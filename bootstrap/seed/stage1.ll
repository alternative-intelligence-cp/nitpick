els`\0A// naming the same vector is physics, not a conflict, and diagnostics render\0A// the base-product form rather than guessing which name was meant.\0A// `Radians` and `Steradians` are the DIMENSIONLESS ratios, so `dim256<Radians>`\0A// IS `tfp256` \E2\80\94 honest, and exactly what the algebra says.\0Apub unit:Radians = 1;\0Apub unit:Steradians = 1;\0Apub unit:Hertz = 1 / Seconds;\0Apub unit:Newtons = Kilograms * Meters / (Seconds * Seconds);\0Apub unit:Pascals = Newtons / (Meters * Meters);\0Apub unit:Joules = Newtons * Meters;\0Apub unit:Watts = Joules / Seconds;\0Apub unit:Coulombs = Amperes * Seconds;\0Apub unit:Volts = Watts / Amperes;\0Apub unit:Farads = Coulombs / Volts;\0Apub unit:Ohms = Volts / Amperes;\0Apub unit:Siemens = Amperes / Volts;\0Apub unit:Webers = Volts * Seconds;\0Apub unit:Teslas = Webers / (Meters * Meters);\0Apub unit:Henries = Webers / Amperes;\0Apub unit:Lumens = Candela * Steradians;\0Apub unit:Lux = Lumens / (Meters * Meters);\0Apub unit:Becquerels = 1 / Seconds;\0Apub unit:Grays = Joules / Kilograms;\0Apub unit:Sieverts = Joules / Kilograms;\0Apub unit:Katals = Moles / Seconds;\0Apub unit:MetersPerSecond = Meters / Seconds;\0Apub unit:MetersPerSecondSquared = Meters / (Seconds * Seconds);\0A\0A// THE FRAC CORE (D-198, 1.3.5): the exact-rational algorithms, in Nitpick,\0A// in int256 \E2\80\94 ONE implementation for all four widths, the width's balanced\0A// bound a parameter, `ok` the answer to \22does the reduced form fit\22. The\0A// EMITTER lowers the frac operators to calls of these (every prelude\0A// function emits into every program under its deterministic symbol), so the\0A// arithmetic a verifier reads is this source, not hand-written IR. int256\0A// because frac64's cross-products reach 2^127 and their SUM overflows i128;\0A// nothing below can overflow 256 bits (the largest intermediate is a mul\0A// product at ~2^254). The core is TAINT-BLIND: the emitter tests the\0A// operands' ERR and discards the result under taint \E2\80\94 stickiness is the\0A// caller's, exactness is ours.\0Apub struct:FracParts = {\0A    bool:ok;\0A    int256:whole;\0A    int256:num;\0A    int256:denom;\0A};\0A\0Afunc:frac_bad = FracParts() never fails {\0A    FracParts:b = FracParts{ ok: false, whole: 0i256, num: 0i256, denom: 0i256 };\0A    pass b;\0A};\0A\0Apub func:npk_gcd256 = int256(int256:a, int256:b) never fails {\0A    int256:x = a;\0A    int256:y = b;\0A    while (y != 0i256) {\0A        int256:t = x % y;\0A        x = y;\0A        y = t;\0A    }\0A    pass x;\0A};\0A\0A// Canonical form \E2\80\94 D-198's five invariants \E2\80\94 from any {w, n, d} with d > 0;\0A// d \E2\89\A4 0 is ERR (`ok: false`), and so is a reduced form whose components\0A// exceed the width's bounds: \22exact or ERR\22, never rounded. The width's\0A// valid component ranges are balanced (\C2\B1bound for whole and num \E2\80\94 the\0A// most-negative is the sentinel) and 1..2\C2\B7bound+1 for the unsigned denom.\0Apub func:npk_frac_norm = FracParts(int256:w0, int256:n0, int256:d0,\0A                                   int256:bound) never fails {\0A    if (d0 <= 0i256) { pass (raw frac_bad()); }\0A    int256:w = w0;\0A    int256:n = n0;\0A    int256:d = d0;\0A    if (n < 0i256) {\0A        int256:an = 0i256 - n;\0A        if (an >= d) {\0A            w = w - (an / d);\0A            n = 0i256 - (an % d);\0A        }\0A    } else {\0A        if (n >= d) {\0A            w = w + (n / d);\0A            n = n % d;\0A        }\0A    }\0A    if (n != 0i256) {\0A        int256:an2 = n;\0A        if (an2 < 0i256) { an2 = 0i256 - an2; }\0A        int256:g = raw npk_gcd256(an2, d);\0A        if (g > 1i256) {\0A            n = n / g;\0A            d = d / g;\0A        }\0A    } else {\0A        d = 1i256;\0A    }\0A    if (w != 0i256) {\0A        if (n < 0i256) {\0A            w = w - 1i256;\0A            n = d + n;\0A        }\0A    }\0A    if (w > bound)                     { pass (raw frac_bad()); }\0A    if (w < (0i256 - bound))           { pass (raw frac_bad()); }\0A    if (n > bound)                     { pass (raw frac_bad()); }\0A    if (n < (0i256 - bound))           { pass (raw frac_bad()); }\0A    if (d > ((2i256 * bound) + 1i256)) { pass (raw frac_bad()); }\0A    FracParts:out = FracParts{ ok: true, whole: w, num: n, denom: d };\0A    pass out;\0A};\0A\0A// The improper form w\C2\B7d + n \E2\80\94 exact under the sign convention for negatives\0A// too: -2 + 5/8 is -11 over 8.\0Afunc:frac_improper = int256(int256:w, int256:n, int256:d) never fails {\0A    pass ((w * d) + n);\0A};\0A\0Apub func:npk_frac_add = FracParts(int256:aw, int256:an, int256:ad,\0A                                  int256:bw, int256:bn, int256:bd,\0A                                  int256:bound) never fails {\0A    if (ad <= 0i256) { pass (raw frac_bad()); }\0A    if (bd <= 0i256) { pass (raw frac_bad()); }\0A    pass (raw npk_frac_norm(aw + bw, (an * bd) + (bn * ad), ad * bd, bound));\0A};\0A\0Apub func:npk_frac_sub = FracParts(int256:aw, int256:an, int256:ad,\0A                                  int256:bw, int256:bn, int256:bd,\0A                                  int256:bound) never fails {\0A    if (ad <= 0i256) { pass (raw frac_bad()); }\0A    if (bd <= 0i256) { pass (raw frac_bad()); }\0A    pass (raw npk_frac_norm(aw - bw, (an * bd) - (bn * ad), ad * bd, bound));\0A};\0A\0Apub func:npk_frac_mul = FracParts(int256:aw, int256:an, int256:ad,\0A                                  int256:bw, int256:bn, int256:bd,\0A                                  int256:bound) never fails {\0A    if (ad <= 0i256) { pass (raw frac_bad()); }\0A    if (bd <= 0i256) { pass (raw frac_bad()); }\0A    int256:pa = raw frac_improper(aw, an, ad);\0A    int256:pb = raw frac_improper(bw, bn, bd);\0A    pass (raw npk_frac_norm(0i256, pa * pb, ad * bd, bound));\0A};\0A\0Apub func:npk_frac_div = FracParts(int256:aw, int256:an, int256:ad,\0A                                  int256:bw, int256:bn, int256:bd,\0A                                  int256:bound) never fails {\0A    if (ad <= 0i256) { pass (raw frac_bad()); }\0A    if (bd <= 0i256) { pass (raw frac_bad()); }\0A    int256:pa = raw frac_improper(aw, an, ad);\0A    int256:pb = raw frac_improper(bw, bn, bd);\0A    // Division by an exact zero is ERR (D-007's twisted row): pb = 0 makes\0A    // the new denominator 0, which `norm` refuses \E2\80\94 but the sign fix below\0A    // must not run on it, so it is said here too.\0A    int256:nn = pa * bd;\0A    int256:nd = ad * pb;\0A    if (nd == 0i256) { pass (raw frac_bad()); }\0A    if (nd < 0i256) {\0A        nn = 0i256 - nn;\0A        nd = 0i256 - nd;\0A    }\0A    pass (raw npk_frac_norm(0i256, nn, nd, bound));\0A};\0A\0A// Exact three-way comparison by cross-multiplied improper forms \E2\80\94 the\0A// common denominator ad\C2\B7bd is positive, so the numerators' order IS the\0A// values'. -1, 0, 1.\0Apub func:npk_frac_cmp = int32(int256:aw, int256:an, int256:ad,\0A                              int256:bw, int256:bn, int256:bd) never fails {\0A    int256:pa = (raw frac_improper(aw, an, ad)) * bd;\0A    int256:pb = (raw frac_improper(bw, bn, bd)) * ad;\0A    if (pa < pb) { pass (0i32 - 1i32); }\0A    if (pa > pb) { pass 1i32; }\0A    pass 0i32;\0A};\0A\0A// A frac RENDERS ITS MIXED NUMBER (D-198, D-168): \223 1/3\22, \22-2 5/8\22, \220\22,\0A// \22ERR\22 \E2\80\94 exact by construction; the sign rides whole, or num when whole\0A// is 0. The members are the read-only component views (1.3.5).\0Aimpl:frac8:ToString = { func:to_string = string(frac8:self) never fails {\0A    if (is_err(self)) { pass \22ERR\22; }\0A    if (self.num == 0i8) { pass (int_to_string(self.whole => int64)); }\0A    string:head = \22\22;\0A    if (self.whole != 0i8) {\0A        head = string_concat(int_to_string(self.whole => int64), \22 \22);\0A    }\0A    string:fr = string_concat(int_to_string(self.num => int64), \22/\22);\0A    pass (string_concat(head,\0A              string_concat(fr, raw uint_to_decimal(self.denom => uint64))));\0A}; };\0Aimpl:frac16:ToString = { func:to_string = string(frac16:self) never fails {\0A    if (is_err(self)) { pass \22ERR\22; }\0A    if (self.num == 0i16) { pass (int_to_string(self.whole => int64)); }\0A    string:head = \22\22;\0A    if (self.whole != 0i16) {\0A        head = string_concat(int_to_string(self.whole => int64), \22 \22);\0A    }\0A    string:fr = string_concat(int_to_string(self.num => int64), \22/\22);\0A    pass (string_concat(head,\0A              string_concat(fr, raw uint_to_decimal(self.denom => uint64))));\0A}; };\0Aimpl:frac32:ToString = { func:to_string = string(frac32:self) never fails {\0A    if (is_err(self)) { pass \22ERR\22; }\0A    if (self.num == 0i32) { pass (int_to_string(self.whole => int64)); }\0A    string:head = \22\22;\0A    if (self.whole != 0i32) {\0A        head = string_concat(int_to_string(self.whole => int64), \22 \22);\0A    }\0A    string:fr = string_concat(int_to_string(self.num => int64), \22/\22);\0A    pass (string_concat(head,\0A              string_concat(fr, raw uint_to_decimal(self.denom => uint64))));\0A}; };\0Aimpl:frac64:ToString = { func:to_string = string(frac64:self) never fails {\0A    if (is_err(self)) { pass \22ERR\22; }\0A    if (self.num == 0i64) { pass (int_to_string(self.whole)); }\0A    string:head = \22\22;\0A    if (self.whole != 0i64) {\0A        head = string_concat(int_to_string(self.whole), \22 \22);\0A    }\0A    string:fr = string_concat(int_to_string(self.num), \22/\22);\0A    pass (string_concat(head,\0A              string_concat(fr, raw uint_to_decimal(self.denom))));\0A}; };\0A\0A// THE COMPLEX CORES (D-199, 1.3.6): per element type, in Nitpick \E2\80\94 the tfp\0A// bodies use the LANGUAGE'S OWN tfp operators, so Q scaling, saturation and\0A// stickiness arrive for free and the any-component-ERR \E2\86\92 BOTH\0A// canonicalization is an explicit line a verifier reads; the float bodies\0A// are IEEE-total, with division by SMITH'S algorithm \E2\80\94 the naive formula\0A// overflows at |denominator| \E2\89\88 \E2\88\9Amax, a silent-wrong-answer class. flt32\0A// computes IN flt32: widening through double would double-round. The\0A// emitter unpacks `complex<T>`'s `{T, T}`, calls the deterministic prelude\0A// symbol, and the returned pair IS the value.\0A\0Apub struct:CplxF32 = {\0A    flt32:re;\0A    flt32:im;\0A};\0A\0Apub func:npk_cplx_add_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\0A    CplxF32:r = CplxF32{ re: a + c, im: b + d };\0A    pass r;\0A};\0A\0Apub func:npk_cplx_sub_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\0A    CplxF32:r = CplxF32{ re: a - c, im: b - d };\0A    pass r;\0A};\0A\0Apub func:npk_cplx_mul_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\0A    CplxF32:r = CplxF32{ re: (a * c) - (b * d), im: (a * d) + (b * c) };\0A    pass r;\0A};\0A\0A// Smith's algorithm: scale by the larger of |c|, |d| so the denominator\0A// never overflows where the value itself is representable.\0Apub func:npk_cplx_div_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\0A    flt32:ac = c;\0A    if (ac < 0.0f32) { ac = 0.0f32 - ac; }\0A    flt32:ad = d;\0A    if (ad < 0.0f32) { ad = 0.0f32 - ad; }\0A    if (ac >= ad) {\0A        flt32:ratio = d / c;\0A        flt32:den = c + (d * ratio);\0A        CplxF32:r = CplxF32{ re: (a + (b * ratio)) / den,\0A                                  im: (b - (a * ratio)) / den };\0A        pass r;\0A    }\0A    flt32:ratio2 = c / d;\0A    flt32:den2 = (c * ratio2) + d;\0A    CplxF32:r2 = CplxF32{ re: ((a * ratio2) + b) / den2,\0A                               im: ((b * ratio2) - a) / den2 };\0A    pass r2;\0A};\0A\0Apub func:npk_cplx_abs2_f32 = flt32(flt32:a, flt32:b) never fails {\0A    pass ((a * a) + (b * b));\0A};\0A\0Apub struct:CplxF64 = {\0A    flt64:re;\0A    flt64:im;\0A};\0A\0Apub func:npk_cplx_add_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\0A    CplxF64:r = CplxF64{ re: a + c, im: b + d };\0A    pass r;\0A};\0A\0Apub func:npk_cplx_sub_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\0A    CplxF64:r = CplxF64{ re: a - c, im: b - d };\0A    pass r;\0A};\0A\0Apub func:npk_cplx_mul_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\0A    CplxF64:r = CplxF64{ re: (a * c) - (b * d), im: (a * d) + (b * c) };\0A    pass r;\0A};\0A\0A// Smith's algorithm: scale by the larger of |c|, |d| so the denominator\0A// never overflows where the value itself is representable.\0Apub func:npk_cplx_div_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\0A    flt64:ac = c;\0A    if (ac < 0.0f64) { ac = 0.0f64 - ac; }\0A    flt64:ad = d;\0A    if (ad < 0.0f64) { ad = 0.0f64 - ad; }\0A    if (ac >= ad) {\0A        flt64:ratio = d / c;\0A        flt64:den = c + (d * ratio);\0A        CplxF64:r = CplxF64{ re: (a + (b * ratio)) / den,\0A                                  im: (b - (a * ratio)) / den };\0A        pass r;\0A    }\0A    flt64:ratio2 = c / d;\0A    flt64:den2 = (c * ratio2) + d;\0A    CplxF64:r2 = CplxF64{ re: ((a * ratio2) + b) / den2,\0A                               im: ((b * ratio2) - a) / den2 };\0A    pass r2;\0A};\0A\0Apub func:npk_cplx_abs2_f64 = flt64(flt64:a, flt64:b) never fails {\0A    pass ((a * a) + (b * b));\0A};\0A\0Apub struct:CplxT32 = {\0A    tfp32:re;\0A    tfp32:im;\0A};\0A\0A// The tfp cores canonicalize: any component ERR makes BOTH ERR (D-199 \E2\80\94\0A// half a taint steering the other half is the hole stickiness closes).\0Afunc:cplx_fix_t32 = CplxT32(tfp32:re2, tfp32:im2) never fails {\0A    if (is_err(re2)) {\0A        CplxT32:e = CplxT32{ re: ERR, im: ERR };\0A        pass e;\0A    }\0A    if (is_err(im2)) {\0A        CplxT32:e2 = CplxT32{ re: ERR, im: ERR };\0A        pass e2;\0A    }\0A    CplxT32:ok = CplxT32{ re: re2, im: im2 };\0A    pass ok;\0A};\0A\0Apub func:npk_cplx_add_t32 = CplxT32(tfp32:a, tfp32:b, tfp32:c, tfp32:d) never fails {\0A    pass (raw cplx_fix_t32(a + c, b + d));\0A};\0A\0Apub func:npk_cplx_sub_