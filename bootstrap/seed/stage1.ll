er) never fails {\0A    pass TextReader{ inner: move(inner), acc: \22\22, pos: 0i64,\0A                     pend_cr: false, seen_eof: false };\0A};\0Apub func:line_buf_writer<BW: Writer> = LineBufWriter<BW>(move BW:inner) never fails {\0A    pass LineBufWriter{ inner: move(inner), pend: \22\22 };\0A};\0A\0A// EVERY BYTE REACHES THE INNER WRITER OR THE CALL FAILS. The trait's `write`\0A// may be partial per call (POSIX's shape); a wrapper that translated a\0A// buffer and delivered half of it would tear a line, so the wrappers loop.\0Aasync func:tw_write_all<W: Writer> = NIL(W->:sink, string:s, Duration:within) {\0A    int64:give_up = (mono_now()) + within.ns;\0A    int64:done = 0i64;\0A    while (done < s.len) {\0A        int64:rem = give_up - (mono_now());\0A        if (rem <= 0i64) { fail DeadlineExceeded; }\0A        string:sview = relay string_slice(s, done, s.len);\0A        uint8[]:bytes = string_bytes(sview);\0A        int64:n = relay await sink.write(bytes, raw duration_ns(rem));\0A        done = done + n;\0A    }\0A    pass NIL;\0A};\0A\0A// `text_write_str(@w, s, within)`: `\5Cn` becomes the writer's ending. The\0A// free-function spelling is D-161's rule \E2\80\94 an inherent impl over a family\0A// cannot be spelled \E2\80\94 with `W` inferred from the receiver (D-064).\0Apub async func:text_write_str<W: Writer> = NIL(TextWriter<W>->:tw, string:s, Duration:within) {\0A    bool:crlf = false;\0A    pick (tw.ending) {\0A        (LineEnding.Lf)   { crlf = false; },\0A        (LineEnding.CrLf) { crlf = true; }\0A    }\0A    if (!crlf) {\0A        relay await tw_write_all(@(tw.inner), s, within);\0A        pass NIL;\0A    }\0A    string:out = \22\22;\0A    int64:i = 0i64;\0A    int64:seg = 0i64;\0A    while (i < s.len) {\0A        if (s.ptr[i] == 10u8) {\0A            string:part = relay string_slice(s, seg, i);\0A            out = string_concat(out, part);\0A            out = string_concat(out, \22\5Cr\5Cn\22);\0A            seg = i + 1i64;\0A        }\0A        i = i + 1i64;\0A    }\0A    string:tail = relay string_slice(s, seg, s.len);\0A    out = string_concat(out, tail);\0A    relay await tw_write_all(@(tw.inner), out, within);\0A    pass NIL;\0A};\0A\0Apub async func:text_write_line<W: Writer> = NIL(TextWriter<W>->:tw, string:s, Duration:within) {\0A    relay await text_write_str(tw, s, within);\0A    bool:crlf2 = false;\0A    pick (tw.ending) {\0A        (LineEnding.Lf)   { crlf2 = false; },\0A        (LineEnding.CrLf) { crlf2 = true; }\0A    }\0A    if (crlf2) {\0A        relay await tw_write_all(@(tw.inner), \22\5Cr\5Cn\22, within);\0A        pass NIL;\0A    }\0A    relay await tw_write_all(@(tw.inner), \22\5Cn\22, within);\0A    pass NIL;\0A};\0A\0Apub async func:text_flush<W: Writer> = NIL(TextWriter<W>->:tw, Duration:within) {\0A    relay await tw.inner.flush(within);\0A    pass NIL;\0A};\0A\0A// ONE LINE, WITHOUT ITS TERMINATOR \E2\80\94 `\5Cr\5Cn`, `\5Cn`, and a lone `\5Cr` are one\0A// break (IO_REFERENCE \C2\A73), a `\5Cr` split from its `\5Cn` by a refill boundary\0A// included. End of input: a final unterminated line is still a line;\0A// `IoEof` only when nothing remains at all.\0Apub async func:text_read_line<R: Reader> = string(TextReader<R>->:tr, Duration:within) {\0A    int64:give_up = (mono_now()) + within.ns;\0A    while (true) {\0A        // a pending `\5Cr` saw its `\5Cn` arrive: consume the second half\0A        if (tr.pend_cr) {\0A            if (tr.pos < tr.acc.len) {\0A                tr.pend_cr = false;\0A                if (tr.acc.ptr[tr.pos] == 10u8) { tr.pos = tr.pos + 1i64; }\0A            }\0A        }\0A        // scan the unconsumed bytes for a break\0A        int64:i = tr.pos;\0A        while (i < tr.acc.len) {\0A            uint8:c = tr.acc.ptr[i];\0A            if (c == 10u8) {\0A                string:line = relay string_slice(tr.acc, tr.pos, i);\0A                tr.pos = i + 1i64;\0A                pass line;\0A            }\0A            if (c == 13u8) {\0A                string:line2 = relay string_slice(tr.acc, tr.pos, i);\0A                tr.pos = i + 1i64;\0A                if (tr.pos < tr.acc.len) {\0A                    if (tr.acc.ptr[tr.pos] == 10u8) { tr.pos = tr.pos + 1i64; }\0A                }\0A                if (tr.pos >= tr.acc.len) {\0A                    if (!tr.seen_eof) { tr.pend_cr = true; }\0A                }\0A                pass line2;\0A            }\0A            i = i + 1i64;\0A        }\0A        // no break in what we hold\0A        if (tr.seen_eof) {\0A            if (tr.pos >= tr.acc.len) { fail IoEof; }\0A            string:last = relay string_slice(tr.acc, tr.pos, tr.acc.len);\0A            tr.pos = tr.acc.len;\0A            pass last;\0A        }\0A        // refill: drop consumed bytes, then ask the inner reader\0A        tr.acc = relay string_slice(tr.acc, tr.pos, tr.acc.len);\0A        tr.pos = 0i64;\0A        int64:rem = give_up - (mono_now());\0A        if (rem <= 0i64) { fail DeadlineExceeded; }\0A        wild int8->:cbuf = alloc(512i64);\0A        defer { dalloc(cbuf); }\0A        uint8[]:cslice = #wild_slice<uint8>(cbuf =>! wild uint8->, 512i64);\0A        Result<int64>:got = await tr.inner.read(cslice, raw duration_ns(rem));\0A        if (got.is_error) {\0A            if (got.err == IoEof) { tr.seen_eof = true; }\0A            if (got.err != IoEof) { fail got.err; }\0A        }\0A        if (!got.is_error) {\0A            string:fresh = string_from_bytes(cbuf, got.value);\0A            tr.acc = string_concat(tr.acc, fresh);\0A        }\0A    }\0A};\0A\0A// LINE BUFFERING AS A TYPE (\C2\A74): bytes gather until a `\5Cn`, then everything\0A// through the LAST `\5Cn` goes down in one write. A partial line lives in the\0A// buffer until its `\5Cn` or an explicit `flush` \E2\80\94 and `defer` does not run\0A// on a trap (D-014), so what a trap loses is exactly the partial line, as\0A// \C2\A74.1 states. NOTE: a partial line also does not flush ITSELF at scope\0A// exit (drops are generated, never user hooks) \E2\80\94 finish lines or flush.\0Aimpl:<BW: Writer>:LineBufWriter<BW>:Writer = {\0A    async func:write = int64(LineBufWriter<BW>->:self, fixed uint8[]:wsrc, Duration:within) {\0A        string:added = string_from_bytes(wsrc.ptr =>! wild int8->, wsrc.len);\0A        self.pend = string_concat(self.pend, added);\0A        int64:nl = 0i64 - 1i64;\0A        int64:i = 0i64;\0A        while (i < self.pend.len) {\0A            if (self.pend.ptr[i] == 10u8) { nl = i; }\0A            i = i + 1i64;\0A        }\0A        if (nl >= 0i64) {\0A            string:ship = relay string_slice(self.pend, 0i64, nl + 1i64);\0A            self.pend = relay string_slice(self.pend, nl + 1i64, self.pend.len);\0A            relay await tw_write_all(@(self.inner), ship, within);\0A        }\0A        pass wsrc.len;\0A    };\0A    async func:flush = NIL(LineBufWriter<BW>->:self, Duration:within) {\0A        if (self.pend.len > 0i64) {\0A            string:all = string_concat(self.pend, \22\22);\0A            self.pend = \22\22;\0A            relay await tw_write_all(@(self.inner), all, within);\0A        }\0A        relay await self.inner.flush(within);\0A        pass NIL;\0A    };\0A};\0A\0A// TRANSLATION ON THE BYTE PATH TOO (\C2\A73: a text stream translates, always) \E2\80\94\0A// `TextWriter` implements `Writer` so a buffered wrapper can stand inside\0A// or outside it, and the byte-trait write is `text_write_str` over the\0A// bytes read as text.\0Aimpl:<W: Writer>:TextWriter<W>:Writer = {\0A    async func:write = int64(TextWriter<W>->:self, fixed uint8[]:wsrc, Duration:within) {\0A        string:s = string_from_bytes(wsrc.ptr =>! wild int8->, wsrc.len);\0A        relay await text_write_str(self, s, within);\0A        pass wsrc.len;\0A    };\0A    async func:flush = NIL(TextWriter<W>->:self, Duration:within) {\0A        relay await self.inner.flush(within);\0A        pass NIL;\0A    };\0A};\0A\0A// THE STANDARD STREAMS (\C2\A78): built IN `main`'s scope by these constructors\0A// and passed down \E2\80\94 they are not globals. Each construction OWNS A DUP of\0A// the inherited descriptor (F_DUPFD_CLOEXEC), so its scope-exit close can\0A// never close descriptor 0/1/2 out from under anything else. Buffering per\0A// \C2\A74, in the TYPE: stdout line-buffered always, stderr unbuffered always,\0A// stdin buffered by its reader. The inherited descriptors stay BLOCKING \E2\80\94\0A// O_NONBLOCK on them would ride the shared open-file description into the\0A// parent process (a real-world footgun) \E2\80\94 so a write to a stuffed stdout\0A// pipe blocks the thread, bounded by the consumer, exactly as every unix\0A// tool is; that stated exception to D-071 lives here and nowhere else.\0Afunc:std_dup = OwnedFd(int32:which) {\0A    // fcntl(fd, F_DUPFD_CLOEXEC = 1030, 0)\0A    int64:d = relay sys(72i64, which => int64, 1030i64, 0i64);\0A    pass own_fd((d =>! int32) =>! fd);\0A};\0A\0Apub func:std_in = TextReader<ByteReader>() {\0A    OwnedFd:d = relay std_dup(0i32);\0A    pass (raw text_reader(ByteReader{ src: move(d) }));\0A};\0Apub func:std_out = TextWriter<LineBufWriter<ByteWriter>>() {\0A    OwnedFd:d = relay std_dup(1i32);\0A    pass (raw text_writer(raw line_buf_writer(ByteWriter{ sink: move(d) }), LineEnding.Lf));\0A};\0Apub func:std_err = TextWriter<ByteWriter>() {\0A    OwnedFd:d = relay std_dup(2i32);\0A    pass (raw text_writer(ByteWriter{ sink: move(d) }, LineEnding.Lf));\0A};\0A\0A// A `tfp`'S EXACT DECIMAL (D-195, \C2\A76b's discipline continued): a Q value is\0A// a binary fraction whose decimal expansion is finite (\E2\89\A4 F digits), and the\0A// canonical rendering IS that exact expansion \E2\80\94 determinism is the family's\0A// whole point, so \22shortest that round-trips\22 (a float concept) does not\0A// apply. One `uint256` core serves every width: the fraction's digits fall\0A// out of repeated \C3\9710-and-shift (never division), the integer half through\0A// divmod-10 at width (inline-expanded, no libcall). \22ERR\22 renders the\0A// sentinel; the sign rides the raw carrier's.\0Apub func:tfp_render = string(bool:neg, uint256:ipart, uint256:frac,\0A                             uint64:fbits) never fails {\0A    string:ip = \22\22;\0A    if (ipart == 0u256) { ip = \220\22; }\0A    uint256:n = ipart;\0A    while (n != 0u256) {\0A        uint256:q = n / 10u256;\0A        uint256:r = n - (q * 10u256);\0A        ip = string_concat(raw digit_char((r =>! uint64)), ip);\0A        n = q;\0A    }\0A    string:fp = \22\22;\0A    int64:emitted = 0i64;\0A    int64:lastnz = 0i64;\0A    uint256:f = frac;\0A    uint256:mask = (1u256 << (fbits => uint256)) - 1u256;\0A    while (emitted < (fbits =>! int64)) {\0A        if (f == 0u256) { emitted = fbits =>! int64; } else {\0A            uint256:t = f * 10u256;\0A            uint256:d = t >> (fbits => uint256);\0A            f = t & mask;\0A            fp = string_concat(fp, raw digit_char((d =>! uint64)));\0A            emitted = emitted + 1i64;\0A            if (d != 0u256) { lastnz = emitted; }\0A        }\0A    }\0A    if (lastnz == 0i64) { fp = \220\22; }\0A    if (lastnz > 0i64) {\0A        if (lastnz < fp.len) {\0A            fp = string_slice(fp, 0i64, lastnz) ?| \220\22;\0A        }\0A    }\0A    string:out = \22\22;\0A    if (neg) { out = \22-\22; }\0A    out = string_concat(out, ip);\0A    out = string_concat(out, \22.\22);\0A    pass (string_concat(out, fp));\0A};\0A\0Aimpl:tfp32:ToString = { func:to_string = string(tfp32:self) never fails {\0A    if (is_err(self)) { pass \22ERR\22; }\0A    wild int8->:b = alloc(4i64);\0A    wild tfp32->:tp = b =>! wild tfp32->;\0A    <-tp = self;\0A    wild int32->:ip2 = b =>! wild int32->;\0A    int32:rawv = <-ip2;\0A    dalloc(b);\0A    bool:neg = false;\0A    if (rawv < 0i32) { neg = true; rawv = 0i32 - rawv; }\0A    uint256:mag = (rawv =>! uint32) => uint256;\0A    pass (raw tfp_render(neg, mag >> 16u256, mag & 65535u256, 16u64));\0A}; };\0Aimpl:tfp64:ToString = { func:to_string = string(tfp64:self