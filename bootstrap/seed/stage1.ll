  %p = getelementptr [1864 x { ptr, i64 }], ptr @npk.site.paths, i32 0, i32 %i
  %hp = getelementptr { ptr, i64 }, ptr %p, i32 0, i32 0
  %hv = load ptr, ptr %hp
  %lp = getelementptr { ptr, i64 }, ptr %p, i32 0, i32 1
  %lv = load i64, ptr %lp
  %r0 = insertvalue { ptr, i64, i64 } zeroinitializer, ptr %hv, 0
  %r1 = insertvalue { ptr, i64, i64 } %r0, i64 %lv, 1
  %r2 = insertvalue { ptr, i64, i64 } %r1, i64 %lv, 2
  ret { ptr, i64, i64 } %r2
out:
  ret { ptr, i64, i64 } zeroinitializer
}


