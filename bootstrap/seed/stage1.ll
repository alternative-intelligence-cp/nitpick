o-divisor rule.\0Apub func:npk_cplx_div_t64 = CplxT64(tfp64:a, tfp64:b, tfp64:c, tfp64:d) never fails {\0A    tfp64:den = (c * c) + (d * d);\0A    pass (raw cplx_fix_t64(((a * c) + (b * d)) / den,\0A                                     ((b * c) - (a * d)) / den));\0A};\0A\0Apub func:npk_cplx_abs2_t64 = tfp64(tfp64:a, tfp64:b) never fails {\0A    tfp64:s = (a * a) + (b * b);\0A    if (is_err(s)) { pass ERR; }\0A    pass s;\0A};\0A\0A// A COMPLEX RENDERS \223+4i\22 / \223-4i\22 via the element's own rendering\0A// (D-199); a tfp-element ERR pair renders \22ERR\22. The sign splice reads the\0A// imaginary component: negative imaginaries render their magnitude behind\0A// `-`, everything else behind `+` (a float NaN imaginary lands on `+nan i`,\0A// which is the honest reading of an unordered sign).\0Aimpl:complex<flt32>:ToString = { func:to_string = string(complex<flt32>:self) never fails {\0A    flt32:im2 = self.im();\0A    string:sign = \22+\22;\0A    if (im2 < 0.0f32) { sign = \22-\22; im2 = 0.0f32 - im2; }\0A    string:h = string_concat(`&{self.re()}`, sign);\0A    pass (string_concat(h, string_concat(`&{im2}`, \22i\22)));\0A}; };\0Aimpl:complex<flt64>:ToString = { func:to_string = string(complex<flt64>:self) never fails {\0A    flt64:im2 = self.im();\0A    string:sign = \22+\22;\0A    if (im2 < 0.0f64) { sign = \22-\22; im2 = 0.0f64 - im2; }\0A    string:h = string_concat(`&{self.re()}`, sign);\0A    pass (string_concat(h, string_concat(`&{im2}`, \22i\22)));\0A}; };\0Aimpl:complex<tfp32>:ToString = { func:to_string = string(complex<tfp32>:self) never fails {\0A    if (is_err(self)) { pass \22ERR\22; }\0A    tfp32:im2 = self.im();\0A    string:sign = \22+\22;\0A    if (im2 < 0.0tfp32) { sign = \22-\22; im2 = 0.0tfp32 - im2; }\0A    string:h = string_concat(`&{self.re()}`, sign);\0A    pass (string_concat(h, string_concat(`&{im2}`, \22i\22)));\0A}; };\0Aimpl:complex<tfp64>:ToString = { func:to_string = string(complex<tfp64>:self) never fails {\0A    if (is_err(self)