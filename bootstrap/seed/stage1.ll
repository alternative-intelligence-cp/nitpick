@.str.8216 = private unnamed_addr constant [76666 x i8] c"// The prelude \E2\80\94 what the compiler itself declares.\0A//\0A// NOT COMPILED AS PART OF THE FRONTEND. Nothing `use`s this file. It is read by\0A// `bootstrap/generator/gen_tables.py`, which emits it into\0A// `src/frontend/prelude_source.npk` as a string constant, and the compiler then\0A// puts that text through the same lexer, the same parser and the same collector as\0A// any other module.\0A//\0A// SOURCE RATHER THAN SYNTHESIS, and generated rather than hand-escaped, for the two\0A// reasons the token tables give: a declaration built in code is one a person cannot\0A// read, and a constant written twice is one that can differ in one of the places.\0A//\0A// COLLECTED INTO THE ROOT SCOPE, so these names are in scope everywhere with no\0A// import. Every module's scope has scope 0 as its parent, so the place already\0A// existed.\0A\0Amod:prelude;\0A\0A// HOW TWO VALUES COMPARE, AS A TYPE RATHER THAN A NUMBER. The prototype's\0A// `partial_cmp` returned an `int32` meaning less, equal or greater by sign \E2\80\94 three\0A// meanings in one number, which is the shape D-036 rejects for `bool` and `char`.\0A// An ordering is not an integer either.\0Apub enum:Ordering = {\0A    Less;\0A    Equal;\0A    Greater;\0A};\0A\0A// EQUALITY. Derived field by field, in declaration order.\0Apub trait:Eq = {\0A    func:eq = bool(Self:self, Self:other);\0A};\0A\0A// A TOTAL ORDER. Every two values compare, which is what makes the result an\0A// `Ordering` and not an `Ordering?`.\0A//\0A// The prototype generated `less_than` returning `bool`, which carries strictly less\0A// information than a three-way comparison and made `Ord` WEAKER than `PartialOrd` \E2\80\94\0A// backwards, since `Ord` is the stronger promise.\0Apub trait:Ord = {\0A    func:cmp = Ordering(Self:self, Self:other);\0A};\0A\0A// AN ORDER THAT MAY HAVE NO ANSWER. Not a second spelling of `Ord` but a different\0A// promise, which is why it survives where `Display` did not: a `flt64` is IEEE 754\0A// with `nan` and no trap (OP_REFERENCE), so two of them genuinely may not compare,\0A// and a total `cmp` over one would have to lie.\0Apub trait:PartialOrd = {\0A    func:partial_cmp = Ordering?(Self:self, Self:other);\0A};\0A\0A// A VALUE OF THE SAME TYPE, MADE FROM THIS ONE.\0Apub trait:Clone = {\0A    func:clone = Self(Self:self);\0A};\0A\0A// A HASH FOR A MAP, AND NOT CRYPTOGRAPHY. The derived combiner is FNV-1a and is\0A// specified rather than left open (D-123), because a derived hash that varies\0A// between builds is not something a verified compiler can have. Real cryptography\0A// is `ncrypto`, a separately audited artifact.\0Apub trait:Hash = {\0A    func:hash = uint64(Self:self);\0A};\0A\0A// THE VALUE AS A STRING, which is what `&{ }` interpolation asks for.\0Apub trait:ToString = {\0A    func:to_string = string(Self:self);\0A};\0A\0A// THE SAME, IN A DIAGNOSTIC FORM naming the type and its fields. A separate trait\0A// from `ToString` because the two are read by different audiences: one is what a\0A// program shows a person, the other is what a person reads while debugging.\0Apub trait:Debug = {\0A    func:debug = string(Self:self);\0A};\0A\0A// WHAT A `for` LOOP DRIVES (D-166). `next` advances and yields the element, or\0A// `NIL` when the iteration is over \E2\80\94 `Item?` is why this was undecidable before\0A// `Optional` lowered (1.0.7). The receiver is `Self->`: `next` mutates the\0A// iterator's position, so it takes it by pointer, the one trait method that does.\0Apub trait:Iterator = {\0A    assoc:Item;\0A    func:next = Item?(Self->:self);\0A};\0A\0A// `to_string` FOR THE BUILTIN SCALARS (D-168, 1.0.9d), so `&{ x }` renders\0A// without a program writing the impl. The integers widen losslessly into `i64`\0A// and go through the floor's `int_to_string`; `bool` is its two words. The\0A// remaining scalars \E2\80\94 the characters (UTF-8), the `tbb` widths (ERR), the kernel\0A// identifiers, `uint64` (its high bit) and the floats (a correct float->decimal\0A// in the floor) \E2\80\94 arrive with their own careful conversions.\0Aimpl:int8:ToString   = { func:to_string = string(int8:self) never fails   { pass (int_to_string(self => int64)); }; };\0Aimpl:int16:ToString  = { func:to_string = string(int16:self) never fails  { pass (int_to_string(self => int64)); }; };\0Aimpl:int32:ToString  = { func:to_string = string(int32:self) never fails  { pass (int_to_string(self => int64)); }; };\0Aimpl:int64:ToString  = { func:to_string = string(int64:self) never fails  { pass (int_to_string(self)); }; };\0Aimpl:uint8:ToString  = { func:to_string = string(uint8:self) never fails  { pass (int_to_string(self => int64)); }; };\0Aimpl:uint16:ToString = { func:to_string = string(uint16:self) never fails { pass (int_to_string(self => int64)); }; };\0Aimpl:uint32:ToString = { func:to_string = string(uint32:self) never fails { pass (int_to_string(self => int64)); }; };\0Aimpl:bool:ToString   = { func:to_string = string(bool:self) never fails   { if (self) { pass \22true\22; } pass \22false\22; }; };\0A\0Aimpl:uint64:ToString = { func:to_string = string(uint64:self) never fails { pass (raw uint_to_decimal(self)); }; };\0A\0A// THE `tbb` WIDTHS RENDER `ERR` OR THE NUMBER (D-008, D-168). ERR is the taint,\0A// shown as itself; everything else is the value, read through the checked cast\0A// the `is_err` guard makes safe.\0Aimpl:tbb8:ToString  = { func:to_string = string(tbb8:self) never fails  { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0Aimpl:tbb16:ToString = { func:to_string = string(tbb16:self) never fails { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0Aimpl:tbb32:ToString = { func:to_string = string(tbb32:self) never fails { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0Aimpl:tbb64:ToString = { func:to_string = string(tbb64:self) never fails { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0A\0A// THE TERNARY FAMILY RENDERS THE SAME WAY (D-197, D-168): the VALUE is a\0A// number and shows as one; the balanced digit string is what `.trit(i)` /\0A// `.nit(i)` are for.\0Aimpl:trit:ToString  = { func:to_string = string(trit:self) never fails  { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0Aimpl:tryte:ToString = { func:to_string = string(tryte:self) never fails { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0Aimpl:nit:ToString   = { func:to_string = string(nit:self) never fails   { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0Aimpl:nyte:ToString  = { func:to_string = string(nyte:self) never fails  { if (is_err(self)) { pass \22ERR\22; } pass (int_to_string(self => int64)); }; };\0A\0A// THE KERNEL IDENTIFIERS RENDER THEIR NUMBER (D-042, D-168): a handle's value is\0A// readable even though a handle is not forgeable.\0Aimpl:fd:ToString  = { func:to_string = string(fd:self) never fails  { pass (int_to_string(self => int64)); }; };\0Aimpl:pid:ToString = { func:to_string = string(pid:self) never fails { pass (int_to_string(self => int64)); }; };\0Aimpl:tid:ToString = { func:to_string = string(tid:self) never fails { pass (int_to_string(self => int64)); }; };\0Aimpl:uid:ToString = { func:to_string = string(uid:self) never fails { pass (int_to_string(self => int64)); }; };\0Aimpl:gid:ToString = { func:to_string = string(gid:self) never fails { pass (int_to_string(self => int64)); }; };\0A\0A// UNSIGNED DECIMAL (D-168), for `uint64`, whose high half the floor's signed\0A// `int_to_string` renders as a negative. Unsigned division here is the language's\0A// own \E2\80\94 `uint64 / 10` and `% 10` are unsigned because the type is \E2\80\94 so the digits\0A// come out right whatever the high bit. The lower unsigned widths fit in `int64`\0A// and go through `int_to_string` losslessly; only `uint64` needs this.\0Apub func:digit_char = string(uint64:d) never fails {\0A    if (d == 0u64) { pass \220\22; }\0A    if (d == 1u64) { pass \221\22; }\0A    if (d == 2u64) { pass \222\22; }\0A    if (d == 3u64) { pass \223\22; }\0A    if (d == 4u64) { pass \224\22; }\0A    if (d == 5u64) { pass \225\22; }\0A    if (d == 6u64) { pass \226\22; }\0A    if (d == 7u64) { pass \227\22; }\0A    if (d == 8u64) { pass \228\22; }\0A    pass \229\22;\0A};\0A\0Apub func:uint_to_decimal = string(uint64:v) never fails {\0A    if (v == 0u64) { pass \220\22; }\0A    string:acc = \22\22;\0A    uint64:n = v;\0A    while (n > 0u64) {\0A        string:d = raw digit_char(n % 10u64);\0A        acc = string_concat(d, acc);\0A        n = n / 10u64;\0A    }\0A    pass acc;\0A};\0A\0A// A UNICODE SCALAR VALUE AS ONE OWNED STRING (\C2\A76b, D-168). The encoder is\0A// TOTAL: a surrogate half or a value past U+10FFFF renders as U+FFFD, the\0A// replacement character \E2\80\94 never a fabricated byte sequence, because a\0A// `string` is UTF-8 by convention and an innocent-looking total function\0A// must not be the way an invalid one is minted. The owned copy rides\0A// D-186's `string_slice` over a `string_from_bytes` view of a scratch\0A// buffer, which is what unblocked this without a floor primitive.\0Apub func:codepoint_to_string = string(uint32:cp) never fails {\0A    uint32:c = cp;\0A    if (c > 1114111u32)                     { c = 65533u32; }\0A    if ((c >= 55296u32) && (c <= 57343u32)) { c = 65533u32; }\0A    wild int8->:b = alloc(4i64);\0A    int64:len = 0i64;\0A    if (c < 128u32) {\0A        b[0i64] = c =>! int8;\0A        len = 1i64;\0A    }\0A    if ((c >= 128u32) && (c < 2048u32)) {\0A        b[0i64] = (192u32 | (c >> 6u32)) =>! int8;\0A        b[1i64] = (128u32 | (c & 63u32)) =>! int8;\0A        len = 2i64;\0A    }\0A    if ((c >= 2048u32) && (c < 65536u32)) {\0A        b[0i64] = (224u32 | (c >> 12u32)) =>! int8;\0A        b[1i64] = (128u32 | ((c >> 6u32) & 63u32)) =>! int8;\0A        b[2i64] = (128u32 | (c & 63u32)) =>! int8;\0A        len = 3i64;\0A    }\0A    if (c >= 65536u32) {\0A        b[0i64] = (240u32 | (c >> 18u32)) =>! int8;\0A        b[1i64] = (128u32 | ((c >> 12u32) & 63u32)) =>! int8;\0A        b[2i64] = (128u32 | ((c >> 6u32) & 63u32)) =>! int8;\0A        b[3i64] = (128u32 | (c & 63u32)) =>! int8;\0A        len = 4i64;\0A    }\0A    string:v = string_from_bytes(b, len);\0A    string:owned = string_slice(v, 0i64, len) ?| \22\22;\0A    dalloc(b);\0A    pass owned;\0A};\0A\0A// THE CHARACTERS RENDER THEIR TEXT (D-005, D-168, \C2\A76b). `char32` is a\0A// Unicode SCALAR VALUE and renders as itself. `char16` is a UTF-16 CODE\0A// UNIT: a lone surrogate half has no text, and the encoder's own guard\0A// renders it U+FFFD. `char8` is a UTF-8 CODE UNIT: a non-ASCII unit alone\0A// is not a character either \E2\80\94 it is a fragment of one \E2\80\94 so only the ASCII\0A// range renders as itself. The masks pin the unit's unsigned value\0A// whatever the cast does with the storage type's sign bit.\0Aimpl:char8:ToString  = { func:to_string = string(char8:self) never fails {\0A    uint32:u = (self =>! uint32) & 255u32;\0A    if (u < 128u32) { pass (raw codepoint_to_string(u)); }\0A    pass (raw codepoint_to_string(65533u32));\0A}; };\0Aimpl:char16:ToString = { func:to_string = string(char16:self) never fails {\0A    pass (raw codepoint_to_string((self =>! uint32) & 65535u32));\0A}; };\0Aimpl:char32:ToString = { func:to_string = string(char32:self) never fails {\0A    pass (raw codepoint_to_string(self =>! uint32));\0A}; };\0A\0A// A FLOAT'S SHORTEST ROUND-TRIP DECIMAL (\C2\A76b, D-168). Exact integer\0A// arithmetic end to end \E2\80\94 the Steele\E2\80\93White (Dragon4) discipline over the\0A// wide-integer tier \E2\80\94 because a NAIVE conversion drifts, and numeric drift\0A// is the safety rationale's own named failure. NO WIDE DIVISION is used:\0A// every \C3\9710 is a shift-and-add, and a digit is at most nine subtractions,\0A// so nothing here can lower to a runtime library call the zero-dependency\0A// scan would have to provide.\0A//\0A// The loop maintains value = R/S with the half-gaps MP (above) and MM\0A// (below) of the float's neighbourhood; a digit is emitted while neither\0A// gap is entered, and the last digit rounds toward the true value, ties to\0A// even. An EVEN mantissa owns its boundaries (IEEE round-nearest-even), so\0A// every gap test carries the inclusive arm. Worst case fits comfortably:\0A// R, S and the boundaries stay under 2^1130 for flt64's full range,\0A// subnormals included, against uint2048's headroom.\0A//\0A// The format is fixed notation while the decimal exponent E sits in\0A// [-4, 15] \E2\80\94 with a mandatory \22.0\22 or fraction \E2\80\94 and `d[.ddd]e\C2\B1EE`\0A// outside it; \220.0\22/\22-0.0\22, \22inf\22/\22-inf\22 and \22nan\22 are spelled directly.\0Apub func:flt_bits_shortest = string(uint64:bits, uint64:mant_bits,\0A                                    uint64:exp_bits) never fails {\0A    uint64:mant_mask = (1u64 << mant_bits) - 1u64;\0A    uint64:exp_mask = (1u64 << exp_bits) - 1u64;\0A    uint64:sgn = (bits >> (mant_bits + exp_bits)) & 1u64;\0A    uint64:biased = (bits >> mant_bits) & exp_mask;\0A    uint64:frac = bits & mant_mask;\0A    string:neg = \22\22;\0A    if (sgn == 1u64) { neg = \22-\22; }\0A    if (biased == exp_mask) {\0A        if (frac == 0u64) { pass (string_concat(neg, \22inf\22)); }\0A        pass \22nan\22;\0A    }\0A    if ((biased == 0u64) && (frac == 0u64)) {\0A        pass (string_concat(neg, \220.0\22));\0A    }\0A    // Decode: value = f \C3\97 2^e. A normal carries the implicit bit and\0A    // e = biased - bias - mant_bits; a subnormal is the bare fraction at\0A    // the minimum exponent.\0A    uint64:bias = (1u64 << (exp_bits - 1u64)) - 1u64;\0A    uint64:f = frac;\0A    int64:e = (1i64 - (bias =>! int64)) - (mant_bits =>! int64);\0A    if (biased != 0u64) {\0A        f = frac | (1u64 << mant_bits);\0A        e = ((biased =>