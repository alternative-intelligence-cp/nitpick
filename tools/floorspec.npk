// floorspec -- the floor's belts and, from 1.5.6 step 3, its obligation
// writer, as one program the harness builds with the snapshot (D-288). At
// step 0 it runs the shared-state belt (D-290) over `runtime/npkrt.ll` and
// `runtime/npkrt.spec` under the manifest root given as its one argument
// and exits 0 when the classification holds, 1 with every finding on
// stdout otherwise, 2 for a bad invocation. `npkg verify` runs the same
// belt through the same module (`npkg/floor_shared.npk`); the harness's
// Python twin is `bootstrap/harness/floor.py`.
mod:floorspec;

use "../lib/nio.npk".*;
use "../npkg/text.npk".*;
use "../npkg/floor_shared.npk".*;
use "../npkg/floor.npk".*;
use "../npkg/floor_ir.npk".*;
use "../npkg/floor_smt.npk".*;

func:say = NIL(string:s) never fails {
    string:ln = string_concat(s, "\n");
    Result<NIL>:r = nio_write_all(raw nio_stdout_fd(), ln.ptr =>! wild int8->, ln.len);
    if (r.is_error) { }
    pass NIL;
};

func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) {
        drop say("usage: floorspec <manifest root> [--emit DIR]");
        exit 2i32;
    }
    string:root = string_from_bytes(argv[1i64].ptr, argv[1i64].len);
    if (argv.len >= 4i64) {
        if (raw text_eq(string_from_bytes(argv[2i64].ptr, argv[2i64].len), "--emit")) {
            string:dir = string_from_bytes(argv[3i64].ptr, argv[3i64].len);
            FloorInputs:inp = raw floor_read(root);
            if (!inp.ok) { drop say(inp.problem); exit 1i32; }
            List<string>:ef = raw floor_emit(@inp.ft, @inp.spec, inp.models, dir);
            for (int64:i in 0i64...ef.count) { drop say(raw strlist_view(ef, i)); }
            if (ef.count > 0i64) { drop say(string_concat(int_to_string(ef.count), " finding(s)")); exit 1i32; }
            drop say(string_concat("floor: obligations written to ", dir));
            exit 0i32;
        }
    }
    if (argv.len >= 4i64) {
        if (raw text_eq(string_from_bytes(argv[2i64].ptr, argv[2i64].len), "--dump")) {
            string:sym = string_from_bytes(argv[3i64].ptr, argv[3i64].len);
            FloorInputs:inp2 = raw floor_read(root);
            if (!inp2.ok) { drop say(inp2.problem); exit 1i32; }
            int64:fi = raw floor_fn_index(@inp2.ft, sym);
            int64:sec = raw spec_section(@inp2.spec, sym);
            if (fi < 0i64) { drop say("no such define"); exit 1i32; }
            drop say(raw floor_dump(@inp2.ft, @inp2.spec, fi, sec));
            exit 0i32;
        }
    }
    List<string>:fl = raw floor_shared_current(root);
    for (int64:i in 0i64...fl.count) { drop say(raw strlist_view(fl, i)); }
    if (fl.count > 0i64) {
        drop say(string_concat(int_to_string(fl.count), " finding(s)"));
        exit 1i32;
    }
    drop say("floor: the shared-state classification holds (D-290)");
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero)        { exit 3i32; },
        (DivOverflow)      { exit 3i32; },
        (HeapBadRequest)   { exit 3i32; },
        (HeapOom)          { exit 3i32; },
        (IntOverflow)      { exit 3i32; },
        (OutOfBounds)      { exit 3i32; },
        (ShiftRange)       { exit 3i32; },
        (Unreachable)      { exit 3i32; },
        (WildLeak)         { exit 3i32; },
        (ETextInt)         { exit 3i32; },
        (intern.BoundsId)  { exit 3i32; },
        (intern.ProvenSlice) { exit 3i32; },
        (nfs.EFsPath)      { exit 3i32; },
        (nfs.EFsRecord)    { exit 3i32; },
        (nfs.EFsIndex)     { exit 3i32; },
        (*)                { exit 3i32; }
    }
    exit 3i32;
};
