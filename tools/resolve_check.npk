// resolve_check -- load a module graph, resolve it, and report.
//
// Cycle 0.3.6. Not part of the compiler: this is how the harness asks the REAL
// frontend a question about a REAL program.
//
// `parse_check` answers "does this file parse". This answers the whole of what
// cycle 0.3 built: does the module graph load, do the imports bind, does every
// name resolve. It is the driver's shape without the driver's job — nothing is
// emitted, which is Phase B.
//
// WHY IT IS A SECOND TOOL. `tests/rejection/` holds files that PARSE and are
// refused later by the checker (D-085). Module errors are refused EARLIER, by the
// loader, and a file that cannot resolve never reaches a checker at all. Running
// both through one tool would make those two kinds of "correctly refused"
// indistinguishable, and the distinction is the whole point of the rejection
// suite.
//
// Exit codes are the interface, so the harness never parses prose:
//
//   0   loaded, resolved, no diagnostics
//   1   diagnostics (one per line on stdout, as CODE line:col)
//   2   the root file could not be read
//
// Output is codes and spans only. The harness asserts on those and never on
// message text, so messages stay free to improve (0.1.6).

mod:resolve_check;
use "../src/frontend/source_location.npk".*;
use "../src/frontend/source.npk".*;
use "../src/frontend/token_kind.npk".*;
use "../src/frontend/token.npk".*;
use "../src/frontend/intern.npk".*;
use "../src/frontend/ast_kind.npk".*;
use "../src/frontend/ast.npk".*;
use "../src/frontend/diag_codes.npk".*;
use "../src/frontend/diagnostics.npk".*;
use "../src/frontend/diag_writer.npk".*;
use "../src/frontend/parse_codes.npk".*;
use "../src/frontend/resolve_codes.npk".*;
use "../src/frontend/builtins.npk".*;
use "../src/frontend/lexer.npk".*;
use "../src/frontend/parser.npk".*;
use "../src/frontend/parse_type.npk".*;
use "../src/frontend/parse_expr.npk".*;
use "../src/frontend/parse_decorate.npk".*;
use "../src/frontend/parse_stmt.npk".*;
use "../src/frontend/parse_pick.npk".*;
use "../src/frontend/parse_decl.npk".*;
use "../src/frontend/paths.npk".*;
use "../src/frontend/resolve_path.npk".*;
use "../src/frontend/symbols.npk".*;
use "../src/frontend/module_graph.npk".*;
use "../src/frontend/resolve.npk".*;
use "../src/frontend/types.npk".*;

async func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) {
        await diag_say("usage: resolve_check <root.npk>") ?| NIL;
        exit 2i32;
    }
    cstring:arg = argv[1i64];
    string:root = string_from_bytes(arg.ptr, arg.len);

    InternTable:it = raw intern_init();
    DiagList:diags = raw diaglist_init();
    RootList:roots = raw rootlist_init();
    ModuleGraph:g = raw graph_init(@it, @diags, @roots, "");

    // The prelude, as `check` loads it — a tool that resolved without it would
    // report every prelude name as unknown and be measuring a different language.
    discard(raw graph_load_prelude(@g));

    int32:first = raw graph_load_all(@g, root);
    if (first < 0i32) {
        exit 2i32;
    }

    // The order is the cycle's whole architecture, and it is not negotiable:
    // every module collected, THEN imports bound to a fixed point, THEN bodies
    // resolved. Each stage needs the previous one complete for every module, and
    // that is what makes a `use` cycle resolvable (D-086) rather than a problem
    // to be broken.
    // COLLECTION IS ITS OWN PASS since 0.6.1, because macro expansion emits
    // declarations and collection is what records them — so it cannot run while a
    // file is still being parsed. This tool expands nothing, and still has to say
    // so by asking.
    drop graph_collect_all(@g);
    drop graph_apply_prelude(@g);
    drop graph_apply_imports(@g);

    Resolver:r = raw resolver_init(@g.ast, @g.tab, @it, @diags);
    int32:i = 0i32;
    while (i < (raw graph_count(@g))) {
        ModuleEntry:e = raw graph_at(@g, i);
        DeclId:mod_id = DeclId{ index: e.root };
        // WHICH MODULE IS THE PRELUDE, as the pipeline says it (D-179): an
        // explicit error code is legal there and nowhere else. This tool never
        // said, so every module-rejection test carried nine stray
        // NITPICK-RESOLVE-010 findings against the prelude's own declarations
        // -- invisible for as long as the runners matched expectations as a
        // subset of what was reported (1.4.8, S-9's measurement found it).
        r.in_prelude = (i == g.prelude);
        r.module_name = raw module_basename_intern(@g, e.file, @it);
        drop resolve_module(@r, mod_id, e.scope);
        i = i + 1i32;
    }

    // The two unresolvable-cycle checks, both from D-086. Structs need only the
    // AST; globals need the bindings phase 2 just produced.
    drop graph_check_struct_cycles(@g);
    // A NAME THE COMPILER OR THE PRELUDE OWNS, declared by the program (D-239):
    // the loader's rule, so the loader's tool reports it -- the pipeline calls
    // the same check at the same point.
    drop graph_check_owned_names(@g);
    // `main`/`failsafe` outside the root module, or inside an inline one
    // (D-248, 1.5.1b step 1): the loader's rule, so the loader's tool reports it.
    drop graph_check_entry_points(@g);
    int32:k = 0i32;
    while (k < (raw graph_count(@g))) {
        ModuleEntry:e2 = raw graph_at(@g, k);
        DeclId:mid = DeclId{ index: e2.root };
        drop check_global_cycles(@r, mid, e2.scope);
        drop check_rule_cycles(@r, mid, e2.scope);
        k = k + 1i32;
    }

    int64:n = raw diaglist_count(@diags);
    await diag_report_stderr(@diags, @g.sm) ?| NIL;

    if (n != 0i64) {
        exit 1i32;
    }
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    // Every defect family this program can die from, NAMED
    // (D-179) — the doctrine applied to ourselves. Exit 3 for
    // each: a defect in the COMPILER, never the input's error.
    pick (e) {
        (DeadlineExceeded) { exit 3i32; },
        (DivByZero) { exit 3i32; },
        (DivOverflow) { exit 3i32; },
        (HeapBadRequest) { exit 3i32; },
        (HeapOom) { exit 3i32; },
        (IntOverflow) { exit 3i32; },
        (OutOfBounds) { exit 3i32; },
        (Unreachable) { exit 3i32; },
        (WildLeak) { exit 3i32; },
        (ast.BoundsId) { exit 3i32; },
        (ast.BoundsScratch) { exit 3i32; },
        (ast.BoundsWindow) { exit 3i32; },
        (diagnostics.BoundsId) { exit 3i32; },
        (intern.BoundsId) { exit 3i32; },
        (intern.ProvenSlice) { exit 3i32; },
        (module_graph.BoundsIndex) { exit 3i32; },
        (module_graph.ProvenSlice) { exit 3i32; },
        (resolve_path.BoundsIndex) { exit 3i32; },
        (source.BoundsIndex) { exit 3i32; },
        (source.BoundsOffset) { exit 3i32; },
        (source.FileUnknown) { exit 3i32; },
        (symbols.BoundsId) { exit 3i32; },
        (token.BoundsId) { exit 3i32; },
        (types.BoundsId) { exit 3i32; },
        (types.BoundsIndex) { exit 3i32; },
        (*) { exit 3i32; }
    }
    exit 3i32;
};
