// check -- run the whole frontend over a program and REPORT.
//
// The Phase A artifact: it validates completely and emits nothing. Since 0.7.8 it
// is a thin wrapper over `src/driver/pipeline.npk` -- the pipeline used to live
// here and was copied into the emitting tool, and two 400-line bodies kept
// identical by discipline alone is the drift the driver module ended.
//
// Exit codes are the interface, so the harness never parses prose:
//
//   0   clean
//   1   diagnostics (codes and spans on stderr)
//   2   could not read the input
//   3   the COMPILER trapped -- a defect in it, never in the input

use "../src/driver/pipeline.npk".*;
use "../lib/nio.npk".*;
use "../src/frontend/source_location.npk".*;
use "../src/frontend/intern.npk".*;
use "../src/frontend/diagnostics.npk".*;
use "../src/frontend/source.npk".*;

func:emit_line = NIL(NioW->:out, SourceManager->:sm, Diagnostic:d) {
    string:pre = "";
    if (d.severity == 0i32) { pre = "note "; }
    string:m1 = relay string_concat(pre, relay string_concat(d.code, " "));
    // THE FILE IS PART OF THE SPAN. `line:col` alone was the whole address while
    // every tool took one file; a module graph makes it ambiguous across sixty,
    // and the first self-check run (119 findings, no way to say where) is what
    // forced the format to say what it always knew.
    //
    // A SPANLESS DIAGNOSTIC IS RENDERED, NOT LOST (D-162, 1.0.1). `span_none()`
    // carries file = -1; `srcmgr_path` fails on it, and before this the failure
    // relayed out through `report` and was dropped -- a refusal that exited 1
    // and printed nothing. A diagnostic a reader cannot act on is worse than no
    // check; `<no span>` at least names the code.
    if (d.span.file < 0i32) {
        m1 = relay string_concat(m1, "<no span>");
        pass (relay nio_line(out, m1));
    }
    m1 = relay string_concat(m1, relay srcmgr_path(sm, d.span.file));
    m1 = relay string_concat(m1, ":");
    string:m2 = relay string_concat(m1, raw int_to_string(d.span.line => int64));
    string:m3 = relay string_concat(m2, ":");
    string:m4 = relay string_concat(m3, raw int_to_string(d.span.col => int64));
    pass (relay nio_line(out, m4));
};

func:report = NIL(NioW->:out, SourceManager->:sm, DiagList->:diags) {
    int64:n = raw diaglist_count(diags);
    int64:d = 0i64;
    while (d < n) {
        Result<NIL>:r = emit_line(out, sm, raw diaglist_at(diags, d));
        if (r.is_error) { fail r.error; }
        d = d + 1i64;
    }
    pass NIL;
};

func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) {
        NioW:uw = raw nio_stderr();
        drop nio_line(@uw, "usage: check <root.npk>");
        exit 2i32;
    }
    cstring:arg = argv[1i64];
    string:root = raw string_from_bytes(arg.ptr, arg.len);

    Front:f;
    int32:fr = raw front_run($$m f, root);
    if (fr == 2i32) { exit 2i32; }
    if (fr != 0i32) {
        NioW:ew = raw nio_stderr();
        drop report(@ew, @f.g.sm, @f.diags);
        exit 1i32;
    }
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) {
    // Reaching here is a defect in the FRONTEND, not in the file being read. A
    // distinct code so the harness never reports it as "this test file has an
    // error".
    exit 3i32;
};
