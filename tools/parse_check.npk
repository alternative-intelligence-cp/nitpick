// parse_check -- read a Nitpick source file on stdin, parse it, report.
//
// Cycle 0.2.7. Not part of the compiler: this is the harness's way of asking the
// REAL parser a question about a REAL file.
//
// It exists for D-085. `tests/rejection/` holds files that must **parse cleanly
// and be refused later**, and until now that rule was checked against the seed's
// parser -- the throwaway one -- while the rule was written about this one. A
// suite that tests the wrong parser tests nothing.
//
// Exit codes are the interface, so the harness never parses prose:
//
//   0   parsed with no diagnostics
//   1   parsed with diagnostics (the count and codes go to stdout)
//   2   could not read stdin
//
// Output is one line per diagnostic, `CODE line:col`. Codes and spans only --
// the harness asserts on those and never on message text, so messages stay free
// to improve (0.1.6).

use "../src/frontend/source_location.npk".*;
use "../src/frontend/token_kind.npk".*;
use "../src/frontend/token.npk".*;
use "../src/frontend/intern.npk".*;
use "../src/frontend/ast_kind.npk".*;
use "../src/frontend/ast.npk".*;
use "../src/frontend/diag_codes.npk".*;
use "../src/frontend/diagnostics.npk".*;
use "../src/frontend/parse_codes.npk".*;
use "../src/frontend/lexer.npk".*;
use "../src/frontend/parser.npk".*;
use "../src/frontend/parse_type.npk".*;
use "../src/frontend/parse_expr.npk".*;
use "../src/frontend/parse_decorate.npk".*;
use "../src/frontend/parse_stmt.npk".*;
use "../src/frontend/parse_pick.npk".*;
use "../src/frontend/parse_decl.npk".*;

func:emit_line = NIL(Diagnostic:d) {
    string:m1 = raw string_concat(d.code, " ");
    string:m2 = raw string_concat(m1, raw int_to_string(d.span.line => int64));
    string:m3 = raw string_concat(m2, ":");
    string:m4 = raw string_concat(m3, raw int_to_string(d.span.col => int64));
    string:m5 = raw string_concat(m4, "\n");
    drop write_raw(1i32, m5.ptr, m5.len);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    // `raw`, not `relay`: `main` returns a bare int32 and leaves through `exit`,
    // so there is no Result to relay into.
    Result<string>:input = read_stdin();
    if (input.is_error) {
        exit 2i32;
    }
    string:text = input.value;

    InternTable:it = raw intern_init();

    // The LEXER and the PARSER get separate diagnostic lists on purpose. A file
    // whose lexer failed will produce parse errors that are artefacts of the
    // broken token stream, and merging the two would let a single bad escape
    // look like a grammar problem.
    DiagList:lexed = raw diaglist_init();
    TokenList:toks = raw lex_all(0i32, text, @it, @lexed);

    Ast:ast = raw ast_init();
    DiagList:parsed = raw diaglist_init();
    Parser:p = raw parser_init(@toks, @ast, @parsed, @it);
    drop p_parse_module(@p);

    int64:n = 0i64;
    int64:i = 0i64;
    while (i < (raw diaglist_count(@lexed))) {
        drop emit_line(raw diaglist_at(@lexed, i));
        n = n + 1i64;
        i = i + 1i64;
    }
    i = 0i64;
    while (i < (raw diaglist_count(@parsed))) {
        drop emit_line(raw diaglist_at(@parsed, i));
        n = n + 1i64;
        i = i + 1i64;
    }

    if (n != 0i64) {
        exit 1i32;
    }
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) {
    // Reaching here means the parser itself failed, which is a defect in the
    // compiler and not in the file being parsed. A distinct code so the harness
    // never reports it as "this test file has a parse error".
    exit 3i32;
};
