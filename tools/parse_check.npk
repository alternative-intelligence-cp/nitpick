// parse_check -- parse a Nitpick source file and report.
//
// Cycle 0.2.7. Not part of the compiler: this is the harness's way of asking the
// REAL parser a question about a REAL file.
//
// It exists for D-085. `tests/rejection/` holds files that must **parse cleanly
// and be refused later**, and until now that rule was checked against the seed's
// parser -- the throwaway one -- while the rule was written about this one. A
// suite that tests the wrong parser tests nothing.
//
// Exit codes are the interface, so the harness never parses prose:
//
//   0   parsed with no diagnostics
//   1   parsed with diagnostics (the count and codes go to stdout)
//   2   could not read the file -- the errno goes to stdout
//
// Output is one line per diagnostic, `CODE line:col`. Codes and spans only --
// the harness asserts on those and never on message text, so messages stay free
// to improve (0.1.6).

use "../lib/nio.npk".*;
use "../src/frontend/source_location.npk".*;
use "../src/frontend/token_kind.npk".*;
use "../src/frontend/token.npk".*;
use "../src/frontend/intern.npk".*;
use "../src/frontend/ast_kind.npk".*;
use "../src/frontend/ast.npk".*;
use "../src/frontend/diag_codes.npk".*;
use "../src/frontend/diagnostics.npk".*;
use "../src/frontend/parse_codes.npk".*;
use "../src/frontend/lexer.npk".*;
use "../src/frontend/parser.npk".*;
use "../src/frontend/parse_type.npk".*;
use "../src/frontend/parse_expr.npk".*;
use "../src/frontend/parse_decorate.npk".*;
use "../src/frontend/parse_stmt.npk".*;
use "../src/frontend/parse_pick.npk".*;
use "../src/frontend/parse_decl.npk".*;
use "../src/frontend/source.npk".*;
use "../src/frontend/types.npk".*;

func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) {
        NioW:uw = raw nio_stderr();
        nio_line(@uw, "usage: parse_check <file.npk>") ?| NIL;
        exit 2i32;
    }

    // argv arrives as `cstring` -- kernel-supplied and NUL-terminated (D-089).
    // The source manager works in `string`, so the path converts once, here.
    cstring:arg = argv[1i64];
    string:path = string_from_bytes(arg.ptr, arg.len);

    SourceManager:sm = raw srcmgr_init();
    // `raw`, not `relay`: `main` returns a bare int32 and leaves through `exit`,
    // so there is no Result to relay into.
    // `move` — `srcmgr_load` takes the path as a `move string` (the manager
    // keeps it for the process's life), `path` is dead after this line, and
    // the seed never checked the transfer. D-183's move-only rule is the real
    // compiler's, and `tools/` meets it for the first time at the 1.4.6 switch
    // exactly as `tests/` does.
    Result<int32>:loaded = srcmgr_load(@sm, move(path));
    if (loaded.is_error) {
        // An `Error` is an identity, not a number (D-179) — say WHICH of the
        // two identities the loader can hand back, and no more.
        string:e = "unknown";
        if (loaded.err == FileUnknown) { e = "no such file"; }
        if (loaded.err == IoEof)       { e = "end of input"; }
        NioW:ew = raw nio_stderr();
        nio_put(@ew, "cannot read: ") ?| NIL;
        nio_line(@ew, e) ?| NIL;
        exit 2i32;
    }
    int32:file = loaded.value;
    string:text = raw srcmgr_text_proven(@sm, file);

    InternTable:it = raw intern_init();

    // The LEXER and the PARSER get separate diagnostic lists on purpose. A file
    // whose lexer failed will produce parse errors that are artefacts of the
    // broken token stream, and merging the two would let a single bad escape
    // look like a grammar problem.
    DiagList:lexed = raw diaglist_init();
    TokenList:toks = raw lex_all(file, text, @it, @lexed);

    Ast:ast = raw ast_init();
    DiagList:parsed = raw diaglist_init();
    Parser:p = raw parser_init(@toks, @ast, @parsed, @it);
    discard(raw p_parse_module(@p));

    int64:n = 0i64;
    int64:i = 0i64;
    NioW:ew = raw nio_stderr();
    while (i < (raw diaglist_count(@lexed))) {
        nio_line(@ew, raw diag_line(raw diaglist_at(@lexed, i), @sm)) ?| NIL;
        n = n + 1i64;
        i = i + 1i64;
    }
    i = 0i64;
    while (i < (raw diaglist_count(@parsed))) {
        nio_line(@ew, raw diag_line(raw diaglist_at(@parsed, i), @sm)) ?| NIL;
        n = n + 1i64;
        i = i + 1i64;
    }

    if (n != 0i64) {
        exit 1i32;
    }
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    // Every defect family this program can die from, NAMED
    // (D-179) — the doctrine applied to ourselves. Exit 3 for
    // each: a defect in the COMPILER, never the input's error.
    pick (e) {
        (DeadlineExceeded) { exit 3i32; },
        (DivByZero) { exit 3i32; },
        (DivOverflow) { exit 3i32; },
        (HeapBadRequest) { exit 3i32; },
        (HeapOom) { exit 3i32; },
        (IntOverflow) { exit 3i32; },
        (OutOfBounds) { exit 3i32; },
        (Unreachable) { exit 3i32; },
        (WildLeak) { exit 3i32; },
        (ast.BoundsId) { exit 3i32; },
        (ast.BoundsScratch) { exit 3i32; },
        (ast.BoundsWindow) { exit 3i32; },
        (diagnostics.BoundsId) { exit 3i32; },
        (intern.BoundsId) { exit 3i32; },
        (intern.ProvenSlice) { exit 3i32; },
        (source.BoundsIndex) { exit 3i32; },
        (source.BoundsOffset) { exit 3i32; },
        (source.FileUnknown) { exit 3i32; },
        (token.BoundsId) { exit 3i32; },
        (types.BoundsId) { exit 3i32; },
        (types.BoundsIndex) { exit 3i32; },
        (*) { exit 3i32; }
    }
    exit 3i32;
};
