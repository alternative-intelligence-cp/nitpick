// ntensor — the runtime-dimensioned containers (D-200, 1.3.7).
//
// `matrix<T>` is `{cells, rows, cols}` and `tensor<T>` caps its rank at 9
// with the dims INLINE — one allocation, and rank 9 is Nikola's manifold by
// construction. Both OWN their heap cell through the `buffer` field, so the
// 1.2 managed regime drops them with no code here — the exit-time leak
// registry proves it in every test that exits 0. Dimensions are `int64`
// (D-200: Nikola-scale tensors against a 2^31 ceiling is a foreseeable
// regret). `tmatrix`/`ttensor` are NOT separate types: they are
// `matrix<tryte>` / `tensor<tryte>` — D-200's own words, the same
// containers over `tryte`.
//
// Element access is `#ptr_add<T>` over the buffer's bytes — the general
// mechanism (D-187), not a per-width verb family — and every index is
// BOUNDS-CHECKED here, failing with this library's own declared errors:
// the buffer's body is in-bounds by construction, so the check at the rim
// is the whole discipline.

mod:ntensor;

error:BadIndex;
error:BadShape;

pub struct:matrix<T> = {
    buffer:cells;
    int64:rows;
    int64:cols;
};

// The zeroed rows×cols matrix. A non-positive dimension refuses — a
// zero-extent matrix has no cell to own, and asking for one is a shape
// mistake, not an allocation.
pub func:mat_of<T> = matrix<T>(int64:rows, int64:cols) {
    if (rows <= 0i64) { fail BadShape; }
    if (cols <= 0i64) { fail BadShape; }
    buffer:b = buffer_new(rows * cols * #size_of<T>());
    matrix<T>:out = matrix{ cells: move(b), rows: rows, cols: cols };
    pass out;
};

impl:<T>:matrix<T> = {
    func:get = T(matrix<T>->:self, int64:r, int64:c) {
        if (r < 0i64)          { fail BadIndex; }
        if (r >= self.rows)    { fail BadIndex; }
        if (c < 0i64)          { fail BadIndex; }
        if (c >= self.cols)    { fail BadIndex; }
        pass (<-(#ptr_add<T>(self.cells.ptr, (r * self.cols) + c)));
    };
    func:set = NIL(matrix<T>->:self, int64:r, int64:c, T:v) {
        if (r < 0i64)          { fail BadIndex; }
        if (r >= self.rows)    { fail BadIndex; }
        if (c < 0i64)          { fail BadIndex; }
        if (c >= self.cols)    { fail BadIndex; }
        <-(#ptr_add<T>(self.cells.ptr, (r * self.cols) + c)) = v;
        pass NIL;
    };
};

pub struct:tensor<T> = {
    buffer:cells;
    int64:ndims;
    int64[9]:dims;
};

// The zeroed tensor over up to NINE dimensions, dims handed in as a slice.
// Rank 0 and rank 10 are both shape mistakes; so is any non-positive
// extent.
pub func:tensor_of<T> = tensor<T>(int64[]:dims) {
    if (dims.len <= 0i64) { fail BadShape; }
    if (dims.len > 9i64)  { fail BadShape; }
    int64[9]:d = [0i64, 0i64, 0i64, 0i64, 0i64, 0i64, 0i64, 0i64, 0i64];
    int64:total = 1i64;
    int64:i = 0i64;
    while (i < dims.len) {
        if (dims[i] <= 0i64) { fail BadShape; }
        d[i] = dims[i];
        total = total * dims[i];
        i = i + 1i64;
    }
    buffer:b = buffer_new(total * #size_of<T>());
    tensor<T>:out = tensor{ cells: move(b), ndims: dims.len, dims: d };
    pass out;
};

// Row-major flat offset for an index tuple, bounds-checked per axis; the
// arity must match the rank exactly.
func:tensor_offset<T> = int64(tensor<T>->:self, int64[]:idx) {
    if (idx.len != self.ndims) { fail BadIndex; }
    int64:off = 0i64;
    int64:i = 0i64;
    while (i < self.ndims) {
        if (idx[i] < 0i64)             { fail BadIndex; }
        if (idx[i] >= self.dims[i])    { fail BadIndex; }
        off = (off * self.dims[i]) + idx[i];
        i = i + 1i64;
    }
    pass off;
};

impl:<T>:tensor<T> = {
    func:get = T(tensor<T>->:self, int64[]:idx) {
        int64:off = relay tensor_offset::<T>(self, idx);
        pass (<-(#ptr_add<T>(self.cells.ptr, off)));
    };
    func:set = NIL(tensor<T>->:self, int64[]:idx, T:v) {
        int64:off = relay tensor_offset::<T>(self, idx);
        <-(#ptr_add<T>(self.cells.ptr, off)) = v;
        pass NIL;
    };
};
