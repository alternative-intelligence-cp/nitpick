// irscan -- the three text scans every emitted module passes before `llc`
// (1.4.8; the third at 1.5.0): no symbol defined twice (D-156), every
// `alloca` in its entry block (D-173), no `undef` anywhere (D-218.10).
// Ported from the harness's `check_symbols_unique`, `check_allocas_hoisted`
// and `check_no_undef`, whose regexes are spelled out here as byte walks;
// the parity stage holds the two to each other.
//
//   DEFINE_RE  ^\s*define[^@]*(@(?:"[^"]*"|[\w.$-]+))\s*\(
//   GLOBAL_RE  ^\s*(@(?:"[^"]*"|[\w.$-]+))\s*=\s*(?!.*\bexternal\b)
//   ALLOCA     ^%\S+ = alloca

mod:irscan;

use "./text.npk".*;
use "./strset.npk".*;

func:is_sym_byte = bool(uint8:c) never fails {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }
    if ((c >= 65u8) && (c <= 90u8))  { pass true; }
    if ((c >= 48u8) && (c <= 57u8))  { pass true; }
    if (c == 95u8) { pass true; }   // _
    if (c == 46u8) { pass true; }   // .
    if (c == 36u8) { pass true; }   // $
    if (c == 45u8) { pass true; }   // -
    pass false;
};

// A symbol starting at the `@` at `at`: the offset just past it, or -1.
func:sym_end = int64(string:s, int64:at) never fails {
    int64:i = at + 1i64;
    if (i >= s.len) { pass (0i64 - 1i64); }
    if (s.ptr[i] == 34u8) {
        int64:close = raw text_find_byte(s, 34u8, i + 1i64);
        if (close < 0i64) { pass (0i64 - 1i64); }
        pass (close + 1i64);
    }
    int64:j = i;
    while (j < s.len) {
        if (!(raw is_sym_byte(s.ptr[j]))) { break; }
        j = j + 1i64;
    }
    if (j == i) { pass (0i64 - 1i64); }
    pass j;
};

func:skip_ws = int64(string:s, int64:from) never fails {
    int64:i = from;
    while (i < s.len) {
        if (!(raw text_is_ws(s.ptr[i]))) { break; }
        i = i + 1i64;
    }
    pass i;
};

// DEFINE_RE: the defined symbol, or "" when the line is not a define.
pub func:ir_define_sym = string(string:line) never fails {
    int64:i = raw skip_ws(line, 0i64);
    if (!(raw text_starts_with(raw text_slice(line, i, line.len), "define"))) { pass ""; }
    int64:at = raw text_find_byte(line, 64u8, i + 6i64);
    if (at < 0i64) { pass ""; }
    int64:e = raw sym_end(line, at);
    if (e < 0i64) { pass ""; }
    int64:p = raw skip_ws(line, e);
    if (p >= line.len) { pass ""; }
    if (line.ptr[p] != 40u8) { pass ""; }
    pass (raw text_slice(line, at, e));
};

// `\bexternal\b` anywhere in `rest`.
func:has_word_external = bool(string:rest) never fails {
    int64:from = 0i64;
    while (true) {
        int64:p = raw text_index_from(rest, "external", from);
        if (p < 0i64) { pass false; }
        bool:left_ok = true;
        if (p > 0i64) {
            uint8:b = rest.ptr[p - 1i64];
            bool:w = false;
            if ((b >= 97u8) && (b <= 122u8)) { w = true; }
            if ((b >= 65u8) && (b <= 90u8))  { w = true; }
            if ((b >= 48u8) && (b <= 57u8))  { w = true; }
            if (b == 95u8) { w = true; }
            if (w) { left_ok = false; }
        }
        bool:right_ok = true;
        int64:after = p + 8i64;
        if (after < rest.len) {
            uint8:a = rest.ptr[after];
            bool:w2 = false;
            if ((a >= 97u8) && (a <= 122u8)) { w2 = true; }
            if ((a >= 65u8) && (a <= 90u8))  { w2 = true; }
            if ((a >= 48u8) && (a <= 57u8))  { w2 = true; }
            if (a == 95u8) { w2 = true; }
            if (w2) { right_ok = false; }
        }
        if (left_ok && right_ok) { pass true; }
        from = p + 1i64;
    }
    pass false;
};

// GLOBAL_RE: the defined global's symbol, or "".
pub func:ir_global_sym = string(string:line) never fails {
    int64:i = raw skip_ws(line, 0i64);
    if (i >= line.len) { pass ""; }
    if (line.ptr[i] != 64u8) { pass ""; }
    int64:e = raw sym_end(line, i);
    if (e < 0i64) { pass ""; }
    int64:p = raw skip_ws(line, e);
    if (p >= line.len) { pass ""; }
    if (line.ptr[p] != 61u8) { pass ""; }
    int64:q = raw skip_ws(line, p + 1i64);
    if (raw has_word_external(raw text_slice(line, q, line.len))) { pass ""; }
    pass (raw text_slice(line, i, e));
};

// No symbol may be DEFINED twice in one emitted module (D-156).
pub func:ir_symbols_unique = List<string>(string:ir, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    StrSet:seen = raw strset_init(1024i64);
    List<string>:dupes = raw list_init::<string>(2i64);
    for (int64:round_no in 0i64...2i64) {
        for (int64:i in 0i64...lines.count) {
            string:ln = raw strlist_view(lines, i);
            string:sym = "";
            if (round_no == 0i64) { sym = raw ir_define_sym(ln); }
            else { sym = raw ir_global_sym(ln); }
            if (sym.len == 0i64) { continue; }
            if (!(raw strset_add(@seen, sym))) { drop strlist_push(@dupes, sym); }
        }
    }
    drop strset_free(@seen);
    if (dupes.count == 0i64) { pass fl; }
    List<string>:sorted = raw strlist_sorted_unique(dupes);
    string:m = string_concat(name, ": ");
    m = string_concat(m, raw text_join(sorted, ", "));
    m = string_concat(m, " defined more than once in one module -- the emitter produced two definitions of one symbol, which is invalid LLVM and means two declarations rendered the same name (D-156)");
    drop list_push(@fl, move(m));
    pass fl;
};

// Every `alloca` is in its function's entry block (D-173).
pub func:ir_allocas_hoisted = List<string>(string:ir, string:name) never fails {
    List<string>:bad = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    string:fn = "";
    bool:have_fn = false;
    bool:in_entry = false;
    for (int64:i in 0i64...lines.count) {
        string:raw_line = raw strlist_view(lines, i);
        string:line = raw text_trim(raw_line);
        string:d = raw ir_define_sym(raw_line);
        if (d.len > 0i64) {
            fn = raw text_copy(d);
            have_fn = true;
            in_entry = false;
            continue;
        }
        if (!have_fn) { continue; }
        if (raw text_eq(line, "entry:")) { in_entry = true; continue; }
        if (raw text_ends_with(line, ":")) {
            if ((raw text_find_byte(line, 32u8, 0i64)) < 0i64) { in_entry = false; continue; }
        }
        if (raw text_starts_with(line, "br ")) { in_entry = false; continue; }
        if (raw text_starts_with(line, "ret ")) { in_entry = false; continue; }
        if (raw text_eq(line, "unreachable")) { in_entry = false; continue; }
        // `%\S+ = alloca `
        if (line.len > 0i64) {
            if (line.ptr[0i64] == 37u8) {
                int64:j = 1i64;
                while (j < line.len) {
                    if (raw text_is_ws(line.ptr[j])) { break; }
                    j = j + 1i64;
                }
                if (j > 1i64) {
                    if (raw text_starts_with(raw text_slice(line, j, line.len), " = alloca ")) {
                        if (!in_entry) {
                            string:m = string_concat(name, ": `");
                            m = string_concat(m, line);
                            m = string_concat(m, "` in `");
                            m = string_concat(m, fn);
                            m = string_concat(m, "` is not in the entry block -- an alloca in a loop body overflows the stack over a large input; route it through irw_alloca (D-173)");
                            drop list_push(@bad, move(m));
                        }
                    }
                }
            }
        }
    }
    pass bad;
};

// --- no `undef`, anywhere (D-218.10, 1.5.0) -------------------------------------
//
// The harness's `check_no_undef`, byte for byte. A line's CODE is the text up
// to its comment with every string constant's contents blanked: a `;` starts
// a comment only outside a string constant (`c"…"`, where `;` is data and a
// quote is spelled `\22`), and the bytes inside one are data too -- the
// compiler's own emission carries the literal `"undef"` its source spells.
// Then the token: `undef` with no identifier byte on either side (`%undef` is
// a value's name, `@undef_x` a symbol's). `poison` is not banned here: LLVM's
// own value model uses it, and 1.6 may need `freeze`.

func:is_ir_word_byte = bool(uint8:c) never fails {
    if (raw is_sym_byte(c)) { pass true; }
    if (c == 37u8) { pass true; }   // %
    if (c == 64u8) { pass true; }   // @
    pass false;
};

// The line's code part: comment cut, string contents blanked.
func:ir_code_part = string(string:line) never fails {
    wild int8->:buf = alloc(line.len + 1i64);
    int64:n = 0i64;
    bool:in_str = false;
    for (int64:i in 0i64...line.len) {
        uint8:c = line.ptr[i];
        if (c == 34u8) {
            in_str = !in_str;
            buf[n] = c =>! int8;
            n = n + 1i64;
            continue;
        }
        if (in_str) { buf[n] = 32i8; n = n + 1i64; continue; }
        if (c == 59u8) { break; }
        buf[n] = c =>! int8;
        n = n + 1i64;
    }
    string:out = string_concat(string_from_bytes(buf, n), "");
    dalloc(buf);
    pass out;
};

// Every line's code part, joined: what a count of instructions must run over
// (the compiler's own emission spells its guard calls as STRING CONSTANTS).
pub func:ir_code_all = string(string:ir) never fails {
    List<string>:lines = raw text_lines(ir);
    List<string>:code = raw list_init::<string>(lines.count + 1i64);
    for (int64:i in 0i64...lines.count) {
        drop list_push(@code, raw ir_code_part(raw strlist_view(lines, i)));
    }
    pass (raw text_join(code, "\n"));
};

// How many `undef` tokens a code line holds.
func:undef_tokens = int64(string:code) never fails {
    int64:n = 0i64;
    int64:from = 0i64;
    while (true) {
        int64:p = raw text_index_from(code, "undef", from);
        if (p < 0i64) { pass n; }
        bool:left_ok = true;
        if (p > 0i64) { if (raw is_ir_word_byte(code.ptr[p - 1i64])) { left_ok = false; } }
        bool:right_ok = true;
        int64:after = p + 5i64;
        if (after < code.len) { if (raw is_sym_byte(code.ptr[after])) { right_ok = false; } }
        if (left_ok && right_ok) { n = n + 1i64; }
        from = p + 1i64;
    }
    pass n;
};

pub func:ir_no_undef = List<string>(string:ir, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    int64:hits = 0i64;
    int64:first_line = 0i64;
    string:first_text = "";
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (!(raw text_contains(ln, "undef"))) { continue; }
        string:code = raw ir_code_part(ln);
        int64:k = raw undef_tokens(code);
        if (k == 0i64) { continue; }
        if (hits == 0i64) {
            first_line = i + 1i64;
            first_text = raw text_head(raw text_trim(code), 120i64);
        }
        hits = hits + k;
    }
    if (hits == 0i64) { pass fl; }
    string:m = string_concat(name, ": `undef` appears ");
    m = string_concat(m, int_to_string(hits));
    m = string_concat(m, " time(s) in the IR (first at line ");
    m = string_concat(m, int_to_string(first_line));
    m = string_concat(m, ": `");
    m = string_concat(m, first_text);
    m = string_concat(m, "`) -- the emitter and the floor seed every aggregate with `zeroinitializer` (D-218.10); an `undef` is a value the optimiser may choose differently per use, which breaks the refinement checking the evidence campaign rests on");
    drop list_push(@fl, move(m));
    pass fl;
};
