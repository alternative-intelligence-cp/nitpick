// irscan -- the three text scans every emitted module passes before `llc`
// (1.4.8; the third at 1.5.0): no symbol defined twice (D-156), every
// `alloca` in its entry block (D-173), no `undef` anywhere (D-218.10).
// Ported from the harness's `check_symbols_unique`, `check_allocas_hoisted`
// and `check_no_undef`, whose regexes are spelled out here as byte walks;
// the parity stage holds the two to each other.
//
//   DEFINE_RE  ^\s*define[^@]*(@(?:"[^"]*"|[\w.$-]+))\s*\(
//   GLOBAL_RE  ^\s*(@(?:"[^"]*"|[\w.$-]+))\s*=\s*(?!.*\bexternal\b)
//   ALLOCA     ^%\S+ = alloca

mod:irscan;

use "./text.npk".*;
use "./strset.npk".*;

func:is_sym_byte = bool(uint8:c) never fails {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }
    if ((c >= 65u8) && (c <= 90u8))  { pass true; }
    if ((c >= 48u8) && (c <= 57u8))  { pass true; }
    if (c == 95u8) { pass true; }   // _
    if (c == 46u8) { pass true; }   // .
    if (c == 36u8) { pass true; }   // $
    if (c == 45u8) { pass true; }   // -
    pass false;
};

// A symbol starting at the `@` at `at`: the offset just past it, or -1.
func:sym_end = int64(string:s, int64:at) never fails {
    int64:i = at + 1i64;
    if (i >= s.len) { pass (0i64 - 1i64); }
    if (s.ptr[i] == 34u8) {
        int64:close = raw text_find_byte(s, 34u8, i + 1i64);
        if (close < 0i64) { pass (0i64 - 1i64); }
        pass (close + 1i64);
    }
    int64:j = i;
    while (j < s.len) decreases s.len - j {
        if (!(raw is_sym_byte(s.ptr[j]))) { break; }
        j = j + 1i64;
    }
    if (j == i) { pass (0i64 - 1i64); }
    pass j;
};

func:skip_ws = int64(string:s, int64:from) never fails {
    int64:i = from;
    while (i < s.len) decreases s.len - i {
        if (!(raw text_is_ws(s.ptr[i]))) { break; }
        i = i + 1i64;
    }
    pass i;
};

// DEFINE_RE: the defined symbol, or "" when the line is not a define.
pub func:ir_define_sym = string(string:line) never fails {
    int64:i = raw skip_ws(line, 0i64);
    if (!(raw text_starts_with(raw text_slice(line, i, line.len), "define"))) { pass ""; }
    int64:at = raw text_find_byte(line, 64u8, i + 6i64);
    if (at < 0i64) { pass ""; }
    int64:e = raw sym_end(line, at);
    if (e < 0i64) { pass ""; }
    int64:p = raw skip_ws(line, e);
    if (p >= line.len) { pass ""; }
    if (line.ptr[p] != 40u8) { pass ""; }
    pass (raw text_slice(line, at, e));
};

// `\bexternal\b` anywhere in `rest`.
func:has_word_external = bool(string:rest) never fails {
    int64:from = 0i64;
    while (true) decreases rest.len - from {
        int64:p = raw text_index_from(rest, "external", from);
        if (p < 0i64) { pass false; }
        bool:left_ok = true;
        if (p > 0i64) {
            uint8:b = rest.ptr[p - 1i64];
            bool:w = false;
            if ((b >= 97u8) && (b <= 122u8)) { w = true; }
            if ((b >= 65u8) && (b <= 90u8))  { w = true; }
            if ((b >= 48u8) && (b <= 57u8))  { w = true; }
            if (b == 95u8) { w = true; }
            if (w) { left_ok = false; }
        }
        bool:right_ok = true;
        int64:after = p + 8i64;
        if (after < rest.len) {
            uint8:a = rest.ptr[after];
            bool:w2 = false;
            if ((a >= 97u8) && (a <= 122u8)) { w2 = true; }
            if ((a >= 65u8) && (a <= 90u8))  { w2 = true; }
            if ((a >= 48u8) && (a <= 57u8))  { w2 = true; }
            if (a == 95u8) { w2 = true; }
            if (w2) { right_ok = false; }
        }
        if (left_ok && right_ok) { pass true; }
        from = p + 1i64;
    }
    pass false;
};

// GLOBAL_RE: the defined global's symbol, or "".
pub func:ir_global_sym = string(string:line) never fails {
    int64:i = raw skip_ws(line, 0i64);
    if (i >= line.len) { pass ""; }
    if (line.ptr[i] != 64u8) { pass ""; }
    int64:e = raw sym_end(line, i);
    if (e < 0i64) { pass ""; }
    int64:p = raw skip_ws(line, e);
    if (p >= line.len) { pass ""; }
    if (line.ptr[p] != 61u8) { pass ""; }
    int64:q = raw skip_ws(line, p + 1i64);
    if (raw has_word_external(raw text_slice(line, q, line.len))) { pass ""; }
    pass (raw text_slice(line, i, e));
};

// No symbol may be DEFINED twice in one emitted module (D-156).
pub func:ir_symbols_unique = List<string>(string:ir, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    StrSet:seen = raw strset_init(1024i64);
    List<string>:dupes = raw list_init::<string>(2i64);
    for (int64:round_no in 0i64...2i64) {
        for (int64:i in 0i64...lines.count) {
            string:ln = raw strlist_view(lines, i);
            string:sym = "";
            if (round_no == 0i64) { sym = raw ir_define_sym(ln); }
            else { sym = raw ir_global_sym(ln); }
            if (sym.len == 0i64) { continue; }
            if (!(raw strset_add(@seen, sym))) { drop strlist_push(@dupes, sym); }
        }
    }
    drop strset_free(@seen);
    if (dupes.count == 0i64) { pass fl; }
    List<string>:sorted = raw strlist_sorted_unique(dupes);
    string:m = string_concat(name, ": ");
    m = string_concat(m, raw text_join(sorted, ", "));
    m = string_concat(m, " defined more than once in one module -- the emitter produced two definitions of one symbol, which is invalid LLVM and means two declarations rendered the same name (D-156)");
    drop list_push(@fl, move(m));
    pass fl;
};

// EVERY PRELUDE DEFINE IS REFERENCED SOMEWHERE ELSE IN THE MODULE (1.5.2d,
// D-262 §1) -- the harness's `check_prelude_trimmed`, byte for byte. The
// emitter brackets each non-generic prelude function, each prelude impl's
// vtable and each prelude generic instance as an item and keeps an item only
// when the module's text references a symbol it defines; a prelude `define`
// nobody names is the trim not running, or an emission path that bypassed
// its brackets. The count is over the WHOLE text, quoted spans included: the
// symbols are D-156 names, quoted (the D-252 lesson).
pub func:ir_prelude_trimmed = List<string>(string:ir, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    List<string>:loose = raw list_init::<string>(2i64);
    for (int64:i in 0i64...lines.count) {
        string:sym = raw ir_define_sym(raw strlist_view(lines, i));
        if (sym.len == 0i64) { continue; }
        if (!(raw text_starts_with(sym, "@\"npk.prelude."))) { continue; }
        int64:hits = 0i64;
        int64:from = 0i64;
        while (hits < 2i64) decreases 2i64 - hits {
            int64:at = raw text_index_from(ir, sym, from);
            if (at < 0i64) { break; }
            hits = hits + 1i64;
            from = at + sym.len;
        }
        if (hits < 2i64) { drop strlist_push(@loose, raw text_copy(sym)); }
    }
    if (loose.count == 0i64) { pass fl; }
    string:m = string_concat(name, ": ");
    m = string_concat(m, int_to_string(loose.count));
    m = string_concat(m, " prelude define(s) referenced nowhere else in the module (first: ");
    m = string_concat(m, raw strlist_view(loose, 0i64));
    m = string_concat(m, ") -- an unreferenced prelude item was emitted (D-262 §1): the trim did not run, or an emission path bypassed its brackets");
    drop list_push(@fl, move(m));
    pass fl;
};

// `s` holds `p` at offset `at`.
func:bytes_at = bool(string:s, int64:at, string:p) never fails {
    if ((at + p.len) > s.len) { pass false; }
    for (int64:k in 0i64...p.len) {
        if (s.ptr[at + k] != p.ptr[k]) { pass false; }
    }
    pass true;
};

// The decimal at `at` (its first nine digits: no site id is longer, and the
// cap is what keeps the read from trapping on an absurd text), and where it
// ends, through `end_out`; -1 and `at` when no digit stands there.
func:digits_at = int64(string:s, int64:at, int64->:end_out) never fails {
    int64:v = 0i64;
    int64:e = at;
    while (e < s.len) decreases s.len - e {
        uint8:g = s.ptr[e];
        if ((g < 48u8) || (g > 57u8)) { break; }
        if (v < 100000000i64) { v = (v * 10i64) + ((g - 48u8) => int64); }
        e = e + 1i64;
    }
    <-end_out = e;
    if (e == at) { pass (0i64 - 1i64); }
    pass v;
};

// A chain-call line's site id -- `call void @npk_chain_reset(i32 N)` or
// `call void @npk_chain_push(i32 N)` after any indentation, the `)` right
// after the digits (the harness's regex) -- or -1 for any other line.
func:site_call_id = int64(string:line) never fails {
    int64:q = 0i64;
    while (q < line.len) decreases line.len - q {
        uint8:c = line.ptr[q];
        if ((c != 32u8) && (c != 9u8)) { break; }
        q = q + 1i64;
    }
    string:a = "call void @npk_chain_reset(i32 ";
    string:b = "call void @npk_chain_push(i32 ";
    int64:d = 0i64 - 1i64;
    if (raw bytes_at(line, q, a)) { d = q + a.len; }
    if ((d < 0i64) && (raw bytes_at(line, q, b))) { d = q + b.len; }
    if (d < 0i64) { pass (0i64 - 1i64); }
    int64:e = 0i64;
    int64:v = raw digits_at(line, d, @e);
    if (v < 0i64) { pass (0i64 - 1i64); }
    if ((e >= line.len) || (line.ptr[e] != 41u8)) { pass (0i64 - 1i64); }   // `)`
    pass v;
};

// How many distinct values a list holds (the no-table report's count; the
// list is short there).
func:distinct_count = int64(List<int32>:l) never fails {
    int64:n = 0i64;
    for (int64:i in 0i64...l.count) {
        bool:seen = false;
        for (int64:j in 0i64...i) {
            if (l[j] == l[i]) { seen = true; break; }
        }
        if (!seen) { n = n + 1i64; }
    }
    pass n;
};

// THE SITE TABLE HOLDS EXACTLY THE SITES THE MODULE'S TEXT REFERENCES (DEF-242,
// 1.6.1e landing 126) -- the harness's `check_site_table_dense`, byte for byte.
// The writer renumbers the kept text's chain sites densely from 1 after the
// trim and writes the tables from that list alone, so the set of ids in the
// module's `call void @npk_chain_reset(i32 N)` / `@npk_chain_push(i32 N)` lines
// must be exactly {1..n} where n+1 is the lines table's length (row 0 is the
// runtime's reserved site). A row nobody references is the renumbering not
// running, or a writer of a chain call that spells the call another way; an id
// past the table is a reference the renumbering missed. A module with no table
// and no call passes (the floor, the shim). Asked of what the compiler under
// test emits and never of the snapshot's emissions (the 1.5.2d rule).
pub func:ir_site_table_dense = List<string>(string:ir, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    string:head = "@npk.site.lines = internal constant [";
    int64:rows = 0i64 - 1i64;
    List<int32>:ids = raw list_init::<int32>(16i64);
    for (int64:i in 0i64...lines.count) {
        string:line = raw strlist_view(lines, i);
        if (raw text_starts_with(line, head)) {
            int64:e = 0i64;
            int64:v = raw digits_at(line, head.len, @e);
            if ((v >= 0i64) && (raw bytes_at(line, e, " x i32]"))) { rows = v; }
            continue;
        }
        int64:id = raw site_call_id(line);
        if (id >= 0i64) { drop list_push(@ids, id =>! int32); }
    }
    if (rows < 0i64) {
        if (ids.count == 0i64) { pass fl; }
        string:m0 = string_concat(name, ": ");
        m0 = string_concat(m0, int_to_string(raw distinct_count(ids)));
        m0 = string_concat(m0, " chain-site id(s) referenced and no site table emitted (DEF-242)");
        drop list_push(@fl, move(m0));
        pass fl;
    }
    int64:n = rows - 1i64;
    List<int32>:seen = raw list_init::<int32>(rows + 1i64);
    for (int64:k in 0i64..n) { drop list_push(@seen, 0i32); }
    List<int32>:past = raw list_init::<int32>(4i64);   // the distinct ids past the table
    for (int64:j in 0i64...ids.count) {
        int64:id = ids[j] => int64;
        if ((id >= 1i64) && (id <= n)) { seen[id] = 1i32; continue; }
        bool:dup = false;
        for (int64:q in 0i64...past.count) {
            if (past[q] == ids[j]) { dup = true; break; }
        }
        if (!dup) { drop list_push(@past, ids[j]); }
    }
    int64:spare = 0i64;
    int64:spare_first = 0i64;
    for (int64:k2 in 1i64..n) {
        if (seen[k2] == 0i32) {
            if (spare == 0i64) { spare_first = k2; }
            spare = spare + 1i64;
        }
    }
    if ((spare == 0i64) && (past.count == 0i64)) { pass fl; }
    int64:past_first = 0i64;
    for (int64:q2 in 0i64...past.count) {
        int64:pv = past[q2] => int64;
        if ((q2 == 0i64) || (pv < past_first)) { past_first = pv; }
    }
    string:m = string_concat(name, ": the site table is not dense against the module's chain calls (DEF-242, landing 126): ");
    if (spare > 0i64) {
        m = string_concat(m, int_to_string(spare));
        m = string_concat(m, " table row(s) referenced by no chain call (first: ");
        m = string_concat(m, int_to_string(spare_first));
        m = string_concat(m, ")");
    }
    if (past.count > 0i64) {
        if (spare > 0i64) { m = string_concat(m, "; "); }
        m = string_concat(m, int_to_string(past.count));
        m = string_concat(m, " chain call(s) naming no table row (first: ");
        m = string_concat(m, int_to_string(past_first));
        m = string_concat(m, ")");
    }
    m = string_concat(m, " -- the renumbering did not run, or a writer spells a chain call another way");
    drop list_push(@fl, move(m));
    pass fl;
};

// EVERY MODULE STATES THE PINNED LAYOUT AND TRIPLE, ONCE EACH, IN THAT ORDER
// (E-8, D-322 (5); 1.6.1 step 1) -- the harness's `check_module_header`, byte
// for byte: the emitter's two header lines, and the floor's and the explorer
// shim's hand-written ones. The layout line is what an analyzer that reads
// the module as it is lays every aggregate out under (NIKOS did, at 1.6.0's
// gate, and read every emission under LLVM's default for want of one); `opt`
// and `llc` derive the same string from the triple, so the object does not
// move for it. The line proves nothing about itself -- `opt` keeps a wrong one
// as written and `llc` accepts one in silence -- which is why the pin is held
// to `opt`'s derivation (`datalayout_pin_check`) and every module to the pin
// here. A `target` line is one that BEGINS the line: a string constant sits
// on an `@` line and a comment on a `;` line. Asked of what the compiler
// under test emits, of the floor and of the shim -- not of the snapshot's
// emissions, the rule every emitted-IR belt keeps (1.5.2d).
pub func:ir_module_header = List<string>(string:ir, string:name, string:triple, string:datalayout) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    List<string>:targets = raw list_init::<string>(2i64);
    for (int64:i in 0i64...lines.count) {
        string:line = raw strlist_view(lines, i);
        if (raw text_starts_with(line, "target ")) { drop strlist_push(@targets, raw text_copy(line)); }
    }
    string:want0 = string_concat("target datalayout = \"", string_concat(datalayout, "\""));
    string:want1 = string_concat("target triple = \"", string_concat(triple, "\""));
    bool:ok = (targets.count == 2i64);
    if (ok) { ok = raw text_eq(raw strlist_view(targets, 0i64), want0); }
    if (ok) { ok = raw text_eq(raw strlist_view(targets, 1i64), want1); }
    if (ok) { pass fl; }
    string:m = string_concat(name, ": the module's header is not the pinned one -- expected `");
    m = string_concat(m, want0);
    m = string_concat(m, "` and `");
    m = string_concat(m, want1);
    m = string_concat(m, "` (nitpick.toml [toolchain]), got ");
    if (targets.count == 0i64) { m = string_concat(m, "no `target` line"); }
    for (int64:k in 0i64...targets.count) {
        if (k > 0i64) { m = string_concat(m, ", "); }
        m = string_concat(m, "`");
        m = string_concat(m, raw strlist_view(targets, k));
        m = string_concat(m, "`");
    }
    m = string_concat(m, " (E-8, D-322 (5): every module of ours states the layout it assumes, and the runners hold it to the pin)");
    drop list_push(@fl, move(m));
    pass fl;
};

// Every `alloca` is in its function's entry block (D-173).
pub func:ir_allocas_hoisted = List<string>(string:ir, string:name) never fails {
    List<string>:bad = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    string:fn = "";
    bool:have_fn = false;
    bool:in_entry = false;
    for (int64:i in 0i64...lines.count) {
        string:raw_line = raw strlist_view(lines, i);
        string:line = raw text_trim(raw_line);
        string:d = raw ir_define_sym(raw_line);
        if (d.len > 0i64) {
            fn = raw text_copy(d);
            have_fn = true;
            in_entry = false;
            continue;
        }
        if (!have_fn) { continue; }
        if (raw text_eq(line, "entry:")) { in_entry = true; continue; }
        if (raw text_ends_with(line, ":")) {
            if ((raw text_find_byte(line, 32u8, 0i64)) < 0i64) { in_entry = false; continue; }
        }
        if (raw text_starts_with(line, "br ")) { in_entry = false; continue; }
        if (raw text_starts_with(line, "ret ")) { in_entry = false; continue; }
        if (raw text_eq(line, "unreachable")) { in_entry = false; continue; }
        // `%\S+ = alloca `
        if (line.len > 0i64) {
            if (line.ptr[0i64] == 37u8) {
                int64:j = 1i64;
                while (j < line.len) decreases line.len - j {
                    if (raw text_is_ws(line.ptr[j])) { break; }
                    j = j + 1i64;
                }
                if (j > 1i64) {
                    if (raw text_starts_with(raw text_slice(line, j, line.len), " = alloca ")) {
                        if (!in_entry) {
                            string:m = string_concat(name, ": `");
                            m = string_concat(m, line);
                            m = string_concat(m, "` in `");
                            m = string_concat(m, fn);
                            m = string_concat(m, "` is not in the entry block -- an alloca in a loop body overflows the stack over a large input; route it through irw_alloca (D-173)");
                            drop list_push(@bad, move(m));
                        }
                    }
                }
            }
        }
    }
    pass bad;
};

// --- no `undef`, anywhere (D-218.10, 1.5.0) -------------------------------------
//
// The harness's `check_no_undef`, byte for byte. A line's CODE is the text up
// to its comment with every string constant's contents blanked: a `;` starts
// a comment only outside a string constant (`c"…"`, where `;` is data and a
// quote is spelled `\22`), and the bytes inside one are data too -- the
// compiler's own emission carries the literal `"undef"` its source spells.
// Then the token: `undef` with no identifier byte on either side (`%undef` is
// a value's name, `@undef_x` a symbol's). `poison` is not banned here: LLVM's
// own value model uses it, and 1.6 may need `freeze`.

func:is_ir_word_byte = bool(uint8:c) never fails {
    if (raw is_sym_byte(c)) { pass true; }
    if (c == 37u8) { pass true; }   // %
    if (c == 64u8) { pass true; }   // @
    pass false;
};

// The line's code part: comment cut, string contents blanked.
func:ir_code_part = string(string:line) never fails {
    wild int8->:buf = alloc(line.len + 1i64);
    int64:n = 0i64;
    bool:in_str = false;
    for (int64:i in 0i64...line.len) {
        uint8:c = line.ptr[i];
        if (c == 34u8) {
            in_str = !in_str;
            buf[n] = c =>! int8;
            n = n + 1i64;
            continue;
        }
        if (in_str) { buf[n] = 32i8; n = n + 1i64; continue; }
        if (c == 59u8) { break; }
        buf[n] = c =>! int8;
        n = n + 1i64;
    }
    string:out = string_concat(string_from_bytes(buf, n), "");
    dalloc(buf);
    pass out;
};

// Every line's code part, joined: what a count of instructions must run over
// (the compiler's own emission spells its guard calls as STRING CONSTANTS).
pub func:ir_code_all = string(string:ir) never fails {
    List<string>:lines = raw text_lines(ir);
    List<string>:code = raw list_init::<string>(lines.count + 1i64);
    for (int64:i in 0i64...lines.count) {
        drop list_push(@code, raw ir_code_part(raw strlist_view(lines, i)));
    }
    pass (raw text_join(code, "\n"));
};

// The line's SYMBOL part: the comment stripped and only a `c"…"` constant's
// contents blanked -- a quoted symbol name (`@"npk.m.f.body"`) survives
// whole, so a count of a spelling INSIDE a D-156 symbol can read it.
// `ir_code_part` blanks every quoted span, which is right for the `undef`
// ban and wrong for the bypass belt: 1.5.2 step 4's first full run counted
// no `.body` use in any emission because the names were blanks. A quote
// inside either kind of span is spelled `\22`, so a raw quote always toggles.
func:ir_symbol_part = string(string:line) never fails {
    wild int8->:buf = alloc(line.len + 1i64);
    int64:n = 0i64;
    bool:in_str = false;
    bool:blank = false;
    for (int64:i in 0i64...line.len) {
        uint8:c = line.ptr[i];
        if (c == 34u8) {
            if (!in_str) {
                blank = false;
                if (i > 0i64) { if (line.ptr[i - 1i64] == 99u8) { blank = true; } }   // c"
            }
            in_str = !in_str;
            buf[n] = c =>! int8;
            n = n + 1i64;
            continue;
        }
        if (in_str) {
            if (blank) { buf[n] = 32i8; } else { buf[n] = c =>! int8; }
            n = n + 1i64;
            continue;
        }
        if (c == 59u8) { break; }
        buf[n] = c =>! int8;
        n = n + 1i64;
    }
    string:out = string_concat(string_from_bytes(buf, n), "");
    dalloc(buf);
    pass out;
};

// Every line's symbol part, joined: what the bypass belt runs over.
pub func:ir_symbol_all = string(string:ir) never fails {
    List<string>:lines = raw text_lines(ir);
    List<string>:syms = raw list_init::<string>(lines.count + 1i64);
    for (int64:i in 0i64...lines.count) {
        drop list_push(@syms, raw ir_symbol_part(raw strlist_view(lines, i)));
    }
    pass (raw text_join(syms, "\n"));
};

// How many `undef` tokens a code line holds.
func:undef_tokens = int64(string:code) never fails {
    int64:n = 0i64;
    int64:from = 0i64;
    while (true) decreases code.len - from {
        int64:p = raw text_index_from(code, "undef", from);
        if (p < 0i64) { pass n; }
        bool:left_ok = true;
        if (p > 0i64) { if (raw is_ir_word_byte(code.ptr[p - 1i64])) { left_ok = false; } }
        bool:right_ok = true;
        int64:after = p + 5i64;
        if (after < code.len) { if (raw is_sym_byte(code.ptr[after])) { right_ok = false; } }
        if (left_ok && right_ok) { n = n + 1i64; }
        from = p + 1i64;
    }
    pass n;
};

pub func:ir_no_undef = List<string>(string:ir, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    List<string>:lines = raw text_lines(ir);
    int64:hits = 0i64;
    int64:first_line = 0i64;
    string:first_text = "";
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (!(raw text_contains(ln, "undef"))) { continue; }
        string:code = raw ir_code_part(ln);
        int64:k = raw undef_tokens(code);
        if (k == 0i64) { continue; }
        if (hits == 0i64) {
            first_line = i + 1i64;
            first_text = raw text_head(raw text_trim(code), 120i64);
        }
        hits = hits + k;
    }
    if (hits == 0i64) { pass fl; }
    string:m = string_concat(name, ": `undef` appears ");
    m = string_concat(m, int_to_string(hits));
    m = string_concat(m, " time(s) in the IR (first at line ");
    m = string_concat(m, int_to_string(first_line));
    m = string_concat(m, ": `");
    m = string_concat(m, first_text);
    m = string_concat(m, "`) -- the emitter and the floor seed every aggregate with `zeroinitializer` (D-218.10); an `undef` is a value the optimiser may choose differently per use, which breaks the refinement checking the evidence campaign rests on");
    drop list_push(@fl, move(m));
    pass fl;
};
