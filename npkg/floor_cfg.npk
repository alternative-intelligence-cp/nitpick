// floor_cfg -- the floor's control-flow graph as the translator needs it
// (1.5.6 step 3; D-288): the loops of a function (a back edge is an edge
// into a block that dominates its source; a loop's members are the blocks
// that reach the back edge's source without passing its header), a reverse
// postorder over the graph with the back edges removed (the order in which
// every block's forward predecessors precede it -- the translator's
// dominance order), and the two transforms the plan names: INLINING (a
// callee's blocks spliced at the call, its registers and labels prefixed,
// its parameters replaced by the arguments as text) and UNROLLING (a loop's
// blocks copied N+1 times, copy k's back edges retargeted at copy k+1's
// header, copy N's at a synthetic `stop` block the translator treats as a
// bound). Both are text transforms over `floor_ir.npk`'s lines: the
// translator (`floor_smt.npk`) then reads ONE acyclic-or-cut graph and never
// meets a call to a floor define or an unrolled loop.
//
// A copied block remembers where it came from (`BMeta`: the function and
// label it was cloned from, and a rename environment mapping the original
// register names to the copy's), so a loop annotation written for the
// original -- `(loop head (invariant ...))` in the callee's or the loop's
// own section -- is found and rendered for the copy.

mod:floor_cfg;

use "./text.npk".*;
use "./floor_ir.npk".*;
use "./floor_instr.npk".*;
use "./floor_shared.npk".*;   // floor_dominators

// One loop: its header, its latches (the sources of its back edges), its
// members (the header included).
pub struct:FLoop = {
    int64:header;
    List<int64>:latches;
    List<int64>:members;
};

func:has_int = bool(List<int64>:l, int64:v) never fails {
    for (int64:i in 0i64...l.count) { if (l[i] == v) { pass true; } }
    pass false;
};

// Every back edge (s -> h) of `f`, grouped by header: `h` dominates `s`.
pub func:floor_loops = List<FLoop>(FFn->:f) never fails {
    int64:n = f.blocks.count;
    List<int32>:dom = raw floor_dominators(f);
    List<FLoop>:out = raw list_init::<FLoop>(4i64);
    for (int64:s in 0i64...n) {
        for (int64:k in 0i64...f.blocks[s].succs.count) {
            int64:h = f.blocks[s].succs[k];
            if (dom[s * n + h] != 1i32) { continue; }
            // find or make the loop of header h
            int64:li = 0i64 - 1i64;
            for (int64:j in 0i64...out.count) { if (out[j].header == h) { li = j; } }
            if (li < 0i64) {
                FLoop:l = FLoop{ header: h, latches: raw list_init::<int64>(2i64), members: raw list_init::<int64>(8i64) };
                drop list_push(@out, move(l));
                li = out.count - 1i64;
            }
            if (!(raw has_int(out[li].latches, s))) { drop list_push(@out[li].latches, s); }
        }
    }
    // members: from each latch backwards over predecessors, not crossing the header
    for (int64:li2 in 0i64...out.count) {
        int64:h2 = out[li2].header;
        drop list_push(@out[li2].members, h2);
        List<int64>:work = raw list_init::<int64>(8i64);
        for (int64:a in 0i64...out[li2].latches.count) {
            int64:s2 = out[li2].latches[a];
            if (!(raw has_int(out[li2].members, s2))) {
                drop list_push(@out[li2].members, s2);
                drop list_push(@work, s2);
            }
        }
        while (work.count > 0i64) {
            int64:b = raw list_pop(@work);
            // every predecessor p of b
            for (int64:p in 0i64...n) {
                if (!(raw has_int(f.blocks[p].succs, b))) { continue; }
                if (raw has_int(out[li2].members, p)) { continue; }
                drop list_push(@out[li2].members, p);
                drop list_push(@work, p);
            }
        }
    }
    pass out;
};

pub func:floor_is_back_edge = bool(List<FLoop>->:loops, int64:from, int64:to) never fails {
    for (int64:i in 0i64...loops.count) {
        if ((<-loops)[i].header != to) { continue; }
        if (raw has_int((<-loops)[i].latches, from)) { pass true; }
    }
    pass false;
};

pub func:floor_loop_of_header = int64(List<FLoop>->:loops, int64:h) never fails {
    for (int64:i in 0i64...loops.count) { if ((<-loops)[i].header == h) { pass i; } }
    pass (0i64 - 1i64);
};

// Reverse postorder over the forward edges (the back edges removed): every
// block after all of its forward predecessors. Blocks the entry does not
// reach are left out.
pub func:floor_rpo = List<int64>(FFn->:f, List<FLoop>->:loops) never fails {
    int64:n = f.blocks.count;
    List<int64>:post = raw list_init::<int64>(n + 1i64);
    List<int32>:state = raw list_init::<int32>(n + 1i64);   // 0 unseen, 1 open, 2 done
    for (int64:i in 0i64...n) { drop list_push(@state, 0i32); }
    // an explicit stack of (block, next successor index)
    List<int64>:stk = raw list_init::<int64>(n + 1i64);
    List<int64>:nxt = raw list_init::<int64>(n + 1i64);
    if (n == 0i64) { pass post; }
    drop list_push(@stk, 0i64);
    drop list_push(@nxt, 0i64);
    state[0i64] = 1i32;
    while (stk.count > 0i64) {
        int64:top = stk.count - 1i64;
        int64:b = stk[top];
        int64:k = nxt[top];
        if (k >= f.blocks[b].succs.count) {
            state[b] = 2i32;
            drop list_push(@post, b);
            discard(raw list_pop(@stk));
            discard(raw list_pop(@nxt));
            continue;
        }
        nxt[top] = k + 1i64;
        int64:s = f.blocks[b].succs[k];
        if (raw floor_is_back_edge(loops, b, s)) { continue; }
        if (state[s] != 0i32) { continue; }
        state[s] = 1i32;
        drop list_push(@stk, s);
        drop list_push(@nxt, 0i64);
    }
    List<int64>:rpo = raw list_init::<int64>(post.count + 1i64);
    for (int64:j in 0i64...post.count) { drop list_push(@rpo, post[post.count - 1i64 - j]); }
    pass rpo;
};

// --- the block metadata a transform leaves behind ---------------------------------------

// Where a block came from: the function and label it was cloned from (its
// own, for an untouched block), the rename environment (original register
// name -> this copy's text, `%i` -> `%memcpy#1.i.u2`, a callee parameter ->
// the argument's text), whether it is an unrolling's synthetic stop block,
// and the bound it stops (0 when it is not one).
pub struct:BMeta = {
    string:origin_fn;        // `@memcpy`
    string:origin_label;     // `head`
    List<string>:ren_from;   // `%i`
    List<string>:ren_to;     // `%memcpy#1.i.u2` or `%dst` or `42`
    bool:is_stop;
    int64:bound;
    bool:exact;              // a stop block of an `(unroll N exact)` loop: the bound is claimed exact
    string:entry_of;         // for a callee's first block: the callee it opens (`@memcpy`), else ""
    string:cont_of;          // for a caller's continuation block: the register the call defined, else ""
};

pub struct:XFn = {
    FFn:f;
    List<BMeta>:meta;
    List<FLoop>:loops;       // the loops left after the transforms (cut by invariants)
    List<int64>:be_from;     // THE BACK EDGES, maintained through the transforms (dominators are
    List<int64>:be_to;       // computed once, on the small original; a transformed graph's loops
                             // are the originals' back edges that survived, copied with their copies)
    List<string>:problems;   // refusals, by name
};

// The natural loops of the back edges listed: for each (s -> h), the blocks
// reaching s without passing h, and h.
pub func:loops_of_edges = List<FLoop>(FFn->:f, List<int64>:be_from, List<int64>:be_to) never fails {
    int64:n = f.blocks.count;
    List<FLoop>:out = raw list_init::<FLoop>(4i64);
    for (int64:e in 0i64...be_from.count) {
        int64:s = be_from[e];
        int64:h = be_to[e];
        int64:li = 0i64 - 1i64;
        for (int64:j in 0i64...out.count) { if (out[j].header == h) { li = j; } }
        if (li < 0i64) {
            FLoop:l = FLoop{ header: h, latches: raw list_init::<int64>(2i64), members: raw list_init::<int64>(8i64) };
            drop list_push(@out, move(l));
            li = out.count - 1i64;
        }
        if (!(raw has_int(out[li].latches, s))) { drop list_push(@out[li].latches, s); }
    }
    // predecessor lists once
    List<List<int64>>:preds = raw list_init::<List<int64>>(n + 1i64);
    for (int64:i2 in 0i64...n) { drop list_push(@preds, raw list_init::<int64>(2i64)); }
    for (int64:b in 0i64...n) {
        for (int64:k in 0i64...f.blocks[b].succs.count) { drop list_push(@preds[f.blocks[b].succs[k]], b); }
    }
    for (int64:li2 in 0i64...out.count) {
        int64:h2 = out[li2].header;
        drop list_push(@out[li2].members, h2);
        List<int64>:work = raw list_init::<int64>(8i64);
        for (int64:a in 0i64...out[li2].latches.count) {
            int64:s2 = out[li2].latches[a];
            if (!(raw has_int(out[li2].members, s2))) {
                drop list_push(@out[li2].members, s2);
                drop list_push(@work, s2);
            }
        }
        while (work.count > 0i64) {
            int64:b2 = raw list_pop(@work);
            for (int64:pi in 0i64...preds[b2].count) {
                int64:p = preds[b2][pi];
                if (raw has_int(out[li2].members, p)) { continue; }
                drop list_push(@out[li2].members, p);
                drop list_push(@work, p);
            }
        }
    }
    pass out;
};

func:meta_plain = BMeta(string:fn, string:label) never fails {
    pass BMeta{ origin_fn: raw text_copy(fn), origin_label: raw text_copy(label),
                ren_from: raw list_init::<string>(2i64), ren_to: raw list_init::<string>(2i64),
                is_stop: false, bound: 0i64, exact: false, entry_of: "", cont_of: "" };
};

func:meta_clone = BMeta(BMeta->:m) never fails {
    pass BMeta{ origin_fn: raw text_copy(raw strlist_view_of(m.origin_fn)),
                origin_label: raw text_copy(raw strlist_view_of(m.origin_label)),
                ren_from: raw strlist_clone(m.ren_from), ren_to: raw strlist_clone(m.ren_to),
                is_stop: m.is_stop, bound: m.bound, exact: m.exact,
                entry_of: raw text_copy(raw strlist_view_of(m.entry_of)),
                cont_of: raw text_copy(raw strlist_view_of(m.cont_of)) };
};

// The environment's answer for an original name: its current text, or the
// name itself when the environment does not rename it.
pub func:meta_rename = string(BMeta->:m, string:name) never fails {
    for (int64:i in 0i64...m.ren_from.count) {
        if (raw text_eq(raw strlist_view(m.ren_from, i), name)) { pass (raw strlist_copy(m.ren_to, i)); }
    }
    pass (raw text_copy(name));
};

// Compose a rename onto an environment: every existing `to` that equals
// `from` becomes `to2`; a `from` the environment does not know yet is added.
func:meta_compose = NIL(BMeta->:m, string:from, string:to2) never fails {
    bool:seen = false;
    for (int64:i in 0i64...m.ren_to.count) {
        if (raw text_eq(raw strlist_view(m.ren_to, i), from)) { m.ren_to[i] = raw text_copy(to2); seen = true; }
    }
    for (int64:j in 0i64...m.ren_from.count) {
        if (raw text_eq(raw strlist_view(m.ren_from, j), from)) { seen = true; }
    }
    if (!seen) { drop strlist_push(@m.ren_from, from); drop strlist_push(@m.ren_to, to2); }
    pass NIL;
};

// --- text renaming --------------------------------------------------------------------------

func:is_ident_byte = bool(uint8:c) never fails {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }
    if ((c >= 65u8) && (c <= 90u8)) { pass true; }
    if ((c >= 48u8) && (c <= 57u8)) { pass true; }
    if ((c == 95u8) || (c == 46u8) || (c == 36u8) || (c == 45u8) || (c == 35u8)) { pass true; }   // _ . $ - #
    pass false;
};

// Every occurrence of `%NAME` (or `@NAME`) in `line` where NAME is a whole
// identifier, replaced by `to`. `from` carries its sigil.
pub func:rename_in_line = string(string:line, string:from, string:to) never fails {
    if (from.len == 0i64) { pass (raw text_copy(line)); }
    string:out = "";
    int64:i = 0i64;
    int64:start = 0i64;
    while (i < line.len) {
        bool:hit = false;
        if ((i + from.len) <= line.len) {
            hit = true;
            for (int64:k in 0i64...from.len) { if (line.ptr[i + k] != from.ptr[k]) { hit = false; break; } }
            if (hit) {
                if ((i + from.len) < line.len) { if (raw is_ident_byte(line.ptr[i + from.len])) { hit = false; } }
            }
            if (hit && (i > 0i64)) { if (raw is_ident_byte(line.ptr[i - 1i64])) { hit = false; } }
        }
        if (hit) {
            out = string_concat(out, raw text_slice(line, start, i));
            out = string_concat(out, to);
            i = i + from.len;
            start = i;
            continue;
        }
        i = i + 1i64;
    }
    out = string_concat(out, raw text_slice(line, start, line.len));
    pass out;
};

// Every `%NAME`/`@NAME` token of `line` mapped through the table in ONE
// pass -- simultaneous, so a renamed token is never renamed again by a
// later entry (`%c` -> `%c.u1` and then `%c.u1` -> `%c.u1.u1` is the double
// rename a sequential pass produces on a doubly unrolled loop).
pub func:rename_all = string(string:line, List<string>:from, List<string>:to) never fails {
    string:out = "";
    int64:i = 0i64;
    int64:start = 0i64;
    while (i < line.len) {
        uint8:c = line.ptr[i];
        if ((c == 37u8) || (c == 64u8)) {
            bool:word_before = false;
            if (i > 0i64) { word_before = raw is_ident_byte(line.ptr[i - 1i64]); }
            int64:k = i + 1i64;
            while ((k < line.len) && (raw is_ident_byte(line.ptr[k]))) { k = k + 1i64; }
            if ((k > i + 1i64) && (!word_before)) {
                string:tok = raw text_slice(line, i, k);
                for (int64:f in 0i64...from.count) {
                    if (raw text_eq(raw strlist_view(from, f), tok)) {
                        out = string_concat(out, raw text_slice(line, start, i));
                        out = string_concat(out, raw strlist_view(to, f));
                        start = k;
                        break;
                    }
                }
            }
            i = k;
            continue;
        }
        i = i + 1i64;
    }
    out = string_concat(out, raw text_slice(line, start, line.len));
    pass out;
};

// The IR type of the value a line defines, or "" when it defines none.
pub func:line_def_type = string(string:line) never fails {
    FInstr:ins = raw floor_instr(line);
    if (ins.dest.len == 0i64) { pass ""; }
    string:op = raw strlist_view_of(ins.op);
    if (raw text_eq(op, "icmp") || raw text_eq(op, "fcmp")) { pass "i1"; }
    if (raw text_eq(op, "getelementptr") || raw text_eq(op, "alloca")) { pass "ptr"; }
    if (raw text_eq(op, "zext") || raw text_eq(op, "sext") || raw text_eq(op, "trunc") || raw text_eq(op, "ptrtoint") ||
        raw text_eq(op, "inttoptr") || raw text_eq(op, "bitcast") || raw text_eq(op, "fpext") || raw text_eq(op, "fptrunc") ||
        raw text_eq(op, "sitofp") || raw text_eq(op, "uitofp")) { pass (raw text_copy(raw strlist_view_of(ins.pred))); }
    if (raw text_eq(op, "extractvalue")) {
        Result<int64>:k = text_int(raw strlist_view(ins.args, 1i64));
        if (k.is_error) { pass ""; }
        List<string>:fs = raw struct_fields(ins.ty);
        if ((k.value < 0i64) || (k.value >= fs.count)) { pass ""; }
        pass (raw strlist_copy(fs, k.value));
    }
    pass (raw text_copy(raw strlist_view_of(ins.ty)));
};

// The register a line defines (`%x = ...`), or "".
pub func:line_dest = string(string:line) never fails {
    if (line.len == 0i64) { pass ""; }
    if (line.ptr[0i64] != 37u8) { pass ""; }
    int64:eq = raw text_index_of(line, " = ");
    if (eq < 0i64) { pass ""; }
    pass (raw text_slice(line, 0i64, eq));
};

// A branch's targets renamed: `label %X` -> `label %Y`. A phi's labels are
// never renamed (see the rule below); a register that happens to share a
// label's name is untouched because only the `label ` spelling is matched.
pub func:rename_label_in_line = string(string:line, string:from, string:to) never fails {
    string:f = string_concat("label %", from);
    string:t = string_concat("label %", to);
    string:out = "";
    int64:i = 0i64;
    int64:start = 0i64;
    while (i < line.len) {
        bool:hit = false;
        if ((i + f.len) <= line.len) {
            hit = true;
            for (int64:k in 0i64...f.len) { if (line.ptr[i + k] != f.ptr[k]) { hit = false; break; } }
            if (hit && ((i + f.len) < line.len)) { if (raw is_ident_byte(line.ptr[i + f.len])) { hit = false; } }
        }
        if (hit) {
            out = string_concat(out, raw text_slice(line, start, i));
            out = string_concat(out, t);
            i = i + f.len;
            start = i;
            continue;
        }
        i = i + 1i64;
    }
    out = string_concat(out, raw text_slice(line, start, line.len));
    pass out;
};

// --- the transforms ---------------------------------------------------------------------------
//
// THE PHI RULE. A phi line is copied with its DESTINATION renamed and its
// incomings left exactly as written -- original values, original labels.
// The translator resolves a phi at block B by B's actual predecessors: for
// each predecessor P it takes the incoming whose label is P's ORIGIN label
// and renames the value through P's environment. So a header phi in copy
// k of an unrolled loop takes `[ %i2, %body ]` from `body.u<k-1>` as
// `%i2.u<k-1>`; an exit block reached from every copy merges every copy's
// value; a callee's `ret` value reaches the caller's continuation phi
// through the returning block's environment; and a phi at a block after a
// split call still names the split block's label, which the continuation
// inherits as its origin.

pub func:xfn_of = XFn(FFn->:f) never fails {
    XFn:x = XFn{ f: FFn{ name: raw text_copy(raw strlist_view_of(f.name)), internal: f.internal,
                         blocks: raw list_init::<FBlock>(f.blocks.count + 4i64), geps: raw list_init::<FGep>(1i64),
                         params: raw strlist_clone(f.params), param_tys: raw strlist_clone(f.param_tys),
                         ret_ty: raw text_copy(raw strlist_view_of(f.ret_ty)) },
                 meta: raw list_init::<BMeta>(f.blocks.count + 4i64),
                 loops: raw list_init::<FLoop>(2i64),
                 be_from: raw list_init::<int64>(4i64), be_to: raw list_init::<int64>(4i64),
                 problems: raw list_init::<string>(1i64) };
    for (int64:b in 0i64...f.blocks.count) {
        FBlock:nb = FBlock{ label: raw text_copy(raw strlist_view_of(f.blocks[b].label)),
                            lines: raw strlist_clone(f.blocks[b].lines), succs: raw list_init::<int64>(2i64) };
        drop list_push(@x.f.blocks, move(nb));
        drop list_push(@x.meta, raw meta_plain(raw strlist_view_of(f.name), raw strlist_view_of(f.blocks[b].label)));
    }
    drop floor_finish(@x.f);
    // the back edges, once, by dominators over the small original
    List<FLoop>:orig = raw floor_loops(@x.f);
    for (int64:li in 0i64...orig.count) {
        for (int64:a in 0i64...orig[li].latches.count) {
            drop list_push(@x.be_from, orig[li].latches[a]);
            drop list_push(@x.be_to, orig[li].header);
        }
    }
    x.loops = raw loops_of_edges(@x.f, x.be_from, x.be_to);
    pass x;
};

// Replace the back-edge list by the edges (from_label -> to_label) named,
// resolved against the current blocks.
func:xfn_set_edges = NIL(XFn->:x, List<string>:from_labels, List<string>:to_labels) never fails {
    drop list_clear(@x.be_from);
    drop list_clear(@x.be_to);
    for (int64:i in 0i64...from_labels.count) {
        int64:fi = raw floor_block_index(@x.f, raw strlist_view(from_labels, i));
        int64:ti = raw floor_block_index(@x.f, raw strlist_view(to_labels, i));
        if ((fi < 0i64) || (ti < 0i64)) { continue; }
        drop list_push(@x.be_from, fi);
        drop list_push(@x.be_to, ti);
    }
    x.loops = raw loops_of_edges(@x.f, x.be_from, x.be_to);
    pass NIL;
};

pub func:xfn_block_index = int64(XFn->:x, string:label) never fails {
    pass (raw floor_block_index(@x.f, label));
};

// Every register a set of blocks defines.
func:defined_in = List<string>(XFn->:x, List<int64>:blocks) never fails {
    List<string>:out = raw list_init::<string>(16i64);
    for (int64:i in 0i64...blocks.count) {
        int64:b = blocks[i];
        for (int64:l in 0i64...x.f.blocks[b].lines.count) {
            string:d = raw line_dest(raw strlist_view(x.f.blocks[b].lines, l));
            if (d.len > 0i64) { drop strlist_push(@out, d); }
        }
    }
    pass out;
};

// One line of a copy: the destination and every non-phi use of a renamed
// register renamed (a phi keeps its incomings, the rule above), branch
// targets inside the copied set retargeted.
func:copy_line = string(string:ln, List<string>:from, List<string>:to, List<string>:lab_from, List<string>:lab_to) never fails {
    FInstr:ins = raw floor_instr(ln);
    string:out = raw text_copy(ln);
    if (raw text_eq(ins.op, "phi")) {
        // the destination only
        string:d = raw line_dest(ln);
        for (int64:i in 0i64...from.count) {
            if (raw text_eq(raw strlist_view(from, i), d)) {
                out = string_concat(raw strlist_view(to, i), raw text_slice(ln, d.len, ln.len));
            }
        }
        pass out;
    }
    out = raw rename_all(out, from, to);
    if (raw text_eq(ins.op, "br")) {
        for (int64:j in 0i64...lab_from.count) {
            out = raw rename_label_in_line(out, raw strlist_view(lab_from, j), raw strlist_view(lab_to, j));
        }
    }
    pass out;
};

// UNROLL the loop with header `h` `n` times: copies 0..n of its blocks
// (copy 0 is the original, in place; copy k > 0 suffixes its labels and
// its registers `.u<unroll_id>_<k>`), copy k's back edges retargeted at copy k+1's
// header, copy n's at the synthetic stop block `<header>.stop` (an
// `unreachable` the translator reads as the bound: reached at most when
// the back edge is taken an (n+1)-th time). N is therefore the most times
// the back edge is taken.
pub func:xfn_unroll = NIL(XFn->:x, int64:li, int64:n, int64:unroll_id, bool:exact) never fails {
    int64:h = x.loops[li].header;
    drop xfn_lcssa(x, li, unroll_id);
    // the back edges after: this loop's are consumed; every other edge stays,
    // and one inside this loop is copied with the copies
    List<string>:ef = raw list_init::<string>(x.be_from.count + 4i64);
    List<string>:et = raw list_init::<string>(x.be_from.count + 4i64);
    for (int64:e in 0i64...x.be_from.count) {
        if (x.be_to[e] == h) { continue; }
        drop strlist_push(@ef, raw strlist_view_of(x.f.blocks[x.be_from[e]].label));
        drop strlist_push(@et, raw strlist_view_of(x.f.blocks[x.be_to[e]].label));
    }
    List<int64>:members = raw list_init::<int64>(x.loops[li].members.count + 1i64);
    for (int64:m in 0i64...x.loops[li].members.count) { drop list_push(@members, x.loops[li].members[m]); }
    List<int64>:latches = raw list_init::<int64>(x.loops[li].latches.count + 1i64);
    for (int64:m2 in 0i64...x.loops[li].latches.count) { drop list_push(@latches, x.loops[li].latches[m2]); }
    List<string>:defs = raw defined_in(x, members);
    string:hlabel = raw text_copy(raw strlist_view_of(x.f.blocks[h].label));
    string:stop_label = string_concat(hlabel, ".stop");
    // the originals' lines, kept as the source of every copy
    List<List<string>>:src = raw list_init::<List<string>>(members.count + 1i64);
    for (int64:m3 in 0i64...members.count) { drop list_push(@src, raw strlist_clone(x.f.blocks[members[m3]].lines)); }
    // THE SUFFIX NAMES THE UNROLLING TOO (`.u<unroll_id>_<k>`): an outer loop's
    // copy 1 of an inner loop's copy 0 would otherwise wear the inner's copy-1
    // label (`scale.u1` twice, in a doubly unrolled fmod)
    string:us = string_concat(".u", int_to_string(unroll_id));
    us = string_concat(us, "_");
    for (int64:k in 0i64...(n + 1i64)) {
        string:sfx = "";
        if (k > 0i64) { sfx = string_concat(us, int_to_string(k)); }
        string:sfx_next = string_concat(us, int_to_string(k + 1i64));
        List<string>:to = raw list_init::<string>(defs.count + 1i64);
        for (int64:di in 0i64...defs.count) { drop strlist_push(@to, string_concat(raw strlist_view(defs, di), sfx)); }
        for (int64:mi in 0i64...members.count) {
            int64:sb = members[mi];
            bool:is_latch = raw has_int(latches, sb);
            // the labels this copy's branches target: every member's label in this copy,
            // except the back edge (a latch's branch to the header) -> the next copy or stop
            List<string>:lf = raw list_init::<string>(members.count + 1i64);
            List<string>:lt = raw list_init::<string>(members.count + 1i64);
            for (int64:mj in 0i64...members.count) {
                string:ml = raw strlist_view_of(x.f.blocks[members[mj]].label);
                drop strlist_push(@lf, ml);
                if ((members[mj] == h) && is_latch) {
                    if (k < n) { drop strlist_push(@lt, string_concat(ml, sfx_next)); }
                    else { drop strlist_push(@lt, stop_label); }
                } else {
                    drop strlist_push(@lt, string_concat(ml, sfx));
                }
            }
            List<string>:lines = raw list_init::<string>(src[mi].count + 1i64);
            for (int64:l in 0i64...src[mi].count) {
                drop strlist_push(@lines, raw copy_line(raw strlist_view(src[mi], l), defs, to, lf, lt));
            }
            if (k == 0i64) {
                x.f.blocks[sb].lines = move(lines);
                continue;
            }
            FBlock:nb = FBlock{ label: string_concat(raw strlist_view_of(x.f.blocks[sb].label), sfx),
                                lines: move(lines), succs: raw list_init::<int64>(2i64) };
            drop list_push(@x.f.blocks, move(nb));
            BMeta:nm = raw meta_clone(@x.meta[sb]);
            for (int64:di3 in 0i64...defs.count) {
                drop meta_compose(@nm, raw strlist_view(defs, di3), raw strlist_view(to, di3));
            }
            drop list_push(@x.meta, move(nm));
        }
        // an inner loop's back edge inside this copy
        if (k > 0i64) {
            for (int64:e2 in 0i64...x.be_from.count) {
                if (x.be_to[e2] == h) { continue; }
                if (!(raw has_int(members, x.be_from[e2]))) { continue; }
                drop strlist_push(@ef, string_concat(raw strlist_view_of(x.f.blocks[x.be_from[e2]].label), sfx));
                drop strlist_push(@et, string_concat(raw strlist_view_of(x.f.blocks[x.be_to[e2]].label), sfx));
            }
        }
    }
    // the stop block
    FBlock:stop = FBlock{ label: raw text_copy(stop_label), lines: raw list_init::<string>(1i64), succs: raw list_init::<int64>(1i64) };
    drop strlist_push(@stop.lines, "unreachable");
    drop list_push(@x.f.blocks, move(stop));
    BMeta:sm = raw meta_plain(raw strlist_view_of(x.f.name), stop_label);
    sm.is_stop = true;
    sm.bound = n;
    sm.exact = exact;
    sm.origin_label = raw text_copy(hlabel);
    drop list_push(@x.meta, move(sm));
    drop floor_finish(@x.f);
    drop xfn_set_edges(x, ef, et);
    pass NIL;
};

// LOOP-CLOSED FORM before an unrolling: a register the loop defines and a
// block outside the loop reads must reach that block through a phi at the
// loop's exit, or every copy's exit would name copy 0's value. For each
// exit block E (outside the loop, with a predecessor inside) and each loop
// register R used outside -- in a non-phi line, or as a phi incoming from
// an outside block -- E gains `%R.lc<n> = phi TY [ %R, %L ]...` over the
// members L that branch to E (the phi rule resolves each copy's value), the
// outside blocks' uses are renamed to it, and their environments learn the
// rename so a later phi resolves through them. A register used past two
// exit blocks would need a merge this transform does not build: refused.
func:xfn_lcssa = NIL(XFn->:x, int64:li, int64:unroll_id) never fails {
    List<int64>:members = raw list_init::<int64>(x.loops[li].members.count + 1i64);
    for (int64:m in 0i64...x.loops[li].members.count) { drop list_push(@members, x.loops[li].members[m]); }
    List<string>:defs = raw defined_in(x, members);
    List<string>:def_tys = raw list_init::<string>(defs.count + 1i64);
    for (int64:d in 0i64...defs.count) {
        string:ty = "";
        for (int64:mi in 0i64...members.count) {
            int64:b = members[mi];
            for (int64:l in 0i64...x.f.blocks[b].lines.count) {
                string:ln = raw strlist_view(x.f.blocks[b].lines, l);
                if (raw text_eq(raw line_dest(ln), raw strlist_view(defs, d))) { ty = raw line_def_type(ln); }
            }
        }
        drop strlist_push(@def_tys, ty);
    }
    // the exit blocks
    List<int64>:exits = raw list_init::<int64>(4i64);
    for (int64:mi2 in 0i64...members.count) {
        int64:b2 = members[mi2];
        for (int64:k in 0i64...x.f.blocks[b2].succs.count) {
            int64:e = x.f.blocks[b2].succs[k];
            if (raw has_int(members, e)) { continue; }
            if (x.meta[e].is_stop) { continue; }   // an inner unrolling's stop block reads nothing
            if (!(raw has_int(exits, e))) { drop list_push(@exits, e); }
        }
    }
    int64:lc = 0i64;
    for (int64:d2 in 0i64...defs.count) {
        string:r = raw strlist_view(defs, d2);
        // the outside blocks that use it
        List<int64>:use_blocks = raw list_init::<int64>(4i64);
        for (int64:b3 in 0i64...x.f.blocks.count) {
            if (raw has_int(members, b3)) { continue; }
            bool:used_here = false;
            for (int64:l3 in 0i64...x.f.blocks[b3].lines.count) {
                string:ln3 = raw strlist_view(x.f.blocks[b3].lines, l3);
                FInstr:ins = raw floor_instr(ln3);
                if (raw text_eq(ins.op, "phi")) {
                    for (int64:a in 0i64...ins.args.count) {
                        if (!(raw text_eq(raw strlist_view(ins.args, a), r))) { continue; }
                        int64:pb = raw floor_block_index(@x.f, raw strlist_view(ins.labels, a));
                        if (!(raw has_int(members, pb))) { used_here = true; }
                    }
                    continue;
                }
                if (raw line_mentions(ln3, r)) { used_here = true; }
            }
            if (used_here) { drop list_push(@use_blocks, b3); }
        }
        if (use_blocks.count == 0i64) { continue; }
        // the exits a use is reachable from (outside the loop)
        List<int64>:live_exits = raw list_init::<int64>(2i64);
        for (int64:xi in 0i64...exits.count) {
            if (raw reaches_any(x, exits[xi], use_blocks, members)) { drop list_push(@live_exits, exits[xi]); }
        }
        if (live_exits.count != 1i64) {
            string:w = string_concat("floor: a value of an unrolled loop is used past ", int_to_string(live_exits.count));
            w = string_concat(w, " exit blocks (");
            for (int64:ei in 0i64...live_exits.count) {
                if (ei > 0i64) { w = string_concat(w, ", "); }
                w = string_concat(w, raw strlist_view_of(x.f.blocks[live_exits[ei]].label));
            }
            w = string_concat(w, "): ");
            w = string_concat(w, r);
            drop strlist_push(@x.problems, w);
            continue;
        }
        int64:e2 = live_exits[0i64];
        lc = lc + 1i64;
        string:nn = string_concat(r, ".lc");
        nn = string_concat(nn, int_to_string(unroll_id));
        nn = string_concat(nn, "_");
        nn = string_concat(nn, int_to_string(lc));
        // the phi over the exiting members
        string:phi = string_concat(nn, " = phi ");
        phi = string_concat(phi, raw strlist_view(def_tys, d2));
        bool:first = true;
        for (int64:mi3 in 0i64...members.count) {
            int64:b4 = members[mi3];
            if (!(raw has_int(x.f.blocks[b4].succs, e2))) { continue; }
            if (!first) { phi = string_concat(phi, ","); }
            first = false;
            phi = string_concat(phi, " [ ");
            phi = string_concat(phi, r);
            phi = string_concat(phi, ", %");
            phi = string_concat(phi, raw strlist_view_of(x.f.blocks[b4].label));
            phi = string_concat(phi, " ]");
        }
        // insert after E's existing phis
        int64:at = 0i64;
        while (at < x.f.blocks[e2].lines.count) {
            FInstr:ei = raw floor_instr(raw strlist_view(x.f.blocks[e2].lines, at));
            if (!(raw text_eq(ei.op, "phi"))) { break; }
            at = at + 1i64;
        }
        List<string>:nl = raw list_init::<string>(x.f.blocks[e2].lines.count + 2i64);
        for (int64:l4 in 0i64...at) { drop strlist_push(@nl, raw strlist_view(x.f.blocks[e2].lines, l4)); }
        drop strlist_push(@nl, phi);
        for (int64:l5 in at...x.f.blocks[e2].lines.count) { drop strlist_push(@nl, raw strlist_view(x.f.blocks[e2].lines, l5)); }
        x.f.blocks[e2].lines = move(nl);
        // rename the outside uses and teach the outside environments
        List<string>:rf = raw list_init::<string>(1i64);
        List<string>:rt = raw list_init::<string>(1i64);
        drop strlist_push(@rf, r);
        drop strlist_push(@rt, nn);
        for (int64:b5 in 0i64...x.f.blocks.count) {
            if (raw has_int(members, b5)) { continue; }
            for (int64:l6 in 0i64...x.f.blocks[b5].lines.count) {
                string:ln6 = raw strlist_copy(x.f.blocks[b5].lines, l6);
                FInstr:i6 = raw floor_instr(ln6);
                if (raw text_eq(i6.op, "phi")) { continue; }
                if (raw text_eq(raw line_dest(ln6), nn)) { continue; }
                x.f.blocks[b5].lines[l6] = raw rename_all(ln6, rf, rt);
            }
            drop meta_compose(@x.meta[b5], r, nn);
        }
    }
    pass NIL;
};

// Is any of `targets` reachable from `from` without entering `avoid`?
func:reaches_any = bool(XFn->:x, int64:from, List<int64>:targets, List<int64>:avoid) never fails {
    List<int64>:seen = raw list_init::<int64>(8i64);
    List<int64>:work = raw list_init::<int64>(8i64);
    drop list_push(@work, from);
    drop list_push(@seen, from);
    while (work.count > 0i64) {
        int64:b = raw list_pop(@work);
        if (raw has_int(targets, b)) { pass true; }
        for (int64:k in 0i64...x.f.blocks[b].succs.count) {
            int64:s = x.f.blocks[b].succs[k];
            if (raw has_int(avoid, s)) { continue; }
            if (raw has_int(seen, s)) { continue; }
            drop list_push(@seen, s);
            drop list_push(@work, s);
        }
    }
    pass false;
};

// Does `line` mention the register `r` as a whole token?
func:line_mentions = bool(string:line, string:r) never fails {
    int64:i = 0i64;
    while (i < line.len) {
        if (line.ptr[i] == 37u8) {
            int64:k = i + 1i64;
            while ((k < line.len) && (raw is_ident_byte(line.ptr[k]))) { k = k + 1i64; }
            if (raw text_eq(raw text_slice(line, i, k), r)) { pass true; }
            i = k;
            continue;
        }
        i = i + 1i64;
    }
    pass false;
};

// INLINE the call at line `li` of block `bi` (a `call` of the floor define
// `callee` whose parameters are `params`, `%dst`...): the block is split
// at the call -- its head branches to the callee's entry copy; the callee's
// blocks are copied with every register and label prefixed `<callee>#<k>.`
// and every parameter replaced by the argument's text; each `ret` becomes a
// branch to the continuation block, which opens with the call's result as
// a phi over the returning blocks (the phi rule: original values and
// labels, resolved through the returning copies' environments) and
// continues with the split block's tail.
pub func:xfn_inline = NIL(XFn->:x, int64:bi, int64:li, FFn->:callee, List<string>:params, int64:k) never fails {
    string:cname = raw text_slice(raw strlist_view_of(callee.name), 1i64, callee.name.len);   // without `@`
    string:prefix = string_concat(cname, "#");
    prefix = string_concat(prefix, int_to_string(k));
    prefix = string_concat(prefix, ".");
    string:call_line = raw strlist_copy(x.f.blocks[bi].lines, li);
    FInstr:ins = raw floor_instr(call_line);
    string:cont_label = string_concat(prefix, "cont");
    string:entry_label = string_concat(prefix, raw strlist_view_of(callee.blocks[0i64].label));
    // the callee's registers and labels, and their prefixed forms
    List<string>:cdefs = raw list_init::<string>(16i64);
    for (int64:cb in 0i64...callee.blocks.count) {
        for (int64:cl in 0i64...callee.blocks[cb].lines.count) {
            string:d = raw line_dest(raw strlist_view(callee.blocks[cb].lines, cl));
            if (d.len > 0i64) { drop strlist_push(@cdefs, d); }
        }
    }
    List<string>:from = raw list_init::<string>(params.count + cdefs.count + 1i64);
    List<string>:to = raw list_init::<string>(params.count + cdefs.count + 1i64);
    for (int64:pi in 0i64...params.count) {
        drop strlist_push(@from, raw strlist_view(params, pi));
        drop strlist_push(@to, raw strlist_view(ins.args, pi));
    }
    for (int64:di in 0i64...cdefs.count) {
        string:dn = raw strlist_view(cdefs, di);
        drop strlist_push(@from, dn);
        drop strlist_push(@to, string_concat("%", string_concat(prefix, raw text_slice(dn, 1i64, dn.len))));
    }
    List<string>:lf = raw list_init::<string>(callee.blocks.count + 1i64);
    List<string>:lt = raw list_init::<string>(callee.blocks.count + 1i64);
    for (int64:cb1 in 0i64...callee.blocks.count) {
        string:ol = raw strlist_view_of(callee.blocks[cb1].label);
        drop strlist_push(@lf, ol);
        drop strlist_push(@lt, string_concat(prefix, ol));
    }
    // the split
    List<string>:head = raw list_init::<string>(li + 2i64);
    for (int64:a in 0i64...li) { drop strlist_push(@head, raw strlist_view(x.f.blocks[bi].lines, a)); }
    drop strlist_push(@head, string_concat("br label %", entry_label));
    List<string>:tail = raw list_init::<string>(x.f.blocks[bi].lines.count + 2i64);
    string:phi = "";
    if (ins.dest.len > 0i64) {
        phi = string_concat(ins.dest, " = phi ");
        phi = string_concat(phi, ins.ty);
    }
    bool:first = true;
    // the callee's blocks
    for (int64:cb2 in 0i64...callee.blocks.count) {
        string:clabel = string_concat(prefix, raw strlist_view_of(callee.blocks[cb2].label));
        List<string>:lines = raw list_init::<string>(callee.blocks[cb2].lines.count + 1i64);
        BMeta:nm = raw meta_plain(raw strlist_view_of(callee.name), raw strlist_view_of(callee.blocks[cb2].label));
        if (cb2 == 0i64) { nm.entry_of = raw text_copy(raw strlist_view_of(callee.name)); }
        for (int64:fi in 0i64...from.count) { drop meta_compose(@nm, raw strlist_view(from, fi), raw strlist_view(to, fi)); }
        for (int64:cl2 in 0i64...callee.blocks[cb2].lines.count) {
            string:ln = raw strlist_copy(callee.blocks[cb2].lines, cl2);
            FInstr:ci = raw floor_instr(ln);
            if (raw text_eq(ci.op, "ret")) {
                if (ins.dest.len > 0i64) {
                    if (!first) { phi = string_concat(phi, ","); }
                    first = false;
                    phi = string_concat(phi, " [ ");
                    if (ci.args.count > 0i64) { phi = string_concat(phi, raw strlist_view(ci.args, 0i64)); }
                    phi = string_concat(phi, ", %");
                    phi = string_concat(phi, raw strlist_view_of(callee.blocks[cb2].label));
                    phi = string_concat(phi, " ]");
                }
                drop strlist_push(@lines, string_concat("br label %", cont_label));
                continue;
            }
            drop strlist_push(@lines, raw copy_line(ln, from, to, lf, lt));
        }
        FBlock:nb = FBlock{ label: move(clabel), lines: move(lines), succs: raw list_init::<int64>(2i64) };
        drop list_push(@x.f.blocks, move(nb));
        drop list_push(@x.meta, move(nm));
    }
    // the continuation
    if (ins.dest.len > 0i64) { drop strlist_push(@tail, phi); }
    for (int64:a2 in (li + 1i64)...x.f.blocks[bi].lines.count) { drop strlist_push(@tail, raw strlist_view(x.f.blocks[bi].lines, a2)); }
    x.f.blocks[bi].lines = move(head);
    FBlock:cont = FBlock{ label: raw text_copy(cont_label), lines: move(tail), succs: raw list_init::<int64>(2i64) };
    drop list_push(@x.f.blocks, move(cont));
    BMeta:cm = raw meta_clone(@x.meta[bi]);
    cm.cont_of = raw text_copy(ins.dest);
    cm.entry_of = "";
    drop list_push(@x.meta, move(cm));
    drop floor_finish(@x.f);
    // the back edges: the caller's -- a latch split at the call ends in its
    // continuation now, so an edge from the split block moves there -- plus
    // the callee's under the prefix
    List<string>:ef = raw list_init::<string>(x.be_from.count + 4i64);
    List<string>:et = raw list_init::<string>(x.be_from.count + 4i64);
    for (int64:e in 0i64...x.be_from.count) {
        if (x.be_from[e] == bi) { drop strlist_push(@ef, cont_label); }
        else { drop strlist_push(@ef, raw strlist_view_of(x.f.blocks[x.be_from[e]].label)); }
        drop strlist_push(@et, raw strlist_view_of(x.f.blocks[x.be_to[e]].label));
    }
    List<FLoop>:cl = raw floor_loops(callee);
    for (int64:li in 0i64...cl.count) {
        for (int64:a3 in 0i64...cl[li].latches.count) {
            drop strlist_push(@ef, string_concat(prefix, raw strlist_view_of(callee.blocks[cl[li].latches[a3]].label)));
            drop strlist_push(@et, string_concat(prefix, raw strlist_view_of(callee.blocks[cl[li].header].label)));
        }
    }
    drop xfn_set_edges(x, ef, et);
    pass NIL;
};
