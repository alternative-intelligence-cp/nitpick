// floor -- THE FLOOR'S VERIFICATION LEG (1.5.6 step 3; D-288 §2.2, §2.6,
// §2.11): the translator's driver over `runtime/npkrt.ll` and
// `runtime/npkrt.spec`, writing `build/verify/floor/` in the compiler's
// directory shape (`NNNN.smt2`, `index.txt`, `rows.txt`) so `z3_decide` and
// the harness's `z3_verdicts` decide it unchanged; and the belts that hold
// the spec to the floor before a solver is spawned: every specified symbol
// exists with those parameters, every section has rows or a `residue`
// sentence, every `(summary)` symbol has an `ensures`, every loop annotation
// names a loop of its function. `tools/floorspec.npk` is the harness's
// entry to the same functions.

mod:floor;

use "../src/frontend/paths.npk".*;
use "../lib/nfs.npk".*;
use "./text.npk".*;
use "./floor_ir.npk".*;
use "./floor_spec.npk".*;
use "./floor_cfg.npk".*;
use "./floor_smt.npk".*;
use "./floor_kernel.npk".*;                  // the kernel-effect table, GENERATED (1.5.6b)
use "./floor_model.npk".*;
use "./floor_explore.npk".*;                 // the models' second reading (1.5.6b step 4d, D-295): TCB's numbers
use "./floor_shared.npk".*;                  // `floor_calls`, the harness's `calls_of` (1.5.6c step 3: TCB's callers table)
use "./explore_req.npk".*;                   // `req_clauses`: the entry checkers' classification (1.5.7 step 5: TCB's D-302 column)
use "../src/backend/smt/smt_kinds.npk".*;
use "../src/backend/smt/smt_manifest.npk".*;

pub struct:FloorInputs = {
    bool:ok;
    string:problem;
    FloorText:ft;
    Sxs:spec;
    List<MModel>:models;        // `runtime/models/*.model`, sorted by name (1.5.6 step 5)
};

// The floor and its spec, read from the manifest root.
pub func:floor_read = FloorInputs(string:root) never fails {
    FloorInputs:out = FloorInputs{ ok: false, problem: "", ft: raw floor_parse(""), spec: raw sx_parse(""), models: raw list_init::<MModel>(8i64) };
    Result<cstring>:fc = to_cstring(raw path_join(root, "runtime/npkrt.ll"));
    if (fc.is_error) { out.problem = "floor: runtime/npkrt.ll: not a path"; pass out; }
    Result<string>:ftext = read_file(fc.value);
    if (ftext.is_error) { out.problem = "floor: runtime/npkrt.ll cannot be read"; pass out; }
    Result<cstring>:sc = to_cstring(raw path_join(root, "runtime/npkrt.spec"));
    if (sc.is_error) { out.problem = "floor: runtime/npkrt.spec: not a path"; pass out; }
    Result<string>:stext = read_file(sc.value);
    if (stext.is_error) { out.problem = "floor: runtime/npkrt.spec is missing -- the floor's specification is part of the tree (D-288)"; pass out; }
    out.ft = raw floor_parse(ftext.value);
    out.spec = raw sx_parse(stext.value);
    if (!out.spec.ok) { out.problem = string_concat("floor: runtime/npkrt.spec: ", out.spec.problem); pass out; }
    // the protocol models beside the spec (1.5.6 step 5, D-289): each read
    // and checked for shape here; the correspondence belt holds them to the
    // floor before a solver is spawned
    ModelSet:ms = raw models_read(root);
    if (ms.problems.count > 0i64) { out.problem = raw strlist_copy(ms.problems, 0i64); pass out; }
    out.models = move(ms.models);
    out.ok = true;
    pass out;
};

// `abs` exists as a directory afterwards (build.npk's `ensure_dir`, repeated
// here so the harness's tool needs nothing of the runner's build layer).
func:floor_ensure_dir = NIL(string:abs) {
    Path:parent = relay path_parse(raw path_dirname(abs));
    fd:d = relay dir_open(parent);
    Result<NIL>:mk = mkdir_at(d, raw text_file_name(abs));
    Result<NIL>:cl = close(d);
    if (mk.is_error) { if (mk.err != Exists) { fail mk.err; } }
    if (cl.is_error) { fail cl.err; }
    pass NIL;
};

// Every `(symbol @name ...)` section's name, in file order.
pub func:spec_symbols = List<string>(Sxs->:s) never fails {
    List<string>:out = raw list_init::<string>(64i64);
    for (int64:i in 0i64...s.roots.count) {
        int64:r = s.roots.items[i];
        if (!(raw text_eq(raw sx_head(s, r), "symbol"))) { continue; }
        drop strlist_push(@out, raw sx_atom(s, raw sx_nth(s, r, 1i64)));
    }
    pass out;
};

// `NNNN`, four digits, 1-based (the compiler's `file_number`).
func:fno = string(int64:n) never fails {
    string:d = int_to_string(n);
    string:z = "";
    for (int64:i in d.len...4i64) { z = string_concat(z, "0"); }
    pass (string_concat(z, d));
};

// THE WRITER: one file per specified symbol that has rows, then one per
// model (1.5.6 step 5), `index.txt` and `rows.txt` in the compiler's shape,
// and `controls.txt` -- one line per control, `cNNNN\tmodel:NAME\tCONTROL\tBAD`,
// each a file `cNNNN.smt2` that must answer `sat`; the problems by name.
pub func:floor_emit = List<string>(FloorText->:ft, Sxs->:s, List<MModel>:models, string:dir) never fails {
    List<string>:fl = raw list_init::<string>(4i64);
    Result<NIL>:d = floor_ensure_dir(dir);
    if (d.is_error) { drop strlist_push(@fl, string_concat("floor: cannot create ", dir)); pass fl; }
    List<string>:syms = raw spec_symbols(s);
    string:index = "";
    string:rows = "";
    int64:n = 0i64;
    for (int64:i in 0i64...syms.count) {
        string:name = raw strlist_view(syms, i);
        int64:fi = raw floor_fn_index(ft, name);
        int64:sec = raw spec_section(s, name);
        if (fi < 0i64) { drop strlist_push(@fl, string_concat("floor: the spec names a symbol the floor does not define: ", name)); continue; }
        // a symbol with a residue sentence and nothing else claims no rows; a
        // BOUNDARY symbol's clauses are its promise at the kernel boundary --
        // assumed at its (summary) calls, never proven here (1.5.6 step 4)
        bool:claims = (raw spec_has(s, sec, "ensures")) || (raw spec_has(s, sec, "ensures-trap")) || (raw spec_has(s, sec, "frame")) || (raw spec_has(s, sec, "loop"));
        if (!claims) { continue; }
        if (raw spec_has(s, sec, "boundary")) { continue; }
        FloorFile:f = raw floor_translate(ft, s, fi, sec);
        if (f.problems.count > 0i64) {
            for (int64:p in 0i64...f.problems.count) { drop strlist_push(@fl, raw strlist_view(f.problems, p)); }
            continue;
        }
        n = n + 1i64;
        string:no = raw fno(n);
        Result<cstring>:pc = to_cstring(raw path_join(dir, string_concat(no, ".smt2")));
        if (pc.is_error) { drop strlist_push(@fl, "floor: an output path is not a path"); continue; }
        Result<NIL>:w = write_file(pc.value, f.text);
        if (w.is_error) { drop strlist_push(@fl, string_concat("floor: cannot write ", string_concat(no, ".smt2"))); continue; }
        index = string_concat(index, no);
        index = string_concat(index, "\t");
        index = string_concat(index, name);
        index = string_concat(index, "\t");
        index = string_concat(index, int_to_string(f.rows.count));
        index = string_concat(index, "\n");
        for (int64:r in 0i64...f.rows.count) {
            string:ln = string_concat(no, "\t");
            ln = string_concat(ln, int_to_string(r + 1i64));
            ln = string_concat(ln, "\tfloor-spec\t");
            ln = string_concat(ln, raw strlist_view_of(f.rows.items[r].hash));
            ln = string_concat(ln, "\t1\t");
            ln = string_concat(ln, name);
            ln = string_concat(ln, "\t");
            ln = string_concat(ln, raw strlist_view_of(f.rows.items[r].site));
            ln = string_concat(ln, "\tconform\t0\t0\t");
            ln = string_concat(ln, raw strlist_view_of(f.rows.items[r].tier));
            ln = string_concat(ln, "\n");
            rows = string_concat(rows, ln);
        }
    }
    // the models: one file each, one row per bad predicate; the controls beside them
    string:controls = "";
    int64:cn = 0i64;
    for (int64:mi in 0i64...models.count) {
        MModel->:m = @models.items[mi];
        ModelFile:mf = raw model_emit(m);
        n = n + 1i64;
        string:mno = raw fno(n);
        Result<cstring>:mpc = to_cstring(raw path_join(dir, string_concat(mno, ".smt2")));
        if (mpc.is_error) { drop strlist_push(@fl, "floor: an output path is not a path"); continue; }
        Result<NIL>:mw = write_file(mpc.value, mf.text);
        if (mw.is_error) { drop strlist_push(@fl, string_concat("floor: cannot write ", string_concat(mno, ".smt2"))); continue; }
        index = string_concat(index, mno);
        index = string_concat(index, "\t");
        index = string_concat(index, raw strlist_view_of(mf.name));
        index = string_concat(index, "\t");
        index = string_concat(index, int_to_string(mf.row_sites.count));
        index = string_concat(index, "\n");
        for (int64:r2 in 0i64...mf.row_sites.count) {
            string:ml = string_concat(mno, "\t");
            ml = string_concat(ml, int_to_string(r2 + 1i64));
            ml = string_concat(ml, "\tfloor-model\t");
            ml = string_concat(ml, raw strlist_view(mf.row_hashes, r2));
            ml = string_concat(ml, "\t1\t");
            ml = string_concat(ml, raw strlist_view_of(mf.name));
            ml = string_concat(ml, "\t");
            ml = string_concat(ml, raw strlist_view(mf.row_sites, r2));
            ml = string_concat(ml, "\tconform\t0\t0\tint\n");
            rows = string_concat(rows, ml);
        }
        for (int64:ci in 0i64...mf.ctl_names.count) {
            cn = cn + 1i64;
            string:cno = string_concat("c", raw fno(cn));
            Result<cstring>:cpc = to_cstring(raw path_join(dir, string_concat(cno, ".smt2")));
            if (cpc.is_error) { drop strlist_push(@fl, "floor: a control's path is not a path"); continue; }
            Result<NIL>:cw = write_file(cpc.value, raw strlist_view(mf.ctl_texts, ci));
            if (cw.is_error) { drop strlist_push(@fl, string_concat("floor: cannot write ", string_concat(cno, ".smt2"))); continue; }
            string:cl = string_concat(cno, "\t");
            cl = string_concat(cl, raw strlist_view_of(mf.name));
            cl = string_concat(cl, "\t");
            cl = string_concat(cl, raw strlist_view(mf.ctl_names, ci));
            cl = string_concat(cl, "\t");
            cl = string_concat(cl, raw strlist_view(mf.ctl_bads, ci));
            cl = string_concat(cl, "\n");
            controls = string_concat(controls, cl);
        }
    }
    Result<cstring>:cc = to_cstring(raw path_join(dir, "controls.txt"));
    if (cc.is_error) { drop strlist_push(@fl, "floor: controls.txt: not a path"); pass fl; }
    Result<NIL>:cw2 = write_file(cc.value, controls);
    if (cw2.is_error) { drop strlist_push(@fl, "floor: cannot write controls.txt"); }
    Result<cstring>:ic = to_cstring(raw path_join(dir, "index.txt"));
    if (ic.is_error) { drop strlist_push(@fl, "floor: index.txt: not a path"); pass fl; }
    Result<NIL>:iw = write_file(ic.value, index);
    if (iw.is_error) { drop strlist_push(@fl, "floor: cannot write index.txt"); }
    Result<cstring>:rc = to_cstring(raw path_join(dir, "rows.txt"));
    if (rc.is_error) { drop strlist_push(@fl, "floor: rows.txt: not a path"); pass fl; }
    Result<NIL>:rw = write_file(rc.value, rows);
    if (rw.is_error) { drop strlist_push(@fl, "floor: cannot write rows.txt"); }
    pass fl;
};

// --- the belts (before a solver is spawned) ---------------------------------------------

// The parameters of the floor's define `name` as a spec spells them (`dst`, `a.0`...).
func:param_names = List<string>(FloorText->:ft, int64:fi) never fails {
    List<string>:out = raw list_init::<string>(8i64);
    for (int64:p in 0i64...ft.fns.items[fi].params.count) {
        string:pn = raw strlist_view(ft.fns.items[fi].params, p);
        if (pn.len == 0i64) { continue; }
        string:bare = raw text_slice(pn, 1i64, pn.len);
        string:pty = raw strlist_view(ft.fns.items[fi].param_tys, p);
        if (raw is_aggregate_ty(pty)) {
            List<string>:fs = raw struct_fields(pty);
            if (raw text_starts_with(pty, "%")) { fs = raw struct_fields(raw floor_type_body(ft, pty)); }
            for (int64:f in 0i64...fs.count) {
                string:pf = string_concat(bare, ".");
                pf = string_concat(pf, int_to_string(f));
                drop strlist_push(@out, pf);
            }
            continue;
        }
        drop strlist_push(@out, bare);
    }
    pass out;
};

// Does a block of the define carry the label?
func:has_label = bool(FloorText->:ft, int64:fi, string:label) never fails {
    pass ((raw floor_block_index(@ft.fns.items[fi], label)) >= 0i64);
};

// THE SPEC BELT (D-288 §2.11): every `(symbol ...)` section names a define
// of the floor; a `(loop LABEL ...)` names a block of it with exactly one
// treatment; every section claims something (a clause that yields rows) or
// says why not (`residue`, `boundary`); a `(summary)` section has an
// `ensures` (a summary with nothing to assume is a hole a caller would
// fall through); no symbol is specified twice; a clause head outside the
// grammar is refused by name; a head the translator reads once is written
// once, and a loop holds only the four sub-clauses it reads (1.5.6c step 1:
// either was dropped in silence before).
pub func:floor_spec_current = List<string>(FloorText->:ft, Sxs->:s) never fails {
    List<string>:fl = raw list_init::<string>(4i64);
    List<string>:seen = raw list_init::<string>(64i64);
    for (int64:i in 0i64...s.roots.count) {
        int64:r = s.roots.items[i];
        string:head = raw sx_head(s, r);
        if (raw text_eq(head, "shared")) { continue; }
        if (!(raw text_eq(head, "symbol"))) {
            drop strlist_push(@fl, string_concat("floor: runtime/npkrt.spec: a top-level form that is neither (shared ...) nor (symbol ...): ", head));
            continue;
        }
        string:name = raw sx_atom(s, raw sx_nth(s, r, 1i64));
        if (name.len == 0i64) { drop strlist_push(@fl, "floor: runtime/npkrt.spec: a (symbol ...) without a name"); continue; }
        if (raw strlist_contains(seen, name)) { drop strlist_push(@fl, string_concat("floor: runtime/npkrt.spec: a symbol specified twice: ", name)); continue; }
        drop strlist_push(@seen, name);
        int64:fi = raw floor_fn_index(ft, name);
        if (fi < 0i64) { drop strlist_push(@fl, string_concat("floor: runtime/npkrt.spec names a symbol the floor does not define: ", name)); continue; }
        bool:claims = false;
        bool:excused = false;
        bool:summary = false;
        bool:has_ensures = false;
        int64:c = s.nodes.items[r].first;
        c = s.nodes.items[c].next;   // past `symbol`
        c = s.nodes.items[c].next;   // past the name
        while (c >= 0i64) {
            if (!(raw sx_is_list(s, c))) {
                drop strlist_push(@fl, string_concat("floor: runtime/npkrt.spec: a bare word inside the section of ", name));
                break;
            }
            string:ch = raw sx_head(s, c);
            bool:known = false;
            if (raw text_eq(ch, "free")) { known = true; }
            if (raw text_eq(ch, "requires")) { known = true; }
            if (raw text_eq(ch, "ensures")) { known = true; claims = true; has_ensures = true; }
            if (raw text_eq(ch, "ensures-trap")) { known = true; claims = true; }
            if (raw text_eq(ch, "frame")) { known = true; claims = true; }
            if (raw text_eq(ch, "summary")) { known = true; summary = true; }
            if (raw text_eq(ch, "residue")) { known = true; excused = true; }
            if (raw text_eq(ch, "boundary")) { known = true; excused = true; }
            if (raw text_eq(ch, "objects")) { known = true; }
            if (raw text_eq(ch, "views")) { known = true; }
            if (raw text_eq(ch, "ensures-fresh")) { known = true; claims = true; has_ensures = true; }
            if (raw text_eq(ch, "ensures-trap")) { has_ensures = true; }
            if (raw text_eq(ch, "frame")) { has_ensures = true; }
            if (raw text_eq(ch, "loop")) {
                known = true;
                claims = true;
                string:label = raw sx_atom(s, raw sx_nth(s, c, 1i64));
                if (!(raw has_label(ft, fi, label))) {
                    string:w = string_concat("floor: runtime/npkrt.spec: ", name);
                    w = string_concat(w, " has no block labelled ");
                    w = string_concat(w, label);
                    drop strlist_push(@fl, w);
                }
                int64:treatments = (raw spec_clause_count(s, c, "invariant")) + (raw spec_clause_count(s, c, "unroll"));
                if (treatments != 1i64) {
                    string:w2 = string_concat("floor: runtime/npkrt.spec: the loop ", label);
                    w2 = string_concat(w2, " of ");
                    w2 = string_concat(w2, name);
                    w2 = string_concat(w2, " needs exactly one of (invariant I) and (unroll N)");
                    drop strlist_push(@fl, w2);
                }
                // a sub-clause the translator does not read would be dropped in silence (1.5.6c step 1)
                int64:lc = s.nodes.items[c].first;
                lc = s.nodes.items[lc].next;   // past `loop`
                if (lc >= 0i64) { lc = s.nodes.items[lc].next; }   // past the label
                while (lc >= 0i64) {
                    if (!(raw sx_is_list(s, lc))) {
                        string:w5 = string_concat("floor: runtime/npkrt.spec: a bare word inside the loop ", label);
                        w5 = string_concat(w5, " of ");
                        w5 = string_concat(w5, name);
                        drop strlist_push(@fl, w5);
                        lc = s.nodes.items[lc].next;
                        continue;
                    }
                    string:lh = raw sx_head(s, lc);
                    bool:lknown = (raw text_eq(lh, "invariant")) || (raw text_eq(lh, "unroll")) || (raw text_eq(lh, "objects")) || (raw text_eq(lh, "inst"));
                    if (!lknown) {
                        string:w6 = string_concat("floor: runtime/npkrt.spec: a loop sub-clause the grammar does not know in the loop ", label);
                        w6 = string_concat(w6, " of ");
                        w6 = string_concat(w6, name);
                        w6 = string_concat(w6, ": ");
                        w6 = string_concat(w6, lh);
                        drop strlist_push(@fl, w6);
                    }
                    lc = s.nodes.items[lc].next;
                }
                if ((raw spec_clause_count(s, c, "objects")) > 1i64) {
                    string:w7 = string_concat("floor: runtime/npkrt.spec: a clause read once and written twice in the loop ", label);
                    w7 = string_concat(w7, " of ");
                    w7 = string_concat(w7, name);
                    w7 = string_concat(w7, ": objects");
                    drop strlist_push(@fl, w7);
                }
            }
            if (!known) {
                string:w3 = string_concat("floor: runtime/npkrt.spec: a clause the grammar does not know in ", name);
                w3 = string_concat(w3, ": ");
                w3 = string_concat(w3, ch);
                drop strlist_push(@fl, w3);
            }
            c = s.nodes.items[c].next;
        }
        // A HEAD THE TRANSLATOR READS ONCE MAY BE WRITTEN ONCE (1.5.6c step 1):
        // `spec_clause(s, sec, HEAD, 0)` is how `floor_smt.npk` reads each of
        // these, so a second was dropped in silence -- for `frame`,
        // `ensures-trap` and `ensures-fresh` a CLAIM written and never proven,
        // for `objects` and `views` a hypothesis written and never assumed. The
        // harness's `_ONCE_HEADS`, in its order.
        List<string>:once = raw list_init::<string>(8i64);
        drop strlist_push(@once, "objects");
        drop strlist_push(@once, "views");
        drop strlist_push(@once, "frame");
        drop strlist_push(@once, "ensures-trap");
        drop strlist_push(@once, "ensures-fresh");
        drop strlist_push(@once, "residue");
        drop strlist_push(@once, "boundary");
        drop strlist_push(@once, "summary");
        for (int64:oi in 0i64...once.count) {
            if ((raw spec_clause_count(s, r, raw strlist_view(once, oi))) > 1i64) {
                string:w8 = string_concat("floor: runtime/npkrt.spec: a clause read once and written twice in ", name);
                w8 = string_concat(w8, ": ");
                w8 = string_concat(w8, raw strlist_view(once, oi));
                drop strlist_push(@fl, w8);
            }
        }
        if (!(claims || excused)) {
            drop strlist_push(@fl, string_concat("floor: runtime/npkrt.spec: a section with no claim and no residue or boundary sentence: ", name));
        }
        if (summary && (!has_ensures)) {
            drop strlist_push(@fl, string_concat("floor: runtime/npkrt.spec: a (summary) symbol without an ensures -- a caller would assume nothing: ", name));
        }
        // every parameter a clause could name exists: a `requires`/`ensures` naming an
        // unknown word is refused by the translator; here the section's free symbols
        // must not shadow a parameter
        List<string>:pn = raw param_names(ft, fi);
        int64:fk = 0i64;
        while (true) {
            int64:fc = raw spec_clause(s, r, "free", fk);
            if (fc < 0i64) { break; }
            fk = fk + 1i64;
            string:fname = raw sx_atom(s, raw sx_nth(s, fc, 1i64));
            if (raw strlist_contains(pn, fname)) {
                string:w4 = string_concat("floor: runtime/npkrt.spec: a free symbol of ", name);
                w4 = string_concat(w4, " shadows its parameter ");
                w4 = string_concat(w4, fname);
                drop strlist_push(@fl, w4);
            }
        }
    }
    pass fl;
};

// --- TCB.md's disposition column (D-288 §2.10) --------------------------------------------

// The floor's classes as TCB.md's table carries them (`asm`/`atomic`/
// `syscall`/`pure`; the harness's `_floor_classes`, form for form): inline
// asm in the body or a call of a symbol `module asm` defines (the clone's
// `npk_clone_raw`), an atomic operation, reaching an asm define
// transitively, or none of those -- over code lines, never comments.
pub func:floor_classes = List<string>(FloorText->:ft) never fails {
    int64:n = ft.fns.count;
    List<string>:cls = raw list_init::<string>(n + 1i64);
    List<bool>:is_asm = raw list_init::<bool>(n + 1i64);
    List<bool>:is_atomic = raw list_init::<bool>(n + 1i64);
    for (int64:i in 0i64...n) {
        bool:a = false;
        bool:at = false;
        for (int64:b in 0i64...ft.fns.items[i].blocks.count) {
            for (int64:l in 0i64...ft.fns.items[i].blocks.items[b].lines.count) {
                string:ln = raw strlist_view(ft.fns.items[i].blocks.items[b].lines, l);
                if (raw has_word(ln, "asm")) { a = true; }
                if ((raw text_index_of(ln, "call ")) >= 0i64) {
                    for (int64:ai in 0i64...ft.asm_syms.count) {
                        string:asym = raw strlist_view(ft.asm_syms, ai);
                        if (raw text_contains(ln, string_concat(asym, "("))) { a = true; }
                    }
                }
                if (raw has_word(ln, "atomicrmw") || raw has_word(ln, "cmpxchg") || raw has_word(ln, "fence")) { at = true; }
                if (raw text_contains(ln, "load atomic ") || raw text_contains(ln, "store atomic ")) { at = true; }
            }
        }
        drop list_push(@is_asm, a);
        drop list_push(@is_atomic, at);
    }
    // reaches asm: a fixpoint over the call graph
    List<bool>:reaches = raw list_init::<bool>(n + 1i64);
    for (int64:i2 in 0i64...n) { drop list_push(@reaches, is_asm.items[i2]); }
    bool:grew = true;
    while (grew) {
        grew = false;
        for (int64:i3 in 0i64...n) {
            if (reaches.items[i3]) { continue; }
            for (int64:b2 in 0i64...ft.fns.items[i3].blocks.count) {
                for (int64:l2 in 0i64...ft.fns.items[i3].blocks.items[b2].lines.count) {
                    string:ln2 = raw strlist_view(ft.fns.items[i3].blocks.items[b2].lines, l2);
                    if ((raw text_index_of(ln2, "call ")) < 0i64) { continue; }
                    int64:at2 = raw text_find_byte(ln2, 64u8, 0i64);
                    if (at2 < 0i64) { continue; }
                    int64:e = at2;
                    while ((e < ln2.len) && (ln2.ptr[e] != 40u8) && (ln2.ptr[e] != 32u8)) { e = e + 1i64; }
                    int64:ci = raw floor_fn_index(ft, raw text_slice(ln2, at2, e));
                    if (ci < 0i64) { continue; }
                    if (reaches.items[ci]) { reaches.items[i3] = true; grew = true; }
                }
            }
        }
    }
    for (int64:i4 in 0i64...n) {
        if (is_asm.items[i4]) { drop strlist_push(@cls, "asm"); continue; }
        if (is_atomic.items[i4]) { drop strlist_push(@cls, "atomic"); continue; }
        if (reaches.items[i4]) { drop strlist_push(@cls, "syscall"); continue; }
        drop strlist_push(@cls, "pure");
    }
    pass cls;
};

// Does the line carry `w` as a whole word?
func:has_word = bool(string:line, string:w) never fails {
    int64:from = 0i64;
    while (true) {
        int64:p = raw text_index_from(line, w, from);
        if (p < 0i64) { pass false; }
        bool:ok = true;
        if (p > 0i64) { if (raw is_word_byte(line.ptr[p - 1i64])) { ok = false; } }
        if ((p + w.len) < line.len) { if (raw is_word_byte(line.ptr[p + w.len])) { ok = false; } }
        if (ok) { pass true; }
        from = p + 1i64;
    }
    pass false;
};

func:is_word_byte = bool(uint8:c) never fails {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }
    if ((c >= 65u8) && (c <= 90u8)) { pass true; }
    if ((c >= 48u8) && (c <= 57u8)) { pass true; }
    if ((c == 95u8) || (c == 46u8)) { pass true; }
    pass false;
};

// The class default text TCB.md carried before a symbol had a disposition.
func:class_default = string(string:cls) never fails {
    if (raw text_eq(cls, "asm")) { pass "the volatile bottom (inline asm): TRUSTED, documented; no proof"; }
    if (raw text_eq(cls, "atomic")) { pass "a modelled primitive (1.5.6, the r6 verdict: model the primitive, never the whole executor)"; }
    if (raw text_eq(cls, "syscall")) { pass "specified at the syscall boundary (1.5.6); the kernel is trusted"; }
    pass "pure IR: Z3-specified at 1.5.6 where feasible";
};

// THE DISPOSITION of one symbol, in §2.1's words, from the spec and the
// committed floor manifest: `trusted (inline asm)` for the asm class;
// `specified (N discharged, M residue)` for a section with rows in the
// manifest (M the budget rows -- residue by the verdict rule); `residue
// (sentence)` and `boundary (sentence)` for a section that says so and has
// no rows; the class default for a symbol no section names yet.
pub func:floor_disposition = string(Sxs->:s, string:name, string:cls, List<ManRow>->:rows, List<MModel>:models) never fails {
    if (raw text_eq(cls, "asm")) { pass "trusted (inline asm)"; }
    // `modelled (a, b)`: the models whose steps name a block of the symbol (1.5.6 step 5)
    string:modelled = "";
    for (int64:mi in 0i64...models.count) {
        bool:names_it = false;
        for (int64:si in 0i64...models.items[mi].steps.count) {
            if (raw strlist_contains(models.items[mi].steps.items[si].ir_syms, name)) { names_it = true; }
        }
        if (!names_it) { continue; }
        if (modelled.len > 0i64) { modelled = string_concat(modelled, ", "); }
        modelled = string_concat(modelled, raw strlist_view_of(models.items[mi].name));
    }
    int64:sec = raw spec_section(s, name);
    if (sec < 0i64) {
        if (modelled.len > 0i64) { pass (string_concat("modelled (", string_concat(modelled, ")"))); }
        pass (raw class_default(cls));
    }
    int64:d = 0i64;
    int64:b = 0i64;
    int64:o = 0i64;
    for (int64:i in 0i64...rows.count) {
        if (!(raw text_eq(raw strlist_view_of(rows.items[i].symbol), name))) { continue; }
        if (rows.items[i].kind != (raw OK_FLOOR_SPEC())) { continue; }
        if (rows.items[i].verdict == (raw OV_DISCHARGED())) { d = d + 1i64; }
        if (rows.items[i].verdict == (raw OV_BUDGET())) { b = b + 1i64; }
        if (rows.items[i].verdict == (raw OV_OPEN())) { o = o + 1i64; }
    }
    string:out = "";
    if ((d + b + o) > 0i64) {
        out = string_concat("specified (", int_to_string(d));
        out = string_concat(out, " discharged, ");
        out = string_concat(out, int_to_string(b));
        out = string_concat(out, " residue)");
        if (o > 0i64) { out = string_concat(out, " -- REFUTED: a red run"); }
    }
    int64:rs = raw spec_clause(s, sec, "residue", 0i64);
    if (rs >= 0i64) {
        string:sent = raw sx_string(s, raw sx_nth(s, rs, 1i64));
        if (out.len > 0i64) { out = string_concat(out, "; "); }
        out = string_concat(out, "residue (");
        out = string_concat(out, sent);
        out = string_concat(out, ")");
    }
    int64:bd = raw spec_clause(s, sec, "boundary", 0i64);
    if (bd >= 0i64) {
        string:sent2 = raw sx_string(s, raw sx_nth(s, bd, 1i64));
        if (out.len > 0i64) { out = string_concat(out, "; "); }
        out = string_concat(out, "boundary (");
        out = string_concat(out, sent2);
        out = string_concat(out, ")");
    }
    if (modelled.len > 0i64) {
        if (out.len > 0i64) { out = string_concat(out, "; "); }
        out = string_concat(out, "modelled (");
        out = string_concat(out, modelled);
        out = string_concat(out, ")");
    }
    if (out.len == 0i64) { pass (raw class_default(cls)); }
    pass out;
};

// The table's rows as TCB.md carries them, sorted by symbol: `| `@name` | class | disposition |`.
pub func:tcb_floor_rows = List<string>(FloorText->:ft, Sxs->:s, List<ManRow>->:rows, List<MModel>:models) never fails {
    List<string>:cls = raw floor_classes(ft);
    List<string>:keyed = raw list_init::<string>(ft.fns.count + 1i64);
    for (int64:i in 0i64...ft.fns.count) {
        string:name = raw strlist_view_of(ft.fns.items[i].name);
        string:ln = string_concat("| `", name);
        ln = string_concat(ln, "` | ");
        ln = string_concat(ln, raw strlist_view(cls, i));
        ln = string_concat(ln, " | ");
        ln = string_concat(ln, raw floor_disposition(s, name, raw strlist_view(cls, i), rows, models));
        ln = string_concat(ln, " |");
        drop strlist_push(@keyed, ln);
    }
    pass (raw strlist_sorted(keyed));
};

// --- what the evidence does not cover (1.5.6 step 6; D-288 SS2.10) ----------------------

// TCB.md's residue region, byte for byte with the harness's `residue_region`:
// every `budget` row by symbol, every `(residue "...")` sentence the spec
// carries, and the models' standing residue. The list a reader is likeliest
// to skip is the one that matters most, so it is generated, not maintained.
pub func:tcb_residue_region = string(Sxs->:s, List<ManRow>->:rows, List<MModel>:models, string:root) never fails {
    List<string>:syms = raw list_init::<string>(4i64);
    List<int64>:counts = raw list_init::<int64>(4i64);
    int64:total = 0i64;
    for (int64:i in 0i64...rows.count) {
        if (rows.items[i].verdict != (raw OV_BUDGET())) { continue; }
        total = total + 1i64;
        string:sym = raw strlist_view_of(rows.items[i].symbol);
        int64:at = 0i64 - 1i64;
        for (int64:k in 0i64...syms.count) { if (raw text_eq(raw strlist_view(syms, k), sym)) { at = k; } }
        if (at < 0i64) { drop strlist_push(@syms, sym); drop list_push(@counts, 1i64); }
        else { counts.items[at] = counts.items[at] + 1i64; }
    }
    string:out = "**Rows the profile did not decide** (`budget`; the verdict rule keeps them as\nresidue, never as a proof). ";
    if (total > 0i64) { out = string_concat(out, string_concat(int_to_string(total), " of them")); }
    else { out = string_concat(out, "None"); }
    out = string_concat(out, ":\n\n");
    // the symbols in ascending order, as the harness's `sorted` gives them
    List<string>:ordered = raw strlist_sorted(syms);
    for (int64:o in 0i64...ordered.count) {
        string:sym2 = raw strlist_view(ordered, o);
        int64:c2 = 0i64;
        for (int64:k2 in 0i64...syms.count) { if (raw text_eq(raw strlist_view(syms, k2), sym2)) { c2 = counts.items[k2]; } }
        out = string_concat(out, "- `");
        out = string_concat(out, sym2);
        out = string_concat(out, "` -- ");
        out = string_concat(out, int_to_string(c2));
        out = string_concat(out, " row(s); the section's `(residue ...)` sentence says why.\n");
    }
    out = string_concat(out, "\n**Sentences the spec carries**, each a claim NOT made:\n\n");
    for (int64:r in 0i64...s.roots.count) {
        int64:root = s.roots.items[r];
        if (!(raw text_eq(raw sx_head(s, root), "symbol"))) { continue; }
        string:name = raw sx_atom(s, raw sx_nth(s, root, 1i64));
        int64:rs = raw spec_clause(s, root, "residue", 0i64);
        if (rs < 0i64) { continue; }
        out = string_concat(out, "- `");
        out = string_concat(out, name);
        out = string_concat(out, "` -- ");
        out = string_concat(out, raw sx_string(s, raw sx_nth(s, rs, 1i64)));
        out = string_concat(out, "\n");
    }
    // THE MODELS ARE READ TWICE (1.5.6b step 4d; D-295): the solver's bounded
    // rows, and the explicit-state search over each model's whole reachable
    // space (`floor_explore.npk`), whose numbers this paragraph prints and
    // whose belt is what lets it say "no bad state" without a bound.
    out = string_concat(out, "\n**The models' residue** (VERIFICATION_REFERENCE SS9.4): every model is read twice --\n");
    out = string_concat(out, "bounded, by the solver (its rows hold to their own depth and preemption bound and no\n");
    out = string_concat(out, "further), and exhaustively, by explicit-state search over its whole reachable space\n");
    out = string_concat(out, "(D-295), which is where the SAFETY claim rests: no bad state is reachable in any model\n");
    out = string_concat(out, "below, inside its bounds or outside them. LIVENESS is not claimed at all -- that a due\n");
    out = string_concat(out, "task is eventually run, and that the shared arena's walker stops spinning, need a\n");
    out = string_concat(out, "fairness assumption neither reading can state.");
    XTexts:mt = raw xp_model_texts(root);
    string:facts = "";
    for (int64:fi in 0i64...mt.names.count) {
        string:one = raw xp_facts(raw strlist_view(mt.texts, fi));
        if (one.len == 0i64) { continue; }
        if (facts.len > 0i64) { facts = string_concat(facts, ", "); }
        facts = string_concat(facts, "`");
        facts = string_concat(facts, raw strlist_view(mt.names, fi));
        facts = string_concat(facts, "` ");
        facts = string_concat(facts, one);
    }
    if (facts.len > 0i64) {
        out = string_concat(out, "\nThe models, each with its bounds and its reachable states (and how many of them the bounds reach): ");
        out = string_concat(out, facts);
        out = string_concat(out, ".");
        pass out;
    }
    if (models.count > 0i64) {
        out = string_concat(out, "\nThe bounds in force: ");
        for (int64:m in 0i64...models.count) {
            if (m > 0i64) { out = string_concat(out, ", "); }
            out = string_concat(out, "`");
            out = string_concat(out, raw strlist_view_of(models.items[m].name));
            out = string_concat(out, "`");
        }
        out = string_concat(out, ".");
    }
    pass out;
};

pub func:tcb_residue_current = List<string>(Sxs->:s, List<ManRow>->:rows, List<MModel>:models, string:tcb_text, string:root) never fails {
    List<string>:fl = raw list_init::<string>(2i64);
    string:bmark = "<!-- BEGIN floor-residue -->\n";
    string:emark = "\n<!-- END floor-residue -->";
    int64:b = raw text_index_of(tcb_text, bmark);
    int64:e = raw text_index_of(tcb_text, emark);
    if ((b < 0i64) || (e < 0i64) || (e < b)) { drop strlist_push(@fl, "tcb-residue: TCB.md has no marked floor-residue region"); pass fl; }
    string:have = raw text_slice(tcb_text, b + bmark.len, e);
    string:want = raw tcb_residue_region(s, rows, models, root);
    if (!(raw text_eq(have, want))) {
        drop strlist_push(@fl, "tcb-residue: TCB.md's residue region is not what the spec and the committed floor manifest say -- regenerate it (bootstrap/harness/tcb_floor.py --write)");
    }
    pass fl;
};

// --- who keeps a section's assumptions (1.5.6c step 3; leads E-1 and E-2) ------------------
//
// A section's `requires`, `(objects ...)` and `(views ...)` are HYPOTHESES of its
// rows. A translated caller of a `(summary)` symbol proves them, as rows at the
// call; a translated caller of any other symbol INLINES it, so the caller's own
// rows cover the body in the caller's context. Every other call -- from a floor
// symbol that is not translated, or from EMITTED code, which reaches whatever
// the floor exports -- is checked by nothing. TCB.md SS4d says which calls are
// which, generated: the hand-written account (1.5.6c's first walk) was wrong
// twice in eleven sections. The harness's `floor.callers_region`, byte for
// byte: the sections in the SPEC's order, the callers in the FLOOR's order --
// neither runner sorts.

// `floor_emit`'s own rule for what becomes a file of rows: a claim that yields
// rows, and no `(boundary ...)` sentence. A symbol with no section is not.
func:callers_translated = bool(Sxs->:s, string:name) never fails {
    int64:sec = raw spec_section(s, name);
    if (sec < 0i64) { pass false; }
    bool:claims = (raw spec_has(s, sec, "ensures")) || (raw spec_has(s, sec, "ensures-trap")) || (raw spec_has(s, sec, "frame")) || (raw spec_has(s, sec, "loop"));
    if (!claims) { pass false; }
    pass (!(raw spec_has(s, sec, "boundary")));
};

// Does define `fi` call `sym` (a direct call, anywhere in its body)?
func:callers_calls = bool(FloorText->:ft, int64:fi, string:sym) never fails {
    List<FCall>:cs = raw floor_calls(@ft.fns.items[fi]);
    for (int64:i in 0i64...cs.count) {
        if (raw text_eq(raw strlist_view_of(cs.items[i].callee), sym)) { pass true; }
    }
    pass false;
};

// "`@a` `@b`", or "--" for none.
func:callers_names = string(List<string>:xs) never fails {
    if (xs.count == 0i64) { pass "--"; }
    string:out = "";
    for (int64:i in 0i64...xs.count) {
        if (i > 0i64) { out = string_concat(out, " "); }
        out = string_concat(out, "`");
        out = string_concat(out, raw strlist_view(xs, i));
        out = string_concat(out, "`");
    }
    pass out;
};

pub func:tcb_callers_region = string(FloorText->:ft, Sxs->:s) never fails {
    List<string>:syms = raw spec_symbols(s);
    List<ReqClause>:clauses = raw req_clauses(ft, s);        // the entry checkers' classification (step 5)
    string:table = "";
    int64:total = 0i64;
    int64:n_open = 0i64;
    int64:n_exp = 0i64;
    int64:n_closed = 0i64;
    for (int64:i in 0i64...syms.count) {
        string:sym = raw strlist_view(syms, i);
        int64:fi = raw floor_fn_index(ft, sym);
        if (fi < 0i64) { continue; }
        if (!(raw callers_translated(s, sym))) { continue; }
        int64:sec = raw spec_section(s, sym);
        string:assumes = "";
        if (raw spec_has(s, sec, "requires")) { assumes = string_concat(assumes, "requires"); }
        if (raw spec_has(s, sec, "objects")) {
            if (assumes.len > 0i64) { assumes = string_concat(assumes, " "); }
            assumes = string_concat(assumes, "objects");
        }
        if (raw spec_has(s, sec, "views")) {
            if (assumes.len > 0i64) { assumes = string_concat(assumes, " "); }
            assumes = string_concat(assumes, "views");
        }
        if (assumes.len == 0i64) { continue; }
        bool:summary = raw spec_has(s, sec, "summary");
        List<string>:covered = raw list_init::<string>(4i64);
        List<string>:unproved = raw list_init::<string>(4i64);
        for (int64:c in 0i64...ft.fns.count) {
            if (c == fi) { continue; }
            if (!(raw callers_calls(ft, c, sym))) { continue; }
            string:cname = raw strlist_view_of(ft.fns.items[c].name);
            if (raw callers_translated(s, cname)) { drop strlist_push(@covered, cname); }
            else { drop strlist_push(@unproved, cname); }
        }
        List<string>:none = raw list_init::<string>(1i64);
        bool:exported = !ft.fns.items[fi].internal;
        total = total + 1i64;
        if (unproved.count > 0i64) { n_open = n_open + 1i64; }
        if (exported) { n_exp = n_exp + 1i64; }
        if ((unproved.count == 0i64) && (!exported)) { n_closed = n_closed + 1i64; }
        // the last column (1.5.7 step 5, D-302): the section's hypotheses the entry checker executes, of those it states
        int64:ex_c = 0i64;
        int64:ex_n = 0i64;
        for (int64:q in 0i64...clauses.count) {
            if (!(raw text_eq(raw strlist_view_of(clauses.items[q].symbol), sym))) { continue; }
            ex_n = ex_n + 1i64;
            if (raw text_eq(raw strlist_view_of(clauses.items[q].status), "checked")) { ex_c = ex_c + 1i64; }
        }
        table = string_concat(table, "\n| `");
        table = string_concat(table, sym);
        table = string_concat(table, "` | ");
        table = string_concat(table, assumes);
        table = string_concat(table, " | ");
        if (summary) { table = string_concat(table, raw callers_names(covered)); } else { table = string_concat(table, raw callers_names(none)); }
        table = string_concat(table, " | ");
        if (summary) { table = string_concat(table, raw callers_names(none)); } else { table = string_concat(table, raw callers_names(covered)); }
        table = string_concat(table, " | ");
        table = string_concat(table, raw callers_names(unproved));
        if (exported) { table = string_concat(table, " | yes | "); } else { table = string_concat(table, " | no | "); }
        table = string_concat(table, int_to_string(ex_c));
        table = string_concat(table, " of ");
        table = string_concat(table, int_to_string(ex_n));
        table = string_concat(table, " |");
    }
    int64:n_checked = 0i64;
    int64:n_listed = 0i64;
    for (int64:q2 in 0i64...clauses.count) {
        if (raw text_eq(raw strlist_view_of(clauses.items[q2].status), "checked")) { n_checked = n_checked + 1i64; } else { n_listed = n_listed + 1i64; }
    }
    string:out = string_concat(int_to_string(total), " sections have rows AND assume something of their caller. For ");
    out = string_concat(out, int_to_string(n_closed));
    out = string_concat(out, " of them every caller is covered -- no\nuntranslated floor caller, and the symbol is not exported; ");
    out = string_concat(out, int_to_string(n_open));
    out = string_concat(out, " have a floor caller no row covers; ");
    out = string_concat(out, int_to_string(n_exp));
    out = string_concat(out, " are\nEXPORTED, so emitted code can call them and nothing proves the assumption there. Under the explorer (1.5.7\nstep 5, D-302) ");
    out = string_concat(out, int_to_string(n_checked));
    out = string_concat(out, " of the ");
    out = string_concat(out, int_to_string(clauses.count));
    out = string_concat(out, " hypotheses these sections state are EXECUTED at every call of every explored\nschedule by a generated entry checker, untranslated floor callers and emitted code alike; the ");
    out = string_concat(out, int_to_string(n_listed));
    out = string_concat(out, " it cannot\nevaluate are listed by name below the table.\n\n");
    out = string_concat(out, "| symbol | assumes | a row at the call | inlined into | NOT PROVED: floor callers | NOT PROVED: emitted code | executed at every explored call |\n|---|---|---|---|---|---|---|");
    out = string_concat(out, table);
    if (n_listed > 0i64) {
        out = string_concat(out, "\n\nListed, not checked -- a clause the entry checker cannot evaluate over the entry state:");
        bool:first_l = true;
        for (int64:q3 in 0i64...clauses.count) {
            if (raw text_eq(raw strlist_view_of(clauses.items[q3].status), "checked")) { continue; }
            if (first_l) { out = string_concat(out, "\n"); first_l = false; } else { out = string_concat(out, "\n"); }
            out = string_concat(out, "- `");
            out = string_concat(out, raw strlist_view_of(clauses.items[q3].symbol));
            out = string_concat(out, "`: `");
            out = string_concat(out, raw strlist_view_of(clauses.items[q3].text));
            out = string_concat(out, "` -- ");
            out = string_concat(out, raw strlist_view_of(clauses.items[q3].reason));
        }
    }
    pass out;
};

pub func:tcb_callers_current = List<string>(FloorText->:ft, Sxs->:s, string:tcb_text) never fails {
    List<string>:fl = raw list_init::<string>(2i64);
    string:bmark = "<!-- BEGIN floor-callers -->\n";
    string:emark = "\n<!-- END floor-callers -->";
    int64:b = raw text_index_of(tcb_text, bmark);
    int64:e = raw text_index_of(tcb_text, emark);
    if ((b < 0i64) || (e < 0i64) || (e < b)) { drop strlist_push(@fl, "tcb-callers: TCB.md has no marked floor-callers region"); pass fl; }
    string:have = raw text_slice(tcb_text, b + bmark.len, e);
    string:want = raw tcb_callers_region(ft, s);
    if (!(raw text_eq(have, want))) {
        drop strlist_push(@fl, "tcb-callers: TCB.md's callers region is not what the floor and the spec say -- regenerate it (bootstrap/harness/tcb_floor.py --write)");
    }
    pass fl;
};

// --- the syscall boundary (1.5.6 step 6; D-288 SS2.8) -----------------------------------

// The kernel's name for a number the floor issues ("" when the table does
// not name it -- a finding, not a blank: the kernel-effect table has one row
// per number and a reader accepts those rows as the kernel's promise).
pub func:syscall_name = string(int64:n) never fails {
    // the name is the kernel-effect table's (floor_kernel.npk, generated from
    // VERIFICATION_REFERENCE SS9.2); this function carried a copy until 1.5.6b
    string:nm = raw ke_name(n);
    if (raw text_eq(nm, "?")) { pass ""; }
    pass nm;
};

// The value operands of an `@npk_sys6(...)` call on this line, the number
// first; none when the line is no such call. Every operand is `i64 VALUE`.
func:sys6_args = List<string>(string:line) never fails {
    List<string>:out = raw list_init::<string>(8i64);
    int64:c = raw text_index_of(line, "@npk_sys6(");
    if (c < 0i64) { pass out; }
    int64:s = c + 10i64;
    int64:e = raw text_find_byte(line, 41u8, s);
    if (e < 0i64) { pass out; }
    List<string>:w = raw text_split_ws(raw text_replace_byte(raw text_slice(line, s, e), 44u8, 32u8));
    int64:i = 1i64;
    while (i < w.count) {
        drop strlist_push(@out, raw strlist_copy(w, i));
        i = i + 2i64;
    }
    pass out;
};

// The decimal a word spells, or -1 (no syscall number and no option is negative).
func:sys6_int = int64(string:s) never fails {
    Result<int64>:r = text_int(s);
    if (r.is_error) { pass (0i64 - 1i64); }
    pass r.value;
};

// Is `name` one of the trap route's entries? Every symbol reaches
// `exit_group` through a trap, which says nothing about the symbol, so the
// route is NAMED in the table rather than counted into a reach.
func:is_trap_entry = bool(string:name) never fails {
    if (raw text_eq(name, "@npk_trap")) { pass true; }
    if (raw text_eq(name, "@npk_raise")) { pass true; }
    if (raw text_eq(name, "@npk_heap_badreq")) { pass true; }
    if (raw text_eq(name, "@npk_heap_oom")) { pass true; }
    if (raw text_eq(name, "@npk_heap_bad")) { pass true; }
    pass false;
};

// The syscall numbers `fi` issues directly, in ascending order.
pub func:floor_direct_syscalls = List<int64>(FloorText->:ft, int64:fi) never fails {
    List<int64>:out = raw list_init::<int64>(4i64);
    for (int64:b in 0i64...ft.fns.items[fi].blocks.count) {
        for (int64:l in 0i64...ft.fns.items[fi].blocks.items[b].lines.count) {
            string:ln = raw strlist_view(ft.fns.items[fi].blocks.items[b].lines, l);
            int64:p = raw text_index_of(ln, "call i64 @npk_sys6(i64 ");
            if (p < 0i64) { continue; }
            int64:s2 = p + 23i64;
            int64:e = s2;
            while ((e < ln.len) && (ln.ptr[e] != 44u8)) { e = e + 1i64; }
            uint128:v = 0u128;
            if (!(raw u128_parse(raw text_slice(ln, s2, e), 64i64, @v))) { continue; }
            int64:n = v =>! int64;
            bool:have = false;
            for (int64:i in 0i64...out.count) { if (out.items[i] == n) { have = true; } }
            if (!have) { drop list_push(@out, n); }
        }
    }
    // ascending
    for (int64:i2 in 0i64...out.count) {
        for (int64:j in (i2 + 1i64)...out.count) {
            if (out.items[j] < out.items[i2]) { int64:t = out.items[i2]; out.items[i2] = out.items[j]; out.items[j] = t; }
        }
    }
    pass out;
};

// The defines `fi` calls, by index.
func:floor_callees = List<int64>(FloorText->:ft, int64:fi) never fails {
    List<int64>:out = raw list_init::<int64>(4i64);
    for (int64:b in 0i64...ft.fns.items[fi].blocks.count) {
        for (int64:l in 0i64...ft.fns.items[fi].blocks.items[b].lines.count) {
            string:ln = raw strlist_view(ft.fns.items[fi].blocks.items[b].lines, l);
            if ((raw text_index_of(ln, "call ")) < 0i64) { continue; }
            int64:at = raw text_find_byte(ln, 64u8, 0i64);
            if (at < 0i64) { continue; }
            int64:e = at;
            while ((e < ln.len) && (ln.ptr[e] != 40u8) && (ln.ptr[e] != 32u8)) { e = e + 1i64; }
            int64:ci = raw floor_fn_index(ft, raw text_slice(ln, at, e));
            if (ci < 0i64) { continue; }
            bool:have = false;
            for (int64:i in 0i64...out.count) { if (out.items[i] == ci) { have = true; } }
            if (!have) { drop list_push(@out, ci); }
        }
    }
    pass out;
};

// The numbers `fi` reaches WITHOUT passing through a trap entry, and whether
// it can reach one (`traps`). A fixpoint over the call graph, the classifier's.
pub func:floor_reach_syscalls = List<int64>(FloorText->:ft, int64:fi, bool->:traps) never fails {
    List<int64>:out = raw list_init::<int64>(8i64);
    List<int64>:work = raw list_init::<int64>(8i64);
    List<bool>:seen = raw list_init::<bool>(ft.fns.count + 1i64);
    for (int64:i in 0i64...ft.fns.count) { drop list_push(@seen, false); }
    drop list_push(@work, fi);
    seen.items[fi] = true;
    <-traps = false;
    while (work.count > 0i64) {
        int64:cur = work.items[work.count - 1i64];
        work.count = work.count - 1i64;
        List<int64>:d = raw floor_direct_syscalls(ft, cur);
        for (int64:k in 0i64...d.count) {
            bool:have = false;
            for (int64:i2 in 0i64...out.count) { if (out.items[i2] == d.items[k]) { have = true; } }
            if (!have) { drop list_push(@out, d.items[k]); }
        }
        List<int64>:cs = raw floor_callees(ft, cur);
        for (int64:c in 0i64...cs.count) {
            int64:ci = cs.items[c];
            if (raw is_trap_entry(raw strlist_view_of(ft.fns.items[ci].name))) { <-traps = true; continue; }
            if (seen.items[ci]) { continue; }
            seen.items[ci] = true;
            drop list_push(@work, ci);
        }
    }
    if (raw is_trap_entry(raw strlist_view_of(ft.fns.items[fi].name))) { <-traps = false; }
    for (int64:i3 in 0i64...out.count) {
        for (int64:j in (i3 + 1i64)...out.count) {
            if (out.items[j] < out.items[i3]) { int64:t = out.items[i3]; out.items[i3] = out.items[j]; out.items[j] = t; }
        }
    }
    pass out;
};

// `0 read, 1 write` -- a number list as the table spells it ("--" for none).
func:syscall_list_text = string(List<int64>:ns) never fails {
    if (ns.count == 0i64) { pass "--"; }
    string:out = "";
    for (int64:i in 0i64...ns.count) {
        if (i > 0i64) { out = string_concat(out, ", "); }
        out = string_concat(out, int_to_string(ns.items[i]));
        out = string_concat(out, " ");
        out = string_concat(out, raw syscall_name(ns.items[i]));
    }
    pass out;
};

// TCB.md's syscall-table rows, in the floor's own order.
pub func:tcb_syscall_rows = List<string>(FloorText->:ft) never fails {
    List<string>:cls = raw floor_classes(ft);
    List<string>:out = raw list_init::<string>(64i64);
    for (int64:i in 0i64...ft.fns.count) {
        bool:traps = false;
        List<int64>:reach = raw floor_reach_syscalls(ft, i, @traps);
        if ((reach.count == 0i64) && (!traps)) { continue; }
        List<int64>:direct = raw floor_direct_syscalls(ft, i);
        string:rt = raw syscall_list_text(reach);
        if (traps) {
            if (reach.count == 0i64) { rt = "the trap route only"; }
            else { rt = string_concat(rt, ", and the trap route"); }
        }
        string:ln = string_concat("| `", raw strlist_view_of(ft.fns.items[i].name));
        ln = string_concat(ln, "` | ");
        ln = string_concat(ln, raw strlist_view(cls, i));
        ln = string_concat(ln, " | ");
        ln = string_concat(ln, raw syscall_list_text(direct));
        ln = string_concat(ln, " | ");
        ln = string_concat(ln, rt);
        ln = string_concat(ln, " |");
        drop strlist_push(@out, ln);
    }
    pass out;
};

// THE SYSCALL BELT: TCB.md's syscall table equals what the floor says today;
// every number the floor issues has a ROW in the kernel-effect table (not
// merely a name: TCB.md's head said "each has one row" while `clone` and
// `execve` had none, until 1.5.6b gave them their `asm` rows); and every
// `npk_sys6` call site of the floor -- translated or not -- passes, where its
// row's effect depends on an option, a NUMERAL the row speaks for.
// `arch_prctl(ARCH_GET_FS)` and `prctl(PR_GET_NAME)` WRITE user memory where
// the options the floor passes do not. `floor.py`'s `check_syscall_names` is
// the twin, finding for finding.
// Every number the floor issues has a row, and every `npk_sys6` site's option is one its row
// speaks for: the findings by name (`floor-syscall-row`, `floor-syscall-option`).
pub func:floor_syscall_sites = List<string>(FloorText->:ft) never fails {
    List<string>:fl = raw list_init::<string>(4i64);
    for (int64:i in 0i64...ft.fns.count) {
        List<int64>:d = raw floor_direct_syscalls(ft, i);
        for (int64:k in 0i64...d.count) {
            if ((raw ke_effect(d.items[k])) != 4i64) { continue; }
            string:w = string_concat("floor: floor-syscall-row: runtime/npkrt.ll issues syscall ", int_to_string(d.items[k]));
            w = string_concat(w, ", which the kernel-effect table has no row for -- give it one in VERIFICATION_REFERENCE SS9.2's `kernel-effects` region and regenerate");
            drop strlist_push(@fl, w);
        }
        for (int64:bi in 0i64...ft.fns.items[i].blocks.count) {
            for (int64:li in 0i64...ft.fns.items[i].blocks.items[bi].lines.count) {
                List<string>:sa = raw sys6_args(raw strlist_view(ft.fns.items[i].blocks.items[bi].lines, li));
                if (sa.count == 0i64) { continue; }
                int64:nr = raw sys6_int(raw strlist_view(sa, 0i64));
                if (nr < 0i64) { continue; }
                int64:oa = raw ke_option_arg(nr);
                if (oa == 0i64) { continue; }
                string:ov = "";
                if (oa < sa.count) { ov = raw strlist_copy(sa, oa); }
                int64:oval = raw sys6_int(ov);
                bool:admitted = false;
                if (oval >= 0i64) { admitted = raw ke_option_ok(nr, oval); }
                if (admitted) { continue; }
                string:wo = string_concat("floor: floor-syscall-option: `", ft.fns.items[i].name);
                wo = string_concat(wo, "` issues syscall ");
                wo = string_concat(wo, int_to_string(nr));
                wo = string_concat(wo, " (");
                wo = string_concat(wo, raw ke_name(nr));
                wo = string_concat(wo, ") with argument ");
                wo = string_concat(wo, int_to_string(oa));
                wo = string_concat(wo, " = `");
                wo = string_concat(wo, ov);
                wo = string_concat(wo, "`, which the kernel-effect table's row does not speak for -- an option the row does not list may write memory the row says it does not (add the option to the row, measured, or do not pass it)");
                drop strlist_push(@fl, wo);
            }
        }
    }
    pass fl;
};

pub func:tcb_syscalls_current = List<string>(FloorText->:ft, string:tcb_text) never fails {
    List<string>:fl = raw floor_syscall_sites(ft);
    int64:b = raw text_index_of(tcb_text, "<!-- BEGIN floor-syscalls -->");
    int64:e = raw text_index_of(tcb_text, "<!-- END floor-syscalls -->");
    if ((b < 0i64) || (e < 0i64) || (e < b)) { drop strlist_push(@fl, "tcb-syscalls: TCB.md has no marked floor-syscalls region"); pass fl; }
    List<string>:want = raw tcb_syscall_rows(ft);
    List<string>:have = raw list_init::<string>(want.count + 1i64);
    List<string>:lines = raw text_lines(raw text_slice(tcb_text, b, e));
    for (int64:i2 in 0i64...lines.count) {
        string:ln2 = raw strlist_view(lines, i2);
        if (raw text_starts_with(ln2, "| `@")) { drop strlist_push(@have, ln2); }
    }
    List<string>:missing = raw strlist_minus(want, have);
    List<string>:stale = raw strlist_minus(have, want);
    for (int64:m in 0i64...missing.count) {
        if (m >= 10i64) { break; }
        drop strlist_push(@fl, string_concat("tcb-syscalls: TCB.md's table lacks the row: ", raw strlist_view(missing, m)));
    }
    for (int64:st in 0i64...stale.count) {
        if (st >= 10i64) { break; }
        drop strlist_push(@fl, string_concat("tcb-syscalls: TCB.md's table carries a row the floor does not say: ", raw strlist_view(stale, st)));
    }
    pass fl;
};

// THE TCB BELT (P-26, extended at 1.5.6 step 3): TCB.md's floor table equals
// what the floor, the spec and the committed floor manifest say today --
// symbol, class and disposition. A symbol whose disposition drifted from
// its rows is a red run.
pub func:tcb_floor_current = List<string>(FloorText->:ft, Sxs->:s, List<ManRow>->:rows, List<MModel>:models, string:tcb_text) never fails {
    List<string>:fl = raw list_init::<string>(4i64);
    int64:b = raw text_index_of(tcb_text, "<!-- BEGIN floor-table -->");
    int64:e = raw text_index_of(tcb_text, "<!-- END floor-table -->");
    if ((b < 0i64) || (e < 0i64) || (e < b)) { drop strlist_push(@fl, "tcb-floor: TCB.md has no marked floor-table region"); pass fl; }
    List<string>:want = raw tcb_floor_rows(ft, s, rows, models);
    List<string>:have = raw list_init::<string>(want.count + 1i64);
    List<string>:lines = raw text_lines(raw text_slice(tcb_text, b, e));
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (raw text_starts_with(ln, "| `@")) { drop strlist_push(@have, ln); }
    }
    List<string>:missing = raw strlist_minus(want, have);
    List<string>:stale = raw strlist_minus(have, want);
    for (int64:m in 0i64...missing.count) {
        if (m >= 10i64) { break; }
        drop strlist_push(@fl, string_concat("tcb-floor: TCB.md's table lacks the row: ", raw strlist_view(missing, m)));
    }
    for (int64:st in 0i64...stale.count) {
        if (st >= 10i64) { break; }
        drop strlist_push(@fl, string_concat("tcb-floor: TCB.md's table carries a row the floor, the spec and the manifest do not say: ", raw strlist_view(stale, st)));
    }
    pass fl;
};
