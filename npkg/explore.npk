// explore -- THE EXPLORED FLOOR IS THE REAL FLOOR, TRANSFORMED (1.5.7 step 0;
// D-212, X-1, X-9 in meta/roadmap/1.5/1.5.7.md).
//
// The schedule explorer runs every synchronization step of the runtime under
// a seeded scheduler (r6's recipe, D-212). A mock floor that re-implemented the
// primitives would explore the mock; so the explored floor is GENERATED from
// `runtime/npkrt.ll` at test time by a text transform that adds calls and
// renames one callee, and every instruction the artifact runs is the
// instruction explored. Text in, text out:
//
//   - before every ATOMIC STEP LINE (`atomicrmw`, `cmpxchg`, `fence`,
//     `load atomic`, `store atomic` -- `line_is_step`'s own definition, the
//     model belt's census) `call void @npkx_point(i32 SITE)`;
//   - every `@npk_sys6(` CALL becomes `@npkx_sys6(` (same signature: the shim
//     takes the scheduling point itself and virtualizes what blocks);
//   - the thread lifecycle: `@npkx_prespawn()` before and `@npkx_spawned(i64
//     %r)` after the `@npk_clone_raw(` call (a statement that may span lines),
//     `@npkx_begin()` first in `@npk_thread_entry`, `@npkx_end()` before its
//     `ret`;
//   - `module asm`, `@npk_sys6`'s own body and every declaration are left
//     alone; the shim's declares are appended.
//
// THE TOTALITY BELT (`explore_totality`, both runners -- the harness's twin
// counts in `bootstrap/harness/explore.py` over THIS transformer's output):
// the number of step lines in the floor equals the number of points plus
// routed calls in the transformed text, and no step line of the output lacks
// its point (`explore-step-escapes`, by name). ONE transformer, as the floor
// has one translator; the belt is the second reader, and it is a count.
//
// The transform preserves every other line byte for byte. `sites` is one
// line per site, `N<TAB>function<TAB>kind<TAB>text`, the shim's map from a
// point's number to the instruction it precedes.

mod:explore;

use "./text.npk".*;
use "./floor_ir.npk".*;                        // floor_code_part: the line without its comment
use "./floor_model.npk".*;                     // line_is_step: the census's own definition
use "../src/backend/smt/smt_writer.npk".*;     // SmtBuf: one allocation for the joined text

pub struct:Explored = {
    string:text;             // the transformed floor
    string:sites;            // sites.txt
    int64:points;            // `@npkx_point` calls inserted -- the atomic step lines
    int64:routed;            // `@npk_sys6(` calls routed to `@npkx_sys6(`
    List<string>:problems;   // what the transform could not do, by name
};

// The raw lines of a text, byte for byte -- no `\r` handling: the floor has
// none, and a transform that dropped one would not be a transform.
func:raw_lines = List<string>(string:s) never fails {
    List<string>:out = raw list_init::<string>(8192i64);
    int64:start = 0i64;
    for (int64:i in 0i64...s.len) {
        if (s.ptr[i] == 10u8) {
            drop strlist_push(@out, raw text_slice(s, start, i));
            start = i + 1i64;
        }
    }
    if (start < s.len) { drop strlist_push(@out, raw text_slice(s, start, s.len)); }
    pass out;
};

// `define ... @name(` -- the symbol a define line introduces; "" otherwise.
func:define_symbol = string(string:code) never fails {
    if (!(raw text_starts_with(code, "define "))) { pass ""; }
    int64:at = raw text_find_byte(code, 64u8, 0i64);        // '@'
    if (at < 0i64) { pass ""; }
    int64:stop = at;
    while (stop < code.len) {
        uint8:c = code.ptr[stop];
        if ((c == 40u8) || (c == 32u8)) { break; }             // '(' or ' '
        stop = stop + 1i64;
    }
    pass (raw text_slice(code, at, stop));
};

// `%r = call ...` -- the register a call line defines; "" when it defines none.
func:defined_register = string(string:code) never fails {
    if (code.len == 0i64) { pass ""; }
    if (code.ptr[0i64] != 37u8) { pass ""; }                   // '%'
    int64:eq = raw text_index_of(code, " =");
    if (eq < 0i64) { pass ""; }
    pass (raw text_slice(code, 0i64, eq));
};

// An atomic step line: the census's definition minus the syscall trampoline.
pub func:line_is_atomic_step = bool(string:code) never fails {
    if (raw text_contains(code, "@npk_sys6(")) { pass false; }
    pass (raw line_is_step(code));
};

// A routed call: `@npk_sys6(` called, not defined.
pub func:line_is_sys6_call = bool(string:code) never fails {
    if (!(raw text_contains(code, "@npk_sys6("))) { pass false; }
    if (raw text_starts_with(code, "define ")) { pass false; }
    if (raw text_starts_with(code, "declare ")) { pass false; }
    pass (raw text_contains(code, "call "));
};

func:site_row = string(int64:n, string:fn, string:kind, string:code) never fails {
    string:s = string_concat(int_to_string(n), "\t");
    s = string_concat(s, fn);
    s = string_concat(s, "\t");
    s = string_concat(s, kind);
    s = string_concat(s, "\t");
    pass (string_concat(s, raw text_head(code, 80i64)));
};

// The transform. `floor` is `runtime/npkrt.ll`'s text.
pub func:explore_transform = Explored(string:floor) never fails {
    List<string>:lines = raw raw_lines(floor);
    SmtBuf:out = raw smtbuf_init();
    SmtBuf:sites = raw smtbuf_init();
    List<string>:problems = raw list_init::<string>(2i64);
    int64:points = 0i64;
    int64:routed = 0i64;
    int64:nsite = 0i64;
    bool:saw_entry = false;
    bool:saw_begin = false;
    bool:saw_end = false;
    bool:saw_clone = false;
    string:fn = "";
    int64:i = 0i64;
    while (i < lines.count) {
        string:line = raw strlist_view(lines, i);
        string:code = raw floor_code_part(line);
        string:sym = raw define_symbol(code);
        if (sym.len > 0i64) {
            fn = string_concat(sym, "");
            if (raw text_eq(fn, "@npk_thread_entry")) { saw_entry = true; }
            drop smtbuf_line(@out, line);
            i = i + 1i64;
            continue;
        }
        if ((fn.len == 0i64) || (raw text_starts_with(code, "module asm"))) {
            drop smtbuf_line(@out, line);
            i = i + 1i64;
            continue;
        }
        if (raw text_eq(code, "}")) {
            fn = "";
            drop smtbuf_line(@out, line);
            i = i + 1i64;
            continue;
        }
        // the lifecycle hooks of the thread's own entry
        if (raw text_eq(fn, "@npk_thread_entry")) {
            if (raw text_eq(code, "entry:")) {
                drop smtbuf_line(@out, line);
                drop smtbuf_line(@out, "  call void @npkx_begin()");
                saw_begin = true;
                i = i + 1i64;
                continue;
            }
            if (raw text_starts_with(code, "ret ")) {
                drop smtbuf_line(@out, "  call void @npkx_end()");
                drop smtbuf_line(@out, line);
                saw_end = true;
                i = i + 1i64;
                continue;
            }
        }
        // the trampoline's own body is the one thing the shim must not intercept
        if (raw text_eq(fn, "@npk_sys6")) {
            drop smtbuf_line(@out, line);
            i = i + 1i64;
            continue;
        }
        // the clone call: a statement that may continue on following lines
        if ((raw text_contains(code, "@npk_clone_raw(")) && (raw text_contains(code, "call "))) {
            string:reg = raw defined_register(code);
            if (reg.len == 0i64) {
                drop strlist_push(@problems, "explore: the `@npk_clone_raw` call defines no register the shim could be handed");
            }
            saw_clone = true;
            drop smtbuf_line(@out, "  call void @npkx_prespawn()");
            while (true) {
                string:part = raw strlist_view(lines, i);
                drop smtbuf_line(@out, part);
                if (raw text_ends_with(raw floor_code_part(part), ")")) { break; }
                i = i + 1i64;
                if (i >= lines.count) { break; }
            }
            string:sp = string_concat("  call void @npkx_spawned(i64 ", reg);
            drop smtbuf_line(@out, string_concat(sp, ")"));
            i = i + 1i64;
            continue;
        }
        if (raw line_is_sys6_call(code)) {
            drop smtbuf_line(@sites, raw site_row(nsite, fn, "sys6", code));
            nsite = nsite + 1i64;
            routed = routed + 1i64;
            drop smtbuf_line(@out, raw text_replace_first(line, "@npk_sys6(", "@npkx_sys6("));
            i = i + 1i64;
            continue;
        }
        if (raw line_is_atomic_step(code)) {
            drop smtbuf_line(@sites, raw site_row(nsite, fn, "atomic", code));
            string:pt = string_concat("  call void @npkx_point(i32 ", int_to_string(nsite));
            drop smtbuf_line(@out, string_concat(pt, ")"));
            nsite = nsite + 1i64;
            points = points + 1i64;
            drop smtbuf_line(@out, line);
            i = i + 1i64;
            continue;
        }
        drop smtbuf_line(@out, line);
        i = i + 1i64;
    }
    if (!saw_entry) { drop strlist_push(@problems, "explore: the floor defines no `@npk_thread_entry` -- the lifecycle hooks have no anchor"); }
    if (saw_entry && (!saw_begin)) { drop strlist_push(@problems, "explore: `@npk_thread_entry` has no `entry:` label -- `@npkx_begin` has no anchor"); }
    if (saw_entry && (!saw_end)) { drop strlist_push(@problems, "explore: `@npk_thread_entry` has no `ret` -- `@npkx_end` has no anchor"); }
    if (!saw_clone) { drop strlist_push(@problems, "explore: the floor calls no `@npk_clone_raw` -- the spawn hooks have no anchor"); }
    drop smtbuf_line(@out, "");
    drop smtbuf_line(@out, "; --- the explorer's shim (runtime/explore/npkx.ll; 1.5.7) ---");
    drop smtbuf_line(@out, "declare void @npkx_point(i32)");
    drop smtbuf_line(@out, "declare i64 @npkx_sys6(i64, i64, i64, i64, i64, i64, i64)");
    drop smtbuf_line(@out, "declare void @npkx_prespawn()");
    drop smtbuf_line(@out, "declare void @npkx_spawned(i64)");
    drop smtbuf_line(@out, "declare void @npkx_begin()");
    drop smtbuf_line(@out, "declare void @npkx_end()");
    pass Explored{ text: raw smtbuf_text(move(out)), sites: raw smtbuf_text(move(sites)),
                   points: points, routed: routed, problems: move(problems) };
};

// The first occurrence of `what` in `line` replaced by `repl`; the line itself when absent.
func:text_replace_first = string(string:line, string:what, string:repl) never fails {
    int64:at = raw text_index_of(line, what);
    if (at < 0i64) { pass (string_concat(line, "")); }
    string:s = string_concat(raw text_slice(line, 0i64, at), repl);
    pass (string_concat(s, raw text_slice(line, at + what.len, line.len)));
};

// THE CENSUS: the step lines of a floor text, inside its defines' bodies.
pub func:explore_census = int64(string:floor) never fails {
    List<string>:lines = raw raw_lines(floor);
    int64:n = 0i64;
    string:fn = "";
    for (int64:i in 0i64...lines.count) {
        string:code = raw floor_code_part(raw strlist_view(lines, i));
        string:sym = raw define_symbol(code);
        if (sym.len > 0i64) { fn = string_concat(sym, ""); continue; }
        if (fn.len == 0i64) { continue; }
        if (raw text_eq(code, "}")) { fn = ""; continue; }
        if (raw line_is_step(code)) { n = n + 1i64; }
    }
    pass n;
};

// THE TOTALITY BELT over a floor and its explored text: every step accounted
// for, by count and by position. The findings, by name; none when it holds.
pub func:explore_totality = List<string>(string:floor, string:explored) never fails {
    List<string>:fl = raw list_init::<string>(2i64);
    int64:census = raw explore_census(floor);
    List<string>:lines = raw raw_lines(explored);
    int64:points = 0i64;
    int64:routed = 0i64;
    int64:escapes = 0i64;
    string:fn = "";
    string:prev = "";
    for (int64:i in 0i64...lines.count) {
        string:code = raw floor_code_part(raw strlist_view(lines, i));
        string:sym = raw define_symbol(code);
        if (sym.len > 0i64) { fn = string_concat(sym, ""); prev = ""; continue; }
        if (fn.len == 0i64) { continue; }
        if (raw text_eq(code, "}")) { fn = ""; prev = ""; continue; }
        if (raw text_starts_with(code, "call void @npkx_point(i32 ")) {
            // the points are numbered by their sites: the k-th point's number is a site's
            points = points + 1i64;
            prev = string_concat(code, "");
            continue;
        }
        if ((raw text_contains(code, "@npkx_sys6(")) && (raw text_contains(code, "call "))) {
            routed = routed + 1i64;
            prev = string_concat(code, "");
            continue;
        }
        if (raw line_is_sys6_call(code)) {
            escapes = escapes + 1i64;
            string:w = string_concat("explore-step-escapes: a `@npk_sys6(` call the transform did not route, in ", fn);
            w = string_concat(w, ": ");
            drop strlist_push(@fl, string_concat(w, raw text_head(code, 100i64)));
        }
        if (raw line_is_atomic_step(code)) {
            if (!(raw text_starts_with(prev, "call void @npkx_point(i32 "))) {
                escapes = escapes + 1i64;
                string:w2 = string_concat("explore-step-escapes: an atomic step with no scheduling point before it, in ", fn);
                w2 = string_concat(w2, ": ");
                drop strlist_push(@fl, string_concat(w2, raw text_head(code, 100i64)));
            }
        }
        prev = string_concat(code, "");
    }
    if ((points + routed) != census) {
        string:m = string_concat("explore-step-escapes: the floor holds ", int_to_string(census));
        m = string_concat(m, " step line(s) and the explored floor ");
        m = string_concat(m, int_to_string(points));
        m = string_concat(m, " point(s) plus ");
        m = string_concat(m, int_to_string(routed));
        m = string_concat(m, " routed call(s) -- a step escaped the transform, or a point precedes no step");
        drop strlist_push(@fl, m);
    }
    pass fl;
};

// The belt over the tree: the real floor through the real transform.
pub func:explore_totality_current = List<string>(string:root) never fails {
    List<string>:fl = raw list_init::<string>(2i64);
    Result<cstring>:fc = to_cstring(string_concat(root, "/runtime/npkrt.ll"));
    if (fc.is_error) { drop strlist_push(@fl, "explore: runtime/npkrt.ll: not a path"); pass fl; }
    Result<string>:ftx = read_file(fc.value);
    if (ftx.is_error) { drop strlist_push(@fl, "explore: runtime/npkrt.ll cannot be read"); pass fl; }
    Explored:x = raw explore_transform(ftx.value);
    for (int64:i in 0i64...x.problems.count) { drop strlist_push(@fl, raw strlist_view(x.problems, i)); }
    if (fl.count > 0i64) { pass fl; }
    pass (raw explore_totality(ftx.value, x.text));
};

// --- the oracle's offsets (step 3; D-301) ---------------------------------------------
//
// The shim reads three words of the floor's structs -- `%npk.exec` field 2
// (the sleeper list's head), `%npk.hdr` fields 7 (`qnext`) and 8 (`wake_at`)
// -- by byte offsets it carries as named constants (`@npkx_off_sl_head`,
// `@npkx_off_qnext`, `@npkx_off_wake_at`); this holds them to the floor's own
// type lines (`explore-oracle-offsets`). The layout is x86_64's: `ptr` 8/8,
// `iN` its bytes at a power-of-two alignment capped at 8, an array its
// elements, a struct its fields at their alignments and padded to its own.

// (size, align) of an IR type, as a pair; a type the reader does not know is (-1, -1).
pub struct:TySize = { int64:size; int64:align; };

func:pow2_ceil = int64(int64:n) never fails {
    int64:p = 1i64;
    while (p < n) { p = p * 2i64; }
    pass p;
};

pub func:layout_size_align = TySize(string:ty0) never fails {
    string:ty = raw text_trim(ty0);
    if (raw text_eq(ty, "ptr")) { pass TySize{ size: 8i64, align: 8i64 }; }
    if (ty.len == 0i64) { pass TySize{ size: 0i64 - 1i64, align: 0i64 - 1i64 }; }
    if (ty.ptr[0i64] == 105u8) {                                    // 'i': iN
        Result<int64>:bits = text_int(raw text_slice(ty, 1i64, ty.len));
        if (bits.is_error) { pass TySize{ size: 0i64 - 1i64, align: 0i64 - 1i64 }; }
        if ((bits.value < 1i64) || (bits.value > 64i64)) { pass TySize{ size: 0i64 - 1i64, align: 0i64 - 1i64 }; }
        int64:bytes = (bits.value + 7i64) / 8i64;
        int64:al = raw pow2_ceil(bytes);
        if (al > 8i64) { al = 8i64; }
        pass TySize{ size: bytes, align: al };
    }
    if (ty.ptr[0i64] == 91u8) {                                     // '[': [N x T]
        int64:n = raw array_count(ty);
        TySize:e = raw layout_size_align(raw array_elem(ty));
        if ((n <= 0i64) || (e.size < 0i64)) { pass TySize{ size: 0i64 - 1i64, align: 0i64 - 1i64 }; }
        pass TySize{ size: n * e.size, align: e.align };
    }
    if (ty.ptr[0i64] == 123u8) {                                    // '{': a struct
        List<string>:fields = raw struct_fields(ty);
        int64:off = 0i64;
        int64:align = 1i64;
        for (int64:i in 0i64...fields.count) {
            TySize:f = raw layout_size_align(raw strlist_view(fields, i));
            if (f.size < 0i64) { pass TySize{ size: 0i64 - 1i64, align: 0i64 - 1i64 }; }
            off = ((off + f.align - 1i64) / f.align) * f.align + f.size;
            if (f.align > align) { align = f.align; }
        }
        pass TySize{ size: ((off + align - 1i64) / align) * align, align: align };
    }
    pass TySize{ size: 0i64 - 1i64, align: 0i64 - 1i64 };
};

// The byte offset of field `k` of a struct body `{ ... }`; -1 when the body cannot be read or has no such field.
pub func:layout_field_offset = int64(string:body, int64:k) never fails {
    List<string>:fields = raw struct_fields(raw text_trim(body));
    if ((k < 0i64) || (k >= fields.count)) { pass (0i64 - 1i64); }
    int64:off = 0i64;
    for (int64:i in 0i64...fields.count) {
        TySize:f = raw layout_size_align(raw strlist_view(fields, i));
        if (f.size < 0i64) { pass (0i64 - 1i64); }
        off = ((off + f.align - 1i64) / f.align) * f.align;
        if (i == k) { pass off; }
        off = off + f.size;
    }
    pass (0i64 - 1i64);
};

// `%name = type { ... }` in a floor text: the body, or "".
func:type_body_of = string(string:floor, string:name) never fails {
    List<string>:lines = raw raw_lines(floor);
    string:head = string_concat(name, " = type ");
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (raw text_starts_with(ln, head)) { pass (raw text_trim(raw text_slice(ln, head.len, ln.len))); }
    }
    pass "";
};

// `@npkx_off_<key> = internal constant i64 N` in the shim's text: N, or -1.
func:shim_offset_of = int64(string:shim, string:key) never fails {
    List<string>:lines = raw raw_lines(shim);
    string:head = string_concat("@npkx_off_", key);
    head = string_concat(head, " = internal constant i64 ");
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (raw text_starts_with(ln, head)) {
            Result<int64>:v = text_int(raw text_trim(raw text_slice(ln, head.len, ln.len)));
            if (v.is_error) { pass (0i64 - 1i64); }
            pass v.value;
        }
    }
    pass (0i64 - 1i64);
};

func:offset_finding = string(string:name, string:key, int64:have, int64:want) never fails {
    string:m = string_concat(name, "-oracle-offsets: the shim reads `");
    m = string_concat(m, key);
    m = string_concat(m, "` at byte ");
    m = string_concat(m, int_to_string(have));
    m = string_concat(m, " and the floor's type puts it at ");
    pass (string_concat(m, int_to_string(want)));
};

pub func:check_oracle_offsets = List<string>(string:floor, string:shim, string:name) never fails {
    List<string>:fl = raw list_init::<string>(3i64);
    int64:h_head = raw shim_offset_of(shim, "sl_head");
    int64:h_qnext = raw shim_offset_of(shim, "qnext");
    int64:h_wake = raw shim_offset_of(shim, "wake_at");
    if (h_head < 0i64) { drop strlist_push(@fl, string_concat(name, "-oracle-offsets: the shim carries no `@npkx_off_sl_head` constant")); }
    if (h_qnext < 0i64) { drop strlist_push(@fl, string_concat(name, "-oracle-offsets: the shim carries no `@npkx_off_qnext` constant")); }
    if (h_wake < 0i64) { drop strlist_push(@fl, string_concat(name, "-oracle-offsets: the shim carries no `@npkx_off_wake_at` constant")); }
    if (fl.count > 0i64) { pass fl; }
    string:ex = raw type_body_of(floor, "%npk.exec");
    string:hd = raw type_body_of(floor, "%npk.hdr");
    if (ex.len == 0i64) { drop strlist_push(@fl, string_concat(name, "-oracle-offsets: the floor defines no `%npk.exec` type")); pass fl; }
    if (hd.len == 0i64) { drop strlist_push(@fl, string_concat(name, "-oracle-offsets: the floor defines no `%npk.hdr` type")); pass fl; }
    int64:w_head = raw layout_field_offset(ex, 2i64);
    int64:w_qnext = raw layout_field_offset(hd, 7i64);
    int64:w_wake = raw layout_field_offset(hd, 8i64);
    if (h_head != w_head) { drop strlist_push(@fl, raw offset_finding(name, "sl_head", h_head, w_head)); }
    if (h_qnext != w_qnext) { drop strlist_push(@fl, raw offset_finding(name, "qnext", h_qnext, w_qnext)); }
    if (h_wake != w_wake) { drop strlist_push(@fl, raw offset_finding(name, "wake_at", h_wake, w_wake)); }
    pass fl;
};

// --- the controls (step 3; X-10) ---------------------------------------------------------
//
// `runtime/explore/controls/<name>.ctl`: `program:`, `verdict:`, `within:` and
// one or more `old:`/`new:` pairs of line blocks (each line indented by two
// spaces). Step 4 widened the grammar in two ways, both runners: a control may
// hold SEVERAL pairs -- each is applied in order and each `old` block must
// occur EXACTLY ONCE in the text as it stands when the pair is applied -- and
// the VERDICT may name the program's own answer instead of a word of the shim
// -- `wrong-exit` (any exit other than the program's `expect-exit:`, a signal
// included, or any shim verdict) or `exit N` (that exit exactly) -- or its
// LATENESS: `late N`, the virtual run time at or past N nanoseconds (the shim's
// `vrun=`; the class a lost wakeup degrades to under D-301, which no exit code
// and no stamp oracle can see). A DIRECTED control (X-15) adds up to four
// `preempt-at: @function <instruction text prefix>` lines, each naming one
// atomic site of the explored floor at which every arriving thread is demoted
// below every other -- a change point at a place, for a window one step wide
// that blind PCT cannot land on; the runners resolve each against the patched
// floor's sites.txt (exactly one `atomic` row, or the control is refused by
// name). Both runners build the patched floor, transform it, and REQUIRE the
// verdict within the seeds (`explore-control-blind` otherwise).

// `before`/`after` hold one string per pair: the pair's lines joined by "\n";
// `preempt` one `@function <prefix>` value per `preempt-at:` line.
pub struct:Control = { bool:ok; string:problem; string:program; string:verdict; int64:within; List<string>:before; List<string>:after; List<string>:preempt; };

func:control_bad = Control(string:problem) never fails {
    pass Control{ ok: false, problem: raw text_copy(problem), program: "", verdict: "", within: 0i64,
                  before: raw list_init::<string>(1i64), after: raw list_init::<string>(1i64), preempt: raw list_init::<string>(1i64) };
};

pub func:read_control = Control(string:text, string:name) never fails {
    Control:c = Control{ ok: true, problem: "", program: "", verdict: "", within: 0i64,
                         before: raw list_init::<string>(2i64), after: raw list_init::<string>(2i64), preempt: raw list_init::<string>(2i64) };
    List<string>:lines = raw raw_lines(text);
    int64:block = 0i64;                                             // 0 none, 1 old, 2 new
    bool:open = false;                                              // a pair is being read
    List<string>:cur_old = raw list_init::<string>(4i64);
    List<string>:cur_new = raw list_init::<string>(4i64);
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (raw text_starts_with(ln, ";")) { continue; }
        if (raw text_eq(ln, "old:")) {
            if (open) {
                drop list_push(@c.before, raw text_join(cur_old, "\n"));
                drop list_push(@c.after, raw text_join(cur_new, "\n"));
                cur_old = raw list_init::<string>(4i64);
                cur_new = raw list_init::<string>(4i64);
            }
            open = true;
            block = 1i64;
            continue;
        }
        if (raw text_eq(ln, "new:")) {
            if ((!open) || (cur_new.count > 0i64)) { pass (raw control_bad(string_concat(name, ": a `new:` with no `old:` before it"))); }
            block = 2i64;
            continue;
        }
        if ((block != 0i64) && ((ln.len == 0i64) || (raw text_starts_with(ln, "  ")))) {
            if (ln.len > 0i64) {
                if (block == 1i64) { drop strlist_push(@cur_old, ln); } else { drop strlist_push(@cur_new, ln); }
            }
            continue;
        }
        block = 0i64;
        if ((raw text_trim(ln)).len == 0i64) { continue; }
        int64:colon = raw text_find_byte(ln, 58u8, 0i64);
        if (colon < 0i64) { pass (raw control_bad(string_concat(string_concat(name, ": a line the control grammar does not know: "), raw text_head(ln, 80i64)))); }
        string:key = raw text_trim(raw text_slice(ln, 0i64, colon));
        string:val = raw text_trim(raw text_slice(ln, colon + 1i64, ln.len));
        if (raw text_eq(key, "within")) {
            Result<int64>:w = text_int(val);
            if (w.is_error) { pass (raw control_bad(string_concat(name, ": `within:` is not a number"))); }
            c.within = w.value;
            continue;
        }
        if (raw text_eq(key, "program")) { c.program = move(val); continue; }
        if (raw text_eq(key, "verdict")) { c.verdict = move(val); continue; }
        if (raw text_eq(key, "preempt-at")) {
            int64:sp = raw text_find_byte(val, 32u8, 0i64);
            bool:shaped = (val.len > 1i64) && (val.ptr[0i64] == 64u8) && (sp > 1i64) && ((raw text_trim(raw text_slice(val, sp + 1i64, val.len))).len > 0i64);
            if (!shaped) { pass (raw control_bad(string_concat(string_concat(name, ": `preempt-at:` is `@function <instruction text prefix>`: "), val))); }
            drop list_push(@c.preempt, move(val));
            continue;
        }
        pass (raw control_bad(string_concat(string_concat(name, ": a line the control grammar does not know: "), raw text_head(ln, 80i64))));
    }
    if (open) {
        drop list_push(@c.before, raw text_join(cur_old, "\n"));
        drop list_push(@c.after, raw text_join(cur_new, "\n"));
    }
    if (c.program.len == 0i64) { pass (raw control_bad(string_concat(name, ": no `program:`"))); }
    if (c.verdict.len == 0i64) { pass (raw control_bad(string_concat(name, ": no `verdict:`"))); }
    if (c.within < 1i64) { pass (raw control_bad(string_concat(name, ": `within:` must be at least 1"))); }
    if (c.before.count == 0i64) { pass (raw control_bad(string_concat(name, ": no `old:`/`new:` pair"))); }
    for (int64:p in 0i64...c.before.count) {
        if (((raw strlist_view(c.before, p)).len == 0i64) || ((raw strlist_view(c.after, p)).len == 0i64)) {
            string:m = string_concat(name, ": `old:` and `new:` must each hold at least one line (pair ");
            m = string_concat(m, int_to_string(p + 1i64));
            pass (raw control_bad(string_concat(m, ")")));
        }
    }
    if (c.preempt.count > 4i64) { pass (raw control_bad(string_concat(name, ": at most four `preempt-at:` sites (the shim holds four)"))); }
    if (raw text_starts_with(c.verdict, "exit ")) {
        Result<int64>:e = text_int(raw text_trim(raw text_slice(c.verdict, 5i64, c.verdict.len)));
        if (e.is_error) { pass (raw control_bad(string_concat(string_concat(name, ": `verdict: exit N` needs a number: "), c.verdict))); }
    }
    if (raw text_starts_with(c.verdict, "late ")) {
        Result<int64>:l = text_int(raw text_trim(raw text_slice(c.verdict, 5i64, c.verdict.len)));
        if (l.is_error) { pass (raw control_bad(string_concat(string_concat(name, ": `verdict: late N` needs a number: "), c.verdict))); }
    }
    pass c;
};

// The floor with each pair's `old` lines replaced by its `new` lines, in order,
// or "" with the finding: each exactly one occurrence in the text as it
// stands, else `explore-control-unmatched` naming the pair.
pub struct:Patched = { string:text; string:problem; };

pub func:apply_control = Patched(string:floor, Control->:c, string:name) never fails {
    string:text = string_concat(floor, "");
    for (int64:p in 0i64...c.before.count) {
        string:before = string_concat(raw strlist_view(c.before, p), "\n");
        string:after = string_concat(raw strlist_view(c.after, p), "\n");
        int64:n = 0i64;
        int64:at = raw text_index_of(text, before);
        int64:first = at;
        while (at >= 0i64) {
            n = n + 1i64;
            at = raw text_index_from(text, before, at + 1i64);
        }
        if (n != 1i64) {
            string:m = string_concat(name, ": explore-control-unmatched: the control's `old` lines (pair ");
            m = string_concat(m, int_to_string(p + 1i64));
            m = string_concat(m, ") occur ");
            m = string_concat(m, int_to_string(n));
            m = string_concat(m, " time(s) in runtime/npkrt.ll, not once");
            pass Patched{ text: "", problem: move(m) };
        }
        string:out = string_concat(raw text_slice(text, 0i64, first), after);
        string:next = string_concat(out, raw text_slice(text, first + before.len, text.len));
        text = move(next);
    }
    pass Patched{ text: move(text), problem: "" };
};

// Whether one run met the control's verdict: a shim word by equality;
// `wrong-exit` by any exit other than the program's own or any shim verdict;
// `exit N` by that exit exactly; `late N` by a virtual run time at or past N.
// `code` is the run's exit, a signal as its negative; `word` the shim's verdict
// word or ""; `vrun` the trace line's virtual run time.
pub func:control_verdict_met = bool(Control->:c, int64:expected_exit, int64:code, string:word, int64:vrun) never fails {
    if (raw text_eq(c.verdict, "wrong-exit")) { pass ((word.len > 0i64) || (code != expected_exit)); }
    if (raw text_starts_with(c.verdict, "exit ")) {
        Result<int64>:e = text_int(raw text_trim(raw text_slice(c.verdict, 5i64, c.verdict.len)));
        if (e.is_error) { pass false; }
        pass (code == e.value);
    }
    if (raw text_starts_with(c.verdict, "late ")) {
        Result<int64>:l = text_int(raw text_trim(raw text_slice(c.verdict, 5i64, c.verdict.len)));
        if (l.is_error) { pass false; }
        pass (vrun >= l.value);
    }
    pass (raw text_eq(word, c.verdict));
};

// THE DIRECTED SITES' NUMBERS (X-15): each `preempt-at:` against the patched
// floor's sites.txt -- exactly one row of that function whose text starts with
// the prefix, and an `atomic` one (a `sys6` site is a routed call, not a point
// the shim can hold). `numbers` holds one number per resolved site; a problem is
// a finding by name in `findings`.
pub struct:Sites = { List<int64>:numbers; List<string>:findings; };

pub func:resolve_sites = Sites(Control->:c, string:sites, string:name) never fails {
    Sites:out = Sites{ numbers: raw list_init::<int64>(4i64), findings: raw list_init::<string>(1i64) };
    List<string>:rows = raw raw_lines(sites);
    for (int64:p in 0i64...c.preempt.count) {
        string:want = raw strlist_view(c.preempt, p);
        int64:sp = raw text_find_byte(want, 32u8, 0i64);
        string:fn = raw text_slice(want, 0i64, sp);
        string:prefix = raw text_trim(raw text_slice(want, sp + 1i64, want.len));
        int64:hits = 0i64;
        int64:hit_n = 0i64;
        string:hit_kind = "";
        for (int64:r in 0i64...rows.count) {
            string:row = raw strlist_view(rows, r);
            if (row.len == 0i64) { continue; }
            // N<TAB>function<TAB>kind<TAB>text
            int64:t1 = raw text_find_byte(row, 9u8, 0i64);
            if (t1 < 0i64) { continue; }
            int64:t2 = raw text_find_byte(row, 9u8, t1 + 1i64);
            if (t2 < 0i64) { continue; }
            int64:t3 = raw text_find_byte(row, 9u8, t2 + 1i64);
            if (t3 < 0i64) { continue; }
            if (!(raw text_eq(raw text_slice(row, t1 + 1i64, t2), fn))) { continue; }
            if (!(raw text_starts_with(raw text_slice(row, t3 + 1i64, row.len), prefix))) { continue; }
            hits = hits + 1i64;
            Result<int64>:n = text_int(raw text_slice(row, 0i64, t1));
            if (!n.is_error) { hit_n = n.value; }
            hit_kind = raw text_slice(row, t2 + 1i64, t3);
        }
        if (hits != 1i64) {
            string:m = string_concat(name, ": explore-control-site-unmatched: `preempt-at: ");
            m = string_concat(m, want);
            m = string_concat(m, "` names ");
            m = string_concat(m, int_to_string(hits));
            m = string_concat(m, " site(s) of the explored floor, not one");
            drop list_push(@out.findings, move(m));
            continue;
        }
        if (!(raw text_eq(hit_kind, "atomic"))) {
            string:m2 = string_concat(name, ": explore-control-site-kind: `preempt-at: ");
            m2 = string_concat(m2, want);
            m2 = string_concat(m2, "` is a `");
            m2 = string_concat(m2, hit_kind);
            m2 = string_concat(m2, "` site; only an atomic step can be a directed site");
            drop list_push(@out.findings, move(m2));
            continue;
        }
        drop list_push(@out.numbers, hit_n);
    }
    pass out;
};
