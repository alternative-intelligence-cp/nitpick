// suites -- `npkg test`: discovery, the import grouping, every verdict, and
// the run (1.4.8; D-206 §5 "succession, not replacement": the structure is
// the Python harness's, unit for unit, so the parity stage can diff the two
// runners' verdicts run-for-run).
//
// WHAT RUNS IS THE MANIFEST'S TABLE, IN ITS ORDER (D-238, 1.4.8b): every
// `[[test]]` entry names a `stage` -- the tool that judges the suite and what
// it must say -- and this module has one function per stage: `compile` (each
// file compiled by the compiler under test and held to its kind), `parse`
// (the real parser over every source, each once), `resolve` and `check` (a
// rejection suite refused by the loader or by the frontend with EXACTLY the
// expected codes), `accept` (silence), `fixture` (built, never run),
// `program` (the real backend, -O0 and the `opt -O2` re-run) and `runtime`
// (the floor's own `.ll` tests). `--only` narrows the compile-stage entries
// and skips every other stage, saying so. The harness reads the same table,
// so the parity diff covers the full tree; the whole-tree instruments stay
// the Python harness's until the switch (`meta/SWITCH.md`).
//
// THE IMPORT GROUPING IS THE LEXER'S ANSWER (D-206 §3, the self-hosting
// dividend). Which files are fixtures another test imports -- and so are
// not run standalone -- is derived from `use` declarations, and the real
// lexer finds them: a `use "..."` inside a comment is not an import here,
// where the harness's regex would count it. The tree has none, so the two
// agree; where they ever differ, the lexer's answer is the language's.

mod:suites;

use "../src/frontend/list.npk".*;
use "../src/frontend/paths.npk".*;
use "../src/frontend/intern.npk".*;
use "../src/frontend/diagnostics.npk".*;
use "../src/frontend/token_kind.npk".*;
use "../src/frontend/token.npk".*;
use "../src/frontend/lexer.npk".*;
use "../lib/nfs.npk".*;
use "./text.npk".*;
use "./strset.npk".*;
use "./expect.npk".*;
use "./manifest.npk".*;
use "./toolchain.npk".*;
use "./build.npk".*;
use "./irscan.npk".*;

// --- discovery ---------------------------------------------------------------------

// `glob("<dir>/*<suffix>")`, sorted: the regular files (a symlink counts)
// with that suffix directly under `dir`, as absolute paths. A missing
// directory is an empty listing, as the glob's is.
pub func:list_suffix = List<string>(string:dir, string:suffix) {
    List<string>:out = raw list_init::<string>(16i64);
    Result<Path>:p = path_parse(dir);
    if (p.is_error) { pass out; }
    Result<Dir>:ld = dir_list(p.value);
    if (ld.is_error) { pass out; }
    Dir:d = ld.value;
    int64:n = raw dir_count(@d);
    for (int64:i in 0i64...n) {
        string:name = relay dir_name(@d, i);
        DirKind:k = relay dir_kind(@d, i);
        if (name.ptr[0i64] == 46u8) { continue; }
        if (!(raw text_ends_with(name, suffix))) { continue; }
        if ((k == DirKind.File) || (k == DirKind.Link)) {
            drop strlist_push(@out, raw path_join(dir, name));
        }
    }
    drop dir_free(@d);
    pass (raw strlist_sorted(out));
};

func:walk_into = NIL(string:dir, string:suffix, List<string>->:out) {
    Result<Path>:p = path_parse(dir);
    if (p.is_error) { pass NIL; }
    Result<Dir>:ld = dir_list(p.value);
    if (ld.is_error) { pass NIL; }
    Dir:d = ld.value;
    int64:n = raw dir_count(@d);
    for (int64:i in 0i64...n) {
        string:name = relay dir_name(@d, i);
        DirKind:k = relay dir_kind(@d, i);
        if (name.ptr[0i64] == 46u8) { continue; }
        string:full = raw path_join(dir, name);
        if (k == DirKind.Dir) {
            Result<NIL>:r = walk_into(full, suffix, out);
            if (r.is_error) { drop dir_free(@d); fail r.err; }
            continue;
        }
        if ((k == DirKind.File) || (k == DirKind.Link)) {
            if (raw text_ends_with(name, suffix)) { drop strlist_push(out, full); }
        }
    }
    drop dir_free(@d);
    pass NIL;
};

// `glob("<dir>/**/*<suffix>", recursive=True)`, sorted over the full paths.
pub func:walk_files = List<string>(string:dir, string:suffix) {
    List<string>:out = raw list_init::<string>(32i64);
    Result<NIL>:r = walk_into(dir, suffix, @out);
    if (r.is_error) { fail r.err; }
    pass (raw strlist_sorted(out));
};

// --- the import grouping -----------------------------------------------------------

// Every `use "<path>"` in a file, as the LEXER reads it: the keyword, then
// a string literal, its decoded text.
func:use_targets = List<string>(string:text) never fails {
    List<string>:out = raw list_init::<string>(4i64);
    InternTable:it = raw intern_init();
    DiagList:diags = raw diaglist_init();
    TokenList:toks = raw lex_all(0i32, text, @it, @diags);
    int64:n = raw tokenlist_count(@toks);
    int64:i = 0i64;
    while ((i + 1i64) < n) {
        Token:t = raw tokenlist_at(@toks, i);
        if (t.kind == TokenKind.KwUse) {
            Token:s = raw tokenlist_at(@toks, i + 1i64);
            if (s.kind == TokenKind.StringLit) {
                drop strlist_push(@out, raw intern_get(@it, s.payload =>! int32));
            }
        }
        i = i + 1i64;
    }
    pass out;
};

// Depth-first post-order over `use`, cycles broken: `order` ends with `p`
// itself, everything it transitively imports before it.
func:visit = NIL(string:p, StrSet->:seen, List<string>->:order) never fails {
    string:real = raw path_normalise(p);
    if (!(raw strset_add(seen, real))) { pass NIL; }
    Result<cstring>:cp = to_cstring(p);
    if (cp.is_error) { pass NIL; }
    Result<string>:rt = read_file(cp.value);
    if (rt.is_error) { pass NIL; }
    List<string>:targets = raw use_targets(rt.value);
    string:dir = raw path_dirname(p);
    for (int64:i in 0i64...targets.count) {
        string:cand = raw path_normalise(raw path_join(dir, raw strlist_view(targets, i)));
        Result<cstring>:cc = to_cstring(cand);
        if (cc.is_error) { continue; }
        if (path_exists(cc.value)) { drop visit(cand, seen, order); }
    }
    drop strlist_push(order, p);
    pass NIL;
};

// The files some other test imports, so they are not run standalone.
pub func:imported_by_others = StrSet(List<string>:paths) never fails {
    StrSet:used = raw strset_init(paths.count + 8i64);
    for (int64:i in 0i64...paths.count) {
        StrSet:seen = raw strset_init(16i64);
        List<string>:order = raw list_init::<string>(8i64);
        drop visit(raw strlist_view(paths, i), @seen, @order);
        for (int64:k in 0i64...(order.count - 1i64)) {
            discard(raw strset_add(@used, raw path_normalise(raw strlist_view(order, k))));
        }
        drop strset_free(@seen);
    }
    pass used;
};

// --- reading a test ----------------------------------------------------------------

pub func:read_text = string(string:path) {
    Result<cstring>:cp = to_cstring(path);
    if (cp.is_error) { fail cp.err; }
    pass (relay read_file(cp.value));
};

// A test whose expectations cannot be read is a failing test, by line.
func:unreadable = List<string>(string:name, Expect:exp) never fails {
    List<string>:f = raw list_init::<string>(1i64);
    string:m = string_concat(name, ": line ");
    m = string_concat(m, int_to_string(exp.bad_line));
    m = string_concat(m, ": an expectation marker whose number cannot be read");
    drop list_push(@f, move(m));
    pass f;
};

// --- diagnostics as the harness reads them -----------------------------------------

// `CODE path:line:col: message`, with `note ` / `warning ` in front for
// those severities: the code is token 0, the span token 1, the message is
// never asserted. A note goes to its own channel; a warning is a finding.
struct:Finding = { string:code; int64:line; int64:col; bool:is_note; };

func:findings_of = List<Finding>(string:stderr) never fails {
    List<Finding>:out = raw list_init::<Finding>(8i64);
    List<string>:lines = raw text_lines(stderr);
    for (int64:i in 0i64...lines.count) {
        List<string>:parts = raw text_split_ws(raw strlist_view(lines, i));
        int64:first = 0i64;
        bool:is_note = false;
        if (parts.count > 0i64) {
            string:p0 = raw strlist_view(parts, 0i64);
            if (raw text_eq(p0, "note")) { first = 1i64; is_note = true; }
            if (raw text_eq(p0, "warning")) { first = 1i64; }
        }
        if ((parts.count - first) < 2i64) { continue; }
        string:code = raw strlist_view(parts, first);
        string:span = raw strlist_view(parts, first + 1i64);
        if ((raw text_find_byte(span, 58u8, 0i64)) < 0i64) { continue; }
        // `span.rstrip(":")`, then the LAST two fields
        int64:stop_at = span.len;
        while (stop_at > 0i64) {
            if (span.ptr[stop_at - 1i64] != 58u8) { break; }
            stop_at = stop_at - 1i64;
        }
        string:sp = raw text_slice(span, 0i64, stop_at);
        int64:last = raw text_rfind_byte(sp, 58u8);
        string:ln = "";
        string:cl = "";
        if (last < 0i64) {
            ln = raw text_copy(sp);
        } else {
            int64:prev = 0i64 - 1i64;
            int64:k = last;
            while (k > 0i64) {
                k = k - 1i64;
                if (sp.ptr[k] == 58u8) { prev = k; break; }
            }
            if (prev < 0i64) {
                // one colon: `ln, _, cl = span.partition(":")`
                ln = raw text_slice(sp, 0i64, last);
                cl = raw text_slice(sp, last + 1i64, sp.len);
            } else {
                ln = raw text_slice(sp, prev + 1i64, last);
                cl = raw text_slice(sp, last + 1i64, sp.len);
            }
        }
        Result<int64>:li = text_int(ln);
        if (li.is_error) { continue; }
        Result<int64>:ci = text_int(cl);
        if (ci.is_error) { continue; }
        Finding:f = Finding{ code: raw text_copy(code), line: li.value, col: ci.value, is_note: is_note };
        drop list_push(@out, move(f));
    }
    pass out;
};

// `sorted(set(codes))` rendered as Python prints a list of strings.
func:codes_repr = string(List<Finding>:fs, bool:notes) never fails {
    List<string>:codes = raw list_init::<string>(4i64);
    for (int64:i in 0i64...fs.count) {
        if (fs.items[i].is_note != notes) { continue; }
        drop strlist_push(@codes, string_from_bytes(fs.items[i].code.ptr, fs.items[i].code.len));
    }
    List<string>:sorted = raw strlist_sorted_unique(codes);
    string:out = "[";
    for (int64:k in 0i64...sorted.count) {
        if (k > 0i64) { out = string_concat(out, ", "); }
        out = string_concat(out, "'");
        out = string_concat(out, raw strlist_view(sorted, k));
        out = string_concat(out, "'");
    }
    pass (string_concat(out, "]"));
};

// `[(g[1], g[2]) for g in hit]` rendered as Python prints it.
func:hits_repr = string(List<Finding>:fs, string:code, bool:notes) never fails {
    string:out = "[";
    bool:first = true;
    for (int64:i in 0i64...fs.count) {
        if (fs.items[i].is_note != notes) { continue; }
        if (!(raw text_eq(string_from_bytes(fs.items[i].code.ptr, fs.items[i].code.len), code))) { continue; }
        if (!first) { out = string_concat(out, ", "); }
        first = false;
        out = string_concat(out, "(");
        out = string_concat(out, int_to_string(fs.items[i].line));
        out = string_concat(out, ", ");
        out = string_concat(out, int_to_string(fs.items[i].col));
        out = string_concat(out, ")");
    }
    pass (string_concat(out, "]"));
};

// The matching loop, for the error channel (`notes` false) or the note
// channel: every expected code must be reported, and at its line and
// column when they are spelled.
func:match_channel = NIL(List<string>->:fl, string:name, List<Expected>:want,
                         List<Finding>:got, bool:notes) never fails {
    for (int64:i in 0i64...want.count) {
        string:code = string_from_bytes(want.items[i].code.ptr, want.items[i].code.len);
        int64:line = want.items[i].line;
        int64:col = want.items[i].col;
        bool:any_code = false;
        bool:at = false;
        for (int64:g in 0i64...got.count) {
            if (got.items[g].is_note != notes) { continue; }
            if (!(raw text_eq(string_from_bytes(got.items[g].code.ptr, got.items[g].code.len), code))) { continue; }
            any_code = true;
            if (got.items[g].line == line) {
                if ((col < 0i64) || (got.items[g].col == col)) { at = true; }
            }
        }
        if (!any_code) {
            string:m = string_concat(name, ": expected ");
            if (notes) { m = string_concat(m, "note "); }
            m = string_concat(m, code);
            m = string_concat(m, ", got ");
            m = string_concat(m, raw codes_repr(got, notes));
            drop list_push(fl, move(m));
            continue;
        }
        if (line >= 0i64) {
            if (!at) {
                string:m2 = string_concat(name, ": ");
                if (notes) { m2 = string_concat(m2, "note "); }
                m2 = string_concat(m2, code);
                m2 = string_concat(m2, " at ");
                m2 = string_concat(m2, raw hits_repr(got, code, notes));
                m2 = string_concat(m2, ", expected ");
                m2 = string_concat(m2, int_to_string(line));
                m2 = string_concat(m2, ":");
                if (col < 0i64) { m2 = string_concat(m2, "*"); }
                else { m2 = string_concat(m2, int_to_string(col)); }
                drop list_push(fl, move(m2));
            }
        }
    }
    pass NIL;
};

// EVERY REPORTED FINDING IS EXPECTED (D-237, 1.4.8b): the converse of
// `match_channel` -- on the error channel (findings, with `warning` counted as
// one) the SET of codes reported must EQUAL the set the expectations name, so
// a code no expectation names fails the test by name, as a missing one always
// has. Notes keep their own rule (an unexpected note is not a finding). One
// message per unexpected code, sorted, worded as the harness words it.
func:unexpected_codes = NIL(List<string>->:fl, string:name, List<Expected>:want,
                            List<Finding>:got) never fails {
    List<string>:codes = raw list_init::<string>(4i64);
    for (int64:g in 0i64...got.count) {
        if (got.items[g].is_note) { continue; }
        string:code = string_from_bytes(got.items[g].code.ptr, got.items[g].code.len);
        bool:named = false;
        for (int64:i in 0i64...want.count) {
            if (raw text_eq(string_from_bytes(want.items[i].code.ptr, want.items[i].code.len), code)) {
                named = true;
            }
        }
        if (!named) { drop strlist_push(@codes, code); }
    }
    List<string>:sorted = raw strlist_sorted_unique(codes);
    for (int64:k in 0i64...sorted.count) {
        string:m = string_concat(name, ": reported ");
        m = string_concat(m, raw strlist_view(sorted, k));
        m = string_concat(m, ", which no expectation names -- an unexpected diagnostic fails a test as surely as a missing one (BUILD_REFERENCE §7.1, D-237)");
        drop list_push(fl, move(m));
    }
    pass NIL;
};

// --- the verdicts ------------------------------------------------------------------

// A whole program that must be refused, with EXACTLY these codes -- by the
// loader, the type checker, an analysis, or the backend's rungs, whichever
// tool `binary` is (the harness's `check_module_rejection`, which every
// rejection suite shares). Every expected code reported at its place, every
// reported code expected (D-237).
pub async func:check_rejection = List<string>(Ctx->:c, string:binary, string:path, string:name,
                                              Expect:exp) {
    List<string>:fl = raw list_init::<string>(1i64);
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    Result<Run>:r = await compile_stdout(c, binary, path, raw duration_secs(20i64));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        drop strlist_push(@fl, string_concat(name, ": the frontend did not terminate"));
        pass fl;
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 3i64) {
        drop strlist_push(@fl, string_concat(name, ": the frontend TRAPPED -- a defect in the compiler, not in this file"));
        pass fl;
    }
    if (rc == 0i64) {
        string:m = string_concat(name, ": expected ");
        m = string_concat(m, raw expect_codes(exp.errors));
        m = string_concat(m, ", but it resolved cleanly");
        drop list_push(@fl, move(m));
        pass fl;
    }
    List<Finding>:got = raw findings_of(run.x.err);
    drop match_channel(@fl, name, exp.errors, got, false);
    drop match_channel(@fl, name, exp.notes, got, true);
    drop unexpected_codes(@fl, name, exp.errors, got);
    pass fl;
};

// A whole program the frontend must accept with NO diagnostics at all.
pub async func:check_accept = List<string>(Ctx->:c, string:binary, string:path, string:name) {
    List<string>:fl = raw list_init::<string>(1i64);
    Result<Run>:r = await compile_stdout(c, binary, path, raw duration_secs(20i64));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        drop strlist_push(@fl, string_concat(name, ": the frontend did not terminate"));
        pass fl;
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 3i64) {
        drop strlist_push(@fl, string_concat(name, ": the frontend TRAPPED -- a defect in the compiler, not in this file"));
        pass fl;
    }
    if (rc == 0i64) { pass fl; }
    // `sorted(set(line.split()[0] ...))`, or the exit code when there were none
    List<string>:firsts = raw list_init::<string>(4i64);
    List<string>:lines = raw text_lines(run.x.err);
    for (int64:i in 0i64...lines.count) {
        List<string>:parts = raw text_split_ws(raw strlist_view(lines, i));
        if (parts.count > 0i64) { drop strlist_push(@firsts, raw strlist_view(parts, 0i64)); }
    }
    string:m = string_concat(name, ": expected no diagnostics, got ");
    if (firsts.count == 0i64) {
        m = string_concat(m, int_to_string(rc));
    } else {
        List<string>:sorted = raw strlist_sorted_unique(firsts);
        m = string_concat(m, "[");
        for (int64:k in 0i64...sorted.count) {
            if (k > 0i64) { m = string_concat(m, ", "); }
            m = string_concat(m, "'");
            m = string_concat(m, raw strlist_view(sorted, k));
            m = string_concat(m, "'");
        }
        m = string_concat(m, "]");
    }
    drop list_push(@fl, move(m));
    pass fl;
};

// The real parser must accept this file with no diagnostics at all.
pub async func:check_parses = List<string>(Ctx->:c, string:binary, string:path, string:name) {
    List<string>:fl = raw list_init::<string>(1i64);
    Result<Run>:r = await compile_stdout(c, binary, path, raw duration_secs(20i64));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        drop strlist_push(@fl, string_concat(name, ": the real parser did not terminate"));
        pass fl;
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 2i64) {
        string:m0 = string_concat(name, ": parse_check could not read the file: ");
        m0 = string_concat(m0, raw text_trim(run.x.err));
        drop list_push(@fl, move(m0));
        pass fl;
    }
    if (rc == 3i64) {
        drop strlist_push(@fl, string_concat(name, ": the real parser TRAPPED -- a defect in the compiler, not in this file"));
        pass fl;
    }
    if (rc != 0i64) {
        string:m = string_concat(name, ": the REAL parser rejected it (");
        m = string_concat(m, raw text_replace_all(raw text_trim(run.x.err), "\n", ", "));
        m = string_concat(m, ") -- every file here must parse and be refused later, which is what D-085 says");
        drop list_push(@fl, move(m));
        pass fl;
    }
    pass fl;
};

// Compiles, links, runs, exits as expected -- with the compiler under test.
pub async func:check_positive = List<string>(Ctx->:c, string:name, string:entry, Expect:exp) {
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                raw text_replace_byte(name, 47u8, 95u8));
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len),
                                                   entry, name, base);
    if (fl.count > 0i64) { pass fl; }
    List<string>:noargs = raw list_init::<string>(1i64);
    pass (relay await run_binary(c, name, base, noargs, exp.stress, exp.exit_code, "", false));
};

// A correct program the BACKEND must refuse (D-085): parses, resolves,
// types, analyses -- and is refused by emission, naming the rung.
pub async func:check_negative = List<string>(Ctx->:c, string:name, string:entry, Expect:exp) {
    List<string>:fl = raw list_init::<string>(1i64);
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    if (exp.errors.count == 0i64) {
        drop strlist_push(@fl, string_concat(name, ": negative test declares no `// expect-error:` -- a test that only asserts 'it failed somehow' stops noticing when it starts failing for a different reason"));
        pass fl;
    }
    pass (relay await check_rejection(c, string_from_bytes(c.npkc.ptr, c.npkc.len), entry, name, exp));
};

// Compiles, but must emit exactly the expected warnings. Nothing emits
// warnings yet and no target uses the kind; defined so the shape is fixed.
pub async func:check_diagnostic = List<string>(Ctx->:c, string:name, string:entry, Expect:exp) {
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                raw text_replace_byte(name, 47u8, 95u8));
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len),
                                                   entry, name, base);
    if (fl.count > 0i64) { pass fl; }
    if (exp.errors.count > 0i64) {
        string:m = string_concat(name, ": expected warnings ");
        m = string_concat(m, raw expect_codes(exp.errors));
        m = string_concat(m, ", none emitted");
        drop list_push(@fl, move(m));
    }
    pass fl;
};

// A program COMPILED BY THIS COMPILER'S BACKEND, run, its exit compared --
// then the same through `opt -O2`. `// argv:` tokens naming a fixture are
// substituted with the built fixture's path; anything else passes verbatim.
pub async func:check_program = List<string>(Ctx->:c, string:path, string:name, Expect:exp,
                                            List<string>:fix_keys, List<string>:fix_paths) {
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                string_concat("prog_", raw text_replace_byte(raw text_file_name(path), 46u8, 95u8)));
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len),
                                                   path, name, base);
    if (fl.count > 0i64) { pass fl; }
    List<string>:args = raw list_init::<string>(2i64);
    for (int64:i in 0i64...exp.argv.count) {
        string:tok = raw strlist_view(exp.argv, i);
        string:sub = raw text_copy(tok);
        for (int64:k in 0i64...fix_keys.count) {
            if (raw text_eq(raw strlist_view(fix_keys, k), tok)) { sub = raw strlist_copy(fix_paths, k); }
        }
        drop strlist_push(@args, sub);
    }
    List<string>:r0 = relay await run_binary(c, name, base, args, exp.stress, exp.exit_code,
                                             " (compiled by the REAL backend)", false);
    if (r0.count > 0i64) { pass r0; }
    pass (relay await check_optimised(c, name, base, args, exp.stress, exp.exit_code));
};

// --- the run -----------------------------------------------------------------------

func:matches_only = bool(string:rel, List<string>:only) never fails {
    for (int64:i in 0i64...only.count) {
        if (raw text_contains(rel, raw strlist_view(only, i))) { pass true; }
    }
    pass false;
};

// Every file with `suffix` under the entry's paths, EACH ONCE, in manifest
// path order and sorted within a path -- `list_suffix` per path, or the
// recursive walk when the entry says so. (The hardcoded sweeps concatenated
// their lists and parsed six files twice; a table sweeps a file once.)
func:files_of = List<string>(Ctx->:c, List<string>:paths, bool:recursive, string:suffix) {
    List<string>:out = raw list_init::<string>(32i64);
    StrSet:seen = raw strset_init(64i64);
    for (int64:i in 0i64...paths.count) {
        string:dir = raw in_root(c, raw strlist_view(paths, i));
        List<string>:found = raw list_init::<string>(1i64);
        if (recursive) { found = relay walk_files(dir, suffix); }
        else { found = relay list_suffix(dir, suffix); }
        for (int64:k in 0i64...found.count) {
            string:p = raw strlist_view(found, k);
            if (raw strset_add(@seen, raw path_normalise(p))) { drop strlist_push(@out, p); }
        }
    }
    drop strset_free(@seen);
    pass out;
};

// The tool a stage judges with -- `tools/<which>.npk` built by the builder --
// once, on first use, and kept in the Ctx ("" not yet asked, "!" it did not
// build, else its path). A tool that did not build is one recorded failure,
// and every stage that needs it skips. Returns "" when there is no tool.
async func:tool_for = string(Ctx->:c, string:which) {
    string:have = "";
    if (raw text_eq(which, "parse_check"))   { have = string_from_bytes(c.parse_check.ptr, c.parse_check.len); }
    if (raw text_eq(which, "resolve_check")) { have = string_from_bytes(c.resolve_check.ptr, c.resolve_check.len); }
    if (raw text_eq(which, "check"))         { have = string_from_bytes(c.check.ptr, c.check.len); }
    if (have.len > 0i64) {
        if (raw text_eq(have, "!")) { pass ""; }
        pass (raw text_copy(have));
    }
    string:src = raw in_root(c, string_concat(string_concat("tools/", which), ".npk"));
    Result<Step>:st = await build_tool(c, src, which);
    if (st.is_error) { fail st.err; }
    Step:s = move(st.value);
    string:got = "!";
    if (s.ok) {
        got = raw text_copy(s.text);
    } else {
        string:m = string_concat(string_concat("tools/", which), ".npk did not build: ");
        drop note_failure(c, string_concat(m, s.text));
    }
    if (raw text_eq(which, "parse_check"))   { c.parse_check = raw text_copy(got); }
    if (raw text_eq(which, "resolve_check")) { c.resolve_check = raw text_copy(got); }
    if (raw text_eq(which, "check"))         { c.check = raw text_copy(got); }
    if (raw text_eq(got, "!")) { pass ""; }
    pass got;
};

// The entry's label, a view.
func:entry_name = string(Ctx->:c, int64:t) never fails {
    pass (string_from_bytes(c.m.tests.items[t].name.ptr, c.m.tests.items[t].name.len));
};

// --- the stages (D-238): one function per stage, the entry decides the files ----------

// `compile`: the compiler under test over every standalone file, held to the
// entry's kind. A file some other file in the suite imports is a fixture and
// is not run. `--only` narrows here and nowhere else; the counts are these.
async func:run_compile = NIL(Ctx->:c, int64:t, List<string>:only) {
    string:tname = raw entry_name(c, t);
    string:kind = string_from_bytes(c.m.tests.items[t].kind.ptr, c.m.tests.items[t].kind.len);
    bool:filtering = (only.count > 0i64);
    List<string>:paths = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    StrSet:skip = raw imported_by_others(paths);
    List<string>:run_paths = raw list_init::<string>(paths.count + 1i64);
    for (int64:i in 0i64...paths.count) {
        string:p = raw strlist_view(paths, i);
        if (raw strset_has(skip, p)) { continue; }
        drop strlist_push(@run_paths, p);
    }
    drop strset_free(@skip);
    c.available = c.available + run_paths.count;
    List<string>:chosen = raw list_init::<string>(run_paths.count + 1i64);
    for (int64:j in 0i64...run_paths.count) {
        string:p2 = raw strlist_view(run_paths, j);
        if (filtering) {
            if (!(raw matches_only(raw rel_to_root(c, p2), only))) { continue; }
        }
        drop strlist_push(@chosen, p2);
    }
    if (filtering && (chosen.count == 0i64)) { pass NIL; }
    for (int64:k in 0i64...chosen.count) {
        string:p3 = raw strlist_view(chosen, k);
        c.total = c.total + 1i64;
        string:name = raw rel_to_root(c, p3);
        string:text = relay read_text(p3);
        Expect:exp = raw expect_read(text);
        List<string>:fl = raw list_init::<string>(1i64);
        if (raw text_eq(kind, "positive"))   { fl = relay await check_positive(c, name, p3, exp); }
        if (raw text_eq(kind, "negative"))   { fl = relay await check_negative(c, name, p3, exp); }
        if (raw text_eq(kind, "diagnostic")) { fl = relay await check_diagnostic(c, name, p3, exp); }
        drop record(c, tname, name, fl);
    }
    drop say(raw stage_line(tname, chosen.count, string_concat(kind, " test(s)")));
    pass NIL;
};

// `parse`: the real parser over every source under the entry's paths, each
// once, accepted with no diagnostic. A rejection test the real parser cannot
// read is testing the wrong stage (D-085); the compiler's own tree is the
// file set that matters most -- stage 1 must parse it to build stage 2.
async func:run_parse = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:pc = relay await tool_for(c, "parse_check");
    if (pc.len == 0i64) { pass NIL; }
    List<string>:files = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:q in 0i64...files.count) {
        string:p = raw strlist_view(files, q);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await check_parses(c, pc, p, name);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "real-parser check(s)"));
    pass NIL;
};

// `resolve` / `check`: whole programs refused with EXACTLY the expected codes
// by the tool the stage names -- the loader (`resolve_check`) or the frontend
// (`check`: the type checker, an analysis, expansion, derive, whichever the
// suite's directory says). A file with no `expect-error:` is a fixture another
// one imports, not a test.
async func:run_rejection = NIL(Ctx->:c, int64:t, string:which) {
    string:tname = raw entry_name(c, t);
    string:tool = relay await tool_for(c, which);
    if (tool.len == 0i64) { pass NIL; }
    List<string>:files = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:i in 0i64...files.count) {
        string:p = raw strlist_view(files, i);
        string:text = relay read_text(p);
        Expect:exp = raw expect_read(text);
        if (exp.errors.count == 0i64) { continue; }
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await check_rejection(c, tool, p, name, exp);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    string:by = "the frontend";
    if (raw text_eq(which, "resolve_check")) { by = "the loader"; }
    drop say(raw stage_line(tname, count, string_concat("rejection test(s), refused by ", by)));
    pass NIL;
};

// `accept`: whole programs the frontend must ACCEPT, in full silence -- the
// counterweight to the rejection suites. One suite, not one per stage:
// silence has no stage.
async func:run_accept_stage = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:check = relay await tool_for(c, "check");
    if (check.len == 0i64) { pass NIL; }
    List<string>:files = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:i in 0i64...files.count) {
        string:p = raw strlist_view(files, i);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await check_accept(c, check, p, name);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "acceptance test(s)"));
    pass NIL;
};

// `fixture`: helper binaries a test spawns, built like programs and never run;
// a program names one in `// argv:` by its uppercased stem, and the map this
// fills is read by the `program` stage (so this entry comes first). A `.c` is
// a reference DRIVER (1.1.13c): TEST TOOLING, never in the artifact, built
// with the system C compiler exactly as the harness builds them.
async func:run_fixture = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:fixdir = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len), "fixtures");
    List<string>:fixtures = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    List<string>:cfixtures = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".c");
    if ((fixtures.count > 0i64) || (cfixtures.count > 0i64)) {
        Result<NIL>:d = ensure_dir(fixdir);
        if (d.is_error) { fail d.err; }
    }
    for (int64:i in 0i64...fixtures.count) {
        string:p = raw strlist_view(fixtures, i);
        string:fname = raw text_file_name(p);
        string:stem = raw text_slice(fname, 0i64, fname.len - 4i64);
        string:fbase = raw path_join(fixdir, stem);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len), p, name, fbase);
        drop record(c, tname, name, fl);
        if (fl.count > 0i64) { continue; }
        drop strlist_push(@c.fix_keys, raw text_upper(stem));
        drop strlist_push(@c.fix_paths, fbase);
    }
    for (int64:j in 0i64...cfixtures.count) {
        string:cp = raw strlist_view(cfixtures, j);
        string:cname = raw text_file_name(cp);
        string:cstem = raw text_slice(cname, 0i64, cname.len - 2i64);
        string:cbase = raw path_join(fixdir, cstem);
        string:crel = raw rel_to_root(c, cp);
        List<string>:cfails = raw list_init::<string>(1i64);
        if (c.t.cc.len == 0i64) {
            drop strlist_push(@cfails, string_concat(crel, ": cc failed: no C compiler on PATH"));
        } else {
            List<string>:args = raw list_init::<string>(5i64);
            drop strlist_push(@args, "-O1");
            drop strlist_push(@args, "-Wall");
            drop strlist_push(@args, "-o");
            drop strlist_push(@args, cbase);
            drop strlist_push(@args, cp);
            Result<Step>:s = await tool_step(c, string_from_bytes(c.t.cc.ptr, c.t.cc.len), args, raw duration_secs(600i64));
            if (s.is_error) { fail s.err; }
            Step:st = move(s.value);
            if (!st.ok) {
                string:m = string_concat(crel, ": cc failed: ");
                m = string_concat(m, raw text_head(raw text_trim(st.text), 160i64));
                drop list_push(@cfails, move(m));
            }
        }
        drop record(c, tname, crel, cfails);
        if (cfails.count > 0i64) { continue; }
        drop strlist_push(@c.fix_keys, raw text_upper(cstem));
        drop strlist_push(@c.fix_paths, cbase);
    }
    drop say(raw stage_line(tname, fixtures.count + cfixtures.count, "fixture(s) built, never run"));
    pass NIL;
};

// `program`: the real backend over every standalone program under the entry's
// paths -- the -O0 run and the -O2 re-run -- with `// argv:` fixture names
// substituted from the map the `fixture` stage filled. A file another one in
// the suite imports is a fixture, not a program.
async func:run_program = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    List<string>:paths = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    StrSet:skip = raw imported_by_others(paths);
    int64:count = 0i64;
    for (int64:k in 0i64...paths.count) {
        string:p2 = raw strlist_view(paths, k);
        if (raw strset_has(skip, p2)) { continue; }
        string:text = relay read_text(p2);
        Expect:exp = raw expect_read(text);
        string:name = raw rel_to_root(c, p2);
        List<string>:fl = relay await check_program(c, p2, name, exp, c.fix_keys, c.fix_paths);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop strset_free(@skip);
    drop say(raw stage_line(tname, count, "real-backend program(s)"));
    drop say(raw stage_text("opt-O2", "every program re-run through opt -O2 + llc -O2, same exit required"));
    pass NIL;
};

// `runtime`: the floor's own `.ll` tests, assembled, linked against the
// floor, run; `expect-exit:` read from the first 400 bytes.
async func:run_runtime_stage = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    List<string>:tests = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".ll");
    int64:count = 0i64;
    for (int64:i in 0i64...tests.count) {
        string:rp = raw strlist_view(tests, i);
        string:name = raw rel_to_root(c, rp);
        string:text = relay read_text(rp);
        // A hand-written floor test is held to the undef ban too (D-218.10).
        List<string>:fnu = raw ir_no_undef(text, name);
        if (fnu.count > 0i64) { drop record(c, tname, name, fnu); continue; }
        string:head = raw text_head(text, 400i64);
        int64:want = 0i64;
        int64:at = raw text_index_of(head, "expect-exit:");
        if (at >= 0i64) {
            int64:q = at + 12i64;
            while (q < head.len) {
                if (!(raw text_is_ws(head.ptr[q]))) { break; }
                q = q + 1i64;
            }
            int64:e = q;
            while (e < head.len) {
                if (!(raw text_is_digit(head.ptr[e]))) { break; }
                e = e + 1i64;
            }
            if (e > q) {
                Result<int64>:v = text_int(raw text_slice(head, q, e));
                if (!v.is_error) { want = v.value; }
            }
        }
        string:fname = raw text_file_name(rp);
        string:rbase = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                     string_concat("rt_", raw text_slice(fname, 0i64, fname.len - 3i64)));
        string:robj = string_concat(rbase, ".o");
        List<string>:fl = raw list_init::<string>(1i64);
        Result<Step>:s1 = await llc_obj(c, c.m.llc_flags, rp, robj);
        if (s1.is_error) { fail s1.err; }
        Step:st1 = move(s1.value);
        if (!st1.ok) {
            string:m1 = string_concat(name, ": llc failed: ");
            m1 = string_concat(m1, raw text_head(raw text_trim(st1.text), 120i64));
            drop list_push(@fl, move(m1));
            drop record(c, tname, name, fl);
            continue;
        }
        Result<Step>:s2 = await lld_link(c, rbase, robj);
        if (s2.is_error) { fail s2.err; }
        Step:st2 = move(s2.value);
        if (!st2.ok) {
            string:m2 = string_concat(name, ": link failed: ");
            m2 = string_concat(m2, raw text_head(raw text_trim(st2.text), 120i64));
            drop list_push(@fl, move(m2));
            drop record(c, tname, name, fl);
            continue;
        }
        List<string>:noargs = raw list_init::<string>(1i64);
        Result<Run>:r = await run_argv(rbase, noargs, c.t.env, raw duration_secs(60i64));
        if (r.is_error) { fail r.err; }
        Run:run = move(r.value);
        int64:got = run.x.status;
        if (!run.x.exited) { got = 0i64 - run.x.signal; }
        if (run.timed_out) {
            drop strlist_push(@fl, string_concat(name, ": timed out"));
        } else {
            if (got != want) {
                string:m3 = string_concat(name, ": exited ");
                m3 = string_concat(m3, int_to_string(got));
                m3 = string_concat(m3, ", expected ");
                m3 = string_concat(m3, int_to_string(want));
                drop list_push(@fl, move(m3));
            }
        }
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "runtime-floor test(s)"));
    pass NIL;
};

// EVERY SUITE, IN MANIFEST ORDER (D-238). A filtered run touches the
// compile-stage entries only: the other stages ask questions about the
// sources as a set -- does every file parse, is every rejection exact --
// which a subset cannot answer. `manifest_load` refused any stage not named
// below before anything ran.
pub async func:run_targets = NIL(Ctx->:c, List<string>:only) {
    bool:filtering = (only.count > 0i64);
    for (int64:t in 0i64...c.m.tests.count) {
        string:stage = string_from_bytes(c.m.tests.items[t].stage.ptr, c.m.tests.items[t].stage.len);
        if (raw text_eq(stage, "compile")) {
            Result<NIL>:r0 = await run_compile(c, t, only);
            if (r0.is_error) { fail r0.err; }
            continue;
        }
        if (filtering) { continue; }
        if (raw text_eq(stage, "parse")) {
            Result<NIL>:r1 = await run_parse(c, t);
            if (r1.is_error) { fail r1.err; }
            continue;
        }
        if (raw text_eq(stage, "resolve")) {
            Result<NIL>:r2 = await run_rejection(c, t, "resolve_check");
            if (r2.is_error) { fail r2.err; }
            continue;
        }
        if (raw text_eq(stage, "check")) {
            Result<NIL>:r3 = await run_rejection(c, t, "check");
            if (r3.is_error) { fail r3.err; }
            continue;
        }
        if (raw text_eq(stage, "accept")) {
            Result<NIL>:r4 = await run_accept_stage(c, t);
            if (r4.is_error) { fail r4.err; }
            continue;
        }
        if (raw text_eq(stage, "fixture")) {
            Result<NIL>:r5 = await run_fixture(c, t);
            if (r5.is_error) { fail r5.err; }
            continue;
        }
        if (raw text_eq(stage, "program")) {
            Result<NIL>:r6 = await run_program(c, t);
            if (r6.is_error) { fail r6.err; }
            continue;
        }
        if (raw text_eq(stage, "runtime")) {
            Result<NIL>:r7 = await run_runtime_stage(c, t);
            if (r7.is_error) { fail r7.err; }
            continue;
        }
    }
    pass NIL;
};
