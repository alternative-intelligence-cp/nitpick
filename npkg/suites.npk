// suites -- `npkg test`: discovery, the import grouping, every verdict, and
// the run (1.4.8; D-206 §5 "succession, not replacement": the structure is
// the Python harness's, unit for unit, so the parity stage can diff the two
// runners' verdicts run-for-run).
//
// WHAT RUNS IS THE MANIFEST'S TABLE, IN ITS ORDER (D-238, 1.4.8b): every
// `[[test]]` entry names a `stage` -- the tool that judges the suite and what
// it must say -- and this module has one function per stage: `compile` (each
// file compiled by the compiler under test and held to its kind), `parse`
// (the real parser over every source, each once), `resolve` and `check` (a
// rejection suite refused by the loader or by the frontend with EXACTLY the
// expected codes), `accept` (silence), `fixture` (built, never run),
// `program` (the real backend, -O0 and the `opt -O2` re-run) and `runtime`
// (the floor's own `.ll` tests). `--only` narrows the compile-stage entries
// and skips every other stage, saying so. The harness reads the same table,
// so the parity diff covers the full tree; the whole-tree instruments stay
// the Python harness's until the switch (`meta/SWITCH.md`).
//
// THE IMPORT GROUPING IS THE LEXER'S ANSWER (D-206 §3, the self-hosting
// dividend). Which files are fixtures another test imports -- and so are
// not run standalone -- is derived from `use` declarations, and the real
// lexer finds them: a `use "..."` inside a comment is not an import here,
// where the harness's regex would count it. The tree has none, so the two
// agree; where they ever differ, the lexer's answer is the language's.

mod:suites;

use "../src/frontend/list.npk".*;
use "../src/frontend/paths.npk".*;
use "../src/frontend/intern.npk".*;
use "../src/frontend/diagnostics.npk".*;
use "../src/frontend/token_kind.npk".*;
use "../src/frontend/token.npk".*;
use "../src/frontend/lexer.npk".*;
use "../lib/nfs.npk".*;
use "../lib/nproc.npk".*;
use "./text.npk".*;
use "./strset.npk".*;
use "./expect.npk".*;
use "./manifest.npk".*;
use "./toml.npk".*;
use "./toolchain.npk".*;
use "./build.npk".*;
use "./irscan.npk".*;
use "./verify.npk".*;
use "../src/backend/smt/smt_kinds.npk".*;

// --- discovery ---------------------------------------------------------------------

// `glob("<dir>/*<suffix>")`, sorted: the regular files (a symlink counts)
// with that suffix directly under `dir`, as absolute paths. A missing
// directory is an empty listing, as the glob's is.
pub func:list_suffix = List<string>(string:dir, string:suffix) {
    List<string>:out = raw list_init::<string>(16i64);
    Result<Path>:p = path_parse(dir);
    if (p.is_error) { pass out; }
    Result<Dir>:ld = dir_list(p.value);
    if (ld.is_error) { pass out; }
    Dir:d = ld.value;
    int64:n = raw dir_count(@d);
    for (int64:i in 0i64...n) {
        string:name = relay dir_name(@d, i);
        DirKind:k = relay dir_kind(@d, i);
        if (name.ptr[0i64] == 46u8) { continue; }
        if (!(raw text_ends_with(name, suffix))) { continue; }
        if ((k == DirKind.File) || (k == DirKind.Link)) {
            drop strlist_push(@out, raw path_join(dir, name));
        }
    }
    drop dir_free(@d);
    pass (raw strlist_sorted(out));
};

func:walk_into = NIL(string:dir, string:suffix, List<string>->:out) {
    Result<Path>:p = path_parse(dir);
    if (p.is_error) { pass NIL; }
    Result<Dir>:ld = dir_list(p.value);
    if (ld.is_error) { pass NIL; }
    Dir:d = ld.value;
    int64:n = raw dir_count(@d);
    for (int64:i in 0i64...n) {
        string:name = relay dir_name(@d, i);
        DirKind:k = relay dir_kind(@d, i);
        if (name.ptr[0i64] == 46u8) { continue; }
        string:full = raw path_join(dir, name);
        if (k == DirKind.Dir) {
            Result<NIL>:r = walk_into(full, suffix, out);
            if (r.is_error) { drop dir_free(@d); fail r.err; }
            continue;
        }
        if ((k == DirKind.File) || (k == DirKind.Link)) {
            if (raw text_ends_with(name, suffix)) { drop strlist_push(out, full); }
        }
    }
    drop dir_free(@d);
    pass NIL;
};

// `glob("<dir>/**/*<suffix>", recursive=True)`, sorted over the full paths.
pub func:walk_files = List<string>(string:dir, string:suffix) {
    List<string>:out = raw list_init::<string>(32i64);
    Result<NIL>:r = walk_into(dir, suffix, @out);
    if (r.is_error) { fail r.err; }
    pass (raw strlist_sorted(out));
};

// --- the import grouping -----------------------------------------------------------

// Every `use "<path>"` in a file, as the LEXER reads it: the keyword, then
// a string literal, its decoded text.
func:use_targets = List<string>(string:text) never fails {
    List<string>:out = raw list_init::<string>(4i64);
    InternTable:it = raw intern_init();
    DiagList:diags = raw diaglist_init();
    TokenList:toks = raw lex_all(0i32, text, @it, @diags);
    int64:n = raw tokenlist_count(@toks);
    int64:i = 0i64;
    while ((i + 1i64) < n) {
        Token:t = raw tokenlist_at(@toks, i);
        if (t.kind == TokenKind.KwUse) {
            Token:s = raw tokenlist_at(@toks, i + 1i64);
            if (s.kind == TokenKind.StringLit) {
                drop strlist_push(@out, raw intern_get(@it, s.payload =>! int32));
            }
        }
        i = i + 1i64;
    }
    pass out;
};

// Depth-first post-order over `use`, cycles broken: `order` ends with `p`
// itself, everything it transitively imports before it.
func:visit = NIL(string:p, StrSet->:seen, List<string>->:order) never fails {
    string:real = raw path_normalise(p);
    if (!(raw strset_add(seen, real))) { pass NIL; }
    Result<cstring>:cp = to_cstring(p);
    if (cp.is_error) { pass NIL; }
    Result<string>:rt = read_file(cp.value);
    if (rt.is_error) { pass NIL; }
    List<string>:targets = raw use_targets(rt.value);
    string:dir = raw path_dirname(p);
    for (int64:i in 0i64...targets.count) {
        string:cand = raw path_normalise(raw path_join(dir, raw strlist_view(targets, i)));
        Result<cstring>:cc = to_cstring(cand);
        if (cc.is_error) { continue; }
        if (path_exists(cc.value)) { drop visit(cand, seen, order); }
    }
    drop strlist_push(order, p);
    pass NIL;
};

// The files some other test imports, so they are not run standalone.
pub func:imported_by_others = StrSet(List<string>:paths) never fails {
    StrSet:used = raw strset_init(paths.count + 8i64);
    for (int64:i in 0i64...paths.count) {
        StrSet:seen = raw strset_init(16i64);
        List<string>:order = raw list_init::<string>(8i64);
        drop visit(raw strlist_view(paths, i), @seen, @order);
        for (int64:k in 0i64...(order.count - 1i64)) {
            discard(raw strset_add(@used, raw path_normalise(raw strlist_view(order, k))));
        }
        drop strset_free(@seen);
    }
    pass used;
};

// --- reading a test ----------------------------------------------------------------

pub func:read_text = string(string:path) {
    Result<cstring>:cp = to_cstring(path);
    if (cp.is_error) { fail cp.err; }
    pass (relay read_file(cp.value));
};

// A test whose expectations cannot be read is a failing test, by line.
func:unreadable = List<string>(string:name, Expect:exp) never fails {
    List<string>:f = raw list_init::<string>(1i64);
    string:m = string_concat(name, ": line ");
    m = string_concat(m, int_to_string(exp.bad_line));
    m = string_concat(m, ": an expectation marker whose number cannot be read");
    drop list_push(@f, move(m));
    pass f;
};

// --- diagnostics as the harness reads them -----------------------------------------

// `CODE path:line:col: message`, with `note ` / `warning ` in front for
// those severities: the code is token 0, the span token 1, the message is
// never asserted. A note goes to its own channel; a warning is a finding.
struct:Finding = { string:code; int64:line; int64:col; bool:is_note; };

func:findings_of = List<Finding>(string:stderr) never fails {
    List<Finding>:out = raw list_init::<Finding>(8i64);
    List<string>:lines = raw text_lines(stderr);
    for (int64:i in 0i64...lines.count) {
        List<string>:parts = raw text_split_ws(raw strlist_view(lines, i));
        int64:first = 0i64;
        bool:is_note = false;
        if (parts.count > 0i64) {
            string:p0 = raw strlist_view(parts, 0i64);
            if (raw text_eq(p0, "note")) { first = 1i64; is_note = true; }
            if (raw text_eq(p0, "warning")) { first = 1i64; }
        }
        if ((parts.count - first) < 2i64) { continue; }
        string:code = raw strlist_view(parts, first);
        string:span = raw strlist_view(parts, first + 1i64);
        if ((raw text_find_byte(span, 58u8, 0i64)) < 0i64) { continue; }
        // `span.rstrip(":")`, then the LAST two fields
        int64:stop_at = span.len;
        while (stop_at > 0i64) {
            if (span.ptr[stop_at - 1i64] != 58u8) { break; }
            stop_at = stop_at - 1i64;
        }
        string:sp = raw text_slice(span, 0i64, stop_at);
        int64:last = raw text_rfind_byte(sp, 58u8);
        string:ln = "";
        string:cl = "";
        if (last < 0i64) {
            ln = raw text_copy(sp);
        } else {
            int64:prev = 0i64 - 1i64;
            int64:k = last;
            while (k > 0i64) {
                k = k - 1i64;
                if (sp.ptr[k] == 58u8) { prev = k; break; }
            }
            if (prev < 0i64) {
                // one colon: `ln, _, cl = span.partition(":")`
                ln = raw text_slice(sp, 0i64, last);
                cl = raw text_slice(sp, last + 1i64, sp.len);
            } else {
                ln = raw text_slice(sp, prev + 1i64, last);
                cl = raw text_slice(sp, last + 1i64, sp.len);
            }
        }
        Result<int64>:li = text_int(ln);
        if (li.is_error) { continue; }
        Result<int64>:ci = text_int(cl);
        if (ci.is_error) { continue; }
        Finding:f = Finding{ code: raw text_copy(code), line: li.value, col: ci.value, is_note: is_note };
        drop list_push(@out, move(f));
    }
    pass out;
};

// `sorted(set(codes))` rendered as Python prints a list of strings.
func:codes_repr = string(List<Finding>:fs, bool:notes) never fails {
    List<string>:codes = raw list_init::<string>(4i64);
    for (int64:i in 0i64...fs.count) {
        if (fs.items[i].is_note != notes) { continue; }
        drop strlist_push(@codes, string_from_bytes(fs.items[i].code.ptr, fs.items[i].code.len));
    }
    List<string>:sorted = raw strlist_sorted_unique(codes);
    string:out = "[";
    for (int64:k in 0i64...sorted.count) {
        if (k > 0i64) { out = string_concat(out, ", "); }
        out = string_concat(out, "'");
        out = string_concat(out, raw strlist_view(sorted, k));
        out = string_concat(out, "'");
    }
    pass (string_concat(out, "]"));
};

// `[(g[1], g[2]) for g in hit]` rendered as Python prints it.
func:hits_repr = string(List<Finding>:fs, string:code, bool:notes) never fails {
    string:out = "[";
    bool:first = true;
    for (int64:i in 0i64...fs.count) {
        if (fs.items[i].is_note != notes) { continue; }
        if (!(raw text_eq(string_from_bytes(fs.items[i].code.ptr, fs.items[i].code.len), code))) { continue; }
        if (!first) { out = string_concat(out, ", "); }
        first = false;
        out = string_concat(out, "(");
        out = string_concat(out, int_to_string(fs.items[i].line));
        out = string_concat(out, ", ");
        out = string_concat(out, int_to_string(fs.items[i].col));
        out = string_concat(out, ")");
    }
    pass (string_concat(out, "]"));
};

// The matching loop, for the error channel (`notes` false) or the note
// channel: every expected code must be reported, and at its line and
// column when they are spelled.
func:match_channel = NIL(List<string>->:fl, string:name, List<Expected>:want,
                         List<Finding>:got, bool:notes) never fails {
    for (int64:i in 0i64...want.count) {
        string:code = string_from_bytes(want.items[i].code.ptr, want.items[i].code.len);
        int64:line = want.items[i].line;
        int64:col = want.items[i].col;
        bool:any_code = false;
        bool:at = false;
        for (int64:g in 0i64...got.count) {
            if (got.items[g].is_note != notes) { continue; }
            if (!(raw text_eq(string_from_bytes(got.items[g].code.ptr, got.items[g].code.len), code))) { continue; }
            any_code = true;
            if (got.items[g].line == line) {
                if ((col < 0i64) || (got.items[g].col == col)) { at = true; }
            }
        }
        if (!any_code) {
            string:m = string_concat(name, ": expected ");
            if (notes) { m = string_concat(m, "note "); }
            m = string_concat(m, code);
            m = string_concat(m, ", got ");
            m = string_concat(m, raw codes_repr(got, notes));
            drop list_push(fl, move(m));
            continue;
        }
        if (line >= 0i64) {
            if (!at) {
                string:m2 = string_concat(name, ": ");
                if (notes) { m2 = string_concat(m2, "note "); }
                m2 = string_concat(m2, code);
                m2 = string_concat(m2, " at ");
                m2 = string_concat(m2, raw hits_repr(got, code, notes));
                m2 = string_concat(m2, ", expected ");
                m2 = string_concat(m2, int_to_string(line));
                m2 = string_concat(m2, ":");
                if (col < 0i64) { m2 = string_concat(m2, "*"); }
                else { m2 = string_concat(m2, int_to_string(col)); }
                drop list_push(fl, move(m2));
            }
        }
    }
    pass NIL;
};

// EVERY REPORTED FINDING IS EXPECTED (D-237, 1.4.8b): the converse of
// `match_channel` -- on the error channel (findings, with `warning` counted as
// one) the SET of codes reported must EQUAL the set the expectations name, so
// a code no expectation names fails the test by name, as a missing one always
// has. Notes keep their own rule (an unexpected note is not a finding). One
// message per unexpected code, sorted, worded as the harness words it.
func:unexpected_codes = NIL(List<string>->:fl, string:name, List<Expected>:want,
                            List<Finding>:got) never fails {
    List<string>:codes = raw list_init::<string>(4i64);
    for (int64:g in 0i64...got.count) {
        if (got.items[g].is_note) { continue; }
        string:code = string_from_bytes(got.items[g].code.ptr, got.items[g].code.len);
        bool:named = false;
        for (int64:i in 0i64...want.count) {
            if (raw text_eq(string_from_bytes(want.items[i].code.ptr, want.items[i].code.len), code)) {
                named = true;
            }
        }
        if (!named) { drop strlist_push(@codes, code); }
    }
    List<string>:sorted = raw strlist_sorted_unique(codes);
    for (int64:k in 0i64...sorted.count) {
        string:m = string_concat(name, ": reported ");
        m = string_concat(m, raw strlist_view(sorted, k));
        m = string_concat(m, ", which no expectation names -- an unexpected diagnostic fails a test as surely as a missing one (BUILD_REFERENCE §7.1, D-237)");
        drop list_push(fl, move(m));
    }
    pass NIL;
};

// --- the verdicts ------------------------------------------------------------------

// A whole program that must be refused, with EXACTLY these codes -- by the
// loader, the type checker, an analysis, or the backend's rungs, whichever
// tool `binary` is (the harness's `check_module_rejection`, which every
// rejection suite shares). Every expected code reported at its place, every
// reported code expected (D-237).
pub async func:check_rejection = List<string>(Ctx->:c, string:binary, string:path, string:name,
                                              Expect:exp) {
    List<string>:fl = raw list_init::<string>(1i64);
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    Result<Run>:r = await compile_stdout(c, binary, path, raw duration_secs(20i64));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        drop strlist_push(@fl, string_concat(name, ": the frontend did not terminate"));
        pass fl;
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 3i64) {
        drop strlist_push(@fl, string_concat(name, ": the frontend TRAPPED -- a defect in the compiler, not in this file"));
        pass fl;
    }
    if (rc == 0i64) {
        string:m = string_concat(name, ": expected ");
        m = string_concat(m, raw expect_codes(exp.errors));
        m = string_concat(m, ", but it resolved cleanly");
        drop list_push(@fl, move(m));
        pass fl;
    }
    List<Finding>:got = raw findings_of(run.x.err);
    drop match_channel(@fl, name, exp.errors, got, false);
    drop match_channel(@fl, name, exp.notes, got, true);
    drop unexpected_codes(@fl, name, exp.errors, got);
    pass fl;
};

// A whole program the frontend must accept with NO diagnostics at all.
pub async func:check_accept = List<string>(Ctx->:c, string:binary, string:path, string:name) {
    List<string>:fl = raw list_init::<string>(1i64);
    Result<Run>:r = await compile_stdout(c, binary, path, raw duration_secs(20i64));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        drop strlist_push(@fl, string_concat(name, ": the frontend did not terminate"));
        pass fl;
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 3i64) {
        drop strlist_push(@fl, string_concat(name, ": the frontend TRAPPED -- a defect in the compiler, not in this file"));
        pass fl;
    }
    if (rc == 0i64) { pass fl; }
    // `sorted(set(line.split()[0] ...))`, or the exit code when there were none
    List<string>:firsts = raw list_init::<string>(4i64);
    List<string>:lines = raw text_lines(run.x.err);
    for (int64:i in 0i64...lines.count) {
        List<string>:parts = raw text_split_ws(raw strlist_view(lines, i));
        if (parts.count > 0i64) { drop strlist_push(@firsts, raw strlist_view(parts, 0i64)); }
    }
    string:m = string_concat(name, ": expected no diagnostics, got ");
    if (firsts.count == 0i64) {
        m = string_concat(m, int_to_string(rc));
    } else {
        List<string>:sorted = raw strlist_sorted_unique(firsts);
        m = string_concat(m, "[");
        for (int64:k in 0i64...sorted.count) {
            if (k > 0i64) { m = string_concat(m, ", "); }
            m = string_concat(m, "'");
            m = string_concat(m, raw strlist_view(sorted, k));
            m = string_concat(m, "'");
        }
        m = string_concat(m, "]");
    }
    drop list_push(@fl, move(m));
    pass fl;
};

// The real parser must accept this file with no diagnostics at all.
pub async func:check_parses = List<string>(Ctx->:c, string:binary, string:path, string:name) {
    List<string>:fl = raw list_init::<string>(1i64);
    Result<Run>:r = await compile_stdout(c, binary, path, raw duration_secs(20i64));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        drop strlist_push(@fl, string_concat(name, ": the real parser did not terminate"));
        pass fl;
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 2i64) {
        string:m0 = string_concat(name, ": parse_check could not read the file: ");
        m0 = string_concat(m0, raw text_trim(run.x.err));
        drop list_push(@fl, move(m0));
        pass fl;
    }
    if (rc == 3i64) {
        drop strlist_push(@fl, string_concat(name, ": the real parser TRAPPED -- a defect in the compiler, not in this file"));
        pass fl;
    }
    if (rc != 0i64) {
        string:m = string_concat(name, ": the REAL parser rejected it (");
        m = string_concat(m, raw text_replace_all(raw text_trim(run.x.err), "\n", ", "));
        m = string_concat(m, ") -- every file here must parse and be refused later, which is what D-085 says");
        drop list_push(@fl, move(m));
        pass fl;
    }
    pass fl;
};

// Compiles, links, runs, exits as expected -- with the compiler under test.
pub async func:check_positive = List<string>(Ctx->:c, string:name, string:entry, Expect:exp) {
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                raw text_replace_byte(name, 47u8, 95u8));
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len),
                                                   entry, name, base);
    if (fl.count > 0i64) { pass fl; }
    List<string>:noargs = raw list_init::<string>(1i64);
    pass (relay await run_binary(c, name, base, noargs, exp.stress, exp.exit_code, "", false));
};

// A correct program the BACKEND must refuse (D-085): parses, resolves,
// types, analyses -- and is refused by emission, naming the rung.
pub async func:check_negative = List<string>(Ctx->:c, string:name, string:entry, Expect:exp) {
    List<string>:fl = raw list_init::<string>(1i64);
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    if (exp.errors.count == 0i64) {
        drop strlist_push(@fl, string_concat(name, ": negative test declares no `// expect-error:` -- a test that only asserts 'it failed somehow' stops noticing when it starts failing for a different reason"));
        pass fl;
    }
    pass (relay await check_rejection(c, string_from_bytes(c.npkc.ptr, c.npkc.len), entry, name, exp));
};

// Compiles, but must emit exactly the expected warnings. Nothing emits
// warnings yet and no target uses the kind; defined so the shape is fixed.
pub async func:check_diagnostic = List<string>(Ctx->:c, string:name, string:entry, Expect:exp) {
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                raw text_replace_byte(name, 47u8, 95u8));
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len),
                                                   entry, name, base);
    if (fl.count > 0i64) { pass fl; }
    if (exp.errors.count > 0i64) {
        string:m = string_concat(name, ": expected warnings ");
        m = string_concat(m, raw expect_codes(exp.errors));
        m = string_concat(m, ", none emitted");
        drop list_push(@fl, move(m));
    }
    pass fl;
};

// A program COMPILED BY THIS COMPILER'S BACKEND, run, its exit compared --
// then the same through `opt -O2`. `// argv:` tokens naming a fixture are
// substituted with the built fixture's path; anything else passes verbatim.
pub async func:check_program = List<string>(Ctx->:c, string:path, string:name, Expect:exp,
                                            List<string>:fix_keys, List<string>:fix_paths) {
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                string_concat("prog_", raw text_replace_byte(raw text_file_name(path), 46u8, 95u8)));
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len),
                                                   path, name, base);
    if (fl.count > 0i64) { pass fl; }
    List<string>:args = raw list_init::<string>(2i64);
    for (int64:i in 0i64...exp.argv.count) {
        string:tok = raw strlist_view(exp.argv, i);
        string:sub = raw text_copy(tok);
        for (int64:k in 0i64...fix_keys.count) {
            if (raw text_eq(raw strlist_view(fix_keys, k), tok)) { sub = raw strlist_copy(fix_paths, k); }
        }
        drop strlist_push(@args, sub);
    }
    List<string>:r0 = relay await run_binary(c, name, base, args, exp.stress, exp.exit_code,
                                             " (compiled by the REAL backend)", false);
    if (r0.count > 0i64) { pass r0; }
    pass (relay await check_optimised(c, name, base, args, exp.stress, exp.exit_code));
};

// --- the run -----------------------------------------------------------------------

func:matches_only = bool(string:rel, List<string>:only) never fails {
    for (int64:i in 0i64...only.count) {
        if (raw text_contains(rel, raw strlist_view(only, i))) { pass true; }
    }
    pass false;
};

// Every file with `suffix` under the entry's paths, EACH ONCE, in manifest
// path order and sorted within a path -- `list_suffix` per path, or the
// recursive walk when the entry says so. (The hardcoded sweeps concatenated
// their lists and parsed six files twice; a table sweeps a file once.)
func:files_of = List<string>(Ctx->:c, List<string>:paths, bool:recursive, string:suffix) {
    List<string>:out = raw list_init::<string>(32i64);
    StrSet:seen = raw strset_init(64i64);
    for (int64:i in 0i64...paths.count) {
        string:dir = raw in_root(c, raw strlist_view(paths, i));
        List<string>:found = raw list_init::<string>(1i64);
        if (recursive) { found = relay walk_files(dir, suffix); }
        else { found = relay list_suffix(dir, suffix); }
        for (int64:k in 0i64...found.count) {
            string:p = raw strlist_view(found, k);
            if (raw strset_add(@seen, raw path_normalise(p))) { drop strlist_push(@out, p); }
        }
    }
    drop strset_free(@seen);
    pass out;
};

// The tool a stage judges with -- `tools/<which>.npk` built by the builder --
// once, on first use, and kept in the Ctx ("" not yet asked, "!" it did not
// build, else its path). A tool that did not build is one recorded failure,
// and every stage that needs it skips. Returns "" when there is no tool.
async func:tool_for = string(Ctx->:c, string:which) {
    string:have = "";
    if (raw text_eq(which, "parse_check"))   { have = string_from_bytes(c.parse_check.ptr, c.parse_check.len); }
    if (raw text_eq(which, "resolve_check")) { have = string_from_bytes(c.resolve_check.ptr, c.resolve_check.len); }
    if (raw text_eq(which, "check"))         { have = string_from_bytes(c.check.ptr, c.check.len); }
    if (have.len > 0i64) {
        if (raw text_eq(have, "!")) { pass ""; }
        pass (raw text_copy(have));
    }
    string:src = raw in_root(c, string_concat(string_concat("tools/", which), ".npk"));
    Result<Step>:st = await build_tool(c, src, which);
    if (st.is_error) { fail st.err; }
    Step:s = move(st.value);
    string:got = "!";
    if (s.ok) {
        got = raw text_copy(s.text);
    } else {
        string:m = string_concat(string_concat("tools/", which), ".npk did not build: ");
        drop note_failure(c, string_concat(m, s.text));
    }
    if (raw text_eq(which, "parse_check"))   { c.parse_check = raw text_copy(got); }
    if (raw text_eq(which, "resolve_check")) { c.resolve_check = raw text_copy(got); }
    if (raw text_eq(which, "check"))         { c.check = raw text_copy(got); }
    if (raw text_eq(got, "!")) { pass ""; }
    pass got;
};

// The entry's label, a view.
func:entry_name = string(Ctx->:c, int64:t) never fails {
    pass (string_from_bytes(c.m.tests.items[t].name.ptr, c.m.tests.items[t].name.len));
};

// --- the stages (D-238): one function per stage, the entry decides the files ----------

// `compile`: the compiler under test over every standalone file, held to the
// entry's kind. A file some other file in the suite imports is a fixture and
// is not run. `--only` narrows here and nowhere else; the counts are these.
async func:run_compile = NIL(Ctx->:c, int64:t, List<string>:only) {
    string:tname = raw entry_name(c, t);
    string:kind = string_from_bytes(c.m.tests.items[t].kind.ptr, c.m.tests.items[t].kind.len);
    bool:filtering = (only.count > 0i64);
    List<string>:paths = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    StrSet:skip = raw imported_by_others(paths);
    List<string>:run_paths = raw list_init::<string>(paths.count + 1i64);
    for (int64:i in 0i64...paths.count) {
        string:p = raw strlist_view(paths, i);
        if (raw strset_has(skip, p)) { continue; }
        drop strlist_push(@run_paths, p);
    }
    drop strset_free(@skip);
    c.available = c.available + run_paths.count;
    List<string>:chosen = raw list_init::<string>(run_paths.count + 1i64);
    for (int64:j in 0i64...run_paths.count) {
        string:p2 = raw strlist_view(run_paths, j);
        if (filtering) {
            if (!(raw matches_only(raw rel_to_root(c, p2), only))) { continue; }
        }
        drop strlist_push(@chosen, p2);
    }
    if (filtering && (chosen.count == 0i64)) { pass NIL; }
    for (int64:k in 0i64...chosen.count) {
        string:p3 = raw strlist_view(chosen, k);
        c.total = c.total + 1i64;
        string:name = raw rel_to_root(c, p3);
        string:text = relay read_text(p3);
        Expect:exp = raw expect_read(text);
        List<string>:fl = raw list_init::<string>(1i64);
        if (raw text_eq(kind, "positive"))   { fl = relay await check_positive(c, name, p3, exp); }
        if (raw text_eq(kind, "negative"))   { fl = relay await check_negative(c, name, p3, exp); }
        if (raw text_eq(kind, "diagnostic")) { fl = relay await check_diagnostic(c, name, p3, exp); }
        drop record(c, tname, name, fl);
    }
    drop say(raw stage_line(tname, chosen.count, string_concat(kind, " test(s)")));
    pass NIL;
};

// `parse`: the real parser over every source under the entry's paths, each
// once, accepted with no diagnostic. A rejection test the real parser cannot
// read is testing the wrong stage (D-085); the compiler's own tree is the
// file set that matters most -- stage 1 must parse it to build stage 2.
async func:run_parse = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:pc = relay await tool_for(c, "parse_check");
    if (pc.len == 0i64) { pass NIL; }
    List<string>:files = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:q in 0i64...files.count) {
        string:p = raw strlist_view(files, q);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await check_parses(c, pc, p, name);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "real-parser check(s)"));
    pass NIL;
};

// `resolve` / `check`: whole programs refused with EXACTLY the expected codes
// by the tool the stage names -- the loader (`resolve_check`) or the frontend
// (`check`: the type checker, an analysis, expansion, derive, whichever the
// suite's directory says). A file with no `expect-error:` is a fixture another
// one imports, not a test.
async func:run_rejection = NIL(Ctx->:c, int64:t, string:which) {
    string:tname = raw entry_name(c, t);
    string:tool = relay await tool_for(c, which);
    if (tool.len == 0i64) { pass NIL; }
    List<string>:files = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:i in 0i64...files.count) {
        string:p = raw strlist_view(files, i);
        string:text = relay read_text(p);
        Expect:exp = raw expect_read(text);
        if (exp.errors.count == 0i64) { continue; }
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await check_rejection(c, tool, p, name, exp);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    string:by = "the frontend";
    if (raw text_eq(which, "resolve_check")) { by = "the loader"; }
    drop say(raw stage_line(tname, count, string_concat("rejection test(s), refused by ", by)));
    pass NIL;
};

// `accept`: whole programs the frontend must ACCEPT, in full silence -- the
// counterweight to the rejection suites. One suite, not one per stage:
// silence has no stage.
async func:run_accept_stage = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:check = relay await tool_for(c, "check");
    if (check.len == 0i64) { pass NIL; }
    List<string>:files = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:i in 0i64...files.count) {
        string:p = raw strlist_view(files, i);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await check_accept(c, check, p, name);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "acceptance test(s)"));
    pass NIL;
};

// `fixture`: helper binaries a test spawns, built like programs and never run;
// a program names one in `// argv:` by its uppercased stem, and the map this
// fills is read by the `program` stage (so this entry comes first). A `.c` is
// a reference DRIVER (1.1.13c): TEST TOOLING, never in the artifact, built
// with the system C compiler exactly as the harness builds them.
// `object`: a NON-ROOT module compiled alone to an object `llc` accepts
// (1.5.1b step 3c, the workbench's O-N14): BUILD_REFERENCE §4.1's per-module
// object, measured. Its undefined symbols are the runtime's and
// `npk_failsafe`, the handler the program root supplies. A comment-only
// module is a unit here on purpose: the smallest that needs the declare.
async func:run_object = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:objdir = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len), "objects");
    List<string>:mods = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    if (mods.count > 0i64) {
        Result<NIL>:d = ensure_dir(objdir);
        if (d.is_error) { fail d.err; }
    }
    List<string>:allow = raw strlist_clone(c.allow);
    drop strlist_push(@allow, "npk_failsafe");
    for (int64:i in 0i64...mods.count) {
        string:p = raw strlist_view(mods, i);
        string:fname = raw text_file_name(p);
        string:stem = raw text_slice(fname, 0i64, fname.len - 4i64);
        string:obase = raw path_join(objdir, stem);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await emit_and_object(c, string_from_bytes(c.npkc.ptr, c.npkc.len), p, name, obase, allow);
        drop record(c, tname, name, fl);
    }
    drop say(raw stage_line(tname, mods.count, "module object(s): non-root modules compiled alone, assembled by llc, needing only the runtime and `npk_failsafe`"));
    pass NIL;
};

async func:run_fixture = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    string:fixdir = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len), "fixtures");
    List<string>:fixtures = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    List<string>:cfixtures = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".c");
    if ((fixtures.count > 0i64) || (cfixtures.count > 0i64)) {
        Result<NIL>:d = ensure_dir(fixdir);
        if (d.is_error) { fail d.err; }
    }
    for (int64:i in 0i64...fixtures.count) {
        string:p = raw strlist_view(fixtures, i);
        string:fname = raw text_file_name(p);
        string:stem = raw text_slice(fname, 0i64, fname.len - 4i64);
        string:fbase = raw path_join(fixdir, stem);
        string:name = raw rel_to_root(c, p);
        List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len), p, name, fbase);
        drop record(c, tname, name, fl);
        if (fl.count > 0i64) { continue; }
        drop strlist_push(@c.fix_keys, raw text_upper(stem));
        drop strlist_push(@c.fix_paths, fbase);
    }
    for (int64:j in 0i64...cfixtures.count) {
        string:cp = raw strlist_view(cfixtures, j);
        string:cname = raw text_file_name(cp);
        string:cstem = raw text_slice(cname, 0i64, cname.len - 2i64);
        string:cbase = raw path_join(fixdir, cstem);
        string:crel = raw rel_to_root(c, cp);
        List<string>:cfails = raw list_init::<string>(1i64);
        if (c.t.cc.len == 0i64) {
            drop strlist_push(@cfails, string_concat(crel, ": cc failed: no C compiler on PATH"));
        } else {
            List<string>:args = raw list_init::<string>(5i64);
            drop strlist_push(@args, "-O1");
            drop strlist_push(@args, "-Wall");
            drop strlist_push(@args, "-o");
            drop strlist_push(@args, cbase);
            drop strlist_push(@args, cp);
            Result<Step>:s = await tool_step(c, string_from_bytes(c.t.cc.ptr, c.t.cc.len), args, raw duration_secs(600i64));
            if (s.is_error) { fail s.err; }
            Step:st = move(s.value);
            if (!st.ok) {
                string:m = string_concat(crel, ": cc failed: ");
                m = string_concat(m, raw text_head(raw text_trim(st.text), 160i64));
                drop list_push(@cfails, move(m));
            }
        }
        drop record(c, tname, crel, cfails);
        if (cfails.count > 0i64) { continue; }
        drop strlist_push(@c.fix_keys, raw text_upper(cstem));
        drop strlist_push(@c.fix_paths, cbase);
    }
    drop say(raw stage_line(tname, fixtures.count + cfixtures.count, "fixture(s) built, never run"));
    pass NIL;
};

// `program`: the real backend over every standalone program under the entry's
// paths -- the -O0 run and the -O2 re-run -- with `// argv:` fixture names
// substituted from the map the `fixture` stage filled. A file another one in
// the suite imports is a fixture, not a program.
async func:run_program = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    List<string>:paths = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    StrSet:skip = raw imported_by_others(paths);
    int64:count = 0i64;
    for (int64:k in 0i64...paths.count) {
        string:p2 = raw strlist_view(paths, k);
        if (raw strset_has(skip, p2)) { continue; }
        string:text = relay read_text(p2);
        Expect:exp = raw expect_read(text);
        string:name = raw rel_to_root(c, p2);
        List<string>:fl = relay await check_program(c, p2, name, exp, c.fix_keys, c.fix_paths);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop strset_free(@skip);
    drop say(raw stage_line(tname, count, "real-backend program(s)"));
    drop say(raw stage_text("opt-O2", "every program re-run through opt -O2 + llc -O2, same exit required"));
    pass NIL;
};

// `runtime`: the floor's own `.ll` tests, assembled, linked against the
// floor, run; `expect-exit:` read from the first 400 bytes.
async func:run_runtime_stage = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    List<string>:tests = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".ll");
    int64:count = 0i64;
    for (int64:i in 0i64...tests.count) {
        string:rp = raw strlist_view(tests, i);
        string:name = raw rel_to_root(c, rp);
        string:text = relay read_text(rp);
        // A hand-written floor test is held to the undef ban too (D-218.10).
        List<string>:fnu = raw ir_no_undef(text, name);
        if (fnu.count > 0i64) { drop record(c, tname, name, fnu); continue; }
        string:head = raw text_head(text, 400i64);
        int64:want = 0i64;
        int64:at = raw text_index_of(head, "expect-exit:");
        if (at >= 0i64) {
            int64:q = at + 12i64;
            while (q < head.len) {
                if (!(raw text_is_ws(head.ptr[q]))) { break; }
                q = q + 1i64;
            }
            int64:e = q;
            while (e < head.len) {
                if (!(raw text_is_digit(head.ptr[e]))) { break; }
                e = e + 1i64;
            }
            if (e > q) {
                Result<int64>:v = text_int(raw text_slice(head, q, e));
                if (!v.is_error) { want = v.value; }
            }
        }
        string:fname = raw text_file_name(rp);
        string:rbase = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                     string_concat("rt_", raw text_slice(fname, 0i64, fname.len - 3i64)));
        string:robj = string_concat(rbase, ".o");
        List<string>:fl = raw list_init::<string>(1i64);
        Result<Step>:s1 = await llc_obj(c, c.m.llc_flags, rp, robj);
        if (s1.is_error) { fail s1.err; }
        Step:st1 = move(s1.value);
        if (!st1.ok) {
            string:m1 = string_concat(name, ": llc failed: ");
            m1 = string_concat(m1, raw text_head(raw text_trim(st1.text), 120i64));
            drop list_push(@fl, move(m1));
            drop record(c, tname, name, fl);
            continue;
        }
        Result<Step>:s2 = await lld_link(c, rbase, robj);
        if (s2.is_error) { fail s2.err; }
        Step:st2 = move(s2.value);
        if (!st2.ok) {
            string:m2 = string_concat(name, ": link failed: ");
            m2 = string_concat(m2, raw text_head(raw text_trim(st2.text), 120i64));
            drop list_push(@fl, move(m2));
            drop record(c, tname, name, fl);
            continue;
        }
        List<string>:noargs = raw list_init::<string>(1i64);
        Result<Run>:r = await run_argv(rbase, noargs, c.t.env, raw duration_secs(60i64));
        if (r.is_error) { fail r.err; }
        Run:run = move(r.value);
        int64:got = run.x.status;
        if (!run.x.exited) { got = 0i64 - run.x.signal; }
        if (run.timed_out) {
            drop strlist_push(@fl, string_concat(name, ": timed out"));
        } else {
            if (got != want) {
                string:m3 = string_concat(name, ": exited ");
                m3 = string_concat(m3, int_to_string(got));
                m3 = string_concat(m3, ", expected ");
                m3 = string_concat(m3, int_to_string(want));
                drop list_push(@fl, move(m3));
            }
        }
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "runtime-floor test(s)"));
    pass NIL;
};

// --- the verify stage (1.5.0, P-22) -------------------------------------------------

// The module a test declares (`mod:NAME;`), for scoping its rows.
func:module_of = string(string:text) never fails {
    List<string>:lines = raw text_lines(text);
    for (int64:i in 0i64...lines.count) {
        string:s = raw text_trim(raw strlist_view(lines, i));
        if (raw text_starts_with(s, "mod:")) {
            int64:semi = raw text_find_byte(s, 59u8, 0i64);
            if (semi > 4i64) { pass (raw text_slice(s, 4i64, semi)); }
        }
    }
    pass "";
};

func:row_in_module = bool(string:sym, string:modname) never fails {
    if (raw text_eq(sym, "@main")) { pass true; }
    if (raw text_eq(sym, "@npk_failsafe")) { pass true; }
    string:prefix = string_concat("@\"npk.", modname);
    prefix = string_concat(prefix, ".");
    pass (raw text_starts_with(sym, prefix));
};

// One `verify` test, the harness's `check_verify_program` step for step:
// obligations emitted (and the flag-less emission byte-identical), decided,
// the module's (kind, verdict) counts compared exactly, the VERIFIED build
// emitted with this run's manifest, cross-checked, linked, run at -O0 and -O2.
pub async func:check_verify = List<string>(Ctx->:c, string:path, string:name, Expect:exp) {
    List<string>:fl = raw list_init::<string>(1i64);
    if (!exp.ok) { pass (raw unreadable(name, exp)); }
    if ((exp.obligations.count == 0i64) && (!exp.obligations_none)) {
        drop strlist_push(@fl, string_concat(name, ": a verify test with no expect-obligation is a failing test"));
        pass fl;
    }
    Result<string>:z3r = which("z3");
    if (z3r.is_error) { fail z3r.err; }
    string:z3 = move(z3r.value);
    if (z3.len == 0i64) { drop strlist_push(@fl, string_concat(name, ": z3 is not on PATH")); pass fl; }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                string_concat("verify_", raw text_replace_byte(raw text_file_name(path), 46u8, 95u8)));
    string:obl = string_concat(base, ".obl");
    string:plain = string_concat(base, ".plain.ll");
    string:compiler = string_from_bytes(c.npkc.ptr, c.npkc.len);
    List<string>:a1 = raw list_init::<string>(6i64);
    drop strlist_push(@a1, path);
    drop strlist_push(@a1, "--obligations");
    drop strlist_push(@a1, obl);
    drop strlist_push(@a1, "-o");
    drop strlist_push(@a1, plain);
    Result<Run>:r1 = await compile_args(c, compiler, a1, raw duration_secs(300i64));
    if (r1.is_error) { fail r1.err; }
    Run:run1 = move(r1.value);
    if (run1.timed_out) { drop strlist_push(@fl, string_concat(name, ": npkc did not terminate")); pass fl; }
    if (!(run1.x.exited && (run1.x.status == 0i64))) {
        string:m0 = string_concat(name, ": expected IR, got a refusal (");
        m0 = string_concat(m0, raw text_replace_all(raw text_trim(run1.x.err), "\n", ", "));
        m0 = string_concat(m0, ")");
        drop list_push(@fl, move(m0));
        pass fl;
    }
    Result<Run>:r0 = await compile_stdout(c, compiler, path, raw duration_secs(300i64));
    if (r0.is_error) { fail r0.err; }
    Run:run0 = move(r0.value);
    Result<cstring>:pc = to_cstring(plain);
    if (pc.is_error) { fail pc.err; }
    Result<string>:ptext = read_file(pc.value);
    if (ptext.is_error) { fail ptext.err; }
    if (!(raw text_eq(run0.x.out, ptext.value))) {
        drop strlist_push(@fl, string_concat(name, ": `--obligations` changed the emitted IR -- the walk must never touch the writer (P-3)"));
        pass fl;
    }
    List<string>:nu = raw ir_no_undef(ptext.value, name);
    if (nu.count > 0i64) { pass nu; }
    Result<List<VRow>>:rows_r = read_rows(obl);
    if (rows_r.is_error) { drop strlist_push(@fl, string_concat(name, ": rows.txt could not be read")); pass fl; }
    List<VRow>:rows = rows_r.value;
    Result<List<VFile>>:files_r = read_index(obl);
    if (files_r.is_error) { drop strlist_push(@fl, string_concat(name, ": index.txt could not be read")); pass fl; }
    List<VFile>:files = files_r.value;
    Result<NIL>:zr = await z3_decide(c, z3, obl, @rows, files, name, @fl);
    if (zr.is_error) { fail zr.err; }
    if (fl.count > 0i64) { pass fl; }
    // the module's counts, exactly (D-237's shape)
    string:modname = raw module_of(relay read_text(path));
    List<string>:keys = raw list_init::<string>(4i64);
    List<int64>:counts = raw list_init::<int64>(4i64);
    for (int64:i in 0i64...rows.count) {
        if (!(raw row_in_module(string_from_bytes(rows.items[i].symbol.ptr, rows.items[i].symbol.len), modname))) { continue; }
        string:key = string_concat(string_from_bytes(rows.items[i].kind.ptr, rows.items[i].kind.len), " ");
        key = string_concat(key, raw ov_name(rows.items[i].verdict));
        int64:slot = 0i64 - 1i64;
        for (int64:j in 0i64...keys.count) { if (raw text_eq(raw strlist_view(keys, j), key)) { slot = j; } }
        if (slot < 0i64) { drop list_push(@keys, move(key)); drop list_push(@counts, 1i64); }
        else { counts.items[slot] = counts.items[slot] + 1i64; }
    }
    if (exp.obligations_none && (keys.count > 0i64)) {
        string:m1 = string_concat(name, ": expected no obligations in module `");
        m1 = string_concat(m1, modname);
        m1 = string_concat(m1, "`, found ");
        m1 = string_concat(m1, int_to_string(rows.count));
        drop list_push(@fl, move(m1));
        pass fl;
    }
    // every expected key present with its count; every found key expected
    for (int64:e in 0i64...exp.obligations.count) {
        string:want = string_concat(string_from_bytes(exp.obligations.items[e].kind.ptr, exp.obligations.items[e].kind.len), " ");
        want = string_concat(want, string_from_bytes(exp.obligations.items[e].verdict.ptr, exp.obligations.items[e].verdict.len));
        int64:found = 0i64;
        for (int64:j2 in 0i64...keys.count) { if (raw text_eq(raw strlist_view(keys, j2), want)) { found = counts.items[j2]; } }
        if (found != exp.obligations.items[e].n) {
            string:m2 = string_concat(name, ": ");
            m2 = string_concat(m2, want);
            m2 = string_concat(m2, ": expected ");
            m2 = string_concat(m2, int_to_string(exp.obligations.items[e].n));
            m2 = string_concat(m2, ", found ");
            m2 = string_concat(m2, int_to_string(found));
            m2 = string_concat(m2, " (the rows of module `");
            m2 = string_concat(m2, modname);
            m2 = string_concat(m2, "`; every reported kind/verdict must be named, D-237's shape)");
            drop list_push(@fl, move(m2));
        }
    }
    for (int64:j3 in 0i64...keys.count) {
        bool:named = false;
        for (int64:e2 in 0i64...exp.obligations.count) {
            string:w2 = string_concat(string_from_bytes(exp.obligations.items[e2].kind.ptr, exp.obligations.items[e2].kind.len), " ");
            w2 = string_concat(w2, string_from_bytes(exp.obligations.items[e2].verdict.ptr, exp.obligations.items[e2].verdict.len));
            if (raw text_eq(w2, raw strlist_view(keys, j3))) { named = true; }
        }
        if (!named) {
            string:m3 = string_concat(name, ": ");
            m3 = string_concat(m3, raw strlist_view(keys, j3));
            m3 = string_concat(m3, ": expected 0, found ");
            m3 = string_concat(m3, int_to_string(counts.items[j3]));
            m3 = string_concat(m3, " (the rows of module `");
            m3 = string_concat(m3, modname);
            m3 = string_concat(m3, "`; every reported kind/verdict must be named, D-237's shape)");
            drop list_push(@fl, move(m3));
        }
    }
    if (fl.count > 0i64) { pass fl; }
    // this run's manifest, the verified build, its cross-checks
    string:man = string_concat(base, ".obligations");
    Result<cstring>:mc = to_cstring(man);
    if (mc.is_error) { fail mc.err; }
    Result<NIL>:mw = write_file(mc.value, raw manifest_of(c, rows));
    if (mw.is_error) { fail mw.err; }
    string:vbase = string_concat(base, ".v");
    string:vll = string_concat(vbase, ".ll");
    List<string>:a2 = raw list_init::<string>(8i64);
    drop strlist_push(@a2, path);
    drop strlist_push(@a2, "--elide");
    drop strlist_push(@a2, man);
    drop strlist_push(@a2, "--obligations");
    drop strlist_push(@a2, string_concat(obl, "2"));
    drop strlist_push(@a2, "-o");
    drop strlist_push(@a2, vll);
    Result<Run>:r2 = await compile_args(c, compiler, a2, raw duration_secs(300i64));
    if (r2.is_error) { fail r2.err; }
    Run:run2 = move(r2.value);
    if (!(run2.x.exited && (run2.x.status == 0i64))) {
        drop strlist_push(@fl, string_concat(name, string_concat(": the --elide run refused: ", raw text_head(raw text_trim(run2.x.err), 300i64))));
        pass fl;
    }
    Result<cstring>:ra = to_cstring(raw path_join(obl, "rows.txt"));
    if (ra.is_error) { fail ra.err; }
    Result<cstring>:rb = to_cstring(raw path_join(string_concat(obl, "2"), "rows.txt"));
    if (rb.is_error) { fail rb.err; }
    Result<string>:ta = read_file(ra.value);
    if (ta.is_error) { fail ta.err; }
    Result<string>:tb = read_file(rb.value);
    if (tb.is_error) { fail tb.err; }
    if (!(raw text_eq(ta.value, tb.value))) {
        drop strlist_push(@fl, string_concat(name, ": the --elide run computed different rows than the --obligations run -- the walk depends on something it must not (P-3)"));
        pass fl;
    }
    Result<cstring>:vc = to_cstring(vll);
    if (vc.is_error) { fail vc.err; }
    Result<string>:vir = read_file(vc.value);
    if (vir.is_error) { fail vir.err; }
    List<string>:nu2 = raw ir_no_undef(vir.value, string_concat(name, " (verified)"));
    if (nu2.count > 0i64) { pass nu2; }
    List<string>:xc = raw elided_ir_checks(rows, vir.value, name);
    if (xc.count > 0i64) { pass xc; }
    string:vobj = string_concat(vbase, ".o");
    Result<Step>:l1 = await llc_obj(c, c.m.llc_flags, vll, vobj);
    if (l1.is_error) { fail l1.err; }
    Step:st1 = move(l1.value);
    if (!st1.ok) { drop strlist_push(@fl, string_concat(name, string_concat(": llc rejected the verified IR: ", raw first_line_with(st1.text, "error", 160i64)))); pass fl; }
    List<string>:zd = raw zero_dep(c, vobj, c.allow, string_concat(name, " (verified)"));
    if (zd.count > 0i64) { pass zd; }
    Result<Step>:l2 = await lld_link(c, vbase, vobj);
    if (l2.is_error) { fail l2.err; }
    Step:st2 = move(l2.value);
    if (!st2.ok) { drop strlist_push(@fl, string_concat(name, string_concat(": the verified build failed to link: ", raw text_head(raw text_trim(st2.text), 140i64)))); pass fl; }
    List<string>:noargs = raw list_init::<string>(1i64);
    List<string>:r0f = relay await run_binary(c, name, vbase, noargs, 1i64, exp.exit_code, " (the verified build)", false);
    if (r0f.count > 0i64) { pass r0f; }
    pass (relay await check_optimised(c, name, vbase, noargs, 1i64, exp.exit_code));
};

async func:run_verify = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    List<string>:paths = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".npk");
    int64:count = 0i64;
    for (int64:k in 0i64...paths.count) {
        string:p2 = raw strlist_view(paths, k);
        string:text = relay read_text(p2);
        Expect:exp = raw expect_read(text);
        string:name = raw rel_to_root(c, p2);
        List<string>:fl = relay await check_verify(c, p2, name, exp);
        drop record(c, tname, name, fl);
        count = count + 1i64;
    }
    drop say(raw stage_line(tname, count, "verified program(s): obligations decided, elided where discharged, run at -O0 and -O2"));
    pass NIL;
};

// EVERY SUITE, IN MANIFEST ORDER (D-238). A filtered run touches the
// compile-stage entries only: the other stages ask questions about the
// sources as a set -- does every file parse, is every rejection exact --
// which a subset cannot answer. `manifest_load` refused any stage not named
// below before anything ran.
// --- the cost stage (1.5.1b step 0): the allocator's numbers as verdicts ---------------
//
// The harness's `stage_cost`, unit for unit. WALL-CLOCK IS NEVER A VERDICT:
// every number is the runtime's own count under NPK_HEAP_STATS -- bytes
// requested in total, the peak of bytes live, allocations -- a function of the
// program's allocation sequence and of nothing else, so the same input gives
// the same numbers on every machine and every run. A unit is one `.toml`
// under the entry's paths, its expectation inside it: a `recipe` unit
// regenerates one of DEF-1's three shapes at N and at N*scale and holds both
// ratios to `bound`; a `probe` unit runs two programs and holds the first's
// peak_live to `bound` times the second's; a `self` unit compiles the
// compiler's own entry and reports, held to `ceiling` when one is set.
// `expect = "fail"` is the NEGATIVE CONTROL (D-237's discipline): the bound
// must be VIOLATED until the commit `until` names lands, and the day it holds
// the unit fails until its row is removed. Every compile and run must exit 0:
// a fast failure looks like a fast compile. Seconds print as colour only.

struct:CostUnit = {
    string:kind;      // recipe | probe | self
    string:recipe;    // fixed-array | statements | literal
    int64:n;
    int64:scale;
    int64:bound;
    string:program;
    string:against;
    string:entry;
    int64:ceiling;
    string:expect;    // pass | fail
    string:until;
};

struct:CostRead = { bool:ok; string:problem; CostUnit:u; };
struct:HeapStats = { bool:ok; int64:allocated; int64:peak; int64:count; };
struct:CostPoint = { bool:ok; string:problem; int64:allocated; int64:peak; int64:count; int64:ns; };
struct:CostOut = { List<string>:faults; string:report; };

func:cost_unit_blank = CostUnit() never fails {
    pass CostUnit{ kind: "", recipe: "", n: 0i64, scale: 0i64, bound: 0i64, program: "", against: "",
                   entry: "", ceiling: 0i64, expect: "", until: "" };
};

func:cost_refuse = CostRead(string:msg) never fails {
    pass CostRead{ ok: false, problem: raw text_copy(msg), u: raw cost_unit_blank() };
};

func:cost_key_allowed = bool(string:kind, string:key) never fails {
    if (raw text_eq(key, "kind"))   { pass true; }
    if (raw text_eq(key, "expect")) { pass true; }
    if (raw text_eq(kind, "recipe")) {
        if (raw text_eq(key, "recipe")) { pass true; }
        if (raw text_eq(key, "n"))      { pass true; }
        if (raw text_eq(key, "scale"))  { pass true; }
        if (raw text_eq(key, "bound"))  { pass true; }
        if (raw text_eq(key, "until"))  { pass true; }
        pass false;
    }
    if (raw text_eq(kind, "probe")) {
        if (raw text_eq(key, "program")) { pass true; }
        if (raw text_eq(key, "against")) { pass true; }
        if (raw text_eq(key, "bound"))   { pass true; }
        if (raw text_eq(key, "until"))   { pass true; }
        pass false;
    }
    if (raw text_eq(key, "entry"))   { pass true; }
    if (raw text_eq(key, "ceiling")) { pass true; }
    pass false;
};

func:cost_keys_text = string(string:kind) never fails {
    if (raw text_eq(kind, "recipe")) { pass "kind, recipe, n, scale, bound, expect, until"; }
    if (raw text_eq(kind, "probe"))  { pass "kind, program, against, bound, expect, until"; }
    pass "kind, entry, ceiling, expect";
};

// A required root-level string key, or "" (the caller refuses by name).
func:cost_str = string(TomlDoc:d, string:key) never fails {
    if (!(raw toml_has(d, "", 0i64 - 1i64, key))) { pass ""; }
    Result<string>:r = toml_string(d, "", 0i64 - 1i64, key);
    if (r.is_error) { pass ""; }
    pass (move(r.value));
};

// A root-level integer key, or -1 when absent or not an integer.
func:cost_int = int64(TomlDoc:d, string:key) never fails {
    if (!(raw toml_has(d, "", 0i64 - 1i64, key))) { pass (0i64 - 1i64); }
    Result<int64>:r = toml_int(d, "", 0i64 - 1i64, key);
    if (r.is_error) { pass (0i64 - 1i64); }
    pass r.value;
};

// One unit, validated STRICTLY (the manifest's discipline): a key the schema
// lacks, a kind or recipe nobody implements, a bound that is not a positive
// integer, an expected failure with no `until`, an `until` on an expected
// pass -- each refused by name.
func:read_cost_unit = CostRead(string:text) never fails {
    TomlDoc:d = raw toml_parse(text);
    if (!d.ok) {
        pass (raw cost_refuse(string_concat("not a readable TOML unit: line ", int_to_string(d.bad_line))));
    }
    CostUnit:u = raw cost_unit_blank();
    u.kind = raw cost_str(d, "kind");
    bool:known = false;
    if (raw text_eq(string_from_bytes(u.kind.ptr, u.kind.len), "recipe")) { known = true; }
    if (raw text_eq(string_from_bytes(u.kind.ptr, u.kind.len), "probe"))  { known = true; }
    if (raw text_eq(string_from_bytes(u.kind.ptr, u.kind.len), "self"))   { known = true; }
    if (!known) { pass (raw cost_refuse("`kind` must be one of recipe, probe, self")); }
    string:kind = string_from_bytes(u.kind.ptr, u.kind.len);
    int64:ne = raw toml_entry_count(d);
    for (int64:i in 0i64...ne) {
        string:key = string_from_bytes(d.entries.items[i].key.ptr, d.entries.items[i].key.len);
        if (d.entries.items[i].section.len > 0i64) {
            key = string_from_bytes(d.entries.items[i].section.ptr, d.entries.items[i].section.len);
        }
        bool:allowed = raw cost_key_allowed(kind, key);
        if (d.entries.items[i].section.len > 0i64) { allowed = false; }
        if (!allowed) {
            string:m = string_concat("`", key);
            m = string_concat(m, "` is not a key a ");
            m = string_concat(m, kind);
            m = string_concat(m, " unit has; the keys are ");
            m = string_concat(m, raw cost_keys_text(kind));
            pass (raw cost_refuse(m));
        }
    }
    if (raw text_eq(kind, "recipe")) {
        u.recipe = raw cost_str(d, "recipe");
        bool:rk = false;
        if (raw text_eq(string_from_bytes(u.recipe.ptr, u.recipe.len), "fixed-array")) { rk = true; }
        if (raw text_eq(string_from_bytes(u.recipe.ptr, u.recipe.len), "statements"))  { rk = true; }
        if (raw text_eq(string_from_bytes(u.recipe.ptr, u.recipe.len), "literal"))     { rk = true; }
        if (!rk) { pass (raw cost_refuse("`recipe` must be one of fixed-array, statements, literal")); }
        u.n = raw cost_int(d, "n");
        u.scale = raw cost_int(d, "scale");
        u.bound = raw cost_int(d, "bound");
        if (u.n <= 0i64)     { pass (raw cost_refuse("`n` must be a positive integer")); }
        if (u.scale <= 0i64) { pass (raw cost_refuse("`scale` must be a positive integer")); }
        if (u.bound <= 0i64) { pass (raw cost_refuse("`bound` must be a positive integer")); }
    }
    if (raw text_eq(kind, "probe")) {
        u.program = raw cost_str(d, "program");
        u.against = raw cost_str(d, "against");
        if (u.program.len == 0i64) { pass (raw cost_refuse("`program` must be a repo-relative program path")); }
        if (u.against.len == 0i64) { pass (raw cost_refuse("`against` must be a repo-relative program path")); }
        u.bound = raw cost_int(d, "bound");
        if (u.bound <= 0i64) { pass (raw cost_refuse("`bound` must be a positive integer")); }
    }
    if (raw text_eq(kind, "self")) {
        u.entry = raw cost_str(d, "entry");
        if (u.entry.len == 0i64) { pass (raw cost_refuse("`entry` must be a repo-relative source path")); }
        if (!(raw toml_has(d, "", 0i64 - 1i64, "ceiling"))) { pass (raw cost_refuse("a self unit needs `ceiling`")); }
        u.ceiling = raw cost_int(d, "ceiling");
        if (u.ceiling < 0i64) { pass (raw cost_refuse("`ceiling` must be a non-negative integer (bytes of peak_live; 0 reports only)")); }
    }
    u.expect = raw cost_str(d, "expect");
    bool:ep = raw text_eq(string_from_bytes(u.expect.ptr, u.expect.len), "pass");
    bool:ef = raw text_eq(string_from_bytes(u.expect.ptr, u.expect.len), "fail");
    if (!(ep || ef)) { pass (raw cost_refuse("`expect` must be \"pass\" or \"fail\"")); }
    if (raw text_eq(kind, "self")) {
        if (!ep) { pass (raw cost_refuse("a self unit reports and holds a ceiling; a designed violation is not a thing it has")); }
    }
    bool:has_until = raw toml_has(d, "", 0i64 - 1i64, "until");
    if (has_until) { u.until = raw cost_str(d, "until"); }
    if (ef && (u.until.len == 0i64)) { pass (raw cost_refuse("an expected failure names, in `until`, the commit that removes it")); }
    if (ep && has_until) { pass (raw cost_refuse("`until` belongs to an expected failure")); }
    pass CostRead{ ok: true, problem: "", u: move(u) };
};

// The wrapper every recipe carries: a `failsafe` naming every reachable
// identity (REACH-002 otherwise) and still carrying `(*)` (PICK-003).
func:cost_failsafe = string() never fails {
    pass "func:failsafe = int32(Error:e) {\n    pick (e) {\n        (HeapBadRequest) { exit 91i32; },\n        (HeapOom)        { exit 92i32; },\n        (IntOverflow)    { exit 93i32; },\n        (OutOfBounds)    { exit 94i32; },\n        (Unreachable)    { exit 95i32; },\n        (WildLeak)       { exit 96i32; },\n        (*)              { exit 99i32; }\n    }\n    exit 9i32;\n};\n";
};

// DEF-1's three shapes, byte for byte the harness's `cost_recipe_text` (and
// the workbench's recipes, nitpick-time commit 8066e62), written into a Sink
// -- the linear idiom, since a recipe at 4N is a quarter of a megabyte and
// this runner is compiled by the compiler whose temporaries do not yet drop.
func:cost_recipe = Sink(string:recipe, int64:n, string:modname) never fails {
    Sink:out = raw sink_to_buffer(65536i64);
    drop sink_write(@out, "mod:");
    drop sink_write(@out, modname);
    drop sink_write(@out, ";\n");
    if (raw text_eq(recipe, "fixed-array")) {
        drop sink_write(@out, "struct:R = { int64:a; int32:b; };\nfixed R[");
        drop sink_write(@out, int_to_string(n));
        drop sink_write(@out, "]:T = [\n");
        for (int64:i in 0i64...n) {
            if (i > 0i64) { drop sink_write(@out, ",\n"); }
            drop sink_write(@out, "    R{ a: ");
            drop sink_write(@out, int_to_string((0i64 - 2208988800i64) + (i * 604800i64) + ((i % 97i64) * 3600i64)));
            drop sink_write(@out, "i64, b: ");
            drop sink_write(@out, int_to_string(i % 13i64));
            drop sink_write(@out, "i32 }");
        }
        drop sink_write(@out, "\n];\nfunc:main = int32(cstring[]:_~argv) {\n    exit 0i32;\n};\n");
    }
    if (raw text_eq(recipe, "statements")) {
        drop sink_write(@out, "func:main = int32(cstring[]:_~argv) {\n    int64:acc = 0i64;\n");
        for (int64:j in 0i64...n) {
            if (j > 0i64) { drop sink_write(@out, "\n"); }
            drop sink_write(@out, "    acc = acc + ");
            drop sink_write(@out, int_to_string(j % 7i64));
            drop sink_write(@out, "i64;");
        }
        drop sink_write(@out, "\n    if (acc < 0i64) { exit 1i32; }\n    exit 0i32;\n};\n");
    }
    if (raw text_eq(recipe, "literal")) {
        int64:pairs = n / 2i64;
        drop sink_write(@out, "fixed string:BLOB = \"");
        for (int64:k in 0i64...pairs) { drop sink_write(@out, "ab"); }
        drop sink_write(@out, "\";\nfunc:main = int32(cstring[]:_~argv) {\n    if (BLOB.len != ");
        drop sink_write(@out, int_to_string(pairs * 2i64));
        drop sink_write(@out, "i64) { exit 1i32; }\n    exit 0i32;\n};\n");
    }
    drop sink_write(@out, raw cost_failsafe());
    pass out;
};

// `heap: allocated=<n> peak_live=<n> count=<n>`, the LAST such line on stderr.
func:cost_field = int64(string:part, string:prefix) never fails {
    if (!(raw text_starts_with(part, prefix))) { pass (0i64 - 1i64); }
    Result<int64>:v = text_int(raw text_slice(part, prefix.len, part.len));
    if (v.is_error) { pass (0i64 - 1i64); }
    pass v.value;
};

func:heap_stats_of = HeapStats(string:err) never fails {
    HeapStats:hs = HeapStats{ ok: false, allocated: 0i64, peak: 0i64, count: 0i64 };
    List<string>:lines = raw text_lines(err);
    for (int64:i in 0i64...lines.count) {
        string:ln = raw text_trim(raw strlist_view(lines, i));
        if (!(raw text_starts_with(ln, "heap: "))) { continue; }
        List<string>:parts = raw text_split_ws(ln);
        if (parts.count != 4i64) { continue; }
        int64:a = raw cost_field(raw strlist_view(parts, 1i64), "allocated=");
        int64:p = raw cost_field(raw strlist_view(parts, 2i64), "peak_live=");
        int64:k = raw cost_field(raw strlist_view(parts, 3i64), "count=");
        if ((a < 0i64) || (p < 0i64) || (k < 0i64)) { continue; }
        hs.ok = true;
        hs.allocated = a;
        hs.peak = p;
        hs.count = k;
    }
    pass hs;
};

// This process's environment plus NPK_HEAP_STATS, in the block a spawn takes.
func:cost_env = ProcArgs() {
    ProcArgs:e = relay env_capture();
    Result<NIL>:r = args_push(@e, "NPK_HEAP_STATS=1");
    if (r.is_error) { drop args_free(@e); fail r.err; }
    pass e;
};

func:cost_point_bad = CostPoint(string:name, string:what, string:why) never fails {
    string:m = string_concat(name, ": ");
    m = string_concat(m, what);
    m = string_concat(m, ": ");
    m = string_concat(m, why);
    pass CostPoint{ ok: false, problem: move(m), allocated: 0i64, peak: 0i64, count: 0i64, ns: 0i64 };
};

// One measured point: exit 0 and a `heap:` line, or the reason it is not one.
async func:cost_point = CostPoint(Ctx->:c, string:exe, List<string>:args, ProcArgs:env,
                                  string:name, string:what, int64:secs) {
    int64:t0 = mono_now();
    Result<Run>:r = await run_argv(exe, args, env, raw duration_secs(secs));
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    int64:ns = (mono_now()) - t0;
    if (run.timed_out) {
        string:w = string_concat("did not terminate in ", int_to_string(secs));
        w = string_concat(w, " s");
        pass (raw cost_point_bad(name, what, w));
    }
    int64:rc = run.x.status;
    if (!run.x.exited) { rc = 0i64 - run.x.signal; }
    if (rc == 3i64) {
        string:t = string_concat("TRAPPED (exit 3) -- a defect, not a measurement: ", raw text_head(raw text_replace_all(raw text_trim(run.x.err), "\n", ", "), 200i64));
        pass (raw cost_point_bad(name, what, t));
    }
    if (rc != 0i64) {
        string:x = string_concat("exited ", int_to_string(rc));
        x = string_concat(x, " (");
        x = string_concat(x, raw text_head(raw first_line_with(run.x.err, "", 160i64), 160i64));
        x = string_concat(x, ") -- a fast failure looks like a fast compile, so a point is only a point at exit 0");
        pass (raw cost_point_bad(name, what, x));
    }
    HeapStats:hs = raw heap_stats_of(run.x.err);
    if (!hs.ok) {
        pass (raw cost_point_bad(name, what, "exit 0 but no `heap:` line on stderr -- the floor this binary was linked against carries no NPK_HEAP_STATS instrument"));
    }
    pass CostPoint{ ok: true, problem: "", allocated: hs.allocated, peak: hs.peak, count: hs.count, ns: ns };
};

// `x14.32` -- two places, truncated (the harness rounds; the verdict is the
// integer comparison, never this text).
func:cost_ratio_text = string(int64:num, int64:den) never fails {
    if (den == 0i64) { pass "x(inf)"; }
    int64:r100 = (num * 100i64) / den;
    string:s = string_concat("x", int_to_string(r100 / 100i64));
    s = string_concat(s, ".");
    int64:frac = r100 % 100i64;
    if (frac < 10i64) { s = string_concat(s, "0"); }
    pass (string_concat(s, int_to_string(frac)));
};

func:cost_stats_text = string(CostPoint:p) never fails {
    string:s = string_concat("allocated=", int_to_string(p.allocated));
    s = string_concat(s, " peak_live=");
    s = string_concat(s, int_to_string(p.peak));
    s = string_concat(s, " count=");
    s = string_concat(s, int_to_string(p.count));
    s = string_concat(s, " (");
    int64:cs = p.ns / 10000000i64;
    s = string_concat(s, int_to_string(cs / 100i64));
    s = string_concat(s, ".");
    int64:cf = cs % 100i64;
    if (cf < 10i64) { s = string_concat(s, "0"); }
    s = string_concat(s, int_to_string(cf));
    pass (string_concat(s, "s)"));
};

func:cost_expect_text = string(CostUnit->:u) never fails {
    string:s = string_concat(" (bound x", int_to_string(u.bound));
    s = string_concat(s, ", expect ");
    s = string_concat(s, string_from_bytes(u.expect.ptr, u.expect.len));
    if (u.until.len > 0i64) {
        s = string_concat(s, " until ");
        s = string_concat(s, string_from_bytes(u.until.ptr, u.until.len));
    }
    pass (string_concat(s, ")"));
};

// The verdict against the unit's expectation.
func:cost_judge = List<string>(CostUnit->:u, bool:held, string:name, string:what) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    if (raw text_eq(string_from_bytes(u.expect.ptr, u.expect.len), "pass")) {
        if (held) { pass fl; }
        string:m = string_concat(name, ": the bound (x");
        m = string_concat(m, int_to_string(u.bound));
        m = string_concat(m, ") is VIOLATED: ");
        m = string_concat(m, what);
        drop list_push(@fl, move(m));
        pass fl;
    }
    if (held) {
        string:m2 = string_concat(name, ": expected the bound (x");
        m2 = string_concat(m2, int_to_string(u.bound));
        m2 = string_concat(m2, ") to be violated until ");
        m2 = string_concat(m2, string_from_bytes(u.until.ptr, u.until.len));
        m2 = string_concat(m2, ", and it HELD (");
        m2 = string_concat(m2, what);
        m2 = string_concat(m2, ") -- the fix has landed, or the instrument stopped biting: remove `expect = \"fail\"` in the commit that made it pass");
        drop list_push(@fl, move(m2));
    }
    pass fl;
};

func:cost_out_bad = CostOut(CostPoint:p, string:report) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    drop strlist_push(@fl, string_from_bytes(p.problem.ptr, p.problem.len));
    pass CostOut{ faults: fl, report: raw text_copy(report) };
};

async func:cost_recipe_point = CostPoint(Ctx->:c, string:recipe, int64:n, string:cdir,
                                         string:name, ProcArgs:env) {
    string:modname = string_concat("cost_", raw text_replace_byte(recipe, 45u8, 95u8));
    modname = string_concat(modname, "_");
    modname = string_concat(modname, int_to_string(n));
    string:path = raw path_join(cdir, string_concat(modname, ".npk"));
    Result<cstring>:pc = to_cstring(path);
    if (pc.is_error) { fail pc.err; }
    Sink:src = raw cost_recipe(recipe, n, modname);
    Result<NIL>:w = write_file(pc.value, raw sink_view(@src));
    if (w.is_error) { fail w.err; }
    List<string>:args = raw list_init::<string>(1i64);
    drop strlist_push(@args, path);
    string:what = string_concat(recipe, " at N=");
    what = string_concat(what, int_to_string(n));
    pass (relay await cost_point(c, string_from_bytes(c.npkc.ptr, c.npkc.len), args, env, name, what, 1800i64));
};

async func:run_cost_recipe = CostOut(Ctx->:c, CostUnit->:u, string:name, ProcArgs:env) {
    string:cdir = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len), "cost");
    Result<NIL>:d = ensure_dir(cdir);
    if (d.is_error) { fail d.err; }
    string:recipe = string_from_bytes(u.recipe.ptr, u.recipe.len);
    int64:n1 = u.n;
    int64:n2 = u.n * u.scale;
    CostPoint:p1 = relay await cost_recipe_point(c, recipe, n1, cdir, name, env);
    if (!p1.ok) {
        string:r1 = string_concat(name, ": ");
        r1 = string_concat(r1, recipe);
        r1 = string_concat(r1, " at N=");
        r1 = string_concat(r1, int_to_string(n1));
        r1 = string_concat(r1, " did not measure");
        pass (raw cost_out_bad(p1, r1));
    }
    CostPoint:p2 = relay await cost_recipe_point(c, recipe, n2, cdir, name, env);
    if (!p2.ok) {
        string:r2 = string_concat(name, ": ");
        r2 = string_concat(r2, recipe);
        r2 = string_concat(r2, " at N=");
        r2 = string_concat(r2, int_to_string(n2));
        r2 = string_concat(r2, " did not measure");
        pass (raw cost_out_bad(p2, r2));
    }
    bool:held = (p2.allocated <= (u.bound * p1.allocated)) && (p2.peak <= (u.bound * p1.peak));
    string:what = string_concat("N=", int_to_string(n1));
    what = string_concat(what, " -> ");
    what = string_concat(what, int_to_string(n2));
    what = string_concat(what, ": allocated ");
    what = string_concat(what, raw cost_ratio_text(p2.allocated, p1.allocated));
    what = string_concat(what, ", peak_live ");
    what = string_concat(what, raw cost_ratio_text(p2.peak, p1.peak));
    string:report = string_concat(name, ": ");
    report = string_concat(report, recipe);
    report = string_concat(report, " N=");
    report = string_concat(report, int_to_string(n1));
    report = string_concat(report, " ");
    report = string_concat(report, raw cost_stats_text(p1));
    report = string_concat(report, "; N=");
    report = string_concat(report, int_to_string(n2));
    report = string_concat(report, " ");
    report = string_concat(report, raw cost_stats_text(p2));
    report = string_concat(report, "; ");
    report = string_concat(report, what);
    report = string_concat(report, raw cost_expect_text(u));
    pass CostOut{ faults: raw cost_judge(u, held, name, what), report: move(report) };
};

async func:cost_probe_point = CostPoint(Ctx->:c, string:rel, string:name, ProcArgs:env) {
    string:path = raw in_root(c, rel);
    Result<cstring>:pc = to_cstring(path);
    if (pc.is_error) { fail pc.err; }
    if (!(path_exists(pc.value))) {
        string:m = string_concat("`", rel);
        m = string_concat(m, "` does not exist");
        pass (raw cost_point_bad(name, rel, m));
    }
    string:base = raw path_join(string_from_bytes(c.tdir.ptr, c.tdir.len),
                                string_concat("cost_", raw text_replace_byte(raw text_file_name(rel), 46u8, 95u8)));
    string:pname = string_concat(name, " (");
    pname = string_concat(pname, rel);
    pname = string_concat(pname, ")");
    List<string>:fl = relay await emit_and_link(c, string_from_bytes(c.npkc.ptr, c.npkc.len), path, pname, base);
    if (fl.count > 0i64) {
        pass (raw cost_point_bad(name, rel, raw text_join(fl, " | ")));
    }
    List<string>:noargs = raw list_init::<string>(1i64);
    string:what = string_concat(rel, " (run)");
    pass (relay await cost_point(c, base, noargs, env, name, what, 600i64));
};

async func:run_cost_probe = CostOut(Ctx->:c, CostUnit->:u, string:name, ProcArgs:env) {
    string:r1 = string_from_bytes(u.program.ptr, u.program.len);
    string:r2 = string_from_bytes(u.against.ptr, u.against.len);
    CostPoint:p1 = relay await cost_probe_point(c, r1, name, env);
    if (!p1.ok) { pass (raw cost_out_bad(p1, string_concat(string_concat(name, ": "), string_concat(r1, " did not measure")))); }
    CostPoint:p2 = relay await cost_probe_point(c, r2, name, env);
    if (!p2.ok) { pass (raw cost_out_bad(p2, string_concat(string_concat(name, ": "), string_concat(r2, " did not measure")))); }
    bool:held = (p1.peak <= (u.bound * p2.peak));
    string:what = string_concat("peak_live(", r1);
    what = string_concat(what, ") is ");
    what = string_concat(what, raw cost_ratio_text(p1.peak, p2.peak));
    what = string_concat(what, " peak_live(");
    what = string_concat(what, r2);
    what = string_concat(what, ")");
    string:report = string_concat(name, ": ");
    report = string_concat(report, r1);
    report = string_concat(report, " ");
    report = string_concat(report, raw cost_stats_text(p1));
    report = string_concat(report, "; ");
    report = string_concat(report, r2);
    report = string_concat(report, " ");
    report = string_concat(report, raw cost_stats_text(p2));
    report = string_concat(report, "; ");
    report = string_concat(report, what);
    report = string_concat(report, raw cost_expect_text(u));
    pass CostOut{ faults: raw cost_judge(u, held, name, what), report: move(report) };
};

async func:run_cost_self = CostOut(Ctx->:c, CostUnit->:u, string:name, ProcArgs:env) {
    string:entry = string_from_bytes(u.entry.ptr, u.entry.len);
    List<string>:args = raw list_init::<string>(1i64);
    drop strlist_push(@args, raw in_root(c, entry));
    string:what = string_concat("the compiler over ", entry);
    CostPoint:p = relay await cost_point(c, string_from_bytes(c.npkc.ptr, c.npkc.len), args, env, name, what, 3600i64);
    if (!p.ok) { pass (raw cost_out_bad(p, string_concat(string_concat(name, ": "), string_concat(entry, " did not measure")))); }
    string:report = string_concat(name, ": ");
    report = string_concat(report, entry);
    report = string_concat(report, " ");
    report = string_concat(report, raw cost_stats_text(p));
    List<string>:fl = raw list_init::<string>(1i64);
    if (u.ceiling == 0i64) {
        report = string_concat(report, " (reported; no ceiling yet)");
        pass CostOut{ faults: fl, report: move(report) };
    }
    report = string_concat(report, " (ceiling ");
    report = string_concat(report, int_to_string(u.ceiling));
    report = string_concat(report, ")");
    if (p.peak > u.ceiling) {
        string:m = string_concat(name, ": the compiler over ");
        m = string_concat(m, entry);
        m = string_concat(m, " peaks at ");
        m = string_concat(m, int_to_string(p.peak));
        m = string_concat(m, " bytes live, over its ceiling of ");
        m = string_concat(m, int_to_string(u.ceiling));
        m = string_concat(m, " -- a memory regression in the compiler's own build");
        drop list_push(@fl, move(m));
    }
    pass CostOut{ faults: fl, report: move(report) };
};

// `cost`: the allocator's own numbers, per unit file, as verdicts; the numbers
// print here so the run's log carries the measurement.
async func:run_cost = NIL(Ctx->:c, int64:t) {
    string:tname = raw entry_name(c, t);
    List<string>:units = relay files_of(c, c.m.tests.items[t].paths, c.m.tests.items[t].recursive, ".toml");
    ProcArgs:env = relay cost_env();
    defer { drop args_free(@env); }
    int64:count = 0i64;
    int64:confirmed = 0i64;
    for (int64:i in 0i64...units.count) {
        string:p = raw strlist_view(units, i);
        string:name = raw rel_to_root(c, p);
        string:text = relay read_text(p);
        CostRead:cr = raw read_cost_unit(text);
        count = count + 1i64;
        if (!cr.ok) {
            List<string>:fl0 = raw list_init::<string>(1i64);
            drop strlist_push(@fl0, string_concat(string_concat(name, ": "), string_from_bytes(cr.problem.ptr, cr.problem.len)));
            drop record(c, tname, name, fl0);
            continue;
        }
        string:kind = string_from_bytes(cr.u.kind.ptr, cr.u.kind.len);
        CostOut:o = CostOut{ faults: raw list_init::<string>(1i64), report: "" };
        if (raw text_eq(kind, "recipe")) { o = relay await run_cost_recipe(c, @cr.u, name, env); }
        if (raw text_eq(kind, "probe"))  { o = relay await run_cost_probe(c, @cr.u, name, env); }
        if (raw text_eq(kind, "self"))   { o = relay await run_cost_self(c, @cr.u, name, env); }
        drop record(c, tname, name, o.faults);
        drop say(raw stage_text(tname, string_from_bytes(o.report.ptr, o.report.len)));
        if (raw text_eq(string_from_bytes(cr.u.expect.ptr, cr.u.expect.len), "fail")) {
            if (o.faults.count == 0i64) { confirmed = confirmed + 1i64; }
        }
    }
    string:tail = string_concat("cost unit(s) under NPK_HEAP_STATS -- the allocator's own numbers, never the clock; ", int_to_string(confirmed));
    tail = string_concat(tail, " designed failure(s) confirmed (the instrument bites)");
    drop say(raw stage_line(tname, count, tail));
    pass NIL;
};

pub async func:run_targets = NIL(Ctx->:c, List<string>:only) {
    bool:filtering = (only.count > 0i64);
    for (int64:t in 0i64...c.m.tests.count) {
        string:stage = string_from_bytes(c.m.tests.items[t].stage.ptr, c.m.tests.items[t].stage.len);
        if (raw text_eq(stage, "compile")) {
            Result<NIL>:r0 = await run_compile(c, t, only);
            if (r0.is_error) { fail r0.err; }
            continue;
        }
        if (filtering) { continue; }
        if (raw text_eq(stage, "parse")) {
            Result<NIL>:r1 = await run_parse(c, t);
            if (r1.is_error) { fail r1.err; }
            continue;
        }
        if (raw text_eq(stage, "resolve")) {
            Result<NIL>:r2 = await run_rejection(c, t, "resolve_check");
            if (r2.is_error) { fail r2.err; }
            continue;
        }
        if (raw text_eq(stage, "check")) {
            Result<NIL>:r3 = await run_rejection(c, t, "check");
            if (r3.is_error) { fail r3.err; }
            continue;
        }
        if (raw text_eq(stage, "accept")) {
            Result<NIL>:r4 = await run_accept_stage(c, t);
            if (r4.is_error) { fail r4.err; }
            continue;
        }
        if (raw text_eq(stage, "object")) {
            Result<NIL>:r4b = await run_object(c, t);
            if (r4b.is_error) { fail r4b.err; }
            continue;
        }
        if (raw text_eq(stage, "fixture")) {
            Result<NIL>:r5 = await run_fixture(c, t);
            if (r5.is_error) { fail r5.err; }
            continue;
        }
        if (raw text_eq(stage, "program")) {
            Result<NIL>:r6 = await run_program(c, t);
            if (r6.is_error) { fail r6.err; }
            continue;
        }
        if (raw text_eq(stage, "runtime")) {
            Result<NIL>:r7 = await run_runtime_stage(c, t);
            if (r7.is_error) { fail r7.err; }
            continue;
        }
        if (raw text_eq(stage, "verify")) {
            Result<NIL>:r8 = await run_verify(c, t);
            if (r8.is_error) { fail r8.err; }
            continue;
        }
        if (raw text_eq(stage, "cost")) {
            Result<NIL>:r9 = await run_cost(c, t);
            if (r9.is_error) { fail r9.err; }
            continue;
        }
    }
    pass NIL;
};
