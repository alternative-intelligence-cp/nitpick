// manifest -- `nitpick.toml` as `npkg` reads it (1.4.8; D-077 for the schema,
// D-204 for `[toolchain]`, BUILD_REFERENCE §7.1 and D-238 for `[[test]]`).
//
// READ ONCE, STRICTLY. One schema, every key named: a key the schema does not
// have refuses the manifest by line, because a setting nobody reads is the
// next stale document -- and `edition` refuses by name, since one language
// with no editions is D-077's own decision. The toolchain block is an INPUT:
// the pin and the four flag lists are what every `llc`/`opt`/`ld.lld`
// invocation is built from, and a missing list is a build the manifest did
// not describe.

mod:manifest;

use "../src/frontend/list.npk".*;
use "./text.npk".*;
use "./toml.npk".*;

// One `[[test]]` entry (BUILD_REFERENCE §7.1, D-238): EVERY suite `npkg test`
// runs is one of these, in declaration order, and the harness reads the same
// table. `stage` names the tool that judges the suite and what it must say;
// `compile` is the default and the only stage with a `kind`.
pub struct:TestTarget = {
    string:name;
    string:stage;            // compile | parse | resolve | check | accept | object | fixture | program | runtime | verify | cost
    string:kind;             // compile only: positive | negative | diagnostic; "" otherwise
    List<string>:paths;      // relative to the root, in declaration order
    bool:recursive;          // sweep subdirectories too
};

func:stage_known = bool(string:s) never fails {
    if (raw text_eq(s, "compile")) { pass true; }
    if (raw text_eq(s, "parse"))   { pass true; }
    if (raw text_eq(s, "resolve")) { pass true; }
    if (raw text_eq(s, "check"))   { pass true; }
    if (raw text_eq(s, "accept"))  { pass true; }
    if (raw text_eq(s, "object"))  { pass true; }
    if (raw text_eq(s, "fixture")) { pass true; }
    if (raw text_eq(s, "program")) { pass true; }
    if (raw text_eq(s, "runtime")) { pass true; }
    if (raw text_eq(s, "verify"))  { pass true; }
    if (raw text_eq(s, "cost"))    { pass true; }
    pass false;
};

pub struct:Manifest = {
    string:root;             // the directory holding nitpick.toml, absolute
    string:entry;            // [build] entry, relative to the root
    string:output;           // [build] output, relative to the root
    int64:opt_level;         // [build] opt-level: 0 (no `opt`) or 2 (the pinned -O2 lists)
    string:llvm;             // [toolchain] llvm, the exact patch release
    List<string>:llc_flags;
    List<string>:llc_opt_flags;
    List<string>:opt_flags;
    List<string>:lld_flags;
    List<TestTarget>:tests;  // [[test]] in declaration order
    bool:z3;                 // [verify] z3: this project declares z3 verification (D-068)
    string:z3_version;       // [verify] z3-version: what `z3 -version` must report (D-218.1)
    string:z3_sha256;        // [verify] z3-sha256: the binary's sha256, 64 lowercase hex
    List<string>:z3_options; // [verify] z3-options: the determinism profile, passed verbatim (D-218.2)
    bool:ok;
    string:problem;          // when !ok, the one sentence to print
};

func:blank = Manifest(string:root) never fails {
    pass Manifest{ root: raw text_copy(root), entry: "", output: "", opt_level: 0i64, llvm: "",
                   llc_flags: raw list_init::<string>(4i64),
                   llc_opt_flags: raw list_init::<string>(4i64),
                   opt_flags: raw list_init::<string>(4i64),
                   lld_flags: raw list_init::<string>(4i64),
                   tests: raw list_init::<TestTarget>(4i64),
                   z3: false, z3_version: "", z3_sha256: "",
                   z3_options: raw list_init::<string>(4i64),
                   ok: true, problem: "" };
};

func:refuse = Manifest(string:root, string:why) never fails {
    Manifest:m = raw blank(root);
    m.ok = false;
    m.problem = raw text_copy(why);
    pass m;
};

// Every (table, key) this manifest schema has. `[dependencies]` takes any
// key -- each names a dependency -- and nothing else is open.
func:schema_allows = bool(string:section, string:key) never fails {
    if (raw text_eq(section, "project")) {
        if (raw text_eq(key, "name"))        { pass true; }
        if (raw text_eq(key, "version"))     { pass true; }
        if (raw text_eq(key, "description")) { pass true; }
        if (raw text_eq(key, "authors"))     { pass true; }
        if (raw text_eq(key, "target"))      { pass true; }
        pass false;
    }
    if (raw text_eq(section, "build")) {
        if (raw text_eq(key, "entry"))     { pass true; }
        if (raw text_eq(key, "output"))    { pass true; }
        if (raw text_eq(key, "opt-level")) { pass true; }
        pass false;
    }
    if (raw text_eq(section, "toolchain")) {
        if (raw text_eq(key, "llvm"))          { pass true; }
        if (raw text_eq(key, "llc-flags"))     { pass true; }
        if (raw text_eq(key, "llc-opt-flags")) { pass true; }
        if (raw text_eq(key, "opt-flags"))     { pass true; }
        if (raw text_eq(key, "lld-flags"))     { pass true; }
        pass false;
    }
    if (raw text_eq(section, "dependencies")) { pass true; }
    if (raw text_eq(section, "test")) {
        if (raw text_eq(key, "name"))      { pass true; }
        if (raw text_eq(key, "stage"))     { pass true; }
        if (raw text_eq(key, "kind"))      { pass true; }
        if (raw text_eq(key, "path"))      { pass true; }
        if (raw text_eq(key, "paths"))     { pass true; }
        if (raw text_eq(key, "recursive")) { pass true; }
        pass false;
    }
    if (raw text_eq(section, "verify")) {
        if (raw text_eq(key, "z3"))         { pass true; }
        if (raw text_eq(key, "z3-version")) { pass true; }
        if (raw text_eq(key, "z3-sha256"))  { pass true; }
        if (raw text_eq(key, "z3-options")) { pass true; }
        pass false;
    }
    if (raw text_eq(section, "verify.nikos")) {
        if (raw text_eq(key, "domain")) { pass true; }
        pass false;
    }
    pass false;
};

func:need_string = string(TomlDoc:d, string:section, string:key) {
    pass (relay toml_string(d, section, 0i64 - 1i64, key));
};

func:need_strings = List<string>(TomlDoc:d, string:section, string:key) {
    pass (relay toml_strings(d, section, 0i64 - 1i64, key));
};

pub func:manifest_load = Manifest(string:root, string:text) never fails {
    TomlDoc:d = raw toml_parse(text);
    if (!d.ok) {
        string:w = string_concat("nitpick.toml: line ", int_to_string(d.bad_line));
        w = string_concat(w, " cannot be read -- the reader takes TOML's tables, `[[array]]` headers, strings, integers, booleans and single-line arrays, and nothing else");
        pass (raw refuse(root, w));
    }
    for (int64:i in 0i64...d.entries.count) {
        string:sec = string_from_bytes(d.entries.items[i].section.ptr, d.entries.items[i].section.len);
        string:key = string_from_bytes(d.entries.items[i].key.ptr, d.entries.items[i].key.len);
        if (raw text_eq(key, "edition")) {
            string:w1 = string_concat("nitpick.toml: line ", int_to_string(d.entries.items[i].line));
            w1 = string_concat(w1, ": there is no `edition` key -- one language, no editions (D-077)");
            pass (raw refuse(root, w1));
        }
        if (!(raw schema_allows(sec, key))) {
            string:w2 = string_concat("nitpick.toml: line ", int_to_string(d.entries.items[i].line));
            w2 = string_concat(w2, ": `");
            if (sec.len > 0i64) { w2 = string_concat(w2, sec); w2 = string_concat(w2, "."); }
            w2 = string_concat(w2, key);
            w2 = string_concat(w2, "` is not a key this manifest schema has (D-077); a setting nothing reads is a document that goes stale in silence");
            pass (raw refuse(root, w2));
        }
    }

    Manifest:m = raw blank(root);
    Result<string>:entry = need_string(d, "build", "entry");
    if (entry.is_error) { pass (raw refuse(root, "nitpick.toml: [build] entry is missing or is not a string")); }
    m.entry = move(entry.value);
    Result<string>:output = need_string(d, "build", "output");
    if (output.is_error) { pass (raw refuse(root, "nitpick.toml: [build] output is missing or is not a string")); }
    m.output = move(output.value);
    if (raw toml_has(d, "build", 0i64 - 1i64, "opt-level")) {
        Result<int64>:lvl = toml_int(d, "build", 0i64 - 1i64, "opt-level");
        if (lvl.is_error) { pass (raw refuse(root, "nitpick.toml: [build] opt-level is not an integer")); }
        m.opt_level = lvl.value;
    }
    if ((m.opt_level != 0i64) && (m.opt_level != 2i64)) {
        pass (raw refuse(root, "nitpick.toml: [build] opt-level must be 0 (no `opt`, `llc-flags`) or 2 (`opt-flags` then `llc-opt-flags`) -- those are the two flag sets [toolchain] pins, and a level with no pinned flags is a build nobody can reproduce (D-204)"));
    }

    Result<string>:llvm = need_string(d, "toolchain", "llvm");
    if (llvm.is_error) { pass (raw refuse(root, "nitpick.toml has no [toolchain] llvm pin -- D-204 makes the toolchain a build INPUT, and an unpinned input is not one")); }
    m.llvm = move(llvm.value);
    Result<List<string>>:f1 = need_strings(d, "toolchain", "llc-flags");
    if (f1.is_error) { pass (raw refuse(root, "nitpick.toml: [toolchain] llc-flags is missing or is not an array of strings")); }
    m.llc_flags = f1.value;
    Result<List<string>>:f2 = need_strings(d, "toolchain", "llc-opt-flags");
    if (f2.is_error) { pass (raw refuse(root, "nitpick.toml: [toolchain] llc-opt-flags is missing or is not an array of strings")); }
    m.llc_opt_flags = f2.value;
    Result<List<string>>:f3 = need_strings(d, "toolchain", "opt-flags");
    if (f3.is_error) { pass (raw refuse(root, "nitpick.toml: [toolchain] opt-flags is missing or is not an array of strings")); }
    m.opt_flags = f3.value;
    Result<List<string>>:f4 = need_strings(d, "toolchain", "lld-flags");
    if (f4.is_error) { pass (raw refuse(root, "nitpick.toml: [toolchain] lld-flags is missing or is not an array of strings")); }
    m.lld_flags = f4.value;

    // THE SOLVER PIN (D-218.1/D-218.2, 1.5.0). `z3 = true` declares the
    // project verified; then the version, the sha256 and the options list are
    // all REQUIRED -- a pin without a hash is not a pin, and an unpinned budget
    // is a verdict that depends on the machine. The profile's refusals (no
    // wall-clock knob, no parallelism) are the pin check's, at the tool.
    if (raw toml_has(d, "verify", 0i64 - 1i64, "z3")) {
        Result<bool>:zb = toml_bool(d, "verify", 0i64 - 1i64, "z3");
        if (zb.is_error) { pass (raw refuse(root, "nitpick.toml: [verify] z3 must be true or false")); }
        m.z3 = zb.value;
    }
    if (m.z3) {
        Result<string>:zv = need_string(d, "verify", "z3-version");
        if (zv.is_error) { pass (raw refuse(root, "nitpick.toml: [verify] z3 is true but z3-version is missing -- the solver is a build INPUT (D-218.1), and an unpinned input is not one")); }
        m.z3_version = move(zv.value);
        Result<string>:zs = need_string(d, "verify", "z3-sha256");
        if (zs.is_error) { pass (raw refuse(root, "nitpick.toml: [verify] z3 is true but z3-sha256 is missing -- a version string cannot tell two builds apart; the pin is the binary's hash (D-218.1)")); }
        m.z3_sha256 = move(zs.value);
        if (m.z3_sha256.len != 64i64) { pass (raw refuse(root, "nitpick.toml: [verify] z3-sha256 must be 64 hex characters")); }
        Result<List<string>>:zo = need_strings(d, "verify", "z3-options");
        if (zo.is_error) { pass (raw refuse(root, "nitpick.toml: [verify] z3 is true but z3-options is missing or is not an array of strings -- the determinism profile is READ from here, never assumed (D-218.2)")); }
        m.z3_options = zo.value;
    }

    // THE TEST TABLE (D-238). An entry the runner cannot honour is refused BY
    // NAME before anything runs, never skipped: a stage this runner does not
    // know, a `kind` on a stage that has none, a compile entry with no kind,
    // no `paths`/`path` (or both), a `recursive` that is not a boolean. (A key
    // outside the schema was refused by line above.)
    int64:n = raw toml_array_count(d, "test");
    for (int64:t in 0i64...n) {
        Result<string>:name = toml_string(d, "test", t, "name");
        if (name.is_error) { pass (raw refuse(root, "nitpick.toml: every [[test]] needs `name`, a string (BUILD_REFERENCE §7.1)")); }
        string:who = string_concat("nitpick.toml: [[test]] `", name.value);
        who = string_concat(who, "`");
        string:stage = "compile";
        if (raw toml_has(d, "test", t, "stage")) {
            Result<string>:st = toml_string(d, "test", t, "stage");
            if (st.is_error) { pass (raw refuse(root, string_concat(who, ": `stage` must be a string"))); }
            stage = move(st.value);
        }
        if (!(raw stage_known(stage))) {
            string:w5 = string_concat(who, ": stage `");
            w5 = string_concat(w5, stage);
            w5 = string_concat(w5, "` is not one this runner knows -- the stages are compile, parse, resolve, check, accept, fixture, program, runtime, verify, cost (D-238); a stage the runner cannot judge is refused, not skipped");
            pass (raw refuse(root, w5));
        }
        string:kind = "";
        bool:has_kind = raw toml_has(d, "test", t, "kind");
        if (raw text_eq(stage, "compile")) {
            if (!has_kind) { pass (raw refuse(root, string_concat(who, ": a compile-stage target needs `kind` positive, negative or diagnostic"))); }
            Result<string>:kd = toml_string(d, "test", t, "kind");
            if (kd.is_error) { pass (raw refuse(root, string_concat(who, ": `kind` must be a string"))); }
            kind = move(kd.value);
            bool:known = false;
            if (raw text_eq(kind, "positive"))   { known = true; }
            if (raw text_eq(kind, "negative"))   { known = true; }
            if (raw text_eq(kind, "diagnostic")) { known = true; }
            if (!known) {
                string:w3 = string_concat(who, " has kind `");
                w3 = string_concat(w3, kind);
                w3 = string_concat(w3, "`; the kinds are positive, negative and diagnostic (BUILD_REFERENCE §7.1)");
                pass (raw refuse(root, w3));
            }
        } else {
            if (has_kind) {
                string:w4 = string_concat(who, ": `kind` belongs to the compile stage only; stage `");
                w4 = string_concat(w4, stage);
                w4 = string_concat(w4, "` judges every file one way");
                pass (raw refuse(root, w4));
            }
        }
        bool:has_paths = raw toml_has(d, "test", t, "paths");
        bool:has_path = raw toml_has(d, "test", t, "path");
        if (has_paths && has_path) { pass (raw refuse(root, string_concat(who, ": `paths` or `path`, not both"))); }
        List<string>:paths = raw list_init::<string>(2i64);
        if (has_paths) {
            Result<List<string>>:ps = toml_strings(d, "test", t, "paths");
            if (ps.is_error) { pass (raw refuse(root, string_concat(who, ": `paths` must be an array of strings"))); }
            paths = ps.value;
            if (paths.count == 0i64) { pass (raw refuse(root, string_concat(who, ": `paths` must name at least one directory"))); }
        } else {
            if (!has_path) { pass (raw refuse(root, string_concat(who, " needs `paths` (or its one-element shorthand `path`)"))); }
            Result<string>:p1 = toml_string(d, "test", t, "path");
            if (p1.is_error) { pass (raw refuse(root, string_concat(who, ": `path` must be a string"))); }
            drop list_push(@paths, move(p1.value));
        }
        bool:recursive = false;
        if (raw toml_has(d, "test", t, "recursive")) {
            Result<bool>:rc = toml_bool(d, "test", t, "recursive");
            if (rc.is_error) { pass (raw refuse(root, string_concat(who, ": `recursive` must be true or false"))); }
            recursive = rc.value;
        }
        TestTarget:tt = TestTarget{ name: move(name.value), stage: move(stage), kind: move(kind),
                                    paths: paths, recursive: recursive };
        drop list_push(@m.tests, move(tt));
    }
    pass m;
};
