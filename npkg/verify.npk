// verify -- `npkg verify` and the z3 leg both `npkg verify` and the `verify`
// test stage share (1.5.0; D-218, D-219; the plan is meta/roadmap/1.5/1.5.0.md).
//
// THE RUNNER OWNS EVERY TOOL INVOCATION (D-067, D-206): the compiler emits
// obligations (`--obligations DIR`: one SMT-LIB2 file per function instance,
// index.txt, rows.txt) and reads a manifest (`--elide FILE`); this module
// spawns z3 -- one fresh process per file under the profile `[verify]` pins
// (D-218.2/D-218.3), through `lib/nproc.npk` like every other tool -- maps
// the answers to rows, renders `nitpick.obligations` (P-10, through
// `smt_manifest.npk`'s one renderer), and drives the second run.
//
// THE VERDICT PASS ASKS `(check-sat)` AND NOTHING ELSE (P-7): exactly N
// answer lines for N encoded rows, anything else fails the run by name. The
// wall-clock net is a hang net and never a verdict (P-13): a killed solver is
// a build failure, not a `budget` row.
//
// `npkg verify` (P-9, P-25): the ladder, the solver pin, the obligations of
// `[build] entry`, z3, the comparison with the COMMITTED `nitpick.obligations`
// -- absent or different is a failure by name; `--record` writes it, on
// purpose -- then the VERIFIED build (`--elide`), its cross-checks, and the
// verified fixpoint: the verified compiler must emit the compiler exactly as
// the unverified one's verified emission (D-202 over the verified build).
// `--explain` adds a second solver pass for the report: a model for every
// open row, the reason for every budget row, an unsat core for every
// discharged one -- never on the gate path.

mod:verify;

use "../src/frontend/paths.npk".*;
use "../src/frontend/diagnostics.npk".*;   // Sink (1.5.1b step 3)
use "../src/backend/smt/smt_kinds.npk".*;
use "../src/backend/smt/smt_manifest.npk".*;
use "../lib/nfs.npk".*;
use "../lib/nproc.npk".*;
use "./text.npk".*;
use "./manifest.npk".*;
use "./toolchain.npk".*;
use "./build.npk".*;
use "./irscan.npk".*;
use "./strset.npk".*;
use "./elf.npk".*;
use "./floor_shared.npk".*;
use "./floor_stack.npk".*;
use "./floor_explore.npk".*;
use "./explore.npk".*;                       // the explored floor's totality belt (1.5.7 step 0)
use "./floor_ir.npk".*;
use "./floor_spec.npk".*;
use "./floor.npk".*;
use "./floor_model.npk".*;

// One row of rows.txt, with its verdict once decided.
pub struct:VRow = {
    string:fno;
    int64:k;
    string:kind;
    string:hash;
    bool:encoded;
    string:symbol;
    int32:verdict;      // OV_* (0 until decided)
    bool:checker;       // a `c` row: the frontend decided it (1.5.4 step 4, L-20)
    // THE SITE, THE ROLE, THE GROUP, THE TRAPS (1.5.3 step 2, L-13): the
    // site's `space:index`; `guard`, `bypass`, `held` or `conform`; the rows
    // one guard shares; the traps that guard keeps while any of them is
    // retained -- what the belts below count by.
    string:site;
    string:role;
    int64:group;
    int64:traps;
    string:tier;        // THE TIER (D-281, 1.5.4b step 3): the encoder's word for the cone's theory
};

// --- reading the compiler's files --------------------------------------------------------

// `k1,k2,...` of `index.t2.txt` (D-281): the ordinals a twin file decides.
func:split_commas = List<string>(string:line) never fails {
    List<string>:out = raw list_init::<string>(4i64);
    int64:start = 0i64;
    for (int64:i in 0i64...line.len) {
        if (line.ptr[i] == 44u8) {
            drop strlist_push(@out, raw text_slice(line, start, i));
            start = i + 1i64;
        }
    }
    drop strlist_push(@out, raw text_slice(line, start, line.len));
    pass out;
};

func:split_tabs = List<string>(string:line) never fails {
    List<string>:out = raw list_init::<string>(6i64);
    int64:start = 0i64;
    for (int64:i in 0i64...line.len) {
        if (line.ptr[i] == 9u8) {
            drop strlist_push(@out, raw text_slice(line, start, i));
            start = i + 1i64;
        }
    }
    drop strlist_push(@out, raw text_slice(line, start, line.len));
    pass out;
};

pub func:read_rows = List<VRow>(string:dir) {
    List<VRow>:rows = raw list_init::<VRow>(32i64);
    Result<cstring>:rc = to_cstring(raw path_join(dir, "rows.txt"));
    if (rc.is_error) { fail rc.err; }
    Result<string>:text = read_file(rc.value);
    if (text.is_error) { fail text.err; }
    List<string>:lines = raw text_lines(text.value);
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (ln.len == 0i64) { continue; }
        List<string>:f = raw split_tabs(ln);
        if (f.count != 11i64) { continue; }
        Result<int64>:k = text_int(raw strlist_view(f, 1i64));
        if (k.is_error) { continue; }
        Result<int64>:grp = text_int(raw strlist_view(f, 8i64));
        if (grp.is_error) { continue; }
        Result<int64>:trp = text_int(raw strlist_view(f, 9i64));
        if (trp.is_error) { continue; }
        if ((raw role_of_name(raw strlist_view(f, 7i64))) < 0i32) { continue; }
        VRow:r = VRow{ fno: raw strlist_copy(f, 0i64), k: k.value,
                       kind: raw strlist_copy(f, 2i64), hash: raw strlist_copy(f, 3i64),
                       encoded: raw text_eq(raw strlist_view(f, 4i64), "1"),
                       symbol: raw strlist_copy(f, 5i64), verdict: 0i32,
                       checker: raw text_eq(raw strlist_view(f, 4i64), "c"),
                       site: raw strlist_copy(f, 6i64), role: raw strlist_copy(f, 7i64),
                       group: grp.value, traps: trp.value, tier: raw strlist_copy(f, 10i64) };
        drop list_push(@rows, move(r));
    }
    pass rows;
};

pub struct:VFile = { string:fno; string:symbol; int64:checks; };

pub func:read_index = List<VFile>(string:dir) {
    List<VFile>:files = raw list_init::<VFile>(16i64);
    Result<cstring>:ic = to_cstring(raw path_join(dir, "index.txt"));
    if (ic.is_error) { fail ic.err; }
    Result<string>:text = read_file(ic.value);
    if (text.is_error) { fail text.err; }
    List<string>:lines = raw text_lines(text.value);
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (ln.len == 0i64) { continue; }
        List<string>:f = raw split_tabs(ln);
        if (f.count != 3i64) { continue; }
        Result<int64>:n = text_int(raw strlist_view(f, 2i64));
        if (n.is_error) { continue; }
        VFile:v = VFile{ fno: raw strlist_copy(f, 0i64), symbol: raw strlist_copy(f, 1i64), checks: n.value };
        drop list_push(@files, move(v));
    }
    pass files;
};

// --- the solver ----------------------------------------------------------------------------

// THE SOLVER'S HANG NET (P-13; D-297, S-77): `120 + 10*checks + 60*B` seconds
// for a file of `checks` rows, B the rows of it the manifest the run is held
// to records as `budget`. A `budget` row burns the whole rlimit BY DEFINITION
// (about 33 s on this machine), so a net sized as if every row cost ten
// seconds left `npk_small_free` (six such rows) at 81% of its bound -- a red
// run that is no verdict on a machine a quarter slower. It stays a hang net:
// a solver killed at its net is a build failure by name, never a row, and no
// verdict can move with the bound. With no manifest to trust -- a `--record`
// run, a verify test, a planted self-check case -- every row takes the
// larger bound. The harness's `hang_net`, `budget_rows_of`, `file_budget`.
pub struct:HangNet = {
    bool:trusted;           // a committed manifest the run is held to
    List<string>:budget;    // its rows recorded `budget`, as `<hash> <kind> <symbol>` keys
};

pub func:hang_net_secs = int64(int64:checks, int64:budget) never fails {
    pass (120i64 + (10i64 * checks) + (60i64 * budget));
};

// A row's key, spelled from rows.txt's fields or a manifest row's.
pub func:net_key = string(string:hash, string:kind, string:symbol) never fails {
    string:k = string_concat(hash, " ");
    k = string_concat(k, kind);
    k = string_concat(k, " ");
    pass (string_concat(k, symbol));
};

// No manifest to trust: every row of every file takes the larger bound.
pub func:net_untrusted = HangNet() never fails {
    pass HangNet{ trusted: false, budget: raw list_init::<string>(1i64) };
};

// The rows a committed manifest records `budget`, keyed as rows.txt spells them.
pub func:net_of_manifest = HangNet(ObManifest->:m) never fails {
    HangNet:n = HangNet{ trusted: true, budget: raw list_init::<string>(8i64) };
    for (int64:i in 0i64...m.rows.count) {
        if (m.rows.items[i].verdict != (raw OV_BUDGET())) { continue; }
        drop strlist_push(@n.budget, raw net_key(
            string_from_bytes(m.rows.items[i].hash.ptr, m.rows.items[i].hash.len),
            raw ok_name(m.rows.items[i].kind),
            string_from_bytes(m.rows.items[i].symbol.ptr, m.rows.items[i].symbol.len)));
    }
    pass n;
};

// How many of a file's encoded rows -- `keys` -- the trusted manifest records
// `budget`; every one of them when there is no manifest to trust.
pub func:file_budget = int64(List<string>:keys, HangNet->:net) never fails {
    if (!net.trusted) { pass keys.count; }
    int64:b = 0i64;
    for (int64:i in 0i64...keys.count) {
        if (raw strlist_contains(net.budget, raw strlist_view(keys, i))) { b = b + 1i64; }
    }
    pass b;
};

// z3 over every file of `dir`; the rows' verdicts filled; the failures, by name.
// `net`: the hang net's knowledge of the manifest the run is held to (D-297).
pub async func:z3_decide = NIL(Ctx->:c, string:z3, string:dir, List<VRow>->:rows,
                               List<VFile>:files, string:name, List<string>->:fl, HangNet->:net) {
    for (int64:fi in 0i64...files.count) {
        string:fno = string_from_bytes(files.items[fi].fno.ptr, files.items[fi].fno.len);
        int64:checks = files.items[fi].checks;
        int64:enc = 0i64;
        List<string>:keys = raw list_init::<string>(checks + 1i64);
        for (int64:ri in 0i64...rows.count) {
            if (raw text_eq(string_from_bytes(rows.items[ri].fno.ptr, rows.items[ri].fno.len), fno)) {
                if (rows.items[ri].encoded) {
                    enc = enc + 1i64;
                    drop strlist_push(@keys, raw net_key(
                        string_from_bytes(rows.items[ri].hash.ptr, rows.items[ri].hash.len),
                        string_from_bytes(rows.items[ri].kind.ptr, rows.items[ri].kind.len),
                        string_from_bytes(rows.items[ri].symbol.ptr, rows.items[ri].symbol.len)));
                }
            }
        }
        if (enc != checks) {
            string:m0 = string_concat(name, ": index.txt says ");
            m0 = string_concat(m0, fno);
            m0 = string_concat(m0, " has ");
            m0 = string_concat(m0, int_to_string(checks));
            m0 = string_concat(m0, " checks, rows.txt lists ");
            m0 = string_concat(m0, int_to_string(enc));
            m0 = string_concat(m0, " encoded rows");
            drop list_push(fl, move(m0));
            pass NIL;
        }
        if (checks == 0i64) { continue; }
        List<string>:args = raw strlist_clone(c.m.z3_options);
        drop strlist_push(@args, "-smt2");
        drop strlist_push(@args, raw path_join(dir, string_concat(fno, ".smt2")));
        int64:secs = raw hang_net_secs(checks, raw file_budget(keys, net));
        Result<Run>:r = await run_argv(z3, args, c.t.env, raw duration_secs(secs));
        if (r.is_error) { fail r.err; }
        Run:run = move(r.value);
        if (run.timed_out) {
            string:m1 = string_concat(name, ": z3 exceeded the wall-clock net of ");
            m1 = string_concat(m1, int_to_string(secs));
            m1 = string_concat(m1, " s on ");
            m1 = string_concat(m1, fno);
            m1 = string_concat(m1, " -- not a verdict: a wedged solver is a build failure, never a `budget` row (P-13)");
            drop list_push(fl, move(m1));
            pass NIL;
        }
        List<string>:ans = raw text_lines(run.x.out);
        int64:got = 0i64;
        int64:next_row = 0i64;
        for (int64:ai in 0i64...ans.count) {
            string:a = raw text_trim(raw strlist_view(ans, ai));
            if (a.len == 0i64) { continue; }
            int32:v = 0i32;
            if (raw text_eq(a, "unsat"))   { v = raw OV_DISCHARGED(); }
            if (raw text_eq(a, "sat"))     { v = raw OV_OPEN(); }
            if (raw text_eq(a, "unknown")) { v = raw OV_BUDGET(); }
            if (v == 0i32) {
                string:m2 = string_concat(name, ": z3 said something other than a verdict on ");
                m2 = string_concat(m2, fno);
                m2 = string_concat(m2, ": ");
                m2 = string_concat(m2, raw text_head(a, 160i64));
                drop list_push(fl, move(m2));
                pass NIL;
            }
            got = got + 1i64;
            // the next encoded row of this file
            while (next_row < rows.count) {
                bool:mine = raw text_eq(string_from_bytes(rows.items[next_row].fno.ptr, rows.items[next_row].fno.len), fno);
                if (mine && rows.items[next_row].encoded) { break; }
                next_row = next_row + 1i64;
            }
            if (next_row < rows.count) { rows.items[next_row].verdict = v; next_row = next_row + 1i64; }
        }
        if (got != checks) {
            string:m3 = string_concat(name, ": z3 answered ");
            m3 = string_concat(m3, int_to_string(got));
            m3 = string_concat(m3, " times for the ");
            m3 = string_concat(m3, int_to_string(checks));
            m3 = string_concat(m3, " obligations of ");
            m3 = string_concat(m3, fno);
            drop list_push(fl, move(m3));
            pass NIL;
        }
    }
    // TIER 2 (D-281, 1.5.4b step 3): a `budget` row with a twin in
    // `NNNN.t2.smt2` is asked once more there; `unsat` discharges it, tier
    // `real`. The harness's pass, line for line.
    Result<cstring>:t2c = to_cstring(raw path_join(dir, "index.t2.txt"));
    if (t2c.is_error) { fail t2c.err; }
    if (path_exists(t2c.value)) {
        Result<string>:t2t = read_file(t2c.value);
        if (t2t.is_error) { fail t2t.err; }
        List<string>:t2l = raw text_lines(t2t.value);
        for (int64:li in 0i64...t2l.count) {
            string:ln = raw strlist_view(t2l, li);
            if (ln.len == 0i64) { continue; }
            List<string>:f = raw split_tabs(ln);
            if (f.count != 3i64) {
                drop list_push(fl, string_concat(name, ": an index.t2.txt line is not `NNNN count k1,k2,...`"));
                pass NIL;
            }
            string:fno2 = raw strlist_copy(f, 0i64);
            Result<int64>:cnt = text_int(raw strlist_view(f, 1i64));
            if (cnt.is_error) { drop list_push(fl, string_concat(name, ": index.t2.txt: a count is not a number")); pass NIL; }
            List<string>:kts = raw split_commas(raw strlist_view(f, 2i64));
            if (kts.count != cnt.value) {
                drop list_push(fl, string_concat(name, ": index.t2.txt lists a different number of ordinals than its count"));
                pass NIL;
            }
            // the rows named, by (file, k); any budget among them? -- and the
            // twin's net counts the twin's rows the manifest records `budget`
            // (a row the twin discharged is recorded `real` discharged and did
            // not burn its budget there)
            List<int64>:idx = raw list_init::<int64>(4i64);
            List<string>:keys2 = raw list_init::<string>(cnt.value + 1i64);
            bool:any_budget = false;
            for (int64:ki in 0i64...kts.count) {
                Result<int64>:kv = text_int(raw strlist_view(kts, ki));
                if (kv.is_error) { drop list_push(fl, string_concat(name, ": index.t2.txt: an ordinal is not a number")); pass NIL; }
                int64:found = 0i64 - 1i64;
                for (int64:ri in 0i64...rows.count) {
                    if ((rows.items[ri].k == kv.value) && (raw text_eq(string_from_bytes(rows.items[ri].fno.ptr, rows.items[ri].fno.len), fno2))) { found = ri; }
                }
                drop list_push(@idx, found);
                if (found >= 0i64) {
                    if (rows.items[found].verdict == (raw OV_BUDGET())) { any_budget = true; }
                    drop strlist_push(@keys2, raw net_key(
                        string_from_bytes(rows.items[found].hash.ptr, rows.items[found].hash.len),
                        string_from_bytes(rows.items[found].kind.ptr, rows.items[found].kind.len),
                        string_from_bytes(rows.items[found].symbol.ptr, rows.items[found].symbol.len)));
                }
            }
            if (!any_budget) { continue; }
            List<string>:args2 = raw strlist_clone(c.m.z3_options);
            drop strlist_push(@args2, "-smt2");
            drop strlist_push(@args2, raw path_join(dir, string_concat(fno2, ".t2.smt2")));
            int64:secs2 = raw hang_net_secs(cnt.value, raw file_budget(keys2, net));
            Result<Run>:r2 = await run_argv(z3, args2, c.t.env, raw duration_secs(secs2));
            if (r2.is_error) { fail r2.err; }
            Run:run2 = move(r2.value);
            if (run2.timed_out) {
                string:m4 = string_concat(name, ": z3 exceeded the wall-clock net of ");
                m4 = string_concat(m4, int_to_string(secs2));
                m4 = string_concat(m4, " s on a tier-2 twin -- not a verdict (P-13)");
                drop list_push(fl, move(m4));
                pass NIL;
            }
            List<string>:ans2 = raw text_lines(run2.x.out);
            int64:got2 = 0i64;
            for (int64:ai in 0i64...ans2.count) {
                string:a2 = raw text_trim(raw strlist_view(ans2, ai));
                if (a2.len == 0i64) { continue; }
                bool:known = (raw text_eq(a2, "unsat")) || (raw text_eq(a2, "sat")) || (raw text_eq(a2, "unknown"));
                if (!known) {
                    drop list_push(fl, string_concat(name, ": z3 said something other than a verdict on a tier-2 twin"));
                    pass NIL;
                }
                if (got2 < idx.count) {
                    int64:ri3 = idx.items[got2];
                    if (ri3 >= 0i64) {
                        if ((rows.items[ri3].verdict == (raw OV_BUDGET())) && (raw text_eq(a2, "unsat"))) {
                            rows.items[ri3].verdict = raw OV_DISCHARGED();
                            rows.items[ri3].tier = "real";
                        }
                    }
                }
                got2 = got2 + 1i64;
            }
            if (got2 != cnt.value) {
                drop list_push(fl, string_concat(name, ": z3 answered a different number of times than the tier-2 twin's count"));
                pass NIL;
            }
        }
    }
    for (int64:ri2 in 0i64...rows.count) {
        if (!rows.items[ri2].encoded) {
            if (rows.items[ri2].checker) { rows.items[ri2].verdict = raw OV_CHECKER(); }
            else { rows.items[ri2].verdict = raw OV_UNENCODED(); }
        }
    }
    pass NIL;
};

// --- the manifest --------------------------------------------------------------------------

// The rows sorted by symbol then hash and deduplicated (P-10), rendered
// through the one renderer, under the manifest's pin and profile.
pub func:manifest_of = string(Ctx->:c, List<VRow>:rows) never fails {
    List<string>:keys = raw list_init::<string>(rows.count + 1i64);
    for (int64:i in 0i64...rows.count) {
        // `symbol<TAB>hash<TAB>kind<TAB>verdict<TAB>role` sorts by symbol, then hash
        string:k = string_concat(string_from_bytes(rows.items[i].symbol.ptr, rows.items[i].symbol.len), "\t");
        k = string_concat(k, string_from_bytes(rows.items[i].hash.ptr, rows.items[i].hash.len));
        k = string_concat(k, "\t");
        k = string_concat(k, string_from_bytes(rows.items[i].kind.ptr, rows.items[i].kind.len));
        k = string_concat(k, "\t");
        k = string_concat(k, raw ov_name(rows.items[i].verdict));
        k = string_concat(k, "\t");
        k = string_concat(k, string_from_bytes(rows.items[i].role.ptr, rows.items[i].role.len));
        k = string_concat(k, "\t");
        k = string_concat(k, string_from_bytes(rows.items[i].tier.ptr, rows.items[i].tier.len));
        drop list_push(@keys, move(k));
    }
    List<string>:sorted = raw strlist_sorted_unique(keys);
    string:opts = raw text_join(c.m.z3_options, " ");
    // THROUGH A SINK (1.5.1b step 3): a row per obligation is program-sized.
    Sink:sk = raw sink_to_buffer(4096i64);
    drop sink_write(@sk, raw man_header(string_from_bytes(c.m.z3_version.ptr, c.m.z3_version.len),
                                        string_from_bytes(c.m.z3_sha256.ptr, c.m.z3_sha256.len), opts));
    for (int64:j in 0i64...sorted.count) {
        List<string>:f = raw split_tabs(raw strlist_view(sorted, j));
        int32:v = raw ov_of_name(raw strlist_view(f, 3i64));
        int32:kind = 0i32;
        for (int32:kk in 1i32...((raw OK_COUNT()) + 1i32)) {
            if (raw text_eq(raw ok_name(kk), raw strlist_view(f, 2i64))) { kind = kk; }
        }
        string:tier = raw strlist_copy(f, 5i64);
        if ((v == (raw OV_UNENCODED())) || (v == (raw OV_CHECKER()))) { tier = "-"; }
        string:elision = raw elision_word(kind, v, raw strlist_view(f, 4i64));
        drop sink_write(@sk, raw man_row(raw strlist_view(f, 1i64), kind, tier, v, elision,
                                         raw strlist_view(f, 0i64)));
        drop sink_write(@sk, "\n");
    }
    pass (raw sink_into_string(move(sk)));
};

// THE ELISION COLUMN (P-10; 1.5.3 step 2): `none` for a guard-less kind
// (1.5.2 step 3; D-218.7's column) or a conformance row, `retained` for a
// held call-site row whatever its verdict (D-268), else what the verdict did
// to the guard. The harness's `elision_word`, byte for byte.
func:elision_word = string(int32:kind, int32:v, string:role) never fails {
    if (!(raw ok_has_guard(kind))) { pass "none"; }
    if (raw text_eq(role, "conform")) { pass "none"; }
    if (raw text_eq(role, "held")) { pass "retained"; }
    if (v == (raw OV_DISCHARGED())) { pass "elided"; }
    pass "retained";
};

// `hash kind verdict symbol` per row of a parsed manifest, sorted unique --
// the comparable form of a manifest.
func:manifest_keys = List<string>(move ObManifest:m) never fails {
    List<string>:keys = raw list_init::<string>(m.rows.count + 1i64);
    for (int64:i in 0i64...m.rows.count) {
        string:k = string_concat(string_from_bytes(m.rows.items[i].hash.ptr, m.rows.items[i].hash.len), " ");
        k = string_concat(k, raw ok_name(m.rows.items[i].kind));
        k = string_concat(k, " ");
        k = string_concat(k, raw ov_name(m.rows.items[i].verdict));
        k = string_concat(k, " ");
        k = string_concat(k, string_from_bytes(m.rows.items[i].symbol.ptr, m.rows.items[i].symbol.len));
        drop list_push(@keys, move(k));
    }
    pass (raw strlist_sorted_unique(keys));
};

// Are the two manifests the same set of rows? "" when they are; otherwise
// the three-way summary of the mismatch (D-040's table, P-9): rows only in
// the committed file, only in this run (a moved verdict shows as one of
// each). CONSUMES both: a borrow of either would taint the key lists.
pub func:manifest_compare = string(move ObManifest:committed, move ObManifest:run, string:name) never fails {
    List<string>:a = raw manifest_keys(move(committed));
    List<string>:b = raw manifest_keys(move(run));
    List<string>:only_a = raw strlist_minus(a, b);
    List<string>:only_b = raw strlist_minus(b, a);
    if ((only_a.count == 0i64) && (only_b.count == 0i64)) { pass ""; }
    string:out = "";
    int64:shown = 0i64;
    for (int64:i in 0i64...only_a.count) {
        if (shown >= 10i64) { break; }
        // THE FILE COMPARED IS NAMED (1.5.8 step 1b): the floor leg's report
        // said "only in nitpick.obligations" of `runtime/npkrt.obligations`.
        out = string_concat(out, "\n  only in ");
        out = string_concat(out, name);
        out = string_concat(out, ": ");
        out = string_concat(out, raw strlist_view(only_a, i));
        shown = shown + 1i64;
    }
    for (int64:j in 0i64...only_b.count) {
        if (shown >= 20i64) { break; }
        out = string_concat(out, "\n  only in this run:            ");
        out = string_concat(out, raw strlist_view(only_b, j));
        shown = shown + 1i64;
    }
    int64:more = (only_a.count + only_b.count) - shown;
    if (more > 0i64) {
        out = string_concat(out, "\n  ... and ");
        out = string_concat(out, int_to_string(more));
        out = string_concat(out, " more");
    }
    pass out;
};

// --- the cross-checks over a verified emission ----------------------------------------------

func:count_of = int64(string:ir, string:needle) never fails {
    int64:n = 0i64;
    int64:from = 0i64;
    while (true) {
        int64:p = raw text_index_from(ir, needle, from);
        if (p < 0i64) { pass n; }
        n = n + 1i64;
        from = p + 1i64;
    }
    pass n;
};

// DOES THE EMISSION HOLD THE FUNCTION A ROW NAMES? Its symbol defined -- or,
// for an ASYNC function, its resume (`@"npk.resume.M.f"` is the define of
// `@"npk.M.f"`, D-177), or its checked entry's `.body` twin (D-252). The
// harness's `_row_function_held`, byte for byte.
func:row_function_held = bool(StrSet:defined, string:sym) never fails {
    if (raw strset_has(defined, sym)) { pass true; }
    if (raw text_starts_with(sym, "@\"npk.")) {
        string:rest = raw text_slice(sym, 6i64, sym.len);
        if (raw strset_has(defined, string_concat("@\"npk.resume.", rest))) { pass true; }
        string:stem = raw text_slice(sym, 0i64, sym.len - 1i64);
        if (raw strset_has(defined, string_concat(stem, ".body\""))) { pass true; }
    }
    pass false;
};

// The trap each guarded kind keeps when retained (the runtime's identities),
// and the kinds behind one code, for the report.
func:trap_of_kind = string(string:k) never fails {
    if (raw text_eq(k, "div-zero"))      { pass "-4097"; }
    if (raw text_eq(k, "div-min"))       { pass "-4098"; }
    if (raw text_eq(k, "limit"))         { pass "-4111"; }
    if (raw text_eq(k, "requires"))      { pass "-4112"; }
    if (raw text_eq(k, "ensures"))       { pass "-4113"; }
    if (raw text_eq(k, "failsafe-post")) { pass "-4113"; }
    if (raw text_eq(k, "invariant"))     { pass "-4114"; }
    if (raw text_eq(k, "loop-step"))     { pass "-4101"; }
    if (raw text_eq(k, "shift-range"))   { pass "-4115"; }
    if (raw text_eq(k, "err-exit"))      { pass "-4100"; }
    if (raw text_eq(k, "disjoint"))      { pass "-4116"; }
    pass "";
};

// THE KINDS BEHIND ONE CODE, for the report -- DERIVED from `trap_of_kind`
// over the catalogue (1.5.8 step 0, DEF-62), so the two tables that had to
// agree are one.
func:kinds_of_trap = string(string:code) never fails {
    string:out = "";
    for (int32:k in 1i32...((raw OK_COUNT()) + 1i32)) {
        if (raw text_eq(raw trap_of_kind(raw ok_name(k)), code)) {
            if (out.len > 0i64) { out = string_concat(out, "/"); }
            out = string_concat(out, raw ok_name(k));
        }
    }
    if (out.len == 0i64) { pass "?"; }
    pass out;
};

// THE CODES THE BELT COUNTS ARE DERIVED (1.5.8 step 0, DEF-62): every
// catalogue kind through `trap_of_kind`, each code once, in the catalogue's
// order -- as the Python twin derives its own from `TRAP_OF_KIND`. Until then
// they were a hand list of nine, and 1.5.5 step 2 gave `disjoint` its code in
// the table and not in the list: the Python belt counted `-4116` and this one
// never did.
func:counted_trap_codes = List<string>() never fails {
    List<string>:codes = raw list_init::<string>(12i64);
    for (int32:k in 1i32...((raw OK_COUNT()) + 1i32)) {
        string:c = raw trap_of_kind(raw ok_name(k));
        if (c.len == 0i64) { continue; }
        if (!(raw strlist_contains(codes, c))) { drop strlist_push(@codes, c); }
    }
    pass codes;
};

// An `llvm.assume` per discharged SITE, a trap per retained GROUP of each
// guarded kind (P-12, L-13): the manifest is an inventory of guards.
pub func:elided_ir_checks = List<string>(List<VRow>:rows, string:ir_text, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    // A ROW COUNTS ONLY FOR A FUNCTION THE EMISSION HOLDS (1.5.2d, D-262 §1):
    // the trim drops a prelude function nothing references with its guards, so
    // a discharged row of a dropped function has no `llvm.assume` to hold and a
    // retained one no trap -- the harness's rule, byte for byte.
    StrSet:defined = raw strset_init(1024i64);
    List<string>:dlines = raw text_lines(ir_text);
    for (int64:di in 0i64...dlines.count) {
        string:dsym = raw ir_define_sym(raw strlist_view(dlines, di));
        if (dsym.len > 0i64) { discard(raw strset_add(@defined, dsym)); }
    }
    // CODE ONLY (the compiler's own emission spells these calls as string constants).
    string:ir = raw ir_code_all(ir_text);
    // THE SYMBOL TEXT TOO: the bypass belt counts a spelling inside QUOTED
    // symbol names, which the code-only text blanks (its first full run
    // counted nothing for that reason).
    string:syms = raw ir_symbol_all(ir_text);
    // THE TRAPS BY GROUP (1.5.3 step 2, L-13): the rows one guard shares -- a
    // loop's entry, preservation and `continue` rows, a function's entry
    // `requires` row -- carry one group and one trap count; the guard stays,
    // with every trap it holds, while ANY row of the group is retained. A
    // `guard` row counts; a `bypass`, `held` or `conform` row keeps no trap
    // of its own function's (the guard it names is the callee's). The
    // harness's rule, byte for byte.
    List<string>:gsyms = raw list_init::<string>(16i64);
    List<string>:gcodes = raw list_init::<string>(16i64);
    List<int64>:ggroups = raw list_init::<int64>(16i64);
    List<bool>:gret = raw list_init::<bool>(16i64);
    List<int64>:gtraps = raw list_init::<int64>(16i64);
    List<string>:ssyms = raw list_init::<string>(8i64);
    List<int64>:sgroups = raw list_init::<int64>(8i64);
    List<bool>:sok = raw list_init::<bool>(8i64);
    int64:disch = 0i64;
    for (int64:i in 0i64...rows.count) {
        string:sym = string_from_bytes(rows.items[i].symbol.ptr, rows.items[i].symbol.len);
        if (!(raw row_function_held(defined, sym))) { continue; }
        bool:d = (rows.items[i].verdict == (raw OV_DISCHARGED()));
        string:k = string_from_bytes(rows.items[i].kind.ptr, rows.items[i].kind.len);
        string:role = string_from_bytes(rows.items[i].role.ptr, rows.items[i].role.len);
        // ONE `llvm.assume` PER DISCHARGED ROW OF AN ASSUME KIND (P-19, L-11):
        // a guard-less kind's discharge emits nothing, and a contract's
        // discharge is the guard's removal alone (1.5.3 L-11).
        if (d) {
            bool:assume_kind = (raw text_eq(k, "div-zero")) || (raw text_eq(k, "div-min")) || (raw text_eq(k, "limit")) || (raw text_eq(k, "shift-range")) || (raw text_eq(k, "err-exit"));
            if (assume_kind) { disch = disch + 1i64; }
        }
        if (raw text_eq(role, "bypass")) {
            if ((raw text_eq(k, "limit-subsume")) || (raw text_eq(k, "requires"))) {
                int64:sslot = 0i64 - 1i64;
                for (int64:sj in 0i64...ssyms.count) {
                    if ((raw text_eq(raw strlist_view(ssyms, sj), sym)) && (sgroups.items[sj] == rows.items[i].group)) { sslot = sj; }
                }
                if (sslot < 0i64) {
                    drop strlist_push(@ssyms, sym);
                    drop list_push(@sgroups, rows.items[i].group);
                    drop list_push(@sok, d);
                } else {
                    if (!d) { sok.items[sslot] = false; }
                }
            }
        }
        if (!(raw text_eq(role, "guard"))) { continue; }
        string:code = raw trap_of_kind(k);
        if (code.len == 0i64) { continue; }
        int64:slot = 0i64 - 1i64;
        for (int64:j in 0i64...gsyms.count) {
            if ((raw text_eq(raw strlist_view(gsyms, j), sym)) && (raw text_eq(raw strlist_view(gcodes, j), code))
                && (ggroups.items[j] == rows.items[i].group)) { slot = j; }
        }
        if (slot < 0i64) {
            drop strlist_push(@gsyms, sym);
            drop strlist_push(@gcodes, code);
            drop list_push(@ggroups, rows.items[i].group);
            drop list_push(@gret, !d);
            drop list_push(@gtraps, rows.items[i].traps);
        } else {
            if (!d) { gret.items[slot] = true; }
            if (rows.items[i].traps > gtraps.items[slot]) { gtraps.items[slot] = rows.items[i].traps; }
        }
    }
    int64:assumes = raw count_of(ir, "call void @llvm.assume(");
    if (assumes != disch) {
        string:m = string_concat(name, ": the verified IR holds ");
        m = string_concat(m, int_to_string(assumes));
        m = string_concat(m, " `llvm.assume` for ");
        m = string_concat(m, int_to_string(disch));
        m = string_concat(m, " discharged sites");
        drop list_push(@fl, move(m));
    }
    List<string>:codes = raw counted_trap_codes();
    for (int64:ci in 0i64...codes.count) {
        string:code2 = raw strlist_view(codes, ci);
        int64:left = 0i64;
        for (int64:gj in 0i64...gsyms.count) {
            if (gret.items[gj] && (raw text_eq(raw strlist_view(gcodes, gj), code2))) { left = left + gtraps.items[gj]; }
        }
        string:needle = string_concat("@npk_trap(i32 ", code2);
        needle = string_concat(needle, ")");
        int64:traps = raw count_of(ir, needle);
        if (traps != left) {
            string:m1 = string_concat(name, ": the verified IR holds ");
            m1 = string_concat(m1, int_to_string(traps));
            m1 = string_concat(m1, " ");
            m1 = string_concat(m1, code2);
            m1 = string_concat(m1, " traps for ");
            m1 = string_concat(m1, int_to_string(left));
            m1 = string_concat(m1, " retained (");
            m1 = string_concat(m1, raw kinds_of_trap(code2));
            m1 = string_concat(m1, " rows by group)");
            drop list_push(@fl, move(m1));
        }
    }
    // THE BYPASS (D-252, 1.5.2 step 4; D-268): every `.body` symbol is its own
    // define, its checked entry's tail call, or the callee of a direct call --
    // and the direct calls equal the call sites whose EVERY bypass row
    // (`limit-subsume`, `requires`) is discharged.
    int64:bodies = raw count_of(syms, ".body\"");
    int64:bcalls = 0i64;
    int64:btails = 0i64;
    int64:bdefs = 0i64;
    List<string>:blines = raw text_lines(syms);
    for (int64:bi in 0i64...blines.count) {
        string:line = raw strlist_view(blines, bi);
        if ((raw count_of(line, ".body\"(")) == 0i64) { continue; }
        if ((raw count_of(line, "define ")) > 0i64) { bdefs = bdefs + 1i64; continue; }
        if ((raw count_of(line, "= tail call ")) > 0i64) { btails = btails + 1i64; continue; }
        if ((raw count_of(line, "= call ")) > 0i64) { bcalls = bcalls + 1i64; continue; }
    }
    bool:placed = (bodies == (bcalls + btails + bdefs)) && (btails == bdefs);
    if (!placed) {
        string:m4 = string_concat(name, ": a `.body` symbol appears where it may not (");
        m4 = string_concat(m4, int_to_string(bodies));
        m4 = string_concat(m4, " uses: ");
        m4 = string_concat(m4, int_to_string(bcalls));
        m4 = string_concat(m4, " calls, ");
        m4 = string_concat(m4, int_to_string(btails));
        m4 = string_concat(m4, " tail calls, ");
        m4 = string_concat(m4, int_to_string(bdefs));
        m4 = string_concat(m4, " defines)");
        drop list_push(@fl, move(m4));
    }
    int64:subs = 0i64;
    for (int64:si in 0i64...sok.count) { if (sok.items[si]) { subs = subs + 1i64; } }
    if (bcalls != subs) {
        string:m5 = string_concat(name, ": the verified IR holds ");
        m5 = string_concat(m5, int_to_string(bcalls));
        m5 = string_concat(m5, " bypass calls for ");
        m5 = string_concat(m5, int_to_string(subs));
        m5 = string_concat(m5, " call sites whose bypass rows are all discharged");
        drop list_push(@fl, move(m5));
    }
    pass fl;
};

// --- `npkg verify` --------------------------------------------------------------------------

// The compiler with extra arguments; the IR through `-o`.
pub async func:compile_args = Run(Ctx->:c, string:compiler, List<string>:args, Duration:within) {
    pass (relay await run_argv(compiler, args, c.t.env, within));
};

func:verdict_counts = string(List<VRow>:rows) never fails {
    int64:d = 0i64; int64:o = 0i64; int64:b = 0i64; int64:u = 0i64; int64:ck = 0i64;
    for (int64:i in 0i64...rows.count) {
        int32:v = rows.items[i].verdict;
        if (v == (raw OV_DISCHARGED())) { d = d + 1i64; }
        if (v == (raw OV_OPEN()))       { o = o + 1i64; }
        if (v == (raw OV_BUDGET()))     { b = b + 1i64; }
        if (v == (raw OV_UNENCODED()))  { u = u + 1i64; }
        if (v == (raw OV_CHECKER()))    { ck = ck + 1i64; }
    }
    string:s = string_concat(int_to_string(rows.count), " obligation(s): ");
    s = string_concat(s, int_to_string(d)); s = string_concat(s, " discharged, ");
    s = string_concat(s, int_to_string(o)); s = string_concat(s, " open, ");
    s = string_concat(s, int_to_string(b)); s = string_concat(s, " budget, ");
    s = string_concat(s, int_to_string(u)); s = string_concat(s, " unencoded, ");
    s = string_concat(s, int_to_string(ck)); s = string_concat(s, " checker");
    pass s;
};

// THE PARTS SUM TO THE TOTAL, OR THE RUN IS RED (1.5.6b step 4d; the library
// listener's catch). The harness's line said "439 obligation(s): 273
// discharged, 138 open, 0 budget, 22 unencoded" from 1.5.4 on -- 433 of 439,
// the six `checker` rows in the total and not in the breakdown; this runner
// printed the category, and neither checked the sum. A verdict word no
// category counts fails by name in both now.
func:verdict_counts_sum = bool(List<VRow>:rows) never fails {
    int64:counted = 0i64;
    for (int64:i in 0i64...rows.count) {
        int32:v = rows.items[i].verdict;
        if ((v == (raw OV_DISCHARGED())) || (v == (raw OV_OPEN())) || (v == (raw OV_BUDGET())) || (v == (raw OV_UNENCODED())) || (v == (raw OV_CHECKER()))) { counted = counted + 1i64; }
    }
    pass (counted == rows.count);
};

pub async func:verify_run = Step(Ctx->:c, bool:record, bool:explain) {
    // THE FLOOR'S BELTS FIRST (1.5.6 step 0, D-290): the shared-state
    // classification of `runtime/npkrt.spec` against `runtime/npkrt.ll`, before
    // a solver is spawned -- a floor whose words are misclassified has no
    // evidence worth deciding.
    List<string>:fb = raw floor_shared_current(string_from_bytes(c.m.root.ptr, c.m.root.len));
    if (fb.count > 0i64) { pass (raw step_bad(raw strlist_view(fb, 0i64))); }
    // the stack rule's second half (1.5.6b, DEF-52): every alloca defined in its entry block
    List<string>:fk = raw floor_stack_current(string_from_bytes(c.m.root.ptr, c.m.root.len));
    if (fk.count > 0i64) { pass (raw step_bad(raw strlist_view(fk, 0i64))); }
    // the models' second reading (1.5.6b step 4d, D-295): explicit-state search, no bound and no solver
    List<string>:fx = raw floor_models_explicit(string_from_bytes(c.m.root.ptr, c.m.root.len));
    if (fx.count > 0i64) { pass (raw step_bad(raw strlist_view(fx, 0i64))); }
    // the explored floor (1.5.7 step 0, X-9): the real floor through the one transformer, every step accounted for
    List<string>:fe = raw explore_totality_current(string_from_bytes(c.m.root.ptr, c.m.root.len));
    if (fe.count > 0i64) { pass (raw step_bad(raw strlist_view(fe, 0i64))); }
    drop say(raw stage_text("floor", "the shared-state classification holds (D-290), every alloca is defined in its entry block (1.5.6b), no model reaches a bad state anywhere (D-295), and no step of the floor escapes its explored transform (1.5.7)"));
    if (!c.m.z3) { pass (raw step_bad("nitpick.toml: [verify] z3 is not true -- this project declares no z3 verification, and a verify that pretended otherwise would be a green light nobody earned (D-068)")); }
    Result<string>:z3r = which("z3");
    if (z3r.is_error) { pass (raw step_bad("npkg verify: PATH cannot be read")); }
    string:z3 = move(z3r.value);
    List<string>:pins = relay await verify_pin_check(z3, c.t.env,
        string_from_bytes(c.m.z3_version.ptr, c.m.z3_version.len),
        string_from_bytes(c.m.z3_sha256.ptr, c.m.z3_sha256.len), c.m.z3_options);
    if (pins.count > 0i64) { pass (raw step_bad(raw strlist_view(pins, 0i64))); }
    string:vdir = raw path_join(string_from_bytes(c.bdir.ptr, c.bdir.len), "verify");
    Result<NIL>:d = ensure_dir(vdir);
    if (d.is_error) { pass (raw step_bad("build/verify/ could not be created")); }
    string:entry = raw in_root(c, string_from_bytes(c.m.entry.ptr, c.m.entry.len));
    string:obl = raw path_join(vdir, "obl");
    string:plain = raw path_join(vdir, "plain.ll");

    // 1. the obligations, guards retained
    List<string>:a1 = raw list_init::<string>(6i64);
    drop strlist_push(@a1, entry);
    drop strlist_push(@a1, "--obligations");
    drop strlist_push(@a1, obl);
    drop strlist_push(@a1, "-o");
    drop strlist_push(@a1, plain);
    Result<Run>:r1 = await compile_args(c, string_from_bytes(c.npkc.ptr, c.npkc.len), a1, raw duration_secs(900i64));
    if (r1.is_error) { fail r1.err; }
    Run:run1 = move(r1.value);
    if (run1.timed_out) { pass (raw step_bad("npkc did not terminate emitting the obligations")); }
    if (!(run1.x.exited && (run1.x.status == 0i64))) {
        pass (raw step_bad(string_concat("npkc refused [build] entry under --obligations: ", raw text_head(raw text_trim(run1.x.err), 300i64))));
    }
    Result<List<VRow>>:rows_r = read_rows(obl);
    if (rows_r.is_error) { pass (raw step_bad("the obligation directory could not be read (rows.txt)")); }
    List<VRow>:rows = move(rows_r.value);
    Result<List<VFile>>:files_r = read_index(obl);
    if (files_r.is_error) { pass (raw step_bad("the obligation directory could not be read (index.txt)")); }
    List<VFile>:files = move(files_r.value);

    // 2. the committed manifest, read BEFORE the solver runs: the hang net of
    //    each file counts the rows it records `budget` (D-297); a `--record`
    //    run has none to trust and every row takes the larger bound
    string:committed = raw in_root(c, "nitpick.obligations");
    Result<cstring>:cc = to_cstring(committed);
    if (cc.is_error) { pass (raw step_bad("nitpick.obligations: not a path")); }
    string:ctext = "";
    if (!record) {
        if (!(path_exists(cc.value))) {
            pass (raw step_bad("nitpick.obligations is not committed -- the verified build is governed by the manifest and nothing writes it implicitly (P-9); run `npkg verify --record` and commit the file"));
        }
        Result<string>:ct = read_file(cc.value);
        if (ct.is_error) { pass (raw step_bad("nitpick.obligations cannot be read")); }
        ctext = move(ct.value);
    }
    // parsed once, at the scope of the net that reads it (D-004 rule 3: the
    // net is built from a borrow of it); under `--record` the empty text
    // parses as not ok and is never asked
    ObManifest:cman = raw man_parse(ctext);
    HangNet:net = raw net_untrusted();
    if (!record) {
        if (!cman.ok) { pass (raw step_bad(string_concat("nitpick.obligations: ", cman.problem))); }
        net = raw net_of_manifest(@cman);
    }

    // 3. z3, one process per function file
    List<string>:zf = raw list_init::<string>(1i64);
    Result<NIL>:zr = await z3_decide(c, z3, obl, @rows, files, "verify", @zf, @net);
    if (zr.is_error) { fail zr.err; }
    if (zf.count > 0i64) { pass (raw step_bad(raw strlist_view(zf, 0i64))); }
    string:run_text = raw manifest_of(c, rows);

    // 4. the comparison, or the record
    if (record) {
        Result<NIL>:w = write_file(cc.value, run_text);
        if (w.is_error) { pass (raw step_bad("nitpick.obligations could not be written")); }
        drop say(raw stage_text("recorded", "nitpick.obligations written from this run (--record): commit it with the change that moved it"));
    } else {
        ObManifest:rman = raw man_parse(run_text);
        if (!rman.ok) { pass (raw step_bad(string_concat("this run's manifest does not read back: ", rman.problem))); }
        string:diff = raw manifest_compare(move(cman), move(rman), "nitpick.obligations");
        if (diff.len > 0i64) {
            string:m = "this run's obligations differ from nitpick.obligations (D-040: a build that would differ from the recorded reasoning stops; `npkg verify --record` re-baselines on purpose):";
            m = string_concat(m, diff);
            pass (raw step_bad(m));
        }
        if (!(raw text_eq(ctext, run_text))) {
            pass (raw step_bad("nitpick.obligations carries the same rows as this run but different bytes -- the header (the pinned z3, the profile) or the row order moved; re-record it"));
        }
    }

    // 5. the VERIFIED build
    string:vll = raw path_join(vdir, "npkc.v.ll");
    List<string>:a2 = raw list_init::<string>(8i64);
    drop strlist_push(@a2, entry);
    drop strlist_push(@a2, "--elide");
    drop strlist_push(@a2, committed);
    drop strlist_push(@a2, "--obligations");
    drop strlist_push(@a2, string_concat(obl, "2"));
    drop strlist_push(@a2, "-o");
    drop strlist_push(@a2, vll);
    Result<Run>:r2 = await compile_args(c, string_from_bytes(c.npkc.ptr, c.npkc.len), a2, raw duration_secs(900i64));
    if (r2.is_error) { fail r2.err; }
    Run:run2 = move(r2.value);
    if (run2.timed_out) { pass (raw step_bad("npkc did not terminate emitting the verified build")); }
    if (!(run2.x.exited && (run2.x.status == 0i64))) {
        pass (raw step_bad(string_concat("npkc refused [build] entry under --elide: ", raw text_head(raw text_trim(run2.x.err), 300i64))));
    }
    Result<cstring>:ra = to_cstring(raw path_join(obl, "rows.txt"));
    if (ra.is_error) { pass (raw step_bad("rows.txt: not a path")); }
    Result<cstring>:rb = to_cstring(raw path_join(string_concat(obl, "2"), "rows.txt"));
    if (rb.is_error) { pass (raw step_bad("rows.txt: not a path")); }
    Result<string>:ta = read_file(ra.value);
    if (ta.is_error) { pass (raw step_bad("rows.txt could not be read back")); }
    Result<string>:tb = read_file(rb.value);
    if (tb.is_error) { pass (raw step_bad("rows.txt could not be read back")); }
    if (!(raw text_eq(ta.value, tb.value))) { pass (raw step_bad("the --elide run computed different rows than the --obligations run -- the walk depends on something it must not (P-3)")); }
    Result<cstring>:vc = to_cstring(vll);
    if (vc.is_error) { pass (raw step_bad("npkc.v.ll: not a path")); }
    Result<string>:vir = read_file(vc.value);
    if (vir.is_error) { pass (raw step_bad("npkc.v.ll could not be read back")); }
    List<string>:s1 = raw ir_symbols_unique(vir.value, "npkc.v.ll");
    if (s1.count > 0i64) { pass (raw step_bad(raw strlist_view(s1, 0i64))); }
    List<string>:s2 = raw ir_allocas_hoisted(vir.value, "npkc.v.ll");
    if (s2.count > 0i64) { pass (raw step_bad(raw strlist_view(s2, 0i64))); }
    List<string>:s3 = raw ir_no_undef(vir.value, "npkc.v.ll");
    if (s3.count > 0i64) { pass (raw step_bad(raw strlist_view(s3, 0i64))); }
    List<string>:s3b = raw ir_prelude_trimmed(vir.value, "npkc.v.ll");
    if (s3b.count > 0i64) { pass (raw step_bad(raw strlist_view(s3b, 0i64))); }
    List<string>:s4 = raw elided_ir_checks(rows, vir.value, "verify");
    if (s4.count > 0i64) { pass (raw step_bad(raw strlist_view(s4, 0i64))); }
    string:vobj = raw path_join(vdir, "npkc.v.o");
    Result<Step>:l1 = await llc_obj(c, c.m.llc_flags, vll, vobj);
    if (l1.is_error) { fail l1.err; }
    Step:st1 = move(l1.value);
    if (!st1.ok) { pass (raw step_bad(string_concat("llc rejected the verified compiler's IR: ", raw first_line_with(st1.text, "error", 160i64)))); }
    List<string>:zd = raw zero_dep(c, vobj, c.allow, "npkc.v.o");
    if (zd.count > 0i64) { pass (raw step_bad(raw strlist_view(zd, 0i64))); }
    string:vbin = raw path_join(vdir, "npkc");
    Result<Step>:l2 = await lld_link(c, vbin, vobj);
    if (l2.is_error) { fail l2.err; }
    Step:st2 = move(l2.value);
    if (!st2.ok) { pass (raw step_bad(string_concat("the verified compiler failed to link: ", raw text_head(raw text_trim(st2.text), 160i64)))); }

    // 6. the verified fixpoint (D-202 over the verified build)
    string:s2ll = raw path_join(vdir, "stage2.v.ll");
    List<string>:a3 = raw list_init::<string>(6i64);
    drop strlist_push(@a3, entry);
    drop strlist_push(@a3, "--elide");
    drop strlist_push(@a3, committed);
    drop strlist_push(@a3, "-o");
    drop strlist_push(@a3, s2ll);
    Result<Run>:r3 = await compile_args(c, vbin, a3, raw duration_secs(900i64));
    if (r3.is_error) { fail r3.err; }
    Run:run3 = move(r3.value);
    if (run3.timed_out) { pass (raw step_bad("THE VERIFIED COMPILER did not terminate compiling the compiler")); }
    if (!(run3.x.exited && (run3.x.status == 0i64))) {
        pass (raw step_bad(string_concat("THE VERIFIED COMPILER cannot compile the compiler: ", raw text_head(raw text_trim(run3.x.err), 300i64))));
    }
    Result<cstring>:s2c = to_cstring(s2ll);
    if (s2c.is_error) { pass (raw step_bad("stage2.v.ll: not a path")); }
    Result<string>:s2t = read_file(s2c.value);
    if (s2t.is_error) { pass (raw step_bad("stage2.v.ll could not be read back")); }
    if (!(raw text_eq(s2t.value, vir.value))) {
        pass (raw step_bad("THE VERIFIED FIXPOINT DRIFTED -- the verified compiler's emission of the compiler differs from the unverified compiler's verified emission (D-202 over the verified build)"));
    }

    if (explain) {
        Result<NIL>:ex = await explain_run(c, z3, obl, rows, files, raw path_join(vdir, "explain.txt"));
        if (ex.is_error) { pass (raw step_bad("the --explain pass could not run")); }
        drop say(raw stage_text("explain", "build/verify/explain.txt: a model per open row, a reason per budget row, a core per discharged row"));
    }
    if (!(raw verdict_counts_sum(rows))) { pass (raw step_bad("verify: the verdict breakdown does not sum to its total -- a verdict word the summary does not count")); }
    string:line = raw verdict_counts(rows);
    line = string_concat(line, "; nitpick.obligations matches; the verified compiler rebuilds itself byte-identically");
    drop say(raw stage_text("verify", line));

    // 7. THE FLOOR'S LEG (1.5.6 step 3, D-288)
    Result<Step>:fs = await floor_leg(c, z3, vdir, record, explain);
    if (fs.is_error) { fail fs.err; }
    Step:fst = move(fs.value);
    if (!fst.ok) { pass fst; }
    drop say(raw stage_text("floor", fst.text));
    drop say(raw stage_text("nikos", "[verify.nikos] declared, not run -- the engine is 1.6.0's gate's (D-217, D-233)"));
    pass (raw step_ok(vbin));
};

// --- THE FLOOR'S LEG (1.5.6 step 3; D-288 §2.11) ----------------------------------------------
//
// After the verified fixpoint: the belts over `runtime/npkrt.spec` (the
// spec names what the floor defines, every section claims or excuses, the
// TCB table's disposition column is what the spec and the committed floor
// manifest say), the translator writing `build/verify/floor/`, z3 over it
// through the same `z3_decide`, the verdict rule -- an `open` floor row is
// a run failure by name, and so is an `unroll-exact` row that is not
// discharged -- and the floor's manifest held to `runtime/npkrt.obligations`
// exactly as the compiler's is to `nitpick.obligations`, `--record` writing
// it, `--explain` covering its rows in `build/verify/explain-floor.txt`.

// The verdict rule's findings over decided floor rows.
pub func:floor_verdict_failures = List<string>(List<VRow>:rows) never fails {
    List<string>:fl = raw list_init::<string>(2i64);
    for (int64:i in 0i64...rows.count) {
        string:site = string_from_bytes(rows.items[i].site.ptr, rows.items[i].site.len);
        string:sym = string_from_bytes(rows.items[i].symbol.ptr, rows.items[i].symbol.len);
        if (rows.items[i].verdict == (raw OV_OPEN())) {
            string:m = string_concat("floor: ", sym);
            m = string_concat(m, ": ");
            m = string_concat(m, site);
            m = string_concat(m, " is refuted (a counterexample exists; either the floor does not meet its specification or the specification is wrong; `npkg verify --explain` writes the model)");
            drop strlist_push(@fl, m);
            continue;
        }
        if ((raw text_starts_with(site, "spec:unroll-exact")) && (rows.items[i].verdict != (raw OV_DISCHARGED()))) {
            string:m2 = string_concat("floor: ", sym);
            m2 = string_concat(m2, ": ");
            m2 = string_concat(m2, site);
            m2 = string_concat(m2, " -- the spec claims the bound exact and the profile did not prove it: say `(unroll N)` without `exact`, or raise the bound");
            drop strlist_push(@fl, m2);
        }
    }
    pass fl;
};

// The belts that need no solver: the spec against the floor, TCB.md's
// table against the spec and the committed floor manifest (absent: the
// class defaults must stand).
pub func:floor_belts = List<string>(Ctx->:c, FloorInputs->:inp) never fails {
    List<string>:fl = raw floor_spec_current(@inp.ft, @inp.spec);
    // the models against the floor: every named block exists, every atomic
    // operation and syscall of a named symbol is in a named block (1.5.6 step 5)
    if (inp.models.count == 0i64) {
        drop strlist_push(@fl, "floor: runtime/models is missing, unreadable or holds no model -- the floor's protocol models are part of the tree (D-289)");
    }
    List<string>:mfl = raw floor_models_current(@inp.ft, inp.models);
    for (int64:mi in 0i64...mfl.count) { drop strlist_push(@fl, raw strlist_view(mfl, mi)); }
    if (fl.count > 0i64) { pass fl; }
    string:root = string_from_bytes(c.m.root.ptr, c.m.root.len);
    List<ManRow>:rows = raw list_init::<ManRow>(64i64);
    Result<cstring>:mc = to_cstring(raw path_join(root, "runtime/npkrt.obligations"));
    if (mc.is_error) { drop strlist_push(@fl, "floor: runtime/npkrt.obligations: not a path"); pass fl; }
    if (path_exists(mc.value)) {
        Result<string>:mt = read_file(mc.value);
        if (mt.is_error) { drop strlist_push(@fl, "floor: runtime/npkrt.obligations cannot be read"); pass fl; }
        ObManifest:man = raw man_parse_named(mt.value, true);
        if (!man.ok) { drop strlist_push(@fl, string_concat("floor: ", man.problem)); pass fl; }
        rows = move(man.rows);
    }
    Result<cstring>:tc = to_cstring(raw path_join(root, "meta/specs/TCB.md"));
    if (tc.is_error) { drop strlist_push(@fl, "tcb-floor: meta/specs/TCB.md: not a path"); pass fl; }
    Result<string>:tt = read_file(tc.value);
    if (tt.is_error) { drop strlist_push(@fl, "tcb-floor: meta/specs/TCB.md is missing"); pass fl; }
    List<string>:tf = raw tcb_floor_current(@inp.ft, @inp.spec, @rows, inp.models, tt.value);
    List<string>:ts = raw tcb_syscalls_current(@inp.ft, tt.value);
    for (int64:si in 0i64...ts.count) { drop strlist_push(@tf, raw strlist_view(ts, si)); }
    List<string>:tr2 = raw tcb_residue_current(@inp.spec, @rows, inp.models, tt.value, root);
    for (int64:ri2 in 0i64...tr2.count) { drop strlist_push(@tf, raw strlist_view(tr2, ri2)); }
    // TCB.md SS4d (1.5.6c step 3): who keeps a section's caller assumptions
    List<string>:tc2 = raw tcb_callers_current(@inp.ft, @inp.spec, tt.value);
    for (int64:ci2 in 0i64...tc2.count) { drop strlist_push(@tf, raw strlist_view(tc2, ci2)); }
    for (int64:i in 0i64...tf.count) { drop strlist_push(@fl, raw strlist_view(tf, i)); }
    pass fl;
};

pub async func:floor_leg = Step(Ctx->:c, string:z3, string:vdir, bool:record, bool:explain) {
    string:root = string_from_bytes(c.m.root.ptr, c.m.root.len);
    FloorInputs:inp = raw floor_read(root);
    if (!inp.ok) { pass (raw step_bad(inp.problem)); }
    List<string>:sb = raw floor_shared_current(root);
    if (sb.count > 0i64) { pass (raw step_bad(raw strlist_view(sb, 0i64))); }
    List<string>:sk = raw floor_stack_current(root);
    if (sk.count > 0i64) { pass (raw step_bad(raw strlist_view(sk, 0i64))); }
    List<string>:sx = raw floor_models_explicit(root);
    if (sx.count > 0i64) { pass (raw step_bad(raw strlist_view(sx, 0i64))); }
    List<string>:se = raw explore_totality_current(root);
    if (se.count > 0i64) { pass (raw step_bad(raw strlist_view(se, 0i64))); }
    List<string>:bl = raw floor_belts(c, @inp);
    if (bl.count > 0i64) { pass (raw step_bad(string_concat(raw strlist_view(bl, 0i64), ""))); }
    string:fdir = raw path_join(vdir, "floor");
    List<string>:ef = raw floor_emit(@inp.ft, @inp.spec, inp.models, fdir);
    if (ef.count > 0i64) { pass (raw step_bad(string_concat(raw strlist_view(ef, 0i64), ""))); }
    Result<List<VRow>>:rows_r = read_rows(fdir);
    if (rows_r.is_error) { pass (raw step_bad("the floor's obligation directory could not be read (rows.txt)")); }
    List<VRow>:rows = move(rows_r.value);
    Result<List<VFile>>:files_r = read_index(fdir);
    if (files_r.is_error) { pass (raw step_bad("the floor's obligation directory could not be read (index.txt)")); }
    List<VFile>:files = move(files_r.value);
    // the committed manifest, read BEFORE the solver runs: the hang net of
    // each file counts the rows it records `budget` (D-297) -- the floor's
    // seven residue rows are where the net's margin was thinnest; a
    // `--record` run has none to trust and every row takes the larger bound
    string:committed = raw path_join(root, "runtime/npkrt.obligations");
    Result<cstring>:cc = to_cstring(committed);
    if (cc.is_error) { pass (raw step_bad("runtime/npkrt.obligations: not a path")); }
    string:ctext = "";
    if (!record) {
        if (!(path_exists(cc.value))) {
            pass (raw step_bad("runtime/npkrt.obligations is not committed -- the floor's rows are governed by their manifest and nothing writes it implicitly (D-288); run `npkg verify --record` and commit the file"));
        }
        Result<string>:ct = read_file(cc.value);
        if (ct.is_error) { pass (raw step_bad("runtime/npkrt.obligations cannot be read")); }
        ctext = move(ct.value);
    }
    // parsed once, at the scope of the net that reads it (D-004 rule 3);
    // under `--record` the empty text parses as not ok and is never asked
    ObManifest:cman = raw man_parse_named(ctext, true);
    HangNet:net = raw net_untrusted();
    if (!record) {
        if (!cman.ok) { pass (raw step_bad(string_concat("runtime/npkrt.obligations: ", cman.problem))); }
        net = raw net_of_manifest(@cman);
    }
    List<string>:zf = raw list_init::<string>(1i64);
    Result<NIL>:zr = await z3_decide(c, z3, fdir, @rows, files, "floor", @zf, @net);
    if (zr.is_error) { fail zr.err; }
    if (zf.count > 0i64) { pass (raw step_bad(raw strlist_view(zf, 0i64))); }
    List<string>:vf = raw floor_verdict_failures(rows);
    if (vf.count > 0i64) { pass (raw step_bad(raw strlist_view(vf, 0i64))); }
    // THE CONTROLS (D-289 SS2.7): every control must be `sat` -- a model whose
    // mutation reaches no bad state is blind to what it claims to see
    Result<List<string>>:cf = await controls_decide(c, z3, fdir);
    if (cf.is_error) { fail cf.err; }
    if (cf.value.count > 0i64) { pass (raw step_bad(raw strlist_view(cf.value, 0i64))); }
    string:run_text = raw manifest_of(c, rows);
    if (record) {
        Result<NIL>:w = write_file(cc.value, run_text);
        if (w.is_error) { pass (raw step_bad("runtime/npkrt.obligations could not be written")); }
        drop say(raw stage_text("recorded", "runtime/npkrt.obligations written from this run (--record): commit it with the change that moved it"));
    } else {
        ObManifest:rman = raw man_parse_named(run_text, true);
        if (!rman.ok) { pass (raw step_bad(string_concat("this run's floor manifest does not read back: ", rman.problem))); }
        string:diff = raw manifest_compare(move(cman), move(rman), "runtime/npkrt.obligations");
        if (diff.len > 0i64) {
            string:m = "this run's floor obligations differ from runtime/npkrt.obligations (D-040: a build that would differ from the recorded reasoning stops; `npkg verify --record` re-baselines on purpose):";
            m = string_concat(m, diff);
            pass (raw step_bad(m));
        }
        if (!(raw text_eq(ctext, run_text))) {
            pass (raw step_bad("runtime/npkrt.obligations carries the same rows as this run but different bytes -- the header (the pinned z3, the profile) or the row order moved; re-record it"));
        }
    }
    if (explain) {
        Result<NIL>:ex = await explain_run(c, z3, fdir, rows, files, raw path_join(vdir, "explain-floor.txt"));
        if (ex.is_error) { pass (raw step_bad("the floor's --explain pass could not run")); }
        drop say(raw stage_text("explain", "build/verify/explain-floor.txt: the floor's rows -- a model per open row, a reason per budget row, a core per discharged row"));
    }
    if (!(raw verdict_counts_sum(rows))) { pass (raw step_bad("floor: the verdict breakdown does not sum to its total -- a verdict word the summary does not count")); }
    string:line = raw verdict_counts(rows);
    line = string_concat(line, "; runtime/npkrt.obligations matches");
    pass (raw step_ok(line));
};

// The controls of `dir/controls.txt` (`cNNNN\tmodel:NAME\tCONTROL\tBAD`), each
// decided once; a control that is not `sat` is a finding by name
// (`floor-control-blind` in the runner self-check).
pub async func:controls_decide = List<string>(Ctx->:c, string:z3, string:dir) {
    List<string>:fl = raw list_init::<string>(2i64);
    Result<cstring>:cc = to_cstring(raw path_join(dir, "controls.txt"));
    if (cc.is_error) { fail cc.err; }
    if (!(path_exists(cc.value))) { drop strlist_push(@fl, "floor: the writer left no controls.txt"); pass fl; }
    Result<string>:ct = read_file(cc.value);
    if (ct.is_error) { fail ct.err; }
    List<string>:lines = raw text_lines(ct.value);
    int64:seen = 0i64;
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (ln.len == 0i64) { continue; }
        List<string>:f = raw split_tabs(ln);
        if (f.count != 4i64) { drop strlist_push(@fl, "floor: a controls.txt line is not `cNNNN model:NAME CONTROL BAD`"); pass fl; }
        List<string>:args = raw strlist_clone(c.m.z3_options);
        drop strlist_push(@args, "-smt2");
        drop strlist_push(@args, raw path_join(dir, string_concat(raw strlist_view(f, 0i64), ".smt2")));
        Result<Run>:r = await run_argv(z3, args, c.t.env, raw duration_secs(130i64));
        if (r.is_error) { fail r.err; }
        Run:run = move(r.value);
        if (run.timed_out) {
            string:m1 = string_concat("floor: z3 exceeded the wall-clock net on the control ", raw strlist_view(f, 2i64));
            m1 = string_concat(m1, " of ");
            m1 = string_concat(m1, raw strlist_view(f, 1i64));
            m1 = string_concat(m1, " -- not a verdict: a wedged solver is a build failure (P-13)");
            drop list_push(@fl, move(m1));
            pass fl;
        }
        string:a = raw text_trim(run.x.out);
        if (!(raw text_eq(a, "sat"))) {
            string:m2 = string_concat("floor: the control ", raw strlist_view(f, 2i64));
            m2 = string_concat(m2, " of ");
            m2 = string_concat(m2, raw strlist_view(f, 1i64));
            m2 = string_concat(m2, " does not reach bad:");
            m2 = string_concat(m2, raw strlist_view(f, 3i64));
            m2 = string_concat(m2, " (z3 said `");
            m2 = string_concat(m2, raw text_head(a, 40i64));
            m2 = string_concat(m2, "`, not `sat`): a model blind to what it claims to see (floor-control-blind)");
            drop list_push(@fl, move(m2));
            pass fl;
        }
        seen = seen + 1i64;
    }
    pass fl;
};

// --- `--explain` (P-7's second pass) ---------------------------------------------------------

// A function file's base (everything before the first `(push)`) and the
// k-th obligation's block (between its `(push)` and `(pop)`, exclusive).
func:file_base = string(string:text) never fails {
    int64:p = raw text_index_of(text, "(push)");
    if (p < 0i64) { pass (raw text_copy(text)); }
    pass (raw text_slice(text, 0i64, p));
};

func:file_block = string(string:text, int64:k) never fails {
    int64:from = 0i64;
    int64:n = 0i64;
    while (true) {
        int64:p = raw text_index_from(text, "(push)\n", from);
        if (p < 0i64) { pass ""; }
        n = n + 1i64;
        if (n == k) {
            int64:q = raw text_index_from(text, "(pop)", p);
            if (q < 0i64) { pass ""; }
            pass (raw text_slice(text, p + 7i64, q));
        }
        from = p + 1i64;
    }
    pass "";
};

async func:explain_run = NIL(Ctx->:c, string:z3, string:dir, List<VRow>:rows, List<VFile>:files, string:out_path) {
    string:report = "";
    for (int64:i in 0i64...rows.count) {
        if (!rows.items[i].encoded) { continue; }
        string:fno = string_from_bytes(rows.items[i].fno.ptr, rows.items[i].fno.len);
        Result<cstring>:fc = to_cstring(raw path_join(dir, string_concat(fno, ".smt2")));
        if (fc.is_error) { fail fc.err; }
        Result<string>:ft = read_file(fc.value);
        if (ft.is_error) { fail ft.err; }
        // the k-th encoded row of the file is the k-th check
        int64:kth = 0i64;
        for (int64:j in 0i64...(i + 1i64)) {
            if (raw text_eq(string_from_bytes(rows.items[j].fno.ptr, rows.items[j].fno.len), fno)) {
                if (rows.items[j].encoded) { kth = kth + 1i64; }
            }
        }
        // A ROW TIER 2 DECIDED (D-281): tier 1 answered `unknown` there, so
        // its core is the twin's business; the report says which tier decided.
        if (raw text_eq(string_from_bytes(rows.items[i].tier.ptr, rows.items[i].tier.len), "real")) {
            report = string_concat(report, "== ");
            report = string_concat(report, string_from_bytes(rows.items[i].symbol.ptr, rows.items[i].symbol.len));
            report = string_concat(report, " ");
            report = string_concat(report, string_from_bytes(rows.items[i].kind.ptr, rows.items[i].kind.len));
            report = string_concat(report, " discharged real ");
            report = string_concat(report, string_from_bytes(rows.items[i].hash.ptr, rows.items[i].hash.len));
            report = string_concat(report, "\n   decided at tier 2 (the Real-interval twin, `");
            report = string_concat(report, fno);
            report = string_concat(report, ".t2.smt2`); tier 1 answered unknown under the profile\n");
            continue;
        }
        string:q = "(set-option :produce-models true)\n(set-option :produce-unsat-cores true)\n";
        q = string_concat(q, raw file_base(ft.value));
        q = string_concat(q, "(push)\n");
        q = string_concat(q, raw file_block(ft.value, kth));
        int32:v = rows.items[i].verdict;
        if (v == (raw OV_OPEN()))       { q = string_concat(q, "(get-model)\n"); }
        if (v == (raw OV_BUDGET()))     { q = string_concat(q, "(get-info :reason-unknown)\n"); }
        if (v == (raw OV_DISCHARGED())) { q = string_concat(q, "(get-unsat-core)\n"); }
        q = string_concat(q, "(pop)\n");
        string:qpath = raw path_join(dir, "explain.smt2");
        Result<cstring>:qc = to_cstring(qpath);
        if (qc.is_error) { fail qc.err; }
        Result<NIL>:w = write_file(qc.value, q);
        if (w.is_error) { fail w.err; }
        List<string>:args = raw strlist_clone(c.m.z3_options);
        drop strlist_push(@args, "-smt2");
        drop strlist_push(@args, qpath);
        Result<Run>:r = await run_argv(z3, args, c.t.env, raw duration_secs(300i64));
        if (r.is_error) { fail r.err; }
        Run:run = move(r.value);
        report = string_concat(report, "== ");
        report = string_concat(report, string_from_bytes(rows.items[i].symbol.ptr, rows.items[i].symbol.len));
        report = string_concat(report, " ");
        report = string_concat(report, string_from_bytes(rows.items[i].kind.ptr, rows.items[i].kind.len));
        report = string_concat(report, " ");
        report = string_concat(report, raw ov_name(v));
        report = string_concat(report, " ");
        report = string_concat(report, string_from_bytes(rows.items[i].tier.ptr, rows.items[i].tier.len));
        report = string_concat(report, " ");
        report = string_concat(report, string_from_bytes(rows.items[i].hash.ptr, rows.items[i].hash.len));
        report = string_concat(report, "\n");
        if (run.timed_out) { report = string_concat(report, "(the explain query exceeded its wall-clock net)\n"); }
        else { report = string_concat(report, run.x.out); }
    }
    Result<cstring>:oc = to_cstring(out_path);
    if (oc.is_error) { fail oc.err; }
    Result<NIL>:ow = write_file(oc.value, report);
    if (ow.is_error) { fail ow.err; }
    pass NIL;
};
