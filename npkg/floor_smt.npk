// floor_smt -- THE FLOOR'S TRANSLATOR (1.5.6 step 3; D-288 §2.3-§2.6): one
// `define` of `runtime/npkrt.ll`, read through `floor_ir.npk`'s blocks and
// `floor_instr.npk`'s typed lines after `floor_cfg.npk`'s transforms, into
// the SMT-LIB2 file the runners already decide (the compiler's directory
// shape: `NNNN.smt2`, `index.txt`, `rows.txt`), its rows drawn from the
// symbol's section of `runtime/npkrt.spec`.
//
// THE THEORY (D-218 (4), as the program encoder's): every IR value of an
// integer or pointer type is an unbounded Int carrying its width's range
// axiom, read UNSIGNED -- the bit pattern's value -- with the signed
// operations (`sdiv`, `srem`, `icmp slt`..., `sext`, `ashr`) reading the
// signed view `(ite (>= x 2^(w-1)) (- x 2^w) x)` where they must; `add`/
// `sub`/`mul` wrap explicitly, `(mod (+ a b) 2^w)`, because the floor's IR
// carries no `nsw`/`nuw` and its address arithmetic wraps on purpose
// (`add %ip, -16`); `udiv`/`urem` are `div`/`mod` (a zero divisor is the
// solver's unspecified value, which is every value -- the IR's poison,
// over-approximated); an `i1` is a Bool; a float is an IEEE term of its
// width (tier `fp`); an aggregate is its fields, one symbol each.
//
// THE BIT OPERATIONS (D-279, D-280, and the four idioms of the plan's §2.3):
// with a numeral operand the Int forms -- `and x (2^k-1)` is `(mod x 2^k)`,
// `and x (-2^k)` is `(- x (mod x 2^k))`, `and x 2^j` the bit test, `shl x k`
// is `(mod (* x 2^k) 2^w)`, `lshr x k` is `(div x 2^k)`, `ashr` over the
// signed view, `xor x -1` the complement; `or a b` is a FRESH symbol `o`
// carrying the facts that hold of every bitwise or -- `a <= o`, `b <= o`,
// `o <= a + b`, `o < 2^w` -- and, for every k the operands' shapes suggest
// (a `shl` by k, a mask of k bits, a `zext i1` -> 1, a numeral's bit
// length), the exact reading `(=> (and (= (mod a 2^k) 0) (< b 2^k)) (= o (+ a
// b)))` both ways round: the low-bit insert `or (shl x 1) y` of the division
// loop reads as `2x + y` under the fact that makes it sound (the shifted
// term is even), and nothing is assumed -- every fact asserted of `o` is a
// theorem of the operation. Two symbolic operands of `and`/`xor`, or a
// symbolic shift, cross into bit-vectors at 64 bits or less (D-280's
// `BV_CROSS_MAX_BITS`, tier `bv`); wider they are opaque (a fresh symbol
// with the range axiom), and a row that depends on one is residue by
// construction. `ptrtoint`/`inttoptr` are identities: an address IS an
// Int in [0, 2^64).
//
// MEMORY is the uninterpreted function `(mem Int) Int` -- a byte per
// address, the range axiom `0 <= mem(a) < 256` asserted at every
// application the translation writes -- with a `store iN` a fresh memory
// function defined pointwise over the previous one (little-endian, N/8
// bytes) and a `load iN` the reassembly `sum mem(a+j) * 256^j`. No array
// sort, no quantifier, no `Seq` (D-218 (6)). An `alloca` is a fresh
// address, a global a fixed symbolic address per name; every pair of them
// the function touches is disjoint (a true fact of the layout, asserted).
//
// CONTROL FLOW: every block has a path condition `|pc:B|`, the disjunction
// of its forward edges' conditions (`|e:P:B|` = P's condition and the
// branch's), every phi at a join an `ite` over its predecessors' edges,
// and memory at a join an `ite`-merged function. A call to a trap symbol
// ends its path with the outcome `trap` (the disjunction of the trap
// sites' conditions) and `trap_code`; `result` and `mem2` are merged over
// the `ret` blocks.
//
// LOOPS (S-65). A loop the spec cuts by `(invariant I)` has its header's
// phis and memory as fresh symbols constrained by I, the row `init` (every
// entry edge establishes I), the row `preserve` (every back edge
// re-establishes it), and everything after the loop decided under I and
// the exit edge's condition. I is quantifier-free: a universal it needs is
// written over the section's free symbols, and the writer asserts the
// hypothesis at THOSE symbols and demands the conclusion at the SAME
// symbols -- THE SINGLE-INSTANCE RULE. Sound: a proof of I'(j) from I(j)
// for an arbitrary j is a proof of forall j. I'(j) from forall j. I(j) when
// the step needs I at no other point. Incomplete: a step that needs I at
// another point is `open`, and the spec author adds `(inst j e)`, an extra
// instantiation of the hypothesis at e -- never of the conclusion. A loop
// the spec unwinds by `(unroll N)` is copied by `floor_cfg.npk` (N is the
// most times the back edge is taken); the stop block's condition is a
// hypothesis, the rows depending on it read `[<=N]`, and a loop whose
// bound the translator can prove exact (the row `unroll-exact`, decided
// by z3, never assumed) drops the mark. A loop with neither annotation is
// a refusal by name.
//
// SUMMARIES. A call to a symbol whose section says `(summary)` is not
// inlined: the callee's `requires` is a row at the call (the caller proves
// it), its `ensures` are hypotheses over fresh result symbols, its
// `ensures-trap` joins the caller's trap outcome, and memory after the
// call is a fresh function equal to the memory before outside the
// callee's `frame`, instantiated at the caller's free symbols by name. A
// callee without `(summary)` is inlined by `floor_cfg.npk` before this
// module reads the function.
//
// WHAT THIS MODULE DOES NOT DO, BY DECISION: no ghost variables, no
// quantifiers in any file it writes, no per-row budget, no reading of
// inline asm or `module asm`, no `switch`, no `invoke`, no vector types.
// Every form outside the floor's measured vocabulary is a refusal naming
// the line (`floor: @sym: instruction form not read: ...`).

mod:floor_smt;

use "./text.npk".*;
use "./floor_ir.npk".*;
use "./floor_instr.npk".*;
use "./floor_spec.npk".*;
use "./floor_cfg.npk".*;
use "./floor_kernel.npk".*;               // the kernel-effect table, GENERATED from VERIFICATION_REFERENCE SS9.2 (1.5.6b)
use "../src/backend/smt/smt_writer.npk".*;
use "../lib/nhash.npk".*;
use "./strset.npk".*;

// --- numerals to 128 bits ------------------------------------------------------------------------

pub func:u128_pow2 = uint128(int64:k) never fails {
    uint128:p = 1u128;
    for (int64:i in 0i64...k) { p = p * 2u128; }
    pass p;
};

// The all-ones 128-bit pattern, computed without an overflow: 2^127 - 1 doubled plus one.
func:u128_all_ones = uint128() never fails {
    uint128:h = (raw u128_pow2(127i64)) - 1u128;   // 2^127 - 1
    pass ((h * 2u128) + 1u128);
};

func:u128_mask_of = uint128(int64:bits) never fails {
    if (bits >= 128i64) { pass (raw u128_all_ones()); }
    pass ((raw u128_pow2(bits)) - 1u128);
};

// v mod 2^bits.
func:u128_wrap = uint128(uint128:v, int64:bits) never fails {
    if (bits >= 128i64) { pass v; }
    pass (v % (raw u128_pow2(bits)));
};

// a + b mod 2^bits, without an overflow at 128 bits.
func:u128_add = uint128(uint128:a, uint128:b, int64:bits) never fails {
    if (bits < 128i64) { pass (raw u128_wrap(a + b, bits)); }
    uint128:room = (raw u128_all_ones()) - a;   // the largest b that does not overflow
    if (b <= room) { pass (a + b); }
    pass (b - room - 1u128);
};

// a - b mod 2^bits.
func:u128_sub = uint128(uint128:a, uint128:b, int64:bits) never fails {
    if (a >= b) { pass (raw u128_wrap(a - b, bits)); }
    // a - b + 2^bits
    if (bits < 128i64) { pass (raw u128_wrap(((raw u128_pow2(bits)) - b) + a, bits)); }
    pass (((raw u128_all_ones()) - b) + a + 1u128);
};

// Decimal text of a uint128.
pub func:u128_text = string(uint128:v) never fails {
    if (v == 0u128) { pass "0"; }
    wild int8->:buf = alloc(48i64);
    int64:n = 0i64;
    uint128:x = v;
    while (x > 0u128) decreases x {
        buf[n] = ((x % 10u128) =>! int8) + 48i8;
        n = n + 1i64;
        x = x / 10u128;
    }
    wild int8->:rev = alloc(n);
    for (int64:i in 0i64...n) { rev[i] = buf[n - 1i64 - i]; }
    string:s = string_concat(string_from_bytes(rev, n), "");
    dalloc(rev);
    dalloc(buf);
    pass s;
};

// An IR integer literal (`42`, `-16`, `4358112156723783278`) as the width's
// unsigned pattern; `ok` false for anything else or a magnitude past 128 bits.
pub func:u128_parse = bool(string:s, int64:bits, uint128->:out) never fails {
    if (s.len == 0i64) { pass false; }
    bool:neg = false;
    int64:i = 0i64;
    if (s.ptr[0i64] == 45u8) { neg = true; i = 1i64; }
    if (i >= s.len) { pass false; }
    uint128:v = 0u128;
    uint128:cap = (raw u128_all_ones()) / 10u128;
    while (i < s.len) decreases s.len - i {
        uint8:c = s.ptr[i];
        if (!(raw text_is_digit(c))) { pass false; }
        if (v > cap) { pass false; }
        v = (v * 10u128) + ((c - 48u8) =>! uint128);
        i = i + 1i64;
    }
    if (neg) { v = raw u128_sub(0u128, v, bits); }
    <-out = raw u128_wrap(v, bits);
    pass true;
};

// The bit length of a numeral (0 for 0): the k with 2^(k-1) <= v < 2^k.
func:u128_bitlen = int64(uint128:v) never fails {
    int64:k = 0i64;
    uint128:x = v;
    while (x > 0u128) decreases x { x = x / 2u128; k = k + 1i64; }
    pass k;
};

// Is v a power of two? Then its exponent, else -1.
func:u128_log2 = int64(uint128:v) never fails {
    if (v == 0u128) { pass (0i64 - 1i64); }
    int64:k = 0i64;
    uint128:x = v;
    while ((x % 2u128) == 0u128) decreases x { x = x / 2u128; k = k + 1i64; }
    if (x != 1u128) { pass (0i64 - 1i64); }
    pass k;
};

// --- the layout of the floor's types (x86_64) -----------------------------------------------------
//
// `i1`/`i8` 1, `i32` 4, `i64`/`ptr`/`double` 8, `float` 4, `i128` 16
// (aligned 16), `[N x T]` N copies of T at T's alignment, `{ a, b, ... }`
// each field at its own alignment, the struct's alignment its largest
// field's and its size rounded up to it, a named `%npk.x` its body's.

pub func:ty_align = int64(FloorText->:ft, string:ty) never fails {
    if (raw text_eq(ty, "i1")) { pass 1i64; }
    if (raw text_eq(ty, "i8")) { pass 1i64; }
    if (raw text_eq(ty, "i16")) { pass 2i64; }
    if (raw text_eq(ty, "i32")) { pass 4i64; }
    if (raw text_eq(ty, "i64")) { pass 8i64; }
    if (raw text_eq(ty, "ptr")) { pass 8i64; }
    if (raw text_eq(ty, "double")) { pass 8i64; }
    if (raw text_eq(ty, "float")) { pass 4i64; }
    if (raw text_eq(ty, "i128")) { pass 16i64; }
    if (raw text_starts_with(ty, "[")) { pass (raw ty_align(ft, raw array_elem(ty))); }
    if (raw text_starts_with(ty, "{")) {
        int64:a = 1i64;
        List<string>:fs = raw struct_fields(ty);
        for (int64:i in 0i64...fs.count) {
            int64:fa = raw ty_align(ft, raw strlist_view(fs, i));
            if (fa > a) { a = fa; }
        }
        pass a;
    }
    if (raw text_starts_with(ty, "%")) { pass (raw ty_align(ft, raw floor_type_body(ft, ty))); }
    pass 0i64;
};

func:round_up = int64(int64:v, int64:a) never fails {
    if (a <= 1i64) { pass v; }
    int64:r = v % a;
    if (r == 0i64) { pass v; }
    pass (v + (a - r));
};

pub func:ty_size = int64(FloorText->:ft, string:ty) never fails {
    if (raw text_eq(ty, "i1")) { pass 1i64; }
    if (raw text_eq(ty, "i8")) { pass 1i64; }
    if (raw text_eq(ty, "i16")) { pass 2i64; }
    if (raw text_eq(ty, "i32")) { pass 4i64; }
    if (raw text_eq(ty, "i64")) { pass 8i64; }
    if (raw text_eq(ty, "ptr")) { pass 8i64; }
    if (raw text_eq(ty, "double")) { pass 8i64; }
    if (raw text_eq(ty, "float")) { pass 4i64; }
    if (raw text_eq(ty, "i128")) { pass 16i64; }
    if (raw text_starts_with(ty, "[")) {
        int64:n = raw array_count(ty);
        pass (n * (raw ty_size(ft, raw array_elem(ty))));
    }
    if (raw text_starts_with(ty, "{")) {
        int64:off = 0i64;
        List<string>:fs = raw struct_fields(ty);
        for (int64:i in 0i64...fs.count) {
            string:fty = raw strlist_view(fs, i);
            off = raw round_up(off, raw ty_align(ft, fty));
            off = off + (raw ty_size(ft, fty));
        }
        pass (raw round_up(off, raw ty_align(ft, ty)));
    }
    if (raw text_starts_with(ty, "%")) { pass (raw ty_size(ft, raw floor_type_body(ft, ty))); }
    pass 0i64;
};

// The k-th field's offset and type of a struct type (named or literal).
pub func:struct_field_offset = int64(FloorText->:ft, string:ty, int64:k) never fails {
    string:body = raw text_copy(ty);
    if (raw text_starts_with(ty, "%")) { body = raw floor_type_body(ft, ty); }
    List<string>:fs = raw struct_fields(body);
    int64:off = 0i64;
    for (int64:i in 0i64...fs.count) {
        string:fty = raw strlist_view(fs, i);
        off = raw round_up(off, raw ty_align(ft, fty));
        if (i == k) { pass off; }
        off = off + (raw ty_size(ft, fty));
    }
    pass (0i64 - 1i64);
};

pub func:struct_field_type = string(FloorText->:ft, string:ty, int64:k) never fails {
    string:body = raw text_copy(ty);
    if (raw text_starts_with(ty, "%")) { body = raw floor_type_body(ft, ty); }
    List<string>:fs = raw struct_fields(body);
    if ((k < 0i64) || (k >= fs.count)) { pass ""; }
    pass (raw strlist_copy(fs, k));
};

pub func:is_aggregate_ty = bool(string:ty) never fails {
    if (raw text_starts_with(ty, "{")) { pass true; }
    if (raw text_starts_with(ty, "%")) { pass true; }
    pass false;
};

// --- SMT symbols ---------------------------------------------------------------------------------
//
// A register `%name` is the SMT symbol `name` so a spec spells parameters
// bare (`dst`, `n`); a name SMT-LIB owns (`abs`, `mod`, `store`, `exists`,
// `match`...) or this writer uses (`mem`, `result`, `trap`, `exec`...) is
// spelled `|r:name|` -- a colon is no LLVM identifier character, so the
// spelling cannot collide with another register. Every symbol the writer
// mints for itself carries a colon (`|pc:head|`, `|mem:3|`, `|e:a:b|`).

func:smt_reserved = bool(string:n) never fails {
    if (raw text_eq(n, "abs")) { pass true; }      if (raw text_eq(n, "mod")) { pass true; }
    if (raw text_eq(n, "div")) { pass true; }      if (raw text_eq(n, "rem")) { pass true; }
    if (raw text_eq(n, "and")) { pass true; }      if (raw text_eq(n, "or")) { pass true; }
    if (raw text_eq(n, "not")) { pass true; }      if (raw text_eq(n, "xor")) { pass true; }
    if (raw text_eq(n, "ite")) { pass true; }      if (raw text_eq(n, "let")) { pass true; }
    if (raw text_eq(n, "true")) { pass true; }     if (raw text_eq(n, "false")) { pass true; }
    if (raw text_eq(n, "distinct")) { pass true; } if (raw text_eq(n, "select")) { pass true; }
    if (raw text_eq(n, "store")) { pass true; }    if (raw text_eq(n, "as")) { pass true; }
    if (raw text_eq(n, "par")) { pass true; }      if (raw text_eq(n, "exists")) { pass true; }
    if (raw text_eq(n, "forall")) { pass true; }   if (raw text_eq(n, "match")) { pass true; }
    if (raw text_eq(n, "to_real")) { pass true; }  if (raw text_eq(n, "to_int")) { pass true; }
    if (raw text_eq(n, "is_int")) { pass true; }   if (raw text_eq(n, "fp")) { pass true; }
    if (raw text_eq(n, "bv2nat")) { pass true; }   if (raw text_eq(n, "int2bv")) { pass true; }
    if (raw text_eq(n, "Int")) { pass true; }      if (raw text_eq(n, "Bool")) { pass true; }
    if (raw text_eq(n, "Real")) { pass true; }     if (raw text_eq(n, "Array")) { pass true; }
    if (raw text_eq(n, "RNE")) { pass true; }      if (raw text_eq(n, "NaN")) { pass true; }
    if (raw text_eq(n, "mem")) { pass true; }      if (raw text_eq(n, "mem2")) { pass true; }
    if (raw text_eq(n, "trap")) { pass true; }     if (raw text_eq(n, "trap_code")) { pass true; }
    if (raw text_eq(n, "result")) { pass true; }   if (raw text_eq(n, "exec")) { pass true; }
    if (raw text_eq(n, "tls")) { pass true; }      if (raw text_eq(n, "sys")) { pass true; }
    if (raw text_eq(n, "assert")) { pass true; }   if (raw text_eq(n, "check-sat")) { pass true; }
    if (raw text_eq(n, "push")) { pass true; }     if (raw text_eq(n, "pop")) { pass true; }
    if (raw text_eq(n, "implies")) { pass true; }  if (raw text_eq(n, "_")) { pass true; }
    pass false;
};

func:is_simple_sym = bool(string:n) never fails {
    if (n.len == 0i64) { pass false; }
    if (raw text_is_digit(n.ptr[0i64])) { pass false; }
    for (int64:i in 0i64...n.len) {
        uint8:c = n.ptr[i];
        bool:ok = false;
        if ((c >= 97u8) && (c <= 122u8)) { ok = true; }
        if ((c >= 65u8) && (c <= 90u8)) { ok = true; }
        if ((c >= 48u8) && (c <= 57u8)) { ok = true; }
        if ((c == 95u8) || (c == 46u8) || (c == 36u8)) { ok = true; }   // _ . $
        if (!ok) { pass false; }
    }
    pass true;
};

// The SMT symbol of the IR name `%name` / `@name`.
pub func:sym_of_ir = string(string:ir) never fails {
    string:n = raw text_slice(ir, 1i64, ir.len);
    if (ir.len == 0i64) { pass ""; }
    if ((ir.ptr[0i64] != 37u8) && (ir.ptr[0i64] != 64u8)) { n = raw text_copy(ir); }
    if ((raw smt_reserved(n)) || (!(raw is_simple_sym(n)))) {
        string:q = string_concat("|r:", n);
        pass (string_concat(q, "|"));
    }
    pass n;
};

// The registers and free symbols a spec may name: the bare spelling of `sym_of_ir`.
pub func:spec_sym = string(string:bare) never fails {
    if ((raw smt_reserved(bare)) || (!(raw is_simple_sym(bare)))) {
        string:q = string_concat("|r:", bare);
        pass (string_concat(q, "|"));
    }
    pass (raw text_copy(bare));
};

// --- terms -----------------------------------------------------------------------------------------

// A value's SMT text with what the translator knows of it: its sort
// (`Int`, `Bool`, `F64`, `F32`), whether it is a numeral (then its value
// and width), and two shape facts the `or` reading uses -- the term is a
// shift left by `shl_k` (or -1), the term is known below 2^`lt_k`.
pub struct:Term = {
    bool:ok;
    string:text;
    string:sort;
    bool:is_num;
    uint128:num;
    int64:bits;
    int64:shl_k;
    int64:lt_k;
    string:div_root;    // `(div ROOT div_by)`: a chain of unsigned divisions by numerals folded ("" for none)
    uint128:div_by;
    string:lin_root;    // `ROOT + parts + lin_off` wrapped once: a chain of additions and address computations folded ("" for none)
    uint128:lin_off;
    string:lin_parts;   // the symbolic parts of that sum, space-joined (`pos`, `(* 8 ci)`; "" for none)
    string:tbl_global;  // an element address into a constant table: the global's IR name ("" for none)
    string:tbl_idx;     // the index term
    int64:tbl_scale;    // the element size
};

func:term_none = Term() never fails {
    pass Term{ ok: false, text: "", sort: "", is_num: false, num: 0u128, bits: 0i64, shl_k: 0i64 - 1i64, lt_k: 0i64 - 1i64, div_root: "", div_by: 0u128, lin_root: "", lin_off: 0u128, lin_parts: "", tbl_global: "", tbl_idx: "", tbl_scale: 0i64 };
};

pub func:term_copy = Term(Term:t) never fails {
    pass Term{ ok: t.ok, text: raw text_copy(raw strlist_view_of(t.text)), sort: raw text_copy(raw strlist_view_of(t.sort)),
               is_num: t.is_num, num: t.num, bits: t.bits, shl_k: t.shl_k, lt_k: t.lt_k,
               div_root: raw text_copy(raw strlist_view_of(t.div_root)), div_by: t.div_by,
               lin_root: raw text_copy(raw strlist_view_of(t.lin_root)), lin_off: t.lin_off, lin_parts: raw text_copy(raw strlist_view_of(t.lin_parts)),
               tbl_global: raw text_copy(raw strlist_view_of(t.tbl_global)), tbl_idx: raw text_copy(raw strlist_view_of(t.tbl_idx)), tbl_scale: t.tbl_scale };
};

func:term_int = Term(string:text, int64:bits) never fails {
    pass Term{ ok: true, text: raw text_copy(text), sort: "Int", is_num: false, num: 0u128, bits: bits, shl_k: 0i64 - 1i64, lt_k: bits, div_root: "", div_by: 0u128, lin_root: "", lin_off: 0u128, lin_parts: "", tbl_global: "", tbl_idx: "", tbl_scale: 0i64 };
};

func:term_bool = Term(string:text) never fails {
    pass Term{ ok: true, text: raw text_copy(text), sort: "Bool", is_num: false, num: 0u128, bits: 1i64, shl_k: 0i64 - 1i64, lt_k: 0i64 - 1i64, div_root: "", div_by: 0u128, lin_root: "", lin_off: 0u128, lin_parts: "", tbl_global: "", tbl_idx: "", tbl_scale: 0i64 };
};

func:term_num = Term(uint128:v, int64:bits) never fails {
    pass Term{ ok: true, text: raw u128_text(v), sort: "Int", is_num: true, num: v, bits: bits, shl_k: 0i64 - 1i64, lt_k: raw u128_bitlen(v), div_root: "", div_by: 0u128, lin_root: "", lin_off: 0u128, lin_parts: "", tbl_global: "", tbl_idx: "", tbl_scale: 0i64 };
};

func:term_fp = Term(string:text, int64:bits) never fails {
    string:sort = "F64";
    if (bits == 32i64) { sort = "F32"; }
    pass Term{ ok: true, text: raw text_copy(text), sort: move(sort), is_num: false, num: 0u128, bits: bits, shl_k: 0i64 - 1i64, lt_k: 0i64 - 1i64, div_root: "", div_by: 0u128, lin_root: "", lin_off: 0u128, lin_parts: "", tbl_global: "", tbl_idx: "", tbl_scale: 0i64 };
};

pub func:sort_text = string(string:sort) never fails {
    if (raw text_eq(sort, "F64")) { pass "(_ FloatingPoint 11 53)"; }
    if (raw text_eq(sort, "F32")) { pass "(_ FloatingPoint 8 24)"; }
    pass (raw text_copy(sort));
};

// `iN` -> N; `ptr` -> 64; `double` -> 64; `float` -> 32; else 0.
pub func:ty_bits = int64(string:ty) never fails {
    if (raw text_eq(ty, "ptr")) { pass 64i64; }
    if (raw text_eq(ty, "double")) { pass 64i64; }
    if (raw text_eq(ty, "float")) { pass 32i64; }
    pass (raw int_width(ty));
};

pub func:ty_sort = string(string:ty) never fails {
    if (raw text_eq(ty, "i1")) { pass "Bool"; }
    if (raw text_eq(ty, "double")) { pass "F64"; }
    if (raw text_eq(ty, "float")) { pass "F32"; }
    if (raw text_eq(ty, "ptr")) { pass "Int"; }
    if ((raw int_width(ty)) > 0i64) { pass "Int"; }
    pass "";
};

// --- the translation state --------------------------------------------------------------------

pub struct:Tx = {
    string:fn;                       // `@memcpy`
    List<string>:defs;               // the SMT lines that declare or define a symbol, in order
    List<string>:def_names;          // the symbol each line introduces
    List<List<string>>:def_refs;     // the symbols each definition references
    List<string>:hyps;               // asserted facts (text)
    List<List<string>>:hyp_syms;     // the symbols each mentions
    List<string>:hyp_tags;           // `range`, `requires`, `invariant:LABEL`, `stop:LABEL`, `summary:@f`...
    List<int64>:hyp_bounds;          // the bound a `stop` hypothesis carries, else 0
    List<string>:row_sites;          // `spec:ensures:1`...
    List<string>:row_goals;
    List<string>:row_excl;           // a hypothesis tag the row's cone must not include ("" for none)
    StrSet:known;                    // every symbol introduced (for the reference scanner)
    // registers: IR name -> SMT symbol, sort, width (aggregates as `%a.0`...)
    List<string>:reg_ir;
    List<string>:reg_sym;
    List<string>:reg_sort;
    List<int64>:reg_bits;
    List<bool>:reg_is_num;           // the register's value is a known numeral (a folded chain)
    List<uint128>:reg_num;
    List<int64>:reg_shl_k;           // the shape facts a term carries, kept across the register (the `or` reading)
    List<int64>:reg_lt_k;
    List<string>:reg_div_root;       // the folded division chain a register is (`div_root`, `div_by`)
    List<uint128>:reg_div_by;
    List<string>:reg_lin_root;       // the folded addition chain a register is (`lin_root`, `lin_parts`, `lin_off`)
    List<uint128>:reg_lin_off;
    List<string>:reg_lin_parts;
    List<string>:reg_tbl_global;     // the constant-table element a register addresses (`tbl_global`, `tbl_idx`, `tbl_scale`)
    List<string>:reg_alias;          // a register defined as another symbol reads as that symbol ("" for none) -- the two sides of a claim then match term for term
    List<string>:reg_tbl_idx;
    List<int64>:reg_tbl_scale;
    // LOOP OBJECTS (1.5.6 step 4): the ranges a `(loop L (objects ...))` clause
    // names, live across the loop under the header's path condition -- an
    // allocation inside the loop is disjoint from them, and a call's frame
    // over `objects` leaves them unchanged
    List<string>:lobj_lo;
    List<string>:lobj_len;
    List<string>:lobj_pc;
    // TABLE VALUES (1.5.6 step 4): the `ite` a constant-table load reads as,
    // by its exact text -- a division by it distributes over the cases
    List<string>:tv_text;
    List<string>:tv_idx;
    List<List<string>>:tv_vals;
    List<string>:tv_sym;
    // THE CROSSING AS A SYMBOL (1.5.6 step 4): each `bv2nat (bvop ...)` text once,
    // as `|bv:N|` with its equation a `bv`-tagged hypothesis -- a row whose goal
    // names no crossing is decided with the crossed values opaque (the int tier)
    List<string>:cx_text;
    List<string>:cx_sym;
    List<string>:wr_text;            // a wrapped computation is ONE named symbol `|w:N|` (`tx_wrap`): the memo by the wrapped text
    List<string>:wr_sym;
    List<string>:rb_text;            // the body of every register that reads as its NAME (no alias): a clause rendering that text reads as the register (`reg_of_text`)
    List<string>:rb_sym;
    // what a defined symbol reaches, transitively (memoised): a hypothesis is
    // about everything its symbols are made of
    List<string>:tr_name;
    List<List<string>>:tr_syms;
    // blocks (by index in the transformed function)
    List<string>:blk_pc;
    List<string>:blk_mem_in;
    List<string>:blk_mem_out;
    List<bool>:blk_ended;            // a trap or a stop ended it: no successors
    List<bool>:blk_done;
    int64:mem_n;
    int64:tmp_n;
    List<string>:mem_apps;           // memory applications seen (for the range axioms), unique
    List<string>:trap_pcs;
    List<string>:trap_codes;
    List<string>:summary_traps;      // the trap conditions summary callees contributed (a caller's clause describes its OWN traps)
    List<string>:fresh_blocks;       // (result, len) texts of every fresh allocation so far: two are disjoint
    List<string>:fresh_lens;
    List<string>:fresh_guards;       // the path condition of each allocation
    List<string>:ret_pcs;
    List<string>:ret_mems;
    List<List<string>>:ret_vals;     // per ret block: its field texts (one for a scalar)
    string:ret_ty;
    bool:nonlinear;
    bool:uses_fp;
    bool:uses_bv;
    List<string>:problems;
    List<string>:free_syms;          // the section's declared free symbols (bare)
    List<string>:addr_syms;          // those declared `Addr`: within the address space
    List<string>:objects;            // the address symbols of the globals and allocas touched
    List<int64>:object_sizes;
    List<string>:globals_ir;         // `@name` for each registered global
    // MEMORY TEMPLATES (1.5.6 step 4): what a summary call, a memory intrinsic
    // or a syscall promises of the memory function it introduces, at ANY point
    // `|pt|` -- instantiated after the translation at every point the file
    // applies that function to (`tx_instantiate_templates`)
    List<string>:mt_mem;             // the memory function the template describes
    List<string>:mt_prev;            // the memory before it
    List<string>:mt_guard;           // the path condition of the call
    List<string>:mt_unchanged;       // the condition over `|pt|` under which the byte is unchanged ("" for none)
    List<string>:mt_value_when;      // the condition over `|pt|` under which the byte has a value ("" for none)
    List<string>:mt_value;           // that value, over `|pt|`
    List<string>:mem_syms;           // every memory function introduced, for the application scan
    // INVARIANT TEMPLATES (1.5.6 step 4): an invariant over an Addr free
    // symbol, rendered with the symbol as `|pt|`, instantiated at every point
    // the file applies the loop's memory to (the single-instance rule's
    // generalisation: the reads of the body are the points that matter)
    List<string>:it_mem;             // the loop's memory at the header
    List<string>:it_guard;           // the header's path condition
    List<string>:it_tag;             // the hypothesis tag (the init row excludes it)
    List<int64>:it_inv;              // the invariant clause node
    List<int64>:it_lclause;          // its loop clause
    List<int64>:it_blk;              // the header block (its rename environment)
    List<string>:it_cm;              // what `mem` renders as there
    List<string>:it_sym;             // the Addr free symbol the instance reads as the point
    string:narrow;                   // a summary call's no-trap condition, folded into the block's path condition after the call ("" for none)
    // STORE-TO-LOAD FORWARDING (1.5.6 step 4): what each defined memory
    // function is -- a store of `size` bytes of `val` at `addr` over `prev`
    // (guarded by `guard`, "true" for a plain store), or a merge of `mems`
    // under `edges` -- so a load at the same address text is the value itself
    // and the solver never reassembles a word it has just seen stored
    List<string>:st_name;
    List<string>:st_prev;
    List<string>:st_addr;
    List<int64>:st_size;
    List<string>:st_val;
    List<string>:st_guard;
    List<string>:mg_name;
    List<List<string>>:mg_edges;
    List<List<string>>:mg_mems;
    List<string>:ld_mem;             // the forwarded loads already named, by (memory, address, size)
    List<string>:ld_addr;
    List<int64>:ld_size;
    List<string>:ld_sym;
    // THE CALLER'S OBJECTS (`(objects (lo len) ...)`): the byte ranges its
    // parameters name, which a fresh allocation is disjoint from and preserves
    List<string>:obj_lo;
    List<string>:obj_len;
    bool:used_opaque;                // an opaque call was met: the section must carry a residue sentence
    bool:used_sys;                   // `sys` is declared
    bool:used_ctpop;                 // `ctpop64` is declared (1.5.6b step 1)
};

pub func:tx_init = Tx(string:fn) never fails {
    pass Tx{ fn: raw text_copy(fn),
             defs: raw list_init::<string>(128i64), def_names: raw list_init::<string>(128i64),
             def_refs: raw list_init::<List<string>>(128i64),
             hyps: raw list_init::<string>(64i64), hyp_syms: raw list_init::<List<string>>(64i64),
             hyp_tags: raw list_init::<string>(64i64), hyp_bounds: raw list_init::<int64>(64i64),
             row_sites: raw list_init::<string>(8i64), row_goals: raw list_init::<string>(8i64),
             row_excl: raw list_init::<string>(8i64),
             known: raw strset_init(256i64),
             reg_ir: raw list_init::<string>(64i64), reg_sym: raw list_init::<string>(64i64),
             reg_sort: raw list_init::<string>(64i64), reg_bits: raw list_init::<int64>(64i64),
             reg_is_num: raw list_init::<bool>(64i64), reg_num: raw list_init::<uint128>(64i64),
             reg_shl_k: raw list_init::<int64>(64i64), reg_lt_k: raw list_init::<int64>(64i64),
             reg_div_root: raw list_init::<string>(64i64), reg_div_by: raw list_init::<uint128>(64i64),
             reg_lin_root: raw list_init::<string>(64i64), reg_lin_off: raw list_init::<uint128>(64i64), reg_lin_parts: raw list_init::<string>(64i64),
             reg_tbl_global: raw list_init::<string>(64i64), reg_tbl_idx: raw list_init::<string>(64i64), reg_tbl_scale: raw list_init::<int64>(64i64),
             reg_alias: raw list_init::<string>(64i64),
             lobj_lo: raw list_init::<string>(4i64), lobj_len: raw list_init::<string>(4i64), lobj_pc: raw list_init::<string>(4i64),
             tv_text: raw list_init::<string>(8i64), tv_idx: raw list_init::<string>(8i64), tv_vals: raw list_init::<List<string>>(8i64), tv_sym: raw list_init::<string>(8i64),
             cx_text: raw list_init::<string>(8i64), cx_sym: raw list_init::<string>(8i64),
             wr_text: raw list_init::<string>(16i64), wr_sym: raw list_init::<string>(16i64),
             rb_text: raw list_init::<string>(32i64), rb_sym: raw list_init::<string>(32i64),
             tr_name: raw list_init::<string>(64i64), tr_syms: raw list_init::<List<string>>(64i64),
             blk_pc: raw list_init::<string>(16i64), blk_mem_in: raw list_init::<string>(16i64),
             blk_mem_out: raw list_init::<string>(16i64), blk_ended: raw list_init::<bool>(16i64),
             blk_done: raw list_init::<bool>(16i64),
             mem_n: 0i64, tmp_n: 0i64, mem_apps: raw list_init::<string>(64i64),
             trap_pcs: raw list_init::<string>(4i64), trap_codes: raw list_init::<string>(4i64),
             summary_traps: raw list_init::<string>(4i64),
             fresh_blocks: raw list_init::<string>(4i64), fresh_lens: raw list_init::<string>(4i64), fresh_guards: raw list_init::<string>(4i64),
             ret_pcs: raw list_init::<string>(4i64), ret_mems: raw list_init::<string>(4i64),
             ret_vals: raw list_init::<List<string>>(4i64), ret_ty: "",
             nonlinear: false, uses_fp: false, uses_bv: false,
             problems: raw list_init::<string>(4i64), free_syms: raw list_init::<string>(4i64), addr_syms: raw list_init::<string>(4i64),
             objects: raw list_init::<string>(8i64), object_sizes: raw list_init::<int64>(8i64),
             globals_ir: raw list_init::<string>(8i64),
             mt_mem: raw list_init::<string>(8i64), mt_prev: raw list_init::<string>(8i64),
             mt_guard: raw list_init::<string>(8i64), mt_unchanged: raw list_init::<string>(8i64),
             mt_value_when: raw list_init::<string>(8i64), mt_value: raw list_init::<string>(8i64),
             mem_syms: raw list_init::<string>(16i64),
             st_name: raw list_init::<string>(16i64), st_prev: raw list_init::<string>(16i64),
             st_addr: raw list_init::<string>(16i64), st_size: raw list_init::<int64>(16i64),
             st_val: raw list_init::<string>(16i64), st_guard: raw list_init::<string>(16i64),
             mg_name: raw list_init::<string>(8i64), mg_edges: raw list_init::<List<string>>(8i64),
             mg_mems: raw list_init::<List<string>>(8i64),
             ld_mem: raw list_init::<string>(32i64), ld_addr: raw list_init::<string>(32i64),
             ld_size: raw list_init::<int64>(32i64), ld_sym: raw list_init::<string>(32i64),
             obj_lo: raw list_init::<string>(4i64), obj_len: raw list_init::<string>(4i64),
             it_mem: raw list_init::<string>(4i64), it_guard: raw list_init::<string>(4i64), it_tag: raw list_init::<string>(4i64),
             it_inv: raw list_init::<int64>(4i64), it_lclause: raw list_init::<int64>(4i64), it_blk: raw list_init::<int64>(4i64), it_cm: raw list_init::<string>(4i64), it_sym: raw list_init::<string>(4i64),
             narrow: "", used_opaque: false, used_sys: false, used_ctpop: false };
};

pub func:tx_problem = NIL(Tx->:t, string:why) never fails {
    string:m = string_concat("floor: ", raw strlist_view_of(t.fn));
    m = string_concat(m, ": ");
    m = string_concat(m, why);
    drop strlist_push(@t.problems, m);
    pass NIL;
};

// --- the symbol scanner -----------------------------------------------------------------------
//
// Every symbol of `text` that the translation introduced: a `|...|` quoted
// token, or a run of symbol characters, that `known` lists. The cones are
// computed from these sets.

func:is_sym_char = bool(uint8:c) never fails {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }
    if ((c >= 65u8) && (c <= 90u8)) { pass true; }
    if ((c >= 48u8) && (c <= 57u8)) { pass true; }
    if ((c == 95u8) || (c == 46u8) || (c == 36u8) || (c == 64u8) || (c == 35u8) || (c == 45u8)) { pass true; }   // _ . $ @ # -
    pass false;
};

pub func:syms_in = List<string>(Tx->:t, string:text) never fails {
    List<string>:out = raw list_init::<string>(8i64);
    int64:i = 0i64;
    while (i < text.len) decreases text.len - i {
        uint8:c = text.ptr[i];
        if (c == 124u8) {   // |quoted|
            int64:j = i + 1i64;
            while ((j < text.len) && (text.ptr[j] != 124u8)) decreases text.len - j { j = j + 1i64; }
            if (j < text.len) {
                string:q = raw text_slice(text, i, j + 1i64);
                if ((raw strset_has(t.known, q)) && (!(raw strlist_contains(out, q)))) { drop strlist_push(@out, q); }
                i = j + 1i64;
                continue;
            }
            i = i + 1i64;
            continue;
        }
        if (raw is_sym_char(c)) {
            int64:k = i;
            while ((k < text.len) && (raw is_sym_char(text.ptr[k]))) decreases text.len - k { k = k + 1i64; }
            string:w = raw text_slice(text, i, k);
            if (!(raw text_is_digit(w.ptr[0i64]))) {
                if ((raw strset_has(t.known, w)) && (!(raw strlist_contains(out, w)))) { drop strlist_push(@out, w); }
            }
            i = k;
            continue;
        }
        i = i + 1i64;
    }
    pass out;
};

// --- introducing symbols ----------------------------------------------------------------------

func:tx_known = NIL(Tx->:t, string:sym) never fails {
    discard(raw strset_add(@t.known, sym));
    pass NIL;
};

// `(define-fun NAME () SORT TEXT)`.
pub func:tx_define = NIL(Tx->:t, string:name, string:sort, string:text) never fails {
    string:l = string_concat("(define-fun ", name);
    l = string_concat(l, " () ");
    l = string_concat(l, raw sort_text(sort));
    l = string_concat(l, " ");
    l = string_concat(l, text);
    l = string_concat(l, ")");
    List<string>:refs = raw syms_in(t, text);
    drop strlist_push(@t.defs, l);
    drop strlist_push(@t.def_names, name);
    drop list_push(@t.def_refs, move(refs));
    drop tx_known(t, name);
    pass NIL;
};

// `(declare-const NAME SORT)`.
pub func:tx_declare = NIL(Tx->:t, string:name, string:sort) never fails {
    string:l = string_concat("(declare-const ", name);
    l = string_concat(l, " ");
    l = string_concat(l, raw sort_text(sort));
    l = string_concat(l, ")");
    drop strlist_push(@t.defs, l);
    drop strlist_push(@t.def_names, name);
    drop list_push(@t.def_refs, raw list_init::<string>(1i64));
    drop tx_known(t, name);
    pass NIL;
};

// A memory function: declared fresh, or defined pointwise over another.
pub func:tx_mem_declare = NIL(Tx->:t, string:name) never fails {
    string:l = string_concat("(declare-fun ", name);
    l = string_concat(l, " (Int) Int)");
    drop strlist_push(@t.defs, l);
    drop strlist_push(@t.def_names, name);
    drop list_push(@t.def_refs, raw list_init::<string>(1i64));
    drop tx_known(t, name);
    drop strlist_push(@t.mem_syms, name);
    pass NIL;
};

pub func:tx_mem_define = NIL(Tx->:t, string:name, string:body) never fails {
    string:l = string_concat("(define-fun ", name);
    l = string_concat(l, " ((|m:x| Int)) Int ");
    l = string_concat(l, body);
    l = string_concat(l, ")");
    List<string>:refs = raw syms_in(t, body);
    drop strlist_push(@t.defs, l);
    drop strlist_push(@t.def_names, name);
    drop list_push(@t.def_refs, move(refs));
    drop tx_known(t, name);
    drop strlist_push(@t.mem_syms, name);
    pass NIL;
};

// Every symbol the definition of `sym` reaches, transitively (memoised);
// control symbols (`|pc:`, `|e:`) are not crossed -- the cone's backward pass
// walks the graph itself, and a sink's hypothesis names its reach explicitly.
func:trans_refs = List<string>(Tx->:t, string:sym) never fails {
    for (int64:m in 0i64...t.tr_name.count) {
        if (raw text_eq(raw strlist_view(t.tr_name, m), sym)) { pass (raw strlist_clone(t.tr_syms[m])); }
    }
    List<string>:out = raw list_init::<string>(8i64);
    StrSet:seen = raw strset_init(32i64);
    List<string>:work = raw list_init::<string>(8i64);
    drop strlist_push(@work, sym);
    int64:w = 0i64;
    // a worklist of symbols: a symbol is pushed by its definition and taken once (`seen`), and the definitions are finite (D-316)
    while (w < work.count) unbounded {
        string:cur = raw strlist_copy(work, w);
        w = w + 1i64;
        if (!(raw strset_add(@seen, cur))) { continue; }
        if (raw text_starts_with(cur, "|pc:") || raw text_starts_with(cur, "|e:")) { continue; }
        if (raw strlist_contains(t.mem_syms, cur)) { continue; }
        if (w > 1i64) { drop strlist_push(@out, cur); }
        for (int64:d in 0i64...t.def_names.count) {
            if (!(raw text_eq(raw strlist_view(t.def_names, d), cur))) { continue; }
            for (int64:r in 0i64...t.def_refs[d].count) { drop strlist_push(@work, raw strlist_view(t.def_refs[d], r)); }
            break;
        }
    }
    drop strset_free(@seen);
    drop strlist_push(@t.tr_name, sym);
    drop list_push(@t.tr_syms, raw strlist_clone(out));
    pass out;
};

pub func:tx_hyp = NIL(Tx->:t, string:text, string:tag, int64:bound) never fails {
    List<string>:syms = raw syms_in(t, text);
    // A HYPOTHESIS IS ABOUT WHAT ITS SYMBOLS ARE MADE OF: a fact over a defined
    // symbol (a load's word, a crossing) joins a cone that names anything its
    // definition reaches -- the backward pass from a goal never meets it else
    int64:n0 = syms.count;
    for (int64:i in 0i64...n0) {
        if (raw text_starts_with(raw strlist_view(syms, i), "|pc:") || raw text_starts_with(raw strlist_view(syms, i), "|e:")) { continue; }
        List<string>:more = raw trans_refs(t, raw strlist_view(syms, i));
        for (int64:k in 0i64...more.count) {
            if (!(raw strlist_contains(syms, raw strlist_view(more, k)))) { drop strlist_push(@syms, raw strlist_view(more, k)); }
        }
    }
    // A MEMORY FUNCTION IS NO SHARED SYMBOL: `mem` and its successors stand in
    // nearly every hypothesis, so sharing one would put the whole file in every
    // cone -- a memory fact is about the ADDRESSES it applies the function to,
    // and those relate it to a goal
    List<string>:kept = raw list_init::<string>(syms.count + 1i64);
    for (int64:q in 0i64...syms.count) {
        if (raw strlist_contains(t.mem_syms, raw strlist_view(syms, q))) { continue; }
        drop strlist_push(@kept, raw strlist_view(syms, q));
    }
    syms = move(kept);
    drop strlist_push(@t.hyps, text);
    drop list_push(@t.hyp_syms, move(syms));
    drop strlist_push(@t.hyp_tags, tag);
    drop list_push(@t.hyp_bounds, bound);
    pass NIL;
};

// The last hypothesis is about every symbol the definition of `sym` reaches
// (transitively), so a cone that names any of them includes it.
pub func:tx_hyp_reaches = NIL(Tx->:t, string:sym) never fails {
    if (t.hyps.count == 0i64) { pass NIL; }
    // two levels: the stop's edge, and that edge's path condition and exit
    // test -- the symbols a row about the loop's exit values reaches; deeper
    // would put the hypothesis in every cone of the file
    StrSet:seen = raw strset_init(64i64);
    List<string>:work = raw list_init::<string>(16i64);
    List<int64>:depth = raw list_init::<int64>(16i64);
    drop strlist_push(@work, sym);
    drop list_push(@depth, 0i64);
    int64:w = 0i64;
    // a worklist of symbols two definitions deep: a symbol is taken once (`seen`), and the definitions are finite (D-316)
    while (w < work.count) unbounded {
        string:cur = raw strlist_copy(work, w);
        int64:dp = depth[w];
        w = w + 1i64;
        if (!(raw strset_add(@seen, cur))) { continue; }
        if (dp >= 2i64) { continue; }
        for (int64:d in 0i64...t.def_names.count) {
            if (!(raw text_eq(raw strlist_view(t.def_names, d), cur))) { continue; }
            for (int64:r in 0i64...t.def_refs[d].count) { drop strlist_push(@work, raw strlist_view(t.def_refs[d], r)); drop list_push(@depth, dp + 1i64); }
            break;
        }
    }
    int64:last = t.hyps.count - 1i64;
    for (int64:k in 0i64...raw strset_count(seen)) {
        string:s2 = raw strset_key(seen, k);
        if (!(raw strlist_contains(t.hyp_syms[last], s2))) { drop strlist_push(@t.hyp_syms[last], s2); }
    }
    drop strset_free(@seen);
    pass NIL;
};

pub func:tx_row = NIL(Tx->:t, string:site, string:goal) never fails {
    drop strlist_push(@t.row_sites, site);
    drop strlist_push(@t.row_goals, goal);
    drop strlist_push(@t.row_excl, "");
    pass NIL;
};

// A fresh writer symbol `|PREFIX:N|`.
func:tx_fresh = string(Tx->:t, string:prefix) never fails {
    t.tmp_n = t.tmp_n + 1i64;
    string:s = string_concat("|", prefix);
    s = string_concat(s, ":");
    s = string_concat(s, int_to_string(t.tmp_n));
    pass (string_concat(s, "|"));
};

// The range axiom of an Int symbol of `bits` bits (unsigned reading).
func:tx_range = NIL(Tx->:t, string:sym, int64:bits) never fails {
    drop tx_hyp(t, raw smt_range_axiom(sym, bits =>! int32, false), "range", 0i64);
    pass NIL;
};

// A memory application, its range axiom recorded once.
pub func:tx_mem_app = string(Tx->:t, string:memsym, string:addr) never fails {
    string:app = raw smt_app1(memsym, addr);
    if (!(raw strlist_contains(t.mem_apps, app))) {
        drop strlist_push(@t.mem_apps, app);
        drop tx_hyp(t, raw smt_app2("and", raw smt_app2("<=", "0", app), raw smt_app2("<", app, "256")), "range", 0i64);
    }
    pass app;
};

// --- memory applications and templates (1.5.6 step 4) ---------------------------------------------

// Every application `(M A)` of a memory function in `text`, as `M` and `A`
// texts, appended to the two lists; `A` is the balanced term after the name.
func:apps_in = NIL(Tx->:t, string:text, List<string>->:ms, List<string>->:ats) never fails {
    int64:i = 0i64;
    while (i < text.len) decreases text.len - i {
        if (text.ptr[i] != 40u8) { i = i + 1i64; continue; }   // (
        // the head token
        int64:j = i + 1i64;
        if (j < text.len) {
            if (text.ptr[j] == 124u8) {   // |quoted|
                int64:k = j + 1i64;
                while ((k < text.len) && (text.ptr[k] != 124u8)) decreases text.len - k { k = k + 1i64; }
                if (k < text.len) { j = k + 1i64; }
            } else {
                while ((j < text.len) && (raw is_sym_char(text.ptr[j]))) decreases text.len - j { j = j + 1i64; }
            }
        }
        string:head = raw text_slice(text, i + 1i64, j);
        if ((head.len > 0i64) && (raw strlist_contains(t.mem_syms, head))) {
            // one argument: a balanced term, then `)`
            int64:a = j;
            while ((a < text.len) && (text.ptr[a] == 32u8)) decreases text.len - a { a = a + 1i64; }
            int64:e = a;
            int64:depth = 0i64;
            bool:quoted = false;
            while (e < text.len) decreases text.len - e {
                uint8:c = text.ptr[e];
                if (c == 124u8) { quoted = !quoted; }
                if (!quoted) {
                    if (c == 40u8) { depth = depth + 1i64; }
                    if (c == 41u8) { if (depth == 0i64) { break; } depth = depth - 1i64; }
                    if ((c == 32u8) && (depth == 0i64)) { break; }
                }
                e = e + 1i64;
            }
            if (e > a) {
                drop strlist_push(ms, head);
                drop strlist_push(ats, raw text_slice(text, a, e));
            }
        }
        i = i + 1i64;
    }
    pass NIL;
};

// The range axiom of every memory application in `text`, recorded once each.
pub func:tx_note_apps = NIL(Tx->:t, string:text) never fails {
    List<string>:ms = raw list_init::<string>(4i64);
    List<string>:ats = raw list_init::<string>(4i64);
    drop apps_in(t, text, @ms, @ats);
    for (int64:i in 0i64...ms.count) { discard(raw tx_mem_app(t, raw strlist_view(ms, i), raw strlist_view(ats, i))); }
    pass NIL;
};

// A template over the point `|pt|`: under `guard`, the byte of `mem` at a
// point satisfying `unchanged` equals `prev`'s, and at a point satisfying
// `value_when` equals `value`.
func:tx_template = NIL(Tx->:t, string:mem, string:prev, string:guard, string:unchanged, string:value_when, string:value) never fails {
    drop strlist_push(@t.mt_mem, mem);
    drop strlist_push(@t.mt_prev, prev);
    drop strlist_push(@t.mt_guard, guard);
    drop strlist_push(@t.mt_unchanged, unchanged);
    drop strlist_push(@t.mt_value_when, value_when);
    drop strlist_push(@t.mt_value, value);
    pass NIL;
};

// The template's facts at the point `a` (the token `|pt|` replaced), as hypotheses.
func:tx_template_at = NIL(Tx->:t, int64:ti, string:a) never fails {
    string:mem = raw strlist_view(t.mt_mem, ti);
    string:prev = raw strlist_view(t.mt_prev, ti);
    string:guard = raw strlist_view(t.mt_guard, ti);
    string:unch = raw strlist_view(t.mt_unchanged, ti);
    string:vw = raw strlist_view(t.mt_value_when, ti);
    string:val = raw strlist_view(t.mt_value, ti);
    string:app = raw tx_mem_app(t, mem, a);
    if (unch.len > 0i64) {
        string:cond = raw text_replace_all(unch, "|pt|", a);
        string:papp = raw tx_mem_app(t, prev, a);
        drop tx_hyp(t, raw smt_app2("=>", raw smt_app2("and", guard, cond), raw smt_app2("=", app, papp)), "template", 0i64);
    }
    if (vw.len > 0i64) {
        string:cond2 = raw text_replace_all(vw, "|pt|", a);
        string:v2 = raw text_replace_all(val, "|pt|", a);
        drop tx_note_apps(t, v2);
        drop tx_hyp(t, raw smt_app2("=>", raw smt_app2("and", guard, cond2), raw smt_app2("=", app, v2)), "template", 0i64);
    }
    // when the call did not happen, the byte is whatever it was
    string:papp2 = raw tx_mem_app(t, prev, a);
    drop tx_hyp(t, raw smt_app2("=>", raw smt_app1("not", guard), raw smt_app2("=", app, papp2)), "template", 0i64);
    pass NIL;
};

// INSTANTIATION AT EVERY POINT (the record's rule): after the translation and
// the section's rows, each template's facts are asserted at every point its
// memory function is applied to anywhere in the file -- a definition, a
// hypothesis, a goal -- and at every point that REACHES it: an instance
// applies the previous memory at the same point, and a pointwise definition
// applied at a point applies every memory its body applies at that point (a
// store's or a merge's body applies them at its bound variable `|m:x|`, which
// is no point of its own). A worklist over (memory, point) pairs, each once.
pub func:tx_instantiate_templates = NIL(Tx->:t, FloorText->:ft, Sxs->:s, XFn->:x) never fails {
    if ((t.mt_mem.count == 0i64) && (t.it_mem.count == 0i64)) { pass NIL; }
    StrSet:done = raw strset_init(64i64);
    List<string>:ms = raw list_init::<string>(64i64);
    List<string>:ats = raw list_init::<string>(64i64);
    for (int64:d in 0i64...t.defs.count) { drop apps_in(t, raw strlist_view(t.defs, d), @ms, @ats); }
    for (int64:h in 0i64...t.hyps.count) { drop apps_in(t, raw strlist_view(t.hyps, h), @ms, @ats); }
    for (int64:g in 0i64...t.row_goals.count) { drop apps_in(t, raw strlist_view(t.row_goals, g), @ms, @ats); }
    int64:i = 0i64;
    while (i < ms.count) decreases 20001i64 - i {
        string:m = raw strlist_copy(ms, i);
        string:a = raw strlist_copy(ats, i);
        i = i + 1i64;
        if (i > 20000i64) {
            string:w = string_concat("instantiation runaway at ", m);
            w = string_concat(w, " @ ");
            int64:alen = a.len;
            if (alen > 300i64) { alen = 300i64; }
            w = string_concat(w, raw text_slice(a, 0i64, alen));
            drop tx_problem(t, w);
            break;
        }
        if (raw text_contains(a, "|m:x|")) { continue; }
        if (!(raw strset_add(@done, raw smt_app1(m, a)))) { continue; }
        // the templates over `m` at `a`; their facts apply the previous memory at `a`
        int64:before = t.hyps.count;
        int64:before_d = t.defs.count;
        for (int64:ti in 0i64...t.mt_mem.count) {
            if (raw text_eq(raw strlist_view(t.mt_mem, ti), m)) { drop tx_template_at(t, ti, a); }
        }
        // the invariants over an Addr, rendered at `a` (a render at the point,
        // so its loads forward and its applications carry their range axioms)
        for (int64:ii in 0i64...t.it_mem.count) {
            if (!(raw text_eq(raw strlist_view(t.it_mem, ii), m))) { continue; }
            int64:hb = t.it_blk[ii];
            REnv:ea = raw renv_new(raw strlist_view(t.it_cm, ii), raw strlist_view(t.it_mem, ii), false, true);
            drop renv_add(@ea, raw strlist_view(t.it_sym, ii), a);
            string:inst = raw inv_conjuncts_over(t, ft, s, t.it_inv[ii], raw strlist_view(t.it_sym, ii), @ea, @x.meta[hb]);
            if (raw text_eq(inst, "true")) { continue; }
            drop tx_hyp(t, raw smt_app2("=>", raw strlist_view(t.it_guard, ii), inst), raw strlist_view(t.it_tag, ii), 0i64);
        }
        for (int64:h2 in before...t.hyps.count) { drop apps_in(t, raw strlist_view(t.hyps, h2), @ms, @ats); }
        for (int64:d3 in before_d...t.defs.count) { drop apps_in(t, raw strlist_view(t.defs, d3), @ms, @ats); }
        // through a pointwise definition
        for (int64:d2 in 0i64...t.def_names.count) {
            if (!(raw text_eq(raw strlist_view(t.def_names, d2), m))) { continue; }
            for (int64:r in 0i64...t.def_refs[d2].count) {
                string:ref = raw strlist_view(t.def_refs[d2], r);
                if (raw strlist_contains(t.mem_syms, ref)) { drop strlist_push(@ms, ref); drop strlist_push(@ats, a); }
            }
            break;
        }
    }
    drop strset_free(@done);
    pass NIL;
};

func:tx_fresh_mem = string(Tx->:t) never fails {
    t.mem_n = t.mem_n + 1i64;
    string:name = string_concat("|mem:", int_to_string(t.mem_n));
    name = string_concat(name, "|");
    drop tx_mem_declare(t, name);
    pass name;
};

// --- registers -----------------------------------------------------------------------------------

pub func:reg_index = int64(Tx->:t, string:ir) never fails {
    for (int64:i in 0i64...t.reg_ir.count) {
        if (raw text_eq(raw strlist_view(t.reg_ir, i), ir)) { pass i; }
    }
    pass (0i64 - 1i64);
};

// Register a name with its sort and width; refuses a redefinition.
func:tx_reg = bool(Tx->:t, string:ir, string:sym, string:sort, int64:bits) never fails {
    if ((raw reg_index(t, ir)) >= 0i64) {
        drop tx_problem(t, string_concat("a register is defined twice: ", ir));
        pass false;
    }
    if (raw strset_has(t.known, sym)) {
        string:w = string_concat("the register ", ir);
        w = string_concat(w, " collides with another symbol of the translation: ");
        w = string_concat(w, sym);
        drop tx_problem(t, w);
        pass false;
    }
    drop strlist_push(@t.reg_ir, ir);
    drop strlist_push(@t.reg_sym, sym);
    drop strlist_push(@t.reg_sort, sort);
    drop list_push(@t.reg_bits, bits);
    drop list_push(@t.reg_is_num, false);
    drop list_push(@t.reg_num, 0u128);
    drop list_push(@t.reg_shl_k, 0i64 - 1i64);
    drop list_push(@t.reg_lt_k, bits);
    drop strlist_push(@t.reg_div_root, "");
    drop list_push(@t.reg_div_by, 0u128);
    drop strlist_push(@t.reg_lin_root, "");
    drop list_push(@t.reg_lin_off, 0u128);
    drop strlist_push(@t.reg_lin_parts, "");
    drop strlist_push(@t.reg_tbl_global, "");
    drop strlist_push(@t.reg_tbl_idx, "");
    drop list_push(@t.reg_tbl_scale, 0i64);
    drop strlist_push(@t.reg_alias, "");
    pass true;
};

// Define register `ir` (type `ty`, scalar) as `text`.
func:tx_set = NIL(Tx->:t, string:ir, string:ty, Term:v) never fails {
    if (!v.ok) { pass NIL; }
    string:sym = raw sym_of_ir(ir);
    string:sort = raw ty_sort(ty);
    if (sort.len == 0i64) { drop tx_problem(t, string_concat("a value of a type the translator does not read: ", ty)); pass NIL; }
    if (!(raw tx_reg(t, ir, sym, sort, raw ty_bits(ty)))) { pass NIL; }
    drop tx_define(t, sym, sort, raw strlist_view_of(v.text));
    // A KNOWN NUMERAL STAYS ONE (a folded chain through a phi with one
    // incoming, an unrolled counter): its readers fold on
    int64:ri = raw reg_index(t, ir);
    if (v.is_num) {
        t.reg_is_num[ri] = true;
        t.reg_num[ri] = v.num;
    }
    // THE SHAPE FACTS SURVIVE THE REGISTER: `%rb = or %r1, %ab1` reads `%r1`
    // as a shift by one and `%ab1` as a value below two only if the table
    // remembers what their definitions were
    t.reg_shl_k[ri] = v.shl_k;
    t.reg_lt_k[ri] = v.lt_k;
    t.reg_div_root[ri] = string_concat(raw strlist_view_of(v.div_root), "");
    t.reg_div_by[ri] = v.div_by;
    t.reg_lin_root[ri] = string_concat(raw strlist_view_of(v.lin_root), "");
    t.reg_lin_off[ri] = v.lin_off;
    t.reg_lin_parts[ri] = string_concat(raw strlist_view_of(v.lin_parts), "");
    t.reg_tbl_global[ri] = string_concat(raw strlist_view_of(v.tbl_global), "");
    t.reg_tbl_idx[ri] = string_concat(raw strlist_view_of(v.tbl_idx), "");
    t.reg_tbl_scale[ri] = v.tbl_scale;
    // AN ALIAS: `%s = load` names `|ld:3|`, `%ex` names `exec` -- a reader of the
    // register gets the symbol itself, so a clause's load and the body's register
    // are one term (the define-fun stays, for a clause that names the register)
    // -- and a PLAIN SUM of atoms (an address inside an object) reads as its
    // text: a wrapped one is already a `|w:N|` atom (`tx_wrap`), so every
    // address the body computes is the very text a clause renders
    if ((raw text_eq(sort, "Int")) && (!v.is_num)) {
        bool:atom = (raw is_word_atom(raw strlist_view_of(v.text), 128i64)) && (!(raw text_starts_with(raw strlist_view_of(v.text), "(")));
        if (atom || (raw is_plain_sum(raw strlist_view_of(v.text)))) { t.reg_alias[ri] = string_concat(raw strlist_view_of(v.text), ""); }
        else {
            // THE OTHER DIRECTION: a register the body reads by NAME (a quotient,
            // a cleared-low-bits form, a product) is what a clause rendering the
            // same text reads too (`reg_of_text`), so `(- r15 (mod r15 16))` in a
            // clause is the body's `rn` and `(+ ip rn)` on both sides is one word
            if (raw text_starts_with(raw strlist_view_of(v.text), "(")) {
                drop strlist_push(@t.rb_text, raw strlist_view_of(v.text));
                drop strlist_push(@t.rb_sym, sym);
            }
        }
    }
    pass NIL;
};

// Declare register `ir` fresh (a parameter, a havoced phi, an opaque value).
func:tx_declare_reg = NIL(Tx->:t, string:ir, string:ty) never fails {
    string:sym = raw sym_of_ir(ir);
    string:sort = raw ty_sort(ty);
    if (sort.len == 0i64) { drop tx_problem(t, string_concat("a value of a type the translator does not read: ", ty)); pass NIL; }
    int64:bits = raw ty_bits(ty);
    if (!(raw tx_reg(t, ir, sym, sort, bits))) { pass NIL; }
    drop tx_declare(t, sym, sort);
    if (raw text_eq(sort, "Int")) { drop tx_range(t, sym, bits); }
    pass NIL;
};

// The term of a register already introduced, or none.
func:term_of_reg = Term(Tx->:t, string:ir) never fails {
    int64:i = raw reg_index(t, ir);
    if (i < 0i64) { pass (raw term_none()); }
    string:sort = raw strlist_view(t.reg_sort, i);
    if (raw text_eq(sort, "Bool")) { pass (raw term_bool(raw strlist_view(t.reg_sym, i))); }
    if (raw text_eq(sort, "Int")) {
        if (t.reg_is_num[i]) { pass (raw term_num(t.reg_num[i], t.reg_bits[i])); }
        string:rname = raw strlist_copy(t.reg_sym, i);
        if ((raw strlist_view(t.reg_alias, i)).len > 0i64) { rname = raw strlist_copy(t.reg_alias, i); }
        Term:r = raw term_int(rname, t.reg_bits[i]);
        r.shl_k = t.reg_shl_k[i];
        r.lt_k = t.reg_lt_k[i];
        r.div_root = raw strlist_copy(t.reg_div_root, i);
        r.div_by = t.reg_div_by[i];
        r.lin_root = raw strlist_copy(t.reg_lin_root, i);
        r.lin_off = t.reg_lin_off[i];
        r.lin_parts = raw strlist_copy(t.reg_lin_parts, i);
        r.tbl_global = raw strlist_copy(t.reg_tbl_global, i);
        r.tbl_idx = raw strlist_copy(t.reg_tbl_idx, i);
        r.tbl_scale = t.reg_tbl_scale[i];
        pass r;
    }
    pass (raw term_fp(raw strlist_view(t.reg_sym, i), t.reg_bits[i]));
};

// --- values ----------------------------------------------------------------------------------------

func:is_hex_float = bool(string:s) never fails {
    if (s.len < 3i64) { pass false; }
    if (s.ptr[0i64] != 48u8) { pass false; }
    if (s.ptr[1i64] != 120u8) { pass false; }   // 0x
    pass true;
};

// A float literal as an IEEE term: a hex pattern `0x7FF0000000000000` is
// the double whose bits those are (`to_fp` of the bit-vector, then, for a
// `float`, rounded to single -- exact where the pattern is representable,
// which is every pattern the floor writes); a decimal `2.0` is the exact
// rational rounded to the width.
func:fp_literal = Term(Tx->:t, string:s, int64:bits) never fails {
    t.uses_fp = true;
    string:eb = "11 53";
    if (bits == 32i64) { eb = "8 24"; }
    if (raw is_hex_float(s)) {
        string:hex = raw text_slice(s, 2i64, s.len);
        string:pat = string_concat("((_ to_fp 11 53) #x", hex);
        pat = string_concat(pat, ")");
        if (bits == 32i64) {
            string:nar = string_concat("((_ to_fp 8 24) RNE ", pat);
            nar = string_concat(nar, ")");
            pass (raw term_fp(nar, bits));
        }
        pass (raw term_fp(pat, bits));
    }
    string:d = string_concat("((_ to_fp ", eb);
    d = string_concat(d, ") RNE ");
    d = string_concat(d, s);
    d = string_concat(d, ")");
    pass (raw term_fp(d, bits));
};

// The address symbol of the global `@name`, registered on first use with
// its object facts: in range, non-null, whole inside the address space,
// and disjoint from every other object the function touches.
pub func:tx_global = string(Tx->:t, FloorText->:ft, string:ir) never fails {
    string:sym = raw sym_of_ir(ir);
    if (raw strlist_contains(t.globals_ir, ir)) { pass sym; }
    string:gty = raw floor_global_type(ft, ir);
    if (gty.len == 0i64) {
        drop tx_problem(t, string_concat("a global the module does not declare: ", ir));
        pass sym;
    }
    drop strlist_push(@t.globals_ir, ir);
    int64:size = raw ty_size(ft, gty);
    drop tx_object(t, sym, size);
    // A CONSTANT'S BYTES (1.5.6 step 4): the class tables and the stats key are
    // `constant` globals with initialisers -- their bytes in the entry memory
    // are facts, one per byte (a constant is written by nobody)
    string:init = raw floor_global_init(ft, ir);
    if (init.len > 0i64) {
        List<int64>:bytes = raw const_bytes(ft, gty, init);
        if (bytes.count != size) {
            if (bytes.count > 0i64) { drop tx_problem(t, string_concat("a constant's initialiser does not fill its type: ", ir)); }
        } else {
            for (int64:i in 0i64...bytes.count) {
                string:a = raw text_copy(sym);
                if (i > 0i64) { a = raw smt_app2("+", sym, int_to_string(i)); }
                // the fact IS the byte's range: no range axiom beside it
                string:app = raw smt_app1("mem", a);
                if (!(raw strlist_contains(t.mem_apps, app))) { drop strlist_push(@t.mem_apps, app); }
                drop tx_hyp(t, raw smt_app2("=", app, int_to_string(bytes[i])), "constant", 0i64);
            }
        }
    }
    pass sym;
};

// The bytes of an initialiser: `[i64 16, i64 32, ...]` (an array of integers,
// little-endian each), `c"..."` (a byte string with `\XX` hex escapes), a bare
// numeral (a scalar of the declared width); empty for a form not read
// (`zeroinitializer` is a global's, never a constant's, in the floor).
func:const_bytes = List<int64>(FloorText->:ft, string:ty, string:init) never fails {
    List<int64>:out = raw list_init::<int64>(64i64);
    if (init.len == 0i64) { pass out; }
    if (init.ptr[0i64] == 99u8) {   // c"..."
        int64:i = 2i64;
        while ((i < init.len) && (init.ptr[i] != 34u8)) decreases init.len - i {
            uint8:c = init.ptr[i];
            if ((c == 92u8) && ((i + 2i64) < init.len)) {
                int64:hv = (raw hex_digit(init.ptr[i + 1i64]) * 16i64) + raw hex_digit(init.ptr[i + 2i64]);
                drop list_push(@out, hv);
                i = i + 3i64;
                continue;
            }
            drop list_push(@out, c => int64);
            i = i + 1i64;
        }
        pass out;
    }
    if (init.ptr[0i64] == 91u8) {   // [i64 16, i64 32, ...]
        string:inner = raw text_slice(init, 1i64, init.len - 1i64);
        List<string>:parts = raw split_top_commas(inner);
        string:ety = raw array_elem(ty);
        int64:esz = raw ty_size(ft, ety);
        for (int64:pi in 0i64...parts.count) {
            string:piece = raw text_trim(raw strlist_view(parts, pi));
            int64:sp = raw text_find_byte(piece, 32u8, 0i64);
            if (sp < 0i64) { drop list_clear(@out); pass out; }
            uint128:v = 0u128;
            if (!(raw u128_parse(raw text_slice(piece, sp + 1i64, piece.len), esz * 8i64, @v))) { drop list_clear(@out); pass out; }
            for (int64:b in 0i64...esz) {
                drop list_push(@out, (v % 256u128) =>! int64);
                v = v / 256u128;
            }
        }
        pass out;
    }
    uint128:sv = 0u128;
    int64:bits = raw ty_bits(ty);
    if ((bits > 0i64) && (raw u128_parse(init, bits, @sv))) {
        for (int64:b2 in 0i64...(bits / 8i64)) {
            drop list_push(@out, (sv % 256u128) =>! int64);
            sv = sv / 256u128;
        }
    }
    pass out;
};

func:hex_digit = int64(uint8:c) never fails {
    if ((c >= 48u8) && (c <= 57u8)) { pass ((c - 48u8) => int64); }
    if ((c >= 65u8) && (c <= 70u8)) { pass ((c - 55u8) => int64); }
    if ((c >= 97u8) && (c <= 102u8)) { pass ((c - 87u8) => int64); }
    pass 0i64;
};

func:split_top_commas = List<string>(string:s) never fails {
    List<string>:out = raw list_init::<string>(16i64);
    int64:start = 0i64;
    int64:depth = 0i64;
    for (int64:i in 0i64...s.len) {
        uint8:c = s.ptr[i];
        if ((c == 91u8) || (c == 123u8)) { depth = depth + 1i64; }
        if ((c == 93u8) || (c == 125u8)) { depth = depth - 1i64; }
        if ((c == 44u8) && (depth == 0i64)) {
            drop strlist_push(@out, raw text_slice(s, start, i));
            start = i + 1i64;
        }
    }
    drop strlist_push(@out, raw text_slice(s, start, s.len));
    pass out;
};

// Whether an `objects` entry is `(lo len)` or `(lo len apart-when COND)`.
func:range_entry_ok = bool(Sxs->:s, int64:node) never fails {
    if (!(raw sx_is_list(s, node))) { pass false; }
    int64:n = raw sx_len(s, node);
    if (n == 2i64) { pass true; }
    if (n != 4i64) { pass false; }
    int64:kw = raw sx_nth(s, node, 2i64);
    if (raw sx_is_list(s, kw)) { pass false; }
    pass (raw text_eq(raw sx_atom(s, kw), "apart-when"));
};

// `(objects (lo len) ...)`: the caller's objects -- each range within the
// address space and the listed ranges pairwise disjoint (a null or an empty
// range is no object and overlaps nothing) -- as facts rendered under `e`; a
// section's are its hypotheses (`record` keeps the ranges for the allocator's
// freshness promise), a summary callee's are rows at the call.
//
// `(lo len apart-when COND)` (1.5.6c step 0): a range that lies in the address
// space ALWAYS and is set apart from the section's other objects only WHERE
// `COND` HOLDS -- the form for an object the body touches on some paths alone.
// `npk_small_free`'s list neighbours are the case: the body moves the chunk
// between lists only when it was full, and only then are the neighbours and
// the partial list's head three OTHER chunks; asserted apart unconditionally
// (the clause 1.5.6 wrote) the hypothesis was false for the ordinary free,
// into a chunk already on the partial list, and every row claimed nothing
// for it. A pair is apart where BOTH ranges' conditions hold. Everything else
// about the range is an object's -- so the body's text, and the solver's work,
// stay what they were (an `ite` to a null `lo` says the same and cost the file
// 357 s against 202, past the hang net: measured in the runners' own mode).
//
// `(views (lo len) ...)` (1.5.6c step 1; `vc0`, -1 for none): ranges the symbol
// is handed to READ. A view is within the address space and disjoint from
// every OBJECT -- and from no other view: two views of one string overlap, and
// `string_concat(s, s)` is a legal program (the clause this form replaced
// asserted the two inputs apart, false for that call). Recorded as an object
// is. That a view is only read is PROVEN, not named: the section's frame row
// exempts no byte of one (`views_in`, `tx_section_rows`). The objects' facts
// come first and are the text they were before views existed, so a section
// without views emits what it always did and no hash of it moves. Either
// clause may be absent (`oc0`/`vc0` negative).
func:objects_facts = List<string>(Tx->:t, FloorText->:ft, Sxs->:s, int64:oc0, int64:vc0, REnv->:e, BMeta->:m, bool:record) never fails {
    List<string>:los = raw list_init::<string>(4i64);
    List<string>:lens = raw list_init::<string>(4i64);
    List<string>:whens = raw list_init::<string>(4i64);
    List<string>:facts = raw list_init::<string>(8i64);
    if (oc0 >= 0i64) {
        int64:oc = s.nodes[oc0].first;
        oc = s.nodes[oc].next;
        while (oc >= 0i64) decreases s.nodes.count - oc {
            if (!(raw range_entry_ok(s, oc))) { drop tx_problem(t, "an objects range is not `(lo len)` or `(lo len apart-when COND)`"); break; }
            drop strlist_push(@los, raw render(t, ft, s, raw sx_nth(s, oc, 0i64), e, m));
            drop strlist_push(@lens, raw render(t, ft, s, raw sx_nth(s, oc, 1i64), e, m));
            if ((raw sx_len(s, oc)) == 4i64) { drop strlist_push(@whens, raw render(t, ft, s, raw sx_nth(s, oc, 3i64), e, m)); }
            else { drop strlist_push(@whens, ""); }
            oc = s.nodes[oc].next;
        }
    }
    int64:nobj = los.count;
    if (vc0 >= 0i64) {
        int64:vc = s.nodes[vc0].first;
        vc = s.nodes[vc].next;
        while (vc >= 0i64) decreases s.nodes.count - vc {
            // a view is `(lo len)`: the conditional form is an object's (no section needs a conditional view)
            if (!(raw sx_is_list(s, vc)) || ((raw sx_len(s, vc)) != 2i64)) { drop tx_problem(t, "a views range is not `(lo len)`"); break; }
            drop strlist_push(@los, raw render(t, ft, s, raw sx_nth(s, vc, 0i64), e, m));
            drop strlist_push(@lens, raw render(t, ft, s, raw sx_nth(s, vc, 1i64), e, m));
            drop strlist_push(@whens, "");
            vc = s.nodes[vc].next;
        }
    }
    string:top = raw pow2_decimal(64i64);
    for (int64:i in 0i64...los.count) {
        string:lo = raw strlist_view(los, i);
        string:ln = raw strlist_view(lens, i);
        drop strlist_push(@facts, raw smt_app2("and", raw smt_app2("<=", "0", lo), raw smt_app2("<=", raw smt_app2("+", lo, ln), top)));
        // an object: apart from every object before it; a view: apart from every object, from no view
        int64:kmax = i;
        if (i >= nobj) { kmax = nobj; }
        for (int64:k in 0i64...kmax) {
            string:o = raw strlist_view(los, k);
            string:oln = raw strlist_view(lens, k);
            string:apart = raw smt_app2("or", raw smt_app2("<=", raw smt_app2("+", lo, ln), o), raw smt_app2("<=", raw smt_app2("+", o, oln), lo));
            string:no_obj = raw smt_app2("or", raw smt_app2("or", raw smt_app2("=", lo, "0"), raw smt_app2("=", o, "0")),
                                             raw smt_app2("or", raw smt_app2("=", ln, "0"), raw smt_app2("=", oln, "0")));
            string:pairf = raw smt_app2("or", no_obj, apart);
            string:wi = raw strlist_view(whens, i);
            string:wk = raw strlist_view(whens, k);
            if (wi.len > 0i64) { pairf = raw smt_app2("or", raw smt_app1("not", wi), pairf); }
            if (wk.len > 0i64) { pairf = raw smt_app2("or", raw smt_app1("not", wk), pairf); }
            drop strlist_push(@facts, pairf);
        }
        if (record) { drop strlist_push(@t.obj_lo, lo); drop strlist_push(@t.obj_len, ln); }
    }
    pass facts;
};

// A load of one element of a constant table `[N x iW]` as the `ite` over its
// index: the table's values by the case, the raw reassembly past the end
// ("" when the initialiser is not a list of integers of the load's size).
func:const_table_ite = string(Tx->:t, FloorText->:ft, string:gname, string:idx, int64:n, string:raw_ld) never fails {
    string:init = raw floor_global_init(ft, gname);
    string:gty = raw floor_global_type(ft, gname);
    if ((init.len < 2i64) || (init.ptr[0i64] != 91u8)) { pass ""; }
    if ((raw ty_size(ft, raw array_elem(gty))) != n) { pass ""; }
    List<string>:items = raw split_top_commas(raw text_slice(init, 1i64, init.len - 1i64));
    List<string>:vals = raw list_init::<string>(items.count + 1i64);
    for (int64:i in 0i64...items.count) {
        string:it = raw text_trim(raw strlist_view(items, i));
        int64:sp = raw text_index_of(it, " ");
        if (sp < 0i64) { pass ""; }
        string:num = raw text_trim(raw text_slice(it, sp + 1i64, it.len));
        uint128:v = 0u128;
        if (!(raw u128_parse(num, n * 8i64, @v))) { pass ""; }
        drop strlist_push(@vals, raw u128_text(v));
    }
    string:out = raw text_copy(raw_ld);
    for (int64:k in 0i64...vals.count) {
        int64:j = vals.count - 1i64 - k;
        out = string_concat(raw smt_app3("ite", raw smt_app2("=", idx, int_to_string(j)), raw strlist_view(vals, j), out), "");
    }
    // named: a word both the body's register and a clause's load resolve to
    for (int64:m in 0i64...t.tv_text.count) {
        if (raw text_eq(raw strlist_view(t.tv_text, m), out)) { pass (raw strlist_copy(t.tv_sym, m)); }
    }
    string:tsym = raw tx_fresh(t, "tv");
    drop tx_define(t, tsym, "Int", out);
    drop strlist_push(@t.tv_text, out);
    drop strlist_push(@t.tv_idx, idx);
    drop list_push(@t.tv_vals, raw strlist_clone(vals));
    drop strlist_push(@t.tv_sym, tsym);
    pass tsym;
};

// The index of the last space in `s`, or -1.
func:text_last_space = int64(string:s) never fails {
    int64:i = s.len - 1i64;
    while (i >= 0i64) decreases i { if (s.ptr[i] == 32u8) { pass i; } i = i - 1i64; }
    pass (0i64 - 1i64);
};

// The body of a zero-arity definition `sym`, or "".
func:def_body = string(Tx->:t, string:sym) never fails {
    for (int64:d in 0i64...t.def_names.count) {
        if (!(raw text_eq(raw strlist_view(t.def_names, d), sym))) { continue; }
        string:l = raw strlist_view(t.defs, d);
        string:pre = string_concat("(define-fun ", sym);
        pre = string_concat(pre, " () ");
        if (!(raw text_starts_with(l, pre))) { pass ""; }
        int64:sp = raw text_index_of(raw text_slice(l, pre.len, l.len), " ");
        if (sp < 0i64) { pass ""; }
        pass (raw text_slice(l, pre.len + sp + 1i64, l.len - 1i64));
    }
    pass "";
};

// THE CASES OF A DIVISOR: a table value (its `ite` text, or a symbol defined
// as one), or such a value plus a numeral, wrapped or not -- `idx` and the
// per-case numerals; a division by it distributes over the cases and every
// branch divides by a numeral (linear), the out-of-table tail a fresh symbol.
func:divisor_cases = string(Tx->:t, string:text, List<string>->:vals) never fails {
    string:s = raw text_copy(text);
    uint128:k = 0u128;
    string:w = raw pow2_decimal(64i64);
    string:msuf = string_concat(" ", w);
    msuf = string_concat(msuf, ")");
    int64:steps = 0i64;
    while (steps < 8i64) decreases 8i64 - steps {
        steps = steps + 1i64;
        // a symbol: its definition
        if (!(raw text_starts_with(s, "("))) {
            string:body = raw def_body(t, s);
            if (body.len == 0i64) { break; }
            s = move(body);
            continue;
        }
        // the writer's own wrap of a sum, `(ite (< (+ X k) W) (+ X k) (- (+ X k) W))`: the sum
        if (raw text_starts_with(s, "(ite (< (+ ")) {
            List<string>:ia = raw smt_split_top(raw text_slice(s, 5i64, s.len - 1i64));
            if (ia.count == 3i64) { s = raw strlist_copy(ia, 1i64); }
        }
        // (mod (+ X k) 2^64) or (+ X k): the numeral joins the offset, X is next
        string:inner = "";
        if ((raw text_starts_with(s, "(mod (+ ")) && (raw text_ends_with(s, msuf))) { inner = raw text_slice(s, 8i64, s.len - msuf.len - 1i64); }
        else { if ((raw text_starts_with(s, "(+ ")) && (raw text_ends_with(s, ")"))) { inner = raw text_slice(s, 3i64, s.len - 1i64); } }
        if (inner.len > 0i64) {
            int64:sp = raw text_last_space(inner);
            if (sp < 0i64) { break; }
            uint128:kk = 0u128;
            if (!(raw u128_parse(raw text_slice(inner, sp + 1i64, inner.len), 64i64, @kk))) { break; }
            k = raw u128_add(k, kk, 64i64);
            s = raw text_slice(inner, 0i64, sp);
            continue;
        }
        break;
    }
    for (int64:i in 0i64...t.tv_text.count) {
        if (!(raw text_eq(raw strlist_view(t.tv_text, i), s))) { continue; }
        for (int64:j in 0i64...t.tv_vals[i].count) {
            uint128:v = 0u128;
            if (!(raw u128_parse(raw strlist_view(t.tv_vals[i], j), 64i64, @v))) { pass ""; }
            drop strlist_push(vals, raw u128_text(raw u128_add(v, k, 64i64)));
        }
        pass (raw strlist_copy(t.tv_idx, i));
    }
    pass "";
};

// `(div a B)`/`(mod a B)` over the cases of B: an `ite` per case with a
// numeral divisor, the tail a fresh ranged symbol (out of the table, the
// quotient is some word).
func:div_over_cases = string(Tx->:t, string:op, string:a, string:idx, List<string>:vals, int64:bits) never fails {
    string:tail = raw tx_fresh(t, op);
    drop tx_declare(t, tail, "Int");
    drop tx_range(t, tail, bits);
    string:out = raw text_copy(tail);
    for (int64:k in 0i64...vals.count) {
        int64:j = vals.count - 1i64 - k;
        string:v = raw strlist_view(vals, j);
        string:branch = raw smt_app2(op, a, v);
        if (raw text_eq(op, "div")) { branch = raw div_text(a, v); }
        if (raw text_eq(v, "0")) { branch = raw text_copy(tail); }
        out = string_concat(raw smt_app3("ite", raw smt_app2("=", idx, int_to_string(j)), branch, out), "");
    }
    pass out;
};

// The ranges of an `(objects (lo len) ...)` clause rendered under `e`, into `los`/`lens`.
func:objects_ranges = NIL(Tx->:t, FloorText->:ft, Sxs->:s, int64:oc0, REnv->:e, BMeta->:m, List<string>->:los, List<string>->:lens) never fails {
    int64:oc = s.nodes[oc0].first;
    oc = s.nodes[oc].next;
    while (oc >= 0i64) decreases s.nodes.count - oc {
        if (!(raw sx_is_list(s, oc)) || ((raw sx_len(s, oc)) != 2i64)) { drop tx_problem(t, "an objects range is not `(lo len)`"); break; }
        drop strlist_push(los, raw render(t, ft, s, raw sx_nth(s, oc, 0i64), e, m));
        drop strlist_push(lens, raw render(t, ft, s, raw sx_nth(s, oc, 1i64), e, m));
        oc = s.nodes[oc].next;
    }
    pass NIL;
};

// The condition that the point `f` lies in one of the CALLER's objects: the
// section's declared ranges and, under their headers' path conditions, the
// loop objects ("false" with none).
func:caller_objects_in = string(Tx->:t, string:f, bool:with_loops) never fails {
    string:out = "false";
    for (int64:ob in 0i64...t.obj_lo.count) {
        string:lo = raw strlist_view(t.obj_lo, ob);
        string:ln = raw strlist_view(t.obj_len, ob);
        string:inside = raw smt_app2("and", raw smt_app2("<=", lo, f), raw smt_app2("<", f, raw smt_app2("+", lo, ln)));
        if (raw text_eq(out, "false")) { out = move(inside); } else { out = string_concat(raw smt_app2("or", out, inside), ""); }
    }
    if (!with_loops) { pass out; }
    // the caller's live blocks (under the guard of the allocation that made each)
    for (int64:fb in 0i64...t.fresh_blocks.count) {
        string:flo = raw strlist_view(t.fresh_blocks, fb);
        string:fln = raw strlist_view(t.fresh_lens, fb);
        string:fin = raw smt_app2("and", raw strlist_view(t.fresh_guards, fb),
                                          raw smt_app2("and", raw smt_app2("<=", flo, f), raw smt_app2("<", f, raw smt_app2("+", flo, fln))));
        if (raw text_eq(out, "false")) { out = move(fin); } else { out = string_concat(raw smt_app2("or", out, fin), ""); }
    }
    for (int64:lb in 0i64...t.lobj_lo.count) {
        string:lo2 = raw strlist_view(t.lobj_lo, lb);
        string:ln2 = raw strlist_view(t.lobj_len, lb);
        string:inside2 = raw smt_app2("and", raw strlist_view(t.lobj_pc, lb),
                                              raw smt_app2("and", raw smt_app2("<=", lo2, f), raw smt_app2("<", f, raw smt_app2("+", lo2, ln2))));
        if (raw text_eq(out, "false")) { out = move(inside2); } else { out = string_concat(raw smt_app2("or", out, inside2), ""); }
    }
    pass out;
};

// Whether the S-expression `node` mentions the atom `name` anywhere.
func:sx_mentions = bool(Sxs->:s, int64:node, string:name) never fails {
    if (node < 0i64) { pass false; }
    if (!(raw sx_is_list(s, node))) { pass (raw text_eq(raw sx_atom(s, node), name)); }
    int64:c = s.nodes[node].first;
    while (c >= 0i64) decreases s.nodes.count - c {
        if (raw sx_mentions(s, c, name)) { pass true; }
        c = s.nodes[c].next;
    }
    pass false;
};

// The conjuncts of the invariant `inv` (`(invariant (and c1 c2 ...))`, or one
// proposition) that mention the free symbol `name`, rendered under `e` as one
// conjunction -- an instance at a point needs only what the point varies;
// the rest stands once, in the header's own hypothesis. "true" when none.
func:inv_conjuncts_over = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:inv, string:name, REnv->:e, BMeta->:m) never fails {
    if ((raw sx_len(s, inv)) != 2i64) { pass (raw render_clause(t, ft, s, inv, e, m)); }
    int64:body = raw sx_nth(s, inv, 1i64);
    if (!(raw sx_is_list(s, body)) || !(raw text_eq(raw sx_head(s, body), "and"))) {
        if (raw sx_mentions(s, body, name)) { pass (raw render(t, ft, s, body, e, m)); }
        pass "true";
    }
    string:out = "true";
    int64:c = s.nodes[body].first;
    c = s.nodes[c].next;   // past `and`
    while (c >= 0i64) decreases s.nodes.count - c {
        if (raw sx_mentions(s, c, name)) {
            string:r = raw render(t, ft, s, c, e, m);
            if (raw text_eq(out, "true")) { out = move(r); } else { out = string_concat(raw smt_app2("and", out, r), ""); }
        }
        c = s.nodes[c].next;
    }
    pass out;
};

// The invariant of a loop clause, with its `(objects (lo len) ...)` facts
// conjoined: the ranges are objects on every visit of the header (in the
// address space, disjoint), proven at init and preserved like the rest.
func:loop_inv_text = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:lclause, int64:inv, REnv->:e, BMeta->:m) never fails {
    string:text = raw render_clause(t, ft, s, inv, e, m);
    int64:oc = raw spec_clause(s, lclause, "objects", 0i64);
    if (oc < 0i64) { pass text; }
    // a loop clause takes no views (the spec belt refuses the sub-clause)
    List<string>:facts = raw objects_facts(t, ft, s, oc, 0i64 - 1i64, e, m, false);
    for (int64:i in 0i64...facts.count) { text = string_concat(raw smt_app2("and", text, raw strlist_view(facts, i)), ""); }
    pass text;
};

// Whether `prefix + total` lies inside an object the file knows: a declared
// object whose `lo` is spelled `prefix` with a numeral length above `total`,
// or an alloca or global named `prefix` of a size above it -- then the
// address needs no wrap (the object's range axiom is a hypothesis of the
// file, and the wrapped and the plain sum agree under it).
// A numeral, or a sum/difference/product of two numerals (`(+ n 16)` as an
// `ensures-fresh` length renders): its value, or false.
func:numeral_fold = bool(string:x, uint128->:out) never fails {
    if (raw u128_parse(x, 64i64, out)) { pass true; }
    if (!((raw text_starts_with(x, "(+ ") || raw text_starts_with(x, "(- ") || raw text_starts_with(x, "(* ")) && (raw text_ends_with(x, ")")))) { pass false; }
    List<string>:ps = raw smt_split_top(raw text_slice(x, 3i64, x.len - 1i64));
    if (ps.count != 2i64) { pass false; }
    uint128:a = 0u128;
    uint128:b = 0u128;
    if (!(raw u128_parse(raw strlist_view(ps, 0i64), 64i64, @a))) { pass false; }
    if (!(raw u128_parse(raw strlist_view(ps, 1i64), 64i64, @b))) { pass false; }
    if (raw text_starts_with(x, "(+ ")) { if ((a + b) >= (raw u128_pow2(64i64))) { pass false; } <-out = a + b; pass true; }
    if (raw text_starts_with(x, "(- ")) { if (a < b) { pass false; } <-out = a - b; pass true; }
    if ((a * b) >= (raw u128_pow2(64i64))) { pass false; }
    <-out = a * b;
    pass true;
};

// Whether the address `prefix + total` lies inside the range [lo, lo+len):
// `lo` the prefix itself, or the prefix at a numeral offset either way
// (`(+ p 8)`, `(- result 16)` -- an allocator's block starts below the
// pointer it hands out); `len` a numeral or a fold of numerals.
func:range_covers = bool(string:lo, string:len, string:prefix, uint128:total) never fails {
    uint128:n = 0u128;
    if (!(raw numeral_fold(len, @n))) { pass false; }
    if (raw text_eq(lo, prefix)) { pass (total < n); }
    if (!((raw text_starts_with(lo, "(+ ") || raw text_starts_with(lo, "(- ")) && (raw text_ends_with(lo, ")")))) { pass false; }
    List<string>:ps = raw smt_split_top(raw text_slice(lo, 3i64, lo.len - 1i64));
    if (ps.count != 2i64) { pass false; }
    if (!(raw text_eq(raw strlist_view(ps, 0i64), prefix))) { pass false; }
    uint128:k = 0u128;
    if (!(raw u128_parse(raw strlist_view(ps, 1i64), 64i64, @k))) { pass false; }
    if (raw text_starts_with(lo, "(+ ")) {
        // the range starts k above the prefix: k <= total < k + n
        if (total < k) { pass false; }
        pass ((total - k) < n);
    }
    // the range starts k below the prefix: total + k < n
    pass ((total + k) < n);
};

// Whether `prefix + total` (a numeral offset from an atom or a plain sum)
// lies inside an object the section declares, a block a summary callee
// handed out (`ensures-fresh`; its facts stand where the block is used --
// the use is dominated by the call), or an alloca/global: then the sum
// cannot wrap and stays plain, the spelling a clause writes.
func:addr_in_object = bool(Tx->:t, string:prefix, uint128:total) never fails {
    for (int64:i in 0i64...t.obj_lo.count) {
        if (raw range_covers(raw strlist_view(t.obj_lo, i), raw strlist_view(t.obj_len, i), prefix, total)) { pass true; }
    }
    for (int64:fb in 0i64...t.fresh_blocks.count) {
        if (raw range_covers(raw strlist_view(t.fresh_blocks, fb), raw strlist_view(t.fresh_lens, fb), prefix, total)) { pass true; }
    }
    for (int64:o in 0i64...t.objects.count) {
        if (!(raw text_eq(raw strlist_view(t.objects, o), prefix))) { continue; }
        if (total < (t.object_sizes[o] =>! uint128)) { pass true; }
    }
    pass false;
};

// An object's address facts (globals and allocas).
func:tx_object = NIL(Tx->:t, string:sym, int64:size) never fails {
    if (raw strset_has(t.known, sym)) {
        drop tx_problem(t, string_concat("an object's address symbol collides with another symbol: ", sym));
        pass NIL;
    }
    drop tx_declare(t, sym, "Int");
    string:sz = int_to_string(size);
    drop tx_hyp(t, raw smt_app2(">", sym, "0"), "range", 0i64);
    drop tx_hyp(t, raw smt_app2("<=", raw smt_app2("+", sym, sz), raw pow2_decimal(64i64)), "range", 0i64);
    for (int64:i in 0i64...t.objects.count) {
        string:o = raw strlist_view(t.objects, i);
        string:osz = int_to_string(t.object_sizes[i]);
        drop tx_hyp(t, raw smt_app2("or", raw smt_app2("<=", raw smt_app2("+", sym, sz), o),
                                          raw smt_app2("<=", raw smt_app2("+", o, osz), sym)), "layout", 0i64);
    }
    // AN ALLOCA IS FRESH STACK: apart from every object the caller declares (a
    // global may BE a declared object, so only the stack's are held apart)
    if (raw text_starts_with(sym, "|a:")) {
        for (int64:ob in 0i64...t.obj_lo.count) {
            string:lo = raw strlist_view(t.obj_lo, ob);
            string:ln = raw strlist_view(t.obj_len, ob);
            drop tx_hyp(t, raw smt_app2("or", raw smt_app2("<=", raw smt_app2("+", sym, sz), lo),
                                              raw smt_app2("<=", raw smt_app2("+", lo, ln), sym)), "layout", 0i64);
        }
    }
    drop strlist_push(@t.objects, sym);
    drop list_push(@t.object_sizes, size);
    pass NIL;
};

// The term of an operand text of type `ty`: a register, a numeral, `null`,
// `true`/`false`, a float literal, a global's address.
pub func:term_of = Term(Tx->:t, FloorText->:ft, string:text, string:ty) never fails {
    if (text.len == 0i64) { pass (raw term_none()); }
    uint8:c0 = text.ptr[0i64];
    if (c0 == 37u8) {
        Term:r = raw term_of_reg(t, text);
        if (!r.ok) { drop tx_problem(t, string_concat("a register used before its definition: ", text)); }
        pass r;
    }
    if (c0 == 64u8) { pass (raw term_int(raw tx_global(t, ft, text), 64i64)); }
    if (raw text_eq(text, "null")) { pass (raw term_num(0u128, 64i64)); }
    if (raw text_eq(text, "true")) { pass (raw term_bool("true")); }
    if (raw text_eq(text, "false")) { pass (raw term_bool("false")); }
    if (raw text_eq(text, "poison") || raw text_eq(text, "undef")) {
        drop tx_problem(t, "a `poison`/`undef` value: the floor mints none (D-218 (10))");
        pass (raw term_none());
    }
    string:sort = raw ty_sort(ty);
    int64:bits = raw ty_bits(ty);
    if (raw text_eq(sort, "F64") || raw text_eq(sort, "F32")) { pass (raw fp_literal(t, text, bits)); }
    if (raw text_eq(sort, "Bool")) {
        if (raw text_eq(text, "1")) { pass (raw term_bool("true")); }
        if (raw text_eq(text, "0")) { pass (raw term_bool("false")); }
    }
    uint128:v = 0u128;
    if (raw u128_parse(text, bits, @v)) { pass (raw term_num(v, bits)); }
    string:w = string_concat("an operand the translator does not read: `", text);
    w = string_concat(w, "` of type ");
    w = string_concat(w, ty);
    drop tx_problem(t, w);
    pass (raw term_none());
};

// --- arithmetic --------------------------------------------------------------------------------------

func:pow2_text = string(int64:k) never fails { pass (raw pow2_decimal(k)); };

// The signed view of an unsigned Int term of `bits` bits.
func:signed_view = string(string:x, int64:bits) never fails {
    pass (raw smt_app3("ite", raw smt_app2(">=", x, raw pow2_text(bits - 1i64)),
                       raw smt_app2("-", x, raw pow2_text(bits)), x));
};

// A top-level split of `s` at spaces (parentheses and `|quoted|` respected).
func:smt_split_top = List<string>(string:s) never fails {
    List<string>:out = raw list_init::<string>(4i64);
    int64:depth = 0i64;
    bool:q = false;
    int64:start = 0i64;
    for (int64:i in 0i64...s.len) {
        uint8:c = s.ptr[i];
        if (c == 124u8) { q = !q; continue; }
        if (q) { continue; }
        if (c == 40u8) { depth = depth + 1i64; continue; }
        if (c == 41u8) { depth = depth - 1i64; continue; }
        if ((c == 32u8) && (depth == 0i64)) {
            if (i > start) { drop strlist_push(@out, raw text_slice(s, start, i)); }
            start = i + 1i64;
        }
    }
    if (s.len > start) { drop strlist_push(@out, raw text_slice(s, start, s.len)); }
    pass out;
};

// An atom of the writer's: a symbol, or a numeral below 2^bits.
func:is_word_atom = bool(string:s, int64:bits) never fails {
    if (s.len == 0i64) { pass false; }
    // a wrapped sum, a wrap by mod, a quotient of a word, a crossing: in range by construction
    if (raw text_starts_with(s, "(ite ") || raw text_starts_with(s, "(mod ") || raw text_starts_with(s, "(div ") || raw text_starts_with(s, "(bv2nat ")) { pass true; }
    if (s.ptr[0i64] == 40u8) { pass false; }
    if (raw text_contains(s, " ")) { pass false; }
    if (raw text_is_digit(s.ptr[0i64])) { uint128:v = 0u128; pass (raw u128_parse(s, bits, @v)); }
    pass true;
};

// WRAPPING. `(+ A B ...)` over two to four atoms and `(- A B)` over two --
// symbols or numerals, every symbol a word by its range axiom or definition
// -- wrap by ONE comparison per possible multiple: an n-atom sum lies below
// n times the width, the difference above minus it, so an `ite` decides the
// case where a `mod` would cost the solver a division's axioms at every
// address compared. Anything else wraps by `mod`. Callers go through
// `tx_wrap`, which names the result once.
func:wrap_text = string(string:x, int64:bits) never fails {
    string:w = raw pow2_text(bits);
    if ((raw text_starts_with(x, "(+ ") || raw text_starts_with(x, "(- ")) && (raw text_ends_with(x, ")"))) {
        List<string>:parts = raw smt_split_top(raw text_slice(x, 3i64, x.len - 1i64));
        bool:atoms = (parts.count >= 2i64) && (parts.count <= 4i64);
        for (int64:i in 0i64...parts.count) { if (!(raw is_word_atom(raw strlist_view(parts, i), bits))) { atoms = false; } }
        if (atoms && (raw text_starts_with(x, "(- ")) && (parts.count == 2i64)) {
            pass (raw smt_app3("ite", raw smt_app2(">=", raw strlist_view(parts, 0i64), raw strlist_view(parts, 1i64)), x, raw smt_app2("+", x, w)));
        }
        if (atoms && (raw text_starts_with(x, "(+ "))) {
            // n atoms: below n times the width, so n-1 thresholds decide the multiple to take off
            string:out = raw smt_app2("-", x, raw smt_app2("*", int_to_string(parts.count - 1i64), w));
            int64:k = parts.count - 1i64;
            while (k >= 1i64) decreases k - 1i64 {
                string:thr = raw text_copy(w);
                if (k > 1i64) { thr = raw smt_app2("*", int_to_string(k), w); }
                string:val = raw text_copy(x);
                if (k > 1i64) { val = raw smt_app2("-", x, raw smt_app2("*", int_to_string(k - 1i64), w)); }
                out = string_concat(raw smt_app3("ite", raw smt_app2("<", x, thr), val, out), "");
                k = k - 1i64;
            }
            pass out;
        }
    }
    pass (raw smt_app2("mod", x, w));
};

// add/sub/mul over Int terms of one width, wrapped; numerals fold.
// `ROOT + off` as a clause writes it: an offset past half the width is the
// subtraction of its complement (`(- ip 16)`, not `(+ ip 18446744073709551600)`)
// -- the two wrap to the same word and the solver matches the spelling.
func:lin_sum_text = string(string:root, uint128:off, int64:bits) never fails {
    uint128:half = raw u128_pow2(bits - 1i64);
    if (off >= half) { pass (raw smt_app2("-", root, raw u128_text(raw u128_sub(0u128, off, bits)))); }
    pass (raw smt_app2("+", root, raw u128_text(off)));
};

// THE WRAP IS A NAMED SYMBOL. `wrap_text` spells a wrapped computation out as
// an `ite` (or a `mod`); the text is returned ONCE as the definition of a
// fresh `|w:N|` and every later wrap of the same text is the same symbol --
// so an address is an atom wherever it is read (a load's memo key, a store's
// address, a crossing's operand, a comparison), the body's register and the
// clause's expression are ONE term, and a chain of wrapped steps can never
// nest a wrap's text inside another's (three copies per level, before).
func:tx_wrap = string(Tx->:t, string:x, int64:bits) never fails {
    string:w = raw wrap_text(x, bits);
    for (int64:i in 0i64...t.wr_text.count) {
        if (raw text_eq(raw strlist_view(t.wr_text, i), w)) { pass (raw strlist_copy(t.wr_sym, i)); }
    }
    string:sym = raw tx_fresh(t, "w");
    drop tx_define(t, sym, "Int", w);
    drop strlist_push(@t.wr_text, w);
    drop strlist_push(@t.wr_sym, sym);
    pass sym;
};

// THE LINEAR SHAPE, ONE TEXT: `root + parts + off` -- a numeral offset past
// half the width spelled as the subtraction of its complement (`(- ip 16)`),
// the sum PLAIN where the address lies inside an object the caller declared,
// a fresh block or the stack (`addr_in_object`: no wrap can happen), wrapped
// once otherwise. The GEP arm and the addition fold both build their result
// here, so `%p = gep %line, %pos` then `gep %p, 5` and a clause's
// `(+ line pos 5)` are the same term.
func:tx_lin_term = Term(Tx->:t, string:root, List<string>:parts, uint128:off, int64:bits) never fails {
    string:joined = "";
    for (int64:pj in 0i64...parts.count) {
        if (pj > 0i64) { joined = string_concat(joined, " "); }
        joined = string_concat(joined, raw strlist_view(parts, pj));
    }
    if ((parts.count == 0i64) && (off == 0u128)) {
        Term:r0 = raw term_int(root, bits);
        r0.lin_root = raw text_copy(root);
        r0.lin_off = 0u128;
        pass r0;
    }
    uint128:half = raw u128_pow2(bits - 1i64);
    bool:neg = off >= half;
    // THE ATOMS IN CANONICAL ORDER (the root among them), the numeral last:
    // `line + (k + pos)` and a clause's `(+ line pos k)` are one text
    // whatever order the body added in (`sum_atoms_text`)
    string:prefix = raw text_copy(root);
    if (parts.count > 0i64) {
        List<string>:atoms = raw list_init::<string>(parts.count + 1i64);
        drop strlist_push(@atoms, root);
        for (int64:pa in 0i64...parts.count) { drop strlist_push(@atoms, raw strlist_view(parts, pa)); }
        prefix = raw sum_atoms_text(atoms, "");
    }
    string:sum = "";
    if (parts.count == 0i64) { sum = raw lin_sum_text(root, off, bits); }
    else {
        sum = raw text_copy(prefix);
        if ((off != 0u128) && (!neg)) {
            List<string>:atoms2 = raw list_init::<string>(parts.count + 1i64);
            drop strlist_push(@atoms2, root);
            for (int64:pb in 0i64...parts.count) { drop strlist_push(@atoms2, raw strlist_view(parts, pb)); }
            sum = raw sum_atoms_text(atoms2, raw u128_text(off));
        }
        if (neg) { sum = raw smt_app2("-", prefix, raw u128_text(raw u128_sub(0u128, off, bits))); }
    }
    Term:r = raw term_none();
    if ((bits == 64i64) && (!neg) && (raw addr_in_object(t, prefix, off))) { r = raw term_int(sum, bits); }
    else { r = raw term_int(raw tx_wrap(t, sum, bits), bits); }
    r.lin_root = raw text_copy(root);
    r.lin_parts = move(joined);
    r.lin_off = off;
    pass r;
};

// `(+ atoms... [numeral])` with the non-numeral atoms in lexicographic order
// and the numerals after them in their own order: the one spelling of a sum
// both sides write, whatever order they computed in.
func:sum_atoms_text = string(List<string>:atoms, string:numeral) never fails {
    List<string>:syms = raw list_init::<string>(atoms.count);
    List<string>:nums = raw list_init::<string>(2i64);
    for (int64:i in 0i64...atoms.count) {
        string:a = raw strlist_view(atoms, i);
        if (raw is_numeral(a)) { drop strlist_push(@nums, a); } else { drop strlist_push(@syms, a); }
    }
    List<string>:sorted = raw strlist_sorted(syms);
    string:out = "(+";
    for (int64:j in 0i64...sorted.count) { out = string_concat(out, " "); out = string_concat(out, raw strlist_view(sorted, j)); }
    for (int64:k in 0i64...nums.count) { out = string_concat(out, " "); out = string_concat(out, raw strlist_view(nums, k)); }
    if (numeral.len > 0i64) { out = string_concat(out, " "); out = string_concat(out, numeral); }
    pass (string_concat(out, ")"));
};

// A plain sum of atoms: `(+ a b 8)`, `(- ip 16)`, `(+ line (* 8 ci))` -- the
// unwrapped shape `tx_lin_term` gives an address inside an object; a
// register defined as one reads as the text, as one defined as a symbol does.
func:is_plain_sum = bool(string:x) never fails {
    if (!((raw text_starts_with(x, "(+ ") || raw text_starts_with(x, "(- ")) && (raw text_ends_with(x, ")")))) { pass false; }
    List<string>:parts = raw smt_split_top(raw text_slice(x, 3i64, x.len - 1i64));
    if (parts.count < 2i64) { pass false; }
    for (int64:i in 0i64...parts.count) {
        string:p = raw strlist_view(parts, i);
        if (raw text_starts_with(p, "(")) {
            // a scaled index `(* k sym)`: two atoms
            if (!(raw text_starts_with(p, "(* ") && raw text_ends_with(p, ")"))) { pass false; }
            List<string>:ps = raw smt_split_top(raw text_slice(p, 3i64, p.len - 1i64));
            if (ps.count != 2i64) { pass false; }
            if (raw text_starts_with(raw strlist_view(ps, 0i64), "(") || raw text_starts_with(raw strlist_view(ps, 1i64), "(")) { pass false; }
            continue;
        }
        if (!(raw is_word_atom(p, 128i64))) { pass false; }
    }
    pass true;
};

// A DIVISION BY A POWER OF TEN IS THE CHAIN OF DIVISIONS BY TEN the digit
// loop computes: `(div v 1000)` renders as `(div (div (div v 10) 10) 10)`,
// both for the body's folded quotient and for a clause's. Measured on
// `npk_hs_put_dec`'s per-length rows (z3 4.16.0, the profile): the flat
// constants decide the ten-digit row in 4 s and never return the answer for
// nineteen digits; the chain decides ten digits in 1.7 s and nineteen in
// 15 s -- each quotient a linear relation with a one-digit remainder to the
// one before it, where the flat form relates twenty quotients of one value
// through twenty independent remainders. Any other divisor stays as written.
func:div_text = string(string:x, string:by) never fails {
    int64:n = 0i64;
    if (raw text_starts_with(by, "1")) {
        bool:pow10 = true;
        for (int64:i in 1i64...by.len) { if (by.ptr[i] != 48u8) { pow10 = false; } }
        if (pow10) { n = by.len - 1i64; }
    }
    if (n < 2i64) { pass (raw smt_app2("div", x, by)); }
    string:out = raw text_copy(x);
    for (int64:k in 0i64...n) { out = string_concat(raw smt_app2("div", out, "10"), ""); }
    pass out;
};

func:tx_arith = Term(Tx->:t, string:op, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (a.is_num && b.is_num) {
        if (raw text_eq(op, "add")) { pass (raw term_num(raw u128_add(a.num, b.num, bits), bits)); }
        if (raw text_eq(op, "sub")) { pass (raw term_num(raw u128_sub(a.num, b.num, bits), bits)); }
        if (bits <= 64i64) { pass (raw term_num(raw u128_wrap(a.num * b.num, bits), bits)); }
    }
    string:sop = "+";
    if (raw text_eq(op, "sub")) { sop = "-"; }
    if (raw text_eq(op, "mul")) { sop = "*"; if (!(a.is_num || b.is_num)) { t.nonlinear = true; } }
    if (!(raw text_eq(op, "mul"))) {
        // A CHAIN OF ADDITIONS OF NUMERALS FOLDS: `x + c` is `ROOT + off` wrapped
        // once, whatever chain of wrapped steps `x` is -- an unrolled counter's
        // twentieth value is `(mod (+ j 20) 2^64)`, not twenty nested wraps
        // the solver would have to normalise before comparing two addresses
        bool:xa = (!a.is_num) && b.is_num;
        bool:xb = a.is_num && (!b.is_num) && (raw text_eq(op, "add"));
        if (xa || xb) {
            string:xtext = raw text_copy(raw strlist_view_of(a.text));
            string:xroot = raw text_copy(raw strlist_view_of(a.lin_root));
            uint128:xoff = a.lin_off;
            string:xparts = raw text_copy(raw strlist_view_of(a.lin_parts));
            uint128:c = b.num;
            if (xb) { xtext = raw text_copy(raw strlist_view_of(b.text)); xroot = raw text_copy(raw strlist_view_of(b.lin_root)); xoff = b.lin_off; xparts = raw text_copy(raw strlist_view_of(b.lin_parts)); c = a.num; }
            if (raw text_eq(op, "sub")) { c = raw u128_sub(0u128, c, bits); }
            string:root = raw text_copy(raw strlist_view_of(xtext));
            uint128:off = c;
            List<string>:lparts = raw list_init::<string>(4i64);
            if (xroot.len > 0i64) {
                root = raw text_copy(raw strlist_view_of(xroot));
                off = raw u128_add(xoff, c, bits);
                if (xparts.len > 0i64) { lparts = raw smt_split_top(xparts); }
            }
            pass (raw tx_lin_term(t, root, lparts, off, bits));
        }
        // TWO SYMBOLS ADDED: the linear shape grows by a part -- `ch + go` is
        // root `ch`, part `go`; a later `+ 8` then reads `(+ ch go 8)`, the
        // flat sum a clause writes, instead of a wrap of a wrap (`tx_lin_term`)
        if (raw text_eq(op, "add")) {
            string:aroot = raw text_copy(raw strlist_view_of(a.text));
            uint128:aoff = 0u128;
            List<string>:aparts = raw list_init::<string>(4i64);
            if (a.lin_root.len > 0i64) {
                aroot = raw text_copy(raw strlist_view_of(a.lin_root));
                aoff = a.lin_off;
                if (a.lin_parts.len > 0i64) { aparts = raw smt_split_top(raw strlist_view_of(a.lin_parts)); }
            }
            if (b.lin_root.len > 0i64) {
                drop strlist_push(@aparts, raw strlist_view_of(b.lin_root));
                if (b.lin_parts.len > 0i64) {
                    List<string>:bparts = raw smt_split_top(raw strlist_view_of(b.lin_parts));
                    for (int64:bi in 0i64...bparts.count) { drop strlist_push(@aparts, raw strlist_view(bparts, bi)); }
                }
                aoff = raw u128_add(aoff, b.lin_off, bits);
            } else { drop strlist_push(@aparts, raw strlist_view_of(b.text)); }
            pass (raw tx_lin_term(t, aroot, aparts, aoff, bits));
        }
        // two symbols subtracted: each operand as its own word (a register's
        // name), so the difference wraps by one comparison and a clause over
        // the same two words reads the same
        pass (raw term_int(raw tx_wrap(t, raw smt_app2(sop, a.text, b.text), bits), bits));
    }
    Term:r = raw term_int(raw tx_wrap(t, raw smt_app2(sop, a.text, b.text), bits), bits);
    // a multiplication by a power of two is a shift's shape
    if (raw text_eq(op, "mul")) {
        if (b.is_num) { int64:k = raw u128_log2(b.num); if (k >= 0i64) { r.shl_k = k; } }
        if (a.is_num) { int64:k2 = raw u128_log2(a.num); if (k2 >= 0i64) { r.shl_k = k2; } }
    }
    pass r;
};

func:tx_udiv = Term(Tx->:t, string:op, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (a.is_num && b.is_num && (b.num != 0u128)) {
        if (raw text_eq(op, "udiv")) { pass (raw term_num(a.num / b.num, bits)); }
        pass (raw term_num(a.num % b.num, bits));
    }
    if (!b.is_num) {
        List<string>:cvals = raw list_init::<string>(16i64);
        string:cidx = raw divisor_cases(t, raw strlist_view_of(b.text), @cvals);
        if (cidx.len > 0i64) {
            string:dop = "div";
            if (raw text_eq(op, "urem")) { dop = "mod"; }
            pass (raw term_int(string_concat(raw div_over_cases(t, dop, raw strlist_view_of(a.text), cidx, cvals, bits), ""), bits));
        }
        t.nonlinear = true;
    }
    if (raw text_eq(op, "udiv")) {
        // A CHAIN OF DIVISIONS BY NUMERALS FOLDS: `div (div v a) b` is `div v (a * b)`
        // for the non-negative v every Int here is -- so the k-th quotient of a
        // decimal loop reads as `(div v 10^k)`, the form a clause writes, and
        // the solver matches the two by congruence instead of relating nineteen
        // nested quotients through their remainders
        string:root = raw text_copy(raw strlist_view_of(a.text));
        uint128:by = b.num;
        uint128:lim64 = (4294967295u128 * 4294967296u128) + 4294967295u128;   // 2^64 - 1, built (D-148)
        if (b.is_num && (a.div_by != 0u128) && (a.div_root.len > 0i64) && (a.div_by <= lim64) && (b.num <= lim64)) {
            root = raw text_copy(raw strlist_view_of(a.div_root));
            by = a.div_by * b.num;
        }
        Term:r = raw term_none();
        if (b.is_num) { r = raw term_int(raw div_text(root, raw u128_text(by)), bits); r.div_root = raw text_copy(raw strlist_view_of(root)); r.div_by = by; }
        else { r = raw term_int(raw smt_app2("div", a.text, b.text), bits); }
        if (b.is_num) { int64:k = raw u128_log2(b.num); if (k >= 0i64) { r.lt_k = bits - k; } }
        pass r;
    }
    Term:r2 = raw term_int(raw smt_app2("mod", a.text, b.text), bits);
    if (b.is_num) { r2.lt_k = raw u128_bitlen(b.num); }
    pass r2;
};

// Truncated signed division and remainder over the signed views, the
// result re-wrapped: the shape `smt_encode.npk` writes for a program's `/`.
func:tx_sdiv = Term(Tx->:t, string:op, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    t.nonlinear = true;
    string:sa = raw signed_view(a.text, bits);
    string:sb = raw signed_view(b.text, bits);
    string:q = raw smt_app3("ite", raw smt_app2(">=", sa, "0"),
                 raw smt_app3("ite", raw smt_app2(">=", sb, "0"), raw smt_app2("div", sa, sb), raw smt_app1("-", raw smt_app2("div", sa, raw smt_app1("-", sb)))),
                 raw smt_app3("ite", raw smt_app2(">=", sb, "0"), raw smt_app1("-", raw smt_app2("div", raw smt_app1("-", sa), sb)), raw smt_app2("div", raw smt_app1("-", sa), raw smt_app1("-", sb))));
    if (raw text_eq(op, "sdiv")) { pass (raw term_int(raw tx_wrap(t, q, bits), bits)); }
    string:rem = raw smt_app2("-", sa, raw smt_app2("*", sb, q));
    pass (raw term_int(raw tx_wrap(t, rem, bits), bits));
};

// THE CROSSING (D-280): both operands into bit-vectors of the width, the
// operation there, the result back as a natural -- at 64 bits or less;
// wider it is opaque (a fresh symbol with the range axiom).
func:tx_cross = Term(Tx->:t, string:bvop, Term:a, Term:b, int64:bits) never fails {
    if (bits > 64i64) {
        string:o = raw tx_fresh(t, "opaque");
        drop tx_declare(t, o, "Int");
        drop tx_range(t, o, bits);
        pass (raw term_int(o, bits));
    }
    // one builder for the body's crossing and a clause's (`cross_text`): the
    // same text is the same `|bv:N|` symbol on both sides
    pass (raw term_int(raw cross_text(t, bvop, raw strlist_view_of(a.text), raw strlist_view_of(b.text), bits), bits));
};

func:tx_shift = Term(Tx->:t, string:op, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (b.is_num) {
        int64:k = b.num =>! int64;
        if (b.num >= (bits =>! uint128)) {
            drop tx_problem(t, "a shift by an amount at or past the width: poison the floor must not mint");
            pass (raw term_none());
        }
        if (a.is_num) {
            if (raw text_eq(op, "shl")) {
                uint128:v = a.num;
                for (int64:i in 0i64...k) { v = raw u128_add(v, v, bits); }
                pass (raw term_num(v, bits));
            }
            if (raw text_eq(op, "lshr")) { pass (raw term_num(a.num / (raw u128_pow2(k)), bits)); }
        }
        if (raw text_eq(op, "shl")) {
            Term:r = raw term_int(raw tx_wrap(t, raw smt_app2("*", a.text, raw pow2_text(k)), bits), bits);
            r.shl_k = k;
            pass r;
        }
        if (raw text_eq(op, "lshr")) {
            Term:r2 = raw term_int(raw smt_app2("div", a.text, raw pow2_text(k)), bits);
            r2.lt_k = bits - k;
            pass r2;
        }
        // ashr: the signed view divided (floor), re-wrapped
        string:sv = raw signed_view(a.text, bits);
        pass (raw term_int(raw tx_wrap(t, raw smt_app2("div", sv, raw pow2_text(k)), bits), bits));
    }
    string:bvs = "bvshl";
    if (raw text_eq(op, "lshr")) { bvs = "bvlshr"; }
    if (raw text_eq(op, "ashr")) { bvs = "bvashr"; }
    pass (raw tx_cross(t, bvs, a, b, bits));
};

// `and` with a numeral: the Int forms of D-279; two symbols: the crossing.
func:tx_and = Term(Tx->:t, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (raw text_eq(a.sort, "Bool")) { pass (raw term_bool(raw smt_app2("and", a.text, b.text))); }
    if (a.is_num && b.is_num) {
        // fold bit by bit
        uint128:x = a.num; uint128:y = b.num; uint128:r = 0u128; uint128:p = 1u128;
        for (int64:i in 0i64...bits) {
            if (((x % 2u128) == 1u128) && ((y % 2u128) == 1u128)) { r = r + p; }
            x = x / 2u128; y = y / 2u128;
            if (i < 127i64) { p = p * 2u128; }
        }
        pass (raw term_num(r, bits));
    }
    Term:x2 = raw term_copy(a);
    Term:m = raw term_copy(b);
    if (a.is_num) { x2 = raw term_copy(b); m = raw term_copy(a); }
    if (m.is_num) {
        // 2^k - 1: the low k bits
        int64:k = raw u128_log2(m.num + 1u128);
        if ((k >= 0i64) && (m.num != 0u128)) {
            Term:r1 = raw term_int(raw smt_app2("mod", x2.text, raw pow2_text(k)), bits);
            r1.lt_k = k;
            pass r1;
        }
        if (m.num == 0u128) { pass (raw term_num(0u128, bits)); }
        // -2^k (the high bits): x - (mod x 2^k)
        uint128:neg = raw u128_sub(0u128, m.num, bits);
        int64:k2 = raw u128_log2(neg);
        if (k2 >= 0i64) {
            pass (raw term_int(raw smt_app2("-", x2.text, raw smt_app2("mod", x2.text, raw pow2_text(k2))), bits));
        }
        // 2^j: the bit test
        int64:j = raw u128_log2(m.num);
        if (j >= 0i64) {
            string:bit = raw smt_app2("mod", raw smt_app2("div", x2.text, raw pow2_text(j)), "2");
            pass (raw term_int(raw smt_app2("*", bit, raw pow2_text(j)), bits));
        }
    }
    pass (raw tx_cross(t, "bvand", a, b, bits));
};

// `or`: a fresh symbol carrying every fact that holds of a bitwise or, and
// the exact reading under each side condition the operands' shapes suggest
// (the header's account).
func:tx_or = Term(Tx->:t, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (raw text_eq(a.sort, "Bool")) { pass (raw term_bool(raw smt_app2("or", a.text, b.text))); }
    if (a.is_num && b.is_num) {
        uint128:x = a.num; uint128:y = b.num; uint128:r = 0u128; uint128:p = 1u128;
        for (int64:i in 0i64...bits) {
            if (((x % 2u128) == 1u128) || ((y % 2u128) == 1u128)) { r = r + p; }
            x = x / 2u128; y = y / 2u128;
            if (i < 127i64) { p = p * 2u128; }
        }
        pass (raw term_num(r, bits));
    }
    if (a.is_num) { if (a.num == 0u128) { pass (raw term_copy(b)); } }
    if (b.is_num) { if (b.num == 0u128) { pass (raw term_copy(a)); } }
    string:o = raw tx_fresh(t, "or");
    drop tx_declare(t, o, "Int");
    drop tx_hyp(t, raw smt_app2("<=", a.text, o), "or", 0i64);
    drop tx_hyp(t, raw smt_app2("<=", b.text, o), "or", 0i64);
    drop tx_hyp(t, raw smt_app2("<=", o, raw smt_app2("+", a.text, b.text)), "or", 0i64);
    drop tx_hyp(t, raw smt_app2("<", o, raw pow2_text(bits)), "or", 0i64);
    drop tx_hyp(t, raw smt_app2("<=", "0", o), "or", 0i64);
    // the candidate widths
    List<int64>:ks = raw list_init::<int64>(4i64);
    if (a.shl_k > 0i64) { drop list_push(@ks, a.shl_k); }
    if (b.shl_k > 0i64) { drop list_push(@ks, b.shl_k); }
    if ((a.lt_k > 0i64) && (a.lt_k < bits)) { drop list_push(@ks, a.lt_k); }
    if ((b.lt_k > 0i64) && (b.lt_k < bits)) { drop list_push(@ks, b.lt_k); }
    for (int64:i2 in 0i64...ks.count) {
        int64:k = ks[i2];
        string:p2 = raw pow2_text(k);
        // a's low k bits clear and b below 2^k: o = a + b; and the other way round
        drop tx_hyp(t, raw smt_app2("=>", raw smt_app2("and", raw smt_app2("=", raw smt_app2("mod", a.text, p2), "0"), raw smt_app2("<", b.text, p2)),
                                          raw smt_app2("=", o, raw smt_app2("+", a.text, b.text))), "or", 0i64);
        drop tx_hyp(t, raw smt_app2("=>", raw smt_app2("and", raw smt_app2("=", raw smt_app2("mod", b.text, p2), "0"), raw smt_app2("<", a.text, p2)),
                                          raw smt_app2("=", o, raw smt_app2("+", a.text, b.text))), "or", 0i64);
    }
    pass (raw term_int(o, bits));
};

func:tx_xor = Term(Tx->:t, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (raw text_eq(a.sort, "Bool")) { pass (raw term_bool(raw smt_app2("xor", a.text, b.text))); }
    if (a.is_num && b.is_num) {
        uint128:x = a.num; uint128:y = b.num; uint128:r = 0u128; uint128:p = 1u128;
        for (int64:i in 0i64...bits) {
            if (((x % 2u128) == 1u128) != ((y % 2u128) == 1u128)) { r = r + p; }
            x = x / 2u128; y = y / 2u128;
            if (i < 127i64) { p = p * 2u128; }
        }
        pass (raw term_num(r, bits));
    }
    // the complement: xor with all ones
    Term:x2 = raw term_copy(a);
    Term:m = raw term_copy(b);
    if (a.is_num) { x2 = raw term_copy(b); m = raw term_copy(a); }
    if (m.is_num) {
        if (m.num == (raw u128_mask_of(bits))) {
            pass (raw term_int(raw smt_app2("-", raw pow2_minus_one_decimal(bits), x2.text), bits));
        }
        if (m.num == 0u128) { pass (raw term_copy(x2)); }
    }
    pass (raw tx_cross(t, "bvxor", a, b, bits));
};

// icmp over Ints (unsigned reading; the signed predicates over the signed
// views); over Bools, equality.
func:tx_icmp = Term(Tx->:t, string:pred, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    if (raw text_eq(a.sort, "Bool")) {
        if (raw text_eq(pred, "eq")) { pass (raw term_bool(raw smt_app2("=", a.text, b.text))); }
        if (raw text_eq(pred, "ne")) { pass (raw term_bool(raw smt_app1("not", raw smt_app2("=", a.text, b.text)))); }
        drop tx_problem(t, string_concat("an icmp over i1 with a predicate other than eq/ne: ", pred));
        pass (raw term_none());
    }
    if (a.is_num && b.is_num) {
        bool:r = false;
        if (raw text_eq(pred, "eq")) { r = (a.num == b.num); }
        if (raw text_eq(pred, "ne")) { r = (a.num != b.num); }
        if (raw text_eq(pred, "ult")) { r = (a.num < b.num); }
        if (raw text_eq(pred, "ule")) { r = (a.num <= b.num); }
        if (raw text_eq(pred, "ugt")) { r = (a.num > b.num); }
        if (raw text_eq(pred, "uge")) { r = (a.num >= b.num); }
        bool:signed = raw text_starts_with(pred, "s");
        if (!signed) { if (r) { pass (raw term_bool("true")); } pass (raw term_bool("false")); }
    }
    string:x = raw text_copy(raw strlist_view_of(a.text));
    string:y = raw text_copy(raw strlist_view_of(b.text));
    if (raw text_starts_with(pred, "s")) {
        x = raw signed_view(x, bits);
        y = raw signed_view(y, bits);
    }
    if (raw text_eq(pred, "eq")) { pass (raw term_bool(raw smt_app2("=", x, y))); }
    if (raw text_eq(pred, "ne")) { pass (raw term_bool(raw smt_app1("not", raw smt_app2("=", x, y)))); }
    if (raw text_eq(pred, "ult") || raw text_eq(pred, "slt")) { pass (raw term_bool(raw smt_app2("<", x, y))); }
    if (raw text_eq(pred, "ule") || raw text_eq(pred, "sle")) { pass (raw term_bool(raw smt_app2("<=", x, y))); }
    if (raw text_eq(pred, "ugt") || raw text_eq(pred, "sgt")) { pass (raw term_bool(raw smt_app2(">", x, y))); }
    if (raw text_eq(pred, "uge") || raw text_eq(pred, "sge")) { pass (raw term_bool(raw smt_app2(">=", x, y))); }
    drop tx_problem(t, string_concat("an icmp predicate the translator does not read: ", pred));
    pass (raw term_none());
};

func:tx_fcmp = Term(Tx->:t, string:pred, Term:a, Term:b) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    t.uses_fp = true;
    string:nan = raw smt_app2("or", raw smt_app1("fp.isNaN", a.text), raw smt_app1("fp.isNaN", b.text));
    if (raw text_eq(pred, "uno")) { pass (raw term_bool(nan)); }
    if (raw text_eq(pred, "ord")) { pass (raw term_bool(raw smt_app1("not", nan))); }
    if (raw text_eq(pred, "oeq")) { pass (raw term_bool(raw smt_app2("fp.eq", a.text, b.text))); }
    if (raw text_eq(pred, "une")) { pass (raw term_bool(raw smt_app1("not", raw smt_app2("fp.eq", a.text, b.text)))); }
    if (raw text_eq(pred, "olt")) { pass (raw term_bool(raw smt_app2("fp.lt", a.text, b.text))); }
    if (raw text_eq(pred, "ole")) { pass (raw term_bool(raw smt_app2("fp.leq", a.text, b.text))); }
    if (raw text_eq(pred, "ogt")) { pass (raw term_bool(raw smt_app2("fp.gt", a.text, b.text))); }
    if (raw text_eq(pred, "oge")) { pass (raw term_bool(raw smt_app2("fp.geq", a.text, b.text))); }
    drop tx_problem(t, string_concat("an fcmp predicate the translator does not read: ", pred));
    pass (raw term_none());
};

func:tx_farith = Term(Tx->:t, string:op, Term:a, Term:b, int64:bits) never fails {
    if (!(a.ok && b.ok)) { pass (raw term_none()); }
    t.uses_fp = true;
    string:fop = "fp.add";
    if (raw text_eq(op, "fsub")) { fop = "fp.sub"; }
    if (raw text_eq(op, "fmul")) { fop = "fp.mul"; }
    if (raw text_eq(op, "fdiv")) { fop = "fp.div"; }
    if (raw text_eq(op, "frem")) {
        string:o = raw tx_fresh(t, "opaque");
        drop tx_declare(t, o, "F64");
        if (bits == 32i64) { drop tx_declare(t, o, "F32"); }
        pass (raw term_fp(o, bits));
    }
    pass (raw term_fp(raw smt_app3(fop, "RNE", a.text, b.text), bits));
};

// The casts: identities and the width changes of the Int reading.
func:tx_cast = Term(Tx->:t, string:op, Term:a, string:from_ty, string:to_ty) never fails {
    if (!a.ok) { pass (raw term_none()); }
    int64:fb = raw ty_bits(from_ty);
    int64:tb = raw ty_bits(to_ty);
    string:ts = raw ty_sort(to_ty);
    if (raw text_eq(op, "zext")) {
        if (raw text_eq(a.sort, "Bool")) { pass (raw term_int_lt(raw smt_app3("ite", a.text, "1", "0"), tb, 1i64)); }
        if (a.is_num) { pass (raw term_num(a.num, tb)); }
        Term:r = raw term_int(raw strlist_view_of(a.text), tb);
        r.lt_k = fb;
        if ((a.lt_k > 0i64) && (a.lt_k < fb)) { r.lt_k = a.lt_k; }
        pass r;
    }
    if (raw text_eq(op, "sext")) {
        if (raw text_eq(a.sort, "Bool")) { pass (raw term_int(raw smt_app3("ite", a.text, raw pow2_minus_one_decimal(tb), "0"), tb)); }
        if (a.is_num) {
            if (a.num >= (raw u128_pow2(fb - 1i64))) { pass (raw term_num(raw u128_add(a.num, raw u128_sub(raw u128_pow2(tb), raw u128_pow2(fb), tb), tb), tb)); }
            pass (raw term_num(a.num, tb));
        }
        string:wide = raw smt_app3("ite", raw smt_app2(">=", a.text, raw pow2_text(fb - 1i64)),
                                   raw smt_app2("+", a.text, raw smt_app2("-", raw pow2_text(tb), raw pow2_text(fb))), a.text);
        pass (raw term_int(wide, tb));
    }
    if (raw text_eq(op, "trunc")) {
        if (raw text_eq(ts, "Bool")) {
            if (a.is_num) { if ((a.num % 2u128) == 1u128) { pass (raw term_bool("true")); } pass (raw term_bool("false")); }
            pass (raw term_bool(raw smt_app2("=", raw smt_app2("mod", a.text, "2"), "1")));
        }
        if (a.is_num) { pass (raw term_num(raw u128_wrap(a.num, tb), tb)); }
        Term:r2 = raw term_int(raw smt_app2("mod", a.text, raw pow2_text(tb)), tb);
        r2.lt_k = tb;
        pass r2;
    }
    if (raw text_eq(op, "ptrtoint") || raw text_eq(op, "inttoptr")) {
        if (fb == tb) { pass (raw term_copy(a)); }
        if (tb < fb) { if (a.is_num) { pass (raw term_num(raw u128_wrap(a.num, tb), tb)); } pass (raw term_int(raw smt_app2("mod", a.text, raw pow2_text(tb)), tb)); }
        if (a.is_num) { pass (raw term_num(a.num, tb)); }
        pass (raw term_int(raw strlist_view_of(a.text), tb));
    }
    if (raw text_eq(op, "bitcast")) {
        if (raw text_eq(a.sort, raw ty_sort(to_ty))) { pass (raw term_copy(a)); }
        drop tx_problem(t, "a bitcast between sorts: not read");
        pass (raw term_none());
    }
    if (raw text_eq(op, "fpext")) { t.uses_fp = true; pass (raw term_fp(raw smt_app1("(_ to_fp 11 53) RNE", a.text), 64i64)); }
    if (raw text_eq(op, "fptrunc")) { t.uses_fp = true; pass (raw term_fp(raw smt_app1("(_ to_fp 8 24) RNE", a.text), 32i64)); }
    if (raw text_eq(op, "sitofp") || raw text_eq(op, "uitofp")) {
        t.uses_fp = true;
        string:eb = "(_ to_fp 11 53) RNE";
        if (tb == 32i64) { eb = "(_ to_fp 8 24) RNE"; }
        string:v = raw text_copy(raw strlist_view_of(a.text));
        if (raw text_eq(op, "sitofp")) { v = raw signed_view(v, fb); }
        pass (raw term_fp(raw smt_app1(eb, raw smt_app1("to_real", v)), tb));
    }
    drop tx_problem(t, string_concat("a cast the translator does not read: ", op));
    pass (raw term_none());
};

func:term_int_lt = Term(string:text, int64:bits, int64:lt_k) never fails {
    Term:r = raw term_int(text, bits);
    r.lt_k = lt_k;
    pass r;
};

// --- the spec file's sections --------------------------------------------------------------------

// The `(symbol @name ...)` root of the spec, or -1.
pub func:spec_section = int64(Sxs->:s, string:name) never fails {
    for (int64:i in 0i64...s.roots.count) {
        int64:r = s.roots[i];
        if (!(raw text_eq(raw sx_head(s, r), "symbol"))) { continue; }
        if (raw text_eq(raw sx_atom(s, raw sx_nth(s, r, 1i64)), name)) { pass r; }
    }
    pass (0i64 - 1i64);
};

// The k-th child clause of `sec` whose head is `head` (0-based), or -1.
pub func:spec_clause = int64(Sxs->:s, int64:sec, string:head, int64:k) never fails {
    if (sec < 0i64) { pass (0i64 - 1i64); }
    int64:n = 0i64;
    int64:c = s.nodes[sec].first;
    while (c >= 0i64) decreases s.nodes.count - c {
        if (raw sx_is_list(s, c)) {
            if (raw text_eq(raw sx_head(s, c), head)) {
                if (n == k) { pass c; }
                n = n + 1i64;
            }
        }
        c = s.nodes[c].next;
    }
    pass (0i64 - 1i64);
};

pub func:spec_clause_count = int64(Sxs->:s, int64:sec, string:head) never fails {
    int64:n = 0i64;
    while ((raw spec_clause(s, sec, head, n)) >= 0i64) decreases s.nodes.count - n { n = n + 1i64; }
    pass n;
};

pub func:spec_has = bool(Sxs->:s, int64:sec, string:head) never fails {
    pass ((raw spec_clause(s, sec, head, 0i64)) >= 0i64);
};

// The `(loop LABEL ...)` clause of a section, or -1.
pub func:spec_loop = int64(Sxs->:s, int64:sec, string:label) never fails {
    int64:k = 0i64;
    while (true) decreases s.nodes.count - k {
        int64:c = raw spec_clause(s, sec, "loop", k);
        if (c < 0i64) { pass (0i64 - 1i64); }
        if (raw text_eq(raw sx_atom(s, raw sx_nth(s, c, 1i64)), label)) { pass c; }
        k = k + 1i64;
    }
    pass (0i64 - 1i64);
};

// --- rendering a clause -----------------------------------------------------------------------------
//
// A clause is SMT-LIB2 text over the spec's names (§2.5). The renderer
// walks the S-expression and spells every atom in the translation's
// vocabulary: an override first (a header phi's original name -> the back
// edge's value; a callee parameter -> the argument), then `mem`/`mem2`,
// `result`, `trap`, `trap_code`, `exec`, a free symbol, a global's address,
// and last a register through the block's environment. The load macros
// expand to the byte reassembly over the named memory; the 64-bit bit
// operations to the crossing.

pub struct:REnv = {
    List<string>:from;       // overrides: the spec's spelling
    List<string>:to;         // its SMT text
    string:mem;              // what `mem` renders as
    string:mem2;             // what `mem2` renders as ("" when not allowed)
    bool:allow_result;
    bool:allow_regs;         // false at a summary site
    bool:probe;              // a failure sets `failed` instead of reporting a problem
    bool:failed;
};

pub func:renv_new = REnv(string:mem, string:mem2, bool:allow_result, bool:allow_regs) never fails {
    pass REnv{ from: raw list_init::<string>(4i64), to: raw list_init::<string>(4i64),
               mem: raw text_copy(mem), mem2: raw text_copy(mem2), allow_result: allow_result, allow_regs: allow_regs,
               probe: false, failed: false };
};

pub func:renv_add = NIL(REnv->:e, string:from, string:to) never fails {
    drop strlist_push(@e.from, from);
    drop strlist_push(@e.to, to);
    pass NIL;
};

func:is_smt_builtin = bool(string:a) never fails {
    if (raw text_eq(a, "and")) { pass true; }   if (raw text_eq(a, "or")) { pass true; }
    if (raw text_eq(a, "not")) { pass true; }   if (raw text_eq(a, "=>")) { pass true; }
    if (raw text_eq(a, "=")) { pass true; }     if (raw text_eq(a, "<")) { pass true; }
    if (raw text_eq(a, "<=")) { pass true; }    if (raw text_eq(a, ">")) { pass true; }
    if (raw text_eq(a, ">=")) { pass true; }    if (raw text_eq(a, "+")) { pass true; }
    if (raw text_eq(a, "-")) { pass true; }     if (raw text_eq(a, "*")) { pass true; }
    if (raw text_eq(a, "div")) { pass true; }   if (raw text_eq(a, "mod")) { pass true; }
    if (raw text_eq(a, "abs")) { pass true; }   if (raw text_eq(a, "ite")) { pass true; }
    if (raw text_eq(a, "true")) { pass true; }  if (raw text_eq(a, "false")) { pass true; }
    if (raw text_eq(a, "distinct")) { pass true; } if (raw text_eq(a, "xor")) { pass true; }
    if (raw text_eq(a, "to_real")) { pass true; }
    if (raw text_starts_with(a, "fp.")) { pass true; }
    if (raw text_eq(a, "RNE")) { pass true; }   if (raw text_eq(a, "_")) { pass true; }
    if (raw text_eq(a, "to_fp")) { pass true; }
    pass false;
};

func:is_numeral = bool(string:a) never fails {
    if (a.len == 0i64) { pass false; }
    for (int64:i in 0i64...a.len) {
        uint8:c = a.ptr[i];
        if (!((raw text_is_digit(c)) || (c == 46u8))) { pass false; }
    }
    pass true;
};

func:is_mem_sym = bool(Tx->:t, string:s) never fails {
    if (raw text_eq(s, "mem")) { pass true; }
    if (raw text_eq(s, "mem2")) { pass true; }
    if (raw text_starts_with(s, "|mem")) { pass true; }
    pass false;
};

// One byte-reassembly read of `n` bytes at `addr` from the memory `memsym`.
pub func:load_text = string(Tx->:t, string:memsym, string:addr, int64:n) never fails {
    if (n == 1i64) { pass (raw tx_mem_app(t, memsym, addr)); }
    string:s = "(+";
    for (int64:j in 0i64...n) {
        string:a = raw text_copy(addr);
        if (j > 0i64) { a = raw smt_app2("+", addr, int_to_string(j)); }
        string:app = raw tx_mem_app(t, memsym, a);
        s = string_concat(s, " ");
        if (j == 0i64) { s = string_concat(s, app); }
        else {
            // 256^j * byte
            string:p = "256";
            if (j > 1i64) { p = raw pow2_decimal(8i64 * j); }
            s = string_concat(s, raw smt_app2("*", p, app));
        }
    }
    pass (string_concat(s, ")"));
};

func:cross_text = string(Tx->:t, string:bvop, string:a, string:b, int64:bits) never fails {
    t.uses_bv = true;
    string:tobv = string_concat("(_ int2bv ", int_to_string(bits));
    tobv = string_concat(tobv, ")");
    string:txt = raw smt_app1("bv2nat", raw smt_app2(bvop, raw smt_app1(tobv, a), raw smt_app1(tobv, b)));
    for (int64:i in 0i64...t.cx_text.count) {
        if (raw text_eq(raw strlist_view(t.cx_text, i), txt)) { pass (raw strlist_copy(t.cx_sym, i)); }
    }
    string:sym = raw tx_fresh(t, "bv");
    drop tx_declare(t, sym, "Int");
    drop tx_range(t, sym, bits);
    drop tx_hyp(t, raw smt_app2("=", sym, txt), "bv", 0i64);
    drop strlist_push(@t.cx_text, txt);
    drop strlist_push(@t.cx_sym, sym);
    pass sym;
};

// A renderer's problem: reported, or -- in the probe mode -- recorded on the
// environment for the caller to decide (a summary callee's trap condition over
// its own registers is a condition the caller cannot name).
func:rproblem = NIL(Tx->:t, REnv->:e, string:msg) never fails {
    if (e.probe) { e.failed = true; pass NIL; }
    drop tx_problem(t, msg);
    pass NIL;
};

// The register whose definition is exactly `text`, if the body reads one by
// name ("" for none): the clause's term is then the body's.
func:reg_of_text = string(Tx->:t, string:text) never fails {
    for (int64:i in 0i64...t.rb_text.count) {
        if (raw text_eq(raw strlist_view(t.rb_text, i), text)) { pass (raw strlist_copy(t.rb_sym, i)); }
    }
    pass "";
};

// A clause's node rendered, and a composite text that IS some register's
// definition read as that register (see `tx_set`).
pub func:render = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:node, REnv->:e, BMeta->:m) never fails {
    string:out = raw render_node(t, ft, s, node, e, m);
    if (raw text_starts_with(out, "(")) {
        string:r = raw reg_of_text(t, out);
        if (r.len > 0i64) { pass r; }
    }
    pass out;
};

func:render_node = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:node, REnv->:e, BMeta->:m) never fails {
    if (node < 0i64) { drop rproblem(t, e, "a clause is incomplete"); pass "false"; }
    if (raw sx_is_string(s, node)) { drop rproblem(t, e, "a string inside a clause"); pass "false"; }
    if (!(raw sx_is_list(s, node))) {
        string:a = raw sx_atom(s, node);
        if (raw is_numeral(a)) { pass a; }
        if (raw is_smt_builtin(a)) { pass a; }
        for (int64:i in 0i64...e.from.count) {
            if (raw text_eq(raw strlist_view(e.from, i), a)) { pass (raw strlist_copy(e.to, i)); }
        }
        if (raw text_eq(a, "mem")) { pass (raw text_copy(raw strlist_view_of(e.mem))); }
        if (raw text_eq(a, "mem2")) {
            if (e.mem2.len == 0i64) { drop rproblem(t, e, "`mem2` in a clause where only the entry memory exists (a requires)"); pass "false"; }
            pass (raw text_copy(raw strlist_view_of(e.mem2)));
        }
        if (raw text_eq(a, "result") || raw text_starts_with(a, "result.")) {
            if (!e.allow_result) { drop rproblem(t, e, "`result` in a clause that has no result (a requires or an invariant)"); pass "false"; }
            if (!(raw strset_has(t.known, a))) { drop rproblem(t, e, string_concat("no such result field: ", a)); pass "false"; }
            pass a;
        }
        if (raw text_eq(a, "exec") || raw text_eq(a, "tls")) {
            // the per-thread constants: an object of the struct's size, introduced
            // here when a clause names one before the body's call does (an objects
            // clause is rendered before the blocks)
            if (!(raw strset_has(t.known, a))) {
                string:cty = "%npk.exec";
                if (raw text_eq(a, "tls")) { cty = "%npk.tls"; }
                drop tx_object(t, a, raw ty_size(ft, cty));
                drop tx_range(t, a, 64i64);
            }
            pass a;
        }
        if (raw text_eq(a, "trap") || raw text_eq(a, "trap_code")) {
            if (!(raw strset_has(t.known, a))) { drop rproblem(t, e, string_concat("a clause names a symbol the translation has not introduced: ", a)); pass "false"; }
            pass a;
        }
        if (raw strlist_contains(t.free_syms, a)) { pass (raw spec_sym(a)); }
        // an inlined callee's own free symbol (its invariant, rendered in the
        // caller's file): declared here on first use, shared by name
        if ((m.origin_fn.len > 0i64) && (!(raw text_eq(raw strlist_view_of(m.origin_fn), raw strlist_view_of(t.fn))))) {
            int64:osec = raw spec_section(s, raw strlist_view_of(m.origin_fn));
            int64:fk = 0i64;
            while (osec >= 0i64) decreases s.nodes.count - fk {
                int64:fc = raw spec_clause(s, osec, "free", fk);
                if (fc < 0i64) { break; }
                fk = fk + 1i64;
                if (raw text_eq(raw sx_atom(s, raw sx_nth(s, fc, 1i64)), a)) {
                    string:fsym = raw spec_sym(a);
                    if (!(raw strset_has(t.known, fsym))) { drop tx_declare(t, fsym, "Int"); drop strlist_push(@t.free_syms, a); }
                    pass fsym;
                }
            }
        }
        string:g = string_concat("@", a);
        if ((raw floor_global_type(ft, g)).len > 0i64) { pass (raw tx_global(t, ft, g)); }
        if (!e.allow_regs) {
            string:w0 = string_concat("a summary clause names `", a);
            w0 = string_concat(w0, "`: only parameters, result, mem, mem2 and free symbols mean anything at a call");
            drop rproblem(t, e, w0);
            pass "false";
        }
        string:ir = raw meta_rename(m, string_concat("%", a));
        if (raw text_starts_with(ir, "%")) {
            int64:ri = raw reg_index(t, ir);
            if (ri < 0i64) {
                string:w = string_concat("a clause names `", a);
                w = string_concat(w, "`, which is no parameter, register, free symbol or global here");
                drop rproblem(t, e, w);
                pass "false";
            }
            if ((raw strlist_view(t.reg_alias, ri)).len > 0i64) { pass (raw strlist_copy(t.reg_alias, ri)); }
            pass (raw strlist_copy(t.reg_sym, ri));
        }
        if (raw text_starts_with(ir, "@")) { pass (raw tx_global(t, ft, ir)); }
        uint128:v = 0u128;
        if (raw u128_parse(ir, 128i64, @v)) { pass (raw u128_text(v)); }
        drop rproblem(t, e, string_concat("a clause names an operand the translator does not read: ", ir));
        pass "false";
    }
    string:head = raw sx_head(s, node);
    int64:len = raw sx_len(s, node);
    if (raw text_starts_with(head, "load")) {
        int64:n = 0i64;
        if (raw text_eq(head, "load8")) { n = 1i64; }
        if (raw text_eq(head, "load16")) { n = 2i64; }
        if (raw text_eq(head, "load32")) { n = 4i64; }
        if (raw text_eq(head, "load64")) { n = 8i64; }
        if (n > 0i64) {
            if (len != 3i64) { drop rproblem(t, e, string_concat(head, " takes a memory and an address")); pass "false"; }
            string:ms = raw render(t, ft, s, raw sx_nth(s, node, 1i64), e, m);
            if (!(raw is_mem_sym(t, ms))) { drop rproblem(t, e, string_concat(head, "'s first argument is not a memory")); pass "false"; }
            // A COMPUTED ADDRESS WRAPS AT THE ADDRESS SPACE, as the IR's every
            // computed address does (`getelementptr`, `add`, `sub`, `mul`): a
            // spec's `(load64 mem (+ exec 48))` reads where the floor writes only
            // when both are the same 64-bit address. A symbol -- a parameter, a
            // register, a global's address, a free Addr -- or a loaded word is a
            // 64-bit value by its range axiom and stays as it is, as the IR's own
            // load through it does: the two sides match term for term.
            int64:an = raw sx_nth(s, node, 2i64);
            string:ad = raw render(t, ft, s, an, e, m);
            if (raw sx_is_list(s, an)) {
                string:ah = raw sx_head(s, an);
                bool:plain = false;
                if (raw text_eq(ah, "+")) {
                    // `(+ a ... k)` with k a numeral inside the object `(+ a ...)` names: no wrap
                    int64:alen = raw sx_len(s, an);
                    int64:last = raw sx_nth(s, an, alen - 1i64);
                    if ((alen >= 3i64) && (!(raw sx_is_list(s, last))) && (raw is_numeral(raw sx_atom(s, last)))) {
                        uint128:kk = 0u128;
                        if (raw u128_parse(raw sx_atom(s, last), 64i64, @kk)) {
                            string:prefix2 = "";
                            if (alen == 3i64) { prefix2 = raw render(t, ft, s, raw sx_nth(s, an, 1i64), e, m); }
                            else {
                                prefix2 = "(+";
                                for (int64:ai2 in 1i64...(alen - 1i64)) { prefix2 = string_concat(prefix2, " "); prefix2 = string_concat(prefix2, raw render(t, ft, s, raw sx_nth(s, an, ai2), e, m)); }
                                prefix2 = string_concat(prefix2, ")");
                            }
                            if (raw addr_in_object(t, prefix2, kk)) { plain = true; }
                        }
                    }
                }
                if ((!plain) && (raw text_eq(ah, "+") || raw text_eq(ah, "-") || raw text_eq(ah, "*"))) { ad = raw tx_wrap(t, ad, 64i64); }
            }
            string:ld = raw fwd_load(t, ms, ad, n, 0i64);
            // an element of a constant table, `(+ G (* K IDX))`: the same `ite` the body's load reads
            if (raw sx_is_list(s, an)) {
                if ((raw text_eq(raw sx_head(s, an), "+")) && ((raw sx_len(s, an)) == 3i64)) {
                    int64:gn = raw sx_nth(s, an, 1i64);
                    int64:pn = raw sx_nth(s, an, 2i64);
                    if ((!(raw sx_is_list(s, gn))) && (raw sx_is_list(s, pn)) && (raw text_eq(raw sx_head(s, pn), "*")) && ((raw sx_len(s, pn)) == 3i64)) {
                        string:gname2 = string_concat("@", raw sx_atom(s, gn));
                        string:kt = raw sx_atom(s, raw sx_nth(s, pn, 1i64));
                        if (((raw floor_global_init(ft, gname2)).len > 0i64) && (raw is_numeral(kt)) && (raw text_eq(kt, int_to_string(n)))) {
                            string:it2 = raw render(t, ft, s, raw sx_nth(s, pn, 2i64), e, m);
                            string:cti2 = raw const_table_ite(t, ft, gname2, it2, n, ld);
                            if (cti2.len > 0i64) { ld = move(cti2); }
                        }
                    }
                }
            }
            pass ld;
        }
    }
    if (raw text_eq(head, "s8") || raw text_eq(head, "s32") || raw text_eq(head, "s64") || raw text_eq(head, "s128")) {
        // the signed view of a word: `(s64 x)` is x read as a two's-complement Int
        if (len != 2i64) { drop rproblem(t, e, string_concat(head, " takes one operand")); pass "false"; }
        int64:sb = 64i64;
        if (raw text_eq(head, "s8")) { sb = 8i64; }
        if (raw text_eq(head, "s32")) { sb = 32i64; }
        if (raw text_eq(head, "s128")) { sb = 128i64; }
        pass (raw signed_view(raw render(t, ft, s, raw sx_nth(s, node, 1i64), e, m), sb));
    }
    if (raw text_eq(head, "xor64") || raw text_eq(head, "and64") || raw text_eq(head, "or64")) {
        if (len != 3i64) { drop rproblem(t, e, string_concat(head, " takes two operands")); pass "false"; }
        string:bvop = "bvxor";
        if (raw text_eq(head, "and64")) { bvop = "bvand"; }
        if (raw text_eq(head, "or64")) { bvop = "bvor"; }
        // a computed operand wraps, as a load's address does: the word the
        // floor's `xor` sees is the wrapped `add`'s
        int64:xn = raw sx_nth(s, node, 1i64);
        int64:yn = raw sx_nth(s, node, 2i64);
        string:x = raw render(t, ft, s, xn, e, m);
        string:y = raw render(t, ft, s, yn, e, m);
        if (raw sx_is_list(s, xn)) { string:xh = raw sx_head(s, xn); if (raw text_eq(xh, "+") || raw text_eq(xh, "-") || raw text_eq(xh, "*")) { x = raw tx_wrap(t, x, 64i64); } }
        if (raw sx_is_list(s, yn)) { string:yh = raw sx_head(s, yn); if (raw text_eq(yh, "+") || raw text_eq(yh, "-") || raw text_eq(yh, "*")) { y = raw tx_wrap(t, y, 64i64); } }
        if (raw text_eq(head, "and64")) {
            // the body's `and` with a mask reads as `mod` or as the cleared low
            // bits (`tx_and`): the clause's reads the same
            Term:ta = raw term_int(x, 64i64);
            Term:tb = raw term_int(y, 64i64);
            uint128:nx = 0u128;
            uint128:ny = 0u128;
            if (raw u128_parse(x, 64i64, @nx)) { ta = raw term_num(nx, 64i64); }
            if (raw u128_parse(y, 64i64, @ny)) { tb = raw term_num(ny, 64i64); }
            Term:tr = raw tx_and(t, ta, tb, 64i64);
            if (tr.ok) { pass (raw text_copy(raw strlist_view_of(tr.text))); }
        }
        pass (raw cross_text(t, bvop, x, y, 64i64));
    }
    if ((raw text_eq(head, "div") || raw text_eq(head, "mod")) && (len == 3i64)) {
        // a division by a table value distributes over its cases, as the body's does
        string:da = raw render(t, ft, s, raw sx_nth(s, node, 1i64), e, m);
        string:db = raw render(t, ft, s, raw sx_nth(s, node, 2i64), e, m);
        // `(mod X 2^64)` written out is the writer's own wrap: spelled as the body spells it
        if (raw text_eq(head, "mod")) {
            if (raw text_eq(db, raw pow2_text(8i64))) { pass (raw tx_wrap(t, da, 8i64)); }
            if (raw text_eq(db, raw pow2_text(16i64))) { pass (raw tx_wrap(t, da, 16i64)); }
            if (raw text_eq(db, raw pow2_text(32i64))) { pass (raw tx_wrap(t, da, 32i64)); }
            if (raw text_eq(db, raw pow2_text(64i64))) { pass (raw tx_wrap(t, da, 64i64)); }
            if (raw text_eq(db, raw pow2_text(128i64))) { pass (raw tx_wrap(t, da, 128i64)); }
        }
        List<string>:cvals2 = raw list_init::<string>(16i64);
        string:cidx2 = raw divisor_cases(t, db, @cvals2);
        if (cidx2.len > 0i64) { pass (string_concat(raw div_over_cases(t, head, da, cidx2, cvals2, 64i64), "")); }
        if (raw text_eq(head, "div")) { pass (raw div_text(da, db)); }
        pass (raw smt_app2(head, da, db));
    }
    // A PRODUCT OF TWO SYMBOLS IS THE BODY'S `mul`: wrapped as its own word,
    // so `(mod (+ base (* idx stride)) 2^64)` is the body's `add` over the
    // body's `mul` -- the same two named words -- and not a non-linear fact
    // the solver must relate to them. A product with a numeral is a scaled
    // index and stays as written (a `getelementptr`'s part).
    if ((raw text_eq(head, "*")) && (len == 3i64)) {
        string:pa = raw render(t, ft, s, raw sx_nth(s, node, 1i64), e, m);
        string:pb = raw render(t, ft, s, raw sx_nth(s, node, 2i64), e, m);
        if (!((raw is_numeral(pa)) || (raw is_numeral(pb)))) { pass (raw tx_wrap(t, raw smt_app2("*", pa, pb), 64i64)); }
        pass (raw smt_app2("*", pa, pb));
    }
    // A SUM IS WRITTEN IN CANONICAL ORDER (`sum_atoms_text`): the body's flat
    // sums are, so a clause's `(+ line pos k)` and the body's `line + (k + pos)`
    // are one text
    if ((raw text_eq(head, "+")) && (len >= 3i64)) {
        List<string>:sa = raw list_init::<string>(len);
        int64:sc = s.nodes[node].first;
        sc = s.nodes[sc].next;
        while (sc >= 0i64) decreases s.nodes.count - sc { drop strlist_push(@sa, raw render(t, ft, s, sc, e, m)); sc = s.nodes[sc].next; }
        pass (raw sum_atoms_text(sa, ""));
    }
    string:out = "(";
    int64:c = s.nodes[node].first;
    bool:first = true;
    while (c >= 0i64) decreases s.nodes.count - c {
        if (!first) { out = string_concat(out, " "); }
        first = false;
        out = string_concat(out, raw render(t, ft, s, c, e, m));
        c = s.nodes[c].next;
    }
    pass (string_concat(out, ")"));
};

// A clause's body: `(ensures P)` -> P rendered; a clause with more than one
// operand after its head is refused.
func:render_clause = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:clause, REnv->:e, BMeta->:m) never fails {
    if ((raw sx_len(s, clause)) != 2i64) {
        drop rproblem(t, e, string_concat("a clause takes exactly one proposition: ", raw sx_head(s, clause)));
        pass "false";
    }
    pass (raw render(t, ft, s, raw sx_nth(s, clause, 1i64), e, m));
};

// --- memory ---------------------------------------------------------------------------------------------

// The i-th byte of an Int value, little-endian.
func:byte_of = string(string:v, int64:i) never fails {
    if (i == 0i64) { pass (raw smt_app2("mod", v, "256")); }
    string:p = "256";
    if (i > 1i64) { p = raw pow2_decimal(8i64 * i); }
    pass (raw smt_app2("mod", raw smt_app2("div", v, p), "256"));
};

// A store of `n` bytes of `v` at `addr` on memory `prev`: the next version.
func:tx_store = string(Tx->:t, string:prev, string:addr, string:v, int64:n) never fails {
    t.mem_n = t.mem_n + 1i64;
    string:name = string_concat("|mem:", int_to_string(t.mem_n));
    name = string_concat(name, "|");
    // innermost first: the previous memory at |m:x|
    string:body = raw smt_app1(prev, "|m:x|");
    for (int64:j in 0i64...n) {
        int64:i = n - 1i64 - j;
        string:a = raw text_copy(addr);
        if (i > 0i64) { a = raw smt_app2("+", addr, int_to_string(i)); }
        body = raw smt_app3("ite", raw smt_app2("=", "|m:x|", a), raw byte_of(v, i), body);
    }
    drop tx_mem_define(t, name, body);
    drop strlist_push(@t.st_name, name);
    drop strlist_push(@t.st_prev, prev);
    drop strlist_push(@t.st_addr, addr);
    drop list_push(@t.st_size, n);
    drop strlist_push(@t.st_val, v);
    drop strlist_push(@t.st_guard, "true");
    pass name;
};

// THE LOAD, FORWARDED: a load of `n` bytes at `addr` from `memsym` is the
// value a store of `n` bytes at the same address text put there (under its
// guard), the previous memory's load where the store's address differs (an
// `ite` on the addresses), the branches' loads through a merge, and the
// byte reassembly only from a declared memory.
pub func:fwd_load = string(Tx->:t, string:memsym, string:addr, int64:n, int64:depth) never fails {
    // memoised by (memory, address, size): a chain is walked once per query,
    // and a merge's branches share their symbols -- without this the text of
    // a load through the unrolled copies of a loop is exponential
    for (int64:q in 0i64...t.ld_mem.count) {
        if ((t.ld_size[q] == n) && (raw text_eq(raw strlist_view(t.ld_mem, q), memsym)) && (raw text_eq(raw strlist_view(t.ld_addr, q), addr))) {
            pass (raw strlist_copy(t.ld_sym, q));
        }
    }
    if (depth > 512i64) { pass (raw load_text(t, memsym, addr, n)); }
    string:out = "";
    bool:named = false;
    for (int64:i in 0i64...t.st_name.count) {
        if (!(raw text_eq(raw strlist_view(t.st_name, i), memsym))) { continue; }
        if (t.st_size[i] != n) {
            // a store of another size: the bytes here where the two ranges
            // overlap, else what the memory below holds at the address -- a
            // four-byte store beside an eight-byte word must not turn the word's
            // read into the byte identity the solver cannot prove
            string:below0 = raw fwd_load(t, raw strlist_view(t.st_prev, i), addr, n, depth + 1i64);
            string:sa = raw strlist_view(t.st_addr, i);
            string:ov = raw smt_app2("and", raw smt_app2("<", sa, raw smt_app2("+", addr, int_to_string(n))),
                                            raw smt_app2("<", addr, raw smt_app2("+", sa, int_to_string(t.st_size[i]))));
            string:g0 = raw strlist_view(t.st_guard, i);
            if (!(raw text_eq(g0, "true"))) { ov = raw smt_app2("and", g0, ov); }
            out = raw smt_app3("ite", ov, raw load_text(t, memsym, addr, n), below0);
            named = true;
            break;
        }
        string:g = raw strlist_view(t.st_guard, i);
        if (raw text_eq(addr, raw strlist_view(t.st_addr, i)) && (raw text_eq(g, "true"))) { out = raw strlist_copy(t.st_val, i); break; }
        string:below = raw fwd_load(t, raw strlist_view(t.st_prev, i), addr, n, depth + 1i64);
        string:same = raw smt_app2("=", addr, raw strlist_view(t.st_addr, i));
        if (!(raw text_eq(g, "true"))) { same = raw smt_app2("and", g, same); }
        out = raw smt_app3("ite", same, raw strlist_view(t.st_val, i), below);
        named = true;
        break;
    }
    if (out.len == 0i64) {
        for (int64:m in 0i64...t.mg_name.count) {
            if (!(raw text_eq(raw strlist_view(t.mg_name, m), memsym))) { continue; }
            int64:k = t.mg_mems[m].count;
            string:v = raw fwd_load(t, raw strlist_view(t.mg_mems[m], k - 1i64), addr, n, depth + 1i64);
            for (int64:j in 0i64...(k - 1i64)) {
                int64:bi = k - 2i64 - j;
                v = raw smt_app3("ite", raw strlist_view(t.mg_edges[m], bi), raw fwd_load(t, raw strlist_view(t.mg_mems[m], bi), addr, n, depth + 1i64), v);
            }
            out = move(v);
            named = true;
            break;
        }
    }
    if (out.len == 0i64) { out = raw load_text(t, memsym, addr, n); }
    // a byte stays inline; a word -- forwarded or reassembled -- is a symbol,
    // so a load whose address is another load composes by name (a list walk's
    // eight nested links would otherwise be eight-to-the-eighth bytes of text)
    if ((!named) && (n <= 1i64)) { pass out; }
    // a symbol for the composite, shared by every later reader
    string:sym = raw tx_fresh(t, "ld");
    drop tx_define(t, sym, "Int", out);
    drop strlist_push(@t.ld_mem, memsym);
    drop strlist_push(@t.ld_addr, addr);
    drop list_push(@t.ld_size, n);
    drop strlist_push(@t.ld_sym, sym);
    pass sym;
};

// A merge memory function: `mems[i]` under `edges[i]`, the last the default.
func:tx_merge_mem = string(Tx->:t, List<string>:edges, List<string>:mems) never fails {
    t.mem_n = t.mem_n + 1i64;
    string:name = string_concat("|mem:", int_to_string(t.mem_n));
    name = string_concat(name, "|");
    int64:k = mems.count;
    string:body = raw smt_app1(raw strlist_view(mems, k - 1i64), "|m:x|");
    for (int64:j in 0i64...(k - 1i64)) {
        int64:bi = k - 2i64 - j;
        body = raw smt_app3("ite", raw strlist_view(edges, bi), raw smt_app1(raw strlist_view(mems, bi), "|m:x|"), body);
    }
    drop tx_mem_define(t, name, body);
    drop strlist_push(@t.mg_name, name);
    drop list_push(@t.mg_edges, raw strlist_clone(edges));
    drop list_push(@t.mg_mems, raw strlist_clone(mems));
    pass name;
};

// --- the fields of an aggregate value -----------------------------------------------------------------
//
// AN AGGREGATE IS ITS LEAVES (1.5.6 step 4, nested since the envelopes
// `{ { ptr, i64, i64 }, i32 }` of the string builders): a register `%r` of
// an aggregate type is the scalars `%r.0.0`, `%r.0.1`, ..., one per leaf,
// named by the path of indices; `result` likewise (`result.0.1`).

// The leaf paths (`.0`, `.1.0`...) and leaf types of an aggregate type.
pub func:agg_leaves = NIL(FloorText->:ft, string:ty, string:prefix, List<string>->:paths, List<string>->:tys) never fails {
    string:body = raw text_copy(ty);
    if (raw text_starts_with(ty, "%")) { body = raw floor_type_body(ft, ty); }
    List<string>:fs = raw struct_fields(body);
    for (int64:i in 0i64...fs.count) {
        string:fty = raw strlist_view(fs, i);
        string:path = string_concat(prefix, ".");
        path = string_concat(path, int_to_string(i));
        if (raw is_aggregate_ty(fty)) { drop agg_leaves(ft, fty, path, paths, tys); continue; }
        drop strlist_push(paths, path);
        drop strlist_push(tys, fty);
    }
    pass NIL;
};

// The leaf texts of an aggregate operand: a register's leaves, or zeros.
func:agg_fields = List<string>(Tx->:t, FloorText->:ft, string:text, string:ty) never fails {
    List<string>:out = raw list_init::<string>(4i64);
    List<string>:paths = raw list_init::<string>(4i64);
    List<string>:tys = raw list_init::<string>(4i64);
    drop agg_leaves(ft, ty, "", @paths, @tys);
    for (int64:i in 0i64...paths.count) {
        string:fty = raw strlist_view(tys, i);
        if (raw text_eq(text, "zeroinitializer")) {
            string:z = "0";
            if (raw text_eq(raw ty_sort(fty), "Bool")) { z = "false"; }
            if (raw text_starts_with(raw ty_sort(fty), "F")) { Term:zf = raw fp_literal(t, "0.0", raw ty_bits(fty)); z = raw text_copy(raw strlist_view_of(zf.text)); }
            drop strlist_push(@out, z);
            continue;
        }
        string:fir = string_concat(text, raw strlist_view(paths, i));
        Term:ft2 = raw term_of_reg(t, fir);
        if (!ft2.ok) { drop tx_problem(t, string_concat("an aggregate value the translator does not know: ", text)); drop strlist_push(@out, "0"); continue; }
        drop strlist_push(@out, raw strlist_view_of(ft2.text));
    }
    pass out;
};

func:tx_set_fields = NIL(Tx->:t, FloorText->:ft, string:ir, string:ty, List<string>:vals) never fails {
    List<string>:paths = raw list_init::<string>(4i64);
    List<string>:tys = raw list_init::<string>(4i64);
    drop agg_leaves(ft, ty, "", @paths, @tys);
    if (paths.count != vals.count) { drop tx_problem(t, "an aggregate's leaf count does not match its type"); pass NIL; }
    for (int64:i in 0i64...paths.count) {
        string:fir = string_concat(ir, raw strlist_view(paths, i));
        string:fty = raw strlist_view(tys, i);
        string:sort = raw ty_sort(fty);
        Term:v = raw term_int(raw strlist_view(vals, i), raw ty_bits(fty));
        if (raw text_eq(sort, "Bool")) { v = raw term_bool(raw strlist_view(vals, i)); }
        if (raw text_starts_with(sort, "F")) { v = raw term_fp(raw strlist_view(vals, i), raw ty_bits(fty)); }
        drop tx_set(t, fir, fty, v);
    }
    pass NIL;
};

// The leaves under index `k` of an aggregate's leaf list: their positions.
func:leaf_positions = List<int64>(List<string>:paths, int64:k) never fails {
    List<int64>:out = raw list_init::<int64>(4i64);
    string:want = string_concat(".", int_to_string(k));
    for (int64:i in 0i64...paths.count) {
        string:p = raw strlist_view(paths, i);
        if (raw text_eq(p, want)) { drop list_push(@out, i); continue; }
        if (raw text_starts_with(p, string_concat(want, "."))) { drop list_push(@out, i); }
    }
    pass out;
};

// --- calls --------------------------------------------------------------------------------------------------

func:is_trap_callee = bool(string:c) never fails {
    if (raw text_eq(c, "@npk_trap")) { pass true; }
    if (raw text_eq(c, "@npk_raise")) { pass true; }
    if (raw text_eq(c, "@npk_heap_bad")) { pass true; }
    if (raw text_eq(c, "@npk_heap_oom")) { pass true; }
    if (raw text_eq(c, "@npk_heap_badreq")) { pass true; }
    if (raw text_eq(c, "@npk_park_forever")) { pass true; }
    pass false;
};

// AN OPAQUE CALL (`npk_failsafe`, the indirect call of `npk_wildx_call`):
// a fresh result, a fresh memory -- the path continues knowing nothing, and
// the section must say so (`residue`).
func:tx_opaque_call = string(Tx->:t, FloorText->:ft, FInstr->:ins, string:mem_cur) never fails {
    t.used_opaque = true;
    if (ins.dest.len > 0i64) {
        string:rty = raw strlist_view_of(ins.ty);
        if (raw is_aggregate_ty(rty)) {
            List<string>:op_paths = raw list_init::<string>(4i64);
            List<string>:op_tys = raw list_init::<string>(4i64);
            drop agg_leaves(ft, rty, "", @op_paths, @op_tys);
            for (int64:f in 0i64...op_paths.count) {
                drop tx_declare_reg(t, string_concat(ins.dest, raw strlist_view(op_paths, f)), raw strlist_view(op_tys, f));
            }
        } else {
            drop tx_declare_reg(t, ins.dest, rty);
        }
    }
    pass (raw tx_fresh_mem(t));
};

// `cmpxchg ptr P, T CMP, T NEW`: the sequential reading -- the prior value
// loaded, the new one stored where it matched; `{ prior, matched }`.
func:tx_cmpxchg = string(Tx->:t, FloorText->:ft, FInstr->:ins, string:mem_cur) never fails {
    Term:p = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "ptr");
    Term:c = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
    Term:nv = raw term_of(t, ft, raw strlist_view(ins.args, 2i64), ins.ty);
    if (!(p.ok && c.ok && nv.ok)) { pass (raw text_copy(mem_cur)); }
    int64:n = raw ty_size(ft, ins.ty);
    string:prior = raw fwd_load(t, mem_cur, raw strlist_view_of(p.text), n, 0i64);
    string:ok = raw smt_app2("=", prior, c.text);
    // the guarded store
    t.mem_n = t.mem_n + 1i64;
    string:name = string_concat("|mem:", int_to_string(t.mem_n));
    name = string_concat(name, "|");
    string:body = raw smt_app1(mem_cur, "|m:x|");
    for (int64:j in 0i64...n) {
        int64:i = n - 1i64 - j;
        string:a = raw text_copy(raw strlist_view_of(p.text));
        if (i > 0i64) { a = raw smt_app2("+", p.text, int_to_string(i)); }
        body = raw smt_app3("ite", raw smt_app2("and", ok, raw smt_app2("=", "|m:x|", a)), raw byte_of(nv.text, i), body);
    }
    drop tx_mem_define(t, name, body);
    drop strlist_push(@t.st_name, name);
    drop strlist_push(@t.st_prev, mem_cur);
    drop strlist_push(@t.st_addr, raw strlist_view_of(p.text));
    drop list_push(@t.st_size, n);
    drop strlist_push(@t.st_val, raw strlist_view_of(nv.text));
    drop strlist_push(@t.st_guard, ok);
    List<string>:vals = raw list_init::<string>(2i64);
    drop strlist_push(@vals, prior);
    drop strlist_push(@vals, ok);
    string:aty = string_concat("{ ", ins.ty);
    aty = string_concat(aty, ", i1 }");
    drop tx_set_fields(t, ft, ins.dest, aty, vals);
    pass name;
};

// `atomicrmw OP ptr P, T V`: the prior value returned, `prior OP V` stored.
func:tx_atomicrmw = string(Tx->:t, FloorText->:ft, FInstr->:ins, string:mem_cur) never fails {
    Term:p = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "ptr");
    Term:v = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
    if (!(p.ok && v.ok)) { pass (raw text_copy(mem_cur)); }
    int64:n = raw ty_size(ft, ins.ty);
    int64:bits = raw ty_bits(ins.ty);
    Term:prior = raw term_int(raw fwd_load(t, mem_cur, raw strlist_view_of(p.text), n, 0i64), bits);
    string:op = raw strlist_view_of(ins.pred);
    Term:nv = raw term_none();
    if (raw text_eq(op, "add")) { nv = raw tx_arith(t, "add", prior, v, bits); }
    if (raw text_eq(op, "sub")) { nv = raw tx_arith(t, "sub", prior, v, bits); }
    if (raw text_eq(op, "xchg")) { nv = raw term_copy(v); }
    if (raw text_eq(op, "and")) { nv = raw tx_and(t, prior, v, bits); }
    if (raw text_eq(op, "or")) { nv = raw tx_or(t, prior, v, bits); }
    if (raw text_eq(op, "xor")) { nv = raw tx_xor(t, prior, v, bits); }
    if (!nv.ok) { drop tx_problem(t, string_concat("an atomicrmw operation the translator does not read: ", op)); pass (raw text_copy(mem_cur)); }
    drop tx_set(t, ins.dest, ins.ty, prior);
    pass (raw tx_store(t, mem_cur, raw strlist_view_of(p.text), raw strlist_view_of(nv.text), n));
};

// THE SYSCALL (D-288 §2.8): `npk_sys6(NR, a1..a6)` is an application of the
// uninterpreted `sys` to the number, the six arguments and a sequence number
// (two identical calls may answer differently); its MEMORY EFFECT is the
// kernel-effect table's -- the one row per number the floor uses, what the
// kernel promises, which a reader accepts (TCB.md SS5). Returns 1 when the
// path ends (exit, exit_group), 0 otherwise; the memory after through `mem`.
func:tx_syscall = string(Tx->:t, FloorText->:ft, FInstr->:ins, string:pc, string:mem, string:line) never fails {
    if (ins.args.count != 7i64) { drop tx_problem(t, string_concat("a syscall with other than seven operands: ", line)); pass (raw text_copy(mem)); }
    Term:nr = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "i64");
    if (!(nr.ok && nr.is_num)) { drop tx_problem(t, string_concat("a syscall whose number is not a numeral: ", line)); pass (raw text_copy(mem)); }
    int64:k = nr.num =>! int64;
    List<Term>:av = raw list_init::<Term>(6i64);
    for (int64:i in 1i64...7i64) {
        Term:a = raw term_of(t, ft, raw strlist_view(ins.args, i), "i64");
        if (!a.ok) { pass (raw text_copy(mem)); }
        drop list_push(@av, move(a));
    }
    if (!t.used_sys) {
        drop strlist_push(@t.defs, "(declare-fun sys (Int Int Int Int Int Int Int Int) Int)");
        drop strlist_push(@t.def_names, "sys");
        drop list_push(@t.def_refs, raw list_init::<string>(1i64));
        drop tx_known(t, "sys");
        t.used_sys = true;
    }
    // THE EFFECT IS THE TABLE'S, and the table is not here (1.5.6b): it is the
    // `kernel-effects` region of VERIFICATION_REFERENCE SS9.2, generated into
    // `floor_kernel.npk`. This function kept its own if-chain until then, and
    // `sys_writes` a second one -- and two of the rows were wrong.
    int64:kind = raw ke_effect(k);          // 0 none, 1 writes, 2 ends, 3 maps, 5 asm, 4 no row
    int64:buf_arg = raw ke_buf_arg(k);      // 1-based argument index of the buffer
    string:len_text = raw ke_len(k);        // the length: `result`, `result12` or a numeral
    if ((kind == 4i64) || (kind == 5i64)) {
        string:w = "a syscall the kernel-effect table has no row for (";
        if (kind == 5i64) { w = "a syscall the kernel-effect table marks `asm` -- issued only from inline asm, no effect modelled -- reached by a translated symbol ("; }
        w = string_concat(w, int_to_string(k));
        w = string_concat(w, "): ");
        w = string_concat(w, line);
        drop tx_problem(t, w);
        pass (raw text_copy(mem));
    }
    // A ROW WHOSE EFFECT DEPENDS ON AN OPTION SPEAKS ONLY FOR THE OPTIONS IT LISTS:
    // `arch_prctl(ARCH_GET_FS)` and `prctl(PR_GET_NAME)` WRITE user memory where the
    // options the floor passes do not, so an option outside the row's set -- or one
    // that is not a numeral -- is refused by name, as a number without a row is.
    int64:oa = raw ke_option_arg(k);
    if (oa > 0i64) {
        bool:opt_ok = false;
        if (av[oa - 1i64].is_num) { opt_ok = raw ke_option_ok(k, av[oa - 1i64].num =>! int64); }
        if (!opt_ok) {
            string:wo = string_concat("a syscall option the kernel-effect table has no row for (", int_to_string(k));
            wo = string_concat(wo, ", argument ");
            wo = string_concat(wo, int_to_string(oa));
            wo = string_concat(wo, "): ");
            wo = string_concat(wo, line);
            drop tx_problem(t, wo);
            pass (raw text_copy(mem));
        }
    }
    if (kind == 2i64) {
        // the process ends: a trap site whose code is the status; "" says so
        drop tx_trap_site(t, pc, raw signed_view(av[0i64].text, 64i64));
        pass "";
    }
    // the result
    t.tmp_n = t.tmp_n + 1i64;
    string:app = string_concat("(sys ", int_to_string(k));
    for (int64:i2 in 0i64...6i64) { app = string_concat(app, " "); app = string_concat(app, av[i2].text); }
    app = string_concat(app, " ");
    app = string_concat(app, int_to_string(t.tmp_n));
    app = string_concat(app, ")");
    string:rs = raw tx_fresh(t, "sys");
    drop tx_declare(t, rs, "Int");
    drop tx_range(t, rs, 64i64);
    drop tx_hyp(t, raw smt_app2("=", rs, app), "sys", 0i64);
    if (ins.dest.len > 0i64) { drop tx_set(t, ins.dest, "i64", raw term_int(rs, 64i64)); }
    string:sr = raw signed_view(rs, 64i64);
    // THE KERNEL'S ANSWER SHAPE: a value, or an errno in [-4095, -1] -- the
    // ABI every libc reads (TCB.md SS5's kernel-effect table)
    drop tx_hyp(t, raw smt_app2(">=", sr, "(- 4095)"), "sys", 0i64);
    // THE KERNEL'S COUNT PROMISE: read, write, getrandom answer at most the
    // count asked, epoll_pwait at most the events room -- a non-negative answer
    // never exceeds the argument (what the kernel promises, TCB.md SS5)
    // the table's `bound` column (sched_getaffinity gained its own at 1.5.6b: without it the row's `result`
    // bytes are unbounded in the model and no caller's frame claim can be proven -- found by a refuted row)
    int64:bound_arg = raw ke_bound_arg(k);
    if (bound_arg > 0i64) {
        drop tx_hyp(t, raw smt_app2("=>", raw smt_app2(">=", sr, "0"), raw smt_app2("<=", sr, av[bound_arg - 1i64].text)), "sys", 0i64);
    }
    if (kind == 1i64) {
        string:buf = raw text_copy(raw strlist_view_of(av[buf_arg - 1i64].text));
        string:len = "";
        if (raw text_eq(len_text, "result")) { len = raw text_copy(sr); }
        if (raw text_eq(len_text, "result12")) { len = raw smt_app2("*", "12", sr); }
        if (len.len == 0i64) { len = raw text_copy(len_text); }
        string:inr = raw smt_app2("and", raw smt_app2("<=", buf, "|pt|"), raw smt_app2("<", "|pt|", raw smt_app2("+", buf, len)));
        // an error answer writes nothing; a NULL buffer is written nowhere (rt_sigaction's oldact)
        string:unch = raw smt_app2("or", raw smt_app2("<", sr, "0"), raw smt_app2("or", raw smt_app2("=", buf, "0"), raw smt_app1("not", inr)));
        string:name = raw tx_fresh_mem(t);
        drop tx_template(t, name, mem, pc, unch, "", "");
        pass name;
    }
    if (kind == 3i64) {
        // mmap(addr, len, prot, flags, fd, off): an address, or an errno past 2^64-4096;
        // the mapping's bytes fresh, and zero when anonymous (flags & 0x20)
        string:len2 = raw text_copy(raw strlist_view_of(av[1i64].text));
        string:errs = raw smt_app2(">=", rs, raw smt_app2("-", raw pow2_decimal(64i64), "4096"));
        string:inr2 = raw smt_app2("and", raw smt_app2("<=", rs, "|pt|"), raw smt_app2("<", "|pt|", raw smt_app2("+", rs, len2)));
        string:unch2 = raw smt_app2("or", errs, raw smt_app1("not", inr2));
        string:vw = "";
        bool:anon = false;
        if (av[3i64].is_num) { if (((av[3i64].num / 32u128) % 2u128) == 1u128) { anon = true; } }
        if (anon) { vw = raw smt_app2("and", raw smt_app1("not", errs), inr2); }
        string:name2 = raw tx_fresh_mem(t);
        drop tx_template(t, name2, mem, pc, unch2, vw, "0");
        pass name2;
    }
    pass (raw text_copy(mem));
};

// The trap identity a trap callee ends the path with: `npk_trap`'s and
// `npk_raise`'s argument, `npk_exit`'s status, the heap traps' fixed codes
// (the integrity trap -4102, HeapOom -4103, HeapBadRequest -4104 -- the
// codes `@npk_heap_bad`, `@npk_heap_oom` and `@npk_heap_badreq` pass to
// `npk_trap`), the park and the failsafe call opaque. (DEF-63, 1.5.8 step 0:
// until then the three were -4103, -4103, -4104 -- crossed, and read by no
// clause yet.)
func:trap_code_of = string(Tx->:t, FloorText->:ft, string:callee, FInstr->:ins) never fails {
    if (raw text_eq(callee, "@npk_heap_bad")) { pass "(- 4102)"; }
    if (raw text_eq(callee, "@npk_heap_badreq")) { pass "(- 4104)"; }
    if (raw text_eq(callee, "@npk_heap_oom")) { pass "(- 4103)"; }
    if (ins.args.count > 0i64) {
        Term:a = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), raw strlist_view(ins.tys, 0i64));
        if (a.ok) {
            if (raw text_eq(a.sort, "Int")) { pass (raw signed_view(a.text, a.bits)); }
        }
    }
    string:o = raw tx_fresh(t, "code");
    drop tx_declare(t, o, "Int");
    pass o;
};

// A trap site: the path ends here with the outcome.
func:tx_trap_site = NIL(Tx->:t, string:pc, string:code) never fails {
    drop strlist_push(@t.trap_pcs, pc);
    drop strlist_push(@t.trap_codes, code);
    pass NIL;
};

// THE INTRINSIC COPY AND FILL as built-in summaries: `llvm.memcpy` requires
// disjoint, in-space operands and copies every byte, `llvm.memset` fills;
// both leave every other byte as it was -- a template, instantiated at
// every point the file reads the memory after.
func:tx_intrinsic_mem = string(Tx->:t, FloorText->:ft, string:callee, FInstr->:ins, string:pc, string:mem_cur, string:site) never fails {
    bool:is_set = raw text_eq(callee, "@llvm.memset.p0.i64");
    if (ins.args.count < 3i64) { drop tx_problem(t, "an intrinsic memory call with too few operands"); pass (raw text_copy(mem_cur)); }
    Term:dst = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "ptr");
    Term:src = raw term_none();
    Term:val = raw term_none();
    if (is_set) { val = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), "i8"); }
    else { src = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), "ptr"); }
    Term:n = raw term_of(t, ft, raw strlist_view(ins.args, 2i64), "i64");
    if (!(dst.ok && n.ok)) { pass (raw text_copy(mem_cur)); }
    string:two64 = raw pow2_decimal(64i64);
    string:dend = raw smt_app2("+", dst.text, n.text);
    drop tx_row_ex(t, string_concat(site, ":in-space"), raw smt_app2("=>", pc, raw smt_app2("<=", dend, two64)), "");
    if (!is_set) {
        string:send = raw smt_app2("+", src.text, n.text);
        drop tx_row_ex(t, string_concat(site, ":in-space-src"), raw smt_app2("=>", pc, raw smt_app2("<=", send, two64)), "");
        drop tx_row_ex(t, string_concat(site, ":disjoint"),
            raw smt_app2("=>", pc, raw smt_app2("or", raw smt_app2("<=", dend, src.text), raw smt_app2("<=", send, dst.text))), "");
    }
    string:name = raw tx_fresh_mem(t);
    string:inr = raw smt_app2("and", raw smt_app2("<=", dst.text, "|pt|"), raw smt_app2("<", "|pt|", dend));
    string:inside = "";
    if (is_set) { inside = raw smt_app2("mod", val.text, "256"); }
    else { inside = raw smt_app1(mem_cur, raw smt_app2("+", src.text, raw smt_app2("-", "|pt|", dst.text))); }
    drop tx_template(t, name, mem_cur, pc, raw smt_app1("not", inr), inr, inside);
    pass name;
};

// A row with an excluded hypothesis tag ("" for none).
func:tx_row_ex = NIL(Tx->:t, string:site, string:goal, string:exclude) never fails {
    drop tx_row(t, site, goal);
    t.row_excl[t.row_excl.count - 1i64] = raw text_copy(exclude);
    pass NIL;
};

// A SUMMARY CALL of a floor define whose section says `(summary)`: the
// callee's requires as rows here, its ensures as hypotheses over fresh
// result symbols, its trap outcome joined, its frame instantiated at the
// caller's free symbols.
func:tx_summary_call = string(Tx->:t, FloorText->:ft, Sxs->:s, string:callee, FInstr->:ins, string:pc, string:mem_cur, string:site) never fails {
    int64:cfi = raw floor_fn_index(ft, callee);
    int64:sec = raw spec_section(s, callee);
    if ((cfi < 0i64) || (sec < 0i64)) { drop tx_problem(t, string_concat("a summary of a symbol without a section: ", callee)); pass (raw text_copy(mem_cur)); }
    if (ft.fns[cfi].params.count != ins.args.count) { drop tx_problem(t, string_concat("a call's operand count differs from the callee's parameters: ", callee)); pass (raw text_copy(mem_cur)); }
    // the substitution: parameters -> argument texts
    REnv:e = raw renv_new(mem_cur, "", false, false);
    for (int64:pi in 0i64...ins.args.count) {
        string:pty = raw strlist_view(ft.fns[cfi].param_tys, pi);
        string:pname = raw strlist_view(ft.fns[cfi].params, pi);
        if (raw is_aggregate_ty(pty)) {
            List<string>:fv = raw agg_fields(t, ft, raw strlist_view(ins.args, pi), pty);
            List<string>:spaths = raw list_init::<string>(4i64);
            List<string>:stys = raw list_init::<string>(4i64);
            drop agg_leaves(ft, pty, "", @spaths, @stys);
            for (int64:fi in 0i64...fv.count) {
                drop renv_add(@e, string_concat(raw text_slice(pname, 1i64, pname.len), raw strlist_view(spaths, fi)), raw strlist_view(fv, fi));
            }
            continue;
        }
        Term:a = raw term_of(t, ft, raw strlist_view(ins.args, pi), pty);
        if (!a.ok) { pass (raw text_copy(mem_cur)); }
        drop renv_add(@e, raw text_slice(pname, 1i64, pname.len), raw strlist_view_of(a.text));
    }
    // the callee's free symbols: the caller's of the same name, else fresh
    int64:fk = 0i64;
    while (true) decreases s.nodes.count - fk {
        int64:fc = raw spec_clause(s, sec, "free", fk);
        if (fc < 0i64) { break; }
        fk = fk + 1i64;
        string:fname = raw sx_atom(s, raw sx_nth(s, fc, 1i64));
        if (raw strlist_contains(t.free_syms, fname)) { continue; }   // resolved by name
        string:fresh = raw tx_fresh(t, "free");
        drop tx_declare(t, fresh, "Int");
        drop renv_add(@e, fname, fresh);
    }
    BMeta:plain = BMeta{ origin_fn: "", origin_label: "", ren_from: raw list_init::<string>(1i64), ren_to: raw list_init::<string>(1i64),
                         is_stop: false, bound: 0i64, exact: false, entry_of: "", cont_of: "" };
    // 1. requires: rows at the call
    int64:rk = 0i64;
    while (true) decreases s.nodes.count - rk {
        int64:rc = raw spec_clause(s, sec, "requires", rk);
        if (rc < 0i64) { break; }
        rk = rk + 1i64;
        string:p = raw render_clause(t, ft, s, rc, @e, @plain);
        string:st = string_concat(site, ":requires:");
        st = string_concat(st, int_to_string(rk));
        drop tx_row_ex(t, st, raw smt_app2("=>", pc, p), "");
    }
    // 1b. the callee's objects and views: rows at the call
    int64:oc = raw spec_clause(s, sec, "objects", 0i64);
    int64:vc = raw spec_clause(s, sec, "views", 0i64);
    if ((oc >= 0i64) || (vc >= 0i64)) {
        List<string>:ofacts = raw objects_facts(t, ft, s, oc, vc, @e, @plain, false);
        for (int64:oi2 in 0i64...ofacts.count) {
            string:st2 = string_concat(site, ":objects:");
            st2 = string_concat(st2, int_to_string(oi2 + 1i64));
            drop tx_row_ex(t, st2, raw smt_app2("=>", pc, raw strlist_view(ofacts, oi2)), "");
        }
    }
    // 2. the result symbols
    string:rty = raw strlist_view_of(ft.fns[cfi].ret_ty);
    if (!(raw text_eq(rty, "void"))) {
        if (raw is_aggregate_ty(rty)) {
            List<string>:fs = raw list_init::<string>(4i64);
            List<string>:rp = raw list_init::<string>(4i64);
            drop agg_leaves(ft, rty, "", @rp, @fs);
            for (int64:fi2 in 0i64...fs.count) {
                string:fty = raw strlist_view(fs, fi2);
                string:rs = raw tx_fresh(t, "ret");
                drop tx_declare(t, rs, raw ty_sort(fty));
                if (raw text_eq(raw ty_sort(fty), "Int")) { drop tx_range(t, rs, raw ty_bits(fty)); }
                drop renv_add(@e, string_concat("result", raw strlist_view(rp, fi2)), rs);
                if (ins.dest.len > 0i64) {
                    Term:rv = raw term_int(rs, raw ty_bits(fty));
                    if (raw text_eq(raw ty_sort(fty), "Bool")) { rv = raw term_bool(rs); }
                    drop tx_set(t, string_concat(ins.dest, raw strlist_view(rp, fi2)), fty, rv);
                }
            }
        } else {
            string:rs2 = raw tx_fresh(t, "ret");
            drop tx_declare(t, rs2, raw ty_sort(rty));
            if (raw text_eq(raw ty_sort(rty), "Int")) { drop tx_range(t, rs2, raw ty_bits(rty)); }
            drop renv_add(@e, "result", rs2);
            if (ins.dest.len > 0i64) {
                Term:rv2 = raw term_int(rs2, raw ty_bits(rty));
                if (raw text_eq(raw ty_sort(rty), "Bool")) { rv2 = raw term_bool(rs2); }
                if (raw text_starts_with(raw ty_sort(rty), "F")) { rv2 = raw term_fp(rs2, raw ty_bits(rty)); }
                drop tx_set(t, ins.dest, rty, rv2);
            }
        }
    }
    e.allow_result = true;
    // 3. the trap outcome: the callee's condition joins the caller's trap sites,
    // listed apart so the caller's own `ensures-trap` describes its own traps
    // and the writer adds the callees'; a callee that always traps ends the path
    string:notrap = "true";
    bool:always = false;
    int64:et = raw spec_clause(s, sec, "ensures-trap", 0i64);
    if (et >= 0i64) {
        e.probe = true;
        e.failed = false;
        string:tp = raw render_clause(t, ft, s, et, @e, @plain);
        e.probe = false;
        if (e.failed) {
            // the condition names the callee's own registers (a validation's
            // checks): at the call it is a condition nobody knows -- a fresh
            // Boolean, both outcomes live
            tp = raw tx_fresh(t, "ctrap");
            drop tx_declare(t, tp, "Bool");
        }
        string:code = raw tx_fresh(t, "code");
        drop tx_declare(t, code, "Int");
        string:site_pc = raw smt_app2("and", pc, tp);
        drop tx_trap_site(t, site_pc, code);
        drop strlist_push(@t.summary_traps, site_pc);
        notrap = string_concat(raw smt_app1("not", tp), "");
        if (raw text_eq(tp, "true")) { always = true; }
    }
    if (always) { pass ""; }
    // the path continues only where the callee did not trap: the block folds
    // this into its path condition for everything after the call
    if (et >= 0i64) { t.narrow = string_concat(notrap, ""); }
    string:guard = raw smt_app2("and", pc, notrap);
    // 4. the memory after: the frame as a template (outside the ranges, unchanged);
    // `(ensures-fresh LEN)`: the result block is disjoint from every object the
    // caller declares, and those objects are unchanged -- the allocator's promise
    // (an acceptance TCB.md SS5 carries: leg A's tenant), everything else
    // unspecified
    string:mafter = raw text_copy(mem_cur);
    int64:fr = raw spec_clause(s, sec, "frame", 0i64);
    int64:ef = raw spec_clause(s, sec, "ensures-fresh", 0i64);
    if ((fr >= 0i64) || (ef >= 0i64)) {
        string:name = raw tx_fresh_mem(t);
        if (fr >= 0i64) {
            string:inr = raw frame_in_ranges(t, ft, s, fr, @e, @plain, "|pt|");
            string:unch = raw smt_app1("not", inr);
            if (raw frame_names_objects(s, fr)) {
                // `objects` in a callee's frame are the CALLER's: what it was handed
                string:oin = raw caller_objects_in(t, "|pt|", true);
                if (raw text_eq(oin, "false")) { unch = ""; } else { unch = string_concat(raw smt_app2("and", oin, unch), ""); }
            }
            if (unch.len > 0i64) { drop tx_template(t, name, mem_cur, guard, unch, "", ""); }
        }
        if (ef >= 0i64) {
            int64:efl = raw sx_len(s, ef);
            if ((efl != 2i64) && (efl != 3i64)) { drop tx_problem(t, "an ensures-fresh clause is `(ensures-fresh LEN)` or `(ensures-fresh LO LEN)`"); pass (raw text_copy(mem_cur)); }
            string:len = raw render(t, ft, s, raw sx_nth(s, ef, efl - 1i64), @e, @plain);
            string:res = "";
            if (efl == 3i64) { res = string_concat(raw render(t, ft, s, raw sx_nth(s, ef, 1i64), @e, @plain), ""); }
            else { for (int64:oi in 0i64...e.from.count) { if (raw text_eq(raw strlist_view(e.from, oi), "result")) { res = raw strlist_copy(e.to, oi); } } }
            if (res.len == 0i64) { drop tx_problem(t, "ensures-fresh on a callee without a scalar result"); pass (raw text_copy(mem_cur)); }
            // two live allocations are disjoint
            for (int64:fb in 0i64...t.fresh_blocks.count) {
                string:pb = raw strlist_view(t.fresh_blocks, fb);
                string:pl = raw strlist_view(t.fresh_lens, fb);
                drop tx_hyp(t, raw smt_app2("=>", guard, raw smt_app2("or", raw smt_app2("<=", raw smt_app2("+", res, len), pb),
                                                                           raw smt_app2("<=", raw smt_app2("+", pb, pl), res))), "summary", 0i64);
            }
            drop strlist_push(@t.fresh_blocks, res);
            drop strlist_push(@t.fresh_guards, guard);
            drop strlist_push(@t.fresh_lens, len);
            string:objs = "false";
            for (int64:ob in 0i64...t.obj_lo.count) {
                string:lo = raw strlist_view(t.obj_lo, ob);
                string:ln = raw strlist_view(t.obj_len, ob);
                drop tx_hyp(t, raw smt_app2("=>", guard, raw smt_app2("or", raw smt_app2("<=", raw smt_app2("+", res, len), lo),
                                                                           raw smt_app2("<=", raw smt_app2("+", lo, ln), res))), "summary", 0i64);
            }
            // the loop objects live at their headers: disjoint from the block there
            for (int64:lb in 0i64...t.lobj_lo.count) {
                string:lo3 = raw strlist_view(t.lobj_lo, lb);
                string:ln3 = raw strlist_view(t.lobj_len, lb);
                drop tx_hyp(t, raw smt_app2("=>", raw smt_app2("and", guard, raw strlist_view(t.lobj_pc, lb)),
                                            raw smt_app2("or", raw smt_app2("<=", raw smt_app2("+", res, len), lo3),
                                                               raw smt_app2("<=", raw smt_app2("+", lo3, ln3), res))), "summary", 0i64);
            }
            objs = string_concat(raw caller_objects_in(t, "|pt|", true), "");
            if (!(raw text_eq(objs, "false"))) { drop tx_template(t, name, mem_cur, guard, objs, "", ""); }
        }
        mafter = move(name);
    }
    e.mem2 = raw text_copy(mafter);
    // 5. the ensures, on the non-trapping paths
    int64:ek = 0i64;
    while (true) decreases s.nodes.count - ek {
        int64:ec = raw spec_clause(s, sec, "ensures", ek);
        if (ec < 0i64) { break; }
        ek = ek + 1i64;
        string:p2 = raw render_clause(t, ft, s, ec, @e, @plain);
        drop tx_hyp(t, raw smt_app2("=>", guard, p2), "summary", 0i64);
    }
    pass mafter;
};

// `(frame (lo len) (lo len) ...)`: is `f` inside any range?
func:frame_in_ranges = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:fr, REnv->:e, BMeta->:m, string:f) never fails {
    string:out = "false";
    int64:c = s.nodes[fr].first;
    c = s.nodes[c].next;   // past the head
    while (c >= 0i64) decreases s.nodes.count - c {
        // the atom `objects` narrows the claim to the caller's objects (`frame_names_objects`, `objects_in`)
        if ((!(raw sx_is_list(s, c))) && (raw text_eq(raw sx_atom(s, c), "objects"))) { c = s.nodes[c].next; continue; }
        if (!(raw sx_is_list(s, c)) || ((raw sx_len(s, c)) != 2i64)) { drop tx_problem(t, "a frame range is not `(lo len)` or the atom `objects`"); pass "false"; }
        string:lo = raw render(t, ft, s, raw sx_nth(s, c, 0i64), e, m);
        string:ln = raw render(t, ft, s, raw sx_nth(s, c, 1i64), e, m);
        string:inr = raw smt_app2("and", raw smt_app2("<=", lo, f), raw smt_app2("<", f, raw smt_app2("+", lo, ln)));
        if (raw text_eq(out, "false")) { out = move(inr); } else { out = raw smt_app2("or", out, inr); }
        c = s.nodes[c].next;
    }
    pass out;
};

// Whether a frame clause names the atom `objects`: the claim is over the
// caller's objects only -- a symbol that allocates changes the heap's own
// words and its fresh blocks, which no caller can name, and promises the
// objects it was handed.
func:frame_names_objects = bool(Sxs->:s, int64:fr) never fails {
    int64:c = s.nodes[fr].first;
    c = s.nodes[c].next;
    while (c >= 0i64) decreases s.nodes.count - c {
        if ((!(raw sx_is_list(s, c))) && (raw text_eq(raw sx_atom(s, c), "objects"))) { pass true; }
        c = s.nodes[c].next;
    }
    pass false;
};

// The condition that the point `f` lies in one of a section's VIEWS, rendered
// under `e` ("false" when it declares none). A NULL view is no view (the
// convention `objects_facts` keeps for its pairs): without the conjunct a null
// view of length n would name the bytes [0, n), which nothing sets apart from
// an object, and the frame row below would claim an object's written bytes
// unchanged.
func:views_in = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:sec, REnv->:e, BMeta->:m, string:f) never fails {
    string:out = "false";
    int64:vc0 = raw spec_clause(s, sec, "views", 0i64);
    if (vc0 < 0i64) { pass out; }
    int64:vc = s.nodes[vc0].first;
    vc = s.nodes[vc].next;
    while (vc >= 0i64) decreases s.nodes.count - vc {
        if (!(raw sx_is_list(s, vc)) || ((raw sx_len(s, vc)) != 2i64)) { drop tx_problem(t, "a views range is not `(lo len)`"); pass "false"; }
        string:lo = raw render(t, ft, s, raw sx_nth(s, vc, 0i64), e, m);
        string:ln = raw render(t, ft, s, raw sx_nth(s, vc, 1i64), e, m);
        string:inr = raw smt_app2("and", raw smt_app1("not", raw smt_app2("=", lo, "0")),
                                         raw smt_app2("and", raw smt_app2("<=", lo, f), raw smt_app2("<", f, raw smt_app2("+", lo, ln))));
        if (raw text_eq(out, "false")) { out = move(inr); } else { out = raw smt_app2("or", out, inr); }
        vc = s.nodes[vc].next;
    }
    pass out;
};

// The condition that the point `f` lies in what a section was HANDED -- one
// of its declared objects or one of its views -- rendered under `e` ("false"
// when it declares neither). The objects come first, the text they always
// were.
func:objects_in = string(Tx->:t, FloorText->:ft, Sxs->:s, int64:sec, REnv->:e, BMeta->:m, string:f) never fails {
    string:out = "false";
    int64:oc0 = raw spec_clause(s, sec, "objects", 0i64);
    if (oc0 >= 0i64) {
        int64:oc = s.nodes[oc0].first;
        oc = s.nodes[oc].next;
        while (oc >= 0i64) decreases s.nodes.count - oc {
            if (!(raw range_entry_ok(s, oc))) { drop tx_problem(t, "an objects range is not `(lo len)` or `(lo len apart-when COND)`"); pass "false"; }
            string:lo = raw render(t, ft, s, raw sx_nth(s, oc, 0i64), e, m);
            string:ln = raw render(t, ft, s, raw sx_nth(s, oc, 1i64), e, m);
            string:inr = raw smt_app2("and", raw smt_app2("<=", lo, f), raw smt_app2("<", f, raw smt_app2("+", lo, ln)));
            // an `apart-when` range is one of the symbol's objects where its condition holds
            if ((raw sx_len(s, oc)) == 4i64) { inr = raw smt_app2("and", raw render(t, ft, s, raw sx_nth(s, oc, 3i64), e, m), inr); }
            if (raw text_eq(out, "false")) { out = move(inr); } else { out = raw smt_app2("or", out, inr); }
            oc = s.nodes[oc].next;
        }
    }
    string:vin = raw views_in(t, ft, s, sec, e, m, f);
    if (!(raw text_eq(vin, "false"))) {
        if (raw text_eq(out, "false")) { out = move(vin); } else { out = raw smt_app2("or", out, vin); }
    }
    pass out;
};

// --- blocks -----------------------------------------------------------------------------------------------

// The pc symbol of a block and the edge symbol of an edge, by label.
func:pc_sym = string(string:label) never fails {
    string:s = string_concat("|pc:", label);
    pass (string_concat(s, "|"));
};

func:edge_sym = string(string:from, string:to) never fails {
    string:s = string_concat("|e:", from);
    s = string_concat(s, ":");
    s = string_concat(s, to);
    pass (string_concat(s, "|"));
};

// The forward predecessors of block `b` (in block order).
func:forward_preds = List<int64>(XFn->:x, int64:b) never fails {
    List<int64>:out = raw list_init::<int64>(4i64);
    for (int64:p in 0i64...x.f.blocks.count) {
        bool:edge = false;
        for (int64:k in 0i64...x.f.blocks[p].succs.count) { if (x.f.blocks[p].succs[k] == b) { edge = true; } }
        if (!edge) { continue; }
        if (raw floor_is_back_edge(@x.loops, p, b)) { continue; }
        drop list_push(@out, p);
    }
    pass out;
};

// The value a phi at block `b` takes from predecessor `p`: the incoming
// whose label is p's origin label (or p's own label), renamed through p's
// environment; "" with a problem when none matches.
func:phi_incoming = string(Tx->:t, XFn->:x, FInstr->:ins, int64:p) never fails {
    string:plabel = raw strlist_view_of(x.f.blocks[p].label);
    string:porigin = raw strlist_view_of(x.meta[p].origin_label);
    for (int64:i in 0i64...ins.labels.count) {
        string:lab = raw strlist_view(ins.labels, i);
        if ((raw text_eq(lab, plabel)) || (raw text_eq(lab, porigin))) {
            pass (raw meta_rename(@x.meta[p], raw strlist_view(ins.args, i)));
        }
    }
    string:w = string_concat("a phi has no incoming for the predecessor ", plabel);
    w = string_concat(w, ": ");
    w = string_concat(w, ins.dest);
    drop tx_problem(t, w);
    pass "";
};

// The memory `mem` of a block's spec context: the function's entry memory,
// or, inside an inlined callee's blocks, the memory at that callee's entry.
func:ctx_mem = string(Tx->:t, XFn->:x, int64:b) never fails {
    string:ofn = raw strlist_view_of(x.meta[b].origin_fn);
    if (raw text_eq(ofn, raw strlist_view_of(x.f.name))) { pass "mem"; }
    // the callee's entry copy: this block's label with its origin label replaced by the callee's first label
    string:lab = raw strlist_view_of(x.f.blocks[b].label);
    string:ol = raw strlist_view_of(x.meta[b].origin_label);
    int64:at = raw text_index_of(lab, ol);
    if (at < 0i64) { pass "mem"; }
    string:prefix = raw text_slice(lab, 0i64, at);
    string:sfx = raw text_slice(lab, at + ol.len, lab.len);
    for (int64:e in 0i64...x.f.blocks.count) {
        if ((raw strlist_view_of(x.meta[e].entry_of)).len == 0i64) { continue; }
        if (!(raw text_eq(raw strlist_view_of(x.meta[e].origin_fn), ofn))) { continue; }
        string:want = string_concat(prefix, raw strlist_view_of(x.meta[e].origin_label));
        want = string_concat(want, sfx);
        if (raw text_eq(raw strlist_view_of(x.f.blocks[e].label), want)) {
            if (e < t.blk_mem_in.count) { pass (raw strlist_copy(t.blk_mem_in, e)); }
        }
    }
    pass "mem";
};

// Does the loop write memory? A store, or a call that is neither a pure
// intrinsic nor a per-thread constant nor a trap (a summary, a syscall, a
// memory intrinsic).
// Whether syscall `k` writes the caller's memory, by the kernel-effect table
// of `tx_syscall` (read, getrandom, clock_gettime, sched_getaffinity,
// rt_sigaction, epoll_pwait, mmap); a number the table lacks is taken to.
func:sys_writes = bool(int64:k) never fails {
    // THE TABLE IS `floor_kernel.npk`'s (1.5.6b): this function kept a list of its
    // own until then, a second hand-written copy of `tx_syscall`'s. A row that
    // says `none` or `ends` writes nothing; `writes` and `maps` write; a number
    // with no row, or an `asm` one, is answered conservatively.
    int64:e = raw ke_effect(k);
    if ((e == 0i64) || (e == 2i64)) { pass false; }
    pass true;
};

func:loop_writes = bool(XFn->:x, int64:li) never fails {
    for (int64:m in 0i64...x.loops[li].members.count) {
        int64:b = x.loops[li].members[m];
        for (int64:l in 0i64...x.f.blocks[b].lines.count) {
            FInstr:ins = raw floor_instr(raw strlist_view(x.f.blocks[b].lines, l));
            if (raw text_eq(ins.op, "store")) { pass true; }
            if (raw text_eq(ins.op, "atomicrmw") || raw text_eq(ins.op, "cmpxchg")) { pass true; }
            if (!(raw text_eq(ins.op, "call"))) { continue; }
            string:c = raw strlist_view_of(ins.callee);
            if (raw text_eq(c, "@llvm.fabs.f64") || raw text_eq(c, "@llvm.fabs.f32")) { continue; }
            if (raw text_eq(c, "@llvm.copysign.f64") || raw text_eq(c, "@llvm.copysign.f32")) { continue; }
            if (raw text_eq(c, "@llvm.umul.with.overflow.i64")) { continue; }
            if (raw text_eq(c, "@llvm.ctpop.i64")) { continue; }
            if (raw text_eq(c, "@npk_exec") || raw text_eq(c, "@npk_tls_self")) { continue; }
            if (raw is_trap_callee(c)) { continue; }
            if (raw text_eq(c, "@npk_sys6") && (ins.args.count == 7i64)) {
                uint128:sn = 0u128;
                if (raw u128_parse(raw strlist_view(ins.args, 0i64), 128i64, @sn)) {
                    if (!(raw sys_writes(sn =>! int64))) { continue; }
                }
            }
            pass true;
        }
    }
    pass false;
};

// The spec's `(loop LABEL ...)` clause for a header block, or -1.
func:loop_clause_of = int64(Sxs->:s, XFn->:x, int64:h) never fails {
    int64:sec = raw spec_section(s, raw strlist_view_of(x.meta[h].origin_fn));
    if (sec < 0i64) { pass (0i64 - 1i64); }
    pass (raw spec_loop(s, sec, raw strlist_view_of(x.meta[h].origin_label)));
};

// The original (spec) name of a header phi's destination: the environment
// entry whose renamed text is the register, else the register itself.
func:orig_name = string(BMeta->:m, string:ir) never fails {
    for (int64:i in 0i64...m.ren_to.count) {
        if (raw text_eq(raw strlist_view(m.ren_to, i), ir)) {
            string:f = raw strlist_view(m.ren_from, i);
            pass (raw text_slice(f, 1i64, f.len));
        }
    }
    pass (raw text_slice(ir, 1i64, ir.len));
};

// One block, in dominance order: its path condition, its entry memory,
// its lines, its edges.
func:tx_block = NIL(Tx->:t, FloorText->:ft, Sxs->:s, XFn->:x, int64:b) never fails {
    string:label = raw strlist_view_of(x.f.blocks[b].label);
    string:pc = raw pc_sym(label);
    List<int64>:preds = raw forward_preds(x, b);
    int64:li = raw floor_loop_of_header(@x.loops, b);
    bool:is_header = (li >= 0i64);
    // 1. the path condition
    if (b == 0i64) { drop tx_define(t, pc, "Bool", "true"); }
    else {
        string:d = "false";
        for (int64:i in 0i64...preds.count) {
            string:e = raw edge_sym(raw strlist_view_of(x.f.blocks[preds[i]].label), label);
            if (i == 0i64) { d = move(e); } else { d = raw smt_app2("or", d, e); }
        }
        drop tx_define(t, pc, "Bool", d);
    }
    t.blk_pc[b] = raw text_copy(pc);
    // 2. the memory at entry
    string:mem_cur = "mem";
    int64:lclause = 0i64 - 1i64;
    int64:inv = 0i64 - 1i64;
    if (is_header) {
        lclause = raw loop_clause_of(s, x, b);
        if (lclause >= 0i64) { inv = raw spec_clause(s, lclause, "invariant", 0i64); }
        if (inv < 0i64) {
            string:w = string_concat("loop ", raw strlist_view_of(x.meta[b].origin_label));
            w = string_concat(w, " has no invariant and no bound");
            drop tx_problem(t, w);
        }
        if (raw loop_writes(x, li)) {
            string:hm = string_concat("|mem@", label);
            hm = string_concat(hm, "|");
            drop tx_mem_declare(t, hm);
            mem_cur = move(hm);
        }
    }
    // A LOOP THAT WRITES NOTHING KEEPS ITS ENTRY MEMORY: no store, no
    // summary, no intrinsic in its blocks, so every back edge carries the
    // memory the header was entered with, and a fresh function would only
    // ask the invariant to restate what the translation already knows.
    if (!(is_header && (raw loop_writes(x, li)))) {
        if (preds.count == 1i64) { mem_cur = raw strlist_copy(t.blk_mem_out, preds[0i64]); }
        if (preds.count > 1i64) {
            // the same memory on every edge needs no merge (a loop that
            // writes nothing, in every copy)
            bool:same = true;
            for (int64:j0 in 1i64...preds.count) {
                if (!(raw text_eq(raw strlist_view(t.blk_mem_out, preds[j0]), raw strlist_view(t.blk_mem_out, preds[0i64])))) { same = false; }
            }
            if (same) { mem_cur = raw strlist_copy(t.blk_mem_out, preds[0i64]); }
            else {
                List<string>:medges = raw list_init::<string>(preds.count + 1i64);
                List<string>:mmems = raw list_init::<string>(preds.count + 1i64);
                for (int64:j in 0i64...preds.count) {
                    drop strlist_push(@medges, raw edge_sym(raw strlist_view_of(x.f.blocks[preds[j]].label), label));
                    drop strlist_push(@mmems, raw strlist_view(t.blk_mem_out, preds[j]));
                }
                mem_cur = string_concat(raw tx_merge_mem(t, medges, mmems), "");
            }
        }
    }
    t.blk_mem_in[b] = string_concat(mem_cur, "");
    // 3. the lines
    bool:ended = false;
    List<string>:hphi_ir = raw list_init::<string>(4i64);
    List<string>:hphi_orig = raw list_init::<string>(4i64);
    for (int64:l in 0i64...x.f.blocks[b].lines.count) {
        string:line = raw strlist_view(x.f.blocks[b].lines, l);
        FInstr:ins = raw floor_instr(line);
        if (ins.op.len == 0i64) { drop tx_problem(t, string_concat("instruction form not read: ", line)); continue; }
        if (ended && (raw text_eq(ins.op, "unreachable"))) { continue; }   // the `unreachable` a trap call is followed by
        if (ended) { drop tx_problem(t, string_concat("an instruction after the path ended: ", line)); continue; }
        string:op = raw strlist_view_of(ins.op);
        if (raw text_eq(op, "phi")) {
            if (is_header) {
                drop tx_declare_reg(t, ins.dest, ins.ty);
                drop strlist_push(@hphi_ir, ins.dest);
                drop strlist_push(@hphi_orig, raw orig_name(@x.meta[b], ins.dest));
                continue;
            }
            if (preds.count == 0i64) { drop tx_declare_reg(t, ins.dest, ins.ty); continue; }
            // the ite over the predecessors' edges, the last the default
            string:v = "";
            bool:all_same = true;   // every incoming the same text: the phi IS that value (an unrolled counter's exits agree)
            string:first_inc = "";
            // one incoming: its shape rides through (a folded division chain, the or-reading facts)
            bool:s_ok = false;
            int64:s_shl = 0i64 - 1i64;
            int64:s_lt = 0i64 - 1i64;
            string:s_root = "";
            uint128:s_by = 0u128;
            string:s_lroot = "";
            uint128:s_loff = 0u128;
            string:s_lparts = "";
            for (int64:j2 in 0i64...preds.count) {
                int64:pi2 = preds.count - 1i64 - j2;
                string:inc = raw phi_incoming(t, x, @ins, preds[pi2]);
                if (inc.len == 0i64) { break; }
                Term:tv = raw term_of(t, ft, inc, ins.ty);
                if (!tv.ok) { break; }
                if (preds.count == 1i64) { s_ok = true; s_shl = tv.shl_k; s_lt = tv.lt_k; s_root = string_concat(raw strlist_view_of(tv.div_root), ""); s_by = tv.div_by; s_lroot = string_concat(raw strlist_view_of(tv.lin_root), ""); s_loff = tv.lin_off; s_lparts = string_concat(raw strlist_view_of(tv.lin_parts), ""); }
                if (j2 == 0i64) { first_inc = string_concat(tv.text, ""); }
                else { if (!(raw text_eq(raw strlist_view_of(tv.text), first_inc))) { all_same = false; } }
                if (j2 == 0i64) { v = string_concat(tv.text, ""); continue; }
                string:e3 = raw edge_sym(raw strlist_view_of(x.f.blocks[preds[pi2]].label), label);
                v = string_concat(raw smt_app3("ite", e3, tv.text, v), "");
            }
            if (v.len == 0i64) { continue; }
            if (all_same && (first_inc.len > 0i64)) { v = string_concat(first_inc, ""); }
            Term:pv = raw term_int(v, raw ty_bits(ins.ty));
            if (raw text_eq(raw ty_sort(ins.ty), "Bool")) { pv = raw term_bool(v); }
            if (raw text_starts_with(raw ty_sort(ins.ty), "F")) { pv = raw term_fp(v, raw ty_bits(ins.ty)); }
            if ((preds.count == 1i64) && (raw text_eq(pv.sort, "Int"))) {
                uint128:nv = 0u128;
                if (raw u128_parse(v, raw ty_bits(ins.ty), @nv)) { pv = raw term_num(nv, raw ty_bits(ins.ty)); }
                else { if (s_ok) { pv.shl_k = s_shl; pv.lt_k = s_lt; pv.div_root = string_concat(s_root, ""); pv.div_by = s_by; pv.lin_root = string_concat(s_lroot, ""); pv.lin_off = s_loff; pv.lin_parts = string_concat(s_lparts, ""); } }
            }
            drop tx_set(t, ins.dest, ins.ty, pv);
            continue;
        }
        if (raw text_eq(op, "add") || raw text_eq(op, "sub") || raw text_eq(op, "mul")) {
            Term:a = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b2 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, ins.ty, raw tx_arith(t, op, a, b2, raw ty_bits(ins.ty)));
            continue;
        }
        if (raw text_eq(op, "udiv") || raw text_eq(op, "urem")) {
            Term:a2 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b3 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, ins.ty, raw tx_udiv(t, op, a2, b3, raw ty_bits(ins.ty)));
            continue;
        }
        if (raw text_eq(op, "sdiv") || raw text_eq(op, "srem")) {
            Term:a3 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b4 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, ins.ty, raw tx_sdiv(t, op, a3, b4, raw ty_bits(ins.ty)));
            continue;
        }
        if (raw text_eq(op, "and") || raw text_eq(op, "or") || raw text_eq(op, "xor")) {
            Term:a4 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b5 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            Term:r = raw term_none();
            if (raw text_eq(op, "and")) { r = raw tx_and(t, a4, b5, raw ty_bits(ins.ty)); }
            if (raw text_eq(op, "or")) { r = raw tx_or(t, a4, b5, raw ty_bits(ins.ty)); }
            if (raw text_eq(op, "xor")) { r = raw tx_xor(t, a4, b5, raw ty_bits(ins.ty)); }
            drop tx_set(t, ins.dest, ins.ty, r);
            continue;
        }
        if (raw text_eq(op, "shl") || raw text_eq(op, "lshr") || raw text_eq(op, "ashr")) {
            Term:a5 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b6 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, ins.ty, raw tx_shift(t, op, a5, b6, raw ty_bits(ins.ty)));
            continue;
        }
        if (raw text_eq(op, "fadd") || raw text_eq(op, "fsub") || raw text_eq(op, "fmul") || raw text_eq(op, "fdiv") || raw text_eq(op, "frem")) {
            Term:a6 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b7 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, ins.ty, raw tx_farith(t, op, a6, b7, raw ty_bits(ins.ty)));
            continue;
        }
        if (raw text_eq(op, "icmp")) {
            Term:a7 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b8 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, "i1", raw tx_icmp(t, ins.pred, a7, b8, raw ty_bits(ins.ty)));
            continue;
        }
        if (raw text_eq(op, "fcmp")) {
            Term:a8 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Term:b9 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            drop tx_set(t, ins.dest, "i1", raw tx_fcmp(t, ins.pred, a8, b9));
            continue;
        }
        if (raw text_eq(op, "select")) {
            if (raw is_aggregate_ty(ins.ty)) { drop tx_problem(t, string_concat("a select over an aggregate: not read: ", line)); continue; }
            Term:c = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "i1");
            Term:a9 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
            Term:b10 = raw term_of(t, ft, raw strlist_view(ins.args, 2i64), ins.ty);
            if (!(c.ok && a9.ok && b10.ok)) { continue; }
            Term:sv = raw term_int(raw smt_app3("ite", c.text, a9.text, b10.text), raw ty_bits(ins.ty));
            if (raw text_eq(a9.sort, "Bool")) { sv = raw term_bool(raw smt_app3("ite", c.text, a9.text, b10.text)); }
            if (raw text_starts_with(a9.sort, "F")) { sv = raw term_fp(raw smt_app3("ite", c.text, a9.text, b10.text), raw ty_bits(ins.ty)); }
            // the smaller of the two bounds is the bound
            if (raw text_eq(sv.sort, "Int")) {
                int64:lk = a9.lt_k;
                if (b10.lt_k > lk) { lk = b10.lt_k; }
                sv.lt_k = lk;
            }
            drop tx_set(t, ins.dest, ins.ty, sv);
            continue;
        }
        if (raw text_eq(op, "zext") || raw text_eq(op, "sext") || raw text_eq(op, "trunc") || raw text_eq(op, "ptrtoint") ||
            raw text_eq(op, "inttoptr") || raw text_eq(op, "bitcast") || raw text_eq(op, "fpext") || raw text_eq(op, "fptrunc") ||
            raw text_eq(op, "sitofp") || raw text_eq(op, "uitofp")) {
            Term:a10 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            drop tx_set(t, ins.dest, ins.pred, raw tx_cast(t, op, a10, ins.ty, ins.pred));
            continue;
        }
        if (raw text_eq(op, "getelementptr")) {
            // ONE FLAT SUM, WRAPPED ONCE: the base's linear shape and every numeral
            // index fold into one offset, a symbolic index contributes its scaled
            // term (a linear index its root), so `line + p` with p = pos + k reads
            // `(mod (+ line pos k) 2^64)` -- the form a clause's `(+ line pos j)` takes
            Term:base = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "ptr");
            if (!base.ok) { continue; }
            string:root = raw text_copy(raw strlist_view_of(base.text));
            uint128:total = 0u128;
            List<string>:parts = raw list_init::<string>(4i64);
            if (base.lin_root.len > 0i64) {
                root = raw text_copy(raw strlist_view_of(base.lin_root));
                total = base.lin_off;
                if (base.lin_parts.len > 0i64) { parts = raw smt_split_top(raw strlist_view_of(base.lin_parts)); }
            }
            string:tbl_idx = "";
            int64:tbl_scale = 0i64;
            string:cur_ty = raw text_copy(raw strlist_view_of(ins.gep_ty));
            bool:bad = false;
            for (int64:gi in 1i64...ins.args.count) {
                string:ity = raw strlist_view(ins.tys, gi - 1i64);
                Term:idx = raw term_of(t, ft, raw strlist_view(ins.args, gi), ity);
                if (!idx.ok) { bad = true; break; }
                int64:sz = 0i64;
                if (gi == 1i64) { sz = raw ty_size(ft, cur_ty); }
                else {
                    if (raw text_starts_with(cur_ty, "[")) {
                        string:ety = raw array_elem(cur_ty);
                        sz = raw ty_size(ft, ety);
                        cur_ty = move(ety);
                    } else {
                        if (!(raw is_aggregate_ty(cur_ty))) { drop tx_problem(t, string_concat("a getelementptr index into a scalar: ", line)); bad = true; break; }
                        if (!idx.is_num) { drop tx_problem(t, string_concat("a struct index that is not a numeral: ", line)); bad = true; break; }
                        int64:k = idx.num =>! int64;
                        int64:foff = raw struct_field_offset(ft, cur_ty, k);
                        string:fty = raw struct_field_type(ft, cur_ty, k);
                        if ((foff < 0i64) || (fty.len == 0i64)) { drop tx_problem(t, string_concat("a struct index past the type's fields: ", line)); bad = true; break; }
                        total = raw u128_add(total, (foff =>! uint128), 64i64);
                        cur_ty = move(fty);
                        continue;
                    }
                }
                uint128:usz = sz =>! uint128;
                if (idx.is_num) { total = raw u128_add(total, raw u128_wrap(usz * idx.num, 64i64), 64i64); continue; }
                string:itext = raw text_copy(raw strlist_view_of(idx.text));
                if (idx.lin_root.len > 0i64) {
                    // an index with a linear shape: its root, EACH of its parts (scaled
                    // alike -- `line + (pos + k)` is `(+ line pos k)`, never `(+ line pos)`)
                    // and its offset folded
                    itext = raw text_copy(raw strlist_view_of(idx.lin_root));
                    total = raw u128_add(total, raw u128_wrap(usz * idx.lin_off, 64i64), 64i64);
                    if (idx.lin_parts.len > 0i64) {
                        List<string>:ips = raw smt_split_top(raw strlist_view_of(idx.lin_parts));
                        for (int64:ii in 0i64...ips.count) {
                            if (sz == 1i64) { drop strlist_push(@parts, raw strlist_view(ips, ii)); }
                            else { drop strlist_push(@parts, raw smt_app2("*", int_to_string(sz), raw strlist_view(ips, ii))); }
                        }
                    }
                }
                if (sz == 1i64) { drop strlist_push(@parts, itext); }
                else { drop strlist_push(@parts, raw smt_app2("*", int_to_string(sz), itext)); }
                if ((gi > 1i64) && (idx.lin_root.len == 0i64)) { tbl_idx = string_concat(itext, ""); tbl_scale = sz; }
            }
            if (bad) { continue; }
            // one n-ary sum `(+ root part... total)`, the spelling a clause's `(+ line pos j)`
            // takes -- plain inside an object, wrapped once otherwise (`tx_lin_term`);
            // the shape rides the register, so a later GEP over it re-flattens
            Term:gt = raw tx_lin_term(t, root, parts, total, 64i64);
            // AN ELEMENT OF A CONSTANT TABLE: `[N x iW]` with an initialiser, one
            // scaled index and nothing else -- a load through it reads as an `ite`
            // over the index (`const_table_ite`), the table's values by the case,
            // where the byte facts alone leave the solver to enumerate the index
            if ((parts.count == 1i64) && (total == 0u128) && (tbl_idx.len > 0i64) && (raw text_eq(root, raw strlist_view_of(base.text)))) {
                string:gname = string_concat("@", root);
                if (((raw floor_global_init(ft, gname)).len > 0i64) && (raw text_starts_with(raw floor_global_type(ft, gname), "["))) {
                    gt.tbl_global = string_concat(gname, "");
                    gt.tbl_idx = string_concat(tbl_idx, "");
                    gt.tbl_scale = tbl_scale;
                }
            }
            drop tx_set(t, ins.dest, "ptr", gt);
            continue;
        }
        if (raw text_eq(op, "load")) {
            Term:p = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "ptr");
            if (!p.ok) { continue; }
            if (raw is_aggregate_ty(ins.ty)) {
                List<string>:fs = raw struct_fields(ins.ty);
                if (raw text_starts_with(ins.ty, "%")) { fs = raw struct_fields(raw floor_type_body(ft, ins.ty)); }
                List<string>:vals = raw list_init::<string>(fs.count + 1i64);
                for (int64:fi in 0i64...fs.count) {
                    string:fty = raw strlist_view(fs, fi);
                    if (!(raw text_eq(raw ty_sort(fty), "Int"))) { drop tx_problem(t, string_concat("a load of an aggregate with a non-integer field: ", line)); break; }
                    int64:foff2 = raw struct_field_offset(ft, ins.ty, fi);
                    string:fa = raw smt_app2("+", p.text, int_to_string(foff2));
                    if (foff2 == 0i64) { fa = raw text_copy(raw strlist_view_of(p.text)); }
                    drop strlist_push(@vals, raw fwd_load(t, mem_cur, fa, raw ty_size(ft, fty), 0i64));
                }
                if (vals.count == fs.count) { drop tx_set_fields(t, ft, ins.dest, ins.ty, vals); }
                continue;
            }
            string:sort = raw ty_sort(ins.ty);
            if (!(raw text_eq(sort, "Int"))) { drop tx_problem(t, string_concat("a load of a type the translator does not read: ", line)); continue; }
            int64:n = raw ty_size(ft, ins.ty);
            string:raw_ld = raw fwd_load(t, mem_cur, raw strlist_view_of(p.text), n, 0i64);
            if ((p.tbl_global.len > 0i64) && (p.tbl_scale == n)) {
                string:cti = raw const_table_ite(t, ft, raw strlist_view_of(p.tbl_global), raw strlist_view_of(p.tbl_idx), n, raw_ld);
                if (cti.len > 0i64) { raw_ld = move(cti); }
            }
            Term:lv = raw term_int(raw_ld, raw ty_bits(ins.ty));
            drop tx_set(t, ins.dest, ins.ty, lv);
            continue;
        }
        if (raw text_eq(op, "store")) {
            Term:p2 = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), "ptr");
            if (!p2.ok) { continue; }
            if (raw is_aggregate_ty(ins.ty)) {
                List<string>:fs2 = raw struct_fields(ins.ty);
                if (raw text_starts_with(ins.ty, "%")) { fs2 = raw struct_fields(raw floor_type_body(ft, ins.ty)); }
                List<string>:fv = raw agg_fields(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
                for (int64:fi2 in 0i64...fs2.count) {
                    string:fty2 = raw strlist_view(fs2, fi2);
                    if (!(raw text_eq(raw ty_sort(fty2), "Int"))) { drop tx_problem(t, string_concat("a store of an aggregate with a non-integer field: ", line)); break; }
                    int64:foff3 = raw struct_field_offset(ft, ins.ty, fi2);
                    string:fa2 = raw smt_app2("+", p2.text, int_to_string(foff3));
                    if (foff3 == 0i64) { fa2 = raw text_copy(raw strlist_view_of(p2.text)); }
                    mem_cur = raw tx_store(t, mem_cur, fa2, raw strlist_view(fv, fi2), raw ty_size(ft, fty2));
                }
                continue;
            }
            Term:v2 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            if (!v2.ok) { continue; }
            if (!(raw text_eq(v2.sort, "Int"))) { drop tx_problem(t, string_concat("a store of a type the translator does not read: ", line)); continue; }
            mem_cur = raw tx_store(t, mem_cur, raw strlist_view_of(p2.text), raw strlist_view_of(v2.text), raw ty_size(ft, ins.ty));
            continue;
        }
        if (raw text_eq(op, "alloca")) {
            string:asym = string_concat("|a:", raw text_slice(ins.dest, 1i64, ins.dest.len));
            asym = string_concat(asym, "|");
            if (raw tx_reg(t, ins.dest, asym, "Int", 64i64)) { drop tx_object(t, asym, raw ty_size(ft, ins.ty)); }
            continue;
        }
        if (raw text_eq(op, "extractvalue")) {
            Result<int64>:k2 = text_int(raw strlist_view(ins.args, 1i64));
            if (k2.is_error) { drop tx_problem(t, string_concat("an extractvalue index that is not a numeral: ", line)); continue; }
            string:fty3 = raw struct_field_type(ft, ins.ty, k2.value);
            List<string>:src_leaves = raw agg_fields(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            List<string>:xpaths = raw list_init::<string>(4i64);
            List<string>:xtys = raw list_init::<string>(4i64);
            drop agg_leaves(ft, ins.ty, "", @xpaths, @xtys);
            List<int64>:pos = raw leaf_positions(xpaths, k2.value);
            if (raw is_aggregate_ty(fty3)) {
                // the whole inner aggregate: its leaves become the dest's
                List<string>:inner = raw list_init::<string>(4i64);
                for (int64:pi4 in 0i64...pos.count) { drop strlist_push(@inner, raw strlist_view(src_leaves, pos[pi4])); }
                drop tx_set_fields(t, ft, ins.dest, fty3, inner);
                continue;
            }
            if (pos.count != 1i64) { drop tx_problem(t, string_concat("an extractvalue index past the fields: ", line)); continue; }
            string:leaf = raw strlist_view(src_leaves, pos[0i64]);
            Term:fv2 = raw term_int(leaf, raw ty_bits(fty3));
            if (raw text_eq(raw ty_sort(fty3), "Bool")) { fv2 = raw term_bool(leaf); }
            if (raw text_starts_with(raw ty_sort(fty3), "F")) { fv2 = raw term_fp(leaf, raw ty_bits(fty3)); }
            drop tx_set(t, ins.dest, fty3, fv2);
            continue;
        }
        if (raw text_eq(op, "insertvalue")) {
            List<string>:fv3 = raw agg_fields(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
            Result<int64>:k3 = text_int(raw strlist_view(ins.args, 2i64));
            if (k3.is_error) { drop tx_problem(t, string_concat("an insertvalue index that is not a numeral: ", line)); continue; }
            List<string>:ipaths = raw list_init::<string>(4i64);
            List<string>:itys = raw list_init::<string>(4i64);
            drop agg_leaves(ft, ins.ty, "", @ipaths, @itys);
            List<int64>:pos2 = raw leaf_positions(ipaths, k3.value);
            if (pos2.count == 0i64) { drop tx_problem(t, string_concat("an insertvalue index past the fields: ", line)); continue; }
            string:ety = raw strlist_view(ins.tys, 0i64);
            if (raw is_aggregate_ty(ety)) {
                List<string>:ev_leaves = raw agg_fields(t, ft, raw strlist_view(ins.args, 1i64), ety);
                if (ev_leaves.count != pos2.count) { drop tx_problem(t, string_concat("an insertvalue of an aggregate whose leaves do not fit: ", line)); continue; }
                for (int64:pi5 in 0i64...pos2.count) { fv3[pos2[pi5]] = raw text_copy(raw strlist_view(ev_leaves, pi5)); }
            } else {
                Term:ev = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ety);
                if (!ev.ok) { continue; }
                fv3[pos2[0i64]] = raw text_copy(raw strlist_view_of(ev.text));
            }
            drop tx_set_fields(t, ft, ins.dest, ins.ty, fv3);
            continue;
        }
        if (raw text_eq(op, "fence")) { continue; }
        if (raw text_eq(op, "cmpxchg")) { mem_cur = string_concat(raw tx_cmpxchg(t, ft, @ins, mem_cur), ""); continue; }
        if (raw text_eq(op, "atomicrmw")) { mem_cur = string_concat(raw tx_atomicrmw(t, ft, @ins, mem_cur), ""); continue; }
        if (raw text_eq(op, "call")) {
            string:callee = raw strlist_view_of(ins.callee);
            if (raw text_eq(callee, "asm")) { drop tx_problem(t, string_concat("inline asm: not read (the volatile bottom): ", line)); continue; }
            if ((raw text_starts_with(callee, "%")) || (raw text_eq(callee, "@npk_failsafe"))) {
                mem_cur = string_concat(raw tx_opaque_call(t, ft, @ins, mem_cur), "");
                continue;
            }
            if (raw is_trap_callee(callee)) {
                string:code = raw trap_code_of(t, ft, callee, @ins);
                drop tx_trap_site(t, pc, code);
                ended = true;
                continue;
            }
            if (raw text_eq(callee, "@npk_exec") || raw text_eq(callee, "@npk_tls_self")) {
                // the per-thread constants: objects of their struct's size
                string:cs = "exec";
                string:cty = "%npk.exec";
                if (raw text_eq(callee, "@npk_tls_self")) { cs = "tls"; cty = "%npk.tls"; }
                if (!(raw strset_has(t.known, cs))) {
                    drop tx_object(t, cs, raw ty_size(ft, cty));
                    drop tx_range(t, cs, 64i64);
                }
                drop tx_set(t, ins.dest, "ptr", raw term_int(cs, 64i64));
                continue;
            }
            if (raw text_eq(callee, "@llvm.fabs.f64") || raw text_eq(callee, "@llvm.fabs.f32")) {
                Term:fa3 = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
                if (!fa3.ok) { continue; }
                t.uses_fp = true;
                drop tx_set(t, ins.dest, ins.ty, raw term_fp(raw smt_app1("fp.abs", fa3.text), raw ty_bits(ins.ty)));
                continue;
            }
            if (raw text_eq(callee, "@llvm.copysign.f64") || raw text_eq(callee, "@llvm.copysign.f32")) {
                Term:ca = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
                Term:cb = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), ins.ty);
                if (!(ca.ok && cb.ok)) { continue; }
                t.uses_fp = true;
                string:mag = raw smt_app1("fp.abs", ca.text);
                drop tx_set(t, ins.dest, ins.ty, raw term_fp(raw smt_app3("ite", raw smt_app1("fp.isNegative", cb.text), raw smt_app1("fp.neg", mag), mag), raw ty_bits(ins.ty)));
                continue;
            }
            if (raw text_eq(callee, "@llvm.ctpop.i64")) {
                // THE POPCOUNT IS AN UNINTERPRETED FUNCTION (1.5.6b step 1) carrying the
                // two facts every popcount satisfies and nothing else: it lies in
                // [0, 64], and the popcount of zero is zero. Sound by construction --
                // both hold of the instruction whatever its operand -- and enough for
                // what `npk_hardware_concurrency` claims: a count between 1 and 1024,
                // and exactly 1 when the kernel wrote nothing (the row DEF-52 refutes).
                Term:pa = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "i64");
                if (!pa.ok) { continue; }
                if (!t.used_ctpop) {
                    drop strlist_push(@t.defs, "(declare-fun ctpop64 (Int) Int)");
                    drop strlist_push(@t.def_names, "ctpop64");
                    drop list_push(@t.def_refs, raw list_init::<string>(1i64));
                    drop tx_known(t, "ctpop64");
                    t.used_ctpop = true;
                }
                string:pcs = raw tx_fresh(t, "ctpop");
                drop tx_declare(t, pcs, "Int");
                drop tx_range(t, pcs, 64i64);
                drop tx_hyp(t, raw smt_app2("=", pcs, raw smt_app1("ctpop64", pa.text)), "ctpop", 0i64);
                drop tx_hyp(t, raw smt_app2("<=", pcs, "64"), "ctpop", 0i64);
                drop tx_hyp(t, raw smt_app2("=>", raw smt_app2("=", pa.text, "0"), raw smt_app2("=", pcs, "0")), "ctpop", 0i64);
                drop tx_set(t, ins.dest, "i64", raw term_int(pcs, 64i64));
                continue;
            }
            if (raw text_eq(callee, "@llvm.umul.with.overflow.i64")) {
                Term:ua = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "i64");
                Term:ub = raw term_of(t, ft, raw strlist_view(ins.args, 1i64), "i64");
                if (!(ua.ok && ub.ok)) { continue; }
                t.nonlinear = true;
                string:prod = raw smt_app2("*", ua.text, ub.text);
                List<string>:uv = raw list_init::<string>(2i64);
                drop strlist_push(@uv, raw tx_wrap(t, prod, 64i64));
                drop strlist_push(@uv, raw smt_app2(">=", prod, raw pow2_decimal(64i64)));
                drop tx_set_fields(t, ft, ins.dest, "{ i64, i1 }", uv);
                continue;
            }
            if (raw text_eq(callee, "@llvm.memcpy.p0.p0.i64") || raw text_eq(callee, "@llvm.memset.p0.i64")) {
                string:site = string_concat("spec:call:", raw text_slice(callee, 1i64, callee.len));
                site = string_concat(site, ":");
                site = string_concat(site, label);
                site = string_concat(site, ":");
                site = string_concat(site, int_to_string(l + 1i64));
                mem_cur = string_concat(raw tx_intrinsic_mem(t, ft, callee, @ins, pc, mem_cur, site), "");
                continue;
            }
            if (raw text_starts_with(callee, "@llvm.")) { drop tx_problem(t, string_concat("an intrinsic the translator does not read: ", line)); continue; }
            if (raw text_eq(callee, "@npk_sys6")) {
                string:m_after = string_concat(raw tx_syscall(t, ft, @ins, pc, mem_cur, line), "");
                if (m_after.len == 0i64) { ended = true; continue; }
                mem_cur = string_concat(m_after, "");
                continue;
            }
            int64:cfi = raw floor_fn_index(ft, callee);
            if (cfi < 0i64) { drop tx_problem(t, string_concat("a call of a symbol the floor does not define: ", line)); continue; }
            int64:csec = raw spec_section(s, callee);
            if ((csec >= 0i64) && (raw spec_has(s, csec, "summary"))) {
                string:site2 = string_concat("spec:call:", raw text_slice(callee, 1i64, callee.len));
                site2 = string_concat(site2, ":");
                site2 = string_concat(site2, label);
                site2 = string_concat(site2, ":");
                site2 = string_concat(site2, int_to_string(l + 1i64));
                string:m_sum = string_concat(raw tx_summary_call(t, ft, s, callee, @ins, pc, mem_cur, site2), "");
                if (m_sum.len == 0i64) { ended = true; continue; }
                mem_cur = string_concat(m_sum, "");
                if (t.narrow.len > 0i64) { pc = raw smt_app2("and", pc, t.narrow); t.narrow = ""; }
                continue;
            }
            drop tx_problem(t, string_concat("a call that was not inlined (a cycle in the call graph?): ", line));
            continue;
        }
        if (raw text_eq(op, "br")) {
            if (ins.labels.count == 1i64) {
                string:tgt = raw strlist_view(ins.labels, 0i64);
                drop tx_define(t, raw edge_sym(label, tgt), "Bool", pc);
                continue;
            }
            Term:cnd = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), "i1");
            if (!cnd.ok) { continue; }
            string:t1 = raw strlist_view(ins.labels, 0i64);
            string:f1 = raw strlist_view(ins.labels, 1i64);
            if (raw text_eq(t1, f1)) { drop tx_define(t, raw edge_sym(label, t1), "Bool", pc); continue; }
            drop tx_define(t, raw edge_sym(label, t1), "Bool", raw smt_app2("and", pc, cnd.text));
            drop tx_define(t, raw edge_sym(label, f1), "Bool", raw smt_app2("and", pc, raw smt_app1("not", cnd.text)));
            continue;
        }
        if (raw text_eq(op, "ret")) {
            List<string>:vals2 = raw list_init::<string>(2i64);
            if (!(raw text_eq(ins.ty, "void"))) {
                if (raw is_aggregate_ty(ins.ty)) { vals2 = raw agg_fields(t, ft, raw strlist_view(ins.args, 0i64), ins.ty); }
                else {
                    Term:rv = raw term_of(t, ft, raw strlist_view(ins.args, 0i64), ins.ty);
                    if (!rv.ok) { continue; }
                    drop strlist_push(@vals2, raw strlist_view_of(rv.text));
                }
            }
            drop strlist_push(@t.ret_pcs, pc);
            drop strlist_push(@t.ret_mems, mem_cur);
            drop list_push(@t.ret_vals, move(vals2));
            t.ret_ty = raw text_copy(raw strlist_view_of(ins.ty));
            ended = true;
            continue;
        }
        if (raw text_eq(op, "unreachable")) {
            if (x.meta[b].is_stop) {
                // `(unroll N)`: the bound is a hypothesis, and every row it
                // reaches reads `[<=N]`; `(unroll N exact)`: the bound is a
                // claim -- the row `unroll-exact` proves it (the cone excludes
                // the hypothesis), and nothing is marked
                string:tag = string_concat("stop:", raw strlist_view_of(x.meta[b].origin_label));
                if (x.meta[b].exact) {
                    drop tx_hyp(t, raw smt_app1("not", pc), tag, 0i64);
                    string:st = string_concat("spec:unroll-exact:", raw strlist_view_of(x.meta[b].origin_label));
                    drop tx_row_ex(t, st, raw smt_app1("not", pc), tag);
                } else {
                    drop tx_hyp(t, raw smt_app1("not", pc), tag, x.meta[b].bound);
                }
                // the stop's pc is a sink nothing is defined from: the hypothesis
                // joins a cone through what the pc is made of (a bound on one loop
                // is what another loop's exactness rests on)
                drop tx_hyp_reaches(t, pc);
                ended = true;
                continue;
            }
            drop tx_problem(t, "`unreachable` that no trap call precedes");
            ended = true;
            continue;
        }
        drop tx_problem(t, string_concat("instruction form not read: ", line));
    }
    t.blk_mem_out[b] = string_concat(mem_cur, "");
    t.blk_ended[b] = ended;
    t.blk_done[b] = true;
    // 4. a header's invariant: the hypothesis over the fresh symbols, and the init row
    if (is_header && (inv >= 0i64)) {
        string:cm = raw ctx_mem(t, x, b);
        REnv:eh = raw renv_new(cm, mem_cur, false, true);
        string:ih = raw loop_inv_text(t, ft, s, lclause, inv, @eh, @x.meta[b]);
        // the loop's objects, for the allocations inside it
        int64:loc = raw spec_clause(s, lclause, "objects", 0i64);
        if (loc >= 0i64) {
            REnv:eo2 = raw renv_new(cm, raw strlist_view(t.blk_mem_in, b), false, true);
            List<string>:llo = raw list_init::<string>(4i64);
            List<string>:lln = raw list_init::<string>(4i64);
            drop objects_ranges(t, ft, s, loc, @eo2, @x.meta[b], @llo, @lln);
            for (int64:li2 in 0i64...llo.count) {
                drop strlist_push(@t.lobj_lo, raw strlist_view(llo, li2));
                drop strlist_push(@t.lobj_len, raw strlist_view(lln, li2));
                drop strlist_push(@t.lobj_pc, pc);
            }
        }
        string:tag2 = string_concat("invariant:", label);
        // GUARDED BY THE HEADER'S PATH CONDITION: the invariant over the fresh
        // symbols is a fact only where the loop is reached -- asserted bare, an
        // invariant that constrains a parameter (`i < n` says `n >= 1`) would
        // reach the rows of every path, and its own `init` row's cone EXCLUDES
        // it (the base case is decided without the claim it establishes); the
        // wrong-invariant control of the record found both
        drop tx_hyp(t, raw smt_app2("=>", pc, ih), tag2, 0i64);
        // over an Addr: the invariant at every point the file applies this
        // memory to (`tx_instantiate_templates`), so the body's reads and the
        // rows' points see it without an `inst` each
        for (int64:ai in 0i64...t.addr_syms.count) {
            drop strlist_push(@t.it_mem, raw strlist_view(t.blk_mem_in, b));
            drop strlist_push(@t.it_guard, pc);
            drop strlist_push(@t.it_tag, tag2);
            drop list_push(@t.it_inv, inv);
            drop list_push(@t.it_lclause, lclause);
            drop list_push(@t.it_blk, b);
            drop strlist_push(@t.it_cm, cm);
            drop strlist_push(@t.it_sym, raw strlist_view(t.addr_syms, ai));
        }
        // init: every entry edge establishes I with the phis at their incoming values
        string:goal = "true";
        for (int64:pi3 in 0i64...preds.count) {
            int64:p = preds[pi3];
            REnv:ep = raw renv_new(cm, raw strlist_view(t.blk_mem_out, p), false, true);
            bool:okp = true;
            for (int64:l2 in 0i64...x.f.blocks[b].lines.count) {
                FInstr:pins = raw floor_instr(raw strlist_view(x.f.blocks[b].lines, l2));
                if (!(raw text_eq(pins.op, "phi"))) { continue; }
                string:inc2 = raw phi_incoming(t, x, @pins, p);
                if (inc2.len == 0i64) { okp = false; break; }
                Term:tv2 = raw term_of(t, ft, inc2, pins.ty);
                if (!tv2.ok) { okp = false; break; }
                drop renv_add(@ep, raw orig_name(@x.meta[b], pins.dest), raw strlist_view_of(tv2.text));
            }
            if (!okp) { break; }
            string:ig = raw smt_app2("=>", raw edge_sym(raw strlist_view_of(x.f.blocks[p].label), label),
                                     raw loop_inv_text(t, ft, s, lclause, inv, @ep, @x.meta[b]));
            if (pi3 == 0i64) { goal = string_concat(ig, ""); } else { goal = string_concat(raw smt_app2("and", goal, ig), ""); }
        }
        string:st2 = string_concat("spec:invariant-init:", label);
        drop tx_row_ex(t, st2, goal, tag2);
    }
    pass NIL;
};

// The preserve rows, after every block: for each cut loop, each back edge
// re-establishes the invariant with the phis at the latch's values and the
// memory at the latch's exit.
func:tx_preserve_rows = NIL(Tx->:t, FloorText->:ft, Sxs->:s, XFn->:x) never fails {
    for (int64:li in 0i64...x.loops.count) {
        int64:h = x.loops[li].header;
        int64:lclause = raw loop_clause_of(s, x, h);
        int64:inv = 0i64 - 1i64;
        if (lclause >= 0i64) { inv = raw spec_clause(s, lclause, "invariant", 0i64); }
        if (inv < 0i64) { continue; }
        string:hlabel = raw strlist_view_of(x.f.blocks[h].label);
        string:cm = raw ctx_mem(t, x, h);
        string:hpc = raw strlist_view(t.blk_pc, h);
        string:hmem = raw strlist_view(t.blk_mem_in, h);
        string:tag2 = string_concat("invariant:", hlabel);
        // `(inst SYM e [SYM e]...)`: the invariant hypothesis once more with the
        // symbols read as the expressions -- rendered HERE, after every block,
        // because an instantiation point may be a register of the body (the
        // binary search's `mid`); the pairs are SIMULTANEOUS: every expression
        // rendered first, then every symbol read as its expression --
        // `(inst j mid k j)` reads j as mid and k as the original j
        int64:ik = 0i64;
        while (true) decreases s.nodes.count - ik {
            int64:ic = raw spec_clause(s, lclause, "inst", ik);
            if (ic < 0i64) { break; }
            ik = ik + 1i64;
            int64:iln = raw sx_len(s, ic);
            if ((iln < 3i64) || ((iln % 2i64) != 1i64)) { drop tx_problem(t, "an inst clause is `(inst SYM e [SYM e]...)`"); break; }
            REnv:ei = raw renv_new(cm, hmem, false, true);
            REnv:ei0 = raw renv_new(cm, hmem, false, true);
            int64:pair = 1i64;
            while ((pair + 1i64) < iln) decreases iln - pair {
                string:isym = raw sx_atom(s, raw sx_nth(s, ic, pair));
                string:iexp = raw render(t, ft, s, raw sx_nth(s, ic, pair + 1i64), @ei0, @x.meta[h]);
                drop renv_add(@ei, isym, iexp);
                pair = pair + 2i64;
            }
            drop tx_hyp(t, raw smt_app2("=>", hpc, raw loop_inv_text(t, ft, s, lclause, inv, @ei, @x.meta[h])), tag2, 0i64);
        }
        string:goal = "true";
        for (int64:a in 0i64...x.loops[li].latches.count) {
            int64:p = x.loops[li].latches[a];
            if (!t.blk_done[p]) { continue; }
            REnv:ep = raw renv_new(cm, raw strlist_view(t.blk_mem_out, p), false, true);
            bool:okp = true;
            for (int64:l2 in 0i64...x.f.blocks[h].lines.count) {
                FInstr:pins = raw floor_instr(raw strlist_view(x.f.blocks[h].lines, l2));
                if (!(raw text_eq(pins.op, "phi"))) { continue; }
                string:inc = raw phi_incoming(t, x, @pins, p);
                if (inc.len == 0i64) { okp = false; break; }
                Term:tv = raw term_of(t, ft, inc, pins.ty);
                if (!tv.ok) { okp = false; break; }
                drop renv_add(@ep, raw orig_name(@x.meta[h], pins.dest), raw strlist_view_of(tv.text));
            }
            if (!okp) { break; }
            string:pg = raw smt_app2("=>", raw edge_sym(raw strlist_view_of(x.f.blocks[p].label), hlabel),
                                     raw loop_inv_text(t, ft, s, lclause, inv, @ep, @x.meta[h]));
            if (a == 0i64) { goal = string_concat(pg, ""); } else { goal = string_concat(raw smt_app2("and", goal, pg), ""); }
        }
        string:st = string_concat("spec:invariant-preserve:", hlabel);
        drop tx_row_ex(t, st, goal, "");
    }
    pass NIL;
};

// --- the exit merge and the section's rows -----------------------------------------------------------

// `|pc:exit|`, `trap`, `trap_code`, `result` (or its fields) and `mem2`.
func:tx_exit = NIL(Tx->:t, FloorText->:ft, XFn->:x) never fails {
    string:pe = "false";
    for (int64:i in 0i64...t.ret_pcs.count) {
        string:p = raw strlist_view(t.ret_pcs, i);
        if (i == 0i64) { pe = raw text_copy(p); } else { pe = raw smt_app2("or", pe, p); }
    }
    drop tx_define(t, "|pc:exit|", "Bool", pe);
    string:tr = "false";
    string:tc = "0";
    for (int64:j in 0i64...t.trap_pcs.count) {
        string:tp = raw strlist_view(t.trap_pcs, j);
        if (j == 0i64) { tr = raw text_copy(tp); } else { tr = raw smt_app2("or", tr, tp); }
        tc = raw smt_app3("ite", tp, raw strlist_view(t.trap_codes, j), tc);
    }
    drop tx_define(t, "trap", "Bool", tr);
    drop tx_define(t, "trap_code", "Int", tc);
    // result
    string:rty = raw strlist_view_of(x.f.ret_ty);
    if (!(raw text_eq(rty, "void")) && (rty.len > 0i64)) {
        List<string>:fs = raw list_init::<string>(2i64);
        List<string>:rpaths = raw list_init::<string>(2i64);
        if (raw is_aggregate_ty(rty)) { drop agg_leaves(ft, rty, "", @rpaths, @fs); }
        else { drop strlist_push(@fs, rty); drop strlist_push(@rpaths, ""); }
        for (int64:f in 0i64...fs.count) {
            string:fty = raw strlist_view(fs, f);
            string:sort = raw ty_sort(fty);
            string:name = string_concat("result", raw strlist_view(rpaths, f));
            if (t.ret_pcs.count == 0i64) {
                drop tx_declare(t, name, sort);
                continue;
            }
            string:v = "";
            for (int64:k in 0i64...t.ret_pcs.count) {
                int64:ri = t.ret_pcs.count - 1i64 - k;
                if (f >= t.ret_vals[ri].count) { drop tx_problem(t, "a return with fewer fields than the type"); break; }
                string:rv = raw strlist_view(t.ret_vals[ri], f);
                if (k == 0i64) { v = raw text_copy(rv); continue; }
                v = raw smt_app3("ite", raw strlist_view(t.ret_pcs, ri), rv, v);
            }
            if (v.len == 0i64) { continue; }
            drop tx_define(t, name, sort, v);
        }
    }
    // mem2: the merge over the returns
    if (t.ret_pcs.count == 0i64) {
        drop tx_mem_define(t, "mem2", raw smt_app1("mem", "|m:x|"));
        List<string>:e0 = raw list_init::<string>(1i64);
        List<string>:m0 = raw list_init::<string>(1i64);
        drop strlist_push(@e0, "true");
        drop strlist_push(@m0, "mem");
        drop strlist_push(@t.mg_name, "mem2");
        drop list_push(@t.mg_edges, move(e0));
        drop list_push(@t.mg_mems, move(m0));
        pass NIL;
    }
    string:body = raw smt_app1(raw strlist_view(t.ret_mems, t.ret_pcs.count - 1i64), "|m:x|");
    for (int64:k2 in 0i64...(t.ret_pcs.count - 1i64)) {
        int64:ri2 = t.ret_pcs.count - 2i64 - k2;
        body = raw smt_app3("ite", raw strlist_view(t.ret_pcs, ri2), raw smt_app1(raw strlist_view(t.ret_mems, ri2), "|m:x|"), body);
    }
    drop tx_mem_define(t, "mem2", body);
    drop strlist_push(@t.mg_name, "mem2");
    drop list_push(@t.mg_edges, raw strlist_clone(t.ret_pcs));
    drop list_push(@t.mg_mems, raw strlist_clone(t.ret_mems));
    pass NIL;
};

// The section's clauses as hypotheses and rows.
func:tx_section_rows = NIL(Tx->:t, FloorText->:ft, Sxs->:s, XFn->:x, int64:sec) never fails {
    BMeta:plain = raw meta_plain_of(x);
    // requires: hypotheses over the entry state
    REnv:er = raw renv_new("mem", "", false, true);
    int64:rk = 0i64;
    while (true) decreases s.nodes.count - rk {
        int64:rc = raw spec_clause(s, sec, "requires", rk);
        if (rc < 0i64) { break; }
        rk = rk + 1i64;
        drop tx_hyp(t, raw render_clause(t, ft, s, rc, @er, @plain), "requires", 0i64);
    }
    // ensures: one row per clause, on the non-trapping paths
    REnv:ee = raw renv_new("mem", "mem2", true, true);
    int64:ek = 0i64;
    while (true) decreases s.nodes.count - ek {
        int64:ec = raw spec_clause(s, sec, "ensures", ek);
        if (ec < 0i64) { break; }
        ek = ek + 1i64;
        string:p = raw render_clause(t, ft, s, ec, @ee, @plain);
        string:st = string_concat("spec:ensures:", int_to_string(ek));
        // ON THE RETURNING, NON-TRAPPING PATHS: `|pc:exit|` is the fact that a
        // `ret` was reached -- the exit edge's condition (a loop's negated test,
        // a branch's outcome) is what the postcondition is decided under
        drop tx_row_ex(t, st, raw smt_app2("=>", raw smt_app2("and", "|pc:exit|", raw smt_app1("not", "trap")), p), "");
    }
    // the trap outcome: the clause describes the symbol's OWN traps; a summary
    // callee's condition is joined by the writer (a caller cannot name it)
    string:callee_traps = "false";
    for (int64:st in 0i64...t.summary_traps.count) {
        string:c = raw strlist_view(t.summary_traps, st);
        if (st == 0i64) { callee_traps = raw text_copy(c); } else { callee_traps = raw smt_app2("or", callee_traps, c); }
    }
    int64:et = raw spec_clause(s, sec, "ensures-trap", 0i64);
    if (et >= 0i64) {
        REnv:etr = raw renv_new("mem", "", false, true);
        string:tp = raw render_clause(t, ft, s, et, @etr, @plain);
        if (t.summary_traps.count > 0i64) { tp = string_concat(raw smt_app2("or", tp, callee_traps), ""); }
        drop tx_row_ex(t, "spec:ensures-trap", raw smt_app2("=", "trap", tp), "");
    } else {
        if (t.trap_pcs.count > 0i64) {
            if (t.summary_traps.count > 0i64) { drop tx_row_ex(t, "spec:no-trap", raw smt_app2("=>", "trap", callee_traps), ""); }
            else { drop tx_row_ex(t, "spec:no-trap", raw smt_app1("not", "trap"), ""); }
        }
    }
    // the frame: outside the listed ranges memory is unchanged; no clause claims every byte
    int64:fr = raw spec_clause(s, sec, "frame", 0i64);
    string:fx = "|frame:x|";
    if (raw strlist_contains(t.free_syms, "x")) {
        fx = raw spec_sym("x");
        if (!(raw strlist_contains(t.addr_syms, "x"))) { drop tx_problem(t, "the free symbol `x` is the frame row's point and must be an Addr"); }
    }
    string:after = raw tx_mem_app(t, "mem2", fx);
    string:before = raw tx_mem_app(t, "mem", fx);
    string:same = raw smt_app2("=", after, before);
    // THE STACK'S OWN CELLS ARE NO PART OF A FRAME CLAIM: an alloca dies with the
    // call, so the memory a caller sees after it is the memory outside every alloca
    string:stack_in = "false";
    for (int64:ao in 0i64...t.objects.count) {
        string:asym = raw strlist_view(t.objects, ao);
        if (!(raw text_starts_with(asym, "|a:"))) { continue; }
        string:ain = raw smt_app2("and", raw smt_app2("<=", asym, fx), raw smt_app2("<", fx, raw smt_app2("+", asym, int_to_string(t.object_sizes[ao]))));
        if (raw text_eq(stack_in, "false")) { stack_in = move(ain); } else { stack_in = string_concat(raw smt_app2("or", stack_in, ain), ""); }
    }
    if (fr >= 0i64) {
        REnv:ef = raw renv_new("mem", "mem2", true, true);
        string:inr = raw frame_in_ranges(t, ft, s, fr, @ef, @plain, fx);
        if (!(raw text_eq(stack_in, "false"))) { inr = string_concat(raw smt_app2("or", inr, stack_in), ""); }
        // A VIEW IS READ-ONLY, AND THIS ROW IS WHAT PROVES IT (1.5.6c step 1): no
        // frame range exempts a byte of a view -- a point inside one is claimed
        // unchanged wherever else it lies. A section without views builds the
        // text it always did. (With no frame clause the default row below claims
        // every byte; under `(frame objects)` `objects_in` counts the views among
        // what the symbol was handed.)
        string:outside = raw smt_app1("not", inr);
        string:vin = raw views_in(t, ft, s, sec, @ef, @plain, fx);
        if (!(raw text_eq(vin, "false"))) { outside = string_concat(raw smt_app2("or", outside, vin), ""); }
        string:fguard = raw smt_app2("and", raw smt_app2("and", "|pc:exit|", raw smt_app1("not", "trap")), outside);
        bool:emit_frame = true;
        if (raw frame_names_objects(s, fr)) {
            // over the caller's objects only; with none declared nothing is claimed
            string:oin = raw objects_in(t, ft, s, sec, @ef, @plain, fx);
            if (raw text_eq(oin, "false")) { emit_frame = false; } else { fguard = string_concat(raw smt_app2("and", fguard, oin), ""); }
        }
        if (emit_frame) { drop tx_row_ex(t, "spec:frame", raw smt_app2("=>", fguard, same), ""); }
    } else {
        string:dguard = raw smt_app2("and", "|pc:exit|", raw smt_app1("not", "trap"));
        if (!(raw text_eq(stack_in, "false"))) { dguard = string_concat(raw smt_app2("and", dguard, raw smt_app1("not", stack_in)), ""); }
        drop tx_row_ex(t, "spec:frame-default", raw smt_app2("=>", dguard, same), "");
    }
    pass NIL;
};

func:meta_plain_of = BMeta(XFn->:x) never fails {
    pass BMeta{ origin_fn: raw text_copy(raw strlist_view_of(x.f.name)), origin_label: "",
                ren_from: raw list_init::<string>(1i64), ren_to: raw list_init::<string>(1i64),
                is_stop: false, bound: 0i64, exact: false, entry_of: "", cont_of: "" };
};

// --- the transforms, driven by the spec ------------------------------------------------------------

// Inline every call of a floor define that is neither a trap, a per-thread
// constant nor a `(summary)` symbol; then unroll every loop the spec says
// to, innermost first. The call graph is acyclic (the belt of §2.11), and a
// cap catches a cycle anyway.
func:tx_transform = NIL(Tx->:t, FloorText->:ft, Sxs->:s, XFn->:x) never fails {
    int64:k = 0i64;
    bool:again = true;
    while (again && (k < 256i64)) decreases 256i64 - k {
        again = false;
        for (int64:b in 0i64...x.f.blocks.count) {
            for (int64:l in 0i64...x.f.blocks[b].lines.count) {
                FInstr:ins = raw floor_instr(raw strlist_view(x.f.blocks[b].lines, l));
                if (!(raw text_eq(ins.op, "call"))) { continue; }
                string:callee = raw strlist_view_of(ins.callee);
                if (!(raw text_starts_with(callee, "@"))) { continue; }
                if (raw text_starts_with(callee, "@llvm.")) { continue; }
                if (raw is_trap_callee(callee)) { continue; }
                if (raw text_eq(callee, "@npk_exec") || raw text_eq(callee, "@npk_tls_self") || raw text_eq(callee, "@npk_sys6")) { continue; }
                int64:cfi = raw floor_fn_index(ft, callee);
                if (cfi < 0i64) { continue; }
                int64:csec = raw spec_section(s, callee);
                if ((csec >= 0i64) && (raw spec_has(s, csec, "summary"))) { continue; }
                if ((csec >= 0i64) && (raw spec_has(s, csec, "boundary"))) {
                    string:wb = string_concat("a call of a boundary symbol that is not a (summary): ", callee);
                    wb = string_concat(wb, " -- its promise cannot be inlined, only assumed");
                    drop tx_problem(t, wb);
                    pass NIL;
                }
                if (ft.fns[cfi].params.count != ins.args.count) {
                    drop tx_problem(t, string_concat("a call's operand count differs from the callee's parameters: ", callee));
                    pass NIL;
                }
                k = k + 1i64;
                drop xfn_inline(x, b, l, @ft.fns[cfi], ft.fns[cfi].params, k);
                again = true;
                break;
            }
            if (again) { break; }
        }
    }
    if (k >= 256i64) { drop tx_problem(t, "inlining did not terminate: a cycle in the call graph"); pass NIL; }
    // unrolling, innermost first (the loop with the fewest members among the annotated)
    int64:guard = 0i64;
    while (guard < 64i64) decreases 64i64 - guard {
        guard = guard + 1i64;   // also the unrolling's id in the copies' suffixes
        int64:chosen = 0i64 - 1i64;
        int64:chosen_n = 0i64;
        int64:chosen_size = 0i64;
        bool:chosen_exact = false;
        for (int64:li in 0i64...x.loops.count) {
            int64:h = x.loops[li].header;
            int64:lc = raw loop_clause_of(s, x, h);
            if (lc < 0i64) { continue; }
            int64:ur = raw spec_clause(s, lc, "unroll", 0i64);
            if (ur < 0i64) { continue; }
            Result<int64>:n = text_int(raw sx_atom(s, raw sx_nth(s, ur, 1i64)));
            if (n.is_error) { drop tx_problem(t, "an unroll clause's bound is not a number"); pass NIL; }
            bool:ex = false;
            if ((raw sx_len(s, ur)) >= 3i64) {
                if (!(raw text_eq(raw sx_atom(s, raw sx_nth(s, ur, 2i64)), "exact"))) { drop tx_problem(t, "an unroll clause is `(unroll N)` or `(unroll N exact)`"); pass NIL; }
                ex = true;
            }
            int64:size = x.loops[li].members.count;
            if ((chosen < 0i64) || (size < chosen_size)) { chosen = li; chosen_n = n.value; chosen_size = size; chosen_exact = ex; }
        }
        if (chosen < 0i64) { break; }
        drop xfn_unroll(x, chosen, chosen_n, guard, chosen_exact);
        for (int64:pp in 0i64...x.problems.count) { drop tx_problem(t, raw strlist_view(x.problems, pp)); }
        drop list_clear(@x.problems);
    }
    pass NIL;
};

// --- the cones, the hashes, the file -------------------------------------------------------------------

pub struct:FloorRow = {
    string:site;
    string:hash;
    string:tier;
    string:canon;
    List<int64>:cone_hyps;
    int64:bound;             // the largest bound among the stop hypotheses in the cone (0 for none)
};

pub struct:FloorFile = {
    string:symbol;
    string:text;
    List<FloorRow>:rows;
    List<string>:problems;
};

func:has_common = bool(List<string>:a, List<string>:b) never fails {
    for (int64:i in 0i64...a.count) { if (raw strlist_contains(b, raw strlist_view(a, i))) { pass true; } }
    pass false;
};

// The cone of one row: every hypothesis (not excluded by tag) sharing a
// symbol with the closure, every definition the closure names.
func:tx_cone = FloorRow(Tx->:t, int64:ri) never fails {
    string:goal = raw strlist_view(t.row_goals, ri);
    string:excl = raw strlist_view(t.row_excl, ri);
    // THE TIERS: a goal that names no crossing is decided with every crossed
    // value opaque -- the `bv`-tagged equations stay out of its cone, so the
    // solver's linear strategy serves it (with them in, the mixed logic sends
    // a two-line geometry fact past the budget)
    bool:bv_goal = (raw text_contains(goal, "|bv:")) || (raw text_contains(goal, "int2bv"));
    List<string>:gs = raw syms_in(t, goal);
    StrSet:syms = raw strset_init(256i64);
    for (int64:g in 0i64...gs.count) { discard(raw strset_add(@syms, raw strlist_view(gs, g))); }
    List<bool>:hin = raw list_init::<bool>(t.hyps.count + 1i64);
    for (int64:i in 0i64...t.hyps.count) { drop list_push(@hin, false); }
    List<bool>:din = raw list_init::<bool>(t.defs.count + 1i64);
    for (int64:i2 in 0i64...t.defs.count) { drop list_push(@din, false); }
    // a definition references only earlier names, so one BACKWARD pass over
    // the definitions closes them; a hypothesis may name anything, so the
    // two passes alternate until nothing is new (two rounds in practice)
    bool:grew = true;
    // the cone's fixed point: a round that includes no new definition or hypothesis is the last, and both are finite (D-316)
    while (grew) unbounded {
        grew = false;
        for (int64:dd in 0i64...t.defs.count) {
            int64:d = t.defs.count - 1i64 - dd;
            if (din[d]) { continue; }
            if (!(raw strset_has(syms, raw strlist_view(t.def_names, d)))) { continue; }
            din[d] = true;
            for (int64:r in 0i64...t.def_refs[d].count) {
                if (raw strset_add(@syms, raw strlist_view(t.def_refs[d], r))) { grew = true; }
            }
        }
        for (int64:h in 0i64...t.hyps.count) {
            if (hin[h]) { continue; }
            if (excl.len > 0i64) { if (raw text_eq(raw strlist_view(t.hyp_tags, h), excl)) { continue; } }
            if ((!bv_goal) && (raw text_eq(raw strlist_view(t.hyp_tags, h), "bv"))) { continue; }
            bool:touch = false;
            for (int64:q in 0i64...t.hyp_syms[h].count) { if (raw strset_has(syms, raw strlist_view(t.hyp_syms[h], q))) { touch = true; break; } }
            if (!touch) { continue; }
            hin[h] = true;
            grew = true;
            for (int64:r2 in 0i64...t.hyp_syms[h].count) {
                discard(raw strset_add(@syms, raw strlist_view(t.hyp_syms[h], r2)));
            }
        }
    }
    // the canonical text: the cone's definitions in order, its hypotheses in order, the goal
    SmtBuf:b = raw smtbuf_init();
    for (int64:d2 in 0i64...t.defs.count) { if (din[d2]) { drop smtbuf_line(@b, raw strlist_view(t.defs, d2)); } }
    List<int64>:ch = raw list_init::<int64>(16i64);
    int64:bound = 0i64;
    for (int64:h2 in 0i64...t.hyps.count) {
        if (!hin[h2]) { continue; }
        drop list_push(@ch, h2);
        drop smtbuf_line(@b, raw smt_app1("assert", raw strlist_view(t.hyps, h2)));
        if (t.hyp_bounds[h2] > bound) { bound = t.hyp_bounds[h2]; }
    }
    drop smtbuf_line(@b, raw smt_app1("assert", raw smt_app1("not", goal)));
    string:canon = raw smtbuf_text(move(b));
    string:hin2 = string_concat(canon, raw strlist_view_of(t.fn));
    hin2 = string_concat(hin2, "\nfloor-spec\n");
    string:tier = "int";
    if (raw text_contains(canon, "int2bv")) { tier = "bv"; }
    if (raw text_contains(canon, "FloatingPoint")) { tier = "fp"; }
    if (raw text_contains(canon, "(fp.")) { tier = "fp"; }
    string:site = raw strlist_copy(t.row_sites, ri);
    if (bound > 0i64) {
        site = string_concat(site, "[<=");
        site = string_concat(site, int_to_string(bound));
        site = string_concat(site, "]");
    }
    drop strset_free(@syms);
    pass FloorRow{ site: move(site), hash: raw sha256_hex(hin2), tier: move(tier), canon: move(canon), cone_hyps: move(ch), bound: bound };
};

// THE TRANSFORMED GRAPH AS TEXT (a debugging aid the tool exposes as
// `--dump @sym`): every block after inlining and unrolling, with its origin
// and environment.
pub func:floor_dump = string(FloorText->:ft, Sxs->:s, int64:fi, int64:sec) never fails {
    string:name = raw text_copy(raw strlist_view_of(ft.fns[fi].name));
    Tx:t = raw tx_init(name);
    XFn:x = raw xfn_of(@ft.fns[fi]);
    drop tx_transform(@t, ft, s, @x);
    string:out = "";
    for (int64:p in 0i64...t.problems.count) { out = string_concat(out, raw strlist_view(t.problems, p)); out = string_concat(out, "\n"); }
    List<int64>:rpo = raw floor_rpo(@x.f, @x.loops);
    out = string_concat(out, "rpo:");
    for (int64:r in 0i64...rpo.count) { out = string_concat(out, " "); out = string_concat(out, raw strlist_view_of(x.f.blocks[rpo[r]].label)); }
    out = string_concat(out, "\n");
    for (int64:b in 0i64...x.f.blocks.count) {
        out = string_concat(out, raw strlist_view_of(x.f.blocks[b].label));
        out = string_concat(out, ":  ; from ");
        out = string_concat(out, raw strlist_view_of(x.meta[b].origin_fn));
        out = string_concat(out, " ");
        out = string_concat(out, raw strlist_view_of(x.meta[b].origin_label));
        out = string_concat(out, " succs");
        for (int64:k in 0i64...x.f.blocks[b].succs.count) {
            out = string_concat(out, " ");
            out = string_concat(out, raw strlist_view_of(x.f.blocks[x.f.blocks[b].succs[k]].label));
        }
        out = string_concat(out, " env");
        for (int64:e in 0i64...x.meta[b].ren_from.count) {
            out = string_concat(out, " ");
            out = string_concat(out, raw strlist_view(x.meta[b].ren_from, e));
            out = string_concat(out, "->");
            out = string_concat(out, raw strlist_view(x.meta[b].ren_to, e));
        }
        out = string_concat(out, "\n");
        for (int64:l in 0i64...x.f.blocks[b].lines.count) {
            out = string_concat(out, "  ");
            out = string_concat(out, raw strlist_view(x.f.blocks[b].lines, l));
            out = string_concat(out, "\n");
        }
    }
    drop strset_free(@t.known);
    pass out;
};

// THE ENTRY POINT: the file for one symbol with a section.
pub func:floor_translate = FloorFile(FloorText->:ft, Sxs->:s, int64:fi, int64:sec) never fails {
    string:name = raw text_copy(raw strlist_view_of(ft.fns[fi].name));
    Tx:t = raw tx_init(name);
    XFn:x = raw xfn_of(@ft.fns[fi]);
    drop tx_transform(@t, ft, s, @x);
    // the entry state: memory, the parameters, the free symbols, the frame point
    drop tx_mem_declare(@t, "mem");
    for (int64:pi in 0i64...x.f.params.count) {
        string:pname = raw strlist_view(x.f.params, pi);
        string:pty = raw strlist_view(x.f.param_tys, pi);
        if (pname.len == 0i64) { drop tx_problem(@t, "an unnamed parameter"); continue; }
        if (raw is_aggregate_ty(pty)) {
            List<string>:ppaths = raw list_init::<string>(4i64);
            List<string>:ptys = raw list_init::<string>(4i64);
            drop agg_leaves(ft, pty, "", @ppaths, @ptys);
            for (int64:f in 0i64...ppaths.count) {
                drop tx_declare_reg(@t, string_concat(pname, raw strlist_view(ppaths, f)), raw strlist_view(ptys, f));
            }
            continue;
        }
        drop tx_declare_reg(@t, pname, pty);
    }
    int64:fk = 0i64;
    while (true) decreases s.nodes.count - fk {
        int64:fc = raw spec_clause(s, sec, "free", fk);
        if (fc < 0i64) { break; }
        fk = fk + 1i64;
        if ((raw sx_len(s, fc)) != 3i64) { drop tx_problem(@t, "a free clause is `(free NAME Int)` or `(free NAME Addr)`"); break; }
        string:fname = raw sx_atom(s, raw sx_nth(s, fc, 1i64));
        string:fsort = raw sx_atom(s, raw sx_nth(s, fc, 2i64));
        bool:is_addr = raw text_eq(fsort, "Addr");
        if (!(is_addr || (raw text_eq(fsort, "Int")))) { drop tx_problem(@t, "a free symbol's sort must be Int or Addr"); break; }
        string:fsym = raw spec_sym(fname);
        if (raw strset_has(t.known, fsym)) { drop tx_problem(@t, string_concat("a free symbol collides with a register or parameter: ", fname)); break; }
        drop strlist_push(@t.free_syms, fname);
        drop tx_declare(@t, fsym, "Int");
        // an Addr ranges over the address space: a universal over addresses (an
        // invariant's frame conjunct, the frame row) is stated there, where a
        // load's wrapped address is the address itself
        if (is_addr) { drop strlist_push(@t.addr_syms, fname); drop tx_range(@t, fsym, 64i64); }
    }
    drop tx_declare(@t, "|frame:x|", "Int");
    drop tx_range(@t, "|frame:x|", 64i64);
    // `(objects (lo len) ...)` and `(views (lo len) ...)`: the byte ranges the parameters name
    int64:ok_ = raw spec_clause(s, sec, "objects", 0i64);
    int64:vk_ = raw spec_clause(s, sec, "views", 0i64);
    if ((ok_ >= 0i64) || (vk_ >= 0i64)) {
        BMeta:plain0 = raw meta_plain_of(@x);
        REnv:eo = raw renv_new("mem", "", false, true);
        List<string>:ofacts = raw objects_facts(@t, ft, s, ok_, vk_, @eo, @plain0, true);
        for (int64:of in 0i64...ofacts.count) { drop tx_hyp(@t, raw strlist_view(ofacts, of), "requires", 0i64); }
    }
    // the blocks in dominance order
    int64:nb = x.f.blocks.count;
    for (int64:b in 0i64...nb) {
        drop strlist_push(@t.blk_pc, "false");
        drop strlist_push(@t.blk_mem_in, "mem");
        drop strlist_push(@t.blk_mem_out, "mem");
        drop list_push(@t.blk_ended, false);
        drop list_push(@t.blk_done, false);
    }
    List<int64>:rpo = raw floor_rpo(@x.f, @x.loops);
    for (int64:i in 0i64...rpo.count) {
        if (t.problems.count > 0i64) { break; }
        drop tx_block(@t, ft, s, @x, rpo[i]);
    }
    if (t.problems.count == 0i64) {
        drop tx_exit(@t, ft, @x);
        drop tx_preserve_rows(@t, ft, s, @x);
        drop tx_section_rows(@t, ft, s, @x, sec);
        drop tx_instantiate_templates(@t, ft, s, @x);
    }
    if (t.used_opaque && (!(raw spec_has(s, sec, "residue")))) {
        drop tx_problem(@t, "an opaque call (npk_failsafe, an indirect call) makes the paths past it residue by construction: the section needs a (residue \"...\") sentence");
    }
    FloorFile:out = FloorFile{ symbol: raw text_copy(name), text: "", rows: raw list_init::<FloorRow>(8i64), problems: raw strlist_clone(t.problems) };
    if (t.problems.count > 0i64) { drop strset_free(@t.known); pass out; }
    for (int64:ri in 0i64...t.row_goals.count) { drop list_push(@out.rows, raw tx_cone(@t, ri)); }
    // the file
    SmtBuf:b2 = raw smtbuf_init();
    drop smtbuf_line(@b2, string_concat("; ", name));
    for (int64:ri2 in 0i64...out.rows.count) {
        string:c = string_concat("; o", int_to_string(ri2 + 1i64));
        c = string_concat(c, " floor-spec ");
        c = string_concat(c, raw strlist_view_of(out.rows[ri2].hash));
        c = string_concat(c, " ");
        c = string_concat(c, raw strlist_view_of(out.rows[ri2].site));
        drop smtbuf_line(@b2, c);
    }
    drop smtbuf_line(@b2, string_concat("; checks ", int_to_string(out.rows.count)));
    if (t.uses_fp || t.uses_bv) { drop smtbuf_line(@b2, "(set-logic ALL)"); }
    else { if (t.nonlinear) { drop smtbuf_line(@b2, "(set-logic QF_UFNIA)"); } else { drop smtbuf_line(@b2, "(set-logic QF_UFLIA)"); } }
    for (int64:d in 0i64...t.defs.count) { drop smtbuf_line(@b2, raw strlist_view(t.defs, d)); }
    for (int64:ri3 in 0i64...out.rows.count) {
        drop smtbuf_line(@b2, "(push)");
        for (int64:h in 0i64...out.rows[ri3].cone_hyps.count) {
            int64:hi = out.rows[ri3].cone_hyps[h];
            string:named = string_concat("(! ", raw strlist_view(t.hyps, hi));
            named = string_concat(named, " :named h");
            named = string_concat(named, int_to_string(hi));
            named = string_concat(named, ")");
            drop smtbuf_line(@b2, raw smt_app1("assert", named));
        }
        string:goal = string_concat("(! ", raw smt_app1("not", raw strlist_view(t.row_goals, ri3)));
        goal = string_concat(goal, " :named o");
        goal = string_concat(goal, int_to_string(ri3 + 1i64));
        goal = string_concat(goal, ")");
        drop smtbuf_line(@b2, raw smt_app1("assert", goal));
        drop smtbuf_line(@b2, "(check-sat)");
        drop smtbuf_line(@b2, "(pop)");
    }
    out.text = raw smtbuf_text(move(b2));
    drop strset_free(@t.known);
    pass out;
};
