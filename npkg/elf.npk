// elf -- the undefined-symbol scan's reader, and the runtime allowlist
// (1.4.8; D-011 §3 "enforce it mechanically", D-206 §4 "the closed-world
// link is law, not a flag").
//
// THE OBJECT IS READ DIRECTLY. The harness spawns `llvm-readelf -s` and
// parses its columns; a fourth LLVM tool outside the `[toolchain]` pin, with
// a text format nothing checks, is a poor foundation for a rule that is
// LAW. ELF64's symbol table is thirty lines to walk: the section header
// table, the one section of type SYMTAB, its string table, and every
// twenty-four-byte entry whose section index is SHN_UNDEF. The parity stage
// cross-checks this reader against `llvm-readelf` on every object the
// Python harness scans, so a disagreement between the two is a diff, never
// a silent difference in what the law let through.
//
// Every field is read through a bounds-checked accessor; a truncated or
// alien object is `EElf`, a refusal, never a wrong answer. A 64-bit field is
// read as two halves and refused when the high half is set -- no offset in
// a relocatable object approaches four gigabytes, and the arithmetic then
// cannot reach D-210's overflow trap.

mod:elf;

use "./text.npk".*;

pub error:EElf;   // not an ELF64 little-endian object this reader can walk, or a truncated one

func:byte_at = int64(string:s, int64:off) {
    if (off < 0i64)      { fail EElf; }
    if (off >= s.len)    { fail EElf; }
    pass (s.ptr[off] => int64);
};

func:u16_at = int64(string:s, int64:off) {
    int64:b0 = relay byte_at(s, off);
    int64:b1 = relay byte_at(s, off + 1i64);
    pass (b0 + (b1 * 256i64));
};

func:u32_at = int64(string:s, int64:off) {
    int64:lo = relay u16_at(s, off);
    int64:hi = relay u16_at(s, off + 2i64);
    pass (lo + (hi * 65536i64));
};

func:u64_at = int64(string:s, int64:off) {
    int64:lo = relay u32_at(s, off);
    int64:hi = relay u32_at(s, off + 4i64);
    if (hi != 0i64) { fail EElf; }
    pass lo;
};

// Every symbol the object needs someone else to provide -- `st_shndx ==
// SHN_UNDEF` with a name -- in table order. The caller sorts.
pub func:elf_undefined = List<string>(string:obj_path) {
    List<string>:out = raw list_init::<string>(8i64);
    Result<cstring>:cp = to_cstring(obj_path);
    if (cp.is_error) { fail EElf; }
    string:s = relay read_file(cp.value);
    // e_ident: 0x7f 'E' 'L' 'F', ELFCLASS64, ELFDATA2LSB
    if ((relay byte_at(s, 0i64)) != 127i64) { fail EElf; }
    if ((relay byte_at(s, 1i64)) != 69i64)  { fail EElf; }
    if ((relay byte_at(s, 2i64)) != 76i64)  { fail EElf; }
    if ((relay byte_at(s, 3i64)) != 70i64)  { fail EElf; }
    if ((relay byte_at(s, 4i64)) != 2i64)   { fail EElf; }
    if ((relay byte_at(s, 5i64)) != 1i64)   { fail EElf; }
    int64:shoff = relay u64_at(s, 40i64);
    int64:shentsize = relay u16_at(s, 58i64);
    int64:shnum = relay u16_at(s, 60i64);
    if (shentsize != 64i64) { fail EElf; }
    if (shnum == 0i64) { fail EElf; }   // the extended-count form: not an object llc emits here
    int64:symoff = 0i64;
    int64:symsize = 0i64;
    int64:strlink = 0i64;
    bool:found = false;
    for (int64:i in 0i64...shnum) {
        int64:base = shoff + (i * 64i64);
        int64:kind = relay u32_at(s, base + 4i64);
        if (kind == 2i64) {   // SHT_SYMTAB
            symoff = relay u64_at(s, base + 24i64);
            symsize = relay u64_at(s, base + 32i64);
            strlink = relay u32_at(s, base + 40i64);
            found = true;
        }
    }
    if (!found) { pass out; }
    if (strlink >= shnum) { fail EElf; }
    int64:sbase = shoff + (strlink * 64i64);
    int64:stroff = relay u64_at(s, sbase + 24i64);
    int64:strsize = relay u64_at(s, sbase + 32i64);
    if ((symsize % 24i64) != 0i64) { fail EElf; }
    int64:n = symsize / 24i64;
    for (int64:k in 0i64...n) {
        int64:e = symoff + (k * 24i64);
        int64:name = relay u32_at(s, e);
        int64:shndx = relay u16_at(s, e + 6i64);
        if (shndx != 0i64) { continue; }
        if (name == 0i64) { continue; }
        if (name >= strsize) { fail EElf; }
        int64:at = stroff + name;
        int64:stop = at;
        while (true) {
            if (stop >= (stroff + strsize)) { fail EElf; }
            if ((relay byte_at(s, stop)) == 0i64) { break; }
            stop = stop + 1i64;
        }
        if (stop > at) {
            drop strlist_push(@out, raw text_slice(s, at, stop));
        }
    }
    pass out;
};

// A section header's name, from the section-name string table.
func:sec_name = string(string:s, int64:shoff, int64:shstr, int64:i) {
    int64:sb = shoff + (shstr * 64i64);
    int64:stroff = relay u64_at(s, sb + 24i64);
    int64:strsize = relay u64_at(s, sb + 32i64);
    int64:name = relay u32_at(s, shoff + (i * 64i64));
    if (name >= strsize) { fail EElf; }
    int64:at = stroff + name;
    int64:stop = at;
    while (true) {
        if (stop >= (stroff + strsize)) { fail EElf; }
        if ((relay byte_at(s, stop)) == 0i64) { break; }
        stop = stop + 1i64;
    }
    pass (raw text_slice(s, at, stop));
};

// A NUL-terminated name out of a string table.
func:str_at = string(string:s, int64:stroff, int64:strsize, int64:name) {
    if (name >= strsize) { fail EElf; }
    int64:at = stroff + name;
    int64:stop = at;
    while (true) {
        if (stop >= (stroff + strsize)) { fail EElf; }
        if ((relay byte_at(s, stop)) == 0i64) { break; }
        stop = stop + 1i64;
    }
    pass (raw text_slice(s, at, stop));
};

// EVERY FUNCTION'S FRAME, AS `llc -stack-size-section` RECORDS IT (1.5.8 step
// 2; D-305): one "name size" line per function, in the section's order. The
// `.stack_sizes` section holds, per function, an eight-byte address -- zero in
// a relocatable object, filled by a relocation in `.rela.stack_sizes` against
// the text section's symbol with the function's offset as the addend -- and
// the frame size as ULEB128. The function is the FUNC symbol of that section
// at that offset. `floor-stack-reserve` reads it (npkg/floor_stack.npk); the
// harness reads the same section through `llvm-readobj --stack-sizes`.
pub func:elf_stack_sizes = List<string>(string:obj_path) {
    List<string>:out = raw list_init::<string>(64i64);
    Result<cstring>:cp = to_cstring(obj_path);
    if (cp.is_error) { fail EElf; }
    string:s = relay read_file(cp.value);
    if ((relay byte_at(s, 0i64)) != 127i64) { fail EElf; }
    if ((relay byte_at(s, 1i64)) != 69i64)  { fail EElf; }
    if ((relay byte_at(s, 2i64)) != 76i64)  { fail EElf; }
    if ((relay byte_at(s, 3i64)) != 70i64)  { fail EElf; }
    if ((relay byte_at(s, 4i64)) != 2i64)   { fail EElf; }
    if ((relay byte_at(s, 5i64)) != 1i64)   { fail EElf; }
    int64:shoff = relay u64_at(s, 40i64);
    int64:shentsize = relay u16_at(s, 58i64);
    int64:shnum = relay u16_at(s, 60i64);
    int64:shstr = relay u16_at(s, 62i64);
    if (shentsize != 64i64) { fail EElf; }
    if ((shnum == 0i64) || (shstr >= shnum)) { fail EElf; }
    int64:ss_idx = 0i64 - 1i64;
    int64:sym_idx = 0i64 - 1i64;
    for (int64:i in 0i64...shnum) {
        int64:kind = relay u32_at(s, (shoff + (i * 64i64)) + 4i64);
        if (kind == 2i64) { sym_idx = i; }
        if (kind == 1i64) {
            string:nm = relay sec_name(s, shoff, shstr, i);
            if (raw text_eq(nm, ".stack_sizes")) { ss_idx = i; }
        }
    }
    if ((ss_idx < 0i64) || (sym_idx < 0i64)) { fail EElf; }
    int64:rel_idx = 0i64 - 1i64;
    for (int64:j in 0i64...shnum) {
        int64:rb = shoff + (j * 64i64);
        if ((relay u32_at(s, rb + 4i64)) == 4i64) {          // SHT_RELA
            if ((relay u32_at(s, rb + 44i64)) == ss_idx) { rel_idx = j; }
        }
    }
    if (rel_idx < 0i64) { fail EElf; }
    int64:ssb = shoff + (ss_idx * 64i64);
    int64:ssoff = relay u64_at(s, ssb + 24i64);
    int64:sssize = relay u64_at(s, ssb + 32i64);
    int64:yb = shoff + (sym_idx * 64i64);
    int64:symoff = relay u64_at(s, yb + 24i64);
    int64:symsize = relay u64_at(s, yb + 32i64);
    int64:strlink = relay u32_at(s, yb + 40i64);
    if (strlink >= shnum) { fail EElf; }
    int64:tb = shoff + (strlink * 64i64);
    int64:stroff = relay u64_at(s, tb + 24i64);
    int64:strsize = relay u64_at(s, tb + 32i64);
    if ((symsize % 24i64) != 0i64) { fail EElf; }
    int64:nsyms = symsize / 24i64;
    int64:rb2 = shoff + (rel_idx * 64i64);
    int64:reloff = relay u64_at(s, rb2 + 24i64);
    int64:relsize = relay u64_at(s, rb2 + 32i64);
    if ((relsize % 24i64) != 0i64) { fail EElf; }
    int64:nrel = relsize / 24i64;
    for (int64:r in 0i64...nrel) {
        int64:e = reloff + (r * 24i64);
        int64:roff = relay u64_at(s, e);
        int64:rsym = relay u32_at(s, e + 12i64);
        int64:addend = relay u64_at(s, e + 16i64);
        if (rsym >= nsyms) { fail EElf; }
        int64:se = symoff + (rsym * 24i64);
        int64:stype = (relay byte_at(s, se + 4i64)) & 15i64;
        int64:sshndx = relay u16_at(s, se + 6i64);
        int64:target = addend;
        if (stype == 2i64) { target = (relay u64_at(s, se + 8i64)) + addend; }
        // the FUNC symbol of the same section at that offset
        string:fname = "";
        for (int64:k in 0i64...nsyms) {
            int64:fe = symoff + (k * 24i64);
            if (((relay byte_at(s, fe + 4i64)) & 15i64) != 2i64) { continue; }
            if ((relay u16_at(s, fe + 6i64)) != sshndx) { continue; }
            if ((relay u64_at(s, fe + 8i64)) != target) { continue; }
            fname = relay str_at(s, stroff, strsize, relay u32_at(s, fe));
            break;
        }
        if (fname.len == 0i64) { fail EElf; }
        // the size: ULEB128 after the eight-byte address
        int64:at = (ssoff + roff) + 8i64;
        if ((roff + 8i64) >= sssize) { fail EElf; }
        int64:size = 0i64;
        int64:mul = 1i64;
        int64:n = 0i64;
        while (true) {
            int64:b = relay byte_at(s, at + n);
            size = size + ((b & 127i64) * mul);
            n = n + 1i64;
            if (b < 128i64) { break; }
            if (n >= 5i64) { fail EElf; }
            mul = mul * 128i64;
        }
        drop strlist_push(@out, string_concat(string_concat(fname, " "), int_to_string(size)));
    }
    pass out;
};

// The functions `runtime/npkrt.ll` DEFINES, read off the IR text -- the
// harness's `_npkrt_defines` shape: `define`, whitespace, an optional
// `internal`, a return type, whitespace, `@name(` with a `\w+` name (a
// quoted name does not match, exactly as its `\w+` never did). Plus `main`,
// the one symbol the RUNTIME may need because the program provides it.
// THE ALLOWLIST IS THE RUNTIME'S EXPORTS (1.5.2d step 2b; OPEN_DECISIONS
// DEF-21, the library workbench's finding): every non-`internal` `define`,
// and every `.globl` name the `module asm` block declares (`_start`,
// `npk_clone_raw` -- hand-written entry points no `define` scan can see).
// Until this step the list was every define, `internal` ones included -- 57
// names the object does not export, so a program naming one passed the scan
// and failed at the link, where D-206 wants the named refusal -- and it
// missed the two `.globl` names, refusing a legal program. The object is the
// authority: 109 non-internal defines plus 2 `.globl` names are exactly its
// 111 GLOBAL symbols. `runtime_exports` reads a text; `runtime_allowlist`
// reads the file (and `main` is added by the caller, as before).
// An LLVM symbol byte, `[-a-zA-Z$._0-9]` (the scanner's own copy; `irscan.npk`'s
// is private to it).
func:elf_sym_byte = bool(uint8:c) never fails {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }
    if ((c >= 65u8) && (c <= 90u8))  { pass true; }
    if ((c >= 48u8) && (c <= 57u8))  { pass true; }
    if (c == 95u8) { pass true; }
    if (c == 46u8) { pass true; }
    if (c == 36u8) { pass true; }
    if (c == 45u8) { pass true; }
    pass false;
};

pub func:runtime_exports = List<string>(string:s) never fails {
    List<string>:out = raw list_init::<string>(200i64);
    List<string>:lines = raw text_lines(s);
    for (int64:li in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, li);
        // `module asm ".globl NAME"`
        int64:g = raw text_index_from(ln, ".globl", 0i64);
        if ((g >= 0i64) && (raw text_starts_with(ln, "module asm"))) {
            int64:ns = g + 6i64;
            while ((ns < ln.len) && (raw text_is_ws(ln.ptr[ns]))) { ns = ns + 1i64; }
            int64:ne = ns;
            while (ne < ln.len) {
                if (!(raw elf_sym_byte(ln.ptr[ne]))) { break; }
                ne = ne + 1i64;
            }
            if (ne > ns) { drop strlist_push(@out, raw text_slice(ln, ns, ne)); }
            continue;
        }
        if (!(raw text_starts_with(ln, "define"))) { continue; }
        int64:i = 6i64;
        if (i >= ln.len) { continue; }
        if (!(raw text_is_ws(ln.ptr[i]))) { continue; }
        while ((i < ln.len) && (raw text_is_ws(ln.ptr[i]))) { i = i + 1i64; }
        // An `internal` define is not an export.
        if (raw text_starts_with(raw text_slice(ln, i, ln.len), "internal ")) { continue; }
        int64:at = raw text_find_byte(ln, 64u8, i);
        if (at < 0i64) { continue; }
        int64:e = at + 1i64;
        while (e < ln.len) {
            if (!(raw elf_sym_byte(ln.ptr[e]))) { break; }
            e = e + 1i64;
        }
        if (e == (at + 1i64)) { continue; }
        drop strlist_push(@out, raw text_slice(ln, at + 1i64, e));
    }
    pass out;
};

pub func:runtime_allowlist = List<string>(string:npkrt_ll) {
    Result<cstring>:cp = to_cstring(npkrt_ll);
    if (cp.is_error) { fail EElf; }
    string:s = relay read_file(cp.value);
    pass (raw runtime_exports(s));
};
