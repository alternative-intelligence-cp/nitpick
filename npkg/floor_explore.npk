// floor_explore -- THE MODELS READ A SECOND WAY (1.5.6b step 4d; D-295):
// explicit-state search over a protocol model's WHOLE reachable state space.
//
// D-289 decides a model's bad predicates by unrolling it to a depth K under a
// preemption bound D and asking the pinned solver (`floor_model.npk`). The
// models are SMALL -- 68 to 1,086 reachable states when this was written --
// and plain breadth-first search reads each in well under a second with no
// depth bound, no preemption bound and no solver. It is a second, independent
// reader of what a model MEANS: the unroller writes the SMT text for BOTH
// runners, so until this belt the two-runner rule never reached a model's
// meaning (1.5.6's stutter hole -- an unroller that made a halted protocol
// read as a safe one -- would have been a disagreement on its first run). And
// it says what a bounded row cannot: a bad state is reachable NOWHERE.
//
// THE SEMANTICS ARE THE UNROLLER'S, MIRRORED: one step per tick or a stutter;
// a step's `next` expressions read the PRE-state, the FIRST binding of a
// variable wins, an unbound variable keeps its value; the ranges hold at every
// tick (a successor out of range is no transition -- the unrolling drops it
// SILENTLY, which is why it is a finding here); the kernel library's rules
// expand exactly as `read_kernel` expands them; a stutter tick's thread is
// free, so thread changes are counted over real steps; a bad predicate is read
// at ticks 1..K, and a stutter keeps the initial state at tick 1.
//
// THE RUN IS GREEN ONLY WHEN BOTH READINGS HOLD -- the solver's rows and this
// search -- which is the disagreement check: no verdict passes between them.
// The Python twin is `bootstrap/harness/floor.py`'s `check_models_explicit`,
// finding for finding, byte for byte; the numbers TCB.md's generated residue
// region prints (`xp_facts`) are this module's in `npkg` and that one's in the
// harness.
//
// A STATE IS ONE `int64` (mixed radix over the variables' ranges); the visited
// set is an open-addressed table of state indices. A model whose state product
// does not fit, or that reaches more than `XP_STATE_CAP` states, is REFUSED BY
// NAME (`floor-model-too-large`), never skipped. Arithmetic is held to
// magnitudes below 2^31 per operand so that no sum or product of a model's
// expressions can overflow (plain integers trap, D-210): a value past it is
// `floor-model-unreadable`, in both twins, with one sentence.

mod:floor_explore;

use "../src/frontend/paths.npk".*;
use "../lib/nfs.npk".*;
use "./text.npk".*;
use "./floor_spec.npk".*;
use "./floor_model.npk".*;

pub func:XP_STATE_CAP = int64() never fails { pass 200000i64; };
func:XP_INF = int64() never fails { pass 1000000000i64; };
func:XP_OPERAND_MAX = int64() never fails { pass 2147483648i64; };

// expression kinds of the pool
func:XK_NUM = int64() never fails { pass 0i64; };
func:XK_VAR = int64() never fails { pass 1i64; };
func:XK_TRUE = int64() never fails { pass 2i64; };
func:XK_FALSE = int64() never fails { pass 3i64; };
func:XK_NOT = int64() never fails { pass 4i64; };
func:XK_AND = int64() never fails { pass 5i64; };
func:XK_OR = int64() never fails { pass 6i64; };
func:XK_IMPL = int64() never fails { pass 7i64; };
func:XK_ITE = int64() never fails { pass 8i64; };
func:XK_EQ = int64() never fails { pass 9i64; };
func:XK_NE = int64() never fails { pass 10i64; };
func:XK_LT = int64() never fails { pass 11i64; };
func:XK_LE = int64() never fails { pass 12i64; };
func:XK_GT = int64() never fails { pass 13i64; };
func:XK_GE = int64() never fails { pass 14i64; };
func:XK_ADD = int64() never fails { pass 15i64; };
func:XK_SUB = int64() never fails { pass 16i64; };
func:XK_MUL = int64() never fails { pass 17i64; };
func:XK_NEG = int64() never fails { pass 18i64; };

// One model as the explicit reading holds it: FLAT, parallel lists (no list of
// owning structs), every expression an index into one pool.
pub struct:XModel = {
    bool:ok;
    string:why;                 // the unreadable sentence ("" when ok)
    bool:too_large;
    bool:eval_bad;              // an expression's value left the computing range during a run
    List<string>:vars;
    List<int64>:lo;
    List<int64>:hi;
    List<string>:threads;
    List<int64>:ek;
    List<int64>:ea;
    List<int64>:eb;
    List<int64>:ec;
    int64:init_e;
    List<int64>:pin;            // per variable: 1 when `init` pins it to `pin_val`
    List<int64>:pin_val;
    List<int64>:s_thr;          // the base steps, in model order
    List<string>:s_name;
    List<int64>:s_guard;        // pool index, or -1 for none
    List<int64>:s_nstart;       // the step's window into nvar/nexpr
    List<int64>:s_ncount;
    List<int64>:nvar;
    List<int64>:nexpr;
    List<string>:b_name;
    List<int64>:b_expr;
    int64:depth;
    int64:preempt;
    List<string>:c_name;
    List<string>:c_bad;
    List<int64>:c_mstart;       // the control's window into the mutations
    List<int64>:c_mcount;
    List<int64>:m_kind;         // 0 replace, 1 remove
    List<string>:m_thr;
    List<string>:m_step;
    List<int64>:m_guard;
    List<int64>:m_nstart;
    List<int64>:m_ncount;
};

func:xm_new = XModel() never fails {
    pass (XModel{ ok: true, why: "", too_large: false, eval_bad: false,
                  vars: raw list_init::<string>(8i64), lo: raw list_init::<int64>(8i64), hi: raw list_init::<int64>(8i64),
                  threads: raw list_init::<string>(4i64),
                  ek: raw list_init::<int64>(64i64), ea: raw list_init::<int64>(64i64), eb: raw list_init::<int64>(64i64), ec: raw list_init::<int64>(64i64),
                  init_e: 0i64 - 1i64, pin: raw list_init::<int64>(8i64), pin_val: raw list_init::<int64>(8i64),
                  s_thr: raw list_init::<int64>(16i64), s_name: raw list_init::<string>(16i64), s_guard: raw list_init::<int64>(16i64),
                  s_nstart: raw list_init::<int64>(16i64), s_ncount: raw list_init::<int64>(16i64),
                  nvar: raw list_init::<int64>(32i64), nexpr: raw list_init::<int64>(32i64),
                  b_name: raw list_init::<string>(4i64), b_expr: raw list_init::<int64>(4i64), depth: 0i64 - 1i64, preempt: 0i64 - 1i64,
                  c_name: raw list_init::<string>(4i64), c_bad: raw list_init::<string>(4i64), c_mstart: raw list_init::<int64>(4i64), c_mcount: raw list_init::<int64>(4i64),
                  m_kind: raw list_init::<int64>(4i64), m_thr: raw list_init::<string>(4i64), m_step: raw list_init::<string>(4i64), m_guard: raw list_init::<int64>(4i64),
                  m_nstart: raw list_init::<int64>(4i64), m_ncount: raw list_init::<int64>(4i64) });
};

// The FIRST problem is the one reported (both twins walk the file in order).
func:xm_fail = NIL(XModel->:m, string:why) never fails {
    if (m.ok) { m.ok = false; m.why = string_concat(why, ""); }
    pass NIL;
};

func:xm_var_index = int64(XModel->:m, string:name) never fails {
    for (int64:i in 0i64...m.vars.count) { if (raw text_eq(raw strlist_view(m.vars, i), name)) { pass i; } }
    pass (0i64 - 1i64);
};

func:xm_thread_index = int64(XModel->:m, string:name) never fails {
    for (int64:i in 0i64...m.threads.count) { if (raw text_eq(raw strlist_view(m.threads, i), name)) { pass i; } }
    pass (0i64 - 1i64);
};

func:xp_is_numeral = bool(string:a) never fails {
    if (a.len == 0i64) { pass false; }
    int64:i = 0i64;
    if (a.ptr[0i64] == 45u8) { i = 1i64; if (a.len == 1i64) { pass false; } }
    while (i < a.len) { if (!(raw text_is_digit(a.ptr[i]))) { pass false; } i = i + 1i64; }
    pass true;
};

// A numeral of at most 18 digits (the caller has checked the shape and the length).
func:xp_parse = int64(string:a) never fails {
    int64:v = 0i64;
    int64:i = 0i64;
    bool:neg = false;
    if (a.ptr[0i64] == 45u8) { neg = true; i = 1i64; }
    while (i < a.len) { v = (v * 10i64) + ((a.ptr[i] - 48u8) =>! int64); i = i + 1i64; }
    if (neg) { pass (0i64 - v); }
    pass v;
};

func:xp_push = int64(XModel->:m, int64:k, int64:a, int64:b, int64:c) never fails {
    drop list_push(@m.ek, k);
    drop list_push(@m.ea, a);
    drop list_push(@m.eb, b);
    drop list_push(@m.ec, c);
    pass (m.ek.count - 1i64);
};

// One expression of the models' grammar compiled into the pool: its index, or
// -1 with the model marked unreadable. Depth-first, left to right -- the order
// the Python twin validates in, so the FIRST problem is the same problem.
func:xp_compile = int64(XModel->:m, Sxs->:s, int64:node) never fails {
    if (node < 0i64) { drop xm_fail(m, "an expression that is neither a word nor an application"); pass (0i64 - 1i64); }
    if (!(raw sx_is_list(s, node))) {
        string:a = raw sx_atom(s, node);
        if (a.len == 0i64) { drop xm_fail(m, "an expression that is neither a word nor an application"); pass (0i64 - 1i64); }
        if (raw xp_is_numeral(a)) {
            if (a.len > 18i64) { drop xm_fail(m, string_concat("a numeral too large for the explicit reading: ", a)); pass (0i64 - 1i64); }
            pass (raw xp_push(m, raw XK_NUM(), raw xp_parse(a), 0i64, 0i64));
        }
        if (raw text_eq(a, "true")) { pass (raw xp_push(m, raw XK_TRUE(), 0i64, 0i64, 0i64)); }
        if (raw text_eq(a, "false")) { pass (raw xp_push(m, raw XK_FALSE(), 0i64, 0i64, 0i64)); }
        int64:vi = raw xm_var_index(m, a);
        if (vi < 0i64) { drop xm_fail(m, string_concat("an expression names no state variable: ", a)); pass (0i64 - 1i64); }
        pass (raw xp_push(m, raw XK_VAR(), vi, 0i64, 0i64));
    }
    string:h = raw sx_head(s, node);
    if (h.len == 0i64) { drop xm_fail(m, "an expression that is neither a word nor an application"); pass (0i64 - 1i64); }
    int64:n = (raw sx_len(s, node)) - 1i64;
    // the operator and its arity FIRST, then the operands in order
    int64:bin = 0i64 - 1i64;      // the binary kind an n-ary head folds with
    bool:known = false;
    bool:arity_ok = true;
    if (raw text_eq(h, "and")) { known = true; bin = raw XK_AND(); arity_ok = (n >= 1i64); }
    if (raw text_eq(h, "or"))  { known = true; bin = raw XK_OR();  arity_ok = (n >= 1i64); }
    if (raw text_eq(h, "+"))   { known = true; bin = raw XK_ADD(); arity_ok = (n >= 1i64); }
    if (raw text_eq(h, "*"))   { known = true; bin = raw XK_MUL(); arity_ok = (n >= 1i64); }
    if (raw text_eq(h, "-"))   { known = true; bin = raw XK_SUB(); arity_ok = (n >= 1i64); }
    if (raw text_eq(h, "not")) { known = true; arity_ok = (n == 1i64); }
    if (raw text_eq(h, "=>"))  { known = true; arity_ok = (n == 2i64); }
    if (raw text_eq(h, "ite")) { known = true; arity_ok = (n == 3i64); }
    if (raw text_eq(h, "="))   { known = true; arity_ok = (n >= 2i64); }
    if (raw text_eq(h, "distinct")) { known = true; arity_ok = (n >= 2i64); }
    int64:cmp = 0i64 - 1i64;
    if (raw text_eq(h, "<"))  { known = true; cmp = raw XK_LT(); arity_ok = (n >= 2i64); }
    if (raw text_eq(h, "<=")) { known = true; cmp = raw XK_LE(); arity_ok = (n >= 2i64); }
    if (raw text_eq(h, ">"))  { known = true; cmp = raw XK_GT(); arity_ok = (n >= 2i64); }
    if (raw text_eq(h, ">=")) { known = true; cmp = raw XK_GE(); arity_ok = (n >= 2i64); }
    if (!known) { drop xm_fail(m, string_concat("an operator the models' grammar does not have: ", h)); pass (0i64 - 1i64); }
    if (!arity_ok) { drop xm_fail(m, string_concat("an application with the wrong number of arguments: ", h)); pass (0i64 - 1i64); }
    List<int64>:ops = raw list_init::<int64>(4i64);
    for (int64:i in 0i64...n) {
        int64:o = raw xp_compile(m, s, raw sx_nth(s, node, i + 1i64));
        if (!m.ok) { pass (0i64 - 1i64); }
        drop list_push(@ops, o);
    }
    if (raw text_eq(h, "not")) { pass (raw xp_push(m, raw XK_NOT(), ops.items[0i64], 0i64, 0i64)); }
    if (raw text_eq(h, "=>"))  { pass (raw xp_push(m, raw XK_IMPL(), ops.items[0i64], ops.items[1i64], 0i64)); }
    if (raw text_eq(h, "ite")) { pass (raw xp_push(m, raw XK_ITE(), ops.items[0i64], ops.items[1i64], ops.items[2i64])); }
    if (raw text_eq(h, "-")) {
        if (n == 1i64) { pass (raw xp_push(m, raw XK_NEG(), ops.items[0i64], 0i64, 0i64)); }
    }
    if (bin >= 0i64) {
        int64:acc = ops.items[0i64];
        for (int64:j in 1i64...n) { acc = raw xp_push(m, bin, acc, ops.items[j], 0i64); }
        pass acc;
    }
    if (raw text_eq(h, "=")) {
        // every operand equals the first
        int64:eq = raw xp_push(m, raw XK_EQ(), ops.items[0i64], ops.items[1i64], 0i64);
        for (int64:j2 in 2i64...n) { eq = raw xp_push(m, raw XK_AND(), eq, raw xp_push(m, raw XK_EQ(), ops.items[0i64], ops.items[j2], 0i64), 0i64); }
        pass eq;
    }
    if (raw text_eq(h, "distinct")) {
        int64:ne = 0i64 - 1i64;
        for (int64:p in 0i64...n) {
            for (int64:q in (p + 1i64)...n) {
                int64:one = raw xp_push(m, raw XK_NE(), ops.items[p], ops.items[q], 0i64);
                if (ne < 0i64) { ne = one; } else { ne = raw xp_push(m, raw XK_AND(), ne, one, 0i64); }
            }
        }
        pass ne;
    }
    // a comparison chain: every adjacent pair
    int64:ch = raw xp_push(m, cmp, ops.items[0i64], ops.items[1i64], 0i64);
    for (int64:j3 in 2i64...n) { ch = raw xp_push(m, raw XK_AND(), ch, raw xp_push(m, cmp, ops.items[j3 - 1i64], ops.items[j3], 0i64), 0i64); }
    pass ch;
};

func:xp_operand_ok = bool(XModel->:m, int64:v) never fails {
    if ((v > (raw XP_OPERAND_MAX())) || (v < (0i64 - (raw XP_OPERAND_MAX())))) { m.eval_bad = true; pass false; }
    pass true;
};

// The value of a pool expression in the state `cur` (a proposition is 0 or 1).
func:xp_eval = int64(XModel->:m, List<int64>:cur, int64:e) never fails {
    int64:k = m.ek.items[e];
    if (k == (raw XK_NUM())) { pass m.ea.items[e]; }
    if (k == (raw XK_VAR())) { pass cur.items[m.ea.items[e]]; }
    if (k == (raw XK_TRUE())) { pass 1i64; }
    if (k == (raw XK_FALSE())) { pass 0i64; }
    if (k == (raw XK_NOT())) { if ((raw xp_eval(m, cur, m.ea.items[e])) != 0i64) { pass 0i64; } pass 1i64; }
    if (k == (raw XK_AND())) {
        if ((raw xp_eval(m, cur, m.ea.items[e])) == 0i64) { pass 0i64; }
        if ((raw xp_eval(m, cur, m.eb.items[e])) == 0i64) { pass 0i64; }
        pass 1i64;
    }
    if (k == (raw XK_OR())) {
        if ((raw xp_eval(m, cur, m.ea.items[e])) != 0i64) { pass 1i64; }
        if ((raw xp_eval(m, cur, m.eb.items[e])) != 0i64) { pass 1i64; }
        pass 0i64;
    }
    if (k == (raw XK_IMPL())) {
        if ((raw xp_eval(m, cur, m.ea.items[e])) == 0i64) { pass 1i64; }
        if ((raw xp_eval(m, cur, m.eb.items[e])) != 0i64) { pass 1i64; }
        pass 0i64;
    }
    if (k == (raw XK_ITE())) {
        if ((raw xp_eval(m, cur, m.ea.items[e])) != 0i64) { pass (raw xp_eval(m, cur, m.eb.items[e])); }
        pass (raw xp_eval(m, cur, m.ec.items[e]));
    }
    int64:x = raw xp_eval(m, cur, m.ea.items[e]);
    if (k == (raw XK_NEG())) {
        if (!(raw xp_operand_ok(m, x))) { pass 0i64; }
        pass (0i64 - x);
    }
    int64:y = raw xp_eval(m, cur, m.eb.items[e]);
    if (k == (raw XK_EQ())) { if (x == y) { pass 1i64; } pass 0i64; }
    if (k == (raw XK_NE())) { if (x != y) { pass 1i64; } pass 0i64; }
    if (k == (raw XK_LT())) { if (x < y) { pass 1i64; } pass 0i64; }
    if (k == (raw XK_LE())) { if (x <= y) { pass 1i64; } pass 0i64; }
    if (k == (raw XK_GT())) { if (x > y) { pass 1i64; } pass 0i64; }
    if (k == (raw XK_GE())) { if (x >= y) { pass 1i64; } pass 0i64; }
    if (!(raw xp_operand_ok(m, x))) { pass 0i64; }
    if (!(raw xp_operand_ok(m, y))) { pass 0i64; }
    if (k == (raw XK_ADD())) { pass (x + y); }
    if (k == (raw XK_SUB())) { pass (x - y); }
    pass (x * y);
};

// A binding (VAR, pool expression) appended to the window that started at
// `wstart`, unless the window already binds VAR: the FIRST binding wins.
func:xm_bind = NIL(XModel->:m, int64:wstart, int64:vi, int64:e) never fails {
    for (int64:i in wstart...m.nvar.count) { if (m.nvar.items[i] == vi) { pass NIL; } }
    drop list_push(@m.nvar, vi);
    drop list_push(@m.nexpr, e);
    pass NIL;
};

// A kernel rule's argument: a state variable or a numeral, as a pool expression.
func:xm_kernel_arg = int64(XModel->:m, Sxs->:s, int64:node) never fails {
    string:a = raw sx_atom(s, node);
    if (a.len == 0i64) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass (0i64 - 1i64); }
    if (raw xp_is_numeral(a)) {
        if (a.len > 18i64) { drop xm_fail(m, string_concat("a numeral too large for the explicit reading: ", a)); pass (0i64 - 1i64); }
        pass (raw xp_push(m, raw XK_NUM(), raw xp_parse(a), 0i64, 0i64));
    }
    int64:vi = raw xm_var_index(m, a);
    if (vi < 0i64) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass (0i64 - 1i64); }
    pass (raw xp_push(m, raw XK_VAR(), vi, 0i64, 0i64));
};

// The forms of one step (or of one `replace` mutation) from `body` on: the
// guard's pool index (-1 for none); the bindings go to the window the caller
// opened at `wstart`. `(ir ...)` forms are the correspondence belt's.
func:xm_body = int64(XModel->:m, Sxs->:s, int64:body, int64:wstart) never fails {
    int64:gd = 0i64 - 1i64;
    int64:c = body;
    while (c >= 0i64) {
        if (!m.ok) { pass gd; }
        string:h = raw sx_head(s, c);
        if (raw text_eq(h, "ir")) { c = s.nodes.items[c].next; continue; }
        if (raw text_eq(h, "guard")) {
            int64:g = raw xp_compile(m, s, raw sx_nth(s, c, 1i64));
            if (!m.ok) { pass gd; }
            if (gd < 0i64) { gd = g; } else { gd = raw xp_push(m, raw XK_AND(), gd, g, 0i64); }
        } else { if (raw text_eq(h, "next")) {
            int64:b = s.nodes.items[c].first;
            b = s.nodes.items[b].next;
            while (b >= 0i64) {
                string:vn = raw sx_atom(s, raw sx_nth(s, b, 0i64));
                int64:vi = raw xm_var_index(m, vn);
                if (vi < 0i64) { drop xm_fail(m, string_concat("a next binding names no state variable: ", vn)); pass gd; }
                int64:e = raw xp_compile(m, s, raw sx_nth(s, b, 1i64));
                if (!m.ok) { pass gd; }
                drop xm_bind(m, wstart, vi, e);
                b = s.nodes.items[b].next;
            }
        } else { if (raw text_eq(h, "kernel")) {
            string:w = raw sx_atom(s, raw sx_nth(s, c, 1i64));
            int64:na = (raw sx_len(s, c)) - 2i64;
            List<int64>:ka = raw list_init::<int64>(4i64);
            for (int64:i in 0i64...na) {
                int64:ae = raw xm_kernel_arg(m, s, raw sx_nth(s, c, i + 2i64));
                if (!m.ok) { pass gd; }
                drop list_push(@ka, ae);
            }
            bool:done = false;
            if ((raw text_eq(w, "futex-wait")) && (na == 3i64)) {
                // PARKED := (ite (= WORD EXPECTED) 1 0); PARKED must be a variable
                if (m.ek.items[ka.items[2i64]] != (raw XK_VAR())) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass gd; }
                int64:eqw = raw xp_push(m, raw XK_EQ(), ka.items[0i64], ka.items[1i64], 0i64);
                int64:one = raw xp_push(m, raw XK_NUM(), 1i64, 0i64, 0i64);
                int64:zero = raw xp_push(m, raw XK_NUM(), 0i64, 0i64, 0i64);
                drop xm_bind(m, wstart, m.ea.items[ka.items[2i64]], raw xp_push(m, raw XK_ITE(), eqw, one, zero));
                done = true;
            }
            if (((raw text_eq(w, "futex-wake")) || (raw text_eq(w, "eventfd-read"))) && (na == 1i64)) {
                if (m.ek.items[ka.items[0i64]] != (raw XK_VAR())) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass gd; }
                drop xm_bind(m, wstart, m.ea.items[ka.items[0i64]], raw xp_push(m, raw XK_NUM(), 0i64, 0i64, 0i64));
                done = true;
            }
            if ((raw text_eq(w, "eventfd-write")) && (na == 1i64)) {
                if (m.ek.items[ka.items[0i64]] != (raw XK_VAR())) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass gd; }
                drop xm_bind(m, wstart, m.ea.items[ka.items[0i64]], raw xp_push(m, raw XK_NUM(), 1i64, 0i64, 0i64));
                done = true;
            }
            if ((raw text_eq(w, "spurious")) && (na == 1i64)) {
                if (m.ek.items[ka.items[0i64]] != (raw XK_VAR())) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass gd; }
                int64:g2 = raw xp_push(m, raw XK_EQ(), ka.items[0i64], raw xp_push(m, raw XK_NUM(), 1i64, 0i64, 0i64), 0i64);
                if (gd < 0i64) { gd = g2; } else { gd = raw xp_push(m, raw XK_AND(), gd, g2, 0i64); }
                drop xm_bind(m, wstart, m.ea.items[ka.items[0i64]], raw xp_push(m, raw XK_NUM(), 0i64, 0i64, 0i64));
                done = true;
            }
            if ((raw text_eq(w, "signal")) && (na == 2i64)) {
                if (m.ek.items[ka.items[0i64]] != (raw XK_VAR())) { drop xm_fail(m, "a kernel rule's arguments are state variables and numerals"); pass gd; }
                drop xm_bind(m, wstart, m.ea.items[ka.items[0i64]], ka.items[1i64]);
                done = true;
            }
            if (!done) { drop xm_fail(m, string_concat("a kernel rule the library does not know: ", w)); pass gd; }
        } else {
            drop xm_fail(m, string_concat("a form the models' grammar does not have inside a step: ", h));
            pass gd;
        } } }
        c = s.nodes.items[c].next;
    }
    pass gd;
};

// `init`'s pins: every `(= VAR NUMERAL)` conjunct of a top-level `and`, the first pin of a variable winning.
func:xm_pins = NIL(XModel->:m, Sxs->:s, int64:node) never fails {
    for (int64:i in 0i64...m.vars.count) { drop list_push(@m.pin, 0i64); drop list_push(@m.pin_val, 0i64); }
    if (!(raw sx_is_list(s, node))) { pass NIL; }
    if (!(raw text_eq(raw sx_head(s, node), "and"))) { pass NIL; }
    int64:c = s.nodes.items[node].first;
    c = s.nodes.items[c].next;
    while (c >= 0i64) {
        if ((raw sx_is_list(s, c)) && ((raw sx_len(s, c)) == 3i64) && (raw text_eq(raw sx_head(s, c), "="))) {
            string:vn = raw sx_atom(s, raw sx_nth(s, c, 1i64));
            string:nv = raw sx_atom(s, raw sx_nth(s, c, 2i64));
            int64:vi = raw xm_var_index(m, vn);
            if ((vi >= 0i64) && (raw xp_is_numeral(nv)) && (nv.len <= 18i64)) {
                if (m.pin.items[vi] == 0i64) { m.pin.items[vi] = 1i64; m.pin_val.items[vi] = raw xp_parse(nv); }
            }
        }
        c = s.nodes.items[c].next;
    }
    pass NIL;
};

// One model text as the explicit reading sees it.
pub func:xm_read = XModel(string:text) never fails {
    XModel:m = raw xm_new();
    Sxs:s = raw sx_parse(text);
    if (!s.ok) { drop xm_fail(@m, "a model file is one (model NAME ...) form"); pass m; }
    if (s.roots.count != 1i64) { drop xm_fail(@m, "a model file is one (model NAME ...) form"); pass m; }
    int64:r = s.roots.items[0i64];
    if (!(raw sx_is_list(@s, r)) || !(raw text_eq(raw sx_head(@s, r), "model")) || ((raw sx_len(@s, r)) < 3i64)) {
        drop xm_fail(@m, "a model file is one (model NAME ...) form"); pass m;
    }
    int64:c0 = s.nodes.items[r].first;
    c0 = s.nodes.items[c0].next;
    c0 = s.nodes.items[c0].next;
    // pass 1: the state
    int64:c = c0;
    while (c >= 0i64) {
        if ((raw sx_is_list(@s, c)) && (raw text_eq(raw sx_head(@s, c), "state"))) {
            int64:v = s.nodes.items[c].first;
            v = s.nodes.items[v].next;
            while (v >= 0i64) {
                string:vn = raw sx_atom(@s, raw sx_nth(@s, v, 0i64));
                string:lo = raw sx_atom(@s, raw sx_nth(@s, v, 1i64));
                string:hi = raw sx_atom(@s, raw sx_nth(@s, v, 2i64));
                if ((vn.len == 0i64) || !(raw xp_is_numeral(lo)) || !(raw xp_is_numeral(hi)) || (lo.len > 18i64) || (hi.len > 18i64)) {
                    drop xm_fail(@m, "a state variable is (NAME LO HI) with numeral bounds"); pass m;
                }
                drop strlist_push(@m.vars, vn);
                drop list_push(@m.lo, raw xp_parse(lo));
                drop list_push(@m.hi, raw xp_parse(hi));
                v = s.nodes.items[v].next;
            }
        }
        c = s.nodes.items[c].next;
    }
    // pass 2: everything else, in file order
    c = c0;
    while (c >= 0i64) {
        if (!m.ok) { pass m; }
        string:h = raw sx_head(@s, c);
        if ((raw text_eq(h, "of")) || (raw text_eq(h, "state"))) { c = s.nodes.items[c].next; continue; }
        if (raw text_eq(h, "init")) {
            m.init_e = raw xp_compile(@m, @s, raw sx_nth(@s, c, 1i64));
            if (!m.ok) { pass m; }
            drop xm_pins(@m, @s, raw sx_nth(@s, c, 1i64));
        } else { if (raw text_eq(h, "thread")) {
            int64:ti = m.threads.count;
            drop strlist_push(@m.threads, raw sx_atom(@s, raw sx_nth(@s, c, 1i64)));
            int64:sc = s.nodes.items[c].first;
            sc = s.nodes.items[sc].next;
            sc = s.nodes.items[sc].next;
            while (sc >= 0i64) {
                int64:body = s.nodes.items[sc].first;
                body = s.nodes.items[body].next;
                body = s.nodes.items[body].next;
                int64:wstart = m.nvar.count;
                int64:gd = raw xm_body(@m, @s, body, wstart);
                if (!m.ok) { pass m; }
                drop list_push(@m.s_thr, ti);
                drop strlist_push(@m.s_name, raw sx_atom(@s, raw sx_nth(@s, sc, 1i64)));
                drop list_push(@m.s_guard, gd);
                drop list_push(@m.s_nstart, wstart);
                drop list_push(@m.s_ncount, m.nvar.count - wstart);
                sc = s.nodes.items[sc].next;
            }
        } else { if (raw text_eq(h, "bad")) {
            int64:be = raw xp_compile(@m, @s, raw sx_nth(@s, c, 2i64));
            if (!m.ok) { pass m; }
            drop strlist_push(@m.b_name, raw sx_atom(@s, raw sx_nth(@s, c, 1i64)));
            drop list_push(@m.b_expr, be);
        } else { if ((raw text_eq(h, "depth")) || (raw text_eq(h, "preempt"))) {
            string:nt = raw sx_atom(@s, raw sx_nth(@s, c, 1i64));
            if (!(raw xp_is_numeral(nt)) || (nt.len > 18i64)) { drop xm_fail(@m, "a model needs (state ...), (init ...), (depth K) and (preempt D)"); pass m; }
            if (raw text_eq(h, "depth")) { m.depth = raw xp_parse(nt); } else { m.preempt = raw xp_parse(nt); }
        } else { if (raw text_eq(h, "control")) {
            int64:mstart = m.m_kind.count;
            int64:mu = raw sx_nth(@s, c, 3i64);
            while (mu >= 0i64) {
                string:mk = raw sx_head(@s, mu);
                if (raw text_eq(mk, "replace")) {
                    int64:mbody = s.nodes.items[mu].first;
                    mbody = s.nodes.items[mbody].next;
                    mbody = s.nodes.items[mbody].next;
                    mbody = s.nodes.items[mbody].next;
                    int64:mw = m.nvar.count;
                    int64:mg = raw xm_body(@m, @s, mbody, mw);
                    if (!m.ok) { pass m; }
                    drop list_push(@m.m_kind, 0i64);
                    drop strlist_push(@m.m_thr, raw sx_atom(@s, raw sx_nth(@s, mu, 1i64)));
                    drop strlist_push(@m.m_step, raw sx_atom(@s, raw sx_nth(@s, mu, 2i64)));
                    drop list_push(@m.m_guard, mg);
                    drop list_push(@m.m_nstart, mw);
                    drop list_push(@m.m_ncount, m.nvar.count - mw);
                } else { if (raw text_eq(mk, "remove")) {
                    drop list_push(@m.m_kind, 1i64);
                    drop strlist_push(@m.m_thr, raw sx_atom(@s, raw sx_nth(@s, mu, 1i64)));
                    drop strlist_push(@m.m_step, raw sx_atom(@s, raw sx_nth(@s, mu, 2i64)));
                    drop list_push(@m.m_guard, 0i64 - 1i64);
                    drop list_push(@m.m_nstart, 0i64);
                    drop list_push(@m.m_ncount, 0i64);
                } else {
                    drop xm_fail(@m, string_concat("a mutation the models' grammar does not have: ", mk)); pass m;
                } }
                mu = s.nodes.items[mu].next;
            }
            drop strlist_push(@m.c_name, raw sx_atom(@s, raw sx_nth(@s, c, 1i64)));
            drop strlist_push(@m.c_bad, raw sx_atom(@s, raw sx_nth(@s, c, 2i64)));
            drop list_push(@m.c_mstart, mstart);
            drop list_push(@m.c_mcount, m.m_kind.count - mstart);
        } else {
            drop xm_fail(@m, string_concat("a form the models' grammar does not have: ", h)); pass m;
        } } } } }
        c = s.nodes.items[c].next;
    }
    if ((m.init_e < 0i64) || (m.depth < 0i64) || (m.preempt < 0i64) || (m.vars.count == 0i64)) {
        drop xm_fail(@m, "a model needs (state ...), (init ...), (depth K) and (preempt D)");
    }
    pass m;
};

// --- the search --------------------------------------------------------------------------

// One run's answers: the states in discovery order (their keys), each one's
// least depth, its least thread changes with no step bound, whether the
// model's (K, D) reaches it; and per BASE step the first variable (declaration
// order) the step can take out of its range from a reachable state, or -1.
pub struct:XRun = {
    List<int64>:keys;
    List<int64>:dist;
    List<int64>:minsw;
    List<int64>:inside;
    List<int64>:blocked;
};

// The effective steps under a control (-1: the model itself), as parallel lists.
struct:XSteps = {
    List<int64>:thr;
    List<int64>:guard;
    List<int64>:nstart;
    List<int64>:ncount;
    List<int64>:base;      // the base step a row came from (the blocked report's key)
};

func:xp_steps_under = XSteps(XModel->:m, int64:ctl) never fails {
    XSteps:o = XSteps{ thr: raw list_init::<int64>(16i64), guard: raw list_init::<int64>(16i64), nstart: raw list_init::<int64>(16i64),
                       ncount: raw list_init::<int64>(16i64), base: raw list_init::<int64>(16i64) };
    for (int64:si in 0i64...m.s_thr.count) {
        bool:hit = false;
        if (ctl >= 0i64) {
            int64:ms = m.c_mstart.items[ctl];
            for (int64:k in 0i64...m.c_mcount.items[ctl]) {
                int64:mi = ms + k;
                int64:mt = raw xm_thread_index(m, raw strlist_view(m.m_thr, mi));
                if ((mt == m.s_thr.items[si]) && (raw text_eq(raw strlist_view(m.m_step, mi), raw strlist_view(m.s_name, si)))) {
                    hit = true;
                    if (m.m_kind.items[mi] == 0i64) {
                        drop list_push(@o.thr, m.s_thr.items[si]);
                        drop list_push(@o.guard, m.m_guard.items[mi]);
                        drop list_push(@o.nstart, m.m_nstart.items[mi]);
                        drop list_push(@o.ncount, m.m_ncount.items[mi]);
                        drop list_push(@o.base, si);
                    }
                }
            }
        }
        if (!hit) {
            drop list_push(@o.thr, m.s_thr.items[si]);
            drop list_push(@o.guard, m.s_guard.items[si]);
            drop list_push(@o.nstart, m.s_nstart.items[si]);
            drop list_push(@o.ncount, m.s_ncount.items[si]);
            drop list_push(@o.base, si);
        }
    }
    pass o;
};

// The visited set: an open-addressed table of state indices keyed by the
// states' mixed-radix keys (`keys` is the run's list). -1 is an empty slot.
struct:XTable = {
    List<int64>:slots;
    int64:mask;
};

func:xt_new = XTable(int64:cap) never fails {
    XTable:t = XTable{ slots: raw list_init::<int64>(cap), mask: cap - 1i64 };
    for (int64:i in 0i64...cap) { drop list_push(@t.slots, 0i64 - 1i64); }
    pass t;
};

// The index of `key`, or -1.
func:xt_find = int64(XTable->:t, List<int64>:keys, int64:key) never fails {
    int64:h = key & t.mask;
    while (true) {
        int64:v = t.slots.items[h];
        if (v < 0i64) { pass (0i64 - 1i64); }
        if (keys.items[v] == key) { pass v; }
        h = (h + 1i64) & t.mask;
    }
    pass (0i64 - 1i64);
};

func:xt_put = NIL(XTable->:t, int64:key, int64:idx) never fails {
    int64:h = key & t.mask;
    while (t.slots.items[h] >= 0i64) { h = (h + 1i64) & t.mask; }
    t.slots.items[h] = idx;
    pass NIL;
};

// The table doubled and every state re-placed (called at half load).
func:xt_grown = XTable(XTable->:t, List<int64>:keys) never fails {
    XTable:n = raw xt_new((t.mask + 1i64) * 2i64);
    for (int64:i in 0i64...keys.count) { drop xt_put(@n, keys.items[i], i); }
    pass n;
};

func:xp_decode = NIL(XModel->:m, List<int64>:strides, int64:key, List<int64>->:cur) never fails {
    int64:rest = key;
    // most significant variable first: the last declared
    int64:i = m.vars.count - 1i64;
    while (i >= 0i64) {
        int64:d = rest / strides.items[i];
        rest = rest - (d * strides.items[i]);
        cur.items[i] = d + m.lo.items[i];
        i = i - 1i64;
    }
    pass NIL;
};

// A run of the model under a control (-1: the model itself). `m.too_large` or
// `m.eval_bad` set means the run is no answer.
pub func:xp_run = XRun(XModel->:m, int64:ctl) never fails {
    XRun:run = XRun{ keys: raw list_init::<int64>(256i64), dist: raw list_init::<int64>(256i64), minsw: raw list_init::<int64>(256i64),
                     inside: raw list_init::<int64>(256i64), blocked: raw list_init::<int64>(16i64) };
    for (int64:bi in 0i64...m.s_thr.count) { drop list_push(@run.blocked, 0i64 - 1i64); }
    int64:nv = m.vars.count;
    int64:nt = m.threads.count;
    // the strides, and the product's fit
    List<int64>:strides = raw list_init::<int64>(nv);
    int64:prod = 1i64;
    for (int64:i in 0i64...nv) {
        drop list_push(@strides, prod);
        int64:radix = (m.hi.items[i] - m.lo.items[i]) + 1i64;
        if (radix < 1i64) { m.too_large = true; pass run; }
        if (prod > (4611686018427387904i64 / radix)) { m.too_large = true; pass run; }
        prod = prod * radix;
    }
    XSteps:steps = raw xp_steps_under(m, ctl);
    XTable:seen = raw xt_new(1024i64);
    List<int64>:cur = raw list_init::<int64>(nv);
    List<int64>:nxt = raw list_init::<int64>(nv);
    for (int64:i2 in 0i64...nv) { drop list_push(@cur, 0i64); drop list_push(@nxt, 0i64); }
    // the initial states: the free variables enumerated in declaration order, filtered by `init`
    int64:combos = 1i64;
    for (int64:i3 in 0i64...nv) {
        if (m.pin.items[i3] == 0i64) {
            combos = combos * ((m.hi.items[i3] - m.lo.items[i3]) + 1i64);
            if (combos > (raw XP_STATE_CAP())) { m.too_large = true; pass run; }
        }
    }
    int64:ninit = 0i64;
    for (int64:ci in 0i64...combos) {
        int64:rest = ci;
        // the LAST free variable varies fastest, as nested loops in declaration order do
        int64:j = nv - 1i64;
        while (j >= 0i64) {
            if (m.pin.items[j] != 0i64) { cur.items[j] = m.pin_val.items[j]; }
            else {
                int64:radix2 = (m.hi.items[j] - m.lo.items[j]) + 1i64;
                int64:q = rest / radix2;
                cur.items[j] = (rest - (q * radix2)) + m.lo.items[j];
                rest = q;
            }
            j = j - 1i64;
        }
        bool:in_range = true;
        for (int64:i4 in 0i64...nv) { if ((cur.items[i4] < m.lo.items[i4]) || (cur.items[i4] > m.hi.items[i4])) { in_range = false; } }
        if (!in_range) { continue; }
        if ((raw xp_eval(m, cur, m.init_e)) == 0i64) { continue; }
        int64:key = 0i64;
        for (int64:i5 in 0i64...nv) { key = key + ((cur.items[i5] - m.lo.items[i5]) * strides.items[i5]); }
        if ((raw xt_find(@seen, run.keys, key)) >= 0i64) { continue; }
        drop list_push(@run.keys, key);
        drop list_push(@run.dist, 0i64);
        drop xt_put(@seen, key, run.keys.count - 1i64);
        ninit = ninit + 1i64;
    }
    // breadth-first, recording every edge (thread, successor index) once per state
    List<int64>:adj_start = raw list_init::<int64>(256i64);
    List<int64>:adj_thr = raw list_init::<int64>(1024i64);
    List<int64>:adj_to = raw list_init::<int64>(1024i64);
    int64:head = 0i64;
    while (head < run.keys.count) {
        drop xp_decode(m, strides, run.keys.items[head], @cur);
        drop list_push(@adj_start, adj_thr.count);
        for (int64:si in 0i64...steps.thr.count) {
            int64:g = steps.guard.items[si];
            if (g >= 0i64) { if ((raw xp_eval(m, cur, g)) == 0i64) { continue; } }
            for (int64:i6 in 0i64...nv) { nxt.items[i6] = cur.items[i6]; }
            int64:ws = steps.nstart.items[si];
            for (int64:b in 0i64...steps.ncount.items[si]) {
                nxt.items[m.nvar.items[ws + b]] = raw xp_eval(m, cur, m.nexpr.items[ws + b]);
            }
            int64:out = 0i64 - 1i64;
            for (int64:i7 in 0i64...nv) {
                if ((out < 0i64) && ((nxt.items[i7] < m.lo.items[i7]) || (nxt.items[i7] > m.hi.items[i7]))) { out = i7; }
            }
            if (out >= 0i64) {
                int64:bs = steps.base.items[si];
                if ((run.blocked.items[bs] < 0i64) || (out < run.blocked.items[bs])) { run.blocked.items[bs] = out; }
                continue;
            }
            int64:nkey = 0i64;
            for (int64:i8 in 0i64...nv) { nkey = nkey + ((nxt.items[i8] - m.lo.items[i8]) * strides.items[i8]); }
            int64:ni = raw xt_find(@seen, run.keys, nkey);
            if (ni < 0i64) {
                if (run.keys.count >= (raw XP_STATE_CAP())) { m.too_large = true; pass run; }
                drop list_push(@run.keys, nkey);
                drop list_push(@run.dist, run.dist.items[head] + 1i64);
                ni = run.keys.count - 1i64;
                if ((run.keys.count * 2i64) > (seen.mask + 1i64)) { seen = raw xt_grown(@seen, run.keys); }
                else { drop xt_put(@seen, nkey, ni); }
            }
            drop list_push(@adj_thr, steps.thr.items[si]);
            drop list_push(@adj_to, ni);
        }
        head = head + 1i64;
    }
    drop list_push(@adj_start, adj_thr.count);
    int64:ns = run.keys.count;
    if (m.eval_bad) { pass run; }
    // least thread changes with no step bound: relax to a fixpoint over (state, last thread)
    List<int64>:sw = raw list_init::<int64>((ns * nt) + 1i64);
    for (int64:i9 in 0i64...(ns * nt)) { drop list_push(@sw, raw XP_INF()); }
    for (int64:s0 in 0i64...ninit) {
        for (int64:e0 in adj_start.items[s0]...adj_start.items[s0 + 1i64]) { sw.items[(adj_to.items[e0] * nt) + adj_thr.items[e0]] = 0i64; }
    }
    bool:changed = true;
    while (changed) {
        changed = false;
        for (int64:s1 in 0i64...ns) {
            for (int64:t1 in 0i64...nt) {
                int64:c1 = sw.items[(s1 * nt) + t1];
                if (c1 >= (raw XP_INF())) { continue; }
                for (int64:e1 in adj_start.items[s1]...adj_start.items[s1 + 1i64]) {
                    int64:nc = c1;
                    if (adj_thr.items[e1] != t1) { nc = c1 + 1i64; }
                    int64:slot = (adj_to.items[e1] * nt) + adj_thr.items[e1];
                    if (nc < sw.items[slot]) { sw.items[slot] = nc; changed = true; }
                }
            }
        }
    }
    for (int64:s2 in 0i64...ns) {
        int64:best = raw XP_INF();
        for (int64:t2 in 0i64...nt) { if (sw.items[(s2 * nt) + t2] < best) { best = sw.items[(s2 * nt) + t2]; } }
        if (s2 < ninit) { best = 0i64; }
        drop list_push(@run.minsw, best);
    }
    // within (K, D): the least changes over paths of at most K steps, layer by layer
    List<int64>:lay = raw list_init::<int64>((ns * nt) + 1i64);
    List<int64>:nlay = raw list_init::<int64>((ns * nt) + 1i64);
    List<int64>:bestk = raw list_init::<int64>((ns * nt) + 1i64);
    for (int64:i10 in 0i64...(ns * nt)) { drop list_push(@lay, raw XP_INF()); drop list_push(@nlay, raw XP_INF()); drop list_push(@bestk, raw XP_INF()); }
    if (m.depth >= 1i64) {
        for (int64:s3 in 0i64...ninit) {
            for (int64:e3 in adj_start.items[s3]...adj_start.items[s3 + 1i64]) {
                int64:sl3 = (adj_to.items[e3] * nt) + adj_thr.items[e3];
                lay.items[sl3] = 0i64;
                bestk.items[sl3] = 0i64;
            }
        }
    }
    // (an inverted inclusive range is not asked of the language: K < 2 has no second layer)
    int64:klast = m.depth;
    if (klast < 2i64) { klast = 1i64; }
    for (int64:kk in 2i64...(klast + 1i64)) {
        for (int64:i11 in 0i64...(ns * nt)) { nlay.items[i11] = raw XP_INF(); }
        for (int64:s4 in 0i64...ns) {
            for (int64:t4 in 0i64...nt) {
                int64:c4 = lay.items[(s4 * nt) + t4];
                if (c4 >= (raw XP_INF())) { continue; }
                for (int64:e4 in adj_start.items[s4]...adj_start.items[s4 + 1i64]) {
                    int64:nc4 = c4;
                    if (adj_thr.items[e4] != t4) { nc4 = c4 + 1i64; }
                    int64:sl4 = (adj_to.items[e4] * nt) + adj_thr.items[e4];
                    if (nc4 < nlay.items[sl4]) { nlay.items[sl4] = nc4; }
                }
            }
        }
        for (int64:i12 in 0i64...(ns * nt)) {
            lay.items[i12] = nlay.items[i12];
            if (nlay.items[i12] < bestk.items[i12]) { bestk.items[i12] = nlay.items[i12]; }
        }
    }
    for (int64:s5 in 0i64...ns) {
        int64:isin = 0i64;
        if (s5 < ninit) { isin = 1i64; }
        for (int64:t5 in 0i64...nt) { if (bestk.items[(s5 * nt) + t5] <= m.preempt) { isin = 1i64; } }
        drop list_push(@run.inside, isin);
    }
    pass run;
};

// --- the findings, the Python twin's texts byte for byte --------------------------------

func:xp_head = string(string:mname) never fails {
    pass (string_concat(string_concat("floor: runtime/models/", mname), ": "));
};

func:xp_kd = string(XModel->:m) never fails {
    string:o = string_concat("(K ", int_to_string(m.depth));
    o = string_concat(o, ", D ");
    o = string_concat(o, int_to_string(m.preempt));
    pass (string_concat(o, ")"));
};

// The states of `run` where the pool proposition `e` holds: (any, least depth, least changes, any inside).
struct:XHits = {
    bool:found;
    int64:depth;
    int64:changes;
    bool:inside;
};

func:xp_hits = XHits(XModel->:m, XRun->:run, int64:e) never fails {
    XHits:h = XHits{ found: false, depth: raw XP_INF(), changes: raw XP_INF(), inside: false };
    int64:nv = m.vars.count;
    List<int64>:strides = raw list_init::<int64>(nv);
    int64:prod = 1i64;
    for (int64:i in 0i64...nv) { drop list_push(@strides, prod); prod = prod * ((m.hi.items[i] - m.lo.items[i]) + 1i64); }
    List<int64>:cur = raw list_init::<int64>(nv);
    for (int64:i2 in 0i64...nv) { drop list_push(@cur, 0i64); }
    for (int64:s in 0i64...run.keys.count) {
        drop xp_decode(m, strides, run.keys.items[s], @cur);
        if ((raw xp_eval(m, cur, e)) == 0i64) { continue; }
        h.found = true;
        if (run.dist.items[s] < h.depth) { h.depth = run.dist.items[s]; }
        if (run.minsw.items[s] < h.changes) { h.changes = run.minsw.items[s]; }
        if (run.inside.items[s] != 0i64) { h.inside = true; }
    }
    pass h;
};

func:xp_unreadable = List<string>(string:mname, string:why) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    string:w = string_concat(raw xp_head(mname), "floor-model-unreadable: ");
    drop strlist_push(@fl, string_concat(w, why));
    pass fl;
};

func:xp_too_large = List<string>(string:mname) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    string:w = string_concat(raw xp_head(mname), "floor-model-too-large: more than ");
    w = string_concat(w, int_to_string(raw XP_STATE_CAP()));
    drop strlist_push(@fl, string_concat(w, " states -- the explicit reading refuses a model it cannot finish, and never skips one (D-295)"));
    pass fl;
};

// One model's explicit reading: its findings, by name.
pub func:floor_explore_model = List<string>(string:mname, string:text) never fails {
    XModel:m = raw xm_read(text);
    if (!m.ok) { pass (raw xp_unreadable(mname, m.why)); }
    XRun:base = raw xp_run(@m, 0i64 - 1i64);
    if (m.too_large) { pass (raw xp_too_large(mname)); }
    if (m.eval_bad) { pass (raw xp_unreadable(mname, "an expression's value leaves the range the explicit reading computes in")); }
    List<string>:fl = raw list_init::<string>(4i64);
    string:head = raw xp_head(mname);
    for (int64:si in 0i64...m.s_thr.count) {
        if (base.blocked.items[si] < 0i64) { continue; }
        string:w = string_concat(head, "floor-model-range-blocks: step `");
        w = string_concat(w, raw strlist_view(m.threads, m.s_thr.items[si]));
        w = string_concat(w, ".");
        w = string_concat(w, raw strlist_view(m.s_name, si));
        w = string_concat(w, "` can take `");
        w = string_concat(w, raw strlist_view(m.vars, base.blocked.items[si]));
        drop strlist_push(@fl, string_concat(w, "` out of its range from a reachable state -- the unrolling drops that transition silently"));
    }
    for (int64:bi in 0i64...m.b_name.count) {
        XHits:h = raw xp_hits(@m, @base, m.b_expr.items[bi]);
        if (m.eval_bad) { pass (raw xp_unreadable(mname, "an expression's value leaves the range the explicit reading computes in")); }
        if (!h.found) { continue; }
        string:w2 = string_concat(head, "floor-model-bad-reachable: `");
        w2 = string_concat(w2, raw strlist_view(m.b_name, bi));
        w2 = string_concat(w2, "` is reachable -- least depth ");
        w2 = string_concat(w2, int_to_string(h.depth));
        w2 = string_concat(w2, ", least thread changes ");
        w2 = string_concat(w2, int_to_string(h.changes));
        if (h.inside) {
            w2 = string_concat(w2, ", INSIDE the model's bounds ");
            w2 = string_concat(w2, raw xp_kd(@m));
            w2 = string_concat(w2, ": a discharged row says the opposite, so one of the two readings is wrong");
        } else {
            w2 = string_concat(w2, ", outside the model's bounds ");
            w2 = string_concat(w2, raw xp_kd(@m));
            w2 = string_concat(w2, ": the bounded rows cannot see it");
        }
        drop strlist_push(@fl, w2);
    }
    for (int64:ci in 0i64...m.c_name.count) {
        int64:be = 0i64 - 1i64;
        for (int64:bj in 0i64...m.b_name.count) {
            if ((be < 0i64) && (raw text_eq(raw strlist_view(m.b_name, bj), raw strlist_view(m.c_bad, ci)))) { be = m.b_expr.items[bj]; }
        }
        if (be < 0i64) {
            string:w3 = string_concat(head, "floor-model-unreadable: a control names no bad predicate: ");
            drop strlist_push(@fl, string_concat(w3, raw strlist_view(m.c_name, ci)));
            continue;
        }
        XRun:cr = raw xp_run(@m, ci);
        if (m.too_large) { pass (raw xp_too_large(mname)); }
        XHits:ch = raw xp_hits(@m, @cr, be);
        if (m.eval_bad) { pass (raw xp_unreadable(mname, "an expression's value leaves the range the explicit reading computes in")); }
        if (ch.found && ch.inside) { continue; }
        string:w4 = string_concat(head, "floor-model-control-unreachable: control `");
        w4 = string_concat(w4, raw strlist_view(m.c_name, ci));
        w4 = string_concat(w4, "` does not reach `");
        w4 = string_concat(w4, raw strlist_view(m.c_bad, ci));
        w4 = string_concat(w4, "` inside the bounds ");
        w4 = string_concat(w4, raw xp_kd(@m));
        if (!ch.found) { w4 = string_concat(w4, " -- it is reachable nowhere"); }
        else {
            w4 = string_concat(w4, " -- it needs depth ");
            w4 = string_concat(w4, int_to_string(ch.depth));
            w4 = string_concat(w4, " and ");
            w4 = string_concat(w4, int_to_string(ch.changes));
            w4 = string_concat(w4, " thread change(s)");
        }
        drop strlist_push(@fl, string_concat(w4, "; the solver's `sat` says the opposite, so one of the two readings is wrong"));
    }
    pass fl;
};

// TCB.md's generated sentence: one model's "(K k, D d; N states, M inside)", or "" when it cannot be read.
pub func:xp_facts = string(string:text) never fails {
    XModel:m = raw xm_read(text);
    if (!m.ok) { pass ""; }
    XRun:run = raw xp_run(@m, 0i64 - 1i64);
    if (m.too_large || m.eval_bad) { pass ""; }
    int64:inside = 0i64;
    for (int64:s in 0i64...run.keys.count) { if (run.inside.items[s] != 0i64) { inside = inside + 1i64; } }
    string:o = string_concat("(K ", int_to_string(m.depth));
    o = string_concat(o, ", D ");
    o = string_concat(o, int_to_string(m.preempt));
    o = string_concat(o, "; ");
    o = string_concat(o, int_to_string(run.keys.count));
    o = string_concat(o, " states, ");
    o = string_concat(o, int_to_string(inside));
    pass (string_concat(o, " inside)"));
};

// The model files under `runtime/models/`, sorted by name: names (without `.model`) and texts.
pub struct:XTexts = {
    List<string>:names;
    List<string>:texts;
};

pub func:xp_model_texts = XTexts(string:root) never fails {
    XTexts:o = XTexts{ names: raw list_init::<string>(8i64), texts: raw list_init::<string>(8i64) };
    string:dir = raw path_join(root, "runtime/models");
    List<string>:files = raw model_names(dir);
    for (int64:i in 0i64...files.count) {
        string:n = raw strlist_view(files, i);
        string:full = raw path_join(dir, n);
        Result<cstring>:pc = to_cstring(full);
        if (pc.is_error) { continue; }
        Result<string>:t = read_file(pc.value);
        if (t.is_error) { continue; }
        string:bare = raw text_slice(n, 0i64, n.len - 6i64);      // without ".model"
        drop strlist_push(@o.names, bare);
        drop strlist_push(@o.texts, t.value);
    }
    pass o;
};

// THE MODELS' SECOND READING over a tree: every model's findings, in name order.
pub func:floor_models_explicit = List<string>(string:root) never fails {
    List<string>:fl = raw list_init::<string>(4i64);
    XTexts:mt = raw xp_model_texts(root);
    for (int64:i in 0i64...mt.names.count) {
        List<string>:one = raw floor_explore_model(raw strlist_view(mt.names, i), raw strlist_view(mt.texts, i));
        for (int64:k in 0i64...one.count) { drop strlist_push(@fl, raw strlist_view(one, k)); }
    }
    pass fl;
};
