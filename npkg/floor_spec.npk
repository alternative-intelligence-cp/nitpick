// floor_spec -- the S-expression reader `runtime/npkrt.spec` is read with
// (1.5.6 step 0; D-288). SMT-LIB2 syntax: lists, atoms, "strings", `;`
// comments. The tree is FLAT (the AST's shape): one node list, each node
// its kind, its text, its first child and its next sibling, so a recursive
// walk is an index walk. The Python twin is `bootstrap/harness/floor.py`'s
// `sexpr`.

mod:floor_spec;

use "./text.npk".*;

pub struct:SxNode = {
    int32:kind;        // 0 atom, 1 string, 2 list
    string:text;       // the atom's or string's text; "" for a list
    int64:first;       // a list's first child, or -1
    int64:next;        // the next sibling, or -1
};

pub struct:Sxs = {
    List<SxNode>:nodes;
    List<int64>:roots;     // the top-level forms, in order
    bool:ok;
    string:problem;
};

pub func:SX_ATOM = int32() never fails { pass 0i32; };
pub func:SX_STRING = int32() never fails { pass 1i32; };
pub func:SX_LIST = int32() never fails { pass 2i32; };

func:is_delim = bool(uint8:c) never fails {
    if (c == 40u8) { pass true; }   // (
    if (c == 41u8) { pass true; }   // )
    if (c == 34u8) { pass true; }   // "
    if (c == 59u8) { pass true; }   // ;
    if (raw text_is_ws(c)) { pass true; }
    pass false;
};

// Append a node; returns its index.
func:push_node = int64(Sxs->:s, int32:kind, move string:text) never fails {
    SxNode:n = SxNode{ kind: kind, text: move(text), first: 0i64 - 1i64, next: 0i64 - 1i64 };
    drop list_push(@s.nodes, move(n));
    pass (s.nodes.count - 1i64);
};

// Link `child` as the last child of `parent` (or as a root when parent < 0),
// through `last`, the previous sibling at that level (or -1).
func:link = NIL(Sxs->:s, int64:parent, int64:last, int64:child) never fails {
    if (last >= 0i64) { s.nodes.items[last].next = child; }
    else { if (parent >= 0i64) { s.nodes.items[parent].first = child; } }
    // EVERY top-level form is a root (1.5.6 step 3): until this fix only the
    // first was listed and the rest hung off its `next`, which the step-0
    // belt never noticed because it asked for the one section that existed
    if (parent < 0i64) { drop list_push(@s.roots, child); }
    pass NIL;
};

pub func:sx_parse = Sxs(string:text) never fails {
    Sxs:s = Sxs{ nodes: raw list_init::<SxNode>(256i64), roots: raw list_init::<int64>(8i64), ok: true, problem: "" };
    // an explicit stack of open lists: the list node and its last child so far
    List<int64>:open_list = raw list_init::<int64>(16i64);
    List<int64>:open_last = raw list_init::<int64>(16i64);
    int64:root_last = 0i64 - 1i64;
    int64:i = 0i64;
    int64:line = 1i64;
    while (i < text.len) {
        uint8:c = text.ptr[i];
        if (c == 10u8) { line = line + 1i64; i = i + 1i64; continue; }
        if (raw text_is_ws(c)) { i = i + 1i64; continue; }
        if (c == 59u8) {
            while ((i < text.len) && (text.ptr[i] != 10u8)) { i = i + 1i64; }
            continue;
        }
        int64:parent = 0i64 - 1i64;
        int64:last = root_last;
        if (open_list.count > 0i64) {
            parent = open_list.items[open_list.count - 1i64];
            last = open_last.items[open_last.count - 1i64];
        }
        if (c == 40u8) {
            string:empty = "";
            int64:nd = raw push_node(@s, raw SX_LIST(), move(empty));
            drop link(@s, parent, last, nd);
            if (open_list.count > 0i64) { open_last.items[open_last.count - 1i64] = nd; } else { root_last = nd; }
            drop list_push(@open_list, nd);
            drop list_push(@open_last, 0i64 - 1i64);
            i = i + 1i64;
            continue;
        }
        if (c == 41u8) {
            if (open_list.count == 0i64) {
                s.ok = false;
                s.problem = string_concat("unbalanced `)` at line ", int_to_string(line));
                pass s;
            }
            open_list.count = open_list.count - 1i64;
            open_last.count = open_last.count - 1i64;
            i = i + 1i64;
            continue;
        }
        if (c == 34u8) {
            int64:j = i + 1i64;
            while ((j < text.len) && (text.ptr[j] != 34u8)) { j = j + 1i64; }
            if (j >= text.len) {
                s.ok = false;
                s.problem = string_concat("an unterminated string at line ", int_to_string(line));
                pass s;
            }
            string:st = raw text_slice(text, i + 1i64, j);
            int64:nd2 = raw push_node(@s, raw SX_STRING(), move(st));
            drop link(@s, parent, last, nd2);
            if (open_list.count > 0i64) { open_last.items[open_last.count - 1i64] = nd2; } else { root_last = nd2; }
            i = j + 1i64;
            continue;
        }
        int64:k = i;
        while ((k < text.len) && (!(raw is_delim(text.ptr[k])))) { k = k + 1i64; }
        string:at = raw text_slice(text, i, k);
        int64:nd3 = raw push_node(@s, raw SX_ATOM(), move(at));
        drop link(@s, parent, last, nd3);
        if (open_list.count > 0i64) { open_last.items[open_last.count - 1i64] = nd3; } else { root_last = nd3; }
        i = k;
    }
    if (open_list.count > 0i64) {
        s.ok = false;
        s.problem = "an unclosed `(` at the end of the file";
    }
    pass s;
};

// The k-th item of a list node (0-based), or -1.
pub func:sx_nth = int64(Sxs->:s, int64:list_node, int64:k) never fails {
    if (list_node < 0i64) { pass (0i64 - 1i64); }
    if (s.nodes.items[list_node].kind != (raw SX_LIST())) { pass (0i64 - 1i64); }
    int64:c = s.nodes.items[list_node].first;
    int64:n = 0i64;
    while (c >= 0i64) {
        if (n == k) { pass c; }
        n = n + 1i64;
        c = s.nodes.items[c].next;
    }
    pass (0i64 - 1i64);
};

pub func:sx_len = int64(Sxs->:s, int64:list_node) never fails {
    if (list_node < 0i64) { pass 0i64; }
    if (s.nodes.items[list_node].kind != (raw SX_LIST())) { pass 0i64; }
    int64:c = s.nodes.items[list_node].first;
    int64:n = 0i64;
    while (c >= 0i64) { n = n + 1i64; c = s.nodes.items[c].next; }
    pass n;
};

// The text of an ATOM node, OWNED, or "" (a string or a list answers "").
pub func:sx_atom = string(Sxs->:s, int64:node) never fails {
    if (node < 0i64) { pass ""; }
    if (s.nodes.items[node].kind != (raw SX_ATOM())) { pass ""; }
    pass (raw text_copy(string_from_bytes(s.nodes.items[node].text.ptr, s.nodes.items[node].text.len)));
};

// The text of a STRING node, or "" -- and whether it is one.
pub func:sx_is_string = bool(Sxs->:s, int64:node) never fails {
    if (node < 0i64) { pass false; }
    pass (s.nodes.items[node].kind == (raw SX_STRING()));
};

pub func:sx_string = string(Sxs->:s, int64:node) never fails {
    if (!(raw sx_is_string(s, node))) { pass ""; }
    pass (raw text_copy(string_from_bytes(s.nodes.items[node].text.ptr, s.nodes.items[node].text.len)));
};

pub func:sx_is_list = bool(Sxs->:s, int64:node) never fails {
    if (node < 0i64) { pass false; }
    pass (s.nodes.items[node].kind == (raw SX_LIST()));
};

// The head atom of a list node: its first item's atom text, or "".
pub func:sx_head = string(Sxs->:s, int64:list_node) never fails {
    pass (raw sx_atom(s, raw sx_nth(s, list_node, 0i64)));
};

// The first top-level list whose head is `name`, or -1.
pub func:sx_find_root = int64(Sxs->:s, string:name) never fails {
    for (int64:i in 0i64...s.roots.count) {
        int64:r = s.roots.items[i];
        if (raw text_eq(raw sx_head(s, r), name)) { pass r; }
    }
    pass (0i64 - 1i64);
};
