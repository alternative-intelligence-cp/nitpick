// explore_stage -- THE EXPLORE STAGE's pieces (1.5.7 step 1; D-212, D-298...D-301):
// the harness's `stage_explore`, unit for unit and message for message, so the
// parity stage can diff the two runners' verdicts.
//
// A program marked `// explore: N` is compiled by the real backend, linked
// against the EXPLORED floor (`runtime/npkrt.ll` through the one transformer,
// `npkg/explore.npk`, assembled) and the shim (`runtime/explore/npkx.ll`,
// hand-written IR under the floor's own belts, assembled), and run under N
// seeds of the shim's PCT scheduler; every run is held to the program's
// `expect-exit:` and to NO VERDICT of the shim (DEADLOCK, STEP BUDGET, MMAP;
// the quiescence oracles from step 3). A measuring run first (seed 0, depth
// 1: no change points) gives k, the schedule's length, so the seeded runs'
// change points fall inside it (X-5). The first seed runs TWICE and its two
// schedule hashes must agree -- nondeterminism in the explored build is a
// defect of the instrument (`explore-replay-differs`, X-7). A `// explore-seed:
// S` runs first, forever (X-11). A program marked `// explore: no <reason>` is
// recorded with its reason and not run; a `// stress:` program marked neither
// is a red run by name (`explore-unmarked`, D-299).

mod:explore_stage;

use "../src/frontend/paths.npk".*;
use "../lib/nfs.npk".*;
use "../lib/nproc.npk".*;
use "./text.npk".*;
use "./expect.npk".*;
use "./toolchain.npk".*;
use "./build.npk".*;
use "./irscan.npk".*;
use "./floor_stack.npk".*;
use "./explore.npk".*;
use "./explore_req.npk".*;                   // explore_assumptions, the D-302 belt (1.5.7 step 5)

// THE MARKER BELT (D-299): a `// stress:` program says whether it is explored;
// the finding when it says neither, else nothing.
pub func:explore_marker_finding = List<string>(Expect->:exp, string:name) never fails {
    List<string>:fl = raw list_init::<string>(1i64);
    if ((exp.explore < 0i64) && (exp.explore_no.len == 0i64) && (exp.stress > 1i64)) {
        drop strlist_push(@fl, string_concat(name, ": explore-unmarked: a `// stress:` program says `// explore: N` or `// explore: no <reason>` (D-299)"));
    }
    pass fl;
};

// The explored floor and the shim, built into `build/explore/`: the two
// objects every unit links against. `findings` names what did not build.
pub struct:ExploredObjects = { string:xfloor_o; string:shim_o; string:assumptions; int64:checkers; List<string>:findings;
                               List<string>:unrouted; };

pub async func:explored_objects = ExploredObjects(Ctx->:c) {
    ExploredObjects:x = ExploredObjects{ xfloor_o: "", shim_o: "", assumptions: "", checkers: 0i64, findings: raw list_init::<string>(1i64),
                                         unrouted: raw list_init::<string>(4i64) };
    string:root = string_from_bytes(c.m.root.ptr, c.m.root.len);
    string:xdir = raw path_join(string_from_bytes(c.bdir.ptr, c.bdir.len), "explore");
    Result<NIL>:d = ensure_dir(xdir);
    if (d.is_error) { drop strlist_push(@x.findings, "explore: build/explore could not be created"); pass x; }
    // the explored floor: the transformer's output, counted by the belt, assembled
    Result<cstring>:fc = to_cstring(string_concat(root, "/runtime/npkrt.ll"));
    if (fc.is_error) { drop strlist_push(@x.findings, "explore: runtime/npkrt.ll: not a path"); pass x; }
    Result<string>:ftx = read_file(fc.value);
    if (ftx.is_error) { drop strlist_push(@x.findings, "explore: runtime/npkrt.ll cannot be read"); pass x; }
    string:spec = raw spec_text_of(root);
    if (spec.len == 0i64) { drop strlist_push(@x.findings, "explore: runtime/npkrt.spec is missing -- the entry checkers have no source (D-302)"); pass x; }
    Explored:xf = raw explore_transform(ftx.value, spec);
    for (int64:i in 0i64...xf.problems.count) { drop strlist_push(@x.findings, raw strlist_view(xf.problems, i)); }
    if (x.findings.count > 0i64) { pass x; }
    List<string>:tot = raw explore_totality(ftx.value, xf.text);
    for (int64:j in 0i64...tot.count) { drop strlist_push(@x.findings, raw strlist_view(tot, j)); }
    if (x.findings.count > 0i64) { pass x; }
    // THE SPEC'S CALLER HYPOTHESES (step 5, D-302): the counting belt, then the rows kept for the stage's sentence
    List<string>:asf = raw explore_assumptions(spec, xf.text, xf.assumptions, "explore");
    for (int64:j3 in 0i64...asf.count) { drop strlist_push(@x.findings, raw strlist_view(asf, j3)); }
    if (x.findings.count > 0i64) { pass x; }
    // THE SYSCALLS NO POINT CAN PRECEDE (1.5.8 step 2b; DEF-64): every `module asm`
    // syscall the census reads is stated, with its reason, in runtime/explore/unrouted.txt
    Result<cstring>:uc = to_cstring(string_concat(root, "/runtime/explore/unrouted.txt"));
    if (uc.is_error) { drop strlist_push(@x.findings, "explore: runtime/explore/unrouted.txt: not a path"); pass x; }
    if (!(path_exists(uc.value))) {
        drop strlist_push(@x.findings, "explore: runtime/explore/unrouted.txt is missing -- the floor's `module asm` syscalls must each be stated (DEF-64)");
        pass x;
    }
    Result<string>:utx = read_file(uc.value);
    if (utx.is_error) { drop strlist_push(@x.findings, "explore: runtime/explore/unrouted.txt cannot be read"); pass x; }
    Unrouted:un = raw explore_unrouted(ftx.value, utx.value, "explore");
    for (int64:j4 in 0i64...un.findings.count) { drop strlist_push(@x.findings, raw strlist_view(un.findings, j4)); }
    if (x.findings.count > 0i64) { pass x; }
    x.unrouted = move(un.pairs);
    x.assumptions = string_concat(xf.assumptions, "");
    x.checkers = xf.checkers;
    string:xll = raw path_join(xdir, "npkrt.explore.ll");
    Result<cstring>:xc = to_cstring(xll);
    if (xc.is_error) { fail xc.err; }
    Result<NIL>:w1 = write_file(xc.value, xf.text);
    if (w1.is_error) { fail w1.err; }
    string:xo = raw path_join(xdir, "npkrt.explore.o");
    Result<Step>:s1 = await llc_obj(c, c.m.llc_flags, xll, xo);
    if (s1.is_error) { fail s1.err; }
    Step:st1 = move(s1.value);
    if (!st1.ok) {
        drop strlist_push(@x.findings, string_concat("explore: llc rejected the explored floor: ", raw text_head(raw text_trim(st1.text), 160i64)));
        pass x;
    }
    // THE SHIM (D-298): hand-written IR under the floor's own belts, assembled
    string:shim = string_concat(root, "/runtime/explore/npkx.ll");
    Result<cstring>:sc = to_cstring(shim);
    if (sc.is_error) { fail sc.err; }
    if (!(path_exists(sc.value))) {
        drop strlist_push(@x.findings, "explore: runtime/explore/npkx.ll is missing -- the shim is part of the tree (D-298)");
        pass x;
    }
    Result<string>:stx = read_file(sc.value);
    if (stx.is_error) { drop strlist_push(@x.findings, "explore: runtime/explore/npkx.ll cannot be read"); pass x; }
    List<string>:nu = raw ir_no_undef(stx.value, "runtime/explore/npkx.ll");
    for (int64:k1 in 0i64...nu.count) { drop strlist_push(@x.findings, raw strlist_view(nu, k1)); }
    List<string>:ho = raw ir_allocas_hoisted(stx.value, "runtime/explore/npkx.ll");
    for (int64:k2 in 0i64...ho.count) { drop strlist_push(@x.findings, raw strlist_view(ho, k2)); }
    List<string>:hd = raw ir_module_header(stx.value, "runtime/explore/npkx.ll", string_from_bytes(c.m.triple.ptr, c.m.triple.len), string_from_bytes(c.m.datalayout.ptr, c.m.datalayout.len));
    for (int64:k4 in 0i64...hd.count) { drop strlist_push(@x.findings, raw strlist_view(hd, k4)); }
    List<string>:sk = raw floor_stack_check(stx.value, "explore");
    for (int64:k3 in 0i64...sk.count) { drop strlist_push(@x.findings, raw strlist_view(sk, k3)); }
    // THE ORACLE'S OFFSETS (step 3; D-301): the three words the quiescence oracle
    // reads off the floor's structs, held to the floor's type lines
    List<string>:oo = raw check_oracle_offsets(ftx.value, stx.value, "explore");
    for (int64:k5 in 0i64...oo.count) { drop strlist_push(@x.findings, raw strlist_view(oo, k5)); }
    if (x.findings.count > 0i64) { pass x; }
    string:so = raw path_join(xdir, "npkx.o");
    Result<Step>:s2 = await llc_obj(c, c.m.llc_flags, shim, so);
    if (s2.is_error) { fail s2.err; }
    Step:st2 = move(s2.value);
    if (!st2.ok) {
        drop strlist_push(@x.findings, string_concat("explore: llc rejected the shim: ", raw text_head(raw text_trim(st2.text), 160i64)));
        pass x;
    }
    List<string>:zd = raw zero_dep(c, so, c.allow, "runtime/explore/npkx.o");
    for (int64:k4 in 0i64...zd.count) { drop strlist_push(@x.findings, raw strlist_view(zd, k4)); }
    if (x.findings.count > 0i64) { pass x; }
    x.xfloor_o = move(xo);
    x.shim_o = move(so);
    pass x;
};

// The explored binary's WHOLE environment: the shim reads /proc/self/environ,
// first match wins, so nothing of ours rides along.
// `p1`..`p4` are a directed control's site numbers (X-15), NPKX_PREEMPT1..4, and
// `h1`..`h4` a held control's (1.5.8 step 2c), NPKX_HOLD1..4, -1 for none; a unit
// passes eight -1s. (Values, not lists: a value built from a borrowed list would
// carry the borrow into the run's text, D-004 rule 3.)
func:explored_env = ProcArgs(int64:seed, int64:k, int64:depth, int64:p1, int64:p2, int64:p3, int64:p4,
                             int64:h1, int64:h2, int64:h3, int64:h4) {
    ProcArgs:e = raw args_init();
    Result<NIL>:r1 = args_push(@e, string_concat("NPKX_SEED=", int_to_string(seed)));
    if (r1.is_error) { drop args_free(@e); fail r1.err; }
    Result<NIL>:r2 = args_push(@e, string_concat("NPKX_K=", int_to_string(k)));
    if (r2.is_error) { drop args_free(@e); fail r2.err; }
    Result<NIL>:r3 = args_push(@e, string_concat("NPKX_D=", int_to_string(depth)));
    if (r3.is_error) { drop args_free(@e); fail r3.err; }
    Result<NIL>:r4 = args_push(@e, "NPKX_TRACE=1");
    if (r4.is_error) { drop args_free(@e); fail r4.err; }
    if (p1 >= 0i64) { Result<NIL>:q1 = args_push(@e, string_concat("NPKX_PREEMPT1=", int_to_string(p1))); if (q1.is_error) { drop args_free(@e); fail q1.err; } }
    if (p2 >= 0i64) { Result<NIL>:q2 = args_push(@e, string_concat("NPKX_PREEMPT2=", int_to_string(p2))); if (q2.is_error) { drop args_free(@e); fail q2.err; } }
    if (p3 >= 0i64) { Result<NIL>:q3 = args_push(@e, string_concat("NPKX_PREEMPT3=", int_to_string(p3))); if (q3.is_error) { drop args_free(@e); fail q3.err; } }
    if (p4 >= 0i64) { Result<NIL>:q4 = args_push(@e, string_concat("NPKX_PREEMPT4=", int_to_string(p4))); if (q4.is_error) { drop args_free(@e); fail q4.err; } }
    if (h1 >= 0i64) { Result<NIL>:g1 = args_push(@e, string_concat("NPKX_HOLD1=", int_to_string(h1))); if (g1.is_error) { drop args_free(@e); fail g1.err; } }
    if (h2 >= 0i64) { Result<NIL>:g2 = args_push(@e, string_concat("NPKX_HOLD2=", int_to_string(h2))); if (g2.is_error) { drop args_free(@e); fail g2.err; } }
    if (h3 >= 0i64) { Result<NIL>:g3 = args_push(@e, string_concat("NPKX_HOLD3=", int_to_string(h3))); if (g3.is_error) { drop args_free(@e); fail g3.err; } }
    if (h4 >= 0i64) { Result<NIL>:g4 = args_push(@e, string_concat("NPKX_HOLD4=", int_to_string(h4))); if (g4.is_error) { drop args_free(@e); fail g4.err; } }
    pass e;
};

// The i-th directed site of a resolved control, or -1 past its count.
func:site_or_none = int64(Sites->:s, int64:i) never fails {
    if (i < s.numbers.count) { pass s.numbers[i]; }
    pass (0i64 - 1i64);
};

// The shim's verdict word on a line `npkx: WORD ...`, or "".
func:npkx_verdict = string(string:err) never fails {
    List<string>:lines = raw text_lines(err);
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (!(raw text_starts_with(ln, "npkx: "))) { continue; }
        string:rest = raw text_slice(ln, 6i64, ln.len);
        if (raw text_starts_with(rest, "DEADLOCK"))    { pass "DEADLOCK"; }
        if (raw text_starts_with(rest, "STEP BUDGET")) { pass "STEP BUDGET"; }
        if (raw text_starts_with(rest, "MMAP"))        { pass "MMAP"; }
        if (raw text_starts_with(rest, "LOST")) {
            // the whole word: `LOST-WAKE` or `LOST-FUTEX-WAKE`, up to the space
            int64:sp = raw text_find_byte(rest, 32u8, 0i64);
            if (sp < 0i64) { pass (string_concat(rest, "")); }
            pass (raw text_slice(rest, 0i64, sp));
        }
        if (raw text_starts_with(rest, "ASSUMPTION"))  { pass "ASSUMPTION"; }
        if (raw text_starts_with(rest, "SHIM FAULT"))  { pass "SHIM FAULT"; }   // K-13, 1.5.8 step 3
    }
    pass "";
};

// The digits after `KEY` on the trace line (`npkx: seed=... steps=... hash=...`),
// as TEXT: a hash is a 64-bit word, and a number the language would trap on.
func:npkx_field = string(string:err, string:key) never fails {
    List<string>:lines = raw text_lines(err);
    for (int64:i in 0i64...lines.count) {
        string:ln = raw strlist_view(lines, i);
        if (!(raw text_starts_with(ln, "npkx: "))) { continue; }
        if (!(raw text_contains(ln, " seed="))) { continue; }
        int64:at = raw text_index_of(ln, key);
        if (at < 0i64) { pass ""; }
        int64:p = at + key.len;
        int64:stop = p;
        while (stop < ln.len) decreases ln.len - stop {
            uint8:ch = ln.ptr[stop];
            if ((ch < 48u8) || (ch > 57u8)) { break; }
            stop = stop + 1i64;
        }
        pass (raw text_slice(ln, p, stop));
    }
    pass "";
};

// A field that is a small count (steps, threads) as a number; -1 when absent.
func:npkx_count = int64(string:err, string:key) never fails {
    string:s = raw npkx_field(err, key);
    if (s.len == 0i64) { pass (0i64 - 1i64); }
    if (s.len > 15i64) { pass (0i64 - 1i64); }
    int64:v = 0i64;
    for (int64:i in 0i64...s.len) { v = (v * 10i64) + ((s.ptr[i] - 48u8) => int64); }
    pass v;
};

pub struct:SeedRun = { List<string>:findings; int64:steps; string:hash; int64:threads; };

// One seeded run: a verdict of the shim, a wrong exit, a hang or a missing
// trace line are failures carrying the replay line.
pub async func:run_explored = SeedRun(Ctx->:c, string:exe, int64:seed, int64:k, int64:depth, int64:want, string:name) {
    SeedRun:x = SeedRun{ findings: raw list_init::<string>(1i64), steps: 0i64, hash: "", threads: 0i64 };
    string:replay = string_concat("NPKX_SEED=", int_to_string(seed));
    replay = string_concat(replay, " NPKX_K=");
    replay = string_concat(replay, int_to_string(k));
    replay = string_concat(replay, " NPKX_D=");
    replay = string_concat(replay, int_to_string(depth));
    replay = string_concat(replay, " NPKX_TRACE=1 ");
    replay = string_concat(replay, exe);
    replay = string_concat(replay, " < /dev/null");
    ProcArgs:env = relay explored_env(seed, k, depth, 0i64 - 1i64, 0i64 - 1i64, 0i64 - 1i64, 0i64 - 1i64,
                                      0i64 - 1i64, 0i64 - 1i64, 0i64 - 1i64, 0i64 - 1i64);
    List<string>:noargs = raw list_init::<string>(1i64);
    Result<Run>:r = await run_argv(exe, noargs, env, raw duration_secs(60i64));
    drop args_free(@env);
    if (r.is_error) { fail r.err; }
    Run:run = move(r.value);
    if (run.timed_out) {
        string:m0 = string_concat(name, ": explore-hung: seed ");
        m0 = string_concat(m0, int_to_string(seed));
        m0 = string_concat(m0, " ran for 60 s of REAL time -- a thread spinning without reading the clock or blocking (replay: ");
        m0 = string_concat(m0, replay);
        drop list_push(@x.findings, string_concat(m0, ")"));
        pass x;
    }
    string:verdict = raw npkx_verdict(run.x.err);
    if (verdict.len > 0i64) {
        string:m1 = string_concat(name, ": explore verdict ");
        m1 = string_concat(m1, verdict);
        m1 = string_concat(m1, " at seed ");
        m1 = string_concat(m1, int_to_string(seed));
        m1 = string_concat(m1, " (replay: ");
        m1 = string_concat(m1, replay);
        m1 = string_concat(m1, "):\n");
        drop list_push(@x.findings, string_concat(m1, raw text_head(raw text_trim(run.x.err), 800i64)));
        pass x;
    }
    int64:got = run.x.status;
    if (!run.x.exited) { got = 0i64 - run.x.signal; }
    if (got != want) {
        string:m2 = string_concat(name, ": exited ");
        m2 = string_concat(m2, int_to_string(got));
        m2 = string_concat(m2, " under the explorer at seed ");
        m2 = string_concat(m2, int_to_string(seed));
        m2 = string_concat(m2, ", expected ");
        m2 = string_concat(m2, int_to_string(want));
        m2 = string_concat(m2, " (replay: ");
        m2 = string_concat(m2, replay);
        drop list_push(@x.findings, string_concat(m2, ")"));
        pass x;
    }
    int64:steps = raw npkx_count(run.x.err, "steps=");
    string:hash = raw npkx_field(run.x.err, "hash=");
    if ((steps < 0i64) || (hash.len == 0i64)) {
        string:m3 = string_concat(name, ": no schedule trace from the shim at seed ");
        m3 = string_concat(m3, int_to_string(seed));
        m3 = string_concat(m3, " (replay: ");
        m3 = string_concat(m3, replay);
        drop list_push(@x.findings, string_concat(m3, ")"));
        pass x;
    }
    x.steps = steps;
    x.hash = move(hash);
    int64:th = raw npkx_count(run.x.err, "threads=");
    if (th > 0i64) { x.threads = th; }
    pass x;
};

// The seeds a unit runs, in order: `// explore-seed: S` first, then 1..N without them.
pub func:explore_seeds = List<int64>(Expect->:exp) never fails {
    List<int64>:seeds = raw list_init::<int64>(exp.explore + 2i64);
    for (int64:i in 0i64...exp.explore_first.count) { drop list_push(@seeds, exp.explore_first[i]); }
    for (int64:s in 1i64..exp.explore) {
        bool:named = false;
        for (int64:j in 0i64...exp.explore_first.count) { if (exp.explore_first[j] == s) { named = true; } }
        if (!named) { drop list_push(@seeds, s); }
    }
    pass seeds;
};

pub struct:XMeasured = { List<string>:findings; bool:ran; int64:threads; int64:k; int64:depth; int64:seeds; };

// THE PROGRAM'S OWN STEPS (step 6, the plan's §2.7; X-20): `base`.ll, a unit's
// emitted IR, through the ONE transformer's program mode -- a point before
// every atomic step line, every `@npk_sys6(` call routed, sites from
// `PROGRAM_SITE_BASE` -- held to the counting belt, written as `base`.x.ll
// with its sites beside it, and assembled by the pinned llc. The harness's
// `explored_program_object`, verdict for verdict. The shim's module is never
// transformed.
pub struct:XProg = { List<string>:findings; string:obj; };

pub async func:explored_program_object = XProg(Ctx->:c, string:base, string:name) {
    XProg:out = XProg{ findings: raw list_init::<string>(1i64), obj: "" };
    Result<cstring>:pc = to_cstring(string_concat(base, ".ll"));
    if (pc.is_error) { fail pc.err; }
    Result<string>:ptx = read_file(pc.value);
    if (ptx.is_error) { fail ptx.err; }
    Explored:px = raw explore_transform_program(ptx.value);
    for (int64:i in 0i64...px.problems.count) {
        drop strlist_push(@out.findings, string_concat(string_concat(name, ": the transformer refused the program's IR: "), raw strlist_view(px.problems, i)));
    }
    if (out.findings.count > 0i64) { pass out; }
    List<string>:tot = raw explore_totality_of("program", ptx.value, px.text);
    for (int64:j in 0i64...tot.count) { drop strlist_push(@out.findings, string_concat(string_concat(name, ": "), raw strlist_view(tot, j))); }
    if (out.findings.count > 0i64) { pass out; }
    string:xll = string_concat(base, ".x.ll");
    Result<cstring>:xc = to_cstring(xll);
    if (xc.is_error) { fail xc.err; }
    Result<NIL>:w1 = write_file(xc.value, px.text);
    if (w1.is_error) { fail w1.err; }
    Result<cstring>:sc = to_cstring(string_concat(base, ".x.sites.txt"));
    if (sc.is_error) { fail sc.err; }
    Result<NIL>:w2 = write_file(sc.value, px.sites);
    if (w2.is_error) { fail w2.err; }
    string:xo = string_concat(base, ".x.o");
    Result<Step>:s1 = await llc_obj(c, c.m.llc_flags, xll, xo);
    if (s1.is_error) { fail s1.err; }
    Step:st1 = move(s1.value);
    if (!st1.ok) {
        drop strlist_push(@out.findings, string_concat(string_concat(name, ": llc rejected the explored program: "), raw text_head(raw text_trim(st1.text), 160i64)));
        pass out;
    }
    out.obj = move(xo);
    pass out;
};

// One unit of the stage: compile, link against the explored floor and the
// shim, the measuring run, the seeds, the replay belt.
pub async func:check_explored_program = XMeasured(Ctx->:c, string:path, string:name, Expect->:exp,
                                                 string:xfloor_o, string:shim_o) {
    XMeasured:m = XMeasured{ findings: raw list_init::<string>(1i64), ran: false, threads: 0i64, k: 0i64, depth: exp.explore_depth, seeds: 0i64 };
    string:fname = raw text_file_name(path);
    string:base = raw path_join(raw path_join(string_from_bytes(c.bdir.ptr, c.bdir.len), "explore"),
                                string_concat("xprog_", raw text_replace_byte(fname, 46u8, 95u8)));
    List<string>:fl = relay await emit_and_object(c, string_from_bytes(c.npkc.ptr, c.npkc.len), path, name, base, c.allow);
    if (fl.count > 0i64) { m.findings = move(fl); pass m; }
    XProg:xp = relay await explored_program_object(c, base, name);
    if (xp.findings.count > 0i64) { m.findings = move(xp.findings); pass m; }
    List<string>:args = raw strlist_clone(c.m.lld_flags);
    drop strlist_push(@args, "-o");
    drop strlist_push(@args, base);
    drop strlist_push(@args, xp.obj);
    drop strlist_push(@args, xfloor_o);
    drop strlist_push(@args, shim_o);
    Result<Step>:ls = await tool_step(c, string_from_bytes(c.t.lld.ptr, c.t.lld.len), args, raw duration_secs(600i64));
    if (ls.is_error) { fail ls.err; }
    Step:lst = move(ls.value);
    if (!lst.ok) {
        string:m0 = string_concat(name, ": link against the explored floor failed: ");
        m0 = string_concat(m0, raw text_head(raw text_trim(lst.text), 140i64));
        drop list_push(@m.findings, move(m0));
        pass m;
    }
    // the measuring run: seed 0, no change points -- k is the schedule's length
    SeedRun:r0 = relay await run_explored(c, base, 0i64, 2000i64, 1i64, exp.exit_code, name);
    if (r0.findings.count > 0i64) { m.findings = move(r0.findings); pass m; }
    int64:k = r0.steps;
    if (k < 1i64) { k = 1i64; }
    m.threads = r0.threads;
    m.k = k;
    List<int64>:seeds = raw explore_seeds(exp);
    m.seeds = seeds.count;
    string:first_hash = "";
    for (int64:i in 0i64...seeds.count) {
        SeedRun:rs = relay await run_explored(c, base, seeds[i], k, exp.explore_depth, exp.exit_code, name);
        if (rs.findings.count > 0i64) { m.findings = move(rs.findings); pass m; }
        if (i == 0i64) { first_hash = move(rs.hash); }
    }
    // THE REPLAY BELT (X-7): the first seed again, the same hash
    if (seeds.count > 0i64) {
        SeedRun:rr = relay await run_explored(c, base, seeds[0i64], k, exp.explore_depth, exp.exit_code, name);
        if (rr.findings.count > 0i64) { m.findings = move(rr.findings); pass m; }
        if (!(raw text_eq(rr.hash, first_hash))) {
            string:m1 = string_concat(name, ": explore-replay-differs: seed ");
            m1 = string_concat(m1, int_to_string(seeds[0i64]));
            m1 = string_concat(m1, " gave two schedule hashes (");
            m1 = string_concat(m1, first_hash);
            m1 = string_concat(m1, ", ");
            m1 = string_concat(m1, rr.hash);
            m1 = string_concat(m1, ") -- nondeterminism in the explored build is a defect of the instrument");
            drop list_push(@m.findings, move(m1));
            pass m;
        }
    }
    m.ran = true;
    pass m;
};

// --- the negative controls (step 3; X-10) ------------------------------------------------
//
// One control (`runtime/explore/controls/<name>.ctl`): the floor with the
// control's `old` lines replaced by its `new` (exactly one occurrence each, in
// order), transformed by the ONE transformer, counted, assembled; the program
// compiled and linked against it and the shim; a measuring run (seed 0, depth
// 1: k is the schedule's length, as a unit's is -- step 4), then seeds
// 1..within at depth 3 until the verdict appears -- a word of the shim,
// `wrong-exit`, `exit N` or `late N`. A control the explorer is blind to fails
// by name (`explore-control-blind`); so does one the grammar cannot read or
// whose `old` lines do not occur exactly once. The harness's
// `run_explore_control`, message for message.
pub struct:CtlRun = { List<string>:findings; int64:seed; };

// THE CONTROL'S HANG NET (1.5.8b step 3, DEF-83): a seed that finds a
// `wrong-exit` control's defect may spin to the shim's step budget BY DESIGN
// -- `link-without-cas.ctl` says "about 30 s" -- where every other seed takes
// milliseconds. The per-seed net was 60 s, the unit explore stage's, and at
// step 1b's first full harness, run beside eight solver batches and a second
// harness, the finding seed (6; step 2's run found it there) passed the net
// and read "hung": a red run that was no verdict. The net is a hang net, never
// a verdict (P-13's rule), sized ten times the slowest designed seed. The
// harness's `CONTROL_SEED_NET` is the twin.
func:control_seed_net_secs = int64() never fails { pass 300i64; };

pub async func:run_explore_control = CtlRun(Ctx->:c, string:path, string:name, string:shim_o) {
    CtlRun:out = CtlRun{ findings: raw list_init::<string>(1i64), seed: 0i64 };
    Result<cstring>:tc = to_cstring(path);
    if (tc.is_error) { fail tc.err; }
    Result<string>:text = read_file(tc.value);
    if (text.is_error) { fail text.err; }
    Control:ctl = raw read_control(text.value, name);
    if (!ctl.ok) {
        string:m0 = string_concat(name, ": explore-control-malformed: ");
        drop list_push(@out.findings, string_concat(m0, ctl.problem));
        pass out;
    }
    string:root = string_from_bytes(c.m.root.ptr, c.m.root.len);
    Result<cstring>:fc = to_cstring(string_concat(root, "/runtime/npkrt.ll"));
    if (fc.is_error) { fail fc.err; }
    Result<string>:ftx = read_file(fc.value);
    if (ftx.is_error) { fail ftx.err; }
    Patched:pt = raw apply_control(ftx.value, @ctl, name);
    if (pt.problem.len > 0i64) {
        drop list_push(@out.findings, string_concat(pt.problem, ""));
        pass out;
    }
    // the spec beside the floor: patched by a spec control, else the real one, so the entry checkers ride
    string:spec0 = raw spec_text_of(root);
    if (spec0.len == 0i64) { drop list_push(@out.findings, string_concat(name, ": runtime/npkrt.spec is missing (D-302)")); pass out; }
    Patched:ps = raw apply_spec_control(spec0, @ctl, name);
    if (ps.problem.len > 0i64) {
        drop list_push(@out.findings, string_concat(ps.problem, ""));
        pass out;
    }
    string:cname = raw text_file_name(path);
    string:stem = raw text_replace_byte(raw text_slice(cname, 0i64, cname.len - 4i64), 45u8, 95u8);
    string:xdir0 = raw path_join(string_from_bytes(c.bdir.ptr, c.bdir.len), "explore");
    Result<NIL>:d0 = ensure_dir(xdir0);
    if (d0.is_error) { fail d0.err; }
    string:cdir = raw path_join(xdir0, string_concat("ctl_", stem));
    Result<NIL>:d = ensure_dir(cdir);
    if (d.is_error) { fail d.err; }
    Explored:xf = raw explore_transform(pt.text, ps.text);
    for (int64:i in 0i64...xf.problems.count) {
        drop list_push(@out.findings, string_concat(string_concat(name, ": the transformer refused the patched floor: "), raw strlist_view(xf.problems, i)));
    }
    if (out.findings.count > 0i64) { pass out; }
    List<string>:tot = raw explore_totality(pt.text, xf.text);
    for (int64:j in 0i64...tot.count) { drop strlist_push(@out.findings, raw strlist_view(tot, j)); }
    if (out.findings.count > 0i64) { pass out; }
    // the directed sites (X-15) and the held ones (1.5.8 step 2c), resolved against THIS floor's sites
    Sites:sites = raw resolve_sites(@ctl, xf.sites, name);
    for (int64:j2 in 0i64...sites.findings.count) { drop strlist_push(@out.findings, raw strlist_view(sites.findings, j2)); }
    Sites:holds = raw resolve_holds(@ctl, xf.sites, name);
    for (int64:j3 in 0i64...holds.findings.count) { drop strlist_push(@out.findings, raw strlist_view(holds.findings, j3)); }
    if (out.findings.count > 0i64) { pass out; }
    string:xll = raw path_join(cdir, "npkrt.explore.ll");
    Result<cstring>:xc = to_cstring(xll);
    if (xc.is_error) { fail xc.err; }
    Result<NIL>:w1 = write_file(xc.value, xf.text);
    if (w1.is_error) { fail w1.err; }
    string:xo = raw path_join(cdir, "npkrt.explore.o");
    Result<Step>:s1 = await llc_obj(c, c.m.llc_flags, xll, xo);
    if (s1.is_error) { fail s1.err; }
    Step:st1 = move(s1.value);
    if (!st1.ok) {
        drop list_push(@out.findings, string_concat(string_concat(name, ": llc rejected the patched explored floor: "), raw text_head(raw text_trim(st1.text), 160i64)));
        pass out;
    }
    string:prog = raw path_join(root, ctl.program);
    Result<cstring>:pc = to_cstring(prog);
    if (pc.is_error) { fail pc.err; }
    if (!(path_exists(pc.value))) {
        drop list_push(@out.findings, string_concat(string_concat(name, ": names a program that does not exist: "), ctl.program));
        pass out;
    }
    Result<string>:ptx = read_file(pc.value);
    if (ptx.is_error) { fail ptx.err; }
    Expect:exp = raw expect_read(ptx.value);
    // A PROGRAM CONTROL (step 6, X-21): the defect is planted in the program's SOURCE, and the patched
    // source -- the same basename, which the module's name must match -- is compiled from here
    string:psrc = string_concat(prog, "");
    if (ctl.prog_before.count > 0i64) {
        Patched:pp = raw apply_program_control(ptx.value, @ctl, name);
        if (pp.problem.len > 0i64) {
            drop list_push(@out.findings, string_concat(pp.problem, ""));
            pass out;
        }
        psrc = raw path_join(cdir, raw text_file_name(ctl.program));
        Result<cstring>:ppc = to_cstring(psrc);
        if (ppc.is_error) { fail ppc.err; }
        Result<NIL>:pw = write_file(ppc.value, pp.text);
        if (pw.is_error) { fail pw.err; }
    }
    string:base = raw path_join(cdir, "prog");
    List<string>:fl = relay await emit_and_object(c, string_from_bytes(c.npkc.ptr, c.npkc.len), psrc, ctl.program, base, c.allow);
    if (fl.count > 0i64) { out.findings = move(fl); pass out; }
    XProg:xp = relay await explored_program_object(c, base, name);
    if (xp.findings.count > 0i64) { out.findings = move(xp.findings); pass out; }
    List<string>:args = raw strlist_clone(c.m.lld_flags);
    drop strlist_push(@args, "-o");
    drop strlist_push(@args, base);
    drop strlist_push(@args, xp.obj);
    drop strlist_push(@args, xo);
    drop strlist_push(@args, shim_o);
    Result<Step>:ls = await tool_step(c, string_from_bytes(c.t.lld.ptr, c.t.lld.len), args, raw duration_secs(600i64));
    if (ls.is_error) { fail ls.err; }
    Step:lst = move(ls.value);
    if (!lst.ok) {
        drop list_push(@out.findings, string_concat(string_concat(name, ": link against the patched floor failed: "), raw text_head(raw text_trim(lst.text), 140i64)));
        pass out;
    }
    // the measuring run: seed 0, no change points -- k is the schedule's length. A verdict there is
    // not counted, but its line carries the steps too (`npkx: WORD (...) seed=0 steps=N`, which
    // `npkx_field` reads off any `npkx:` line naming a seed): the planted defect may fire on the
    // unperturbed schedule, and the measurement is the steps it took to get there.
    int64:ds1 = raw site_or_none(@sites, 0i64);
    int64:ds2 = raw site_or_none(@sites, 1i64);
    int64:ds3 = raw site_or_none(@sites, 2i64);
    int64:ds4 = raw site_or_none(@sites, 3i64);
    int64:hs1 = raw site_or_none(@holds, 0i64);
    int64:hs2 = raw site_or_none(@holds, 1i64);
    int64:hs3 = raw site_or_none(@holds, 2i64);
    int64:hs4 = raw site_or_none(@holds, 3i64);
    ProcArgs:menv = relay explored_env(0i64, 2000i64, 1i64, ds1, ds2, ds3, ds4, hs1, hs2, hs3, hs4);
    List<string>:mnoargs = raw list_init::<string>(1i64);
    Result<Run>:mr = await run_argv(base, mnoargs, menv, raw duration_secs(raw control_seed_net_secs()));
    drop args_free(@menv);
    if (mr.is_error) { fail mr.err; }
    Run:mrun = move(mr.value);
    if (mrun.timed_out) {
        drop list_push(@out.findings, string_concat(name, ": the measuring run (seed 0) hung"));
        pass out;
    }
    int64:k = raw npkx_count(mrun.x.err, " steps=");
    if (k < 0i64) {
        drop list_push(@out.findings, string_concat(name, ": no schedule trace from the shim at the measuring run (seed 0)"));
        pass out;
    }
    if (k < 1i64) { k = 1i64; }
    string:seen = "";
    int64:nseen = 0i64;
    for (int64:seed in 1i64..ctl.within) {
        ProcArgs:env = relay explored_env(seed, k, 3i64, ds1, ds2, ds3, ds4, hs1, hs2, hs3, hs4);
        List<string>:noargs = raw list_init::<string>(1i64);
        Result<Run>:r = await run_argv(base, noargs, env, raw duration_secs(raw control_seed_net_secs()));
        drop args_free(@env);
        if (r.is_error) { fail r.err; }
        Run:run = move(r.value);
        string:what = "";
        if (run.timed_out) { what = "hung"; }
        else {
            string:v = raw npkx_verdict(run.x.err);
            int64:got = run.x.status;
            if (!run.x.exited) { got = 0i64 - run.x.signal; }
            int64:vrun = raw npkx_count(run.x.err, " vrun=");
            if (vrun < 0i64) { vrun = 0i64; }
            if (raw control_verdict_met(@ctl, exp.exit_code, got, v, vrun)) { out.seed = seed; pass out; }
            if (v.len > 0i64) { what = move(v); }
            else {
                what = string_concat("exit ", int_to_string(got));
                what = string_concat(what, ", vrun ");
                what = string_concat(what, int_to_string(vrun));
            }
        }
        if (nseen < 6i64) {
            if (seen.len > 0i64) { seen = string_concat(seen, ", "); }
            seen = string_concat(seen, string_concat(string_concat("seed ", int_to_string(seed)), ": "));
            seen = string_concat(seen, what);
            nseen = nseen + 1i64;
        }
    }
    string:m = string_concat(name, ": explore-control-blind: the explorer did not reach ");
    m = string_concat(m, ctl.verdict);
    m = string_concat(m, " within ");
    m = string_concat(m, int_to_string(ctl.within));
    m = string_concat(m, " seed(s) of the planted defect (k ");
    m = string_concat(m, int_to_string(k));
    if (sites.numbers.count > 0i64) {
        m = string_concat(m, ", directed at ");
        for (int64:d in 0i64...sites.numbers.count) {
            if (d > 0i64) { m = string_concat(m, ","); }
            m = string_concat(m, int_to_string(sites.numbers[d]));
        }
    }
    if (holds.numbers.count > 0i64) {
        m = string_concat(m, ", held at ");
        for (int64:hd in 0i64...holds.numbers.count) {
            if (hd > 0i64) { m = string_concat(m, ","); }
            m = string_concat(m, int_to_string(holds.numbers[hd]));
        }
    }
    m = string_concat(m, "; ");
    m = string_concat(m, seen);
    m = string_concat(m, ") -- an instrument blind to what it claims to see");
    drop list_push(@out.findings, move(m));
    pass out;
};

// A text written whole to `path` (the self-check's planted controls).
pub func:text_write_file = NIL(string:path, string:text) {
    Result<cstring>:pc = to_cstring(path);
    if (pc.is_error) { fail pc.err; }
    Result<NIL>:w = write_file(pc.value, text);
    if (w.is_error) { fail w.err; }
    pass NIL;
};
