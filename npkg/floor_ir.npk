// floor_ir -- the floor's text as functions, blocks and instruction lines
// (1.5.6 step 0; D-288's reader begins here, D-290's belt reads it).
//
// `runtime/npkrt.ll` is hand-written LLVM IR in a fixed vocabulary, and the
// belts that hold `runtime/npkrt.spec` to it need three things from the
// text: every `define` with its blocks in order and each block's successors
// (the control-flow graph, for dominance), every instruction line with its
// comment cut and its string constants blanked (the `undef` ban's rule, so a
// `;` inside `c"..."` is data), and the addresses each function computes into
// the four shared struct types and off the module's globals (the map an
// access is attributed through). Nothing here interprets an instruction:
// step 3's translator (`floor_smt.npk`) reads the same lines with a typed
// grammar; this module is the shape both share. The Python twin is
// `bootstrap/harness/floor.py`, form for form.

mod:floor_ir;

use "./text.npk".*;
use "./irscan.npk".*;

// One basic block: its label, its instruction lines (code parts, non-empty),
// and the indexes of its successor blocks in the function.
pub struct:FBlock = {
    string:label;
    List<string>:lines;
    List<int64>:succs;
};

// An address a function computed: `reg` names the register, `ty` the struct
// type (`%npk.hdr` ...) and `slot` its field for a typed struct GEP; for a
// GEP off a global, `ty` is "" and `global` names it.
pub struct:FGep = {
    string:reg;
    string:ty;
    int64:slot;
    string:global;
};

pub struct:FFn = {
    string:name;
    bool:internal;
    List<FBlock>:blocks;
    List<FGep>:geps;
    List<string>:params;      // `%dst`, `%src`, `%n` (1.5.6 step 3)
    List<string>:param_tys;   // `ptr`, `ptr`, `i64`
    string:ret_ty;            // `ptr`, `void`, `{ ptr, i64 }`
};

pub struct:FloorText = {
    List<FFn>:fns;
    List<string>:mutable;     // the module's `global` (not `constant`) names
    List<string>:globals;     // every global's name, `@name`, in file order (1.5.6 step 3)
    List<string>:global_tys;  // its declared type text (`i32`, `[14 x i64]`, `{ ptr, i64 }`)
    List<string>:global_inits; // a `constant`'s initialiser text, raw (`[i64 16, i64 32, ...]`, `c"..."`, `16`); "" for a global (1.5.6 step 4)
    List<string>:type_names;  // the named struct types, `%npk.hdr` (1.5.6 step 3)
    List<string>:type_texts;  // their bodies, `{ ptr, i32, ... }`
    List<string>:asm_syms;    // the symbols `module asm ".globl X"` defines, as `@X` (1.5.6 step 3)
    List<FAsm>:asm_bodies;    // the `module asm` census (1.5.8 step 2b; DEF-64): every symbol with a body, in file order
    List<int64>:asm_unread_lines; // the 1-based numbers of `module asm` lines the census cannot read
};

// One symbol a `module asm` block defines with a body (1.5.8 step 2b; DEF-64):
// its syscalls in order -- `read` false where the census cannot read the
// number -- its direct callees (`@Y`, a `call`/`jmp` to a named symbol), and
// whether it makes an indirect call. `floor.py`'s `AsmSym`, field for field.
pub struct:FAsm = {
    string:name;
    List<int64>:sys;
    List<bool>:read;
    List<string>:calls;
    bool:indirect;
};

// The line's code part: the comment cut, string contents blanked (the
// `irscan` rule, repeated here because that module keeps its copy private).
pub func:floor_code_part = string(string:line) never fails {
    wild int8->:buf = alloc(line.len + 1i64);
    int64:n = 0i64;
    bool:in_str = false;
    for (int64:i in 0i64...line.len) {
        uint8:c = line.ptr[i];
        if (c == 34u8) {
            in_str = !in_str;
            buf[n] = c =>! int8;
            n = n + 1i64;
            continue;
        }
        if (in_str) { buf[n] = 32i8; n = n + 1i64; continue; }
        if (c == 59u8) { break; }
        buf[n] = c =>! int8;
        n = n + 1i64;
    }
    string:out = raw text_trim(string_from_bytes(buf, n));
    dalloc(buf);
    pass out;
};

// `@name = internal global ...` / `... constant ...`: the global's name and
// whether it is mutable; "" when the line declares no global.
func:global_decl = string(string:line, bool->:is_mutable, string->:ty) never fails {
    if (line.len == 0i64) { pass ""; }
    if (line.ptr[0i64] != 64u8) { pass ""; }
    int64:eq = raw text_index_of(line, " = ");
    if (eq < 0i64) { pass ""; }
    string:rest = raw text_slice(line, eq + 3i64, line.len);
    // the floor pads some names before the `=` (`@npk_hs_live      = ...`)
    string:name = raw text_trim(raw text_slice(line, 0i64, eq));
    if (raw text_starts_with(rest, "internal ")) { rest = raw text_slice(rest, 9i64, rest.len); }
    if (raw text_starts_with(rest, "private ")) { rest = raw text_slice(rest, 8i64, rest.len); }
    if (raw text_starts_with(rest, "global ")) { <-is_mutable = true; <-ty = raw type_token(raw text_slice(rest, 7i64, rest.len)); pass name; }
    if (raw text_starts_with(rest, "constant ")) { <-is_mutable = false; <-ty = raw type_token(raw text_slice(rest, 9i64, rest.len)); pass name; }
    pass "";
};

// The leading TYPE of a text: one balanced token -- `i64`, `ptr`, `[14 x
// i64]`, `{ ptr, i64 }`, `{ { ptr, i64 }, i32 }` -- braces and brackets
// kept whole; "" when the text starts with neither a word nor a bracket.
pub func:type_token = string(string:s) never fails {
    int64:i = 0i64;
    while ((i < s.len) && (raw text_is_ws(s.ptr[i]))) { i = i + 1i64; }
    int64:start = i;
    int64:depth = 0i64;
    while (i < s.len) {
        uint8:ch = s.ptr[i];
        if ((ch == 123u8) || (ch == 91u8)) { depth = depth + 1i64; }
        if ((ch == 125u8) || (ch == 93u8)) { depth = depth - 1i64; }
        if (depth == 0i64) {
            if ((ch == 125u8) || (ch == 93u8)) { i = i + 1i64; break; }
            if ((raw text_is_ws(ch)) || (ch == 44u8) || (ch == 40u8) || (ch == 41u8)) { break; }
        }
        i = i + 1i64;
    }
    pass (raw text_slice(s, start, i));
};

// `%npk.hdr = type { ... }`: the name, and the body through `ty`; "" otherwise.
func:type_decl = string(string:line, string->:ty) never fails {
    if (line.len == 0i64) { pass ""; }
    if (line.ptr[0i64] != 37u8) { pass ""; }
    int64:eq = raw text_index_of(line, " = type ");
    if (eq < 0i64) { pass ""; }
    <-ty = raw type_token(raw text_slice(line, eq + 8i64, line.len));
    pass (raw text_trim(raw text_slice(line, 0i64, eq)));
};

// A label line: `name:` with no space; "" otherwise.
func:label_of = string(string:line) never fails {
    if (line.len < 2i64) { pass ""; }
    if (!(raw text_ends_with(line, ":"))) { pass ""; }
    if ((raw text_find_byte(line, 32u8, 0i64)) >= 0i64) { pass ""; }
    pass (raw text_slice(line, 0i64, line.len - 1i64));
};

// `%r = getelementptr [inbounds] TYPE, ptr BASE, ...`: the GEP, or a reg "".
func:gep_of = FGep(string:line) never fails {
    FGep:none = FGep{ reg: "", ty: "", slot: 0i64 - 1i64, global: "" };
    if (line.len == 0i64) { pass none; }
    if (line.ptr[0i64] != 37u8) { pass none; }
    int64:at = raw text_index_of(line, " = getelementptr ");
    if (at < 0i64) { pass none; }
    string:reg = raw text_slice(line, 0i64, at);
    string:rest = raw text_slice(line, at + 17i64, line.len);
    if (raw text_starts_with(rest, "inbounds ")) { rest = raw text_slice(rest, 9i64, rest.len); }
    int64:comma = raw text_find_byte(rest, 44u8, 0i64);
    if (comma < 0i64) { pass none; }
    string:ty = raw text_slice(rest, 0i64, comma);
    // an aggregate type carries commas of its own: `[14 x i64]` has none, a
    // struct literal type is never a GEP source in the floor
    int64:pp = raw text_index_from(rest, ", ptr ", 0i64);
    if (pp < 0i64) { pass none; }
    int64:bs = pp + 6i64;
    int64:be = bs;
    while (be < rest.len) {
        uint8:c = rest.ptr[be];
        if ((c == 44u8) || (c == 32u8)) { break; }
        be = be + 1i64;
    }
    string:base = raw text_slice(rest, bs, be);
    bool:is_struct = raw text_starts_with(ty, "%npk.");
    if (is_struct) {
        // `, i32 0, i32 N` at the end
        int64:z = raw text_index_from(rest, ", i32 0, i32 ", be);
        if (z < 0i64) { pass none; }
        Result<int64>:n = text_int(raw text_slice(rest, z + 13i64, rest.len));
        if (n.is_error) { pass none; }
        pass FGep{ reg: move(reg), ty: move(ty), slot: n.value, global: "" };
    }
    if (base.len > 0i64) {
        if (base.ptr[0i64] == 64u8) {
            pass FGep{ reg: move(reg), ty: "", slot: 0i64 - 1i64, global: move(base) };
        }
    }
    pass none;
};

func:ffn_empty = FFn() never fails {
    pass FFn{ name: "", internal: false, blocks: raw list_init::<FBlock>(8i64), geps: raw list_init::<FGep>(8i64),
              params: raw list_init::<string>(4i64), param_tys: raw list_init::<string>(4i64), ret_ty: "" };
};

// `define [internal] RET @name(TY %p, TY %q, ...) [attrs] {`: the return
// type and the parameters with their types.
func:define_header = NIL(string:line, FFn->:f) never fails {
    string:rest = raw text_slice(line, 7i64, line.len);   // after `define `
    if (raw text_starts_with(rest, "internal ")) { rest = raw text_slice(rest, 9i64, rest.len); }
    if (raw text_starts_with(rest, "private ")) { rest = raw text_slice(rest, 8i64, rest.len); }
    f.ret_ty = raw type_token(rest);
    int64:op = raw text_find_byte(rest, 40u8, 0i64);
    if (op < 0i64) { pass NIL; }
    int64:cl = op + 1i64;
    int64:depth = 1i64;
    while ((cl < rest.len) && (depth > 0i64)) {
        if (rest.ptr[cl] == 40u8) { depth = depth + 1i64; }
        if (rest.ptr[cl] == 41u8) { depth = depth - 1i64; }
        cl = cl + 1i64;
    }
    string:inner = raw text_slice(rest, op + 1i64, cl - 1i64);
    // split on top-level commas
    int64:i = 0i64;
    int64:start = 0i64;
    int64:d2 = 0i64;
    while (i <= inner.len) {
        bool:cut = (i == inner.len);
        if (!cut) {
            uint8:c = inner.ptr[i];
            if ((c == 123u8) || (c == 91u8)) { d2 = d2 + 1i64; }
            if ((c == 125u8) || (c == 93u8)) { d2 = d2 - 1i64; }
            if ((c == 44u8) && (d2 == 0i64)) { cut = true; }
        }
        if (cut) {
            string:piece = raw text_trim(raw text_slice(inner, start, i));
            if (piece.len > 0i64) {
                string:pty = raw type_token(piece);
                string:after = raw text_trim(raw text_slice(piece, pty.len, piece.len));
                // `%name`, possibly after parameter attributes (the floor writes none)
                int64:pc = raw text_find_byte(after, 37u8, 0i64);
                string:pname = "";
                if (pc >= 0i64) {
                    int64:pe = pc;
                    while ((pe < after.len) && (!(raw text_is_ws(after.ptr[pe])))) { pe = pe + 1i64; }
                    pname = raw text_slice(after, pc, pe);
                }
                drop strlist_push(@f.params, pname);
                drop strlist_push(@f.param_tys, pty);
            }
            start = i + 1i64;
        }
        i = i + 1i64;
    }
    pass NIL;
};

pub func:floor_parse = FloorText(string:text) never fails {
    FloorText:ft = FloorText{ fns: raw list_init::<FFn>(180i64), mutable: raw list_init::<string>(48i64),
                              globals: raw list_init::<string>(64i64), global_tys: raw list_init::<string>(64i64),
                              global_inits: raw list_init::<string>(64i64),
                              type_names: raw list_init::<string>(4i64), type_texts: raw list_init::<string>(4i64),
                              asm_syms: raw list_init::<string>(4i64),
                              asm_bodies: raw list_init::<FAsm>(8i64), asm_unread_lines: raw list_init::<int64>(1i64) };
    List<string>:raw_lines = raw text_lines(text);
    bool:in_fn = false;
    FFn:cur = raw ffn_empty();
    int64:i = 0i64 - 1i64;
    while ((i + 1i64) < raw_lines.count) {
        i = i + 1i64;
        string:rawl = raw strlist_view(raw_lines, i);
        // `module asm ".globl X"`: X is a symbol the assembler defines -- read
        // from the raw line, since the code part blanks the string
        if (raw text_starts_with(rawl, "module asm ")) {
            int64:q = raw text_find_byte(rawl, 34u8, 0i64);
            if (q >= 0i64) {
                string:inner = raw text_slice(rawl, q + 1i64, rawl.len);
                if (raw text_starts_with(inner, ".globl ")) {
                    int64:e = raw text_find_byte(inner, 34u8, 7i64);
                    if (e > 7i64) { drop strlist_push(@ft.asm_syms, string_concat("@", raw text_trim(raw text_slice(inner, 7i64, e)))); }
                }
            }
            continue;
        }
        string:line = raw floor_code_part(rawl);
        // AN INSTRUCTION -- OR A DEFINE HEADER -- MAY CONTINUE ON THE NEXT LINE
        // (the clone's call and the string builders' parameter lists end a
        // line with a comma): join until the code part ends in neither `,` nor `(`
        while ((in_fn || (raw text_starts_with(line, "define "))) && (line.len > 0i64) && ((line.ptr[line.len - 1i64] == 44u8) || (line.ptr[line.len - 1i64] == 40u8)) && ((i + 1i64) < raw_lines.count)) {
            i = i + 1i64;
            string:more = raw floor_code_part(raw strlist_view(raw_lines, i));
            line = string_concat(string_concat(line, " "), more);
        }
        if (!in_fn) {
            bool:mut = false;
            string:gty = "";
            string:g = raw global_decl(line, @mut, @gty);
            if (g.len > 0i64) {
                if (mut) { drop strlist_push(@ft.mutable, g); }
                drop strlist_push(@ft.globals, g);
                drop strlist_push(@ft.global_tys, gty);
                // a constant's initialiser, from the RAW line (the code part
                // blanks a `c"..."` string): the text after the type, up to `, align`
                string:init = "";
                if (!mut) {
                    int64:ce = raw text_index_of(rawl, "constant ");
                    if (ce >= 0i64) {
                        string:after = raw text_trim(raw text_slice(rawl, ce + 9i64 + gty.len, rawl.len));
                        int64:al = raw text_index_of(after, ", align");
                        if (al >= 0i64) { after = raw text_trim(raw text_slice(after, 0i64, al)); }
                        init = string_concat(after, "");
                    }
                }
                drop strlist_push(@ft.global_inits, init);
                continue;
            }
            string:tty = "";
            string:tn = raw type_decl(line, @tty);
            if (tn.len > 0i64) {
                drop strlist_push(@ft.type_names, tn);
                drop strlist_push(@ft.type_texts, tty);
                continue;
            }
            string:sym = raw ir_define_sym(line);
            if (sym.len == 0i64) { continue; }
            in_fn = true;
            cur = raw ffn_empty();
            cur.name = move(sym);
            cur.internal = raw text_contains(line, "define internal ");
            drop define_header(line, @cur);
            FBlock:entry = FBlock{ label: "entry", lines: raw list_init::<string>(16i64), succs: raw list_init::<int64>(2i64) };
            drop list_push(@cur.blocks, move(entry));
            continue;
        }
        if (raw text_eq(line, "}")) {
            drop floor_finish(@cur);
            drop list_push(@ft.fns, move(cur));
            cur = raw ffn_empty();
            in_fn = false;
            continue;
        }
        if (line.len == 0i64) { continue; }
        string:lab = raw label_of(line);
        if (lab.len > 0i64) {
            int64:last = cur.blocks.count - 1i64;
            // the implicit first block is renamed by the first label when it
            // has no lines yet (the floor names it `entry:` almost everywhere)
            if ((last == 0i64) && (cur.blocks.items[0i64].lines.count == 0i64)) {
                cur.blocks.items[0i64].label = move(lab);
                continue;
            }
            FBlock:b = FBlock{ label: move(lab), lines: raw list_init::<string>(16i64), succs: raw list_init::<int64>(2i64) };
            drop list_push(@cur.blocks, move(b));
            continue;
        }
        int64:bi = cur.blocks.count - 1i64;
        drop strlist_push(@cur.blocks.items[bi].lines, line);
        FGep:g2 = raw gep_of(line);
        if (g2.reg.len > 0i64) { drop list_push(@cur.geps, move(g2)); }
    }
    drop floor_asm_census(@ft, raw_lines);
    pass ft;
};

// --- THE `module asm` CENSUS (1.5.8 step 2b; DEF-64) -------------------------------------
//
// Until this step the syscall census, TCB.md SS4b and the explorer's transform
// read only `call i64 @npk_sys6(i64 N` in `define` bodies, so a syscall written
// in a `module asm` block -- `rt_sigreturn` (15), the clone trampoline's `clone`
// (56) and the child's `exit` (60) -- was invisible to all three. A symbol is a
// `.globl X` whose `X:` label follows in the same RUN of consecutive `module
// asm` lines; a local label continues it, a directive (`.section`, `.previous`)
// is not an instruction, and a line that is not `module asm` ends the run. A
// `syscall`'s number is read from the instruction IMMEDIATELY before it --
// `mov $N, %eax` (or `%rax`), N one to nine digits, no label between -- and from
// nothing else, so the census never traces what a register holds. `floor.py`'s
// `asm_symbols`, rule for rule.

// `module asm "TEXT"` followed by nothing or a `;` comment: TEXT (a quote inside
// `module asm` is always escaped, so TEXT runs to the next quote), and `ok`.
func:asm_line_text = string(string:rawl, bool->:ok) never fails {
    <-ok = false;
    if (!(raw text_starts_with(rawl, "module asm \""))) { pass ""; }
    int64:e = raw text_find_byte(rawl, 34u8, 12i64);
    if (e < 0i64) { pass ""; }
    string:rest = raw text_trim(raw text_slice(rawl, e + 1i64, rawl.len));
    if ((rest.len > 0i64) && (rest.ptr[0i64] != 59u8)) { pass ""; }
    <-ok = true;
    pass (raw text_slice(rawl, 12i64, e));
};

// `mov`/`movl`/`movq`, whitespace, `$N`, a comma, `%eax` or `%rax`: N (one to
// nine digits), else -1.
func:asm_mov_nr = int64(string:a) never fails {
    int64:i = 0i64;
    if (raw text_starts_with(a, "movl")) { i = 4i64; }
    else {
        if (raw text_starts_with(a, "movq")) { i = 4i64; }
        else {
            if (!(raw text_starts_with(a, "mov"))) { pass (0i64 - 1i64); }
            i = 3i64;
        }
    }
    int64:ws = i;
    while ((i < a.len) && (raw text_is_ws(a.ptr[i]))) { i = i + 1i64; }
    if (i == ws) { pass (0i64 - 1i64); }
    if ((i >= a.len) || (a.ptr[i] != 36u8)) { pass (0i64 - 1i64); }
    i = i + 1i64;
    int64:ds = i;
    int64:v = 0i64;
    while ((i < a.len) && ((i - ds) < 10i64) && (a.ptr[i] >= 48u8) && (a.ptr[i] <= 57u8)) {
        v = (v * 10i64) + ((a.ptr[i] - 48u8) => int64);
        i = i + 1i64;
    }
    if (((i - ds) == 0i64) || ((i - ds) > 9i64)) { pass (0i64 - 1i64); }
    if ((i >= a.len) || (a.ptr[i] != 44u8)) { pass (0i64 - 1i64); }
    i = i + 1i64;
    while ((i < a.len) && (raw text_is_ws(a.ptr[i]))) { i = i + 1i64; }
    string:reg = raw text_slice(a, i, a.len);
    if ((raw text_eq(reg, "%eax")) || (raw text_eq(reg, "%rax"))) { pass v; }
    pass (0i64 - 1i64);
};

// `call`/`callq`/`jmp`/`jmpq` and whitespace: the operand after it, else "".
func:asm_call_operand = string(string:a) never fails {
    int64:i = 0i64;
    if (raw text_starts_with(a, "callq")) { i = 5i64; }
    else {
        if (raw text_starts_with(a, "call")) { i = 4i64; }
        else {
            if (raw text_starts_with(a, "jmpq")) { i = 4i64; }
            else {
                if (!(raw text_starts_with(a, "jmp"))) { pass ""; }
                i = 3i64;
            }
        }
    }
    int64:ws = i;
    while ((i < a.len) && (raw text_is_ws(a.ptr[i]))) { i = i + 1i64; }
    if (i == ws) { pass ""; }
    pass (raw text_slice(a, i, a.len));
};

// A symbol name as the assembler spells one: `[A-Za-z_.$][A-Za-z0-9_.$]*`.
pub func:asm_is_name = bool(string:s) never fails {
    if (s.len == 0i64) { pass false; }
    for (int64:i in 0i64...s.len) {
        uint8:c = s.ptr[i];
        bool:alpha = ((c >= 65u8) && (c <= 90u8)) || ((c >= 97u8) && (c <= 122u8)) || (c == 95u8) || (c == 46u8) || (c == 36u8);
        bool:digit = (c >= 48u8) && (c <= 57u8);
        if (alpha) { continue; }
        if (digit && (i > 0i64)) { continue; }
        pass false;
    }
    pass true;
};

func:floor_asm_census = NIL(FloorText->:ft, List<string>:lines) never fails {
    List<string>:globs = raw list_init::<string>(8i64);
    bool:open = false;
    int64:prev = 0i64 - 1i64;
    for (int64:li in 0i64...lines.count) {
        string:rawl = raw strlist_view(lines, li);
        bool:ok = false;
        string:inner = raw asm_line_text(rawl, @ok);
        if (!ok) {
            if (raw text_starts_with(rawl, "module asm")) { drop list_push(@ft.asm_unread_lines, li + 1i64); }
            open = false;
            prev = 0i64 - 1i64;
            continue;
        }
        string:a = raw text_trim(inner);
        if (raw text_starts_with(a, ".globl ")) {
            drop strlist_push(@globs, raw text_trim(raw text_slice(a, 7i64, a.len)));
            continue;
        }
        if ((a.len == 0i64) || (a.ptr[0i64] == 46u8)) { continue; }
        if (a.ptr[a.len - 1i64] == 58u8) {
            string:label = raw text_slice(a, 0i64, a.len - 1i64);
            if (raw strlist_contains(globs, label)) {
                FAsm:s = FAsm{ name: string_concat("@", label), sys: raw list_init::<int64>(2i64),
                               read: raw list_init::<bool>(2i64), calls: raw list_init::<string>(2i64), indirect: false };
                drop list_push(@ft.asm_bodies, move(s));
                open = true;
            }
            prev = 0i64 - 1i64;
            continue;
        }
        if (!open) { continue; }
        int64:k = ft.asm_bodies.count - 1i64;
        int64:mv = raw asm_mov_nr(a);
        if (mv >= 0i64) { prev = mv; continue; }
        if (raw text_eq(a, "syscall")) {
            drop list_push(@ft.asm_bodies.items[k].sys, prev);
            drop list_push(@ft.asm_bodies.items[k].read, prev >= 0i64);
            prev = 0i64 - 1i64;
            continue;
        }
        prev = 0i64 - 1i64;
        string:op = raw asm_call_operand(a);
        if (op.len == 0i64) { continue; }
        if (op.ptr[0i64] == 42u8) { ft.asm_bodies.items[k].indirect = true; continue; }
        if (raw asm_is_name(op)) { drop strlist_push(@ft.asm_bodies.items[k].calls, string_concat("@", op)); }
    }
    pass NIL;
};

// The successors of every block from its last line's `br` (or `switch`).
// Public since 1.5.6 step 3: a CFG transform (`floor_cfg.npk`) recomputes them.
pub func:floor_finish = NIL(FFn->:f) never fails {
    for (int64:b in 0i64...f.blocks.count) {
        f.blocks.items[b].succs.count = 0i64;
        int64:n = f.blocks.items[b].lines.count;
        if (n == 0i64) { continue; }
        string:last = raw strlist_view(f.blocks.items[b].lines, n - 1i64);
        if (!((raw text_starts_with(last, "br ")) || (raw text_starts_with(last, "switch ")))) { continue; }
        int64:from = 0i64;
        while (true) {
            int64:p = raw text_index_from(last, "label %", from);
            if (p < 0i64) { break; }
            int64:s = p + 7i64;
            int64:e = s;
            while (e < last.len) {
                uint8:c = last.ptr[e];
                if ((c == 44u8) || (c == 32u8)) { break; }
                e = e + 1i64;
            }
            string:lab = raw text_slice(last, s, e);
            int64:ti = raw floor_block_index(f, lab);
            if (ti >= 0i64) { drop list_push(@f.blocks.items[b].succs, ti); }
            from = e;
        }
    }
    pass NIL;
};

pub func:floor_block_index = int64(FFn->:f, string:label) never fails {
    for (int64:i in 0i64...f.blocks.count) {
        if (raw text_eq(raw strlist_view_of(f.blocks.items[i].label), label)) { pass i; }
    }
    pass (0i64 - 1i64);
};

// A view of an owned string (a name of a field), for comparisons.
pub func:strlist_view_of = string(string:s) never fails {
    pass (string_from_bytes(s.ptr, s.len));
};

pub func:floor_fn_index = int64(FloorText->:ft, string:name) never fails {
    for (int64:i in 0i64...ft.fns.count) {
        if (raw text_eq(raw strlist_view_of(ft.fns.items[i].name), name)) { pass i; }
    }
    pass (0i64 - 1i64);
};

// The GEP a register names in `f`, or -1.
pub func:floor_gep_index = int64(FFn->:f, string:reg) never fails {
    for (int64:i in 0i64...f.geps.count) {
        if (raw text_eq(raw strlist_view_of(f.geps.items[i].reg), reg)) { pass i; }
    }
    pass (0i64 - 1i64);
};

pub func:floor_is_mutable = bool(FloorText->:ft, string:global) never fails {
    pass (raw strlist_contains(ft.mutable, global));
};

// The body of a named struct type (`%npk.hdr` -> `{ ptr, i32, ... }`), or "".
pub func:floor_type_body = string(FloorText->:ft, string:name) never fails {
    for (int64:i in 0i64...ft.type_names.count) {
        if (raw text_eq(raw strlist_view_of(ft.type_names.items[i]), name)) { pass (raw strlist_copy(ft.type_texts, i)); }
    }
    pass "";
};

// A global's declared type text, or "" when the module declares no such global.
pub func:floor_global_type = string(FloorText->:ft, string:global) never fails {
    for (int64:i in 0i64...ft.globals.count) {
        if (raw text_eq(raw strlist_view_of(ft.globals.items[i]), global)) { pass (raw strlist_copy(ft.global_tys, i)); }
    }
    pass "";
};

// --- type texts (1.5.6 step 3; the translator and the CFG transforms share them) ----

// `[14 x i64]` -> 14 and `i64`.
pub func:array_count = int64(string:ty) never fails {
    int64:x = raw text_index_of(ty, " x ");
    if (x < 0i64) { pass 0i64; }
    Result<int64>:n = text_int(raw text_slice(ty, 1i64, x));
    if (n.is_error) { pass 0i64; }
    pass n.value;
};

pub func:array_elem = string(string:ty) never fails {
    int64:x = raw text_index_of(ty, " x ");
    if (x < 0i64) { pass ""; }
    pass (raw text_trim(raw text_slice(ty, x + 3i64, ty.len - 1i64)));
};

// `{ ptr, i64, [2 x i32] }` -> its field types, brackets kept whole.
pub func:struct_fields = List<string>(string:ty) never fails {
    List<string>:out = raw list_init::<string>(4i64);
    if (ty.len < 2i64) { pass out; }
    string:inner = raw text_slice(ty, 1i64, ty.len - 1i64);
    int64:i = 0i64;
    int64:start = 0i64;
    int64:depth = 0i64;
    while (i < inner.len) {
        uint8:c = inner.ptr[i];
        if ((c == 123u8) || (c == 91u8)) { depth = depth + 1i64; }
        if ((c == 125u8) || (c == 93u8)) { depth = depth - 1i64; }
        if ((c == 44u8) && (depth == 0i64)) {
            string:f = raw text_trim(raw text_slice(inner, start, i));
            if (f.len > 0i64) { drop strlist_push(@out, f); }
            start = i + 1i64;
        }
        i = i + 1i64;
    }
    string:last = raw text_trim(raw text_slice(inner, start, inner.len));
    if (last.len > 0i64) { drop strlist_push(@out, last); }
    pass out;
};

// A constant global's initialiser text (raw), or "" for a mutable global or
// a global without one.
pub func:floor_global_init = string(FloorText->:ft, string:global) never fails {
    for (int64:i in 0i64...ft.globals.count) {
        if (raw text_eq(raw strlist_view_of(ft.globals.items[i]), global)) { pass (raw strlist_copy(ft.global_inits, i)); }
    }
    pass "";
};
