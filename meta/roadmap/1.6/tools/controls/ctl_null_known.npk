mod:ctl_null_known;
// 1.6.0 control (c'): a NULL dereference through a pointer the analyzer can KNOW is null -- the address is the
// literal 0 (control (c) derives it from an argument, so a sound analyzer sees only an unknown pointer there).
// The source guards the read with `!= NULL` (exit 3 in every build); the PLANT removes the guard's branch, and
// the planted program reads through NULL: MachineFault (exit 99).
func:zero = int32(cstring[]:argv) never fails { pass ((argv.len =>! int32) - 1i32); };
func:main = int32(cstring[]:argv) {
    wild int32->:p = #wild_ptr<int32>(0i64);
    int32:v = 3i32 + (raw zero(argv));
    if (p != NULL) { v = <-p; }
    exit (v & 63i32);
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow)      { exit 96i32; },
        (StackExhausted)   { exit 98i32; },
        (MachineFault)     { exit 99i32; },
        (WildLeak)         { exit 92i32; },
        (Unreachable)      { exit 91i32; },
        (HeapOom)          { exit 94i32; },
        (HeapBadRequest)   { exit 93i32; },
        (*)                { exit 97i32; }
    }
};
