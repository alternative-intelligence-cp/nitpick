// The prelude — what the compiler itself declares.
//
// NOT COMPILED AS PART OF THE FRONTEND. Nothing `use`s this file. It is read by
// `bootstrap/generator/gen_tables.py`, which emits it into
// `src/frontend/prelude_source.npk` as a string constant, and the compiler then
// puts that text through the same lexer, the same parser and the same collector as
// any other module.
//
// SOURCE RATHER THAN SYNTHESIS, and generated rather than hand-escaped, for the two
// reasons the token tables give: a declaration built in code is one a person cannot
// read, and a constant written twice is one that can differ in one of the places.
//
// COLLECTED INTO THE ROOT SCOPE, so these names are in scope everywhere with no
// import. Every module's scope has scope 0 as its parent, so the place already
// existed.

mod:prelude;

// HOW TWO VALUES COMPARE, AS A TYPE RATHER THAN A NUMBER. The prototype's
// `partial_cmp` returned an `int32` meaning less, equal or greater by sign — three
// meanings in one number, which is the shape D-036 rejects for `bool` and `char`.
// An ordering is not an integer either.
pub enum:Ordering = {
    Less;
    Equal;
    Greater;
};

// EQUALITY. Derived field by field, in declaration order.
pub trait:Eq = {
    func:eq = bool(Self:self, Self:other);
};

// A TOTAL ORDER. Every two values compare, which is what makes the result an
// `Ordering` and not an `Ordering?`.
//
// The prototype generated `less_than` returning `bool`, which carries strictly less
// information than a three-way comparison and made `Ord` WEAKER than `PartialOrd` —
// backwards, since `Ord` is the stronger promise.
pub trait:Ord = {
    func:cmp = Ordering(Self:self, Self:other);
};

// AN ORDER THAT MAY HAVE NO ANSWER. Not a second spelling of `Ord` but a different
// promise, which is why it survives where `Display` did not: a `flt64` is IEEE 754
// with `nan` and no trap (OP_REFERENCE), so two of them genuinely may not compare,
// and a total `cmp` over one would have to lie.
pub trait:PartialOrd = {
    func:partial_cmp = Ordering?(Self:self, Self:other);
};

// A VALUE OF THE SAME TYPE, MADE FROM THIS ONE.
pub trait:Clone = {
    func:clone = Self(Self:self);
};

// A HASH FOR A MAP, AND NOT CRYPTOGRAPHY. The derived combiner is FNV-1a and is
// specified rather than left open (D-123), because a derived hash that varies
// between builds is not something a verified compiler can have. Real cryptography
// is `ncrypto`, a separately audited artifact.
pub trait:Hash = {
    func:hash = uint64(Self:self);
};

// THE VALUE AS A STRING, which is what `&{ }` interpolation asks for.
pub trait:ToString = {
    func:to_string = string(Self:self);
};

// THE SAME, IN A DIAGNOSTIC FORM naming the type and its fields. A separate trait
// from `ToString` because the two are read by different audiences: one is what a
// program shows a person, the other is what a person reads while debugging.
pub trait:Debug = {
    func:debug = string(Self:self);
};

// WHAT A `for` LOOP DRIVES (D-166). `next` advances and yields the element, or
// `NIL` when the iteration is over — `Item?` is why this was undecidable before
// `Optional` lowered (1.0.7). The receiver is `Self->`: `next` mutates the
// iterator's position, so it takes it by pointer, the one trait method that does.
pub trait:Iterator = {
    assoc:Item;
    func:next = Item?(Self->:self);
};

// `to_string` FOR THE BUILTIN SCALARS (D-168, 1.0.9d), so `&{ x }` renders
// without a program writing the impl. The integers widen losslessly into `i64`
// and go through the floor's `int_to_string`; `bool` is its two words. The
// remaining scalars — the characters (UTF-8), the `tbb` widths (ERR), the kernel
// identifiers, `uint64` (its high bit) and the floats (a correct float->decimal
// in the floor) — arrive with their own careful conversions.
impl:int8:ToString   = { func:to_string = string(int8:self) never fails   { pass (raw int_to_string(self => int64)); }; };
impl:int16:ToString  = { func:to_string = string(int16:self) never fails  { pass (raw int_to_string(self => int64)); }; };
impl:int32:ToString  = { func:to_string = string(int32:self) never fails  { pass (raw int_to_string(self => int64)); }; };
impl:int64:ToString  = { func:to_string = string(int64:self) never fails  { pass (raw int_to_string(self)); }; };
impl:uint8:ToString  = { func:to_string = string(uint8:self) never fails  { pass (raw int_to_string(self => int64)); }; };
impl:uint16:ToString = { func:to_string = string(uint16:self) never fails { pass (raw int_to_string(self => int64)); }; };
impl:uint32:ToString = { func:to_string = string(uint32:self) never fails { pass (raw int_to_string(self => int64)); }; };
impl:bool:ToString   = { func:to_string = string(bool:self) never fails   { if (self) { pass "true"; } pass "false"; }; };

impl:uint64:ToString = { func:to_string = string(uint64:self) never fails { pass (raw uint_to_decimal(self)); }; };

// THE `tbb` WIDTHS RENDER `ERR` OR THE NUMBER (D-008, D-168). ERR is the taint,
// shown as itself; everything else is the value, read through the checked cast
// the `is_err` guard makes safe.
impl:tbb8:ToString  = { func:to_string = string(tbb8:self) never fails  { if (is_err(self)) { pass "ERR"; } pass (raw int_to_string(self => int64)); }; };
impl:tbb16:ToString = { func:to_string = string(tbb16:self) never fails { if (is_err(self)) { pass "ERR"; } pass (raw int_to_string(self => int64)); }; };
impl:tbb32:ToString = { func:to_string = string(tbb32:self) never fails { if (is_err(self)) { pass "ERR"; } pass (raw int_to_string(self => int64)); }; };
impl:tbb64:ToString = { func:to_string = string(tbb64:self) never fails { if (is_err(self)) { pass "ERR"; } pass (raw int_to_string(self => int64)); }; };

// THE KERNEL IDENTIFIERS RENDER THEIR NUMBER (D-042, D-168): a handle's value is
// readable even though a handle is not forgeable.
impl:fd:ToString  = { func:to_string = string(fd:self) never fails  { pass (raw int_to_string(self => int64)); }; };
impl:pid:ToString = { func:to_string = string(pid:self) never fails { pass (raw int_to_string(self => int64)); }; };
impl:tid:ToString = { func:to_string = string(tid:self) never fails { pass (raw int_to_string(self => int64)); }; };
impl:uid:ToString = { func:to_string = string(uid:self) never fails { pass (raw int_to_string(self => int64)); }; };
impl:gid:ToString = { func:to_string = string(gid:self) never fails { pass (raw int_to_string(self => int64)); }; };

// UNSIGNED DECIMAL (D-168), for `uint64`, whose high half the floor's signed
// `int_to_string` renders as a negative. Unsigned division here is the language's
// own — `uint64 / 10` and `% 10` are unsigned because the type is — so the digits
// come out right whatever the high bit. The lower unsigned widths fit in `int64`
// and go through `int_to_string` losslessly; only `uint64` needs this.
pub func:digit_char = string(uint64:d) never fails {
    if (d == 0u64) { pass "0"; }
    if (d == 1u64) { pass "1"; }
    if (d == 2u64) { pass "2"; }
    if (d == 3u64) { pass "3"; }
    if (d == 4u64) { pass "4"; }
    if (d == 5u64) { pass "5"; }
    if (d == 6u64) { pass "6"; }
    if (d == 7u64) { pass "7"; }
    if (d == 8u64) { pass "8"; }
    pass "9";
};

pub func:uint_to_decimal = string(uint64:v) never fails {
    if (v == 0u64) { pass "0"; }
    string:acc = "";
    uint64:n = v;
    while (n > 0u64) {
        string:d = raw digit_char(n % 10u64);
        acc = raw string_concat(d, acc);
        n = n / 10u64;
    }
    pass acc;
};

// FNV-1a, THE DERIVED HASH (D-123). The combiner is specified so a derived hash
// is the same across builds -- a verified compiler cannot have one that drifts.
// The offset basis (0xcbf29ce484222325) is past the 64-bit literal envelope, so it
// is built from its two words; the prime fits.
pub func:fnv_offset = uint64() never fails { pass ((3421887204u64 << 32u64) | 2216829733u64); };
pub func:fnv_mix = uint64(uint64:h, uint64:v) never fails { pass ((h ^ v) * 1099511628211u64); };

// A SCALAR HASHES ITS VALUE (D-123); a derived struct hash combines its fields
// the same way, so the whole is FNV-1a over the parts.
impl:int8:Hash = { func:hash = uint64(int8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:int16:Hash = { func:hash = uint64(int16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:int32:Hash = { func:hash = uint64(int32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:int64:Hash = { func:hash = uint64(int64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:uint8:Hash = { func:hash = uint64(uint8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:uint16:Hash = { func:hash = uint64(uint16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:uint32:Hash = { func:hash = uint64(uint32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:uint64:Hash = { func:hash = uint64(uint64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self)); }; };
impl:bool:Hash = { func:hash = uint64(bool:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:char8:Hash = { func:hash = uint64(char8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:char16:Hash = { func:hash = uint64(char16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:char32:Hash = { func:hash = uint64(char32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:fd:Hash = { func:hash = uint64(fd:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:pid:Hash = { func:hash = uint64(pid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:tid:Hash = { func:hash = uint64(tid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:uid:Hash = { func:hash = uint64(uid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };
impl:gid:Hash = { func:hash = uint64(gid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };

// A tbb HASHES ERR AS A FIXED WORD, ITS VALUE OTHERWISE (D-008): the checked read
// cannot touch ERR, so the guard comes first.
impl:tbb8:Hash = { func:hash = uint64(tbb8:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:tbb16:Hash = { func:hash = uint64(tbb16:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:tbb32:Hash = { func:hash = uint64(tbb32:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };
impl:tbb64:Hash = { func:hash = uint64(tbb64:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };

// A string CLONES BY ALLOCATING A FRESH BODY (D-183). This is the language's
// one spelling for "I genuinely want a second owner": explicit at the call
// site (`x.clone()`), greppable, and it allocates — which is exactly why it is
// not what assignment does. Concatenation with the empty string IS the fresh
// copy, and the result carries `cap = n`, so the clone owns its body and drops
// it independently of the original.
impl:string:Clone = { func:clone = string(string:self) {
    pass (relay string_concat(self, ""));
}; };

// A string HASHES ITS BYTES (D-123) -- FNV-1a is over bytes, and self.ptr[i] walks
// them.
impl:string:Hash = { func:hash = uint64(string:self) never fails {
    uint64:h = raw fnv_offset();
    int64:i = 0i64;
    while (i < self.len) {
        h = raw fnv_mix(h, self.ptr[i] => uint64);
        i = i + 1i64;
    }
    pass h;
}; };

// --- the deadline substrate (D-176, 1.1.3) -----------------------------------
//
// `Duration` is a span of time as int64 NANOSECONDS — one word, one compare,
// ±292 years. Deadline parameters take one, RELATIVE, named `within`; the
// executor converts to an absolute monotonic timepoint once, at suspension
// entry. The constructors' multiplications ride ordinary int64 arithmetic,
// whose overflow traps (D-142) — a span past ±292 years is a controlled stop.
pub struct:Duration = { int64:ns; };

pub func:duration_ns = Duration(int64:n) never fails {
    pass Duration{ ns: n };
};
pub func:duration_ms = Duration(int64:ms) never fails {
    pass Duration{ ns: ms * 1000000i64 };
};
pub func:duration_secs = Duration(int64:s) never fails {
    pass Duration{ ns: s * 1000000000i64 };
};

// --- the system error family (D-179) -----------------------------------------------
//
// D-142's table as DECLARATIONS — the same fixed codes npkrt.ll hardcodes
// (its values are the stability constraint), now named. The explicit-code
// form is legal here and nowhere else: the SYSTEM domain is exactly what the
// prelude declares, its sign an encoding detail the compiler owns (stored
// negated). User programs name these in `failsafe` picks; they cannot
// declare into the family, so identity can never be forged.
pub error:DivByZero = 4097i32;         // division or remainder by zero (the 0.7 guard)
pub error:DivOverflow = 4098i32;       // MIN / -1 — the one signed division that overflows
pub error:OutOfBounds = 4099i32;       // an index outside its array, slice or range
pub error:TbbErr = 4100i32;            // ERR at a bare comparison / checked cast out of tbb (D-008 s5, D-144)
pub error:BadStep = 4101i32;           // a counted loop's step was not positive at runtime (D-142)
pub error:Unreachable = 4102i32;       // #unreachable() reached, and the runtime's integrity defects (D-061, D-153)
pub error:HeapOom = 4103i32;           // mmap failure — the allocation-free trap path (D-153)
pub error:HeapBadRequest = 4104i32;    // negative size; count*size overflow (D-153)
pub error:WildLeak = 4105i32;          // a `wild` allocation outlived exit 0 (D-151)
pub error:StaleHandle = 4106i32;       // an arena handle outlived its slot's generation (D-152)
pub error:DeadlineExceeded = 4107i32;  // time ran out (D-176): the Result error AND the join's trap
pub error:ChannelClosed = 4108i32;     // a `send` to, or a drained `recv` from, a closed channel (D-072/D-182)
pub error:IoEof = 4096i32;             // end of input (the io floor's marker, distinct from every errno)

// --- waiting (D-071, 1.1.8) --------------------------------------------------
//
// THE ONE WAITING PRIMITIVE, and everything that blocks is built from it.
// `await sleep(within)` suspends the TASK: the executor takes the park
// request and sleeps the thread only when it has nothing else runnable, so
// a waiting task can never stall a sibling (D-071's whole point). The
// deadline is ABSOLUTE and monotonic by the time the kernel sees it — the
// span is converted once, here, at suspension entry (D-176 rule 2).
pub async func:sleep = NIL(Duration:within) {
    drop suspend_until((raw mono_now()) + within.ns);
    pass NIL;
};

// `await io_ready(fd, events, within)` (B-3a, 1.1.12a): suspend until the
// descriptor is ready for `events` (EPOLLIN 1, EPOLLOUT 4) or the deadline
// passes — the reactor's one wait. One registration, one park, one return:
// a resume past the deadline is the deadline's, and reports it; a resume
// before it means READINESS WAS SIGNALLED — retry the syscall, and if it
// still would block (stolen by a sibling, a spurious wake), call this
// again. The stream types are loops around exactly that.
pub async func:io_ready = NIL(int32:iofd, int32:events, Duration:within) {
    int64:io_abs = (raw mono_now()) + within.ns;
    // The registration lives exactly as long as the wait: a one-shot left
    // armed past this frame would fire into freed memory. Every exit --
    // readiness, deadline, wind-up -- runs this.
    defer { drop io_unwatch(iofd); }
    drop suspend_io(iofd, events, io_abs);
    if ((raw mono_now()) >= io_abs) { fail DeadlineExceeded; }
    pass NIL;
};

// --- the streams (D-185, 1.1.12b; IO_REFERENCE) -------------------------------
//
// TWO ERRNOS, NAMED, because every stream loop must tell them from real
// failures: the kernel's own codes ride the error word verbatim (negative,
// disjoint from the 4096+ system family), and these are the two that mean
// "again", not "broken". Naming more of the errno space is a decision for
// the code that needs it.
pub error:WouldBlock = 11i32;      // EAGAIN — not ready; wait for readiness and retry
pub error:Interrupted = 4i32;      // EINTR — a signal cut the call; retry immediately

// A PATH IS PARSED, NOT PASSED AROUND AS A STRING (D-051/D-054): absolute,
// lexically normalized, no interior NUL. Normalization here is LEXICAL —
// D-054's warning stands: it does not survive symlinks, and containment
// wants openat + O_NOFOLLOW, not a string check.
pub error:BadPath;
pub struct:Path = { string:text; };

pub func:path_parse = Path(string:s) {
    if (s.len == 0i64)        { fail BadPath; }
    if (s.ptr[0i64] != 47u8)  { fail BadPath; }   // absolute, or it is not a Path
    string:out = "";
    int64:depth = 0i64;
    int64:i = 1i64;
    int64:seg = 1i64;
    while (i <= s.len) {
        bool:at_end = (i == s.len);
        uint8:c = 0u8;
        if (!at_end) {
            c = s.ptr[i];
            if (c == 0u8) { fail BadPath; }       // interior NUL: the poison byte
        }
        if (at_end || (c == 47u8)) {
            int64:sl = i - seg;
            if (sl > 0i64) {
                string:sgt = relay string_slice(s, seg, i);
                bool:dot = string_equals(sgt, ".");
                if (!dot) {
                    if (string_equals(sgt, "..")) {
                        // ".." above the root is not a path, it is an escape.
                        if (depth == 0i64) { fail BadPath; }
                        int64:j = out.len - 1i64;
                        while (j >= 0i64) {
                            if (out.ptr[j] == 47u8) { break; }
                            j = j - 1i64;
                        }
                        // string_slice returns a VIEW (cap 0) into the
                        // body this assignment is about to free — concat
                        // with "" copies it into a body of its own first.
                        // (The silent view-over-owner hazard is recorded in
                        // D-185 / OPEN_DECISIONS: the type cannot yet say
                        // "view", so the discipline is the author's.)
                        string:kept = relay string_slice(out, 0i64, j);
                        out = relay string_concat(kept, "");
                        depth = depth - 1i64;
                    }
                    if (!(string_equals(sgt, ".."))) {
                        out = relay string_concat(out, "/");
                        out = relay string_concat(out, sgt);
                        depth = depth + 1i64;
                    }
                }
            }
            seg = i + 1i64;
        }
        i = i + 1i64;
    }
    if (out.len == 0i64) {
        string:root = relay string_concat("/", "");
        pass Path{ text: move(root) };
    }
    pass Path{ text: move(out) };
};

// THE STREAM TRAITS (IO_REFERENCE §1): every operation is async, returns
// Result, and carries a deadline — there is no unbounded read. Receivers are
// `Self->` (the spec's by-value self predates the move-only rule for owners:
// a by-value receiver would CONSUME the stream per call). `dyn Writer` is
// 1.1.12d's stage; concrete impls dispatch statically today.
pub trait:Reader = {
    async func:read = int64(Self->:self, uint8[]:dest, Duration:within);
};
pub trait:Writer = {
    async func:write = int64(Self->:self, fixed uint8[]:wsrc, Duration:within);
    async func:flush = NIL(Self->:self, Duration:within);
};

// WHERE A SEEK MEASURES FROM (IO_REFERENCE §7) — an enum, not an integer.
pub enum:Whence = { Start; Current; End; };

// THE BYTE STREAMS (IO_REFERENCE §3): no translation, ever. The OwnedFd
// field is the lifetime story — scope exit drops the stream, the struct
// drop reaches the descriptor, and the descriptor's drop closes it. That is
// the whole of "there is no close in the surface" (§6). Descriptors are
// opened NONBLOCK + CLOEXEC: every wait is a task suspension through
// io_ready, never a parked thread (D-071).
pub struct:ByteReader = { OwnedFd:src; };
pub struct:ByteWriter = { OwnedFd:sink; };

// The open itself is the one synchronous hop (epoll cannot wait for open;
// io_uring is refused before Astrée — D-184): `within` governs the waits
// the stream performs after it.
pub func:byte_reader_open = ByteReader(Path:p, Duration:_~within) {
    cstring:cp = relay to_cstring(p.text);
    // O_RDONLY | O_NONBLOCK | O_CLOEXEC
    fd:f = relay open(cp, 526336i64, 0i64);
    pass ByteReader{ src: own_fd(f) };
};

pub func:byte_writer_create = ByteWriter(Path:p, Duration:_~within) {
    cstring:cp = relay to_cstring(p.text);
    // O_WRONLY | O_CREAT | O_TRUNC | O_NONBLOCK | O_CLOEXEC, mode 0644
    fd:f = relay open(cp, 526913i64, 420i64);
    pass ByteWriter{ sink: own_fd(f) };
};

// THE RETRY LOOP (D-184's contract): a resume from io_ready means readiness
// was SIGNALLED — the syscall is re-tried, and a retry that still would
// block waits again on the time that remains. EAGAIN and EINTR retry;
// everything else — IoEof included — is the caller's to handle, forwarded
// verbatim (`fail r.err`, the 05_result rule).
impl:ByteReader:Reader = {
    async func:read = int64(ByteReader->:self, uint8[]:dest, Duration:within) {
        int64:give_up = (raw mono_now()) + within.ns;
        while (true) {
            Result<int64>:r = read(self.src.value, dest.ptr, dest.len);
            if (!r.is_error) { pass r.value; }
            bool:retry = false;
            if (r.err == WouldBlock)  { retry = true; }
            if (r.err == Interrupted) { retry = true; }
            if (!retry) { fail r.err; }
            if (r.err == WouldBlock) {
                int64:rem = give_up - (raw mono_now());
                if (rem <= 0i64) { fail DeadlineExceeded; }
                Result<NIL>:w = await io_ready((self.src.value) =>! int32, 1i32,
                                               raw duration_ns(rem));
                if (w.is_error) { fail w.err; }
            }
        }
    };
};

impl:ByteWriter:Writer = {
    async func:write = int64(ByteWriter->:self, fixed uint8[]:wsrc, Duration:within) {
        int64:give_up = (raw mono_now()) + within.ns;
        while (true) {
            Result<int64>:r = write(self.sink.value, wsrc.ptr, wsrc.len);
            if (!r.is_error) { pass r.value; }
            bool:retry = false;
            if (r.err == WouldBlock)  { retry = true; }
            if (r.err == Interrupted) { retry = true; }
            if (!retry) { fail r.err; }
            if (r.err == WouldBlock) {
                int64:rem = give_up - (raw mono_now());
                if (rem <= 0i64) { fail DeadlineExceeded; }
                Result<NIL>:w = await io_ready((self.sink.value) =>! int32, 4i32,
                                               raw duration_ns(rem));
                if (w.is_error) { fail w.err; }
            }
        }
    };
    // Nothing is buffered at this layer (buffering is an explicit wrapper —
    // IO_REFERENCE §4), so a flush has nothing to move — but the trait
    // carries it so a buffered writer can stand wherever this one does.
    async func:flush = NIL(ByteWriter->:self, Duration:_~within) {
        pass NIL;
    };
};

// SEEK (IO_REFERENCE §7): the new position, from an enum'd origin. lseek
// does not block, so the deadline is carried for shape and unspent.
impl:ByteReader = {
    async func:seek = int64(ByteReader->:self, Whence:w, int64:off, Duration:_~within) {
        int64:wh = 0i64;
        pick (w) {
            (Whence.Start)   { wh = 0i64; },
            (Whence.Current) { wh = 1i64; },
            (Whence.End)     { wh = 2i64; }
        }
        int64:np = relay sys(8i64, (self.src.value) =>! int64, off, wh);
        pass np;
    };
};
