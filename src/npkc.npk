// npkc — the Nitpick compiler.
//
// Cycle 0.7.8, the first `main` this project has had: `nitpick.toml`'s
// `entry = "src/npkc.npk"` stops being aspiration. It reads one root, runs the
// whole front half (`src/driver/pipeline.npk`), and either reports diagnostics —
// codes and spans, one per line — or writes the program's LLVM IR to stdout.
//
// STDOUT IS THE PRODUCT; STDERR IS THE REPORT. The IR goes to stdout (or with
// `-o` to a file); diagnostics go to stderr through the line-disciplined,
// UNBUFFERED writer (D-076) — which is why `npkc bad.npk > out.ll` shows its
// errors instead of burying them in the redirect, and why they survive a trap.
//
// IT WRITES TEXT — and nothing else. It could not spawn `llc` when it was
// written (subset 1 had no process spawning) and it does not once it can:
// `llc` and `ld.lld` are the build system's to invoke (BUILD_REFERENCE §4;
// `npkg build` under D-206), which is the honest shape — the compiler's output
// IS the IR, and what a build does with it is the build's.
//
//   npkc <root.npk>              IR on stdout
//   npkc <root.npk> -o <out.ll>  IR written to the file, stdout silent
//   --obligations <dir>          also write the program's proof obligations
//                                (one SMT-LIB2 file per function, index.txt,
//                                rows.txt) into <dir> (1.5.0, D-218)
//   --elide <nitpick.obligations>  emit the VERIFIED build: every guard the
//                                manifest records as discharged gives way to
//                                `llvm.assume` of the proven fact (D-219)
//   --extra-picky=no-wildx       the high-assurance build mode (D-035)
//
// Exit codes, the same contract every tool holds:
//
//   0   clean — the IR was delivered
//   1   diagnostics (codes and spans on stderr; no IR)
//   2   could not read the input, or could not write the output
//   3   the COMPILER trapped — a defect in it, never in the input

mod:npkc;
use "./driver/pipeline.npk".*;
use "../lib/nio.npk".*;
use "./frontend/source_location.npk".*;
use "./frontend/intern.npk".*;
use "./frontend/diagnostics.npk".*;
use "./frontend/diag_writer.npk".*;
use "./frontend/source.npk".*;
use "./backend/ir/ir_writer.npk".*;
use "./backend/emit_program.npk".*;
use "./frontend/type_resolve.npk".*;
use "./frontend/types.npk".*;
use "./frontend/ast.npk".*;
use "./frontend/analysis/bindings.npk".*;
use "./frontend/analysis/escape.npk".*;
use "./frontend/expr_types.npk".*;
use "./frontend/analysis/locks.npk".*;
use "./frontend/module_graph.npk".*;
use "./frontend/resolve_path.npk".*;
use "./frontend/symbols.npk".*;
use "./frontend/token.npk".*;
use "./frontend/type_trait.npk".*;
use "./frontend/paths.npk".*;
use "./backend/smt/smt_table.npk".*;
use "./backend/smt/smt_manifest.npk".*;
use "../lib/nfs.npk".*;
use "../lib/nsys.npk".*;

// The renderer moved to `diag_report` (diag_writer.npk) at 1.4.7 step 1:
// ONE walk -- generic and borrowing since D-229 -- where this file, check,
// resolve_check and parse_check each kept their own copy of the loop.

func:USAGE = string() never fails {
    pass "usage: npkc <root.npk> [-o out.ll] [--obligations DIR] [--elide nitpick.obligations] [--extra-picky=no-wildx]";
};

async func:main = int32(cstring[]:argv) {
    // THE ARGUMENT TABLE (1.5.0). `-o` was parsed positionally while it was
    // the one flag, with a note that the second flag would make this a
    // table; the third and fourth did. Every flag is order-free, given at
    // most once, and an argument this does not know is a usage error: a
    // misspelled flag must never be read as the root file.
    string:root = "";
    string:out_path = "";
    string:obl_dir = "";
    string:elide_path = "";
    bool:no_wildx = false;
    int64:ai = 1i64;
    while (ai < argv.len) {
        string:a = string_from_bytes(argv[ai].ptr, argv[ai].len);
        if (raw string_eq(a, "-o") || raw string_eq(a, "--obligations") || raw string_eq(a, "--elide")) {
            if ((ai + 1i64) >= argv.len) {
                await diag_say(string_concat(a, " needs an argument")) ?| NIL;
                await diag_say(raw USAGE()) ?| NIL;
                exit 2i32;
            }
            string:val = string_from_bytes(argv[ai + 1i64].ptr, argv[ai + 1i64].len);
            if (raw string_eq(a, "-o")) {
                if (out_path.len > 0i64) { await diag_say("-o given twice") ?| NIL; exit 2i32; }
                out_path = move(val);
            } else {
                if (raw string_eq(a, "--obligations")) {
                    if (obl_dir.len > 0i64) { await diag_say("--obligations given twice") ?| NIL; exit 2i32; }
                    obl_dir = move(val);
                } else {
                    if (elide_path.len > 0i64) { await diag_say("--elide given twice") ?| NIL; exit 2i32; }
                    elide_path = move(val);
                }
            }
            ai = ai + 2i64;
            continue;
        }
        if (raw string_eq(a, "--extra-picky=no-wildx")) {
            no_wildx = true;
            ai = ai + 1i64;
            continue;
        }
        if (a.len > 0i64) {
            if (a.ptr[0i64] == 45u8) {
                await diag_say(string_concat("unknown argument: ", a)) ?| NIL;
                await diag_say(raw USAGE()) ?| NIL;
                exit 2i32;
            }
        }
        if (root.len > 0i64) {
            await diag_say("npkc takes one root file") ?| NIL;
            await diag_say(raw USAGE()) ?| NIL;
            exit 2i32;
        }
        root = move(a);
        ai = ai + 1i64;
    }
    if (root.len == 0i64) {
        await diag_say(raw USAGE()) ?| NIL;
        exit 2i32;
    }

    // THE OBLIGATION TABLE (1.5.0, P-3): what `--obligations` fills and what
    // `--elide` reads. The manifest is read before the front half runs, so a
    // file this compiler cannot vouch for is refused before any work.
    ObTable:obl = raw obtable_init(obl_dir.len > 0i64);
    bool:verify_on = (obl_dir.len > 0i64) || (elide_path.len > 0i64);
    if (elide_path.len > 0i64) {
        Result<cstring>:ec = to_cstring(elide_path);
        if (ec.is_error) { await diag_say("npkc: --elide: not a path") ?| NIL; exit 2i32; }
        Result<string>:et = read_file(ec.value);
        if (et.is_error) { await diag_say("npkc: --elide: the manifest cannot be read") ?| NIL; exit 2i32; }
        ObManifest:man = raw man_parse(et.value);
        if (!man.ok) { await diag_say(string_concat("npkc: --elide: ", man.problem)) ?| NIL; exit 2i32; }
        obl.elide = raw man_discharged(move(man));
    }

    // Declared UNINITIALISED and filled by the pipeline through the pointer —
    // the graph inside holds a pointer to the intern table beside it, so the
    // whole Front must sit in one frame before any wiring happens. `$$m`, not
    // `@`: the MUTABLE borrow is the out-parameter spelling — it says in source
    // that the callee writes this, and the definite-assignment analysis credits
    // exactly that spelling as the assignment (D-010). `@f` here would be
    // refused, correctly: an immutable borrow of memory nothing has written is
    // a read of it.
    Front:f;
    int32:fr = raw front_run($$m f, root);
    if (fr == 2i32) { exit 2i32; }
    if (fr != 0i32) {
        await diag_report_stderr(@f.diags, @f.g.sm) ?| NIL;
        exit 1i32;
    }

    // The build-mode exclusion runs on a clean front half: it is a refusal
    // about what may be built, not about whether the program type-checks.
    if (no_wildx) {
        if ((raw reject_wildx($$m f)) > 0i32) {
            await diag_report_stderr(@f.diags, @f.g.sm) ?| NIL;
            exit 1i32;
        }
    }

    // The backend, INTO A BUFFER: a rung refusal can arrive after half the
    // module is written, and half a module beside an error report is an output
    // nobody can consume. The IR leaves the process only once it is known whole.
    IrWriter:w = raw irw_to_buffer();
    InstanceTable:einst = raw insttable_init();
    TypeResolver:tr = raw tyres_init(@f.g.ast, @f.types, @f.g.tab, @f.it,
                                     @f.diags, @einst);
    bool:emitted = raw emit_all(@w, @f.g, @f.types, @f.it, @f.ets, @tr,
                                    @f.fninsts, @f.im, @f.diags, @obl, verify_on);
    if (!emitted) {
        await diag_report_stderr(@f.diags, @f.g.sm) ?| NIL;
        exit 1i32;
    }
    // THE OBLIGATION FILES (1.5.0, P-6): one `.smt2` per function with rows,
    // the index and the row list, into `--obligations`' directory (created
    // if absent; an existing one is fine).
    if (obl_dir.len > 0i64) {
        if (!(raw obl_write_dir(obl_dir, @obl))) {
            await diag_say("npkc: --obligations: the directory or a file in it could not be written") ?| NIL;
            exit 2i32;
        }
    }
    string:ir = raw irw_text(@w);
    if (out_path.len > 0i64) {
        // THROUGH THE FLOOR'S WHOLE-FILE WRITE, whose loop retries short writes
        // and whose failed close is a failed write — an .ll that silently lost
        // its tail would be a program that assembles to something other than
        // what was compiled.
        // `-o`'s path is user input: an interior NUL names no file (D-049)
        // and is reported like any other unwritable path — under `raw` it
        // became a garbage cstring, which was a live bug this sweep found.
        Result<cstring>:oc = to_cstring(out_path);
        if (oc.is_error) {
            await diag_say("npkc: cannot write the output file") ?| NIL;
            exit 2i32;
        }
        Result<NIL>:wr = write_file(oc.value, ir);
        if (wr.is_error) {
            await diag_say("npkc: cannot write the output file") ?| NIL;
            exit 2i32;
        }
        wild_release_all();
        exit 0i32;
    }
    // The IR is BYTES already carrying its `\n`s — the byte path, not a text
    // writer: nothing here may translate the product (D-050, binary side).
    Result<NIL>:pr = nio_write_all(raw nio_stdout_fd(),
                                   ir.ptr =>! wild int8->, ir.len);
    if (pr.is_error) {
        await diag_say("npkc: cannot write the IR to stdout") ?| NIL;
        exit 2i32;
    }
    wild_release_all();
    exit 0i32;
};

// The obligation directory: `dir` absolute or relative to the working
// directory; created when absent; then every file through the floor's
// whole-file write. False on any refusal -- the caller reports it.
func:obl_write_dir = bool(string:dir, ObTable->:t) never fails {
    string:abs = string_concat(dir, "");
    if (!(raw path_is_absolute(abs))) {
        Result<string>:cw = sys_cwd();
        if (cw.is_error) { pass false; }
        abs = raw path_normalise(raw path_join(cw.value, dir));
    }
    Result<Path>:parent = path_parse(raw path_dirname(abs));
    if (parent.is_error) { pass false; }
    Result<fd>:pd = dir_open(parent.value);
    if (pd.is_error) { pass false; }
    Result<NIL>:mk = mkdir_at(pd.value, raw path_basename(abs));
    Result<NIL>:cl = close(pd.value);
    if (mk.is_error) { if (mk.err != Exists) { pass false; } }
    if (cl.is_error) { pass false; }
    for (int64:i in 0i64...t.files.count) {
        string:name = string_concat(raw file_number(i + 1i64), ".smt2");
        Result<cstring>:fc = to_cstring(raw path_join(abs, name));
        if (fc.is_error) { pass false; }
        Result<NIL>:w = write_file(fc.value, string_from_bytes(t.files.items[i].ptr, t.files.items[i].len));
        if (w.is_error) { pass false; }
    }
    Result<cstring>:ic = to_cstring(raw path_join(abs, "index.txt"));
    if (ic.is_error) { pass false; }
    Result<NIL>:iw = write_file(ic.value, raw obl_index_text(t));
    if (iw.is_error) { pass false; }
    Result<cstring>:rc = to_cstring(raw path_join(abs, "rows.txt"));
    if (rc.is_error) { pass false; }
    Result<NIL>:rw = write_file(rc.value, raw obl_rows_text(t));
    if (rw.is_error) { pass false; }
    pass true;
};

func:failsafe = int32(Error:e) {
    // Every defect family this program can die from, NAMED
    // (D-179) — the doctrine applied to ourselves. Exit 3 for
    // each: a defect in the COMPILER, never the input's error.
    pick (e) {
        (DeadlineExceeded) { exit 3i32; },
        (DivByZero) { exit 3i32; },
        (DivOverflow) { exit 3i32; },
        (HeapBadRequest) { exit 3i32; },
        (HeapOom) { exit 3i32; },
        (IntOverflow) { exit 3i32; },
        (OutOfBounds) { exit 3i32; },
        (Unreachable) { exit 3i32; },
        (WildLeak) { exit 3i32; },
        (BadPath) { exit 3i32; },
        (EFsPath) { exit 3i32; },
        (EFsIndex) { exit 3i32; },
        (EFsRecord) { exit 3i32; },
        (ast.BoundsId) { exit 3i32; },
        (ast.BoundsScratch) { exit 3i32; },
        (ast.BoundsWindow) { exit 3i32; },
        (bindings.Rederived) { exit 3i32; },
        (diagnostics.BoundsId) { exit 3i32; },
        (escape.Rederived) { exit 3i32; },
        (expr_types.BoundsId) { exit 3i32; },
        (intern.BoundsId) { exit 3i32; },
        (intern.ProvenSlice) { exit 3i32; },
        (locks.Rederived) { exit 3i32; },
        (module_graph.BoundsIndex) { exit 3i32; },
        (module_graph.ProvenSlice) { exit 3i32; },
        (resolve_path.BoundsIndex) { exit 3i32; },
        (source.BoundsIndex) { exit 3i32; },
        (source.BoundsOffset) { exit 3i32; },
        (source.FileUnknown) { exit 3i32; },
        (symbols.BoundsId) { exit 3i32; },
        (token.BoundsId) { exit 3i32; },
        (type_trait.BoundsBound) { exit 3i32; },
        (type_trait.BoundsImpl) { exit 3i32; },
        (types.BoundsId) { exit 3i32; },
        (types.BoundsIndex) { exit 3i32; },
        (*) { exit 3i32; }
    }
    exit 3i32;
};
