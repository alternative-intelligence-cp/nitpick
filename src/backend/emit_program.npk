// A whole program, as one LLVM module.
//
// Cycle 0.7.7. The walker the driver calls: preamble, every function of every
// module, string constants — into ONE buffer, in ONE order, because D-078's
// fixpoint compares bytes and iteration order is part of the output.
//
// A REFUSAL IS A DIAGNOSTIC, NOT A STOP. Every function is attempted, so one
// out-of-rung construct reports once and the rest of the program still gets
// checked against the rung — the same shape as the frontend, where one bad
// expression does not hide the next. The IR text is DISCARDED whenever any
// refusal was recorded; a module with a hole in it is not a module.

mod:emit_program;

use "../frontend/source_location.npk".*;
use "../frontend/intern.npk".*;
use "../frontend/ast_kind.npk".*;
use "../frontend/ast.npk".*;
use "../frontend/parse_decl.npk".*;
use "../frontend/parser.npk".*;   // QUAL_FIXED (D-165, D-211)
use "../frontend/diagnostics.npk".*;
use "../frontend/symbols.npk".*;
use "../frontend/module_graph.npk".*;
use "../frontend/source.npk".*;
use "../frontend/paths.npk".*;
use "../frontend/types.npk".*;
use "../frontend/expr_types.npk".*;
use "../frontend/resolve_type.npk".*;
use "../frontend/type_layout.npk".*;
use "../frontend/type_names.npk".*;
use "../frontend/type_trait.npk".*;   // trait_binding, for a generic trait's thunk
use "../frontend/type_generic.npk".*;
use "./ir/emit_codes.npk".*;
use "./ir/ir_writer.npk".*;
use "./ir/ir_types.npk".*;
use "./ir/ir_runtime.npk".*;
use "./ir/ir_func.npk".*;
use "./ir/ir_expr.npk".*;
use "./ir/ir_stmt.npk".*;

// One refusal, as the diagnostic SUBSET_1 §3 specifies: the construct, and the
// rung that enables it.
func:refuse = NIL(DiagList->:diags, IrVal:v) never fails {
    if (v.state == (raw LL_RUNG())) {
        // A RUNG NAMES A CYCLE ("1.5") OR A ROW ("a later cycle (G-2)"); the
        // sentence reads differently for each (1.0.8 — the row form rendered
        // "enabled by cycle a later cycle (G-2)").
        string:m1 = string_concat(v.what,
            " is not supported at this backend rung; enabled by cycle ");
        if (v.rung.len > 0i64) {
            if (v.rung.ptr[0i64] < 48u8) {
                m1 = string_concat(v.what,
                    " is not supported at this backend rung; owned by ");
            } else {
                if (v.rung.ptr[0i64] > 57u8) {
                    m1 = string_concat(v.what,
                        " is not supported at this backend rung; owned by ");
                }
            }
        }
        drop diaglist_push(diags,
            raw diag_error(raw RUNG_UNSUPPORTED(),
                           string_concat(m1, v.rung), v.at));
        pass NIL;
    }
    // EVERY `iv_broken` ARRIVES HERE, not only an unclassified kind — a
    // pattern with no variant, a slot nothing opened. What they share is that
    // the frontend promised this program valid and the emitter could not keep
    // the promise; the sentence says that, and no more (1.0.8).
    drop diaglist_push(diags,
        raw diag_error(raw EMIT_INTERNAL(),
            "the emitter could not lower this, although the frontend accepted it; a defect in the compiler rather than in this program — report it with the construct at this position",
            v.at));
    pass NIL;
};

// The named aggregate headers: `%Name = type { … }` for every struct, and for
// every enum a variant of which carries a payload — walked off the MODULES, in
// load order, so each struct's field types resolve in ITS OWN module's scope.
// The first draft walked the type table with `graph_at(0)`'s scope, and module
// zero is the PRELUDE: every struct whose field named another struct reported
// that type as unknown, in a program the checker had already accepted.
//
// TWO TYPES RENDERING ONE NAME IS REFUSED, loudly. `%Point` from two modules is
// one IR name for two layouts, and which one `llc` believes depends on which
// definition it reads first. Module-qualified type names are 0.8's mangling
// decision; until then the collision is an error rather than a coin toss.
func:emit_type_headers = NIL(IrWriter->:w, TypeResolver->:tr, LlCtx->:c,
                             DiagList->:diags, ModuleGraph->:g) never fails {
    int32:m = 0i32;
    while (m < (raw graph_count(g))) {
        ModuleEntry:me = raw graph_at(g, m);
        DeclNode:mn = raw ast_decl(@g.ast, DeclId{ index: me.root });
        int32:i = 0i32;
        while (i < (raw item_member_count(@g.ast, mn))) {
            DeclId:item = raw item_member(@g.ast, mn, i);
            DeclNode:d = raw ast_decl(@g.ast, item);
            if (d.kind == DeclKind.DeclStructDecl) {
                drop emit_one_header(w, tr, c, diags, me.scope, item, true);
            }
            if (d.kind == DeclKind.DeclEnumDecl) {
                drop emit_one_header(w, tr, c, diags, me.scope, item, false);
            }
            i = i + 1i32;
        }
        m = m + 1i32;
    }

    // THE INSTANTIATIONS (1.0.2). Monomorphization emits one definition per
    // distinct instance, and the interned type table IS that set: D-108 keys an
    // instantiation by its mangled name, so a repeat request returns the existing
    // entry and the table holds each exactly once. Walking it here — rather than
    // re-deriving instantiations from call sites — is why the dedup needs no
    // second mechanism, and why the emission order is the interning order, which
    // is deterministic (the fixpoint depends on it).
    //
    // The scope is the DECLARING module's, since that is where the generic's
    // field annotations resolve; `ll_struct_body` substitutes this instance's
    // arguments over them.
    int32:t = 0i32;
    while (t < (raw tt_count(c.types))) {
        if ((raw type_args_count_of(c.types, t)) > 0i32) {
            drop emit_instance_header(w, tr, c, diags, g, t);
        }
        t = t + 1i32;
    }

    drop irw_blank(w);
    pass NIL;
};

// AN `impl` BLOCK IS ITS METHODS (1.0.4). The block itself has no code — it
// groups functions and names what they are methods OF — so lowering it is
// emitting each member, with `Self` bound to the target for the duration.
//
// `Self` IS BOUND ON THE RESOLVER, not substituted afterwards: a method's
// signature and its body's annotations both mention it, and the resolver is the
// one place both go through. This mirrors what `type_method_call` does on the
// checking side (`r.self_type = recv`), which is what keeps the two answers the
// same one.
//
// A BLANKET OR FAMILY IMPL EMITS NOTHING HERE. Its methods are templates over a
// parameter, and what LLVM needs is one method per instantiation — the same rule
// a generic function follows (1.0.2b), and the same reason: `T` is not a type
// until something binds it.
func:emit_impl_block = NIL(ExprEmitter->:x, DiagList->:diags, DeclId:item,
                           DeclNode:d) never fails {
    TypeId:tgt = raw impl_target(x.ast, d);
    if (raw type_is_none(tgt)) { pass NIL; }

    // A FAMILY IMPL EMITS NOTHING HERE (1.0.4b, moved at 1.0.7). Its methods
    // are templates over the impl's parameters AND over `Self`; each recorded
    // instantiation is emitted by the instance loop at the end of the module
    // walk, through `emit_family_instance`, which binds both. It was emitted
    // from this block until 1.0.7, which reached only the instances recorded
    // BEFORE the block — and a call through a bound records its instance while
    // a specialization is emitted, after every block has been walked.
    if ((raw impl_generic_count(x.ast, d)) > 0i32) { pass NIL; }
    int32:self_ty = raw resolve_type(x.tr, tgt,
                        raw symtab_home_scope(x.tab, item.index, x.scope));

    int32:saved = x.tr.self_type;
    x.tr.self_type = self_ty;

    // THE TRAIT THIS IMPL IMPLEMENTS, resolved once — it is half of every method
    // symbol this block emits (D-156 as amended at 1.0.5b), and 0 for an
    // inherent impl.
    int32:impl_trait_ty = 0i32;
    TypeId:trt0 = raw impl_trait(x.ast, d);
    if (!(raw type_is_none(trt0))) {
        impl_trait_ty = raw resolve_trait_type(x.tr, trt0,
                            raw symtab_home_scope(x.tab, item.index, x.scope));
    }

    int32:saved_trait = x.cur_trait;
    x.cur_trait = impl_trait_ty;
    // AND THE IMPL ITSELF (1.4.7, D-229 stage 2): the MODULE half of every
    // symbol this block emits -- own methods, inherited defaults, and their
    // coroutine frames -- is this impl's, wherever its trait lives.
    int32:saved_impl = x.cur_impl;
    x.cur_impl = item.index;

    int32:i = 0i32;
    while (i < (raw impl_member_count(x.ast, d))) {
        DeclId:mid = raw impl_member(x.ast, d, i);
        DeclNode:m = raw ast_decl(x.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if (!(raw decl_has(m, raw DECL_COMPTIME()))) {
                IrVal:r = raw emit_function_named(x, mid,
                    raw impl_method_sym(x, self_ty, impl_trait_ty, m));
                if (!(raw iv_is_ok(r))) { drop refuse(diags, r); }
            }
        }
        i = i + 1i32;
    }

    // AN INHERITED DEFAULT IS EMITTED FOR THIS IMPL (1.0.4). A trait method with
    // a body belongs to every implementor that does not write its own, and its
    // `Self` is a different type in each — so it is a template, emitted once per
    // impl with `Self` bound, exactly as a generic function is emitted once per
    // argument set (1.0.2b). Without this the call resolved (the checker finds
    // the default) and the symbol did not exist.
    TypeId:trt = raw impl_trait(x.ast, d);
    if (!(raw type_is_none(trt))) {
        int32:trait_ty = impl_trait_ty;
        int32:tdecl = raw type_decl_of(x.fe.ctx.types, trait_ty);
        if (tdecl != 0i32) {
            DeclNode:td = raw ast_decl(x.ast, DeclId{ index: tdecl });
            int32:k = 0i32;
            while (k < (raw item_member_count(x.ast, td))) {
                DeclId:tmid = raw item_member(x.ast, td, k);
                DeclNode:tm = raw ast_decl(x.ast, tmid);
                if (tm.kind == DeclKind.DeclFunctionDecl) {
                    if (!(raw stmt_is_none(raw fn_body(x.ast, tm)))) {
                        // only when THIS impl did not write its own
                        if ((raw impl_own_member(x.ast, d,
                                 raw decl_name(tm))) == 0i32) {
                            // THE DEFAULT'S SYMBOL IS THIS IMPL'S, not the
                            // trait's. One declaration, one body per
                            // implementing impl — so the name has to come from
                            // where the emission stands, or every implementor
                            // renders the same symbol and `llc` refuses the
                            // module.
                            IrVal:r2 = raw emit_function_named(x, tmid,
                                raw impl_method_sym(x, self_ty, trait_ty, tm));
                            if (!(raw iv_is_ok(r2))) { drop refuse(diags, r2); }
                        }
                    }
                }
                k = k + 1i32;
            }
        }
    }

    // AND ITS VTABLE (D-158, 1.0.5c). Emitted here because this is where `Self`
    // is bound and the trait is known — the same reason the methods are.
    if (impl_trait_ty != 0i32) {
        drop emit_vtable(x, diags, item, self_ty, impl_trait_ty);
    }

    x.cur_trait = saved_trait;
    x.cur_impl = saved_impl;
    x.tr.self_type = saved;
    pass NIL;
};

// ONE TABLE PER (IMPL, TRAIT), ENTRIES IN TRAIT DECLARATION ORDER (D-158). The
// slot is the declaration index: stable, source-derived, hash-free — the same
// property D-156's symbols have and for the same auditing reason.
//
// EACH ENTRY IS AN ADAPTER THUNK, not the method itself. The erased caller holds
// one `ptr` and the method takes its receiver BY VALUE, so something has to load
// it — and the thunk is the one place that knows the concrete type well enough
// to. That is what lets an impl keep its natural `Point:self` signature instead
// of every method being rewritten to take a pointer.
//
// A NON-OBJECT-SAFE TRAIT GETS NO TABLE, and that is not a refusal: its `dyn`
// was already refused at every use (D-157), so no table is ever loaded. Building
// one anyway would mean thunking methods that cannot be thunked — a method
// returning `Self` has no erased signature — and would turn a legal program
// (a non-object-safe trait nobody uses as `dyn`) into a rung.
func:emit_vtable = NIL(ExprEmitter->:x, DiagList->:diags, DeclId:item,
                       int32:self_ty, int32:trait_ty) never fails {
    if (!(raw trait_is_object_safe(x.tr, trait_ty))) { pass NIL; }

    int32:tdecl = raw type_decl_of(x.fe.ctx.types, trait_ty);
    if (tdecl == 0i32) { pass NIL; }
    DeclNode:td = raw ast_decl(x.ast, DeclId{ index: tdecl });

    LlType:sll = raw ll_type(x.fe.ctx, self_ty);
    if (!(raw ll_is_ok(sll))) { pass NIL; }

    string:vtn = raw vtable_stem_of(x.fe.ctx, x.interns, self_ty, trait_ty);
    // SLOT 0 IS THE CONCRETE TYPE'S DROP (D-183, 1.2.4), or null when the
    // concrete owns nothing; the methods follow at declaration index + 1.
    // Behind `dyn` the concrete type is erased, so scope exit cannot name
    // which drop to call — the table carries it, one pointer per vtable,
    // the same shape the methods already ride. Every (impl, trait) table of
    // one concrete type carries the same slot 0, which is what keeps D-159's
    // widening sound: any retained word can drop the value.
    string:entries = "ptr null";
    if (raw type_drops_recorded(x.fe.ctx.types, self_ty, 64i32)) {
        entries = string_concat("ptr ",
                      raw drop_fn_sym(x.fe.ctx, self_ty));
    }
    int32:slots = 1i32;

    int32:k = 0i32;
    while (k < (raw item_member_count(x.ast, td))) {
        DeclNode:tm = raw ast_decl(x.ast, raw item_member(x.ast, td, k));
        if (tm.kind == DeclKind.DeclFunctionDecl) {
            // AN ASYNC METHOD'S SLOT IS ITS RESUME FUNCTION (D-185, 1.1.12d)
            // — no thunk: the caller builds the frame (size below) and
            // drives it; a wrapper function has nothing to add and no
            // synchronous shape to wrap into.
            if (raw decl_has(tm, raw DECL_ASYNC())) {
                string:amn = raw method_symbol_name(x.fe.ctx.types, x.interns,
                                 self_ty, trait_ty,
                                 raw intern_get(x.interns, raw decl_name(tm)));
                entries = string_concat(entries, ", ");
                entries = string_concat(entries, string_concat("ptr ",
                              raw resume_fn_sym(x.fe.ctx, item.index, amn)));
                slots = slots + 1i32;
            }
            if (!(raw decl_has(tm, raw DECL_ASYNC()))) {
                string:thunk = raw emit_thunk(x, item, td, tm, self_ty, trait_ty,
                                                sll, vtn);
                if (thunk.len == 0i64) { pass NIL; }
                entries = string_concat(entries, ", ");
                entries = string_concat(entries,
                              string_concat("ptr ", thunk));
                slots = slots + 1i32;
            }
        }
        k = k + 1i32;
    }
    // THE FRAME-SIZE TAIL (D-185, 1.1.12d): one entry per ASYNC method, in
    // declaration order, after the method slots — the size of the concrete
    // coroutine's frame, as a pointer-sized constant. `dyn` erases the type
    // that knows it; the table is where it survives erasure.
    k = 0i32;
    while (k < (raw item_member_count(x.ast, td))) {
        DeclNode:tm = raw ast_decl(x.ast, raw item_member(x.ast, td, k));
        if (tm.kind == DeclKind.DeclFunctionDecl) {
            if (raw decl_has(tm, raw DECL_ASYNC())) {
                string:smn = raw method_symbol_name(x.fe.ctx.types, x.interns,
                                 self_ty, trait_ty,
                                 raw intern_get(x.interns, raw decl_name(tm)));
                string:sfr = raw frame_ty_sym(x.fe.ctx, item.index, smn);
                entries = string_concat(entries, ", ");
                entries = raw cat3(entries, "ptr ",
                              raw frame_size_sym(sfr));
                slots = slots + 1i32;
            }
        }
        k = k + 1i32;
    }

    string:g1 = string_concat(
                    raw mangled_fn_sym(x.fe.ctx, item.index, vtn),
                    " = internal constant [");
    string:g2 = string_concat(g1, int_to_string(slots => int64));
    string:g3 = string_concat(g2, " x ptr] [");
    drop irw_raw(x.fe.w, string_concat(g3,
                     string_concat(entries, "]")));
    drop irw_blank(x.fe.w);
    pass NIL;
};

// One thunk: take the data pointer plus the erased arguments, load the concrete
// receiver, call the real method, return what it returned. Empty on refusal —
// the caller then emits no table, which is right, because a table with a hole
// is not a table minus a hole.
func:emit_thunk = string(ExprEmitter->:x, DeclId:item, DeclNode:td,
                         DeclNode:tm, int32:self_ty, int32:trait_ty,
                         LlType:sll, string:vtn) never fails {
    int32:home = raw symtab_home_scope(x.tab, item.index, x.scope);
    string:mname = raw intern_get(x.interns, raw decl_name(tm));

    // A GENERIC TRAIT'S PARAMETERS ARE BOUND FROM THE IMPL'S INSTANCE OF IT
    // (1.0.6b). `impl:IntBox:Producer<int32>` means `T = int32` in everything
    // `Producer` declares, and the signature read below is the TRAIT'S — so
    // without this, `func:make = T(Self:self)` resolved `T` against nothing and
    // reported "there is no type named `T`" AT THE TRAIT'S DECLARATION, from the
    // backend, for a program the frontend had already accepted.
    //
    // A REGRESSION THIS SUBCYCLE FOUND IN THE LAST ONE: 1.0.5c added this
    // signature read and no test had a generic trait with an impl, so the suite
    // was green over a program `npkc` could not compile.
    GenericScope:saved_tb = x.tr.enclosing;
    x.tr.enclosing = raw trait_binding(x.tr, trait_ty);

    // THE TRAIT'S SIGNATURE IS THE ERASED ONE. Object safety guarantees every
    // part of it but the receiver is concrete already (D-157), which is exactly
    // what makes a single thunk shape possible.
    int32:ret = raw resolve_type(x.tr, raw fn_return(x.ast, tm), home);
    LlType:rll = raw ll_wrap_result(x.fe.ctx, ret);
    if (!(raw ll_is_ok(rll))) { x.tr.enclosing = saved_tb; pass ""; }

    // A POINTER RECEIVER TAKES THE DATA POINTER ITSELF (1.1.12d): a
    // `Self->` method wants the concrete's ADDRESS, and `%d` already is it —
    // loading a value and passing it as the address handed the method its
    // own first bytes as a pointer. Read from the AST node: the receiver's
    // annotation is `Self->`, a pointer TypeNode, before any resolution.
    bool:recv_ptr = false;
    if ((raw fn_param_count(x.ast, tm)) > 0i32) {
        TypeNode:p0n = raw ast_type(x.ast,
                           raw param_type(raw ast_decl(x.ast,
                               raw fn_param(x.ast, tm, 0i32))));
        if (p0n.kind == TypeKind.TypePointerType) { recv_ptr = true; }
    }
    string:params = "ptr %d";
    string:args = string_concat(sll.text, " %r0");
    if (recv_ptr) { args = "ptr %d"; }
    int32:pc = raw fn_param_count(x.ast, tm);
    int32:i = 1i32;
    while (i < pc) {
        DeclNode:pd = raw ast_decl(x.ast, raw fn_param(x.ast, tm, i));
        int32:pt = raw resolve_type(x.tr, raw param_type(pd), home);
        LlType:pll = raw ll_type(x.fe.ctx, pt);
        if (!(raw ll_is_ok(pll))) { x.tr.enclosing = saved_tb; pass ""; }
        string:an = string_concat("%a", int_to_string(i => int64));
        params = string_concat(params,
                     raw cat4(", ", pll.text, " ", an));
        args = string_concat(args,
                   raw cat4(", ", pll.text, " ", an));
        i = i + 1i32;
    }

    x.tr.enclosing = saved_tb;

    string:sym = raw mangled_fn_sym(x.fe.ctx, item.index,
                     string_concat(vtn, string_concat(".", mname)));
    string:real = raw mangled_fn_sym(x.fe.ctx, item.index,
                      raw method_symbol_name(x.fe.ctx.types, x.interns,
                          self_ty, trait_ty, mname));

    drop irw_begin_function(x.fe.w);
    drop irw_raw(x.fe.w, raw cat5("define internal ", rll.text, " ", sym,
                             raw cat3("(", params, ") {")));
    drop irw_label(x.fe.w, "entry");
    if (!recv_ptr) {
        drop irw_line(x.fe.w, raw cat3("%r0 = load ", sll.text, ", ptr %d"));
    }
    string:rv = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(rv, " = call ", rll.text, " ",
                             raw cat4(real, "(", args, ")")));
    drop irw_line(x.fe.w, raw cat3("ret ", rll.text,
                             string_concat(" ", rv)));
    drop irw_raw(x.fe.w, "}");
    drop irw_blank(x.fe.w);
    pass sym;
};

// ONE FAMILY-INSTANCE VTABLE (1.0.9b), registered in `vtmap` and emitted, with
// `Self` bound to this instantiation's target and the impl's parameters bound to
// its arguments — the same two bindings `emit_family_instance` makes for the
// methods, and here for the same reason: the thunks resolve the trait's
// signature and name the concrete target. Built only once per (instance, trait)
// — the `vtmap` guard — and only when every slot has a recorded method
// (`family_vtable_ready`), so a plain call to one method never emits a
// half-built table. The thunks may forward-reference method bodies the fninst
// loop emits later, which is legal within a module.
func:emit_family_vtable = NIL(ExprEmitter->:x, DiagList->:diags,
                              FnInstance:fvi) never fails {
    DeclNode:fvd = raw ast_decl(x.ast, DeclId{ index: fvi.owner_impl });
    TypeId:fvtr = raw impl_trait(x.ast, fvd);
    if (raw type_is_none(fvtr)) { pass NIL; }
    int32:fvtrait = raw resolve_trait_type(x.tr, fvtr, x.scope);
    if (fvtrait == 0i32) { pass NIL; }

    TypeId:fvtgt = raw impl_target(x.ast, fvd);
    IdSpan:fvpw = raw decl_generic_window(x.ast, fvd);
    GenericScope:fvg = GenericScope{
        params_start: fvpw.start, params_count: fvpw.count,
        args_start: fvi.args_start, args_count: fvi.args_count };
    x.tr.generics = fvg;
    x.tr.enclosing = fvg;
    int32:fvself = raw type_subst(x.tr,
                       raw resolve_type(x.tr, fvtgt, x.scope),
                       fvg, fvd.span, 64i32, x.fe.ctx.impls);

    if ((raw vtmap_find(x.fe.ctx, fvself, fvtrait)) != 0i32) { pass NIL; }
    if (!(raw family_vtable_ready(x, fvtrait, fvi.owner_impl,
                                    fvi.args_start, fvi.args_count))) {
        pass NIL;
    }
    x.tr.self_type = fvself;
    drop vtmap_add(x.fe.ctx, fvself, fvtrait,
        raw intern_add(x.interns,
            raw mangled_fn_sym(x.fe.ctx, fvi.owner_impl,
                raw vtable_stem_of(x.fe.ctx, x.interns, fvself, fvtrait))));
    drop emit_vtable(x, diags, DeclId{ index: fvi.owner_impl }, fvself, fvtrait);
    pass NIL;
};

// One body per recorded instantiation of this family impl's methods, with the
// impl's parameters bound to that instantiation's arguments and `Self` bound to
// the substituted target (`Box<int32>`, not the template's `Box<T>`).
// ONE RECORDED INSTANTIATION OF A FAMILY IMPL'S METHOD (1.0.4b; one at a time
// from the instance loop since 1.0.7). The impl's parameters are bound to the
// instance's arguments and `Self` to the instantiated target — the two
// bindings a family's method body needs and the global walk did not have.
func:emit_family_instance = NIL(ExprEmitter->:x, DiagList->:diags,
                                FnInstance:inst) never fails {
    DeclId:item = DeclId{ index: inst.owner_impl };
    DeclNode:d = raw ast_decl(x.ast, item);
    TypeId:tgt = raw impl_target(x.ast, d);
    if (raw type_is_none(tgt)) { pass NIL; }
    IdSpan:pw = raw decl_generic_window(x.ast, d);
    int32:home = raw symtab_home_scope(x.tab, item.index, x.scope);

    // Half of every method symbol this instance emits; 0 for an inherent family.
    int32:fam_trait_ty = 0i32;
    TypeId:ftr = raw impl_trait(x.ast, d);
    if (!(raw type_is_none(ftr))) {
        fam_trait_ty = raw resolve_trait_type(x.tr, ftr, home);
    }

    GenericScope:g = GenericScope{
        params_start: pw.start, params_count: pw.count,
        args_start: inst.args_start, args_count: inst.args_count };

    GenericScope:gs = x.tr.generics;
    GenericScope:es = x.tr.enclosing;
    int32:ss = x.tr.self_type;
    x.tr.generics = g;
    x.tr.enclosing = g;
    int32:fam_saved_trait = x.cur_trait;
    x.cur_trait = fam_trait_ty;
    int32:fam_saved_impl = x.cur_impl;
    x.cur_impl = inst.owner_impl;
    // `Self` is THIS instantiation's target.
    x.tr.self_type = raw type_subst(x.tr,
                         raw resolve_type(x.tr, tgt, home),
                         g, d.span, 64i32, x.fe.ctx.impls);

    // THE SPECIALIZATION'S SYMBOL NAMES ITS INSTANTIATED TARGET (D-156
    // amended). This passed 0 — the plain method name — so `impl:<T>:Box<T>:S`
    // emitted `w` for EVERY instantiation, and two of them collided exactly as
    // two per-instance impls did. `Self` is already bound to this
    // instantiation's target above, which is the spelling that separates them.
    DeclNode:im = raw ast_decl(x.ast, DeclId{ index: inst.decl });
    IrVal:r = raw emit_fn_instance(x, DeclId{ index: inst.decl },
                  inst.args_start, inst.args_count,
                  inst.params_start, inst.params_count,
                  raw impl_method_sym(x, x.tr.self_type, fam_trait_ty, im));

    x.cur_trait = fam_saved_trait;
    x.cur_impl = fam_saved_impl;
    x.tr.generics = gs;
    x.tr.enclosing = es;
    x.tr.self_type = ss;
    if (!(raw iv_is_ok(r))) { drop refuse(diags, r); }
    pass NIL;
};

// IS EVERY SLOT OF THIS FAMILY INSTANCE'S VTABLE FILLED? (1.0.9b). A vtable is
// all-or-nothing — a thunk per trait method, each pointing at a method body — so
// it can be emitted only once every one of the trait's methods has a recorded
// instantiation for THIS (impl, arguments). A `dyn` coercion records them all at
// once; a call records one; this is the test that tells a complete table from a
// half-built one, so a plain call to one method of a family never emits a table
// with holes.
func:family_vtable_ready = bool(ExprEmitter->:x, int32:trait_ty,
                                int32:impl_decl, int32:args_start,
                                int32:args_count) never fails {
    int32:tdecl = raw type_decl_of(x.fe.ctx.types, trait_ty);
    if (tdecl == 0i32) { pass false; }
    DeclNode:td = raw ast_decl(x.ast, DeclId{ index: tdecl });
    int32:k = 0i32;
    while (k < (raw item_member_count(x.ast, td))) {
        DeclNode:tm = raw ast_decl(x.ast, raw item_member(x.ast, td, k));
        if (tm.kind == DeclKind.DeclFunctionDecl) {
            if (!(raw family_method_recorded(x, raw decl_name(tm), impl_decl,
                                               args_start, args_count))) {
                pass false;
            }
        }
        k = k + 1i32;
    }
    pass true;
};

// Was a method of this NAME recorded for this family impl at these arguments?
// The recorded declaration is the impl's own member or the trait default, so it
// is matched by name, not by declaration index — the same name the vtable's
// thunk and the emitted body agree on.
func:family_method_recorded = bool(ExprEmitter->:x, int32:name,
                                   int32:impl_decl, int32:args_start,
                                   int32:args_count) never fails {
    int32:i = 0i32;
    while (i < (raw fninst_count(x.fninsts))) {
        FnInstance:e = raw fninst_at(x.fninsts, i);
        if (e.owner_impl == impl_decl) {
            if (e.args_count == args_count) {
                bool:same = true;
                int32:j = 0i32;
                while (j < args_count) {
                    if ((raw ast_id_at(x.ast, e.args_start, j))
                            != (raw ast_id_at(x.ast, args_start, j))) {
                        same = false;
                        j = args_count;
                    } else {
                        j = j + 1i32;
                    }
                }
                if (same) {
                    DeclNode:md = raw ast_decl(x.ast,
                                      DeclId{ index: e.decl });
                    if ((raw decl_name(md)) == name) { pass true; }
                }
            }
        }
        i = i + 1i32;
    }
    pass false;
};

// The interned symbol name for one of this impl's methods (D-156 amended).
func:impl_method_sym = int32(ExprEmitter->:x, int32:self_ty, int32:trait_ty,
                             DeclNode:m) never fails {
    pass (raw intern_add(x.interns,
              raw method_symbol_name(x.fe.ctx.types, x.interns, self_ty,
                  trait_ty, raw intern_get(x.interns, raw decl_name(m)))));
};

// Did this impl write its own method called `name`? 0 when it inherits.
func:impl_own_member = int32(Ast->:ast, DeclNode:d, int32:name) never fails {
    int32:i = 0i32;
    while (i < (raw impl_member_count(ast, d))) {
        DeclId:mid = raw impl_member(ast, d, i);
        DeclNode:m = raw ast_decl(ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// One instantiation's `%"npk.mod.Container<int32>" = type { … }`.
func:emit_instance_header = NIL(IrWriter->:w, TypeResolver->:tr, LlCtx->:c,
                                DiagList->:diags, ModuleGraph->:g, int32:t) never fails {
    int32:k = raw type_kind(c.types, t);
    if (k != (raw TY_STRUCT())) {
        if (k != (raw TY_ENUM())) { pass NIL; }
    }
    // A TEMPLATE-SHAPED INSTANCE — `List<T>`, recorded for a literal inside a
    // generic body — has no representation; its specializations do (1.0.7).
    if (raw type_mentions_param(c.types, c.ast, t, 64i32)) { pass NIL; }
    LlType:name = raw ll_type(c, t);
    if (!(raw ll_is_ok(name))) { pass NIL; }
    if (raw string_eq(name.text, "i32")) { pass NIL; }   // payload-less enum

    // Any scope will do as the starting point: `ll_struct_body` re-homes it to
    // the declaring module's (the same rule field access follows, 0.8.1).
    int32:scope = (raw graph_at(g, 0i32)).scope;
    LlType:body = raw ll_enum_body(c, t);
    if (k == (raw TY_STRUCT())) {
        body = raw ll_struct_body(tr, c, t, scope);
    }
    if (!(raw ll_is_ok(body))) { pass NIL; }
    drop irw_raw(w, raw cat4(name.text, " = type ", body.text, ""));
    pass NIL;
};

// The interned type this declaration produced, found by ITS DECL — the same
// identity `tt_struct` interns under (D-090), so two same-named structs cannot
// answer for each other here.
func:type_of_decl = int32(LlCtx->:c, int32:decl_index, int32:kind) never fails {
    int32:i = 0i32;
    while (i < (raw tt_count(c.types))) {
        if ((raw type_kind(c.types, i)) == kind) {
            if ((raw type_decl(c.types, i)) == decl_index) {
                if ((raw type_args_count_of(c.types, i)) == 0i32) { pass i; }
            }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

func:emit_one_header = NIL(IrWriter->:w, TypeResolver->:tr, LlCtx->:c,
                           DiagList->:diags, int32:scope, DeclId:item,
                           bool:is_struct) never fails {
    int32:want_kind = raw TY_ENUM();
    if (is_struct) { want_kind = raw TY_STRUCT(); }

    // A GENERIC DECLARATION HAS NO BODY OF ITS OWN (1.0.2). `Container<T>` is a
    // template; what LLVM needs is `Container<int32>`, emitted by the instance
    // walk. Resolving this declaration's fields here would resolve `T` with
    // nothing bound to it — which is what the removed `args_count > 0` rung used
    // to prevent by refusing instances outright.
    DeclNode:gd = raw ast_decl(c.ast, item);
    if ((raw decl_generic_window(c.ast, gd)).count > 0i32) { pass NIL; }

    int32:t = raw type_of_decl(c, item.index, want_kind);
    if (t == 0i32) { pass NIL; }    // declared and never used: nothing interned it
    LlType:name = raw ll_type(c, t);
    if (!(raw ll_is_ok(name))) { pass NIL; }
    if (raw string_eq(name.text, "i32")) { pass NIL; }   // a payload-less enum
    LlType:body = raw ll_enum_body(c, t);
    if (is_struct) {
        body = raw ll_struct_body(tr, c, t, scope);
    }
    if (!(raw ll_is_ok(body))) { pass NIL; }
    drop irw_raw(w, raw cat4(name.text, " = type ", body.text, ""));
    pass NIL;
};

// (D-162, 1.0.1: the interim duplicate-type-name refusal is RETIRED. Two
// same-named types in two modules are two declarations (D-090), two interned
// entries, and two D-156 symbols -- they link and run. What made the refusal
// seem necessary at 1.0.0 was the struct-literal context hole, not a type-table
// merge; with D-162 closing that, the guard has nothing left to guard.
// `same_name_two_modules.npk` is its inversion, executed.)

// THE MODULE MAP (D-156): decl index -> canonical module name, for every
// function and named type. Built once, here, because this is the first point
// with both the graph (module provenance) and the LlCtx (where the mangling
// helpers read it). The canonical name is the file BASENAME (path-free,
// D-078; = the `mod:` name, D-088), extended by `.` for a nested inline
// module. Deterministic in graph order, so stage 1 and stage 2 emit identical
// symbols -- the fixpoint the scheme must not disturb.
func:build_modmap = NIL(ModuleGraph->:g, LlCtx->:c) never fails {
    int32:n = raw ast_decl_count(@g.ast);
    int64:sz = n => int64;
    if (sz < 1i64) { sz = 1i64; }
    wild int8->:mem = alloc(sz * #size_of<int32>());
    wild int32->:map = mem =>! wild int32->;
    int64:z = 0i64;
    while (z < sz) { map[z] = 0i32; z = z + 1i64; }
    int32:m = 0i32;
    while (m < (raw graph_count(g))) {
        ModuleEntry:me = raw graph_at(g, m);
        string:base = raw path_basename(raw srcmgr_resolved_proven(@g.sm, me.file));
        DeclNode:mn = raw ast_decl(@g.ast, DeclId{ index: me.root });
        drop modmap_members(g, map, mn, move(base));
        m = m + 1i32;
    }
    drop llctx_set_modmap(c, map, n);
    pass NIL;
};

// EVERY IMPL'S VTABLE NAME, BEFORE ANY BODY IS EMITTED (1.0.5c). A `dyn`
// construction knows the concrete type and its traits; the table is named in the
// IMPL's module (D-156) and the construction site cannot reach that. Emitting
// impls first would not fix it either — impls and functions interleave in module
// order, so a function that builds a `dyn` can be emitted before the impl whose
// table it needs. Same answer as `build_modmap`: walk once, record, look up.
func:build_vtmap = NIL(ModuleGraph->:g, TypeResolver->:tr, LlCtx->:c) never fails {
    int32:m = 0i32;
    while (m < (raw graph_count(g))) {
        ModuleEntry:me = raw graph_at(g, m);
        DeclNode:mn = raw ast_decl(@g.ast, DeclId{ index: me.root });
        drop vtmap_members(g, tr, c, mn, me.scope);
        m = m + 1i32;
    }
    pass NIL;
};

func:vtmap_members = NIL(ModuleGraph->:g, TypeResolver->:tr, LlCtx->:c,
                         DeclNode:mn, int32:scope) never fails {
    int32:k = raw item_member_count(@g.ast, mn);
    for (int32:i in 0i32...k) {
        DeclId:item = raw item_member(@g.ast, mn, i);
        DeclNode:d = raw ast_decl(@g.ast, item);
        if (d.kind == DeclKind.DeclModuleDecl) {
            drop vtmap_members(g, tr, c, d, scope);
        }
        if (d.kind == DeclKind.DeclImplDecl) {
            // A FAMILY IMPL HAS NO ONE TABLE. Its target is a template, and each
            // instantiation would need its own — which nothing constructs a
            // `dyn` from yet, so it is a rung rather than a silent omission.
            if ((raw impl_generic_count(@g.ast, d)) == 0i32) {
                TypeId:tg = raw impl_target(@g.ast, d);
                TypeId:tr0 = raw impl_trait(@g.ast, d);
                if (!(raw type_is_none(tg))) {
                    if (!(raw type_is_none(tr0))) {
                        int32:home = raw symtab_home_scope(@g.tab, item.index,
                                                           scope);
                        int32:sty = raw resolve_type(tr, tg, home);
                        int32:tty = raw resolve_trait_type(tr, tr0, home);
                        if (sty != 0i32) {
                            if (tty != 0i32) {
                                drop vtmap_add(c, sty, tty,
                                    raw intern_add(g.interns,
                                        raw mangled_fn_sym(c, item.index,
                                            raw vtable_stem_of(c, g.interns,
                                                                 sty, tty))));
                            }
                        }
                    }
                }
            }
        }
    }
    pass NIL;
};

// `vt.<Type>.<Trait>` — D-156 names the table; the thunks append their method.
func:vtable_stem_of = string(LlCtx->:c, InternTable->:interns, int32:self_ty,
                             int32:trait_ty) never fails {
    string:v1 = string_concat("vt.",
                    raw type_display(c.types, interns, self_ty));
    pass (string_concat(v1,
              string_concat(".",
                  raw type_display(c.types, interns, trait_ty))));
};

func:modmap_members = NIL(ModuleGraph->:g, wild int32->:map, DeclNode:mn,
                          move string:canon) never fails {
    // INTERN ONCE, REUSE THE ID (D-186's fallout). The first cut said
    // `intern_add(move(canon))` at every member — moving one binding many
    // times over, so every table entry aliased ONE body. Latent-harmless
    // while slice-derived names were views (a duplicate's drop was a no-op
    // on cap 0); D-186's owned slices made the drops real and the second
    // duplicate a DOUBLE FREE — npk_small_free's bitmap caught it on the
    // first stage-1 run. The loop-carried re-`move` the checker missed is
    // recorded as its own open (the moved-from analysis is straight-line).
    int32:cid = raw intern_add(g.interns, move(canon));
    string:cname = raw intern_get(g.interns, cid);
    int32:k = raw item_member_count(@g.ast, mn);
    for (int32:i in 0i32...k) {
        DeclId:item = raw item_member(@g.ast, mn, i);
        DeclNode:d = raw ast_decl(@g.ast, item);
        if (d.kind == DeclKind.DeclModuleDecl) {
            string:nm = raw intern_get(g.interns, raw decl_name(d));
            string:nc = string_concat(cname, string_concat(".", nm));
            drop modmap_members(g, map, d, move(nc));
        } else {
            map[item.index => int64] = cid;

            // AN `impl`'s METHODS ARE IN THE MODULE TOO (1.0.4). They are
            // declarations this walk never reaches on its own — an impl GROUPS
            // them — so without this they fell through to the unqualified
            // `@npk_<name>` fallback and lost D-156's qualification silently.
            // Found by reading the emitted IR for an inherent method, not by a
            // failing test: the fallback links, it just does not qualify.
            if (d.kind == DeclKind.DeclImplDecl) {
                int32:mi = 0i32;
                while (mi < (raw impl_member_count(@g.ast, d))) {
                    DeclId:mid = raw impl_member(@g.ast, d, mi);
                    map[mid.index => int64] = cid;
                    mi = mi + 1i32;
                }
            }
            // A TRAIT'S DEFAULT METHODS ARE MODULE MEMBERS TOO (1.0.4) — they
            // are emitted once per implementing impl, and each emission needs
            // its module qualification like any other definition.
            if (d.kind == DeclKind.DeclTraitDecl) {
                int32:ti = 0i32;
                while (ti < (raw item_member_count(@g.ast, d))) {
                    DeclId:tmem = raw item_member(@g.ast, d, ti);
                    map[tmem.index => int64] = cid;
                    ti = ti + 1i32;
                }
            }
        }
    }
    pass NIL;
};


// The runtime floor's declarations, in `rt_name_at` order — which makes the
// declare block a fixed constant of every module this compiler ever emits.
func:emit_runtime_declares = NIL(IrWriter->:w) never fails {
    int32:i = 0i32;
    while (i < (raw rt_count())) {
        RtSig:sig = raw rt_sig(raw rt_name_at(i));
        string:args = "";
        int32:a = 0i32;
        while (a < sig.argc) {
            if (a > 0i32) { args = string_concat(args, ", "); }
            args = string_concat(args, raw rt_arg(sig, a));
            a = a + 1i32;
        }
        drop irw_raw(w, raw cat5("declare ", sig.ret, " ", sig.sym,
                          raw cat3("(", args, ")")));
        i = i + 1i32;
    }
    // `@npk_trap` is DELIBERATELY not in the table above: it is not a builtin a
    // program may call — it is how emitted GUARDS (division, and every guard a
    // later rung adds) route a runtime fault into `failsafe` (D-142). Declared
    // unconditionally because the declare block is a fixed constant.
    drop irw_raw(w, "declare void @npk_trap(i32)");
    // The `dyn` CELL (D-183, 1.2.4): a coercion moves the concrete value
    // into a managed heap cell the `dyn` owns — the data pointer must
    // outlive the frame that built it, which an alloca cannot. Not a
    // builtin a program may call; the generated dyn drop hands the cell
    // back through `npk_dalloc` after calling vtable slot 0.
    drop irw_raw(w, "declare ptr @npk_alloc_managed(i64)");
    // The origin chain's stamps (D-179, 1.1.6): not builtins a program may
    // call — `fail` resets, `relay` and `?!` push. Declared unconditionally,
    // like the trap they feed.
    drop irw_raw(w, "declare void @npk_chain_reset(i32)");
    drop irw_raw(w, "declare void @npk_chain_push(i32)");
    // The executor's own symbols (D-071, 1.1.8): the suspension primitive's
    // park request, the wind-up note every resume segment makes, and the
    // freeze flag D-063 has the run loop read before every resume.
    drop irw_raw(w, "declare void @npk_park_until(i64)");
    // The frame's owning executor, stamped into every frame at birth
    // (D-032 pins a task to it) so a channel waker can reach it.
    drop irw_raw(w, "declare ptr @npk_exec()");
    drop irw_raw(w, "declare void @npk_windup_note(i32)");
    drop irw_raw(w, "declare i64 @npk_park_take()");
    drop irw_raw(w, "declare void @npk_park_sleep(i64)");
    drop irw_raw(w, "declare i32 @npk_frozen_get()");
    drop irw_raw(w, "declare void @npk_rq_push(ptr)");
    drop irw_raw(w, "declare i32 @npk_run_until(ptr, i64)");
    drop irw_raw(w, "declare i32 @npk_task_done(ptr)");
    drop irw_raw(w, "declare void @npk_windup_all(ptr)");
    drop irw_raw(w, "declare i64 @npk_join_deadline()");
    drop irw_raw(w, "declare i64 @npk_windup_grace()");
    drop irw_raw(w, "declare ptr @npk_thread_start(ptr, ptr, i64)");
    drop irw_raw(w, "declare i32 @npk_thread_join(ptr, i64)");
    drop irw_raw(w, "declare i64 @npk_hardware_concurrency()");
    drop irw_raw(w, "declare i64 @npk_ch_open(i64, i64)");
    drop irw_raw(w, "declare i32 @npk_ch_close(i64)");
    drop irw_raw(w, "declare i32 @npk_ch_try_send(i64, ptr)");
    drop irw_raw(w, "declare i32 @npk_ch_send_wait(i64, ptr, i64, ptr)");
    drop irw_raw(w, "declare i32 @npk_ch_recv_wait(i64, ptr, i64, ptr)");
    drop irw_raw(w, "declare i32 @npk_ch_try_recv(i64, ptr)");
    // The creating function's exit hands the channel back (D-183, 1.2.5);
    // not a builtin a program may call.
    drop irw_raw(w, "declare i32 @npk_ch_reclaim(i64)");
    // The mutex (D-056, 1.1.11): the acquire's park protocol and the release
    // the guard's drop calls. Not builtins a program may call.
    drop irw_raw(w, "declare i32 @npk_mutex_acquire_wait(ptr, i64, ptr)");
    drop irw_raw(w, "declare void @npk_guard_release(ptr)");
    drop irw_raw(w, "declare i32 @npk_rw_read_wait(ptr, i64, ptr)");
    drop irw_raw(w, "declare i32 @npk_rw_write_wait(ptr, i64, ptr)");
    drop irw_raw(w, "declare void @npk_rw_release_read(ptr)");
    drop irw_raw(w, "declare void @npk_cv_begin(ptr, ptr, i64, ptr)");
    drop irw_raw(w, "declare void @npk_cv_done(ptr, ptr)");
    drop irw_raw(w, "declare void @npk_cv_signal(ptr)");
    drop irw_raw(w, "declare void @npk_cv_broadcast(ptr)");
    drop irw_raw(w, "declare i64 @npk_barrier_arrive(ptr)");
    drop irw_raw(w, "declare i32 @npk_barrier_poll(ptr, i64, i64, ptr)");
    drop irw_raw(w, "declare void @npk_barrier_cancel(ptr, i64, ptr)");
    // The reactor (B-3a, 1.1.12a): one-shot readiness registration.
    drop irw_raw(w, "declare void @npk_io_register(i32, i32)");
    drop irw_raw(w, "declare void @npk_io_unwatch(i32)");
    drop irw_raw(w, "declare void @npk_ofd_close(i32)");
    // THE GENERIC FRAME HEADER (D-177 stage E): every coroutine frame begins
    // with this prefix, and a spawnable child's success is `NIL` by checker
    // rule, so its result slot is `{ i32 }` — which is what lets ONE join
    // walk a heterogeneous child list: resume through slot 0, windup slot 2,
    // error slot 3, sibling slot 5, all at fixed offsets. Declared
    // unconditionally, like the runtime block it rides with.
    drop irw_raw(w, string_concat("%\"npk.frame.hdr\" = type ",
                      "{ ptr, i32, i32, { i32 }, ptr, ptr, ptr, ptr, i64, ptr, ptr, ptr }"));
    // `sys` calls the six-register trampoline directly (0.9.7).
    drop irw_raw(w, "declare i64 @npk_sys6(i64, i64, i64, i64, i64, i64, i64)");
    // THE OVERFLOW INTRINSICS, for every integer width and all six families.
    // `tbb` multiplication rode `smul` alone from 0.9.5; D-210 (1.4.2b) made
    // the DEFAULT integer's `+ - *` checked too, so every width the language
    // has needs `{s,u}{add,sub,mul}`. Declared unconditionally — the declare
    // block is a fixed constant of every module this compiler emits, and an
    // unused declare costs nothing. llc 20.1.2 legalizes all of them, i1
    // through i4096, at -O0 and -O2 alike (verified before the guard was
    // written; the opt-O2 leg re-proves it on every run).
    int32:owi = 0i32;
    while (owi < (raw int_width_count())) {
        int32:owf = 0i32;
        while (owf < (raw ovf_family_count())) {
            string:owh = raw cat5("declare { ", raw int_width_at(owi),
                              ", i1 } @", raw ovf_intrinsic_name(owf,
                                  raw int_width_at(owi)), "(");
            string:owa = raw cat3(raw int_width_at(owi), ", ",
                              raw int_width_at(owi));
            drop irw_raw(w, string_concat(owh, string_concat(owa, ")")));
            owf = owf + 1i32;
        }
        owi = owi + 1i32;
    }
    // `.abs()` on float-element complex (D-199, 1.3.6) — the sqrt is an
    // instruction on this target, which is exactly why it is float-only.
    drop irw_raw(w, "declare float @llvm.sqrt.f32(float)");
    drop irw_raw(w, "declare double @llvm.sqrt.f64(double)");
    drop irw_blank(w);
    pass NIL;
};

// An INLINE `mod` carries members like a file module does — and until 0.9.6
// `emit_all` neither descended into one nor refused it, so inline-mod code was
// SILENTLY SHED (the audit's fourth Theme-A hole, held on the kinds table
// since 0.9.1). Functions emit — their signatures resolve in their own home
// scopes (D-137), so the caller's emitter serves — and the members a rung
// refuses refuse here exactly as at top level.
// A MODULE-LEVEL BINDING, LOWERED TO AN LLVM CONSTANT (D-165, 1.0.9d; 1.4.2c).
// Every one of them: D-211 requires `fixed` and D-165 requires the initialiser
// to be a compile-time constant, so the writable `global` form the plain and
// `fixed` spellings used to take has no occupant left.
// The initialiser is a compile-time constant the checker has already held to
// that shape (`TYPE_GLOBAL_NOT_CONSTANT`), rendered by `emit_global_const`. The
// symbol follows D-156. No initialiser runs before `main`: the value is the
// constant, emitted once, in no order anyone has to have chosen.
func:emit_one_global = NIL(ExprEmitter->:x, DiagList->:diags, DeclId:item,
                           DeclNode:d) never fails {
    int32:saved_scope = x.scope;
    int32:home = raw symtab_home_scope(x.tab, item.index, x.scope);
    x.scope = home;
    int32:gt = raw resolve_type(x.tr, raw global_type(d), home);
    LlType:gll = raw ll_type(x.fe.ctx, gt);
    if (!(raw ll_is_ok(gll))) {
        x.scope = saved_scope;
        drop refuse(diags, raw iv_from_ll_at(x, gll, gt, d.span));
        pass NIL;
    }
    string:cval = "";
    ExprId:init = raw global_init(d);
    if (raw expr_is_none(init)) {
        cval = "zeroinitializer";
    } else {
        cval = raw emit_global_const(x, init);
    }
    x.scope = saved_scope;
    if (cval.len == 0i64) {
        // The checker proved the initialiser constant, so a failure to render is
        // a defect, not a rung.
        drop refuse(diags, raw iv_broken(d.span));
        pass NIL;
    }
    // EVERY MODULE BINDING IS `constant` (1.4.2c). D-165 requires the
    // initialiser to be a compile-time constant and D-211 requires `fixed`, so
    // the writable `global` form had no occupant left once `const` retired —
    // and the memory the linker maps read-only is a stronger statement of the
    // same fact than a checker rule alone.
    string:sym = raw mangled_fn_sym(x.fe.ctx, item.index,
                     raw intern_get(x.interns, raw decl_name(d)));
    drop irw_raw(x.fe.w, raw cat5(sym, " = ", "constant", " ",
                     raw cat3(gll.text, " ", cval)));
    pass NIL;
};

func:emit_nested_module = NIL(ExprEmitter->:x, DiagList->:diags, DeclNode:m) never fails {
    int32:i = 0i32;
    while (i < (raw item_member_count(x.ast, m))) {
        DeclId:item = raw item_member(x.ast, m, i);
        DeclNode:d = raw ast_decl(x.ast, item);
        if (d.kind == DeclKind.DeclFunctionDecl) {
            if (!(raw decl_has(d, raw DECL_COMPTIME()))) {
                IrVal:r = raw emit_function(x, item);
                if (!(raw iv_is_ok(r))) { drop refuse(diags, r); }
            }
        }
        if (d.kind == DeclKind.DeclImplDecl) {
            drop emit_impl_block(x, diags, item, d);
        }
        if (d.kind == DeclKind.DeclExternBlock) {
            // EMITS NOTHING, BY DESIGN (D-190, 1.1.13c): the block is the
            // interface record — its stubs were generated in the expansion
            // phase and emit as the ordinary async functions they are. The
            // 1.1 rung refusal that stood here retired when they landed.
        }
        if (d.kind == DeclKind.DeclGlobalDecl) {
            drop emit_one_global(x, diags, item, d);
        }
        if (d.kind == DeclKind.DeclModuleDecl) {
            drop emit_nested_module(x, diags, d);
        }
        i = i + 1i32;
    }
    pass NIL;
};

// Everything. True when the program emitted whole; false when any refusal was
// recorded, in which case the writer's text is not a module and must not be used.
//
// `emit_all`, NOT `emit_program`: the module is named `emit_program` (the
// basename rule fixes that), and a module's own name occupies its scope — a
// function spelled the same is a redeclaration to the real resolver. The seed's
// single namespace hid the collision from 0.7.7 until the first self-check.
pub func:emit_all = bool(IrWriter->:w, ModuleGraph->:g, TypeTable->:types,
                             InternTable->:interns, ExprTypes->:ets,
                             TypeResolver->:tr, FnInstTable->:fninsts,
                             wild ImplTable->:impls, DiagList->:diags) never fails {
    int64:before = raw diaglist_count(diags);
    LlCtx:c = raw llctx_init(@g.ast, types, interns);
    drop llctx_set_impls(@c, impls, tr);
    drop build_modmap(g, @c);
    drop build_vtmap(g, tr, @c);
    StrTable:st = raw strtab_init();
    drop irw_raw(w, "target triple = \"x86_64-unknown-linux-gnu\"");
    drop irw_blank(w);
    drop emit_type_headers(w, tr, @c, diags, g);
    int32:headers_before = raw tt_count(c.types);
    drop emit_runtime_declares(w);

    FnEmitter:fe = raw fnem_init(w, @c);

    // FAMILY-INSTANCE VTABLES, BEFORE ANY BODY THAT BUILDS A `dyn` FROM ONE
    // (1.0.9b). `build_vtmap` pre-registers every per-instance impl's table, so
    // a `dyn` coercion in any function finds it; a FAMILY impl's table is per
    // instantiation and is known only from the recorded set, so it is
    // registered and emitted here — after the preamble, before the function
    // loop where `emit_dyn_from` reads `vtmap`. The emitter is built at the
    // impl's home scope and handed to `emit_family_vtable`, where `Self` and the
    // impl's parameters bind — the same shape `emit_family_instance` takes, and
    // the reason it is a function rather than inline: a resolver reached through
    // a LOCAL emitter is a borrow the escape analysis cannot name (BORROW-009),
    // while one reached through a parameter is.
    int32:fv = 0i32;
    while (fv < (raw fninst_count(fninsts))) {
        FnInstance:fvi = raw fninst_at(fninsts, fv);
        if (fvi.owner_impl != 0i32) {
            int32:fvhs = raw impl_scope_of(impls, fvi.owner_impl);
            ExprEmitter:fvx = raw exprem_init(@fe, @g.ast, ets, @g.tab,
                                  interns, @st, @g.sm, tr, fninsts, fvhs);
            drop emit_family_vtable(@fvx, diags, fvi);
        }
        fv = fv + 1i32;
    }

    int32:m = 0i32;
    while (m < (raw graph_count(g))) {
        ModuleEntry:me = raw graph_at(g, m);
        ExprEmitter:x = raw exprem_init(@fe, @g.ast, ets, @g.tab, interns, @st, @g.sm,
                                        tr, fninsts, me.scope);
        DeclNode:mn = raw ast_decl(@g.ast, DeclId{ index: me.root });
        int32:i = 0i32;
        while (i < (raw item_member_count(@g.ast, mn))) {
            DeclId:item = raw item_member(@g.ast, mn, i);
            DeclNode:d = raw ast_decl(@g.ast, item);
            if (d.kind == DeclKind.DeclFunctionDecl) {
                // A `comptime func:` was CONSUMED at fold time (0.6.4); nothing
                // remains to lower, and emitting it would be emitting a phase.
                if (!(raw decl_has(d, raw DECL_COMPTIME()))) {
                    IrVal:r = raw emit_function(@x, item);
                    if (!(raw iv_is_ok(r))) {
                        drop refuse(diags, r);
                    }
                }
            }
            // AN `impl` CARRIES CODE, AND CODE THIS RUNG CANNOT LOWER IS
            // REFUSED, NOT DROPPED. Skipping it would compile a program minus
            // its methods — every call to them already refuses, but a rung that
            // silently sheds declared code is a rung whose output stops meaning
            // the source. A `trait` is different: erased by design, generating
            // nothing at ANY rung, so there is genuinely nothing to refuse.
            if (d.kind == DeclKind.DeclImplDecl) {
                drop emit_impl_block(@x, diags, item, d);
            }
            if (d.kind == DeclKind.DeclExternBlock) {
                // Emits nothing (D-190): the interface record — the stubs
                // generated from it are ordinary members of this module.
            }
            if (d.kind == DeclKind.DeclGlobalDecl) {
                drop emit_one_global(@x, diags, item, d);
            }
            if (d.kind == DeclKind.DeclModuleDecl) {
                drop emit_nested_module(@x, diags, d);
            }
            i = i + 1i32;
        }
        m = m + 1i32;
    }

    // THE GENERIC-FUNCTION SPECIALIZATIONS (1.0.2b). One body per recorded
    // (declaration, arguments) request — the frontend deduped them the way
    // D-108 dedups a type instantiation, so this walk emits each exactly once,
    // in recording order, which is deterministic (the fixpoint requires it).
    // The emitter is built at the DECLARING module's scope, since that is where
    // the body's annotations resolve.
    int32:fi = 0i32;
    while (fi < (raw fninst_count(fninsts))) {
        FnInstance:inst = raw fninst_at(fninsts, fi);
        // An impl-owned instantiation is emitted by its own impl block, where
        // `Self` and the impl's parameters are bound (1.0.4b).
        //
        // A TEMPLATE-SHAPED INSTANTIATION IS NOT EMITTED (1.0.7). `pair_of<T>`
        // calling `list_make::<T>(…)` records `list_make<T>` with T opaque
        // (D-107); that is a request made on behalf of whatever `pair_of` is
        // instantiated at, and it is honoured when `pair_of<int64>`'s body is
        // emitted — `emit_call` substitutes the arguments and records
        // `list_make<int64>`, which this loop then reaches, since it re-reads
        // the count. Emitting the template itself put `T` in front of
        // `ll_type` with nothing bound, and refused a valid program.
        if (raw fninst_is_template(@g.ast, @c, inst)) {
            fi = fi + 1i32;
        } else {
        if (inst.owner_impl != 0i32) {
            // AN IMPL-OWNED INSTANTIATION, emitted at its IMPL's home scope
            // with the impl's parameters and `Self` bound (1.0.4b, here since
            // 1.0.7 so that an instance recorded by a later specialization is
            // still reached).
            // AN IMPL HAS NO SYMBOL, so `symtab_home_scope` cannot place it;
            // the impl table recorded the scope it was collected in for
            // exactly this kind of question.
            int32:ihs = raw impl_scope_of(impls, inst.owner_impl);
            ExprEmitter:xf = raw exprem_init(@fe, @g.ast, ets, @g.tab, interns,
                                             @st, @g.sm, tr, fninsts, ihs);
            drop emit_family_instance(@xf, diags, inst);
            fi = fi + 1i32;
        } else {
        int32:hs = raw symtab_home_scope(@g.tab, inst.decl, 0i32);
        ExprEmitter:xi = raw exprem_init(@fe, @g.ast, ets, @g.tab, interns, @st,
                                         @g.sm, tr, fninsts, hs);
        IrVal:ir = raw emit_fn_instance(@xi, DeclId{ index: inst.decl },
                                          inst.args_start, inst.args_count,
                                          inst.params_start, inst.params_count,
                                          raw fninst_symbol(@g.ast, @c, inst));
        if (!(raw iv_is_ok(ir))) { drop refuse(diags, ir); }
        fi = fi + 1i32;
        }
        }
    }

    // THE DROP BODIES (D-183, 1.2.1), before the string table so their own
    // literals — none today, but a drop is ordinary code — still land. The
    // loop RE-READS the count: a struct's drop calls its fields' drops, which
    // registers them, exactly as the generic-instance loop above grows.
    drop emit_drop_bodies(w, @c, tr, @g.ast, @g.tab, diags);
    drop strtab_write_all(@st, w);
    // The site tables LAST (D-179, 1.1.6): every stamp site has registered by
    // now — emitting them beside the declares wrote a one-row sentinel table
    // before any function had spoken.
    drop emit_site_tables(w);
    // INSTANCES THE BODIES CREATED (1.0.7): a `List<int64>` that exists only
    // because `list_make<int64>`'s body built one. Textual IR resolves a named
    // type wherever its definition appears, so the late ones go at the end.
    drop emit_late_headers(w, tr, @c, diags, g, headers_before);
    pass ((raw diaglist_count(diags)) == before);
};

// --- the drop bodies (D-183, 1.2.1) ------------------------------------------
//
// One function per type that owns something, `@"npk.drop.<dty>"`, taking the
// value BY POINTER: a drop reads and releases storage rather than consuming a
// copy, and an aggregate passed by value would be copied to be freed.
//
// Types that own nothing never reach here, because nothing registers them —
// which is the whole cost model. A scalar-only program emits no drop bodies
// and no calls, and its IR is byte-for-byte what it was before this landed.
func:emit_drop_bodies = NIL(IrWriter->:w, LlCtx->:c, TypeResolver->:tr,
                            Ast->:ast, SymbolTable->:tab,
                            DiagList->:diags) never fails {
    int64:i = 0i64;
    while (i < (raw drop_type_count(c))) {
        int32:dty = raw drop_type_at(c, i);
        drop emit_one_drop(w, c, tr, ast, tab, diags, dty);
        drop emit_one_vacant(w, c, tr, ast, tab, dty);
        i = i + 1i64;
    }
    pass NIL;
};

func:emit_one_drop = NIL(IrWriter->:w, LlCtx->:c, TypeResolver->:tr,
                         Ast->:ast, SymbolTable->:tab, DiagList->:diags,
                         int32:dty) never fails {
    LlType:t = raw ll_type(c, dty);
    if (!(raw ll_is_ok(t))) { pass NIL; }
    string:sym = raw drop_fn_sym(c, dty);
    drop irw_raw(w, raw cat4("define internal void ", sym, "(ptr %v) {", ""));
    drop irw_raw(w, "entry:");
    int32:k = raw type_kind(c.types, dty);

    // A STRING FREES ITS BODY ONLY WHEN IT OWNS IT (D-183): `cap == 0` is a
    // literal's body, which is a module constant, and `npk_dalloc` traps on
    // one — correctly. A BUFFER IS THE SAME SHAPE with the same cap bit
    // (D-200/§23, 1.3.7), so it is the same body.
    bool:strlike = (k == (raw TY_STRING()));
    if (k == (raw TY_BUFFER())) { strlike = true; }
    if (strlike) {
        drop irw_raw(w, "  %cp = getelementptr { ptr, i64, i64 }, ptr %v, i32 0, i32 2");
        drop irw_raw(w, "  %cap = load i64, ptr %cp");
        drop irw_raw(w, "  %own = icmp ne i64 %cap, 0");
        drop irw_raw(w, "  br i1 %own, label %free, label %done");
        drop irw_raw(w, "free:");
        drop irw_raw(w, "  %bp = getelementptr { ptr, i64, i64 }, ptr %v, i32 0, i32 0");
        drop irw_raw(w, "  %b = load ptr, ptr %bp");
        drop irw_raw(w, "  call void @npk_dalloc(ptr %b)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // `atomic<T>` IS `T`'s storage, so it is dropped as one.
    if (k == (raw TY_ATOMIC())) {
        int32:inner = raw type_elem(c.types, dty);
        drop irw_raw(w, raw cat4("  call void ", raw drop_fn_sym(c, inner),
                          "(ptr %v)", ""));
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // `Result<T>` is `{ T, i32 }`: an error case carries no value to drop.
    if (k == (raw TY_RESULT())) {
        int32:inner = raw type_elem(c.types, dty);
        drop irw_raw(w, raw cat5("  %ep = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 1", "", ""));
        drop irw_raw(w, "  %err = load i32, ptr %ep");
        drop irw_raw(w, "  %ok = icmp eq i32 %err, 0");
        drop irw_raw(w, "  br i1 %ok, label %val, label %done");
        drop irw_raw(w, "val:");
        drop irw_raw(w, raw cat5("  %vp = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 0", "", ""));
        drop irw_raw(w, raw cat4("  call void ", raw drop_fn_sym(c, inner),
                          "(ptr %vp)", ""));
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // `Optional<T>` is `{ i8, T }`, TAG FIRST, and 1 means present.
    if (k == (raw TY_OPTIONAL())) {
        int32:inner = raw type_elem(c.types, dty);
        drop irw_raw(w, raw cat5("  %tp = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 0", "", ""));
        drop irw_raw(w, "  %tag = load i8, ptr %tp");
        drop irw_raw(w, "  %has = icmp ne i8 %tag, 0");
        drop irw_raw(w, "  br i1 %has, label %some, label %done");
        drop irw_raw(w, "some:");
        drop irw_raw(w, raw cat5("  %vp = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 1", "", ""));
        drop irw_raw(w, raw cat4("  call void ", raw drop_fn_sym(c, inner),
                          "(ptr %vp)", ""));
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN ARRAY DROPS EVERY ELEMENT, ascending — order among siblings is not
    // observable, and ascending is the cheaper induction.
    if (k == (raw TY_ARRAY())) {
        int32:el = raw type_elem(c.types, dty);
        string:n = int_to_string((raw type_array_count(c.types, dty)) => int64);
        drop irw_raw(w, "  br label %loop");
        drop irw_raw(w, "loop:");
        drop irw_raw(w, "  %i = phi i64 [ 0, %entry ], [ %ni, %body ]");
        drop irw_raw(w, raw cat4("  %at_end = icmp uge i64 %i, ", n, "", ""));
        drop irw_raw(w, "  br i1 %at_end, label %done, label %body");
        drop irw_raw(w, "body:");
        drop irw_raw(w, raw cat5("  %ep = getelementptr ", t.text,
                          ", ptr %v, i32 0, i64 %i", "", ""));
        drop irw_raw(w, raw cat4("  call void ", raw drop_fn_sym(c, el),
                          "(ptr %ep)", ""));
        drop irw_raw(w, "  %ni = add i64 %i, 1");
        drop irw_raw(w, "  br label %loop");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN ARENA DESTROYS ITS SLABS (D-003/D-183, 1.2.5c) — after dropping
    // any still-LIVE owning element: live is an even, non-zero generation
    // (the parity discipline arena_alloc and arena_free keep), the stride is
    // the element's static size, and `npk_arena_destroy` is already
    // idempotent, so an explicit `.destroy()` before scope exit stays legal
    // and the drop's call after it frees nothing twice.
    if (k == (raw TY_ARENA())) {
        int32:ael = (raw tt_get(c.types, dty)).a;
        if (raw type_drops_recorded(c.types, ael, 64i32)) {
            string:astr = int_to_string(raw type_size(c.types, ael));
            drop irw_raw(w, raw cat3("  %slab = load ptr, ptr %v", "", ""));
            drop irw_raw(w, "  %sdead = icmp eq ptr %slab, null");
            drop irw_raw(w, "  br i1 %sdead, label %done, label %walkp");
            drop irw_raw(w, "walkp:");
            drop irw_raw(w, raw cat3("  %gp = getelementptr ", t.text,
                              ", ptr %v, i32 0, i32 1"));
            drop irw_raw(w, "  %gens = load ptr, ptr %gp");
            drop irw_raw(w, raw cat3("  %tp = getelementptr ", t.text,
                              ", ptr %v, i32 0, i32 3"));
            drop irw_raw(w, "  %top = load i64, ptr %tp");
            drop irw_raw(w, "  br label %walk");
            drop irw_raw(w, "walk:");
            drop irw_raw(w, "  %i = phi i64 [ 0, %walkp ], [ %i2, %next ]");
            drop irw_raw(w, "  %in = icmp ult i64 %i, %top");
            drop irw_raw(w, "  br i1 %in, label %probe, label %done");
            drop irw_raw(w, "probe:");
            drop irw_raw(w, "  %gep = getelementptr i32, ptr %gens, i64 %i");
            drop irw_raw(w, "  %g = load i32, ptr %gep");
            drop irw_raw(w, "  %nz = icmp ne i32 %g, 0");
            drop irw_raw(w, "  %par = and i32 %g, 1");
            drop irw_raw(w, "  %ev = icmp eq i32 %par, 0");
            drop irw_raw(w, "  %live = and i1 %nz, %ev");
            drop irw_raw(w, "  br i1 %live, label %del, label %next");
            drop irw_raw(w, "del:");
            drop irw_raw(w, raw cat3("  %off = mul i64 %i, ", astr, ""));
            drop irw_raw(w, "  %ep = getelementptr i8, ptr %slab, i64 %off");
            drop irw_raw(w, raw cat4("  call void ",
                              raw drop_fn_sym(c, ael), "(ptr %ep)", ""));
            drop irw_raw(w, "  br label %next");
            drop irw_raw(w, "next:");
            drop irw_raw(w, "  %i2 = add i64 %i, 1");
            drop irw_raw(w, "  br label %walk");
            drop irw_raw(w, "done:");
        }
        drop irw_raw(w, "  call void @npk_arena_destroy(ptr %v)");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // A `shared_arena`'s DROP IS ITS TEARDOWN (D-154/D-207, 1.4.4). The
    // value is one pointer to the runtime structure, so the drop is the
    // null-checked release the guard's already is — and it NULLS THE SLOT
    // after, which is what makes an explicit `.destroy()` earlier in the
    // scope and this call at its exit add up to exactly one teardown.
    // (`npk_sarena_destroy` frees the structure itself, so unlike
    // `npk_arena_destroy` it cannot be idempotent on its own; the emitter's
    // `.destroy()` clears the binding's drop flag for the straight-line
    // case, and this null is the belt for a conditional one.) There is no
    // element walk: D-154's contract is write-once, read-only slots, so an
    // owning element would need the deep-view family D-183 records as owed
    // and `alloc` refuses one at the checker.
    if (k == (raw TY_SHARED_ARENA())) {
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        drop irw_raw(w, "  call void @npk_sarena_destroy(ptr %c)");
        drop irw_raw(w, "  store ptr null, ptr %v");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // A GUARD'S DROP IS THE RELEASE (D-056, 1.1.11) — the first drop in the
    // language that frees no memory: the closing brace of the critical
    // section lowers to exactly this call, which is what cycle 1.2 existed
    // to make possible. Null (a zeroed frame slot) releases nothing.
    if (k == (raw TY_GUARD())) {
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %rel");
        drop irw_raw(w, "rel:");
        drop irw_raw(w, "  call void @npk_guard_release(ptr %c)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN RGUARD'S DROP RELEASES A READER (D-056, 1.1.11b); null releases
    // nothing, like the write guard's.
    if (k == (raw TY_RGUARD())) {
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %rel");
        drop irw_raw(w, "rel:");
        drop irw_raw(w, "  call void @npk_rw_release_read(ptr %c)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN RWLOCK OWNS ITS CELL AND ELEMENT like the mutex; a CONDVAR and a
    // BARRIER own bare cells (D-056, 1.1.11b). By the join discipline nobody
    // waits at the owner's exit.
    if (k == (raw TY_RWLOCK())) {
        int32:rwel = raw type_elem(c.types, dty);
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        if (raw type_drops_recorded(c.types, rwel, 64i32)) {
            drop irw_raw(w, "  %ep = getelementptr i8, ptr %c, i64 24");
            drop irw_raw(w, raw cat4("  call void ",
                              raw drop_fn_sym(c, rwel), "(ptr %ep)", ""));
        }
        drop irw_raw(w, "  call void @npk_dalloc(ptr %c)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }
    if (k == (raw TY_CONDVAR())) {
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        drop irw_raw(w, "  call void @npk_dalloc(ptr %c)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }
    if (k == (raw TY_BARRIER())) {
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        drop irw_raw(w, "  call void @npk_dalloc(ptr %c)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // A MUTEX OWNS ITS CELL AND ITS ELEMENT (D-056/D-183): by the join
    // discipline nobody holds it at the owner's exit, so the element drops
    // (at cell+16, when it owns) and the cell goes back.
    if (k == (raw TY_MUTEX())) {
        int32:mel = raw type_elem(c.types, dty);
        drop irw_raw(w, "  %c = load ptr, ptr %v");
        drop irw_raw(w, "  %dead = icmp eq ptr %c, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        if (raw type_drops_recorded(c.types, mel, 64i32)) {
            drop irw_raw(w, "  %ep = getelementptr i8, ptr %c, i64 24");
            drop irw_raw(w, raw cat4("  call void ",
                              raw drop_fn_sym(c, mel), "(ptr %ep)", ""));
        }
        drop irw_raw(w, "  call void @npk_dalloc(ptr %c)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN OwnedFd's DROP CLOSES ITS DESCRIPTOR (D-185, 1.1.12b). The kernel's
    // verdict is not observable from a drop — a caller that must see it says
    // `close(release_fd(move o))` instead; on Linux the descriptor is gone
    // either way. Negative means a zeroed slot (an empty enum arm's payload):
    // nothing to close.
    if (k == (raw TY_OWNEDFD())) {
        drop irw_raw(w, "  %f = load i32, ptr %v");
        drop irw_raw(w, "  %dead = icmp slt i32 %f, 0");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        drop irw_raw(w, "  call void @npk_ofd_close(i32 %f)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // A `dyn` DROPS THROUGH THE VTABLE'S SLOT 0 (D-183, 1.2.4): the concrete
    // type is erased, so only the table built beside the value knows which
    // drop applies — null there means the concrete owns nothing. The cell is
    // the `dyn`'s own storage either way and is always handed back. Null
    // DATA is a zeroed frame or an empty enum arm's payload slot: nothing.
    if (k == (raw TY_DYN())) {
        drop irw_raw(w, raw cat3("  %dp = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 0"));
        drop irw_raw(w, "  %d = load ptr, ptr %dp");
        drop irw_raw(w, "  %dead = icmp eq ptr %d, null");
        drop irw_raw(w, "  br i1 %dead, label %done, label %live");
        drop irw_raw(w, "live:");
        drop irw_raw(w, raw cat3("  %vtp = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 1"));
        drop irw_raw(w, "  %vt = load ptr, ptr %vtp");
        drop irw_raw(w, "  %s0 = load ptr, ptr %vt");
        drop irw_raw(w, "  %inert = icmp eq ptr %s0, null");
        drop irw_raw(w, "  br i1 %inert, label %free, label %call");
        drop irw_raw(w, "call:");
        drop irw_raw(w, "  call void %s0(ptr %d)");
        drop irw_raw(w, "  br label %free");
        drop irw_raw(w, "free:");
        drop irw_raw(w, "  call void @npk_dalloc(ptr %d)");
        drop irw_raw(w, "  br label %done");
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN ENUM DROPS ITS LIVE VARIANT'S OWNING PAYLOADS (1.4.1) — a tag
    // switch to the one variant that is live, then that variant's owning
    // payloads in REVERSE payload order, the struct rule applied to the
    // variant. The walkers-total instrument's FIRST RUN found this arm
    // missing: the silent `ret void` default below stood in for it, so an
    // enum owning a string leaked its body at every scope exit since 1.2 —
    // green throughout, because a managed-heap leak shows up in no counter a
    // program can read. Tags come from `variant_tag_of` and offsets from
    // `variant_payload_slot_at` — the SAME functions construction and `pick`
    // binding read — so the three sites cannot drift.
    if (k == (raw TY_ENUM())) {
        DeclId:edid = DeclId{ index: raw type_decl(c.types, dty) };
        DeclNode:ed = raw ast_decl(ast, edid);
        int32:ehome = raw symtab_home_scope(tab, edid.index, 0i32);
        // Pass 1: the switch's arm list — only variants owning something.
        string:arms = "";
        bool:have_arm = false;
        int32:vi = 0i32;
        while (vi < (raw item_member_count(ast, ed))) {
            DeclNode:vm = raw ast_decl(ast, raw item_member(ast, ed, vi));
            if (vm.kind == DeclKind.DeclEnumVariant) {
                bool:owns = false;
                int32:pc = raw variant_payload_count(vm);
                for (int32:pj in 0i32...pc) {
                    PayloadSlot:ps = raw variant_payload_slot_at(tr, c.types,
                                         ast, tab, ehome, dty,
                                         raw decl_name(vm), pj);
                    if (ps.ok) {
                        if (raw type_drops_recorded(c.types, ps.type_id, 64i32)) {
                            owns = true;
                        }
                    }
                }
                if (owns) {
                    string:a1 = raw cat5(" i32 ",
                                    int_to_string((raw variant_tag_of(ast, vm, vi)) => int64),
                                    ", label %var",
                                    int_to_string(vi => int64), "");
                    arms = string_concat(arms, a1);
                    have_arm = true;
                }
            }
            vi = vi + 1i32;
        }
        if (!have_arm) {
            // Registered, but no variant owns anything this walk can see —
            // nothing to release, and an empty body is the CORRECT body.
            drop irw_raw(w, "  ret void");
            drop irw_raw(w, "}");
            pass NIL;
        }
        drop irw_raw(w, raw cat4("  %tp = getelementptr ", t.text,
                          ", ptr %v, i32 0, i32 0", ""));
        drop irw_raw(w, "  %tag = load i32, ptr %tp");
        drop irw_raw(w, raw cat4("  switch i32 %tag, label %done [", arms,
                          " ]", ""));
        // Pass 2: one block per owning variant.
        vi = 0i32;
        while (vi < (raw item_member_count(ast, ed))) {
            DeclNode:vm = raw ast_decl(ast, raw item_member(ast, ed, vi));
            if (vm.kind == DeclKind.DeclEnumVariant) {
                bool:owns2 = false;
                int32:pc2 = raw variant_payload_count(vm);
                int32:q = 0i32;
                while (q < pc2) {
                    PayloadSlot:qs = raw variant_payload_slot_at(tr, c.types,
                                         ast, tab, ehome, dty,
                                         raw decl_name(vm), q);
                    if (qs.ok) {
                        if (raw type_drops_recorded(c.types, qs.type_id, 64i32)) {
                            owns2 = true;
                        }
                    }
                    q = q + 1i32;
                }
                if (owns2) {
                    drop irw_raw(w, raw cat3("var",
                                      int_to_string(vi => int64), ":"));
                    drop irw_raw(w, raw cat5("  %pa",
                                      int_to_string(vi => int64),
                                      " = getelementptr ", t.text,
                                      ", ptr %v, i32 0, i32 1"));
                    int32:rj = pc2;
                    while (rj > 0i32) {
                        rj = rj - 1i32;
                        PayloadSlot:rs = raw variant_payload_slot_at(tr, c.types,
                                             ast, tab, ehome, dty,
                                             raw decl_name(vm), rj);
                        if (rs.ok) {
                            if (raw type_drops_recorded(c.types, rs.type_id, 64i32)) {
                                string:pp = raw cat3("%pa",
                                                int_to_string(vi => int64), "");
                                if (rs.offset != 0i64) {
                                    string:pn = raw cat5("%p",
                                                    int_to_string(vi => int64),
                                                    "_",
                                                    int_to_string(rj => int64), "");
                                    drop irw_raw(w, raw cat5("  ", pn,
                                                      " = getelementptr i8, ptr ",
                                                      pp,
                                                      string_concat(", i64 ",
                                                          int_to_string(rs.offset))));
                                    pp = raw cat5("%p",
                                             int_to_string(vi => int64),
                                             "_",
                                             int_to_string(rj => int64), "");
                                }
                                drop irw_raw(w, raw cat5("  call void ",
                                                  raw drop_fn_sym(c, rs.type_id),
                                                  "(ptr ", pp, ")"));
                            }
                        }
                    }
                    drop irw_raw(w, "  br label %done");
                }
            }
            vi = vi + 1i32;
        }
        drop irw_raw(w, "done:");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // A STRUCT DROPS ITS FIELDS IN REVERSE DECLARATION ORDER (D-183), and
    // only the ones that own something.
    if (k == (raw TY_STRUCT())) {
        DeclId:did = DeclId{ index: raw type_decl(c.types, dty) };
        DeclNode:d = raw ast_decl(ast, did);
        int32:home = raw symtab_home_scope(tab, did.index, 0i32);
        // count the fields first, so the walk can run backwards
        int32:nf = 0i32;
        int32:m = 0i32;
        while (m < (raw item_member_count(ast, d))) {
            DeclNode:fm = raw ast_decl(ast, raw item_member(ast, d, m));
            if (fm.kind == DeclKind.DeclFieldDecl) { nf = nf + 1i32; }
            m = m + 1i32;
        }
        int32:fi = nf;
        while (fi > 0i32) {
            fi = fi - 1i32;
            // find the fi'th field decl
            int32:seen = 0i32;
            int32:q = 0i32;
            while (q < (raw item_member_count(ast, d))) {
                DeclNode:fm = raw ast_decl(ast, raw item_member(ast, d, q));
                if (fm.kind == DeclKind.DeclFieldDecl) {
                    if (seen == fi) {
                        // THROUGH THE BOUND WALK, NEVER A RAW RE-RESOLVE
                        // (1.1.12c): this is a TEMPLATE's field node, and for
                        // a generic instance its `W` means the instance's
                        // argument — the raw form resolved it with no binding,
                        // so the first drop body generated for a struct whose
                        // field is itself a generic instance reported "there
                        // is no type named `W`" against a correct program.
                        // `struct_field` binds the instance's arguments.
                        FieldInfo:bfi = raw struct_field(tr, dty,
                                            raw decl_name(fm), home);
                        int32:ft = 0i32;
                        if (bfi.found) { ft = bfi.type_id; }
                        if (raw type_drops_recorded(c.types, ft, 64i32)) {
                            string:g = raw cat5("  %f", int_to_string(fi => int64),
                                          " = getelementptr ", t.text, "");
                            drop irw_raw(w, raw cat5(g, ", ptr %v, i32 0, i32 ",
                                              int_to_string(fi => int64), "", ""));
                            drop irw_raw(w, raw cat5("  call void ",
                                              raw drop_fn_sym(c, ft), "(ptr %f",
                                              int_to_string(fi => int64), ")"));
                        }
                        q = raw item_member_count(ast, d);
                    } else {
                        seen = seen + 1i32;
                        q = q + 1i32;
                    }
                } else {
                    q = q + 1i32;
                }
            }
        }
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // Anything else registered is a defect: `type_drops` said it owns
    // something and this does not know how to release it. SAY SO (1.4.1) —
    // until the walkers-total instrument's first run, this default emitted a
    // VALID EMPTY BODY, which is a silent leak wearing a completed compile;
    // the missing TY_ENUM arm above hid behind it for two cycles. The body
    // still closes so the IR stays well-formed behind the failing build.
    Span:dsp = raw span_make(0i32, 0i32, 0i32, 0i32, 0i32);
    int32:ddecl = raw type_decl(c.types, dty);
    if (ddecl > 0i32) {
        dsp = (raw ast_decl(ast, DeclId{ index: ddecl })).span;
    }
    drop diaglist_push(diags,
        raw diag_error(raw EMIT_INTERNAL(),
            "a drop body was requested for a type kind this generator has no arm for -- `type_drops` claims the type owns something, so an empty body would be a silent leak; a defect in the compiler rather than in this program",
            dsp));
    drop irw_raw(w, "  ret void");
    drop irw_raw(w, "}");
    pass NIL;
};

// THE VACANT BODY (D-225) -- THE FIXUPS ONLY. Its caller stores
// `zeroinitializer` over the whole slot first, so this writes only what a zero
// fill gets WRONG.
//
// Today that is `OwnedFd` and nothing else. Its drop gates on
// `icmp slt i32 %f, 0`, so a zeroed slot holds descriptor 0 -- stdin -- and the
// unconditional overwrite-drop would close it silently, with no trap: strictly
// worse than the -4102 D-225 was written to fix. Re-biasing the representation
// so zero were vacant was REJECTED; what must be uniform is the invariant
// (vacant drops as a no-op), not the bit pattern, and the string trio already
// spells vacant `cap == 0` where `dyn` spells it null.
//
// AN UNHANDLED KIND IS CORRECT HERE, unlike in the drop generator, where it is
// a reported defect: all-zeroes IS the vacant value for every other kind, so an
// empty body is the right answer rather than a silent leak.
func:emit_one_vacant = NIL(IrWriter->:w, LlCtx->:c, TypeResolver->:tr,
                           Ast->:ast, SymbolTable->:tab,
                           int32:dty) never fails {
    LlType:t = raw ll_type(c, dty);
    if (!(raw ll_is_ok(t))) { pass NIL; }
    drop irw_raw(w, raw cat4("define internal void ",
                      raw vacant_fn_sym(c, dty), "(ptr %v) {", ""));
    drop irw_raw(w, "entry:");
    int32:k = raw type_kind(c.types, dty);

    if (k == (raw TY_OWNEDFD())) {
        drop irw_raw(w, "  store i32 -1, ptr %v");
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    if (k == (raw TY_ARRAY())) {
        int32:el = raw type_elem(c.types, dty);
        if (raw type_drops_recorded(c.types, el, 64i32)) {
            string:n = int_to_string((raw type_array_count(c.types, dty)) => int64);
            drop irw_raw(w, "  br label %loop");
            drop irw_raw(w, "loop:");
            drop irw_raw(w, "  %i = phi i64 [ 0, %entry ], [ %ni, %body ]");
            drop irw_raw(w, raw cat4("  %at_end = icmp uge i64 %i, ", n, "", ""));
            drop irw_raw(w, "  br i1 %at_end, label %done, label %body");
            drop irw_raw(w, "body:");
            drop irw_raw(w, raw cat5("  %ep = getelementptr ", t.text,
                              ", ptr %v, i32 0, i64 %i", "", ""));
            drop irw_raw(w, raw cat4("  call void ", raw vacant_fn_sym(c, el),
                              "(ptr %ep)", ""));
            drop irw_raw(w, "  %ni = add i64 %i, 1");
            drop irw_raw(w, "  br label %loop");
            drop irw_raw(w, "done:");
        }
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    // AN ENUM IS FIXED ALONG THE TAG-0 PROJECTION ALONE (D-225). A zeroed enum
    // reads as tag 0, so only variant 0's payload is live; variant layouts
    // OVERLAP, and writing -1 through variant 1's descriptor offset can land in
    // variant 0's `cap` field and turn the vacant value back into a freeable
    // one. No switch: the tag is known.
    if (k == (raw TY_ENUM())) {
        DeclId:edid = DeclId{ index: raw type_decl(c.types, dty) };
        DeclNode:ed = raw ast_decl(ast, edid);
        int32:ehome = raw symtab_home_scope(tab, edid.index, 0i32);
        int32:vi = 0i32;
        while (vi < (raw item_member_count(ast, ed))) {
            DeclNode:vm = raw ast_decl(ast, raw item_member(ast, ed, vi));
            if (vm.kind == DeclKind.DeclEnumVariant) {
                if ((raw variant_tag_of(ast, vm, vi)) == 0i32) {
                    int32:pc = raw variant_payload_count(vm);
                    for (int32:pj in 0i32...pc) {
                        PayloadSlot:ps = raw variant_payload_slot_at(tr, c.types,
                                             ast, tab, ehome, dty,
                                             raw decl_name(vm), pj);
                        if (ps.ok) {
                            if (raw type_drops_recorded(c.types, ps.type_id, 64i32)) {
                                drop irw_raw(w, raw cat5("  %pa",
                                                  int_to_string(pj => int64),
                                                  " = getelementptr ", t.text,
                                                  ", ptr %v, i32 0, i32 1"));
                                string:pp = raw cat3("%pa",
                                                int_to_string(pj => int64), "");
                                if (ps.offset != 0i64) {
                                    string:pn = raw cat3("%pf",
                                                    int_to_string(pj => int64), "");
                                    drop irw_raw(w, raw cat5("  ", pn,
                                                      " = getelementptr i8, ptr ",
                                                      pp,
                                                      string_concat(", i64 ",
                                                          int_to_string(ps.offset))));
                                    pp = raw cat3("%pf",
                                             int_to_string(pj => int64), "");
                                }
                                drop irw_raw(w, raw cat5("  call void ",
                                                  raw vacant_fn_sym(c, ps.type_id),
                                                  "(ptr ", pp, ")"));
                            }
                        }
                    }
                }
            }
            vi = vi + 1i32;
        }
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    if (k == (raw TY_STRUCT())) {
        DeclId:did = DeclId{ index: raw type_decl(c.types, dty) };
        DeclNode:d = raw ast_decl(ast, did);
        int32:home = raw symtab_home_scope(tab, did.index, 0i32);
        int32:fi = 0i32;
        int32:q = 0i32;
        while (q < (raw item_member_count(ast, d))) {
            DeclNode:fm = raw ast_decl(ast, raw item_member(ast, d, q));
            if (fm.kind == DeclKind.DeclFieldDecl) {
                // THROUGH THE BOUND WALK (1.1.12c), for the same reason the
                // drop generator does it: a generic instance's field type is
                // the instance's argument, and a raw re-resolve reports "there
                // is no type named `W`" against a correct program.
                FieldInfo:bfi = raw struct_field(tr, dty, raw decl_name(fm), home);
                int32:ft = 0i32;
                if (bfi.found) { ft = bfi.type_id; }
                if (raw type_drops_recorded(c.types, ft, 64i32)) {
                    drop irw_raw(w, raw cat5("  %f", int_to_string(fi => int64),
                                      " = getelementptr ", t.text,
                                      raw cat3(", ptr %v, i32 0, i32 ",
                                          int_to_string(fi => int64), "")));
                    drop irw_raw(w, raw cat5("  call void ",
                                      raw vacant_fn_sym(c, ft), "(ptr %f",
                                      int_to_string(fi => int64), ")"));
                }
                fi = fi + 1i32;
            }
            q = q + 1i32;
        }
        drop irw_raw(w, "  ret void");
        drop irw_raw(w, "}");
        pass NIL;
    }

    drop irw_raw(w, "  ret void");
    drop irw_raw(w, "}");
    pass NIL;
};

func:emit_late_headers = NIL(IrWriter->:w, TypeResolver->:tr, LlCtx->:c,
                             DiagList->:diags, ModuleGraph->:g, int32:from) never fails {
    int32:t = from;
    bool:some = false;
    while (t < (raw tt_count(c.types))) {
        if ((raw type_args_count_of(c.types, t)) > 0i32) {
            if (!some) { drop irw_blank(w); some = true; }
            drop emit_instance_header(w, tr, c, diags, g, t);
        }
        t = t + 1i32;
    }
    pass NIL;
};

// The scope an impl was collected in (its module's), or 0.
func:impl_scope_of = int32(ImplTable->:t, int32:impl_decl) never fails {
    int32:i = 0i32;
    while ((i => int64) < t.v.count) {
        ImplEntry:e = raw impl_at(t, i);
        if (e.decl == impl_decl) { pass e.scope; }
        i = i + 1i32;
    }
    pass 0i32;
};

// Does any of this instantiation's arguments still name a parameter? (1.0.7)
func:fninst_is_template = bool(Ast->:ast, LlCtx->:c, FnInstance:inst) never fails {
    int32:i = 0i32;
    while (i < inst.args_count) {
        if (raw type_mentions_param(c.types, ast,
                                    raw ast_id_at(ast, inst.args_start, i),
                                    64i32)) {
            pass true;
        }
        i = i + 1i32;
    }
    pass false;
};

// `extract<int32>` — the D-108 spelling for a function instantiation: the
// declaration's name with its arguments, which `mangled_fn_sym` then qualifies
// and quotes (D-156). Interned, because a symbol is a name.
func:fninst_symbol = int32(Ast->:ast, LlCtx->:c, FnInstance:inst) never fails {
    DeclNode:d = raw ast_decl(ast, DeclId{ index: inst.decl });
    string:m = string_concat(
                   raw intern_get(c.interns, raw decl_name(d)), "<");
    int32:i = 0i32;
    while (i < inst.args_count) {
        if (i > 0i32) { m = string_concat(m, ", "); }
        m = string_concat(m,
                raw type_display(c.types, c.interns,
                    raw ast_id_at(ast, inst.args_start, i)));
        i = i + 1i32;
    }
    pass (raw intern_add(c.interns, string_concat(m, ">")));
};

// THE SITE TABLES (D-179, 1.1.6): what the origin chain's ids mean. One line
// table, one path table (a byte constant per distinct site, headers in the
// table), and two internal lookup functions the `site_line`/`site_path`
// builtins call — bounds-checked, answering 0/"" for the runtime's reserved
// site 0 and anything out of range. Emitted per program, deterministic in
// registration order (D-078).
func:emit_site_tables = NIL(IrWriter->:w) never fails {
    int32:n = (w.site_lines.count) =>! int32;   // bounded by irw_site's own `i + 1i32`
    // the byte constants first
    int32:i = 0i32;
    while (i < n) {
        string->:sp2 = $$i w.site_paths.items[i => int64];
        string:enc = "";
        int64:bj = 0i64;
        while (bj < sp2.len) {
            enc = string_concat(enc, raw esc_byte(sp2.ptr[bj] => uint8));
            bj = bj + 1i64;
        }
        drop irw_raw(w, raw cat5("@npk.sitep.", int_to_string((i + 1i32) => int64),
                          " = internal constant [", int_to_string(sp2.len),
                          raw cat3(" x i8] c\"", enc, "\"")));
        i = i + 1i32;
    }
    // the line table, index 0 = the runtime's reserved site
    string:ls = "i32 0";
    i = 0i32;
    while (i < n) {
        ls = raw cat3(ls, ", i32 ",
                 int_to_string(w.site_lines.items[i => int64] => int64));
        i = i + 1i32;
    }
    drop irw_raw(w, raw cat5("@npk.site.lines = internal constant [",
                      int_to_string((n + 1i32) => int64), " x i32] [", ls, "]"));
    // the path header table: { ptr, i64 } pairs (pointer, byte length)
    string:ps = "{ ptr, i64 } { ptr null, i64 0 }";
    i = 0i32;
    while (i < n) {
        string->:sp3 = $$i w.site_paths.items[i => int64];
        ps = raw cat5(ps, ", { ptr, i64 } { ptr @npk.sitep.",
                 int_to_string((i + 1i32) => int64),
                 ", i64 ", string_concat(int_to_string(sp3.len), " }"));
        i = i + 1i32;
    }
    drop irw_raw(w, raw cat5("@npk.site.paths = internal constant [",
                      int_to_string((n + 1i32) => int64), " x { ptr, i64 }] [",
                      ps, "]"));
    // the lookups
    string:cnt = int_to_string((n + 1i32) => int64);
    drop irw_raw(w, "define internal i32 @npk_site_line(i32 %i) {");
    drop irw_raw(w, "entry:");
    drop irw_raw(w, raw cat3("  %ok = icmp ult i32 %i, ", cnt, ""));
    drop irw_raw(w, "  br i1 %ok, label %in, label %out");
    drop irw_raw(w, "in:");
    drop irw_raw(w, raw cat5("  %p = getelementptr [", cnt,
                      " x i32], ptr @npk.site.lines, i32 0, i32 %i", "", ""));
    drop irw_raw(w, "  %v = load i32, ptr %p");
    drop irw_raw(w, "  ret i32 %v");
    drop irw_raw(w, "out:");
    drop irw_raw(w, "  ret i32 0");
    drop irw_raw(w, "}");
    drop irw_blank(w);
    drop irw_raw(w, "define internal { ptr, i64, i64 } @npk_site_path(i32 %i) {");
    drop irw_raw(w, "entry:");
    drop irw_raw(w, raw cat3("  %ok = icmp ult i32 %i, ", cnt, ""));
    drop irw_raw(w, "  br i1 %ok, label %in, label %out");
    drop irw_raw(w, "in:");
    drop irw_raw(w, raw cat5("  %p = getelementptr [", cnt,
                      " x { ptr, i64 }], ptr @npk.site.paths, i32 0, i32 %i", "", ""));
    drop irw_raw(w, "  %hp = getelementptr { ptr, i64 }, ptr %p, i32 0, i32 0");
    drop irw_raw(w, "  %hv = load ptr, ptr %hp");
    drop irw_raw(w, "  %lp = getelementptr { ptr, i64 }, ptr %p, i32 0, i32 1");
    drop irw_raw(w, "  %lv = load i64, ptr %lp");
    drop irw_raw(w, "  %r0 = insertvalue { ptr, i64, i64 } undef, ptr %hv, 0");
    drop irw_raw(w, "  %r1 = insertvalue { ptr, i64, i64 } %r0, i64 %lv, 1");
    drop irw_raw(w, "  %r2 = insertvalue { ptr, i64, i64 } %r1, i64 %lv, 2");
    drop irw_raw(w, "  ret { ptr, i64, i64 } %r2");
    drop irw_raw(w, "out:");
    drop irw_raw(w, "  ret { ptr, i64, i64 } zeroinitializer");
    drop irw_raw(w, "}");
    drop irw_blank(w);
    pass NIL;
};
