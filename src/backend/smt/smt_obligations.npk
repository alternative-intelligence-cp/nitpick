// smt_obligations — THE WALK'S GLUE INTO THE EMITTER (1.5.0; P-3): one call
// per function instance, from `emit_function_body_subst`, after the
// parameters are bound and before the body is lowered, inside the instance's
// generic window -- and, since 1.5.2 step 2, one call per `Rules` declaration
// from `emit_rule_fn`, over its clauses. It runs the walk (`smt_encode.npk`),
// fills the elision answers the guard emitters consult (`LlCtx.el_sites`/
// `el_kinds`/`el_spaces`, cleared per function), and appends the function's
// solver file and rows to the program's table (`smt_table.npk`) when
// `--obligations` asked for them.

mod:smt_obligations;

use "../../frontend/ast.npk".*;
use "../../frontend/parse_decl.npk".*;
use "../ir/ir_types.npk".*;
use "../ir/ir_expr.npk".*;
use "./smt_kinds.npk".*;
use "./smt_table.npk".*;
use "./smt_encode.npk".*;

// THE CALL PER FUNCTION INSTANCE, from `emit_function_body_subst` after the
// parameters are bound and before the body is lowered, inside the instance's
// generic window. `pnames`/`ptypes` are the parameters as the emitter
// resolved them (the same types its slots have); `prules`/`pdecls` their
// `Rules` (0 for none) and declaration ids (1.5.2 step 2, D-251).
pub func:obl_function = NIL(ExprEmitter->:x, string:symbol, List<int32>:pnames,
                            List<int32>:ptypes, List<int32>:prules,
                            List<int32>:pdecls, StmtId:body, DeclId:did,
                            bool:is_failsafe, int32:ret_type) never fails {
    LlCtx->:c = x.fe.ctx;
    drop list_clear(@c.el_sites);
    drop list_clear(@c.el_kinds);
    drop list_clear(@c.el_spaces);
    drop list_clear(@c.el_ctxs);
    drop list_clear(@c.pv_sites);
    drop list_clear(@c.pv_hashes);
    if (c.obl == NULL) { pass NIL; }
    Encoder:en = raw enc_init(x.ast, x.et, x.tab, c.types, x.interns, c, x.tr, x.scope, symbol);
    // THE CONTRACTS' CONTEXT (1.5.3 step 2): the declaration whose
    // `requires`/`ensures` the walk records, its impl and trait for the
    // conformance rows, its success type for `result`, and `failsafe`.
    en.fn_decl = did.index;
    en.impl_decl = x.cur_impl;
    en.trait_ty = x.cur_trait;
    en.ret_type = ret_type;
    en.is_failsafe = is_failsafe;
    drop enc_prepare(@en, body);   // the escape set before any name is bound (DEF-14)
    for (int64:i in 0i64...pnames.count) {
        drop enc_param(@en, pnames[i], ptypes[i], prules[i], pdecls[i]);
    }
    drop enc_entry_contracts(@en);   // the entry row and its hypothesis; the conformance rows
    drop enc_body(@en, body);
    drop obl_finish(x, symbol, @en);
    pass NIL;
};

// THE CALL PER `Rules` DECLARATION (1.5.2 step 2, D-251), from `emit_rule_fn`
// after the subject is bound and before the clauses are lowered: the subject
// is the one parameter (opaque -- its range axiom is all the walk knows), and
// each clause is walked for its own sites. A rule body has no write point, so
// no `limit` row of its own; refinements are calls to their own functions,
// whose clauses are walked there.
pub func:obl_rule = NIL(ExprEmitter->:x, string:symbol, int32:subject_name,
                        int32:subject_type, DeclId:rd) never fails {
    LlCtx->:c = x.fe.ctx;
    drop list_clear(@c.el_sites);
    drop list_clear(@c.el_kinds);
    drop list_clear(@c.el_spaces);
    drop list_clear(@c.el_ctxs);
    drop list_clear(@c.pv_sites);
    drop list_clear(@c.pv_hashes);
    if (c.obl == NULL) { pass NIL; }
    Encoder:en = raw enc_init(x.ast, x.et, x.tab, c.types, x.interns, c, x.tr, x.scope, symbol);
    drop enc_param(@en, subject_name, subject_type, 0i32, 0i32);
    drop enc_subject(@en, subject_name);
    DeclNode:d = raw ast_decl(x.ast, rd);
    int32:cn = raw rule_clause_count(x.ast, d);
    for (int32:j in 0i32...cn) { drop enc_clause(@en, raw rule_clause(x.ast, d, j)); }
    drop obl_finish(x, symbol, @en);
    pass NIL;
};

// THE SHARED TAIL: the cones and hashes, the elision answers (a row that is
// both discharged and encoded), and -- when files were asked for -- the
// function's solver file and its `rows.txt` lines.
func:obl_finish = NIL(ExprEmitter->:x, string:symbol, Encoder->:en) never fails {
    LlCtx->:c = x.fe.ctx;
    drop enc_finish(en);
    if (en.obls.count == 0i64) { pass NIL; }
    // THE `prove` ROWS' HASHES (1.5.4 step 4, L-16): what the emitter's
    // refusal looks up in the manifest to name the verdict.
    for (int64:pi in 0i64...en.obls.count) {
        if (en.obls[pi].kind == (raw OK_PROVE())) {
            drop list_push(@c.pv_sites, en.obls[pi].site);
            drop list_push(@c.pv_hashes, string_concat(en.obls[pi].hash, ""));
        }
    }
    if (c.obl.elide.count > 0i64) {
        drop enc_mark_discharged(en, c.obl.elide);
        for (int64:oi in 0i64...en.obls.count) {
            if (en.obls[oi].discharged && en.obls[oi].encoded) {
                drop list_push(@c.el_sites, en.obls[oi].site);
                drop list_push(@c.el_kinds, en.obls[oi].kind);
                drop list_push(@c.el_spaces, en.obls[oi].space);
                drop list_push(@c.el_ctxs, en.obls[oi].ctx);
            }
        }
    }
    if (!c.obl.want_files) { pass NIL; }
    int64:checks = 0i64;
    for (int64:oi2 in 0i64...en.obls.count) { if (en.obls[oi2].encoded) { checks = checks + 1i64; } }
    drop list_push(@c.obl.files, raw enc_file_text(en));
    drop list_push(@c.obl.file_syms, string_concat(symbol, ""));
    drop list_push(@c.obl.file_checks, checks);
    string:fno = raw file_number(c.obl.files.count);
    // THE TIER-2 TWIN (D-281): the rows the Real-interval abstraction may
    // decide, in a file of their own beside the tier-1 file.
    List<int64>:t2ks = raw list_init::<int64>(4i64);
    string:t2 = raw enc_t2_text(en, @t2ks);
    if (t2ks.count > 0i64) {
        drop list_push(@c.obl.t2_names, string_concat(fno, ""));
        drop list_push(@c.obl.t2_texts, move(t2));
        string:ix = string_concat(fno, "\t");
        ix = string_concat(ix, int_to_string(t2ks.count));
        ix = string_concat(ix, "\t");
        for (int64:ti in 0i64...t2ks.count) {
            if (ti > 0i64) { ix = string_concat(ix, ","); }
            ix = string_concat(ix, int_to_string(t2ks[ti]));
        }
        drop list_push(@c.obl.t2_index, move(ix));
    }
    for (int64:oi3 in 0i64...en.obls.count) {
        string:r = string_concat(fno, "\t");
        r = string_concat(r, int_to_string(oi3 + 1i64));
        r = string_concat(r, "\t");
        r = string_concat(r, raw ok_name(en.obls[oi3].kind));
        r = string_concat(r, "\t");
        r = string_concat(r, string_from_bytes(en.obls[oi3].hash.ptr, en.obls[oi3].hash.len));
        r = string_concat(r, "\t");
        if (en.obls[oi3].encoded) { r = string_concat(r, "1"); c.obl.encoded_rows = c.obl.encoded_rows + 1i64; }
        else {
            if (en.obls[oi3].checker) { r = string_concat(r, "c"); c.obl.checker_rows = c.obl.checker_rows + 1i64; }
            else { r = string_concat(r, "0"); c.obl.unencoded_rows = c.obl.unencoded_rows + 1i64; }
        }
        r = string_concat(r, "\t");
        r = string_concat(r, symbol);
        // THE SITE, THE ROLE, THE GROUP, THE TRAPS (1.5.3 step 2, L-13):
        // what the runners' belts count sites and traps by.
        r = string_concat(r, "\t");
        r = string_concat(r, int_to_string(en.obls[oi3].space => int64));
        r = string_concat(r, ":");
        r = string_concat(r, int_to_string(en.obls[oi3].site => int64));
        r = string_concat(r, "\t");
        r = string_concat(r, raw role_name(en.obls[oi3].role));
        r = string_concat(r, "\t");
        r = string_concat(r, int_to_string(en.obls[oi3].group => int64));
        r = string_concat(r, "\t");
        r = string_concat(r, int_to_string(en.obls[oi3].traps => int64));
        // THE TIER (D-281, 1.5.4b step 3): the eleventh field.
        r = string_concat(r, "\t");
        r = string_concat(r, string_from_bytes(en.obls[oi3].tier.ptr, en.obls[oi3].tier.len));
        drop list_push(@c.obl.rows, move(r));
    }
    pass NIL;
};
