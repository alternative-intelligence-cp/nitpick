// smt_table — THE PER-PROGRAM OBLIGATION TABLE, the data half (1.5.0; P-3,
// P-6, P-12): what `--obligations` writes and what `--elide` hands the
// emitter. A leaf module -- `LlCtx` carries a pointer to one, so this cannot
// import the emitter; the walk that fills it is `smt_obligations.npk`.
//
//   <dir>/NNNN.smt2   one per function with obligations, in emission order
//   <dir>/index.txt   NNNN<TAB>symbol<TAB>checks
//   <dir>/rows.txt    NNNN<TAB>k<TAB>kind<TAB>hash<TAB>encoded<TAB>symbol<TAB>space:site<TAB>role<TAB>group<TAB>traps
//
// `encoded` is `1` for a row with a `(check-sat)`, `0` for an `unencoded`
// row, and `c` for a row THE FRONTEND DECIDED (1.5.4 step 4, L-20): an
// `exhaustive` row at a `pick` (the 0.5 analysis refused every uncovered
// one), an `assert-static` row (the fold) -- no query, verdict `checker`.
//
// The last four (1.5.3 step 2, L-13): the site's id space and index, the
// row's role (`guard`, `bypass`, `held`, `conform`), the group of rows one
// guard shares, and the traps that guard keeps while any row of the group is
// retained -- what the runners' belts count by.
//
// `k` is the obligation's 1-based index within its function (the file's
// `o<k>` comment), and the runner maps the file's answers to its encoded
// rows in order.

mod:smt_table;

use "../../frontend/diagnostics.npk".*;   // Sink (1.5.1b step 3)

pub struct:ObTable = {
    bool:want_files;         // --obligations DIR was given
    List<string>:elide;      // --elide FILE's discharged hashes ("" count when absent)
    // THE MANIFEST'S EVERY ROW (1.5.4 step 4, L-16): `--elide` was given at
    // all (a manifest with no discharged row is still a manifest), and each
    // row's hash with its verdict word, so a `prove` the manifest does not
    // discharge can say which verdict it carries.
    bool:elide_given;
    List<string>:man_hashes;
    List<string>:man_words;
    List<string>:files;      // each function's .smt2 text, in emission order
    List<string>:file_syms;  // its symbol
    List<int64>:file_checks; // its `(check-sat)` count
    List<string>:rows;       // rows.txt lines
    // THE TIER-2 TWINS (D-281, 1.5.4b step 3): `NNNN.t2.smt2` texts by file
    // number, and `index.t2.txt`'s lines (`NNNN<TAB>count<TAB>k1,k2,...`).
    List<string>:t2_names;
    List<string>:t2_texts;
    List<string>:t2_index;
    int64:encoded_rows;      // totals for the driver's report line
    int64:unencoded_rows;
    int64:checker_rows;
};

pub func:obtable_init = ObTable(bool:want_files) never fails {
    pass ObTable{ want_files: want_files,
                  elide: raw list_init::<string>(8i64),
                  elide_given: false,
                  man_hashes: raw list_init::<string>(8i64),
                  man_words: raw list_init::<string>(8i64),
                  files: raw list_init::<string>(16i64),
                  file_syms: raw list_init::<string>(16i64),
                  file_checks: raw list_init::<int64>(16i64),
                  rows: raw list_init::<string>(32i64),
                  t2_names: raw list_init::<string>(4i64),
                  t2_texts: raw list_init::<string>(4i64),
                  t2_index: raw list_init::<string>(4i64),
                  encoded_rows: 0i64, unencoded_rows: 0i64, checker_rows: 0i64 };
};

// `NNNN`, four digits, 1-based.
pub func:file_number = string(int64:n) never fails {
    string:d = int_to_string(n);
    string:z = "";
    for (int64:i in d.len...4i64) { z = string_concat(z, "0"); }
    pass (string_concat(z, d));
};

// The index and the row list, as the two files' texts.
// THROUGH A SINK (1.5.1b step 3): a row per obligation and a line per file
// are program-sized, and appending each to a growing prefix was quadratic in
// them; the sink's bytes are copied out once.
pub func:obl_index_text = string(ObTable->:t) never fails {
    Sink:s = raw sink_to_buffer(4096i64);
    for (int64:i in 0i64...t.files.count) {
        drop sink_write(@s, raw file_number(i + 1i64));
        drop sink_write(@s, "\t");
        drop sink_write(@s, string_from_bytes(t.file_syms.items[i].ptr, t.file_syms.items[i].len));
        drop sink_write(@s, "\t");
        drop sink_write(@s, int_to_string(t.file_checks.items[i]));
        drop sink_write(@s, "\n");
    }
    pass (raw sink_into_string(move(s)));
};

pub func:obl_t2_index_text = string(ObTable->:t) never fails {
    Sink:s = raw sink_to_buffer(1024i64);
    for (int64:i in 0i64...t.t2_index.count) {
        drop sink_write(@s, string_from_bytes(t.t2_index.items[i].ptr, t.t2_index.items[i].len));
        drop sink_write(@s, "\n");
    }
    pass (raw sink_into_string(move(s)));
};

pub func:obl_rows_text = string(ObTable->:t) never fails {
    Sink:s = raw sink_to_buffer(4096i64);
    for (int64:i in 0i64...t.rows.count) {
        drop sink_write(@s, string_from_bytes(t.rows.items[i].ptr, t.rows.items[i].len));
        drop sink_write(@s, "\n");
    }
    pass (raw sink_into_string(move(s)));
};
