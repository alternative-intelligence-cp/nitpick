// Function emission — the define line, the entry block, parameter slots, locals,
// and the `Result<T>` return.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.7.4.
//
// THE SEED'S SHAPES, QUOTED. `bootstrap/generator/emit.py` already lowers a
// function as: a `define` line, an `entry:` block, one alloca-and-store per
// parameter, every local an alloca, and a `pass` built as two `insertvalue`s.
// Naive by design — no SSA construction, because `mem2reg` already does that
// correctly and a hand-rolled phi placement is wrong exactly on merges, which is
// cycle 0.5's whole lesson. Each shape below names the seed function it mirrors.
//
// ONE DELIBERATE DEPARTURE: LOCALS ARE A SCOPE STACK, NOT A FLAT MAP. The seed
// keeps `self.locals` as a dict keyed by name, so an inner block's `int32:x`
// OVERWRITES the outer `x` and stays bound after the block ends — and the language
// permits shadowing (`resolve.npk`: "an inner one may shadow an outer"), so that
// is a program the frontend accepts and the seed lowers WRONGLY. The seed gets
// away with it because it compiles exactly one program, the compiler, which never
// leans on the pattern. The real emitter compiles whatever the frontend accepts.
// So: bindings append, lookup walks BACKWARD (innermost shadow wins), and leaving
// a block truncates back to a mark — outer bindings reappear because they were
// never gone. Worse than a rung that lowers wrongly is inheriting a reference's
// defect on purpose.
//
// THE ERROR FIELD OF A SUCCESSFUL Result IS WRITTEN, NEVER LEFT undef. A Result
// whose error slot is undef is one whose `.is_error` answers differently on
// different runs — a slot that means two things, decided by the optimiser.
//
// AND NO AGGREGATE IS SEEDED WITH `undef` AT ALL (1.5.0, D-218.10): every
// `insertvalue` chain in this backend starts from `zeroinitializer`, never
// `undef` and never `poison`. Every chain inserts every field before the value
// escapes (audited at 1.5.0), so the seed is never observed — but a seed that
// IS a defined value makes an audit slip a wrong zero rather than a value
// the optimiser may choose per use (r8's ~18% of Alive2-found miscompiles),
// and the harness bans the word from every `.ll` the tree holds or emits.

mod:ir_func;

use "../../frontend/intern.npk".*;
use "../../frontend/diagnostics.npk".*;
use "../../frontend/types.npk".*;
use "./ir_writer.npk".*;
use "./ir_types.npk".*;

// `main` AND `failsafe` RETURN A BARE `int32` — the two exceptions D-089 names,
// and the only two: they are where `exit` lives, so they have no caller to hand a
// `Result` to. Everything else declares `T` and returns `Result<T>` (D-069), and
// the wrap is implicit — which is why this module is where it becomes explicit.
pub func:fn_is_bare = bool(string:name) never fails {
    // by name alone: D-248 (1.5.1b) admits both at the root module's top level only
    if (raw string_eq(name, "main"))     { pass true; }
    if (raw string_eq(name, "failsafe")) { pass true; }
    pass false;
};

pub struct:FnEmitter = {
    IrWriter->:w;
    LlCtx->:ctx;

    // The signature being collected. The define line cannot be written until
    // every parameter is known, so parameters are DECLARED first and `fnem_open`
    // writes the header, the entry label and the prologue in one place.
    string:sym;        // "@main" | "@npk_<name>"
    bool:bare;
    bool:ret_nil;
    int32:ret_type;    // the DECLARED return — `T`, never `Result<T>`
    string:ret_ll;     // what the define line says: `T` bare, `{T, i32}` wrapped
    string:val_ll;     // `T`'s own text, for insertvalue; "" when T is NIL
    string:val_zero;   // the value slot of a failed Result

    List<int32>:pnames;
    List<int32>:ptypes;
    List<string>:plls;

    // The scope stack. Append-only between marks; `fnem_release` truncates.
    List<int32>:lnames;
    List<string>:lslots;
    List<int32>:ltypes;
    // THE DROP FLAG's slot, or "" (D-183, 1.2.3): a one-bit alloca per OWNING
    // binding, set live at initialisation, cleared by `move` and by `pass`
    // (which moves implicitly), and tested at the scope-exit drop — so a
    // moved-out binding is not freed a second time, and a conditionally-moved
    // one is freed exactly when it still owns. "" means no flag and no drop:
    // pick-arm and loop bindings are BITWISE COPIES of storage a container
    // still owns, and are safe precisely because they are never dropped.
    List<string>:lflags;

    // Which parameters are `move` (consuming) — parallel to pnames. A lent
    // parameter is the CALLER's to drop; a `move` one is this function's, at
    // its exit, unless the body moved it onward.
    List<int32>:pmoves;

    // STATEMENT-END TEMPORARIES (D-246, 1.5.1b step 4). An owning value no
    // place takes is registered where it is PRODUCED -- stored to a slot of
    // its own beside an i8 flag that says the producing path ran -- and
    // dropped, flag-guarded, when its statement ends; the one consumer that
    // KEEPS it (a binding, a `move` parameter, a literal's slot, a return, a
    // send) marks it taken and no drop is ever emitted for it. Parallel
    // lists, LIFO like the locals; `cur_tmark` is the open statement's floor.
    List<int32>:ttypes;
    List<string>:tslots;
    List<string>:tflags;
    List<string>:trefs;
    List<int32>:tlive;
    int64:cur_tmark;
    // A temporary produced while an `await`'s operand is evaluated lives
    // across the suspension (D-178's one exception) and so in the FRAME: a
    // region appended after the flag bytes, one value slot and one i8 flag
    // per temporary, the flags zeroed by the resume that starts the body.
    // A spawn's arguments are the child's for its life: taken, never dropped
    // by the statement that spawned it.
    bool:in_await_args;
    bool:spawn_args;
    List<string>:tframe_lls;
    List<string>:tframe_flags;
    // The temporary count at each loop's entry, parallel to `loop_heads`: a
    // `break` or `continue` drops what the body registered above it.
    List<int64>:loop_tmarks;

    // --- control-flow state (0.7.6) ------------------------------------------
    //
    // HERE rather than in the statement walker, because `relay` needs it too:
    // an expression that returns early has to run the same defers a `pass`
    // would, and the function is the thing both have in common.

    // The current block already ended in a terminator. Mirrors the seed's
    // `self.terminated`: a `br` after a `ret` is IR llc rejects, so every
    // emission of either goes through this flag.
    bool:terminated;

    // DEFERRED BODIES, as StmtId indices, flat, with frame starts — the same
    // mark/truncate shape as the locals. A frame per block; running a frame
    // walks it BACKWARD, and running "everything" walks the frames backward
    // too: LIFO twice over, which is what a cleanup stack means.
    List<int32>:dstmts;
    List<int64>:dframes;

    // THE LOCALS MARK EACH SCOPE WAS PUSHED AT (D-183, 1.2.1), parallel to
    // `dframes`. A scope's DROPS are its locals above this mark, and they run
    // on the same unwind its defers do — so the two stacks are pushed and
    // popped together, and "defers first, then drops, innermost scope first"
    // is a property of one loop rather than an ordering anybody maintains.
    List<int64>:dlmarks;
    // THE SAME MARK SHAPE, THREE MORE TIMES (D-207, 1.4.4). A scope owns more
    // than its locals now, and every one of these is "what this scope added",
    // read the same way: the value at push, against the value at exit.
    //   `dcfmarks` — the CHANNEL STASHES it opened (D-183's creation-site
    //     finalizers, re-homed from the function to the scope). Without the
    //     truncation at pop, a later SIBLING block at the same depth would
    //     reclaim the earlier one's stash: the stash list is function-long,
    //     the window is not.
    //   `dspawns`  — the count of spawns emitted, so a scope's exit can tell
    //     whether it needs a join at all. Restored at pop, so a spawn in a
    //     DEEPER scope (already joined at that scope's exit) does not make
    //     this one emit a join it cannot use.
    //   `djmarks`  — the slot holding `join_head` as it stood at scope entry.
    //     The join list is a LIFO stack, so a scope's children are exactly
    //     the ones pushed since it was entered, and the exit joins down to
    //     this mark. One pointer per scope instead of one list head per
    //     scope, and `emit_spawn` never has to know which scope it is in.
    List<int64>:dcfmarks;
    List<int32>:dspawns;
    List<string>:djmarks;
    int32:spawn_count;

    // THE LOOP STACK: continue target, break target, and the DEFER DEPTH at
    // entry. The depth is what closes the seed's recorded gap — its own comment
    // says "defers registered INSIDE the loop body do not run here. That is a
    // gap the real compiler must close" (D-014: scope exit is a normal exit
    // path). `break` runs every frame deeper than the recorded depth first.
    List<string>:loop_heads;
    List<string>:loop_dones;
    List<int64>:loop_depths;
    // The two 0.9.7 columns: the loop's LABEL (intern index; 0 = unlabelled),
    // and its `$` counter slot ("" for a while/for — `$` belongs to the
    // counted forms, and the innermost counted loop wins).
    List<int32>:loop_labels;
    List<string>:loop_iters;

    // THE PICK STACK (0.9.7): the frame `give` and `fall` resolve against.
    // Scalar columns only — arm body labels are DERIVED ("pk<seq>.arm<i>"),
    // so `fall label;` computes its target from the frame's seq and the arm
    // list rather than needing a stored label table.
    List<string>:pick_dones;
    List<string>:pick_slots;      // "" for a statement pick
    List<string>:pick_lls;
    List<int32>:pick_tids;        // the give slot's TYPE, for `emit_fit` (1.0.6e)
    List<int32>:pick_starts;
    List<int32>:pick_counts;
    List<int32>:pick_seqs;
    List<int64>:pick_depths;      // defer depth at entry — give/fall unwind to it
    int32:pick_seq;                // per-function label sequence

    // --- the coroutine machine (D-177, 1.1.4) --------------------------------
    //
    // An `async` function emits as `i8 <resume_sym>(ptr %fr)` over a frame
    // whose header is fixed (slot 0 resume_fn, 1 state, 2 windup, 3 result,
    // 4 join_head, 5 sibling, 6 awaitee, 7+i parameter i). The caller sets
    // `is_async`, `frame_ty` and `resume_sym` between `fnem_begin` and
    // `fnem_open`; the GEP registers below are cut in the entry block, so
    // they dominate every resume segment.
    bool:is_async;
    bool:is_gives;                 // D-183 1.2.6: this fn's creations register no reclaim
    // The built return aggregate, held between the two halves of the return
    // seam (D-207, 1.4.4) — a synchronous function's `ret` is emitted after
    // its unwind, and the value it returns was built before it.
    string:exit_agg;
    string:frame_ty;
    string:resume_sym;
    string:state_gep;
    string:windup_gep;
    string:result_gep;
    string:join_gep;
    string:awaitee_gep;
    // Resume segments: seg_labels[K] is the switch target for state K.
    List<string>:seg_labels;
    int32:guard_depth;             // inside a `pick` arm's `where` guard (D3 rung)
    // The statement being emitted (D-182): a channel `await` is a suspension
    // inside an EXPRESSION, and its loop state must be frame-resident like
    // any crossing local. D-178 guarantees at most one suspension per
    // statement, so the statement's index is a sufficient key.
    int32:cur_stmt;
    int32:fn_site;                 // the join's chain-stamp site (D-179, 1.1.6)

    // CROSSING LOCALS (stage D): the pre-scan registers each var-decl the
    // suspend walk marked, by stmt index, before `fnem_open` fixes the frame
    // type — slot `7 + pcount + j`. The GEPs are cut in the entry block at
    // open, and the declaration site binds the name to its slot instead of
    // an alloca.
    List<int32>:cross_stmts;
    List<int32>:cross_roles;
    List<int32>:cross_types;
    List<string>:cross_lls;
    List<string>:cross_geps;
    // The FLAG slot's GEP for an owning crossing var-decl (D-183, 1.2.4b):
    // "" for every entry that needs none (hidden loop/pick roles, non-owning
    // types). A drop flag is one byte beside the value, and a crossing
    // local's byte must cross with it — an alloca flag dies between resumes.
    List<string>:cross_fgeps;
    // CHANNEL RECLAIM STASHES (D-183, 1.2.5): one slot per `channel()` site,
    // holding the packed i64 handle; the creating FUNCTION's exit — after
    // its defers, drops and child joins — loads each and reclaims. An i64
    // alloca in a sync body, a role-30+ frame slot in a coroutine.
    List<string>:chfins;
    List<int32>:chfin_elems;      // the element's tid when it OWNS, else 0
    int32:chopen_ord;              // per-statement channel-open ordinal
};

pub func:fnem_init = FnEmitter(IrWriter->:w, LlCtx->:ctx) never fails {
    FnEmitter:fe = FnEmitter{
        w: w, ctx: ctx,
        sym: "", bare: false, ret_nil: false, ret_type: 0i32,
        is_gives: false,
        ret_ll: "", val_ll: "", val_zero: "",
        terminated: false,
        spawn_count: 0i32,
        pick_seq: 0i32,
        is_async: false, exit_agg: "", frame_ty: "", resume_sym: "",
        state_gep: "", windup_gep: "", result_gep: "", join_gep: "",
        awaitee_gep: "",
        guard_depth: 0i32, fn_site: 0i32, cur_stmt: 0i32, chopen_ord: 0i32,
        pnames: raw list_init::<int32>(8i64),
        ptypes: raw list_init::<int32>(8i64),
        plls: raw list_init::<string>(8i64),
        pmoves: raw list_init::<int32>(8i64),
        ttypes: raw list_init::<int32>(16i64),
        tslots: raw list_init::<string>(16i64),
        tflags: raw list_init::<string>(16i64),
        trefs: raw list_init::<string>(16i64),
        tlive: raw list_init::<int32>(16i64),
        cur_tmark: 0i64,
        in_await_args: false, spawn_args: false,
        tframe_lls: raw list_init::<string>(8i64),
        tframe_flags: raw list_init::<string>(8i64),
        loop_tmarks: raw list_init::<int64>(8i64),
        lnames: raw list_init::<int32>(32i64),
        lslots: raw list_init::<string>(32i64),
        ltypes: raw list_init::<int32>(32i64),
        lflags: raw list_init::<string>(32i64),
        dstmts: raw list_init::<int32>(16i64),
        dframes: raw list_init::<int64>(16i64),
        dlmarks: raw list_init::<int64>(16i64),
        dcfmarks: raw list_init::<int64>(16i64),
        dspawns: raw list_init::<int32>(16i64),
        djmarks: raw list_init::<string>(16i64),
        loop_heads: raw list_init::<string>(8i64),
        loop_dones: raw list_init::<string>(8i64),
        loop_depths: raw list_init::<int64>(8i64),
        loop_labels: raw list_init::<int32>(8i64),
        loop_iters: raw list_init::<string>(8i64),
        pick_dones: raw list_init::<string>(8i64),
        pick_slots: raw list_init::<string>(8i64),
        pick_lls: raw list_init::<string>(8i64),
        pick_tids: raw list_init::<int32>(8i64),
        pick_starts: raw list_init::<int32>(8i64),
        pick_counts: raw list_init::<int32>(8i64),
        pick_seqs: raw list_init::<int32>(8i64),
        pick_depths: raw list_init::<int64>(8i64),
        seg_labels: raw list_init::<string>(8i64),
        cross_stmts: raw list_init::<int32>(8i64),
        cross_roles: raw list_init::<int32>(8i64),
        cross_types: raw list_init::<int32>(8i64),
        cross_lls: raw list_init::<string>(8i64),
        cross_geps: raw list_init::<string>(8i64),
        cross_fgeps: raw list_init::<string>(8i64),
        chfins: raw list_init::<string>(8i64),
        chfin_elems: raw list_init::<int32>(8i64)
    };
    pass fe;
};

// --- the signature ----------------------------------------------------------------

// Start a function. Returns the RETURN's lowering — `LL_RUNG` and `LL_BROKEN`
// propagate to the caller, which is where the rung diagnostic lives (0.7.7); a
// module with no codes of its own cannot misreport one.
//
// Mirrors the seed's `fn_sig`: bare for `main`/`failsafe`, `Result<T>` otherwise.
pub func:fnem_begin = LlType(FnEmitter->:fe, string:name, int32:decl_index,
                             int32:ret_type) never fails {
    fe.sym = raw mangled_fn_sym(fe.ctx, decl_index, name);
    fe.bare = raw fn_is_bare(name);
    fe.ret_type = ret_type;
    fe.ret_nil = ((raw type_kind(fe.ctx.types, ret_type)) == (raw TY_NIL()));
    // EVERY LIST OF EVERY RESET GROUP, LISTED RATHER THAN FOLDED. Each
    // group's counts move together because one function pushes all of
    // them, and this reset is the one place that invariant is easy to
    // half-do -- a missed line leaves the PREVIOUS function's rows
    // visible to this one. Suspend's per-function reset carries the same
    // warning for the same reason. The bulk rewrite that produced this
    // file emitted one line per GROUP, which is precisely the half-done
    // version the warning is about; the compiler's type error on `0i32`
    // into an int64 count is what exposed it.
    //
    // `picks` is absent DELIBERATELY, as it was before: a pick's push and
    // pop are balanced inside one function, so its lists return to zero
    // on their own and a reset here would hide an unbalanced pair.
    fe.pnames.count = 0i64;
    fe.ptypes.count = 0i64;
    fe.plls.count = 0i64;
    fe.pmoves.count = 0i64;
    fe.ttypes.count = 0i64;
    fe.tslots.count = 0i64;
    fe.tflags.count = 0i64;
    fe.trefs.count = 0i64;
    fe.tlive.count = 0i64;
    fe.cur_tmark = 0i64;
    fe.in_await_args = false;
    fe.spawn_args = false;
    fe.tframe_lls.count = 0i64;
    fe.tframe_flags.count = 0i64;
    fe.loop_tmarks.count = 0i64;
    fe.lnames.count = 0i64;
    fe.lslots.count = 0i64;
    fe.ltypes.count = 0i64;
    fe.lflags.count = 0i64;
    fe.terminated = false;
    fe.dstmts.count = 0i64;
    fe.dframes.count = 0i64;
    fe.dlmarks.count = 0i64;
    fe.dcfmarks.count = 0i64;
    fe.dspawns.count = 0i64;
    fe.djmarks.count = 0i64;
    fe.spawn_count = 0i32;
    fe.loop_heads.count = 0i64;
    fe.loop_dones.count = 0i64;
    fe.loop_depths.count = 0i64;
    fe.loop_labels.count = 0i64;
    fe.loop_iters.count = 0i64;
    fe.is_async = false;
    fe.is_gives = false;
    fe.frame_ty = "";
    fe.resume_sym = "";
    fe.seg_labels.count = 0i64;
    fe.guard_depth = 0i32;
    fe.fn_site = 0i32;
    fe.cur_stmt = 0i32;
    fe.cross_stmts.count = 0i64;
    fe.cross_roles.count = 0i64;
    fe.cross_types.count = 0i64;
    fe.cross_lls.count = 0i64;
    fe.cross_geps.count = 0i64;
    fe.cross_fgeps.count = 0i64;
    fe.chfins.count = 0i64;
    fe.chfin_elems.count = 0i64;
    fe.chopen_ord = 0i32;
    // EVERY FUNCTION STARTS FROM ZERO — a one-function change produces a
    // one-function diff, which is what makes the fixpoint check readable.
    drop irw_begin_function(fe.w);

    if (fe.bare) {
        LlType:vt = raw ll_type(fe.ctx, ret_type);
        if (vt.state != (raw LL_OK())) { pass vt; }
        fe.ret_ll = string_concat(vt.text, "");
        fe.val_ll = string_concat(vt.text, "");
        fe.val_zero = raw ll_zero(vt);
        pass vt;
    }

    LlType:rt = raw ll_wrap_result(fe.ctx, ret_type);
    if (rt.state != (raw LL_OK())) { pass rt; }
    fe.ret_ll = string_concat(rt.text, "");
    fe.val_ll = "";
    fe.val_zero = "";
    if (!fe.ret_nil) {
        LlType:vt = raw ll_type(fe.ctx, ret_type);
        fe.val_ll = string_concat(vt.text, "");
        fe.val_zero = raw ll_zero(vt);
    }
    pass rt;
};

// Declare one parameter, in order. A refused type propagates and the function is
// not emitted — a signature with a hole in it is not a signature minus a hole.
pub func:fnem_param = LlType(FnEmitter->:fe, int32:name, int32:type_id,
                             bool:is_move) never fails {
    LlType:t = raw ll_type(fe.ctx, type_id);
    if (t.state != (raw LL_OK())) { pass t; }
    drop list_push(@fe.pnames, name);
    drop list_push(@fe.ptypes, type_id);
    drop list_push(@fe.plls, string_concat(t.text, ""));
    int32:mv = 0i32;
    if (is_move) { mv = 1i32; }
    drop list_push(@fe.pmoves, mv);
    pass t;
};

// Write the header, the entry block, and the prologue.
//
// PARAMETERS ARRIVE AS `%a0`, `%a1`, … — a namespace apart from `%tN`, for the
// same reason `irw_temp` is the only source of temp names: two schemes numbering
// into ONE space is how a name comes to mean two things, so the schemes get
// disjoint prefixes. The seed uses `%aN` too.
//
// EACH PARAMETER IS STORED TO A SLOT AND THE SLOT IS THE BINDING. An LLVM
// argument register cannot be assigned to, so `a = a + 1i32;` needs the parameter
// to live in memory like any other local — naive lowering, `mem2reg` undoes it.
pub func:fnem_open = NIL(FnEmitter->:fe) never fails {
    if (fe.is_async) {
        drop fnem_open_async(fe);
        pass NIL;
    }
    string:params = "";
    int32:i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        if (i > 0i32) { params = string_concat(params, ", "); }
        params = raw cat3(params, fe.plls.items[i => int64], " %a");
        params = string_concat(params, int_to_string(i => int64));
        i = i + 1i32;
    }
    drop irw_raw(fe.w, raw cat5("define ", fe.ret_ll, " ", fe.sym,
                                  raw cat3("(", params, ") {")));
    drop irw_label(fe.w, "entry");
    // The define line and `entry:` are in the module stream; from here allocas
    // and body buffer separately and splice back at close (1.0.9a).
    drop irw_open_fn(fe.w);

    i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        string:arg = string_concat("%a", int_to_string(i => int64));
        string:slot = raw irw_temp(fe.w);
        // READ IN PLACE, NOT COPIED (D-183): `irw_alloca` and `cat5` LEND
        // their arguments, so handing them the element directly transfers
        // nothing and needs no local to own.
        drop irw_alloca(fe.w, slot, fe.plls.items[i => int64]);
        drop irw_line(fe.w, raw cat5("store ", fe.plls.items[i => int64], " ", arg,
                                       string_concat(", ptr ", slot)));
        drop fnem_bind(fe, fe.pnames.items[i => int64], move(slot), fe.ptypes.items[i => int64]);
        // A `move` PARAMETER IS THIS FUNCTION'S TO DROP (D-183, 1.2.3): the
        // caller transferred ownership in, so unless the body moves it onward
        // the value is released at THIS function's exit. A lent parameter gets
        // no flag and no drop — it is the caller's, and dropping it here would
        // free the caller's binding out from under it. The flag starts LIVE:
        // the caller's transfer is this binding's initialisation.
        if (fe.pmoves.items[i => int64] != 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.ptypes.items[i => int64], 64i32)) {
                string:pfl = raw irw_temp(fe.w);
                drop irw_alloca(fe.w, pfl, "i8");
                drop irw_line(fe.w, raw cat3("store i8 1, ptr ", pfl, ""));
                drop fnem_flag_last(fe, move(pfl));
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// One frame-resident slot, registered by the pre-scan (stage D), keyed by
// (stmt index, role). Role 0 is a var-decl's own slot; the loop and pick
// emitters reserve their hidden state under the roles `ir_stmt` names —
// in a coroutine, ALL loop state is frame-resident, uniformly, so there is
// no per-loop detector for the emitter's needs to drift from. Idempotent on
// the key for the same reason the walk's mark is.
pub func:fnem_cross_add = NIL(FnEmitter->:fe, int32:stmt_index, int32:role,
                              int32:type_id, move string:ll) never fails {
    if ((raw fnem_cross_find(fe, stmt_index, role)) >= 0i64) { pass NIL; }
    drop list_push(@fe.cross_stmts, stmt_index);
    drop list_push(@fe.cross_roles, role);
    drop list_push(@fe.cross_types, type_id);
    drop list_push(@fe.cross_lls, move(ll));
    drop list_push(@fe.cross_geps, "");
    drop list_push(@fe.cross_fgeps, "");
    pass NIL;
};

pub func:fnem_cross_find = int64(FnEmitter->:fe, int32:stmt_index,
                                 int32:role) never fails {
    int64:i = 0i64;
    while (i < fe.cross_stmts.count) {
        if (fe.cross_stmts.items[i] == stmt_index) {
            if (fe.cross_roles.items[i] == role) { pass i; }
        }
        i = i + 1i64;
    }
    pass 0i64 - 1i64;
};

pub func:fnem_cross_gep = string(FnEmitter->:fe, int64:idx) never fails {
    // A VIEW of container-owned storage (D-183): cap 0, drops free nothing.
    pass (string_from_bytes(fe.cross_geps.items[idx => int64].ptr, fe.cross_geps.items[idx => int64].len));
};

// The flag slot's GEP for a crossing entry — "" when the entry has none.
pub func:fnem_cross_fgep = string(FnEmitter->:fe, int64:idx) never fails {
    pass (string_from_bytes(fe.cross_fgeps.items[idx => int64].ptr, fe.cross_fgeps.items[idx => int64].len));
};

// One channel-open stash slot (D-183, 1.2.5). `elem` is the element's tid
// when the element OWNS something — the reclaim drains and drops what the
// buffer still holds before handing the slot back — and 0 otherwise.
pub func:fnem_chfin_add = NIL(FnEmitter->:fe, move string:slot,
                              int32:elem) never fails {
    drop list_push(@fe.chfins, move(slot));
    drop list_push(@fe.chfin_elems, elem);
    pass NIL;
};
pub func:fnem_chfin_at = string(FnEmitter->:fe, int64:i) never fails {
    pass (string_from_bytes(fe.chfins.items[i => int64].ptr, fe.chfins.items[i => int64].len));
};
pub func:fnem_chfin_elem = int32(FnEmitter->:fe, int64:i) never fails {
    pass (fe.chfin_elems.items[i => int64]);
};

// The drain-then-reclaim for one stash (D-183, 1.2.5b), shared by the sync
// unwind and the coroutine's post-join site. An owning element still in the
// ring belongs to nobody the program can reach — the send transferred it in
// and no recv took it out — so the reclaim drops each one first: try_recv
// into a scratch slot while it answers 0, the generated drop for each, then
// the slot goes back. A rendezvous ring is empty by construction and the
// loop exits on its first probe.
pub func:fnem_chfin_reclaim = NIL(FnEmitter->:fe, int64:i) never fails {
    string:cst = raw fnem_chfin_at(fe, i);
    string:chv = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat4(chv, " = load i64, ptr ", cst, ""));
    int32:el = raw fnem_chfin_elem(fe, i);
    if (el != 0i32) {
        LlType:ell = raw ll_type(fe.ctx, el);
        if (raw ll_is_ok(ell)) {
            string:tmp = raw irw_temp(fe.w);
            drop irw_alloca(fe.w, tmp, ell.text);
            string:dh = raw irw_new_label(fe.w, "ch.drain");
            string:dd = raw irw_new_label(fe.w, "ch.drop");
            string:dz = raw irw_new_label(fe.w, "ch.drained");
            drop irw_line(fe.w, raw cat3("br label %", dh, ""));
            drop irw_label(fe.w, dh);
            string:trc = raw irw_temp(fe.w);
            drop irw_line(fe.w, raw cat5(trc, " = call i32 @npk_ch_try_recv(i64 ",
                              chv, ", ptr ", string_concat(tmp, ")")));
            string:got = raw irw_temp(fe.w);
            drop irw_line(fe.w, raw cat3(got, " = icmp eq i32 ",
                              string_concat(trc, ", 0")));
            drop irw_line(fe.w, raw cat5("br i1 ", got, ", label %", dd,
                              string_concat(", label %", dz)));
            drop irw_label(fe.w, dd);
            drop irw_line(fe.w, raw cat4("call void ",
                              raw drop_fn_sym(fe.ctx, el),
                              string_concat("(ptr ", tmp), ")"));
            drop irw_line(fe.w, raw cat3("br label %", dh, ""));
            drop irw_label(fe.w, dz);
        }
    }
    string:crc = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat3(crc, " = call i32 @npk_ch_reclaim(i64 ",
                      string_concat(chv, ")")));
    pass NIL;
};

// `@"npk.fsz.<name>"` from `%"npk.frame.<name>"` — the frame-size global's
// symbol, derived so both sides spell it identically.
pub func:frame_size_sym = string(string:frame_ty) never fails {
    if (frame_ty.len < 12i64) { pass (string_concat("@\"npk.fsz.bad", "\"")); }
    Result<string>:inner = string_slice(frame_ty, 12i64, frame_ty.len - 1i64);
    if (inner.is_error) { pass (string_concat("@\"npk.fsz.bad", "\"")); }
    string:s1 = string_concat("@\"npk.fsz.", inner.value);
    pass (string_concat(s1, "\""));
};

// --- the coroutine's open (D-177, 1.1.4) --------------------------------------------
//
// The frame type, the resume function's header, and the entry block that makes
// every parameter FRAME-RESIDENT: each parameter name binds to a GEP into the
// frame rather than an alloca copy, so a parameter used after a suspension
// reads the slot the spawner filled — no copy exists to die with the stack.
// Locals keep their allocas; the suspend walk marked any whose range crosses,
// and stage C refuses those at the declaration site.
func:fnem_open_async = NIL(FnEmitter->:fe) never fails {
    // The frame type: fixed header, then one slot per parameter.
    //   [ 0 resume_fn | 1 state | 2 windup | 3 result | 4 join_head
    //   | 5 sibling | 6 awaitee | 7 qnext | 8 wake_at | 9 thread_tls
    //   | 10 chan_next | 11 owner | 12+i param i ]
    //
    // 10 and 11 are the channel WAIT (1.1.10-C2). A task blocked on a channel
    // is on two lists at once and they cannot share a link: its own
    // executor's SLEEPERS, through `qnext`, holding the deadline that bounds
    // the wait; and the CHANNEL's waiter list, through `chan_next`, shared
    // across threads, which is how a peer operation wakes it before that
    // deadline. `owner` is the executor the task is pinned to (D-032), which
    // the waker needs and could not otherwise find: `thread_tls` is non-null
    // only on a THREAD's root task, so it answers a different question.
    // THE FRAME TYPE IS WRITTEN AT CLOSE (1.5.1b step 4, `fnem_frame_type_write`):
    // its temporary region is known only once the body has been emitted, and
    // the type goes to the sink that splices ahead of every function, so the
    // order of writing never mattered. The fixed part's layout is unchanged.
    int32:i = 0i32;
    // THE FRAME'S SIZE, AS A SYMBOL (D-185, 1.1.12d): the vtable's size tail
    // references this global rather than the frame type directly — a global
    // forward-references freely, where a gep constant over a named type
    // demands the definition first, and vtables are emitted before the
    // frames of the methods they name.
    drop irw_raw(fe.w, raw cat5(raw frame_size_sym(fe.frame_ty),
                      " = internal constant i64 ptrtoint (ptr getelementptr (",
                      fe.frame_ty, ", ptr null, i32 1) to i64)", ""));
    drop irw_raw(fe.w, raw cat4("define i8 ", fe.resume_sym, "(ptr %fr) {", ""));
    drop irw_label(fe.w, "entry");
    drop irw_open_fn(fe.w);

    fe.state_gep   = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 1i64);
    fe.windup_gep  = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 2i64);
    fe.result_gep  = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 3i64);
    fe.join_gep    = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 4i64);
    fe.awaitee_gep = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 6i64);

    i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        string:pg = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 12i64 + (i => int64));
        drop fnem_bind(fe, fe.pnames.items[i => int64], move(pg), fe.ptypes.items[i => int64]);
        i = i + 1i32;
    }
    i = 0i32;
    while ((i => int64) < fe.cross_stmts.count) {
        fe.cross_geps.items[i => int64] =
            raw fnem_frame_gep(fe, fe.frame_ty, "%fr", 12i64 + fe.pnames.count + (i => int64));
        i = i + 1i32;
    }

    // State 0 is the body's start; the switch is appended to the entry stream
    // at close, once every state is known.
    string:s0 = raw fnem_new_seg(fe);
    drop irw_label(fe.w, s0);

    // THE FLAG GEPS, and the parameter flags' one-time seed. The GEPs go to
    // the ENTRY stream (they must dominate every segment); the `store i8 1`
    // lines land HERE, in state 0's body, which runs exactly once per task —
    // the spawner's transfer is the binding's initialisation, and no spawn
    // site has to know this layout. A crossing var-decl's flag needs no seed:
    // its declaration stores 0 or 1 when it executes, and every path that
    // reads the flag is dominated by the declaration dynamically — a frame
    // reused from the free list carries garbage there only until then.
    int64:fslot = 12i64 + fe.pnames.count + fe.cross_stmts.count;
    i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        if (fe.pmoves.items[i => int64] != 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.ptypes.items[i => int64], 64i32)) {
                string:pfg = raw fnem_frame_gep(fe, fe.frame_ty, "%fr", fslot);
                fslot = fslot + 1i64;
                drop irw_line(fe.w, raw cat3("store i8 1, ptr ", pfg, ""));
                drop fnem_flag_at(fe, (i => int64), move(pfg));
            }
        }
        i = i + 1i32;
    }
    i = 0i32;
    while ((i => int64) < fe.cross_stmts.count) {
        if (fe.cross_roles.items[i => int64] == 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.cross_types.items[i => int64], 64i32)) {
                fe.cross_fgeps.items[i => int64] =
                    raw fnem_frame_gep(fe, fe.frame_ty, "%fr", fslot);
                fslot = fslot + 1i64;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// One GEP into a frame, cut in the ENTRY stream so it dominates every segment.
pub func:fnem_frame_gep = string(FnEmitter->:fe, string:frame_ty, string:fr,
                                 int64:slot) never fails {
    string:r = raw irw_temp(fe.w);
    drop irw_entry(fe.w, raw cat5(r, " = getelementptr ", frame_ty,
                      raw cat3(", ptr ", fr, ", i32 0, i32 "),
                      int_to_string(slot => int64)));
    pass r;
};

// A fresh resume state: its number is the label's index. State K's label is
// the switch target the suspension before it stores.
pub func:fnem_new_seg = string(FnEmitter->:fe) never fails {
    string:lb = raw irw_new_label(fe.w, "seg");
    drop list_push(@fe.seg_labels, string_concat(lb, ""));
    pass lb;
};

pub func:fnem_seg_index = int64(FnEmitter->:fe) never fails {
    pass (fe.seg_labels.count - 1i64);
};

// THE ONE RETURN SEAM (D-177), IN TWO HALVES SINCE D-207. Every function exit
// hands its fully-built return value to `fnem_ret_agg`, runs its unwind, and
// then calls `fnem_ret_done`. The suspend return (`ret i8 1`) never comes
// through here: suspension is not scope exit, runs no defers, and returns no
// value.
//
// WHY THE HALVES. Until 1.4.4 a coroutine stored its result and branched to
// one `%npk.join` block emitted at close, which is what forced the join to
// run LAST — after every scope's drops, including the sync primitives a
// spawned child borrows. D-207 puts the join at each scope's exit instead,
// inside the unwind, and the arbitration it performs ("the first child error
// stands as the function's own — unless the function already failed") reads
// the frame's result slot. So the store has to happen BEFORE the unwind and
// the `ret` after it. D-136 is untouched: the value is still EVALUATED before
// the defers, which is the rule that decision states; only its store moved.
pub func:fnem_ret_agg = NIL(FnEmitter->:fe, string:value) never fails {
    if (!fe.is_async) {
        // A synchronous function has no result slot and cannot spawn, so its
        // aggregate simply waits — an SSA value defined in a block that
        // dominates every block the unwind goes on to emit.
        fe.exit_agg = string_concat(value, "");
        pass NIL;
    }
    drop irw_line(fe.w, raw cat5("store ", fe.ret_ll, " ", value,
                      string_concat(", ptr ", fe.result_gep)));
    pass NIL;
};

pub func:fnem_ret_done = NIL(FnEmitter->:fe) never fails {
    if (!fe.is_async) {
        drop irw_line(fe.w, raw cat4("ret ", fe.ret_ll, " ", fe.exit_agg));
        pass NIL;
    }
    drop irw_line(fe.w, "ret i8 0");
    pass NIL;
};

// The generic frame-header type, as the join and the spawn link see every
// child: resume slot 0, windup 2, `{ i32 }` error 3 (a spawnable child's
// success is `NIL` by checker rule), sibling 5. MUST match the definition
// `emit_runtime_declares` writes — one line there, one here.
pub func:fnem_hdr_ty = string() never fails {
    pass "%\"npk.frame.hdr\"";
};

// A GEP into a frame at the CURRENT point (for a callee frame at an await
// site, or inside the entry shim) — `fnem_frame_gep` is the entry-stream twin
// for the function's OWN frame.
pub func:fnem_slot_gep = string(FnEmitter->:fe, string:frame_ty, string:fr,
                                int32:slot) never fails {
    string:r = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(r, " = getelementptr ", frame_ty,
                      raw cat3(", ptr ", fr, ", i32 0, i32 "),
                      int_to_string(slot => int64)));
    pass r;
};

// The frame's size as a link-time constant — the GEP-null idiom, so the
// compiler's idea of the size and LLVM's cannot drift (D-153 wants exact
// sizes; this IS the exact size).
pub func:fnem_frame_size_arg = string(string:frame_ty) never fails {
    pass (raw cat3("i64 ptrtoint (ptr getelementptr (", frame_ty,
                   ", ptr null, i32 1) to i64)"));
};

// Initialise a fresh frame's header: resume_fn, state 0, windup 0, and the
// three link words null. The result slot belongs to the callee; the argument
// slots to the caller's next few stores.
pub func:fnem_frame_init = NIL(FnEmitter->:fe, string:frame_ty, string:fr,
                               string:resume_sym) never fails {
    string:g0 = raw fnem_slot_gep(fe, frame_ty, fr, 0i32);
    drop irw_line(fe.w, raw cat4("store ptr ", resume_sym, ", ptr ", g0));
    string:g1 = raw fnem_slot_gep(fe, frame_ty, fr, 1i32);
    drop irw_line(fe.w, raw cat3("store i32 0, ptr ", g1, ""));
    string:g2 = raw fnem_slot_gep(fe, frame_ty, fr, 2i32);
    drop irw_line(fe.w, raw cat3("store i32 0, ptr ", g2, ""));
    string:g4 = raw fnem_slot_gep(fe, frame_ty, fr, 4i32);
    drop irw_line(fe.w, raw cat3("store ptr null, ptr ", g4, ""));
    string:g5 = raw fnem_slot_gep(fe, frame_ty, fr, 5i32);
    drop irw_line(fe.w, raw cat3("store ptr null, ptr ", g5, ""));
    string:g6 = raw fnem_slot_gep(fe, frame_ty, fr, 6i32);
    drop irw_line(fe.w, raw cat3("store ptr null, ptr ", g6, ""));
    string:g7 = raw fnem_slot_gep(fe, frame_ty, fr, 7i32);
    drop irw_line(fe.w, raw cat3("store ptr null, ptr ", g7, ""));
    string:g8 = raw fnem_slot_gep(fe, frame_ty, fr, 8i32);
    drop irw_line(fe.w, raw cat3("store i64 0, ptr ", g8, ""));
    string:g9 = raw fnem_slot_gep(fe, frame_ty, fr, 9i32);
    drop irw_line(fe.w, raw cat3("store ptr null, ptr ", g9, ""));
    string:g10 = raw fnem_slot_gep(fe, frame_ty, fr, 10i32);
    drop irw_line(fe.w, raw cat3("store ptr null, ptr ", g10, ""));
    // THE OWNER IS STAMPED WHERE THE FRAME IS BORN, which is the one moment
    // the creating thread is the owning thread: D-032 pins a task to the
    // executor that created it and never migrates it.
    string:ox = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat3(ox, " = call ptr @npk_exec()", ""));
    string:g11 = raw fnem_slot_gep(fe, frame_ty, fr, 11i32);
    drop irw_line(fe.w, raw cat5("store ptr ", ox, ", ptr ", g11, ""));
    pass NIL;
};

// THE ENTRY SHIM (D-177): `@main` allocates `async main`'s frame, stores the
// arguments, and drives the resume once. DONE returns the stored exit code;
// SUSPENDED is a defect until 1.1.5's executor exists — nothing in the
// language can legally suspend before there is something to wake it — so it
// makes the same controlled stop a bad resume state does. 1.1.5 replaces this
// shim's middle with the real run loop.
//
// Emitted right after the resume function, from the same FnEmitter state:
// `plls`/`pcount` still hold main's parameters, `frame_ty`/`resume_sym` its
// names. Written at module level like the `dyn` thunks — no buffering, no
// allocas, one block chain.
pub func:fnem_emit_main_shim = NIL(FnEmitter->:fe) never fails {
    string:params = "";
    int32:i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        if (i > 0i32) { params = string_concat(params, ", "); }
        params = raw cat3(params, fe.plls.items[i => int64], " %a");
        params = string_concat(params, int_to_string(i => int64));
        i = i + 1i32;
    }
    drop irw_begin_function(fe.w);
    drop irw_raw(fe.w, raw cat3("define i32 @main(", params, ") {"));
    drop irw_label(fe.w, "entry");
    string:fr = raw irw_temp(fe.w);
    // THE ROOT FRAME IS A STACK ALLOCA (D-224, as amended the same day). It was
    // a heap block, and `wild_release_all()` may legally precede `exit` -- that
    // release unmaps every chunk, so the scope-exit unwind `exit` runs (the
    // join scan, the defers, the drops -- all frame-resident in a coroutine,
    // the join mark at role 41 because a scope spans suspensions) was reading
    // pages that no longer existed. `async_exit_release.npk` took SIGSEGV
    // inside the resume, one instruction past the release. The stack is the one
    // mapping the release cannot touch.
    //
    // Nothing frees it, and nothing needs to: `@main` outlives every use of the
    // frame, since `npk_run_until` does not return until the root task
    // completes -- so the shim's `npk_dalloc` is gone from the `fin` block
    // below. A frame that was never in the heap is also in no leak accounting,
    // which is what the superseded managed-allocation attempt was reaching for.
    // Initialisation is unchanged: `npk_alloc_impl` never zeroed a block (a
    // reused one carries the 0xAA free poison), so `frame_init` just below is
    // the only initialisation the frame has ever had.
    drop irw_line(fe.w, raw cat4(fr, " = alloca ", fe.frame_ty, ""));
    drop fnem_frame_init(fe, fe.frame_ty, fr, fe.resume_sym);
    i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        string:ag = raw fnem_slot_gep(fe, fe.frame_ty, fr, 12i32 + i);
        drop irw_line(fe.w, raw cat5("store ", fe.plls.items[i => int64], " %a",
                          int_to_string(i => int64),
                          string_concat(", ptr ", ag)));
        i = i + 1i32;
    }
    // THE ROOT TASK, RUN BY THE EXECUTOR (D-071, 1.1.8): enqueue main and
    // pump until it completes. Every other task the program spawns runs
    // through the same loop, which is what makes a waiting task unable to
    // stall a runnable sibling — the property D-071 exists for. The
    // deadlock, unwakeable-suspension and post-trap freeze stops all live
    // in `npk_step`, one copy for every driver.
    drop irw_line(fe.w, raw cat3("call void @npk_rq_push(ptr ", fr, ")"));
    string:rr = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(rr, " = call i32 @npk_run_until(ptr ",
                      fr, ", i64 0)", ""));
    drop irw_line(fe.w, "br label %fin");
    drop irw_label(fe.w, "fin");
    string:rg = raw fnem_slot_gep(fe, fe.frame_ty, fr, 3i32);
    string:code = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(code, " = load ", fe.ret_ll, ", ptr ",
                      string_concat(rg, "")));
    drop irw_line(fe.w, raw cat4("ret i32 ", code, "", ""));
    drop irw_raw(fe.w, "}");
    drop irw_blank(fe.w);
    pass NIL;
};

// --- locals -----------------------------------------------------------------------

pub func:fnem_bind = NIL(FnEmitter->:fe, int32:name, move string:slot, int32:type_id) never fails {
    drop list_push(@fe.lnames, name);
    drop list_push(@fe.lslots, move(slot));
    drop list_push(@fe.ltypes, type_id);
    drop list_push(@fe.lflags, "");
    pass NIL;
};

// A local: its alloca HOISTED to the entry block (D-173), bound from here to the
// end of its enclosing scope. This is the site most locals come through — a
// `pick` arm's binding, a `for` element, a destructured payload — and each is
// inside a branch or loop, so emitting the alloca inline is the loop-body
// overflow D-173 fixes. The caller supplies the lowered text it already has —
// lowering again here would be a second chance for the two to differ.
pub func:fnem_local = string(FnEmitter->:fe, int32:name, int32:type_id, string:ll) never fails {
    string:slot = raw irw_temp(fe.w);
    drop irw_alloca(fe.w, slot, ll);
    drop fnem_bind(fe, name, string_concat(slot, ""), type_id);
    pass slot;
};

// BACKWARD, so the innermost binding of a name wins — which is what shadowing
// means. Forward search would resolve every shadowed name to its OUTERMOST
// declaration, silently, in exactly the programs the frontend went out of its way
// to permit.
// THE INDEX, NOT THE SLOT (D-183). Returning the slot copied a string the
// table still owns — a second owner the moment drops exist — and a borrow
// cannot ride in a struct field (D-004 rule 3). The caller reads
// `fnem_local_slot_at` / `fnem_local_type_at` in place; -1 is not-found.
pub func:fnem_lookup_idx = int64(FnEmitter->:fe, int32:name) never fails {
    int64:i = fe.lnames.count;
    while (i > 0i64) {
        i = i - 1i64;
        if (fe.lnames.items[i => int64] == name) { pass i; }
    }
    pass (0i64 - 1i64);
};

// Block entry and exit. The mark is the local count; release truncates back to
// it, so everything a block declared stops resolving the moment it ends.
pub func:fnem_mark = int64(FnEmitter->:fe) never fails { pass fe.lnames.count; };

pub func:fnem_release = NIL(FnEmitter->:fe, int64:mark) never fails {
    // ALL FOUR. Listed, for the reason `fnem_begin`'s reset lists its own.
    fe.lnames.count = mark;
    fe.lslots.count = mark;
    fe.ltypes.count = mark;
    fe.lflags.count = mark;
    pass NIL;
};

// --- control-flow state (dumb state; the walking lives in ir_stmt) ------------------

pub func:fnem_defer_frame_push = NIL(FnEmitter->:fe) never fails {
    drop list_push(@fe.dframes, fe.dstmts.count);
    drop list_push(@fe.dlmarks, fe.lnames.count);
    drop list_push(@fe.dcfmarks, fe.chfins.count);
    drop list_push(@fe.dspawns, fe.spawn_count);
    drop list_push(@fe.djmarks, "");
    pass NIL;
};

// Dropping the frame drops its entries with it — the same truncation the locals
// use, for the same reason: what a block registered stops existing when it does.
// The channel stashes and the spawn count truncate for the same reason (D-207).
pub func:fnem_defer_frame_pop = NIL(FnEmitter->:fe) never fails {
    // The frame group's five drop together; the windows they name are read
    // BEFORE the pop, because after it the marks are past the count.
    int64:top = fe.dframes.count - 1i64;
    int64:dmark = fe.dframes.items[top];
    int64:cfmark = fe.dcfmarks.items[top];
    int32:smark = fe.dspawns.items[top];
    fe.dframes.count = top;
    fe.dlmarks.count = top;
    fe.dcfmarks.count = top;
    fe.dspawns.count = top;
    fe.djmarks.count = top;
    fe.dstmts.count = dmark;
    fe.chfins.count = cfmark;
    fe.chfin_elems.count = cfmark;
    fe.spawn_count = smark;
    pass NIL;
};

// This scope's CHANNEL STASHES — the window `fnem_chfin_add` filled between
// its push and here (D-207, 1.4.4). The `hi` is the live top for the
// innermost scope, exactly as the locals window works.
pub func:fnem_scope_cfmark = int64(FnEmitter->:fe, int64:f) never fails {
    pass fe.dcfmarks.items[f => int64];
};
pub func:fnem_scope_cfhi = int64(FnEmitter->:fe, int64:f) never fails {
    if (f == (fe.dframes.count - 1i64)) { pass fe.chfins.count; }
    pass fe.dcfmarks.items[f + 1i64];
};

// DID THIS SCOPE SPAWN? A spawn in a deeper scope was joined at that scope's
// exit and restored the count on the way out, so this answers about frame `f`
// itself. Emission order is what makes the question answerable at all: within
// one entry of a frame, execution reaches a point having run only that
// frame's statements textually before it — a loop body is a DEEPER frame, and
// `continue` runs that frame's exit before the back edge — so a child on
// frame `f`'s segment at this exit was spawned textually before it.
pub func:fnem_scope_spawned = bool(FnEmitter->:fe, int64:f) never fails {
    pass (fe.spawn_count > fe.dspawns.items[f => int64]);
};
pub func:fnem_note_spawn = NIL(FnEmitter->:fe) never fails {
    fe.spawn_count = fe.spawn_count + 1i32;
    pass NIL;
};

// The slot holding `join_head` as it stood at this scope's entry. "" in a
// synchronous function, which cannot spawn (the checker refuses `drop f(…)`
// on an `async` callee outside an `async` body), and "" for the frame of a
// block whose mark slot the pre-scan did not reserve.
pub func:fnem_set_jmark = NIL(FnEmitter->:fe, move string:slot) never fails {
    fe.djmarks.items[(fe.dframes.count - 1i64) => int64] = move(slot);
    pass NIL;
};
pub func:fnem_scope_jmark = string(FnEmitter->:fe, int64:f) never fails {
    pass (string_from_bytes(fe.djmarks.items[f => int64].ptr,
                            fe.djmarks.items[f => int64].len));
};

pub func:fnem_defer_add = NIL(FnEmitter->:fe, int32:stmt_index) never fails {
    drop list_push(@fe.dstmts, stmt_index);
    pass NIL;
};

pub func:fnem_defer_frames = int64(FnEmitter->:fe) never fails { pass fe.dframes.count; };
pub func:fnem_defer_frame_lo = int64(FnEmitter->:fe, int64:f) never fails {
    pass fe.dframes.items[f => int64];
};
pub func:fnem_defer_frame_hi = int64(FnEmitter->:fe, int64:f) never fails {
    if (f == (fe.dframes.count - 1i64)) { pass fe.dstmts.count; }
    pass fe.dframes.items[f + 1i64];
};
pub func:fnem_defer_at = int32(FnEmitter->:fe, int64:i) never fails {
    pass fe.dstmts.items[i => int64];
};

// A SCOPE'S OWN LOCALS: those bound between its mark and the next scope's, or
// the live top for the innermost. The drop unwind walks this window backwards,
// which is reverse declaration order within the scope (D-183).
pub func:fnem_scope_lmark = int64(FnEmitter->:fe, int64:f) never fails {
    pass fe.dlmarks.items[f => int64];
};
pub func:fnem_scope_lhi = int64(FnEmitter->:fe, int64:f) never fails {
    if (f == (fe.dframes.count - 1i64)) { pass fe.lnames.count; }
    pass fe.dlmarks.items[f + 1i64];
};
pub func:fnem_local_slot_at = string(FnEmitter->:fe, int64:i) never fails {
    pass (string_from_bytes(fe.lslots.items[i => int64].ptr, fe.lslots.items[i => int64].len));
};
pub func:fnem_local_type_at = int32(FnEmitter->:fe, int64:i) never fails {
    pass fe.ltypes.items[i => int64];
};

// Attach a drop flag to the most recent binding (D-183, 1.2.3). Called right
// after the `fnem_bind`/`fnem_local` that created it, by the two sites that
// create OWNED bindings: `emit_vardecl`, and the prologue for `move` params.
pub func:fnem_flag_last = NIL(FnEmitter->:fe, move string:flag) never fails {
    fe.lflags.items[(fe.lnames.count - 1i64) => int64] = move(flag);
    pass NIL;
};
// The by-index form, for a coroutine's `move` parameters (D-183, 1.2.4b):
// they are the first `pcount` binding entries — bound in order before any
// body local — and their frame flag GEPs are cut after every bind.
pub func:fnem_flag_at = NIL(FnEmitter->:fe, int64:i, move string:flag) never fails {
    fe.lflags.items[i => int64] = move(flag);
    pass NIL;
};
pub func:fnem_local_flag_at = string->(FnEmitter->:fe, int64:i) never fails {
    pass ($$i fe.lflags.items[i => int64]);
};
pub func:fnem_param_is_move = bool(FnEmitter->:fe, int64:i) never fails {
    if (i < 0i64) { pass false; }
    if (i >= fe.pnames.count) { pass false; }
    pass (fe.pmoves.items[i => int64] != 0i32);
};

pub func:fnem_loop_push = NIL(FnEmitter->:fe, move string:head, move string:done,
                              int32:label, move string:iter) never fails {
    drop list_push(@fe.loop_heads, move(head));
    drop list_push(@fe.loop_dones, move(done));
    drop list_push(@fe.loop_depths, fe.dframes.count);
    drop list_push(@fe.loop_labels, label);
    drop list_push(@fe.loop_iters, move(iter));
    drop list_push(@fe.loop_tmarks, fe.ttypes.count);
    pass NIL;
};

pub func:fnem_loop_tmark_at = int64(FnEmitter->:fe, int64:i) never fails {
    pass (fe.loop_tmarks.items[i]);
};

// The stack index a labelled `break`/`continue` targets: the nearest frame
// carrying the label, or -1. Unlabelled (0) means the top.
pub func:fnem_loop_find = int64(FnEmitter->:fe, int32:label) never fails {
    if (label == 0i32) { pass (fe.loop_heads.count - 1i64); }
    int64:i = fe.loop_heads.count;
    while (i > 0i64) {
        i = i - 1i64;
        if (fe.loop_labels.items[i => int64] == label) { pass i; }
    }
    pass (0i64 - 1i64);
};

// The innermost `$` slot — the nearest counted frame; "" when none is open.
pub func:fnem_iter_slot = string(FnEmitter->:fe) never fails {
    int64:i = fe.loop_heads.count;
    while (i > 0i64) {
        i = i - 1i64;
        // A GETTER OVER A CONTAINER OF OWNING VALUES: returning a BORROW is
        // refused by D-004 rule 2 and the deep-view accessor family D-183
        // records is not built, so the correct spelling available today is the
        // one that allocates. It was `move(fe.loop_iters.items[i])` until 1.4.3 —
        // which does not empty a container ELEMENT (there is no drop flag on
        // one), so the caller and the container held one body between them and
        // whichever dropped first freed it. The move analysis said so as soon
        // as it could see `fe`, a parameter. Cold: one call per `$` in a
        // counted loop.
        string:it = string_concat(fe.loop_iters.items[i => int64], "");
        if (it.len > 0i64) { pass it; }
    }
    pass "";
};

pub func:fnem_pick_push = NIL(FnEmitter->:fe, move string:done, move string:slot,
                              move string:ll, int32:slot_ty, int32:start,
                              int32:count, int32:seq) never fails {
    drop list_push(@fe.pick_dones, move(done));
    drop list_push(@fe.pick_slots, move(slot));
    drop list_push(@fe.pick_lls, move(ll));
    drop list_push(@fe.pick_tids, slot_ty);
    drop list_push(@fe.pick_starts, start);
    drop list_push(@fe.pick_counts, count);
    drop list_push(@fe.pick_seqs, seq);
    drop list_push(@fe.pick_depths, fe.dframes.count);
    pass NIL;
};

pub func:fnem_pick_pop = NIL(FnEmitter->:fe) never fails {
    int64:n = fe.pick_dones.count - 1i64;   // ALL EIGHT
    fe.pick_dones.count = n;
    fe.pick_slots.count = n;
    fe.pick_lls.count = n;
    fe.pick_tids.count = n;
    fe.pick_starts.count = n;
    fe.pick_counts.count = n;
    fe.pick_seqs.count = n;
    fe.pick_depths.count = n;
    pass NIL;
};

pub func:fnem_pick_done = string(FnEmitter->:fe) never fails {
    pass (string_from_bytes(fe.pick_dones.items[(fe.pick_dones.count - 1i64) => int64].ptr, fe.pick_dones.items[(fe.pick_dones.count - 1i64) => int64].len));
};
pub func:fnem_pick_slot = string(FnEmitter->:fe) never fails {
    pass (string_from_bytes(fe.pick_slots.items[(fe.pick_dones.count - 1i64) => int64].ptr, fe.pick_slots.items[(fe.pick_dones.count - 1i64) => int64].len));
};
pub func:fnem_pick_ll = string(FnEmitter->:fe) never fails {
    pass (string_from_bytes(fe.pick_lls.items[(fe.pick_dones.count - 1i64) => int64].ptr, fe.pick_lls.items[(fe.pick_dones.count - 1i64) => int64].len));
};
pub func:fnem_pick_tid = int32(FnEmitter->:fe) never fails {
    pass fe.pick_tids.items[(fe.pick_dones.count - 1i64) => int64];
};
pub func:fnem_pick_start = int32(FnEmitter->:fe) never fails {
    pass fe.pick_starts.items[(fe.pick_dones.count - 1i64) => int64];
};
pub func:fnem_pick_count_of = int32(FnEmitter->:fe) never fails {
    pass fe.pick_counts.items[(fe.pick_dones.count - 1i64) => int64];
};
pub func:fnem_pick_seq_of = int32(FnEmitter->:fe) never fails {
    pass fe.pick_seqs.items[(fe.pick_dones.count - 1i64) => int64];
};
pub func:fnem_pick_depth = int64(FnEmitter->:fe) never fails {
    pass fe.pick_depths.items[(fe.pick_dones.count - 1i64) => int64];
};
pub func:fnem_next_pick_seq = int32(FnEmitter->:fe) never fails {
    fe.pick_seq = fe.pick_seq + 1i32;
    pass fe.pick_seq;
};

pub func:fnem_loop_head_at = string(FnEmitter->:fe, int64:i) never fails {
    pass (string_from_bytes(fe.loop_heads.items[i => int64].ptr, fe.loop_heads.items[i => int64].len));
};
pub func:fnem_loop_done_at = string(FnEmitter->:fe, int64:i) never fails {
    pass (string_from_bytes(fe.loop_dones.items[i => int64].ptr, fe.loop_dones.items[i => int64].len));
};
pub func:fnem_loop_depth_at = int64(FnEmitter->:fe, int64:i) never fails {
    pass fe.loop_depths.items[i => int64];
};

pub func:fnem_loop_pop = NIL(FnEmitter->:fe) never fails {
    int64:n = fe.loop_heads.count - 1i64;   // ALL SIX
    fe.loop_heads.count = n;
    fe.loop_dones.count = n;
    fe.loop_depths.count = n;
    fe.loop_labels.count = n;
    fe.loop_iters.count = n;
    fe.loop_tmarks.count = n;
    pass NIL;
};

// --- statement-end temporaries (D-246, 1.5.1b step 4) --------------------------

pub func:fnem_temp_mark = int64(FnEmitter->:fe) never fails { pass fe.ttypes.count; };

pub func:fnem_temp_count = int64(FnEmitter->:fe) never fails { pass fe.ttypes.count; };

pub func:fnem_temp_release = NIL(FnEmitter->:fe, int64:mark) never fails {
    fe.ttypes.count = mark;
    fe.tslots.count = mark;
    fe.tflags.count = mark;
    fe.trefs.count = mark;
    fe.tlive.count = mark;
    pass NIL;
};

pub func:fnem_temp_push = int64(FnEmitter->:fe, int32:ttid, move string:slot,
                                move string:flag, move string:ref) never fails {
    int64:i = fe.ttypes.count;
    drop list_push(@fe.ttypes, ttid);
    drop list_push(@fe.tslots, move(slot));
    drop list_push(@fe.tflags, move(flag));
    drop list_push(@fe.trefs, move(ref));
    drop list_push(@fe.tlive, 1i32);
    pass i;
};

// THE TEMPORARY WHOSE VALUE IS `ref` IS TAKEN: a consumer keeps it, so no drop
// is emitted for it anywhere. A value that is nobody's temporary is left
// alone -- every consumer says "take" without asking, and only a registered
// SSA name answers. Newest first: the same name never names two live ones.
pub func:fnem_temp_take = NIL(FnEmitter->:fe, string:ref) never fails {
    int64:i = fe.ttypes.count;
    while (i > 0i64) {
        i = i - 1i64;
        if (fe.tlive.items[i] != 0i32) {
            if (raw string_eq(fe.trefs.items[i], ref)) {
                fe.tlive.items[i] = 0i32;
                pass NIL;
            }
        }
    }
    pass NIL;
};

pub func:fnem_temp_live_at = int32(FnEmitter->:fe, int64:i) never fails { pass (fe.tlive.items[i]); };
pub func:fnem_temp_type_at = int32(FnEmitter->:fe, int64:i) never fails { pass (fe.ttypes.items[i]); };
// Views of container-owned storage (D-183): cap 0, drops free nothing.
pub func:fnem_temp_slot_at = string(FnEmitter->:fe, int64:i) never fails {
    pass (string_from_bytes(fe.tslots.items[i].ptr, fe.tslots.items[i].len));
};
pub func:fnem_temp_flag_at = string(FnEmitter->:fe, int64:i) never fails {
    pass (string_from_bytes(fe.tflags.items[i].ptr, fe.tflags.items[i].len));
};

// THE FRAME'S FIXED SLOT COUNT: the header, the parameters, the crossing
// region and the flag bytes, counted exactly as `fnem_frame_slots_text` lays
// them out -- the temporary region begins at this index.
pub func:fnem_frame_fixed_slots = int64(FnEmitter->:fe) never fails {
    int64:n = 12i64 + fe.pnames.count + fe.cross_stmts.count;
    int32:i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        if (fe.pmoves.items[i => int64] != 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.ptypes.items[i => int64], 64i32)) {
                n = n + 1i64;
            }
        }
        i = i + 1i32;
    }
    i = 0i32;
    while ((i => int64) < fe.cross_stmts.count) {
        if (fe.cross_roles.items[i => int64] == 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.cross_types.items[i => int64], 64i32)) {
                n = n + 1i64;
            }
        }
        i = i + 1i32;
    }
    pass n;
};

// A FRAME-RESIDENT TEMPORARY'S TWO SLOTS (the value, then its i8 flag),
// appended to the region; the caller computes their GEPs from the index.
pub func:fnem_temp_frame_add = int64(FnEmitter->:fe, move string:ll) never fails {
    int64:idx = (raw fnem_frame_fixed_slots(fe)) + fe.tframe_lls.count;
    drop list_push(@fe.tframe_lls, move(ll));
    drop list_push(@fe.tframe_lls, "i8");
    pass idx;
};

pub func:fnem_temp_frame_flag = NIL(FnEmitter->:fe, move string:gep) never fails {
    drop list_push(@fe.tframe_flags, move(gep));
    pass NIL;
};

pub func:fnem_loop_head = string(FnEmitter->:fe) never fails {
    pass (string_from_bytes(fe.loop_heads.items[(fe.loop_heads.count - 1i64) => int64].ptr, fe.loop_heads.items[(fe.loop_heads.count - 1i64) => int64].len));
};
pub func:fnem_loop_done = string(FnEmitter->:fe) never fails {
    pass (string_from_bytes(fe.loop_dones.items[(fe.loop_heads.count - 1i64) => int64].ptr, fe.loop_dones.items[(fe.loop_heads.count - 1i64) => int64].len));
};
pub func:fnem_loop_depth = int64(FnEmitter->:fe) never fails {
    pass fe.loop_depths.items[(fe.loop_heads.count - 1i64) => int64];
};

// --- returns ----------------------------------------------------------------------
//
// The seed's `emit_return` / `emit_return_err`, shape for shape.

// `pass v` — the Result is BUILT, not assembled over time: value in slot 0, and
// error EXPLICITLY ZERO in slot 1. `Result<NIL>` is the constant `{ i32 0 }`.
pub func:fnem_ret_pass = NIL(FnEmitter->:fe, string:value) never fails {
    if (fe.bare) {
        drop fnem_ret_agg(fe, value);
        pass NIL;
    }
    if (fe.ret_nil) {
        drop fnem_ret_agg(fe, "{ i32 0 }");
        pass NIL;
    }
    string:a = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(a, " = insertvalue ", fe.ret_ll,
                                   " zeroinitializer, ",
                                   raw cat4(fe.val_ll, " ", value, ", 0")));
    string:b = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(b, " = insertvalue ", fe.ret_ll,
                                   " ", string_concat(a, ", i32 0, 1")));
    drop fnem_ret_agg(fe, b);
    pass NIL;
};

// `fail c` — a zeroed value slot and the code in the error slot, so a caller that
// unwraps without checking reads an empty value rather than memory that means
// something else.
pub func:fnem_ret_fail = NIL(FnEmitter->:fe, string:code) never fails {
    if (fe.bare) {
        // The frontend refuses `fail` in `main` and `failsafe` (there is no
        // Result to fail into); emitting the bare form anyway means a frontend
        // regression produces IR that is wrong, not IR that is malformed.
        drop fnem_ret_agg(fe, code);
        pass NIL;
    }
    if (fe.ret_nil) {
        string:a = raw irw_temp(fe.w);
        drop irw_line(fe.w, raw cat5(a, " = insertvalue ", fe.ret_ll,
                                       " zeroinitializer, i32 ",
                                       string_concat(code, ", 0")));
        drop fnem_ret_agg(fe, a);
        pass NIL;
    }
    string:a = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(a, " = insertvalue ", fe.ret_ll,
                                   " zeroinitializer, ",
                                   raw cat4(fe.val_ll, " ", fe.val_zero, ", 0")));
    string:b = raw irw_temp(fe.w);
    drop irw_line(fe.w, raw cat5(b, " = insertvalue ", fe.ret_ll,
                                   " ", raw cat4(a, ", i32 ", code, ", 1")));
    drop fnem_ret_agg(fe, b);
    pass NIL;
};

// Close the body. A function that falls off its end still terminates — subset-1
// sources always return explicitly, and this keeps the IR well-formed regardless,
// which is the seed's rule too.
// THE FRAME TYPE, in the layout `fnem_open_async` documents: the header, one
// slot per parameter, the crossing region, the flag bytes, then (1.5.1b step
// 4) the TEMPORARY region -- a value slot and an i8 flag per temporary that
// crossed an `await`, appended last so every established index keeps its
// meaning (`fnem_frame_fixed_slots` counts to its start).
func:fnem_frame_type_write = NIL(FnEmitter->:fe) never fails {
    string:slots = string_concat("ptr, i32, i32, ", fe.ret_ll);
    slots = string_concat(slots, ", ptr, ptr, ptr, ptr, i64, ptr, ptr, ptr");
    int32:i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        slots = raw cat3(slots, ", ", fe.plls.items[i => int64]);
        i = i + 1i32;
    }
    i = 0i32;
    while ((i => int64) < fe.cross_stmts.count) {
        slots = raw cat3(slots, ", ", fe.cross_lls.items[i => int64]);
        i = i + 1i32;
    }
    // DROP-FLAG SLOTS (D-183, 1.2.4b): one i8 per owning `move` parameter,
    // then one per owning crossing var-decl (role 0) — appended AFTER the
    // crossing region so every established index keeps its meaning. A flag
    // is the byte that says the binding still owns its value; a crossing
    // local's byte must cross with it, because an alloca dies between
    // `resume` calls exactly like the value slot it guards would have.
    i = 0i32;
    while ((i => int64) < fe.pnames.count) {
        if (fe.pmoves.items[i => int64] != 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.ptypes.items[i => int64], 64i32)) {
                slots = string_concat(slots, ", i8");
            }
        }
        i = i + 1i32;
    }
    i = 0i32;
    while ((i => int64) < fe.cross_stmts.count) {
        if (fe.cross_roles.items[i => int64] == 0i32) {
            if (raw type_drops_recorded(fe.ctx.types, fe.cross_types.items[i => int64], 64i32)) {
                slots = string_concat(slots, ", i8");
            }
        }
        i = i + 1i32;
    }
    int64:t = 0i64;
    while (t < fe.tframe_lls.count) {
        slots = raw cat3(slots, ", ", fe.tframe_lls.items[t]);
        t = t + 1i64;
    }
    drop irw_frame_type(fe.w, raw cat5(fe.frame_ty, " = type { ", slots, " }", ""));
    pass NIL;
};

pub func:fnem_close = NIL(FnEmitter->:fe, bool:terminated) never fails {
    if (!terminated) {
        if (fe.bare) {
            drop fnem_ret_agg(fe, "0");
        } else {
            drop fnem_ret_agg(fe, "zeroinitializer");
        }
        // No unwind runs between the two halves here: a body that falls off
        // its end already had its own block's exit walked by `emit_block`,
        // joins and drops included (D-207).
        drop fnem_ret_done(fe);
    }
    if (fe.is_async) {
        // `%npk.join` USED TO LIVE HERE (D-177 stage E). One block, emitted
        // once, that every exit branched to — which is exactly what made the
        // join run after every scope's drops, including the sync primitives a
        // spawned child borrows. D-207 moved it into the unwind
        // (`emit_scope_join`, ir_stmt), where it is emitted per scope exit
        // like defers and drops already are, and the channel reclaims moved
        // with it.

        // A RESUME STATE NOBODY ASSIGNED IS A DEFECT, not a branch: the state
        // word is written only by this function's own suspensions, so the
        // switch's default makes a controlled stop (D-061), the same shape
        // `#unreachable()` lowers to.
        drop irw_label(fe.w, "coro.bad");
        drop irw_line(fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                          int_to_string(fe.fn_site => int64), ")"));
        string:bt = raw irw_temp(fe.w);
        drop irw_line(fe.w, raw cat3(bt, " = call i32 @npk_failsafe(i32 ",
                          "-4102)"));
        drop irw_line(fe.w, raw cat3("call void @npk_exit(i32 ", bt, ")"));
        drop irw_line(fe.w, "unreachable");

        drop fnem_frame_type_write(fe);

        // The entry block's tail, appended after every hoisted alloca and
        // frame GEP: load the state, dispatch to its segment.
        string:st = raw irw_temp(fe.w);
        drop irw_entry(fe.w, raw cat3(st, " = load i32, ptr ", fe.state_gep));
        // THE FIRST RESUME ZEROES THE TEMPORARY FLAGS (1.5.1b step 4): a frame
        // is not zeroed at birth, and a temporary's flag must read "not
        // produced" on every path its statement did not take -- so state 0,
        // and only state 0, stores the zeros before the dispatch.
        if (fe.tframe_flags.count > 0i64) {
            string:is0 = raw irw_temp(fe.w);
            drop irw_entry(fe.w, raw cat3(is0, " = icmp eq i32 ", string_concat(st, ", 0")));
            drop irw_entry(fe.w, raw cat3("br i1 ", is0, ", label %coro.tinit, label %coro.go"));
            drop irw_entry_label(fe.w, "coro.tinit");
            int64:tf = 0i64;
            while (tf < fe.tframe_flags.count) {
                drop irw_entry(fe.w, raw cat3("store i8 0, ptr ", fe.tframe_flags.items[tf], ""));
                tf = tf + 1i64;
            }
            drop irw_entry(fe.w, "br label %coro.go");
            drop irw_entry_label(fe.w, "coro.go");
        }
        string:cases = "";
        int32:k = 0i32;
        while ((k => int64) < fe.seg_labels.count) {
            cases = raw cat5(cases, " i32 ", int_to_string(k => int64),
                             ", label %", fe.seg_labels.items[k => int64]);
            k = k + 1i32;
        }
        drop irw_entry(fe.w, raw cat5("switch i32 ", st,
                          ", label %coro.bad [", cases, " ]"));
    }
    // The hoisted allocas, then the body, into the module stream (1.0.9a).
    drop irw_close_fn(fe.w);
    drop irw_raw(fe.w, "}");
    drop irw_blank(fe.w);
    pass NIL;
};
