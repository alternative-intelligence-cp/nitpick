// Statement lowering — blocks, declarations, assignment, `if`, `while`,
// `pass`/`fail`/`exit`, `defer`, `break`/`continue`, and whole functions.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.7.6.
//
// THIS MODULE AND `ir_expr` ARE A DECLARED CYCLE, the same way `type_expr` and
// `type_stmt` are (0.4.2): a statement contains expressions, and `relay` is an
// expression that exits the function — which means running the `defer` stack,
// which means emitting statements. The cycle is the honest shape of that; hiding
// it behind a callback would be the same dependency with the name filed off.
//
// TWO DEPARTURES FROM THE SEED, both closing a defect it recorded or carried:
//
//   `break`/`continue` RUN THE DEFERS OF THE SCOPES THEY EXIT. The seed's own
//   comment concedes the gap: "defers registered INSIDE the loop body do not run
//   here. That is a gap the real compiler must close" — D-014 makes scope exit a
//   normal exit path, and a `break` exits every scope between it and the loop.
//   The loop stack records the defer depth at entry; `break` runs every frame
//   deeper than it, LIFO, before branching.
//
//   `pass v` EVALUATES `v` FIRST, THEN RUNS DEFERS (D-136). The seed does the
//   reverse, so a defer that mutates `x` changes what `pass x` returns — a read
//   whose meaning depends on cleanup code pages away. The value you passed is
//   the value returned; `fail` and `exit` follow the same rule.

mod:ir_stmt;

use "../../frontend/source_location.npk".*;
use "../../frontend/intern.npk".*;
use "../../frontend/token_kind.npk".*;
use "../../frontend/ast_kind.npk".*;
use "../../frontend/ast.npk".*;
use "../../frontend/parse_expr.npk".*;
use "../../frontend/parse_stmt.npk".*;
use "../../frontend/parse_decl.npk".*;
use "../../frontend/parser.npk".*;   // QUAL_MOVE (D-183)
use "../../frontend/parse_decorate.npk".*;
use "../../frontend/parse_pick.npk".*;
use "../../frontend/type_layout.npk".*;
use "../../frontend/type_generic.npk".*;
use "../../frontend/diagnostics.npk".*;
use "../../frontend/types.npk".*;
use "../../frontend/expr_types.npk".*;
use "../../frontend/symbols.npk".*;
use "../../frontend/resolve_type.npk".*;
use "../../frontend/type_decl.npk".*;
use "../../frontend/type_trait.npk".*;   // impl_count/impl_at, method_symbol_name (D-166)
use "../../frontend/type_names.npk".*;   // method_symbol_name (D-166)
use "./ir_writer.npk".*;
use "./ir_types.npk".*;
use "./ir_func.npk".*;
use "./ir_expr.npk".*;

// A `br` or a block start, through the terminated flag — mirrors the seed's
// `br()`/`start_block()`: a branch after a terminator is IR llc rejects, and a
// label resets the flag because a new block is live by construction.
pub func:s_br = NIL(ExprEmitter->:x, string:label) never fails {
    if (!x.fe.terminated) {
        drop irw_line(x.fe.w, raw string_concat("br label %", label));
        x.fe.terminated = true;
    }
    pass NIL;
};

pub func:s_start = NIL(ExprEmitter->:x, string:label) never fails {
    drop irw_label(x.fe.w, label);
    x.fe.terminated = false;
    pass NIL;
};

// --- defers -------------------------------------------------------------------------

// Run the frames deeper than `depth`, innermost first, latest first — without
// popping anything: the frames belong to scopes that are still open on other
// paths. A deferred body is emitted AT EACH EXIT that runs it; cleanup code is
// duplicated per path, which is the seed's model and what naive lowering means.
pub func:run_defers_down_to = IrVal(ExprEmitter->:x, int32:depth) never fails {
    int32:f = raw fnem_defer_frames(x.fe);
    while (f > depth) {
        f = f - 1i32;
        int32:hi = raw fnem_defer_frame_hi(x.fe, f);
        int32:lo = raw fnem_defer_frame_lo(x.fe, f);
        int32:i = hi;
        while (i > lo) {
            i = i - 1i32;
            StmtId:body = StmtId{ index: raw fnem_defer_at(x.fe, i) };
            IrVal:r = raw emit_stmt(x, body);
            if (!(raw iv_is_ok(r))) { pass r; }
        }
        // THIS SCOPE'S DROPS (D-183, 1.2.3) — after its defers, because a
        // `defer` body can name the scope's bindings and dropping first would
        // hand it freed storage; and before the enclosing scope's anything,
        // because that is what innermost-first means. Held back until the
        // move-only rule armed (1.2.2): drops in a language where a copy
        // makes two owners are a use-after-free, measured, not a leak fix.
        IrVal:dr = raw run_scope_drops(x, f);
        if (!(raw iv_is_ok(dr))) { pass dr; }
    }
    // A FULL EXIT ALSO RELEASES THE `move` PARAMETERS (D-183, 1.2.3): they
    // sit below every scope frame — bound in the prologue, before the body
    // block pushes — so the frame walk never reaches them, which is exactly
    // right for `break`/`continue` (depth > 0) and exactly wrong for the
    // function's own exits. Lent parameters have no flag and are the
    // CALLER's to drop.
    if (depth == 0i32) {
        IrVal:pr = raw run_param_drops(x);
        if (!(raw iv_is_ok(pr))) { pass pr; }
        // CHANNEL RECLAIMS (D-183, 1.2.5) — SYNC functions only: they spawn
        // nothing, so there is no join to order against; a coroutine's
        // reclaims sit after its join, at `npk.jend` in `fnem_close`.
        if (!x.fe.is_async) {
            int32:cfi = 0i32;
            while (cfi < x.fe.chfin_count) {
                drop fnem_chfin_reclaim(x.fe, cfi);
                cfi = cfi + 1i32;
            }
        }
    }
    pass (raw iv_nil());
};

// One scope's drops, FLAG-TESTED (D-183, 1.2.3). A binding with no flag emits
// nothing at all — that covers every non-owning local (the feature costs zero
// for the scalars that dominate every program) and the bindings that are
// deliberately unflagged: pick-arm and loop bindings, bitwise copies of
// storage a container still owns, safe precisely because they never drop.
// The test is one load and one branch; a moved-out binding's flag is zero, so
// the drop is skipped exactly where D-065 says the binding no longer owns.
pub func:run_scope_drops = IrVal(ExprEmitter->:x, int32:f) never fails {
    int32:lhi = raw fnem_scope_lhi(x.fe, f);
    int32:llo = raw fnem_scope_lmark(x.fe, f);
    int32:i = lhi;
    while (i > llo) {
        i = i - 1i32;
        drop emit_one_flagged_drop(x, i);
    }
    pass (raw iv_nil());
};

pub func:run_param_drops = IrVal(ExprEmitter->:x) never fails {
    int32:i = x.fe.pcount;
    while (i > 0i32) {
        i = i - 1i32;
        drop emit_one_flagged_drop(x, i);
    }
    pass (raw iv_nil());
};

func:emit_one_flagged_drop = NIL(ExprEmitter->:x, int32:i) never fails {
    // AGGREGATE DROPS WENT LIVE AT 1.2.3e. They were staged for a day behind
    // a TY_STRUCT/TY_ENUM guard here while a one-line corruption in stage 1's
    // output was hunted; a by-tid bisect first blamed the emitter's own
    // `FnEmitter`, wrongly — enabling any drop set shifts the allocator's
    // recycling pattern, so a guilty configuration proves only that SOME
    // still-referenced body was freed SOMEWHERE. The real defect was
    // `result_ll_value_half` passing a `slice_proven` VIEW of a lent ll out
    // to become a longer-lived IrVal's `.ll` (see ir_expr). The quarantine
    // allocator (`@npk_quarantine` in npkrt.ll) is what actually isolated
    // it: free poisons and never reuses, so the one stale read produced
    // seventeen 0xAA bytes at a deterministic line and the concat tripwire
    // named reader and freer under gdb. That instrument stays, off by
    // default, for the next hunt.
    string->:fl = raw fnem_local_flag_at(x.fe, i);
    if (fl.len == 0i64) { pass NIL; }
    string:lf = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(lf, " = load i8, ptr ", <-fl, ""));
    string:lb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(lb, " = icmp ne i8 ",
                      raw string_concat(lf, ", 0")));
    string:dl = raw irw_new_label(x.fe.w, "drop.go");
    string:nl = raw irw_new_label(x.fe.w, "drop.done");
    drop irw_line(x.fe.w, raw cat5("br i1 ", lb, ", label %", dl,
                      raw string_concat(", label %", nl)));
    drop s_start(x, dl);
    drop irw_line(x.fe.w, raw cat3("call void ",
                      raw drop_fn_sym(x.fe.ctx, raw fnem_local_type_at(x.fe, i)),
                      raw string_concat(
                          raw string_concat("(ptr ",
                              raw fnem_local_slot_at(x.fe, i)), ")")));
    drop s_br(x, nl);
    drop s_start(x, nl);
    pass NIL;
};

pub func:run_all_defers = IrVal(ExprEmitter->:x) never fails {
    pass (raw run_defers_down_to(x, 0i32));
};

// `exit` RUNS DEFERS AND NO DROPS (D-183, amended at 1.2.3). Two reasons, and
// the second is the safety case. The process is ending: managed reclamation at
// process death is what the kernel does wholesale, so drops here buy nothing —
// Rust's `process::exit` runs no destructors on the same reasoning. And `exit`
// is the CONTROLLED SHUTDOWN (D-013: main and failsafe only) — the one path
// that must not fail. Walking the program's entire live state to free it, on
// the way out, adds failure modes to exactly the path that exists to have
// none: stage 1's own exit walked the whole pipeline struct and died in the
// heap validator. Defers still run (D-014's list is unchanged); the D-151
// leak check still runs and still covers what it always covered — WILD
// allocations, whose discipline is manual and unaffected by this.
pub func:run_exit_defers = IrVal(ExprEmitter->:x) never fails {
    int32:f = raw fnem_defer_frames(x.fe);
    while (f > 0i32) {
        f = f - 1i32;
        int32:hi = raw fnem_defer_frame_hi(x.fe, f);
        int32:lo = raw fnem_defer_frame_lo(x.fe, f);
        int32:i = hi;
        while (i > lo) {
            i = i - 1i32;
            StmtId:body = StmtId{ index: raw fnem_defer_at(x.fe, i) };
            IrVal:r = raw emit_stmt(x, body);
            if (!(raw iv_is_ok(r))) { pass r; }
        }
    }
    pass (raw iv_nil());
};

// --- blocks -------------------------------------------------------------------------

pub func:emit_block = IrVal(ExprEmitter->:x, StmtId:sid) never fails {
    StmtNode:s = raw ast_stmt(x.ast, sid);
    int32:mark = raw fnem_mark(x.fe);
    drop fnem_defer_frame_push(x.fe);

    int32:i = 0i32;
    int32:n = raw stmt_list_count(s);
    while (i < n) {
        if (x.fe.terminated) { break; }
        StmtId:st = StmtId{ index: raw ast_id_at(x.ast, raw stmt_list_start(s), i) };
        IrVal:r = raw emit_stmt(x, st);
        if (!(raw iv_is_ok(r))) { pass r; }
        i = i + 1i32;
    }

    // The block's own defers, on its NORMAL end. A terminated block already ran
    // them at whatever exit terminated it.
    if (!x.fe.terminated) {
        IrVal:r = raw run_defers_down_to(x, (raw fnem_defer_frames(x.fe)) - 1i32);
        if (!(raw iv_is_ok(r))) { pass r; }
    }
    drop fnem_defer_frame_pop(x.fe);
    drop fnem_release(x.fe, mark);
    pass (raw iv_nil());
};

// --- statements ---------------------------------------------------------------------

pub func:emit_stmt = IrVal(ExprEmitter->:x, StmtId:sid) never fails {
    StmtNode:s = raw ast_stmt(x.ast, sid);
    // Each statement opens a fresh temp mark (D-177): `emit_await` refuses to
    // suspend past an SSA value this statement already minted.
    drop irw_stmt_mark(x.fe.w);
    x.fe.cur_stmt = sid.index;
    x.fe.chopen_ord = 0i32;

    if (s.kind == StmtKind.StmtBlockStmt)   { pass (raw emit_block(x, sid)); }
    if (s.kind == StmtKind.StmtVarDeclStmt) { pass (raw emit_vardecl(x, s, sid)); }
    if (s.kind == StmtKind.StmtAssignStmt)  { pass (raw emit_assign(x, s)); }

    if (s.kind == StmtKind.StmtExprStmt) {
        IrVal:v = raw emit_expr(x, raw stmt_expr(s));
        if (!(raw iv_is_ok(v))) { pass v; }
        pass (raw iv_nil());
    }
    if (s.kind == StmtKind.StmtDiscardStmt) {
        IrVal:v = raw emit_expr(x, raw stmt_operand(s));
        if (!(raw iv_is_ok(v))) { pass v; }
        pass (raw iv_nil());
    }

    if (s.kind == StmtKind.StmtIfStmt)      { pass (raw emit_if(x, s)); }
    if (s.kind == StmtKind.StmtWhileStmt)   { pass (raw emit_while(x, s)); }

    if (s.kind == StmtKind.StmtBreakStmt)   { pass (raw emit_break(x, s, true)); }
    if (s.kind == StmtKind.StmtContinueStmt){ pass (raw emit_break(x, s, false)); }

    if (s.kind == StmtKind.StmtPassStmt)    { pass (raw emit_pass(x, s)); }
    if (s.kind == StmtKind.StmtFailStmt)    { pass (raw emit_fail(x, s)); }
    if (s.kind == StmtKind.StmtExitStmt)    { pass (raw emit_exit(x, s)); }
    if (s.kind == StmtKind.StmtTrapStmt)    { pass (raw emit_trap(x, s)); }

    if (s.kind == StmtKind.StmtDeferStmt) {
        drop fnem_defer_add(x.fe, (raw stmt_target(s)).index);
        pass (raw iv_nil());
    }

    if (s.kind == StmtKind.StmtReturnStmt)  { pass (raw emit_return(x, s)); }
    if (s.kind == StmtKind.StmtPickStmt)    { pass (raw emit_pick(x, s)); }

    // `give` yields from a pick EXPRESSION (D-059), and `fall` is its explicit
    // fallthrough — both live or die with `PickExpr`, which is 0.9's.

    if (s.kind == StmtKind.StmtForStmt) { pass (raw emit_for(x, s, sid)); }
    if (s.kind == StmtKind.StmtLoopStmt) { pass (raw emit_counted(x, s, sid, false)); }
    if (s.kind == StmtKind.StmtTillStmt) { pass (raw emit_counted(x, s, sid, true)); }
    if (s.kind == StmtKind.StmtWhenStmt)  { pass (raw emit_when(x, s, sid)); }

    if (s.kind == StmtKind.StmtGiveStmt) { pass (raw emit_give(x, s)); }
    if (s.kind == StmtKind.StmtFallStmt) { pass (raw emit_fall(x, s)); }
    if (s.kind == StmtKind.StmtProveStmt) {
        pass (raw iv_rung("`prove`", "1.5", s.span));
    }
    if (s.kind == StmtKind.StmtAssertStaticStmt) {
        pass (raw iv_rung("`assert_static`", "1.5", s.span));
    }

    // FAIL CLOSED — StmtNone, a bare PickArm, or a kind nobody classified.
    pass (raw iv_broken(s.span));
};

// --- declarations and assignment ----------------------------------------------------

func:emit_vardecl = IrVal(ExprEmitter->:x, StmtNode:s, StmtId:sid) never fails {
    // LIVE-1's repair (0.9.0): a `limit<Rules>` that lowered to a bare alloca
    // told the program its rule held while nothing checked it — the worst
    // outcome D-068 names. Refused until 1.4 emits the real check; the same
    // shape `prove` has had since 0.7.
    VerifyId:lim = raw stmt_decl_limit(x.ast, s);
    if (!(raw verify_is_none(lim))) {
        pass (raw iv_rung("a `limit<Rules>` constraint", "1.5", s.span));
    }
    int32:dty = raw resolve_type(x.tr, raw stmt_decl_type(s), x.scope);
    LlType:ll = raw ll_type(x.fe.ctx, dty);
    if (!(raw ll_is_ok(ll))) { pass (raw iv_from_ll_at(x, ll, dty, s.span)); }

    // SLOT FIRST, THEN THE INITIALISER — the seed's order, and the right one:
    // the name is not bound until after the initialiser runs (`fnem_local` binds
    // on the way out), so `int32:x = x;` reads the OUTER `x`, not the slot being
    // created.
    //
    // A CROSSING LOCAL LIVES IN THE FRAME (D-177, stage D): the suspend walk
    // marked it, the pre-scan reserved its slot, and the entry block cut its
    // GEP — an alloca would die between `resume` calls. A marked local with
    // no reserved slot is one the pre-scan could not reach (a decl inside a
    // value-`pick`), and it refuses rather than silently taking an alloca.
    string:slot = "";
    bool:framed = false;
    string:ffl = "";
    if (x.fe.is_async) {
        if (raw exprtypes_crossing(x.et, sid.index)) {
            int32:cidx = raw fnem_cross_find(x.fe, sid.index, 0i32);
            if (cidx < 0i32) {
                // The pre-scan frames every crossing value-pick local (the
                // probe that retired this rung proved it); a missing slot is
                // the scan broken, not a rung (1.1.13-close).
                pass (raw iv_broken(s.span));
            }
            slot = raw fnem_cross_gep(x.fe, cidx);
            // The FLAG slot beside it (D-183, 1.2.4b) — non-empty exactly
            // when this decl's type owns; the walk widened owning locals to
            // the function's end, so an owning decl in a suspending function
            // is here, framed, and its flag byte crosses with its value.
            ffl = raw fnem_cross_fgep(x.fe, cidx);
            framed = true;
        }
    }
    if (!framed) {
        slot = raw irw_temp(x.fe.w);
        drop irw_alloca(x.fe.w, slot, ll.text);
    }
    ExprId:init = raw stmt_decl_init(x.ast, s);
    if (!(raw expr_is_none(init))) {
        IrVal:v = raw emit_expr(x, init);
        if (!(raw iv_is_ok(v))) { pass v; }
        // THE VALUE IS FIT TO THE SLOT, NOT STORED (1.0.5c, generalised at
        // 1.0.6e). A concrete value bound to a `dyn` is widened into a fat
        // pointer; storing it wrote 4 bytes into a 16-byte slot and left the
        // vtable word uninitialised — which read back as a plausible answer
        // rather than a crash. 1.0.5c did this here and nowhere else; `emit_fit`
        // is the one place now, and this is one of its sites.
        v = raw emit_fit(x, dty, move(v), s.span);
        if (!(raw iv_is_ok(v))) { pass v; }
        drop irw_line(x.fe.w, raw cat5("store ", v.ll, " ", v.ref,
                          raw string_concat(", ptr ", slot)));
    }
    drop fnem_bind(x.fe, raw stmt_name(s), raw string_concat(slot, ""), dty);
    // THE DROP FLAG (D-183, 1.2.3; frame-resident half at 1.2.4b): one bit
    // beside every OWNING local, live when the binding holds a value, cleared
    // by `move` and by `pass`, tested at the scope-exit drop. An
    // uninitialised declaration starts dead and its first assignment brings
    // it live. A FRAMED local's flag is the frame byte `fnem_open_async`
    // reserved beside its slot — an alloca would die between `resume` calls;
    // a non-framed local in a coroutine is one the widened suspend walk
    // proved suspension-free to the function's end, so its alloca flag and
    // every read of it sit inside one resume call.
    if (raw type_drops(x.fe.ctx.types, dty, 64i32)) {
        string:seed = "store i8 0, ptr ";
        if (!(raw expr_is_none(init))) { seed = "store i8 1, ptr "; }
        if (ffl.len > 0i64) {
            drop irw_line(x.fe.w, raw cat3(seed, ffl, ""));
            drop fnem_flag_last(x.fe, move(ffl));
        } else {
            string:dfl = raw irw_temp(x.fe.w);
            drop irw_alloca(x.fe.w, dfl, "i8");
            drop irw_line(x.fe.w, raw cat3(seed, dfl, ""));
            drop fnem_flag_last(x.fe, move(dfl));
        }
    }
    pass (raw iv_nil());
};

// CLEAR THE DROP FLAG AT A PLACE'S ROOT (D-183, 1.2.3) — the emitter's half
// of `move` and of `pass`'s implicit move. D-065 invalidates the WHOLE
// binding on any move rooted at it, so the flag clears for `x` and
// `x.f` alike; the sibling-leak that field granularity would fix is the
// partial-move item recorded open on D-183. A root that is not a flagged
// local — a pointer parameter, a global, a temporary — clears nothing.
pub func:clear_root_flag = NIL(ExprEmitter->:x, ExprId:vid) never fails {
    if (raw expr_is_none(vid)) { pass NIL; }
    PlaceRoot:r = raw place_root(x.ast, vid, raw BORROW_FUEL());
    if (r.exhausted) { pass NIL; }
    if (raw expr_is_none(r.id)) { pass NIL; }
    ExprNode:rn = raw ast_expr(x.ast, r.id);
    if (rn.kind != ExprKind.ExprIdentifierExpr) { pass NIL; }
    int32:li = raw fnem_lookup_idx(x.fe, rn.payload =>! int32);
    if (li < 0i32) { pass NIL; }
    string->:fl = raw fnem_local_flag_at(x.fe, li);
    if (fl.len == 0i64) { pass NIL; }
    drop irw_line(x.fe.w, raw cat3("store i8 0, ptr ", <-fl, ""));
    pass NIL;
};

func:compound_op = TokenKind(TokenKind:k) never fails {
    if (k == TokenKind.OpPlusAssign)    { pass TokenKind.OpPlus; }
    if (k == TokenKind.OpMinusAssign)   { pass TokenKind.OpMinus; }
    if (k == TokenKind.OpStarAssign)    { pass TokenKind.OpStar; }
    if (k == TokenKind.OpSlashAssign)   { pass TokenKind.OpSlash; }
    if (k == TokenKind.OpPercentAssign) { pass TokenKind.OpPercent; }
    if (k == TokenKind.OpAmpAssign)     { pass TokenKind.OpAmp; }
    if (k == TokenKind.OpPipeAssign)    { pass TokenKind.OpPipe; }
    if (k == TokenKind.OpCaretAssign)   { pass TokenKind.OpCaret; }
    if (k == TokenKind.OpShlAssign)     { pass TokenKind.OpShl; }
    if (k == TokenKind.OpShrAssign)     { pass TokenKind.OpShr; }
    pass TokenKind.OpAssign;
};

func:emit_assign = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    // A PLACE, whatever shape it takes: a name's slot, a field through layout,
    // an element through a bound, a pointee through `<-` (0.7.7).
    PlaceVal:place = raw addr_of(x, raw stmt_target(s));
    if (place.state != (raw LL_OK())) { pass (raw iv_from_place(move(place))); }
    LlType:ll = raw ll_type(x.fe.ctx, place.type_id);
    if (!(raw ll_is_ok(ll))) {
        pass (raw iv_from_ll_at(x, ll, place.type_id, s.span));
    }

    TokenKind:op = raw stmt_op(s);
    if (op == TokenKind.OpAssign) {
        IrVal:v = raw emit_expr(x, raw stmt_assigned(s));
        if (!(raw iv_is_ok(v))) { pass v; }
        // FIT TO THE PLACE'S TYPE (1.0.6e). This is the site that segfaulted:
        // `q = c;` with `q` a `dyn` stored the 4-byte `Cat` over the fat
        // pointer and dispatched through the remains.
        v = raw emit_fit(x, place.type_id, move(v), s.span);
        if (!(raw iv_is_ok(v))) { pass v; }
        // OVERWRITING AN OWNED VALUE RELEASES IT FIRST (D-183, 1.2.3): the
        // RHS is already computed — `s = string_concat(s, "x")` has loaned
        // the old body and finished with it — so the old value's drop sits
        // between evaluation and the store. A FLAGGED whole-local target
        // guards its drop with the flag; a pointer target is somebody
        // else's value and is left alone.
        //
        // A FIELD OR MANAGED-ELEMENT TARGET DROPS UNCONDITIONALLY (D-186,
        // closing D-183's partial-place item): a live struct's fields are
        // always live — construction fills every field and partial moves do
        // not exist — and a managed array's elements likewise, so no flag
        // is needed. The prelude's own streams exposed the leak:
        // `tr.acc = string_slice(tr.acc, …)` left the old body behind on
        // every refill. A `wild` pointee stays the manual regime's;
        // elements reached through a pointer base are exempt.
        string:aflag = "";
        {
            ExprNode:tgt = raw ast_expr(x.ast, raw stmt_target(s));
            bool:tgt_drops_old = false;
            if (tgt.kind == ExprKind.ExprMemberAccessExpr) {
                if (raw type_drops(x.fe.ctx.types, place.type_id, 64i32)) {
                    // through a pointer receiver or a plain place alike: the
                    // field belongs to the struct, and the struct's owner is
                    // exactly who is overwriting it.
                    tgt_drops_old = true;
                }
            }
            if (tgt.kind == ExprKind.ExprIndexExpr) {
                if (raw type_drops(x.fe.ctx.types, place.type_id, 64i32)) {
                    int32:ibase = raw exprtypes_get(x.et, raw expr_operand(tgt));
                    int32:ibk = raw type_kind(x.fe.ctx.types, ibase);
                    if (ibk == (raw TY_ARRAY())) { tgt_drops_old = true; }
                }
            }
            if (tgt_drops_old) {
                drop irw_line(x.fe.w, raw cat4("call void ",
                                  raw drop_fn_sym(x.fe.ctx, place.type_id),
                                  raw string_concat("(ptr ", place.addr), ")"));
            }
            if (tgt.kind == ExprKind.ExprIdentifierExpr) {
                int32:tli = raw fnem_lookup_idx(x.fe, tgt.payload =>! int32);
                if (tli >= 0i32) {
                    string->:tfl = raw fnem_local_flag_at(x.fe, tli);
                    if (tfl.len > 0i64) {
                        aflag = raw string_concat(<-tfl, "");
                        string:of = raw irw_temp(x.fe.w);
                        drop irw_line(x.fe.w, raw cat4(of, " = load i8, ptr ",
                                          aflag, ""));
                        string:ob = raw irw_temp(x.fe.w);
                        drop irw_line(x.fe.w, raw cat3(ob, " = icmp ne i8 ",
                                          raw string_concat(of, ", 0")));
                        string:dl = raw irw_new_label(x.fe.w, "old.drop");
                        string:kl = raw irw_new_label(x.fe.w, "old.kept");
                        drop irw_line(x.fe.w, raw cat5("br i1 ", ob, ", label %",
                                          dl, raw string_concat(", label %", kl)));
                        drop s_start(x, dl);
                        drop irw_line(x.fe.w, raw cat4("call void ",
                                          raw drop_fn_sym(x.fe.ctx, place.type_id),
                                          raw string_concat("(ptr ", place.addr), ")"));
                        drop s_br(x, kl);
                        drop s_start(x, kl);
                    }
                }
            }
        }
        drop irw_line(x.fe.w, raw cat5("store ", v.ll, " ", v.ref,
                          raw string_concat(", ptr ", place.addr)));
        if (aflag.len > 0i64) {
            drop irw_line(x.fe.w, raw cat3("store i8 1, ptr ", aflag, ""));
        }
        pass (raw iv_nil());
    }

    // `x += e` is a load, the operation, a store — the seed's shape. Signedness
    // for `/`, `%`, `>>` comes from the TARGET's type, which the checker made
    // the value's type too.
    bool:signed = false;
    if ((raw type_kind(x.fe.ctx.types, place.type_id)) == (raw TY_INT())) {
        signed = raw type_is_signed(x.fe.ctx.types, place.type_id);
    }
    string:cur = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cur, " = load ", ll.text, ", ptr ",
                                     place.addr));
    IrVal:v = raw emit_expr(x, raw stmt_assigned(s));
    if (!(raw iv_is_ok(v))) { pass v; }
    string:ins = raw arith_name(raw compound_op(op), signed);
    if (ins.len == 0i64) { pass (raw iv_broken(s.span)); }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = ", ins, " ",
                      raw cat5(ll.text, " ", cur, ", ", v.ref)));
    drop irw_line(x.fe.w, raw cat5("store ", ll.text, " ", r,
                      raw string_concat(", ptr ", place.addr)));
    pass (raw iv_nil());
};

// --- control flow -------------------------------------------------------------------

func:emit_if = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    string:then_l = raw irw_new_label(x.fe.w, "if.then");
    string:done_l = raw irw_new_label(x.fe.w, "if.done");
    string:else_l = raw string_concat(done_l, "");
    bool:has_else = !(raw stmt_is_none(raw stmt_else(s)));
    if (has_else) { else_l = raw irw_new_label(x.fe.w, "if.else"); }

    IrVal:c = raw emit_cond(x, raw stmt_cond(s));
    if (!(raw iv_is_ok(c))) { pass c; }
    drop irw_line(x.fe.w, raw cat5("br i1 ", c.ref, ", label %", then_l,
                      raw string_concat(", label %", else_l)));
    x.fe.terminated = true;

    drop s_start(x, then_l);
    IrVal:t = raw emit_stmt(x, raw stmt_then(s));
    if (!(raw iv_is_ok(t))) { pass t; }
    drop s_br(x, done_l);

    if (has_else) {
        drop s_start(x, else_l);
        IrVal:e = raw emit_stmt(x, raw stmt_else(s));
        if (!(raw iv_is_ok(e))) { pass e; }
        drop s_br(x, done_l);
    }
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// An operand as an i64 — the loop machinery's working width; narrower counters
// sign-extend.
func:loop_i64 = string(ExprEmitter->:x, IrVal:v) never fails {
    // cloned, not passed through: the parameter is lent (D-183)
    if (raw string_eq(v.ll, "i64")) { pass (raw string_concat(v.ref, "")); }
    string:w = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(w, " = sext ", v.ll, " ",
                      raw string_concat(v.ref, " to i64")));
    pass w;
};

// `loop(start, limit, step)` / `till(limit, step)` (0.9.7, D-022): DIRECTION
// IS INFERRED FROM THE BOUNDS — ascending runs `$ < limit`, descending
// `$ > limit` — and `step` only sizes the jump. A non-positive step is refused
// at compile time where it is a literal; otherwise it TRAPS (BAD_STEP, -4101),
// the runtime fallback D-022 specifies, because a zero step cannot terminate
// and a negative one contradicts bounds it cannot see.
func:emit_counted = IrVal(ExprEmitter->:x, StmtNode:s, StmtId:sid,
                          bool:is_till) never fails {
    VerifyId:cinv = raw stmt_counted_invariant(x.ast, s);
    if (!(raw verify_is_none(cinv))) {
        pass (raw iv_rung("a loop `invariant`", "1.5", s.span));
    }
    string:sv = "0";
    int32:base = 0i32;
    if (!is_till) {
        IrVal:s0 = raw emit_expr(x, raw stmt_counted_arg(x.ast, s, 0i32));
        if (!(raw iv_is_ok(s0))) { pass s0; }
        sv = raw loop_i64(x, s0);
        base = 1i32;
    }
    IrVal:l0 = raw emit_expr(x, raw stmt_counted_arg(x.ast, s, base));
    if (!(raw iv_is_ok(l0))) { pass l0; }
    string:lv = raw loop_i64(x, l0);
    IrVal:p0 = raw emit_expr(x, raw stmt_counted_arg(x.ast, s, base + 1i32));
    if (!(raw iv_is_ok(p0))) { pass p0; }
    string:pv = raw loop_i64(x, p0);

    string:bad = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(bad, " = icmp sle i64 ",
                      raw string_concat(pv, ", 0")));
    string:trap_l = raw irw_new_label(x.fe.w, "ct.step");
    string:go_l = raw irw_new_label(x.fe.w, "ct.go");
    drop irw_line(x.fe.w, raw cat5("br i1 ", bad, ", label %", trap_l,
                      raw string_concat(", label %", go_l)));
    drop irw_label(x.fe.w, trap_l);
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4101)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, go_l);

    string:slot = raw loop_slot(x, sid, 1i32, "i64");
    if (slot.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop irw_line(x.fe.w, raw cat5("store i64 ", sv, ", ptr ", slot, ""));
    // The limit, the step and the direction persist across iterations — and
    // in a coroutine, across suspensions — so they live in slots, re-read
    // where used, never carried as SSA values into a later segment.
    string:lv_s = raw loop_slot(x, sid, 2i32, "i64");
    if (lv_s.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop loop_stash(x, lv_s, "i64", lv);
    string:pv_s = raw loop_slot(x, sid, 5i32, "i64");
    if (pv_s.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop loop_stash(x, pv_s, "i64", pv);
    string:asc0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(asc0, " = icmp slt i64 ", sv, ", ", lv));
    string:ascb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(ascb, " = zext i1 ",
                      raw string_concat(asc0, " to i8")));
    string:asc_s = raw loop_slot(x, sid, 6i32, "i8");
    if (asc_s.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop loop_stash(x, asc_s, "i8", ascb);

    string:head_l = raw irw_new_label(x.fe.w, "ct.head");
    string:body_l = raw irw_new_label(x.fe.w, "ct.body");
    string:incr_l = raw irw_new_label(x.fe.w, "ct.incr");
    string:done_l = raw irw_new_label(x.fe.w, "ct.done");
    drop s_br(x, head_l);
    drop s_start(x, head_l);
    string:cur = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cur, " = load i64, ptr ", slot, "", ""));
    string:lvh = raw loop_reread(x, lv_s, "i64");
    string:ascw = raw loop_reread(x, asc_s, "i8");
    string:asch = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(asch, " = trunc i8 ",
                      raw string_concat(ascw, " to i1")));
    string:up = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(up, " = icmp slt i64 ", cur, ", ", lvh));
    string:down = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(down, " = icmp sgt i64 ", cur, ", ", lvh));
    string:cond = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cond, " = select i1 ", asch, ", ",
                      raw cat5("i1 ", up, ", i1 ", down, "")));
    drop irw_line(x.fe.w, raw cat5("br i1 ", cond, ", label %", body_l,
                      raw string_concat(", label %", done_l)));
    x.fe.terminated = true;

    drop s_start(x, body_l);
    // `continue` re-enters at the INCREMENT, or the counter would never move.
    drop fnem_loop_push(x.fe, raw string_concat(incr_l, ""), raw string_concat(done_l, ""), raw stmt_label(s), raw string_concat(slot, ""));
    IrVal:b = raw emit_block(x, raw stmt_counted_body(s));
    drop fnem_loop_pop(x.fe);
    if (!(raw iv_is_ok(b))) { pass b; }
    drop s_br(x, incr_l);
    drop s_start(x, incr_l);
    string:c2 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(c2, " = load i64, ptr ", slot, "", ""));
    string:pvi = raw loop_reread(x, pv_s, "i64");
    string:ascw2 = raw loop_reread(x, asc_s, "i8");
    string:asci = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(asci, " = trunc i8 ",
                      raw string_concat(ascw2, " to i1")));
    string:nup = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(nup, " = add i64 ", c2, ", ", pvi));
    string:ndown = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(ndown, " = sub i64 ", c2, ", ", pvi));
    string:nxt = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(nxt, " = select i1 ", asci, ", ",
                      raw cat5("i64 ", nup, ", i64 ", ndown, "")));
    drop irw_line(x.fe.w, raw cat5("store i64 ", nxt, ", ptr ", slot, ""));
    drop s_br(x, head_l);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// `when (cond) { } then { } end { }` (0.9.7, D-027): a while that TRACKS
// whether its body ever ran. `then` runs when it did — including a `break`
// exit, which lands at the same junction — and `end` only when the condition
// was false from the start. One flag, one junction, never both clauses.
func:emit_when = IrVal(ExprEmitter->:x, StmtNode:s, StmtId:sid) never fails {
    VerifyId:winv = raw stmt_when_invariant(x.ast, s);
    if (!(raw verify_is_none(winv))) {
        pass (raw iv_rung("a loop `invariant`", "1.5", s.span));
    }
    string:flag = raw loop_slot(x, sid, 1i32, "i8");
    if (flag.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop irw_line(x.fe.w, raw cat3("store i8 0, ptr ", flag, ""));

    string:head_l = raw irw_new_label(x.fe.w, "wn.head");
    string:body_l = raw irw_new_label(x.fe.w, "wn.body");
    string:junc_l = raw irw_new_label(x.fe.w, "wn.junc");
    string:then_l = raw irw_new_label(x.fe.w, "wn.then");
    string:end_l = raw irw_new_label(x.fe.w, "wn.end");
    string:done_l = raw irw_new_label(x.fe.w, "wn.done");

    drop s_br(x, head_l);
    drop s_start(x, head_l);
    IrVal:c = raw emit_cond(x, raw stmt_cond(s));
    if (!(raw iv_is_ok(c))) { pass c; }
    drop irw_line(x.fe.w, raw cat5("br i1 ", c.ref, ", label %", body_l,
                      raw string_concat(", label %", junc_l)));
    x.fe.terminated = true;

    drop s_start(x, body_l);
    drop irw_line(x.fe.w, raw cat3("store i8 1, ptr ", flag, ""));
    drop fnem_loop_push(x.fe, raw string_concat(head_l, ""), raw string_concat(junc_l, ""), raw stmt_label(s), "");
    IrVal:b = raw emit_block(x, raw stmt_when_body(x.ast, s));
    drop fnem_loop_pop(x.fe);
    if (!(raw iv_is_ok(b))) { pass b; }
    drop s_br(x, head_l);

    drop s_start(x, junc_l);
    string:ran = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(ran, " = load i8, ptr ", flag, "", ""));
    string:rb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(rb, " = icmp ne i8 ",
                      raw string_concat(ran, ", 0")));
    drop irw_line(x.fe.w, raw cat5("br i1 ", rb, ", label %", then_l,
                      raw string_concat(", label %", end_l)));
    x.fe.terminated = true;

    drop s_start(x, then_l);
    StmtId:tb = raw stmt_when_then(x.ast, s);
    if (tb.index != 0i32) {
        IrVal:tv = raw emit_stmt(x, tb);
        if (!(raw iv_is_ok(tv))) { pass tv; }
    }
    drop s_br(x, done_l);
    drop s_start(x, end_l);
    StmtId:eb = raw stmt_when_end(x.ast, s);
    if (eb.index != 0i32) {
        IrVal:ev = raw emit_stmt(x, eb);
        if (!(raw iv_is_ok(ev))) { pass ev; }
    }
    drop s_br(x, done_l);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// `for (T:x in iterable)` (0.9.7): a range walks its half-open span with the
// BINDING as the value; a slice or array walks its elements by index, copying
// each into the binding — a value per iteration, exactly what a binding is.
func:emit_for = IrVal(ExprEmitter->:x, StmtNode:s, StmtId:sid) never fails {
    VerifyId:finv = raw stmt_for_invariant(x.ast, s);
    if (!(raw verify_is_none(finv))) {
        pass (raw iv_rung("a loop `invariant`", "1.5", s.span));
    }
    ExprId:iter = raw stmt_for_iter(x.ast, s);
    int32:itid = raw exprtypes_get(x.et, iter);
    int32:ikind = raw type_kind(x.fe.ctx.types, itid);
    DeclNode:bind = raw ast_decl(x.ast, raw stmt_for_binding(s));
    int32:btid = raw resolve_type(x.tr, raw param_type(bind), x.scope);
    LlType:bll = raw ll_type(x.fe.ctx, btid);
    if (!(raw ll_is_ok(bll))) { pass (raw iv_from_ll_at(x, bll, btid, s.span)); }

    if (ikind == (raw TY_RANGE())) {
        IrVal:rv = raw emit_expr(x, iter);
        if (!(raw iv_is_ok(rv))) { pass rv; }
        string:lo = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(lo, " = extractvalue ", rv.ll, " ",
                          raw string_concat(rv.ref, ", 0")));
        string:hi0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(hi0, " = extractvalue ", rv.ll, " ",
                          raw string_concat(rv.ref, ", 1")));
        string:hi_s = raw loop_slot(x, sid, 2i32, bll.text);
        if (hi_s.len == 0i64) { pass (raw iv_broken(s.span)); }
        drop loop_stash(x, hi_s, bll.text, hi0);
        string:slot = raw for_bind_slot(x, sid, bind, btid, bll);
        drop irw_line(x.fe.w, raw cat5("store ", bll.text, " ", lo,
                          raw string_concat(", ptr ", slot)));
        string:head_l = raw irw_new_label(x.fe.w, "fr.head");
        string:body_l = raw irw_new_label(x.fe.w, "fr.body");
        string:incr_l = raw irw_new_label(x.fe.w, "fr.incr");
        string:done_l = raw irw_new_label(x.fe.w, "fr.done");
        drop s_br(x, head_l);
        drop s_start(x, head_l);
        string:cur = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(cur, " = load ", bll.text, ", ptr ",
                          raw string_concat(slot, "")));
        string:hih = raw loop_reread(x, hi_s, bll.text);
        string:cnd = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(cnd, " = icmp slt ", bll.text, " ",
                          raw cat3(cur, ", ", hih)));
        drop irw_line(x.fe.w, raw cat5("br i1 ", cnd, ", label %", body_l,
                          raw string_concat(", label %", done_l)));
        x.fe.terminated = true;
        drop s_start(x, body_l);
        drop fnem_loop_push(x.fe, raw string_concat(incr_l, ""), raw string_concat(done_l, ""), raw stmt_label(s), "");
        IrVal:b = raw emit_stmt(x, raw stmt_for_body(x.ast, s));
        drop fnem_loop_pop(x.fe);
        if (!(raw iv_is_ok(b))) { pass b; }
        drop s_br(x, incr_l);
        drop s_start(x, incr_l);
        string:c2 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(c2, " = load ", bll.text, ", ptr ",
                          raw string_concat(slot, "")));
        string:nx = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(nx, " = add ", bll.text, " ",
                          raw string_concat(c2, ", 1")));
        drop irw_line(x.fe.w, raw cat5("store ", bll.text, " ", nx,
                          raw string_concat(", ptr ", slot)));
        drop s_br(x, head_l);
        drop s_start(x, done_l);
        pass (raw iv_nil());
    }

    if (ikind == (raw TY_SLICE())) {
        pass (raw emit_for_indexed(x, s, sid, iter, bind, btid, bll, false));
    }
    if (ikind == (raw TY_ARRAY())) {
        pass (raw emit_for_indexed(x, s, sid, iter, bind, btid, bll, true));
    }
    if (ikind == (raw TY_POINTER())) {
        pass (raw emit_for_iterator(x, s, sid, iter, itid, bind, btid, bll));
    }
    if (raw iterator_impl_of(x, itid) != 0i32) {
        pass (raw emit_for_iterator(x, s, sid, iter, itid, bind, btid, bll));
    }
    // UNREACHABLE. The five arms above -- range, slice, array, pointer, and an
    // `Iterator` implementor -- are exactly the set `check_for` (D-166) admits;
    // everything else it refuses with `TYPE_NOT_ITERABLE` before the backend.
    pass (raw iv_broken(s.span));
};

// The `for` binding's slot: the frame slot in a coroutine (bound through the
// same scope stack, so shadowing behaves), an ordinary local otherwise.
func:for_bind_slot = string(ExprEmitter->:x, StmtId:sid, DeclNode:bind,
                            int32:btid, LlType:bll) never fails {
    if (x.fe.is_async) {
        int32:ci = raw fnem_cross_find(x.fe, sid.index, 4i32);
        if (ci >= 0i32) {
            string:g = raw fnem_cross_gep(x.fe, ci);
            drop fnem_bind(x.fe, raw decl_name(bind), raw string_concat(g, ""), btid);
            pass g;
        }
    }
    pass (raw fnem_local(x.fe, raw decl_name(bind), btid, bll.text));
};

// The impl of the prelude `Iterator` for `it1` (0 for none): a non-blanket impl
// whose target is `it1` and whose trait is `Iterator`. Its `.decl` is the impl,
// `.trait_id` the interned `Iterator` type the method symbol is named under.
func:iterator_impl_of = int32(ExprEmitter->:x, int32:itid) never fails {
    int32:it1 = itid;
    if ((raw type_kind(x.fe.ctx.types, itid)) == (raw TY_POINTER())) {
        it1 = raw type_elem(x.fe.ctx.types, itid);
    }
    int32:iter_sym = raw scope_lookup(x.tab, x.scope,
                         raw intern_add(x.interns, "Iterator"));
    if (iter_sym == 0i32) { pass 0i32; }
    Symbol:isym = raw symtab_get(x.tab, iter_sym);
    if (isym.origin_kind != (raw SYM_DECL())) { pass 0i32; }
    int32:i = 0i32;
    while (i < (raw impl_count(x.fe.ctx.impls))) {
        ImplEntry:e = raw impl_at(x.fe.ctx.impls, i);
        if (!e.blanket) {
            if (e.target == it1) {
                if ((raw type_decl_of(x.fe.ctx.types, e.trait_id))
                        == isym.origin) {
                    pass (i + 1i32);
                }
            }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// `for (T:x in it)` OVER AN `Iterator` (D-166, 1.0.9d): call `next(@it)` until it
// yields `NIL`. `next`'s receiver is `Self->`, so the iterable's ADDRESS is the
// argument — its own when the loop is over a pointer, its place otherwise. The
// call returns `Result<Item?>`; the loop reads the `Optional` out of the Result
// (its value word), ends on the empty tag, and binds the value word otherwise.
// `continue` re-calls `next` (head), `break` leaves (done).
func:emit_for_iterator = IrVal(ExprEmitter->:x, StmtNode:s, StmtId:sid,
                               ExprId:iter, int32:itid, DeclNode:bind,
                               int32:btid, LlType:bll) never fails {
    int32:idx = raw iterator_impl_of(x, itid);
    if (idx == 0i32) { pass (raw iv_broken(s.span)); }
    ImplEntry:e = raw impl_at(x.fe.ctx.impls, idx - 1i32);

    int32:it1 = itid;
    string:recv = "";
    if ((raw type_kind(x.fe.ctx.types, itid)) == (raw TY_POINTER())) {
        it1 = raw type_elem(x.fe.ctx.types, itid);
        IrVal:pv = raw emit_expr(x, iter);
        if (!(raw iv_is_ok(pv))) { pass pv; }
        recv = move(pv.ref);
    } else {
        PlaceVal:apv = raw addr_of(x, iter);
        if (apv.state != (raw LL_OK())) { pass (raw iv_from_place(move(apv))); }
        recv = move(apv.addr);
    }

    // The impl's `next` method and its D-156 symbol.
    DeclNode:idecl = raw ast_decl(x.ast, DeclId{ index: e.decl });
    int32:next_name = raw intern_add(x.interns, "next");
    int32:next_decl = 0i32;
    int32:mi = 0i32;
    while (mi < (raw impl_member_count(x.ast, idecl))) {
        DeclId:mid = raw impl_member(x.ast, idecl, mi);
        DeclNode:m = raw ast_decl(x.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if ((raw decl_name(m)) == next_name) { next_decl = mid.index; }
        }
        mi = mi + 1i32;
    }
    if (next_decl == 0i32) { pass (raw iv_broken(s.span)); }
    string:sym = raw mangled_fn_sym(x.fe.ctx, next_decl,
                     raw method_symbol_name(x.fe.ctx.types, x.interns, it1,
                         e.trait_id, "next"));

    // `next`'s return: `Result<Optional<Item>>`, and `Item` is the binding type
    // (the checker held them equal, D-166).
    int32:opt_tid = raw tt_optional(x.fe.ctx.types, btid,
                        raw type_size(x.fe.ctx.types, btid),
                        raw type_align(x.fe.ctx.types, btid));
    int32:ret_tid = raw tt_result(x.fe.ctx.types, opt_tid,
                        raw type_size(x.fe.ctx.types, opt_tid),
                        raw type_align(x.fe.ctx.types, opt_tid));
    LlType:ret_ll = raw ll_type(x.fe.ctx, ret_tid);
    if (!(raw ll_is_ok(ret_ll))) { pass (raw iv_from_ll_at(x, ret_ll, ret_tid, s.span)); }
    LlType:opt_ll = raw ll_type(x.fe.ctx, opt_tid);
    if (!(raw ll_is_ok(opt_ll))) { pass (raw iv_from_ll_at(x, opt_ll, opt_tid, s.span)); }

    // The receiver's address persists across iterations — a slot (D2).
    string:recv_s = raw loop_slot(x, sid, 3i32, "ptr");
    if (recv_s.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop loop_stash(x, recv_s, "ptr", recv);
    string:slot = raw for_bind_slot(x, sid, bind, btid, bll);
    string:head_l = raw irw_new_label(x.fe.w, "fi.head");
    string:body_l = raw irw_new_label(x.fe.w, "fi.body");
    string:done_l = raw irw_new_label(x.fe.w, "fi.done");
    drop s_br(x, head_l);
    drop s_start(x, head_l);
    string:recvh = raw loop_reread(x, recv_s, "ptr");
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret_ll.text, " ",
                      raw cat5(sym, "(ptr ", recvh, ")", "")));
    string:opt = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(opt, " = extractvalue ", ret_ll.text, " ",
                      raw string_concat(r, ", 0")));
    string:tag = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(tag, " = extractvalue ", opt_ll.text, " ",
                      raw string_concat(opt, ", 0")));
    string:empty = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(empty, " = icmp eq i8 ",
                      raw string_concat(tag, ", 0")));
    drop irw_line(x.fe.w, raw cat5("br i1 ", empty, ", label %", done_l,
                      raw string_concat(", label %", body_l)));
    x.fe.terminated = true;
    drop s_start(x, body_l);
    string:val = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(val, " = extractvalue ", opt_ll.text, " ",
                      raw string_concat(opt, ", 1")));
    drop irw_line(x.fe.w, raw cat5("store ", bll.text, " ", val,
                      raw string_concat(", ptr ", slot)));
    drop fnem_loop_push(x.fe, raw string_concat(head_l, ""), raw string_concat(done_l, ""), raw stmt_label(s), "");
    IrVal:b = raw emit_stmt(x, raw stmt_for_body(x.ast, s));
    drop fnem_loop_pop(x.fe);
    if (!(raw iv_is_ok(b))) { pass b; }
    drop s_br(x, head_l);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// The slice/array half: index 0..len, element copied into the binding.
func:emit_for_indexed = IrVal(ExprEmitter->:x, StmtNode:s, StmtId:sid,
                              ExprId:iter, DeclNode:bind, int32:btid,
                              LlType:bll, bool:is_array) never fails {
    string:base = "";
    string:len = "";
    int32:itid = raw exprtypes_get(x.et, iter);
    if (is_array) {
        PlaceVal:pv2 = raw addr_of(x, iter);
        if (pv2.state != (raw LL_OK())) { pass (raw iv_from_place(move(pv2))); }
        base = move(pv2.addr);
        len = raw int_to_string(
            (raw type_array_count(x.fe.ctx.types, itid)) => int64);
    } else {
        IrVal:sv = raw emit_expr(x, iter);
        if (!(raw iv_is_ok(sv))) { pass sv; }
        string:d = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(d, " = extractvalue ", sv.ll, " ",
                          raw string_concat(sv.ref, ", 0")));
        base = move(d);
        string:l2 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(l2, " = extractvalue ", sv.ll, " ",
                          raw string_concat(sv.ref, ", 1")));
        len = move(l2);
    }
    // Base and length persist across iterations — slots, not SSA (D2).
    string:base_s = raw loop_slot(x, sid, 3i32, "ptr");
    if (base_s.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop loop_stash(x, base_s, "ptr", base);
    string:len_s = raw loop_slot(x, sid, 2i32, "i64");
    if (len_s.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop loop_stash(x, len_s, "i64", len);
    string:idx = raw loop_slot(x, sid, 1i32, "i64");
    if (idx.len == 0i64) { pass (raw iv_broken(s.span)); }
    drop irw_line(x.fe.w, raw cat3("store i64 0, ptr ", idx, ""));
    string:slot = raw for_bind_slot(x, sid, bind, btid, bll);
    string:head_l = raw irw_new_label(x.fe.w, "fe.head");
    string:body_l = raw irw_new_label(x.fe.w, "fe.body");
    string:incr_l = raw irw_new_label(x.fe.w, "fe.incr");
    string:done_l = raw irw_new_label(x.fe.w, "fe.done");
    drop s_br(x, head_l);
    drop s_start(x, head_l);
    string:cur = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cur, " = load i64, ptr ", idx, "", ""));
    string:lenh = raw loop_reread(x, len_s, "i64");
    string:cnd = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cnd, " = icmp ult i64 ", cur, ", ", lenh));
    drop irw_line(x.fe.w, raw cat5("br i1 ", cnd, ", label %", body_l,
                      raw string_concat(", label %", done_l)));
    x.fe.terminated = true;
    drop s_start(x, body_l);
    string:baseh = raw loop_reread(x, base_s, "ptr");
    string:ep = raw irw_temp(x.fe.w);
    if (is_array) {
        LlType:all = raw ll_type(x.fe.ctx, itid);
        if (!(raw ll_is_ok(all))) { pass (raw iv_broken(s.span)); }
        drop irw_line(x.fe.w, raw cat5(ep, " = getelementptr ", all.text,
                          ", ptr ", raw cat4(baseh, ", i64 0, i64 ", cur, "")));
    } else {
        drop irw_line(x.fe.w, raw cat5(ep, " = getelementptr ", bll.text,
                          ", ptr ", raw cat4(baseh, ", i64 ", cur, "")));
    }
    string:ev = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(ev, " = load ", bll.text, ", ptr ",
                      raw string_concat(ep, "")));
    drop irw_line(x.fe.w, raw cat5("store ", bll.text, " ", ev,
                      raw string_concat(", ptr ", slot)));
    drop fnem_loop_push(x.fe, raw string_concat(incr_l, ""), raw string_concat(done_l, ""), raw stmt_label(s), "");
    IrVal:b = raw emit_stmt(x, raw stmt_for_body(x.ast, s));
    drop fnem_loop_pop(x.fe);
    if (!(raw iv_is_ok(b))) { pass b; }
    drop s_br(x, incr_l);
    drop s_start(x, incr_l);
    string:c3 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(c3, " = load i64, ptr ", idx, "", ""));
    string:n3 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(n3, " = add i64 ",
                      raw string_concat(c3, ", 1")));
    drop irw_line(x.fe.w, raw cat5("store i64 ", n3, ", ptr ", idx, ""));
    drop s_br(x, head_l);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

func:emit_while = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    // LIVE-1 (0.9.0): an invariant the backend never read was an obligation
    // that silently vanished. Refused until 1.4 checks it.
    VerifyId:winv = raw stmt_while_invariant(x.ast, s);
    if (!(raw verify_is_none(winv))) {
        pass (raw iv_rung("a loop `invariant`", "1.5", s.span));
    }
    string:head_l = raw irw_new_label(x.fe.w, "wh.head");
    string:body_l = raw irw_new_label(x.fe.w, "wh.body");
    string:done_l = raw irw_new_label(x.fe.w, "wh.done");

    drop s_br(x, head_l);
    drop s_start(x, head_l);
    IrVal:c = raw emit_cond(x, raw stmt_cond(s));
    if (!(raw iv_is_ok(c))) { pass c; }
    drop irw_line(x.fe.w, raw cat5("br i1 ", c.ref, ", label %", body_l,
                      raw string_concat(", label %", done_l)));
    x.fe.terminated = true;

    drop s_start(x, body_l);
    drop fnem_loop_push(x.fe, raw string_concat(head_l, ""), raw string_concat(done_l, ""), raw stmt_label(s), "");
    IrVal:b = raw emit_block(x, raw stmt_body(x.ast, s));
    drop fnem_loop_pop(x.fe);
    if (!(raw iv_is_ok(b))) { pass b; }
    drop s_br(x, head_l);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// `break` and `continue` — ONE function, because the only difference is which
// label. Both run the defers of every scope between here and the loop first,
// which is the gap the seed recorded and this closes.
func:emit_break = IrVal(ExprEmitter->:x, StmtNode:s, bool:is_break) never fails {
    // LABELLED OR NOT, one mechanism (0.9.7): the label picks the loop frame,
    // and the defers of every scope between here and THAT frame run first —
    // exactly the unlabelled rule, aimed further out.
    int32:frame = raw fnem_loop_find(x.fe, raw stmt_label(s));
    if (frame < 0i32) { pass (raw iv_broken(s.span)); }
    IrVal:d = raw run_defers_down_to(x, raw fnem_loop_depth_at(x.fe, frame));
    if (!(raw iv_is_ok(d))) { pass d; }
    if (is_break) { drop s_br(x, raw fnem_loop_done_at(x.fe, frame)); }
    else          { drop s_br(x, raw fnem_loop_head_at(x.fe, frame)); }
    pass (raw iv_nil());
};

// --- exits --------------------------------------------------------------------------
//
// VALUE FIRST, THEN DEFERS, THEN THE RETURN (D-136) — for all three. The value a
// function passes is the value read AT the `pass`, whatever cleanup does after.

func:emit_pass = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    string:vref = "";
    ExprId:val = raw stmt_operand(s);
    if (!(raw expr_is_none(val))) {
        IrVal:v = raw emit_expr(x, val);
        if (!(raw iv_is_ok(v))) { pass v; }
        // THE DECLARED `T` IS A SLOT (1.0.6e): `pass d;` from a function
        // returning `dyn Speaks` builds the fat pointer here.
        v = raw emit_fit(x, x.fe.ret_type, move(v), s.span);
        if (!(raw iv_is_ok(v))) { pass v; }
        vref = move(v.ref);
        // `pass` MOVES IMPLICITLY (D-183): the value leaves the frame, so the
        // unwind below must not free the body it carries. Cleared BEFORE the
        // defers run, or the scope drop would release the returned value.
        drop clear_root_flag(x, val);
    }
    IrVal:d = raw run_all_defers(x);
    if (!(raw iv_is_ok(d))) { pass d; }
    drop fnem_ret_pass(x.fe, vref);
    x.fe.terminated = true;
    pass (raw iv_nil());
};

func:emit_fail = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    IrVal:v = raw emit_expr(x, raw stmt_operand(s));
    if (!(raw iv_is_ok(v))) { pass v; }
    IrVal:d = raw run_all_defers(x);
    if (!(raw iv_is_ok(d))) { pass d; }
    // THE ORIGIN (D-179): a fresh failure restarts the chain here.
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      raw int_to_string((raw x_site(x, s.span)) => int64), ")"));
    drop fnem_ret_fail(x.fe, v.ref);
    x.fe.terminated = true;
    pass (raw iv_nil());
};

func:emit_exit = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    IrVal:v = raw emit_expr(x, raw stmt_operand(s));
    if (!(raw iv_is_ok(v))) { pass v; }
    IrVal:d = raw run_exit_defers(x);
    if (!(raw iv_is_ok(d))) { pass d; }
    // `exit` is legal only in `main` and `failsafe` (D-013), and returning from
    // either IS process exit — so it lowers to a plain `ret`. In `async main`
    // the seam stores the code into the frame's result slot and the entry
    // shim returns it (D-177).
    drop fnem_ret_agg(x.fe, v.ref);
    x.fe.terminated = true;
    pass (raw iv_nil());
};

// A trap runs NO defers (D-014) — the omission is the decision: at trap time the
// state of the system is unknown, so no cleanup runs before the handler that
// understands the situation gets control. `failsafe`'s return value IS the
// process exit code.
func:emit_trap = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    IrVal:v = raw emit_expr(x, raw stmt_operand(s));
    if (!(raw iv_is_ok(v))) { pass v; }
    // `!!!` is an ORIGIN: the chain restarts at this site (D-179).
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      raw int_to_string((raw x_site(x, s.span)) => int64), ")"));
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(r, " = call i32 @npk_failsafe(i32 ",
                      raw string_concat(v.ref, ")")));
    drop irw_line(x.fe.w, raw cat3("call void @npk_exit(i32 ", r, ")"));
    drop irw_line(x.fe.w, "unreachable");
    x.fe.terminated = true;
    pass (raw iv_nil());
};

// `return Result{…}` — the one spelling of `return` (type_stmt refused every
// other), so the operand IS the whole Result and the `ret` takes it verbatim.
// Value first, then defers, then the return: D-136's rule, the third time.
func:emit_return = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    IrVal:v = raw emit_expr(x, raw stmt_operand(s));
    if (!(raw iv_is_ok(v))) { pass v; }
    IrVal:d = raw run_all_defers(x);
    if (!(raw iv_is_ok(d))) { pass d; }
    drop fnem_ret_agg(x.fe, v.ref);
    x.fe.terminated = true;
    pass (raw iv_nil());
};

// --- pick ---------------------------------------------------------------------------
//
// A `switch` OVER A DISCRIMINANT, which is the seed's shape: every subset-1
// pattern is a compile-time integer — a literal, or a variant's tag — so the
// dispatch is one instruction and the exhaustiveness the analyses proved (0.5)
// needs no runtime default of its own.

// "pk<seq>.arm<i>" — DERIVED arm-body labels, so `fall label;` computes its
// target from the pick frame's seq and the arm list instead of a stored table.
pub func:pk_label = string(int32:seq, int32:i) never fails {
    string:a = raw string_concat("pk", raw int_to_string(seq => int64));
    string:b = raw string_concat(a, ".arm");
    pass (raw string_concat(b, raw int_to_string(i => int64)));
};

func:pk_named = string(int32:seq, string:stem) never fails {
    string:a = raw string_concat("pk", raw int_to_string(seq => int64));
    pass (raw string_concat(a, stem));
};

// The integer constant an arm matches, as text — or a refusal.
func:pat_err_fnv = uint64(string:sv, uint64:h0) never fails {
    uint64:h = h0;
    int64:i = 0i64;
    while (i < sv.len) {
        h = ((h ^ ((sv.ptr[i] =>! uint64) & 255u64)) * 1099511628211u64);
        i = i + 1i64;
    }
    pass h;
};

func:pattern_const = IrVal(ExprEmitter->:x, PatNode:pn, int32:sel_tid, Span:at) never fails {
    // `(module.Name)` OVER AN `Error` SELECTOR (D-179): a two-segment,
    // bind-free "destructure" is the qualified spelling of an error
    // constant — segment 0 names the module, segment 1 the constant, and
    // the match value is its assigned code.
    if (pn.kind == PatKind.PatEnumDestructure) {
        if ((raw type_kind(x.fe.ctx.types, sel_tid)) == (raw TY_ERROR())) {
            if ((raw pat_enum_segment_count(x.ast, pn)) == 2i32) {
                if ((raw pat_enum_bind_count(x.ast, pn)) == 0i32) {
                    // THE CODE IS THE HASH (D-179): a user constant's value
                    // is derived from `module.Name`, so the qualified
                    // pattern needs no lookup and no import — the same
                    // FNV-1a the resolver and the seed compute, restated a
                    // third time under D-123's no-drift discipline.
                    uint64:h = raw pat_err_fnv(raw intern_get(x.interns,
                                   raw pat_enum_segment(x.ast, pn, 0i32)),
                                   ((3421887204u64 << 32u64) | 2216829733u64));
                    h = ((h ^ 46u64) * 1099511628211u64);
                    h = raw pat_err_fnv(raw intern_get(x.interns,
                            raw pat_enum_segment(x.ast, pn, 1i32)), h);
                    int32:pcode = ((h & 1073741822u64) =>! int32) + 1i32;
                    pass (raw iv("", raw int_to_string(pcode => int64), 0i32));
                }
            }
            pass (raw iv_broken(at));
        }
    }
    if (pn.kind == PatKind.PatValue) {
        ExprNode:vn = raw ast_expr(x.ast, raw pat_value(pn));
        if (vn.kind == ExprKind.ExprIntLiteral) {
            pass (raw iv("", raw int_to_string(vn.payload), 0i32));
        }
        if (vn.kind == ExprKind.ExprBoolLiteral) {
            if (vn.payload == 1i64) { pass (raw iv("", "1", 0i32)); }
            pass (raw iv("", "0", 0i32));
        }
        if (vn.kind == ExprKind.ExprCharLiteral) {
            pass (raw iv("", raw int_to_string(vn.payload), 0i32));
        }
        // A DECLARED ERROR CONSTANT is a compile-time integer too (D-179):
        // its assigned code, from the slot resolve wrote.
        if (vn.kind == ExprKind.ExprIdentifierExpr) {
            if (vn.a != 0i32) {
                Symbol:pes = raw symtab_get(x.tab, vn.a);
                if (pes.origin_kind == (raw SYM_DECL())) {
                    DeclNode:ped = raw ast_decl(x.ast, DeclId{ index: pes.origin });
                    if (ped.kind == DeclKind.DeclErrorDecl) {
                        pass (raw iv("", raw int_to_string(ped.c => int64), 0i32));
                    }
                }
            }
        }
        // `(Enum.Variant)` in pattern position — a tag, not a value to build.
        if (vn.kind == ExprKind.ExprMemberAccessExpr) {
            VariantInfo:vi = raw variant_info(x, sel_tid, vn.payload =>! int32);
            if (vi.found) {
                pass (raw iv("", raw int_to_string(vi.tag => int64), 0i32));
            }
        }
        // Every literal kind a pattern can legally hold has an arm above;
        // anything else is a walk hole, not a program mistake.
        pass (raw iv_broken(at));
    }
    if (pn.kind == PatKind.PatEnumDestructure) {
        int32:segs = raw pat_enum_segment_count(x.ast, pn);
        if (segs <= 0i32) { pass (raw iv_broken(at)); }
        VariantInfo:vi = raw variant_info(x, sel_tid,
                             raw pat_enum_segment(x.ast, pn, segs - 1i32));
        if (!vi.found) { pass (raw iv_broken(at)); }
        pass (raw iv("", raw int_to_string(vi.tag => int64), 0i32));
    }
    // A range pattern routes to the CHAIN dispatch before this runs (0.9.7);
    // reaching it here is a hole in the routing, not in the program.
    if (pn.kind == PatKind.PatRange) {
        pass (raw iv_broken(at));
    }
    // A STRUCT DESTRUCTURE NEVER REACHES `pattern_const` (1.0.9c): it is
    // irrefutable, so the chain sets its match to `true` before asking for a
    // constant. Reaching here is a routing defect, not a rung.
    if (pn.kind == PatKind.PatStructDestructure) {
        pass (raw iv_broken(at));
    }
    // `ERR:` matches the sentinel (0.9.5) — the pick's OWN compare, which is
    // deliberately unguarded: pick-with-ERR-arm is the sanctioned branch on a
    // taint (D-008 §5.1), the thing a bare `==` traps over.
    if (pn.kind == PatKind.PatErrPattern) {
        int32:pb = raw type_int_bits(x.fe.ctx.types, sel_tid);
        string:pmn = raw tbb_min_decimal(pb);
        if (pmn.len == 0i64) { pass (raw iv_broken(at)); }
        pass (raw iv("", move(pmn), 0i32));
    }
    pass (raw iv_broken(at));
};

// The payload, narrowed back out of the uniform `i64` word and bound for the
// arm's body. The widths match by construction: the constructor widened the
// same declared type in.
func:bind_payload = IrVal(ExprEmitter->:x, PatNode:pn, int32:sel_tid,
                          IrVal:sel, int32:arm_idx, Span:at) never fails {
    // A STRUCT DESTRUCTURE BINDS EACH NAMED FIELD (1.0.9c): `(Point{ x, y })`
    // reads `x` and `y` out of the selector by field. The pattern is
    // irrefutable, so the arm always runs; this is the binding half of that.
    if (pn.kind == PatKind.PatStructDestructure) {
        int32:sbc = raw pat_bind_count(pn);
        int32:sbs = raw pat_bind_start(pn);
        int32:si = 0i32;
        while (si < sbc) {
            int32:fname = raw ast_id_at(x.ast, sbs, si);
            FieldInfo:fi = raw struct_field(x.tr, sel_tid, fname, x.scope);
            if (!fi.found) { pass (raw iv_broken(at)); }
            LlType:fll = raw ll_type(x.fe.ctx, fi.type_id);
            if (!(raw ll_is_ok(fll))) {
                pass (raw iv_from_ll_at(x, fll, fi.type_id, at));
            }
            string:fv = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(fv, " = extractvalue ", sel.ll, " ",
                              raw cat3(sel.ref, ", ",
                                  raw int_to_string(fi.index => int64))));
            string:fslot = raw pick_bind_slot(x, arm_idx, si, fname,
                                              fi.type_id, fll.text);
            if (fslot.len == 0i64) { pass (raw iv_broken(at)); }
            drop irw_line(x.fe.w, raw cat5("store ", fll.text, " ", fv,
                              raw string_concat(", ptr ", fslot)));
            si = si + 1i32;
        }
        pass (raw iv_nil());
    }
    if (pn.kind != PatKind.PatEnumDestructure) { pass (raw iv_nil()); }
    if ((raw pat_enum_bind_count(x.ast, pn)) == 0i32) { pass (raw iv_nil()); }

    int32:segs = raw pat_enum_segment_count(x.ast, pn);
    VariantInfo:vi = raw variant_info(x, sel_tid,
                         raw pat_enum_segment(x.ast, pn, segs - 1i32));
    if (!vi.found) { pass (raw iv_broken(at)); }
    if (vi.payload_count == 0i32) { pass (raw iv_nil()); }

    int32:pty = raw resolve_type(x.tr, vi.payload_ty,
                     raw symtab_home_scope(x.tab, raw type_decl(x.fe.ctx.types,
                                               sel_tid), x.scope));
    LlType:pll = raw ll_type(x.fe.ctx, pty);
    if (!(raw ll_is_ok(pll))) { pass (raw iv_from_ll_at(x, pll, pty, at)); }

    // THE GENERAL SINGLE BINDING (0.9.2): spill the selector, address its
    // payload slot, and load the VARIANT'S OWN TYPE through the pointer — the
    // mirror of construction, and the end of the widen-narrow contract that
    // could only carry one machine word (a string payload truncated to its
    // pointer under the old shape). Kept byte-identical (1.0.9c wraps it in the
    // count guard and adds the multi case below).
    if ((raw pat_enum_bind_count(x.ast, pn)) == 1i32) {
        string:tmp = raw irw_temp(x.fe.w);
        drop irw_alloca(x.fe.w, tmp, sel.ll);
        drop irw_line(x.fe.w, raw cat5("store ", sel.ll, " ", sel.ref,
                          raw string_concat(", ptr ", tmp)));
        string:pp = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(pp, " = getelementptr ", sel.ll,
                          ", ptr ", raw string_concat(tmp, ", i32 0, i32 1")));
        string:val = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(val, " = load ", pll.text, ", ptr ",
                          raw string_concat(pp, "")));
        string:slot = raw pick_bind_slot(x, arm_idx, 0i32,
                          raw pat_enum_bind(x.ast, pn, 0i32), pty, pll.text);
        if (slot.len == 0i64) { pass (raw iv_broken(at)); }
        drop irw_line(x.fe.w, raw cat5("store ", pll.text, " ", val,
                          raw string_concat(", ptr ", slot)));
        pass (raw iv_nil());
    }

    // MULTI-PAYLOAD BINDING (1.0.9c): each binding reads its payload from the
    // struct offset construction wrote it to. Binding i is payload i — the
    // checker holds the counts equal — and `variant_payload_slot` gives each
    // one's type and offset, the same source of truth the constructor used, so
    // the two cannot drift.
    string:mtmp = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, mtmp, sel.ll);
    drop irw_line(x.fe.w, raw cat5("store ", sel.ll, " ", sel.ref,
                      raw string_concat(", ptr ", mtmp)));
    int32:vn2 = raw pat_enum_segment(x.ast, pn, segs - 1i32);
    int32:bc = raw pat_enum_bind_count(x.ast, pn);
    int32:bi = 0i32;
    while (bi < bc) {
        PayloadSlot:bs = raw variant_payload_slot(x, sel_tid, vn2, bi);
        if (!bs.ok) { pass (raw iv_broken(at)); }
        LlType:bpll = raw ll_type(x.fe.ctx, bs.type_id);
        if (!(raw ll_is_ok(bpll))) {
            pass (raw iv_from_ll_at(x, bpll, bs.type_id, at));
        }
        string:bbase = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(bbase, " = getelementptr ", sel.ll,
                          ", ptr ", raw string_concat(mtmp, ", i32 0, i32 1")));
        string:bpp = raw string_concat(bbase, "");
        if (bs.offset != 0i64) {
            string:bpp2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(bpp2, " = getelementptr i8, ptr ",
                              bbase, ", i64 ", raw int_to_string(bs.offset)));
            bpp = move(bpp2);
        }
        string:bval = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(bval, " = load ", bpll.text, ", ptr ",
                          raw string_concat(bpp, "")));
        string:bslot = raw pick_bind_slot(x, arm_idx, bi,
                          raw pat_enum_bind(x.ast, pn, bi), bs.type_id,
                          bpll.text);
        if (bslot.len == 0i64) { pass (raw iv_broken(at)); }
        drop irw_line(x.fe.w, raw cat5("store ", bpll.text, " ", bval,
                          raw string_concat(", ptr ", bslot)));
        bi = bi + 1i32;
    }
    pass (raw iv_nil());
};

// `give expr;` (0.9.7, D-059): the pick-expression's yield — value into the
// frame's slot, defers between here and the pick unwound, exit to its done.
func:emit_give = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    string:slot = raw fnem_pick_slot(x.fe);
    if (slot.len == 0i64) { pass (raw iv_broken(s.span)); }
    IrVal:v = raw emit_expr(x, raw stmt_operand(s));
    if (!(raw iv_is_ok(v))) { pass v; }
    // THE PICK'S SLOT IS A SLOT (1.0.6e): each arm's `give` is fit to it.
    v = raw emit_fit(x, raw fnem_pick_tid(x.fe), move(v), s.span);
    if (!(raw iv_is_ok(v))) { pass v; }
    IrVal:d = raw run_defers_down_to(x, raw fnem_pick_depth(x.fe));
    if (!(raw iv_is_ok(d))) { pass d; }
    drop irw_line(x.fe.w, raw cat5("store ", v.ll, " ", v.ref,
                      raw string_concat(", ptr ", slot)));
    drop s_br(x, raw fnem_pick_done(x.fe));
    pass (raw iv_nil());
};

// `fall label;` — jump to the labelled arm's BODY, which is derivable from the
// frame's seq and the arm list; there is no implicit fallthrough (D-047-era
// rule), so the target is always named.
func:emit_fall = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    int32:want = raw stmt_label(s);
    int32:start = raw fnem_pick_start(x.fe);
    int32:count = raw fnem_pick_count_of(x.fe);
    int32:seq = raw fnem_pick_seq_of(x.fe);
    int32:i = 0i32;
    while (i < count) {
        StmtNode:arm = raw ast_stmt(x.ast, raw pick_arm_at(x.ast, start, i));
        if ((raw arm_label(arm)) == want) {
            IrVal:d = raw run_defers_down_to(x, raw fnem_pick_depth(x.fe));
            if (!(raw iv_is_ok(d))) { pass d; }
            drop s_br(x, raw pk_label(seq, i));
            pass (raw iv_nil());
        }
        i = i + 1i32;
    }
    pass (raw iv_broken(s.span));
};

func:emit_pick = IrVal(ExprEmitter->:x, StmtNode:s) never fails {
    ExprId:sel_id = raw pick_selector(s);
    int32:sel_tid = raw exprtypes_get(x.et, sel_id);
    IrVal:sel = raw emit_expr(x, sel_id);
    if (!(raw iv_is_ok(sel))) { pass sel; }

    // The discriminant: a payload-carrying enum's tag lives in slot 0; a plain
    // enum, a bool, a char or an integer IS its own discriminant.
    string:disc = raw string_concat(sel.ref, "");
    string:disc_ll = raw string_concat(sel.ll, "");
    if ((raw type_kind(x.fe.ctx.types, sel_tid)) == (raw TY_ENUM())) {
        if (raw enum_has_payload(x.ast, x.fe.ctx.types, sel_tid)) {
            string:tag = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(tag, " = extractvalue ", sel.ll,
                              " ", raw string_concat(sel.ref, ", 0")));
            disc = move(tag);
            disc_ll = "i32";
        }
    }
    // GUARDS, STRINGS AND RANGES CANNOT RIDE A SWITCH (0.9.7): any of them
    // sends the whole pick to the compare CHAIN, which tests arms in source
    // order. Bare-constant picks keep the switch.
    int32:count = raw pick_arm_count(s);
    bool:chain = raw string_eq(disc_ll, "{ ptr, i64, i64 }");
    // A STRUCT SELECTOR CANNOT RIDE THE SWITCH (1.0.9c): its discriminant is the
    // whole aggregate, which `switch` cannot take. Its only arms are irrefutable
    // destructures (D-169: a struct has no `==`), so the chain runs the first
    // and binds its fields.
    if ((raw type_kind(x.fe.ctx.types, sel_tid)) == (raw TY_STRUCT())) {
        chain = true;
    }
    int32:ci2 = 0i32;
    while (ci2 < count) {
        StmtNode:carm = raw ast_stmt(x.ast, raw pick_arm_at(x.ast,
                                           raw pick_arm_start(s), ci2));
        if (!(raw expr_is_none(raw arm_guard(carm)))) { chain = true; }
        PatNode:cpn = raw ast_pat(x.ast, raw arm_pattern(carm));
        if (cpn.kind == PatKind.PatRange) { chain = true; }
        ci2 = ci2 + 1i32;
    }
    if (chain) {
        pass (raw emit_pick_chain(x, sel, sel_tid, disc, move(disc_ll),
                  raw pick_arm_start(s), count, "", "", 0i32));
    }

    int32:seq = raw fnem_next_pick_seq(x.fe);
    string:done_l = raw pk_named(seq, ".done");

    // FIRST PASS: a label per arm and the switch line — in arm order, so the
    // emitted cases read as the source does.
    // The arm labels, held locally so pass two starts each arm at the label
    // pass one promised the switch. Local because a pick nests inside a pick.
    wild int8->:lm = alloc((count => int64) * #size_of<string>());
    wild string->:labels = lm =>! wild string->;
    string:cases = "";
    string:default_l = raw string_concat(done_l, "");
    int32:i = 0i32;
    while (i < count) {
        StmtNode:arm = raw ast_stmt(x.ast, raw pick_arm_at(x.ast,
                                          raw pick_arm_start(s), i));
        string:arm_l = raw pk_label(seq, i);
        labels[i => int64] = raw string_concat(arm_l, "");
        PatNode:pn = raw ast_pat(x.ast, raw arm_pattern(arm));
        if (pn.kind == PatKind.PatWildcard) {
            default_l = raw string_concat(arm_l, "");
        } else {
            IrVal:c = raw pattern_const(x, pn, sel_tid, arm.span);
            if (!(raw iv_is_ok(c))) { pass c; }
            if (cases.len > 0i64) { cases = raw string_concat(cases, " "); }
            cases = raw cat5(cases, disc_ll, " ", c.ref,
                               raw string_concat(", label %", arm_l));
        }
        i = i + 1i32;
    }
    drop irw_line(x.fe.w, raw cat5("switch ", disc_ll, " ", disc,
                      raw cat5(", label %", default_l, " [ ", cases, " ]")));
    x.fe.terminated = true;

    // SECOND PASS: the bodies, each in its own scope, each ending at `done`.
    // The frame is what `fall` (and, in the expression form, `give`) resolve
    // against.
    drop fnem_pick_push(x.fe, raw string_concat(done_l, ""), "", "", 0i32, raw pick_arm_start(s), count,
                        seq);
    i = 0i32;
    while (i < count) {
        StmtId:armid = raw pick_arm_at(x.ast, raw pick_arm_start(s), i);
        StmtNode:arm = raw ast_stmt(x.ast, armid);
        drop s_start(x, labels[i => int64]);
        int32:mark = raw fnem_mark(x.fe);
        PatNode:pn = raw ast_pat(x.ast, raw arm_pattern(arm));
        IrVal:bp = raw bind_payload(x, pn, sel_tid, sel, armid.index, arm.span);
        if (!(raw iv_is_ok(bp))) { pass bp; }
        IrVal:b = raw emit_stmt(x, raw arm_body(arm));
        if (!(raw iv_is_ok(b))) { pass b; }
        drop fnem_release(x.fe, mark);
        drop s_br(x, done_l);
        i = i + 1i32;
    }
    drop fnem_pick_pop(x.fe);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// THE CHAIN (0.9.7): arm-by-arm tests in source order, for the patterns a
// switch cannot host — string equality, ranges, guards — and for every
// EXPRESSION pick, whose arms `give` into the slot. Bindings happen before the
// guard, because a guard's whole point is to read them. Exhaustiveness was
// proven statically (0.5), so the fall-off end is `unreachable`.
pub func:emit_pick_chain = IrVal(ExprEmitter->:x, IrVal:sel, int32:sel_tid,
                                 string:disc, move string:disc_ll, int32:start,
                                 int32:count, move string:give_slot,
                                 move string:give_ll, int32:give_tid) never fails {
    int32:seq = raw fnem_next_pick_seq(x.fe);
    string:done_l = raw pk_named(seq, ".done");
    drop fnem_pick_push(x.fe, raw string_concat(done_l, ""), move(give_slot), move(give_ll), give_tid, start, count,
                        seq);

    bool:sel_signed = true;
    if ((raw type_kind(x.fe.ctx.types, sel_tid)) == (raw TY_INT())) {
        sel_signed = raw type_is_signed(x.fe.ctx.types, sel_tid);
    }
    if ((raw type_kind(x.fe.ctx.types, sel_tid)) == (raw TY_CHAR())) {
        sel_signed = false;
    }

    string:first_t = raw pk_named(seq, ".t0");
    drop s_br(x, first_t);
    int32:i = 0i32;
    while (i < count) {
        StmtId:armid = raw pick_arm_at(x.ast, start, i);
        StmtNode:arm = raw ast_stmt(x.ast, armid);
        PatNode:pn = raw ast_pat(x.ast, raw arm_pattern(arm));
        string:test_l = raw pk_named(seq,
                            raw string_concat(".t", raw int_to_string(i => int64)));
        string:body_l = raw pk_label(seq, i);
        string:next_l = raw pk_named(seq, ".none");
        if ((i + 1i32) < count) {
            next_l = raw pk_named(seq,
                         raw string_concat(".t", raw int_to_string((i + 1i32) => int64)));
        }
        drop s_start(x, test_l);
        int32:mark = raw fnem_mark(x.fe);

        // --- the pattern's truth -------------------------------------------
        string:hit = "";
        if (pn.kind == PatKind.PatWildcard) {
            hit = "true";
        }
        // A STRUCT DESTRUCTURE IS IRREFUTABLE (1.0.9c): it always matches and
        // binds its fields, so it is `true` like a wildcard — and the selector
        // is an aggregate, which is exactly why a struct `pick` takes the chain
        // and never the switch.
        if (pn.kind == PatKind.PatStructDestructure) {
            hit = "true";
        }
        if (hit.len == 0i64) {
            if (raw string_eq(disc_ll, "{ ptr, i64, i64 }")) {
                // A string arm: the literal, then the floor's byte equality.
                IrVal:lit = raw emit_expr(x, raw pat_value(pn));
                if (!(raw iv_is_ok(lit))) { pass lit; }
                string:eqv = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(eqv,
                                  " = call i8 @npk_string_equals(",
                                  raw cat4(disc_ll, " ", disc, ", "),
                                  raw cat3(disc_ll, " ", lit.ref), ")"));
                string:eb = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat3(eb, " = icmp ne i8 ",
                                  raw string_concat(eqv, ", 0")));
                hit = move(eb);
            }
        }
        if (hit.len == 0i64) {
            if (pn.kind == PatKind.PatRange) {
                // Pattern bounds are LITERALS (the exhaustiveness analysis
                // reasons over them, so nothing dynamic ever got here) — read
                // their payloads directly; pattern sub-expressions carry no
                // checker-recorded type to emit through.
                ExprNode:lon = raw ast_expr(x.ast, raw pat_range_lo(pn));
                ExprNode:hin = raw ast_expr(x.ast, raw pat_range_hi(pn));
                if (lon.kind != ExprKind.ExprIntLiteral) {
                    if (lon.kind != ExprKind.ExprCharLiteral) {
                        pass (raw iv_broken(arm.span));
                    }
                }
                IrVal:plo = raw iv(move(disc_ll), raw int_to_string(lon.payload), 0i32);
                IrVal:phi = raw iv(move(disc_ll), raw int_to_string(hin.payload), 0i32);
                string:gep2 = "uge";
                string:lep = "ult";
                string:lip = "ule";
                if (sel_signed) { gep2 = "sge"; lep = "slt"; lip = "sle"; }
                string:c1 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(c1, " = icmp ", gep2, " ",
                                  raw cat5(disc_ll, " ", disc, ", ", plo.ref)));
                string:hp = move(lep);
                if (raw pat_range_inclusive(pn)) { hp = move(lip); }
                string:c2 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(c2, " = icmp ", hp, " ",
                                  raw cat5(disc_ll, " ", disc, ", ", phi.ref)));
                string:c3 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(c3, " = and i1 ", c1, ", ", c2));
                hit = move(c3);
            }
        }
        if (hit.len == 0i64) {
            IrVal:pc = raw pattern_const(x, pn, sel_tid, arm.span);
            if (!(raw iv_is_ok(pc))) { pass pc; }
            string:cc = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(cc, " = icmp eq ", disc_ll, " ",
                              raw cat3(disc, ", ", pc.ref)));
            hit = move(cc);
        }

        // --- bindings, then the guard --------------------------------------
        ExprId:g = raw arm_guard(arm);
        if (raw expr_is_none(g)) {
            if (raw string_eq(hit, "true")) {
                drop s_br(x, body_l);
            } else {
                drop irw_line(x.fe.w, raw cat5("br i1 ", hit, ", label %",
                                  body_l, raw string_concat(", label %", next_l)));
                x.fe.terminated = true;
            }
        } else {
            string:prep_l = raw pk_named(seq,
                                raw string_concat(".g", raw int_to_string(i => int64)));
            if (raw string_eq(hit, "true")) {
                drop s_br(x, prep_l);
            } else {
                drop irw_line(x.fe.w, raw cat5("br i1 ", hit, ", label %",
                                  prep_l, raw string_concat(", label %", next_l)));
                x.fe.terminated = true;
            }
            drop s_start(x, prep_l);
            IrVal:gb = raw bind_payload(x, pn, sel_tid, sel, armid.index, arm.span);
            if (!(raw iv_is_ok(gb))) { pass gb; }
            // A guard's suspension would kill the chain's selector value —
            // the next arm's test re-reads it — so `await` rungs inside a
            // `where` (the depth is read by `emit_await`).
            x.fe.guard_depth = x.fe.guard_depth + 1i32;
            IrVal:gc = raw emit_cond(x, g);
            x.fe.guard_depth = x.fe.guard_depth - 1i32;
            if (!(raw iv_is_ok(gc))) { pass gc; }
            drop irw_line(x.fe.w, raw cat5("br i1 ", gc.ref, ", label %",
                              body_l, raw string_concat(", label %", next_l)));
            x.fe.terminated = true;
        }

        // --- the body ------------------------------------------------------
        drop s_start(x, body_l);
        if (raw expr_is_none(g)) {
            IrVal:bp = raw bind_payload(x, pn, sel_tid, sel, armid.index, arm.span);
            if (!(raw iv_is_ok(bp))) { pass bp; }
        }
        IrVal:b = raw emit_stmt(x, raw arm_body(arm));
        if (!(raw iv_is_ok(b))) { pass b; }
        drop fnem_release(x.fe, mark);
        drop s_br(x, done_l);
        i = i + 1i32;
    }
    drop s_start(x, raw pk_named(seq, ".none"));
    drop irw_line(x.fe.w, "unreachable");
    x.fe.terminated = true;
    drop fnem_pick_pop(x.fe);
    drop s_start(x, done_l);
    pass (raw iv_nil());
};

// --- a whole function ---------------------------------------------------------------

// Everything between `func:` and its closing brace: signature, prologue, body,
// epilogue. The driver's per-function loop is a call to this.
// A GENERIC FUNCTION'S SPECIALIZATION (1.0.2b). One body per argument set: the
// declaration is a template, and what LLVM needs is `extract<int32>` with `T`
// bound. The frontend recorded which sets a program asks for (`FnInstTable`,
// deduped by declaration and arguments), and this emits one of them — pushing
// the resolver's generic scope so every parameter, local and return annotation
// in the body resolves with the arguments bound, exactly as `ll_struct_body`
// does for a struct's fields.
pub func:emit_fn_instance = IrVal(ExprEmitter->:x, DeclId:did,
                                  int32:args_start, int32:args_count,
                                  int32:params_start, int32:params_count,
                                  int32:mangled_name) never fails {
    DeclNode:d = raw ast_decl(x.ast, did);
    if (d.kind != DeclKind.DeclFunctionDecl) { pass (raw iv_broken(d.span)); }
    // The parameters these arguments bind, as the checker recorded them: a
    // generic function's own, or — for a family impl's method — its IMPL's,
    // which the method's declaration does not carry (1.0.4b).
    IdSpan:gp = IdSpan{ start: params_start, count: params_count };

    // THE SUBSTITUTION IS APPLIED TO WHAT RESOLUTION RETURNS, not pushed onto
    // the resolver's scope. `fn_signature` calls `bind_own_generics`, which
    // deliberately rebinds the declaration's parameters UNBOUND — a definition
    // is checked with `T` opaque (D-107) — so a scope pushed here would be
    // overwritten before any annotation resolved. Substituting afterwards is
    // the same shape `type_generic_call` uses on the caller's side, and it is
    // why a specialization's every type is the caller's, not the template's.
    GenericScope:g = GenericScope{
        params_start: gp.start, params_count: gp.count,
        args_start: args_start, args_count: args_count };

    // The EXPRESSION half of the substitution (1.0.4c): a generic body's
    // expressions carry the types the checker recorded with `T` opaque, so
    // `ll_type` needs the binding to lower them. The annotation half is the
    // resolver scope pushed inside `emit_function_body_subst`.
    drop llctx_set_subst(x.fe.ctx, gp.start, gp.count, args_start);
    IrVal:r = raw emit_function_body_subst(x, did, d, mangled_name, g, true);
    drop llctx_set_subst(x.fe.ctx, 0i32, 0i32, 0i32);
    pass r;
};

pub func:emit_function = IrVal(ExprEmitter->:x, DeclId:did) never fails {
    pass (raw emit_function_named(x, did, 0i32));
};

// The same emission under a GIVEN name. An impl's method carries its impl in its
// symbol (D-156 as amended at 1.0.5b), and the name is computed where the impl
// is known — which is the only place that knows it, since a trait DEFAULT is one
// declaration emitted once per implementing impl and the declaration cannot say
// which of those a body is.
pub func:emit_function_named = IrVal(ExprEmitter->:x, DeclId:did,
                                     int32:name_intern) never fails {
    DeclNode:d = raw ast_decl(x.ast, did);
    if (d.kind != DeclKind.DeclFunctionDecl) { pass (raw iv_broken(d.span)); }

    // A GENERIC DECLARATION EMITS NOTHING OF ITS OWN — it is a template, and its
    // specializations are emitted from the recorded instantiations (1.0.2b), the
    // same rule a generic struct follows.
    if ((raw decl_generic_window(x.ast, d)).count > 0i32) { pass (raw iv_nil()); }
    pass (raw emit_function_body_subst(x, did, d, name_intern,
              raw generic_scope_none(), false));
};

// A loop's hidden slot (stage D2): the frame GEP in a coroutine, an alloca
// otherwise. The pre-scan registered every coroutine loop's roles, so a miss
// while async is a defect — fail closed as broken IR, never a quiet alloca.
func:loop_slot = string(ExprEmitter->:x, StmtId:sid, int32:role,
                        string:ll) never fails {
    if (x.fe.is_async) {
        int32:ci = raw fnem_cross_find(x.fe, sid.index, role);
        if (ci < 0i32) { pass ""; }
        pass (raw fnem_cross_gep(x.fe, ci));
    }
    string:a = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, a, ll);
    pass a;
};

// A value the loop re-reads each iteration: stored to its slot once, loaded
// fresh at each use site. In a coroutine the slot is frame-resident, so the
// value survives a suspension inside the body.
func:loop_stash = NIL(ExprEmitter->:x, string:slot, string:ll,
                      string:value) never fails {
    drop irw_line(x.fe.w, raw cat5("store ", ll, " ", value,
                      raw string_concat(", ptr ", slot)));
    pass NIL;
};

func:loop_reread = string(ExprEmitter->:x, string:slot, string:ll) never fails {
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = load ", ll, ", ptr ", slot));
    pass r;
};

// A pick arm's pattern-binding slot (stage D3): role 7+ordinal on the ARM's
// stmt index, frame-resident in a coroutine so a bind extracted at arm entry
// survives a suspension inside the arm. The scan registered it by mirroring
// the same field/payload resolution the emitter makes below — a miss here is
// drift between the two, and it fails closed as broken IR.
func:pick_bind_slot = string(ExprEmitter->:x, int32:arm_idx, int32:ordinal,
                             int32:name, int32:bind_tid, string:ll) never fails {
    if (x.fe.is_async) {
        int32:ci = raw fnem_cross_find(x.fe, arm_idx, 7i32 + ordinal);
        if (ci < 0i32) { pass ""; }
        string:g = raw fnem_cross_gep(x.fe, ci);
        drop fnem_bind(x.fe, name, raw string_concat(g, ""), bind_tid);
        pass g;
    }
    pass (raw fnem_local(x.fe, name, bind_tid, ll));
};

// A CHANNEL AWAIT'S LOOP STATE (D-182), reserved on the enclosing
// STATEMENT because D-178 guarantees at most one suspension per statement.
// The handle word, the absolute deadline, the value in flight and the
// outcome all outlive the suspension the retry loop makes, so they live in
// the frame — an SSA value computed before the loop does not dominate the
// resume switch's re-entry, which is the verifier error this reserves
// against.
//   20 handle word | 21 deadline | 22 value | 23 outcome
func:scan_channel_await = NIL(ExprEmitter->:x, StmtId:sid, ExprId:eid,
                              int32:fuel) never fails {
    if (raw expr_is_none(eid)) { pass NIL; }
    if (fuel <= 0i32) { pass NIL; }
    ExprNode:n = raw ast_expr(x.ast, eid);
    if (n.kind == ExprKind.ExprAwaitExpr) {
        ExprId:op = raw expr_operand(n);
        ExprNode:opn = raw ast_expr(x.ast, op);
        // AN AWAITED VARIADIC CALL'S GATHERED TAIL (1.1.13-close, role 30):
        // the [N x elem] array the call builds must OUTLIVE the suspension
        // the child takes — a resume-stack alloca dies at the park and the
        // callee's slice would point into a dead stack — so the pre-scan
        // reserves it in the caller's frame, sized from the same call node
        // the emitter reads. A `..^` tail needs no slot (the operand's own
        // storage follows the ordinary crossing rules).
        if (opn.kind == ExprKind.ExprCallExpr) {
            int32:vft = raw exprtypes_callee_ft(x.et, op);
            if (raw type_is_variadic(x.fe.ctx.types, vft)) {
                int32:vgc = raw expr_generic_count(opn);
                int32:vstart = (raw expr_list_start(opn)) + vgc;
                int32:vcount = (raw expr_list_count(opn)) - vgc;
                int32:vfix = (raw type_param_count_of(x.fe.ctx.types, vft)) - 1i32;
                int32:vtrail = vcount - vfix;
                bool:vspread = false;
                if (vtrail == 1i32) {
                    ExprNode:vln = raw ast_expr(x.ast, ExprId{
                        index: raw ast_id_at(x.ast, vstart, vcount - 1i32) });
                    if (vln.kind == ExprKind.ExprSpreadExpr) { vspread = true; }
                }
                if (vtrail > 0i32) { if (!vspread) {
                    int32:vcoll = raw subst_emitted_param(x.fe.ctx,
                        raw ast_id_at(x.ast,
                            raw type_param_start_of(x.fe.ctx.types, vft),
                            vfix));
                    int32:velem = raw type_elem(x.fe.ctx.types, vcoll);
                    LlType:vell = raw ll_type(x.fe.ctx, velem);
                    if (raw ll_is_ok(vell)) {
                        drop fnem_cross_add(x.fe, sid.index, 30i32, 0i32,
                            raw cat5("[", raw int_to_string(vtrail => int64),
                                     " x ", vell.text, "]"));
                    }
                } }
            }
        }
        if (opn.kind == ExprKind.ExprMethodCallExpr) {
            int32:rt = raw exprtypes_get(x.et, raw expr_operand(opn));
            if ((raw type_kind(x.fe.ctx.types, rt)) == (raw TY_CHANNEL())) {
                int32:el = raw type_elem(x.fe.ctx.types, rt);
                LlType:ell = raw ll_type(x.fe.ctx, el);
                if (raw ll_is_ok(ell)) {
                    drop fnem_cross_add(x.fe, sid.index, 20i32, 0i32, "i64");
                    drop fnem_cross_add(x.fe, sid.index, 21i32, 0i32, "i64");
                    drop fnem_cross_add(x.fe, sid.index, 22i32, el, move(ell.text));
                    drop fnem_cross_add(x.fe, sid.index, 23i32, 0i32, "i32");
                }
            }
            // A MUTEX ACQUIRE'S LOOP STATE (D-056, 1.1.11): the cell word,
            // the absolute deadline, and the outcome — same protocol, no
            // value slot (the guard IS the cell pointer). A borrowed
            // receiver acquires the same way.
            int32:mrt = rt;
            if ((raw type_kind(x.fe.ctx.types, mrt)) == (raw TY_POINTER())) {
                mrt = raw type_elem(x.fe.ctx.types, mrt);
            }
            int32:mrk = raw type_kind(x.fe.ctx.types, mrt);
            if (mrk == (raw TY_MUTEX())) {
                drop fnem_cross_add(x.fe, sid.index, 20i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 21i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 23i32, 0i32, "i32");
            }
            if (mrk == (raw TY_RWLOCK())) {
                drop fnem_cross_add(x.fe, sid.index, 20i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 21i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 23i32, 0i32, "i32");
            }
            // The condvar's TWO-PHASE wait adds the phase, the mutex cell
            // and the lent guard's slot address (D-056, 1.1.11b).
            if (mrk == (raw TY_CONDVAR())) {
                drop fnem_cross_add(x.fe, sid.index, 20i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 21i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 22i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 23i32, 0i32, "i32");
                drop fnem_cross_add(x.fe, sid.index, 24i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 25i32, 0i32, "i64");
            }
            // The barrier waits out a GENERATION.
            if (mrk == (raw TY_BARRIER())) {
                drop fnem_cross_add(x.fe, sid.index, 20i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 21i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 22i32, 0i32, "i64");
                drop fnem_cross_add(x.fe, sid.index, 23i32, 0i32, "i32");
            }
        }
    }
    // A `channel()` OPEN needs a frame-resident stash for its handle (D-183,
    // 1.2.5): role 30+k on the enclosing statement, k counting the sites the
    // statement holds. The reclaim loop walks every stash, so a pairing swap
    // between scan order and emission order is harmless — all stashes are
    // i64 handles and all of them are reclaimed.
    if (n.kind == ExprKind.ExprCallExpr) {
        ExprId:cbe = raw expr_callee(n);
        if (!(raw expr_is_none(cbe))) {
            ExprNode:cbn = raw ast_expr(x.ast, cbe);
            if (cbn.kind == ExprKind.ExprIdentifierExpr) {
                if (cbn.a == 0i32) {
                    if (raw string_eq(raw intern_get(x.interns,
                                          cbn.payload =>! int32), "channel")) {
                        int32:k = 0i32;
                        while ((raw fnem_cross_find(x.fe, sid.index,
                                                    30i32 + k)) >= 0i32) {
                            k = k + 1i32;
                        }
                        drop fnem_cross_add(x.fe, sid.index, 30i32 + k,
                                            0i32, "i64");
                    }
                }
            }
        }
    }
    // A `gives` CALL reserves one stash per channel its result carries
    // (D-183, 1.2.6): the caller owns their reclaim, and in a coroutine the
    // stash must be frame-resident like `channel()`'s own. Inside a `gives`
    // function the only legal position is transit (checker rule), which
    // takes no stash, so nothing is reserved.
    if (!x.fe.is_gives) {
        bool:g_call = (n.kind == ExprKind.ExprCallExpr);
        if (n.kind == ExprKind.ExprMethodCallExpr) { g_call = true; }
        if (g_call) {
            int32:gcd = raw exprtypes_callee(x.et, eid);
            if (gcd != 0i32) {
                DeclNode:gcdn = raw ast_decl(x.ast, DeclId{ index: gcd });
                bool:g_fn = (gcdn.kind == DeclKind.DeclFunctionDecl);
                bool:g_gives = false;
                if (g_fn) { g_gives = raw fn_declares_gives(x.ast, gcdn); }
                if (g_gives) {
                    int32:grt = raw exprtypes_get(x.et, eid);
                    if ((raw type_kind(x.fe.ctx.types, grt)) == (raw TY_RESULT())) {
                        grt = raw type_elem(x.fe.ctx.types, grt);
                    }
                    int32:gn = raw gives_chan_count(x, grt);
                    int32:gi = 0i32;
                    while (gi < gn) {
                        int32:k2 = 0i32;
                        while ((raw fnem_cross_find(x.fe, sid.index,
                                                    30i32 + k2)) >= 0i32) {
                            k2 = k2 + 1i32;
                        }
                        drop fnem_cross_add(x.fe, sid.index, 30i32 + k2,
                                            0i32, "i64");
                        gi = gi + 1i32;
                    }
                }
            }
        }
    }
    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_NONE())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        int32:i = 0i32;
        while (i < (raw expr_list_count(n))) {
            drop scan_channel_await(x, sid, ExprId{ index: raw ast_id_at(x.ast,
                     raw expr_list_start(n), i) }, fuel - 1i32);
            i = i + 1i32;
        }
        pass NIL;
    }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) {
        int32:j = 0i32;
        while (j < (raw expr_list_count(n))) {
            drop scan_channel_await(x, sid, ExprId{ index: raw ast_id_at(x.ast,
                     raw expr_list_start(n), j) }, fuel - 1i32);
            j = j + 1i32;
        }
        drop scan_channel_await(x, sid, raw expr_lhs(n), fuel - 1i32);
        pass NIL;
    }
    drop scan_channel_await(x, sid, raw expr_lhs(n), fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_ONE())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        int32:k = 0i32;
        while (k < (raw expr_list_count(n))) {
            drop scan_channel_await(x, sid, ExprId{ index: raw ast_id_at(x.ast,
                     raw expr_list_start(n), k) }, fuel - 1i32);
            k = k + 1i32;
        }
        pass NIL;
    }
    drop scan_channel_await(x, sid, raw expr_rhs(n), fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_TWO())) { pass NIL; }
    drop scan_channel_await(x, sid, raw expr_third(n), fuel - 1i32);
    pass NIL;
};

// A counted loop's frame slots (stage D2): counter, limit, step, direction.
func:scan_counted_slots = NIL(ExprEmitter->:x, StmtId:sid) never fails {
    drop fnem_cross_add(x.fe, sid.index, 1i32, 0i32, "i64");
    drop fnem_cross_add(x.fe, sid.index, 2i32, 0i32, "i64");
    drop fnem_cross_add(x.fe, sid.index, 5i32, 0i32, "i64");
    drop fnem_cross_add(x.fe, sid.index, 6i32, 0i32, "i8");
    pass NIL;
};

// A pick's arm-binding slots (stage D3), registered by mirroring the same
// resolution `bind_payload` makes: a struct destructure binds each named
// field, an enum destructure its payload(s). Role 7+ordinal on the ARM's
// stmt index. `bind_payload` fails closed on a miss, so a drift between
// this mirror and the emitter is loud.
func:scan_pick_binds = NIL(ExprEmitter->:x, int32:sel_tid, int32:arm_start,
                           int32:arm_count) never fails {
    int32:i = 0i32;
    while (i < arm_count) {
        StmtId:armid = raw pick_arm_at(x.ast, arm_start, i);
        StmtNode:arm = raw ast_stmt(x.ast, armid);
        PatNode:pn = raw ast_pat(x.ast, raw arm_pattern(arm));
        if (pn.kind == PatKind.PatStructDestructure) {
            int32:sbc = raw pat_bind_count(pn);
            int32:sbs = raw pat_bind_start(pn);
            int32:si = 0i32;
            while (si < sbc) {
                FieldInfo:fi = raw struct_field(x.tr, sel_tid,
                                   raw ast_id_at(x.ast, sbs, si), x.scope);
                if (fi.found) {
                    LlType:fll = raw ll_type(x.fe.ctx, fi.type_id);
                    if (raw ll_is_ok(fll)) {
                        drop fnem_cross_add(x.fe, armid.index, 7i32 + si,
                                            fi.type_id, move(fll.text));
                    }
                }
                si = si + 1i32;
            }
        }
        if (pn.kind == PatKind.PatEnumDestructure) {
            if ((raw pat_enum_bind_count(x.ast, pn)) > 0i32) {
                int32:segs = raw pat_enum_segment_count(x.ast, pn);
                VariantInfo:vi = raw variant_info(x, sel_tid,
                                     raw pat_enum_segment(x.ast, pn, segs - 1i32));
                if (vi.found) { if (vi.payload_count > 0i32) {
                    if ((raw pat_enum_bind_count(x.ast, pn)) == 1i32) {
                        int32:pty = raw resolve_type(x.tr, vi.payload_ty,
                                        raw symtab_home_scope(x.tab,
                                            raw type_decl(x.fe.ctx.types,
                                                sel_tid), x.scope));
                        LlType:pll = raw ll_type(x.fe.ctx, pty);
                        if (raw ll_is_ok(pll)) {
                            drop fnem_cross_add(x.fe, armid.index, 7i32,
                                                pty, move(pll.text));
                        }
                    } else {
                        int32:vn2 = raw pat_enum_segment(x.ast, pn, segs - 1i32);
                        int32:bc = raw pat_enum_bind_count(x.ast, pn);
                        int32:bi = 0i32;
                        while (bi < bc) {
                            PayloadSlot:bs = raw variant_payload_slot(x, sel_tid,
                                                 vn2, bi);
                            if (bs.ok) {
                                LlType:bpll = raw ll_type(x.fe.ctx, bs.type_id);
                                if (raw ll_is_ok(bpll)) {
                                    drop fnem_cross_add(x.fe, armid.index,
                                        7i32 + bi, bs.type_id, move(bpll.text));
                                }
                            }
                            bi = bi + 1i32;
                        }
                    }
                } }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// The scan's EXPRESSION descent (stage D3): the one statement-shaped thing an
// expression can hide is a value-`pick`, whose arms hold statements — so the
// walk follows every expression looking for `ExprPickExpr` and hands its arms
// back to the statement scan (var-decls register, binds register).
func:scan_expr = IrVal(ExprEmitter->:x, ExprId:id, int32:fuel) never fails {
    if (raw expr_is_none(id)) { pass (raw iv_nil()); }
    if (fuel <= 0i32) { pass (raw iv_nil()); }
    ExprNode:n = raw ast_expr(x.ast, id);

    if (n.kind == ExprKind.ExprPickExpr) {
        StmtNode:as_stmt = StmtNode{ kind: StmtKind.StmtPickStmt, span: n.span,
                                     a: n.a, b: n.b, c: n.c, payload: 0i64 };
        IrVal:sr = raw scan_expr(x, raw pick_selector(as_stmt), fuel - 1i32);
        if (!(raw iv_is_ok(sr))) { pass sr; }
        drop scan_pick_binds(x, raw exprtypes_get(x.et,
                                 raw pick_selector(as_stmt)),
                             raw pick_arm_start(as_stmt),
                             raw pick_arm_count(as_stmt));
        int32:j = 0i32;
        while (j < (raw pick_arm_count(as_stmt))) {
            IrVal:ar = raw scan_crossing(x, raw pick_arm_at(x.ast,
                           raw pick_arm_start(as_stmt), j), fuel - 1i32);
            if (!(raw iv_is_ok(ar))) { pass ar; }
            j = j + 1i32;
        }
        pass (raw iv_nil());
    }

    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            IrVal:r = raw scan_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                          raw expr_list_start(n), i) }, fuel - 1i32);
            if (!(raw iv_is_ok(r))) { pass r; }
            i = i + 2i32;
        }
        pass (raw iv_nil());
    }
    if (n.kind == ExprKind.ExprCallExpr) {
        IrVal:cr = raw scan_expr(x, raw expr_callee(n), fuel - 1i32);
        if (!(raw iv_is_ok(cr))) { pass cr; }
        pass (raw scan_expr_window(x, (raw expr_list_start(n))
                  + (raw expr_generic_count(n)),
                  (raw expr_list_count(n)) - (raw expr_generic_count(n)), fuel));
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        pass (raw scan_expr_window(x, (raw expr_list_start(n))
                  + (raw builtin_generic_count(n)),
                  (raw expr_list_count(n)) - (raw builtin_generic_count(n)), fuel));
    }

    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass (raw iv_nil()); }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        pass (raw scan_expr_window(x, raw expr_list_start(n),
                  raw expr_list_count(n), fuel));
    }
    if (shape == (raw EXPR_SHAPE_NONE()))   { pass (raw iv_nil()); }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) { pass (raw iv_nil()); }
    IrVal:r1 = raw scan_expr(x, raw expr_lhs(n), fuel - 1i32);
    if (!(raw iv_is_ok(r1))) { pass r1; }
    if (shape == (raw EXPR_SHAPE_ONE())) { pass (raw iv_nil()); }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        pass (raw scan_expr_window(x, raw expr_list_start(n),
                  raw expr_list_count(n), fuel));
    }
    IrVal:r2 = raw scan_expr(x, raw expr_rhs(n), fuel - 1i32);
    if (!(raw iv_is_ok(r2))) { pass r2; }
    if (shape == (raw EXPR_SHAPE_TWO())) { pass (raw iv_nil()); }
    pass (raw scan_expr(x, raw expr_third(n), fuel - 1i32));
};

func:scan_expr_window = IrVal(ExprEmitter->:x, int32:start, int32:count,
                              int32:fuel) never fails {
    int32:i = 0i32;
    while (i < count) {
        IrVal:r = raw scan_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, i) },
                                fuel - 1i32);
        if (!(raw iv_is_ok(r))) { pass r; }
        i = i + 1i32;
    }
    pass (raw iv_nil());
};

// THE CROSSING PRE-SCAN (stage D): before the frame type is fixed, find every
// var-decl the suspend walk marked and register its slot — and since D3, the
// loop and pick hidden state too, with `scan_expr` following expressions into
// value-`pick` arms so nothing statement-shaped hides from it. A marked decl
// this scan still cannot reach falls to the declaration-site rung below, so
// the answer is refusal, never a dead slot.
func:scan_crossing = IrVal(ExprEmitter->:x, StmtId:sid, int32:fuel) never fails {
    if (raw stmt_is_none(sid)) { pass (raw iv_nil()); }
    if (fuel <= 0i32) { pass (raw iv_nil()); }
    StmtNode:s = raw ast_stmt(x.ast, sid);

    // Every statement is asked whether it carries a channel await — but ONLY
    // through the accessor its own kind has. A blanket `stmt_expr` on a block
    // reads a statement-window start as an expression index, and the walk
    // trapped on the first program that reached it: an accessor is a promise
    // about a layout, and calling one on the wrong kind is reading a
    // different node's slot.
    if (s.kind == StmtKind.StmtVarDeclStmt) {
        drop scan_channel_await(x, sid, raw stmt_decl_init(x.ast, s), 128i32);
    }
    if (s.kind == StmtKind.StmtAssignStmt) {
        drop scan_channel_await(x, sid, raw stmt_target(s), 128i32);
        drop scan_channel_await(x, sid, raw stmt_assigned(s), 128i32);
    }
    if (s.kind == StmtKind.StmtIfStmt) {
        drop scan_channel_await(x, sid, raw stmt_cond(s), 128i32);
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        drop scan_channel_await(x, sid, raw stmt_cond(s), 128i32);
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        drop scan_channel_await(x, sid, raw stmt_cond(s), 128i32);
    }
    if (raw stmt_carries_expr(s.kind)) {
        drop scan_channel_await(x, sid, raw stmt_expr(s), 128i32);
    }
    if (s.kind == StmtKind.StmtPassStmt) {
        drop scan_channel_await(x, sid, raw stmt_operand(s), 128i32);
    }
    if (s.kind == StmtKind.StmtReturnStmt) {
        drop scan_channel_await(x, sid, raw stmt_operand(s), 128i32);
    }
    if (s.kind == StmtKind.StmtVarDeclStmt) {
        if (raw exprtypes_crossing(x.et, sid.index)) {
            int32:dty = raw resolve_type(x.tr, raw stmt_decl_type(s), x.scope);
            LlType:ll = raw ll_type(x.fe.ctx, dty);
            if (!(raw ll_is_ok(ll))) {
                pass (raw iv_from_ll_at(x, ll, dty, s.span));
            }
            drop fnem_cross_add(x.fe, sid.index, 0i32, dty, move(ll.text));
        }
        pass (raw scan_expr(x, raw stmt_decl_init(x.ast, s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtAssignStmt) {
        IrVal:ra = raw scan_expr(x, raw stmt_target(s), fuel - 1i32);
        if (!(raw iv_is_ok(ra))) { pass ra; }
        pass (raw scan_expr(x, raw stmt_assigned(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtPassStmt) {
        pass (raw scan_expr(x, raw stmt_operand(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtFailStmt) {
        pass (raw scan_expr(x, raw stmt_operand(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtReturnStmt) {
        pass (raw scan_expr(x, raw stmt_operand(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtExitStmt) {
        pass (raw scan_expr(x, raw stmt_expr(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtBlockStmt) {
        int32:i = 0i32;
        while (i < (raw stmt_list_count(s))) {
            IrVal:r = raw scan_crossing(x, StmtId{ index: raw ast_id_at(x.ast,
                          raw stmt_list_start(s), i) }, fuel - 1i32);
            if (!(raw iv_is_ok(r))) { pass r; }
            i = i + 1i32;
        }
        pass (raw iv_nil());
    }
    if (s.kind == StmtKind.StmtIfStmt) {
        IrVal:r0 = raw scan_expr(x, raw stmt_cond(s), fuel - 1i32);
        if (!(raw iv_is_ok(r0))) { pass r0; }
        IrVal:r1 = raw scan_crossing(x, raw stmt_then(s), fuel - 1i32);
        if (!(raw iv_is_ok(r1))) { pass r1; }
        pass (raw scan_crossing(x, raw stmt_else(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        IrVal:rw = raw scan_expr(x, raw stmt_cond(s), fuel - 1i32);
        if (!(raw iv_is_ok(rw))) { pass rw; }
        pass (raw scan_crossing(x, raw stmt_body(x.ast, s), fuel - 1i32));
    }
    // LOOP STATE IS FRAME-RESIDENT IN A COROUTINE, uniformly (stage D2): the
    // counter, the limit, the step and direction, the base pointer, the
    // binding — every value a loop head re-reads each iteration. An SSA copy
    // or an alloca would die at a suspension inside the body; framing them
    // unconditionally means no detector exists for the emitter's needs to
    // drift from. Roles: 1 counter/index, 2 limit/hi/len, 3 base/receiver,
    // 4 the `for` binding, 5 step, 6 direction.
    if (s.kind == StmtKind.StmtForStmt) {
        ExprId:fiter = raw stmt_for_iter(x.ast, s);
        int32:fitid = raw exprtypes_get(x.et, fiter);
        int32:fik = raw type_kind(x.fe.ctx.types, fitid);
        DeclNode:fbind = raw ast_decl(x.ast, raw stmt_for_binding(s));
        int32:fbtid = raw resolve_type(x.tr, raw param_type(fbind), x.scope);
        LlType:fbll = raw ll_type(x.fe.ctx, fbtid);
        if (!(raw ll_is_ok(fbll))) {
            pass (raw iv_from_ll_at(x, fbll, fbtid, s.span));
        }
        drop fnem_cross_add(x.fe, sid.index, 4i32, fbtid, raw string_concat(fbll.text, ""));
        IrVal:rfi = raw scan_expr(x, fiter, fuel - 1i32);
        if (!(raw iv_is_ok(rfi))) { pass rfi; }
        if (fik == (raw TY_RANGE())) {
            drop fnem_cross_add(x.fe, sid.index, 2i32, fbtid, move(fbll.text));
        }
        if (fik == (raw TY_SLICE())) {
            drop fnem_cross_add(x.fe, sid.index, 1i32, 0i32, "i64");
            drop fnem_cross_add(x.fe, sid.index, 2i32, 0i32, "i64");
            drop fnem_cross_add(x.fe, sid.index, 3i32, 0i32, "ptr");
        }
        if (fik == (raw TY_ARRAY())) {
            drop fnem_cross_add(x.fe, sid.index, 1i32, 0i32, "i64");
            drop fnem_cross_add(x.fe, sid.index, 2i32, 0i32, "i64");
            drop fnem_cross_add(x.fe, sid.index, 3i32, 0i32, "ptr");
        }
        if (fik == (raw TY_POINTER())) {
            drop fnem_cross_add(x.fe, sid.index, 3i32, 0i32, "ptr");
        }
        if (raw iterator_impl_of(x, fitid) != 0i32) {
            drop fnem_cross_add(x.fe, sid.index, 3i32, 0i32, "ptr");
        }
        pass (raw scan_crossing(x, raw stmt_for_body(x.ast, s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        // The `when` tracking flag persists across iterations — framed too.
        drop fnem_cross_add(x.fe, sid.index, 1i32, 0i32, "i8");
        IrVal:rwc = raw scan_expr(x, raw stmt_cond(s), fuel - 1i32);
        if (!(raw iv_is_ok(rwc))) { pass rwc; }
        IrVal:r2 = raw scan_crossing(x, raw stmt_when_body(x.ast, s), fuel - 1i32);
        if (!(raw iv_is_ok(r2))) { pass r2; }
        IrVal:r3 = raw scan_crossing(x, raw stmt_when_then(x.ast, s), fuel - 1i32);
        if (!(raw iv_is_ok(r3))) { pass r3; }
        pass (raw scan_crossing(x, raw stmt_when_end(x.ast, s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtLoopStmt) {
        drop scan_counted_slots(x, sid);
        IrVal:rl = raw scan_counted_args(x, s, fuel);
        if (!(raw iv_is_ok(rl))) { pass rl; }
        pass (raw scan_crossing(x, raw stmt_counted_body(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtTillStmt) {
        drop scan_counted_slots(x, sid);
        IrVal:rt = raw scan_counted_args(x, s, fuel);
        if (!(raw iv_is_ok(rt))) { pass rt; }
        pass (raw scan_crossing(x, raw stmt_counted_body(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtPickStmt) {
        IrVal:rs = raw scan_expr(x, raw pick_selector(s), fuel - 1i32);
        if (!(raw iv_is_ok(rs))) { pass rs; }
        drop scan_pick_binds(x, raw exprtypes_get(x.et, raw pick_selector(s)),
                             raw pick_arm_start(s), raw pick_arm_count(s));
        int32:j = 0i32;
        while (j < (raw pick_arm_count(s))) {
            IrVal:r4 = raw scan_crossing(x, StmtId{ index: raw ast_id_at(x.ast,
                           raw pick_arm_start(s), j) }, fuel - 1i32);
            if (!(raw iv_is_ok(r4))) { pass r4; }
            j = j + 1i32;
        }
        pass (raw iv_nil());
    }
    if (s.kind == StmtKind.StmtPickArm) {
        IrVal:rg = raw scan_expr(x, raw arm_guard(s), fuel - 1i32);
        if (!(raw iv_is_ok(rg))) { pass rg; }
        pass (raw scan_crossing(x, raw arm_body(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtDeferStmt) {
        pass (raw scan_crossing(x, StmtId{ index: s.a }, fuel - 1i32));
    }
    if (raw stmt_carries_expr(s.kind)) {
        pass (raw scan_expr(x, raw stmt_expr(s), fuel - 1i32));
    }
    pass (raw iv_nil());
};

// A counted loop's bound expressions, scanned for hidden value-picks.
func:scan_counted_args = IrVal(ExprEmitter->:x, StmtNode:s, int32:fuel) never fails {
    int32:n = raw stmt_counted_argc(x.ast, s);
    int32:i = 0i32;
    while (i < n) {
        IrVal:r = raw scan_expr(x, raw stmt_counted_arg(x.ast, s, i), fuel - 1i32);
        if (!(raw iv_is_ok(r))) { pass r; }
        i = i + 1i32;
    }
    pass (raw iv_nil());
};

func:emit_function_body_subst = IrVal(ExprEmitter->:x, DeclId:did, DeclNode:d,
                                      int32:mangled_name, GenericScope:g,
                                      bool:specialize) never fails {
    bool:fn_async = raw decl_has(d, raw DECL_ASYNC());
    // LIVE-1's repair (0.9.0): a `requires`/`ensures` the backend never read
    // compiled to a function that claims a contract nothing enforces — the
    // observed defect was a `requires b != 0i32` body emitting a bare `sdiv`.
    // `acquires` is NOT refused: the lock-level analysis (0.5.6) enforces it
    // statically and completely, so it owes emission nothing.
    int32:ci = 0i32;
    int32:ccount = raw fn_contract_count(x.ast, d);
    while (ci < ccount) {
        VerifyNode:cv = raw ast_verify(x.ast, raw fn_contract(x.ast, d, ci));
        // `never fails` (D-163) is NOT a 1.4 contract: it is checked entirely
        // by the frontend and changes no emitted byte — the backend owes it
        // nothing, so it passes through where `requires`/`ensures` still rung.
        if (cv.kind != VerifyKind.VerifyNeverFails) {
            // `joins <const Duration>` (D-181) is read by the THREAD SPAWN,
            // not by the body — it states the executor's join deadline, and
            // the body owes it nothing.
            if (cv.kind != VerifyKind.VerifyJoinsWithin) {
                // `gives` (D-183, 1.2.6) is read by the CALL SITES — the
                // caller stashes the returned channels — and by this
                // function's own `channel()` lowerings, which register no
                // reclaim. The body owes it nothing beyond that bit.
                if (cv.kind != VerifyKind.VerifyGives) {
                    if (cv.a != (raw CONTRACT_ACQUIRES())) {
                        pass (raw iv_rung("a `requires`/`ensures` contract", "1.5", cv.span));
                    }
                }
            }
        }
        ci = ci + 1i32;
    }

    int32:name = raw decl_name(d);
    string:fname = raw intern_get(x.interns, name);
    // A SPECIALIZATION CARRIES ITS INSTANTIATED NAME (1.0.2b) —
    // `extract<int32>`, the D-108 spelling — so two instantiations of one
    // declaration are two symbols. 0 means "not a specialization".
    if (mangled_name != 0i32) {
        fname = raw intern_get(x.interns, mangled_name);
    }
    FnSig:sg = raw fn_signature(x.tr, did, name, x.scope);
    int32:succ = sg.success;
    if (specialize) {
        succ = raw type_subst(x.tr, succ, g, d.span, 64i32, x.fe.ctx.impls);
    }

    LlType:rt = raw fnem_begin(x.fe, fname, did.index, succ);
    if (!(raw ll_is_ok(rt))) { pass (raw iv_from_ll_at(x, rt, sg.success, d.span)); }
    x.fe.is_gives = raw fn_declares_gives(x.ast, d);
    if (fn_async) {
        // THE COROUTINE (D-177): same walk, different skeleton. The seam
        // (`fnem_ret_agg`), the frame-resident parameters and the entry
        // switch are all inside fnem; the body emission below is unchanged.
        x.fe.is_async = true;
        x.fe.frame_ty = raw frame_ty_sym(x.fe.ctx, did.index, fname);
        x.fe.resume_sym = raw resume_fn_sym(x.fe.ctx, did.index, fname);
        // The join's stamp site (D-179): the function itself.
        x.fe.fn_site = raw x_site(x, d.span);
        // The crossing pre-scan (stage D), under the same instantiation
        // binding the body will use — the frame type is fixed at open, so
        // the slots must be known now.
        GenericScope:cssaved = x.tr.generics;
        GenericScope:cesaved = x.tr.enclosing;
        if (specialize) {
            x.tr.generics = g;
            x.tr.enclosing = g;
        }
        IrVal:cs = raw scan_crossing(x, raw fn_body(x.ast, d), 256i32);
        x.tr.generics = cssaved;
        x.tr.enclosing = cesaved;
        if (!(raw iv_is_ok(cs))) { pass cs; }
    }

    int32:i = 0i32;
    int32:n = raw fn_param_count(x.ast, d);
    while (i < n) {
        DeclNode:pd = raw ast_decl(x.ast, raw fn_param(x.ast, d, i));
        // A parameter's `limit` is the same dropped guarantee (LIVE-1).
        VerifyId:plim = raw param_limit(pd);
        if (!(raw verify_is_none(plim))) {
            pass (raw iv_rung("a `limit<Rules>` constraint", "1.5", pd.span));
        }
        // UNDER THE INSTANTIATION'S BINDING (1.0.2b): `T:x` resolves to the
        // argument, not to "there is no type named T". The scope is pushed
        // here rather than around `fn_signature`, which rebinds the
        // declaration's parameters unbound by design (D-107).
        GenericScope:psaved = x.tr.generics;
        GenericScope:pesaved = x.tr.enclosing;
        // BOTH SLOTS (1.0.4b). A generic FUNCTION's parameters are its own
        // (`generics`); a family IMPL's method is generic in its impl's, which
        // `generic_lookup` reaches through `enclosing` — the same slot
        // `bind_blanket` sets on the checking side. Pushing both is what makes
        // one emitter serve both shapes.
        if (specialize) {
            x.tr.generics = g;
            x.tr.enclosing = g;
        }
        int32:pt = raw resolve_type(x.tr, raw param_type(pd),
                       raw symtab_home_scope(x.tab, did.index, x.scope));
        x.tr.generics = psaved;
        x.tr.enclosing = pesaved;
        if (specialize) {
            pt = raw type_subst(x.tr, pt, g, pd.span, 64i32, x.fe.ctx.impls);
        }
        LlType:pl = raw fnem_param(x.fe, raw decl_name(pd), pt,
                        ((raw param_quals(pd)) & (raw QUAL_MOVE())) != 0i32);
        if (!(raw ll_is_ok(pl))) { pass (raw iv_from_ll_at(x, pl, pt, pd.span)); }
        i = i + 1i32;
    }

    // THE VARIADIC COLLECTOR IS ONE MORE PARAMETER (1.1.13-close): the spec's
    // whole rule — "`..*T[]:name` is a typed slice, and a variadic call lowers
    // to building one" — so the callee's side is exactly a `{ ptr, i64 }`
    // slice binding, and sync/async ride the same fnem machinery every other
    // parameter uses. The CALL side gathers (or `..^`-spreads) the tail.
    DeclId:vspec = raw fn_variadic(x.ast, d);
    if (!(raw decl_is_none(vspec))) {
        DeclNode:vn = raw ast_decl(x.ast, vspec);
        GenericScope:vsaved = x.tr.generics;
        GenericScope:vesaved = x.tr.enclosing;
        if (specialize) {
            x.tr.generics = g;
            x.tr.enclosing = g;
        }
        int32:vt = raw resolve_type(x.tr, raw variadic_type(vn),
                       raw symtab_home_scope(x.tab, did.index, x.scope));
        x.tr.generics = vsaved;
        x.tr.enclosing = vesaved;
        if (specialize) {
            vt = raw type_subst(x.tr, vt, g, vn.span, 64i32, x.fe.ctx.impls);
        }
        LlType:vl = raw fnem_param(x.fe, raw decl_name(vn), vt, false);
        if (!(raw ll_is_ok(vl))) { pass (raw iv_from_ll_at(x, vl, vt, vn.span)); }
    }

    drop fnem_open(x.fe);
    // The BODY too: a local `T:tmp = x;` inside a generic resolves against the
    // instantiation, and every expression's recorded type already is the
    // substituted one (the checker typed the body once with `T` opaque, and the
    // emitter reads recorded types for expressions — only ANNOTATIONS resolve
    // here, which is what this binding serves).
    GenericScope:bsaved = x.tr.generics;
    GenericScope:besaved = x.tr.enclosing;
    if (specialize) {
        x.tr.generics = g;
        x.tr.enclosing = g;
    }
    IrVal:b = raw emit_block(x, raw fn_body(x.ast, d));
    x.tr.generics = bsaved;
    x.tr.enclosing = besaved;
    if (!(raw iv_is_ok(b))) { pass b; }
    drop fnem_close(x.fe, x.fe.terminated);
    if (fn_async) {
        if (x.fe.bare) {
            // `async main`: the resume function above answered to
            // `npk.resume.main`; the linkable `@main` is the entry shim.
            drop fnem_emit_main_shim(x.fe);
        }
    }
    pass (raw iv_nil());
};
