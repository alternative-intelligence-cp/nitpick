// A Nitpick type, as LLVM type text.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.7.2.
//
// THE SEED IS THE REFERENCE, NOT AN INFLUENCE. `bootstrap/generator/ntypes.py`
// answers this same question for the compiler that builds stage 1, and stage 1
// builds stage 2 — so the two compilers' IR meets at every runtime symbol and
// every aggregate that crosses between them. `llc` rejects a caller whose struct
// disagrees with the callee's by one field, which is how the runtime's own header
// records the mismatch being caught the first time.
//
// Every text below is therefore quoted from `ntypes.llvm()` rather than derived
// again, and `check_ll_types_agree` in the harness diffs the two lists on every
// run — the same technique `tests/frontend/type_layout.npk` uses for SIZES,
// applied to the text.
//
// WHETHER A TYPE LOWERS AND WHAT IT LOWERS TO ARE TWO QUESTIONS. A function
// returning just a string would have to spell "no answer" as some string, and
// `NIL` already lowers to `void` — a real answer that reads like an absence. So
// the result carries a STATE, and there are three of them rather than two:
//
//   LL_OK      it lowers; `text` is the answer
//   LL_RUNG    valid Nitpick that no rung lowers yet; `rung` names the cycle
//   LL_BROKEN  not a type the emitter can be asked about at all
//
// The third is not fussiness. `TY_INVALID` means resolution already failed and
// said so; `TY_COMPTIME` is a VALUE standing in a type-argument window and was
// never a type. Reporting either as "enabled by cycle 1.0" would be a sentence
// that is not true, offered to somebody trying to fix their program.

mod:ir_types;

use "../../frontend/source_location.npk".*;   // span_none, for the late substitution
use "../../frontend/intern.npk".*;
use "../../frontend/ast_kind.npk".*;
use "../../frontend/ast.npk".*;
use "../../frontend/parse_decl.npk".*;
use "../../frontend/types.npk".*;
use "../../frontend/type_names.npk".*;   // type_display, for D-156's method names
use "../../frontend/type_trait.npk".*;   // ImplTable, for D-164 normalisation
use "../../frontend/resolve_type.npk".*;
use "../../frontend/symbols.npk".*;
use "../../frontend/type_layout.npk".*;
use "../../frontend/type_generic.npk".*;

pub func:LL_OK = int32() never fails     { pass 0i32; };
pub func:LL_RUNG = int32() never fails   { pass 1i32; };
pub func:LL_BROKEN = int32() never fails { pass 2i32; };

pub struct:LlType = {
    int32:state;
    string:text;     // meaningful when LL_OK
    string:rung;     // meaningful when LL_RUNG
};

pub func:ll_ok = LlType(move string:text) never fails {
    LlType:t = LlType{ state: raw LL_OK(), text: move(text), rung: "" };
    pass t;
};

func:ll_rung = LlType(move string:rung) never fails {
    LlType:t = LlType{ state: raw LL_RUNG(), text: "", rung: move(rung) };
    pass t;
};

func:ll_broken = LlType() never fails {
    LlType:t = LlType{ state: raw LL_BROKEN(), text: "", rung: "" };
    pass t;
};

pub func:ll_is_ok = bool(LlType:t) never fails { pass (t.state == (raw LL_OK())); };

// WHAT THE EMITTER NEEDS TO ASK A TYPE. Three tables rather than three parameters
// threaded through every recursive call: the type table for the kind, the AST for
// an enum's variants, and the interns for a named type's spelling.
pub struct:LlCtx = {
    Ast->:ast;
    TypeTable->:types;
    InternTable->:interns;

    // decl index -> interned CANONICAL MODULE NAME (D-156). Zero means "no
    // module" -- a runtime symbol or the fallback. Built by emit_program after
    // the graph exists; a null map (mod_n == 0) leaves every symbol on the
    // pre-scheme `@npk_<name>` path, which is what keeps `llctx_init` callable
    // by the type-header tests that have no graph.
    wild int32->:mod_of;
    int32:mod_n;

    // THE SPECIALIZATION BEING EMITTED, or counts of 0 (1.0.4c). A generic
    // body's EXPRESSIONS carry the types the checker recorded when it walked
    // the body with `T` opaque (D-107) — so `self.v != other.v` on a
    // `Box<T>`'s field reaches lowering as a bare `T`, which has no
    // representation. Annotations are substituted by the resolver during
    // emission (1.0.2b); this is the other half, and it belongs HERE because
    // `ll_type` is the one place a parameter would otherwise become a rung.
    int32:subst_params_start;
    int32:subst_params_count;
    int32:subst_args_start;

    // (self type, trait) -> the vtable's symbol, interned (1.0.5c). Built by a
    // pre-pass over every impl, for the same reason `mod_of` is: the place that
    // NEEDS the name is not the place that can derive it. A `dyn` construction
    // knows the concrete type and the traits and nothing about the impl — and
    // the vtable is named in the IMPL's module (D-156), which the construction
    // site has no way to reach. Emitting impls first is not an option either:
    // impls and functions interleave in module order, so a function that builds
    // a `dyn` can be emitted before the impl it needs.
    // A RESOLVER, or NULL — needed only to answer what an impl bound an
    // associated type to, which takes resolving the binding's own annotation in
    // the impl's scope. Carried rather than passed because `ll_type` recurses,
    // and a projection can be nested (`T.Item[]`): normalising outside the walk
    // would only reach the top level.
    wild TypeResolver->:tr;

    // THE IMPL TABLE, or NULL. The backend re-substitutes a specialization's
    // signature when it emits one, and `T.Item` becomes what the impl bound
    // during substitution (D-164) — so the emitter needs the same table the
    // checker used, or an associated type survives to lowering and fails closed.
    // Learned by watching exactly that happen.
    wild ImplTable->:impls;

    wild int32->:vt_self;
    wild int32->:vt_trait;
    wild int32->:vt_sym;
    int32:vt_count;
    int32:vt_cap;

    // THE TYPES A DROP WAS EMITTED FOR (D-183, 1.2.1), recorded on demand at
    // the call sites and emitted as bodies after the module's functions. A
    // registry rather than a sweep over the type table: only types actually
    // dropped need a function, and a type nothing drops may not have its
    // named aggregate defined at all — emitting a body for it would reference
    // a type llc has never seen. Grows while the bodies are emitted, because a
    // struct's drop calls its fields' drops, so the emission loop re-reads the
    // count exactly as the generic-instance loop does.
    wild int32->:drop_types;
    int32:drop_count;
    int32:drop_cap;
};

pub func:llctx_init = LlCtx(Ast->:ast, TypeTable->:types, InternTable->:interns) never fails {
    int64:vn = 16i64;
    LlCtx:c = LlCtx{ ast: ast, types: types, interns: interns,
                     mod_of: NULL, mod_n: 0i32,
                     subst_params_start: 0i32, subst_params_count: 0i32,
                     subst_args_start: 0i32, impls: NULL, tr: NULL,
                     vt_self: (alloc(vn * #size_of<int32>())) =>! wild int32->,
                     vt_trait: (alloc(vn * #size_of<int32>())) =>! wild int32->,
                     vt_sym: (alloc(vn * #size_of<int32>())) =>! wild int32->,
                     vt_count: 0i32, vt_cap: vn =>! int32,
                     drop_types: (alloc(vn * #size_of<int32>())) =>! wild int32->,
                     drop_count: 0i32, drop_cap: vn =>! int32 };
    pass c;
};

// THE DROP SYMBOL for a type, and the registration that guarantees a body.
// Idempotent: a type dropped in forty scopes is emitted once.
pub func:drop_fn_sym = string(LlCtx->:c, int32:dty) never fails {
    if (c.drop_count >= c.drop_cap) {
        int32:nc = c.drop_cap * 2i32;
        c.drop_types = (ralloc(c.drop_types =>! wild int8->,
                               (nc => int64) * #size_of<int32>())) =>! wild int32->;
        c.drop_cap = nc;
    }
    bool:seen = false;
    int32:i = 0i32;
    while (i < c.drop_count) {
        if (c.drop_types[i => int64] == dty) { seen = true; }
        i = i + 1i32;
    }
    if (!seen) {
        c.drop_types[c.drop_count => int64] = dty;
        c.drop_count = c.drop_count + 1i32;
    }
    pass (raw string_concat("@\"npk.drop.",
              raw string_concat(raw int_to_string(dty => int64), "\"")));
};

pub func:drop_type_count = int32(LlCtx->:c) never fails { pass c.drop_count; };
pub func:drop_type_at = int32(LlCtx->:c, int32:i) never fails {
    pass (c.drop_types[i => int64]);
};

// Record one impl's table. Called by the pre-pass; the emitter reads it back
// when it builds a `dyn`.
pub func:vtmap_add = NIL(LlCtx->:c, int32:self_ty, int32:trait_ty, int32:sym) never fails {
    if (c.vt_count >= c.vt_cap) {
        int32:nc = c.vt_cap * 2i32;
        int64:sz = (nc => int64) * #size_of<int32>();
        c.vt_self = (ralloc(c.vt_self =>! wild int8->, sz)) =>! wild int32->;
        c.vt_trait = (ralloc(c.vt_trait =>! wild int8->, sz)) =>! wild int32->;
        c.vt_sym = (ralloc(c.vt_sym =>! wild int8->, sz)) =>! wild int32->;
        c.vt_cap = nc;
    }
    c.vt_self[c.vt_count => int64] = self_ty;
    c.vt_trait[c.vt_count => int64] = trait_ty;
    c.vt_sym[c.vt_count => int64] = sym;
    c.vt_count = c.vt_count + 1i32;
    pass NIL;
};

// The table for this (type, trait), or 0. Coherence makes the pair unique
// program-wide (TRAITS_REFERENCE 4.1), so the first match is the only one.
pub func:vtmap_find = int32(LlCtx->:c, int32:self_ty, int32:trait_ty) never fails {
    int32:i = 0i32;
    while (i < c.vt_count) {
        if (c.vt_self[i => int64] == self_ty) {
            if (c.vt_trait[i => int64] == trait_ty) {
                pass (c.vt_sym[i => int64]);
            }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// Bind a specialization's parameters while its body is emitted; counts of 0
// clear it. Saved and restored by the caller, like every other emission scope.
pub func:llctx_set_subst = NIL(LlCtx->:c, int32:params_start,
                               int32:params_count, int32:args_start) never fails {
    c.subst_params_start = params_start;
    c.subst_params_count = params_count;
    c.subst_args_start = args_start;
    pass NIL;
};

pub func:llctx_set_impls = NIL(LlCtx->:c, wild ImplTable->:t,
                               wild TypeResolver->:r) never fails {
    c.impls = t;
    c.tr = r;
    pass NIL;
};

pub func:llctx_set_modmap = NIL(LlCtx->:c, wild int32->:m, int32:n) never fails {
    c.mod_of = m;
    c.mod_n = n;
    pass NIL;
};

// The canonical module name for a declaration, or "" when there is none
// (D-156). "" routes the caller to the pre-scheme fallback.
pub func:mod_canonical = string(LlCtx->:c, int32:decl_index) never fails {
    if (c.mod_n == 0i32)         { pass ""; }
    if (decl_index < 0i32)       { pass ""; }
    if (decl_index >= c.mod_n)   { pass ""; }
    int32:ci = c.mod_of[decl_index => int64];
    if (ci == 0i32)              { pass ""; }
    pass (raw intern_get(c.interns, ci));
};

// `@"npk.<module>.<name>"` for a function, quoted (the spelling embeds `<`,
// spaces and commas for instantiations). main keeps `@main` and failsafe
// `@npk_failsafe` -- the two functions outside the Result regime (D-013) are
// the two outside the scheme. A declaration with no module falls back to the
// pre-scheme `@npk_<name>`: builtins and runtime symbols reach ir_symbol
// through the rt table, not here, so the fallback is only ever hit by a
// symbol the modmap did not cover, which stays linkable.
pub func:mangled_fn_sym = string(LlCtx->:c, int32:decl_index, string:name) never fails {
    if (raw string_eq(name, "main"))     { pass "@main"; }
    if (raw string_eq(name, "failsafe")) { pass "@npk_failsafe"; }
    string:canon = raw mod_canonical(c, decl_index);
    if (canon.len == 0i64) {
        pass (raw string_concat("@npk_", name));
    }
    string:body = raw string_concat("npk.",
                      raw string_concat(canon,
                          raw string_concat(".", name)));
    pass (raw string_concat("@\"",
              raw string_concat(body, "\"")));
};

// THE COROUTINE'S TWO DERIVED NAMES (D-177, 1.1.4), built from the same
// ingredients as `mangled_fn_sym` rather than parsed back out of its output —
// parsing a name to build a name is two spellings of one derivation. Both are
// always quoted: the body can embed `<`, spaces and commas for instantiations.
func:coro_body_name = string(LlCtx->:c, int32:decl_index, string:stem,
                             string:name) never fails {
    string:canon = raw mod_canonical(c, decl_index);
    if (canon.len == 0i64) {
        pass (raw string_concat(stem, name));
    }
    pass (raw string_concat(stem,
              raw string_concat(canon,
                  raw string_concat(".", name))));
};

pub func:resume_fn_sym = string(LlCtx->:c, int32:decl_index, string:name) never fails {
    string:body = raw coro_body_name(c, decl_index, "npk.resume.", name);
    pass (raw string_concat("@\"",
              raw string_concat(body, "\"")));
};

pub func:frame_ty_sym = string(LlCtx->:c, int32:decl_index, string:name) never fails {
    string:body = raw coro_body_name(c, decl_index, "npk.frame.", name);
    pass (raw string_concat("%\"",
              raw string_concat(body, "\"")));
};

// `%"npk.<module>.<Name>"` for a named aggregate. No name exceptions -- no
// type is named main or failsafe. The `%Name` fallback keeps a mapless
// context (the header tests) rendering as before.
pub func:mangled_type_name = string(LlCtx->:c, int32:decl_index, string:name) never fails {
    string:canon = raw mod_canonical(c, decl_index);
    if (canon.len == 0i64) {
        pass (raw string_concat("%", name));
    }
    string:body = raw string_concat("npk.",
                      raw string_concat(canon,
                          raw string_concat(".", name)));
    pass (raw string_concat("%\"",
              raw string_concat(body, "\"")));
};

// WHAT A GENERIC PARAMETER STANDS FOR IN THE SPECIALIZATION BEING EMITTED, or
// the parameter itself outside one. Factored out of `ll_type` at 1.0.6b because
// a second caller needs the substituted TYPE rather than its LLVM text: a method
// call through a bound has to name `IntBox:Producer.make`, and the receiver's
// recorded type is the parameter `P`.
pub func:subst_emitted_param = int32(LlCtx->:c, int32:id) never fails {
    if ((raw type_kind(c.types, id)) != (raw TY_PARAM())) { pass id; }
    int32:pd = raw type_decl_of(c.types, id);
    int32:pi = 0i32;
    while (pi < c.subst_params_count) {
        if ((raw ast_id_at(c.ast, c.subst_params_start, pi)) == pd) {
            pass (raw ast_id_at(c.ast, c.subst_args_start, pi));
        }
        pi = pi + 1i32;
    }
    pass id;
};

// DOES THIS TYPE MENTION A GENERIC PARAMETER anywhere in its structure? (1.0.7)
// A `List<T>` recorded for a literal inside `list_make<T>`'s body is
// template-shaped: it names the declaration's own parameter, and has no
// representation until the parameter is bound. Walked by kind, because each
// kind keeps its operands in different slots (the accessors above say which).
pub func:type_mentions_param = bool(TypeTable->:t, Ast->:ast, int32:id,
                                    int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    if (id == 0i32) { pass false; }
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_PARAM())) { pass true; }
    if (k == (raw TY_ASSOC())) {
        pass (raw type_mentions_param(t, ast, raw type_assoc_base(t, id), fuel - 1i32));
    }
    if (k == (raw TY_STRUCT())) { pass (raw args_mention_param(t, ast, id, fuel)); }
    if (k == (raw TY_ENUM()))   { pass (raw args_mention_param(t, ast, id, fuel)); }
    if (k == (raw TY_FUNC())) {
        if (raw type_mentions_param(t, ast, (raw tt_get(t, id)).a, fuel - 1i32)) {
            pass true;
        }
        int32:ps = (raw tt_get(t, id)).b;
        int32:pc = (raw tt_get(t, id)).c;
        int32:i = 0i32;
        while (i < pc) {
            if (raw type_mentions_param(t, ast, raw ast_id_at(ast, ps, i), fuel - 1i32)) {
                pass true;
            }
            i = i + 1i32;
        }
        pass false;
    }
    if (k == (raw TY_DYN()))    { pass false; }
    if (k == (raw TY_TRAIT()))  { pass false; }
    // Every remaining kind with an operand keeps it in slot `a`: pointer,
    // slice, array, `Optional`, `Result`, arena, shared arena, `Handle`, range.
    bool:has_elem = false;
    if (k == (raw TY_POINTER()))      { has_elem = true; }
    if (k == (raw TY_SLICE()))        { has_elem = true; }
    if (k == (raw TY_ARRAY()))        { has_elem = true; }
    if (k == (raw TY_OPTIONAL()))     { has_elem = true; }
    if (k == (raw TY_RESULT()))       { has_elem = true; }
    if (k == (raw TY_ARENA()))        { has_elem = true; }
    if (k == (raw TY_SHARED_ARENA())) { has_elem = true; }
    if (k == (raw TY_HANDLE()))       { has_elem = true; }
    if (k == (raw TY_RANGE()))        { has_elem = true; }
    // `atomic<T>` and `Channel<T, LEVEL, CAP>` keep their element in slot `a`
    // like the rest (1.1.10-D3). Added to the type system at 1.1.10-A/B and
    // missed here, which made `subst_emitted_type` answer "nothing to
    // substitute" for `Channel<J, …>`: the channel was then opened with `J`'s
    // size, and an unsubstituted parameter measures ZERO, so a generic pool
    // copied nothing into its ring and every job arrived blank. Nothing
    // failed; the values were simply zero.
    if (k == (raw TY_ATOMIC()))       { has_elem = true; }
    if (k == (raw TY_CHANNEL()))      { has_elem = true; }
    if (k == (raw TY_MUTEX()))        { has_elem = true; }
    if (k == (raw TY_GUARD()))        { has_elem = true; }
    if (k == (raw TY_RWLOCK()))       { has_elem = true; }
    if (k == (raw TY_RGUARD()))       { has_elem = true; }
    if (has_elem) {
        pass (raw type_mentions_param(t, ast, (raw tt_get(t, id)).a, fuel - 1i32));
    }
    pass false;
};

func:args_mention_param = bool(TypeTable->:t, Ast->:ast, int32:id, int32:fuel) never fails {
    int32:n = raw type_args_count_of(t, id);
    int32:start = raw type_args_start_of(t, id);
    int32:i = 0i32;
    while (i < n) {
        if (raw type_mentions_param(t, ast, raw ast_id_at(ast, start, i), fuel - 1i32)) {
            pass true;
        }
        i = i + 1i32;
    }
    pass false;
};

// WHAT A TYPE STANDS FOR IN THE SPECIALIZATION BEING EMITTED (1.0.7), or
// itself when it names no bound parameter, or when nothing is bound. A bare
// parameter, a parameter inside an instantiation's window, a parameter behind
// a pointer or in an array — one walk, `type_subst`'s, the one the frontend
// uses, so a type arrived at here is interned exactly as the checker would
// have interned it. The scope is the one `llctx_set_subst` holds — the same
// four numbers a `GenericScope` is.
pub func:subst_emitted_scope = GenericScope(LlCtx->:c) never fails {
    GenericScope:g = GenericScope{ params_start: c.subst_params_start,
                                   params_count: c.subst_params_count,
                                   args_start: c.subst_args_start,
                                   args_count: c.subst_params_count };
    pass g;
};

pub func:subst_emitted_type = int32(LlCtx->:c, int32:id) never fails {
    if (c.subst_params_count == 0i32) { pass id; }
    if (c.tr == NULL) { pass id; }
    if (!(raw type_mentions_param(c.types, c.ast, id, 64i32))) { pass id; }
    pass (raw type_subst(c.tr, id, raw subst_emitted_scope(c), raw span_none(),
                           raw SUBST_FUEL_LL(), c.impls));
};

// --- the lowering -----------------------------------------------------------------


// WHAT MAY RIDE A CHANNEL AT THIS RUNG (D-072 §6.3, D-065). A channel hands its
// element to ANOTHER TASK, and D-065 is explicit that nothing moves by being
// passed — ownership transfers only where `move` is written. So an element that
// owns heap storage would arrive at the far side as a SECOND owner of the same
// body: `ch.send(s, dl)` on a `string` copies a pointer, and both sides then
// believe they hold it. Which of them frees it is the managed lowering's
// question (B-6), and it has no answer yet.
//
// So the rung transfers what it can transfer by copying the bytes: scalars, the
// index-shaped handles, pointer-free structs, and arrays of those. Everything
// else refuses by name. `tt_haspt` is layout's own answer to "can this struct
// hold an address" and is exactly the question here; 0 means layout never
// computed it, which is refused with the rest — an unasked question is not a
// no.
func:chan_elem_ok = bool(LlCtx->:c, int32:elem, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    int32:k = raw type_kind(c.types, elem);
    if (k == (raw TY_BOOL()))    { pass true; }
    if (k == (raw TY_INT()))     { pass true; }
    if (k == (raw TY_CHAR()))    { pass true; }
    if (k == (raw TY_FLOAT()))   { pass true; }
    if (k == (raw TY_TBB()))     { pass true; }
    if (k == (raw TY_KERNEL()))  { pass true; }
    if (k == (raw TY_ERROR()))   { pass true; }
    if (k == (raw TY_NIL()))     { pass true; }
    // An index and a generation, both ways: a `Handle<T>` into an arena the
    // runtime owns, and a channel endpoint — the shapes that exist BECAUSE
    // they cross a task boundary without carrying an address.
    if (k == (raw TY_HANDLE()))  { pass true; }
    if (k == (raw TY_CHANNEL())) { pass true; }
    // OWNING ELEMENTS RIDE (D-183, 1.2.5b — the 1.1.10-B rung retired). A
    // `string` and every owning aggregate transfer WHOLE under the send's
    // `move`: the body's pointer crosses with its ownership, the receiver's
    // drop frees it, and the heap's mutex (npkrt) is what made a
    // cross-thread free sound. What still refuses is a BORROW: a `T->`, a
    // slice, or anything holding one names storage that stays behind on the
    // sender's frame — `type_contains_borrow` is layout's transitive answer,
    // with `string`'s owned body excepted and `dyn` refused as erased.
    if (k == (raw TY_STRING()))  { pass true; }
    if (k == (raw TY_OPTIONAL())) {
        pass (raw chan_elem_ok(c, raw type_elem(c.types, elem), fuel - 1i32));
    }
    if (k == (raw TY_RESULT())) {
        pass (raw chan_elem_ok(c, raw type_elem(c.types, elem), fuel - 1i32));
    }
    if (k == (raw TY_ARRAY()))   {
        pass (raw chan_elem_ok(c, raw type_elem(c.types, elem), fuel - 1i32));
    }
    if (k == (raw TY_ENUM()))    {
        pass (!(raw type_contains_borrow(c.types, elem, fuel)));
    }
    if (k == (raw TY_STRUCT()))  {
        pass (!(raw type_contains_borrow(c.types, elem, fuel)));
    }
    // AN UNSUBSTITUTED PARAMETER IS NOT AN OWNING TYPE, it is an unknown, and
    // the question is asked again — with an answer — on every specialization.
    // `Channel<J, …>` inside `worker<J>` is the template's own signature, and
    // refusing it here refuses the template rather than any actual channel:
    // D-182's pool would not compile though every instantiation of it is
    // legal. The specialization is where an owning element is caught.
    if (k == (raw TY_PARAM()))   { pass true; }
    if (k == (raw TY_SELF()))    { pass true; }
    if (k == (raw TY_ASSOC()))   { pass true; }
    pass false;
};

pub func:ll_type = LlType(LlCtx->:c, int32:id) never fails {
    int32:k = raw type_kind(c.types, id);

    // Resolution already failed and already said so. Anything said here would be
    // a second diagnostic about one mistake.
    if (k == (raw TY_INVALID()))  { pass (raw ll_broken()); }

    // A `comptime` ARGUMENT IS NOT A TYPE (`Mutex<Config, 2>`'s `2`). It sits in a
    // type-argument window so the window stays positional, and asking it for a
    // representation is asking the wrong question rather than an early one.
    if (k == (raw TY_COMPTIME())) { pass (raw ll_broken()); }

    // `void` IS ONLY EVER A RETURN TYPE. A `NIL` never occupies storage — D-084
    // makes it genuinely zero-sized — and `Result<NIL>` is handled below as
    // `{i32}` rather than by wrapping this.
    if (k == (raw TY_NIL()))      { pass (raw ll_ok("void")); }

    // STORED AS A BYTE, and `i1` appears only inside a condition. A `bool` in a
    // struct that was `i1` would be one bit of a byte LLVM still allocates, and
    // two compilers could disagree about which bit.
    if (k == (raw TY_BOOL()))     { pass (raw ll_ok("i8")); }
    if (k == (raw TY_ERROR()))    { pass (raw ll_ok("i32")); }   // D-179: 4 bytes, not a number
    // D-182: `atomic<T>` IS `T`'s storage — same bytes, same alignment. What
    // an atomic changes is how it is ACCESSED, and that lives in the
    // operations, not in the layout.
    if (k == (raw TY_ATOMIC()))   { pass (raw ll_type(c, raw type_elem(c.types, id))); }
    // D-182: a channel ENDPOINT is a handle — an index and a generation —
    // not a pointer, which is what lets it cross a spawn.
    if (k == (raw TY_CHANNEL()))  {
        if (!(raw chan_elem_ok(c, raw type_elem(c.types, id), 8i32))) {
            pass (raw ll_rung("per-scope join machinery (C-22) for `dyn` elements — everything else that refuses here carries a BORROW: a `T->`, a slice, or a struct holding one names storage that stays behind on the sender's frame, and no move can carry a borrowed target across a task boundary. Owning elements — strings, owning aggregates — ride since D-183's 1.2.5b: the send's `move` transfers the body with its ownership, and the receiver's drop frees it"));
        }
        pass (raw ll_ok("{ i32, i32 }"));
    }

    if (k == (raw TY_STRING()))   { pass (raw ll_ok("{ ptr, i64, i64 }")); }

    // NUL-terminated, `{ptr, i64}`, and NO capacity (D-049): a `cstring` is never
    // grown and is not ours to free — `argv` comes from the kernel.
    if (k == (raw TY_CSTRING()))  { pass (raw ll_ok("{ ptr, i64 }")); }

    // THIN, ONE WORD, NO BOUNDS METADATA (D-038) — whatever it points at, which is
    // why this does not recurse and why `any->` lowers while bare `any` does not.
    if (k == (raw TY_POINTER()))  { pass (raw ll_ok("ptr")); }

    // The bounds live on the ARRAY type (D-070), which is what keeps a pointer one
    // word and makes a slice a separate type rather than a fatter pointer.
    if (k == (raw TY_SLICE()))    { pass (raw ll_ok("{ ptr, i64 }")); }

    // FIVE DISTINCT TYPES THAT ALL LOWER TO `i32` (D-042). They compare and they
    // do not add, and the type checker is what holds that line — to LLVM an `fd`
    // and a `pid` are the same thirty-two bits.
    if (k == (raw TY_KERNEL()))   { pass (raw ll_ok("i32")); }

    if (k == (raw TY_INT()))      { pass (raw ll_int_bits(raw type_int_bits(c.types, id))); }

    // `char8` IS A BYTE AND IS NOT AN INTEGER. The representation is shared and
    // the arithmetic is not (D-005); `char16` and `char32` wait for 0.9.
    // Every char width lowers (0.9.6); the semantic-type discipline — compare
    // and index, no arithmetic — is the checker's, as it always was for char8.
    if (k == (raw TY_CHAR())) {
        int32:cbits = raw type_int_bits(c.types, id);
        if (cbits == 8i32)  { pass (raw ll_ok("i8")); }
        if (cbits == 16i32) { pass (raw ll_ok("i16")); }
        if (cbits == 32i32) { pass (raw ll_ok("i32")); }
        pass (raw ll_broken());
    }

    // `tbb32` IS ADMITTED AS AN ERROR-CODE TYPE ONLY — assignment, comparison and
    // passing, never arithmetic. That one restriction is what keeps ERR,
    // stickiness and saturation (D-008) out of this rung entirely.
    if (k == (raw TY_TBB())) {
        // Every tbb width lowers as its carrier (0.9.3); the ARITHMETIC — ERR,
        // stickiness, saturation — is 0.9.5's and refuses at the operator.
        pass (raw ll_int_bits(raw type_int_bits(c.types, id)));
    }

    // `flt32`/`flt64` compute; `flt128` is STORAGE ONLY (D-143) — it lowers
    // so it can be held, passed, and returned, and the checker refuses every
    // operation on it, so no fp128 instruction is ever emitted.
    if (k == (raw TY_FLOAT())) {
        int32:fbits = raw type_int_bits(c.types, id);
        if (fbits == 32i32)  { pass (raw ll_ok("float")); }
        if (fbits == 64i32)  { pass (raw ll_ok("double")); }
        if (fbits == 128i32) { pass (raw ll_ok("fp128")); }
        pass (raw ll_broken());
    }

    // BARE `any` HAS NO REPRESENTATION and the frontend refuses it as a type
    // (`NITPICK-TYPE-003`, measured at 1.0.9). `any->` never reaches here: a
    // pointer is `ptr` without asking what it points at. Reaching this is a
    // broken promise, not a rung — "enabled by cycle 1.0" was never going to
    // be true of it (converted 1.0.9).
    if (k == (raw TY_ANY()))      { pass (raw ll_broken()); }

    // `Optional<T>` IS `{ i8, T }`, TAG FIRST (TYPE_REFERENCE §11.1; 1.0.7) — the
    // layout `tt_optional` interned, and compiler-known exactly as `Result<T>`
    // is, for the same reason: D-099 strikes its readable members, so a library
    // struct would have been a struct whose fields are not members. An `i8`
    // rather than an `i1` because a bit is not addressable.
    if (k == (raw TY_OPTIONAL())) {
        LlType:oel = raw ll_type(c, raw type_elem(c.types, id));
        if (oel.state != (raw LL_OK())) { pass oel; }
        pass (raw ll_ok(raw string_concat("{ i8, ",
                            raw string_concat(oel.text, " }"))));
    }

    // A TRAIT IS NOT A VALUE TYPE. `dyn Trait` is; the bare trait names a
    // contract and has no representation of its own. The checker refuses a
    // trait in every value position since 1.0.9 (`resolve_user_named`, unless
    // the caller asked for a trait through `resolve_trait_type`), so this is a
    // broken promise rather than the rung it was while `TY_DYN` below became
    // real at 1.0.5b.
    if (k == (raw TY_TRAIT()))    { pass (raw ll_broken()); }

    // `dyn A & B` — THE DATA WORD AND ONE VTABLE WORD PER TRAIT (D-159), in the
    // canonical bound order the frontend interned it with, so every word's slot
    // is a compile-time constant.
    //
    // THE SHAPE ALONE IS NOT ENOUGH, and lowering it alone was tried and
    // reverted at 1.0.5b's opening: with a real `{ ptr, ptr }` but no
    // construction, an assignment stored a 4-byte `Dog` into the 16-byte slot,
    // loaded 16 bytes back with 12 uninitialised, and called the CONCRETE method
    // directly with the result — returning the right answer, because the
    // struct's one field sits at offset 0. It landed here only once
    // `emit_dyn_from` and the dispatch path landed with it.
    if (k == (raw TY_DYN())) {
        int32:nb = raw type_dyn_count(c.types, id);
        string:dt = "{ ptr";
        int32:bi = 0i32;
        while (bi < nb) {
            dt = raw string_concat(dt, ", ptr");
            bi = bi + 1i32;
        }
        pass (raw ll_ok(raw string_concat(dt, " }")));
    }

    // `Self` IS SUBSTITUTED BEFORE IT IS LOWERED: a trait default is emitted
    // per implementing impl with `tr.self_type` bound (1.0.4), an impl method
    // with its target, and outside a trait or impl body the checker refuses
    // it outright (`NITPICK-TYPE-005`, measured at 1.0.9). A `Self` reaching
    // here is a substitution hole to fix, not a rung (converted 1.0.9).
    if (k == (raw TY_SELF()))     { pass (raw ll_broken()); }

    // AN ASSOCIATED TYPE IS WHAT THE IMPL BOUND (D-164). The signature is
    // normalised during substitution, but a generic BODY's expression types were
    // recorded with the parameter opaque (D-107) — so `it.next()` reaches here
    // carrying `T.Item`, exactly as `self.v` reached 1.0.4c carrying `T`. The
    // base is substituted through the specialization being emitted and the
    // impl's binding is the answer.
    //
    // STILL FAILS CLOSED when there is no answer: a projection nobody bound is a
    // missed normalisation, and a guessed representation would turn an accepted
    // program into a wrong one.
    if (k == (raw TY_ASSOC())) {
        if (c.tr != NULL) {
            int32:ab = raw subst_emitted_param(c, raw type_assoc_base(c.types, id));
            int32:bound = raw assoc_binding_of(c.tr, c.impls, ab,
                              raw type_assoc_trait(c.types, id),
                              raw type_assoc_name(c.types, id));
            if (bound != 0i32) { pass (raw ll_type(c, bound)); }
        }
        pass (raw ll_broken());
    }
    if (k == (raw TY_PARAM())) {
        // Inside a specialization the parameter IS its argument (1.0.4c);
        // outside one it is a template's type and has no representation —
        // and no template body is emitted (1.0.7 skips template-shaped
        // instances), so a bare parameter here is a missed substitution, not
        // a rung (converted 1.0.9).
        int32:sub = raw subst_emitted_param(c, id);
        if (sub != id) { pass (raw ll_type(c, sub)); }
        pass (raw ll_broken());
    }

    // `lo..hi` IS A TYPED VALUE (D-093): `{ T, T }`, ALWAYS HALF-OPEN — the
    // inclusive spelling was normalized away at construction (D-145), so no
    // consumer ever asks which kind it holds.
    if (k == (raw TY_RANGE())) {
        LlType:rel = raw ll_type(c, raw type_elem(c.types, id));
        if (rel.state != (raw LL_OK())) { pass rel; }
        string:ra = raw string_concat("{ ", rel.text);
        ra = raw string_concat(ra, ", ");
        ra = raw string_concat(ra, rel.text);
        ra = raw string_concat(ra, " }");
        pass (raw ll_ok(move(ra)));
    }

    // A FUNCTION VALUE. Closures are gone (D-018) and a function pointer is an
    // ordinary value with a `FuncType` spelling (D-087) — so it will lower to
    // `ptr` like every other pointer, once there is a rung that can CALL through
    // one. NO RUNG TABLE NAMED IT; 0.7.2 assigns it to 0.9 with the rest of full
    // type lowering, rather than leaving a type whose refusal has no cycle.
    if (k == (raw TY_FUNC()))          { pass (raw ll_ok("ptr")); }
    // A variadic function VALUE is the same one word (1.1.13-close): the
    // gathering happens at the CALL, where the checker-recorded ft says how
    // many parameters are fixed and what the collector's element is.
    if (k == (raw TY_FUNC_VARIADIC())) { pass (raw ll_ok("ptr")); }

    if (k == (raw TY_ARRAY()))    { pass (raw ll_array(c, id)); }
    if (k == (raw TY_RESULT()))   { pass (raw ll_result(c, id)); }
    if (k == (raw TY_ARENA()))    { pass (raw ll_ok("{ ptr, ptr, i64, i64, i64 }")); }
    if (k == (raw TY_HANDLE()))   { pass (raw ll_ok("{ i64, i32 }")); }
    if (k == (raw TY_SHARED_ARENA())) { pass (raw ll_ok("ptr")); }
    // A mutex and its guard are each ONE POINTER to the owned cell
    // (D-056, 1.1.11): [lock i32 | pad | waiters ptr | T at +16].
    if (k == (raw TY_MUTEX()))        { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_GUARD()))        { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_RWLOCK()))       { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_RGUARD()))       { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_CONDVAR()))      { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_BARRIER()))      { pass (raw ll_ok("ptr")); }
    // D-185: the owning descriptor IS the kernel's number; ownership is a
    // frontend fact (drop flag + generated drop), not a representation one.
    if (k == (raw TY_OWNEDFD()))      { pass (raw ll_ok("i32")); }
    // AN INSTANTIATION THAT NAMES THE PARAMETER BEING EMITTED (1.0.7). A
    // `List{ … }` literal inside `list_make<T>`'s body is recorded as `List<T>`
    // (D-107: the body is typed once with `T` opaque), and in the
    // specialization its name, its header and its layout are `List<int32>`'s.
    // `subst_emitted_param` answers for a bare `T`; this is the same answer for
    // a `T` inside an instance's argument window, walked by `type_subst`, which
    // re-interns the instance and RECORDS it — so an instance no annotation ever
    // named still gets its header, after the bodies (`emit_late_headers`).
    if (k == (raw TY_STRUCT())) {
        int32:si = raw subst_emitted_type(c, id);
        if (si != id) { pass (raw ll_type(c, si)); }
        pass (raw ll_named(c, id));
    }
    if (k == (raw TY_ENUM())) {
        int32:ei = raw subst_emitted_type(c, id);
        if (ei != id) { pass (raw ll_type(c, ei)); }
        pass (raw ll_enum(c, id));
    }

    // FAIL CLOSED ON A KIND NOBODY CLASSIFIED. A kind added without a case here
    // must refuse rather than fall through to something plausible — the whole
    // value of Phase A is that an accepted program is valid, and an emitter that
    // guesses turns that into a lie.
    pass (raw ll_broken());
};

// NATIVE `iN` AT EVERY WIDTH (0.9.3, D-011 — and this comment once said the
// opposite: "arrives with LBIM rather than as i128", the dead reading the
// audit caught contradicting D-011's own measurements). LLVM 20 lowers every
// operation at every width here natively: add/mul inline, i128 division via
// `__divti3`-family libcalls the runtime floor hand-writes, and division at
// 256 bits and beyond as inline expansion — an executed probe took `udiv
// i4096` through llc whole. Sub-byte widths (`int1/2/4`) have no layout and
// wait on decision G-2; they refuse rather than guess.
func:ll_int_bits = LlType(int32:bits) never fails {
    if (bits == 8i32)    { pass (raw ll_ok("i8")); }
    if (bits == 16i32)   { pass (raw ll_ok("i16")); }
    if (bits == 32i32)   { pass (raw ll_ok("i32")); }
    if (bits == 64i32)   { pass (raw ll_ok("i64")); }
    if (bits == 128i32)  { pass (raw ll_ok("i128")); }
    if (bits == 256i32)  { pass (raw ll_ok("i256")); }
    if (bits == 512i32)  { pass (raw ll_ok("i512")); }
    if (bits == 1024i32) { pass (raw ll_ok("i1024")); }
    if (bits == 2048i32) { pass (raw ll_ok("i2048")); }
    if (bits == 4096i32) { pass (raw ll_ok("i4096")); }
    // Sub-byte widths (`int1/2/4`): no layout exists, and decision G-2 owns
    // whether they get one or leave the grammar.
    pass (raw ll_rung("a later cycle (G-2)"));
};

// `[N x T]` — A VALUE TYPE THAT DOES NOT DECAY. Its element's refusal is its own:
// an array of something unlowerable is unlowerable, and reporting it as the array
// would name the wrong construct.
func:ll_array = LlType(LlCtx->:c, int32:id) never fails {
    LlType:el = raw ll_type(c, raw type_elem(c.types, id));
    if (el.state != (raw LL_OK())) { pass el; }
    string:a = raw string_concat("[",
                   raw int_to_string((raw type_array_count(c.types, id)) => int64));
    string:b = raw string_concat(a, " x ");
    string:d = raw string_concat(b, el.text);
    pass (raw ll_ok(raw string_concat(d, "]")));
};

// `{T, i32}` (D-069) — NO `is_error` FIELD, because `.is_error` is derived as
// `error != 0` and a stored flag would be a second place for one fact to live.
//
// `Result<NIL>` IS `{i32}` and not `{void, i32}`: `NIL` is zero-sized (D-084), and
// `void` is not a type LLVM will put in a struct.
func:ll_result = LlType(LlCtx->:c, int32:id) never fails {
    pass (raw ll_wrap_result(c, raw type_elem(c.types, id)));
};

// THE SAME RULE, KEYED ON THE INNER TYPE — because the wrap is usually IMPLICIT.
// Every function returns `Result<T>` while declaring `T` (D-069), so the emitter
// mostly holds a `T` with no interned `Result<T>` beside it. One body serving both
// spellings is what keeps "what does a Result look like" a single place.
pub func:ll_wrap_result = LlType(LlCtx->:c, int32:inner) never fails {
    if ((raw type_kind(c.types, inner)) == (raw TY_NIL())) {
        pass (raw ll_ok("{ i32 }"));
    }
    LlType:it = raw ll_type(c, inner);
    if (it.state != (raw LL_OK())) { pass it; }
    string:a = raw string_concat("{ ", it.text);
    pass (raw ll_ok(raw string_concat(a, ", i32 }")));
};

// A NAMED AGGREGATE PRINTS AS `%Name`, and its body is emitted once at module
// level — which is what makes a struct one definition rather than a shape repeated
// at every mention.
//
// AN INSTANTIATION LOWERS (1.0.2). Its name is MANGLED and contains `<`, which is
// what makes `Container<int32>` reversible by inspection for an auditor — and is
// not a BARE LLVM identifier, which is why this refused until D-156 put every
// symbol in quotes. `%"npk.mod.Container<int32>"` is legal and reversible, so the
// instance renders like any other named aggregate; what distinguishes it is the
// BODY, which substitutes (`ll_struct_body`).
func:ll_named = LlType(LlCtx->:c, int32:id) never fails {
    int32:nm = raw type_name(c.types, id);
    if (raw intern_is_none(nm)) { pass (raw ll_broken()); }
    pass (raw ll_ok(raw mangled_type_name(c, raw type_decl_of(c.types, id),
                        raw intern_get(c.interns, nm))));
};

// A PAYLOAD-LESS ENUM IS A PLAIN `i32` AND HAS NO DEFINITION AT ALL
// (TYPE_REFERENCE §9.3: "Enum values are plain i32 constants"). Only a tagged one
// is an aggregate, and SUBSET_1 §1.2's one-machine-word payload fixes its shape at
// `{i32, i64}` — uniform, with no max-payload sizing and no alignment puzzles.
func:ll_enum = LlType(LlCtx->:c, int32:id) never fails {
    if (!(raw enum_has_payload(c.ast, c.types, id))) { pass (raw ll_ok("i32")); }
    int32:nm = raw type_name(c.types, id);
    if (raw intern_is_none(nm)) { pass (raw ll_broken()); }
    pass (raw ll_ok(raw mangled_type_name(c, raw type_decl_of(c.types, id),
                        raw intern_get(c.interns, nm))));
};

// --- what the module preamble writes ------------------------------------------------
//
// The BODY behind a `%Name`, emitted once. A struct's is its fields in declaration
// order; a tagged enum's is the uniform word.

// A ZERO-FIELD STRUCT GETS AN `i8` BODY rather than `{}`. Two distinct empty
// structs must have distinct addresses, and `type {}` would place them on top of
// each other — the same reason the layout gives an empty struct one byte.
// Mirrors `type_generic`'s own SUBST_FUEL: a substituted instance has its own
// arguments substituted in turn, so the walk follows a type's structure and is
// bounded the same way the frontend bounds it.
pub func:SUBST_FUEL_LL = int32() never fails { pass 64i32; };

pub func:ll_struct_body = LlType(TypeResolver->:r, LlCtx->:c, int32:id,
                                 int32:scope) never fails {
    if ((raw type_kind(c.types, id)) != (raw TY_STRUCT())) { pass (raw ll_broken()); }

    DeclId:did = DeclId{ index: raw type_decl(c.types, id) };
    DeclNode:d = raw ast_decl(c.ast, did);

    // AN INSTANTIATION SUBSTITUTES ITS ARGUMENTS INTO EVERY FIELD (1.0.2).
    // `Container<int32>`'s body is the declaration's fields with `T` replaced —
    // monomorphization, done by the FRONTEND's own machinery rather than a
    // second idea of substitution living in the emitter.
    //
    // TWO THINGS ARE NEEDED, and `type_layout` (0.8.1) needs the same two for
    // the same reason. `r.generics` must carry the declaration's parameter
    // window bound to this instance's arguments, because a field's `T` resolves
    // through `generic_lookup` and NOT through any scope — a struct's parameters
    // are declared into no scope at all. And the field's annotation must resolve
    // AT HOME: it means what it meant where the struct was written.
    IdSpan:gp = raw decl_generic_window(c.ast, d);
    GenericScope:g = GenericScope{
        params_start: gp.start, params_count: gp.count,
        args_start: raw type_args_start_of(c.types, id),
        args_count: raw type_args_count_of(c.types, id) };
    GenericScope:saved = r.generics;
    r.generics = g;
    scope = raw symtab_home_scope(r.tab, did.index, scope);

    string:body = "";
    int32:n = 0i32;
    int32:i = 0i32;
    while (i < (raw item_member_count(c.ast, d))) {
        DeclId:mid = raw item_member(c.ast, d, i);
        DeclNode:m = raw ast_decl(c.ast, mid);
        if (m.kind == DeclKind.DeclFieldDecl) {
            int32:ft0 = raw resolve_type(r, raw field_type(m), scope);
            int32:ft = raw type_subst(r, ft0, g, m.span, raw SUBST_FUEL_LL(),
                            c.impls);
            LlType:ll = raw ll_type(c, ft);
            if (ll.state != (raw LL_OK())) {
                r.generics = saved;
                pass ll;
            }
            if (n > 0i32) { body = raw string_concat(body, ", "); }
            body = raw string_concat(body, ll.text);
            n = n + 1i32;
        }
        i = i + 1i32;
    }
    r.generics = saved;
    if (n == 0i32) { body = "i8"; }

    string:a = raw string_concat("{ ", body);
    pass (raw ll_ok(raw string_concat(a, " }")));
};

// THE PAYLOAD SLOT (0.9.2): `{ i32, [N x iK] }`, DERIVED from the layout the
// frontend already computed — K is the enum's stored alignment in bits, N
// covers the stored size past the tag. One computation (type_layout's enum
// arm, widest-variant sizing) and this derivation; a second walk here would be
// a second copy of one fact. `[N x i8]` would give the slot alignment 1 and an
// 8-byte payload would sit at odd addresses — the misalignment the audit
// caught in TYPE_REFERENCE §9.3's own example; making the element BE the
// alignment makes the alignment structural. Construction and binding never do
// this arithmetic — they address the slot with a typed getelementptr and
// store/load the variant's own type through the pointer.
pub struct:EnumSlot = {
    bool:ok;
    int32:kbits;
    int64:count;
};

pub func:enum_payload_slot = EnumSlot(LlCtx->:c, int32:id) never fails {
    EnumSlot:bad = EnumSlot{ ok: false, kbits: 0i32, count: 0i64 };
    int64:sz = raw type_size(c.types, id);
    int32:al = raw type_align(c.types, id);
    // FAIL CLOSED on a layout the table does not hold: a zero here becomes a
    // slot that cannot hold its payload, which is memory corruption wearing a
    // type annotation. Alignments past 8 arrive with i128 (0.9.3), which must
    // extend this derivation deliberately.
    if (sz <= 0i64)  { pass bad; }
    if (al <= 0i32)  { pass bad; }
    if (al > 16i32)  { pass bad; }
    int64:tag = raw align_up(4i64, al);
    int64:bytes = sz - tag;
    if (bytes <= 0i64) { pass bad; }
    EnumSlot:out = EnumSlot{ ok: true, kbits: al * 8i32,
                             count: bytes / (al => int64) };
    pass out;
};

pub func:ll_enum_body = LlType(LlCtx->:c, int32:id) never fails {
    if ((raw type_kind(c.types, id)) != (raw TY_ENUM())) { pass (raw ll_broken()); }
    // A payload-less enum has no body to ask for; the question itself is the
    // mistake (internal — every caller filters first).
    if (!(raw enum_has_payload(c.ast, c.types, id))) { pass (raw ll_broken()); }
    EnumSlot:sl = raw enum_payload_slot(c, id);
    if (!sl.ok) { pass (raw ll_broken()); }
    string:a = raw string_concat("{ i32, [",
                   raw int_to_string(sl.count));
    string:b = raw string_concat(a, " x i");
    string:d2 = raw string_concat(b, raw int_to_string(sl.kbits => int64));
    pass (raw ll_ok(raw string_concat(d2, "] }")));
};

// The ERR sentinel per tbb width, as decimal text (D-008: the most negative
// value of the carrier). ONE representation, shared by every site that spells
// it — the arithmetic saturation, the sentinel maps in casts, `is_err`, the
// `ERR` literal, and the `ERR:` pick arm — so no two sites can disagree about
// which bit pattern taint is.
pub func:tbb_min_decimal = string(int32:bits) never fails {
    if (bits == 8i32)   { pass "-128"; }
    if (bits == 16i32)  { pass "-32768"; }
    if (bits == 32i32)  { pass "-2147483648"; }
    if (bits == 64i32)  { pass "-9223372036854775808"; }
    if (bits == 128i32) { pass "-170141183460469231731687303715884105728"; }
    if (bits == 256i32) { pass "-57896044618658097711785492504343953926634992332820282019728792003956564819968"; }
    pass "";
};

// The widest VALID magnitude per tbb width — MIN's mirror, for the range
// checks the cast matrix emits.
pub func:tbb_max_decimal = string(int32:bits) never fails {
    if (bits == 8i32)   { pass "127"; }
    if (bits == 16i32)  { pass "32767"; }
    if (bits == 32i32)  { pass "2147483647"; }
    if (bits == 64i32)  { pass "9223372036854775807"; }
    if (bits == 128i32) { pass "170141183460469231731687303715884105727"; }
    if (bits == 256i32) { pass "57896044618658097711785492504343953926634992332820282019728792003956564819967"; }
    pass "";
};

// --- questions the emitter asks about a lowered type --------------------------------
//
// ASKED OF THE TEXT, NOT OF THE KIND. The seed's own note says why: "asking the
// question this way rather than listing type names means the answer cannot drift
// from what the emitter can actually lower". A payload-free enum is `i32` and
// passes; a tagged one is a struct and does not — and neither had to be listed.

// True when this lowered to a plain `iN`, which is exactly the set of types one
// LLVM instruction — `add`, `icmp`, `zext` — is valid over.
// The same question asked of a bare TYPE STRING (D-183's sweep): callers that
// hold `v.ll` needed to build a throwaway LlType — copying a lent string into
// a local that existed only to be asked this — so the text rule lives here and
// the LlType form delegates.
pub func:ll_text_is_scalar_int = bool(string:text) never fails {
    if (text.len < 2i64) { pass false; }
    if (text.ptr[0i64] != 105u8) { pass false; }   // 'i'
    int64:i = 1i64;
    while (i < text.len) {
        if (text.ptr[i] < 48u8) { pass false; }    // '0'
        if (text.ptr[i] > 57u8) { pass false; }    // '9'
        i = i + 1i64;
    }
    pass true;
};

pub func:ll_is_scalar_int = bool(LlType:t) never fails {
    if (t.state != (raw LL_OK())) { pass false; }
    pass (raw ll_text_is_scalar_int(t.text));
};



// The three float texts, asked of the TEXT like the neighbours above.
pub func:ll_is_float_text = bool(string:t) never fails {
    if (raw string_eq(t, "float"))  { pass true; }
    if (raw string_eq(t, "double")) { pass true; }
    if (raw string_eq(t, "fp128"))  { pass true; }
    pass false;
};

pub func:ll_is_pointer = bool(LlType:t) never fails {
    if (t.state != (raw LL_OK())) { pass false; }
    pass (raw string_eq(t.text, "ptr"));
};

// THE ZERO VALUE, for the value slot of a failed `Result` — every failure writes
// one, so this is on the path of every error in every program.
//
// Derived from the TEXT for the same reason as the two above: a table keyed by
// Nitpick kind would be a second list to keep in step with the first.
pub func:ll_zero = string(LlType:t) never fails {
    if (raw ll_is_scalar_int(t)) { pass "0"; }
    if (raw ll_is_pointer(t))    { pass "null"; }
    pass "zeroinitializer";
};
