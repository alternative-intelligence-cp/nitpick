// A Nitpick type, as LLVM type text.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.7.2.
//
// THE SEED IS THE REFERENCE, NOT AN INFLUENCE. `bootstrap/generator/ntypes.py`
// answers this same question for the compiler that builds stage 1, and stage 1
// builds stage 2 — so the two compilers' IR meets at every runtime symbol and
// every aggregate that crosses between them. `llc` rejects a caller whose struct
// disagrees with the callee's by one field, which is how the runtime's own header
// records the mismatch being caught the first time.
//
// Every text below is therefore quoted from `ntypes.llvm()` rather than derived
// again, and `check_ll_types_agree` in the harness diffs the two lists on every
// run — the same technique `tests/frontend/type_layout.npk` uses for SIZES,
// applied to the text.
//
// WHETHER A TYPE LOWERS AND WHAT IT LOWERS TO ARE TWO QUESTIONS. A function
// returning just a string would have to spell "no answer" as some string, and
// `NIL` already lowers to `void` — a real answer that reads like an absence. So
// the result carries a STATE, and there are three of them rather than two:
//
//   LL_OK      it lowers; `text` is the answer
//   LL_RUNG    valid Nitpick that no rung lowers yet; `rung` names the cycle
//   LL_BROKEN  not a type the emitter can be asked about at all
//
// The third is not fussiness. `TY_INVALID` means resolution already failed and
// said so; `TY_COMPTIME` is a VALUE standing in a type-argument window and was
// never a type. Reporting either as "enabled by cycle 1.0" would be a sentence
// that is not true, offered to somebody trying to fix their program.

mod:ir_types;

use "../../frontend/intern.npk".*;
use "../../frontend/ast_kind.npk".*;
use "../../frontend/ast.npk".*;
use "../../frontend/parse_decl.npk".*;
use "../../frontend/types.npk".*;
use "../../frontend/resolve_type.npk".*;
use "../../frontend/symbols.npk".*;
use "../../frontend/type_layout.npk".*;
use "../../frontend/type_generic.npk".*;

pub func:LL_OK = int32()     { pass 0i32; };
pub func:LL_RUNG = int32()   { pass 1i32; };
pub func:LL_BROKEN = int32() { pass 2i32; };

pub struct:LlType = {
    int32:state;
    string:text;     // meaningful when LL_OK
    string:rung;     // meaningful when LL_RUNG
};

func:ll_ok = LlType(string:text) {
    LlType:t = LlType{ state: raw LL_OK(), text: text, rung: "" };
    pass t;
};

func:ll_rung = LlType(string:rung) {
    LlType:t = LlType{ state: raw LL_RUNG(), text: "", rung: rung };
    pass t;
};

func:ll_broken = LlType() {
    LlType:t = LlType{ state: raw LL_BROKEN(), text: "", rung: "" };
    pass t;
};

pub func:ll_is_ok = bool(LlType:t) { pass (t.state == (raw LL_OK())); };

// WHAT THE EMITTER NEEDS TO ASK A TYPE. Three tables rather than three parameters
// threaded through every recursive call: the type table for the kind, the AST for
// an enum's variants, and the interns for a named type's spelling.
pub struct:LlCtx = {
    Ast->:ast;
    TypeTable->:types;
    InternTable->:interns;

    // decl index -> interned CANONICAL MODULE NAME (D-156). Zero means "no
    // module" -- a runtime symbol or the fallback. Built by emit_program after
    // the graph exists; a null map (mod_n == 0) leaves every symbol on the
    // pre-scheme `@npk_<name>` path, which is what keeps `llctx_init` callable
    // by the type-header tests that have no graph.
    wild int32->:mod_of;
    int32:mod_n;
};

pub func:llctx_init = LlCtx(Ast->:ast, TypeTable->:types, InternTable->:interns) {
    LlCtx:c = LlCtx{ ast: ast, types: types, interns: interns,
                     mod_of: NULL, mod_n: 0i32 };
    pass c;
};

pub func:llctx_set_modmap = NIL(LlCtx->:c, wild int32->:m, int32:n) {
    c.mod_of = m;
    c.mod_n = n;
    pass NIL;
};

// The canonical module name for a declaration, or "" when there is none
// (D-156). "" routes the caller to the pre-scheme fallback.
pub func:mod_canonical = string(LlCtx->:c, int32:decl_index) {
    if (c.mod_n == 0i32)         { pass ""; }
    if (decl_index < 0i32)       { pass ""; }
    if (decl_index >= c.mod_n)   { pass ""; }
    int32:ci = c.mod_of[decl_index => int64];
    if (ci == 0i32)              { pass ""; }
    pass (relay intern_get(c.interns, ci));
};

// `@"npk.<module>.<name>"` for a function, quoted (the spelling embeds `<`,
// spaces and commas for instantiations). main keeps `@main` and failsafe
// `@npk_failsafe` -- the two functions outside the Result regime (D-013) are
// the two outside the scheme. A declaration with no module falls back to the
// pre-scheme `@npk_<name>`: builtins and runtime symbols reach ir_symbol
// through the rt table, not here, so the fallback is only ever hit by a
// symbol the modmap did not cover, which stays linkable.
pub func:mangled_fn_sym = string(LlCtx->:c, int32:decl_index, string:name) {
    if (raw string_eq(name, "main"))     { pass "@main"; }
    if (raw string_eq(name, "failsafe")) { pass "@npk_failsafe"; }
    string:canon = relay mod_canonical(c, decl_index);
    if (canon.len == 0i64) {
        pass (relay string_concat("@npk_", name));
    }
    string:body = relay string_concat("npk.",
                      relay string_concat(canon,
                          relay string_concat(".", name)));
    pass (relay string_concat("@\"",
              relay string_concat(body, "\"")));
};

// `%"npk.<module>.<Name>"` for a named aggregate. No name exceptions -- no
// type is named main or failsafe. The `%Name` fallback keeps a mapless
// context (the header tests) rendering as before.
pub func:mangled_type_name = string(LlCtx->:c, int32:decl_index, string:name) {
    string:canon = relay mod_canonical(c, decl_index);
    if (canon.len == 0i64) {
        pass (relay string_concat("%", name));
    }
    string:body = relay string_concat("npk.",
                      relay string_concat(canon,
                          relay string_concat(".", name)));
    pass (relay string_concat("%\"",
              relay string_concat(body, "\"")));
};

// --- the lowering -----------------------------------------------------------------

pub func:ll_type = LlType(LlCtx->:c, int32:id) {
    int32:k = raw type_kind(c.types, id);

    // Resolution already failed and already said so. Anything said here would be
    // a second diagnostic about one mistake.
    if (k == (raw TY_INVALID()))  { pass (raw ll_broken()); }

    // A `comptime` ARGUMENT IS NOT A TYPE (`Mutex<Config, 2>`'s `2`). It sits in a
    // type-argument window so the window stays positional, and asking it for a
    // representation is asking the wrong question rather than an early one.
    if (k == (raw TY_COMPTIME())) { pass (raw ll_broken()); }

    // `void` IS ONLY EVER A RETURN TYPE. A `NIL` never occupies storage — D-084
    // makes it genuinely zero-sized — and `Result<NIL>` is handled below as
    // `{i32}` rather than by wrapping this.
    if (k == (raw TY_NIL()))      { pass (raw ll_ok("void")); }

    // STORED AS A BYTE, and `i1` appears only inside a condition. A `bool` in a
    // struct that was `i1` would be one bit of a byte LLVM still allocates, and
    // two compilers could disagree about which bit.
    if (k == (raw TY_BOOL()))     { pass (raw ll_ok("i8")); }

    if (k == (raw TY_STRING()))   { pass (raw ll_ok("{ ptr, i64, i64 }")); }

    // NUL-terminated, `{ptr, i64}`, and NO capacity (D-049): a `cstring` is never
    // grown and is not ours to free — `argv` comes from the kernel.
    if (k == (raw TY_CSTRING()))  { pass (raw ll_ok("{ ptr, i64 }")); }

    // THIN, ONE WORD, NO BOUNDS METADATA (D-038) — whatever it points at, which is
    // why this does not recurse and why `any->` lowers while bare `any` does not.
    if (k == (raw TY_POINTER()))  { pass (raw ll_ok("ptr")); }

    // The bounds live on the ARRAY type (D-070), which is what keeps a pointer one
    // word and makes a slice a separate type rather than a fatter pointer.
    if (k == (raw TY_SLICE()))    { pass (raw ll_ok("{ ptr, i64 }")); }

    // FIVE DISTINCT TYPES THAT ALL LOWER TO `i32` (D-042). They compare and they
    // do not add, and the type checker is what holds that line — to LLVM an `fd`
    // and a `pid` are the same thirty-two bits.
    if (k == (raw TY_KERNEL()))   { pass (raw ll_ok("i32")); }

    if (k == (raw TY_INT()))      { pass (relay ll_int_bits(raw type_int_bits(c.types, id))); }

    // `char8` IS A BYTE AND IS NOT AN INTEGER. The representation is shared and
    // the arithmetic is not (D-005); `char16` and `char32` wait for 0.9.
    // Every char width lowers (0.9.6); the semantic-type discipline — compare
    // and index, no arithmetic — is the checker's, as it always was for char8.
    if (k == (raw TY_CHAR())) {
        int32:cbits = raw type_int_bits(c.types, id);
        if (cbits == 8i32)  { pass (raw ll_ok("i8")); }
        if (cbits == 16i32) { pass (raw ll_ok("i16")); }
        if (cbits == 32i32) { pass (raw ll_ok("i32")); }
        pass (raw ll_broken());
    }

    // `tbb32` IS ADMITTED AS AN ERROR-CODE TYPE ONLY — assignment, comparison and
    // passing, never arithmetic. That one restriction is what keeps ERR,
    // stickiness and saturation (D-008) out of this rung entirely.
    if (k == (raw TY_TBB())) {
        // Every tbb width lowers as its carrier (0.9.3); the ARITHMETIC — ERR,
        // stickiness, saturation — is 0.9.5's and refuses at the operator.
        pass (relay ll_int_bits(raw type_int_bits(c.types, id)));
    }

    // `flt32`/`flt64` compute; `flt128` is STORAGE ONLY (D-143) — it lowers
    // so it can be held, passed, and returned, and the checker refuses every
    // operation on it, so no fp128 instruction is ever emitted.
    if (k == (raw TY_FLOAT())) {
        int32:fbits = raw type_int_bits(c.types, id);
        if (fbits == 32i32)  { pass (raw ll_ok("float")); }
        if (fbits == 64i32)  { pass (raw ll_ok("double")); }
        if (fbits == 128i32) { pass (raw ll_ok("fp128")); }
        pass (raw ll_broken());
    }

    // BARE `any` HAS NO REPRESENTATION and the frontend already refuses it as a
    // type. `any->` never reaches here: a pointer is `ptr` without asking what it
    // points at.
    if (k == (raw TY_ANY()))      { pass (raw ll_rung("1.0")); }

    if (k == (raw TY_OPTIONAL())) { pass (raw ll_rung("1.0")); }
    if (k == (raw TY_TRAIT()))    { pass (raw ll_rung("1.0")); }
    if (k == (raw TY_DYN()))      { pass (raw ll_rung("1.0")); }

    // `Self` AND A GENERIC PARAMETER ARE REAL TYPES THAT HAVE NOT BEEN SUBSTITUTED
    // YET, so they are a rung rather than broken: both live inside `trait` and
    // `impl` bodies and generic declarations, which cycle 1.0 is what enables.
    if (k == (raw TY_SELF()))     { pass (raw ll_rung("1.0")); }
    if (k == (raw TY_PARAM()))    { pass (raw ll_rung("1.0")); }

    // `lo..hi` IS A TYPED VALUE (D-093): `{ T, T }`, ALWAYS HALF-OPEN — the
    // inclusive spelling was normalized away at construction (D-145), so no
    // consumer ever asks which kind it holds.
    if (k == (raw TY_RANGE())) {
        LlType:rel = relay ll_type(c, raw type_elem(c.types, id));
        if (rel.state != (raw LL_OK())) { pass rel; }
        string:ra = relay string_concat("{ ", rel.text);
        ra = relay string_concat(ra, ", ");
        ra = relay string_concat(ra, rel.text);
        ra = relay string_concat(ra, " }");
        pass (raw ll_ok(ra));
    }

    // A FUNCTION VALUE. Closures are gone (D-018) and a function pointer is an
    // ordinary value with a `FuncType` spelling (D-087) — so it will lower to
    // `ptr` like every other pointer, once there is a rung that can CALL through
    // one. NO RUNG TABLE NAMED IT; 0.7.2 assigns it to 0.9 with the rest of full
    // type lowering, rather than leaving a type whose refusal has no cycle.
    if (k == (raw TY_FUNC()))          { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_FUNC_VARIADIC())) { pass (raw ll_rung("1.1")); }

    if (k == (raw TY_ARRAY()))    { pass (relay ll_array(c, id)); }
    if (k == (raw TY_RESULT()))   { pass (relay ll_result(c, id)); }
    if (k == (raw TY_ARENA()))    { pass (raw ll_ok("{ ptr, ptr, i64, i64, i64 }")); }
    if (k == (raw TY_HANDLE()))   { pass (raw ll_ok("{ i64, i32 }")); }
    if (k == (raw TY_SHARED_ARENA())) { pass (raw ll_ok("ptr")); }
    if (k == (raw TY_STRUCT()))   { pass (relay ll_named(c, id)); }
    if (k == (raw TY_ENUM()))     { pass (relay ll_enum(c, id)); }

    // FAIL CLOSED ON A KIND NOBODY CLASSIFIED. A kind added without a case here
    // must refuse rather than fall through to something plausible — the whole
    // value of Phase A is that an accepted program is valid, and an emitter that
    // guesses turns that into a lie.
    pass (raw ll_broken());
};

// NATIVE `iN` AT EVERY WIDTH (0.9.3, D-011 — and this comment once said the
// opposite: "arrives with LBIM rather than as i128", the dead reading the
// audit caught contradicting D-011's own measurements). LLVM 20 lowers every
// operation at every width here natively: add/mul inline, i128 division via
// `__divti3`-family libcalls the runtime floor hand-writes, and division at
// 256 bits and beyond as inline expansion — an executed probe took `udiv
// i4096` through llc whole. Sub-byte widths (`int1/2/4`) have no layout and
// wait on decision G-2; they refuse rather than guess.
func:ll_int_bits = LlType(int32:bits) {
    if (bits == 8i32)    { pass (raw ll_ok("i8")); }
    if (bits == 16i32)   { pass (raw ll_ok("i16")); }
    if (bits == 32i32)   { pass (raw ll_ok("i32")); }
    if (bits == 64i32)   { pass (raw ll_ok("i64")); }
    if (bits == 128i32)  { pass (raw ll_ok("i128")); }
    if (bits == 256i32)  { pass (raw ll_ok("i256")); }
    if (bits == 512i32)  { pass (raw ll_ok("i512")); }
    if (bits == 1024i32) { pass (raw ll_ok("i1024")); }
    if (bits == 2048i32) { pass (raw ll_ok("i2048")); }
    if (bits == 4096i32) { pass (raw ll_ok("i4096")); }
    // Sub-byte widths (`int1/2/4`): no layout exists, and decision G-2 owns
    // whether they get one or leave the grammar.
    pass (raw ll_rung("a later cycle (G-2)"));
};

// `[N x T]` — A VALUE TYPE THAT DOES NOT DECAY. Its element's refusal is its own:
// an array of something unlowerable is unlowerable, and reporting it as the array
// would name the wrong construct.
func:ll_array = LlType(LlCtx->:c, int32:id) {
    LlType:el = relay ll_type(c, raw type_elem(c.types, id));
    if (el.state != (raw LL_OK())) { pass el; }
    string:a = relay string_concat("[",
                   raw int_to_string((raw type_array_count(c.types, id)) => int64));
    string:b = relay string_concat(a, " x ");
    string:d = relay string_concat(b, el.text);
    pass (raw ll_ok(relay string_concat(d, "]")));
};

// `{T, i32}` (D-069) — NO `is_error` FIELD, because `.is_error` is derived as
// `error != 0` and a stored flag would be a second place for one fact to live.
//
// `Result<NIL>` IS `{i32}` and not `{void, i32}`: `NIL` is zero-sized (D-084), and
// `void` is not a type LLVM will put in a struct.
func:ll_result = LlType(LlCtx->:c, int32:id) {
    pass (relay ll_wrap_result(c, raw type_elem(c.types, id)));
};

// THE SAME RULE, KEYED ON THE INNER TYPE — because the wrap is usually IMPLICIT.
// Every function returns `Result<T>` while declaring `T` (D-069), so the emitter
// mostly holds a `T` with no interned `Result<T>` beside it. One body serving both
// spellings is what keeps "what does a Result look like" a single place.
pub func:ll_wrap_result = LlType(LlCtx->:c, int32:inner) {
    if ((raw type_kind(c.types, inner)) == (raw TY_NIL())) {
        pass (raw ll_ok("{ i32 }"));
    }
    LlType:it = relay ll_type(c, inner);
    if (it.state != (raw LL_OK())) { pass it; }
    string:a = relay string_concat("{ ", it.text);
    pass (raw ll_ok(relay string_concat(a, ", i32 }")));
};

// A NAMED AGGREGATE PRINTS AS `%Name`, and its body is emitted once at module
// level — which is what makes a struct one definition rather than a shape repeated
// at every mention.
//
// AN INSTANTIATION LOWERS (1.0.2). Its name is MANGLED and contains `<`, which is
// what makes `Container<int32>` reversible by inspection for an auditor — and is
// not a BARE LLVM identifier, which is why this refused until D-156 put every
// symbol in quotes. `%"npk.mod.Container<int32>"` is legal and reversible, so the
// instance renders like any other named aggregate; what distinguishes it is the
// BODY, which substitutes (`ll_struct_body`).
func:ll_named = LlType(LlCtx->:c, int32:id) {
    int32:nm = raw type_name(c.types, id);
    if (raw intern_is_none(nm)) { pass (raw ll_broken()); }
    pass (raw ll_ok(relay mangled_type_name(c, raw type_decl_of(c.types, id),
                        relay intern_get(c.interns, nm))));
};

// A PAYLOAD-LESS ENUM IS A PLAIN `i32` AND HAS NO DEFINITION AT ALL
// (TYPE_REFERENCE §9.3: "Enum values are plain i32 constants"). Only a tagged one
// is an aggregate, and SUBSET_1 §1.2's one-machine-word payload fixes its shape at
// `{i32, i64}` — uniform, with no max-payload sizing and no alignment puzzles.
func:ll_enum = LlType(LlCtx->:c, int32:id) {
    if (!(relay enum_has_payload(c.ast, c.types, id))) { pass (raw ll_ok("i32")); }
    int32:nm = raw type_name(c.types, id);
    if (raw intern_is_none(nm)) { pass (raw ll_broken()); }
    pass (raw ll_ok(relay mangled_type_name(c, raw type_decl_of(c.types, id),
                        relay intern_get(c.interns, nm))));
};

// --- what the module preamble writes ------------------------------------------------
//
// The BODY behind a `%Name`, emitted once. A struct's is its fields in declaration
// order; a tagged enum's is the uniform word.

// A ZERO-FIELD STRUCT GETS AN `i8` BODY rather than `{}`. Two distinct empty
// structs must have distinct addresses, and `type {}` would place them on top of
// each other — the same reason the layout gives an empty struct one byte.
// Mirrors `type_generic`'s own SUBST_FUEL: a substituted instance has its own
// arguments substituted in turn, so the walk follows a type's structure and is
// bounded the same way the frontend bounds it.
func:SUBST_FUEL_LL = int32() { pass 64i32; };

pub func:ll_struct_body = LlType(TypeResolver->:r, LlCtx->:c, int32:id,
                                 int32:scope) {
    if ((raw type_kind(c.types, id)) != (raw TY_STRUCT())) { pass (raw ll_broken()); }

    DeclId:did = DeclId{ index: raw type_decl(c.types, id) };
    DeclNode:d = relay ast_decl(c.ast, did);

    // AN INSTANTIATION SUBSTITUTES ITS ARGUMENTS INTO EVERY FIELD (1.0.2).
    // `Container<int32>`'s body is the declaration's fields with `T` replaced —
    // monomorphization, done by the FRONTEND's own machinery rather than a
    // second idea of substitution living in the emitter.
    //
    // TWO THINGS ARE NEEDED, and `type_layout` (0.8.1) needs the same two for
    // the same reason. `r.generics` must carry the declaration's parameter
    // window bound to this instance's arguments, because a field's `T` resolves
    // through `generic_lookup` and NOT through any scope — a struct's parameters
    // are declared into no scope at all. And the field's annotation must resolve
    // AT HOME: it means what it meant where the struct was written.
    IdSpan:gp = raw decl_generic_window(c.ast, d);
    GenericScope:g = GenericScope{
        params_start: gp.start, params_count: gp.count,
        args_start: raw type_args_start_of(c.types, id),
        args_count: raw type_args_count_of(c.types, id) };
    GenericScope:saved = r.generics;
    r.generics = g;
    scope = raw symtab_home_scope(r.tab, did.index, scope);

    string:body = "";
    int32:n = 0i32;
    int32:i = 0i32;
    while (i < (raw item_member_count(c.ast, d))) {
        DeclId:mid = raw item_member(c.ast, d, i);
        DeclNode:m = relay ast_decl(c.ast, mid);
        if (m.kind == DeclKind.DeclFieldDecl) {
            int32:ft0 = relay resolve_type(r, raw field_type(m), scope);
            int32:ft = relay type_subst(r, ft0, g, m.span, raw SUBST_FUEL_LL());
            LlType:ll = relay ll_type(c, ft);
            if (ll.state != (raw LL_OK())) {
                r.generics = saved;
                pass ll;
            }
            if (n > 0i32) { body = relay string_concat(body, ", "); }
            body = relay string_concat(body, ll.text);
            n = n + 1i32;
        }
        i = i + 1i32;
    }
    r.generics = saved;
    if (n == 0i32) { body = "i8"; }

    string:a = relay string_concat("{ ", body);
    pass (raw ll_ok(relay string_concat(a, " }")));
};

// THE PAYLOAD SLOT (0.9.2): `{ i32, [N x iK] }`, DERIVED from the layout the
// frontend already computed — K is the enum's stored alignment in bits, N
// covers the stored size past the tag. One computation (type_layout's enum
// arm, widest-variant sizing) and this derivation; a second walk here would be
// a second copy of one fact. `[N x i8]` would give the slot alignment 1 and an
// 8-byte payload would sit at odd addresses — the misalignment the audit
// caught in TYPE_REFERENCE §9.3's own example; making the element BE the
// alignment makes the alignment structural. Construction and binding never do
// this arithmetic — they address the slot with a typed getelementptr and
// store/load the variant's own type through the pointer.
pub struct:EnumSlot = {
    bool:ok;
    int32:kbits;
    int64:count;
};

pub func:enum_payload_slot = EnumSlot(LlCtx->:c, int32:id) {
    EnumSlot:bad = EnumSlot{ ok: false, kbits: 0i32, count: 0i64 };
    int64:sz = raw type_size(c.types, id);
    int32:al = raw type_align(c.types, id);
    // FAIL CLOSED on a layout the table does not hold: a zero here becomes a
    // slot that cannot hold its payload, which is memory corruption wearing a
    // type annotation. Alignments past 8 arrive with i128 (0.9.3), which must
    // extend this derivation deliberately.
    if (sz <= 0i64)  { pass bad; }
    if (al <= 0i32)  { pass bad; }
    if (al > 16i32)  { pass bad; }
    int64:tag = raw align_up(4i64, al);
    int64:bytes = sz - tag;
    if (bytes <= 0i64) { pass bad; }
    EnumSlot:out = EnumSlot{ ok: true, kbits: al * 8i32,
                             count: bytes / (al => int64) };
    pass out;
};

pub func:ll_enum_body = LlType(LlCtx->:c, int32:id) {
    if ((raw type_kind(c.types, id)) != (raw TY_ENUM())) { pass (raw ll_broken()); }
    // A payload-less enum has no body to ask for; the question itself is the
    // mistake (internal — every caller filters first).
    if (!(relay enum_has_payload(c.ast, c.types, id))) { pass (raw ll_broken()); }
    EnumSlot:sl = raw enum_payload_slot(c, id);
    if (!sl.ok) { pass (raw ll_broken()); }
    string:a = relay string_concat("{ i32, [",
                   raw int_to_string(sl.count));
    string:b = relay string_concat(a, " x i");
    string:d2 = relay string_concat(b, raw int_to_string(sl.kbits => int64));
    pass (raw ll_ok(relay string_concat(d2, "] }")));
};

// The ERR sentinel per tbb width, as decimal text (D-008: the most negative
// value of the carrier). ONE representation, shared by every site that spells
// it — the arithmetic saturation, the sentinel maps in casts, `is_err`, the
// `ERR` literal, and the `ERR:` pick arm — so no two sites can disagree about
// which bit pattern taint is.
pub func:tbb_min_decimal = string(int32:bits) {
    if (bits == 8i32)   { pass "-128"; }
    if (bits == 16i32)  { pass "-32768"; }
    if (bits == 32i32)  { pass "-2147483648"; }
    if (bits == 64i32)  { pass "-9223372036854775808"; }
    if (bits == 128i32) { pass "-170141183460469231731687303715884105728"; }
    if (bits == 256i32) { pass "-57896044618658097711785492504343953926634992332820282019728792003956564819968"; }
    pass "";
};

// The widest VALID magnitude per tbb width — MIN's mirror, for the range
// checks the cast matrix emits.
pub func:tbb_max_decimal = string(int32:bits) {
    if (bits == 8i32)   { pass "127"; }
    if (bits == 16i32)  { pass "32767"; }
    if (bits == 32i32)  { pass "2147483647"; }
    if (bits == 64i32)  { pass "9223372036854775807"; }
    if (bits == 128i32) { pass "170141183460469231731687303715884105727"; }
    if (bits == 256i32) { pass "57896044618658097711785492504343953926634992332820282019728792003956564819967"; }
    pass "";
};

// --- questions the emitter asks about a lowered type --------------------------------
//
// ASKED OF THE TEXT, NOT OF THE KIND. The seed's own note says why: "asking the
// question this way rather than listing type names means the answer cannot drift
// from what the emitter can actually lower". A payload-free enum is `i32` and
// passes; a tagged one is a struct and does not — and neither had to be listed.

// True when this lowered to a plain `iN`, which is exactly the set of types one
// LLVM instruction — `add`, `icmp`, `zext` — is valid over.
pub func:ll_is_scalar_int = bool(LlType:t) {
    if (t.state != (raw LL_OK())) { pass false; }
    if (t.text.len < 2i64) { pass false; }
    if (t.text.ptr[0i64] != 105u8) { pass false; }   // 'i'
    int64:i = 1i64;
    while (i < t.text.len) {
        if (t.text.ptr[i] < 48u8) { pass false; }    // '0'
        if (t.text.ptr[i] > 57u8) { pass false; }    // '9'
        i = i + 1i64;
    }
    pass true;
};

// The three float texts, asked of the TEXT like the neighbours above.
pub func:ll_is_float_text = bool(string:t) {
    if (raw string_eq(t, "float"))  { pass true; }
    if (raw string_eq(t, "double")) { pass true; }
    if (raw string_eq(t, "fp128"))  { pass true; }
    pass false;
};

pub func:ll_is_pointer = bool(LlType:t) {
    if (t.state != (raw LL_OK())) { pass false; }
    pass (raw string_eq(t.text, "ptr"));
};

// THE ZERO VALUE, for the value slot of a failed `Result` — every failure writes
// one, so this is on the path of every error in every program.
//
// Derived from the TEXT for the same reason as the two above: a table keyed by
// Nitpick kind would be a second list to keep in step with the first.
pub func:ll_zero = string(LlType:t) {
    if (raw ll_is_scalar_int(t)) { pass "0"; }
    if (raw ll_is_pointer(t))    { pass "null"; }
    pass "zeroinitializer";
};
