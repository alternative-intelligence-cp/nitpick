// The LLVM IR text writer.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.7.1 — the first module of the backend.
//
// TEXT, NOT A STRUCTURE. The output is LLVM IR as characters, which is what `llc`
// takes and what a person can read. There is no intermediate object graph to keep
// in step with the text, because there is only one consumer and the text IS the
// artifact.
//
// DETERMINISM IS A REQUIREMENT, NOT A NICETY (D-078). Identical input must produce
// BYTE-IDENTICAL output — not equivalent IR, identical bytes — because D-085's
// stage-1/stage-2 fixpoint check compares two compilers' output for equality, and a
// single reordered iteration makes that check meaningless.
//
// What that rules out is worth stating, because each is a thing a writer normally
// does: no iteration over anything unordered, no temp numbered by visit order rather
// than by source order, no "whichever came first" tie-break. Every counter here is
// sequential and every walk that uses it goes in source order.
//
// THE SEED'S OUTPUT IS THE REFERENCE. Stage 1 is built by the seed and stage 2 by
// stage 1, so the two compilers' IR meets at every runtime symbol and every layout
// until the fixpoint closes. Symbol naming in particular is not a free choice: it is
// whatever `bootstrap/generator/emit.py` already does.

mod:ir_writer;

use "../../frontend/intern.npk".*;
use "../../frontend/diagnostics.npk".*;

pub struct:IrWriter = {
    // WRITTEN THROUGH A SINK, which grows since 0.7.1. A fixed buffer that dropped
    // what did not fit would produce a program that compiles to something other
    // than what was written, with nothing reporting it.
    Sink:out;

    // A FUNCTION'S BODY AND ITS HOISTED ALLOCAS, buffered separately while the
    // function is emitted and spliced into `out` at its close (1.0.9a). An
    // `alloca` inside a loop body allocates fresh stack every iteration and
    // reclaims none until the function returns, so a walk over a large program
    // overflows the stack; every alloca is emitted into `allocas` and placed
    // once, right after `entry:`, regardless of where in the body it was
    // discovered — the entry block dominates everything, so this is always
    // valid, and the value name is unchanged. While `in_fn` is set, `irw_line`,
    // `irw_label` and `irw_raw` write to `body`; `irw_alloca` writes to
    // `allocas`; outside a function they write to `out` as before.
    Sink:allocas;
    Sink:body;
    bool:in_fn;

    // THE MODULE'S COROUTINE FRAME TYPES, held apart and spliced in AHEAD of
    // the first function (1.1.10-D1). A frame type's shape is not known until
    // its body has been scanned for crossing locals, so it is written where it
    // is discovered — in the middle of the module — while the call sites that
    // ask for its SIZE may be anywhere, including earlier. LLVM will not size
    // a forward-referenced named type, so `async func:main` awaiting a helper
    // declared below it produced `base element of getelementptr must be
    // sized` from llc rather than a program. Every existing test happened to
    // declare its callees first, which is why nothing caught it.
    //
    // `out` is the head — everything before the first function, where the
    // aggregate types a frame may embed are already defined — and `tail` is
    // everything from the first function on. The assembled text is
    // head, frame types, tail.
    Sink:types;
    Sink:tail;
    bool:seen_fn;

    // `%t0`, `%t1`, … WITHIN ONE FUNCTION. Reset at each function's start, so a
    // function's IR depends on that function alone — which is what makes a
    // one-function change produce a one-function diff.
    int32:next_temp;

    // Basic-block labels, numbered in the same way and for the same reason.
    int32:next_label;

    // THE STATEMENT MARK (D-177, 1.1.4): where the temp counter stood when the
    // current statement began, and how many of the temps minted since were
    // allocas. An `await` is stage-C-legal only when every temp its statement
    // has minted so far is an alloca: an SSA value minted before the
    // suspension and used after it would not dominate its use once the resume
    // switch re-enters mid-body. Allocas are exempt — they are hoisted to the
    // entry block, which dominates every segment.
    int32:stmt_mark;
    int32:alloca_since;

    // THE SITE REGISTRY (D-179, 1.1.6): one row per stamp site — the places
    // `fail` resets the origin chain and `relay`/`?!` extend it. Ids from 1
    // (0 is the runtime's own reserved site); rows are (path, line), deduped,
    // in first-registration order, which is emission order — deterministic
    // (D-078). Emitted at the program's tail as two tables and two lookup
    // functions the `site_line`/`site_path` builtins call.
    // SoA KEPT, two Lists (1.4.7 step 2). Both counts move together -- every
    // registration pushes both -- which is this pair's invariant now that the
    // shared `site_count` is gone. The paths are OWNING strings; `List<T>`
    // holds them behind a `wild T->` exactly as the raw array did, so the drop
    // discipline is unchanged.
    List<string>:site_paths;
    List<int32>:site_lines;

    // ITEMS (1.5.2d, D-262 §1): ranges of one module sink the emitter
    // brackets — a non-generic PRELUDE function, a prelude impl's vtable with
    // its thunks — kept at the close of emission only if a symbol they define
    // is referenced from outside every item or from a kept item.
    // `irw_trim_items` decides over the TEXT: a reference is an `@` token,
    // wherever it stands, so no kind of use has to be enumerated and a kind
    // nobody anticipated keeps its item. Everything outside an item is a root.
    List<int32>:item_sink;     // 0 = `out`, 2 = `tail`
    List<int64>:item_start;
    List<int64>:item_end;
    bool:item_open;
    int32:item_open_sink;
    int64:item_open_start;
};

pub func:irw_to_buffer = IrWriter() never fails {
    IrWriter:w = IrWriter{ out: raw sink_to_buffer(4096i64),
                           allocas: raw sink_to_buffer(1024i64),
                           body: raw sink_to_buffer(4096i64),
                           in_fn: false,
                           types: raw sink_to_buffer(1024i64),
                           tail: raw sink_to_buffer(4096i64),
                           seen_fn: false,
                           next_temp: 0i32, next_label: 0i32,
                           stmt_mark: 0i32, alloca_since: 0i32,
                           site_paths: raw list_init::<string>(16i64),
                           site_lines: raw list_init::<int32>(16i64),
                           item_sink: raw list_init::<int32>(64i64),
                           item_start: raw list_init::<int64>(64i64),
                           item_end: raw list_init::<int64>(64i64),
                           item_open: false, item_open_sink: 0i32,
                           item_open_start: 0i64 };
    pass w;
};

// --- items, and the trim (1.5.2d, D-262 §1) --------------------------------------------

// Which MODULE sink is current, as a number: 0 `out`, 2 `tail`. An item begins
// and ends outside a function, where `irw_sink` answers one of those two.
func:irw_sink_id = int32(IrWriter->:w) never fails {
    if (w.seen_fn) { pass 2i32; }
    pass 0i32;
};

pub func:irw_item_begin = NIL(IrWriter->:w) never fails {
    // FROM THE FIRST ITEM ON, THE MODULE STREAM IS THE TAIL: a function's
    // `define` switches it there anyway (`irw_begin_function`), and an item
    // that began in the head and ended in the tail could not be recorded --
    // the first prelude function of every module stayed unrecorded, hence
    // kept, until this line. The head holds what was written before.
    if (!w.seen_fn) { w.seen_fn = true; }
    w.item_open = true;
    w.item_open_sink = raw irw_sink_id(w);
    w.item_open_start = raw sink_length(raw irw_sink(w));
    pass NIL;
};

// An item that straddled the switch from `out` to `tail` (the first function
// of the module began inside it) is not recorded: not recorded is kept.
pub func:irw_item_end = NIL(IrWriter->:w) never fails {
    if (!w.item_open) { pass NIL; }
    w.item_open = false;
    if ((raw irw_sink_id(w)) != w.item_open_sink) { pass NIL; }
    int64:fin = raw sink_length(raw irw_sink(w));   // (`end` is a keyword)
    if (fin <= w.item_open_start) { pass NIL; }
    drop list_push(@w.item_sink, w.item_open_sink);
    drop list_push(@w.item_start, w.item_open_start);
    drop list_push(@w.item_end, fin);
    pass NIL;
};

// An LLVM symbol byte: `[-a-zA-Z$._0-9]`.
func:trim_sym_byte = bool(uint8:u) never fails {
    if ((u >= 97u8) && (u <= 122u8)) { pass true; }
    if ((u >= 65u8) && (u <= 90u8))  { pass true; }
    if ((u >= 48u8) && (u <= 57u8))  { pass true; }
    if (u == 95u8) { pass true; }    // _
    if (u == 46u8) { pass true; }    // .
    if (u == 36u8) { pass true; }    // $
    if (u == 45u8) { pass true; }    // -
    pass false;
};

// The symbol token at `text[p]` (an `@`): its NAME interned into `syms` —
// quotes stripped, so `@"x"` and `@x` are one symbol as they are to LLVM —
// and the index just past the token. −1 when the `@` begins no token.
pub struct:TrimTok = { int32:sym; int64:next; };

func:trim_token = TrimTok(InternTable->:syms, string:text, int64:p) never fails {
    TrimTok:none = TrimTok{ sym: 0i32 - 1i32, next: p + 1i64 };
    if ((p + 1i64) >= text.len) { pass none; }
    if (text.ptr[p + 1i64] == 34u8) {   // a quoted name
        int64:q = p + 2i64;
        while (q < text.len) {
            if (text.ptr[q] == 34u8) {
                if (q == (p + 2i64)) { pass none; }
                string:name = string_from_bytes(#ptr_add<uint8>(text.ptr =>! wild uint8->, p + 2i64), q - (p + 2i64));
                pass (TrimTok{ sym: raw intern_add(syms, string_concat(name, "")), next: q + 1i64 });
            }
            q = q + 1i64;
        }
        pass none;
    }
    int64:e = p + 1i64;
    while (e < text.len) {
        if (!(raw trim_sym_byte(text.ptr[e]))) { break; }
        e = e + 1i64;
    }
    if (e == (p + 1i64)) { pass none; }
    string:bare = string_from_bytes(#ptr_add<uint8>(text.ptr =>! wild uint8->, p + 1i64), e - (p + 1i64));
    pass (TrimTok{ sym: raw intern_add(syms, string_concat(bare, "")), next: e });
};

// Every symbol token in `text[lo, hi)`, pushed on `into`.
func:trim_scan_refs = NIL(InternTable->:syms, string:text, int64:lo, int64:hi,
                          List<int32>->:into) never fails {
    int64:p = lo;
    while (p < hi) {
        if (text.ptr[p] == 64u8) {   // @
            TrimTok:t = raw trim_token(syms, text, p);
            if (t.sym >= 0i32) { drop list_push(into, t.sym); }
            p = t.next;
        } else {
            p = p + 1i64;
        }
    }
    pass NIL;
};

// Does `text` carry `word` at `at`?
func:trim_has_at = bool(string:text, int64:at, string:word) never fails {
    if ((at + word.len) > text.len) { pass false; }
    int64:i = 0i64;
    while (i < word.len) {
        if (text.ptr[at + i] != word.ptr[i]) { pass false; }
        i = i + 1i64;
    }
    pass true;
};

// Every symbol an item DEFINES: the first token of a line beginning `define`,
// and the token beginning a line `@name = …`. Lines begin at `lo` and after
// every newline inside the range.
func:trim_scan_defs = NIL(InternTable->:syms, string:text, int64:lo, int64:hi,
                          List<int32>->:into) never fails {
    int64:p = lo;
    bool:at_line_start = true;
    while (p < hi) {
        if (at_line_start) {
            if (raw trim_has_at(text, p, "define")) {
                int64:q = p + 6i64;
                while ((q < hi) && (text.ptr[q] != 64u8) && (text.ptr[q] != 10u8)) { q = q + 1i64; }
                if ((q < hi) && (text.ptr[q] == 64u8)) {
                    TrimTok:t = raw trim_token(syms, text, q);
                    if (t.sym >= 0i32) { drop list_push(into, t.sym); }
                }
            } else {
                if (text.ptr[p] == 64u8) {
                    TrimTok:t2 = raw trim_token(syms, text, p);
                    if (t2.sym >= 0i32) { drop list_push(into, t2.sym); }
                }
            }
        }
        at_line_start = (text.ptr[p] == 10u8);
        p = p + 1i64;
    }
    pass NIL;
};

// The bytes of `s[lo, hi)` appended to `dst`.
func:trim_copy = NIL(Sink->:dst, Sink->:s, int64:lo, int64:hi) never fails {
    if (hi <= lo) { pass NIL; }
    drop sink_write(dst, string_from_bytes(#ptr_add<int8>(s.v.items, lo), hi - lo));
    pass NIL;
};

// A VIEW of one module sink's text by its number (0 `out`, 1 `types`, 2 `tail`)
// — a fresh view at every use, since a `string` binding is move-only (TYPE-046)
// and a view of container-owned bytes drops nothing (D-183).
func:trim_sink_text = string(IrWriter->:w, int32:sid) never fails {
    if (sid == 1i32) { pass (raw sink_view(@w.types)); }
    if (sid == 2i32) { pass (raw sink_view(@w.tail)); }
    pass (raw sink_view(@w.out));
};

// THE TRIM. Items are recorded in emission order, so within one sink their
// ranges ascend and do not overlap.
pub func:irw_trim_items = NIL(IrWriter->:w) never fails {
    int64:n = w.item_sink.count;
    if (n == 0i64) { pass NIL; }
    InternTable:syms = raw intern_init();

    // Each item's definitions and references, as windows into two flat lists.
    List<int32>:defs = raw list_init::<int32>(1024i64);
    List<int64>:def_lo = raw list_init::<int64>(n);
    List<int64>:def_hi = raw list_init::<int64>(n);
    List<int32>:refs = raw list_init::<int32>(4096i64);
    List<int64>:ref_lo = raw list_init::<int64>(n);
    List<int64>:ref_hi = raw list_init::<int64>(n);
    List<int32>:roots = raw list_init::<int32>(4096i64);
    int64:i = 0i64;
    while (i < n) {
        string:t = raw trim_sink_text(w, w.item_sink.items[i]);
        drop list_push(@def_lo, defs.count);
        drop trim_scan_defs(@syms, t, w.item_start.items[i], w.item_end.items[i], @defs);
        drop list_push(@def_hi, defs.count);
        drop list_push(@ref_lo, refs.count);
        drop trim_scan_refs(@syms, t, w.item_start.items[i], w.item_end.items[i], @refs);
        drop list_push(@ref_hi, refs.count);
        i = i + 1i64;
    }
    // The roots: every token outside the items, in all three sinks.
    int32:sid = 0i32;
    while (sid <= 2i32) {
        string:t = raw trim_sink_text(w, sid);
        int64:cursor = 0i64;
        int64:k = 0i64;
        while (k < n) {
            if (w.item_sink.items[k] == sid) {
                drop trim_scan_refs(@syms, t, cursor, w.item_start.items[k], @roots);
                cursor = w.item_end.items[k];
            }
            k = k + 1i64;
        }
        drop trim_scan_refs(@syms, t, cursor, t.len, @roots);
        sid = sid + 1i32;
    }
    // Which item defines a symbol (−1: none, a root's own or an external).
    int64:nsyms = (raw intern_count(@syms)) => int64;
    List<int32>:owner = raw list_init::<int32>(nsyms + 1i64);
    int64:z = 0i64;
    while (z < nsyms) { drop list_push(@owner, 0i32 - 1i32); z = z + 1i64; }
    i = 0i64;
    while (i < n) {
        int64:d = def_lo.items[i];
        while (d < def_hi.items[i]) {
            owner.items[defs.items[d] => int64] = i =>! int32;
            d = d + 1i64;
        }
        i = i + 1i64;
    }
    // The fixpoint: from the roots, through kept items' references.
    List<int32>:kept = raw list_init::<int32>(n);
    i = 0i64;
    while (i < n) { drop list_push(@kept, 0i32); i = i + 1i64; }
    List<int64>:work = raw list_init::<int64>(n);
    int64:r = 0i64;
    while (r < roots.count) {
        int32:o = owner.items[roots.items[r] => int64];
        if (o >= 0i32) { if (kept.items[o => int64] == 0i32) {
            kept.items[o => int64] = 1i32;
            drop list_push(@work, o => int64);
        } }
        r = r + 1i64;
    }
    while (work.count > 0i64) {
        int64:it = work.items[work.count - 1i64];
        work.count = work.count - 1i64;
        int64:q = ref_lo.items[it];
        while (q < ref_hi.items[it]) {
            int32:o2 = owner.items[refs.items[q] => int64];
            if (o2 >= 0i32) { if (kept.items[o2 => int64] == 0i32) {
                kept.items[o2 => int64] = 1i32;
                drop list_push(@work, o2 => int64);
            } }
            q = q + 1i64;
        }
    }
    // Rebuild `out` and `tail` from their non-item bytes and the kept items.
    sid = 0i32;
    while (sid <= 2i32) {
        if (sid != 1i32) {
            Sink->:src = @w.out;
            if (sid == 2i32) { src = @w.tail; }
            Sink:fresh = raw sink_to_buffer(raw sink_length(src));
            int64:cursor2 = 0i64;
            int64:k2 = 0i64;
            while (k2 < n) {
                if (w.item_sink.items[k2] == sid) {
                    drop trim_copy(@fresh, src, cursor2, w.item_start.items[k2]);
                    if (kept.items[k2] != 0i32) {
                        drop trim_copy(@fresh, src, w.item_start.items[k2], w.item_end.items[k2]);
                    }
                    cursor2 = w.item_end.items[k2];
                }
                k2 = k2 + 1i64;
            }
            drop trim_copy(@fresh, src, cursor2, raw sink_length(src));
            drop sink_reset(src);
            drop sink_append(src, @fresh);
        }
        sid = sid + 1i32;
    }
    // The items are spent; a second trim would find nothing to do.
    w.item_sink.count = 0i64;
    w.item_start.count = 0i64;
    w.item_end.count = 0i64;
    pass NIL;
};

// THE SINK A NON-ALLOCA LINE GOES TO: the body while a function is open, the
// module stream otherwise. Public since 1.5.1b step 3: the builders that
// used to RETURN an accumulated string -- a global initialiser, the site
// tables, an escaped literal -- write their pieces into it in order, and the
// emitter is single-threaded, so nothing interleaves with a line in progress.
pub func:irw_sink = Sink->(IrWriter->:w) never fails {
    if (w.in_fn) { pass (@w.body); }
    if (w.seen_fn) { pass (@w.tail); }
    pass (@w.out);
};

// A COROUTINE FRAME TYPE, into the sink that splices ahead of every function
// (1.1.10-D1). Not `irw_raw`: the whole point is that this line does NOT stay
// where it was written.
pub func:irw_frame_type = NIL(IrWriter->:w, string:line) never fails {
    drop sink_write(@w.types, line);
    drop sink_write(@w.types, "\n");
    pass NIL;
};

// OPEN A FUNCTION'S BUFFERS (1.0.9a). The define line and `entry:` label are
// written to `out` BEFORE this, so allocas and body land after them at close.
pub func:irw_open_fn = NIL(IrWriter->:w) never fails {
    drop sink_reset(@w.allocas);
    drop sink_reset(@w.body);
    w.in_fn = true;
    pass NIL;
};

// CLOSE A FUNCTION: allocas first, then the body, into the module stream.
pub func:irw_close_fn = NIL(IrWriter->:w) never fails {
    w.in_fn = false;
    // INTO THE SAME STREAM THE `define` LINE WENT TO, which is the tail once
    // any function has begun (1.1.10-D1) — splicing into `out` unconditionally
    // put every function's body in the head, ahead of its own header.
    Sink->:dst = raw irw_sink(w);
    drop sink_append(dst, @w.allocas);
    drop sink_append(dst, @w.body);
    pass NIL;
};

// AN ALLOCA, HOISTED (1.0.9a). Always inside a function; the line goes to the
// alloca buffer and is placed right after `entry:` at close.
pub func:irw_alloca = NIL(IrWriter->:w, string:slot, string:ty_text) never fails {
    w.alloca_since = w.alloca_since + 1i32;
    drop sink_write(@w.allocas, "  ");
    drop sink_write(@w.allocas, slot);
    drop sink_write(@w.allocas, " = alloca ");
    drop sink_write(@w.allocas, ty_text);
    drop sink_write(@w.allocas, "\n");
    pass NIL;
};


// A NON-ALLOCA LINE IN THE ENTRY BLOCK (D-177, 1.1.4): the coroutine's frame
// GEPs, and at close its state load and `switch`. Same stream as the hoisted
// allocas, so everything lands after `entry:` and before the body — the GEPs
// are pure address arithmetic, so order within the entry block cannot matter.
pub func:irw_entry = NIL(IrWriter->:w, string:text) never fails {
    drop sink_write(@w.allocas, "  ");
    drop sink_write(@w.allocas, text);
    drop sink_write(@w.allocas, "\n");
    pass NIL;
};

// A LABEL IN THE ENTRY STREAM (1.5.1b step 4): the coroutine's first-resume
// block that zeroes its frame-resident temporary flags sits between the
// state load and the switch, so it is written here, at column zero.
pub func:irw_entry_label = NIL(IrWriter->:w, string:name) never fails {
    drop sink_write(@w.allocas, name);
    drop sink_write(@w.allocas, ":\n");
    pass NIL;
};

// One stamp site, registered: its id, minting the row on first sight.
pub func:irw_site = int32(IrWriter->:w, move string:path, int32:line) never fails {
    int32:i = 0i32;
    while ((i => int64) < w.site_lines.count) {
        if (w.site_lines.items[i => int64] == line) {
            if (raw string_eq(w.site_paths.items[i => int64], path)) {
                pass (i + 1i32);
            }
        }
        i = i + 1i32;
    }
    // BOTH, ALWAYS.
    drop list_push(@w.site_paths, move(path));
    drop list_push(@w.site_lines, line);
    // THE ID IS `i + 1`, NOT A NARROWED COUNT. After the scan `i` IS the old
    // count, already an int32, so the new 1-based id needs no cast -- and under
    // D-210 the `+ 1i32` TRAPS rather than wrapping, which is exactly the
    // protection the int32 counter gave for free before this conversion
    // (family 5's note). A guarded narrow off the int64 count would have needed
    // a new error identity, and this module declares none.
    pass (i + 1i32);
};

// --- writing --------------------------------------------------------------------

// A PIECE OF A LINE, no newline (1.5.1b step 3, DEF-1): a program-sized line
// is written as its pieces, each once, instead of assembled by copying an
// ever-longer prefix. `irw_newline` ends it.
pub func:irw_write = NIL(IrWriter->:w, string:text) never fails {
    drop sink_write(raw irw_sink(w), text);
    pass NIL;
};

pub func:irw_newline = NIL(IrWriter->:w) never fails {
    drop sink_write(raw irw_sink(w), "\n");
    pass NIL;
};

// A SINK'S BYTES AS ONE RAW LINE: an initialiser is assembled apart, so a
// failure midway leaves nothing in the module stream.
pub func:irw_raw_sink = NIL(IrWriter->:w, Sink->:s) never fails {
    Sink->:d = raw irw_sink(w);
    drop sink_append(d, s);
    drop sink_write(d, "\n");
    pass NIL;
};

// A line at module level: a type definition, a declaration, a function header.
pub func:irw_raw = NIL(IrWriter->:w, string:text) never fails {
    Sink->:s = raw irw_sink(w);
    drop sink_write(s, text);
    drop sink_write(s, "\n");
    pass NIL;
};

// A line INSIDE a function, indented two spaces. The indentation is cosmetic and is
// here anyway: the IR is read by people during bootstrap far more often than it is
// read by `llc`.
pub func:irw_line = NIL(IrWriter->:w, string:text) never fails {
    Sink->:s = raw irw_sink(w);
    drop sink_write(s, "  ");
    drop sink_write(s, text);
    drop sink_write(s, "\n");
    pass NIL;
};

pub func:irw_blank = NIL(IrWriter->:w) never fails {
    drop sink_write(raw irw_sink(w), "\n");
    pass NIL;
};

// A label, which is a line at column zero inside a function body.
pub func:irw_label = NIL(IrWriter->:w, string:name) never fails {
    Sink->:s = raw irw_sink(w);
    drop sink_write(s, name);
    drop sink_write(s, ":\n");
    pass NIL;
};

// --- names ----------------------------------------------------------------------

// A NEW TEMPORARY. Sequential, per function, and the only source of value names —
// nothing else may invent one, because two schemes numbering into the same space is
// how a `%3` comes to mean two things.
//
// `%t0` AND NOT `%0`, and the letter is load-bearing (0.7.4). LLVM treats a bare
// NUMERIC name as its own implicit counter: numbered values must be defined in
// exactly ascending order with no gaps, so a temp that is handed out and then not
// written — or written after a branch reordered things — is not sloppy IR, it is IR
// `llc` REJECTS. A lettered name carries no such obligation, which turns "every
// temp must be emitted, in order, exactly once" from a global invariant every
// future lowering must maintain into a rule nobody has to remember. The seed uses
// `%tN` for the same reason.
pub func:irw_temp = string(IrWriter->:w) never fails {
    string:t = string_concat("%t", int_to_string(w.next_temp => int64));
    w.next_temp = w.next_temp + 1i32;
    pass t;
};

pub func:irw_new_label = string(IrWriter->:w, string:stem) never fails {
    string:l = string_concat(stem, int_to_string(w.next_label => int64));
    w.next_label = w.next_label + 1i32;
    pass l;
};

// EVERY FUNCTION STARTS FROM ZERO. Called at the head of each one, so that the
// numbering of a function's temporaries is a property of that function.
pub func:irw_begin_function = NIL(IrWriter->:w) never fails {
    // From here on the module stream is the TAIL; the frame types splice in
    // between it and the head.
    w.seen_fn = true;
    w.next_temp = 0i32;
    w.next_label = 0i32;
    w.stmt_mark = 0i32;
    w.alloca_since = 0i32;
    pass NIL;
};

// A statement begins: remember where the temps stood. Read by `emit_await`.
pub func:irw_stmt_mark = NIL(IrWriter->:w) never fails {
    w.stmt_mark = w.next_temp;
    w.alloca_since = 0i32;
    pass NIL;
};

// Has this statement minted only allocas so far?
pub func:irw_clean_since_mark = bool(IrWriter->:w) never fails {
    pass ((w.next_temp - w.stmt_mark) == w.alloca_since);
};

// `main` KEEPS ITS NAME FOR THE LINKER; everything else is prefixed, so a Nitpick
// name cannot collide with a runtime symbol.
//
// THIS MATCHES THE SEED EXACTLY and is not a choice this module gets to make: stage
// 1 is built by the seed and calls into the same runtime, so a different prefix
// would be two compilers emitting calls to two different symbols.
pub func:ir_symbol = string(string:name) never fails {
    // by name alone: D-248 makes `main` the root module's, so this is the program's
    if (raw string_eq(name, "main")) { pass "@main"; }
    pass (string_concat("@npk_", name));
};

// --- building a line --------------------------------------------------------------
//
// An instruction is five to seven pieces, and a chain of six `string_concat`
// calls buries which six. One definition, here, because the seed compiles the
// whole backend as one namespace — a private copy per module is a duplicate
// definition to it, and two copies of a helper is one more than the truth needs.

pub func:cat3 = string(string:a, string:b, string:c) never fails {
    pass (string_concat(string_concat(a, b), c));
};

pub func:cat4 = string(string:a, string:b, string:c, string:d) never fails {
    pass (string_concat(raw cat3(a, b, c), d));
};

pub func:cat5 = string(string:a, string:b, string:c, string:d, string:e) never fails {
    pass (string_concat(raw cat4(a, b, c, d), e));
};

// --- reading it back --------------------------------------------------------------
//
// For a test, and for a driver that writes the whole module at once.
pub func:irw_length = int64(IrWriter->:w) never fails {
    pass (raw sink_length(@w.out));
};

pub func:irw_byte_at = uint8(IrWriter->:w, int64:i) never fails {
    pass (raw sink_byte_at(@w.out, i));
};

pub func:irw_text = string(IrWriter->:w) never fails {
    // MID-FUNCTION, the allocas and body are still in their own sinks (1.0.9a),
    // not yet spliced into `out` — so a read taken before the function closes
    // (a unit test emitting expressions and checking the text) must assemble
    // the view: `out`, then the hoisted allocas, then the body. Outside a
    // function both are empty of anything current and `out` holds it all.
    string:t = raw sink_view(@w.out);
    t = string_concat(t, raw sink_view(@w.types));
    t = string_concat(t, raw sink_view(@w.tail));
    if (w.in_fn) {
        t = string_concat(t, raw sink_view(@w.allocas));
        t = string_concat(t, raw sink_view(@w.body));
    }
    pass t;
};
