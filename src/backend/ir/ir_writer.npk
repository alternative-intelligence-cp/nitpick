// The LLVM IR text writer.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.7.1 — the first module of the backend.
//
// TEXT, NOT A STRUCTURE. The output is LLVM IR as characters, which is what `llc`
// takes and what a person can read. There is no intermediate object graph to keep
// in step with the text, because there is only one consumer and the text IS the
// artifact.
//
// DETERMINISM IS A REQUIREMENT, NOT A NICETY (D-078). Identical input must produce
// BYTE-IDENTICAL output — not equivalent IR, identical bytes — because D-085's
// stage-1/stage-2 fixpoint check compares two compilers' output for equality, and a
// single reordered iteration makes that check meaningless.
//
// What that rules out is worth stating, because each is a thing a writer normally
// does: no iteration over anything unordered, no temp numbered by visit order rather
// than by source order, no "whichever came first" tie-break. Every counter here is
// sequential and every walk that uses it goes in source order.
//
// THE SEED'S OUTPUT IS THE REFERENCE. Stage 1 is built by the seed and stage 2 by
// stage 1, so the two compilers' IR meets at every runtime symbol and every layout
// until the fixpoint closes. Symbol naming in particular is not a free choice: it is
// whatever `bootstrap/generator/emit.py` already does.

mod:ir_writer;

use "../../frontend/intern.npk".*;
use "../../frontend/diagnostics.npk".*;

pub struct:IrWriter = {
    // WRITTEN THROUGH A SINK, which grows since 0.7.1. A fixed buffer that dropped
    // what did not fit would produce a program that compiles to something other
    // than what was written, with nothing reporting it.
    Sink:out;

    // A FUNCTION'S BODY AND ITS HOISTED ALLOCAS, buffered separately while the
    // function is emitted and spliced into `out` at its close (1.0.9a). An
    // `alloca` inside a loop body allocates fresh stack every iteration and
    // reclaims none until the function returns, so a walk over a large program
    // overflows the stack; every alloca is emitted into `allocas` and placed
    // once, right after `entry:`, regardless of where in the body it was
    // discovered — the entry block dominates everything, so this is always
    // valid, and the value name is unchanged. While `in_fn` is set, `irw_line`,
    // `irw_label` and `irw_raw` write to `body`; `irw_alloca` writes to
    // `allocas`; outside a function they write to `out` as before.
    Sink:allocas;
    Sink:body;
    bool:in_fn;

    // THE MODULE'S COROUTINE FRAME TYPES, held apart and spliced in AHEAD of
    // the first function (1.1.10-D1). A frame type's shape is not known until
    // its body has been scanned for crossing locals, so it is written where it
    // is discovered — in the middle of the module — while the call sites that
    // ask for its SIZE may be anywhere, including earlier. LLVM will not size
    // a forward-referenced named type, so `async func:main` awaiting a helper
    // declared below it produced `base element of getelementptr must be
    // sized` from llc rather than a program. Every existing test happened to
    // declare its callees first, which is why nothing caught it.
    //
    // `out` is the head — everything before the first function, where the
    // aggregate types a frame may embed are already defined — and `tail` is
    // everything from the first function on. The assembled text is
    // head, frame types, tail.
    Sink:types;
    Sink:tail;
    bool:seen_fn;

    // `%t0`, `%t1`, … WITHIN ONE FUNCTION. Reset at each function's start, so a
    // function's IR depends on that function alone — which is what makes a
    // one-function change produce a one-function diff.
    int32:next_temp;

    // Basic-block labels, numbered in the same way and for the same reason.
    int32:next_label;

    // THE STATEMENT MARK (D-177, 1.1.4): where the temp counter stood when the
    // current statement began, and how many of the temps minted since were
    // allocas. An `await` is stage-C-legal only when every temp its statement
    // has minted so far is an alloca: an SSA value minted before the
    // suspension and used after it would not dominate its use once the resume
    // switch re-enters mid-body. Allocas are exempt — they are hoisted to the
    // entry block, which dominates every segment.
    int32:stmt_mark;
    int32:alloca_since;

    // THE SITE REGISTRY (D-179, 1.1.6): one row per stamp site — the places
    // `fail` resets the origin chain and `relay`/`?!` extend it. Ids from 1
    // (0 is the runtime's own reserved site); rows are (path, line), deduped,
    // in first-registration order, which is emission order — deterministic
    // (D-078). Emitted at the program's tail as two tables and two lookup
    // functions the `site_line`/`site_path` builtins call.
    wild string->:site_paths;
    wild int32->:site_lines;
    int32:site_count;
    int32:site_cap;
};

pub func:irw_to_buffer = IrWriter() never fails {
    IrWriter:w = IrWriter{ out: raw sink_to_buffer(4096i64),
                           allocas: raw sink_to_buffer(1024i64),
                           body: raw sink_to_buffer(4096i64),
                           in_fn: false,
                           types: raw sink_to_buffer(1024i64),
                           tail: raw sink_to_buffer(4096i64),
                           seen_fn: false,
                           next_temp: 0i32, next_label: 0i32,
                           stmt_mark: 0i32, alloca_since: 0i32,
                           site_paths: (alloc(16i64 * #size_of<string>())) =>! wild string->,
                           site_lines: (alloc(16i64 * 4i64)) =>! wild int32->,
                           site_count: 0i32, site_cap: 16i32 };
    pass w;
};

// THE SINK A NON-ALLOCA LINE GOES TO: the body while a function is open, the
// module stream otherwise.
func:irw_sink = Sink->(IrWriter->:w) never fails {
    if (w.in_fn) { pass (@w.body); }
    if (w.seen_fn) { pass (@w.tail); }
    pass (@w.out);
};

// A COROUTINE FRAME TYPE, into the sink that splices ahead of every function
// (1.1.10-D1). Not `irw_raw`: the whole point is that this line does NOT stay
// where it was written.
pub func:irw_frame_type = NIL(IrWriter->:w, string:line) never fails {
    drop sink_write(@w.types, line);
    drop sink_write(@w.types, "\n");
    pass NIL;
};

// OPEN A FUNCTION'S BUFFERS (1.0.9a). The define line and `entry:` label are
// written to `out` BEFORE this, so allocas and body land after them at close.
pub func:irw_open_fn = NIL(IrWriter->:w) never fails {
    drop sink_reset(@w.allocas);
    drop sink_reset(@w.body);
    w.in_fn = true;
    pass NIL;
};

// CLOSE A FUNCTION: allocas first, then the body, into the module stream.
pub func:irw_close_fn = NIL(IrWriter->:w) never fails {
    w.in_fn = false;
    // INTO THE SAME STREAM THE `define` LINE WENT TO, which is the tail once
    // any function has begun (1.1.10-D1) — splicing into `out` unconditionally
    // put every function's body in the head, ahead of its own header.
    Sink->:dst = raw irw_sink(w);
    drop sink_append(dst, @w.allocas);
    drop sink_append(dst, @w.body);
    pass NIL;
};

// AN ALLOCA, HOISTED (1.0.9a). Always inside a function; the line goes to the
// alloca buffer and is placed right after `entry:` at close.
pub func:irw_alloca = NIL(IrWriter->:w, string:slot, string:ty_text) never fails {
    w.alloca_since = w.alloca_since + 1i32;
    drop sink_write(@w.allocas, "  ");
    drop sink_write(@w.allocas, slot);
    drop sink_write(@w.allocas, " = alloca ");
    drop sink_write(@w.allocas, ty_text);
    drop sink_write(@w.allocas, "\n");
    pass NIL;
};


// A NON-ALLOCA LINE IN THE ENTRY BLOCK (D-177, 1.1.4): the coroutine's frame
// GEPs, and at close its state load and `switch`. Same stream as the hoisted
// allocas, so everything lands after `entry:` and before the body — the GEPs
// are pure address arithmetic, so order within the entry block cannot matter.
pub func:irw_entry = NIL(IrWriter->:w, string:text) never fails {
    drop sink_write(@w.allocas, "  ");
    drop sink_write(@w.allocas, text);
    drop sink_write(@w.allocas, "\n");
    pass NIL;
};

// One stamp site, registered: its id, minting the row on first sight.
pub func:irw_site = int32(IrWriter->:w, move string:path, int32:line) never fails {
    int32:i = 0i32;
    while (i < w.site_count) {
        if (w.site_lines[i => int64] == line) {
            if (raw string_eq(w.site_paths[i => int64], path)) {
                pass (i + 1i32);
            }
        }
        i = i + 1i32;
    }
    if (w.site_count >= w.site_cap) {
        int64:ncap = (w.site_cap => int64) * 2i64;
        wild int8->:na = ralloc(w.site_paths =>! wild int8->,
                                ncap * #size_of<string>());
        wild int8->:nb = ralloc(w.site_lines =>! wild int8->, ncap * 4i64);
        w.site_paths = na =>! wild string->;
        w.site_lines = nb =>! wild int32->;
        w.site_cap = ncap =>! int32;
    }
    w.site_paths[w.site_count => int64] = move(path);
    w.site_lines[w.site_count => int64] = line;
    w.site_count = w.site_count + 1i32;
    pass w.site_count;
};

// --- writing --------------------------------------------------------------------

// A line at module level: a type definition, a declaration, a function header.
pub func:irw_raw = NIL(IrWriter->:w, string:text) never fails {
    Sink->:s = raw irw_sink(w);
    drop sink_write(s, text);
    drop sink_write(s, "\n");
    pass NIL;
};

// A line INSIDE a function, indented two spaces. The indentation is cosmetic and is
// here anyway: the IR is read by people during bootstrap far more often than it is
// read by `llc`.
pub func:irw_line = NIL(IrWriter->:w, string:text) never fails {
    Sink->:s = raw irw_sink(w);
    drop sink_write(s, "  ");
    drop sink_write(s, text);
    drop sink_write(s, "\n");
    pass NIL;
};

pub func:irw_blank = NIL(IrWriter->:w) never fails {
    drop sink_write(raw irw_sink(w), "\n");
    pass NIL;
};

// A label, which is a line at column zero inside a function body.
pub func:irw_label = NIL(IrWriter->:w, string:name) never fails {
    Sink->:s = raw irw_sink(w);
    drop sink_write(s, name);
    drop sink_write(s, ":\n");
    pass NIL;
};

// --- names ----------------------------------------------------------------------

// A NEW TEMPORARY. Sequential, per function, and the only source of value names —
// nothing else may invent one, because two schemes numbering into the same space is
// how a `%3` comes to mean two things.
//
// `%t0` AND NOT `%0`, and the letter is load-bearing (0.7.4). LLVM treats a bare
// NUMERIC name as its own implicit counter: numbered values must be defined in
// exactly ascending order with no gaps, so a temp that is handed out and then not
// written — or written after a branch reordered things — is not sloppy IR, it is IR
// `llc` REJECTS. A lettered name carries no such obligation, which turns "every
// temp must be emitted, in order, exactly once" from a global invariant every
// future lowering must maintain into a rule nobody has to remember. The seed uses
// `%tN` for the same reason.
pub func:irw_temp = string(IrWriter->:w) never fails {
    string:t = string_concat("%t", int_to_string(w.next_temp => int64));
    w.next_temp = w.next_temp + 1i32;
    pass t;
};

pub func:irw_new_label = string(IrWriter->:w, string:stem) never fails {
    string:l = string_concat(stem, int_to_string(w.next_label => int64));
    w.next_label = w.next_label + 1i32;
    pass l;
};

// EVERY FUNCTION STARTS FROM ZERO. Called at the head of each one, so that the
// numbering of a function's temporaries is a property of that function.
pub func:irw_begin_function = NIL(IrWriter->:w) never fails {
    // From here on the module stream is the TAIL; the frame types splice in
    // between it and the head.
    w.seen_fn = true;
    w.next_temp = 0i32;
    w.next_label = 0i32;
    w.stmt_mark = 0i32;
    w.alloca_since = 0i32;
    pass NIL;
};

// A statement begins: remember where the temps stood. Read by `emit_await`.
pub func:irw_stmt_mark = NIL(IrWriter->:w) never fails {
    w.stmt_mark = w.next_temp;
    w.alloca_since = 0i32;
    pass NIL;
};

// Has this statement minted only allocas so far?
pub func:irw_clean_since_mark = bool(IrWriter->:w) never fails {
    pass ((w.next_temp - w.stmt_mark) == w.alloca_since);
};

// `main` KEEPS ITS NAME FOR THE LINKER; everything else is prefixed, so a Nitpick
// name cannot collide with a runtime symbol.
//
// THIS MATCHES THE SEED EXACTLY and is not a choice this module gets to make: stage
// 1 is built by the seed and calls into the same runtime, so a different prefix
// would be two compilers emitting calls to two different symbols.
pub func:ir_symbol = string(string:name) never fails {
    if (raw string_eq(name, "main")) { pass "@main"; }
    pass (string_concat("@npk_", name));
};

// --- building a line --------------------------------------------------------------
//
// An instruction is five to seven pieces, and a chain of six `string_concat`
// calls buries which six. One definition, here, because the seed compiles the
// whole backend as one namespace — a private copy per module is a duplicate
// definition to it, and two copies of a helper is one more than the truth needs.

pub func:cat3 = string(string:a, string:b, string:c) never fails {
    pass (string_concat(string_concat(a, b), c));
};

pub func:cat4 = string(string:a, string:b, string:c, string:d) never fails {
    pass (string_concat(raw cat3(a, b, c), d));
};

pub func:cat5 = string(string:a, string:b, string:c, string:d, string:e) never fails {
    pass (string_concat(raw cat4(a, b, c, d), e));
};

// --- reading it back --------------------------------------------------------------
//
// For a test, and for a driver that writes the whole module at once.
pub func:irw_length = int64(IrWriter->:w) never fails {
    pass (raw sink_length(@w.out));
};

pub func:irw_byte_at = uint8(IrWriter->:w, int64:i) never fails {
    pass (raw sink_byte_at(@w.out, i));
};

pub func:irw_text = string(IrWriter->:w) never fails {
    // MID-FUNCTION, the allocas and body are still in their own sinks (1.0.9a),
    // not yet spliced into `out` — so a read taken before the function closes
    // (a unit test emitting expressions and checking the text) must assemble
    // the view: `out`, then the hoisted allocas, then the body. Outside a
    // function both are empty of anything current and `out` holds it all.
    string:t = string_from_bytes(w.out.buf, w.out.len);
    t = string_concat(t, string_from_bytes(w.types.buf, w.types.len));
    t = string_concat(t, string_from_bytes(w.tail.buf, w.tail.len));
    if (w.in_fn) {
        t = string_concat(t,
                string_from_bytes(w.allocas.buf, w.allocas.len));
        t = string_concat(t,
                string_from_bytes(w.body.buf, w.body.len));
    }
    pass t;
};
