// Expression lowering — literals, names, arithmetic, comparison, casts, calls.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.7.5.
//
// THE FRONTEND'S ANSWER IS THE TYPE; THIS MODULE NEVER TYPES ANYTHING. The
// checker recorded every expression's type in `ExprTypes` (0.4.2), and
// `check_kinds_typed` holds the line that every kind is covered. The seed could
// not do this — it rebuilds a checker scope per node and asks again — and asking
// again is two typings of one expression, which is two chances to disagree. The
// one place `ExprTypes` is silent is a bare-name builtin call, typed UNKNOWN on
// purpose ("its signature arrives with call checking"), and `ir_runtime.npk`
// exists precisely to answer there.
//
// NO `nsw`, NO `nuw`, EVER, ON ORDINARY ARITHMETIC (D-037). Overflow is DEFINED
// WRAPPING in Nitpick. Every C-family frontend emits `add nsw` because C says
// signed overflow is undefined — and that flag licenses LLVM to assume it never
// happens, which licenses deleting exactly the kind of guard a safety language
// adds. The prototype was bitten and worked around it by DISABLING OPTIMISATION
// for the affected types — a guarantee that lives in a build flag is not in the
// artifact, and verification analyses the optimised output, so a property that
// survives only at -O0 is one the analyzer never sees. Treat "works unoptimised"
// as a defect report about THIS module.
//
// EXTENSION FOLLOWS THE SOURCE'S SIGNEDNESS, NOT THE TARGET'S — a deliberate
// departure from the seed, which extends by the TARGET's. `uint32 => int64` of a
// value with the high bit set is value-preserving under zext and NEGATIVE under
// the seed's sext; D-021's checked cast promises no loss, and the seed's shape
// breaks the promise in the one corner its own sources never exercise. The seed
// compiles one program; this compiles whatever the frontend accepted.

mod:ir_expr;

use "../../frontend/source_location.npk".*;
use "../../frontend/source.npk".*;
use "../../frontend/intern.npk".*;
use "../../frontend/num_width.npk".*;
use "../../frontend/token_kind.npk".*;
use "../../frontend/ast_kind.npk".*;
use "../../frontend/ast.npk".*;
use "../../frontend/parse_expr.npk".*;
use "../../frontend/diagnostics.npk".*;
use "../../frontend/types.npk".*;
use "../../frontend/expr_types.npk".*;
use "../../frontend/type_layout.npk".*;
use "../../frontend/type_names.npk".*;
use "../../frontend/symbols.npk".*;
use "../../frontend/parse_decl.npk".*;
use "../../frontend/parse_decorate.npk".*;
use "./ir_writer.npk".*;
use "./ir_types.npk".*;
use "./ir_func.npk".*;
use "../../frontend/resolve_type.npk".*;
use "../../frontend/type_generic.npk".*;   // type_subst, for transitive instantiation (1.0.7)
use "../../frontend/type_trait.npk".*;     // the impl table, for a family instance reached through a bound (1.0.7)
use "./ir_runtime.npk".*;
// THE DECLARED CYCLE with the statement walker — `relay` exits the function,
// which runs the defer stack, which emits statements. Same shape, same reason,
// as `type_expr` ↔ `type_stmt` (0.4.2).
use "./ir_stmt.npk".*;

// An emitted value. `ll` and `ref` are what an instruction writes; `type_id` is
// the frontend's answer, 0 where the frontend deliberately has none (a builtin
// call). `wrapped`/`inner` carry what `raw` needs to know about a call's Result —
// STORED, not sniffed out of the text, because `cstring`'s `{ ptr, i64 }` is one
// brace away from reading like a wrapper.
//
// A REFUSAL CARRIES ITS CONSTRUCT AND ITS SPAN (0.7.7). `NITPICK-RUNG-001` must
// name the construct and the rung that enables it, at the place it was written —
// so the refusal site, which is the only thing that knows all three, records
// them. A bare state would make the driver reconstruct what it refused, which is
// how a diagnostic comes to point at the wrong thing.
pub struct:IrVal = {
    int32:state;      // LL_OK / LL_RUNG / LL_BROKEN, reusing ir_types' states
    string:rung;
    string:what;      // "the `for` loop" — the construct, for the diagnostic
    Span:at;
    string:ll;
    string:ref;
    int32:type_id;
    bool:wrapped;
    string:inner;
};

pub func:iv = IrVal(move string:ll, move string:ref, int32:type_id) never fails {
    IrVal:v = IrVal{ state: raw LL_OK(), rung: "", what: "", at: raw span_none(),
                     ll: move(ll), ref: move(ref),
                     type_id: type_id, wrapped: false, inner: "" };
    pass v;
};

pub func:iv_rung = IrVal(move string:what, move string:rung, Span:at) never fails {
    IrVal:v = IrVal{ state: raw LL_RUNG(), rung: move(rung), what: move(what), at: at,
                     ll: "", ref: "",
                     type_id: 0i32, wrapped: false, inner: "" };
    pass v;
};

pub func:iv_broken = IrVal(Span:at) never fails {
    IrVal:v = IrVal{ state: raw LL_BROKEN(), rung: "", what: "", at: at,
                     ll: "", ref: "",
                     type_id: 0i32, wrapped: false, inner: "" };
    pass v;
};

pub func:iv_is_ok = bool(IrVal:v) never fails { pass (v.state == (raw LL_OK())); };

// A statement's "it worked" — statements yield nothing, so the value slots are
// the NIL convention and only the state matters.
pub func:iv_nil = IrVal() never fails {
    pass (raw iv("i32", "0", 0i32));
};

// A refused TYPE, named as one. `LlType` has no span — a type is refused wherever
// it is mentioned — so the mention supplies it, and the type names itself.
// LENDS its LlType — this is the COLD error path, and its callers keep using
// the type they hand in (`pll2.text` two lines later), so consuming here
// forced every caller into a copy. The rung string is cloned instead, once,
// on a path that is already a refusal (D-183).
pub func:iv_from_ll_at = IrVal(ExprEmitter->:x, LlType:t, int32:type_id, Span:at) never fails {
    string:what = raw string_concat("the type `",
                      raw string_concat(raw type_display(x.fe.ctx.types,
                                              x.interns, type_id), "`"));
    if (t.state == (raw LL_RUNG())) {
        pass (raw iv_rung(move(what), raw string_concat(t.rung, ""), at));
    }
    pass (raw iv_broken(at));
};

// --- string literals live at module level -------------------------------------------
//
// A literal becomes a private constant and three insertvalues. The TABLE is
// module-wide — global names must be unique across the module — so the numbering
// is global too, exactly the seed's `@.str.N`.

pub struct:StrTable = {
    wild string->:items;
    int32:count;
    int32:cap;
};

pub func:strtab_init = StrTable() never fails {
    wild int8->:m = alloc(16i64 * #size_of<string>());
    StrTable:t = StrTable{ items: m =>! wild string->, count: 0i32, cap: 16i32 };
    pass t;
};

pub func:strtab_add = string(StrTable->:t, move string:data) never fails {
    if (t.count >= t.cap) {
        int32:nc = t.cap * 2i32;
        wild int8->:m = ralloc(t.items =>! wild int8->,
                               (nc => int64) * #size_of<string>());
        t.items = m =>! wild string->;
        t.cap = nc;
    }
    t.items[t.count => int64] = move(data);
    string:name = raw string_concat("@.str.",
                      raw int_to_string(t.count => int64));
    t.count = t.count + 1i32;
    pass name;
};

// One byte of a `c"…"` constant. Printable ASCII stays itself; `"` and `\` and
// everything else become `\XX` — two hex digits, uppercase, the seed's encoding.
pub func:esc_byte = string(uint8:b) never fails {
    if (b >= 32u8) {
        if (b < 127u8) {
            if (b != 34u8) {
                if (b != 92u8) {
                    wild int8->:one = alloc(1i64);
                    one[0i64] = b =>! int8;
                    pass (raw string_from_bytes(one, 1i64));
                }
            }
        }
    }
    string:hex = "0123456789ABCDEF";
    // MASK AFTER THE WIDENING. This function is seed-compiled until 1.3, and the
    // seed extends by the TARGET's signedness (the 0.7.5 divergence, met in the
    // wild): byte 226 — the lead of every em-dash — sign-extended to -30 and
    // indexed the hex table at -1. The mask makes the value 0..255 under EITHER
    // extension rule, which is what "correct" has to mean for code that runs
    // under two compilers until the fixpoint closes.
    int64:wide = (b =>! int64) & 255i64;
    wild int8->:buf = alloc(3i64);
    buf[0i64] = 92i8;                                   // backslash
    buf[1i64] = hex.ptr[(wide / 16i64)] =>! int8;
    buf[2i64] = hex.ptr[(wide % 16i64)] =>! int8;
    pass (raw string_from_bytes(buf, 3i64));
};

// The whole table, as module-level constants. Called by the driver once the
// bodies are emitted, which is why the table and the writer are separate things.
pub func:strtab_write_all = NIL(StrTable->:t, IrWriter->:w) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        string->:data = $$i t.items[i => int64];
        string:enc = "";
        int64:j = 0i64;
        while (j < data.len) {
            enc = raw string_concat(enc, raw esc_byte(data.ptr[j] => uint8));
            j = j + 1i64;
        }
        string:h1 = raw string_concat("@.str.", raw int_to_string(i => int64));
        string:h2 = raw string_concat(h1, " = private unnamed_addr constant [");
        string:h3 = raw string_concat(h2, raw int_to_string(data.len));
        string:h4 = raw string_concat(h3, " x i8] c\"");
        string:h5 = raw string_concat(h4, enc);
        drop irw_raw(w, raw string_concat(h5, "\""));
        i = i + 1i32;
    }
    pass NIL;
};

// --- the emitter --------------------------------------------------------------------

pub struct:ExprEmitter = {
    FnEmitter->:fe;
    Ast->:ast;
    ExprTypes->:et;
    SymbolTable->:tab;
    InternTable->:interns;
    StrTable->:strs;
    SourceManager->:sm;   // for the origin chain's site paths (D-179, 1.1.6)

    // FOR ANNOTATIONS, NOT FOR EXPRESSIONS (0.7.6). A declaration's type is an
    // AST type node the checker resolved and did not store, so the emitter
    // resolves it again — a cache hit by construction, since the checker already
    // interned every type this can produce. Expressions never come here; their
    // types are in `et`.
    TypeResolver->:tr;
    int32:scope;

    // The generic-function instantiations the frontend recorded (1.0.2b). A
    // generic call reads this to name its specialization; nothing else does.
    FnInstTable->:fninsts;

    // THE TRAIT OF THE IMPL BEING EMITTED, or 0 outside one (1.0.5b). It is the
    // other half of a method symbol, and the half a `Self`-receiver call cannot
    // get any other way: a trait DEFAULT is typed ONCE with `Self` opaque, so
    // the checker cannot record a per-impl symbol for `self.size()` inside it —
    // there is no one impl at that point. The emitter is where there is: the
    // default is emitted once per implementing impl, and this plus
    // `tr.self_type` say which. Same substitution shape as 1.0.2b's generic
    // bodies, for the same reason.
    int32:cur_trait;
};

pub func:exprem_init = ExprEmitter(FnEmitter->:fe, Ast->:ast, ExprTypes->:et,
                                   SymbolTable->:tab, InternTable->:interns,
                                   StrTable->:strs, SourceManager->:sm,
                                   TypeResolver->:tr,
                                   FnInstTable->:fninsts, int32:scope) never fails {
    ExprEmitter:x = ExprEmitter{ fe: fe, ast: ast, et: et, tab: tab,
                                 interns: interns, strs: strs, sm: sm, tr: tr,
                                 fninsts: fninsts, scope: scope,
                                 cur_trait: 0i32 };
    pass x;
};

// The lowered text of this expression's frontend-recorded type.
func:node_ll = LlType(ExprEmitter->:x, ExprId:id) never fails {
    pass (raw ll_type(x.fe.ctx, raw exprtypes_get(x.et, id)));
};

// --- dispatch -----------------------------------------------------------------------

// EVERY VALUE LEAVES HERE CARRYING ITS RECORDED TYPE (1.0.6e). The kind walk
// below returns from sixty-odd places, and several of them answer with a bare
// `iv("i8", …, 0i32)` — a comparison, a `bool` literal — because nothing
// downstream asked. `emit_fit` asks: it decides whether a value needs building
// into the slot it is going to by the value's TYPE, and a `true` going into a
// `bool?` slot with no type recorded would be stored bare. One stamp here
// rather than sixty — the same wrapper shape `type_of_expr` uses for the same
// reason, and only where the kind walk left the field empty, since a call's
// value deliberately carries its `Result` type.
pub func:emit_expr = IrVal(ExprEmitter->:x, ExprId:id) never fails {
    IrVal:v = raw emit_expr_kind(x, id);
    if (v.state != (raw LL_OK())) { pass v; }
    if (v.type_id == 0i32) {
        if (raw exprtypes_known(x.et, id)) {
            v.type_id = raw exprtypes_get(x.et, id);
        }
    }
    pass v;
};

// THE BACKEND'S HALF OF `fits` (1.0.6e). The checker's `fits` is the one place
// that says what may be written where a slot expects something else, and it
// admits exactly two shapes beyond equality: a concrete value into a `dyn`
// slot, built into a fat pointer (D-158/D-159), and — from 1.0.7 — a bare `T`
// into an `Optional<T>` slot, wrapped (D-099). Nothing else is coerced (D-092).
//
// THIS IS THE ONLY PLACE A VALUE IS BUILT INTO A SLOT, and it is called at every
// site `fits` is: a declaration's initialiser, an assignment, a call argument,
// `pass`, a literal's field or element, a `pick` arm's `give`, an unwrap's
// default. Before it existed the declaration site widened inline and the other
// fifteen stored the raw value — an assignment of a `Cat` into a `dyn` slot
// wrote 4 bytes over a 16-byte fat pointer and dispatched through what was
// left. `check_slot_sites_agree` pairs the two lists so a `fits` site cannot
// be added without its partner.
//
// SUBSTITUTED FIRST. Inside a specialization the value's recorded type may still
// be the parameter `T` (D-107), so both sides are read through the binding
// before their kinds are compared; `ll_type` does the same for the text.
// `v` IS CONSUMED (D-183): fitting often IS the identity, and an identity
// passthrough of a lent value returns a header whose body the caller still
// owns — six of this function's returns did exactly that. The callers all
// write `v = emit_fit(x, want, move(v), at)`, the move-then-reassign shape
// D-065's analysis accepts.
pub func:emit_fit = IrVal(ExprEmitter->:x, int32:want, move IrVal:v, Span:at) never fails {
    if (v.state != (raw LL_OK())) { pass v; }
    if (want == 0i32) { pass v; }
    if (v.type_id == want) { pass v; }
    if (v.type_id == 0i32) { pass v; }
    int32:w = raw subst_emitted_param(x.fe.ctx, want);
    int32:g = raw subst_emitted_param(x.fe.ctx, v.type_id);
    if (w == g) { pass v; }
    int32:wk = raw type_kind(x.fe.ctx.types, w);
    if (wk == (raw TY_DYN())) {
        if ((raw type_kind(x.fe.ctx.types, g)) != (raw TY_DYN())) {
            pass (raw emit_dyn_from(x, w, v, at));
        }
        // `dyn A & B` TO `dyn A` IS A REBUILD, not a store: the shapes differ
        // by a word per dropped bound (D-159).
        pass (raw emit_dyn_widen(x, w, v, at));
    }
    // A BARE `T` INTO AN `Optional<T>` SLOT IS WRAPPED (D-099, 1.0.7): the one
    // implicit conversion in the language, and the only way an `Optional`
    // holding a value is built, since there is no constructor to write.
    if (wk == (raw TY_OPTIONAL())) {
        if ((raw type_kind(x.fe.ctx.types, g)) != (raw TY_OPTIONAL())) {
            pass (raw emit_opt_wrap(x, w, v, at));
        }
    }
    pass v;
};

// `{ i8 1, T v }` — the tag over a zeroed aggregate, then the value. Two
// `insertvalue`s over `zeroinitializer` rather than one over a spelled-out
// constant, so the value half's text never has to be written here.
pub func:emit_opt_wrap = IrVal(ExprEmitter->:x, int32:opt_ty, IrVal:v,
                               Span:at) never fails {
    LlType:oll = raw ll_type(x.fe.ctx, opt_ty);
    if (!(raw ll_is_ok(oll))) { pass (raw iv_from_ll_at(x, oll, opt_ty, at)); }
    string:tagged = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(tagged, " = insertvalue ",
                      raw string_concat(oll.text, " zeroinitializer, i8 1, 0")));
    string:full = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(full, " = insertvalue ", oll.text, " ",
                      raw cat5(tagged, ", ", v.ll, " ",
                          raw string_concat(v.ref, ", 1"))));
    pass (raw iv(move(oll.text), move(full), opt_ty));
};

// The VALUE half of a Result-shaped LLVM type text — for an operand the
// checker typed as UNKNOWN (a bare-name builtin), whose layout is still fully
// present in the IrVal's own ll: `{ i64, i32 }` carries an i64, and the
// one-slot `{ i32 }` is `Result<NIL>` with no value at all (D-163, 1.1.2 —
// the `?!`-on-a-builtin sites the flip's sweeps write).
//
// RETURNS AN OWNED STRING (1.2.3). The first shape passed a `slice_proven`
// VIEW of the lent `ll` out, and the caller moved it into the result IrVal —
// whose life exceeds the operand IrVal that owns the body. Nothing noticed
// for as long as IrVals never dropped; the moment struct drops armed, the
// operand's scope-exit drop freed the body under the view, and the next
// vardecl store emitted seventeen bytes of allocator poison as its type.
// The quarantine allocator caught it at the read (see npkrt's
// @npk_quarantine). A helper that derives a string from a LENT parameter
// must hand back a body the caller owns; the "" arms are literals, which a
// drop already skips by cap==0, so the contract is uniform either way.
func:result_ll_value_half = string(string:ll) never fails {
    if (raw string_eq(ll, "{ i32 }")) { pass ""; }
    // strip leading "{ " and trailing ", i32 }"
    if (ll.len <= 9i64) { pass ""; }
    pass (raw string_concat(raw slice_proven(ll, 2i64, ll.len - 7i64), ""));
};

func:emit_expr_kind = IrVal(ExprEmitter->:x, ExprId:id) never fails {
    ExprNode:n = raw ast_expr(x.ast, id);

    if (n.kind == ExprKind.ExprIntLiteral)    { pass (raw emit_int(x, id, n)); }
    if (n.kind == ExprKind.ExprBoolLiteral) {
        if (n.payload == 1i64) { pass (raw iv("i8", "1", 0i32)); }
        pass (raw iv("i8", "0", 0i32));
    }
    if (n.kind == ExprKind.ExprCharLiteral) {
        pass (raw iv("i8", raw int_to_string(n.payload), 0i32));
    }
    if (n.kind == ExprKind.ExprSentinelLiteral) {
        // NIL is the zero-width value; its `i32 0` exists only to have something
        // to hand `Result<NIL>` machinery. NULL is the pointer. ERR (0.9.5) is
        // the `tbb` taint (D-008): the sentinel of whatever width the checker
        // gave this position, from the one shared table.
        // `NIL` WHERE AN `Optional<T>` IS EXPECTED IS THE EMPTY ONE (D-099,
        // 1.0.7): the checker typed it AS the `Optional`, and it lowers to
        // `zeroinitializer` — tag 0 and a ZEROED value half, never `undef`. The
        // spec's IR comment writes `i32 undef` for the empty value; a defined
        // byte is what the `fail` desugar already chooses for a `Result`'s
        // value half (§11.2), and what a verifier can reason about.
        if (n.payload == 0i64) {
            int32:ntid = raw exprtypes_get(x.et, id);
            if ((raw type_kind(x.fe.ctx.types, ntid)) == (raw TY_OPTIONAL())) {
                LlType:nll = raw ll_type(x.fe.ctx, ntid);
                if (!(raw ll_is_ok(nll))) {
                    pass (raw iv_from_ll_at(x, nll, ntid, n.span));
                }
                pass (raw iv(move(nll.text), "zeroinitializer", ntid));
            }
            pass (raw iv("i32", "0", 0i32));
        }
        if (n.payload == 1i64) { pass (raw iv("ptr", "null", 0i32)); }
        int32:stid = raw exprtypes_get(x.et, id);
        int32:sbits2 = raw type_int_bits(x.fe.ctx.types, stid);
        string:smn = raw tbb_min_decimal(sbits2);
        if (smn.len == 0i64) { pass (raw iv_broken(n.span)); }
        LlType:sll = raw ll_type(x.fe.ctx, stid);
        if (!(raw ll_is_ok(sll))) { pass (raw iv_from_ll_at(x, sll, stid, n.span)); }
        pass (raw iv(move(sll.text), move(smn), stid));
    }
    if (n.kind == ExprKind.ExprStringLiteral) { pass (raw emit_string(x, n)); }
    if (n.kind == ExprKind.ExprIdentifierExpr){ pass (raw emit_ident(x, id, n)); }
    if (n.kind == ExprKind.ExprUnaryExpr)     { pass (raw emit_unary(x, id, n)); }
    if (n.kind == ExprKind.ExprBinaryExpr)    { pass (raw emit_binary(x, id, n)); }
    if (n.kind == ExprKind.ExprCastExpr)      { pass (raw emit_cast(x, id, n)); }
    if (n.kind == ExprKind.ExprUncheckedCastExpr) { pass (raw emit_cast(x, id, n)); }
    if (n.kind == ExprKind.ExprCallExpr)      { pass (raw emit_call(x, id, n)); }
    if (n.kind == ExprKind.ExprRawUnwrapExpr) { pass (raw emit_raw(x, id, n)); }
    if (n.kind == ExprKind.ExprDropExpr) {
        // The SPAWN form (D-058/D-177 stage E): `drop` of an `async` call
        // links a child onto the join list instead of calling anything.
        int32:spd = raw await_callee_decl(x, raw expr_operand(n));
        if (spd != 0i32) {
            if (raw decl_has(raw ast_decl(x.ast, DeclId{ index: spd }),
                             raw DECL_THREAD())) {
                pass (raw emit_thread_spawn(x, raw expr_operand(n), n, spd));
            }
            pass (raw emit_spawn(x, raw expr_operand(n), n, spd));
        }
        IrVal:v = raw emit_expr(x, raw expr_operand(n));
        if (v.state != (raw LL_OK())) { pass v; }
        pass (raw iv("i32", "0", 0i32));
    }

    if (n.kind == ExprKind.ExprRelayExpr)    { pass (raw emit_relay(x, id, n)); }

    if (n.kind == ExprKind.ExprMemberAccessExpr) { pass (raw emit_member(x, id, n)); }
    if (n.kind == ExprKind.ExprIndexExpr)        { pass (raw emit_index(x, id, n)); }
    // `@` and `$$` both lower to the address; that a borrow is SECOND-CLASS is
    // the escape analysis's guarantee (0.5), not a difference in representation.
    if (n.kind == ExprKind.ExprAddressOfExpr)    { pass (raw emit_addr_op(x, id, n)); }
    if (n.kind == ExprKind.ExprBorrowExpr)       { pass (raw emit_addr_op(x, id, n)); }
    if (n.kind == ExprKind.ExprDerefExpr)        { pass (raw emit_deref(x, id, n)); }
    if (n.kind == ExprKind.ExprStructLiteralExpr){ pass (raw emit_struct_lit(x, id, n)); }
    if (n.kind == ExprKind.ExprArrayLiteralExpr) { pass (raw emit_array_lit(x, id, n)); }
    if (n.kind == ExprKind.ExprResultLiteralExpr){ pass (raw emit_result_lit(x, id, n)); }
    if (n.kind == ExprKind.ExprBuiltinExpr)      { pass (raw emit_builtin(x, id, n)); }

    // A raw or block string differs from a plain one in LEXING only; by here all
    // three are an intern index of decoded bytes.
    if (n.kind == ExprKind.ExprRawStringLiteral)   { pass (raw emit_string(x, n)); }
    if (n.kind == ExprKind.ExprBlockStringLiteral) { pass (raw emit_string(x, n)); }

    // --- classified refusals, one rung each ---------------------------------
    if (n.kind == ExprKind.ExprMethodCallExpr) {
        // `Ev.Move(5i32)` parses as a method call; the receiver naming an enum
        // DECLARATION is what distinguishes a constructor from a real method,
        // exactly the test the checker makes.
        int32:edecl = raw member_enum_decl(x, n);
        if (edecl != 0i32) {
            pass (raw emit_ctor(x, id, n.span, raw exprtypes_get(x.et, id),
                      n.payload =>! int32, raw expr_list_start(n),
                      raw expr_list_count(n)));
        }
        // THE ARENA'S OWN OPERATIONS (D-152) lower here; every other method
        // call stays 1.0's.
        int32:amrecv = raw exprtypes_get(x.et, raw expr_operand(n));
        int32:amk = raw type_kind(x.fe.ctx.types, amrecv);
        if (amk == (raw TY_ARENA())) {
            pass (raw emit_arena_method(x, id, n, amrecv));
        }
        if (amk == (raw TY_SHARED_ARENA())) {
            pass (raw emit_sarena_method(x, id, n, amrecv));
        }
        if (amk == (raw TY_ATOMIC())) {
            pass (raw emit_atomic_method(x, id, n, amrecv));
        }
        if (amk == (raw TY_CHANNEL())) {
            pass (raw emit_channel_method(x, id, n, amrecv));
        }
        if (amk == (raw TY_POINTER())) {
            if ((raw type_kind(x.fe.ctx.types,
                     raw type_elem(x.fe.ctx.types, amrecv))) == (raw TY_ARENA())) {
                pass (raw emit_arena_method(x, id, n, amrecv));
            }
        }
        pass (raw emit_method_call(x, id, n));
    }
    if (n.kind == ExprKind.ExprSafeNavExpr)     { pass (raw emit_safe_nav(x, id, n)); }
    if (n.kind == ExprKind.ExprNullCoalesceExpr) { pass (raw emit_coalesce(x, id, n)); }
    if (n.kind == ExprKind.ExprSafeUnwrapExpr) {
        // `r ?| default` (D-175): the value, or the default — LAZY, so the
        // default only evaluates on the error path. Reached via `?|` now (D-175
        // restored it as the fallback); a bare `?` is refused at parse.
        IrVal:qv = raw emit_expr(x, raw expr_lhs(n));
        if (!(raw iv_is_ok(qv))) { pass qv; }
        int32:qtid = raw exprtypes_get(x.et, id);
        // `r ?| NIL` — a NIL success has NO value channel (found by 1.1.1's
        // `?| NIL` statements: this arm allocated a `void` slot, which LLVM
        // refuses). Both arms produce nothing, so the whole expression is the
        // evaluation of `r`; the error is deliberately ignored either way.
        if (qtid == x.fe.ctx.types.t_nil) {
            pass (raw iv_nil());
        }
        LlType:qll = raw ll_type(x.fe.ctx, qtid);
        if (!(raw ll_is_ok(qll))) { pass (raw iv_from_ll_at(x, qll, qtid, n.span)); }
        string:qslot = raw irw_temp(x.fe.w);
        drop irw_alloca(x.fe.w, qslot, qll.text);
        string:qerr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(qerr, " = extractvalue ", qv.ll, " ",
                          raw string_concat(qv.ref, ", 1")));
        string:qbad = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(qbad, " = icmp ne i32 ",
                          raw string_concat(qerr, ", 0")));
        string:qd_l = raw irw_new_label(x.fe.w, "q.def");
        string:qo_l = raw irw_new_label(x.fe.w, "q.ok");
        string:qj_l = raw irw_new_label(x.fe.w, "q.done");
        drop irw_line(x.fe.w, raw cat5("br i1 ", qbad, ", label %", qd_l,
                          raw string_concat(", label %", qo_l)));
        drop irw_label(x.fe.w, qo_l);
        string:qin = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(qin, " = extractvalue ", qv.ll, " ",
                          raw string_concat(qv.ref, ", 0")));
        drop irw_line(x.fe.w, raw cat5("store ", qll.text, " ", qin,
                          raw string_concat(", ptr ", qslot)));
        drop irw_line(x.fe.w, raw cat3("br label %", qj_l, ""));
        drop irw_label(x.fe.w, qd_l);
        IrVal:qdv = raw emit_expr(x, raw expr_rhs(n));
        if (!(raw iv_is_ok(qdv))) { pass qdv; }
        // THE DEFAULT IS A SLOT (1.0.6e), of the Result's `T`.
        qdv = raw emit_fit(x, qtid, move(qdv), n.span);
        if (!(raw iv_is_ok(qdv))) { pass qdv; }
        drop irw_line(x.fe.w, raw cat5("store ", qdv.ll, " ", qdv.ref,
                          raw string_concat(", ptr ", qslot)));
        drop irw_line(x.fe.w, raw cat3("br label %", qj_l, ""));
        drop irw_label(x.fe.w, qj_l);
        string:qout = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(qout, " = load ", qll.text, ", ptr ",
                          raw string_concat(qslot, "")));
        pass (raw iv(move(qll.text), move(qout), qtid));
    }
    if (n.kind == ExprKind.ExprEmphaticUnwrapExpr) {
        // `r ?! code` (0.9.7, OP §187): the value, or `failsafe(code)` through
        // the D-142 trap route — the CALLER'S code, not the Result's, because
        // the operator is the site saying what this failure means here.
        IrVal:ev2 = raw emit_expr(x, raw expr_lhs(n));
        if (!(raw iv_is_ok(ev2))) { pass ev2; }
        IrVal:ec2 = raw emit_expr(x, raw expr_rhs(n));
        if (!(raw iv_is_ok(ec2))) { pass ec2; }
        // `Result<NIL>` is `{ i32 }` — the error rides slot 0 and there is no
        // value channel (found by 1.1.1's `f() ?! c;` statements, the first to
        // emit this arm over NIL: slot 1 does not exist, and the "value"
        // extract would have read the error).
        int32:etid0 = raw exprtypes_get(x.et, id);
        string:eslot = ", 1";
        if (etid0 == x.fe.ctx.types.t_nil) { eslot = ", 0"; }
        if (etid0 == 0i32) {
            if (raw string_eq(ev2.ll, "{ i32 }")) { eslot = ", 0"; }
        }
        string:eerr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(eerr, " = extractvalue ", ev2.ll, " ",
                          raw string_concat(ev2.ref, eslot)));
        string:ebad = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(ebad, " = icmp ne i32 ",
                          raw string_concat(eerr, ", 0")));
        string:et_l = raw irw_new_label(x.fe.w, "eq.trap");
        string:eo_l = raw irw_new_label(x.fe.w, "eq.ok");
        drop irw_line(x.fe.w, raw cat5("br i1 ", ebad, ", label %", et_l,
                          raw string_concat(", label %", eo_l)));
        drop irw_label(x.fe.w, et_l);
        // `?!` EXTENDS the chain (D-179): the error carries its stamps from
        // the callee; this site is one more hop, not a new origin.
        drop irw_line(x.fe.w, raw cat3("call void @npk_chain_push(i32 ",
                          raw int_to_string((raw x_site(x, n.span)) => int64),
                          ")"));
        drop irw_line(x.fe.w, raw cat3("call void @npk_trap(i32 ",
                          ec2.ref, ")"));
        drop irw_line(x.fe.w, "unreachable");
        drop irw_label(x.fe.w, eo_l);
        if (etid0 == x.fe.ctx.types.t_nil) { pass (raw iv_nil()); }
        if (etid0 == 0i32) {
            string:evh = raw result_ll_value_half(ev2.ll);
            if (evh.len == 0i64) { pass (raw iv_nil()); }
            string:eun = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(eun, " = extractvalue ", ev2.ll, " ",
                              raw string_concat(ev2.ref, ", 0")));
            pass (raw iv(move(evh), move(eun), 0i32));
        }
        string:ein = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(ein, " = extractvalue ", ev2.ll, " ",
                          raw string_concat(ev2.ref, ", 0")));
        LlType:ell2 = raw ll_type(x.fe.ctx, etid0);
        if (!(raw ll_is_ok(ell2))) { pass (raw iv_from_ll_at(x, ell2, etid0, n.span)); }
        pass (raw iv(move(ell2.text), move(ein), etid0));
    }
    if (n.kind == ExprKind.ExprTemplateLiteral) {
        pass (raw emit_template(x, id, n));
    }
    if (n.kind == ExprKind.ExprComptimeExpr) {
        // THE FOLDED CONSTANT (1.0.9c). `comptime(expr)` forced the fold at check
        // time (`type_comptime`), so the value is a compile-time constant and is
        // emitted as one — not as the runtime evaluation of `expr`, which is the
        // point of writing `comptime` in a value position, and the only way
        // `comptime(GLOBAL)` reaches a value before module-level bindings lower
        // (1.0.9d). The checker proved it folds, so a miss here is a defect.
        int32:ctid = raw exprtypes_get(x.et, id);
        LlType:ct = raw node_ll(x, id);
        if (ct.state != (raw LL_OK())) {
            pass (raw iv_from_ll_at(x, ct, ctid, n.span));
        }
        ConstVal:cv = raw fold_const(x.tr, ExprId{ index: n.a }, x.scope);
        if (!(raw cv_folded(cv))) { pass (raw iv_broken(n.span)); }
        if (cv.kind == (raw CV_STRING())) {
            string:sg = raw strtab_add(x.strs, raw string_concat(cv.text, ""));
            string:slen = raw int_to_string(cv.text.len);
            string:s1 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat4(s1,
                " = insertvalue { ptr, i64, i64 } undef, ptr ", sg, ", 0"));
            string:s2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(s2,
                " = insertvalue { ptr, i64, i64 } ", s1, ", i64 ",
                raw string_concat(slen, ", 1")));
    // CAPACITY ZERO MEANS THE BODY IS NOT OURS (D-183). A literal's body is a
    // module constant, so a drop must never hand it to `npk_dalloc` — which
    // validates and traps, correctly. The capacity field is read by nothing
    // (not the runtime, not this emitter, not the seed), so it carries the
    // ownership bit: 0 here, `n` on a heap-built string, and the string drop
    // is `if cap != 0`. It says the same thing from the other side too — a
    // literal is not growable in place.
            string:s3 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat4(s3,
                " = insertvalue { ptr, i64, i64 } ", s2, ", i64 0, 2"));
            pass (raw iv("{ ptr, i64, i64 }", move(s3), ctid));
        }
        // int, bool and char are one numeric constant at the node's width.
        pass (raw iv(move(ct.text), raw int_to_string(cv.num), ctid));
    }
    // A range VALUE (0.9.6, D-145): `{ T, T }`, normalized HALF-OPEN at
    // construction — the inclusive `..` stores hi+1, so every consumer sees
    // one convention and none asks which spelling built it.
    if (n.kind == ExprKind.ExprRangeExpr) {
        int32:rtid = raw exprtypes_get(x.et, id);
        LlType:rll = raw ll_type(x.fe.ctx, rtid);
        if (!(raw ll_is_ok(rll))) { pass (raw iv_from_ll_at(x, rll, rtid, n.span)); }
        IrVal:rlo = raw emit_expr(x, raw expr_lhs(n));
        if (!(raw iv_is_ok(rlo))) { pass rlo; }
        IrVal:rhi = raw emit_expr(x, raw expr_rhs(n));
        if (!(raw iv_is_ok(rhi))) { pass rhi; }
        string:hi_ref = raw string_concat(rhi.ref, "");
        if (n.payload == 1i64) {
            string:bump = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(bump, " = add ", rhi.ll, " ",
                              raw string_concat(rhi.ref, ", 1")));
            hi_ref = move(bump);
        }
        string:ra = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(ra, " = insertvalue ", rll.text,
                          " undef, ", raw cat5(rlo.ll, " ", rlo.ref, ", 0", "")));
        string:rb = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(rb, " = insertvalue ", rll.text, " ",
                          raw cat5(ra, ", ", rhi.ll, " ",
                              raw string_concat(hi_ref, ", 1"))));
        pass (raw iv(move(rll.text), move(rb), rtid));
    }
    if (n.kind == ExprKind.ExprSpreadExpr) {
        pass (raw iv_rung("the `..^` expansion", "1.1", n.span));
    }
    // `is (cond) : a : b` — LAZY (0.9.6, D-145): only the taken arm runs.
    // Lowered with branches through a slot, NEVER `select` — select evaluates
    // both arms, and `is (b != 0) : a/b : 0` must not divide by the zero it
    // just tested for.
    if (n.kind == ExprKind.ExprTernaryExpr) {
        int32:ttid = raw exprtypes_get(x.et, id);
        LlType:tll = raw ll_type(x.fe.ctx, ttid);
        if (!(raw ll_is_ok(tll))) { pass (raw iv_from_ll_at(x, tll, ttid, n.span)); }
        string:slot = raw irw_temp(x.fe.w);
        drop irw_alloca(x.fe.w, slot, tll.text);
        IrVal:tc = raw emit_cond(x, ExprId{ index: n.a });
        if (!(raw iv_is_ok(tc))) { pass tc; }
        string:then_l = raw irw_new_label(x.fe.w, "is.then");
        string:else_l = raw irw_new_label(x.fe.w, "is.else");
        string:done_l = raw irw_new_label(x.fe.w, "is.done");
        drop irw_line(x.fe.w, raw cat5("br i1 ", tc.ref, ", label %", then_l,
                          raw string_concat(", label %", else_l)));
        drop irw_label(x.fe.w, then_l);
        IrVal:tv = raw emit_expr(x, ExprId{ index: n.b });
        if (!(raw iv_is_ok(tv))) { pass tv; }
        drop irw_line(x.fe.w, raw cat5("store ", tv.ll, " ", tv.ref,
                          raw string_concat(", ptr ", slot)));
        drop irw_line(x.fe.w, raw cat3("br label %", done_l, ""));
        drop irw_label(x.fe.w, else_l);
        IrVal:ev = raw emit_expr(x, ExprId{ index: n.c });
        if (!(raw iv_is_ok(ev))) { pass ev; }
        drop irw_line(x.fe.w, raw cat5("store ", ev.ll, " ", ev.ref,
                          raw string_concat(", ptr ", slot)));
        drop irw_line(x.fe.w, raw cat3("br label %", done_l, ""));
        drop irw_label(x.fe.w, done_l);
        string:out = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(out, " = load ", tll.text, ", ptr ",
                          slot));
        pass (raw iv(move(tll.text), move(out), ttid));
    }
    if (n.kind == ExprKind.ExprPostfixExpr) {
        // `++`/`--` are struck (D-174): redundant with `x += 1`, hidden mutation
        // in expression position, and no cycle ever owned them. The parser
        // refuses them by name (`PARSE-010`), so this is a defensive confession.
        pass (raw iv_broken(n.span));
    }
    // A float literal (0.9.4). The lexer kept the TEXT; LLVM's parser converts
    // decimal to double with correct rounding, so `double <text>` is exact for
    // flt64. A flt32 literal rides the same double and truncates — exactly
    // correct for ≤ 15 significant digits (double rounding is innocuous at
    // 53 vs 24 bits), and the checker refused anything longer (D-143).
    if (n.kind == ExprKind.ExprFloatLiteral) {
        int32:ftid = raw exprtypes_get(x.et, id);
        LlType:fll = raw ll_type(x.fe.ctx, ftid);
        if (!(raw ll_is_ok(fll))) { pass (raw iv_from_ll_at(x, fll, ftid, n.span)); }
        string:txt = raw intern_get(x.interns, n.payload =>! int32);
        string:body = raw float_literal_body(x, txt);
        if (raw string_eq(fll.text, "double")) {
            pass (raw iv("double", move(body), ftid));
        }
        if (raw string_eq(fll.text, "float")) {
            string:fr = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(fr, " = fptrunc double ", body,
                              " to float", ""));
            pass (raw iv("float", move(fr), ftid));
        }
        pass (raw iv_broken(n.span));
    }
    // The four below were found by `check_kinds_lowered_or_refused`'s first run
    // (0.9.1): each fell through to iv_broken — an INTERNAL-defect report for
    // what is really an unlowered language feature. The honest answer is a
    // rung, exactly like their neighbours above.
    if (n.kind == ExprKind.ExprPipeExpr) {
        pass (raw emit_pipe(x, id, n));
    }
    if (n.kind == ExprKind.ExprDefaultsExpr) {
        // The node a struck bare `?` and the word `defaults` build (D-175): the
        // fallback is `?|`, which builds ExprSafeUnwrapExpr instead. The parser
        // refuses `?`/`defaults` by name (`PARSE-011`), so this is a defensive
        // confession -- a clean program never reaches it.
        pass (raw iv_broken(n.span));
    }
    // `is_err(x)` — THE test that does not trap (D-008 §5): ERR flows through
    // data and stops at branches, and this is the sanctioned way to look.
    if (n.kind == ExprKind.ExprIsErrExpr) {
        IrVal:ov = raw emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(ov))) { pass ov; }
        int32:obits = raw type_int_bits(x.fe.ctx.types, ov.type_id);
        string:mn = raw tbb_min_decimal(obits);
        if (mn.len == 0i64) { pass (raw iv_broken(n.span)); }
        string:ec = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(ec, " = icmp eq ", ov.ll, " ",
                          raw cat3(ov.ref, ", ", mn)));
        string:ez = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(ez, " = zext i1 ",
                          raw string_concat(ec, " to i8")));
        pass (raw iv("i8", move(ez), 0i32));
    }
    if (n.kind == ExprKind.ExprVectorCtorExpr) {
        pass (raw iv_rung("a vector constructor", "1.1 (G-3)", n.span));
    }
    // `move(place)` LOWERS: it yields the place's value, and what it does to
    // the SOURCE is static — the 0.5 move analysis already blessed and tracked
    // the transfer, so there is nothing for the IR to add (D-065). Found by
    // the same first run, miscategorized as iv_broken.
    if (n.kind == ExprKind.ExprMoveExpr) {
        // THE VALUE IS THE OPERAND; THE TRANSFER IS THE FLAG (D-183, 1.2.3).
        // Reading first, clearing second — the order does not matter to the
        // bytes (the flag is a separate word) but reads correctly.
        IrVal:mv = raw emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(mv))) { pass mv; }
        drop clear_root_flag(x, raw expr_operand(n));
        pass mv;
    }
    // `$` — the innermost counted loop's counter (0.9.7), i64 like its slot.
    if (n.kind == ExprKind.ExprIterationVarExpr) {
        string:islot = raw fnem_iter_slot(x.fe);
        if (islot.len == 0i64) { pass (raw iv_broken(n.span)); }
        string:iv2 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(iv2, " = load i64, ptr ", islot, "", ""));
        pass (raw iv("i64", move(iv2), raw exprtypes_get(x.et, id)));
    }
    // A pick EXPRESSION (0.9.7, D-059): the chain dispatch with a value slot
    // its arms `give` into.
    if (n.kind == ExprKind.ExprPickExpr) {
        int32:ptid = raw exprtypes_get(x.et, id);
        LlType:pll2 = raw ll_type(x.fe.ctx, ptid);
        if (!(raw ll_is_ok(pll2))) { pass (raw iv_from_ll_at(x, pll2, ptid, n.span)); }
        ExprId:psel = ExprId{ index: n.a };
        int32:pstid = raw exprtypes_get(x.et, psel);
        IrVal:psv = raw emit_expr(x, psel);
        if (!(raw iv_is_ok(psv))) { pass psv; }
        string:pdisc = raw string_concat(psv.ref, "");
        string:pdll = raw string_concat(psv.ll, "");
        if ((raw type_kind(x.fe.ctx.types, pstid)) == (raw TY_ENUM())) {
            if (raw enum_has_payload(x.ast, x.fe.ctx.types, pstid)) {
                string:ptag = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(ptag, " = extractvalue ",
                                  psv.ll, " ", raw string_concat(psv.ref, ", 0")));
                pdisc = move(ptag);
                pdll = "i32";
            }
        }
        string:pslot = raw irw_temp(x.fe.w);
        drop irw_alloca(x.fe.w, pslot, pll2.text);
        IrVal:pc2 = raw emit_pick_chain(x, psv, pstid, pdisc, move(pdll),
                        n.b, n.c, raw string_concat(pslot, ""), raw string_concat(pll2.text, ""), ptid);
        if (!(raw iv_is_ok(pc2))) { pass pc2; }
        string:pout = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(pout, " = load ", pll2.text, ", ptr ",
                          raw string_concat(pslot, "")));
        pass (raw iv(move(pll2.text), move(pout), ptid));
    }
    if (n.kind == ExprKind.ExprAwaitExpr) {
        pass (raw emit_await(x, id, n));
    }
    if (n.kind == ExprKind.ExprDynCastExpr) {
        // A `dyn` CAST IS THE FIT TO THE `dyn` TARGET (D-158/D-159): the same
        // fat-pointer build a `dyn`-typed slot triggers implicitly, only written
        // out. `emit_fit` picks between building from a concrete value and
        // widening an existing `dyn`, so the explicit `=>` and the implicit
        // coercion lower through one path and cannot drift apart.
        IrVal:dv = raw emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(dv))) { pass dv; }
        pass (raw emit_fit(x, raw exprtypes_get(x.et, id), move(dv), n.span));
    }
    // FAIL CLOSED ON A KIND NOBODY CLASSIFIED. Phase A's whole output is a
    // promise that accepted programs are valid; an emitter that guesses at a
    // node it does not know turns that into a lie.
    pass (raw iv_broken(n.span));
};

// --- leaves -------------------------------------------------------------------------

func:emit_int = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    LlType:t = raw node_ll(x, id);
    if (t.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, t, raw exprtypes_get(x.et, id), n.span));
    }
    pass (raw iv(move(t.text), raw int_to_string(n.payload),
                 raw exprtypes_get(x.et, id)));
};

// A `&{ }` TEMPLATE (D-168, 1.0.9d): each part rendered to a `string` and the
// lot joined with `string_concat`. A `string` part is itself; any other is
// `to_string`'d at its concrete type. The checker proved every part stringable,
// so a missing `to_string` here is a defect, not a rung.
func:emit_template = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);
    string:acc = "";
    bool:have = false;
    int32:i = 0i32;
    while (i < count) {
        ExprId:item = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        int32:itype = raw exprtypes_get(x.et, item);
        string:sref = "";
        if ((raw type_kind(x.fe.ctx.types, itype)) == (raw TY_STRING())) {
            IrVal:sv = raw emit_expr(x, item);
            if (!(raw iv_is_ok(sv))) { pass sv; }
            sref = move(sv.ref);
        } else {
            IrVal:tv = raw emit_tostring(x, item, itype);
            if (!(raw iv_is_ok(tv))) { pass tv; }
            sref = move(tv.ref);
        }
        if (!have) {
            acc = move(sref);
            have = true;
        } else {
            string:cc = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(cc,
                " = call { { ptr, i64, i64 }, i32 } @npk_string_concat({ ptr, i64, i64 } ",
                acc, ", { ptr, i64, i64 } ",
                raw cat3(sref, ")", "")));
            string:cv = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(cv,
                " = extractvalue { { ptr, i64, i64 }, i32 } ",
                raw string_concat(cc, ", 0")));
            acc = move(cv);
        }
        i = i + 1i32;
    }
    if (!have) {
        // An empty template is the empty string.
        string:g = raw strtab_add(x.strs, "");
        string:a = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat4(a,
            " = insertvalue { ptr, i64, i64 } undef, ptr ", g, ", 0"));
        string:b = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(b,
            " = insertvalue { ptr, i64, i64 } ", a, ", i64 0", ", 1"));
        string:c = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(c,
            " = insertvalue { ptr, i64, i64 } ", b, ", i64 0", ", 2"));
        pass (raw iv("{ ptr, i64, i64 }", move(c), raw exprtypes_get(x.et, id)));
    }
    pass (raw iv("{ ptr, i64, i64 }", move(acc), raw exprtypes_get(x.et, id)));
};

// CALL `to_string` FOR A VALUE (D-168): resolve the `ToString` impl for its
// concrete type, call the impl's method by value, and hand back the `string` the
// Result carries. A per-type impl (the prelude scalars) is matched by target;
// the checker admitted the interpolation, so one exists.
func:emit_tostring = IrVal(ExprEmitter->:x, ExprId:item, int32:itype) never fails {
    Span:at = (raw ast_expr(x.ast, item)).span;
    int32:ts_sym = raw scope_lookup(x.tab, x.scope,
                       raw intern_add(x.interns, "ToString"));
    if (ts_sym == 0i32) { pass (raw iv_broken(at)); }
    Symbol:tss = raw symtab_get(x.tab, ts_sym);
    if (tss.origin_kind != (raw SYM_DECL())) { pass (raw iv_broken(at)); }

    int32:impl_decl = 0i32;
    int32:trait_ty = 0i32;
    int32:j = 0i32;
    while (j < (raw impl_count(x.fe.ctx.impls))) {
        ImplEntry:e = raw impl_at(x.fe.ctx.impls, j);
        if (!e.blanket) {
            if (e.target == itype) {
                if ((raw type_decl_of(x.fe.ctx.types, e.trait_id)) == tss.origin) {
                    impl_decl = e.decl;
                    trait_ty = e.trait_id;
                    j = raw impl_count(x.fe.ctx.impls);
                } else { j = j + 1i32; }
            } else { j = j + 1i32; }
        } else { j = j + 1i32; }
    }
    if (impl_decl == 0i32) { pass (raw iv_broken(at)); }

    DeclNode:idecl = raw ast_decl(x.ast, DeclId{ index: impl_decl });
    int32:ts_name = raw intern_add(x.interns, "to_string");
    int32:m_decl = 0i32;
    int32:mi = 0i32;
    while (mi < (raw impl_member_count(x.ast, idecl))) {
        DeclId:mid = raw impl_member(x.ast, idecl, mi);
        DeclNode:m = raw ast_decl(x.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if ((raw decl_name(m)) == ts_name) { m_decl = mid.index; }
        }
        mi = mi + 1i32;
    }
    if (m_decl == 0i32) { pass (raw iv_broken(at)); }
    string:sym = raw mangled_fn_sym(x.fe.ctx, m_decl,
                     raw method_symbol_name(x.fe.ctx.types, x.interns, itype,
                         trait_ty, "to_string"));

    IrVal:av = raw emit_expr(x, item);
    if (!(raw iv_is_ok(av))) { pass av; }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(r,
        " = call { { ptr, i64, i64 }, i32 } ", sym,
        raw cat5("(", av.ll, " ", av.ref, ")")));
    string:sv = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(sv,
        " = extractvalue { { ptr, i64, i64 }, i32 } ",
        raw string_concat(r, ", 0")));
    pass (raw iv("{ ptr, i64, i64 }", move(sv), 0i32));
};

func:emit_string = IrVal(ExprEmitter->:x, ExprNode:n) never fails {
    string:data = raw intern_get(x.interns, n.payload =>! int32);
    string:g = raw strtab_add(x.strs, raw string_concat(data, ""));
    string:len = raw int_to_string(data.len);
    string:a = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(a,
        " = insertvalue { ptr, i64, i64 } undef, ptr ", g, ", 0"));
    string:b = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(b, " = insertvalue { ptr, i64, i64 } ", a,
                                     ", i64 ", raw string_concat(len, ", 1")));
    // CAPACITY ZERO MEANS THE BODY IS NOT OURS (D-183). A literal's body is a
    // module constant, so a drop must never hand it to `npk_dalloc` — which
    // validates and traps, correctly. The capacity field is read by nothing
    // (not the runtime, not this emitter, not the seed), so it carries the
    // ownership bit: 0 here, `n` on a heap-built string, and the string drop
    // is `if cap != 0`. It says the same thing from the other side too — a
    // literal is not growable in place.
    string:c = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(c, " = insertvalue { ptr, i64, i64 } ", b,
                                     ", i64 0, 2"));
    pass (raw iv("{ ptr, i64, i64 }", move(c), 0i32));
};

func:emit_ident = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:si = raw fnem_lookup_idx(x.fe, n.payload =>! int32);
    if (si < 0i32) {
        // A FUNCTION USED AS A VALUE (0.9.6, D-087): one machine word, the
        // symbol itself — closures are gone (D-018), so there is no
        // environment to capture and nothing to allocate.
        if (n.a != 0i32) {
            Symbol:fsym = raw symtab_get(x.tab, n.a);
            if (fsym.origin_kind == (raw SYM_DECL())) {
                DeclNode:fdecl = raw ast_decl(x.ast, DeclId{ index: fsym.origin });
                if (fdecl.kind == DeclKind.DeclFunctionDecl) {
                    string:fnm = raw intern_get(x.interns, fsym.name);
                    pass (raw iv("ptr",
                                 raw mangled_fn_sym(x.fe.ctx, fsym.origin, fnm),
                                 raw exprtypes_get(x.et, id)));
                }
                // A DECLARED ERROR CONSTANT IS ITS ASSIGNED CODE (D-179):
                // resolve wrote it into slot `c`, and the constant lowers
                // inline — no symbol, no load, four bytes that are not a
                // number.
                if (fdecl.kind == DeclKind.DeclErrorDecl) {
                    pass (raw iv("i32", raw int_to_string(fdecl.c => int64),
                                 raw exprtypes_get(x.et, id)));
                }
                // A MODULE-LEVEL BINDING IS LOADED FROM ITS GLOBAL (D-165,
                // 1.0.9d): the value the constant/global holds, under D-156's
                // symbol — the same one `emit_one_global` wrote.
                if (fdecl.kind == DeclKind.DeclGlobalDecl) {
                    int32:gtid = raw exprtypes_get(x.et, id);
                    LlType:gll = raw node_ll(x, id);
                    if (gll.state != (raw LL_OK())) {
                        pass (raw iv_from_ll_at(x, gll, gtid, n.span));
                    }
                    string:gsym = raw mangled_fn_sym(x.fe.ctx, fsym.origin,
                                      raw intern_get(x.interns, fsym.name));
                    string:gr = raw irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, raw cat5(gr, " = load ", gll.text,
                                      ", ptr ", gsym));
                    pass (raw iv(move(gll.text), move(gr), gtid));
                }
            }
        }
        // Not a local, a function or a global: the checker refuses an unknown
        // name, so reaching here is a defect, not a rung (D-165 retired the
        // "a name that is not a local" rung, 1.0.9d).
        pass (raw iv_broken(n.span));
    }
    // The SLOT's type, not the table's: the binding is the local truth, and for
    // a name the checker recorded (every ordinary local) the two are the same id
    // by construction — the vardecl resolved the same annotation into the same
    // interned type the checker did.
    int32:sty = raw fnem_local_type_at(x.fe, si);
    LlType:t = raw ll_type(x.fe.ctx, sty);
    if (!(raw ll_is_ok(t))) {
        pass (raw iv_from_ll_at(x, t, sty, n.span));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = load ", t.text, ", ptr ",
                      raw fnem_local_slot_at(x.fe, si)));
    pass (raw iv(move(t.text), move(r), sty));
};

// --- operators ----------------------------------------------------------------------

func:emit_unary = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    TokenKind:op = raw expr_op(n);
    IrVal:v = raw emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }

    if (op == TokenKind.OpMinus) {
        string:r = raw irw_temp(x.fe.w);
        // Floats negate with fneg — `fsub 0.0, x` is NOT negation under IEEE
        // (it loses -0.0: 0.0 - 0.0 is +0.0, while -(0.0) is -0.0).
        if (raw ll_is_float_text(v.ll)) {
            drop irw_line(x.fe.w, raw cat5(r, " = fneg ", v.ll, " ", v.ref));
            pass (raw iv(raw string_concat(v.ll, ""), move(r), v.type_id));
        }
        // A `tbb` NEGATES STICKILY (D-008 §2, 1.0.9): ERR stays ERR, and
        // every other value's negation is representable by construction —
        // the sentinel is the one two's-complement value `sub 0, x` would
        // overflow on, and it is not a value. A select, branch-free, the
        // same shape the type's arithmetic has.
        int32:utid = raw exprtypes_get(x.et, raw expr_operand(n));
        if ((raw type_kind(x.fe.ctx.types, utid)) == (raw TY_TBB())) {
            string:tmn = raw tbb_min_decimal(raw type_int_bits(x.fe.ctx.types, utid));
            if (tmn.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:neg = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(neg, " = sub ", v.ll, " 0, ", v.ref));
            string:iserr = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(iserr, " = icmp eq ", v.ll, " ",
                              raw cat3(v.ref, ", ", tmn)));
            drop irw_line(x.fe.w, raw cat5(r, " = select i1 ", iserr, ", ",
                              raw cat5(v.ll, " ", tmn, ", ",
                                  raw cat3(v.ll, " ", neg))));
            pass (raw iv(raw string_concat(v.ll, ""), move(r), v.type_id));
        }
        drop irw_line(x.fe.w, raw cat5(r, " = sub ", v.ll, " 0, ", v.ref));
        pass (raw iv(raw string_concat(v.ll, ""), move(r), v.type_id));
    }
    if (op == TokenKind.OpTilde) {
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = xor ", v.ll, " ",
                                         raw string_concat(v.ref, ", -1")));
        pass (raw iv(raw string_concat(v.ll, ""), move(r), v.type_id));
    }
    if (op == TokenKind.OpBang) {
        // FROM THE VALUE ALREADY EMITTED — re-emitting the operand to get a
        // truth value runs it twice, and the seed's note records what that did:
        // `!(raw split(x))` split twice, the second refused, and the negation
        // answered about the wrong run.
        string:c = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(c, " = icmp ne ", v.ll, " ",
                                         raw string_concat(v.ref, ", 0")));
        string:xr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(xr, " = xor i1 ", raw string_concat(c, ", true")));
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(r, " = zext i1 ", raw string_concat(xr, " to i8")));
        pass (raw iv("i8", move(r), v.type_id));
    }
    pass (raw iv_broken(n.span));
};

// A truth value for a branch or a short-circuit: `i1`, derived by comparing
// against zero. `bool` is STORED as `i8`; `i1` exists only here.
pub func:emit_cond = IrVal(ExprEmitter->:x, ExprId:id) never fails {
    IrVal:v = raw emit_expr(x, id);
    if (v.state != (raw LL_OK())) { pass v; }
    string:c = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(c, " = icmp ne ", v.ll, " ",
                                     raw string_concat(v.ref, ", 0")));
    pass (raw iv("i1", move(c), 0i32));
};

// The index, as i64, for a bounds compare: narrower indices sign-extend, so a
// negative index of any width becomes a huge unsigned value and ONE unsigned
// compare rejects both "negative" and "past the end" (D-070).
func:index_as_i64 = string(ExprEmitter->:x, IrVal:ix) never fails {
    // cloned, not passed through: the parameter is lent (D-183)
    if (raw string_eq(ix.ll, "i64")) { pass (raw string_concat(ix.ref, "")); }
    string:w = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(w, " = sext ", ix.ll, " ",
                      raw string_concat(ix.ref, " to i64")));
    pass w;
};

// The bounds trap (0.9.2, D-070): `idx <u len` or branch to OUT_OF_BOUNDS
// (-4099) through the D-142 route. Emitted at EVERY dynamic index — a slice's
// length is a runtime fact and an array's is a constant, but the refusal is
// the same controlled shutdown either way.
func:emit_bounds_guard = NIL(ExprEmitter->:x, string:idx64, string:len_ref,
                             Span:at) never fails {
    string:ok_c = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(ok_c, " = icmp ult i64 ", idx64, ", ",
                      raw string_concat(len_ref, "")));
    string:trap_l = raw irw_new_label(x.fe.w, "idx.oob");
    string:ok_l = raw irw_new_label(x.fe.w, "idx.ok");
    drop irw_line(x.fe.w, raw cat5("br i1 ", ok_c, ", label %", ok_l,
                      raw string_concat(", label %", trap_l)));
    drop irw_label(x.fe.w, trap_l);
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      raw int_to_string((raw x_site(x, at)) => int64), ")"));
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4099)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, ok_l);
    pass NIL;
};

// The literal text, made a valid LLVM decimal-FP constant: the type suffix is
// cut, and a body with no '.' gets one ("1e10" is not LLVM grammar; "1.0e10"
// is). The digits themselves pass through untouched — LLVM's own parser does
// the correctly-rounded conversion.
func:float_literal_body = string(ExprEmitter->:x, string:txt) never fails {
    int64:cut = txt.len;
    int64:fi = 0i64;
    while (fi < txt.len) {
        if (txt.ptr[fi] == 102u8) { cut = fi; break; }   // 'f' opens the suffix
        fi = fi + 1i64;
    }
    string:body = raw slice_proven(txt, 0i64, cut);
    bool:has_dot = false;
    int64:epos = body.len;
    int64:bi = 0i64;
    while (bi < body.len) {
        uint8:bc = body.ptr[bi];
        if (bc == 46u8) { has_dot = true; }
        if (bc == 101u8) { epos = bi; break; }
        if (bc == 69u8)  { epos = bi; break; }
        bi = bi + 1i64;
    }
    if (has_dot) { pass body; }
    string:mant = raw slice_proven(body, 0i64, epos);
    string:rest = raw slice_proven(body, epos, body.len);
    pass (raw cat3(mant, ".0", rest));
};

// `tbb` division and remainder: zero divisor or any ERR yields ERR — never a
// trap, never UB. The divisor is REPLACED with 1 when the result will be ERR
// anyway, so the machine instruction itself can never fault; the select picks
// the sentinel afterward. (An ERR-free dividend can never be the sentinel, so
// sdiv's own INT_MIN/-1 case is unreachable by construction.)
func:tbb_divlike = IrVal(ExprEmitter->:x, ExprNode:n, IrVal:lhs, IrVal:rhs,
                         string:anyerr, string:tmn, string:ins) never fails {
    string:z = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(z, " = icmp eq ", lhs.ll, " ",
                      raw string_concat(rhs.ref, ", 0")));
    string:sticky = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(sticky, " = or i1 ", anyerr, ", ", z));
    string:safeb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(safeb, " = select i1 ", sticky, ", ",
                      raw cat5(lhs.ll, " 1, ", lhs.ll, " ", rhs.ref)));
    string:q = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(q, " = ", ins, " ",
                      raw cat5(lhs.ll, " ", lhs.ref, ", ", safeb)));
    string:res = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(res, " = select i1 ", sticky, ", ",
                      raw cat5(lhs.ll, " ", tmn, ", ",
                          raw cat3(lhs.ll, " ", q))));
    pass (raw iv(raw string_concat(lhs.ll, ""), raw string_concat(res, ""), lhs.type_id));
};

pub func:arith_name = string(TokenKind:op, bool:signed) never fails {
    if (op == TokenKind.OpPlus)    { pass "add"; }
    if (op == TokenKind.OpMinus)   { pass "sub"; }
    if (op == TokenKind.OpStar)    { pass "mul"; }
    if (op == TokenKind.OpSlash)   { if (signed) { pass "sdiv"; } pass "udiv"; }
    if (op == TokenKind.OpPercent) { if (signed) { pass "srem"; } pass "urem"; }
    if (op == TokenKind.OpAmp)     { pass "and"; }
    if (op == TokenKind.OpPipe)    { pass "or"; }
    if (op == TokenKind.OpCaret)   { pass "xor"; }
    if (op == TokenKind.OpShl)     { pass "shl"; }
    if (op == TokenKind.OpShr)     { if (signed) { pass "ashr"; } pass "lshr"; }
    pass "";
};

func:icmp_name = string(TokenKind:op, bool:signed) never fails {
    if (op == TokenKind.OpEqEq)  { pass "eq"; }
    if (op == TokenKind.OpNotEq) { pass "ne"; }
    if (op == TokenKind.OpLt)    { if (signed) { pass "slt"; } pass "ult"; }
    if (op == TokenKind.OpLtEq)  { if (signed) { pass "sle"; } pass "ule"; }
    if (op == TokenKind.OpGt)    { if (signed) { pass "sgt"; } pass "ugt"; }
    if (op == TokenKind.OpGtEq)  { if (signed) { pass "sge"; } pass "uge"; }
    pass "";
};

// Is this expression the `NIL` sentinel, written as such? (1.0.7)
func:expr_is_nil_literal = bool(ExprEmitter->:x, ExprId:e) never fails {
    ExprNode:en = raw ast_expr(x.ast, e);
    if (en.kind != ExprKind.ExprSentinelLiteral) { pass false; }
    pass (en.payload == 0i64);
};

func:emit_binary = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    TokenKind:op = raw expr_op(n);

    if (op == TokenKind.OpAndAnd) { pass (raw emit_shortcircuit(x, n, true)); }
    if (op == TokenKind.OpOrOr)   { pass (raw emit_shortcircuit(x, n, false)); }

    // AN `Optional` COMPARES AGAINST `NIL` BY ITS TAG (D-099, 1.0.7) — `a == NIL`
    // and `NIL != a` are THE test, in either order. The sentinel side is never
    // emitted: it has no bytes worth reading. Two `Optional`s that are neither
    // `NIL` fall through to the non-scalar refusal below; what that comparison
    // MEANS is T-5's (1.0.9), the same question for every aggregate.
    if ((raw type_kind(x.fe.ctx.types, raw exprtypes_get(x.et, raw expr_lhs(n))))
            == (raw TY_OPTIONAL())) {
        bool:is_eq = (op == TokenKind.OpEqEq);
        if (is_eq || (op == TokenKind.OpNotEq)) {
            ExprId:other = raw expr_lhs(n);
            bool:found_nil = false;
            if (raw expr_is_nil_literal(x, raw expr_rhs(n))) {
                found_nil = true;
            } else {
                if (raw expr_is_nil_literal(x, raw expr_lhs(n))) {
                    found_nil = true;
                    other = raw expr_rhs(n);
                }
            }
            if (found_nil) {
                IrVal:ov = raw emit_expr(x, other);
                if (ov.state != (raw LL_OK())) { pass ov; }
                string:otag = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(otag, " = extractvalue ", ov.ll, " ",
                                  raw string_concat(ov.ref, ", 0")));
                string:opred = "eq";
                if (!is_eq) { opred = "ne"; }
                string:oc = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(oc, " = icmp ", opred, " i8 ",
                                  raw string_concat(otag, ", 0")));
                string:oz = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat3(oz, " = zext i1 ",
                                  raw string_concat(oc, " to i8")));
                pass (raw iv("i8", move(oz), 0i32));
            }
        }
    }

    IrVal:lhs = raw emit_expr(x, raw expr_lhs(n));
    if (lhs.state != (raw LL_OK())) { pass lhs; }
    IrVal:rhs = raw emit_expr(x, raw expr_rhs(n));
    if (rhs.state != (raw LL_OK())) { pass rhs; }

    // A COMPARISON ON A NON-SCALAR IS NOW A DEFECT, NOT A RUNG (D-169, 1.0.9c).
    // `icmp` takes integers, pointers and nothing else; the checker refuses `==`
    // on a struct, array, `Result`, `string`, `dyn`, two non-`NIL` `Optional`s
    // or a payload-carrying enum by name (`TYPE_NOT_COMPARABLE`), so an
    // aggregate reaching here is a broken promise, not valid Nitpick — it fails
    // closed. `== NIL` was handled above; scalars, floats and pointers fall
    // through to the real compare below.
    string:cmp0 = raw icmp_name(op, false);
    if (cmp0.len > 0i64) {
        if (!(raw ll_is_scalar_int(raw ll_ok(raw string_concat(lhs.ll, ""))))) {
            if (!(raw ll_is_float_text(lhs.ll))) {
                if (!(raw string_eq(lhs.ll, "ptr"))) {
                    pass (raw iv_broken(n.span));
                }
            }
        }
    }

    // SIGNEDNESS COMES FROM THE OPERANDS' TYPE, and the two sides agree because
    // the checker made them (D-092: no implicit widening — a mixed comparison
    // was refused before this runs).
    //
    // THE DEFAULT IS UNSIGNED, and `char8` is why: a character orders by CODE
    // POINT, so `'a' <= c` on bytes past 127 must be `ult` — `slt` would sort
    // the upper half of every encoding below NUL. Only a signed integer opts
    // into the signed comparisons; `eq`/`ne` never cared.
    int32:lt = raw exprtypes_get(x.et, raw expr_lhs(n));
    bool:signed = false;
    if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_INT())) {
        signed = raw type_is_signed(x.fe.ctx.types, lt);
    }

    string:cmp = raw icmp_name(op, signed);
    if (cmp.len > 0i64) {
        // FLOATS COMPARE WITH fcmp AND IEEE SEMANTICS (0.9.4, D-143): ordered
        // predicates except `!=`, which is `une` — NaN != NaN is TRUE, the one
        // place unordered is the correct answer, because `!=` must be the
        // negation of `==` (oeq is false on NaN) or the two operators lie to
        // each other.
        if (raw ll_is_float_text(lhs.ll)) {
            string:fpred = "";
            if (op == TokenKind.OpEqEq)  { fpred = "oeq"; }
            if (op == TokenKind.OpNotEq) { fpred = "une"; }
            if (op == TokenKind.OpLt)    { fpred = "olt"; }
            if (op == TokenKind.OpLtEq)  { fpred = "ole"; }
            if (op == TokenKind.OpGt)    { fpred = "ogt"; }
            if (op == TokenKind.OpGtEq)  { fpred = "oge"; }
            if (fpred.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:fc = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(fc, " = fcmp ", fpred, " ",
                              raw cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
            string:fz = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(fz, " = zext i1 ",
                              raw string_concat(fc, " to i8")));
            pass (raw iv("i8", move(fz), 0i32));
        }
        // `tbb` EQUALITY GUARDS FIRST (0.9.5, D-008 §5): an ERR operand at a
        // comparison is a tainted value about to steer control flow, and it
        // traps (TBB_ERR, -4100) — `is_err` is the test that looks without
        // trapping, and `pick` with an `ERR:` arm is the branch that handles
        // it; a bare `==` is neither. Ordering was already a compile error
        // (D-093).
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_TBB())) {
            int32:tb = raw type_int_bits(x.fe.ctx.types, lt);
            string:tmn = raw tbb_min_decimal(tb);
            if (tmn.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:e1 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(e1, " = icmp eq ", lhs.ll, " ",
                              raw cat3(lhs.ref, ", ", tmn)));
            string:e2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(e2, " = icmp eq ", lhs.ll, " ",
                              raw cat3(rhs.ref, ", ", tmn)));
            string:ea = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(ea, " = or i1 ", e1, ", ", e2));
            string:tl = raw irw_new_label(x.fe.w, "tbb.err");
            string:ol = raw irw_new_label(x.fe.w, "tbb.ok");
            drop irw_line(x.fe.w, raw cat5("br i1 ", ea, ", label %", tl,
                              raw string_concat(", label %", ol)));
            drop irw_label(x.fe.w, tl);
            drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                              raw int_to_string((raw x_site(x, n.span)) => int64), ")"));
            drop irw_line(x.fe.w, "call void @npk_trap(i32 -4100)");
            drop irw_line(x.fe.w, "unreachable");
            drop irw_label(x.fe.w, ol);
        }
        string:c = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(c, " = icmp ", cmp, " ",
                          raw cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
        string:z = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(z, " = zext i1 ",
                          raw string_concat(c, " to i8")));
        pass (raw iv("i8", raw string_concat(z, ""), 0i32));
    }

    // FLOAT ARITHMETIC IS IEEE AND TOTAL (0.9.4, D-143): fadd through frem,
    // NO guards — division by zero yields ±inf/nan, which is DEFINED behavior,
    // the reason floats have infinities at all. `%` is frem, which llc lowers
    // to the fmod/fmodf libcalls the floor hand-writes. (flt128 never reaches
    // here — the checker refused its arithmetic outright.)
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_FLOAT())) {
            string:fins = "";
            if (op == TokenKind.OpPlus)    { fins = "fadd"; }
            if (op == TokenKind.OpMinus)   { fins = "fsub"; }
            if (op == TokenKind.OpStar)    { fins = "fmul"; }
            if (op == TokenKind.OpSlash)   { fins = "fdiv"; }
            if (op == TokenKind.OpPercent) { fins = "frem"; }
            if (fins.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:fres = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(fres, " = ", fins, " ",
                              raw cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
            pass (raw iv(raw string_concat(lhs.ll, ""), move(fres), lhs.type_id));
        }
    }

    // `tbb` ARITHMETIC (0.9.5, D-008): sticky, saturating, BRANCH-FREE. Any
    // ERR operand yields ERR (stickiness beats every identity — ERR * 0 is
    // ERR); overflow yields ERR (saturation); a result that lands ON the
    // sentinel arithmetically IS ERR by construction, no extra check. Division
    // by zero yields ERR, not a trap — this is the fail-operational row of
    // D-007's table, the whole reason the type exists. Lowered with selects,
    // never branches, so the operation's cost and shape are data-independent.
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_TBB())) {
            int32:tb = raw type_int_bits(x.fe.ctx.types, lt);
            string:tmn = raw tbb_min_decimal(tb);
            if (tmn.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:e1 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(e1, " = icmp eq ", lhs.ll, " ",
                              raw cat3(lhs.ref, ", ", tmn)));
            string:e2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(e2, " = icmp eq ", lhs.ll, " ",
                              raw cat3(rhs.ref, ", ", tmn)));
            string:anyerr = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(anyerr, " = or i1 ", e1, ", ", e2));

            string:bad = "";
            string:val = "";
            if (op == TokenKind.OpPlus) {
                string:v = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(v, " = add ", lhs.ll, " ",
                                  raw cat3(lhs.ref, ", ", rhs.ref)));
                // Signed overflow, by the sign trick: it happened iff the
                // operands agree in sign and the result does not.
                string:xa = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(xa, " = xor ", lhs.ll, " ",
                                  raw cat3(v, ", ", lhs.ref)));
                string:xb = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(xb, " = xor ", lhs.ll, " ",
                                  raw cat3(v, ", ", rhs.ref)));
                string:ab = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(ab, " = and ", lhs.ll, " ",
                                  raw cat3(xa, ", ", xb)));
                string:o = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(o, " = icmp slt ", lhs.ll, " ",
                                  raw string_concat(ab, ", 0")));
                bad = raw string_concat(o, "");
                val = raw string_concat(v, "");
            }
            if (op == TokenKind.OpMinus) {
                string:v = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(v, " = sub ", lhs.ll, " ",
                                  raw cat3(lhs.ref, ", ", rhs.ref)));
                // Subtraction overflows iff the operands DISAGREE in sign and
                // the result disagrees with the minuend.
                string:xa = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(xa, " = xor ", lhs.ll, " ",
                                  raw cat3(lhs.ref, ", ", rhs.ref)));
                string:xb = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(xb, " = xor ", lhs.ll, " ",
                                  raw cat3(v, ", ", lhs.ref)));
                string:ab = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(ab, " = and ", lhs.ll, " ",
                                  raw cat3(xa, ", ", xb)));
                string:o = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(o, " = icmp slt ", lhs.ll, " ",
                                  raw string_concat(ab, ", 0")));
                bad = raw string_concat(o, "");
                val = raw string_concat(v, "");
            }
            if (op == TokenKind.OpStar) {
                // Multiplication's overflow has no cheap sign trick; the
                // intrinsic lowers natively at every width here (D-011).
                string:pair = raw irw_temp(x.fe.w);
                string:mhead = raw cat5(pair, " = call { ", lhs.ll,
                                    ", i1 } @llvm.smul.with.overflow.", lhs.ll);
                string:margs = raw cat5("(", lhs.ll, " ", lhs.ref,
                                    raw cat4(", ", lhs.ll, " ",
                                        raw string_concat(rhs.ref, ")")));
                drop irw_line(x.fe.w, raw string_concat(mhead, margs));
                string:v = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(v, " = extractvalue { ", lhs.ll,
                                  ", i1 } ", raw string_concat(pair, ", 0")));
                string:o = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(o, " = extractvalue { ", lhs.ll,
                                  ", i1 } ", raw string_concat(pair, ", 1")));
                bad = raw string_concat(o, "");
                val = move(v);
            }
            if (op == TokenKind.OpSlash) {
                pass (raw tbb_divlike(x, n, lhs, rhs, anyerr, tmn, "sdiv"));
            }
            if (op == TokenKind.OpPercent) {
                pass (raw tbb_divlike(x, n, lhs, rhs, anyerr, tmn, "srem"));
            }
            if (bad.len == 0i64) { pass (raw iv_broken(n.span)); }

            string:sticky = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(sticky, " = or i1 ", anyerr, ", ", bad));
            string:res = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(res, " = select i1 ", sticky, ", ",
                              raw cat5(lhs.ll, " ", tmn, ", ",
                                  raw cat3(lhs.ll, " ", val))));
            pass (raw iv(raw string_concat(lhs.ll, ""), move(res), lhs.type_id));
        }
    }

    // `+` ON STRINGS IS CONCATENATION (TYPE_REFERENCE §4), typed since 0.7.7
    // and lowered here (0.9.7): the floor's concat, value slot extracted —
    // the operator is total because the bump allocator is.
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_STRING())) {
            if (op == TokenKind.OpPlus) {
                string:scr = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(scr,
                                  " = call { { ptr, i64, i64 }, i32 } @npk_string_concat(",
                                  raw cat4(lhs.ll, " ", lhs.ref, ", "),
                                  raw cat3(rhs.ll, " ", rhs.ref), ")"));
                string:sv2 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat3(sv2,
                                  " = extractvalue { { ptr, i64, i64 }, i32 } ",
                                  raw string_concat(scr, ", 0")));
                pass (raw iv("{ ptr, i64, i64 }", move(sv2), lhs.type_id));
            }
        }
    }

    // ARITHMETIC BEYOND FLOATS, INTEGERS AND `tbb` is not this rung's. The
    // checker already refused what is never legal — this refuses what is legal
    // and not yet lowered, which is exactly the difference between the two
    // states.
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) != (raw TY_INT())) {
            pass (raw iv_rung("arithmetic on this type", "1.1 (G-3)", n.span));
        }
    }
    string:ins = raw arith_name(op, signed);
    if (ins.len == 0i64) { pass (raw iv_broken(n.span)); }

    // LIVE-2's repair (0.9.0, D-142): division and remainder TRAP on a zero
    // divisor — D-007's rule, and the difference between a controlled shutdown
    // through `failsafe` and SIGFPE with actuators live. Signed division adds
    // the INT_MIN/-1 case: LLVM UB with no defined value, and D-008 already
    // refused inventing one, so it traps too. The guard is emitted, never
    // elided — a build without the verifier still has to emit the check
    // (D-068), and 1.4's static discharge may remove only what it proves.
    bool:divlike = false;
    if (op == TokenKind.OpSlash)   { divlike = true; }
    if (op == TokenKind.OpPercent) { divlike = true; }
    if (divlike) {
        string:z = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(z, " = icmp eq ", lhs.ll, " ",
                          raw string_concat(rhs.ref, ", 0")));
        string:trap_l = raw irw_new_label(x.fe.w, "div.zero");
        string:ok_l = raw irw_new_label(x.fe.w, "div.ok");
        string:next_l = raw string_concat(ok_l, "");
        if (signed) {
            next_l = raw irw_new_label(x.fe.w, "div.chk");
        }
        drop irw_line(x.fe.w, raw cat5("br i1 ", z, ", label %", trap_l,
                          raw string_concat(", label %", next_l)));
        drop irw_label(x.fe.w, trap_l);
        drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                          raw int_to_string((raw x_site(x, n.span)) => int64), ")"));
        drop irw_line(x.fe.w, "call void @npk_trap(i32 -4097)");
        drop irw_line(x.fe.w, "unreachable");
        if (signed) {
            drop irw_label(x.fe.w, next_l);
            // INT_MIN is detected STRUCTURALLY (0.9.3): it is the one nonzero
            // value equal to its own negation, at every width — so the guard
            // is total over every integer this backend will ever lower, with
            // no per-width constant table to keep in step (the table this
            // replaces would have needed a 1234-digit literal for i4096).
            string:negl = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(negl, " = sub ", lhs.ll, " 0, ",
                              lhs.ref));
            string:m0 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(m0, " = icmp eq ", lhs.ll, " ",
                              raw cat3(lhs.ref, ", ", negl)));
            string:nz = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(nz, " = icmp ne ", lhs.ll, " ",
                              raw string_concat(lhs.ref, ", 0")));
            string:m = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(m, " = and i1 ", m0, ", ", nz));
            string:o = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(o, " = icmp eq ", lhs.ll, " ",
                              raw string_concat(rhs.ref, ", -1")));
            string:both = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(both, " = and i1 ", m, ", ", o));
            string:min_l = raw irw_new_label(x.fe.w, "div.min");
            drop irw_line(x.fe.w, raw cat5("br i1 ", both, ", label %", min_l,
                              raw string_concat(", label %", ok_l)));
            drop irw_label(x.fe.w, min_l);
            drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                              raw int_to_string((raw x_site(x, n.span)) => int64), ")"));
            drop irw_line(x.fe.w, "call void @npk_trap(i32 -4098)");
            drop irw_line(x.fe.w, "unreachable");
        }
        drop irw_label(x.fe.w, ok_l);
    }

    // NO nsw, NO nuw — D-037 makes overflow defined wrapping, and the flag is
    // the license to delete guards. The header says why at length.
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = ", ins, " ",
                      raw cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
    // ONE move per binding (D-065 invalidates the whole root): the type id is
    // read first, the ll string moves, and nothing touches `lhs` after.
    int32:lty = lhs.type_id;
    pass (raw iv(move(lhs.ll), move(r), lty));
};

// `&&` and `||` short-circuit THROUGH A SLOT, not a phi — naive lowering says
// every merged value lives in memory and `mem2reg` builds the phi. The rhs block
// exists so the right side is not evaluated when the left decides.
func:emit_shortcircuit = IrVal(ExprEmitter->:x, ExprNode:n, bool:is_and) never fails {
    string:slot = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, slot, "i8");
    string:rhs_l = raw irw_new_label(x.fe.w, "sc.rhs");
    string:done_l = raw irw_new_label(x.fe.w, "sc.done");

    IrVal:l = raw emit_cond(x, raw expr_lhs(n));
    if (l.state != (raw LL_OK())) { pass l; }
    // The answer when the right side never runs: `&&` is already false, `||` is
    // already true.
    if (is_and) {
        drop irw_line(x.fe.w, raw string_concat("store i8 0, ptr ", slot));
        drop irw_line(x.fe.w, raw cat5("br i1 ", l.ref, ", label %", rhs_l,
                          raw string_concat(", label %", done_l)));
    } else {
        drop irw_line(x.fe.w, raw string_concat("store i8 1, ptr ", slot));
        drop irw_line(x.fe.w, raw cat5("br i1 ", l.ref, ", label %", done_l,
                          raw string_concat(", label %", rhs_l)));
    }
    drop irw_label(x.fe.w, rhs_l);
    IrVal:r = raw emit_cond(x, raw expr_rhs(n));
    if (r.state != (raw LL_OK())) { pass r; }
    string:z = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(z, " = zext i1 ",
                      raw string_concat(r.ref, " to i8")));
    drop irw_line(x.fe.w, raw cat4("store i8 ", z, ", ptr ", slot));
    drop irw_line(x.fe.w, raw cat3("br label %", done_l, ""));
    drop irw_label(x.fe.w, done_l);
    string:out = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(out, " = load i8, ptr ",  slot));
    pass (raw iv("i8", move(out), 0i32));
};

// --- casts --------------------------------------------------------------------------

// Between the scalar `iN`s. Truncation truncates; EXTENSION FOLLOWS THE SOURCE:
// a signed source sign-extends, an unsigned one zero-extends, because that is
// what preserves the value — the promise `=>` makes (D-021). `bool` and `char8`
// widen unsigned: neither has negative values.
// 2^(N-1) as a DOUBLE hex constant, positive and negative — the float→tbb
// range bounds. Powers of two are exact in double at every tbb width, and the
// compare is done in double (an f32 source extends first) so one table serves
// both float widths.
func:tbb_pow_hex = string(int32:bits, bool:neg) never fails {
    if (bits == 8i32)   { if (neg) { pass "0xC060000000000000"; } pass "0x4060000000000000"; }
    if (bits == 16i32)  { if (neg) { pass "0xC0E0000000000000"; } pass "0x40E0000000000000"; }
    if (bits == 32i32)  { if (neg) { pass "0xC1E0000000000000"; } pass "0x41E0000000000000"; }
    if (bits == 64i32)  { if (neg) { pass "0xC3E0000000000000"; } pass "0x43E0000000000000"; }
    if (bits == 128i32) { if (neg) { pass "0xC7E0000000000000"; } pass "0x47E0000000000000"; }
    if (bits == 256i32) { if (neg) { pass "0xCFE0000000000000"; } pass "0x4FE0000000000000"; }
    pass "";
};

// A -4100 trap block on a condition — the shared shape of every checked-cast
// guard in the tbb matrix.
func:tbb_trap_if = NIL(ExprEmitter->:x, string:cond, Span:at) never fails {
    string:tl = raw irw_new_label(x.fe.w, "tbbc.err");
    string:ol = raw irw_new_label(x.fe.w, "tbbc.ok");
    drop irw_line(x.fe.w, raw cat5("br i1 ", cond, ", label %", tl,
                      raw string_concat(", label %", ol)));
    drop irw_label(x.fe.w, tl);
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      raw int_to_string((raw x_site(x, at)) => int64), ")"));
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4100)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, ol);
    pass NIL;
};

// Resize a tbb/int carrier between widths; signed extension, because every
// carrier that reaches here is either signed or being treated as its number.
func:tbb_resize = string(ExprEmitter->:x, string:from_ll, string:ref,
                         string:to_ll, bool:src_signed) never fails {
    // cloned, not passed through: the parameter is lent (D-183)
    if (raw string_eq(from_ll, to_ll)) { pass (raw string_concat(ref, "")); }
    int64:sw = raw ll_int_width(from_ll);
    int64:dw = raw ll_int_width(to_ll);
    string:r = raw irw_temp(x.fe.w);
    if (dw < sw) {
        drop irw_line(x.fe.w, raw cat5(r, " = trunc ", from_ll, " ",
                          raw cat3(ref, " to ", to_ll)));
        pass r;
    }
    if (src_signed) {
        drop irw_line(x.fe.w, raw cat5(r, " = sext ", from_ll, " ",
                          raw cat3(ref, " to ", to_ll)));
        pass r;
    }
    drop irw_line(x.fe.w, raw cat5(r, " = zext ", from_ll, " ",
                      raw cat3(ref, " to ", to_ll)));
    pass r;
};

// THE tbb CAST MATRIX (0.9.5, D-144) — closing the audit's third Theme-A hole:
// same-width int⇄tbb rode the no-op fast path, so a taint could be forged or
// laundered with no spelling saying so. The contract, per the settled
// `cast_from_tbb`/`cast_to_tbb` arms: every crossing is legal (`CAST_OK`) and
// CARRIES ITS RUNTIME CHECK — `=>` traps (TBB_ERR, -4100) where the value has
// no image (an ERR leaving tbb, a sentinel-or-out-of-range value entering),
// and `=>!` is the greppable acceptance: the same conversion SATURATES to ERR
// instead of trapping (entering) or reads the raw carrier (leaving). tbb⇄tbb
// maps the sentinel across widths in BOTH spellings — ERR is a state, not a
// number, and a conversion that forgot it would forge validity out of taint.
func:emit_tbb_cast = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n, IrVal:v,
                           move LlType:want, int32:wid) never fails {
    bool:unchecked = false;
    if (n.kind == ExprKind.ExprUncheckedCastExpr) { unchecked = true; }
    int32:sk = raw type_kind(x.fe.ctx.types, v.type_id);
    int32:dk = raw type_kind(x.fe.ctx.types, wid);

    if (sk == (raw TY_TBB())) {
        int32:sb = raw type_int_bits(x.fe.ctx.types, v.type_id);
        string:mn_s = raw tbb_min_decimal(sb);
        if (mn_s.len == 0i64) { pass (raw iv_broken(n.span)); }
        string:err = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(err, " = icmp eq ", v.ll, " ",
                          raw cat3(v.ref, ", ", mn_s)));

        if (dk == (raw TY_TBB())) {
            int32:db = raw type_int_bits(x.fe.ctx.types, wid);
            string:mn_d = raw tbb_min_decimal(db);
            string:mx_d = raw tbb_max_decimal(db);
            if (mn_d.len == 0i64) { pass (raw iv_broken(n.span)); }
            if (db < sb) {
                string:hi2 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(hi2, " = icmp sgt ", v.ll, " ",
                                  raw cat3(v.ref, ", ", mx_d)));
                string:lo2 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(lo2, " = icmp slt ", v.ll, " ",
                                  raw cat4(v.ref, ", -", mx_d, "")));
                string:oor = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(oor, " = or i1 ", hi2, ", ", lo2));
                if (!unchecked) {
                    string:ne = raw irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, raw cat3(ne, " = xor i1 ",
                                      raw string_concat(err, ", true")));
                    string:tv = raw irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, raw cat5(tv, " = and i1 ", oor, ", ", ne));
                    drop tbb_trap_if(x, tv, n.span);
                    string:rz = raw tbb_resize(x, v.ll, v.ref, want.text, true);
                    string:res = raw irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, raw cat5(res, " = select i1 ", err, ", ",
                                      raw cat5(want.text, " ", mn_d, ", ",
                                          raw cat3(want.text, " ", rz))));
                    pass (raw iv(move(want.text), move(res), wid));
                }
                string:sat = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(sat, " = or i1 ", err, ", ", oor));
                string:rz2 = raw tbb_resize(x, v.ll, v.ref, want.text, true);
                string:res2 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(res2, " = select i1 ", sat, ", ",
                                  raw cat5(want.text, " ", mn_d, ", ",
                                      raw cat3(want.text, " ", rz2))));
                pass (raw iv(move(want.text), move(res2), wid));
            }
            string:rz3 = raw tbb_resize(x, v.ll, v.ref, want.text, true);
            string:res3 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(res3, " = select i1 ", err, ", ",
                              raw cat5(want.text, " ", mn_d, ", ",
                                  raw cat3(want.text, " ", rz3))));
            pass (raw iv(move(want.text), move(res3), wid));
        }

        // Leaving tbb: `=>` traps on ERR (no image); `=>!` reads the carrier.
        if (!unchecked) { drop tbb_trap_if(x, err, n.span); }
        if (dk == (raw TY_FLOAT())) {
            string:fr = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(fr, " = sitofp ", v.ll, " ",
                              raw cat3(v.ref, " to ", want.text)));
            pass (raw iv(move(want.text), move(fr), wid));
        }
        string:iz = raw tbb_resize(x, v.ll, v.ref, want.text, true);
        pass (raw iv(move(want.text), move(iz), wid));
    }

    // Entering tbb.
    int32:db2 = raw type_int_bits(x.fe.ctx.types, wid);
    string:mn2 = raw tbb_min_decimal(db2);
    string:mx2 = raw tbb_max_decimal(db2);
    if (mn2.len == 0i64) { pass (raw iv_broken(n.span)); }

    if (sk == (raw TY_FLOAT())) {
        // Compare in DOUBLE so one bound table serves both float widths;
        // strict bounds exclude the sentinel, and NaN fails every ordered
        // compare, so `!in` covers garbage of every kind.
        // SEEDED BY COPY, deliberately: `v` is lent and stays live (its
        // `.ref` is interpolated again below), so the mutable working names
        // take fresh bodies — the emitters' copy idiom, concat with "".
        string:cv = raw string_concat(v.ref, "");
        string:cll = raw string_concat(v.ll, "");
        if (raw string_eq(v.ll, "float")) {
            string:xt = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(xt, " = fpext float ",
                              raw string_concat(v.ref, " to double")));
            cv = move(xt);
            cll = "double";
        }
        string:pgt = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(pgt, " = fcmp ogt double ", cv, ", ",
                          raw tbb_pow_hex(db2, true)));
        string:plt = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(plt, " = fcmp olt double ", cv, ", ",
                          raw tbb_pow_hex(db2, false)));
        string:inr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(inr, " = and i1 ", pgt, ", ", plt));
        if (!unchecked) {
            string:bad2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(bad2, " = xor i1 ",
                              raw string_concat(inr, ", true")));
            drop tbb_trap_if(x, bad2, n.span);
            string:q = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(q, " = fptosi ", v.ll, " ",
                              raw cat3(v.ref, " to ", want.text)));
            pass (raw iv(move(want.text), move(q), wid));
        }
        string:q2 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(q2, " = fptosi ", v.ll, " ",
                          raw cat3(v.ref, " to ", want.text)));
        string:res4 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(res4, " = select i1 ", inr, ", ",
                          raw cat5(want.text, " ", q2, ", ",
                              raw cat3(want.text, " ", mn2))));
        pass (raw iv(move(want.text), move(res4), wid));
    }

    // int → tbb. A strictly narrower source always fits the valid range; a
    // same-or-wider one is range-checked in ITS OWN width, which is where the
    // information still exists.
    bool:ssig = raw type_is_signed(x.fe.ctx.types, v.type_id);
    int64:sw = raw ll_int_width(v.ll);
    int64:dw = raw ll_int_width(want.text);
    if (sw >= dw) {
        string:oor2 = "";
        if (ssig) {
            string:h3 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(h3, " = icmp sgt ", v.ll, " ",
                              raw cat3(v.ref, ", ", mx2)));
            string:l3 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(l3, " = icmp slt ", v.ll, " ",
                              raw cat4(v.ref, ", -", mx2, "")));
            string:o3 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(o3, " = or i1 ", h3, ", ", l3));
            oor2 = move(o3);
        } else {
            string:o4 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(o4, " = icmp ugt ", v.ll, " ",
                              raw cat3(v.ref, ", ", mx2)));
            oor2 = move(o4);
        }
        if (!unchecked) {
            drop tbb_trap_if(x, oor2, n.span);
            string:rz4 = raw tbb_resize(x, v.ll, v.ref, want.text, ssig);
            pass (raw iv(move(want.text), move(rz4), wid));
        }
        string:rz5 = raw tbb_resize(x, v.ll, v.ref, want.text, ssig);
        string:res5 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(res5, " = select i1 ", oor2, ", ",
                          raw cat5(want.text, " ", mn2, ", ",
                              raw cat3(want.text, " ", rz5))));
        pass (raw iv(move(want.text), move(res5), wid));
    }
    string:rz6 = raw tbb_resize(x, v.ll, v.ref, want.text, ssig);
    pass (raw iv(move(want.text), move(rz6), wid));
};

func:emit_cast = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    IrVal:v = raw emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }
    LlType:want = raw node_ll(x, id);
    if (want.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, want, raw exprtypes_get(x.et, id), n.span));
    }
    int32:wid = raw exprtypes_get(x.et, id);

    if (raw string_eq(v.ll, want.text)) {
        pass (raw iv(move(want.text), move(v.ref), wid));
    }

    // `enum =>! intN` — the TAG is the number (0.8.0, settled with the user). A
    // payload-less enum already IS its `i32` tag; a payload-carrying one holds
    // the tag in slot 0, so the cast extracts it and then proceeds as a scalar.
    if ((raw type_kind(x.fe.ctx.types, v.type_id)) == (raw TY_ENUM())) {
        if (!(raw string_eq(v.ll, "i32"))) {
            string:tag = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(tag, " = extractvalue ", v.ll, " ",
                              raw string_concat(v.ref, ", 0")));
            v = raw iv("i32", move(tag), v.type_id);
        }
        if (raw string_eq(v.ll, want.text)) {
            pass (raw iv(move(want.text), move(v.ref), wid));
        }
    }

    // A tbb ON EITHER SIDE takes the matrix (0.9.5) — the generic scalar path
    // below would trunc/sext the carrier raw, which is exactly the forge and
    // launder the matrix exists to end.
    if ((raw type_kind(x.fe.ctx.types, v.type_id)) == (raw TY_TBB())) {
        pass (raw emit_tbb_cast(x, id, n, v, move(want), wid));
    }
    if ((raw type_kind(x.fe.ctx.types, wid)) == (raw TY_TBB())) {
        pass (raw emit_tbb_cast(x, id, n, v, move(want), wid));
    }

    // FLOAT CASTS (0.9.4). The frontend already decided legality and loss
    // (float→int is always `=>!`; int→float and float-widening follow the
    // value-range rules); this only picks the instruction.
    bool:src_f = raw ll_is_float_text(v.ll);
    bool:dst_f = raw ll_is_float_text(want.text);
    if (src_f) {
        string:fr2 = raw irw_temp(x.fe.w);
        if (dst_f) {
            // float↔float by width: double→float truncates, float→double extends.
            if (raw string_eq(v.ll, "double")) {
                drop irw_line(x.fe.w, raw cat5(fr2, " = fptrunc double ",
                                  v.ref, " to ", want.text));
            } else {
                drop irw_line(x.fe.w, raw cat5(fr2, " = fpext ", v.ll, " ",
                                  raw cat3(v.ref, " to ", want.text)));
            }
            pass (raw iv(move(want.text), move(fr2), wid));
        }
        // float→int: signedness of the TARGET picks the instruction.
        bool:dsig = raw type_is_signed(x.fe.ctx.types, wid);
        if (dsig) {
            drop irw_line(x.fe.w, raw cat5(fr2, " = fptosi ", v.ll, " ",
                              raw cat3(v.ref, " to ", want.text)));
        } else {
            drop irw_line(x.fe.w, raw cat5(fr2, " = fptoui ", v.ll, " ",
                              raw cat3(v.ref, " to ", want.text)));
        }
        pass (raw iv(move(want.text), move(fr2), wid));
    }
    if (dst_f) {
        // int→float: signedness of the SOURCE picks the instruction.
        string:fr3 = raw irw_temp(x.fe.w);
        bool:ssig = raw type_is_signed(x.fe.ctx.types, v.type_id);
        if ((raw type_kind(x.fe.ctx.types, v.type_id)) == (raw TY_TBB())) { ssig = true; }
        if (ssig) {
            drop irw_line(x.fe.w, raw cat5(fr3, " = sitofp ", v.ll, " ",
                              raw cat3(v.ref, " to ", want.text)));
        } else {
            drop irw_line(x.fe.w, raw cat5(fr3, " = uitofp ", v.ll, " ",
                              raw cat3(v.ref, " to ", want.text)));
        }
        pass (raw iv(move(want.text), move(fr3), wid));
    }

    // EVERY NON-SCALAR CAST THE CHECKER ADMITS IS LOWERED ABOVE (1.0.9c): an
    // enum's tag is read, a `tbb` takes the matrix, a pointer is a no-op (same
    // `ptr`), a kernel id is a scalar integer. What the checker REFUSES —
    // a struct, array, `Result`, `Optional`, `dyn` (no value range,
    // `CAST_IMPOSSIBLE`), or an integer forging a payload-carrying enum
    // (`TYPE_NO_CAST`, above) — never reaches here. So a non-scalar operand at
    // this point is a broken promise, not a rung: it fails closed.
    if (!(raw ll_text_is_scalar_int(v.ll))) { pass (raw iv_broken(n.span)); }
    if (!(raw ll_text_is_scalar_int(want.text))) { pass (raw iv_broken(n.span)); }

    int64:sbits = raw ll_int_width(v.ll);
    int64:dbits = raw ll_int_width(want.text);
    string:r = raw irw_temp(x.fe.w);
    if (sbits > dbits) {
        drop irw_line(x.fe.w, raw cat5(r, " = trunc ", v.ll, " ",
                          raw cat3(v.ref, " to ", want.text)));
        pass (raw iv(move(want.text), move(r), wid));
    }
    bool:src_signed = false;
    int32:st = v.type_id;
    if ((raw type_kind(x.fe.ctx.types, st)) == (raw TY_INT())) {
        src_signed = raw type_is_signed(x.fe.ctx.types, st);
    }
    // `tbb` widens by SIGN: the carrier is signed by construction (negative
    // codes, INT32_MIN sentinel), and this arm exists because the TY_INT guard
    // above deliberately does not speak for other kinds.
    if ((raw type_kind(x.fe.ctx.types, st)) == (raw TY_TBB())) {
        src_signed = true;
    }
    if (src_signed) {
        drop irw_line(x.fe.w, raw cat5(r, " = sext ", v.ll, " ",
                          raw cat3(v.ref, " to ", want.text)));
    } else {
        drop irw_line(x.fe.w, raw cat5(r, " = zext ", v.ll, " ",
                          raw cat3(v.ref, " to ", want.text)));
    }
    pass (raw iv(move(want.text), move(r), wid));
};

// "i32" -> 32. Only ever called on text `ll_is_scalar_int` accepted.
func:ll_int_width = int64(string:ll) never fails {
    int64:n = 0i64;
    int64:i = 1i64;
    while (i < ll.len) {
        n = (n * 10i64) + ((ll.ptr[i] => int64) - 48i64);
        i = i + 1i64;
    }
    pass n;
};

// --- calls --------------------------------------------------------------------------


// THE PARAMETER AN ARGUMENT IS FIT TO (1.0.6e): position `i` of the function
// type the checker recorded on the call — the SUBSTITUTED one for a generic or
// family-impl call, which is why it is read rather than re-derived. 0 past the
// fixed window (a variadic tail; 1.1's) or when no type was recorded (a
// builtin), and `emit_fit` treats 0 as "nothing to do".
func:call_param_want = int32(ExprEmitter->:x, int32:ft, int32:i) never fails {
    if (ft == 0i32) { pass 0i32; }
    if (i >= (raw type_param_count_of(x.fe.ctx.types, ft))) { pass 0i32; }
    pass (raw ast_id_at(x.ast, raw type_param_start_of(x.fe.ctx.types, ft), i));
};

// TWO FUNCTION TYPES THAT SAY THE SAME THING (1.0.6e). `tt_func` interns the
// parameter window's start index, so two computations of one signature are
// two ids (the artifact `types_agree` exists for on the checking side); the
// parameters themselves are canonical ids, so they are what is compared.
func:fn_types_same = bool(ExprEmitter->:x, int32:a, int32:b) never fails {
    if (a == b) { pass true; }
    if (a == 0i32) { pass false; }
    if (b == 0i32) { pass false; }
    int32:pc = raw type_param_count_of(x.fe.ctx.types, a);
    if (pc != (raw type_param_count_of(x.fe.ctx.types, b))) { pass false; }
    if ((raw type_elem(x.fe.ctx.types, a)) != (raw type_elem(x.fe.ctx.types, b))) {
        pass false;
    }
    int32:sa = raw type_param_start_of(x.fe.ctx.types, a);
    int32:sb = raw type_param_start_of(x.fe.ctx.types, b);
    int32:k = 0i32;
    while (k < pc) {
        if ((raw ast_id_at(x.ast, sa, k)) != (raw ast_id_at(x.ast, sb, k))) {
            pass false;
        }
        k = k + 1i32;
    }
    pass true;
};

// A call through a FUNCTION VALUE (0.9.6, D-087): the callee is one machine
// word, the return contract is the same `Result<T>` every named call has, and
// the checker already held the arguments to the function TYPE's parameters.
func:emit_indirect_call = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    IrVal:fp = raw emit_expr(x, raw expr_callee(n));
    if (!(raw iv_is_ok(fp))) { pass fp; }
    int32:gcount = raw expr_generic_count(n);
    // TYPE ARGUMENTS ON A CALL THROUGH A FUNCTION VALUE are refused by the
    // checker (1.0.9): a function value is one body, already instantiated.
    // Reaching here with any is the frontend's promise broken, not a rung.
    if (gcount > 0i32) { pass (raw iv_broken(n.span)); }
    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);
    int32:ift = raw exprtypes_callee_ft(x.et, id);
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        IrVal:av = raw emit_expr(x, aid);
        if (av.state != (raw LL_OK())) { pass av; }
        av = raw emit_fit(x, raw call_param_want(x, ift, i), move(av), n.span);
        if (av.state != (raw LL_OK())) { pass av; }
        if (i > 0i32) { args = raw string_concat(args, ", "); }
        args = raw cat3(args, av.ll, raw string_concat(" ", av.ref));
        i = i + 1i32;
    }
    LlType:ret = raw node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret.text, " ",
                      raw cat5(fp.ref, "(", args, ")", "")));
    pass (raw iv(move(ret.text), move(r), raw exprtypes_get(x.et, id)));
};

// THE PIPE IS THE CALL WRITTEN THE OTHER WAY ROUND (1.0.9c). `x |> g` is `g(x)`
// — the value on the left is `g`'s one argument, and the result is `g`'s, a
// `Result<T>` the caller handles like any call's. The right side is a bare
// function name (a direct call to its symbol) or a function value (an indirect
// call through the pointer it evaluates to) — the same split `emit_call` makes.
// A generic function has no single symbol and no instantiation recorded on a
// pipe node, so piping to one is a defect the checker owns, not a rung.
func:emit_pipe = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    ExprId:lhs = raw expr_lhs(n);
    ExprId:rhs = raw expr_rhs(n);
    int32:rt = raw exprtypes_get(x.et, rhs);          // `g`'s function type

    IrVal:av = raw emit_expr(x, lhs);
    if (!(raw iv_is_ok(av))) { pass av; }
    av = raw emit_fit(x, raw call_param_want(x, rt, 0i32), move(av), n.span);
    if (!(raw iv_is_ok(av))) { pass av; }

    LlType:ret = raw node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }

    string:callee = "";
    ExprNode:rn = raw ast_expr(x.ast, rhs);
    if (rn.kind == ExprKind.ExprIdentifierExpr) {
        if (rn.a != 0i32) {
            Symbol:rs = raw symtab_get(x.tab, rn.a);
            if (rs.origin_kind == (raw SYM_DECL())) {
                DeclNode:rd = raw ast_decl(x.ast, DeclId{ index: rs.origin });
                if (rd.kind == DeclKind.DeclFunctionDecl) {
                    if ((raw decl_generic_window(x.ast, rd)).count > 0i32) {
                        pass (raw iv_broken(n.span));
                    }
                    callee = raw mangled_fn_sym(x.fe.ctx, rs.origin,
                                 raw intern_get(x.interns, rs.name));
                }
            }
        }
    }
    if (callee.len == 0i64) {
        // A FUNCTION VALUE: evaluate it to a pointer and call through it.
        IrVal:fp = raw emit_expr(x, rhs);
        if (!(raw iv_is_ok(fp))) { pass fp; }
        callee = move(fp.ref);
    }

    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret.text, " ",
                      raw cat5(callee, "(",
                          raw cat3(av.ll, " ", av.ref), ")", "")));
    pass (raw iv(move(ret.text), move(r), raw exprtypes_get(x.et, id)));
};

// Is this expression a DIRECT call to an `async` function? Returns the callee
// declaration's index, or 0. The narrow shape — identifier callee, declared
// symbol — is exactly the shape stage C lowers; everything wider rungs at the
// await site.
func:await_callee_decl = int32(ExprEmitter->:x, ExprId:cid) never fails {
    if (raw expr_is_none(cid)) { pass 0i32; }
    ExprNode:cn = raw ast_expr(x.ast, cid);
    // A METHOD CALL (1.1.10-D2). The checker already resolved which method
    // this reaches — through an impl, or through a generic bound (D-182
    // settles async trait methods as generics-yes, `dyn`-no) — and recorded
    // its declaration, so the await site reads that answer rather than
    // repeating the lookup. `await job.run()` is the call the `Work` trait
    // exists to make, and it refused until now.
    if (cn.kind == ExprKind.ExprMethodCallExpr) {
        int32:md = raw exprtypes_callee(x.et, cid);
        if (md == 0i32) { pass 0i32; }
        DeclNode:mdecl = raw ast_decl(x.ast, DeclId{ index: md });
        if (mdecl.kind != DeclKind.DeclFunctionDecl) { pass 0i32; }
        if (!(raw decl_has(mdecl, raw DECL_ASYNC()))) { pass 0i32; }
        pass md;
    }
    if (cn.kind != ExprKind.ExprCallExpr) { pass 0i32; }
    ExprId:callee = raw expr_callee(cn);
    if (raw expr_is_none(callee)) { pass 0i32; }
    ExprNode:cnode = raw ast_expr(x.ast, callee);
    if (cnode.kind != ExprKind.ExprIdentifierExpr) { pass 0i32; }
    if (cnode.a == 0i32) { pass 0i32; }
    Symbol:cs = raw symtab_get(x.tab, cnode.a);
    if (cs.origin_kind != (raw SYM_DECL())) { pass 0i32; }
    DeclNode:cdecl = raw ast_decl(x.ast, DeclId{ index: cs.origin });
    if (cdecl.kind != DeclKind.DeclFunctionDecl) { pass 0i32; }
    if (!(raw decl_has(cdecl, raw DECL_ASYNC()))) { pass 0i32; }
    pass cs.origin;
};

// A child frame, built for `await` and for the spawn alike (D-177):
// allocate by the GEP-null size, initialise the header, store the arguments
// in source order, each fit to its parameter. The ref is the frame pointer.
func:emit_child_frame = IrVal(ExprEmitter->:x, ExprId:cid, ExprNode:cn,
                              string:cfr_ty, string:crs, Span:at) never fails {
    string:fr = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(fr, " = call ptr @npk_alloc(",
                      raw fnem_frame_size_arg(cfr_ty), ")"));
    drop fnem_frame_init(x.fe, cfr_ty, fr, crs);
    // A CALL's window holds generic arguments first and value arguments after;
    // a METHOD call's holds only value arguments, and the slot `expr_generic_count`
    // reads means something else on that node — read blind it swallowed the
    // whole argument list, and the callee got its parameters unwritten (a
    // method awaited with one argument saw zero, and read whatever the frame
    // was allocated with).
    int32:gcount = 0i32;
    if (cn.kind != ExprKind.ExprMethodCallExpr) {
        gcount = raw expr_generic_count(cn);
    }
    int32:start = (raw expr_list_start(cn)) + gcount;
    int32:count = (raw expr_list_count(cn)) - gcount;
    int32:cft = raw exprtypes_callee_ft(x.et, cid);
    // A METHOD CALL'S RECEIVER IS PARAMETER 0 (1.1.10-D2), exactly as it is
    // for an ordinary method call — `self` is a parameter, and the only thing
    // unusual about it here is that it is not in the argument window.
    int32:base = 0i32;
    if (cn.kind == ExprKind.ExprMethodCallExpr) {
        IrVal:rv = raw emit_expr(x, raw expr_operand(cn));
        if (rv.state != (raw LL_OK())) { pass rv; }
        rv = raw emit_fit(x, raw call_param_want(x, cft, 0i32), move(rv), at);
        if (rv.state != (raw LL_OK())) { pass rv; }
        string:rg = raw fnem_slot_gep(x.fe, cfr_ty, fr, 12i32);
        drop irw_line(x.fe.w, raw cat5("store ", rv.ll, " ", rv.ref,
                          raw string_concat(", ptr ", rg)));
        base = 1i32;
    }
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        IrVal:av = raw emit_expr(x, aid);
        if (av.state != (raw LL_OK())) { pass av; }
        av = raw emit_fit(x, raw call_param_want(x, cft, base + i), move(av), at);
        if (av.state != (raw LL_OK())) { pass av; }
        string:ag = raw fnem_slot_gep(x.fe, cfr_ty, fr, 12i32 + base + i);
        drop irw_line(x.fe.w, raw cat5("store ", av.ll, " ", av.ref,
                          raw string_concat(", ptr ", ag)));
        i = i + 1i32;
    }
    pass (raw iv("ptr", move(fr), 0i32));
};

// THE ASYNC CALLEE'S NAME AT A CALL SITE, specialization included (1.1.10-D1).
// A coroutine's frame type and resume symbol are derived from its name, and a
// generic one's name is the name of the INSTANTIATION — `worker<Job>`, the
// same spelling `emit_program` gives the definition — not the template's.
// Returns "" when the callee is generic and no instantiation matches, which is
// the one case that still refuses: the specialization would not exist to call.
//
// Until this, an `await` or a spawn of a generic callee refused outright, and
// that refusal is what made D-182's own pool design unbuildable: a
// `ThreadPool<J, …>` is N worker TASKS generic in the job type, so every one
// of its spawns is this call.
func:async_callee_name = string(ExprEmitter->:x, ExprId:cid, ExprNode:cn,
                                int32:cdi, DeclNode:cdecl) never fails {
    // A METHOD'S SYMBOL IS READ, NOT REBUILT (1.0.5b's rule, and the reason
    // two impls in one module may both define `run`): the checker recorded
    // the qualified spelling — `Job:Work.run` — and the frame type and resume
    // symbol are derived from exactly that.
    if (cn.kind == ExprKind.ExprMethodCallExpr) {
        string:mn = raw intern_get(x.interns, raw decl_name(cdecl));
        int32:msym = raw exprtypes_callee_sym(x.et, cid);
        if (msym != 0i32) { pass (raw intern_get(x.interns, msym)); }
        // A CALL THROUGH A BOUND NAMES THE SPECIALIZATION'S IMPL (1.0.6b's
        // rule, and the same reasoning): `async func:do_one<J: Work>` calling
        // `job.run()` records no symbol, because at check time the receiver is
        // the PARAMETER `J` and there is no impl yet. Here there is — `J` has
        // been substituted and the trait the method came through was recorded
        // — so the two combine into the name the impl was emitted under. This
        // is the call `Work` exists for, so without it the pool cannot be
        // written.
        ExprId:rid = raw expr_operand(cn);
        int32:rty = raw exprtypes_get(x.et, rid);
        if ((raw type_kind(x.fe.ctx.types, rty)) == (raw TY_SELF())) {
            if (x.tr.self_type != 0i32) {
                pass (raw method_symbol_name(x.fe.ctx.types, x.interns,
                          x.tr.self_type, x.cur_trait, mn));
            }
        }
        if (raw type_mentions_param(x.fe.ctx.types, x.ast, rty, 64i32)) {
            int32:conc = raw subst_emitted_type(x.fe.ctx, rty);
            if (conc != rty) {
                int32:btrait = raw exprtypes_callee_trait(x.et, cid);
                pass (raw method_symbol_name(x.fe.ctx.types, x.interns,
                          conc, btrait, mn));
            }
        }
        pass "";
    }
    ExprNode:cnode = raw ast_expr(x.ast, raw expr_callee(cn));
    Symbol:cs = raw symtab_get(x.tab, cnode.a);
    string:fname = raw intern_get(x.interns, cs.name);
    if ((raw decl_generic_window(x.ast, cdecl)).count == 0i32) { pass fname; }
    int32:sn = raw fninst_for_call(x, cdi, cid);
    if (sn == 0i32) { pass ""; }
    pass (raw intern_get(x.interns, sn));
};

// THE SPAWN (D-058/D-177 stage E): `drop f(…)` on an `async` callee builds
// the child's frame and LINKS it onto the enclosing frame's join list —
// `child.sibling = join_head; join_head = child` — and control continues
// without yielding. The frame IS the task object; the join at this
// function's exits drives it. Until 1.1.5 nothing enqueues.
func:emit_spawn = IrVal(ExprEmitter->:x, ExprId:cid, ExprNode:n,
                        int32:cdi) never fails {
    ExprNode:cn = raw ast_expr(x.ast, cid);
    DeclNode:cdecl = raw ast_decl(x.ast, DeclId{ index: cdi });
    string:fname = raw async_callee_name(x, cid, cn, cdi, cdecl);
    if (fname.len == 0i64) {
        pass (raw iv_rung("a spawned generic call with no recorded instantiation",
                          "1.1", n.span));
    }
    string:cfr_ty = raw frame_ty_sym(x.fe.ctx, cdi, fname);
    string:crs = raw resume_fn_sym(x.fe.ctx, cdi, fname);
    IrVal:cfv = raw emit_child_frame(x, cid, cn, cfr_ty, crs, n.span);
    if (cfv.state != (raw LL_OK())) { pass cfv; }
    string:hdr = raw fnem_hdr_ty();
    string:sg = raw fnem_slot_gep(x.fe, hdr, cfv.ref, 5i32);
    string:old_h = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(old_h, " = load ptr, ptr ",
                      x.fe.join_gep, ""));
    drop irw_line(x.fe.w, raw cat4("store ptr ", old_h, ", ptr ", sg));
    drop irw_line(x.fe.w, raw cat5("store ptr ", cfv.ref, ", ptr ",
                      x.fe.join_gep, ""));
    // AND ENQUEUED (D-071, 1.1.8): a spawned task is runnable immediately,
    // so it advances whenever this task waits — the join collects it, but
    // the join is not what makes it run.
    drop irw_line(x.fe.w, raw cat3("call void @npk_rq_push(ptr ",
                      cfv.ref, ")"));
    pass (raw iv("i32", "0", 0i32));
};

// THE THREAD SPAWN (D-181): the same `drop f(…)` form, but the child gets an
// EXECUTOR of its own rather than a place on this one — which is the whole
// difference between a thread and a task, and why the modifier is on the
// declaration. The frame is built exactly as a task's is (same helper, same
// argument rules, same D-180 borrow ban); what changes is who runs it.
//
// The join deadline comes from the callee's `joins` clause where it has one
// and the executor default otherwise (D-083: fixed where the executor is
// created, stated in one greppable place). The TLS block the runtime hands
// back is the join's handle — held by the emitter, never by the program,
// which is what keeps "there is no thread handle" true at the surface.
func:emit_thread_spawn = IrVal(ExprEmitter->:x, ExprId:cid, ExprNode:n,
                               int32:cdi) never fails {
    ExprNode:cn = raw ast_expr(x.ast, cid);
    DeclNode:cdecl = raw ast_decl(x.ast, DeclId{ index: cdi });
    string:fname = raw async_callee_name(x, cid, cn, cdi, cdecl);
    if (fname.len == 0i64) {
        pass (raw iv_rung("a generic `thread` spawn with no recorded instantiation",
                          "1.1", n.span));
    }
    string:cfr_ty = raw frame_ty_sym(x.fe.ctx, cdi, fname);
    string:crs = raw resume_fn_sym(x.fe.ctx, cdi, fname);
    IrVal:cfv = raw emit_child_frame(x, cid, cn, cfr_ty, crs, n.span);
    if (cfv.state != (raw LL_OK())) { pass cfv; }

    // The deadline: the clause's constant, or the executor's default.
    string:jns = "";
    int32:ji = 0i32;
    while (ji < (raw fn_contract_count(x.ast, cdecl))) {
        VerifyNode:jv = raw ast_verify(x.ast, raw fn_contract(x.ast, cdecl, ji));
        if (jv.kind == VerifyKind.VerifyJoinsWithin) {
            IrVal:jd = raw emit_expr(x, raw contract_cond(jv));
            if (jd.state != (raw LL_OK())) { pass jd; }
            string:jx = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(jx, " = extractvalue ", jd.ll, " ",
                              raw string_concat(jd.ref, ", 0")));
            jns = move(jx);
        }
        ji = ji + 1i32;
    }
    if (jns.len == 0i64) {
        string:jdef = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(jdef, " = call i64 @npk_join_deadline()", ""));
        jns = move(jdef);
    }

    string:tls = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(tls, " = call ptr @npk_thread_start(ptr ",
                      cfv.ref, raw cat3(", ptr ", crs, ", i64 "),
                      raw string_concat(jns, ")")));
    // The thread rides the SAME join list a task does — one mechanism, and
    // the wind-up, the first-error relay and the deadline all already work
    // on it. Slot 7 (`qnext`) carries the TLS block, which the join needs
    // and nothing else reads: a thread is never on a ready queue, because
    // its own executor runs it.
    string:hdr = raw fnem_hdr_ty();
    string:qg = raw fnem_slot_gep(x.fe, hdr, cfv.ref, 9i32);
    drop irw_line(x.fe.w, raw cat4("store ptr ", tls, ", ptr ", qg));
    string:sg2 = raw fnem_slot_gep(x.fe, hdr, cfv.ref, 5i32);
    string:oldh = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(oldh, " = load ptr, ptr ",
                      x.fe.join_gep, ""));
    drop irw_line(x.fe.w, raw cat4("store ptr ", oldh, ", ptr ", sg2));
    drop irw_line(x.fe.w, raw cat5("store ptr ", cfv.ref, ", ptr ",
                      x.fe.join_gep, ""));
    pass (raw iv("i32", "0", 0i32));
};

// `atomic<T>`'s OPERATIONS (D-182, D-016). The receiver is a PLACE — the
// checker required one — so each lowers to LLVM's own atomic over that
// address: nothing is copied first, which is the whole point of the type.
//
// EVERY ONE IS `seq_cst`. There is no ordering parameter to read, because
// D-016 settled that a weak ordering misused is intermittent corruption on
// another CPU months later — and one spelling here means no program can ask
// for the dangerous one by accident.
func:emit_atomic_method = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                                int32:recv_tid) never fails {
    string:m = raw intern_get(x.interns, n.payload =>! int32);
    PlaceVal:pl = raw addr_of(x, raw expr_operand(n));
    if (pl.state != (raw LL_OK())) { pass (raw iv_from_place(pl)); }
    int32:elem = raw type_elem(x.fe.ctx.types, recv_tid);
    LlType:ell = raw ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, elem, n.span)); }
    string:algn = raw int_to_string((raw type_align(x.fe.ctx.types, elem)) => int64);
    int32:start = raw expr_list_start(n);
    int32:etid = raw exprtypes_get(x.et, id);

    if (raw string_eq(m, "load")) {
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = load atomic ", ell.text, ", ptr ",
                          raw cat5(pl.addr, " seq_cst, align ", algn, "", "")));
        pass (raw iv(move(ell.text), move(r), etid));
    }
    IrVal:v0 = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 0i32) });
    if (v0.state != (raw LL_OK())) { pass v0; }
    if (raw string_eq(m, "store")) {
        drop irw_line(x.fe.w, raw cat5("store atomic ", ell.text, " ", v0.ref,
                          raw cat5(", ptr ", pl.addr, " seq_cst, align ", algn, "")));
        pass (raw iv_nil());
    }
    if (raw string_eq(m, "compare_exchange")) {
        IrVal:v1 = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 1i32) });
        if (v1.state != (raw LL_OK())) { pass v1; }
        string:cx = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(cx, " = cmpxchg ptr ", pl.addr, ", ",
                          raw cat5(ell.text, " ", v0.ref, ", ",
                              raw cat5(ell.text, " ", v1.ref,
                                  " seq_cst seq_cst", ""))));
        string:prev = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(prev, " = extractvalue { ", ell.text,
                          ", i1 } ", raw string_concat(cx, ", 0")));
        pass (raw iv(move(ell.text), move(prev), etid));
    }
    string:opname = "xchg";
    if (raw string_eq(m, "fetch_add")) { opname = "add"; }
    if (raw string_eq(m, "fetch_sub")) { opname = "sub"; }
    string:rw = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(rw, " = atomicrmw ", opname, " ptr ",
                      raw cat5(pl.addr, ", ", ell.text, " ",
                          raw string_concat(v0.ref, " seq_cst"))));
    pass (raw iv(move(ell.text), move(rw), etid));
};

// A CHANNEL HANDLE, PACKED BACK INTO ONE WORD for the runtime calls.
func:chan_handle_word = string(ExprEmitter->:x, IrVal:hv) never fails {
    string:lo = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(lo, " = extractvalue { i32, i32 } ", hv.ref,
                      ", 0", ""));
    string:hi = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(hi, " = extractvalue { i32, i32 } ", hv.ref,
                      ", 1", ""));
    string:lo64 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(lo64, " = zext i32 ",
                      raw string_concat(lo, " to i64")));
    string:hi64 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(hi64, " = zext i32 ",
                      raw string_concat(hi, " to i64")));
    string:sh = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(sh, " = shl i64 ",
                      raw string_concat(hi64, ", 32")));
    string:w = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(w, " = or i64 ", sh, ", ", lo64));
    pass w;
};

// `ch.close()` (D-072) — synchronous: closing is a state change, not a wait.
// A stale handle answers `StaleHandle`, so a double close is a caught error
// rather than a second teardown.
func:emit_channel_method = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                                 int32:recv_tid) never fails {
    string:m = raw intern_get(x.interns, n.payload =>! int32);
    if (!(raw string_eq(m, "close"))) {
        // `send`/`recv` suspend, so they are reached through `await` and
        // lowered there — a channel operation that blocks is not a call.
        // A DEFECT, NOT A RUNG (1.1.10-D). `send` and `recv` are `async`, and
        // the checker now refuses a bare one by name (TYPE-043) for the same
        // reason it refuses a bare call to any `async` function: written
        // without `await` the operation does not happen. So reaching here
        // means the checker let one through, which is a hole in the checker
        // rather than a capability arriving in some later cycle — and it used
        // to say "enabled by cycle 1.1", promising a feature that was never
        // going to exist.
        pass (raw iv_broken(n.span));
    }
    IrVal:hv = raw emit_expr(x, raw expr_operand(n));
    if (hv.state != (raw LL_OK())) { pass hv; }
    string:hw = raw chan_handle_word(x, hv);
    string:rc = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(rc, " = call i32 @npk_ch_close(i64 ", hw,
                      ")", ""));
    string:r0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r0, " = insertvalue { i32 } undef, i32 ",
                      rc, ", 0", ""));
    IrVal:out = raw iv("{ i32 }", move(r0), raw exprtypes_get(x.et, id));
    out.wrapped = true;
    out.inner = "";
    pass out;
};

// `await g(x)` — the machines compose (D-177). Allocate g's frame, store the
// arguments, advance our own state, and DRIVE: g DONE hands back its result
// slot and the frame is freed; g SUSPENDED propagates — we save nothing but
// the state word, because everything live is already frame-resident (params)
// or refused (crossing locals, until stage D).
// IS THIS AWAIT'S OPERAND A CHANNEL `send`/`recv`? They are the language's
// only intrinsic suspensions besides `sleep` — a full or empty channel
// suspends the TASK (D-071), which is emitted code's business because only
// the state machine can suspend.
func:await_channel_recv = int32(ExprEmitter->:x, ExprId:cid) never fails {
    if (raw expr_is_none(cid)) { pass 0i32; }
    ExprNode:cn = raw ast_expr(x.ast, cid);
    if (cn.kind != ExprKind.ExprMethodCallExpr) { pass 0i32; }
    int32:rt = raw exprtypes_get(x.et, raw expr_operand(cn));
    if ((raw type_kind(x.fe.ctx.types, rt)) != (raw TY_CHANNEL())) { pass 0i32; }
    pass rt;
};

// `await ch.send(v, within)` / `await ch.recv(within)` (D-072/D-182).
//
// THE DEADLINE IS ABSOLUTE BEFORE THE LOOP STARTS: the span is converted
// once, at suspension entry (D-176 rule 2), so a retry cannot extend it.
// Each turn tries the non-blocking step; "would block" suspends the task
// and comes back. The first cut RE-POLLS on a short timer rather than being
// woken by the peer — correct and bounded, never missing a wakeup, with the
// per-channel futex wake named as the follow-up in 1.1.10's plan.
func:emit_channel_await = IrVal(ExprEmitter->:x, ExprId:id, ExprId:cid,
                                int32:ch_tid, Span:at) never fails {
    ExprNode:cn = raw ast_expr(x.ast, cid);
    string:m = raw intern_get(x.interns, cn.payload =>! int32);
    bool:is_send = raw string_eq(m, "send");
    // Substituted for the same reason `channel()` is: inside a generic body the
    // recorded channel type still names the parameter, and the element's
    // LLVM type and size are what the copy is measured in.
    ch_tid = raw subst_emitted_type(x.fe.ctx, ch_tid);
    int32:elem = raw type_elem(x.fe.ctx.types, ch_tid);
    LlType:ell = raw ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, elem, at)); }

    // THE LOOP'S STATE IS FRAME-RESIDENT (D-182). Everything below outlives
    // the suspension the retry makes, and an SSA value computed before the
    // loop does not dominate the resume switch's re-entry — the pre-scan
    // reserved these slots on this statement, which D-178 guarantees carries
    // at most one suspension.
    int32:hi_ = raw fnem_cross_find(x.fe, x.fe.cur_stmt, 20i32);
    int32:di_ = raw fnem_cross_find(x.fe, x.fe.cur_stmt, 21i32);
    int32:vi_ = raw fnem_cross_find(x.fe, x.fe.cur_stmt, 22i32);
    int32:ei_ = raw fnem_cross_find(x.fe, x.fe.cur_stmt, 23i32);
    if (hi_ < 0i32) { pass (raw iv_broken(at)); }
    if (di_ < 0i32) { pass (raw iv_broken(at)); }
    if (vi_ < 0i32) { pass (raw iv_broken(at)); }
    if (ei_ < 0i32) { pass (raw iv_broken(at)); }
    string:hwslot = raw fnem_cross_gep(x.fe, hi_);
    string:dslot = raw fnem_cross_gep(x.fe, di_);
    string:slot = raw fnem_cross_gep(x.fe, vi_);
    string:eslot = raw fnem_cross_gep(x.fe, ei_);

    IrVal:hv = raw emit_expr(x, raw expr_operand(cn));
    if (hv.state != (raw LL_OK())) { pass hv; }
    string:hw0 = raw chan_handle_word(x, hv);
    drop irw_line(x.fe.w, raw cat4("store i64 ", hw0, ", ptr ", hwslot));

    int32:start = raw expr_list_start(cn);
    if (is_send) {
        IrVal:sv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 0i32) });
        if (sv.state != (raw LL_OK())) { pass sv; }
        // THE SLOT IS THE ELEMENT'S, AND `fits` ADMITS MORE THAN EQUALITY —
        // a concrete value into a `dyn`, a `T` into a `T?`, a `T` into an
        // `atomic<T>`. The checker asked `fits` for this argument, so the
        // value here is not necessarily already the element's shape, and
        // storing it raw writes the argument's bytes into a slot sized and
        // shaped for something else. `emit_fit` is what builds it.
        sv = raw emit_fit(x, elem, move(sv), at);
        if (sv.state != (raw LL_OK())) { pass sv; }
        drop irw_line(x.fe.w, raw cat5("store ", ell.text, " ", sv.ref,
                          raw string_concat(", ptr ", slot)));
    }
    // the deadline, absolute, computed once
    int32:dai = 0i32;
    if (is_send) { dai = 1i32; }
    IrVal:dv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, dai) });
    if (dv.state != (raw LL_OK())) { pass dv; }
    string:dns = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(dns, " = extractvalue ", dv.ll, " ",
                      raw string_concat(dv.ref, ", 0")));
    string:t0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(t0, " = call i64 @npk_mono_now()", ""));
    string:dabs0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(dabs0, " = add i64 ", t0, ", ", dns));
    drop irw_line(x.fe.w, raw cat4("store i64 ", dabs0, ", ptr ", dslot));
    drop irw_line(x.fe.w, raw cat3("store i32 0, ptr ", eslot, ""));

    // THE WHOLE PROTOCOL IS ONE CALL (1.1.10-C2). `npk_ch_{send,recv}_wait`
    // takes the channel's lock, unlinks this frame from the waiter list it may
    // still be on, re-tests the condition, and then either completes, reports
    // an error, or registers the frame and parks it against the deadline. It
    // returns 0 done, 1 parked, or a negative Error — so the emitted loop is a
    // call, a branch, and a resume point, with no timing decisions in it.
    //
    // It used to poll: try, and if the answer was "would block", park for a
    // millisecond and try again. That was bounded and correct and it cost up
    // to a millisecond per hand-off — and it could not express a rendezvous,
    // because a poll has no way to ask whether a receiver is present.
    string:head = raw irw_new_label(x.fe.w, "ch.try");
    string:fin = raw irw_new_label(x.fe.w, "ch.done");
    drop s_br(x, head);
    drop s_start(x, head);
    string:fn = "@npk_ch_recv_wait";
    if (is_send) { fn = "@npk_ch_send_wait"; }
    string:hw = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(hw, " = load i64, ptr ", hwslot, ""));
    string:dabs = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(dabs, " = load i64, ptr ", dslot, ""));
    string:rc = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(rc, " = call i32 ", fn, "(i64 ",
                      raw cat5(hw, ", ptr ", slot, ", i64 ",
                          raw cat3(dabs, ", ptr %fr)", ""))));
    drop irw_line(x.fe.w, raw cat4("store i32 ", rc, ", ptr ", eslot));
    string:again = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(again, " = icmp eq i32 ",
                      raw string_concat(rc, ", 1")));
    string:park = raw irw_new_label(x.fe.w, "ch.park");
    drop irw_line(x.fe.w, raw cat5("br i1 ", again, ", label %", park,
                      raw string_concat(", label %", fin)));
    x.fe.terminated = true;

    drop s_start(x, park);
    // The runtime already named the wake condition (it called `park_until`
    // with the caller's deadline before returning 1), so this only has to
    // record where to come back to.
    string:sg = raw fnem_new_seg(x.fe);
    int32:sk = raw fnem_seg_index(x.fe);
    drop irw_line(x.fe.w, raw cat5("store i32 ",
                      raw int_to_string(sk => int64), ", ptr ",
                      x.fe.state_gep, ""));
    drop irw_line(x.fe.w, "ret i8 1");
    x.fe.terminated = true;
    drop s_start(x, sg);
    // the wind-up poll every resume segment owes (D-177): a wound-up task
    // stops waiting on a channel like it stops waiting on anything else
    string:pw = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(pw, " = load i32, ptr ", x.fe.windup_gep, ""));
    drop irw_line(x.fe.w, raw cat3("call void @npk_windup_note(i32 ", pw, ")"));
    string:pwb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(pwb, " = icmp ne i32 ",
                      raw string_concat(pw, ", 0")));
    string:wu = raw irw_new_label(x.fe.w, "ch.wind");
    string:go = raw irw_new_label(x.fe.w, "ch.go");
    drop irw_line(x.fe.w, raw cat5("br i1 ", pwb, ", label %", wu,
                      raw string_concat(", label %", go)));
    x.fe.terminated = true;
    drop s_start(x, wu);
    IrVal:wd = raw run_all_defers(x);
    if (!(raw iv_is_ok(wd))) { pass wd; }
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      raw int_to_string((raw x_site(x, at)) => int64), ")"));
    drop fnem_ret_fail(x.fe, "-4107");
    x.fe.terminated = true;
    drop s_start(x, go);
    drop s_br(x, head);

    drop s_start(x, fin);
    // rc is 0 on success and a negative Error otherwise — DeadlineExceeded
    // included, which the runtime decides now that it owns the waiting
    string:err = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(err, " = load i32, ptr ",
                      raw string_concat(eslot, "")));
    int32:rt_id = raw exprtypes_get(x.et, cid);
    if (is_send) {
        string:o0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(o0, " = insertvalue { i32 } undef, i32 ",
                          err, ", 0", ""));
        IrVal:so = raw iv("{ i32 }", move(o0), rt_id);
        so.wrapped = true;
        so.inner = "";
        pass so;
    }
    string:got = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(got, " = load ", ell.text, ", ptr ",
                      raw string_concat(slot, "")));
    LlType:rll = raw ll_wrap_result(x.fe.ctx, elem);
    if (!(raw ll_is_ok(rll))) { pass (raw iv_from_ll_at(x, rll, elem, at)); }
    string:v0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(v0, " = insertvalue ", rll.text, " undef, ",
                      raw cat4(ell.text, " ", got, ", 0")));
    string:v1 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(v1, " = insertvalue ", rll.text, " ",
                      raw string_concat(v0, raw cat3(", i32 ", err, ", 1"))));
    IrVal:ro = raw iv(move(rll.text), move(v1), rt_id);
    ro.wrapped = true;
    ro.inner = move(ell.text);
    pass ro;
};

func:emit_await = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    // The one pick position that still refuses (D3): a `where` guard. The
    // compare CHAIN re-reads the selector value after a failed guard to test
    // the next arm, and that value cannot survive a suspension inside the
    // guard. Arm BODIES are fine — their bindings are frame-resident now.
    if (x.fe.guard_depth > 0i32) {
        pass (raw iv_rung("an `await` inside a `pick` arm's `where` guard",
                          "1.1", n.span));
    }
    // THE FIRST-EVALUATION BACKSTOP (D-178): the checker's SUSPEND-002 rule
    // refuses a suspension after other evaluation, so no legal program
    // reaches this — it stands as the belt to that suspender, refusing
    // loudly if a checker regression ever lets an SSA value straddle the
    // resume switch.
    if (!(raw irw_clean_since_mark(x.fe.w))) {
        pass (raw iv_rung("an `await` after other evaluation in its statement",
                          "1.1", n.span));
    }
    ExprId:cid = raw expr_operand(n);
    int32:cht = raw await_channel_recv(x, cid);
    if (cht != 0i32) {
        pass (raw emit_channel_await(x, id, cid, cht, n.span));
    }
    int32:cdi = raw await_callee_decl(x, cid);
    if (cdi == 0i32) {
        pass (raw iv_rung("an `await` of an indirect or builtin call",
                          "1.1", n.span));
    }
    ExprNode:cn = raw ast_expr(x.ast, cid);
    DeclNode:cdecl = raw ast_decl(x.ast, DeclId{ index: cdi });
    string:fname = raw async_callee_name(x, cid, cn, cdi, cdecl);
    if (fname.len == 0i64) {
        pass (raw iv_rung("an `await` of a generic call with no recorded instantiation",
                          "1.1", n.span));
    }
    string:cfr_ty = raw frame_ty_sym(x.fe.ctx, cdi, fname);
    string:crs = raw resume_fn_sym(x.fe.ctx, cdi, fname);

    // The callee's frame, then its arguments — via the same helper the
    // spawn uses. Nothing here can suspend: `await` nests inside no
    // expression that could re-enter this sequence.
    IrVal:cfv = raw emit_child_frame(x, cid, cn, cfr_ty, crs, n.span);
    if (cfv.state != (raw LL_OK())) { pass cfv; }
    string:fr = move(cfv.ref);

    // Advance our state to the resume segment, then fall into it. From here
    // to the segment's end is exactly what a re-entry replays.
    drop irw_line(x.fe.w, raw cat4("store ptr ", fr, ", ptr ",
                      x.fe.awaitee_gep));
    string:sg = raw fnem_new_seg(x.fe);
    int32:kk = raw fnem_seg_index(x.fe);
    drop irw_line(x.fe.w, raw cat5("store i32 ",
                      raw int_to_string(kk => int64), ", ptr ",
                      x.fe.state_gep, ""));
    drop irw_line(x.fe.w, raw cat3("br label %", sg, ""));
    x.fe.terminated = true;
    drop s_start(x, sg);

    // THE WIND-UP POLL (D-177): a segment that begins at a suspension reads
    // its own windup word first and propagates it into the awaitee, which
    // then unwinds through its own defers and answers through its result
    // slot — no skip path, one completion shape.
    string:w = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(w, " = load i32, ptr ",
                      x.fe.windup_gep, ""));
    string:wb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(wb, " = icmp ne i32 ",
                      raw string_concat(w, ", 0")));
    string:wu_l = raw irw_new_label(x.fe.w, "wu");
    string:drv_l = raw irw_new_label(x.fe.w, "drv");
    drop irw_line(x.fe.w, raw cat5("br i1 ", wb, ", label %", wu_l,
                      raw string_concat(", label %", drv_l)));
    x.fe.terminated = true;
    drop s_start(x, wu_l);
    string:af0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(af0, " = load ptr, ptr ",
                      x.fe.awaitee_gep, ""));
    string:cwg = raw fnem_slot_gep(x.fe, cfr_ty, af0, 2i32);
    drop irw_line(x.fe.w, raw cat4("store i32 ", w, ", ptr ", cwg));
    drop irw_line(x.fe.w, raw cat3("br label %", drv_l, ""));
    x.fe.terminated = true;
    drop s_start(x, drv_l);

    string:af = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(af, " = load ptr, ptr ",
                      x.fe.awaitee_gep, ""));
    string:rc = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(rc, " = call i8 ", crs, "(ptr ",
                      raw string_concat(af, ")")));
    string:dn = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(dn, " = icmp eq i8 ",
                      raw string_concat(rc, ", 0")));
    string:sus_l = raw irw_new_label(x.fe.w, "sus");
    string:dn_l = raw irw_new_label(x.fe.w, "dn");
    drop irw_line(x.fe.w, raw cat5("br i1 ", dn, ", label %", dn_l,
                      raw string_concat(", label %", sus_l)));
    x.fe.terminated = true;
    drop s_start(x, sus_l);
    // Suspension propagates. No defers run — the scope is not exiting, it is
    // pausing; every value it still needs is in a frame.
    drop irw_line(x.fe.w, "ret i8 1");
    x.fe.terminated = true;
    drop s_start(x, dn_l);

    LlType:rll = raw node_ll(x, cid);
    if (rll.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, rll, raw exprtypes_get(x.et, cid), n.span));
    }
    string:rg = raw fnem_slot_gep(x.fe, cfr_ty, af, 3i32);
    string:res = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(res, " = load ", rll.text, ", ptr ",
                      raw string_concat(rg, "")));
    drop irw_line(x.fe.w, raw cat3("call void @npk_dalloc(ptr ", af, ")"));
    drop irw_line(x.fe.w, raw cat4("store ptr null, ptr ",
                      x.fe.awaitee_gep, "", ""));

    int32:rt_id = raw exprtypes_get(x.et, cid);
    IrVal:out = raw iv(move(rll.text), move(res), rt_id);
    out.wrapped = true;
    out.inner = "";
    int32:inner_id = raw type_elem(x.fe.ctx.types, rt_id);
    if ((raw type_kind(x.fe.ctx.types, inner_id)) != (raw TY_NIL())) {
        LlType:it = raw ll_type(x.fe.ctx, inner_id);
        if (it.state != (raw LL_OK())) {
            pass (raw iv_from_ll_at(x, it, inner_id, n.span));
        }
        out.inner = move(it.text);
    }
    pass out;
};

func:emit_call = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    ExprId:callee = raw expr_callee(n);
    if (raw expr_is_none(callee)) { pass (raw iv_broken(n.span)); }
    ExprNode:cnode = raw ast_expr(x.ast, callee);
    if (cnode.kind == ExprKind.ExprMemberAccessExpr) {
        // A MEMBER-ACCESS CALLEE IS ONE OF TWO THINGS (1.0.9c). `Ev.Move(…)` is
        // an enum VARIANT constructor — the member types as its enum. `(s.f)(x)`
        // is a call through a function-valued FIELD — the member types as a
        // function, and the checker recorded that type as the callee signature
        // (1.0.6e), so it lowers as an indirect call, the field loaded first.
        if (raw type_is_func(x.fe.ctx.types, raw exprtypes_get(x.et, callee))) {
            pass (raw emit_indirect_call(x, id, n));
        }
        pass (raw emit_enum_ctor(x, id, n, cnode));
    }
    if (cnode.kind != ExprKind.ExprIdentifierExpr) {
        pass (raw emit_indirect_call(x, id, n));
    }
    if (cnode.a != 0i32) {
        Symbol:csym = raw symtab_get(x.tab, cnode.a);
        if (csym.origin_kind == (raw SYM_STMT())) {
            // The callee is a LOCAL holding a function value — indirect too.
            pass (raw emit_indirect_call(x, id, n));
        }
        if (csym.origin_kind == (raw SYM_DECL())) {
            DeclNode:cdecl = raw ast_decl(x.ast, DeclId{ index: csym.origin });
            // A PARAMETER holding a function value: indirect, same as a local.
            if (cdecl.kind == DeclKind.DeclParamDecl) {
                pass (raw emit_indirect_call(x, id, n));
            }
        }
    }

    // The turbofish's arguments were consumed by the checker (which recorded the
    // instantiation, 1.0.2b); the emitter steps over them and calls the
    // specialization named below.
    int32:gcount = raw expr_generic_count(n);
    int32:start = (raw expr_list_start(n)) + gcount;
    int32:count = (raw expr_list_count(n)) - gcount;

    // A BUILTIN EMITS ITS OWN ARGUMENTS: two lower inline without a call at
    // all, and the floor's signatures are the coercion authority for the rest —
    // a user call needs neither, so the paths split before the argument walk.
    if (cnode.a == 0i32) {
        pass (raw call_builtin(x, id, n, cnode, start, count));
    }

    // Arguments in source order, each FIT TO ITS PARAMETER (1.0.6e). This loop
    // used to say "no `want` coercion anywhere: D-092 has no implicit widening,
    // so the checker already made every argument EXACTLY its parameter's type"
    // — which is true of widening and false of `fits`' two admissions, a
    // concrete value into a `dyn` and a `T` into a `T?`. A `Dog` passed where
    // `dyn Speaks` was declared reached `llc` as `%Dog` and was refused there.
    int32:cft = raw exprtypes_callee_ft(x.et, id);
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        IrVal:av = raw emit_expr(x, aid);
        if (av.state != (raw LL_OK())) { pass av; }
        av = raw emit_fit(x, raw call_param_want(x, cft, i), move(av), n.span);
        if (av.state != (raw LL_OK())) { pass av; }
        if (i > 0i32) { args = raw string_concat(args, ", "); }
        args = raw cat3(args, av.ll, raw string_concat(" ", av.ref));
        i = i + 1i32;
    }

    // A user function: the symbol names the declaration, the declaration names
    // the function, and the call's own recorded type is the full `Result<T>`.
    Symbol:s = raw symtab_get(x.tab, cnode.a);
    string:fname = raw intern_get(x.interns, s.name);

    // A GENERIC CALL NAMES ITS SPECIALIZATION (1.0.2b). The declaration is a
    // template; what this call reaches is the body emitted for ITS argument set.
    //
    // THE INSTANTIATION IS RE-DERIVED, NOT CARRIED ON THE NODE. A call node's
    // slots are all spoken for (callee, argument window, generic count), and
    // widening the AST to carry a backend index is the frontend rework the
    // capability ladder exists to prevent. Instead the match is made from what
    // the checker already recorded: this call's own ARGUMENT TYPES against the
    // recorded instantiation's PARAMETER TYPES. Two instantiations of one
    // declaration differ in their substituted signature, so the arguments that
    // reached this call say which one it is — and where a program has only one
    // instantiation of a function (the common case) the first match is it.
    string:sym = raw mangled_fn_sym(x.fe.ctx, s.origin, fname);
    DeclNode:cdecl = raw ast_decl(x.ast, DeclId{ index: s.origin });
    if ((raw decl_generic_window(x.ast, cdecl)).count > 0i32) {
        int32:spec = raw fninst_for_call(x, s.origin, id);
        if (spec != 0i32) {
            sym = raw mangled_fn_sym(x.fe.ctx, s.origin,
                      raw intern_get(x.interns, spec));
        }
    }
    LlType:ret = raw node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }

    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret.text, " ",
                      raw cat4(sym, "(", args, ")")));
    int32:rt_id = raw exprtypes_get(x.et, id);
    IrVal:out = raw iv(move(ret.text), move(r), rt_id);
    out.wrapped = true;
    // `Result<NIL>` has no value half; everything else's is the type it declares.
    out.inner = "";
    int32:inner_id = raw type_elem(x.fe.ctx.types, rt_id);
    if ((raw type_kind(x.fe.ctx.types, inner_id)) != (raw TY_NIL())) {
        LlType:it = raw ll_type(x.fe.ctx, inner_id);
        if (it.state != (raw LL_OK())) {
            pass (raw iv_from_ll_at(x, it, inner_id, n.span));
        }
        out.inner = move(it.text);
    }
    pass out;
};

// DROP EVERY LIVE ELEMENT OF AN ARENA (D-183, 1.2.5c), emitted where the
// element type is known — reset and destroy retire slots wholesale, and a
// live slot of an owning type holds a body only its drop can free. Live is
// an even, non-zero generation (arena_alloc/arena_free's parity). The
// counter is an alloca rather than a phi so no predecessor bookkeeping is
// needed at a method site.
func:arena_drop_live = NIL(ExprEmitter->:x, string:ap, int32:elem) never fails {
    if (!(raw type_drops(x.fe.ctx.types, elem, 64i32))) { pass NIL; }
    string:all = "{ ptr, ptr, i64, i64, i64 }";
    string:slab = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(slab, " = load ptr, ptr ", ap, ""));
    string:sdead = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(sdead, " = icmp eq ptr ",
                      raw string_concat(slab, ", null")));
    string:lgo = raw irw_new_label(x.fe.w, "aw.go");
    string:ldone = raw irw_new_label(x.fe.w, "aw.done");
    drop irw_line(x.fe.w, raw cat5("br i1 ", sdead, ", label %", ldone,
                      raw string_concat(", label %", lgo)));
    drop s_start(x, lgo);
    string:gp = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(gp, " = getelementptr ", all, ", ptr ",
                      raw string_concat(ap, ", i32 0, i32 1")));
    string:gens = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(gens, " = load ptr, ptr ", gp, ""));
    string:tp = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(tp, " = getelementptr ", all, ", ptr ",
                      raw string_concat(ap, ", i32 0, i32 3")));
    string:top = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(top, " = load i64, ptr ", tp, ""));
    string:iv2 = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, iv2, "i64");
    drop irw_line(x.fe.w, raw cat3("store i64 0, ptr ", iv2, ""));
    string:lhead = raw irw_new_label(x.fe.w, "aw.head");
    string:lbody = raw irw_new_label(x.fe.w, "aw.body");
    string:ldel = raw irw_new_label(x.fe.w, "aw.del");
    string:lstep = raw irw_new_label(x.fe.w, "aw.step");
    drop s_br(x, lhead);
    drop s_start(x, lhead);
    string:ic = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(ic, " = load i64, ptr ", iv2, ""));
    string:inb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(inb, " = icmp ult i64 ", ic, ", ",
                      raw string_concat(top, "")));
    drop irw_line(x.fe.w, raw cat5("br i1 ", inb, ", label %", lbody,
                      raw string_concat(", label %", ldone)));
    drop s_start(x, lbody);
    string:gep = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(gep, " = getelementptr i32, ptr ", gens,
                      ", i64 ", raw string_concat(ic, "")));
    string:g = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat4(g, " = load i32, ptr ", gep, ""));
    string:nz = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(nz, " = icmp ne i32 ",
                      raw string_concat(g, ", 0")));
    string:par = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(par, " = and i32 ",
                      raw string_concat(g, ", 1")));
    string:ev = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(ev, " = icmp eq i32 ",
                      raw string_concat(par, ", 0")));
    string:lv = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(lv, " = and i1 ", nz, ", ",
                      raw string_concat(ev, "")));
    drop irw_line(x.fe.w, raw cat5("br i1 ", lv, ", label %", ldel,
                      raw string_concat(", label %", lstep)));
    drop s_start(x, ldel);
    string:off = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(off, " = mul i64 ", ic, ", ",
                      raw int_to_string(raw type_size(x.fe.ctx.types, elem))));
    string:ep = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(ep, " = getelementptr i8, ptr ", slab,
                      ", i64 ", raw string_concat(off, "")));
    drop irw_line(x.fe.w, raw cat4("call void ",
                      raw drop_fn_sym(x.fe.ctx, elem),
                      raw string_concat("(ptr ", ep), ")"));
    drop s_br(x, lstep);
    drop s_start(x, lstep);
    string:i2 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(i2, " = add i64 ",
                      raw string_concat(ic, ", 1")));
    drop irw_line(x.fe.w, raw cat5("store i64 ", i2, ", ptr ", iv2, ""));
    drop s_br(x, lhead);
    drop s_start(x, ldone);
    pass NIL;
};

func:call_builtin = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                          ExprNode:cnode, int32:start, int32:count) never fails {
    string:name = raw intern_get(x.interns, cnode.payload =>! int32);

    // `channel()` (D-182): the runtime opens the channel and hands back a
    // packed { index, generation }. Capacity and element size come from the
    // TYPE — which is why the call takes no arguments.
    if (raw string_eq(name, "channel")) {
        int32:crt = raw exprtypes_get(x.et, id);
        int32:cht = raw type_elem(x.fe.ctx.types, crt);
        // THROUGH THE INSTANTIATION'S BINDING (1.1.10-D3). The checker recorded
        // the TEMPLATE's type — `Channel<J, …>` inside `pool_create<J>` — and
        // the element's SIZE is what the ring copies. Unsubstituted, `J`
        // measures 0, so the channel was opened with a zero-byte element and
        // every value came back all zeroes: a pool whose jobs all arrived
        // blank, with nothing failing anywhere.
        cht = raw subst_emitted_type(x.fe.ctx, cht);
        int32:celem = raw type_elem(x.fe.ctx.types, cht);
        int64:ccap = (raw type_chan_cap(x.fe.ctx.types, cht)) => int64;
        int64:cesz = raw type_size(x.fe.ctx.types, celem);
        // THE CREATING FUNCTION OWNS THE RECLAIM (D-182/D-183, 1.2.5):
        // endpoints are copyable non-owners, so nothing about the VALUE can
        // say when the channel's life ends — the CREATION SITE can, and
        // does: the packed handle is stashed beside the frame, and the
        // function's exit — after its defers, drops and child joins — hands
        // the slot back, which moves the generation and makes StaleHandle
        // reachable. Inside a LOOP the one stash would hold only the last
        // iteration's handle and the rest would leak their slots; that needs
        // per-scope join machinery, and it refuses by name until it exists.
        // A FACTORY HANDS ITS CHANNELS OUT (D-183, 1.2.5): a function whose
        // RETURN TYPE carries a channel — `pool_create` returning the pool
        // that holds one — cannot be its reclaimer, and nothing else can be
        // yet (endpoints are copyable non-owners by D-182, so no value says
        // when the life ends). Its creations live to process end, the
        // pre-1.2.5 status quo, recorded as D-183's open item: an explicit
        // ownership marker for factory channels is a language-surface
        // question. Everything else reclaims at the creating function.
        bool:cfinal = !(raw type_contains_channel(x.fe.ctx.types,
                            raw subst_emitted_type(x.fe.ctx, x.fe.ret_type),
                            64i32));
        if (cfinal) {
            if (x.fe.loop_count > 0i32) {
                pass (raw iv_rung(
                    "a `channel()` inside a loop — one stash per creation SITE reclaims only the last iteration's channel, and per-iteration reclaim needs per-scope join machinery",
                    "per-scope join machinery (C-22)", n.span));
            }
        }
        string:hr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(hr, " = call i64 @npk_ch_open(i64 ",
                          raw int_to_string(ccap), ", i64 ",
                          raw cat3(raw int_to_string(cesz), ")", "")));
        string:cstash = "";
        if (cfinal) {
            if (x.fe.is_async) {
                int32:cfi = raw fnem_cross_find(x.fe, x.fe.cur_stmt,
                                                30i32 + x.fe.chopen_ord);
                // A MISS IS A DEFECT, NOT A RUNG: the pre-scan and this
                // site walk the same tree, and drift between them fails
                // closed as broken IR.
                if (cfi < 0i32) { pass (raw iv_broken(n.span)); }
                x.fe.chopen_ord = x.fe.chopen_ord + 1i32;
                cstash = raw fnem_cross_gep(x.fe, cfi);
            } else {
                cstash = raw irw_temp(x.fe.w);
                drop irw_alloca(x.fe.w, cstash, "i64");
            }
            drop irw_line(x.fe.w, raw cat5("store i64 ", hr, ", ptr ", cstash, ""));
            int32:cdrop = 0i32;
            if (raw type_drops(x.fe.ctx.types, celem, 64i32)) { cdrop = celem; }
            drop fnem_chfin_add(x.fe, raw string_concat(cstash, ""), cdrop);
        }
        // the packed word becomes the { i32, i32 } the type lowers to
        string:lo = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(lo, " = trunc i64 ",
                          raw string_concat(hr, " to i32")));
        string:sh = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(sh, " = lshr i64 ",
                          raw string_concat(hr, ", 32")));
        string:hi = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(hi, " = trunc i64 ",
                          raw string_concat(sh, " to i32")));
        string:h0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(h0, " = insertvalue { i32, i32 } undef, i32 ",
                          lo, ", 0", ""));
        string:h1 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(h1, " = insertvalue { i32, i32 } ", h0,
                          ", i32 ", raw string_concat(hi, ", 1")));
        // wrapped as the Result the checker gave it
        string:r0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r0,
                          " = insertvalue { { i32, i32 }, i32 } undef, { i32, i32 } ",
                          h1, ", 0", ""));
        string:r1 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(r1,
                          " = insertvalue { { i32, i32 }, i32 } ",
                          raw string_concat(r0, ", i32 0, 1")));
        IrVal:cv = raw iv("{ { i32, i32 }, i32 }", move(r1), crt);
        cv.wrapped = true;
        cv.inner = "{ i32, i32 }";
        pass cv;
    }

    // THE SUSPENSION PRIMITIVE (D-071, 1.1.8). `suspend_until(at)` is the
    // bottom of the waiting stack — every blocking operation in the language
    // is built from it, which is what makes "blocking is always task
    // suspension" true rather than aspirational. It lowers INLINE, because
    // suspending is not something a called function can do for you: the park
    // request goes to the executor, the state word advances to a fresh
    // segment, and the machine returns SUSPENDED. On resume the switch lands
    // at that segment and execution continues past the call.
    if (raw string_eq(name, "suspend_until")) {
        if (!x.fe.is_async) { pass (raw iv_broken(n.span)); }
        IrVal:pa = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 0i32) });
        if (!(raw iv_is_ok(pa))) { pass pa; }
        drop irw_line(x.fe.w, raw cat3("call void @npk_park_until(i64 ",
                          pa.ref, ")"));
        string:psg = raw fnem_new_seg(x.fe);
        int32:pk = raw fnem_seg_index(x.fe);
        drop irw_line(x.fe.w, raw cat5("store i32 ",
                          raw int_to_string(pk => int64), ", ptr ",
                          x.fe.state_gep, ""));
        drop irw_line(x.fe.w, "ret i8 1");
        x.fe.terminated = true;
        drop s_start(x, psg);
        // THE WIND-UP POLL (D-177), and its meaning: a task whose wind-up
        // word is set does not resume its work — the wait completes with the
        // wind-up error instead of its value, the task runs its own `defer`s,
        // and it fails with `DeadlineExceeded`. That is the whole cooperative
        // model, and it needs to exist at ONE site only: every wait in the
        // language bottoms out here, so an awaiting task learns through its
        // awaitee's failure rather than through a second mechanism — and no
        // frame is abandoned, because each level unwinds in order.
        string:pw = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat4(pw, " = load i32, ptr ",
                          x.fe.windup_gep, ""));
        drop irw_line(x.fe.w, raw cat3("call void @npk_windup_note(i32 ",
                          pw, ")"));
        string:pwb = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(pwb, " = icmp ne i32 ",
                          raw string_concat(pw, ", 0")));
        string:wu_l2 = raw irw_new_label(x.fe.w, "wu.unwind");
        string:go_l2 = raw irw_new_label(x.fe.w, "wu.go");
        drop irw_line(x.fe.w, raw cat5("br i1 ", pwb, ", label %", wu_l2,
                          raw string_concat(", label %", go_l2)));
        x.fe.terminated = true;
        drop s_start(x, wu_l2);
        IrVal:wud = raw run_all_defers(x);
        if (!(raw iv_is_ok(wud))) { pass wud; }
        drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                          raw int_to_string((raw x_site(x, n.span)) => int64),
                          ")"));
        drop fnem_ret_fail(x.fe, "-4107");
        x.fe.terminated = true;
        drop s_start(x, go_l2);
        pass (raw iv("i32", "0", 0i32));
    }

    // THE SITE LOOKUPS (D-179, 1.1.6) call the per-program tables the origin
    // chain's ids index — emitted by `emit_site_tables`, bounded-checked there.
    if (raw string_eq(name, "site_line")) {
        IrVal:sa = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 0i32) });
        if (!(raw iv_is_ok(sa))) { pass sa; }
        string:sr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(sr, " = call i32 @npk_site_line(i32 ",
                          sa.ref, ")", ""));
        pass (raw iv("i32", move(sr), 0i32));
    }
    if (raw string_eq(name, "site_path")) {
        IrVal:sb = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 0i32) });
        if (!(raw iv_is_ok(sb))) { pass sb; }
        string:sr2 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(sr2,
                          " = call { ptr, i64, i64 } @npk_site_path(i32 ",
                          sb.ref, ")", ""));
        pass (raw iv("{ ptr, i64, i64 }", move(sr2), 0i32));
    }

    // TWO LOWER INLINE, because their whole body is a field read: a string's
    // byte length IS its second slot, and emptiness is that slot against zero.
    // A call would be a symbol, a frame, and a return for an extractvalue.
    if (raw string_eq(name, "string_byte_length")) {
        IrVal:sv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                       start, 0i32) });
        if (!(raw iv_is_ok(sv))) { pass sv; }
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = extractvalue ", sv.ll, " ",
                          raw string_concat(sv.ref, ", 1")));
        pass (raw iv("i64", move(r), 0i32));
    }
    if (raw string_eq(name, "string_is_empty")) {
        IrVal:sv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                       start, 0i32) });
        if (!(raw iv_is_ok(sv))) { pass sv; }
        string:ln = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(ln, " = extractvalue ", sv.ll, " ",
                          raw string_concat(sv.ref, ", 1")));
        string:c = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(c, " = icmp eq i64 ",
                          raw string_concat(ln, ", 0")));
        string:z = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(z, " = zext i1 ",
                          raw string_concat(c, " to i8")));
        pass (raw iv("i8", move(z), 0i32));
    }

    // `shared_arena_make(cap)` is TYPE-DIRECTED like `arena_make` (D-154).
    if (raw string_eq(name, "shared_arena_make")) {
        if (count != 1i32) { pass (raw iv_broken(cnode.span)); }
        int32:smtid = raw exprtypes_get(x.et, id);
        if ((raw type_kind(x.fe.ctx.types, smtid)) != (raw TY_SHARED_ARENA())) {
            pass (raw iv_broken(cnode.span));
        }
        string:smst = raw arena_stride_text(x, smtid);
        IrVal:smcap = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                          start, 0i32) });
        if (!(raw iv_is_ok(smcap))) { pass smcap; }
        string:smcr = raw string_concat(smcap.ref, "");
        if (!(raw string_eq(smcap.ll, "i64"))) {
            string:smw = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(smw, " = sext ", smcap.ll, " ",
                              raw string_concat(smcap.ref, " to i64")));
            smcr = move(smw);
        }
        string:smr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(smr,
            " = call ptr @npk_sarena_make(i64 ", smst,
            ", i64 ", raw string_concat(smcr, ")")));
        pass (raw iv("ptr", move(smr), smtid));
    }

    // `arena_make(cap)` is TYPE-DIRECTED (D-152): the element's stride comes
    // from the arena type the annotation gave this call, so the generic
    // signature table cannot serve it.
    if (raw string_eq(name, "arena_make")) {
        if (count != 1i32) { pass (raw iv_broken(cnode.span)); }
        int32:amtid = raw exprtypes_get(x.et, id);
        if ((raw type_kind(x.fe.ctx.types, amtid)) != (raw TY_ARENA())) {
            pass (raw iv_broken(cnode.span));
        }
        string:amst = raw arena_stride_text(x, amtid);
        IrVal:amcap = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                          start, 0i32) });
        if (!(raw iv_is_ok(amcap))) { pass amcap; }
        string:amcr = raw string_concat(amcap.ref, "");
        if (!(raw string_eq(amcap.ll, "i64"))) {
            string:amw = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(amw, " = sext ", amcap.ll, " ",
                              raw string_concat(amcap.ref, " to i64")));
            amcr = move(amw);
        }
        string:amr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(amr,
            " = call { ptr, ptr, i64, i64, i64 } @npk_arena_make(i64 ", amst,
            ", i64 ", raw string_concat(amcr, ")")));
        pass (raw iv("{ ptr, ptr, i64, i64, i64 }", move(amr), amtid));
    }

    RtSig:sig = raw rt_sig(name);
    if (!sig.found) {
        // `sys(CONST, ..*int64[])` is the one remaining bare builtin with no
        // floor entry, and its blocker is named: it is VARIADIC, and variadics
        // are 0.9's machinery (D-047/D-048 settled its shape long ago).
        if (raw string_eq(name, "sys")) {
            // `sys(NR, args…)` (0.9.7, BUILTIN §3): the six-register trampoline
            // the floor already carries, zero-filled — and the kernel's return
            // mapped into the D-141 convention right here: negative is the
            // error slot, anything else is the value. The one syscall form.
            if (count > 7i32) { pass (raw iv_broken(cnode.span)); }
            if (count < 1i32) { pass (raw iv_broken(cnode.span)); }
            string:sargs = "";
            int32:si = 0i32;
            while (si < count) {
                ExprId:said = ExprId{ index: raw ast_id_at(x.ast, start, si) };
                IrVal:sav = raw emit_expr(x, said);
                if (!(raw iv_is_ok(sav))) { pass sav; }
                string:sref = raw string_concat(sav.ref, "");
                if (!(raw string_eq(sav.ll, "i64"))) {
                    string:sw = raw irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, raw cat5(sw, " = sext ", sav.ll, " ",
                                      raw string_concat(sav.ref, " to i64")));
                    sref = move(sw);
                }
                if (si > 0i32) { sargs = raw string_concat(sargs, ", "); }
                sargs = raw cat3(sargs, "i64 ", sref);
                si = si + 1i32;
            }
            while (si < 7i32) {
                if (si > 0i32) { sargs = raw string_concat(sargs, ", "); }
                sargs = raw string_concat(sargs, "i64 0");
                si = si + 1i32;
            }
            string:sr = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(sr, " = call i64 @npk_sys6(",
                              raw string_concat(sargs, ")")));
            string:sneg = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(sneg, " = icmp slt i64 ",
                              raw string_concat(sr, ", 0")));
            string:se32 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(se32, " = trunc i64 ",
                              raw string_concat(sr, " to i32")));
            string:serr = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(serr, " = select i1 ", sneg,
                              ", i32 ", raw string_concat(se32, ", i32 0")));
            string:sval = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(sval, " = select i1 ", sneg,
                              ", i64 0, i64 ", sr));
            string:sa2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(sa2,
                              " = insertvalue { i64, i32 } undef, i64 ", sval,
                              ", 0", ""));
            string:sb2 = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(sb2,
                              " = insertvalue { i64, i32 } ", sa2, ", i32 ",
                              raw string_concat(serr, ", 1")));
            pass (raw iv("{ i64, i32 }", move(sb2), 0i32));
        }
        // UNREACHABLE. Every `is_builtin_name` (builtins.npk) is served above:
        // four lower inline, `sys` is handled in this block, and the rest have an
        // `rt_sig` entry -- the resolver admits no other name as a builtin.
        pass (raw iv_broken(cnode.span));
    }

    // THE FLOOR'S SIGNATURE IS THE COERCION AUTHORITY. Builtin arguments are
    // deliberately loose in the checker ("its signature arrives with call
    // checking"), so a scalar that arrives wider or narrower than the runtime's
    // parameter is adjusted HERE — `memset`'s value is `int64` in the language
    // and `i32` at the symbol, and an uncoerced call is IR llc rejects.
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        IrVal:av = raw emit_expr(x, aid);
        if (av.state != (raw LL_OK())) { pass av; }
        string:want = raw rt_arg(sig, i);
        string:ref = raw string_concat(av.ref, "");
        string:ll = move(av.ll);
        if (i < sig.argc) {
            if (!(raw string_eq(ll, want))) {
                if (raw ll_text_is_scalar_int(ll)) {
                    if (raw ll_text_is_scalar_int(want)) {
                        string:cv = raw irw_temp(x.fe.w);
                        if ((raw ll_int_width(ll)) > (raw ll_int_width(want))) {
                            drop irw_line(x.fe.w, raw cat5(cv, " = trunc ", ll,
                                              " ", raw cat3(ref, " to ", want)));
                        } else {
                            drop irw_line(x.fe.w, raw cat5(cv, " = zext ", ll,
                                              " ", raw cat3(ref, " to ", want)));
                        }
                        ref = move(cv);
                        ll = move(want);
                    }
                }
            }
        }
        if (i > 0i32) { args = raw string_concat(args, ", "); }
        args = raw cat3(args, ll, raw string_concat(" ", ref));
        i = i + 1i32;
    }

    if (raw string_eq(sig.ret, "void")) {
        drop irw_line(x.fe.w, raw cat5("call void ", sig.sym, "(", args, ")"));
        pass (raw iv("i32", "0", 0i32));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", sig.ret, " ",
                      raw cat4(sig.sym, "(", args, ")")));
    IrVal:out = raw iv(raw string_concat(sig.ret, ""), move(r), 0i32);
    out.wrapped = sig.wrapped;
    out.inner = move(sig.inner);
    pass out;
};

// --- `raw` --------------------------------------------------------------------------

// Unwrap without looking: the value half, whatever the error said. The analyses
// already decided where that is allowed; here it is just an extract.
// `relay` — unwrap, or return the caller's error VERBATIM (D-080). A normal
// exit path: the defer stack runs on the error branch, exactly as a `fail`
// there would run it, and that is why this module and `ir_stmt` are a cycle.
// A stamp site's id, from a span (D-179, 1.1.6). The MAY-FAIL path lookup,
// deliberately: a harness-built emitter has an empty source manager, and a
// missing path is data for the table ("?"), not a defect — the same posture
// diag rendering takes for `<unknown file>`.
pub func:x_site = int32(ExprEmitter->:x, Span:sp) never fails {
    Result<string>:pr = srcmgr_path(x.sm, sp.file);
    string:sp_path = "?";
    if (!pr.is_error) { sp_path = move(pr.value); }
    pass (raw irw_site(x.fe.w, move(sp_path), sp.line));
};

func:emit_relay = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    IrVal:v = raw emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }
    int32:my_t = raw exprtypes_get(x.et, id);
    // Type-driven, flag as fallback — the same repair `emit_raw` records.
    int32:ot = raw exprtypes_get(x.et, raw expr_operand(n));
    if ((raw type_kind(x.fe.ctx.types, ot)) == (raw TY_RESULT())) {
        int32:in_t = raw type_elem(x.fe.ctx.types, ot);
        v.wrapped = true;
        v.inner = "";
        if ((raw type_kind(x.fe.ctx.types, in_t)) != (raw TY_NIL())) {
            LlType:il = raw ll_type(x.fe.ctx, in_t);
            if (!(raw ll_is_ok(il))) {
                pass (raw iv_from_ll_at(x, il, in_t, n.span));
            }
            v.inner = move(il.text);
        }
    }
    if (!v.wrapped) { pass (raw iv(raw string_concat(v.ll, ""), raw string_concat(v.ref, ""), my_t)); }

    // The value half first — only the ok path needs it, but extracting before
    // the branch keeps every extract in the block that computed the Result.
    string:val = "";
    if (v.inner.len > 0i64) {
        val = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(val, " = extractvalue ", v.ll, " ",
                          raw string_concat(v.ref, ", 0")));
    }
    // The error field: slot 1, or slot 0 of a `Result<NIL>` (D-084 collapsed
    // the value away).
    string:idx = ", 1";
    if (v.inner.len == 0i64) { idx = ", 0"; }
    string:code = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(code, " = extractvalue ", v.ll, " ",
                      raw string_concat(v.ref, idx)));
    string:bad = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(bad, " = icmp ne i32 ",
                      raw string_concat(code, ", 0")));
    string:err_l = raw irw_new_label(x.fe.w, "relay.err");
    string:ok_l = raw irw_new_label(x.fe.w, "relay.ok");
    drop irw_line(x.fe.w, raw cat5("br i1 ", bad, ", label %", err_l,
                      raw string_concat(", label %", ok_l)));
    x.fe.terminated = true;

    drop s_start(x, err_l);
    // THE HOP IS STAMPED (D-179): one `npk_chain_push` per relay site, before
    // the defers — the chain records where the error PASSED, and it passed
    // here first.
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_push(i32 ",
                      raw int_to_string((raw x_site(x, n.span)) => int64), ")"));
    // EVERY frame runs — relay exits the whole function, so its error path owes
    // the same cleanup a `fail` here would owe.
    IrVal:d = raw run_all_defers(x);
    if (!(raw iv_is_ok(d))) { pass d; }
    drop fnem_ret_fail(x.fe, code);
    x.fe.terminated = true;

    drop s_start(x, ok_l);
    if (v.inner.len == 0i64) { pass (raw iv("i32", "0", my_t)); }
    pass (raw iv(raw string_concat(v.inner, ""), move(val), my_t));
};

func:emit_raw = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    IrVal:v = raw emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }
    int32:my_t = raw exprtypes_get(x.et, id);

    // THE OPERAND'S RECORDED TYPE DECIDES, and the call-side flag is only the
    // fallback for the one place the type is deliberately unknown (a builtin
    // call). The first version asked only the flag, and the flag is set by
    // CALLS — so `raw r` over a Result-typed LOCAL passed the whole `{T, i32}`
    // through as the value, and `llc` refused the insertvalue two lines later.
    int32:ot = raw exprtypes_get(x.et, raw expr_operand(n));
    bool:is_result = ((raw type_kind(x.fe.ctx.types, ot)) == (raw TY_RESULT()));
    if (!is_result) {
        if (!v.wrapped) {
            // Genuinely plain — a bare-`ptr` builtin, or already unwrapped.
            // Two fields of one root cannot both move (D-065): the ll is
            // copied, the ref — the larger, always-unique SSA name — moves.
            pass (raw iv(raw string_concat(v.ll, ""), move(v.ref), my_t));
        }
    }

    string:inner_ll = raw string_concat(v.inner, "");
    if (is_result) {
        int32:in_t = raw type_elem(x.fe.ctx.types, ot);
        if ((raw type_kind(x.fe.ctx.types, in_t)) == (raw TY_NIL())) {
            inner_ll = "";
        } else {
            LlType:il = raw ll_type(x.fe.ctx, in_t);
            if (!(raw ll_is_ok(il))) {
                pass (raw iv_from_ll_at(x, il, in_t, n.span));
            }
            inner_ll = move(il.text);
        }
    }
    if (inner_ll.len == 0i64) {
        // `Result<NIL>`: the value half is nothing, spelled `i32 0`.
        pass (raw iv("i32", "0", my_t));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = extractvalue ", v.ll, " ",
                                     raw string_concat(v.ref, ", 0")));
    pass (raw iv(move(inner_ll), move(r), my_t));
};

// --- places (0.7.7) ---------------------------------------------------------------
//
// A PLACE IS AN ADDRESS WITH A TYPE. Assignment stores through one, `@` hands one
// out, an index into an array needs one. Everything else in the emitter is
// value-based — which was enough until the compiler's own sources demanded
// `list.items[n] = d`, which is the seed's history too.


// The element stride an arena runtime call carries: the element's size
// rounded up to its alignment, floored at 8 so a free slot can hold the
// freelist link (D-152).
func:arena_stride_text = string(ExprEmitter->:x, int32:arena_tid) never fails {
    int32:elem = (raw tt_get(x.fe.ctx.types, arena_tid)).a;
    int64:esz = raw type_size(x.fe.ctx.types, elem);
    int64:eal = (raw type_align(x.fe.ctx.types, elem)) => int64;
    if (eal < 1i64) { eal = 1i64; }
    int64:st = ((esz + eal) - 1i64) / eal;
    st = st * eal;
    if (st < 8i64) { st = 8i64; }
    pass (raw int_to_string(st));
};

// `a.alloc()` / `a.get(h)` / `a.put(h, v)` / `a.free(h)` / `a.reset()` /
// `a.destroy()` — the D-152 lowering. One runtime address helper serves get
// and put (`@npk_arena_at` returns the slot pointer or null); the LOAD or
// STORE through it is emitted here, where the element's layout is known. A
// stale handle becomes a `Result` error (-4106), never a trap: staleness is
// a condition the program handles, not a defect the runtime ends.
func:emit_arena_method = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                               int32:recv_tid) never fails {
    // The receiver's address: a place directly, or the pointer's VALUE when
    // the receiver is `arena<T>->` (the same one-level peel `.` does).
    string:ap = "";
    int32:atid = recv_tid;
    if ((raw type_kind(x.fe.ctx.types, recv_tid)) == (raw TY_POINTER())) {
        atid = raw type_elem(x.fe.ctx.types, recv_tid);
        IrVal:pv2 = raw emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(pv2))) { pass pv2; }
        ap = move(pv2.ref);
    } else {
        PlaceVal:apv = raw addr_of(x, raw expr_operand(n));
        if (apv.state != (raw LL_OK())) { pass (raw iv_from_place(apv)); }
        ap = move(apv.addr);
    }
    string:st = raw arena_stride_text(x, atid);
    int32:elem = (raw tt_get(x.fe.ctx.types, atid)).a;
    string:m = raw intern_get(x.fe.ctx.interns, n.payload =>! int32);
    int32:start = raw expr_list_start(n);

    if (raw string_eq(m, "alloc")) {
        string:h = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(h,
            " = call { i64, i32 } @npk_arena_alloc(ptr ", ap, ", i64 ",
            raw string_concat(st, ")")));
        pass (raw iv("{ i64, i32 }", move(h), raw exprtypes_get(x.et, id)));
    }
    if (raw string_eq(m, "reset")) {
        // OWNING ELEMENTS DROP BEFORE THE RING FORGETS THEM (D-183, 1.2.5c):
        // reset retires every live slot, and a live slot of an owning type
        // holds a body only its drop can free.
        drop arena_drop_live(x, ap, elem);
        drop irw_line(x.fe.w, raw cat5("call void @npk_arena_reset(ptr ", ap,
                          ", i64 ", st, ")"));
        pass (raw iv("i32", "0", 0i32));
    }
    if (raw string_eq(m, "destroy")) {
        drop arena_drop_live(x, ap, elem);
        drop irw_line(x.fe.w, raw cat3("call void @npk_arena_destroy(ptr ",
                          ap, ")"));
        pass (raw iv("i32", "0", 0i32));
    }

    // the remaining three all carry a handle first
    IrVal:hv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 0i32) });
    if (!(raw iv_is_ok(hv))) { pass hv; }
    string:hidx = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(hidx, " = extractvalue { i64, i32 } ",
                      hv.ref, ", ", "0"));
    string:hgen = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(hgen, " = extractvalue { i64, i32 } ",
                      hv.ref, ", ", "1"));

    if (raw string_eq(m, "free")) {
        // The element's drop runs before the slot retires (D-183, 1.2.5c):
        // `arena_at` re-validates the handle, so a stale free drops nothing.
        if (raw type_drops(x.fe.ctx.types, elem, 64i32)) {
            string:fep = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(fep,
                " = call ptr @npk_arena_at(ptr ", ap,
                raw cat5(", i64 ", st, ", i64 ", hidx, ""),
                raw cat3(", i32 ", hgen, ")")));
            string:fok = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(fok, " = icmp ne ptr ",
                              raw string_concat(fep, ", null")));
            string:fdl = raw irw_new_label(x.fe.w, "af.drop");
            string:fkl = raw irw_new_label(x.fe.w, "af.kept");
            drop irw_line(x.fe.w, raw cat5("br i1 ", fok, ", label %", fdl,
                              raw string_concat(", label %", fkl)));
            drop s_start(x, fdl);
            drop irw_line(x.fe.w, raw cat4("call void ",
                              raw drop_fn_sym(x.fe.ctx, elem),
                              raw string_concat("(ptr ", fep), ")"));
            drop s_br(x, fkl);
            drop s_start(x, fkl);
        }
        string:rc = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(rc,
            " = call i32 @npk_arena_free(ptr ", ap,
            raw cat5(", i64 ", st, ", i64 ", hidx, ""),
            raw cat3(", i32 ", hgen, ")")));
        string:bad = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(bad, " = icmp ne i32 ",
                          raw string_concat(rc, ", 0")));
        string:ec = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(ec, " = select i1 ", raw
                          string_concat(bad, ", i32 -4106, i32 0")));
        string:rr = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(rr, " = insertvalue { i32 } undef, i32 ",
                          ec, ", ", "0"));
        pass (raw iv("{ i32 }", move(rr), raw exprtypes_get(x.et, id)));
    }

    LlType:ell = raw ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, elem, n.span)); }
    string:p = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(p,
        " = call ptr @npk_arena_at(ptr ", ap,
        raw cat5(", i64 ", st, ", i64 ", hidx, ""),
        raw cat3(", i32 ", hgen, ")")));
    string:isnull = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(isnull, " = icmp eq ptr ",
                      raw string_concat(p, ", null")));

    if (raw string_eq(m, "get")) {
        int32:rtid = raw exprtypes_get(x.et, id);
        LlType:rll = raw ll_type(x.fe.ctx, rtid);
        if (!(raw ll_is_ok(rll))) { pass (raw iv_from_ll_at(x, rll, rtid, n.span)); }
        string:slot = raw irw_temp(x.fe.w);
        drop irw_alloca(x.fe.w, slot, rll.text);
        string:l_ok = raw irw_new_label(x.fe.w, "ar.ok");
        string:l_st = raw irw_new_label(x.fe.w, "ar.stale");
        string:l_dn = raw irw_new_label(x.fe.w, "ar.done");
        drop irw_line(x.fe.w, raw cat5("br i1 ", isnull, ", label %", l_st,
                          raw string_concat(", label %", l_ok)));
        drop irw_label(x.fe.w, l_ok);
        string:v = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(v, " = load ", ell.text, ", ptr ", p));
        string:f0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(f0, " = getelementptr ", rll.text,
                          ", ptr ", raw string_concat(slot, ", i32 0, i32 0")));
        drop irw_line(x.fe.w, raw cat5("store ", ell.text, " ", v,
                          raw string_concat(", ptr ", f0)));
        string:f1 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(f1, " = getelementptr ", rll.text,
                          ", ptr ", raw string_concat(slot, ", i32 0, i32 1")));
        drop irw_line(x.fe.w, raw cat3("store i32 0, ptr ", f1, ""));
        drop irw_line(x.fe.w, raw cat3("br label %", l_dn, ""));
        drop irw_label(x.fe.w, l_st);
        string:g0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(g0, " = getelementptr ", rll.text,
                          ", ptr ", raw string_concat(slot, ", i32 0, i32 0")));
        drop irw_line(x.fe.w, raw cat5("store ", ell.text,
                          " zeroinitializer, ptr ", g0, ""));
        string:g1 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(g1, " = getelementptr ", rll.text,
                          ", ptr ", raw string_concat(slot, ", i32 0, i32 1")));
        drop irw_line(x.fe.w, raw cat3("store i32 -4106, ptr ", g1, ""));
        drop irw_line(x.fe.w, raw cat3("br label %", l_dn, ""));
        drop irw_label(x.fe.w, l_dn);
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = load ", rll.text, ", ptr ", slot));
        pass (raw iv(move(rll.text), move(r), rtid));
    }

    // put: store the value through the slot, or report stale
    IrVal:vv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, 1i32) });
    if (!(raw iv_is_ok(vv))) { pass vv; }
    // THE ARENA'S ELEMENT IS A SLOT (1.0.6e).
    vv = raw emit_fit(x, elem, move(vv), n.span);
    if (!(raw iv_is_ok(vv))) { pass vv; }
    string:pslot = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, pslot, "{ i32 }");
    string:p_ok = raw irw_new_label(x.fe.w, "ap.ok");
    string:p_st = raw irw_new_label(x.fe.w, "ap.stale");
    string:p_dn = raw irw_new_label(x.fe.w, "ap.done");
    drop irw_line(x.fe.w, raw cat5("br i1 ", isnull, ", label %", p_st,
                      raw string_concat(", label %", p_ok)));
    drop irw_label(x.fe.w, p_ok);
    drop irw_line(x.fe.w, raw cat5("store ", vv.ll, " ", vv.ref,
                      raw string_concat(", ptr ", p)));
    drop irw_line(x.fe.w, raw cat3("store { i32 } { i32 0 }, ptr ", pslot, ""));
    drop irw_line(x.fe.w, raw cat3("br label %", p_dn, ""));
    drop irw_label(x.fe.w, p_st);
    drop irw_line(x.fe.w, raw cat3("store { i32 } { i32 -4106 }, ptr ", pslot, ""));
    drop irw_line(x.fe.w, raw cat3("br label %", p_dn, ""));
    drop irw_label(x.fe.w, p_dn);
    string:pr = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(pr, " = load { i32 }, ptr ", pslot, "", ""));
    pass (raw iv("{ i32 }", move(pr), raw exprtypes_get(x.et, id)));
};


// `s.alloc(v)` / `s.get(h)` / `s.destroy()` (D-154). The receiver is a
// VALUE — one pointer to the runtime structure — so no place is taken.
// `alloc` bumps atomically, asks for the slot address, stores the value,
// and only then builds the handle: the write happens before the handle can
// escape, which is the whole publication discipline. `get` checks the
// handle's generation is the shared arena's constant zero (an `arena<T>`
// handle wandering over carries an even generation of at least two and is
// refused as stale), then asks for the slot; null is stale (-4106).
func:emit_sarena_method = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                                int32:recv_tid) never fails {
    IrVal:sav = raw emit_expr(x, raw expr_operand(n));
    if (!(raw iv_is_ok(sav))) { pass sav; }
    string:sa = move(sav.ref);
    string:st = raw arena_stride_text(x, recv_tid);
    int32:elem = (raw tt_get(x.fe.ctx.types, recv_tid)).a;
    string:m = raw intern_get(x.fe.ctx.interns, n.payload =>! int32);
    int32:start = raw expr_list_start(n);

    if (raw string_eq(m, "destroy")) {
        drop irw_line(x.fe.w, raw cat3("call void @npk_sarena_destroy(ptr ",
                          sa, ")"));
        pass (raw iv("i32", "0", 0i32));
    }

    if (raw string_eq(m, "alloc")) {
        IrVal:vv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                       start, 0i32) });
        if (!(raw iv_is_ok(vv))) { pass vv; }
        // THE ARENA'S ELEMENT IS A SLOT (1.0.6e).
        vv = raw emit_fit(x, elem, move(vv), n.span);
        if (!(raw iv_is_ok(vv))) { pass vv; }
        string:idx = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(idx,
            " = call i64 @npk_sarena_bump(ptr ", sa, ", i64 ",
            raw string_concat(st, ")")));
        string:p = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(p,
            " = call ptr @npk_sarena_slot(ptr ", sa,
            raw cat5(", i64 ", st, ", i64 ", idx, ")"), ""));
        drop irw_line(x.fe.w, raw cat5("store ", vv.ll, " ", vv.ref,
                          raw string_concat(", ptr ", p)));
        string:h0 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(h0,
            " = insertvalue { i64, i32 } undef, i64 ", idx, ", ", "0"));
        string:h1 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(h1,
            " = insertvalue { i64, i32 } ", h0, ", i32 0, ", "1"));
        pass (raw iv("{ i64, i32 }", move(h1), raw exprtypes_get(x.et, id)));
    }

    // get(h)
    IrVal:hv = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                   start, 0i32) });
    if (!(raw iv_is_ok(hv))) { pass hv; }
    string:hidx = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(hidx, " = extractvalue { i64, i32 } ",
                      hv.ref, ", ", "0"));
    string:hgen = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(hgen, " = extractvalue { i64, i32 } ",
                      hv.ref, ", ", "1"));
    string:genok = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(genok, " = icmp eq i32 ",
                      raw string_concat(hgen, ", 0")));
    string:p2 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(p2,
        " = call ptr @npk_sarena_slot(ptr ", sa,
        raw cat5(", i64 ", st, ", i64 ", hidx, ")"), ""));
    string:nn = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(nn, " = icmp ne ptr ",
                      raw string_concat(p2, ", null")));
    string:live = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(live, " = and i1 ", genok, ", ", nn));

    int32:rtid = raw exprtypes_get(x.et, id);
    LlType:rll = raw ll_type(x.fe.ctx, rtid);
    if (!(raw ll_is_ok(rll))) { pass (raw iv_from_ll_at(x, rll, rtid, n.span)); }
    LlType:ell = raw ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, elem, n.span)); }
    string:slot = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, slot, rll.text);
    string:l_ok = raw irw_new_label(x.fe.w, "sg.ok");
    string:l_st = raw irw_new_label(x.fe.w, "sg.stale");
    string:l_dn = raw irw_new_label(x.fe.w, "sg.done");
    drop irw_line(x.fe.w, raw cat5("br i1 ", live, ", label %", l_ok,
                      raw string_concat(", label %", l_st)));
    drop irw_label(x.fe.w, l_ok);
    string:v = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(v, " = load ", ell.text, ", ptr ", p2));
    string:f0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(f0, " = getelementptr ", rll.text,
                      ", ptr ", raw string_concat(slot, ", i32 0, i32 0")));
    drop irw_line(x.fe.w, raw cat5("store ", ell.text, " ", v,
                      raw string_concat(", ptr ", f0)));
    string:f1 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(f1, " = getelementptr ", rll.text,
                      ", ptr ", raw string_concat(slot, ", i32 0, i32 1")));
    drop irw_line(x.fe.w, raw cat3("store i32 0, ptr ", f1, ""));
    drop irw_line(x.fe.w, raw cat3("br label %", l_dn, ""));
    drop irw_label(x.fe.w, l_st);
    string:g0 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(g0, " = getelementptr ", rll.text,
                      ", ptr ", raw string_concat(slot, ", i32 0, i32 0")));
    drop irw_line(x.fe.w, raw cat5("store ", ell.text,
                      " zeroinitializer, ptr ", g0, ""));
    string:g1 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(g1, " = getelementptr ", rll.text,
                      ", ptr ", raw string_concat(slot, ", i32 0, i32 1")));
    drop irw_line(x.fe.w, raw cat3("store i32 -4106, ptr ", g1, ""));
    drop irw_line(x.fe.w, raw cat3("br label %", l_dn, ""));
    drop irw_label(x.fe.w, l_dn);
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = load ", rll.text, ", ptr ", slot));
    pass (raw iv(move(rll.text), move(r), rtid));
};

pub struct:PlaceVal = {
    int32:state;
    string:rung;
    string:what;
    Span:at;
    string:addr;      // a `ptr`-typed ref
    int32:type_id;    // what is stored there
};

func:pv = PlaceVal(move string:addr, int32:type_id) never fails {
    PlaceVal:p = PlaceVal{ state: raw LL_OK(), rung: "", what: "",
                           at: raw span_none(), addr: move(addr), type_id: type_id };
    pass p;
};

func:pv_rung = PlaceVal(move string:what, move string:rung, Span:at) never fails {
    PlaceVal:p = PlaceVal{ state: raw LL_RUNG(), rung: move(rung), what: move(what), at: at,
                           addr: "", type_id: 0i32 };
    pass p;
};

func:pv_broken = PlaceVal(Span:at) never fails {
    PlaceVal:p = PlaceVal{ state: raw LL_BROKEN(), rung: "", what: "", at: at,
                           addr: "", type_id: 0i32 };
    pass p;
};

// Which recorded instantiation of `decl` does this call reach? Matched on the
// call's argument types against the instantiation's substituted parameter types
// (1.0.2b). Returns the interned specialized NAME (`extract<int32>`), or 0.
//
// MATCHED BY THE SIGNATURE THE CHECKER RECORDED ON THE CALL (1.0.6e), not by
// the arguments' own types. Until 1.0.6e this compared each argument's recorded
// type with the instantiation's parameter type, which is exact only while the
// two are equal — and `fits` admits a `Dog` where `dyn Speaks` is declared and
// an `int32` where `int32?` is. Either would have matched no instantiation and
// called the template's symbol, which does not exist. `callee_ft` IS the
// instantiation's substituted signature, so the match is the signature itself.
func:fninst_for_call = int32(ExprEmitter->:x, int32:decl, ExprId:call) never fails {
    int32:ft = raw exprtypes_callee_ft(x.et, call);
    int32:i = 0i32;
    while (i < (raw fninst_count(x.fninsts))) {
        FnInstance:e = raw fninst_at(x.fninsts, i);
        if (e.decl == decl) {
            if (raw fn_types_same(x, e.type_id, ft)) {
                pass (raw fninst_name_of(x, raw fninst_concrete(x, e, call)));
            }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// A TEMPLATE-SHAPED INSTANCE BECOMES THE CONCRETE ONE THIS SPECIALIZATION ASKS
// FOR (1.0.7). `pair_of<T>` calling `list_make::<T>(…)` recorded `list_make<T>`
// with `T` opaque (D-107) — a request on behalf of whatever `pair_of` is
// instantiated at. Emitting `pair_of<int64>`, its arguments are read through
// the binding, the concrete request is RECORDED (deduped by arguments, D-108's
// rule, so two callers of one instance record it once), and the instance loop
// in `emit_program`, which re-reads the table's count, emits it after this
// body. Nothing is recorded when no argument names a parameter: a concrete
// instance is its own answer. This is transitive monomorphization, and the
// table is its worklist.
func:fninst_concrete = FnInstance(ExprEmitter->:x, FnInstance:e, ExprId:call) never fails {
    if (x.fe.ctx.subst_params_count == 0i32) { pass e; }
    bool:shaped = false;
    int32:i = 0i32;
    while (i < e.args_count) {
        if (raw type_mentions_param(x.fe.ctx.types, x.ast,
                                    raw ast_id_at(x.ast, e.args_start, i),
                                    64i32)) {
            shaped = true;
        }
        i = i + 1i32;
    }
    if (!shaped) { pass e; }

    int32:mark = raw ast_scratch_mark(x.ast);
    i = 0i32;
    while (i < e.args_count) {
        drop ast_scratch_push(x.ast, raw subst_emitted_type(x.fe.ctx,
                                  raw ast_id_at(x.ast, e.args_start, i)));
        i = i + 1i32;
    }
    IdSpan:w = raw ast_scratch_commit(x.ast, mark);
    ExprNode:cn = raw ast_expr(x.ast, call);
    int32:ft = raw type_subst(x.tr, e.type_id,
                                raw subst_emitted_scope(x.fe.ctx), cn.span,
                                raw SUBST_FUEL_LL(), x.fe.ctx.impls);
    drop fninst_record(x.fninsts, x.ast, e.decl, w.start, w.count,
                       e.params_start, e.params_count, e.owner_impl, ft, cn.span);
    // The recorded one — the first with these arguments, which is the one the
    // loop will emit and whose name the call must use.
    int32:k = 0i32;
    while (k < (raw fninst_count(x.fninsts))) {
        FnInstance:r = raw fninst_at(x.fninsts, k);
        if (r.decl == e.decl) {
            if (r.args_count == w.count) {
                bool:same = true;
                int32:j = 0i32;
                while (j < w.count) {
                    if ((raw ast_id_at(x.ast, r.args_start, j))
                            != (raw ast_id_at(x.ast, w.start, j))) {
                        same = false;
                        j = w.count;
                    } else {
                        j = j + 1i32;
                    }
                }
                if (same) { pass r; }
            }
        }
        k = k + 1i32;
    }
    pass e;
};

// `extract<int32>` — the same D-108 spelling `emit_program` gives the definition,
// built here so the call and the definition cannot drift apart.
func:fninst_name_of = int32(ExprEmitter->:x, FnInstance:e) never fails {
    DeclNode:d = raw ast_decl(x.ast, DeclId{ index: e.decl });
    string:m = raw string_concat(
                   raw intern_get(x.interns, raw decl_name(d)), "<");
    int32:i = 0i32;
    while (i < e.args_count) {
        if (i > 0i32) { m = raw string_concat(m, ", "); }
        m = raw string_concat(m,
                raw type_display(x.fe.ctx.types, x.interns,
                    raw ast_id_at(x.ast, e.args_start, i)));
        i = i + 1i32;
    }
    pass (raw intern_add(x.interns, raw string_concat(m, ">")));
};

// BUILDING A `dyn` FROM A CONCRETE VALUE (D-158/D-159, 1.0.5c). The data word
// and one vtable word per bound, in the canonical order the type was interned
// with — so every word's position is a compile-time constant and no runtime
// table is consulted.
//
// THE VALUE IS SPILLED TO A SLOT, because the erased half is a POINTER and a
// value has no address until something gives it one. That the slot is in this
// frame is safe rather than lucky: `carries_pointer` counts a `dyn` as carrying
// one, so the escape analysis already refuses a `dyn` that outlives what it
// points at, the same way it refuses a returned borrow.
pub func:emit_dyn_from = IrVal(ExprEmitter->:x, int32:dyn_ty, IrVal:v,
                               Span:at) never fails {
    LlType:dll = raw ll_type(x.fe.ctx, dyn_ty);
    if (!(raw ll_is_ok(dll))) { pass (raw iv_from_ll_at(x, dll, dyn_ty, at)); }

    // THE CELL IS HEAP, NOT AN ALLOCA (D-183, 1.2.4). The first shape spilled
    // the concrete value to the coercion site's own stack — and a `dyn` is
    // storable everywhere a value is (1.0.6e closed that matrix), so
    // dyn_slots.npk's `choose` RETURNED one and main dispatched through a
    // dead frame; it passed only while nothing scribbled the stack in
    // between. The coercion moves the concrete into a managed cell the `dyn`
    // owns — `type_drops` says TY_DYN is true, so the fat pointer is
    // move-only and its generated drop calls vtable slot 0 on the cell, then
    // frees it. The size is asked of LLVM (null-gep), never computed.
    string:szg = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(szg, " = getelementptr ", v.ll,
                      ", ptr null, i32 1", ""));
    string:szi = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(szi, " = ptrtoint ptr ",
                      raw string_concat(szg, " to i64")));
    string:spill = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(spill,
                      " = call ptr @npk_alloc_managed(i64 ",
                      raw string_concat(szi, ")")));
    drop irw_line(x.fe.w, raw cat5("store ", v.ll, " ", v.ref,
                      raw string_concat(", ptr ", spill)));

    string:cur = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cur, " = insertvalue ", dll.text,
                      " undef, ptr ", raw string_concat(spill, ", 0")));

    int32:n = raw type_dyn_count(x.fe.ctx.types, dyn_ty);
    int32:start = raw type_dyn_start(x.fe.ctx.types, dyn_ty);
    int32:i = 0i32;
    while (i < n) {
        int32:tt = raw ast_id_at(x.ast, start, i);
        // THE SOURCE TYPE IS READ THROUGH THE BINDING (1.0.6e): inside a
        // specialization a `T:x` bound to a `dyn` slot carries `T`, and the
        // table is keyed by what `T` became.
        int32:sym = raw vtmap_find(x.fe.ctx,
                                   raw subst_emitted_param(x.fe.ctx, v.type_id),
                                   tt);
        // NO TABLE IS NOW A DEFECT, NOT A RUNG (1.0.9b). A family impl's table
        // is per instantiation, registered and emitted by the pre-pass in
        // `emit_all` for every family instance a `dyn` coercion recorded — and a
        // coercion is the only way a value reaches this slot, so a missing table
        // means the checker accepted a `dyn` the emitter did not build a table
        // for. That is a broken promise, which fails closed; it was a rung
        // ("enabled by cycle 1.0") until the pre-pass made the case real, and
        // leaving that message would claim a future cycle enables what this one
        // already does.
        if (sym == 0i32) { pass (raw iv_broken(at)); }
        string:nx = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(nx, " = insertvalue ", dll.text,
                          raw cat3(" ", cur, ", ptr "),
                          raw cat3(raw intern_get(x.interns, sym), ", ",
                              raw int_to_string((i + 1i32) => int64))));
        cur = move(nx);
        i = i + 1i32;
    }
    pass (raw iv(move(dll.text), move(cur), dyn_ty));
};

// WIDENING IS A VALUE REBUILD (D-159). `dyn A & B` assigned to `dyn A` copies
// the data word and the RETAINED traits' vtable words into the narrower shape.
// Every position is known at compile time from the canonical bound order, so
// there is no runtime table, no prefix rule and no subview: just N+1 extracts
// and inserts, paid once at the widening site and nowhere else.
pub func:emit_dyn_widen = IrVal(ExprEmitter->:x, int32:dst_ty, IrVal:v,
                                Span:at) never fails {
    LlType:dll = raw ll_type(x.fe.ctx, dst_ty);
    if (!(raw ll_is_ok(dll))) { pass (raw iv_from_ll_at(x, dll, dst_ty, at)); }

    string:cur = raw irw_temp(x.fe.w);
    string:dat = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(dat, " = extractvalue ", v.ll, " ",
                      raw string_concat(v.ref, ", 0")));
    drop irw_line(x.fe.w, raw cat5(cur, " = insertvalue ", dll.text,
                      " undef, ptr ", raw string_concat(dat, ", 0")));

    int32:dn = raw type_dyn_count(x.fe.ctx.types, dst_ty);
    int32:ds = raw type_dyn_start(x.fe.ctx.types, dst_ty);
    int32:sn = raw type_dyn_count(x.fe.ctx.types, v.type_id);
    int32:ss = raw type_dyn_start(x.fe.ctx.types, v.type_id);

    int32:i = 0i32;
    while (i < dn) {
        int32:want = raw ast_id_at(x.ast, ds, i);
        // WHICH WORD OF THE SOURCE HOLDS IT. The destination's traits are a
        // subset of the source's — `dyn_accepts` refused the reverse, which
        // would be inventing a vtable that was never built.
        int32:from = 0i32;
        int32:j = 0i32;
        while (j < sn) {
            if ((raw ast_id_at(x.ast, ss, j)) == want) { from = j + 1i32; }
            j = j + 1i32;
        }
        if (from == 0i32) { pass (raw iv_broken(at)); }

        string:w = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(w, " = extractvalue ", v.ll, " ",
                          raw cat3(v.ref, ", ",
                              raw int_to_string(from => int64))));
        string:nx = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(nx, " = insertvalue ", dll.text,
                          raw cat3(" ", cur, ", ptr "),
                          raw cat3(w, ", ",
                              raw int_to_string((i + 1i32) => int64))));
        cur = move(nx);
        i = i + 1i32;
    }
    pass (raw iv(move(dll.text), move(cur), dst_ty));
};

// Where a method sits in a `dyn`: which bound's vtable word holds it, and which
// slot of that table it is.
struct:DynSlot = {
    bool:found;
    int32:word;   // 1-based: word 0 is the data pointer
    int32:slot;   // the method's index among the trait's declared functions
};

// WHICH BOUND DECLARES THIS METHOD, AND AT WHAT INDEX (D-158). The slot IS the
// declaration index — stable, source-derived, hash-free, the same property
// D-156's symbols have and for the same auditing reason.
//
// SEARCHED, NOT RECORDED. A `dyn` names a handful of traits and each declares a
// handful of methods, so this is a walk over single digits; recording it would
// be a third column on `ExprTypes` for a fact that is one comparison away from
// what the emitter already holds.
func:dyn_slot_of = DynSlot(ExprEmitter->:x, int32:dyn_ty, int32:decl) never fails {
    int32:n = raw type_dyn_count(x.fe.ctx.types, dyn_ty);
    int32:start = raw type_dyn_start(x.fe.ctx.types, dyn_ty);
    int32:i = 0i32;
    while (i < n) {
        int32:tt = raw ast_id_at(x.ast, start, i);
        int32:tdecl = raw type_decl_of(x.fe.ctx.types, tt);
        if (tdecl != 0i32) {
            DeclNode:td = raw ast_decl(x.ast, DeclId{ index: tdecl });
            int32:slot = 0i32;
            int32:k = 0i32;
            while (k < (raw item_member_count(x.ast, td))) {
                DeclId:mid = raw item_member(x.ast, td, k);
                DeclNode:tm = raw ast_decl(x.ast, mid);
                if (tm.kind == DeclKind.DeclFunctionDecl) {
                    if (mid.index == decl) {
                        DynSlot:hit = DynSlot{ found: true, word: i + 1i32,
                                               slot: slot };
                        pass hit;
                    }
                    slot = slot + 1i32;
                }
                k = k + 1i32;
            }
        }
        i = i + 1i32;
    }
    DynSlot:miss = DynSlot{ found: false, word: 0i32, slot: 0i32 };
    pass miss;
};

// `x.m(a, b)` — UFCS METHOD LOWERING (1.0.3). One call with the receiver as the
// first argument, which is what UFCS MEANS (D-006): `p.magnitude()` and
// `magnitude(p)` are the same call, so they must emit the same call.
//
// THE CALLEE IS READ, NOT RE-DERIVED. Resolving `m` means asking the impl table,
// then the bound table, then the scope — and the emitter holds none of them. The
// checker recorded which declaration it settled on (`exprtypes_callee`), so this
// reads one slot. That is also D-163's hook: a method call's resolved callee is
// as reachable as a plain call's, which is what the licence will read.
//
// THE RECEIVER IS ADJUSTED to the first parameter's form — a method taking
// `Point->:self` called on a `Point` place takes its address, the same one-level
// adjustment `.` already makes for access (D-098); a by-value parameter takes
// the value.
// Is this method call's operand a trait name — the `Trait.method(…)` form
// (D-172)? The checker accepted it; the emitter tells it from an ordinary
// method call the same way, by the operand's symbol.
func:emit_is_trait_qualified = bool(ExprEmitter->:x, ExprNode:n) never fails {
    ExprId:bid = raw expr_operand(n);
    if (raw expr_is_none(bid)) { pass false; }
    ExprNode:bn = raw ast_expr(x.ast, bid);
    if (bn.kind != ExprKind.ExprIdentifierExpr) { pass false; }
    if (bn.a == 0i32) { pass false; }
    Symbol:s = raw symtab_get(x.tab, bn.a);
    if (s.origin_kind != (raw SYM_DECL())) { pass false; }
    DeclNode:d = raw ast_decl(x.ast, DeclId{ index: s.origin });
    pass (d.kind == DeclKind.DeclTraitDecl);
};

// `Trait.method(recv, …)` lowered as a direct call to the impl's method symbol
// (D-172), the receiver being argument 0 like any other. The symbol and the
// signature were recorded by the checker; this is the named-call shape with
// no `skip`.
func:emit_qualified_call = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:sym = raw exprtypes_callee_sym(x.et, id);
    string:fname = raw intern_get(x.interns, sym);
    string:callsym = raw mangled_fn_sym(x.fe.ctx,
                         raw exprtypes_callee(x.et, id), fname);
    int32:mft = raw exprtypes_callee_ft(x.et, id);
    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        IrVal:av = raw emit_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, i) });
        if (!(raw iv_is_ok(av))) { pass av; }
        av = raw emit_fit(x, raw call_param_want(x, mft, i), move(av), n.span);
        if (!(raw iv_is_ok(av))) { pass av; }
        if (i > 0i32) { args = raw string_concat(args, ", "); }
        args = raw cat3(args, av.ll, raw string_concat(" ", av.ref));
        i = i + 1i32;
    }
    LlType:ret = raw node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret.text, " ",
                      raw cat4(callsym, "(", args, ")")));
    pass (raw iv(move(ret.text), move(r), raw exprtypes_get(x.et, id)));
};

// `s.f(x)` THROUGH A FUNCTION-VALUED FIELD (1.0.9c). Told from a real method the
// same way the checker told it: the receiver's type (one pointer level peeled,
// as `.` always peels, D-098) is a struct with a function-typed field of this
// name. Detected identically on both sides so no new state rides the node.
func:emit_is_field_call = bool(ExprEmitter->:x, ExprNode:n) never fails {
    ExprId:rid = raw expr_operand(n);
    if (raw expr_is_none(rid)) { pass false; }
    int32:rt = raw exprtypes_get(x.et, rid);
    if ((raw type_kind(x.fe.ctx.types, rt)) == (raw TY_POINTER())) {
        rt = raw type_elem(x.fe.ctx.types, rt);
    }
    if ((raw type_kind(x.fe.ctx.types, rt)) != (raw TY_STRUCT())) { pass false; }
    FieldInfo:fi = raw struct_field(x.tr, rt, n.payload =>! int32, x.scope);
    if (!fi.found) { pass false; }
    pass (raw type_is_func(x.fe.ctx.types, fi.type_id));
};

// Load the function-valued field, then call through it — an indirect call whose
// callee is a struct member rather than a plain expression. The field type the
// checker recorded is the coercion authority for the arguments.
func:emit_field_call = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    ExprId:rid = raw expr_operand(n);
    IrVal:rv = raw emit_expr(x, rid);
    if (!(raw iv_is_ok(rv))) { pass rv; }
    IrVal:fv = raw emit_member_from(x, id, n, move(rv), raw exprtypes_get(x.et, rid));
    if (!(raw iv_is_ok(fv))) { pass fv; }

    int32:ift = raw exprtypes_callee_ft(x.et, id);
    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        IrVal:av = raw emit_expr(x, aid);
        if (!(raw iv_is_ok(av))) { pass av; }
        av = raw emit_fit(x, raw call_param_want(x, ift, i), move(av), n.span);
        if (!(raw iv_is_ok(av))) { pass av; }
        if (i > 0i32) { args = raw string_concat(args, ", "); }
        args = raw cat3(args, av.ll, raw string_concat(" ", av.ref));
        i = i + 1i32;
    }
    LlType:ret = raw node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret.text, " ",
                      raw cat5(fv.ref, "(", args, ")", "")));
    pass (raw iv(move(ret.text), move(r), raw exprtypes_get(x.et, id)));
};

func:emit_method_call = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:decl = raw exprtypes_callee(x.et, id);
    if (decl == 0i32) {
        // No method decl, but a call all the same: `s.f(x)` through a
        // function-valued field (1.0.9c). The checker resolves a method first,
        // so reaching here with a field-call means there was no method.
        if (raw emit_is_field_call(x, n)) {
            pass (raw emit_field_call(x, id, n));
        }
        pass (raw iv_broken(n.span));
    }
    DeclId:did = DeclId{ index: decl };
    DeclNode:d = raw ast_decl(x.ast, did);
    if (d.kind != DeclKind.DeclFunctionDecl) { pass (raw iv_broken(n.span)); }
    if ((raw fn_param_count(x.ast, d)) == 0i32) { pass (raw iv_broken(n.span)); }

    // `Trait.method(recv, …)` — a DIRECT CALL, receiver as argument 0 (D-172).
    // The operand is a trait name, not a value, so it is not emitted as a
    // receiver; the checker recorded the impl's symbol and every argument
    // (including the receiver) is a plain call argument.
    if (raw emit_is_trait_qualified(x, n)) {
        pass (raw emit_qualified_call(x, id, n));
    }

    // THE RECEIVER'S OWN TYPE DECIDES THE FORM, not the parameter's annotation
    // (1.0.4). Resolving the parameter would resolve `Self` for a trait
    // DEFAULT's signature — and `Self` has no binding at emit time, so it
    // reported "valid only inside a trait or impl body" about a method the
    // checker had already accepted. The checker has done the matching; what is
    // left is how to pass the value, and the receiver's recorded type answers
    // that directly: a pointer is passed, anything else is passed by value.


    ExprId:rid = raw expr_operand(n);
    IrVal:rv = raw emit_expr(x, rid);
    if (!(raw iv_is_ok(rv))) { pass rv; }

    // DISPATCH THROUGH THE VTABLE WHEN THE RECEIVER IS ERASED (D-158, 1.0.5c).
    // The data word is the receiver the thunk will load; the trait's word holds
    // the table, and the method's declaration index is its slot. Both positions
    // are compile-time constants — that is what D-159's canonical bound order
    // buys, and why no runtime table is consulted.
    bool:via_dyn = ((raw type_kind(x.fe.ctx.types, rv.type_id))
                        == (raw TY_DYN()));
    string:dyn_fn = "";
    string:args = "";
    if (via_dyn) {
        DynSlot:ds = raw dyn_slot_of(x, rv.type_id, decl);
        if (!ds.found) { pass (raw iv_broken(n.span)); }
        string:dat = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(dat, " = extractvalue ", rv.ll, " ",
                          raw string_concat(rv.ref, ", 0")));
        string:vt = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(vt, " = extractvalue ", rv.ll, " ",
                          raw cat3(rv.ref, ", ",
                              raw int_to_string(ds.word => int64))));
        string:sp = raw irw_temp(x.fe.w);
        // +1: TABLE slot 0 is the concrete type's drop (D-183, 1.2.4); the
        // methods follow at declaration index + 1. `DynSlot.slot` stays the
        // declaration index — D-158's meaning — and the shift lives here, at
        // the one place an index becomes a table offset.
        drop irw_line(x.fe.w, raw cat5(sp, " = getelementptr ptr, ptr ", vt,
                          ", i64 ", raw int_to_string((ds.slot + 1i32) => int64)));
        dyn_fn = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(dyn_fn, " = load ptr, ptr ", sp));
        args = raw string_concat("ptr ", dat);
    } else {
        int32:p0w = raw call_param_want(x, raw exprtypes_callee_ft(x.et, id), 0i32);
        // A POINTER RECEIVER IS PASSED BY ADDRESS (1.0.9b): a method
        // `set = NIL(Box<T>->:self, …)` called `b.set(x)` takes `@b`, the dual
        // of the auto-dereference a value receiver gets. The receiver must be a
        // place — a temporary has no address, which the checker's mutation
        // rules already require anyway.
        bool:want_ptr = false;
        if (p0w != 0i32) {
            int32:p0k = raw type_kind(x.fe.ctx.types,
                            raw subst_emitted_param(x.fe.ctx, p0w));
            if (p0k == (raw TY_POINTER())) {
                if ((raw type_kind(x.fe.ctx.types, rv.type_id)) != (raw TY_POINTER())) {
                    want_ptr = true;
                }
            }
        }
        if (want_ptr) {
            PlaceVal:rp = raw addr_of(x, rid);
            if (rp.state != (raw LL_OK())) { pass (raw iv_from_place(move(rp))); }
            args = raw string_concat("ptr ", rp.addr);
        } else {
            // THE RECEIVER IS FIT TO PARAMETER 0 (1.0.8) — a UFCS call on a free
            // function whose first parameter is a `T?` or a `dyn` takes the same
            // wrap or widening `f(p)` would. Not on the erased path above: there
            // the receiver IS the `dyn`, and the thunk loads the concrete value.
            rv = raw emit_fit(x, p0w, move(rv), n.span);
            if (!(raw iv_is_ok(rv))) { pass rv; }
            args = raw cat3(rv.ll, " ", rv.ref);
        }
    }

    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);
    // THE RECEIVER FILLED PARAMETER 0, so argument `i` is fit to parameter
    // `i + 1` (1.0.6e) — the same `skip` the checker's `check_args` applies.
    int32:mft = raw exprtypes_callee_ft(x.et, id);
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        IrVal:av = raw emit_expr(x, aid);
        if (!(raw iv_is_ok(av))) { pass av; }
        av = raw emit_fit(x, raw call_param_want(x, mft, i + 1i32), move(av), n.span);
        if (!(raw iv_is_ok(av))) { pass av; }
        args = raw string_concat(args, ", ");
        args = raw cat3(args, av.ll, raw string_concat(" ", av.ref));
        i = i + 1i32;
    }

    // THE SYMBOL IS READ, NOT REBUILT (1.0.5b). A method's symbol carries its
    // impl (D-156 amended), and the receiver type and owning trait that name
    // needs live in the checker's tables, not here — so the checker interned the
    // name and this reads it, the same slot-not-lookup rule `exprtypes_callee`
    // is built on. 0 means a free function reached through UFCS, which keeps its
    // own name.
    string:fname = raw intern_get(x.interns, raw decl_name(d));
    int32:msym = raw exprtypes_callee_sym(x.et, id);
    if (msym != 0i32) { fname = raw intern_get(x.interns, msym); }

    // A `Self` RECEIVER MEANS THE IMPL BEING EMITTED. Inside a trait default,
    // `self.size()` was typed with `Self` opaque, so nothing was recorded — and
    // the default is emitted once per implementing impl, each needing its own
    // impl's `size`. `tr.self_type` is bound to that impl's target here, which
    // is what turns one typed body into the right call in each copy.
    if (msym == 0i32) {
        int32:rty = raw exprtypes_get(x.et, rid);
        if ((raw type_kind(x.fe.ctx.types, rty)) == (raw TY_SELF())) {
            if (x.tr.self_type != 0i32) {
                fname = raw method_symbol_name(x.fe.ctx.types, x.interns,
                            x.tr.self_type, x.cur_trait, fname);
            }
        }

        // A CALL THROUGH A BOUND NAMES THE SPECIALIZATION'S IMPL (1.0.6b).
        // `func:twice<P: Producer>` calling `p.make()` records no symbol,
        // because at check time the receiver is the PARAMETER `P` — there is no
        // impl yet. Here there is: `P` has been substituted, and the trait the
        // method came through was recorded, so the two combine into the name the
        // impl was emitted under.
        //
        // BROKEN SINCE 1.0.5b AND CAUGHT AT 1.0.6b. Before the symbols carried
        // their impl, both ends said `@npk.m.make` and matched by accident;
        // afterwards the definition moved and this call site did not, so every
        // call through a bound emitted a reference to a symbol that no longer
        // existed. No test called a method through a generic parameter's bound,
        // so the suite stayed green over a program `llc` refuses.
        //
        // AND A RECEIVER THAT MENTIONS THE PARAMETER ANYWHERE (1.0.7): `P`
        // itself, or `Box<P>` — a concrete instance of a family whose argument
        // is the parameter, whose recorded symbol would still spell `Box<P>`.
        // Both read through the binding. When the impl that answers is a FAMILY
        // impl, the instance it needs is recorded here — the checker saw `P`
        // and could not — and the instance loop, which re-reads the table,
        // emits it after this body (transitive monomorphization, as for a
        // generic free function).
        if (raw type_mentions_param(x.fe.ctx.types, x.ast, rty, 64i32)) {
            int32:conc = raw subst_emitted_type(x.fe.ctx, rty);
            if (conc != rty) {
                int32:btrait = raw exprtypes_callee_trait(x.et, id);
                fname = raw method_symbol_name(x.fe.ctx.types, x.interns,
                            conc, btrait, fname);
                drop note_family_instance(x, conc, btrait, raw decl_name(d), n.span);
            }
        }
    }
    string:sym = raw mangled_fn_sym(x.fe.ctx, decl, fname);
    // An erased call names the LOADED slot rather than a symbol: behind the
    // vtable there is no one definition to name, which is the whole point.
    if (via_dyn) { sym = move(dyn_fn); }
    LlType:ret = raw node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (raw iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = call ", ret.text, " ",
                      raw cat4(sym, "(", args, ")")));
    int32:rt_id = raw exprtypes_get(x.et, id);
    IrVal:out = raw iv(move(ret.text), move(r), rt_id);
    out.wrapped = true;
    out.inner = "";
    int32:inner_id = raw type_elem(x.fe.ctx.types, rt_id);
    if ((raw type_kind(x.fe.ctx.types, inner_id)) != (raw TY_NIL())) {
        LlType:il = raw ll_type(x.fe.ctx, inner_id);
        if (raw ll_is_ok(il)) { out.inner = move(il.text); }
    }
    pass out;
};

// A CALL THAT LANDS ON A FAMILY IMPL AT A CONCRETE RECEIVER RECORDS THE
// INSTANCE IT NEEDS (1.0.7). `impl:<T>:List<T>:Sized` is a template; its
// `size` for `List<int32>` is one body per instantiation, recorded in the
// same table a generic function's specializations are (1.0.4b). The checker
// records it when the receiver is concrete at check time; through a bound, or
// through a receiver that mentions the enclosing parameter, the receiver is
// concrete only HERE. Bound positionally from the receiver's own arguments,
// exactly as `bind_blanket` binds them on the checking side. Nothing is
// recorded for a per-instance impl (its block emits its methods) or when no
// family impl answers (the checker already accepted the call, so one does).
func:note_family_instance = NIL(ExprEmitter->:x, int32:conc, int32:trait_ty,
                                int32:name, Span:at) never fails {
    if (x.fe.ctx.impls == NULL) { pass NIL; }
    wild ImplTable->:t = x.fe.ctx.impls;
    int32:cdecl = raw type_decl_of(x.fe.ctx.types, conc);
    if (cdecl == 0i32) { pass NIL; }
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = raw impl_at(t, i);
        if (!e.blanket) {
            if (e.trait_id == trait_ty) {
                if (e.target == conc) { pass NIL; }    // per-instance: its block emits it
                if (e.target != 0i32) {
                    DeclNode:idn = raw ast_decl(x.ast, DeclId{ index: e.decl });
                    if ((raw impl_generic_count(x.ast, idn)) > 0i32) {
                        if ((raw type_decl_of(x.fe.ctx.types, e.target)) == cdecl) {
                            int32:mdecl = raw impl_method_named(x.ast, x.interns,
                                              e.decl, name);
                            if (mdecl == 0i32) {
                                mdecl = raw trait_default_named(x.ast, x.interns,
                                            x.fe.ctx.types, trait_ty, name);
                            }
                            if (mdecl == 0i32) { pass NIL; }
                            IdSpan:pw = raw decl_generic_window(x.ast, idn);
                            int32:mark = raw ast_scratch_mark(x.ast);
                            int32:rargs = raw type_args_start_of(x.fe.ctx.types, conc);
                            int32:rn = raw type_args_count_of(x.fe.ctx.types, conc);
                            int32:k = 0i32;
                            while (k < rn) {
                                drop ast_scratch_push(x.ast,
                                    raw ast_id_at(x.ast, rargs, k));
                                k = k + 1i32;
                            }
                            IdSpan:aw = raw ast_scratch_commit(x.ast, mark);
                            drop fninst_record(x.fninsts, x.ast, mdecl, aw.start,
                                               aw.count, pw.start, pw.count,
                                               e.decl, 0i32, at);
                            pass NIL;
                        }
                    }
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

pub func:iv_from_place = IrVal(move PlaceVal:p) never fails {
    if (p.state == (raw LL_RUNG())) { pass (raw iv_rung(move(p.what), move(p.rung), p.at)); }
    pass (raw iv_broken(p.at));
};

func:pv_from_iv = PlaceVal(move IrVal:v) never fails {
    if (v.state == (raw LL_RUNG())) { pass (raw pv_rung(move(v.what), move(v.rung), v.at)); }
    pass (raw pv_broken(v.at));
};

// The field index inside a builtin aggregate, or -1. One table for the three
// `{…}`-shaped builtins, because `.ptr` meaning slot 0 is a fact about all of
// them and stating it three times is two chances to drift.
func:builtin_field_index = int32(ExprEmitter->:x, int32:kind, int32:name) never fails {
    string:f = raw intern_get(x.interns, name);
    if (raw string_eq(f, "ptr")) { pass 0i32; }
    if (raw string_eq(f, "len")) { pass 1i32; }
    if (kind == (raw TY_STRING())) {
        if (raw string_eq(f, "cap")) { pass 2i32; }
    }
    pass (0i32 - 1i32);
};

// The address of a place expression: a name, a field, an element, or a pointee.
pub func:addr_of = PlaceVal(ExprEmitter->:x, ExprId:id) never fails {
    ExprNode:n = raw ast_expr(x.ast, id);

    if (n.kind == ExprKind.ExprIdentifierExpr) {
        int32:si = raw fnem_lookup_idx(x.fe, n.payload =>! int32);
        if (si < 0i32) {
            // A MODULE-LEVEL BINDING'S PLACE IS ITS GLOBAL (D-165, 1.0.9d): the
            // address is the D-156 symbol itself, so a global struct's field and
            // a global array's element are read (and a mutable global written)
            // through the same GEP path a local's are.
            if (n.a != 0i32) {
                Symbol:gsym = raw symtab_get(x.tab, n.a);
                if (gsym.origin_kind == (raw SYM_DECL())) {
                    DeclNode:gd = raw ast_decl(x.ast,
                                      DeclId{ index: gsym.origin });
                    if (gd.kind == DeclKind.DeclGlobalDecl) {
                        string:gs = raw mangled_fn_sym(x.fe.ctx, gsym.origin,
                                        raw intern_get(x.interns, gsym.name));
                        pass (raw pv(move(gs), raw exprtypes_get(x.et, id)));
                    }
                }
            }
            // The checker refuses an unknown name, so anything else here is a
            // defect, not a rung.
            pass (raw pv_broken(n.span));
        }
        pass (raw pv(raw fnem_local_slot_at(x.fe, si),
                     raw fnem_local_type_at(x.fe, si)));
    }

    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        ExprId:base_id = raw expr_operand(n);
        PlaceVal:base = raw addr_of(x, base_id);
        if (base.state != (raw LL_OK())) { pass base; }
        int32:btid = base.type_id;
        string:baddr = move(base.addr);

        // `.` AUTO-DEREFERENCES (D-006): through a pointer field, the pointee's
        // address is one load away, and the source spells both accesses the
        // same because the intent is the same.
        if ((raw type_kind(x.fe.ctx.types, btid)) == (raw TY_POINTER())) {
            string:loaded = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(loaded, " = load ptr, ptr ", baddr));
            baddr = move(loaded);
            btid = raw type_elem(x.fe.ctx.types, btid);
        }

        int32:bkind = raw type_kind(x.fe.ctx.types, btid);
        LlType:bll = raw ll_type(x.fe.ctx, btid);
        if (!(raw ll_is_ok(bll))) {
            pass (raw pv_rung("a field of an unlowered type", move(bll.rung), n.span));
        }

        int32:idx = 0i32 - 1i32;
        int32:fty = raw exprtypes_get(x.et, id);
        if (bkind == (raw TY_STRING()))  { idx = raw builtin_field_index(x, bkind, n.payload =>! int32); }
        if (bkind == (raw TY_CSTRING())) { idx = raw builtin_field_index(x, bkind, n.payload =>! int32); }
        if (bkind == (raw TY_SLICE()))   { idx = raw builtin_field_index(x, bkind, n.payload =>! int32); }
        if (bkind == (raw TY_STRUCT())) {
            FieldInfo:fi = raw struct_field(x.tr, btid, n.payload =>! int32,
                                              x.scope);
            if (!fi.found) { pass (raw pv_broken(n.span)); }
            idx = fi.index;
            fty = fi.type_id;
        }
        if (idx < 0i32) { pass (raw pv_broken(n.span)); }

        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = getelementptr ", bll.text,
                          ", ptr ", raw cat3(baddr, ", i32 0, i32 ",
                              raw int_to_string(idx => int64))));
        pass (raw pv(move(r), fty));
    }

    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:obj_tid = raw exprtypes_get(x.et, raw expr_lhs(n));
        int32:okind = raw type_kind(x.fe.ctx.types, obj_tid);
        int32:elem_tid = raw exprtypes_get(x.et, id);
        LlType:ell = raw ll_type(x.fe.ctx, elem_tid);
        if (!(raw ll_is_ok(ell))) {
            pass (raw pv_rung("an element of an unlowered type", move(ell.rung), n.span));
        }

        // A SLICE'S BOUNDS LIVE ON IT AND ARE CHECKED HERE (0.9.2, D-070):
        // the length rides in the value, the index compares against it
        // unsigned, and out-of-range traps to `failsafe` — where OOB
        // detection COMES FROM, since pointers are thin (D-038) and carry
        // nothing to check.
        if (okind == (raw TY_SLICE())) {
            IrVal:ov = raw emit_expr(x, raw expr_lhs(n));
            if (!(raw iv_is_ok(ov))) { pass (raw pv_from_iv(move(ov))); }
            IrVal:ix = raw emit_expr(x, raw expr_rhs(n));
            if (!(raw iv_is_ok(ix))) { pass (raw pv_from_iv(move(ix))); }
            string:slen = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(slen, " = extractvalue ", ov.ll,
                              " ", raw string_concat(ov.ref, ", 1")));
            string:idx64 = raw index_as_i64(x, ix);
            drop emit_bounds_guard(x, idx64, slen, n.span);
            string:data = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(data, " = extractvalue ", ov.ll,
                              " ", raw string_concat(ov.ref, ", 0")));
            string:r = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(r, " = getelementptr ", ell.text,
                              ", ptr ", raw cat4(data, ", i64 ", idx64, "")));
            pass (raw pv(move(r), elem_tid));
        }
        if (okind == (raw TY_POINTER())) {
            IrVal:ov = raw emit_expr(x, raw expr_lhs(n));
            if (!(raw iv_is_ok(ov))) { pass (raw pv_from_iv(move(ov))); }
            IrVal:ix = raw emit_expr(x, raw expr_rhs(n));
            if (!(raw iv_is_ok(ix))) { pass (raw pv_from_iv(move(ix))); }
            string:r = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(r, " = getelementptr ", ell.text,
                              ", ptr ", raw cat5(ov.ref, ", ", ix.ll, " ", ix.ref)));
            pass (raw pv(move(r), elem_tid));
        }
        if (okind == (raw TY_ARRAY())) {
            // A VALUE type: its elements are reached through ITS address, and
            // `i64 0` steps through the array-of-one that address denotes.
            // The bound is the TYPE'S constant (D-070), and a dynamic index
            // still checks against it at run time (0.9.2) — a static bound
            // does not make the index static.
            PlaceVal:base = raw addr_of(x, raw expr_lhs(n));
            if (base.state != (raw LL_OK())) { pass base; }
            LlType:all = raw ll_type(x.fe.ctx, obj_tid);
            if (!(raw ll_is_ok(all))) { pass (raw pv_broken(n.span)); }
            IrVal:ix = raw emit_expr(x, raw expr_rhs(n));
            if (!(raw iv_is_ok(ix))) { pass (raw pv_from_iv(move(ix))); }
            string:idx64 = raw index_as_i64(x, ix);
            string:bound = raw int_to_string(
                (raw type_array_count(x.fe.ctx.types, obj_tid)) => int64);
            drop emit_bounds_guard(x, idx64, bound, n.span);
            string:r = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(r, " = getelementptr ", all.text,
                              ", ptr ", raw cat4(base.addr, ", i64 0, ",
                                  raw cat3("i64 ", idx64, ""), "")));
            pass (raw pv(move(r), elem_tid));
        }
        pass (raw pv_broken(n.span));
    }

    // `<-p = v` — the place IS the pointer's value.
    if (n.kind == ExprKind.ExprDerefExpr) {
        IrVal:v = raw emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(v))) { pass (raw pv_from_iv(move(v))); }
        pass (raw pv(move(v.ref), raw exprtypes_get(x.et, id)));
    }

    pass (raw pv_broken(n.span));
};

// --- enum variants ----------------------------------------------------------------

pub struct:VariantInfo = {
    bool:found;
    int32:tag;
    int32:payload_count;
    TypeId:payload_ty;    // the FIRST payload's type node; resolve at use
};

// The tag is the DECLARED value where one is given — `Retry = 3i32` lowers to 3,
// not to its position — and the POSITION otherwise, which is the seed's rule
// exactly. The declared value must be an integer literal; the checker said so
// before this runs.
// ONE PAYLOAD OF A MULTI-PAYLOAD VARIANT (1.0.9c): its resolved type and its
// byte offset within the payload area. The payloads are laid out as a struct —
// field `j` at its aligned offset after `j-1` — the same rule `ensure_layout`
// sizes the area by, so construction and binding agree with the layout and with
// each other. `ok` is false for an out-of-range index or a non-enum.
pub struct:PayloadSlot = {
    bool:ok;
    int64:offset;
    int32:type_id;
};

pub func:variant_payload_slot = PayloadSlot(ExprEmitter->:x, int32:enum_tid,
                                            int32:vname, int32:j) never fails {
    PayloadSlot:bad = PayloadSlot{ ok: false, offset: 0i64, type_id: 0i32 };
    if ((raw type_kind(x.fe.ctx.types, enum_tid)) != (raw TY_ENUM())) { pass bad; }
    DeclId:did = DeclId{ index: raw type_decl(x.fe.ctx.types, enum_tid) };
    int32:phome = raw symtab_home_scope(x.tab, did.index, x.scope);
    DeclNode:d = raw ast_decl(x.ast, did);
    int32:i = 0i32;
    while (i < (raw item_member_count(x.ast, d))) {
        DeclNode:m = raw ast_decl(x.ast, raw item_member(x.ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == vname) {
                int32:pc = raw variant_payload_count(m);
                if (j >= pc) { pass bad; }
                int32:pstart = raw variant_payload_start(m);
                int64:off = 0i64;
                int32:k = 0i32;
                while (k <= j) {
                    int32:pt = raw resolve_type(x.tr,
                                   TypeId{ index: raw ast_id_at(x.ast, pstart, k) },
                                   phome);
                    off = raw align_up(off, raw type_align(x.fe.ctx.types, pt));
                    if (k == j) {
                        pass (PayloadSlot{ ok: true, offset: off,
                                          type_id: pt });
                    }
                    off = off + (raw type_size(x.fe.ctx.types, pt));
                    k = k + 1i32;
                }
            }
        }
        i = i + 1i32;
    }
    pass bad;
};

pub func:variant_info = VariantInfo(ExprEmitter->:x, int32:enum_tid, int32:name) never fails {
    VariantInfo:none = VariantInfo{ found: false, tag: 0i32, payload_count: 0i32,
                                    payload_ty: raw type_none() };
    if ((raw type_kind(x.fe.ctx.types, enum_tid)) != (raw TY_ENUM())) { pass none; }
    DeclId:did = DeclId{ index: raw type_decl(x.fe.ctx.types, enum_tid) };
    DeclNode:d = raw ast_decl(x.ast, did);
    int32:i = 0i32;
    while (i < (raw item_member_count(x.ast, d))) {
        DeclNode:m = raw ast_decl(x.ast, raw item_member(x.ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == name) {
                int32:tag = i;
                ExprId:ve = raw variant_value(m);
                if (!(raw expr_is_none(ve))) {
                    ExprNode:vn = raw ast_expr(x.ast, ve);
                    if (vn.kind == ExprKind.ExprIntLiteral) {
                        tag = vn.payload =>! int32;
                    }
                }
                TypeId:pt = raw type_none();
                if ((raw variant_payload_count(m)) > 0i32) {
                    pt = TypeId{ index: raw ast_id_at(x.ast,
                                     raw variant_payload_start(m), 0i32) };
                }
                VariantInfo:v = VariantInfo{ found: true, tag: tag,
                                             payload_count: raw variant_payload_count(m),
                                             payload_ty: pt };
                pass v;
            }
        }
        i = i + 1i32;
    }
    pass none;
};

// Is this member access `Enum.Variant`? The base must be an identifier whose
// symbol is an enum DECLARATION — a value of enum type takes the other path.
func:member_enum_decl = int32(ExprEmitter->:x, ExprNode:n) never fails {
    ExprId:b = raw expr_operand(n);
    if (raw expr_is_none(b)) { pass 0i32; }
    ExprNode:bnode = raw ast_expr(x.ast, b);
    if (bnode.kind != ExprKind.ExprIdentifierExpr) { pass 0i32; }
    if (bnode.a == 0i32) { pass 0i32; }
    Symbol:sym = raw symtab_get(x.tab, bnode.a);
    if (sym.origin_kind != (raw SYM_DECL())) { pass 0i32; }
    DeclId:did = DeclId{ index: sym.origin };
    DeclNode:d = raw ast_decl(x.ast, did);
    if (d.kind != DeclKind.DeclEnumDecl) { pass 0i32; }
    pass sym.origin;
};

// A payload-less variant as a value: the tag, in whichever shape the ENUM takes —
// a plain `i32` when no variant anywhere carries a payload, a `{tag, 0}` pair
// when one does, because the TYPE has one layout however this variant travels.
func:emit_variant_ref = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:etid = raw exprtypes_get(x.et, id);
    VariantInfo:vi = raw variant_info(x, etid, n.payload =>! int32);
    if (!vi.found) { pass (raw iv_broken(n.span)); }
    string:tag = raw int_to_string(vi.tag => int64);
    if (!(raw enum_has_payload(x.ast, x.fe.ctx.types, etid))) {
        pass (raw iv("i32", move(tag), etid));
    }
    LlType:ell = raw ll_type(x.fe.ctx, etid);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, etid, n.span)); }
    // OVER zeroinitializer, not undef, and only the tag is inserted: the
    // payload slot is `[N x iK]` (0.9.2) and writing "i64 0" into it stopped
    // being well-typed the day payloads outgrew one word. Zeroed payload bytes
    // also keep a payload-less variant deterministic wherever it travels.
    string:a = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(a, " = insertvalue ", ell.text,
                      " zeroinitializer, i32 ", raw string_concat(tag, ", 0")));
    pass (raw iv(move(ell.text), move(a), etid));
};

// `Net.Disconnect(code)` — the payload widens into the uniform `i64` word
// (SUBSET_1 §1.2), whatever its own width; `pick` narrows it back out. Reached
// through TWO parse shapes — a method call, and a call whose callee is a member
// access (`(Ev.Move)(5i32)`) — so the builder takes the name and the argument
// window rather than a node whose shape it would have to know.
func:emit_enum_ctor = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                            ExprNode:cnode) never fails {
    int32:etid = raw exprtypes_get(x.et, id);
    if ((raw type_kind(x.fe.ctx.types, etid)) != (raw TY_ENUM())) {
        // UNREACHABLE. `emit_call` sends a function-valued member to
        // `emit_indirect_call`; this path is a checker-confirmed enum ctor.
        pass (raw iv_broken(n.span));
    }
    int32:gcount = raw expr_generic_count(n);
    pass (raw emit_ctor(x, id, n.span, etid, cnode.payload =>! int32,
              (raw expr_list_start(n)) + gcount,
              (raw expr_list_count(n)) - gcount));
};

func:emit_ctor = IrVal(ExprEmitter->:x, ExprId:id, Span:at, int32:etid,
                       int32:vname, int32:start, int32:count) never fails {
    if ((raw type_kind(x.fe.ctx.types, etid)) != (raw TY_ENUM())) {
        // UNREACHABLE, as in `emit_enum_ctor`: only a confirmed enum ctor calls in.
        pass (raw iv_broken(at));
    }
    VariantInfo:vi = raw variant_info(x, etid, vname);
    if (!vi.found) { pass (raw iv_broken(at)); }
    LlType:ell = raw ll_type(x.fe.ctx, etid);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, etid, at)); }

    // A payload-less variant spelled with parentheses: the same value its bare
    // reference builds.
    if (!(raw enum_has_payload(x.ast, x.fe.ctx.types, etid))) {
        pass (raw iv("i32", raw int_to_string(vi.tag => int64), etid));
    }

    // THE GENERAL CONSTRUCTION (0.9.2): through a stack slot, because the
    // payload slot is `[N x iK]` and the payload is stored AS ITS OWN TYPE
    // through a typed pointer — insertvalue cannot write a `{ptr,i64,i64}`
    // into an i64 array, and the widen-to-one-word shape it replaces emitted
    // invalid IR for any aggregate payload. Zero first, so a smaller payload
    // leaves no undefined bytes in the slot.
    string:tag = raw int_to_string(vi.tag => int64);
    string:tmp = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, tmp, ell.text);
    drop irw_line(x.fe.w, raw cat5("store ", ell.text, " zeroinitializer, ptr ",
                      tmp, ""));
    string:tp = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(tp, " = getelementptr ", ell.text,
                      ", ptr ", raw string_concat(tmp, ", i32 0, i32 0")));
    drop irw_line(x.fe.w, raw cat5("store i32 ", tag, ", ptr ", tp, ""));
    if (count == 1i32) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, 0i32) };
        IrVal:av = raw emit_expr(x, aid);
        if (!(raw iv_is_ok(av))) { pass av; }
        // THE PAYLOAD IS A SLOT (1.0.6e), of the variant's declared payload type
        // — resolved in the ENUM's home scope, as `check_ctor_args` resolved it.
        int32:phome = raw symtab_home_scope(x.tab, raw type_decl(x.fe.ctx.types,
                                                                etid), x.scope);
        int32:ptid = raw resolve_type(x.tr, vi.payload_ty, phome);
        av = raw emit_fit(x, ptid, move(av), at);
        if (!(raw iv_is_ok(av))) { pass av; }
        string:pp = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(pp, " = getelementptr ", ell.text,
                          ", ptr ", raw string_concat(tmp, ", i32 0, i32 1")));
        drop irw_line(x.fe.w, raw cat5("store ", av.ll, " ", av.ref,
                          raw string_concat(", ptr ", pp)));
    }

    // MULTI-PAYLOAD CONSTRUCTION (1.0.9c): each argument stored at its payload's
    // struct offset within the area. Field 1 is the area base; a non-zero offset
    // is an `i8` step from it, so payload 0 writes exactly where the single-
    // payload path does. `variant_payload_slot` computes offset and type the
    // same way the layout sized the area and the binding will read it.
    if (count > 1i32) {
        int32:ci = 0i32;
        while (ci < count) {
            PayloadSlot:pslot = raw variant_payload_slot(x, etid, vname, ci);
            if (!pslot.ok) { pass (raw iv_broken(at)); }
            ExprId:cad = ExprId{ index: raw ast_id_at(x.ast, start, ci) };
            IrVal:cav = raw emit_expr(x, cad);
            if (!(raw iv_is_ok(cav))) { pass cav; }
            cav = raw emit_fit(x, pslot.type_id, move(cav), at);
            if (!(raw iv_is_ok(cav))) { pass cav; }
            LlType:cpll = raw ll_type(x.fe.ctx, pslot.type_id);
            if (!(raw ll_is_ok(cpll))) {
                pass (raw iv_from_ll_at(x, cpll, pslot.type_id, at));
            }
            string:cbase = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(cbase, " = getelementptr ", ell.text,
                              ", ptr ", raw string_concat(tmp, ", i32 0, i32 1")));
            string:cpp = raw string_concat(cbase, "");
            if (pslot.offset != 0i64) {
                string:cpp2 = raw irw_temp(x.fe.w);
                drop irw_line(x.fe.w, raw cat5(cpp2, " = getelementptr i8, ptr ",
                                  cbase, ", i64 ", raw int_to_string(pslot.offset)));
                cpp = move(cpp2);
            }
            drop irw_line(x.fe.w, raw cat5("store ", cav.ll, " ", cav.ref,
                              raw string_concat(", ptr ", cpp)));
            ci = ci + 1i32;
        }
    }

    string:whole = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(whole, " = load ", ell.text, ", ptr ",
                      raw string_concat(tmp, "")));
    pass (raw iv(move(ell.text), move(whole), etid));
};

// --- member and index reads --------------------------------------------------------

// A field READ goes through the VALUE — extractvalue — not through an address.
// One shape for every base, including one that has no address at all
// (`(raw f()).len`); the whole-aggregate load a pointer base implies is what
// naive lowering means, and `opt` scalarises it.
// `a ?? d` (D-099, 1.0.7): the value, or the default — LAZY, so the default
// only evaluates on the empty path, the shape `?` on a `Result` has (0.9.7)
// with the tag in place of the error word. The default meets the inner type
// through `emit_fit`, since the checker typed it with `fits(inner, d)`.
func:emit_coalesce = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    IrVal:cv = raw emit_expr(x, raw expr_lhs(n));
    if (!(raw iv_is_ok(cv))) { pass cv; }
    int32:ctid = raw exprtypes_get(x.et, id);
    LlType:cll = raw ll_type(x.fe.ctx, ctid);
    if (!(raw ll_is_ok(cll))) { pass (raw iv_from_ll_at(x, cll, ctid, n.span)); }
    string:cslot = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, cslot, cll.text);
    string:ctag = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(ctag, " = extractvalue ", cv.ll, " ",
                      raw string_concat(cv.ref, ", 0")));
    string:cempty = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(cempty, " = icmp eq i8 ",
                      raw string_concat(ctag, ", 0")));
    string:cd_l = raw irw_new_label(x.fe.w, "nc.def");
    string:co_l = raw irw_new_label(x.fe.w, "nc.some");
    string:cj_l = raw irw_new_label(x.fe.w, "nc.done");
    drop irw_line(x.fe.w, raw cat5("br i1 ", cempty, ", label %", cd_l,
                      raw string_concat(", label %", co_l)));
    drop irw_label(x.fe.w, co_l);
    string:cin = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cin, " = extractvalue ", cv.ll, " ",
                      raw string_concat(cv.ref, ", 1")));
    drop irw_line(x.fe.w, raw cat5("store ", cll.text, " ", cin,
                      raw string_concat(", ptr ", cslot)));
    drop irw_line(x.fe.w, raw cat3("br label %", cj_l, ""));
    drop irw_label(x.fe.w, cd_l);
    IrVal:cdv = raw emit_expr(x, raw expr_rhs(n));
    if (!(raw iv_is_ok(cdv))) { pass cdv; }
    // THE DEFAULT IS A SLOT, of the inner type (D-099's list names it).
    cdv = raw emit_fit(x, ctid, move(cdv), n.span);
    if (!(raw iv_is_ok(cdv))) { pass cdv; }
    drop irw_line(x.fe.w, raw cat5("store ", cdv.ll, " ", cdv.ref,
                      raw string_concat(", ptr ", cslot)));
    drop irw_line(x.fe.w, raw cat3("br label %", cj_l, ""));
    drop irw_label(x.fe.w, cj_l);
    string:cout = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cout, " = load ", cll.text, ", ptr ",
                      raw string_concat(cslot, "")));
    pass (raw iv(move(cll.text), move(cout), ctid));
};

// `a?.f` (D-099, 1.0.7): the field, still wrapped — the absence survives the
// access. Empty yields `zeroinitializer` of the RESULT type; present extracts
// the value, reads the field through the same path `.` uses, and wraps it —
// unless the field is itself an `Optional`, in which case the checker already
// flattened the type (TYPE_REFERENCE §11.1) and the field is stored as it is.
func:emit_safe_nav = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    ExprId:base_id = raw expr_operand(n);
    IrVal:bv = raw emit_expr(x, base_id);
    if (!(raw iv_is_ok(bv))) { pass bv; }
    int32:otid = raw exprtypes_get(x.et, base_id);
    if ((raw type_kind(x.fe.ctx.types, otid)) != (raw TY_OPTIONAL())) {
        pass (raw iv_broken(n.span));
    }
    int32:inner_tid = raw type_elem(x.fe.ctx.types, otid);
    LlType:ill = raw ll_type(x.fe.ctx, inner_tid);
    if (!(raw ll_is_ok(ill))) { pass (raw iv_from_ll_at(x, ill, inner_tid, n.span)); }
    int32:rtid = raw exprtypes_get(x.et, id);
    LlType:rll = raw ll_type(x.fe.ctx, rtid);
    if (!(raw ll_is_ok(rll))) { pass (raw iv_from_ll_at(x, rll, rtid, n.span)); }

    string:sslot = raw irw_temp(x.fe.w);
    drop irw_alloca(x.fe.w, sslot, rll.text);
    string:stag = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(stag, " = extractvalue ", bv.ll, " ",
                      raw string_concat(bv.ref, ", 0")));
    string:sempty = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(sempty, " = icmp eq i8 ",
                      raw string_concat(stag, ", 0")));
    string:sn_l = raw irw_new_label(x.fe.w, "sn.none");
    string:ss_l = raw irw_new_label(x.fe.w, "sn.some");
    string:sj_l = raw irw_new_label(x.fe.w, "sn.done");
    drop irw_line(x.fe.w, raw cat5("br i1 ", sempty, ", label %", sn_l,
                      raw string_concat(", label %", ss_l)));
    drop irw_label(x.fe.w, sn_l);
    drop irw_line(x.fe.w, raw cat5("store ", rll.text, " zeroinitializer, ptr ",
                      sslot, ""));
    drop irw_line(x.fe.w, raw cat3("br label %", sj_l, ""));
    drop irw_label(x.fe.w, ss_l);
    string:sin = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(sin, " = extractvalue ", bv.ll, " ",
                      raw string_concat(bv.ref, ", 1")));
    IrVal:fv = raw emit_member_from(x, id, n, raw iv(move(ill.text), move(sin), inner_tid),
                                      inner_tid);
    if (!(raw iv_is_ok(fv))) { pass fv; }
    // NOT WRAPPED TWICE: a field that is itself an `Optional` IS the result.
    if ((raw type_kind(x.fe.ctx.types, fv.type_id)) != (raw TY_OPTIONAL())) {
        fv = raw emit_opt_wrap(x, rtid, fv, n.span);
        if (!(raw iv_is_ok(fv))) { pass fv; }
    }
    drop irw_line(x.fe.w, raw cat5("store ", fv.ll, " ", fv.ref,
                      raw string_concat(", ptr ", sslot)));
    drop irw_line(x.fe.w, raw cat3("br label %", sj_l, ""));
    drop irw_label(x.fe.w, sj_l);
    string:sout = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(sout, " = load ", rll.text, ", ptr ",
                      raw string_concat(sslot, "")));
    pass (raw iv(move(rll.text), move(sout), rtid));
};

func:emit_member = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    if ((raw member_enum_decl(x, n)) != 0i32) {
        pass (raw emit_variant_ref(x, id, n));
    }

    ExprId:base_id = raw expr_operand(n);
    IrVal:bv0 = raw emit_expr(x, base_id);
    if (!(raw iv_is_ok(bv0))) { pass bv0; }
    pass (raw emit_member_from(x, id, n, move(bv0), raw exprtypes_get(x.et, base_id)));
};

// THE READ, GIVEN THE BASE VALUE (split out at 1.0.7 so `?.` can hand in the
// value it unwrapped). The result is typed as the FIELD's own type for a
// struct field, and as the node's recorded type for a builtin member — the
// same answers `emit_member` always gave.
func:emit_member_from = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                              move IrVal:bv_in, int32:btid_in) never fails {
    IrVal:bv = move(bv_in);
    int32:btid = btid_in;

    if ((raw type_kind(x.fe.ctx.types, btid)) == (raw TY_POINTER())) {
        btid = raw type_elem(x.fe.ctx.types, btid);
        LlType:pl = raw ll_type(x.fe.ctx, btid);
        if (!(raw ll_is_ok(pl))) { pass (raw iv_from_ll_at(x, pl, btid, n.span)); }
        string:loaded = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(loaded, " = load ", pl.text, ", ptr ",
                                         bv.ref));
        bv = raw iv(move(pl.text), move(loaded), btid);
    }

    int32:bkind = raw type_kind(x.fe.ctx.types, btid);
    int32:idx = 0i32 - 1i32;
    int32:fty = raw exprtypes_get(x.et, id);
    string:fll = "";
    if (bkind == (raw TY_STRING())) {
        idx = raw builtin_field_index(x, bkind, n.payload =>! int32);
        fll = "i64";
        if (idx == 0i32) { fll = "ptr"; }
    }
    if (bkind == (raw TY_CSTRING())) {
        idx = raw builtin_field_index(x, bkind, n.payload =>! int32);
        fll = "i64";
        if (idx == 0i32) { fll = "ptr"; }
    }
    if (bkind == (raw TY_SLICE())) {
        idx = raw builtin_field_index(x, bkind, n.payload =>! int32);
        fll = "i64";
        if (idx == 0i32) { fll = "ptr"; }
    }
    // A `Result`'s three members (D-069): `value` is slot 0, `error` slot 1, and
    // `.is_error` is DERIVED as `error != 0` — no stored flag, so there is no
    // second place for the fact to live, and no way for the two to disagree.
    if (bkind == (raw TY_RESULT())) {
        string:f = raw intern_get(x.interns, n.payload =>! int32);
        int32:inner = raw type_elem(x.fe.ctx.types, btid);
        bool:inner_nil = ((raw type_kind(x.fe.ctx.types, inner)) == (raw TY_NIL()));
        if (raw string_eq(f, "value")) {
            if (inner_nil) { pass (raw iv("i32", "0", fty)); }
            LlType:il = raw ll_type(x.fe.ctx, inner);
            if (!(raw ll_is_ok(il))) { pass (raw iv_from_ll_at(x, il, inner, n.span)); }
            string:rv = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat5(rv, " = extractvalue ", bv.ll, " ",
                              raw string_concat(bv.ref, ", 0")));
            pass (raw iv(move(il.text), move(rv), fty));
        }
        string:eidx = ", 1";
        if (inner_nil) { eidx = ", 0"; }
        string:re = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(re, " = extractvalue ", bv.ll, " ",
                          raw string_concat(bv.ref, eidx)));
        if (raw string_eq(f, "err")) { pass (raw iv("i32", move(re), fty)); }
        if (raw string_eq(f, "is_error")) {
            string:cz = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(cz, " = icmp ne i32 ",
                              raw string_concat(re, ", 0")));
            string:z = raw irw_temp(x.fe.w);
            drop irw_line(x.fe.w, raw cat3(z, " = zext i1 ",
                              raw string_concat(cz, " to i8")));
            pass (raw iv("i8", move(z), fty));
        }
        pass (raw iv_broken(n.span));
    }
    if (bkind == (raw TY_STRUCT())) {
        FieldInfo:fi = raw struct_field(x.tr, btid, n.payload =>! int32, x.scope);
        if (!fi.found) { pass (raw iv_broken(n.span)); }
        idx = fi.index;
        fty = fi.type_id;
        LlType:fl = raw ll_type(x.fe.ctx, fi.type_id);
        if (!(raw ll_is_ok(fl))) {
            pass (raw iv_from_ll_at(x, fl, fi.type_id, n.span));
        }
        fll = move(fl.text);
    }
    if (idx < 0i32) { pass (raw iv_broken(n.span)); }

    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = extractvalue ", bv.ll, " ",
                      raw cat3(bv.ref, ", ", raw int_to_string(idx => int64))));
    pass (raw iv(move(fll), move(r), fty));
};

// An INDEX read is its place plus a load — an element's address exists by
// construction, and a dynamic index into an aggregate VALUE does not. A RANGE
// index is different in kind: `arr[lo...hi]` yields a VALUE, the `{ptr, len}`
// view D-070 describes, and takes the seed's shape exactly — element pointer
// moved to `lo`, length `hi - lo`.
func:emit_index = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    ExprNode:ix = raw ast_expr(x.ast, raw expr_rhs(n));
    if (ix.kind == ExprKind.ExprRangeExpr) {
        pass (raw emit_range_slice(x, id, n, ix));
    }
    PlaceVal:p = raw addr_of(x, id);
    if (p.state != (raw LL_OK())) { pass (raw iv_from_place(move(p))); }
    LlType:ell = raw ll_type(x.fe.ctx, p.type_id);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, p.type_id, n.span)); }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = load ", ell.text, ", ptr ", p.addr));
    pass (raw iv(move(ell.text), move(r), p.type_id));
};

func:emit_range_slice = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                              ExprNode:ix) never fails {
    int32:obj_tid = raw exprtypes_get(x.et, raw expr_lhs(n));
    int32:okind = raw type_kind(x.fe.ctx.types, obj_tid);
    int32:elem_tid = raw type_elem(x.fe.ctx.types, obj_tid);
    LlType:ell = raw ll_type(x.fe.ctx, elem_tid);
    if (!(raw ll_is_ok(ell))) {
        pass (raw iv_from_ll_at(x, ell, elem_tid, n.span));
    }

    // The data pointer: an array's is its own address, a slice's is its first
    // field. Anything else cannot be ranged and the checker said so already.
    string:base = "";
    string:src_len = "";
    if (okind == (raw TY_ARRAY())) {
        PlaceVal:p = raw addr_of(x, raw expr_lhs(n));
        if (p.state != (raw LL_OK())) { pass (raw iv_from_place(move(p))); }
        base = move(p.addr);
        src_len = raw int_to_string(
            (raw type_array_count(x.fe.ctx.types, obj_tid)) => int64);
    }
    if (okind == (raw TY_SLICE())) {
        IrVal:ov = raw emit_expr(x, raw expr_lhs(n));
        if (!(raw iv_is_ok(ov))) { pass ov; }
        string:d = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(d, " = extractvalue ", ov.ll, " ",
                          raw string_concat(ov.ref, ", 0")));
        base = move(d);
        string:sl2 = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(sl2, " = extractvalue ", ov.ll, " ",
                          raw string_concat(ov.ref, ", 1")));
        src_len = move(sl2);
    }
    if (base.len == 0i64) { pass (raw iv_broken(n.span)); }

    IrVal:lo = raw emit_expr(x, raw expr_lhs(ix));
    if (!(raw iv_is_ok(lo))) { pass lo; }
    IrVal:hi = raw emit_expr(x, raw expr_rhs(ix));
    if (!(raw iv_is_ok(hi))) { pass hi; }

    // THE VIEW MUST FIT (0.9.2, D-070): `lo <= hi` and `hi <= len`, both
    // unsigned, or the trap — before this guard a range past the end
    // fabricated a slice into whatever came after, and `hi < lo` wrapped the
    // count to near-2^64. Unchecked, either one is the exact defect the slice
    // type exists to prevent.
    string:lo64 = raw index_as_i64(x, lo);
    string:hi64 = raw index_as_i64(x, hi);
    // `..` IS INCLUSIVE (LEXICAL §5.1) and normalizes to half-open here, the
    // same rule range VALUES get (D-145) — until 0.9.6 both spellings were
    // silently treated as exclusive, so `arr[0..2]` viewed two elements while
    // the language said three.
    if (ix.payload == 1i64) {
        string:hb = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(hb, " = add i64 ",
                          raw string_concat(hi64, ", 1")));
        hi64 = move(hb);
    }
    string:c1 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(c1, " = icmp ule i64 ", lo64, ", ",
                      raw string_concat(hi64, "")));
    string:c2 = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(c2, " = icmp ule i64 ", hi64, ", ",
                      raw string_concat(src_len, "")));
    string:both = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(both, " = and i1 ", c1, ", ", c2));
    string:trap_l = raw irw_new_label(x.fe.w, "rng.oob");
    string:ok_l = raw irw_new_label(x.fe.w, "rng.ok");
    drop irw_line(x.fe.w, raw cat5("br i1 ", both, ", label %", ok_l,
                      raw string_concat(", label %", trap_l)));
    drop irw_label(x.fe.w, trap_l);
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      raw int_to_string((raw x_site(x, n.span)) => int64), ")"));
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4099)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, ok_l);

    string:g = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(g, " = getelementptr ", ell.text,
                      ", ptr ", raw cat4(base, ", i64 ", lo64, "")));
    string:cnt = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(cnt, " = sub i64 ", hi64, ", ", lo64));
    string:a = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat3(a, " = insertvalue { ptr, i64 } undef, ptr ",
                      raw string_concat(g, ", 0")));
    string:b = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(b, " = insertvalue { ptr, i64 } ", a,
                      ", i64 ", raw string_concat(cnt, ", 1")));
    pass (raw iv("{ ptr, i64 }", move(b), raw exprtypes_get(x.et, id)));
};

func:emit_addr_op = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    PlaceVal:p = raw addr_of(x, raw expr_operand(n));
    if (p.state != (raw LL_OK())) { pass (raw iv_from_place(move(p))); }
    pass (raw iv("ptr", move(p.addr), raw exprtypes_get(x.et, id)));
};

func:emit_deref = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    IrVal:v = raw emit_expr(x, raw expr_operand(n));
    if (!(raw iv_is_ok(v))) { pass v; }
    int32:elem = raw exprtypes_get(x.et, id);
    LlType:ell = raw ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass (raw iv_from_ll_at(x, ell, elem, n.span)); }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = load ", ell.text, ", ptr ", v.ref));
    pass (raw iv(move(ell.text), move(r), elem));
};

// --- aggregate literals ------------------------------------------------------------

// `Point{ x: 1i32, y: 2i32 }` — one insertvalue per field, AT THE FIELD'S
// DECLARED INDEX, so the literal's written order never matters to the layout.
// The checker already refused an omitted field; this never re-checks.
// A MODULE-LEVEL BINDING'S INITIALISER, RENDERED AS AN LLVM CONSTANT (D-165,
// 1.0.9d). Returns the constant's VALUE text — the caller writes
// `constant/global <ll> <this>` — or "" when the initialiser is not a
// compile-time constant (which the checker has already refused by name, so ""
// here is a defect). Recurses for struct and array literals; everything the
// folder handles (scalars, strings, arithmetic, `comptime`, a reference to
// another module binding) goes through `fold_const`.
pub func:emit_global_const = string(ExprEmitter->:x, ExprId:eid) never fails {
    ExprNode:n = raw ast_expr(x.ast, eid);
    int32:gcid = raw exprtypes_get(x.et, eid);

    if (n.kind == ExprKind.ExprSentinelLiteral) {
        if (n.payload == 0i64) {
            if ((raw type_kind(x.fe.ctx.types, gcid)) == (raw TY_OPTIONAL())) {
                pass "zeroinitializer";
            }
            pass "0";
        }
        if (n.payload == 1i64) { pass "null"; }
        int32:sb = raw type_int_bits(x.fe.ctx.types, gcid);
        pass (raw tbb_min_decimal(sb));
    }

    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        pass (raw emit_global_struct_const(x, eid, n, gcid));
    }
    if (n.kind == ExprKind.ExprArrayLiteralExpr) {
        pass (raw emit_global_array_const(x, eid, n, gcid));
    }

    ConstVal:cv = raw fold_const(x.tr, eid, x.scope);
    if (!(raw cv_folded(cv))) { pass ""; }
    if (cv.kind == (raw CV_STRING())) {
        string:g = raw strtab_add(x.strs, raw string_concat(cv.text, ""));
        string:ln = raw int_to_string(cv.text.len);
        pass (raw cat5("{ ptr ", g, ", i64 ",
                  raw cat5(ln, ", i64 ", ln, " }", ""), ""));
    }
    pass (raw int_to_string(cv.num));
};

// A struct literal as a constant: every field in DECLARATION order, each
// typed, so `{ i32 5, { ptr, i64, i64 } {…} }` matches the struct's layout.
func:emit_global_struct_const = string(ExprEmitter->:x, ExprId:eid,
                                       ExprNode:n, int32:stid) never fails {
    DeclId:sdid = DeclId{ index: raw type_decl(x.fe.ctx.types, stid) };
    DeclNode:sd = raw ast_decl(x.ast, sdid);
    int32:pairs = (raw expr_list_count(n)) / 2i32;
    string:out = "{ ";
    int32:emitted = 0i32;
    int32:fi = 0i32;
    while (fi < (raw item_member_count(x.ast, sd))) {
        DeclNode:fdecl = raw ast_decl(x.ast, raw item_member(x.ast, sd, fi));
        if (fdecl.kind == DeclKind.DeclFieldDecl) {
            int32:fname = raw decl_name(fdecl);
            // find this field's value in the literal
            ExprId:vid = ExprId{ index: 0i32 };
            bool:found = false;
            int32:pi = 0i32;
            while (pi < pairs) {
                int32:lname = raw ast_id_at(x.ast, raw expr_list_start(n),
                                            pi * 2i32);
                if (lname == fname) {
                    vid = ExprId{ index: raw ast_id_at(x.ast,
                              raw expr_list_start(n), (pi * 2i32) + 1i32) };
                    found = true;
                    pi = pairs;
                } else {
                    pi = pi + 1i32;
                }
            }
            if (!found) { pass ""; }
            FieldInfo:info = raw struct_field(x.tr, stid, fname, x.scope);
            if (!info.found) { pass ""; }
            LlType:fll = raw ll_type(x.fe.ctx, info.type_id);
            if (!(raw ll_is_ok(fll))) { pass ""; }
            string:fc = raw emit_global_const(x, vid);
            if (fc.len == 0i64) { pass ""; }
            if (emitted > 0i32) { out = raw string_concat(out, ", "); }
            out = raw cat3(out, fll.text, raw string_concat(" ", fc));
            emitted = emitted + 1i32;
        }
        fi = fi + 1i32;
    }
    pass (raw string_concat(out, " }"));
};

// An array literal as a constant: every element typed the same, in order.
func:emit_global_array_const = string(ExprEmitter->:x, ExprId:eid,
                                      ExprNode:n, int32:atid) never fails {
    int32:elem = raw type_elem(x.fe.ctx.types, atid);
    LlType:ell = raw ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass ""; }
    int32:count = raw expr_list_count(n);
    string:out = "[ ";
    int32:i = 0i32;
    while (i < count) {
        ExprId:vid = ExprId{ index: raw ast_id_at(x.ast, raw expr_list_start(n), i) };
        string:ec = raw emit_global_const(x, vid);
        if (ec.len == 0i64) { pass ""; }
        if (i > 0i32) { out = raw string_concat(out, ", "); }
        out = raw cat3(out, ell.text, raw string_concat(" ", ec));
        i = i + 1i32;
    }
    pass (raw string_concat(out, " ]"));
};

func:emit_struct_lit = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:stid = raw exprtypes_get(x.et, id);
    LlType:sll = raw ll_type(x.fe.ctx, stid);
    if (!(raw ll_is_ok(sll))) { pass (raw iv_from_ll_at(x, sll, stid, n.span)); }

    string:acc = "undef";
    int32:i = 0i32;
    int32:pairs = (raw expr_list_count(n)) / 2i32;
    while (i < pairs) {
        int32:fname = raw ast_id_at(x.ast, raw expr_list_start(n), i * 2i32);
        ExprId:vid = ExprId{ index: raw ast_id_at(x.ast,
                                 raw expr_list_start(n), (i * 2i32) + 1i32) };
        FieldInfo:fi = raw struct_field(x.tr, stid, fname, x.scope);
        if (!fi.found) { pass (raw iv_broken(n.span)); }
        IrVal:v = raw emit_expr(x, vid);
        if (!(raw iv_is_ok(v))) { pass v; }
        // A FIELD IS A SLOT (1.0.6e): `Holder{ s: d }` with `dyn Speaks:s`.
        v = raw emit_fit(x, fi.type_id, move(v), n.span);
        if (!(raw iv_is_ok(v))) { pass v; }
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = insertvalue ", sll.text, " ",
                          raw cat5(acc, ", ", v.ll, " ",
                              raw cat4(v.ref, ", ",
                                  raw int_to_string(fi.index => int64), ""))));
        acc = move(r);
        i = i + 1i32;
    }
    pass (raw iv(move(sll.text), move(acc), stid));
};

func:emit_array_lit = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:atid = raw exprtypes_get(x.et, id);
    LlType:all = raw ll_type(x.fe.ctx, atid);
    if (!(raw ll_is_ok(all))) { pass (raw iv_from_ll_at(x, all, atid, n.span)); }
    // `[]` is the zero array (0.8.1): absent means zero, as in `Result{…}`.
    if ((raw expr_list_count(n)) == 0i32) {
        pass (raw iv(move(all.text), "zeroinitializer", atid));
    }
    string:acc = "undef";
    int32:i = 0i32;
    while (i < (raw expr_list_count(n))) {
        ExprId:eid = ExprId{ index: raw ast_id_at(x.ast,
                                 raw expr_list_start(n), i) };
        IrVal:v = raw emit_expr(x, eid);
        if (!(raw iv_is_ok(v))) { pass v; }
        // AN ELEMENT IS A SLOT (1.0.6e), of the array's element type.
        v = raw emit_fit(x, raw type_elem(x.fe.ctx.types, atid), move(v), n.span);
        if (!(raw iv_is_ok(v))) { pass v; }
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = insertvalue ", all.text, " ",
                          raw cat5(acc, ", ", v.ll, " ",
                              raw cat4(v.ref, ", ",
                                  raw int_to_string(i => int64), ""))));
        acc = move(r);
        i = i + 1i32;
    }
    pass (raw iv(move(all.text), move(acc), atid));
};

// `Result{ value: v, err: e }` — either field may be omitted and the omitted
// one is ZERO, which is D-069's derivation rule made concrete: no error means
// `error == 0`, and a failed Result's value slot is the type's zero.
func:emit_result_lit = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    int32:rtid = raw exprtypes_get(x.et, id);
    LlType:rll = raw ll_type(x.fe.ctx, rtid);
    if (!(raw ll_is_ok(rll))) { pass (raw iv_from_ll_at(x, rll, rtid, n.span)); }
    int32:inner = raw type_elem(x.fe.ctx.types, rtid);

    string:eref = "0";
    ExprId:ee = raw expr_rhs(n);
    if (!(raw expr_is_none(ee))) {
        IrVal:ev = raw emit_expr(x, ee);
        if (!(raw iv_is_ok(ev))) { pass ev; }
        eref = move(ev.ref);
    }

    if ((raw type_kind(x.fe.ctx.types, inner)) == (raw TY_NIL())) {
        string:a = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(a, " = insertvalue ", rll.text,
                          " undef, i32 ", raw string_concat(eref, ", 0")));
        pass (raw iv(move(rll.text), move(a), rtid));
    }

    LlType:ill = raw ll_type(x.fe.ctx, inner);
    if (!(raw ll_is_ok(ill))) { pass (raw iv_from_ll_at(x, ill, inner, n.span)); }
    string:vref = raw ll_zero(ill);
    ExprId:ve = raw expr_lhs(n);
    if (!(raw expr_is_none(ve))) {
        IrVal:vv = raw emit_expr(x, ve);
        if (!(raw iv_is_ok(vv))) { pass vv; }
        // THE VALUE HALF IS A SLOT (1.0.6e), of the Result's `T`.
        vv = raw emit_fit(x, inner, move(vv), n.span);
        if (!(raw iv_is_ok(vv))) { pass vv; }
        vref = move(vv.ref);
    }
    string:a = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(a, " = insertvalue ", rll.text, " undef, ",
                      raw cat4(ill.text, " ", vref, ", 0")));
    string:b = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(b, " = insertvalue ", rll.text, " ",
                      raw cat4(a, ", i32 ", eref, ", 1")));
    pass (raw iv(move(rll.text), move(b), rtid));
};

// --- the three compiler builtins ---------------------------------------------------

func:emit_builtin = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) never fails {
    string:name = raw intern_get(x.interns, raw builtin_name(n));
    int32:gc = raw builtin_generic_count(n);
    int32:start = raw expr_list_start(n);

    // `#size_of<T>()` — ASK LLVM, never compute: gep one element past null and
    // read the offset. A hand-rolled size that disagrees with the one LLVM lays
    // out survives testing and corrupts memory later; this costs two
    // instructions `opt` folds away. The seed's shape, exactly.
    if (raw string_eq(name, "size_of")) {
        TypeId:ta = TypeId{ index: raw ast_id_at(x.ast, start, 0i32) };
        int32:sized = raw resolve_type(x.tr, ta, x.scope);
        LlType:sll = raw ll_type(x.fe.ctx, sized);
        if (!(raw ll_is_ok(sll))) { pass (raw iv_from_ll_at(x, sll, sized, n.span)); }
        string:g = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(g, " = getelementptr ", sll.text,
                          ", ptr null, i32 1", ""));
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(r, " = ptrtoint ptr ",
                          raw string_concat(g, " to i64")));
        pass (raw iv("i64", move(r), raw exprtypes_get(x.et, id)));
    }

    // `#wild_ptr<T>(addr)` — the ONE place an integer becomes a pointer (D-019).
    if (raw string_eq(name, "wild_ptr")) {
        ExprId:aid = ExprId{ index: raw ast_id_at(x.ast, start, gc) };
        IrVal:av = raw emit_expr(x, aid);
        if (!(raw iv_is_ok(av))) { pass av; }
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = inttoptr ", av.ll, " ",
                          raw string_concat(av.ref, " to ptr")));
        pass (raw iv("ptr", move(r), raw exprtypes_get(x.et, id)));
    }

    // `#wild_slice<T>(ptr, len)` — a `{ptr, len}` built from parts the caller
    // vouches for; deliberately parallel to `#wild_ptr` (D-019).
    if (raw string_eq(name, "wild_slice")) {
        ExprId:parg = ExprId{ index: raw ast_id_at(x.ast, start, gc) };
        ExprId:lid = ExprId{ index: raw ast_id_at(x.ast, start, gc + 1i32) };
        IrVal:pv2 = raw emit_expr(x, parg);
        if (!(raw iv_is_ok(pv2))) { pass pv2; }
        IrVal:lv = raw emit_expr(x, lid);
        if (!(raw iv_is_ok(lv))) { pass lv; }
        string:a = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat3(a,
            " = insertvalue { ptr, i64 } undef, ptr ",
            raw string_concat(pv2.ref, ", 0")));
        string:b = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(b, " = insertvalue { ptr, i64 } ", a,
                          ", i64 ", raw string_concat(lv.ref, ", 1")));
        pass (raw iv("{ ptr, i64 }", move(b), raw exprtypes_get(x.et, id)));
    }

    // `#unreachable()` — TRAP THROUGH D-142'S ROUTE (D-061, `UNREACHABLE`,
    // −4102). It replaced the removed `(!)`: a point a stricter analysis has
    // excluded, made a CONTROLLED stop rather than undefined behaviour if the
    // exclusion was wrong. `unreachable` is a block terminator, so a fresh
    // (dead) block follows it — whatever the surrounding expression emits next
    // lands there, valid but never reached — and the handed-back value is
    // `undef` of the node's type, which is never produced.
    if (raw string_eq(name, "unreachable")) {
        drop irw_line(x.fe.w, "call void @npk_trap(i32 -4102)");
        drop irw_line(x.fe.w, "unreachable");
        string:ual = raw irw_new_label(x.fe.w, "unreach.after");
        drop irw_label(x.fe.w, ual);
        int32:utid = raw exprtypes_get(x.et, id);
        LlType:ull = raw node_ll(x, id);
        if (ull.state != (raw LL_OK())) {
            pass (raw iv_from_ll_at(x, ull, utid, n.span));
        }
        pass (raw iv(move(ull.text), "undef", utid));
    }

    pass (raw iv_broken(n.span));
};
