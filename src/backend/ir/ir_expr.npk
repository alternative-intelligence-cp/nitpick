// Expression lowering — literals, names, arithmetic, comparison, casts, calls.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.7.5.
//
// THE FRONTEND'S ANSWER IS THE TYPE; THIS MODULE NEVER TYPES ANYTHING. The
// checker recorded every expression's type in `ExprTypes` (0.4.2), and
// `check_kinds_typed` holds the line that every kind is covered. The seed could
// not do this — it rebuilds a checker scope per node and asks again — and asking
// again is two typings of one expression, which is two chances to disagree. The
// one place `ExprTypes` is silent is a bare-name builtin call, typed UNKNOWN on
// purpose ("its signature arrives with call checking"), and `ir_runtime.npk`
// exists precisely to answer there.
//
// NO `nsw`, NO `nuw`, EVER, ON ORDINARY ARITHMETIC (D-037). Overflow is DEFINED
// WRAPPING in Nitpick. Every C-family frontend emits `add nsw` because C says
// signed overflow is undefined — and that flag licenses LLVM to assume it never
// happens, which licenses deleting exactly the kind of guard a safety language
// adds. The prototype was bitten and worked around it by DISABLING OPTIMISATION
// for the affected types — a guarantee that lives in a build flag is not in the
// artifact, and verification analyses the optimised output, so a property that
// survives only at -O0 is one the analyzer never sees. Treat "works unoptimised"
// as a defect report about THIS module.
//
// EXTENSION FOLLOWS THE SOURCE'S SIGNEDNESS, NOT THE TARGET'S — a deliberate
// departure from the seed, which extends by the TARGET's. `uint32 => int64` of a
// value with the high bit set is value-preserving under zext and NEGATIVE under
// the seed's sext; D-021's checked cast promises no loss, and the seed's shape
// breaks the promise in the one corner its own sources never exercise. The seed
// compiles one program; this compiles whatever the frontend accepted.

mod:ir_expr;

use "../../frontend/source_location.npk".*;
use "../../frontend/intern.npk".*;
use "../../frontend/num_width.npk".*;
use "../../frontend/token_kind.npk".*;
use "../../frontend/ast_kind.npk".*;
use "../../frontend/ast.npk".*;
use "../../frontend/parse_expr.npk".*;
use "../../frontend/diagnostics.npk".*;
use "../../frontend/types.npk".*;
use "../../frontend/expr_types.npk".*;
use "../../frontend/type_layout.npk".*;
use "../../frontend/type_names.npk".*;
use "../../frontend/symbols.npk".*;
use "../../frontend/parse_decl.npk".*;
use "./ir_writer.npk".*;
use "./ir_types.npk".*;
use "./ir_func.npk".*;
use "../../frontend/resolve_type.npk".*;
use "./ir_runtime.npk".*;
// THE DECLARED CYCLE with the statement walker — `relay` exits the function,
// which runs the defer stack, which emits statements. Same shape, same reason,
// as `type_expr` ↔ `type_stmt` (0.4.2).
use "./ir_stmt.npk".*;

// An emitted value. `ll` and `ref` are what an instruction writes; `type_id` is
// the frontend's answer, 0 where the frontend deliberately has none (a builtin
// call). `wrapped`/`inner` carry what `raw` needs to know about a call's Result —
// STORED, not sniffed out of the text, because `cstring`'s `{ ptr, i64 }` is one
// brace away from reading like a wrapper.
//
// A REFUSAL CARRIES ITS CONSTRUCT AND ITS SPAN (0.7.7). `NITPICK-RUNG-001` must
// name the construct and the rung that enables it, at the place it was written —
// so the refusal site, which is the only thing that knows all three, records
// them. A bare state would make the driver reconstruct what it refused, which is
// how a diagnostic comes to point at the wrong thing.
pub struct:IrVal = {
    int32:state;      // LL_OK / LL_RUNG / LL_BROKEN, reusing ir_types' states
    string:rung;
    string:what;      // "the `for` loop" — the construct, for the diagnostic
    Span:at;
    string:ll;
    string:ref;
    int32:type_id;
    bool:wrapped;
    string:inner;
};

pub func:iv = IrVal(string:ll, string:ref, int32:type_id) {
    IrVal:v = IrVal{ state: raw LL_OK(), rung: "", what: "", at: raw span_none(),
                     ll: ll, ref: ref,
                     type_id: type_id, wrapped: false, inner: "" };
    pass v;
};

pub func:iv_rung = IrVal(string:what, string:rung, Span:at) {
    IrVal:v = IrVal{ state: raw LL_RUNG(), rung: rung, what: what, at: at,
                     ll: "", ref: "",
                     type_id: 0i32, wrapped: false, inner: "" };
    pass v;
};

pub func:iv_broken = IrVal(Span:at) {
    IrVal:v = IrVal{ state: raw LL_BROKEN(), rung: "", what: "", at: at,
                     ll: "", ref: "",
                     type_id: 0i32, wrapped: false, inner: "" };
    pass v;
};

pub func:iv_is_ok = bool(IrVal:v) { pass (v.state == (raw LL_OK())); };

// A statement's "it worked" — statements yield nothing, so the value slots are
// the NIL convention and only the state matters.
pub func:iv_nil = IrVal() {
    pass (raw iv("i32", "0", 0i32));
};

// A refused TYPE, named as one. `LlType` has no span — a type is refused wherever
// it is mentioned — so the mention supplies it, and the type names itself.
pub func:iv_from_ll_at = IrVal(ExprEmitter->:x, LlType:t, int32:type_id, Span:at) {
    string:what = relay string_concat("the type `",
                      relay string_concat(relay type_display(x.fe.ctx.types,
                                              x.interns, type_id), "`"));
    if (t.state == (raw LL_RUNG())) { pass (raw iv_rung(what, t.rung, at)); }
    pass (raw iv_broken(at));
};

// --- string literals live at module level -------------------------------------------
//
// A literal becomes a private constant and three insertvalues. The TABLE is
// module-wide — global names must be unique across the module — so the numbering
// is global too, exactly the seed's `@.str.N`.

pub struct:StrTable = {
    wild string->:items;
    int32:count;
    int32:cap;
};

pub func:strtab_init = StrTable() {
    wild int8->:m = alloc(16i64 * #size_of<string>());
    StrTable:t = StrTable{ items: m =>! wild string->, count: 0i32, cap: 16i32 };
    pass t;
};

pub func:strtab_add = string(StrTable->:t, string:data) {
    if (t.count >= t.cap) {
        int32:nc = t.cap * 2i32;
        wild int8->:m = ralloc(t.items =>! wild int8->,
                               (nc => int64) * #size_of<string>());
        t.items = m =>! wild string->;
        t.cap = nc;
    }
    t.items[t.count => int64] = data;
    string:name = relay string_concat("@.str.",
                      raw int_to_string(t.count => int64));
    t.count = t.count + 1i32;
    pass name;
};

// One byte of a `c"…"` constant. Printable ASCII stays itself; `"` and `\` and
// everything else become `\XX` — two hex digits, uppercase, the seed's encoding.
func:esc_byte = string(uint8:b) {
    if (b >= 32u8) {
        if (b < 127u8) {
            if (b != 34u8) {
                if (b != 92u8) {
                    wild int8->:one = alloc(1i64);
                    one[0i64] = b =>! int8;
                    pass (raw string_from_bytes(one, 1i64));
                }
            }
        }
    }
    string:hex = "0123456789ABCDEF";
    // MASK AFTER THE WIDENING. This function is seed-compiled until 1.2, and the
    // seed extends by the TARGET's signedness (the 0.7.5 divergence, met in the
    // wild): byte 226 — the lead of every em-dash — sign-extended to -30 and
    // indexed the hex table at -1. The mask makes the value 0..255 under EITHER
    // extension rule, which is what "correct" has to mean for code that runs
    // under two compilers until the fixpoint closes.
    int64:wide = (b =>! int64) & 255i64;
    wild int8->:buf = alloc(3i64);
    buf[0i64] = 92i8;                                   // backslash
    buf[1i64] = hex.ptr[(wide / 16i64)] =>! int8;
    buf[2i64] = hex.ptr[(wide % 16i64)] =>! int8;
    pass (raw string_from_bytes(buf, 3i64));
};

// The whole table, as module-level constants. Called by the driver once the
// bodies are emitted, which is why the table and the writer are separate things.
pub func:strtab_write_all = NIL(StrTable->:t, IrWriter->:w) {
    int32:i = 0i32;
    while (i < t.count) {
        string:data = t.items[i => int64];
        string:enc = "";
        int64:j = 0i64;
        while (j < data.len) {
            enc = relay string_concat(enc, relay esc_byte(data.ptr[j] => uint8));
            j = j + 1i64;
        }
        string:h1 = relay string_concat("@.str.", raw int_to_string(i => int64));
        string:h2 = relay string_concat(h1, " = private unnamed_addr constant [");
        string:h3 = relay string_concat(h2, raw int_to_string(data.len));
        string:h4 = relay string_concat(h3, " x i8] c\"");
        string:h5 = relay string_concat(h4, enc);
        drop irw_raw(w, relay string_concat(h5, "\""));
        i = i + 1i32;
    }
    pass NIL;
};

// --- the emitter --------------------------------------------------------------------

pub struct:ExprEmitter = {
    FnEmitter->:fe;
    Ast->:ast;
    ExprTypes->:et;
    SymbolTable->:tab;
    InternTable->:interns;
    StrTable->:strs;

    // FOR ANNOTATIONS, NOT FOR EXPRESSIONS (0.7.6). A declaration's type is an
    // AST type node the checker resolved and did not store, so the emitter
    // resolves it again — a cache hit by construction, since the checker already
    // interned every type this can produce. Expressions never come here; their
    // types are in `et`.
    TypeResolver->:tr;
    int32:scope;
};

pub func:exprem_init = ExprEmitter(FnEmitter->:fe, Ast->:ast, ExprTypes->:et,
                                   SymbolTable->:tab, InternTable->:interns,
                                   StrTable->:strs, TypeResolver->:tr,
                                   int32:scope) {
    ExprEmitter:x = ExprEmitter{ fe: fe, ast: ast, et: et, tab: tab,
                                 interns: interns, strs: strs, tr: tr,
                                 scope: scope };
    pass x;
};

// The lowered text of this expression's frontend-recorded type.
func:node_ll = LlType(ExprEmitter->:x, ExprId:id) {
    pass (relay ll_type(x.fe.ctx, raw exprtypes_get(x.et, id)));
};

// --- dispatch -----------------------------------------------------------------------

pub func:emit_expr = IrVal(ExprEmitter->:x, ExprId:id) {
    ExprNode:n = relay ast_expr(x.ast, id);

    if (n.kind == ExprKind.ExprIntLiteral)    { pass (relay emit_int(x, id, n)); }
    if (n.kind == ExprKind.ExprBoolLiteral) {
        if (n.payload == 1i64) { pass (raw iv("i8", "1", 0i32)); }
        pass (raw iv("i8", "0", 0i32));
    }
    if (n.kind == ExprKind.ExprCharLiteral) {
        pass (raw iv("i8", raw int_to_string(n.payload), 0i32));
    }
    if (n.kind == ExprKind.ExprSentinelLiteral) {
        // NIL is the zero-width value; its `i32 0` exists only to have something
        // to hand `Result<NIL>` machinery. NULL is the pointer. ERR (0.9.5) is
        // the `tbb` taint (D-008): the sentinel of whatever width the checker
        // gave this position, from the one shared table.
        if (n.payload == 0i64) { pass (raw iv("i32", "0", 0i32)); }
        if (n.payload == 1i64) { pass (raw iv("ptr", "null", 0i32)); }
        int32:stid = raw exprtypes_get(x.et, id);
        int32:sbits2 = raw type_int_bits(x.fe.ctx.types, stid);
        string:smn = raw tbb_min_decimal(sbits2);
        if (smn.len == 0i64) { pass (raw iv_broken(n.span)); }
        LlType:sll = relay ll_type(x.fe.ctx, stid);
        if (!(raw ll_is_ok(sll))) { pass (relay iv_from_ll_at(x, sll, stid, n.span)); }
        pass (raw iv(sll.text, smn, stid));
    }
    if (n.kind == ExprKind.ExprStringLiteral) { pass (relay emit_string(x, n)); }
    if (n.kind == ExprKind.ExprIdentifierExpr){ pass (relay emit_ident(x, id, n)); }
    if (n.kind == ExprKind.ExprUnaryExpr)     { pass (relay emit_unary(x, id, n)); }
    if (n.kind == ExprKind.ExprBinaryExpr)    { pass (relay emit_binary(x, id, n)); }
    if (n.kind == ExprKind.ExprCastExpr)      { pass (relay emit_cast(x, id, n)); }
    if (n.kind == ExprKind.ExprUncheckedCastExpr) { pass (relay emit_cast(x, id, n)); }
    if (n.kind == ExprKind.ExprCallExpr)      { pass (relay emit_call(x, id, n)); }
    if (n.kind == ExprKind.ExprRawUnwrapExpr) { pass (relay emit_raw(x, id, n)); }
    if (n.kind == ExprKind.ExprDropExpr) {
        IrVal:v = relay emit_expr(x, raw expr_operand(n));
        if (v.state != (raw LL_OK())) { pass v; }
        pass (raw iv("i32", "0", 0i32));
    }

    if (n.kind == ExprKind.ExprRelayExpr)    { pass (relay emit_relay(x, id, n)); }

    if (n.kind == ExprKind.ExprMemberAccessExpr) { pass (relay emit_member(x, id, n)); }
    if (n.kind == ExprKind.ExprIndexExpr)        { pass (relay emit_index(x, id, n)); }
    // `@` and `$$` both lower to the address; that a borrow is SECOND-CLASS is
    // the escape analysis's guarantee (0.5), not a difference in representation.
    if (n.kind == ExprKind.ExprAddressOfExpr)    { pass (relay emit_addr_op(x, id, n)); }
    if (n.kind == ExprKind.ExprBorrowExpr)       { pass (relay emit_addr_op(x, id, n)); }
    if (n.kind == ExprKind.ExprDerefExpr)        { pass (relay emit_deref(x, id, n)); }
    if (n.kind == ExprKind.ExprStructLiteralExpr){ pass (relay emit_struct_lit(x, id, n)); }
    if (n.kind == ExprKind.ExprArrayLiteralExpr) { pass (relay emit_array_lit(x, id, n)); }
    if (n.kind == ExprKind.ExprResultLiteralExpr){ pass (relay emit_result_lit(x, id, n)); }
    if (n.kind == ExprKind.ExprBuiltinExpr)      { pass (relay emit_builtin(x, id, n)); }

    // A raw or block string differs from a plain one in LEXING only; by here all
    // three are an intern index of decoded bytes.
    if (n.kind == ExprKind.ExprRawStringLiteral)   { pass (relay emit_string(x, n)); }
    if (n.kind == ExprKind.ExprBlockStringLiteral) { pass (relay emit_string(x, n)); }

    // --- classified refusals, one rung each ---------------------------------
    if (n.kind == ExprKind.ExprMethodCallExpr) {
        // `Ev.Move(5i32)` parses as a method call; the receiver naming an enum
        // DECLARATION is what distinguishes a constructor from a real method,
        // exactly the test the checker makes.
        int32:edecl = raw member_enum_decl(x, n);
        if (edecl != 0i32) {
            pass (relay emit_ctor(x, id, n.span, raw exprtypes_get(x.et, id),
                      n.payload =>! int32, raw expr_list_start(n),
                      raw expr_list_count(n)));
        }
        pass (raw iv_rung("a method call", "1.0", n.span));
    }
    if (n.kind == ExprKind.ExprSafeNavExpr) {
        pass (raw iv_rung("the `?.` operator", "1.0", n.span));
    }
    if (n.kind == ExprKind.ExprNullCoalesceExpr) {
        pass (raw iv_rung("the `??` operator", "1.0", n.span));
    }
    if (n.kind == ExprKind.ExprSafeUnwrapExpr) {
        pass (raw iv_rung("the `?` operator", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprEmphaticUnwrapExpr) {
        pass (raw iv_rung("the `?!` operator", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprTemplateLiteral) {
        pass (raw iv_rung("a template literal", "0.8", n.span));
    }
    if (n.kind == ExprKind.ExprComptimeExpr) {
        pass (raw iv_rung("`comptime(…)` in a runtime position", "0.8", n.span));
    }
    if (n.kind == ExprKind.ExprRangeExpr) {
        pass (raw iv_rung("a range value", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprSpreadExpr) {
        pass (raw iv_rung("the `..^` expansion", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprTernaryExpr) {
        pass (raw iv_rung("the ternary `is`", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprPostfixExpr) {
        pass (raw iv_rung("a postfix operator", "0.9", n.span));
    }
    // A float literal (0.9.4). The lexer kept the TEXT; LLVM's parser converts
    // decimal to double with correct rounding, so `double <text>` is exact for
    // flt64. A flt32 literal rides the same double and truncates — exactly
    // correct for ≤ 15 significant digits (double rounding is innocuous at
    // 53 vs 24 bits), and the checker refused anything longer (D-143).
    if (n.kind == ExprKind.ExprFloatLiteral) {
        int32:ftid = raw exprtypes_get(x.et, id);
        LlType:fll = relay ll_type(x.fe.ctx, ftid);
        if (!(raw ll_is_ok(fll))) { pass (relay iv_from_ll_at(x, fll, ftid, n.span)); }
        string:txt = relay intern_get(x.interns, n.payload =>! int32);
        string:body = relay float_literal_body(x, txt);
        if (raw string_eq(fll.text, "double")) {
            pass (raw iv("double", body, ftid));
        }
        if (raw string_eq(fll.text, "float")) {
            string:fr = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(fr, " = fptrunc double ", body,
                              " to float", ""));
            pass (raw iv("float", fr, ftid));
        }
        pass (raw iv_broken(n.span));
    }
    // The four below were found by `check_kinds_lowered_or_refused`'s first run
    // (0.9.1): each fell through to iv_broken — an INTERNAL-defect report for
    // what is really an unlowered language feature. The honest answer is a
    // rung, exactly like their neighbours above.
    if (n.kind == ExprKind.ExprPipeExpr) {
        pass (raw iv_rung("the pipe operator", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprDefaultsExpr) {
        pass (raw iv_rung("the defaults operator", "0.9", n.span));
    }
    // `is_err(x)` — THE test that does not trap (D-008 §5): ERR flows through
    // data and stops at branches, and this is the sanctioned way to look.
    if (n.kind == ExprKind.ExprIsErrExpr) {
        IrVal:ov = relay emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(ov))) { pass ov; }
        int32:obits = raw type_int_bits(x.fe.ctx.types, ov.type_id);
        string:mn = raw tbb_min_decimal(obits);
        if (mn.len == 0i64) { pass (raw iv_broken(n.span)); }
        string:ec = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(ec, " = icmp eq ", ov.ll, " ",
                          relay cat3(ov.ref, ", ", mn)));
        string:ez = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(ez, " = zext i1 ",
                          relay string_concat(ec, " to i8")));
        pass (raw iv("i8", ez, 0i32));
    }
    if (n.kind == ExprKind.ExprVectorCtorExpr) {
        pass (raw iv_rung("a vector constructor", "0.9", n.span));
    }
    // `move(place)` LOWERS: it yields the place's value, and what it does to
    // the SOURCE is static — the 0.5 move analysis already blessed and tracked
    // the transfer, so there is nothing for the IR to add (D-065). Found by
    // the same first run, miscategorized as iv_broken.
    if (n.kind == ExprKind.ExprMoveExpr) {
        pass (relay emit_expr(x, raw expr_operand(n)));
    }
    if (n.kind == ExprKind.ExprIterationVarExpr) {
        pass (raw iv_rung("the `$` iteration variable", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprPickExpr) {
        pass (raw iv_rung("a `pick` expression", "0.9", n.span));
    }
    if (n.kind == ExprKind.ExprAwaitExpr) {
        pass (raw iv_rung("`await`", "1.1", n.span));
    }
    if (n.kind == ExprKind.ExprDynCastExpr) {
        pass (raw iv_rung("a `dyn` cast", "1.0", n.span));
    }
    if (n.kind == ExprKind.ExprFloatLiteral) {
        pass (raw iv_rung("a float literal", "0.9", n.span));
    }

    // FAIL CLOSED ON A KIND NOBODY CLASSIFIED. Phase A's whole output is a
    // promise that accepted programs are valid; an emitter that guesses at a
    // node it does not know turns that into a lie.
    pass (raw iv_broken(n.span));
};

// --- leaves -------------------------------------------------------------------------

func:emit_int = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    LlType:t = relay node_ll(x, id);
    if (t.state != (raw LL_OK())) {
        pass (relay iv_from_ll_at(x, t, raw exprtypes_get(x.et, id), n.span));
    }
    pass (raw iv(t.text, raw int_to_string(n.payload),
                 raw exprtypes_get(x.et, id)));
};

func:emit_string = IrVal(ExprEmitter->:x, ExprNode:n) {
    string:data = relay intern_get(x.interns, n.payload =>! int32);
    string:g = relay strtab_add(x.strs, data);
    string:len = raw int_to_string(data.len);
    string:a = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat4(a,
        " = insertvalue { ptr, i64, i64 } undef, ptr ", g, ", 0"));
    string:b = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(b, " = insertvalue { ptr, i64, i64 } ", a,
                                     ", i64 ", relay string_concat(len, ", 1")));
    string:c = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(c, " = insertvalue { ptr, i64, i64 } ", b,
                                     ", i64 ", relay string_concat(len, ", 2")));
    pass (raw iv("{ ptr, i64, i64 }", c, 0i32));
};

func:emit_ident = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    LocalSlot:s = raw fnem_lookup(x.fe, n.payload =>! int32);
    if (!s.found) {
        // Not a local: a module-level `const`, a function used as a value, or a
        // name this rung cannot reach. Each is real Nitpick; none is lowered
        // yet. Refusing beats loading from a slot that is not there.
        pass (raw iv_rung("a name that is not a local", "0.8", n.span));
    }
    // The SLOT's type, not the table's: the binding is the local truth, and for
    // a name the checker recorded (every ordinary local) the two are the same id
    // by construction — the vardecl resolved the same annotation into the same
    // interned type the checker did.
    LlType:t = relay ll_type(x.fe.ctx, s.type_id);
    if (t.state != (raw LL_OK())) {
        pass (relay iv_from_ll_at(x, t, s.type_id, n.span));
    }
    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = load ", t.text, ", ptr ", s.slot));
    pass (raw iv(t.text, r, s.type_id));
};

// --- operators ----------------------------------------------------------------------

func:emit_unary = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    TokenKind:op = raw expr_op(n);
    IrVal:v = relay emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }

    if (op == TokenKind.OpMinus) {
        string:r = relay irw_temp(x.fe.w);
        // Floats negate with fneg — `fsub 0.0, x` is NOT negation under IEEE
        // (it loses -0.0: 0.0 - 0.0 is +0.0, while -(0.0) is -0.0).
        if (raw ll_is_float_text(v.ll)) {
            drop irw_line(x.fe.w, relay cat5(r, " = fneg ", v.ll, " ", v.ref));
            pass (raw iv(v.ll, r, v.type_id));
        }
        drop irw_line(x.fe.w, relay cat5(r, " = sub ", v.ll, " 0, ", v.ref));
        pass (raw iv(v.ll, r, v.type_id));
    }
    if (op == TokenKind.OpTilde) {
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(r, " = xor ", v.ll, " ",
                                         relay string_concat(v.ref, ", -1")));
        pass (raw iv(v.ll, r, v.type_id));
    }
    if (op == TokenKind.OpBang) {
        // FROM THE VALUE ALREADY EMITTED — re-emitting the operand to get a
        // truth value runs it twice, and the seed's note records what that did:
        // `!(raw split(x))` split twice, the second refused, and the negation
        // answered about the wrong run.
        string:c = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(c, " = icmp ne ", v.ll, " ",
                                         relay string_concat(v.ref, ", 0")));
        string:xr = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(xr, " = xor i1 ", relay string_concat(c, ", true")));
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(r, " = zext i1 ", relay string_concat(xr, " to i8")));
        pass (raw iv("i8", r, v.type_id));
    }
    pass (raw iv_broken(n.span));
};

// A truth value for a branch or a short-circuit: `i1`, derived by comparing
// against zero. `bool` is STORED as `i8`; `i1` exists only here.
pub func:emit_cond = IrVal(ExprEmitter->:x, ExprId:id) {
    IrVal:v = relay emit_expr(x, id);
    if (v.state != (raw LL_OK())) { pass v; }
    string:c = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(c, " = icmp ne ", v.ll, " ",
                                     relay string_concat(v.ref, ", 0")));
    pass (raw iv("i1", c, 0i32));
};

// The index, as i64, for a bounds compare: narrower indices sign-extend, so a
// negative index of any width becomes a huge unsigned value and ONE unsigned
// compare rejects both "negative" and "past the end" (D-070).
func:index_as_i64 = string(ExprEmitter->:x, IrVal:ix) {
    if (raw string_eq(ix.ll, "i64")) { pass ix.ref; }
    string:w = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(w, " = sext ", ix.ll, " ",
                      relay string_concat(ix.ref, " to i64")));
    pass w;
};

// The bounds trap (0.9.2, D-070): `idx <u len` or branch to OUT_OF_BOUNDS
// (-4099) through the D-142 route. Emitted at EVERY dynamic index — a slice's
// length is a runtime fact and an array's is a constant, but the refusal is
// the same controlled shutdown either way.
func:emit_bounds_guard = NIL(ExprEmitter->:x, string:idx64, string:len_ref) {
    string:ok_c = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(ok_c, " = icmp ult i64 ", idx64, ", ",
                      relay string_concat(len_ref, "")));
    string:trap_l = relay irw_new_label(x.fe.w, "idx.oob");
    string:ok_l = relay irw_new_label(x.fe.w, "idx.ok");
    drop irw_line(x.fe.w, relay cat5("br i1 ", ok_c, ", label %", ok_l,
                      relay string_concat(", label %", trap_l)));
    drop irw_label(x.fe.w, trap_l);
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4099)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, ok_l);
    pass NIL;
};

// The literal text, made a valid LLVM decimal-FP constant: the type suffix is
// cut, and a body with no '.' gets one ("1e10" is not LLVM grammar; "1.0e10"
// is). The digits themselves pass through untouched — LLVM's own parser does
// the correctly-rounded conversion.
func:float_literal_body = string(ExprEmitter->:x, string:txt) {
    int64:cut = txt.len;
    int64:fi = 0i64;
    while (fi < txt.len) {
        if (txt.ptr[fi] == 102u8) { cut = fi; break; }   // 'f' opens the suffix
        fi = fi + 1i64;
    }
    string:body = relay string_slice(txt, 0i64, cut);
    bool:has_dot = false;
    int64:epos = body.len;
    int64:bi = 0i64;
    while (bi < body.len) {
        uint8:bc = body.ptr[bi];
        if (bc == 46u8) { has_dot = true; }
        if (bc == 101u8) { epos = bi; break; }
        if (bc == 69u8)  { epos = bi; break; }
        bi = bi + 1i64;
    }
    if (has_dot) { pass body; }
    string:mant = relay string_slice(body, 0i64, epos);
    string:rest = relay string_slice(body, epos, body.len);
    pass (relay cat3(mant, ".0", rest));
};

// `tbb` division and remainder: zero divisor or any ERR yields ERR — never a
// trap, never UB. The divisor is REPLACED with 1 when the result will be ERR
// anyway, so the machine instruction itself can never fault; the select picks
// the sentinel afterward. (An ERR-free dividend can never be the sentinel, so
// sdiv's own INT_MIN/-1 case is unreachable by construction.)
func:tbb_divlike = IrVal(ExprEmitter->:x, ExprNode:n, IrVal:lhs, IrVal:rhs,
                         string:anyerr, string:tmn, string:ins) {
    string:z = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(z, " = icmp eq ", lhs.ll, " ",
                      relay string_concat(rhs.ref, ", 0")));
    string:sticky = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(sticky, " = or i1 ", anyerr, ", ", z));
    string:safeb = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(safeb, " = select i1 ", sticky, ", ",
                      relay cat5(lhs.ll, " 1, ", lhs.ll, " ", rhs.ref)));
    string:q = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(q, " = ", ins, " ",
                      relay cat5(lhs.ll, " ", lhs.ref, ", ", safeb)));
    string:res = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(res, " = select i1 ", sticky, ", ",
                      relay cat5(lhs.ll, " ", tmn, ", ",
                          relay cat3(lhs.ll, " ", q))));
    pass (raw iv(lhs.ll, res, lhs.type_id));
};

pub func:arith_name = string(TokenKind:op, bool:signed) {
    if (op == TokenKind.OpPlus)    { pass "add"; }
    if (op == TokenKind.OpMinus)   { pass "sub"; }
    if (op == TokenKind.OpStar)    { pass "mul"; }
    if (op == TokenKind.OpSlash)   { if (signed) { pass "sdiv"; } pass "udiv"; }
    if (op == TokenKind.OpPercent) { if (signed) { pass "srem"; } pass "urem"; }
    if (op == TokenKind.OpAmp)     { pass "and"; }
    if (op == TokenKind.OpPipe)    { pass "or"; }
    if (op == TokenKind.OpCaret)   { pass "xor"; }
    if (op == TokenKind.OpShl)     { pass "shl"; }
    if (op == TokenKind.OpShr)     { if (signed) { pass "ashr"; } pass "lshr"; }
    pass "";
};

func:icmp_name = string(TokenKind:op, bool:signed) {
    if (op == TokenKind.OpEqEq)  { pass "eq"; }
    if (op == TokenKind.OpNotEq) { pass "ne"; }
    if (op == TokenKind.OpLt)    { if (signed) { pass "slt"; } pass "ult"; }
    if (op == TokenKind.OpLtEq)  { if (signed) { pass "sle"; } pass "ule"; }
    if (op == TokenKind.OpGt)    { if (signed) { pass "sgt"; } pass "ugt"; }
    if (op == TokenKind.OpGtEq)  { if (signed) { pass "sge"; } pass "uge"; }
    pass "";
};

func:emit_binary = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    TokenKind:op = raw expr_op(n);

    if (op == TokenKind.OpAndAnd) { pass (relay emit_shortcircuit(x, n, true)); }
    if (op == TokenKind.OpOrOr)   { pass (relay emit_shortcircuit(x, n, false)); }

    IrVal:lhs = relay emit_expr(x, raw expr_lhs(n));
    if (lhs.state != (raw LL_OK())) { pass lhs; }
    IrVal:rhs = relay emit_expr(x, raw expr_rhs(n));
    if (rhs.state != (raw LL_OK())) { pass rhs; }

    // SIGNEDNESS COMES FROM THE OPERANDS' TYPE, and the two sides agree because
    // the checker made them (D-092: no implicit widening — a mixed comparison
    // was refused before this runs).
    //
    // THE DEFAULT IS UNSIGNED, and `char8` is why: a character orders by CODE
    // POINT, so `'a' <= c` on bytes past 127 must be `ult` — `slt` would sort
    // the upper half of every encoding below NUL. Only a signed integer opts
    // into the signed comparisons; `eq`/`ne` never cared.
    int32:lt = raw exprtypes_get(x.et, raw expr_lhs(n));
    bool:signed = false;
    if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_INT())) {
        signed = raw type_is_signed(x.fe.ctx.types, lt);
    }

    string:cmp = raw icmp_name(op, signed);
    if (cmp.len > 0i64) {
        // FLOATS COMPARE WITH fcmp AND IEEE SEMANTICS (0.9.4, D-143): ordered
        // predicates except `!=`, which is `une` — NaN != NaN is TRUE, the one
        // place unordered is the correct answer, because `!=` must be the
        // negation of `==` (oeq is false on NaN) or the two operators lie to
        // each other.
        if (raw ll_is_float_text(lhs.ll)) {
            string:fpred = "";
            if (op == TokenKind.OpEqEq)  { fpred = "oeq"; }
            if (op == TokenKind.OpNotEq) { fpred = "une"; }
            if (op == TokenKind.OpLt)    { fpred = "olt"; }
            if (op == TokenKind.OpLtEq)  { fpred = "ole"; }
            if (op == TokenKind.OpGt)    { fpred = "ogt"; }
            if (op == TokenKind.OpGtEq)  { fpred = "oge"; }
            if (fpred.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:fc = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(fc, " = fcmp ", fpred, " ",
                              relay cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
            string:fz = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat3(fz, " = zext i1 ",
                              relay string_concat(fc, " to i8")));
            pass (raw iv("i8", fz, 0i32));
        }
        // `tbb` EQUALITY GUARDS FIRST (0.9.5, D-008 §5): an ERR operand at a
        // comparison is a tainted value about to steer control flow, and it
        // traps (TBB_ERR, -4100) — `is_err` is the test that looks without
        // trapping, and `pick` with an `ERR:` arm is the branch that handles
        // it; a bare `==` is neither. Ordering was already a compile error
        // (D-093).
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_TBB())) {
            int32:tb = raw type_int_bits(x.fe.ctx.types, lt);
            string:tmn = raw tbb_min_decimal(tb);
            if (tmn.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:e1 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(e1, " = icmp eq ", lhs.ll, " ",
                              relay cat3(lhs.ref, ", ", tmn)));
            string:e2 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(e2, " = icmp eq ", lhs.ll, " ",
                              relay cat3(rhs.ref, ", ", tmn)));
            string:ea = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(ea, " = or i1 ", e1, ", ", e2));
            string:tl = relay irw_new_label(x.fe.w, "tbb.err");
            string:ol = relay irw_new_label(x.fe.w, "tbb.ok");
            drop irw_line(x.fe.w, relay cat5("br i1 ", ea, ", label %", tl,
                              relay string_concat(", label %", ol)));
            drop irw_label(x.fe.w, tl);
            drop irw_line(x.fe.w, "call void @npk_trap(i32 -4100)");
            drop irw_line(x.fe.w, "unreachable");
            drop irw_label(x.fe.w, ol);
        }
        string:c = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(c, " = icmp ", cmp, " ",
                          relay cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
        string:z = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(z, " = zext i1 ",
                          relay string_concat(c, " to i8")));
        pass (raw iv("i8", z, 0i32));
    }

    // FLOAT ARITHMETIC IS IEEE AND TOTAL (0.9.4, D-143): fadd through frem,
    // NO guards — division by zero yields ±inf/nan, which is DEFINED behavior,
    // the reason floats have infinities at all. `%` is frem, which llc lowers
    // to the fmod/fmodf libcalls the floor hand-writes. (flt128 never reaches
    // here — the checker refused its arithmetic outright.)
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_FLOAT())) {
            string:fins = "";
            if (op == TokenKind.OpPlus)    { fins = "fadd"; }
            if (op == TokenKind.OpMinus)   { fins = "fsub"; }
            if (op == TokenKind.OpStar)    { fins = "fmul"; }
            if (op == TokenKind.OpSlash)   { fins = "fdiv"; }
            if (op == TokenKind.OpPercent) { fins = "frem"; }
            if (fins.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:fres = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(fres, " = ", fins, " ",
                              relay cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
            pass (raw iv(lhs.ll, fres, lhs.type_id));
        }
    }

    // `tbb` ARITHMETIC (0.9.5, D-008): sticky, saturating, BRANCH-FREE. Any
    // ERR operand yields ERR (stickiness beats every identity — ERR * 0 is
    // ERR); overflow yields ERR (saturation); a result that lands ON the
    // sentinel arithmetically IS ERR by construction, no extra check. Division
    // by zero yields ERR, not a trap — this is the fail-operational row of
    // D-007's table, the whole reason the type exists. Lowered with selects,
    // never branches, so the operation's cost and shape are data-independent.
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) == (raw TY_TBB())) {
            int32:tb = raw type_int_bits(x.fe.ctx.types, lt);
            string:tmn = raw tbb_min_decimal(tb);
            if (tmn.len == 0i64) { pass (raw iv_broken(n.span)); }
            string:e1 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(e1, " = icmp eq ", lhs.ll, " ",
                              relay cat3(lhs.ref, ", ", tmn)));
            string:e2 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(e2, " = icmp eq ", lhs.ll, " ",
                              relay cat3(rhs.ref, ", ", tmn)));
            string:anyerr = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(anyerr, " = or i1 ", e1, ", ", e2));

            string:bad = "";
            string:val = "";
            if (op == TokenKind.OpPlus) {
                string:v = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(v, " = add ", lhs.ll, " ",
                                  relay cat3(lhs.ref, ", ", rhs.ref)));
                // Signed overflow, by the sign trick: it happened iff the
                // operands agree in sign and the result does not.
                string:xa = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(xa, " = xor ", lhs.ll, " ",
                                  relay cat3(v, ", ", lhs.ref)));
                string:xb = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(xb, " = xor ", lhs.ll, " ",
                                  relay cat3(v, ", ", rhs.ref)));
                string:ab = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(ab, " = and ", lhs.ll, " ",
                                  relay cat3(xa, ", ", xb)));
                string:o = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(o, " = icmp slt ", lhs.ll, " ",
                                  relay string_concat(ab, ", 0")));
                bad = o;
                val = v;
            }
            if (op == TokenKind.OpMinus) {
                string:v = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(v, " = sub ", lhs.ll, " ",
                                  relay cat3(lhs.ref, ", ", rhs.ref)));
                // Subtraction overflows iff the operands DISAGREE in sign and
                // the result disagrees with the minuend.
                string:xa = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(xa, " = xor ", lhs.ll, " ",
                                  relay cat3(lhs.ref, ", ", rhs.ref)));
                string:xb = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(xb, " = xor ", lhs.ll, " ",
                                  relay cat3(v, ", ", lhs.ref)));
                string:ab = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(ab, " = and ", lhs.ll, " ",
                                  relay cat3(xa, ", ", xb)));
                string:o = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(o, " = icmp slt ", lhs.ll, " ",
                                  relay string_concat(ab, ", 0")));
                bad = o;
                val = v;
            }
            if (op == TokenKind.OpStar) {
                // Multiplication's overflow has no cheap sign trick; the
                // intrinsic lowers natively at every width here (D-011).
                string:pair = relay irw_temp(x.fe.w);
                string:mhead = relay cat5(pair, " = call { ", lhs.ll,
                                    ", i1 } @llvm.smul.with.overflow.", lhs.ll);
                string:margs = relay cat5("(", lhs.ll, " ", lhs.ref,
                                    relay cat4(", ", lhs.ll, " ",
                                        relay string_concat(rhs.ref, ")")));
                drop irw_line(x.fe.w, relay string_concat(mhead, margs));
                string:v = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(v, " = extractvalue { ", lhs.ll,
                                  ", i1 } ", relay string_concat(pair, ", 0")));
                string:o = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(o, " = extractvalue { ", lhs.ll,
                                  ", i1 } ", relay string_concat(pair, ", 1")));
                bad = o;
                val = v;
            }
            if (op == TokenKind.OpSlash) {
                pass (relay tbb_divlike(x, n, lhs, rhs, anyerr, tmn, "sdiv"));
            }
            if (op == TokenKind.OpPercent) {
                pass (relay tbb_divlike(x, n, lhs, rhs, anyerr, tmn, "srem"));
            }
            if (bad.len == 0i64) { pass (raw iv_broken(n.span)); }

            string:sticky = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(sticky, " = or i1 ", anyerr, ", ", bad));
            string:res = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(res, " = select i1 ", sticky, ", ",
                              relay cat5(lhs.ll, " ", tmn, ", ",
                                  relay cat3(lhs.ll, " ", val))));
            pass (raw iv(lhs.ll, res, lhs.type_id));
        }
    }

    // ARITHMETIC BEYOND FLOATS, INTEGERS AND `tbb` is not this rung's. The
    // checker already refused what is never legal — this refuses what is legal
    // and not yet lowered, which is exactly the difference between the two
    // states.
    if (lt != 0i32) {
        if ((raw type_kind(x.fe.ctx.types, lt)) != (raw TY_INT())) {
            pass (raw iv_rung("arithmetic on a non-integer type", "0.9", n.span));
        }
    }
    string:ins = raw arith_name(op, signed);
    if (ins.len == 0i64) { pass (raw iv_broken(n.span)); }

    // LIVE-2's repair (0.9.0, D-142): division and remainder TRAP on a zero
    // divisor — D-007's rule, and the difference between a controlled shutdown
    // through `failsafe` and SIGFPE with actuators live. Signed division adds
    // the INT_MIN/-1 case: LLVM UB with no defined value, and D-008 already
    // refused inventing one, so it traps too. The guard is emitted, never
    // elided — a build without the verifier still has to emit the check
    // (D-068), and 1.3's static discharge may remove only what it proves.
    bool:divlike = false;
    if (op == TokenKind.OpSlash)   { divlike = true; }
    if (op == TokenKind.OpPercent) { divlike = true; }
    if (divlike) {
        string:z = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(z, " = icmp eq ", lhs.ll, " ",
                          relay string_concat(rhs.ref, ", 0")));
        string:trap_l = relay irw_new_label(x.fe.w, "div.zero");
        string:ok_l = relay irw_new_label(x.fe.w, "div.ok");
        string:next_l = ok_l;
        if (signed) {
            next_l = relay irw_new_label(x.fe.w, "div.chk");
        }
        drop irw_line(x.fe.w, relay cat5("br i1 ", z, ", label %", trap_l,
                          relay string_concat(", label %", next_l)));
        drop irw_label(x.fe.w, trap_l);
        drop irw_line(x.fe.w, "call void @npk_trap(i32 -4097)");
        drop irw_line(x.fe.w, "unreachable");
        if (signed) {
            drop irw_label(x.fe.w, next_l);
            // INT_MIN is detected STRUCTURALLY (0.9.3): it is the one nonzero
            // value equal to its own negation, at every width — so the guard
            // is total over every integer this backend will ever lower, with
            // no per-width constant table to keep in step (the table this
            // replaces would have needed a 1234-digit literal for i4096).
            string:negl = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(negl, " = sub ", lhs.ll, " 0, ",
                              lhs.ref));
            string:m0 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(m0, " = icmp eq ", lhs.ll, " ",
                              relay cat3(lhs.ref, ", ", negl)));
            string:nz = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(nz, " = icmp ne ", lhs.ll, " ",
                              relay string_concat(lhs.ref, ", 0")));
            string:m = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(m, " = and i1 ", m0, ", ", nz));
            string:o = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(o, " = icmp eq ", lhs.ll, " ",
                              relay string_concat(rhs.ref, ", -1")));
            string:both = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(both, " = and i1 ", m, ", ", o));
            string:min_l = relay irw_new_label(x.fe.w, "div.min");
            drop irw_line(x.fe.w, relay cat5("br i1 ", both, ", label %", min_l,
                              relay string_concat(", label %", ok_l)));
            drop irw_label(x.fe.w, min_l);
            drop irw_line(x.fe.w, "call void @npk_trap(i32 -4098)");
            drop irw_line(x.fe.w, "unreachable");
        }
        drop irw_label(x.fe.w, ok_l);
    }

    // NO nsw, NO nuw — D-037 makes overflow defined wrapping, and the flag is
    // the license to delete guards. The header says why at length.
    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = ", ins, " ",
                      relay cat5(lhs.ll, " ", lhs.ref, ", ", rhs.ref)));
    pass (raw iv(lhs.ll, r, lhs.type_id));
};

// `&&` and `||` short-circuit THROUGH A SLOT, not a phi — naive lowering says
// every merged value lives in memory and `mem2reg` builds the phi. The rhs block
// exists so the right side is not evaluated when the left decides.
func:emit_shortcircuit = IrVal(ExprEmitter->:x, ExprNode:n, bool:is_and) {
    string:slot = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay string_concat(slot, " = alloca i8"));
    string:rhs_l = relay irw_new_label(x.fe.w, "sc.rhs");
    string:done_l = relay irw_new_label(x.fe.w, "sc.done");

    IrVal:l = relay emit_cond(x, raw expr_lhs(n));
    if (l.state != (raw LL_OK())) { pass l; }
    // The answer when the right side never runs: `&&` is already false, `||` is
    // already true.
    if (is_and) {
        drop irw_line(x.fe.w, relay string_concat("store i8 0, ptr ", slot));
        drop irw_line(x.fe.w, relay cat5("br i1 ", l.ref, ", label %", rhs_l,
                          relay string_concat(", label %", done_l)));
    } else {
        drop irw_line(x.fe.w, relay string_concat("store i8 1, ptr ", slot));
        drop irw_line(x.fe.w, relay cat5("br i1 ", l.ref, ", label %", done_l,
                          relay string_concat(", label %", rhs_l)));
    }
    drop irw_label(x.fe.w, rhs_l);
    IrVal:r = relay emit_cond(x, raw expr_rhs(n));
    if (r.state != (raw LL_OK())) { pass r; }
    string:z = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat3(z, " = zext i1 ",
                      relay string_concat(r.ref, " to i8")));
    drop irw_line(x.fe.w, relay cat4("store i8 ", z, ", ptr ", slot));
    drop irw_line(x.fe.w, relay cat3("br label %", done_l, ""));
    drop irw_label(x.fe.w, done_l);
    string:out = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat3(out, " = load i8, ptr ",  slot));
    pass (raw iv("i8", out, 0i32));
};

// --- casts --------------------------------------------------------------------------

// Between the scalar `iN`s. Truncation truncates; EXTENSION FOLLOWS THE SOURCE:
// a signed source sign-extends, an unsigned one zero-extends, because that is
// what preserves the value — the promise `=>` makes (D-021). `bool` and `char8`
// widen unsigned: neither has negative values.
// 2^(N-1) as a DOUBLE hex constant, positive and negative — the float→tbb
// range bounds. Powers of two are exact in double at every tbb width, and the
// compare is done in double (an f32 source extends first) so one table serves
// both float widths.
func:tbb_pow_hex = string(int32:bits, bool:neg) {
    if (bits == 8i32)   { if (neg) { pass "0xC060000000000000"; } pass "0x4060000000000000"; }
    if (bits == 16i32)  { if (neg) { pass "0xC0E0000000000000"; } pass "0x40E0000000000000"; }
    if (bits == 32i32)  { if (neg) { pass "0xC1E0000000000000"; } pass "0x41E0000000000000"; }
    if (bits == 64i32)  { if (neg) { pass "0xC3E0000000000000"; } pass "0x43E0000000000000"; }
    if (bits == 128i32) { if (neg) { pass "0xC7E0000000000000"; } pass "0x47E0000000000000"; }
    if (bits == 256i32) { if (neg) { pass "0xCFE0000000000000"; } pass "0x4FE0000000000000"; }
    pass "";
};

// A -4100 trap block on a condition — the shared shape of every checked-cast
// guard in the tbb matrix.
func:tbb_trap_if = NIL(ExprEmitter->:x, string:cond) {
    string:tl = relay irw_new_label(x.fe.w, "tbbc.err");
    string:ol = relay irw_new_label(x.fe.w, "tbbc.ok");
    drop irw_line(x.fe.w, relay cat5("br i1 ", cond, ", label %", tl,
                      relay string_concat(", label %", ol)));
    drop irw_label(x.fe.w, tl);
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4100)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, ol);
    pass NIL;
};

// Resize a tbb/int carrier between widths; signed extension, because every
// carrier that reaches here is either signed or being treated as its number.
func:tbb_resize = string(ExprEmitter->:x, string:from_ll, string:ref,
                         string:to_ll, bool:src_signed) {
    if (raw string_eq(from_ll, to_ll)) { pass ref; }
    int64:sw = relay ll_int_width(from_ll);
    int64:dw = relay ll_int_width(to_ll);
    string:r = relay irw_temp(x.fe.w);
    if (dw < sw) {
        drop irw_line(x.fe.w, relay cat5(r, " = trunc ", from_ll, " ",
                          relay cat3(ref, " to ", to_ll)));
        pass r;
    }
    if (src_signed) {
        drop irw_line(x.fe.w, relay cat5(r, " = sext ", from_ll, " ",
                          relay cat3(ref, " to ", to_ll)));
        pass r;
    }
    drop irw_line(x.fe.w, relay cat5(r, " = zext ", from_ll, " ",
                      relay cat3(ref, " to ", to_ll)));
    pass r;
};

// THE tbb CAST MATRIX (0.9.5, D-144) — closing the audit's third Theme-A hole:
// same-width int⇄tbb rode the no-op fast path, so a taint could be forged or
// laundered with no spelling saying so. The contract, per the settled
// `cast_from_tbb`/`cast_to_tbb` arms: every crossing is legal (`CAST_OK`) and
// CARRIES ITS RUNTIME CHECK — `=>` traps (TBB_ERR, -4100) where the value has
// no image (an ERR leaving tbb, a sentinel-or-out-of-range value entering),
// and `=>!` is the greppable acceptance: the same conversion SATURATES to ERR
// instead of trapping (entering) or reads the raw carrier (leaving). tbb⇄tbb
// maps the sentinel across widths in BOTH spellings — ERR is a state, not a
// number, and a conversion that forgot it would forge validity out of taint.
func:emit_tbb_cast = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n, IrVal:v,
                           LlType:want, int32:wid) {
    bool:unchecked = false;
    if (n.kind == ExprKind.ExprUncheckedCastExpr) { unchecked = true; }
    int32:sk = raw type_kind(x.fe.ctx.types, v.type_id);
    int32:dk = raw type_kind(x.fe.ctx.types, wid);

    if (sk == (raw TY_TBB())) {
        int32:sb = raw type_int_bits(x.fe.ctx.types, v.type_id);
        string:mn_s = raw tbb_min_decimal(sb);
        if (mn_s.len == 0i64) { pass (raw iv_broken(n.span)); }
        string:err = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(err, " = icmp eq ", v.ll, " ",
                          relay cat3(v.ref, ", ", mn_s)));

        if (dk == (raw TY_TBB())) {
            int32:db = raw type_int_bits(x.fe.ctx.types, wid);
            string:mn_d = raw tbb_min_decimal(db);
            string:mx_d = raw tbb_max_decimal(db);
            if (mn_d.len == 0i64) { pass (raw iv_broken(n.span)); }
            if (db < sb) {
                string:hi2 = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(hi2, " = icmp sgt ", v.ll, " ",
                                  relay cat3(v.ref, ", ", mx_d)));
                string:lo2 = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(lo2, " = icmp slt ", v.ll, " ",
                                  relay cat4(v.ref, ", -", mx_d, "")));
                string:oor = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(oor, " = or i1 ", hi2, ", ", lo2));
                if (!unchecked) {
                    string:ne = relay irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, relay cat3(ne, " = xor i1 ",
                                      relay string_concat(err, ", true")));
                    string:tv = relay irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, relay cat5(tv, " = and i1 ", oor, ", ", ne));
                    drop tbb_trap_if(x, tv);
                    string:rz = raw tbb_resize(x, v.ll, v.ref, want.text, true);
                    string:res = relay irw_temp(x.fe.w);
                    drop irw_line(x.fe.w, relay cat5(res, " = select i1 ", err, ", ",
                                      relay cat5(want.text, " ", mn_d, ", ",
                                          relay cat3(want.text, " ", rz))));
                    pass (raw iv(want.text, res, wid));
                }
                string:sat = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(sat, " = or i1 ", err, ", ", oor));
                string:rz2 = raw tbb_resize(x, v.ll, v.ref, want.text, true);
                string:res2 = relay irw_temp(x.fe.w);
                drop irw_line(x.fe.w, relay cat5(res2, " = select i1 ", sat, ", ",
                                  relay cat5(want.text, " ", mn_d, ", ",
                                      relay cat3(want.text, " ", rz2))));
                pass (raw iv(want.text, res2, wid));
            }
            string:rz3 = raw tbb_resize(x, v.ll, v.ref, want.text, true);
            string:res3 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(res3, " = select i1 ", err, ", ",
                              relay cat5(want.text, " ", mn_d, ", ",
                                  relay cat3(want.text, " ", rz3))));
            pass (raw iv(want.text, res3, wid));
        }

        // Leaving tbb: `=>` traps on ERR (no image); `=>!` reads the carrier.
        if (!unchecked) { drop tbb_trap_if(x, err); }
        if (dk == (raw TY_FLOAT())) {
            string:fr = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(fr, " = sitofp ", v.ll, " ",
                              relay cat3(v.ref, " to ", want.text)));
            pass (raw iv(want.text, fr, wid));
        }
        string:iz = raw tbb_resize(x, v.ll, v.ref, want.text, true);
        pass (raw iv(want.text, iz, wid));
    }

    // Entering tbb.
    int32:db2 = raw type_int_bits(x.fe.ctx.types, wid);
    string:mn2 = raw tbb_min_decimal(db2);
    string:mx2 = raw tbb_max_decimal(db2);
    if (mn2.len == 0i64) { pass (raw iv_broken(n.span)); }

    if (sk == (raw TY_FLOAT())) {
        // Compare in DOUBLE so one bound table serves both float widths;
        // strict bounds exclude the sentinel, and NaN fails every ordered
        // compare, so `!in` covers garbage of every kind.
        string:cv = v.ref;
        string:cll = v.ll;
        if (raw string_eq(v.ll, "float")) {
            string:xt = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat3(xt, " = fpext float ",
                              relay string_concat(v.ref, " to double")));
            cv = xt;
            cll = "double";
        }
        string:pgt = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(pgt, " = fcmp ogt double ", cv, ", ",
                          raw tbb_pow_hex(db2, true)));
        string:plt = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(plt, " = fcmp olt double ", cv, ", ",
                          raw tbb_pow_hex(db2, false)));
        string:inr = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(inr, " = and i1 ", pgt, ", ", plt));
        if (!unchecked) {
            string:bad2 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat3(bad2, " = xor i1 ",
                              relay string_concat(inr, ", true")));
            drop tbb_trap_if(x, bad2);
            string:q = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(q, " = fptosi ", v.ll, " ",
                              relay cat3(v.ref, " to ", want.text)));
            pass (raw iv(want.text, q, wid));
        }
        string:q2 = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(q2, " = fptosi ", v.ll, " ",
                          relay cat3(v.ref, " to ", want.text)));
        string:res4 = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(res4, " = select i1 ", inr, ", ",
                          relay cat5(want.text, " ", q2, ", ",
                              relay cat3(want.text, " ", mn2))));
        pass (raw iv(want.text, res4, wid));
    }

    // int → tbb. A strictly narrower source always fits the valid range; a
    // same-or-wider one is range-checked in ITS OWN width, which is where the
    // information still exists.
    bool:ssig = raw type_is_signed(x.fe.ctx.types, v.type_id);
    int64:sw = relay ll_int_width(v.ll);
    int64:dw = relay ll_int_width(want.text);
    if (sw >= dw) {
        string:oor2 = "";
        if (ssig) {
            string:h3 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(h3, " = icmp sgt ", v.ll, " ",
                              relay cat3(v.ref, ", ", mx2)));
            string:l3 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(l3, " = icmp slt ", v.ll, " ",
                              relay cat4(v.ref, ", -", mx2, "")));
            string:o3 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(o3, " = or i1 ", h3, ", ", l3));
            oor2 = o3;
        } else {
            string:o4 = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(o4, " = icmp ugt ", v.ll, " ",
                              relay cat3(v.ref, ", ", mx2)));
            oor2 = o4;
        }
        if (!unchecked) {
            drop tbb_trap_if(x, oor2);
            string:rz4 = raw tbb_resize(x, v.ll, v.ref, want.text, ssig);
            pass (raw iv(want.text, rz4, wid));
        }
        string:rz5 = raw tbb_resize(x, v.ll, v.ref, want.text, ssig);
        string:res5 = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(res5, " = select i1 ", oor2, ", ",
                          relay cat5(want.text, " ", mn2, ", ",
                              relay cat3(want.text, " ", rz5))));
        pass (raw iv(want.text, res5, wid));
    }
    string:rz6 = raw tbb_resize(x, v.ll, v.ref, want.text, ssig);
    pass (raw iv(want.text, rz6, wid));
};

func:emit_cast = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    IrVal:v = relay emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }
    LlType:want = relay node_ll(x, id);
    if (want.state != (raw LL_OK())) {
        pass (relay iv_from_ll_at(x, want, raw exprtypes_get(x.et, id), n.span));
    }
    int32:wid = raw exprtypes_get(x.et, id);

    if (raw string_eq(v.ll, want.text)) {
        pass (raw iv(want.text, v.ref, wid));
    }

    // `enum =>! intN` — the TAG is the number (0.8.0, settled with the user). A
    // payload-less enum already IS its `i32` tag; a payload-carrying one holds
    // the tag in slot 0, so the cast extracts it and then proceeds as a scalar.
    if ((raw type_kind(x.fe.ctx.types, v.type_id)) == (raw TY_ENUM())) {
        if (!(raw string_eq(v.ll, "i32"))) {
            string:tag = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(tag, " = extractvalue ", v.ll, " ",
                              relay string_concat(v.ref, ", 0")));
            v = raw iv("i32", tag, v.type_id);
        }
        if (raw string_eq(v.ll, want.text)) {
            pass (raw iv(want.text, v.ref, wid));
        }
    }

    // A tbb ON EITHER SIDE takes the matrix (0.9.5) — the generic scalar path
    // below would trunc/sext the carrier raw, which is exactly the forge and
    // launder the matrix exists to end.
    if ((raw type_kind(x.fe.ctx.types, v.type_id)) == (raw TY_TBB())) {
        pass (relay emit_tbb_cast(x, id, n, v, want, wid));
    }
    if ((raw type_kind(x.fe.ctx.types, wid)) == (raw TY_TBB())) {
        pass (relay emit_tbb_cast(x, id, n, v, want, wid));
    }

    // FLOAT CASTS (0.9.4). The frontend already decided legality and loss
    // (float→int is always `=>!`; int→float and float-widening follow the
    // value-range rules); this only picks the instruction.
    bool:src_f = raw ll_is_float_text(v.ll);
    bool:dst_f = raw ll_is_float_text(want.text);
    if (src_f) {
        string:fr2 = relay irw_temp(x.fe.w);
        if (dst_f) {
            // float↔float by width: double→float truncates, float→double extends.
            if (raw string_eq(v.ll, "double")) {
                drop irw_line(x.fe.w, relay cat5(fr2, " = fptrunc double ",
                                  v.ref, " to ", want.text));
            } else {
                drop irw_line(x.fe.w, relay cat5(fr2, " = fpext ", v.ll, " ",
                                  relay cat3(v.ref, " to ", want.text)));
            }
            pass (raw iv(want.text, fr2, wid));
        }
        // float→int: signedness of the TARGET picks the instruction.
        bool:dsig = raw type_is_signed(x.fe.ctx.types, wid);
        if (dsig) {
            drop irw_line(x.fe.w, relay cat5(fr2, " = fptosi ", v.ll, " ",
                              relay cat3(v.ref, " to ", want.text)));
        } else {
            drop irw_line(x.fe.w, relay cat5(fr2, " = fptoui ", v.ll, " ",
                              relay cat3(v.ref, " to ", want.text)));
        }
        pass (raw iv(want.text, fr2, wid));
    }
    if (dst_f) {
        // int→float: signedness of the SOURCE picks the instruction.
        string:fr3 = relay irw_temp(x.fe.w);
        bool:ssig = raw type_is_signed(x.fe.ctx.types, v.type_id);
        if ((raw type_kind(x.fe.ctx.types, v.type_id)) == (raw TY_TBB())) { ssig = true; }
        if (ssig) {
            drop irw_line(x.fe.w, relay cat5(fr3, " = sitofp ", v.ll, " ",
                              relay cat3(v.ref, " to ", want.text)));
        } else {
            drop irw_line(x.fe.w, relay cat5(fr3, " = uitofp ", v.ll, " ",
                              relay cat3(v.ref, " to ", want.text)));
        }
        pass (raw iv(want.text, fr3, wid));
    }

    LlType:src_l = LlType{ state: raw LL_OK(), text: v.ll, rung: "" };
    LlType:dst_l = want;
    if (!(raw ll_is_scalar_int(src_l))) {
        pass (raw iv_rung("a cast between non-scalar types", "0.9", n.span));
    }
    if (!(raw ll_is_scalar_int(dst_l))) {
        pass (raw iv_rung("a cast between non-scalar types", "0.9", n.span));
    }

    int64:sbits = relay ll_int_width(v.ll);
    int64:dbits = relay ll_int_width(want.text);
    string:r = relay irw_temp(x.fe.w);
    if (sbits > dbits) {
        drop irw_line(x.fe.w, relay cat5(r, " = trunc ", v.ll, " ",
                          relay cat3(v.ref, " to ", want.text)));
        pass (raw iv(want.text, r, wid));
    }
    bool:src_signed = false;
    int32:st = v.type_id;
    if ((raw type_kind(x.fe.ctx.types, st)) == (raw TY_INT())) {
        src_signed = raw type_is_signed(x.fe.ctx.types, st);
    }
    // `tbb` widens by SIGN: the carrier is signed by construction (negative
    // codes, INT32_MIN sentinel), and this arm exists because the TY_INT guard
    // above deliberately does not speak for other kinds.
    if ((raw type_kind(x.fe.ctx.types, st)) == (raw TY_TBB())) {
        src_signed = true;
    }
    if (src_signed) {
        drop irw_line(x.fe.w, relay cat5(r, " = sext ", v.ll, " ",
                          relay cat3(v.ref, " to ", want.text)));
    } else {
        drop irw_line(x.fe.w, relay cat5(r, " = zext ", v.ll, " ",
                          relay cat3(v.ref, " to ", want.text)));
    }
    pass (raw iv(want.text, r, wid));
};

// "i32" -> 32. Only ever called on text `ll_is_scalar_int` accepted.
func:ll_int_width = int64(string:ll) {
    int64:n = 0i64;
    int64:i = 1i64;
    while (i < ll.len) {
        n = (n * 10i64) + ((ll.ptr[i] => int64) - 48i64);
        i = i + 1i64;
    }
    pass n;
};

// --- calls --------------------------------------------------------------------------

func:emit_call = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    ExprId:callee = raw expr_callee(n);
    if (raw expr_is_none(callee)) { pass (raw iv_broken(n.span)); }
    ExprNode:cnode = relay ast_expr(x.ast, callee);
    if (cnode.kind == ExprKind.ExprMemberAccessExpr) {
        pass (relay emit_enum_ctor(x, id, n, cnode));
    }
    if (cnode.kind != ExprKind.ExprIdentifierExpr) {
        // An indirect call — through a function value. D-087 gives it a type;
        // calling through one is 0.9's.
        pass (raw iv_rung("an indirect call", "0.9", n.span));
    }

    int32:gcount = raw expr_generic_count(n);
    int32:start = (raw expr_list_start(n)) + gcount;
    int32:count = (raw expr_list_count(n)) - gcount;
    if (gcount > 0i32) { pass (raw iv_rung("a generic call", "1.0", n.span)); }

    // A BUILTIN EMITS ITS OWN ARGUMENTS: two lower inline without a call at
    // all, and the floor's signatures are the coercion authority for the rest —
    // a user call needs neither, so the paths split before the argument walk.
    if (cnode.a == 0i32) {
        pass (relay call_builtin(x, n, cnode, start, count));
    }

    // Arguments in source order, each with its own frontend-recorded type. No
    // `want` coercion anywhere: D-092 has no implicit widening, so the checker
    // already made every argument EXACTLY its parameter's type.
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: relay ast_id_at(x.ast, start, i) };
        IrVal:av = relay emit_expr(x, aid);
        if (av.state != (raw LL_OK())) { pass av; }
        if (i > 0i32) { args = relay string_concat(args, ", "); }
        args = relay cat3(args, av.ll, relay string_concat(" ", av.ref));
        i = i + 1i32;
    }

    // A user function: the symbol names the declaration, the declaration names
    // the function, and the call's own recorded type is the full `Result<T>`.
    Symbol:s = raw symtab_get(x.tab, cnode.a);
    string:fname = relay intern_get(x.interns, s.name);
    string:sym = relay ir_symbol(fname);
    LlType:ret = relay node_ll(x, id);
    if (ret.state != (raw LL_OK())) {
        pass (relay iv_from_ll_at(x, ret, raw exprtypes_get(x.et, id), n.span));
    }

    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = call ", ret.text, " ",
                      relay cat4(sym, "(", args, ")")));
    int32:rt_id = raw exprtypes_get(x.et, id);
    IrVal:out = raw iv(ret.text, r, rt_id);
    out.wrapped = true;
    // `Result<NIL>` has no value half; everything else's is the type it declares.
    out.inner = "";
    int32:inner_id = raw type_elem(x.fe.ctx.types, rt_id);
    if ((raw type_kind(x.fe.ctx.types, inner_id)) != (raw TY_NIL())) {
        LlType:it = relay ll_type(x.fe.ctx, inner_id);
        if (it.state != (raw LL_OK())) {
            pass (relay iv_from_ll_at(x, it, inner_id, n.span));
        }
        out.inner = it.text;
    }
    pass out;
};

func:call_builtin = IrVal(ExprEmitter->:x, ExprNode:n, ExprNode:cnode,
                          int32:start, int32:count) {
    string:name = relay intern_get(x.interns, cnode.payload =>! int32);

    // TWO LOWER INLINE, because their whole body is a field read: a string's
    // byte length IS its second slot, and emptiness is that slot against zero.
    // A call would be a symbol, a frame, and a return for an extractvalue.
    if (raw string_eq(name, "string_byte_length")) {
        IrVal:sv = relay emit_expr(x, ExprId{ index: relay ast_id_at(x.ast,
                                       start, 0i32) });
        if (!(raw iv_is_ok(sv))) { pass sv; }
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(r, " = extractvalue ", sv.ll, " ",
                          relay string_concat(sv.ref, ", 1")));
        pass (raw iv("i64", r, 0i32));
    }
    if (raw string_eq(name, "string_is_empty")) {
        IrVal:sv = relay emit_expr(x, ExprId{ index: relay ast_id_at(x.ast,
                                       start, 0i32) });
        if (!(raw iv_is_ok(sv))) { pass sv; }
        string:ln = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(ln, " = extractvalue ", sv.ll, " ",
                          relay string_concat(sv.ref, ", 1")));
        string:c = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(c, " = icmp eq i64 ",
                          relay string_concat(ln, ", 0")));
        string:z = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(z, " = zext i1 ",
                          relay string_concat(c, " to i8")));
        pass (raw iv("i8", z, 0i32));
    }

    RtSig:sig = raw rt_sig(name);
    if (!sig.found) {
        // `sys(CONST, ..*int64[])` is the one remaining bare builtin with no
        // floor entry, and its blocker is named: it is VARIADIC, and variadics
        // are 0.9's machinery (D-047/D-048 settled its shape long ago).
        if (raw string_eq(name, "sys")) {
            pass (raw iv_rung("the `sys` builtin", "0.9", cnode.span));
        }
        string:what = relay cat3("the builtin `", name, "`");
        pass (raw iv_rung(what, "0.8", cnode.span));
    }

    // THE FLOOR'S SIGNATURE IS THE COERCION AUTHORITY. Builtin arguments are
    // deliberately loose in the checker ("its signature arrives with call
    // checking"), so a scalar that arrives wider or narrower than the runtime's
    // parameter is adjusted HERE — `memset`'s value is `int64` in the language
    // and `i32` at the symbol, and an uncoerced call is IR llc rejects.
    string:args = "";
    int32:i = 0i32;
    while (i < count) {
        ExprId:aid = ExprId{ index: relay ast_id_at(x.ast, start, i) };
        IrVal:av = relay emit_expr(x, aid);
        if (av.state != (raw LL_OK())) { pass av; }
        string:want = raw rt_arg(sig, i);
        string:ref = av.ref;
        string:ll = av.ll;
        if (i < sig.argc) {
            if (!(raw string_eq(ll, want))) {
                LlType:src_l = LlType{ state: raw LL_OK(), text: ll, rung: "" };
                LlType:dst_l = LlType{ state: raw LL_OK(), text: want, rung: "" };
                if (raw ll_is_scalar_int(src_l)) {
                    if (raw ll_is_scalar_int(dst_l)) {
                        string:cv = relay irw_temp(x.fe.w);
                        if ((relay ll_int_width(ll)) > (relay ll_int_width(want))) {
                            drop irw_line(x.fe.w, relay cat5(cv, " = trunc ", ll,
                                              " ", relay cat3(ref, " to ", want)));
                        } else {
                            drop irw_line(x.fe.w, relay cat5(cv, " = zext ", ll,
                                              " ", relay cat3(ref, " to ", want)));
                        }
                        ref = cv;
                        ll = want;
                    }
                }
            }
        }
        if (i > 0i32) { args = relay string_concat(args, ", "); }
        args = relay cat3(args, ll, relay string_concat(" ", ref));
        i = i + 1i32;
    }

    if (raw string_eq(sig.ret, "void")) {
        drop irw_line(x.fe.w, relay cat5("call void ", sig.sym, "(", args, ")"));
        pass (raw iv("i32", "0", 0i32));
    }
    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = call ", sig.ret, " ",
                      relay cat4(sig.sym, "(", args, ")")));
    IrVal:out = raw iv(sig.ret, r, 0i32);
    out.wrapped = sig.wrapped;
    out.inner = sig.inner;
    pass out;
};

// --- `raw` --------------------------------------------------------------------------

// Unwrap without looking: the value half, whatever the error said. The analyses
// already decided where that is allowed; here it is just an extract.
// `relay` — unwrap, or return the caller's error VERBATIM (D-080). A normal
// exit path: the defer stack runs on the error branch, exactly as a `fail`
// there would run it, and that is why this module and `ir_stmt` are a cycle.
func:emit_relay = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    IrVal:v = relay emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }
    int32:my_t = raw exprtypes_get(x.et, id);
    // Type-driven, flag as fallback — the same repair `emit_raw` records.
    int32:ot = raw exprtypes_get(x.et, raw expr_operand(n));
    if ((raw type_kind(x.fe.ctx.types, ot)) == (raw TY_RESULT())) {
        int32:in_t = raw type_elem(x.fe.ctx.types, ot);
        v.wrapped = true;
        v.inner = "";
        if ((raw type_kind(x.fe.ctx.types, in_t)) != (raw TY_NIL())) {
            LlType:il = relay ll_type(x.fe.ctx, in_t);
            if (!(raw ll_is_ok(il))) {
                pass (relay iv_from_ll_at(x, il, in_t, n.span));
            }
            v.inner = il.text;
        }
    }
    if (!v.wrapped) { pass (raw iv(v.ll, v.ref, my_t)); }

    // The value half first — only the ok path needs it, but extracting before
    // the branch keeps every extract in the block that computed the Result.
    string:val = "";
    if (v.inner.len > 0i64) {
        val = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(val, " = extractvalue ", v.ll, " ",
                          relay string_concat(v.ref, ", 0")));
    }
    // The error field: slot 1, or slot 0 of a `Result<NIL>` (D-084 collapsed
    // the value away).
    string:idx = ", 1";
    if (v.inner.len == 0i64) { idx = ", 0"; }
    string:code = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(code, " = extractvalue ", v.ll, " ",
                      relay string_concat(v.ref, idx)));
    string:bad = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat3(bad, " = icmp ne i32 ",
                      relay string_concat(code, ", 0")));
    string:err_l = relay irw_new_label(x.fe.w, "relay.err");
    string:ok_l = relay irw_new_label(x.fe.w, "relay.ok");
    drop irw_line(x.fe.w, relay cat5("br i1 ", bad, ", label %", err_l,
                      relay string_concat(", label %", ok_l)));
    x.fe.terminated = true;

    drop s_start(x, err_l);
    // EVERY frame runs — relay exits the whole function, so its error path owes
    // the same cleanup a `fail` here would owe.
    IrVal:d = relay run_all_defers(x);
    if (!(raw iv_is_ok(d))) { pass d; }
    drop fnem_ret_fail(x.fe, code);
    x.fe.terminated = true;

    drop s_start(x, ok_l);
    if (v.inner.len == 0i64) { pass (raw iv("i32", "0", my_t)); }
    pass (raw iv(v.inner, val, my_t));
};

func:emit_raw = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    IrVal:v = relay emit_expr(x, raw expr_operand(n));
    if (v.state != (raw LL_OK())) { pass v; }
    int32:my_t = raw exprtypes_get(x.et, id);

    // THE OPERAND'S RECORDED TYPE DECIDES, and the call-side flag is only the
    // fallback for the one place the type is deliberately unknown (a builtin
    // call). The first version asked only the flag, and the flag is set by
    // CALLS — so `raw r` over a Result-typed LOCAL passed the whole `{T, i32}`
    // through as the value, and `llc` refused the insertvalue two lines later.
    int32:ot = raw exprtypes_get(x.et, raw expr_operand(n));
    bool:is_result = ((raw type_kind(x.fe.ctx.types, ot)) == (raw TY_RESULT()));
    if (!is_result) {
        if (!v.wrapped) {
            // Genuinely plain — a bare-`ptr` builtin, or already unwrapped.
            pass (raw iv(v.ll, v.ref, my_t));
        }
    }

    string:inner_ll = v.inner;
    if (is_result) {
        int32:in_t = raw type_elem(x.fe.ctx.types, ot);
        if ((raw type_kind(x.fe.ctx.types, in_t)) == (raw TY_NIL())) {
            inner_ll = "";
        } else {
            LlType:il = relay ll_type(x.fe.ctx, in_t);
            if (!(raw ll_is_ok(il))) {
                pass (relay iv_from_ll_at(x, il, in_t, n.span));
            }
            inner_ll = il.text;
        }
    }
    if (inner_ll.len == 0i64) {
        // `Result<NIL>`: the value half is nothing, spelled `i32 0`.
        pass (raw iv("i32", "0", my_t));
    }
    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = extractvalue ", v.ll, " ",
                                     relay string_concat(v.ref, ", 0")));
    pass (raw iv(inner_ll, r, my_t));
};

// --- places (0.7.7) ---------------------------------------------------------------
//
// A PLACE IS AN ADDRESS WITH A TYPE. Assignment stores through one, `@` hands one
// out, an index into an array needs one. Everything else in the emitter is
// value-based — which was enough until the compiler's own sources demanded
// `list.items[n] = d`, which is the seed's history too.

pub struct:PlaceVal = {
    int32:state;
    string:rung;
    string:what;
    Span:at;
    string:addr;      // a `ptr`-typed ref
    int32:type_id;    // what is stored there
};

func:pv = PlaceVal(string:addr, int32:type_id) {
    PlaceVal:p = PlaceVal{ state: raw LL_OK(), rung: "", what: "",
                           at: raw span_none(), addr: addr, type_id: type_id };
    pass p;
};

func:pv_rung = PlaceVal(string:what, string:rung, Span:at) {
    PlaceVal:p = PlaceVal{ state: raw LL_RUNG(), rung: rung, what: what, at: at,
                           addr: "", type_id: 0i32 };
    pass p;
};

func:pv_broken = PlaceVal(Span:at) {
    PlaceVal:p = PlaceVal{ state: raw LL_BROKEN(), rung: "", what: "", at: at,
                           addr: "", type_id: 0i32 };
    pass p;
};

pub func:iv_from_place = IrVal(PlaceVal:p) {
    if (p.state == (raw LL_RUNG())) { pass (raw iv_rung(p.what, p.rung, p.at)); }
    pass (raw iv_broken(p.at));
};

func:pv_from_iv = PlaceVal(IrVal:v) {
    if (v.state == (raw LL_RUNG())) { pass (raw pv_rung(v.what, v.rung, v.at)); }
    pass (raw pv_broken(v.at));
};

// The field index inside a builtin aggregate, or -1. One table for the three
// `{…}`-shaped builtins, because `.ptr` meaning slot 0 is a fact about all of
// them and stating it three times is two chances to drift.
func:builtin_field_index = int32(ExprEmitter->:x, int32:kind, int32:name) {
    string:f = relay intern_get(x.interns, name);
    if (raw string_eq(f, "ptr")) { pass 0i32; }
    if (raw string_eq(f, "len")) { pass 1i32; }
    if (kind == (raw TY_STRING())) {
        if (raw string_eq(f, "cap")) { pass 2i32; }
    }
    pass (0i32 - 1i32);
};

// The address of a place expression: a name, a field, an element, or a pointee.
pub func:addr_of = PlaceVal(ExprEmitter->:x, ExprId:id) {
    ExprNode:n = relay ast_expr(x.ast, id);

    if (n.kind == ExprKind.ExprIdentifierExpr) {
        LocalSlot:s = raw fnem_lookup(x.fe, n.payload =>! int32);
        if (!s.found) {
            pass (raw pv_rung("assignment to a name that is not a local",
                              "0.8", n.span));
        }
        pass (raw pv(s.slot, s.type_id));
    }

    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        ExprId:base_id = raw expr_operand(n);
        PlaceVal:base = relay addr_of(x, base_id);
        if (base.state != (raw LL_OK())) { pass base; }
        int32:btid = base.type_id;
        string:baddr = base.addr;

        // `.` AUTO-DEREFERENCES (D-006): through a pointer field, the pointee's
        // address is one load away, and the source spells both accesses the
        // same because the intent is the same.
        if ((raw type_kind(x.fe.ctx.types, btid)) == (raw TY_POINTER())) {
            string:loaded = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat3(loaded, " = load ptr, ptr ", baddr));
            baddr = loaded;
            btid = raw type_elem(x.fe.ctx.types, btid);
        }

        int32:bkind = raw type_kind(x.fe.ctx.types, btid);
        LlType:bll = relay ll_type(x.fe.ctx, btid);
        if (!(raw ll_is_ok(bll))) {
            pass (raw pv_rung("a field of an unlowered type", bll.rung, n.span));
        }

        int32:idx = 0i32 - 1i32;
        int32:fty = raw exprtypes_get(x.et, id);
        if (bkind == (raw TY_STRING()))  { idx = raw builtin_field_index(x, bkind, n.payload =>! int32); }
        if (bkind == (raw TY_CSTRING())) { idx = raw builtin_field_index(x, bkind, n.payload =>! int32); }
        if (bkind == (raw TY_SLICE()))   { idx = raw builtin_field_index(x, bkind, n.payload =>! int32); }
        if (bkind == (raw TY_STRUCT())) {
            FieldInfo:fi = relay struct_field(x.tr, btid, n.payload =>! int32,
                                              x.scope);
            if (!fi.found) { pass (raw pv_broken(n.span)); }
            idx = fi.index;
            fty = fi.type_id;
        }
        if (idx < 0i32) { pass (raw pv_broken(n.span)); }

        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(r, " = getelementptr ", bll.text,
                          ", ptr ", relay cat3(baddr, ", i32 0, i32 ",
                              raw int_to_string(idx => int64))));
        pass (raw pv(r, fty));
    }

    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:obj_tid = raw exprtypes_get(x.et, raw expr_lhs(n));
        int32:okind = raw type_kind(x.fe.ctx.types, obj_tid);
        int32:elem_tid = raw exprtypes_get(x.et, id);
        LlType:ell = relay ll_type(x.fe.ctx, elem_tid);
        if (!(raw ll_is_ok(ell))) {
            pass (raw pv_rung("an element of an unlowered type", ell.rung, n.span));
        }

        // A SLICE'S BOUNDS LIVE ON IT AND ARE CHECKED HERE (0.9.2, D-070):
        // the length rides in the value, the index compares against it
        // unsigned, and out-of-range traps to `failsafe` — where OOB
        // detection COMES FROM, since pointers are thin (D-038) and carry
        // nothing to check.
        if (okind == (raw TY_SLICE())) {
            IrVal:ov = relay emit_expr(x, raw expr_lhs(n));
            if (!(raw iv_is_ok(ov))) { pass (raw pv_from_iv(ov)); }
            IrVal:ix = relay emit_expr(x, raw expr_rhs(n));
            if (!(raw iv_is_ok(ix))) { pass (raw pv_from_iv(ix)); }
            string:slen = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(slen, " = extractvalue ", ov.ll,
                              " ", relay string_concat(ov.ref, ", 1")));
            string:idx64 = raw index_as_i64(x, ix);
            drop emit_bounds_guard(x, idx64, slen);
            string:data = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(data, " = extractvalue ", ov.ll,
                              " ", relay string_concat(ov.ref, ", 0")));
            string:r = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(r, " = getelementptr ", ell.text,
                              ", ptr ", relay cat4(data, ", i64 ", idx64, "")));
            pass (raw pv(r, elem_tid));
        }
        if (okind == (raw TY_POINTER())) {
            IrVal:ov = relay emit_expr(x, raw expr_lhs(n));
            if (!(raw iv_is_ok(ov))) { pass (raw pv_from_iv(ov)); }
            IrVal:ix = relay emit_expr(x, raw expr_rhs(n));
            if (!(raw iv_is_ok(ix))) { pass (raw pv_from_iv(ix)); }
            string:r = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(r, " = getelementptr ", ell.text,
                              ", ptr ", relay cat5(ov.ref, ", ", ix.ll, " ", ix.ref)));
            pass (raw pv(r, elem_tid));
        }
        if (okind == (raw TY_ARRAY())) {
            // A VALUE type: its elements are reached through ITS address, and
            // `i64 0` steps through the array-of-one that address denotes.
            // The bound is the TYPE'S constant (D-070), and a dynamic index
            // still checks against it at run time (0.9.2) — a static bound
            // does not make the index static.
            PlaceVal:base = relay addr_of(x, raw expr_lhs(n));
            if (base.state != (raw LL_OK())) { pass base; }
            LlType:all = relay ll_type(x.fe.ctx, obj_tid);
            if (!(raw ll_is_ok(all))) { pass (raw pv_broken(n.span)); }
            IrVal:ix = relay emit_expr(x, raw expr_rhs(n));
            if (!(raw iv_is_ok(ix))) { pass (raw pv_from_iv(ix)); }
            string:idx64 = raw index_as_i64(x, ix);
            string:bound = raw int_to_string(
                (raw type_array_count(x.fe.ctx.types, obj_tid)) => int64);
            drop emit_bounds_guard(x, idx64, bound);
            string:r = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(r, " = getelementptr ", all.text,
                              ", ptr ", relay cat4(base.addr, ", i64 0, ",
                                  relay cat3("i64 ", idx64, ""), "")));
            pass (raw pv(r, elem_tid));
        }
        pass (raw pv_broken(n.span));
    }

    // `<-p = v` — the place IS the pointer's value.
    if (n.kind == ExprKind.ExprDerefExpr) {
        IrVal:v = relay emit_expr(x, raw expr_operand(n));
        if (!(raw iv_is_ok(v))) { pass (raw pv_from_iv(v)); }
        pass (raw pv(v.ref, raw exprtypes_get(x.et, id)));
    }

    pass (raw pv_broken(n.span));
};

// --- enum variants ----------------------------------------------------------------

pub struct:VariantInfo = {
    bool:found;
    int32:tag;
    int32:payload_count;
    TypeId:payload_ty;    // the FIRST payload's type node; resolve at use
};

// The tag is the DECLARED value where one is given — `Retry = 3i32` lowers to 3,
// not to its position — and the POSITION otherwise, which is the seed's rule
// exactly. The declared value must be an integer literal; the checker said so
// before this runs.
pub func:variant_info = VariantInfo(ExprEmitter->:x, int32:enum_tid, int32:name) {
    VariantInfo:none = VariantInfo{ found: false, tag: 0i32, payload_count: 0i32,
                                    payload_ty: raw type_none() };
    if ((raw type_kind(x.fe.ctx.types, enum_tid)) != (raw TY_ENUM())) { pass none; }
    DeclId:did = DeclId{ index: raw type_decl(x.fe.ctx.types, enum_tid) };
    DeclNode:d = relay ast_decl(x.ast, did);
    int32:i = 0i32;
    while (i < (raw item_member_count(x.ast, d))) {
        DeclNode:m = relay ast_decl(x.ast, raw item_member(x.ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == name) {
                int32:tag = i;
                ExprId:ve = raw variant_value(m);
                if (!(raw expr_is_none(ve))) {
                    ExprNode:vn = relay ast_expr(x.ast, ve);
                    if (vn.kind == ExprKind.ExprIntLiteral) {
                        tag = vn.payload =>! int32;
                    }
                }
                TypeId:pt = raw type_none();
                if ((raw variant_payload_count(m)) > 0i32) {
                    pt = TypeId{ index: relay ast_id_at(x.ast,
                                     raw variant_payload_start(m), 0i32) };
                }
                VariantInfo:v = VariantInfo{ found: true, tag: tag,
                                             payload_count: raw variant_payload_count(m),
                                             payload_ty: pt };
                pass v;
            }
        }
        i = i + 1i32;
    }
    pass none;
};

// Is this member access `Enum.Variant`? The base must be an identifier whose
// symbol is an enum DECLARATION — a value of enum type takes the other path.
func:member_enum_decl = int32(ExprEmitter->:x, ExprNode:n) {
    ExprId:b = raw expr_operand(n);
    if (raw expr_is_none(b)) { pass 0i32; }
    ExprNode:bnode = relay ast_expr(x.ast, b);
    if (bnode.kind != ExprKind.ExprIdentifierExpr) { pass 0i32; }
    if (bnode.a == 0i32) { pass 0i32; }
    Symbol:sym = raw symtab_get(x.tab, bnode.a);
    if (sym.origin_kind != (raw SYM_DECL())) { pass 0i32; }
    DeclId:did = DeclId{ index: sym.origin };
    DeclNode:d = relay ast_decl(x.ast, did);
    if (d.kind != DeclKind.DeclEnumDecl) { pass 0i32; }
    pass sym.origin;
};

// A payload-less variant as a value: the tag, in whichever shape the ENUM takes —
// a plain `i32` when no variant anywhere carries a payload, a `{tag, 0}` pair
// when one does, because the TYPE has one layout however this variant travels.
func:emit_variant_ref = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    int32:etid = raw exprtypes_get(x.et, id);
    VariantInfo:vi = raw variant_info(x, etid, n.payload =>! int32);
    if (!vi.found) { pass (raw iv_broken(n.span)); }
    string:tag = raw int_to_string(vi.tag => int64);
    if (!(relay enum_has_payload(x.ast, x.fe.ctx.types, etid))) {
        pass (raw iv("i32", tag, etid));
    }
    LlType:ell = relay ll_type(x.fe.ctx, etid);
    if (!(raw ll_is_ok(ell))) { pass (relay iv_from_ll_at(x, ell, etid, n.span)); }
    // OVER zeroinitializer, not undef, and only the tag is inserted: the
    // payload slot is `[N x iK]` (0.9.2) and writing "i64 0" into it stopped
    // being well-typed the day payloads outgrew one word. Zeroed payload bytes
    // also keep a payload-less variant deterministic wherever it travels.
    string:a = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(a, " = insertvalue ", ell.text,
                      " zeroinitializer, i32 ", relay string_concat(tag, ", 0")));
    pass (raw iv(ell.text, a, etid));
};

// `Net.Disconnect(code)` — the payload widens into the uniform `i64` word
// (SUBSET_1 §1.2), whatever its own width; `pick` narrows it back out. Reached
// through TWO parse shapes — a method call, and a call whose callee is a member
// access (`(Ev.Move)(5i32)`) — so the builder takes the name and the argument
// window rather than a node whose shape it would have to know.
func:emit_enum_ctor = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                            ExprNode:cnode) {
    int32:etid = raw exprtypes_get(x.et, id);
    if ((raw type_kind(x.fe.ctx.types, etid)) != (raw TY_ENUM())) {
        pass (raw iv_rung("a call through a member", "1.0", n.span));
    }
    int32:gcount = raw expr_generic_count(n);
    pass (relay emit_ctor(x, id, n.span, etid, cnode.payload =>! int32,
              (raw expr_list_start(n)) + gcount,
              (raw expr_list_count(n)) - gcount));
};

func:emit_ctor = IrVal(ExprEmitter->:x, ExprId:id, Span:at, int32:etid,
                       int32:vname, int32:start, int32:count) {
    if ((raw type_kind(x.fe.ctx.types, etid)) != (raw TY_ENUM())) {
        pass (raw iv_rung("a call through a member", "1.0", at));
    }
    VariantInfo:vi = raw variant_info(x, etid, vname);
    if (!vi.found) { pass (raw iv_broken(at)); }
    LlType:ell = relay ll_type(x.fe.ctx, etid);
    if (!(raw ll_is_ok(ell))) { pass (relay iv_from_ll_at(x, ell, etid, at)); }

    // A payload-less variant spelled with parentheses: the same value its bare
    // reference builds.
    if (!(relay enum_has_payload(x.ast, x.fe.ctx.types, etid))) {
        pass (raw iv("i32", raw int_to_string(vi.tag => int64), etid));
    }

    // MULTI-PAYLOAD CONSTRUCTION REFUSES rather than truncates. Before 0.9.2
    // this path consumed argument 0 and SILENTLY DROPPED the rest — a
    // miscompile found while generalising, not by any test. The pattern tail
    // (0.9.7) owns the multi-payload story end to end.
    if (count > 1i32) {
        pass (raw iv_rung("a multi-payload variant construction", "0.9", at));
    }

    // THE GENERAL CONSTRUCTION (0.9.2): through a stack slot, because the
    // payload slot is `[N x iK]` and the payload is stored AS ITS OWN TYPE
    // through a typed pointer — insertvalue cannot write a `{ptr,i64,i64}`
    // into an i64 array, and the widen-to-one-word shape it replaces emitted
    // invalid IR for any aggregate payload. Zero first, so a smaller payload
    // leaves no undefined bytes in the slot.
    string:tag = raw int_to_string(vi.tag => int64);
    string:tmp = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat3(tmp, " = alloca ", ell.text));
    drop irw_line(x.fe.w, relay cat5("store ", ell.text, " zeroinitializer, ptr ",
                      tmp, ""));
    string:tp = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(tp, " = getelementptr ", ell.text,
                      ", ptr ", relay string_concat(tmp, ", i32 0, i32 0")));
    drop irw_line(x.fe.w, relay cat5("store i32 ", tag, ", ptr ", tp, ""));
    if (count == 1i32) {
        ExprId:aid = ExprId{ index: relay ast_id_at(x.ast, start, 0i32) };
        IrVal:av = relay emit_expr(x, aid);
        if (!(raw iv_is_ok(av))) { pass av; }
        string:pp = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(pp, " = getelementptr ", ell.text,
                          ", ptr ", relay string_concat(tmp, ", i32 0, i32 1")));
        drop irw_line(x.fe.w, relay cat5("store ", av.ll, " ", av.ref,
                          relay string_concat(", ptr ", pp)));
    }
    string:whole = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(whole, " = load ", ell.text, ", ptr ",
                      relay string_concat(tmp, "")));
    pass (raw iv(ell.text, whole, etid));
};

// --- member and index reads --------------------------------------------------------

// A field READ goes through the VALUE — extractvalue — not through an address.
// One shape for every base, including one that has no address at all
// (`(raw f()).len`); the whole-aggregate load a pointer base implies is what
// naive lowering means, and `opt` scalarises it.
func:emit_member = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    if ((raw member_enum_decl(x, n)) != 0i32) {
        pass (relay emit_variant_ref(x, id, n));
    }

    ExprId:base_id = raw expr_operand(n);
    IrVal:bv = relay emit_expr(x, base_id);
    if (!(raw iv_is_ok(bv))) { pass bv; }
    int32:btid = raw exprtypes_get(x.et, base_id);

    if ((raw type_kind(x.fe.ctx.types, btid)) == (raw TY_POINTER())) {
        btid = raw type_elem(x.fe.ctx.types, btid);
        LlType:pl = relay ll_type(x.fe.ctx, btid);
        if (!(raw ll_is_ok(pl))) { pass (relay iv_from_ll_at(x, pl, btid, n.span)); }
        string:loaded = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(loaded, " = load ", pl.text, ", ptr ",
                                         bv.ref));
        bv = raw iv(pl.text, loaded, btid);
    }

    int32:bkind = raw type_kind(x.fe.ctx.types, btid);
    int32:idx = 0i32 - 1i32;
    int32:fty = raw exprtypes_get(x.et, id);
    string:fll = "";
    if (bkind == (raw TY_STRING())) {
        idx = raw builtin_field_index(x, bkind, n.payload =>! int32);
        fll = "i64";
        if (idx == 0i32) { fll = "ptr"; }
    }
    if (bkind == (raw TY_CSTRING())) {
        idx = raw builtin_field_index(x, bkind, n.payload =>! int32);
        fll = "i64";
        if (idx == 0i32) { fll = "ptr"; }
    }
    if (bkind == (raw TY_SLICE())) {
        idx = raw builtin_field_index(x, bkind, n.payload =>! int32);
        fll = "i64";
        if (idx == 0i32) { fll = "ptr"; }
    }
    // A `Result`'s three members (D-069): `value` is slot 0, `error` slot 1, and
    // `.is_error` is DERIVED as `error != 0` — no stored flag, so there is no
    // second place for the fact to live, and no way for the two to disagree.
    if (bkind == (raw TY_RESULT())) {
        string:f = relay intern_get(x.interns, n.payload =>! int32);
        int32:inner = raw type_elem(x.fe.ctx.types, btid);
        bool:inner_nil = ((raw type_kind(x.fe.ctx.types, inner)) == (raw TY_NIL()));
        if (raw string_eq(f, "value")) {
            if (inner_nil) { pass (raw iv("i32", "0", fty)); }
            LlType:il = relay ll_type(x.fe.ctx, inner);
            if (!(raw ll_is_ok(il))) { pass (relay iv_from_ll_at(x, il, inner, n.span)); }
            string:rv = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat5(rv, " = extractvalue ", bv.ll, " ",
                              relay string_concat(bv.ref, ", 0")));
            pass (raw iv(il.text, rv, fty));
        }
        string:eidx = ", 1";
        if (inner_nil) { eidx = ", 0"; }
        string:re = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(re, " = extractvalue ", bv.ll, " ",
                          relay string_concat(bv.ref, eidx)));
        if (raw string_eq(f, "error")) { pass (raw iv("i32", re, fty)); }
        if (raw string_eq(f, "is_error")) {
            string:cz = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat3(cz, " = icmp ne i32 ",
                              relay string_concat(re, ", 0")));
            string:z = relay irw_temp(x.fe.w);
            drop irw_line(x.fe.w, relay cat3(z, " = zext i1 ",
                              relay string_concat(cz, " to i8")));
            pass (raw iv("i8", z, fty));
        }
        pass (raw iv_broken(n.span));
    }
    if (bkind == (raw TY_STRUCT())) {
        FieldInfo:fi = relay struct_field(x.tr, btid, n.payload =>! int32, x.scope);
        if (!fi.found) { pass (raw iv_broken(n.span)); }
        idx = fi.index;
        fty = fi.type_id;
        LlType:fl = relay ll_type(x.fe.ctx, fi.type_id);
        if (!(raw ll_is_ok(fl))) {
            pass (relay iv_from_ll_at(x, fl, fi.type_id, n.span));
        }
        fll = fl.text;
    }
    if (idx < 0i32) { pass (raw iv_broken(n.span)); }

    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = extractvalue ", bv.ll, " ",
                      relay cat3(bv.ref, ", ", raw int_to_string(idx => int64))));
    pass (raw iv(fll, r, fty));
};

// An INDEX read is its place plus a load — an element's address exists by
// construction, and a dynamic index into an aggregate VALUE does not. A RANGE
// index is different in kind: `arr[lo...hi]` yields a VALUE, the `{ptr, len}`
// view D-070 describes, and takes the seed's shape exactly — element pointer
// moved to `lo`, length `hi - lo`.
func:emit_index = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    ExprNode:ix = relay ast_expr(x.ast, raw expr_rhs(n));
    if (ix.kind == ExprKind.ExprRangeExpr) {
        pass (relay emit_range_slice(x, id, n, ix));
    }
    PlaceVal:p = relay addr_of(x, id);
    if (p.state != (raw LL_OK())) { pass (relay iv_from_place(p)); }
    LlType:ell = relay ll_type(x.fe.ctx, p.type_id);
    if (!(raw ll_is_ok(ell))) { pass (relay iv_from_ll_at(x, ell, p.type_id, n.span)); }
    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = load ", ell.text, ", ptr ", p.addr));
    pass (raw iv(ell.text, r, p.type_id));
};

func:emit_range_slice = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n,
                              ExprNode:ix) {
    int32:obj_tid = raw exprtypes_get(x.et, raw expr_lhs(n));
    int32:okind = raw type_kind(x.fe.ctx.types, obj_tid);
    int32:elem_tid = raw type_elem(x.fe.ctx.types, obj_tid);
    LlType:ell = relay ll_type(x.fe.ctx, elem_tid);
    if (!(raw ll_is_ok(ell))) {
        pass (relay iv_from_ll_at(x, ell, elem_tid, n.span));
    }

    // The data pointer: an array's is its own address, a slice's is its first
    // field. Anything else cannot be ranged and the checker said so already.
    string:base = "";
    string:src_len = "";
    if (okind == (raw TY_ARRAY())) {
        PlaceVal:p = relay addr_of(x, raw expr_lhs(n));
        if (p.state != (raw LL_OK())) { pass (relay iv_from_place(p)); }
        base = p.addr;
        src_len = raw int_to_string(
            (raw type_array_count(x.fe.ctx.types, obj_tid)) => int64);
    }
    if (okind == (raw TY_SLICE())) {
        IrVal:ov = relay emit_expr(x, raw expr_lhs(n));
        if (!(raw iv_is_ok(ov))) { pass ov; }
        string:d = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(d, " = extractvalue ", ov.ll, " ",
                          relay string_concat(ov.ref, ", 0")));
        base = d;
        string:sl2 = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(sl2, " = extractvalue ", ov.ll, " ",
                          relay string_concat(ov.ref, ", 1")));
        src_len = sl2;
    }
    if (base.len == 0i64) { pass (raw iv_broken(n.span)); }

    IrVal:lo = relay emit_expr(x, raw expr_lhs(ix));
    if (!(raw iv_is_ok(lo))) { pass lo; }
    IrVal:hi = relay emit_expr(x, raw expr_rhs(ix));
    if (!(raw iv_is_ok(hi))) { pass hi; }

    // THE VIEW MUST FIT (0.9.2, D-070): `lo <= hi` and `hi <= len`, both
    // unsigned, or the trap — before this guard a range past the end
    // fabricated a slice into whatever came after, and `hi < lo` wrapped the
    // count to near-2^64. Unchecked, either one is the exact defect the slice
    // type exists to prevent.
    string:lo64 = raw index_as_i64(x, lo);
    string:hi64 = raw index_as_i64(x, hi);
    string:c1 = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(c1, " = icmp ule i64 ", lo64, ", ",
                      relay string_concat(hi64, "")));
    string:c2 = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(c2, " = icmp ule i64 ", hi64, ", ",
                      relay string_concat(src_len, "")));
    string:both = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(both, " = and i1 ", c1, ", ", c2));
    string:trap_l = relay irw_new_label(x.fe.w, "rng.oob");
    string:ok_l = relay irw_new_label(x.fe.w, "rng.ok");
    drop irw_line(x.fe.w, relay cat5("br i1 ", both, ", label %", ok_l,
                      relay string_concat(", label %", trap_l)));
    drop irw_label(x.fe.w, trap_l);
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4099)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, ok_l);

    string:g = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(g, " = getelementptr ", ell.text,
                      ", ptr ", relay cat4(base, ", i64 ", lo64, "")));
    string:cnt = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(cnt, " = sub i64 ", hi64, ", ", lo64));
    string:a = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat3(a, " = insertvalue { ptr, i64 } undef, ptr ",
                      relay string_concat(g, ", 0")));
    string:b = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(b, " = insertvalue { ptr, i64 } ", a,
                      ", i64 ", relay string_concat(cnt, ", 1")));
    pass (raw iv("{ ptr, i64 }", b, raw exprtypes_get(x.et, id)));
};

func:emit_addr_op = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    PlaceVal:p = relay addr_of(x, raw expr_operand(n));
    if (p.state != (raw LL_OK())) { pass (relay iv_from_place(p)); }
    pass (raw iv("ptr", p.addr, raw exprtypes_get(x.et, id)));
};

func:emit_deref = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    IrVal:v = relay emit_expr(x, raw expr_operand(n));
    if (!(raw iv_is_ok(v))) { pass v; }
    int32:elem = raw exprtypes_get(x.et, id);
    LlType:ell = relay ll_type(x.fe.ctx, elem);
    if (!(raw ll_is_ok(ell))) { pass (relay iv_from_ll_at(x, ell, elem, n.span)); }
    string:r = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(r, " = load ", ell.text, ", ptr ", v.ref));
    pass (raw iv(ell.text, r, elem));
};

// --- aggregate literals ------------------------------------------------------------

// `Point{ x: 1i32, y: 2i32 }` — one insertvalue per field, AT THE FIELD'S
// DECLARED INDEX, so the literal's written order never matters to the layout.
// The checker already refused an omitted field; this never re-checks.
func:emit_struct_lit = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    int32:stid = raw exprtypes_get(x.et, id);
    LlType:sll = relay ll_type(x.fe.ctx, stid);
    if (!(raw ll_is_ok(sll))) { pass (relay iv_from_ll_at(x, sll, stid, n.span)); }

    string:acc = "undef";
    int32:i = 0i32;
    int32:pairs = (raw expr_list_count(n)) / 2i32;
    while (i < pairs) {
        int32:fname = relay ast_id_at(x.ast, raw expr_list_start(n), i * 2i32);
        ExprId:vid = ExprId{ index: relay ast_id_at(x.ast,
                                 raw expr_list_start(n), (i * 2i32) + 1i32) };
        FieldInfo:fi = relay struct_field(x.tr, stid, fname, x.scope);
        if (!fi.found) { pass (raw iv_broken(n.span)); }
        IrVal:v = relay emit_expr(x, vid);
        if (!(raw iv_is_ok(v))) { pass v; }
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(r, " = insertvalue ", sll.text, " ",
                          relay cat5(acc, ", ", v.ll, " ",
                              relay cat4(v.ref, ", ",
                                  raw int_to_string(fi.index => int64), ""))));
        acc = r;
        i = i + 1i32;
    }
    pass (raw iv(sll.text, acc, stid));
};

func:emit_array_lit = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    int32:atid = raw exprtypes_get(x.et, id);
    LlType:all = relay ll_type(x.fe.ctx, atid);
    if (!(raw ll_is_ok(all))) { pass (relay iv_from_ll_at(x, all, atid, n.span)); }
    // `[]` is the zero array (0.8.1): absent means zero, as in `Result{…}`.
    if ((raw expr_list_count(n)) == 0i32) {
        pass (raw iv(all.text, "zeroinitializer", atid));
    }
    string:acc = "undef";
    int32:i = 0i32;
    while (i < (raw expr_list_count(n))) {
        ExprId:eid = ExprId{ index: relay ast_id_at(x.ast,
                                 raw expr_list_start(n), i) };
        IrVal:v = relay emit_expr(x, eid);
        if (!(raw iv_is_ok(v))) { pass v; }
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(r, " = insertvalue ", all.text, " ",
                          relay cat5(acc, ", ", v.ll, " ",
                              relay cat4(v.ref, ", ",
                                  raw int_to_string(i => int64), ""))));
        acc = r;
        i = i + 1i32;
    }
    pass (raw iv(all.text, acc, atid));
};

// `Result{ value: v, error: e }` — either field may be omitted and the omitted
// one is ZERO, which is D-069's derivation rule made concrete: no error means
// `error == 0`, and a failed Result's value slot is the type's zero.
func:emit_result_lit = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    int32:rtid = raw exprtypes_get(x.et, id);
    LlType:rll = relay ll_type(x.fe.ctx, rtid);
    if (!(raw ll_is_ok(rll))) { pass (relay iv_from_ll_at(x, rll, rtid, n.span)); }
    int32:inner = raw type_elem(x.fe.ctx.types, rtid);

    string:eref = "0";
    ExprId:ee = raw expr_rhs(n);
    if (!(raw expr_is_none(ee))) {
        IrVal:ev = relay emit_expr(x, ee);
        if (!(raw iv_is_ok(ev))) { pass ev; }
        eref = ev.ref;
    }

    if ((raw type_kind(x.fe.ctx.types, inner)) == (raw TY_NIL())) {
        string:a = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(a, " = insertvalue ", rll.text,
                          " undef, i32 ", relay string_concat(eref, ", 0")));
        pass (raw iv(rll.text, a, rtid));
    }

    LlType:ill = relay ll_type(x.fe.ctx, inner);
    if (!(raw ll_is_ok(ill))) { pass (relay iv_from_ll_at(x, ill, inner, n.span)); }
    string:vref = raw ll_zero(ill);
    ExprId:ve = raw expr_lhs(n);
    if (!(raw expr_is_none(ve))) {
        IrVal:vv = relay emit_expr(x, ve);
        if (!(raw iv_is_ok(vv))) { pass vv; }
        vref = vv.ref;
    }
    string:a = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(a, " = insertvalue ", rll.text, " undef, ",
                      relay cat4(ill.text, " ", vref, ", 0")));
    string:b = relay irw_temp(x.fe.w);
    drop irw_line(x.fe.w, relay cat5(b, " = insertvalue ", rll.text, " ",
                      relay cat4(a, ", i32 ", eref, ", 1")));
    pass (raw iv(rll.text, b, rtid));
};

// --- the three compiler builtins ---------------------------------------------------

func:emit_builtin = IrVal(ExprEmitter->:x, ExprId:id, ExprNode:n) {
    string:name = relay intern_get(x.interns, raw builtin_name(n));
    int32:gc = raw builtin_generic_count(n);
    int32:start = raw expr_list_start(n);

    // `#size_of<T>()` — ASK LLVM, never compute: gep one element past null and
    // read the offset. A hand-rolled size that disagrees with the one LLVM lays
    // out survives testing and corrupts memory later; this costs two
    // instructions `opt` folds away. The seed's shape, exactly.
    if (raw string_eq(name, "size_of")) {
        TypeId:ta = TypeId{ index: relay ast_id_at(x.ast, start, 0i32) };
        int32:sized = relay resolve_type(x.tr, ta, x.scope);
        LlType:sll = relay ll_type(x.fe.ctx, sized);
        if (!(raw ll_is_ok(sll))) { pass (relay iv_from_ll_at(x, sll, sized, n.span)); }
        string:g = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(g, " = getelementptr ", sll.text,
                          ", ptr null, i32 1", ""));
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(r, " = ptrtoint ptr ",
                          relay string_concat(g, " to i64")));
        pass (raw iv("i64", r, raw exprtypes_get(x.et, id)));
    }

    // `#wild_ptr<T>(addr)` — the ONE place an integer becomes a pointer (D-019).
    if (raw string_eq(name, "wild_ptr")) {
        ExprId:aid = ExprId{ index: relay ast_id_at(x.ast, start, gc) };
        IrVal:av = relay emit_expr(x, aid);
        if (!(raw iv_is_ok(av))) { pass av; }
        string:r = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(r, " = inttoptr ", av.ll, " ",
                          relay string_concat(av.ref, " to ptr")));
        pass (raw iv("ptr", r, raw exprtypes_get(x.et, id)));
    }

    // `#wild_slice<T>(ptr, len)` — a `{ptr, len}` built from parts the caller
    // vouches for; deliberately parallel to `#wild_ptr` (D-019).
    if (raw string_eq(name, "wild_slice")) {
        ExprId:parg = ExprId{ index: relay ast_id_at(x.ast, start, gc) };
        ExprId:lid = ExprId{ index: relay ast_id_at(x.ast, start, gc + 1i32) };
        IrVal:pv2 = relay emit_expr(x, parg);
        if (!(raw iv_is_ok(pv2))) { pass pv2; }
        IrVal:lv = relay emit_expr(x, lid);
        if (!(raw iv_is_ok(lv))) { pass lv; }
        string:a = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat3(a,
            " = insertvalue { ptr, i64 } undef, ptr ",
            relay string_concat(pv2.ref, ", 0")));
        string:b = relay irw_temp(x.fe.w);
        drop irw_line(x.fe.w, relay cat5(b, " = insertvalue { ptr, i64 } ", a,
                          ", i64 ", relay string_concat(lv.ref, ", 1")));
        pass (raw iv("{ ptr, i64 }", b, raw exprtypes_get(x.et, id)));
    }

    pass (raw iv_broken(n.span));
};
