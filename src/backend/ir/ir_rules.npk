// ir_rules — `limit<Rules>` LIVE (1.5.2 step 2; D-220, D-251, D-068). One
// generated predicate function per `Rules` declaration, and the one check
// every write point of a limited binding runs.
//
// THE PREDICATE: `define i8 @"npk.<module>.<name>"(<T> %a0)` -- the ordinary
// mangling (a `Rules` name lives in the module's one declaration namespace,
// so the symbol is free), the subject the single parameter, the verdict
// returned BARE (the function is the emitter's own, never callable from
// source, so it owes no envelope; its `bool` is the language's byte, D-036).
// The body is the refinements then the
// clauses in SOURCE ORDER, short-circuit: each refinement a call to its
// rule's function, each clause `emit_cond` with `$` bound to the subject's
// slot; the first false ends the evaluation with `ret i1 false`. Every
// declaration is emitted whether or not anything limits by it (V-6's eager
// rule: a defect in a clause is found before the rule has a user). A clause's
// own guard sites -- a division inside `{ $ != 0i32, 100i32 / $ > 1i32 }` --
// therefore exist ONCE, in one function instance, with ONE row each; inline
// expansion at every write point would give one clause node several sites in
// one function, and `llctx_elided`, keyed by node id per function, would
// answer one site's elision for all of them. D-183: the subject arrives by
// value and is a LENT parameter -- no flag, no drop. D-246: each clause is a
// condition -- its temporaries drop where the verdict is decided.
//
// THE CHECK, after the write, over the binding's WHOLE current value: the
// slot loaded, the predicate called, a branch, `npk_chain_reset`,
// `npk_trap(-4111)` -- the division guard's shape. Emitted in EVERY build
// (D-068); step 3 elides what the manifest discharged.

mod:ir_rules;

use "../../frontend/source_location.npk".*;
use "../../frontend/intern.npk".*;
use "../../frontend/token_kind.npk".*;   // the range clauses' operators (step 3)
use "../../frontend/ast_kind.npk".*;
use "../../frontend/ast.npk".*;
use "../../frontend/parse_expr.npk".*;
use "../../frontend/parse_decl.npk".*;
use "../../frontend/parse_stmt.npk".*;   // the loop and block accessors (1.5.3 step 1)
use "../../frontend/parse_pick.npk".*;   // the pick arms (1.5.3 step 1)
use "../../frontend/parse_decorate.npk".*;
use "../../frontend/types.npk".*;
use "../../frontend/expr_types.npk".*;
use "../../frontend/symbols.npk".*;
use "../../frontend/type_resolve.npk".*;
use "./ir_writer.npk".*;
use "./ir_types.npk".*;
use "./ir_func.npk".*;
use "./ir_expr.npk".*;
use "./ir_stmt.npk".*;
use "../smt/smt_obligations.npk".*;
use "../smt/smt_kinds.npk".*;   // OK_LIMIT, the elision question (step 3)

// The predicate's symbol: the declaration's own, by the ordinary mangling.
pub func:rule_fn_sym = string(ExprEmitter->:x, DeclId:rd) never fails {
    DeclNode:d = raw ast_decl(x.ast, rd);
    pass (raw mangled_fn_sym(x.fe.ctx, rd.index,
                             raw intern_get(x.interns, raw decl_name(d))));
};

// ONE `Rules` DECLARATION, ONE FUNCTION.
pub func:emit_rule_fn = IrVal(ExprEmitter->:x, DeclId:rd) never fails {
    DeclNode:d = raw ast_decl(x.ast, rd);
    if (d.kind != DeclKind.DeclRuleDecl) { pass (raw iv_broken(d.span)); }
    int32:subject = raw resolve_type(x.tr, raw rule_subject(d),
                        raw symtab_home_scope(x.tab, rd.index, x.scope));
    LlType:sl = raw ll_type(x.fe.ctx, subject);
    if (!(raw ll_is_ok(sl))) { pass (raw iv_from_ll_at(x, sl, subject, d.span)); }
    string:rname = raw intern_get(x.interns, raw decl_name(d));
    LlType:rt = raw fnem_begin(x.fe, rname, rd.index, x.fe.ctx.types.t_bool, true);
    if (!(raw ll_is_ok(rt))) { pass (raw iv_from_ll_at(x, rt, x.fe.ctx.types.t_bool, d.span)); }
    // THE VERDICT IS THE LANGUAGE'S `bool` -- a byte (D-036), never a bare
    // `i1`: the define line says what `ll_type` says, and so do the returns.
    string:bl = string_concat(rt.text, "");
    int32:dollar = raw intern_add(x.interns, "$");
    LlType:pl = raw fnem_param(x.fe, dollar, subject, false);
    if (!(raw ll_is_ok(pl))) { pass (raw iv_from_ll_at(x, pl, subject, d.span)); }
    drop fnem_open(x.fe);
    x.fe.rule_slot = raw fnem_local_slot_at(x.fe, 0i64);
    x.fe.rule_ll = string_concat(sl.text, "");
    // THE WALK (P-3), over the clauses under the same binding, before they
    // are lowered: a clause's own guards get their rows and their elision
    // answers exactly as a body's do.
    drop obl_rule(x, raw mangled_fn_sym(x.fe.ctx, rd.index, rname), dollar, subject, rd);

    string:no_l = raw irw_new_label(x.fe.w, "rule.no");
    int32:rn = raw rule_refine_count(x.ast, d);
    for (int32:i in 0i32...rn) {
        VerifyNode:rv = raw ast_verify(x.ast, raw rule_refine(x.ast, d, i));
        DeclId:sub = raw limit_target(rv);
        string:v = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(v, " = load ", sl.text, ", ptr ", x.fe.rule_slot));
        string:r = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(r, " = call ", bl, " ",
                                         raw cat5(raw rule_fn_sym(x, sub), "(", sl.text,
                                                  " ", string_concat(v, ")"))));
        string:rb = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(rb, " = icmp ne ", bl, " ", string_concat(r, ", 0")));
        string:nx = raw irw_new_label(x.fe.w, "rule.c");
        drop irw_line(x.fe.w, raw cat5("br i1 ", rb, ", label %", nx,
                                         string_concat(", label %", no_l)));
        drop s_start(x, nx);
    }
    int32:cn = raw rule_clause_count(x.ast, d);
    for (int32:j in 0i32...cn) {
        int64:ctm = raw fnem_temp_mark(x.fe);
        IrVal:c = raw emit_cond(x, raw rule_clause(x.ast, d, j));
        if (!(raw iv_is_ok(c))) { pass c; }
        drop emit_temp_drops(x, ctm);
        drop fnem_temp_release(x.fe, ctm);
        string:nx2 = raw irw_new_label(x.fe.w, "rule.c");
        drop irw_line(x.fe.w, raw cat5("br i1 ", c.ref, ", label %", nx2,
                                         string_concat(", label %", no_l)));
        drop s_start(x, nx2);
    }
    drop irw_line(x.fe.w, raw cat3("ret ", bl, " 1"));
    x.fe.terminated = true;
    drop s_start(x, no_l);
    drop irw_line(x.fe.w, raw cat3("ret ", bl, " 0"));
    x.fe.terminated = true;
    drop fnem_close(x.fe, true);
    x.fe.rule_slot = "";
    x.fe.rule_ll = "";
    pass (raw iv_nil());
};

// THE CHECK AT A WRITE POINT: the binding's slot and type, the rule, the
// site's key (`space`, `site` -- read by step 3's elision), the span the
// trap's origin chain names.
pub func:emit_limit_check = IrVal(ExprEmitter->:x, string:slot, int32:type_id,
                                  DeclId:rule, int32:space, int32:site,
                                  Span:at) never fails {
    LlType:ll = raw ll_type(x.fe.ctx, type_id);
    if (!(raw ll_is_ok(ll))) { pass (raw iv_from_ll_at(x, ll, type_id, at)); }
    string:v = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(v, " = load ", ll.text, ", ptr ", slot));
    pass (raw emit_limit_check_value(x, v, ll, type_id, rule, space, site, at));
};

// THE CHECK OVER A VALUE IN REGISTER: the write points load their slot first;
// a checked entry (D-252) has the argument register itself.
pub func:emit_limit_check_value = IrVal(ExprEmitter->:x, string:v, LlType:ll,
                                        int32:type_id, DeclId:rule, int32:space,
                                        int32:site, Span:at) never fails {
    // ELIDED (D-218.9, L-11): the manifest discharged this site, so the
    // guard is gone -- no call, no branch, no trap -- and ONE `llvm.assume`
    // states the rule's RANGE clauses over the value in register (the
    // channel 1.6's analyzers read); `true` when the rule has none. Sound
    // because the discharge proved the rule on every continuing execution
    // (L-7) and the value loaded is the value written.
    if (raw llctx_elided(x.fe.ctx, space, site, raw OK_LIMIT())) {
        string:fact = raw rule_range_i1(x, rule, v, ll, type_id, 64i32);
        if (fact.len == 0i64) { fact = "true"; }
        drop irw_line(x.fe.w, raw cat3("call void @llvm.assume(i1 ", fact, ")"));
        pass (raw iv_nil());
    }
    LlType:bt = raw ll_type(x.fe.ctx, x.fe.ctx.types.t_bool);
    if (!(raw ll_is_ok(bt))) { pass (raw iv_from_ll_at(x, bt, x.fe.ctx.types.t_bool, at)); }
    string:vd = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(vd, " = call ", bt.text, " ",
                                     raw cat5(raw rule_fn_sym(x, rule), "(", ll.text,
                                              " ", string_concat(v, ")"))));
    string:vb = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(vb, " = icmp ne ", bt.text, " ", string_concat(vd, ", 0")));
    string:good = raw irw_new_label(x.fe.w, "limit.ok");
    string:bad = raw irw_new_label(x.fe.w, "limit.bad");
    drop irw_line(x.fe.w, raw cat5("br i1 ", vb, ", label %", good,
                                     string_concat(", label %", bad)));
    drop irw_label(x.fe.w, bad);
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      int_to_string((raw x_site(x, at)) => int64), ")"));
    drop irw_line(x.fe.w, "call void @npk_trap(i32 -4111)");
    drop irw_line(x.fe.w, "unreachable");
    drop irw_label(x.fe.w, good);
    pass (raw iv_nil());
};

// THE RANGE CLAUSES OF A RULE AS ONE `i1` (L-11), or "" when it has none: a
// clause that is a comparison between `$` and an integer literal, either
// side, or an `&&` of such -- refinements expanded -- each one `icmp` over
// the value in register, `and`-chained. Nothing else qualifies: a call or a
// division in a clause can trap or cost, and an elided site emits neither.
// Integer subjects only; a literal is the parser's non-negative payload.
func:rule_range_i1 = string(ExprEmitter->:x, DeclId:rule, string:v, LlType:ll,
                            int32:type_id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass ""; }
    DeclNode:d = raw ast_decl(x.ast, rule);
    if (d.kind != DeclKind.DeclRuleDecl) { pass ""; }
    if ((raw type_kind(x.fe.ctx.types, type_id)) != (raw TY_INT())) { pass ""; }
    string:acc = "";
    int32:rn = raw rule_refine_count(x.ast, d);
    for (int32:i in 0i32...rn) {
        VerifyNode:rv = raw ast_verify(x.ast, raw rule_refine(x.ast, d, i));
        string:sub = raw rule_range_i1(x, raw limit_target(rv), v, ll, type_id, fuel - 1i32);
        acc = raw and_i1(x, acc, sub);
    }
    int32:cn = raw rule_clause_count(x.ast, d);
    for (int32:j in 0i32...cn) {
        string:c = raw clause_range_i1(x, raw rule_clause(x.ast, d, j), v, ll, type_id, 16i32);
        acc = raw and_i1(x, acc, c);
    }
    pass acc;
};

func:and_i1 = string(ExprEmitter->:x, string:a, string:b) never fails {
    if (a.len == 0i64) { pass (string_concat(b, "")); }
    if (b.len == 0i64) { pass (string_concat(a, "")); }
    string:t = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(t, " = and i1 ", a, ", ", b));
    pass t;
};

func:clause_range_i1 = string(ExprEmitter->:x, ExprId:id, string:v, LlType:ll,
                              int32:type_id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass ""; }
    if (raw expr_is_none(id)) { pass ""; }
    ExprNode:n = raw ast_expr(x.ast, id);
    if (n.kind != ExprKind.ExprBinaryExpr) { pass ""; }
    TokenKind:op = raw expr_op(n);
    if (op == TokenKind.OpAndAnd) {
        string:l = raw clause_range_i1(x, raw expr_lhs(n), v, ll, type_id, fuel - 1i32);
        string:r = raw clause_range_i1(x, raw expr_rhs(n), v, ll, type_id, fuel - 1i32);
        pass (raw and_i1(x, l, r));
    }
    ExprNode:a = raw ast_expr(x.ast, raw expr_lhs(n));
    ExprNode:b = raw ast_expr(x.ast, raw expr_rhs(n));
    bool:swap = false;
    int64:lit = 0i64;
    if ((a.kind == ExprKind.ExprIterationVarExpr) && (b.kind == ExprKind.ExprIntLiteral)) {
        lit = b.payload;
    } else {
        if ((b.kind == ExprKind.ExprIterationVarExpr) && (a.kind == ExprKind.ExprIntLiteral)) {
            swap = true;
            lit = a.payload;
        } else {
            pass "";
        }
    }
    if (lit < 0i64) { pass ""; }
    bool:sg = raw type_is_signed(x.fe.ctx.types, type_id);
    // `lit OP $` is `$ OP' lit` with the order mirrored.
    string:pred = "";
    if (op == TokenKind.OpEqEq)  { pred = "eq"; }
    if (op == TokenKind.OpNotEq) { pred = "ne"; }
    if (op == TokenKind.OpLt)    { if (swap) { pred = "gt"; } else { pred = "lt"; } }
    if (op == TokenKind.OpLtEq)  { if (swap) { pred = "ge"; } else { pred = "le"; } }
    if (op == TokenKind.OpGt)    { if (swap) { pred = "lt"; } else { pred = "gt"; } }
    if (op == TokenKind.OpGtEq)  { if (swap) { pred = "le"; } else { pred = "ge"; } }
    if (pred.len == 0i64) { pass ""; }
    if (!((raw string_eq(pred, "eq")) || (raw string_eq(pred, "ne")))) {
        if (sg) { pred = string_concat("s", pred); } else { pred = string_concat("u", pred); }
    }
    string:t = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(t, " = icmp ", pred, " ",
                                     raw cat5(ll.text, " ", v, ", ", int_to_string(lit))));
    pass t;
};

// THE CHECKED ENTRY (D-252): the ordinary symbol of a split function -- the
// parameter list verbatim, each limited parameter checked over its argument
// register (or, for a discharged entry row, assumed), the `requires`
// predicate called over the same registers when the function has one and
// its entry row is retained (1.5.3 step 1, D-268), then a tail call of
// the body under `.body`. Emitted after the body's close, straight into the
// module stream: outside an open function the writer's lines go there.
pub func:emit_checked_entry = IrVal(ExprEmitter->:x, string:sym, List<int32>:prules,
                                    List<int32>:pdecls, List<int32>:ptypes,
                                    bool:req, string:rsym, Span:at) never fails {
    string:params = "";
    string:args = "";
    for (int64:i in 0i64...x.fe.plls.count) {
        if (i > 0i64) {
            params = string_concat(params, ", ");
            args = string_concat(args, ", ");
        }
        string:an = string_concat("%a", int_to_string(i));
        params = raw cat3(params, x.fe.plls.items[i], string_concat(" ", an));
        args = raw cat3(args, x.fe.plls.items[i], string_concat(" ", an));
    }
    drop irw_raw(x.fe.w, raw cat5("define ", x.fe.ret_ll, " ", sym,
                                    raw cat3("(", params, ") {")));
    drop irw_label(x.fe.w, "entry");
    for (int64:pi in 0i64...prules.count) {
        if (prules.items[pi] == 0i32) { continue; }
        DeclNode:pd = raw ast_decl(x.ast, DeclId{ index: pdecls.items[pi] });
        LlType:pl = raw ll_type(x.fe.ctx, ptypes.items[pi]);
        if (!(raw ll_is_ok(pl))) { pass (raw iv_from_ll_at(x, pl, ptypes.items[pi], pd.span)); }
        IrVal:c = raw emit_limit_check_value(x, string_concat("%a", int_to_string(pi)), pl,
                                             ptypes.items[pi], DeclId{ index: prules.items[pi] },
                                             raw SITE_DECL(), pdecls.items[pi], pd.span);
        if (!(raw iv_is_ok(c))) { pass c; }
    }
    // THE `requires` PREDICATE (1.5.3 step 1; L-1, L-2), after the limit
    // checks: it traps inside on the first false clause, so its verdict is
    // not read here.
    if (req) {
        LlType:bt = raw ll_type(x.fe.ctx, x.fe.ctx.types.t_bool);
        if (!(raw ll_is_ok(bt))) { pass (raw iv_from_ll_at(x, bt, x.fe.ctx.types.t_bool, at)); }
        string:rq = raw irw_temp(x.fe.w);
        drop irw_line(x.fe.w, raw cat5(rq, " = call ", bt.text, " ",
                                         raw cat4(rsym, "(", args, ")")));
    }
    string:r = raw irw_temp(x.fe.w);
    drop irw_line(x.fe.w, raw cat5(r, " = tail call ", x.fe.ret_ll, " ",
                                     raw cat4(x.fe.sym, "(", args, ")")));
    drop irw_line(x.fe.w, raw cat4("ret ", x.fe.ret_ll, " ", r));
    drop irw_raw(x.fe.w, "}");
    drop irw_blank(x.fe.w);
    pass (raw iv_nil());
};

// THE BODY'S SYMBOL: `.body` INSIDE the quotes of a D-156 symbol
// (`@"npk.m.f"` becomes `@"npk.m.f.body"`); a bare symbol takes it plainly.
pub func:body_sym = string(string:sym) never fails {
    if (sym.len == 0i64) { pass ""; }
    if (sym.ptr[sym.len - 1i64] == 34u8) {
        pass (string_concat(string_from_bytes(sym.ptr, sym.len - 1i64), ".body\""));
    }
    pass (string_concat(sym, ".body"));
};

// DOES THIS DIRECT CALL BYPASS THE CALLEE'S ENTRY CHECK (D-252)? A sync
// callee with a limited parameter, and this call's `limit-subsume` row
// discharged by the manifest -- false whenever no `--elide` was given.
pub func:callee_bypasses = bool(ExprEmitter->:x, int32:decl_index, ExprId:call) never fails {
    if (decl_index == 0i32) { pass false; }
    DeclNode:d = raw ast_decl(x.ast, DeclId{ index: decl_index });
    if (d.kind != DeclKind.DeclFunctionDecl) { pass false; }
    if (raw decl_has(d, raw DECL_ASYNC())) { pass false; }
    if (raw decl_has(d, raw DECL_THREAD())) { pass false; }
    bool:limited = false;
    int32:pn = raw fn_param_count(x.ast, d);
    for (int32:i in 0i32...pn) {
        DeclNode:pd = raw ast_decl(x.ast, raw fn_param(x.ast, d, i));
        if (!(raw verify_is_none(raw param_limit(pd)))) { limited = true; }
    }
    // EVERY BYPASS ROW OF THE CALL DISCHARGED (1.5.3 step 2, D-268): the
    // `limit-subsume` row when the callee has limited parameters, the
    // `requires` row when it has clauses -- the body skips both checks.
    bool:required = (raw fn_requires_count(x, d)) > 0i32;
    if (!(limited || required)) { pass false; }
    if (limited) {
        if (!(raw llctx_elided(x.fe.ctx, raw SITE_EXPR(), call.index, raw OK_LIMIT_SUBSUME()))) { pass false; }
    }
    if (required) {
        if (!(raw llctx_elided(x.fe.ctx, raw SITE_EXPR(), call.index, raw OK_REQUIRES()))) { pass false; }
    }
    pass true;
};

// THE LOCAL A PLACE IS ROOTED AT, as its index in the local table, or -1:
// through member and index bases whose type is not a pointer, slice or
// handle (that storage is not the binding's own) to the identifier. The
// checker's `place_limited` walks the same way (TYPE-063 refuses the
// addresses that would make the walk incomplete).
pub func:place_root_local = int64(ExprEmitter->:x, ExprId:id) never fails {
    ExprId:cur = id;
    int32:fuel = 64i32;
    while (fuel > 0i32) {
        fuel = fuel - 1i32;
        if (raw expr_is_none(cur)) { pass (0i64 - 1i64); }
        ExprNode:n = raw ast_expr(x.ast, cur);
        if (n.kind == ExprKind.ExprIdentifierExpr) {
            pass (raw fnem_lookup_idx(x.fe, n.payload =>! int32));
        }
        ExprId:base = ExprId{ index: 0i32 };
        if (n.kind == ExprKind.ExprMemberAccessExpr) {
            base = raw expr_operand(n);
        } else {
            if (n.kind == ExprKind.ExprIndexExpr) {
                base = raw expr_lhs(n);
            } else {
                pass (0i64 - 1i64);
            }
        }
        int32:bt = raw exprtypes_get(x.et, base);
        if (bt != 0i32) {
            int32:bk = raw type_kind(x.fe.ctx.types, bt);
            if (bk == (raw TY_POINTER())) { pass (0i64 - 1i64); }
            if (bk == (raw TY_SLICE()))   { pass (0i64 - 1i64); }
            if (bk == (raw TY_HANDLE()))  { pass (0i64 - 1i64); }
        }
        cur = base;
    }
    pass (0i64 - 1i64);
};

// THE SECOND WRITE POINT (D-251): an assignment to a limited local or
// parameter, or to any part of one, re-checks the ROOT's whole value after
// the store. Nothing to do for a root that is not a limited local.
pub func:emit_assign_limit = IrVal(ExprEmitter->:x, ExprId:target, int32:site,
                                   Span:at) never fails {
    int64:ri = raw place_root_local(x, target);
    if (ri < 0i64) { pass (raw iv_nil()); }
    int32:rr = raw fnem_local_rule_at(x.fe, ri);
    if (rr == 0i32) { pass (raw iv_nil()); }
    pass (raw emit_limit_check(x, raw fnem_local_slot_at(x.fe, ri),
                               raw fnem_local_type_at(x.fe, ri),
                               DeclId{ index: rr }, raw SITE_STMT(), site, at));
};

// --- contracts (1.5.3 step 1; D-221, D-241, D-243, D-245, D-267, D-268) -------
//
// ONE SHAPE FOR EVERY CLAUSE CHECK: the proposition lowered as a condition
// (`emit_cond`, its temporaries dropped where the verdict is decided, D-246),
// a branch to `ctr.ok` or `ctr.bad`, and in `ctr.bad` `npk_chain_reset` at
// the clause's site then `npk_trap(<code>)` -- the limit check's shape with
// the predicate call replaced by the clause. The codes are the prelude's
// `RequiresViolated` (-4112), `EnsuresViolated` (-4113) and
// `InvariantViolated` (-4114). `elided` is the caller's answer for the
// site's row (or rows): a discharged row removes the check and nothing
// replaces it -- L-11 states no `llvm.assume` for a contract. The
// accounting is L-13's: one trap per clause at an entry or a loop head, one
// per return point (`emit_ensures_at`, ir_stmt.npk, chains a return point's
// clauses into ONE `ctr.bad`).
pub func:emit_contract_check = IrVal(ExprEmitter->:x, ExprId:cond, string:code,
                                     bool:elided, Span:at) never fails {
    if (elided) { pass (raw iv_nil()); }
    int64:ctm = raw fnem_temp_mark(x.fe);
    IrVal:c = raw emit_cond(x, cond);
    if (!(raw iv_is_ok(c))) { pass c; }
    drop emit_temp_drops(x, ctm);
    drop fnem_temp_release(x.fe, ctm);
    pass (raw emit_check_i1(x, c.ref, code, at));
};

// THE BRANCH AND THE TRAP over a verdict already in register.
pub func:emit_check_i1 = IrVal(ExprEmitter->:x, string:verdict, string:code,
                               Span:at) never fails {
    string:good = raw irw_new_label(x.fe.w, "ctr.ok");
    string:bad = raw irw_new_label(x.fe.w, "ctr.bad");
    drop irw_line(x.fe.w, raw cat5("br i1 ", verdict, ", label %", good,
                                     string_concat(", label %", bad)));
    drop irw_label(x.fe.w, bad);
    drop emit_contract_trap(x, code, at);
    drop irw_label(x.fe.w, good);
    pass (raw iv_nil());
};

// THE TRAP BLOCK'S BODY: the origin chain restarted at the site (D-179),
// the trap, `unreachable`.
pub func:emit_contract_trap = NIL(ExprEmitter->:x, string:code, Span:at) never fails {
    drop irw_line(x.fe.w, raw cat3("call void @npk_chain_reset(i32 ",
                      int_to_string((raw x_site(x, at)) => int64), ")"));
    drop irw_line(x.fe.w, raw cat3("call void @npk_trap(i32 ", code, ")"));
    drop irw_line(x.fe.w, "unreachable");
    pass NIL;
};

// The clause counts of a function's `requires` and `ensures` -- 0 for a
// declaration that is not a function (a `Rules` declaration has no slot 5).
pub func:fn_requires_count = int32(ExprEmitter->:x, DeclNode:d) never fails {
    pass (raw fn_contract_kind_count(x, d, raw CONTRACT_REQUIRES()));
};

pub func:fn_ensures_count = int32(ExprEmitter->:x, DeclNode:d) never fails {
    pass (raw fn_contract_kind_count(x, d, raw CONTRACT_ENSURES()));
};

func:fn_contract_kind_count = int32(ExprEmitter->:x, DeclNode:d, int32:kind) never fails {
    if (d.kind != DeclKind.DeclFunctionDecl) { pass 0i32; }
    int32:n = 0i32;
    int32:cc = raw fn_contract_count(x.ast, d);
    for (int32:i in 0i32...cc) {
        VerifyNode:cv = raw ast_verify(x.ast, raw fn_contract(x.ast, d, i));
        if (cv.kind != VerifyKind.VerifyContractNode) { continue; }
        if ((raw contract_kind(cv)) == kind) { n = n + 1i32; }
    }
    pass n;
};

// THE PREDICATE'S SYMBOL: `.req` inside the quotes, `body_sym`'s rule.
pub func:req_sym = string(string:sym) never fails {
    if (sym.len == 0i64) { pass ""; }
    if (sym.ptr[sym.len - 1i64] == 34u8) {
        pass (string_concat(string_from_bytes(sym.ptr, sym.len - 1i64), ".req\""));
    }
    pass (string_concat(sym, ".req"));
};

// THE `requires` PREDICATE (L-1, L-2; D-252 as amended by D-268): `define
// i8 @"<sym>.req"(<params>)` -- the function's parameter list verbatim,
// every parameter a LENT binding (no flag, no drop: the predicate borrows
// what the entry received), each `requires` clause checked in source order
// with `npk_trap(-4112)` at the clause's own site (L-13: one trap per
// clause), `ret i8 1` after the last -- a verdict nothing reads, since a
// false clause never returns. Called from the checked entry (a sync
// function) or at state 0 (a coroutine; `emit_function` in ir_stmt.npk)
// with the arguments as they arrived. Not walked for rows: a guard inside
// a clause is the function's SITE_DECL business (L-5), and its elision
// answers are the function's, still in the context when this runs. Emitted
// after the body's close and the checked entry: it reuses the one
// FnEmitter, and so must come LAST.
pub func:emit_req_fn = IrVal(ExprEmitter->:x, DeclId:did, DeclNode:d, string:fname,
                             int32:qual, string:plain_sym, List<int32>:pnames,
                             List<int32>:ptypes) never fails {
    LlType:rt = raw fnem_begin(x.fe, fname, qual, x.fe.ctx.types.t_bool, true);
    if (!(raw ll_is_ok(rt))) { pass (raw iv_from_ll_at(x, rt, x.fe.ctx.types.t_bool, d.span)); }
    x.fe.sym = raw req_sym(plain_sym);
    x.fe.decl = did.index;
    string:bl = string_concat(rt.text, "");
    for (int64:i in 0i64...pnames.count) {
        LlType:pl = raw fnem_param(x.fe, pnames.items[i], ptypes.items[i], false);
        if (!(raw ll_is_ok(pl))) { pass (raw iv_from_ll_at(x, pl, ptypes.items[i], d.span)); }
    }
    drop fnem_open(x.fe);
    int32:cc = raw fn_contract_count(x.ast, d);
    for (int32:ci in 0i32...cc) {
        VerifyNode:cv = raw ast_verify(x.ast, raw fn_contract(x.ast, d, ci));
        if (cv.kind != VerifyKind.VerifyContractNode) { continue; }
        if ((raw contract_kind(cv)) != (raw CONTRACT_REQUIRES())) { continue; }
        IrVal:c = raw emit_contract_check(x, raw contract_cond(cv), "-4112", false, cv.span);
        if (!(raw iv_is_ok(c))) { pass c; }
    }
    drop irw_line(x.fe.w, raw cat3("ret ", bl, " 1"));
    x.fe.terminated = true;
    drop fnem_close(x.fe, true);
    pass (raw iv_nil());
};

// THE INVARIANT AT A LOOP HEAD (L-8, L-13): one check per clause, elided
// only when EVERY row of the loop is discharged -- the entry row at the
// loop statement, the preservation row at its body block, and one per
// `continue` that re-enters this loop (an unlabelled one directly in the
// body, a labelled one naming this loop anywhere in it; an unlabelled
// `continue` inside a nested loop is that loop's). The head runs at entry
// and after every iteration: D-221's "holds at entry and is preserved".
pub func:emit_invariant_checks = IrVal(ExprEmitter->:x, VerifyId:inv, StmtId:sid,
                                       StmtId:body, int32:label) never fails {
    if (raw verify_is_none(inv)) { pass (raw iv_nil()); }
    bool:elided = raw invariant_elided(x, sid, body, label);
    VerifyNode:v = raw ast_verify(x.ast, inv);
    // THE CLAUSE CONTEXT (1.5.3 step 2): a guard inside a clause is the
    // head's site, keyed under the loop's statement.
    x.fe.ctx.cur_ctx = sid.index;
    for (int32:i in 0i32...(raw invariant_count(v))) {
        ExprId:cl = ExprId{ index: raw ast_id_at(x.ast, v.b, i) };
        ExprNode:cn = raw ast_expr(x.ast, cl);
        IrVal:c = raw emit_contract_check(x, cl, "-4114", elided, cn.span);
        if (!(raw iv_is_ok(c))) { x.fe.ctx.cur_ctx = 0i32; pass c; }
    }
    x.fe.ctx.cur_ctx = 0i32;
    pass (raw iv_nil());
};

pub func:invariant_elided = bool(ExprEmitter->:x, StmtId:sid, StmtId:body,
                                 int32:label) never fails {
    if (!(raw llctx_elided(x.fe.ctx, raw SITE_STMT(), sid.index, raw OK_INVARIANT()))) { pass false; }
    if (!(raw llctx_elided(x.fe.ctx, raw SITE_STMT(), body.index, raw OK_INVARIANT()))) { pass false; }
    pass (raw continues_elided(x, body, label, false, 64i32));
};

// Every `continue` re-entering the loop whose body this is has its row
// discharged. `nested` is true inside a nested loop, where an unlabelled
// `continue` is the inner loop's; a `defer` body cannot `continue`.
func:continues_elided = bool(ExprEmitter->:x, StmtId:sid, int32:label, bool:nested,
                             int32:fuel) never fails {
    if (raw stmt_is_none(sid)) { pass true; }
    if (fuel <= 0i32) { pass false; }
    StmtNode:s = raw ast_stmt(x.ast, sid);
    // A `continue` INSIDE A PICK EXPRESSION'S ARM (DEF-26, 1.5.4 step 0): the
    // arms are statements inside an expression, searched through the one
    // enumeration of a statement's expressions (`stmt_expr_ids`).
    List<int32>:xs = raw list_init::<int32>(4i64);
    drop stmt_expr_ids(x.ast, s, @xs);
    for (int64:xi in 0i64...xs.count) {
        if (!(raw pickexpr_continues_elided(x, ExprId{ index: xs.items[xi] }, label, nested, fuel - 1i32))) { pass false; }
    }
    if (s.kind == StmtKind.StmtContinueStmt) {
        bool:mine = false;
        if ((raw stmt_label(s)) == 0i32) {
            mine = !nested;
        } else {
            if ((raw stmt_label(s)) == label) { mine = true; }
        }
        if (!mine) { pass true; }
        pass (raw llctx_elided(x.fe.ctx, raw SITE_STMT(), sid.index, raw OK_INVARIANT()));
    }
    if (s.kind == StmtKind.StmtBlockStmt) {
        for (int32:i in 0i32...(raw stmt_list_count(s))) {
            StmtId:ch = StmtId{ index: raw ast_id_at(x.ast, raw stmt_list_start(s), i) };
            if (!(raw continues_elided(x, ch, label, nested, fuel - 1i32))) { pass false; }
        }
        pass true;
    }
    if (s.kind == StmtKind.StmtIfStmt) {
        if (!(raw continues_elided(x, raw stmt_then(s), label, nested, fuel - 1i32))) { pass false; }
        pass (raw continues_elided(x, raw stmt_else(s), label, nested, fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        pass (raw continues_elided(x, raw stmt_body(x.ast, s), label, true, fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtForStmt) {
        pass (raw continues_elided(x, raw stmt_for_body(x.ast, s), label, true, fuel - 1i32));
    }
    if ((s.kind == StmtKind.StmtLoopStmt) || (s.kind == StmtKind.StmtTillStmt)) {
        pass (raw continues_elided(x, raw stmt_counted_body(s), label, true, fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        if (!(raw continues_elided(x, raw stmt_when_body(x.ast, s), label, true, fuel - 1i32))) { pass false; }
        if (!(raw continues_elided(x, raw stmt_when_then(x.ast, s), label, true, fuel - 1i32))) { pass false; }
        pass (raw continues_elided(x, raw stmt_when_end(x.ast, s), label, true, fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtPickStmt) {
        for (int32:j in 0i32...(raw pick_arm_count(s))) {
            StmtId:arm = raw pick_arm_at(x.ast, raw pick_arm_start(s), j);
            if (!(raw continues_elided(x, arm, label, nested, fuel - 1i32))) { pass false; }
        }
        pass true;
    }
    if (s.kind == StmtKind.StmtPickArm) {
        pass (raw continues_elided(x, raw arm_body(s), label, nested, fuel - 1i32));
    }
    pass true;
};

// The `continue` walk's descent into an EXPRESSION (DEF-26): a pick
// expression's arms are statements, asked as `continues_elided` asks a
// block's; every other kind is searched for nested ones by its shape
// (`collect_old_expr`'s descent).
func:pickexpr_continues_elided = bool(ExprEmitter->:x, ExprId:id, int32:label, bool:nested,
                                      int32:fuel) never fails {
    if (raw expr_is_none(id)) { pass true; }
    if (fuel <= 0i32) { pass false; }
    ExprNode:n = raw ast_expr(x.ast, id);
    if (n.kind == ExprKind.ExprPickExpr) {
        if (!(raw pickexpr_continues_elided(x, ExprId{ index: n.a }, label, nested, fuel - 1i32))) { pass false; }
        for (int32:pa in 0i32...n.c) {
            if (!(raw continues_elided(x, raw pick_arm_at(x.ast, n.b, pa), label, nested, fuel - 1i32))) { pass false; }
        }
        pass true;
    }
    if (n.kind == ExprKind.ExprCallExpr) {
        if (!(raw pickexpr_continues_elided(x, raw expr_callee(n), label, nested, fuel - 1i32))) { pass false; }
        pass (raw pickexpr_continues_window(x, (raw expr_list_start(n)) + (raw expr_generic_count(n)),
                                            (raw expr_list_count(n)) - (raw expr_generic_count(n)),
                                            label, nested, fuel));
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        pass (raw pickexpr_continues_window(x, (raw expr_list_start(n)) + (raw builtin_generic_count(n)),
                                            (raw expr_list_count(n)) - (raw builtin_generic_count(n)),
                                            label, nested, fuel));
    }
    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            if (!(raw pickexpr_continues_elided(x, ExprId{ index: raw ast_id_at(x.ast, raw expr_list_start(n), i) },
                                                label, nested, fuel - 1i32))) { pass false; }
            i = i + 2i32;
        }
        pass true;
    }
    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass true; }
    if (shape == (raw EXPR_SHAPE_NONE())) { pass true; }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) { pass true; }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        pass (raw pickexpr_continues_window(x, raw expr_list_start(n), raw expr_list_count(n), label, nested, fuel));
    }
    if (!(raw pickexpr_continues_elided(x, raw expr_lhs(n), label, nested, fuel - 1i32))) { pass false; }
    if (shape == (raw EXPR_SHAPE_ONE())) { pass true; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        pass (raw pickexpr_continues_window(x, raw expr_list_start(n), raw expr_list_count(n), label, nested, fuel));
    }
    if (!(raw pickexpr_continues_elided(x, raw expr_rhs(n), label, nested, fuel - 1i32))) { pass false; }
    if (shape == (raw EXPR_SHAPE_TWO())) { pass true; }
    pass (raw pickexpr_continues_elided(x, raw expr_third(n), label, nested, fuel - 1i32));
};

func:pickexpr_continues_window = bool(ExprEmitter->:x, int32:start, int32:count, int32:label,
                                      bool:nested, int32:fuel) never fails {
    for (int32:i in 0i32...count) {
        if (!(raw pickexpr_continues_elided(x, ExprId{ index: raw ast_id_at(x.ast, start, i) },
                                            label, nested, fuel - 1i32))) { pass false; }
    }
    pass true;
};

// EVERY `old(...)` NODE the function's seam or heads will read (L-10,
// D-243): the `ensures` clauses' in order, then the body's loop invariants'
// in source order -- listed once so the entry can snapshot each (a
// coroutine registers each slot before its frame type is fixed).
pub func:collect_old = NIL(ExprEmitter->:x, DeclNode:d, List<int32>->:out) never fails {
    if (d.kind != DeclKind.DeclFunctionDecl) { pass NIL; }
    int32:cc = raw fn_contract_count(x.ast, d);
    for (int32:ci in 0i32...cc) {
        VerifyNode:cv = raw ast_verify(x.ast, raw fn_contract(x.ast, d, ci));
        if (cv.kind != VerifyKind.VerifyContractNode) { continue; }
        if ((raw contract_kind(cv)) != (raw CONTRACT_ENSURES())) { continue; }
        drop collect_old_expr(x, raw contract_cond(cv), out, 64i32);
    }
    drop collect_old_stmt(x, raw fn_body(x.ast, d), out, 64i32);
    pass NIL;
};

func:collect_old_inv = NIL(ExprEmitter->:x, VerifyId:inv, List<int32>->:out,
                           int32:fuel) never fails {
    if (raw verify_is_none(inv)) { pass NIL; }
    VerifyNode:v = raw ast_verify(x.ast, inv);
    for (int32:i in 0i32...(raw invariant_count(v))) {
        drop collect_old_expr(x, ExprId{ index: raw ast_id_at(x.ast, v.b, i) }, out, fuel);
    }
    pass NIL;
};

func:collect_old_stmt = NIL(ExprEmitter->:x, StmtId:sid, List<int32>->:out,
                            int32:fuel) never fails {
    if (raw stmt_is_none(sid)) { pass NIL; }
    if (fuel <= 0i32) { pass NIL; }
    StmtNode:s = raw ast_stmt(x.ast, sid);
    if (s.kind == StmtKind.StmtBlockStmt) {
        for (int32:i in 0i32...(raw stmt_list_count(s))) {
            StmtId:ch = StmtId{ index: raw ast_id_at(x.ast, raw stmt_list_start(s), i) };
            drop collect_old_stmt(x, ch, out, fuel - 1i32);
        }
        pass NIL;
    }
    if (s.kind == StmtKind.StmtIfStmt) {
        drop collect_old_stmt(x, raw stmt_then(s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_else(s), out, fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        drop collect_old_inv(x, raw stmt_while_invariant(x.ast, s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_body(x.ast, s), out, fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtForStmt) {
        drop collect_old_inv(x, raw stmt_for_invariant(x.ast, s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_for_body(x.ast, s), out, fuel - 1i32);
        pass NIL;
    }
    if ((s.kind == StmtKind.StmtLoopStmt) || (s.kind == StmtKind.StmtTillStmt)) {
        drop collect_old_inv(x, raw stmt_counted_invariant(x.ast, s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_counted_body(s), out, fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        drop collect_old_inv(x, raw stmt_when_invariant(x.ast, s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_when_body(x.ast, s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_when_then(x.ast, s), out, fuel - 1i32);
        drop collect_old_stmt(x, raw stmt_when_end(x.ast, s), out, fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPickStmt) {
        for (int32:j in 0i32...(raw pick_arm_count(s))) {
            StmtId:arm = raw pick_arm_at(x.ast, raw pick_arm_start(s), j);
            drop collect_old_stmt(x, arm, out, fuel - 1i32);
        }
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPickArm) {
        drop collect_old_stmt(x, raw arm_body(s), out, fuel - 1i32);
        pass NIL;
    }
    pass NIL;
};

// An expression's `old` nodes in source order -- `scan_expr`'s descent
// (ir_stmt.npk): the call and builtin windows past their generic arguments,
// a struct literal's values at the odd positions, the rest by shape.
func:collect_old_expr = NIL(ExprEmitter->:x, ExprId:id, List<int32>->:out,
                            int32:fuel) never fails {
    if (raw expr_is_none(id)) { pass NIL; }
    if (fuel <= 0i32) { pass NIL; }
    ExprNode:n = raw ast_expr(x.ast, id);
    if (n.kind == ExprKind.ExprOldExpr) {
        drop list_push(out, id.index);   // never nested (D-243)
        pass NIL;
    }
    // A PICK EXPRESSION (DEF-26): the selector, then the arms as statements.
    if (n.kind == ExprKind.ExprPickExpr) {
        drop collect_old_expr(x, ExprId{ index: n.a }, out, fuel - 1i32);
        for (int32:pa in 0i32...n.c) {
            drop collect_old_stmt(x, raw pick_arm_at(x.ast, n.b, pa), out, fuel - 1i32);
        }
        pass NIL;
    }
    if (n.kind == ExprKind.ExprCallExpr) {
        drop collect_old_expr(x, raw expr_callee(n), out, fuel - 1i32);
        drop collect_old_window(x, (raw expr_list_start(n)) + (raw expr_generic_count(n)),
                                (raw expr_list_count(n)) - (raw expr_generic_count(n)),
                                out, fuel);
        pass NIL;
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        drop collect_old_window(x, (raw expr_list_start(n)) + (raw builtin_generic_count(n)),
                                (raw expr_list_count(n)) - (raw builtin_generic_count(n)),
                                out, fuel);
        pass NIL;
    }
    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            drop collect_old_expr(x, ExprId{ index: raw ast_id_at(x.ast, raw expr_list_start(n), i) },
                                  out, fuel - 1i32);
            i = i + 2i32;
        }
        pass NIL;
    }
    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_NONE())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        drop collect_old_window(x, raw expr_list_start(n), raw expr_list_count(n), out, fuel);
        pass NIL;
    }
    drop collect_old_expr(x, raw expr_lhs(n), out, fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_ONE())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        drop collect_old_window(x, raw expr_list_start(n), raw expr_list_count(n), out, fuel);
        pass NIL;
    }
    drop collect_old_expr(x, raw expr_rhs(n), out, fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_TWO())) { pass NIL; }
    drop collect_old_expr(x, raw expr_third(n), out, fuel - 1i32);
    pass NIL;
};

func:collect_old_window = NIL(ExprEmitter->:x, int32:start, int32:count,
                              List<int32>->:out, int32:fuel) never fails {
    for (int32:i in 0i32...count) {
        drop collect_old_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, i) }, out, fuel - 1i32);
    }
    pass NIL;
};
