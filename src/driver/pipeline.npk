// The front half of the compiler, as one callable pipeline.
//
// Cycle 0.7.8. Until now this sequence lived in `tools/check.npk` and was COPIED
// into `tools/emit_check.npk` — two 400-line bodies that had to stay identical by
// discipline alone, which is the drift this module exists to end. `check`, and
// the compiler's own `main`, are thin wrappers over this one function.
//
// THE CALLER OWNS THE TABLES. `front_run` fills a `Front` the caller placed,
// rather than returning one: the module graph holds a pointer to the intern
// table, so a returned-by-value Front would carry a pointer into this function's
// dead frame. Placement first, wiring second — the same reason `FnEmitter` takes
// its writer rather than making one.

mod:pipeline;

use "../frontend/source_location.npk".*;
use "../frontend/source.npk".*;
use "../frontend/token_kind.npk".*;
use "../frontend/token.npk".*;
use "../frontend/num_width.npk".*;
use "../frontend/intern.npk".*;
use "../frontend/ast_kind.npk".*;
use "../frontend/ast.npk".*;
use "../frontend/diag_codes.npk".*;
use "../frontend/diagnostics.npk".*;
use "../frontend/parse_codes.npk".*;
use "../frontend/resolve_codes.npk".*;
use "../frontend/type_codes.npk".*;
use "../frontend/builtins.npk".*;
use "../frontend/lexer.npk".*;
use "../frontend/parser.npk".*;
use "../frontend/parse_type.npk".*;
use "../frontend/parse_expr.npk".*;
use "../frontend/parse_decorate.npk".*;
use "../frontend/parse_stmt.npk".*;
use "../frontend/parse_pick.npk".*;
use "../frontend/parse_decl.npk".*;
use "../frontend/paths.npk".*;
use "../frontend/resolve_path.npk".*;
use "../frontend/symbols.npk".*;
use "../frontend/module_graph.npk".*;
use "../frontend/macro/macro_codes.npk".*;
use "../frontend/macro/expand.npk".*;
use "../frontend/macro/derive.npk".*;
use "../frontend/macro/bridge_stubs.npk".*;
use "../frontend/resolve.npk".*;
use "../frontend/types.npk".*;
use "../frontend/builtin_types.npk".*;
use "../frontend/resolve_type.npk".*;
use "../frontend/type_names.npk".*;
use "../frontend/type_cast.npk".*;
use "../frontend/type_layout.npk".*;
use "../frontend/type_decl.npk".*;
use "../frontend/type_trait.npk".*;
use "../frontend/type_generic.npk".*;
use "../frontend/type_access.npk".*;
use "../frontend/expr_types.npk".*;
use "../frontend/type_expr.npk".*;
use "../frontend/type_stmt.npk".*;
use "../frontend/analysis/analysis_codes.npk".*;
use "../frontend/analysis/escape.npk".*;
use "../frontend/analysis/bindings.npk".*;
use "../frontend/analysis/exhaust.npk".*;
use "../frontend/analysis/locks.npk".*;
use "../frontend/analysis/suspend.npk".*;
use "../frontend/analysis/reach.npk".*;

// Every table the pipeline fills, owned by the caller for the caller's lifetime.
pub struct:Front = {
    InternTable:it;
    DiagList:diags;
    RootList:roots;
    ModuleGraph:g;
    Expander:xp;
    TypeTable:types;
    InstanceTable:inst;
    FnInstTable:fninsts;
    ImplTable:im;
    BoundTable:bd;
    ExprTypes:ets;
};

// Load, expand, resolve, type-check, analyse. Returns 0 with `f` filled and no
// diagnostics; 1 with diagnostics in `f.diags`; 2 when the root could not be
// read at all.
// `--extra-picky=no-wildx` (D-035): after a clean front half, refuse every
// `wildx` in the tree — a build mode for the highest assurance levels
// (DO-178C, IEC 61508, ISO 26262), which require structural coverage over
// code that exists before execution. wildx generates code that does not, so a
// program using it cannot reach those levels; excluding it is a property of
// the BUILD, not the language. The scan is flat over the AST's arrays — every
// vardecl and every decl is there regardless of nesting — so a `wildx` local
// or a `wildx`-returning function anywhere is found. Returns the count found.
pub func:reject_wildx = int32(Front->:f) never fails {
    int32:found = 0i32;
    int32:si = 0i32;
    int32:sn = raw ast_stmt_count(@f.g.ast);
    while (si < sn) {
        StmtNode:s = raw ast_stmt(@f.g.ast, StmtId{ index: si });
        if (s.kind == StmtKind.StmtVarDeclStmt) {
            if (((raw stmt_quals(@f.g.ast, s)) & (raw QUAL_WILDX())) != 0i32) {
                drop diaglist_push(@f.diags, raw diag_error(raw WILDX_EXCLUDED(),
                    "`wildx` is excluded by `--extra-picky=no-wildx`: this build mode forbids runtime code generation, which no structural-coverage regime can analyse (D-035)",
                    s.span));
                found = found + 1i32;
            }
        }
        si = si + 1i32;
    }
    int32:di = 0i32;
    int32:dn = raw ast_decl_count(@f.g.ast);
    while (di < dn) {
        DeclNode:d = raw ast_decl(@f.g.ast, DeclId{ index: di });
        if (((raw decl_flags(d)) & (raw DECL_RET_WILDX())) != 0i32) {
            drop diaglist_push(@f.diags, raw diag_error(raw WILDX_EXCLUDED(),
                "`wildx` is excluded by `--extra-picky=no-wildx` (D-035)",
                d.span));
            found = found + 1i32;
        }
        di = di + 1i32;
    }
    pass found;
};

pub func:front_run = int32(Front->:f, string:root) never fails {
    f.it = raw intern_init();
    f.diags = raw diaglist_init();
    f.roots = raw rootlist_init();
    f.g = raw graph_init(@f.it, @f.diags, @f.roots, "");

    // THE PRELUDE FIRST. Everything after it may name what it declares, and it is
    // loaded rather than synthesised: the same lexer, parser and collector.
    discard(raw graph_load_prelude(@f.g));

    int32:first = raw graph_load_all(@f.g, root);
    if (first < 0i32) {
        pass 2i32;
    }

    // --- stage 0: expansion --------------------------------------------------
    //
    // EXPANSION PRECEDES EVERYTHING (`MACRO_REFERENCE.md` §6). What every stage
    // below sees is the expanded program — which is what makes a defect here
    // different in kind from a defect anywhere else: the passes that follow do not
    // fail on a bad expansion, they analyse it faithfully and report on code
    // nobody wrote.
    //
    // COLLECTION PRECEDES EXPANSION, because an invocation may name a macro
    // declared after it — the same reason cycle 0.3 collects every declaration
    // before binding any name.
    f.xp = raw expander_init(@f.g.ast, @f.it, @f.diags);
    int64:before_expand = raw diaglist_count(@f.diags);
    int32:cm = 0i32;
    while (cm < (raw graph_count(@f.g))) {
        drop collect_macros(@f.xp, DeclId{ index: (raw graph_at(@f.g, cm)).root });
        cm = cm + 1i32;
    }

    // A FIXED POINT, BOUNDED. A macro body may contain invocations, so one round
    // is not enough; and `macro:m = () { #m(); };` never settles, so the loop is
    // bounded and exceeding the bound REFUSES rather than proceeding with a
    // half-expanded program.
    int32:xr = 0i32;
    bool:more = true;
    while (more) {
        if (xr >= (raw EXPAND_ROUNDS())) { break; }
        more = false;
        int32:xm = 0i32;
        while (xm < (raw graph_count(@f.g))) {
            if (raw expand_module(@f.xp, DeclId{ index: (raw graph_at(@f.g, xm)).root })) {
                more = true;
            }
            xm = xm + 1i32;
        }
        if (raw expander_blown(@f.xp)) { break; }
        xr = xr + 1i32;
    }
    if (more) {
        if (!(raw expander_blown(@f.xp))) {
            drop expand_no_fixpoint(@f.xp, (raw ast_decl(@f.g.ast,
                DeclId{ index: (raw graph_at(@f.g, 0i32)).root })).span);
        }
    }

    // EVERY `#name(...)` STILL STANDING IS ACCOUNTED FOR. It is a compiler builtin
    // or it is a refusal — there is no third outcome, and before this there was:
    // an invocation naming nothing at all typed as INVALID, which is the encoding
    // the checker uses to suppress cascades, so it produced no diagnostic anywhere.
    //
    // It is also what proves the expansion WALK has no hole. A body the walk never
    // entered still has its invocation in the array, so a missing case arrives here
    // named and refused rather than as a program that quietly did nothing.
    //
    // RUN ONLY OVER AN EXPANSION THAT OTHERWISE SUCCEEDED. An invocation that was
    // found and refused — wrong shape, wrong arity — is still standing afterwards,
    // and reporting it a second time as "names no macro" would be the same mistake
    // `check` is a separate tool from `resolve_check` to avoid: the second sentence
    // is about the wreckage of the first.
    if (!(raw expander_blown(@f.xp))) {
        if ((raw diaglist_count(@f.diags)) == before_expand) {
            drop expand_audit(@f.xp);
        }
    }

    // A PROGRAM THAT DID NOT EXPAND IS NOT A PROGRAM TO RESOLVE. Every name below
    // would be looked up in a tree that is missing what a macro was supposed to
    // emit, and the diagnostics would be about the absence rather than the cause.
    if ((raw diaglist_count(@f.diags)) != 0i64) {
        drop expansion_notes(@f.xp, @f.diags);
        drop expansion_notes(@f.xp, @f.diags);
        pass 1i32;
    }

    // `#[derive]` IS READ IN THE EXPANSION PHASE, because derive emits declarations
    // (D-123, "a macro that does not look like one") and what it emits has to be
    // complete before any name is bound.
    drop derive_apply(@f.g);
    if ((raw diaglist_count(@f.diags)) != 0i64) {
        drop expansion_notes(@f.xp, @f.diags);
        drop expansion_notes(@f.xp, @f.diags);
        pass 1i32;
    }

    // `extern` BLOCKS LOWER HERE TOO (D-149/D-190, 1.1.13c): each block's
    // driver stubs and its `<name>_iface_hash` constant are generated as
    // source and spliced like derive's impls — the block is the interface
    // record, the stubs are the callable surface, and both must exist
    // before collection binds a name.
    drop bridge_apply(@f.g);
    if ((raw diaglist_count(@f.diags)) != 0i64) {
        pass 1i32;
    }

    // EVERY DECLARATION RECORDED, now that expansion has settled and there is a
    // final answer about what the declarations ARE.
    drop graph_collect_all(@f.g);

    // --- stage 1: names ------------------------------------------------------
    //
    // The order is cycle 0.3's whole architecture and is not negotiable: every
    // module collected, THEN imports bound to a fixed point, THEN bodies
    // resolved. Each stage needs the previous one complete for every module, and
    // that is what makes a `use` cycle resolvable (D-086) rather than a problem
    // to be broken.
    // THE PRELUDE IS BOUND INTO EVERY MODULE FIRST, so a program's own `use` can
    // collide with it and be told, rather than the order deciding which wins.
    drop graph_apply_prelude(@f.g);

    drop graph_apply_imports(@f.g);

    Resolver:r = raw resolver_init(@f.g.ast, @f.g.tab, @f.it, @f.diags);
    int32:i = 0i32;
    while (i < (raw graph_count(@f.g))) {
        ModuleEntry:e = raw graph_at(@f.g, i);
        DeclId:mod_id = DeclId{ index: e.root };
        // D-179: the prelude is where the system error family's explicit
        // codes are legal — and nowhere else. The module name that error
        // codes hash under is the FILE'S BASENAME — the `mod:` line must
        // match it where present, files without one still have it, and the
        // seed derives the same string, which is what keeps the two
        // compilers numbering identically.
        r.in_prelude = (i == f.g.prelude);
        r.module_name = raw module_basename_intern(@f.g, e.file, @f.it);
        drop resolve_module(@r, mod_id, e.scope);
        i = i + 1i32;
    }

    drop graph_check_struct_cycles(@f.g);
    drop graph_check_dup_members(@f.g);
    int32:k = 0i32;
    while (k < (raw graph_count(@f.g))) {
        ModuleEntry:e2 = raw graph_at(@f.g, k);
        DeclId:mid = DeclId{ index: e2.root };
        drop check_global_cycles(@r, mid, e2.scope);
        k = k + 1i32;
    }

    // A NAME THAT DID NOT BIND MAKES EVERY TYPE QUESTION ABOUT IT MEANINGLESS, so
    // the type stage does not run over a program that failed to resolve. This is
    // the same reason `check` is a separate tool from `resolve_check`: reporting
    // "there is no type named `Foo`" beneath "unknown name `Foo`" is the same
    // mistake twice, and the second sentence is the less useful one.
    if ((raw diaglist_count(@f.diags)) != 0i64) {
        drop expansion_notes(@f.xp, @f.diags);
        drop expansion_notes(@f.xp, @f.diags);
        pass 1i32;
    }

    // --- stage 2: types ------------------------------------------------------
    //
    // ONE SET OF TABLES FOR THE WHOLE PROGRAM. Types are interned and compared by
    // index (D-090), so a per-module table would make `Point` from one module a
    // different type from `Point` in another — which is the one thing interning
    // exists to prevent.
    f.types = raw typetable_init();
    f.inst = raw insttable_init();
    f.fninsts = raw fninst_init();
    TypeResolver:tr = raw tyres_init(@f.g.ast, @f.types, @f.g.tab, @f.it, @f.diags, @f.inst);
    f.im = raw impltable_init();
    f.bd = raw boundtable_init();

    // COLLECTION BEFORE CHECKING, ACROSS EVERY MODULE. An impl in one module may
    // implement a trait declared in another, and a bound may name a trait a later
    // module declares — so every table has to be complete for the whole program
    // before any question is asked of it. Collecting and checking module by module
    // would make the answer depend on the order the graph happened to load in.
    int32:m = 0i32;
    while (m < (raw graph_count(@f.g))) {
        ModuleEntry:e3 = raw graph_at(@f.g, m);
        DeclId:mid3 = DeclId{ index: e3.root };
        drop collect_impls(@f.im, @tr, mid3, e3.scope);
        drop collect_bounds(@f.bd, @tr, mid3, e3.scope);
        m = m + 1i32;
    }

    // THE IMPL CHECKS RUN ONCE OVER THE WHOLE TABLE, not once per module. They
    // are questions about the PROGRAM — is a trait implemented twice, does an
    // impl supply what its trait requires — and each entry carries the scope it
    // was collected in, so the answers do not depend on which module is being
    // visited.
    drop check_coherence(@f.im, @tr);
    drop check_impls_complete(@f.im, @tr);
    drop check_supertraits(@f.im, @f.bd, @tr);
    drop check_duplicate_methods(@f.im, @tr);

    // AN EXPRESSION-TYPE TABLE for the whole program (0.5.0), sized from the AST
    // after every module is loaded — so it covers every expression in the graph
    // rather than the root module's.
    f.ets = raw exprtypes_for(@f.g.ast);
    ExprTyper:et = raw etyper_init(@f.g.ast, @f.types, @f.g.tab, @f.it, @f.diags, 0i32,
                                   @f.im, @f.bd, @f.inst, @f.fninsts, @f.ets);
    int32:b = 0i32;
    while (b < (raw graph_count(@f.g))) {
        ModuleEntry:e4 = raw graph_at(@f.g, b);
        DeclId:mid4 = DeclId{ index: e4.root };
        et.scope = e4.scope;
        drop check_module(@et, mid4, e4.scope);
        b = b + 1i32;
    }

    // INSTANTIATIONS ARE JUDGED LAST, once every one of them has been recorded —
    // by a signature, by a field, or by an annotation inside a body. Deciding
    // earlier would ask the impl table a question while it was still being filled
    // (D-108).
    drop check_instantiations(@f.inst, @f.im, @f.bd, @tr);
    // What the decide pass has judged. Anything recorded after this point
    // is swept below, once every pass that can record has run.
    int32:decided = raw inst_count(@f.inst);

    // --- stage 3: analyses ---------------------------------------------------
    //
    // AFTER TYPING, AND ONLY IF IT SUCCEEDED. Every analysis in cycle 0.5 reads
    // the expression-type table, and a table filled in from a program that failed
    // to type check holds the INVALID type wherever the checker gave up — so an
    // analysis run over it would be asking questions about types nobody
    // established. The same reason the type stage does not run over a program
    // that failed to resolve.
    if ((raw diaglist_count(@f.diags)) != 0i64) {
        drop expansion_notes(@f.xp, @f.diags);
        drop expansion_notes(@f.xp, @f.diags);
        pass 1i32;
    }

    // SECOND-CLASS BORROWS (D-004, 0.5.1).
    //
    // MARKED TO A FIXPOINT, THEN REPORTED ONCE. Which bindings hold a borrow is
    // dataflow, and a single pass in source order answers it wrongly wherever a
    // binding is assigned after it is used — inside a loop, most obviously. Marks
    // only ever go unset-to-set, so the rounds converge; the bound is there
    // because an unbounded loop in a checker is not a checker.
    Escape:esc = raw escape_init(@f.g.ast, @f.g.tab, @f.types, @f.ets, @f.diags,
                                 @tr);
    int32:round = 0i32;
    bool:settling = true;
    while (settling) {
        if (round >= (raw ESCAPE_ROUNDS())) { break; }
        drop escape_new_round(@esc);
        drop escape_walk(@esc, @f.g);
        settling = raw escape_changed(@esc);
        round = round + 1i32;
    }
    if (settling) {
        drop escape_unsettled(@esc, (raw ast_decl(@f.g.ast,
            DeclId{ index: (raw graph_at(@f.g, 0i32)).root })).span);
    }
    drop escape_report_mode(@esc);
    drop escape_walk(@esc, @f.g);

    // DEFINITE ASSIGNMENT (D-010, 0.5.2). No fixpoint: this is a MUST analysis
    // with an intersection merge, and a loop body that may run zero times is both
    // the sound answer and a fixed point on the first pass.
    Assign:asg = raw assign_init(@f.g.ast, @f.g.tab, @f.it, @f.types, @f.ets, @f.diags, @tr);
    int32:y2 = 0i32;
    while (y2 < (raw graph_count(@f.g))) {
        ModuleEntry:e6 = raw graph_at(@f.g, y2);
        DeclId:mid6 = DeclId{ index: e6.root };
        drop assign_module(@asg, mid6, e6.scope);
        y2 = y2 + 1i32;
    }

    // EXHAUSTIVENESS (D-008, D-059, D-061, 0.5.4). Reads the selector's recorded
    // type, so it runs after typing like every other analysis in this cycle.
    Exhaust:exh = raw exhaust_init(@f.g.ast, @f.g.tab, @f.types, @f.ets, @f.it, @f.diags);
    int32:z2 = 0i32;
    while (z2 < (raw graph_count(@f.g))) {
        ModuleEntry:e7 = raw graph_at(@f.g, z2);
        DeclId:mid7 = DeclId{ index: e7.root };
        drop exhaust_module(@exh, mid7, e7.scope);
        z2 = z2 + 1i32;
    }

    // LIVENESS ACROSS AWAIT (D-177, 1.1.4). Which locals cross a suspension
    // point, marked on `ExprTypes` for the emitter: a crossing local lives in
    // the coroutine frame, not an alloca. Runs after typing like its peers —
    // not because it reads types, but because a program the checker refused
    // has no emitter to record for.
    Suspend:ssp = raw suspend_init(@f.g.ast, @f.g.tab, @f.ets, @f.types, @f.it, @f.diags);
    int32:s0 = 0i32;
    while (s0 < (raw graph_count(@f.g))) {
        ModuleEntry:e9 = raw graph_at(@f.g, s0);
        drop suspend_module(@ssp, DeclId{ index: e9.root });
        s0 = s0 + 1i32;
    }

    // REACHABLE ERRORS (D-179, 1.1.7): the program-wide set that can reach
    // `failsafe`, and the named coverage its `pick` owes. Whole-program like
    // the locks — one set, one failsafe, one verdict.
    Reach:rch = raw reach_init(@f.g.ast, @f.g.tab, @f.it, @f.types, @f.ets, @f.diags);
    if (f.g.prelude >= 0i32) {
        ModuleEntry:rpe = raw graph_at(@f.g, f.g.prelude);
        rch.prelude_scope = rpe.scope;
    }
    int32:rc0 = 0i32;
    while (rc0 < (raw graph_count(@f.g))) {
        // The PRELUDE is excluded from the detector walk: a program reaches
        // its guard-bearing internals only through machinery the program's
        // OWN text must contain (a tbb value, an index, a division), and
        // those trip the detectors where they appear. Walking the prelude
        // would make every conditional unconditional and the precision
        // pointless.
        if (rc0 != f.g.prelude) {
            ModuleEntry:e10 = raw graph_at(@f.g, rc0);
            drop reach_module(@rch, DeclId{ index: e10.root },
                raw module_basename_intern(@f.g, e10.file, @f.it));
        }
        rc0 = rc0 + 1i32;
    }
    drop reach_settle(@rch);

    // LOCK LEVELS (D-056, D-113, 0.5.6) — the cycle's only whole-program analysis,
    // affordable because verification is whole-program anyway. Seed every declared
    // level, widen until nothing changes, then report once. Reporting during the
    // widening rounds would report each finding once per round.
    Locks:lk = raw locks_init(@f.g.ast, @f.g.tab, @f.types, @f.ets, @f.it, @f.im, @f.bd, @f.diags, @tr);
    int32:s1 = 0i32;
    while (s1 < (raw graph_count(@f.g))) {
        ModuleEntry:e8 = raw graph_at(@f.g, s1);
        drop locks_seed(@lk, DeclId{ index: e8.root }, e8.scope);
        s1 = s1 + 1i32;
    }

    // ITS OWN NAMES. The escape analysis above already declared `round` and
    // `settling` in this scope, and the real resolver refuses a redeclaration
    // (RESOLVE-001) — the seed's single namespace hid the collision for as long
    // as only the seed compiled this file.
    int32:lock_round = 0i32;
    bool:lock_settling = true;
    while (lock_settling) {
        if (lock_round >= (raw LOCK_ROUNDS())) { break; }
        drop locks_new_round(@lk);
        int32:w1 = 0i32;
        while (w1 < (raw graph_count(@f.g))) {
            ModuleEntry:e9 = raw graph_at(@f.g, w1);
            drop locks_widen(@lk, DeclId{ index: e9.root }, e9.scope);
            w1 = w1 + 1i32;
        }
        lock_settling = raw locks_changed(@lk);
        lock_round = lock_round + 1i32;
    }
    if (lock_settling) {
        drop locks_unsettled(@lk, (raw ast_decl(@f.g.ast,
            DeclId{ index: (raw graph_at(@f.g, 0i32)).root })).span);
    }

    drop locks_report_mode(@lk);
    int32:r1 = 0i32;
    while (r1 < (raw graph_count(@f.g))) {
        ModuleEntry:ea = raw graph_at(@f.g, r1);
        drop locks_widen(@lk, DeclId{ index: ea.root }, ea.scope);
        r1 = r1 + 1i32;
    }

    // EVERY TYPE LAID OUT, once the whole program is known. The checker asks for
    // very few sizes, so demand-driven layout leaves most of the table at zero —
    // fine for checking, and not fine for what Phase B does with these types. A
    // wrong size does not fail; it corrupts memory later.
    drop finish_layouts(@tr, (raw graph_at(@f.g, 0i32)).scope);

    // THE TAIL, JUDGED. `check_instantiations` above runs where it does because
    // the impl table is full by then (D-108), but recording is demand-driven and
    // every pass since -- the analyses, and `finish_layouts` right above --
    // resolves types and can therefore reach `inst_record`. An instance recorded
    // after the decide pass would never be bound-checked at all.
    //
    // Measured empty today, on the compiler's own source and 237 test files, so
    // this is a belt rather than a repair; it is here because "nothing currently
    // records late" is a property of the passes as they are written now, and the
    // next pass added after this line would inherit the gap silently.
    drop check_instantiations_from(@f.inst, @f.im, @f.bd, @tr, decided);


    int64:n = raw diaglist_count(@f.diags);
    if (n != 0i64) {
        drop expansion_notes(@f.xp, @f.diags);
        pass 1i32;
    }
    pass 0i32;
};

// One walk over every module, so the marking rounds and the reporting round
// cannot drift apart by being written twice.
func:escape_walk = NIL(Escape->:esc, ModuleGraph->:g) never fails {
    int32:i = 0i32;
    while (i < (raw graph_count(g))) {
        ModuleEntry:m = raw graph_at(g, i);
        DeclId:mid = DeclId{ index: m.root };
        drop escape_module(esc, mid, m.scope);
        i = i + 1i32;
    }
    pass NIL;
};
