// npkc — the Nitpick compiler.
//
// Cycle 0.7.8, the first `main` this project has had: `nitpick.toml`'s
// `entry = "src/main.npk"` stops being aspiration. It reads one root, runs the
// whole front half (`src/driver/pipeline.npk`), and either reports diagnostics —
// codes and spans, one per line — or writes the program's LLVM IR to stdout.
//
// STDOUT IS THE PRODUCT; STDERR IS THE REPORT. The IR goes to stdout (or with
// `-o` to a file); diagnostics go to stderr through the line-disciplined,
// UNBUFFERED writer (D-076) — which is why `npkc bad.npk > out.ll` shows its
// errors instead of burying them in the redirect, and why they survive a trap.
//
// IT WRITES TEXT — and nothing else. Subset 1
// has no process spawning, so `llc` and `ld.lld` are the build system's to invoke
// (BUILD_REFERENCE §4), which is also the honest shape: the compiler's output IS
// the IR, and what a build does with it is the build's.
//
//   npkc <root.npk>              IR on stdout
//   npkc <root.npk> -o <out.ll>  IR written to the file, stdout silent
//
// Exit codes, the same contract every tool holds:
//
//   0   clean — the IR was delivered
//   1   diagnostics (codes and spans on stderr; no IR)
//   2   could not read the input, or could not write the output
//   3   the COMPILER trapped — a defect in it, never in the input

use "./driver/pipeline.npk".*;
use "../lib/nio.npk".*;
use "./frontend/source_location.npk".*;
use "./frontend/intern.npk".*;
use "./frontend/diagnostics.npk".*;
use "./frontend/source.npk".*;
use "./backend/ir/ir_writer.npk".*;
use "./backend/emit_program.npk".*;
use "./frontend/resolve_type.npk".*;
use "./frontend/types.npk".*;
use "./frontend/ast.npk".*;
use "./frontend/analysis/bindings.npk".*;
use "./frontend/analysis/escape.npk".*;
use "./frontend/expr_types.npk".*;
use "./frontend/analysis/locks.npk".*;
use "./frontend/module_graph.npk".*;
use "./frontend/resolve_path.npk".*;
use "./frontend/symbols.npk".*;
use "./frontend/token.npk".*;
use "./frontend/type_trait.npk".*;

// EVERY DIAGNOSTIC THROUGH THE ONE RENDERER (1.0.8). This driver defined its
// own `emit_line` until then — `CODE path:line:col`, the message dropped — and
// so did three others, no two alike; `diag_line` is the only formatter now and
// the overflow note reaches the reader too, which it never did from a driver.
func:report = NIL(NioW->:out, SourceManager->:sm, DiagList->:diags) never fails {
    int64:n = raw diaglist_count(diags);
    int64:d = 0i64;
    while (d < n) {
        // Diagnostics are best-effort by the time they print: a broken
        // stderr cannot be reported on stderr (D-163's reasoned `?| NIL`).
        nio_line(out, raw diag_line(raw diaglist_at(diags, d), sm)) ?| NIL;
        d = d + 1i64;
    }
    if (diags.overflowed) {
        nio_line(out, raw diag_overflow_line()) ?| NIL;
    }
    pass NIL;
};

func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) {
        NioW:uw = raw nio_stderr();
        nio_line(@uw, "usage: npkc <root.npk> [-o out.ll]") ?| NIL;
        exit 2i32;
    }
    cstring:arg = argv[1i64];
    string:root = raw string_from_bytes(arg.ptr, arg.len);

    // `-o out.ll` — the one flag. Parsed positionally rather than by a scanner,
    // because one flag does not justify one; the day there are two, this becomes
    // the driver's argument table, not a second special case.
    string:out_path = "";
    if (argv.len >= 4i64) {
        cstring:flag = argv[2i64];
        string:flag_s = raw string_from_bytes(flag.ptr, flag.len);
        if (raw string_eq(flag_s, "-o")) {
            cstring:op = argv[3i64];
            out_path = raw string_from_bytes(op.ptr, op.len);
        }
    }

    // `--extra-picky=no-wildx` — the high-assurance build mode (D-035). Scanned
    // across every argument, since it is order-free and pairs with `-o`.
    bool:no_wildx = false;
    int64:ai = 1i64;
    while (ai < argv.len) {
        cstring:a = argv[ai];
        if (raw string_eq(raw string_from_bytes(a.ptr, a.len),
                          "--extra-picky=no-wildx")) {
            no_wildx = true;
        }
        ai = ai + 1i64;
    }

    // Declared UNINITIALISED and filled by the pipeline through the pointer —
    // the graph inside holds a pointer to the intern table beside it, so the
    // whole Front must sit in one frame before any wiring happens. `$$m`, not
    // `@`: the MUTABLE borrow is the out-parameter spelling — it says in source
    // that the callee writes this, and the definite-assignment analysis credits
    // exactly that spelling as the assignment (D-010). `@f` here would be
    // refused, correctly: an immutable borrow of memory nothing has written is
    // a read of it.
    Front:f;
    int32:fr = raw front_run($$m f, root);
    if (fr == 2i32) { exit 2i32; }
    if (fr != 0i32) {
        NioW:ew = raw nio_stderr();
        report(@ew, @f.g.sm, @f.diags) ?| NIL;
        exit 1i32;
    }

    // The build-mode exclusion runs on a clean front half: it is a refusal
    // about what may be built, not about whether the program type-checks.
    if (no_wildx) {
        if ((raw reject_wildx($$m f)) > 0i32) {
            NioW:ew = raw nio_stderr();
            report(@ew, @f.g.sm, @f.diags) ?| NIL;
            exit 1i32;
        }
    }

    // The backend, INTO A BUFFER: a rung refusal can arrive after half the
    // module is written, and half a module beside an error report is an output
    // nobody can consume. The IR leaves the process only once it is known whole.
    IrWriter:w = raw irw_to_buffer();
    InstanceTable:einst = raw insttable_init();
    TypeResolver:tr = raw tyres_init(@f.g.ast, @f.types, @f.g.tab, @f.it,
                                     @f.diags, @einst);
    bool:emitted = raw emit_all(@w, @f.g, @f.types, @f.it, @f.ets, @tr,
                                    @f.fninsts, @f.im, @f.diags);
    if (!emitted) {
        NioW:ew = raw nio_stderr();
        report(@ew, @f.g.sm, @f.diags) ?| NIL;
        exit 1i32;
    }
    string:ir = raw irw_text(@w);
    if (out_path.len > 0i64) {
        // THROUGH THE FLOOR'S WHOLE-FILE WRITE, whose loop retries short writes
        // and whose failed close is a failed write — an .ll that silently lost
        // its tail would be a program that assembles to something other than
        // what was compiled.
        // `-o`'s path is user input: an interior NUL names no file (D-049)
        // and is reported like any other unwritable path — under `raw` it
        // became a garbage cstring, which was a live bug this sweep found.
        Result<cstring>:oc = to_cstring(out_path);
        if (oc.is_error) {
            NioW:ew = raw nio_stderr();
            nio_line(@ew, "npkc: cannot write the output file") ?| NIL;
            exit 2i32;
        }
        Result<NIL>:wr = write_file(oc.value, ir);
        if (wr.is_error) {
            NioW:ew = raw nio_stderr();
            nio_line(@ew, "npkc: cannot write the output file") ?| NIL;
            exit 2i32;
        }
        drop wild_release_all();
        exit 0i32;
    }
    // The IR is BYTES already carrying its `\n`s — the byte path, not a text
    // writer: nothing here may translate the product (D-050, binary side).
    Result<NIL>:pr = nio_write_all(raw nio_stdout_fd(),
                                   ir.ptr =>! wild int8->, ir.len);
    if (pr.is_error) {
        NioW:ew = raw nio_stderr();
        nio_line(@ew, "npkc: cannot write the IR to stdout") ?| NIL;
        exit 2i32;
    }
    drop wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    // Every defect family this program can die from, NAMED
    // (D-179) — the doctrine applied to ourselves. Exit 3 for
    // each: a defect in the COMPILER, never the input's error.
    pick (e) {
        (DeadlineExceeded) { exit 3i32; },
        (DivByZero) { exit 3i32; },
        (DivOverflow) { exit 3i32; },
        (HeapBadRequest) { exit 3i32; },
        (HeapOom) { exit 3i32; },
        (OutOfBounds) { exit 3i32; },
        (Unreachable) { exit 3i32; },
        (WildLeak) { exit 3i32; },
        (ast.BoundsId) { exit 3i32; },
        (ast.BoundsScratch) { exit 3i32; },
        (ast.BoundsWindow) { exit 3i32; },
        (bindings.Rederived) { exit 3i32; },
        (diagnostics.BoundsId) { exit 3i32; },
        (escape.Rederived) { exit 3i32; },
        (expr_types.BoundsId) { exit 3i32; },
        (intern.BoundsId) { exit 3i32; },
        (intern.ProvenSlice) { exit 3i32; },
        (locks.Rederived) { exit 3i32; },
        (module_graph.BoundsIndex) { exit 3i32; },
        (module_graph.ProvenSlice) { exit 3i32; },
        (resolve_path.BoundsIndex) { exit 3i32; },
        (source.BoundsOffset) { exit 3i32; },
        (source.FileUnknown) { exit 3i32; },
        (symbols.BoundsId) { exit 3i32; },
        (token.BoundsId) { exit 3i32; },
        (type_trait.BoundsBound) { exit 3i32; },
        (type_trait.BoundsImpl) { exit 3i32; },
        (types.BoundsId) { exit 3i32; },
        (types.BoundsIndex) { exit 3i32; },
        (*) { exit 3i32; }
    }
    exit 3i32;
};
