// Rendering a type as the name a programmer wrote.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.4.3.
//
// Its own module because two checkers need it and neither should depend on the
// other: expression typing (0.4.2) and cast checking (0.4.3) both exist to say
// WHICH TYPE was wrong, and a diagnostic that elides the name is most of the
// value gone.

use "./intern.npk".*;
use "./ast.npk".*;
use "./parse_decl.npk".*;   // decl_name, for D-159's canonical bound order
use "./types.npk".*;

// A type's name, for a message. The whole value of a type error is which type
// was wrong, so this is never elided.
// --- canonical bound ordering for `dyn` (D-159) -------------------------------
//
// `dyn A & B` AND `dyn B & A` ARE ONE TYPE. Interning keys on the window, so
// without this they were two — two interned types, two layouts, and two
// different answers to "which word holds B's vtable". Sorting the bounds by
// NAME makes every vtable word's slot a compile-time constant that a reader can
// predict from the source, which is why the key is the name and not the
// interned id (assigned in encounter order) or the declaration index (which
// shifts when an unrelated declaration is added earlier — an ABI that moves for
// an edit that touched nothing).
//
// Insertion sort: a `dyn` names a handful of traits, and an insertion sort over
// a handful is smaller to audit than anything asymptotically better.
//
// THE TIE IS UNREACHABLE, and the fallback is defensive (measured at 1.0.5b).
// Two same-named traits would produce equal keys — but they cannot both be
// named in one file: a glob import of both is the loader's ambiguity
// (`NITPICK-RESOLVE-008`), and the qualified form `a.S` does not parse, because
// a dotted path is not a type spelling. The declaration-index tiebreak below
// stays anyway, since a total order should be total whether or not the tie
// arises. IF A DOTTED TYPE SPELLING IS EVER ADDED, this needs a
// module-qualified key in the same change — D-159 records that dependency.
pub func:dyn_sort_bounds = NIL(Ast->:ast, TypeTable->:tyt,
                               InternTable->:interns, int32:mark) never fails {
    // `ast_scratch_mark` READ NOW is the current top, so the difference is the
    // size of the region this caller pushed. It is the same function the caller
    // took `mark` from — a second one under a name meaning "top" would be two
    // spellings of one thing, which is what the blueprint rule argues against.
    int32:n = (raw ast_scratch_mark(ast)) - mark;
    int32:i = 1i32;
    while (i < n) {
        int32:v = raw ast_scratch_at(ast, mark, i);
        int32:j = i - 1i32;
        while (j >= 0i32) {
            int32:w = raw ast_scratch_at(ast, mark, j);
            if (!(raw bound_before(ast, tyt, interns, v, w))) { break; }
            drop ast_scratch_set(ast, mark, j + 1i32, w);
            j = j - 1i32;
        }
        drop ast_scratch_set(ast, mark, j + 1i32, v);
        i = i + 1i32;
    }
    pass NIL;
};

// Does trait type `a` sort before trait type `b`?
func:bound_before = bool(Ast->:ast, TypeTable->:tyt, InternTable->:interns,
                         int32:a, int32:b) never fails {
    string:an = raw bound_name(ast, tyt, interns, a);
    string:bn = raw bound_name(ast, tyt, interns, b);
    if (raw name_lt(an, bn)) { pass true; }
    if (raw name_lt(bn, an)) { pass false; }
    // The tie: two traits of one name. Any deterministic answer canonicalises
    // the type; this one is the declaration index.
    pass ((raw type_decl_of(tyt, a)) < (raw type_decl_of(tyt, b)));
};

func:bound_name = string(Ast->:ast, TypeTable->:tyt, InternTable->:interns,
                         int32:t) never fails {
    int32:d = raw type_decl_of(tyt, t);
    if (d == 0i32) { pass ""; }
    DeclNode:dn = raw ast_decl(ast, DeclId{ index: d });
    pass (raw intern_get(interns, raw decl_name(dn)));
};

// A METHOD'S NAME CARRIES ITS IMPL (D-156 as amended at 1.0.5b). Before this a
// method's symbol was its module and its own name, so two impls of one trait on
// different types both rendered `@"npk.<module>.say"` and `llc` refused the
// module — `invalid redefinition of function`. The qualifier is the pair D-158
// already says a vtable is per:
//
//     Dog:Speaks.say     a trait impl's method
//     Dog.say            an inherent impl's method
//     say                a free function — `self_ty` of 0 says so
//
// THE RECEIVER'S CONCRETE TYPE, NOT THE IMPL'S DECLARED TARGET. A family impl
// `impl:<T>:Box<T>:S` emits one body per instantiation and each needs its own
// symbol — `Box<int32>:S.w`, not two of `Box<T>:S.w`. Both ends already hold the
// substituted type, so using it separates the specializations with no second
// rule.
//
// IT LIVES IN THE FRONTEND because the CHECKER computes it: the checker is where
// the receiver type and the owning trait are both known, and the emitter would
// have to redo a lookup it holds neither table for. Same reasoning as
// `exprtypes_callee` — one computation, recorded, rather than two that can drift.
pub func:method_symbol_name = string(TypeTable->:tyt, InternTable->:interns,
                                     int32:self_ty, int32:trait_ty,
                                     string:name) never fails {
    // cloned, not passed through: the parameter is lent (D-183)
    if (self_ty == 0i32) { pass (string_concat(name, "")); }
    string:q = raw type_display(tyt, interns, self_ty);
    if (trait_ty != 0i32) {
        q = string_concat(q,
                string_concat(":", raw type_display(tyt, interns, trait_ty)));
    }
    pass (string_concat(q, string_concat(".", name)));
};

pub func:type_display = string(TypeTable->:tyt, InternTable->:interns, int32:t) never fails {
    int32:k = raw type_kind(tyt, t);
    if (k == (raw TY_INVALID())) { pass "<unresolved>"; }
    if (k == (raw TY_BOOL()))    { pass "bool"; }
    if (k == (raw TY_STRING()))  { pass "string"; }
    if (k == (raw TY_CSTRING())) { pass "cstring"; }
    if (k == (raw TY_BUFFER()))  { pass "buffer"; }
    if (k == (raw TY_NIL()))     { pass "NIL"; }
    if (k == (raw TY_ERROR()))   { pass "Error"; }
    // Interned as a nameless singleton (D-185), so the named-type tail
    // cannot answer for it — found at 1.4.1 by the walkers-total instrument.
    if (k == (raw TY_OWNEDFD())) { pass "OwnedFd"; }
    if (k == (raw TY_CHANNEL())) {
        string:c1 = string_concat("Channel<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(c1, ", …>"));
    }
    if (k == (raw TY_MUTEX())) {
        string:m1 = string_concat("Mutex<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(m1, ", …>"));
    }
    if (k == (raw TY_GUARD())) {
        string:g1 = string_concat("Guard<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(g1, ">"));
    }
    if (k == (raw TY_RWLOCK())) {
        string:r1 = string_concat("RwLock<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(r1, ", …>"));
    }
    if (k == (raw TY_RGUARD())) {
        string:r2 = string_concat("RGuard<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(r2, ">"));
    }
    if (k == (raw TY_CONDVAR())) { pass "CondVar<…>"; }
    if (k == (raw TY_BARRIER())) { pass "Barrier<…>"; }
    if (k == (raw TY_ATOMIC())) {
        string:a1 = string_concat("atomic<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(a1, ">"));
    }
    if (k == (raw TY_SIMD())) {
        string:s1 = string_concat("simd<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        string:s2 = string_concat(s1, ", ");
        string:s3 = string_concat(s2,
                        int_to_string(((raw tt_get(tyt, t)).b) => int64));
        pass (string_concat(s3, ">"));
    }
    if (k == (raw TY_ANY()))     { pass "any"; }
    if (k == (raw TY_CHAR())) {
        pass (string_concat("char",
                  int_to_string((raw type_int_bits(tyt, t)) => int64)));
    }
    if (k == (raw TY_TBB())) {
        pass (string_concat("tbb",
                  int_to_string((raw type_int_bits(tyt, t)) => int64)));
    }
    if (k == (raw TY_TFP())) {
        pass (string_concat("tfp",
                  int_to_string((raw type_int_bits(tyt, t)) => int64)));
    }
    // `dim256<…>` renders its vector in BASE-PRODUCT form (D-196, 1.3.3) —
    // never a guessed derived name: `Hertz` and `Becquerels` are one vector,
    // and a diagnostic that picked one would be inventing intent.
    if (k == (raw TY_DIM())) {
        string:dv = string_concat("dim256<",
                        raw dim_unit_text(raw type_dim_vec(tyt, t)));
        pass (string_concat(dv, ">"));
    }
    // The ternary/nonary four, named from the (base, digits) pair (D-197).
    if (k == (raw TY_TERN())) {
        if ((raw type_tern_base(tyt, t)) == 3i32) {
            if ((raw type_tern_digits(tyt, t)) == 1i32) { pass "trit"; }
            pass "tryte";
        }
        if ((raw type_tern_digits(tyt, t)) == 1i32) { pass "nit"; }
        pass "nyte";
    }
    if (k == (raw TY_FRAC())) {
        pass (string_concat("frac",
                  int_to_string((raw type_int_bits(tyt, t)) => int64)));
    }
    if (k == (raw TY_COMPLEX())) {
        string:ce = string_concat("complex<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(ce, ">"));
    }
    if (k == (raw TY_KERNEL())) {
        int32:w = raw type_elem(tyt, t);
        if (w == (raw KERNEL_FD()))  { pass "fd"; }
        if (w == (raw KERNEL_PID())) { pass "pid"; }
        if (w == (raw KERNEL_TID())) { pass "tid"; }
        if (w == (raw KERNEL_UID())) { pass "uid"; }
        pass "gid";
    }
    if (k == (raw TY_INT())) {
        string:base = "int";
        if (!(raw type_is_signed(tyt, t))) { base = "uint"; }
        pass (string_concat(base,
                  int_to_string((raw type_int_bits(tyt, t)) => int64)));
    }
    if (k == (raw TY_FLOAT())) {
        pass (string_concat("flt",
                  int_to_string((raw type_int_bits(tyt, t)) => int64)));
    }
    if (k == (raw TY_POINTER())) {
        pass (string_concat(raw type_display(tyt, interns, raw type_elem(tyt, t)), "->"));
    }
    if (k == (raw TY_SLICE())) {
        pass (string_concat(raw type_display(tyt, interns, raw type_elem(tyt, t)), "[]"));
    }
    if (k == (raw TY_OPTIONAL())) {
        pass (string_concat(raw type_display(tyt, interns, raw type_elem(tyt, t)), "?"));
    }
    if (k == (raw TY_RESULT())) {
        string:r1 = string_concat("Result<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(r1, ">"));
    }
    // THE REST OF THE ONE-OPERAND KINDS (1.0.8). Each printed `<type>` — so
    // "`<type>` and `<type>` are different types" was the whole of a refusal
    // between two `Handle`s, and `arr.nope` on an array reported "`<type>` has
    // no member `nope`". Every kind that carries an operand spells it.
    if (k == (raw TY_ARRAY())) {
        string:a1 = string_concat(
                        raw type_display(tyt, interns, raw type_elem(tyt, t)), "[");
        string:a2 = string_concat(a1,
                        int_to_string((raw type_array_count(tyt, t)) => int64));
        pass (string_concat(a2, "]"));
    }
    if (k == (raw TY_HANDLE())) {
        string:h1 = string_concat("Handle<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(h1, ">"));
    }
    if (k == (raw TY_ARENA())) {
        string:n1 = string_concat("arena<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(n1, ">"));
    }
    if (k == (raw TY_SHARED_ARENA())) {
        string:s1 = string_concat("shared_arena<",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        pass (string_concat(s1, ">"));
    }
    // A RANGE IS `{ T, T }` (D-093), spelled as the value that makes one.
    if (k == (raw TY_RANGE())) {
        string:g1 = string_concat(
                        raw type_display(tyt, interns, raw type_elem(tyt, t)), "..");
        pass (string_concat(g1,
                  raw type_display(tyt, interns, raw type_elem(tyt, t))));
    }
    // A PROJECTION IS SPELLED AS ONE (D-164): `T.Item`.
    if (k == (raw TY_ASSOC())) {
        string:p1 = string_concat(
                        raw type_display(tyt, interns, raw type_assoc_base(tyt, t)), ".");
        pass (string_concat(p1,
                  raw intern_get(interns, raw type_assoc_name(tyt, t))));
    }
    // A FUNCTION PRINTS ITS RETURN AND ITS SHAPE, not `<type>`. `type_elem` on a
    // function is its return type, and the two kinds are told apart in the one
    // place a reader looks — a diagnostic saying "`func Result<int64>(…)` is not
    // a function" would have been the only clue that the variadic kind existed.
    if (k == (raw TY_FUNC())) {
        string:f1 = string_concat("func ",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        string:f2 = string_concat(f1, "(…)");
        if (raw func_never_fails(tyt, t)) { pass (string_concat(f2, " never fails")); }
        pass f2;
    }
    if (k == (raw TY_FUNC_VARIADIC())) {
        string:f1 = string_concat("func ",
                        raw type_display(tyt, interns, raw type_elem(tyt, t)));
        string:f2 = string_concat(f1, "(…, ..*T[])");
        if (raw func_never_fails(tyt, t)) { pass (string_concat(f2, " never fails")); }
        pass f2;
    }
    // `Self` HAS NO NAME TO CARRY, so without this it printed `<type>` — and it
    // appears in exactly the diagnostics where the reader needs to see it, since
    // a trait's declared signature is written in terms of it.
    if (k == (raw TY_SELF())) { pass "Self"; }

    // A `comptime` ARGUMENT PRINTS AS THE VALUE, which is what it is. It carries
    // its rendering as its name, so it falls through to the named-type case below
    // and comes out as `2` inside `Mutex<Config, 2>` — the mangled name of an
    // instantiation is built out of exactly these, so getting it wrong here would
    // rename every instance that carries one.

    // Named types carry their own name.
    int32:nm = raw type_name(tyt, t);
    if (!(raw intern_is_none(nm))) {
        pass (raw intern_get(interns, nm));
    }
    pass "<type>";
};
