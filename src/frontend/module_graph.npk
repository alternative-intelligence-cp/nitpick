// The module graph.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.3.3.
//
// From a root file: the whole program, each module loaded once, in any order,
// with the same result.
//
// EVERY MODULE SHARES ONE `Ast`. A `Span` carries its file id (0.1.0), so nodes
// from different files are already distinguishable, and one arena means a
// cross-module reference is an ordinary index rather than a pair of them.
//
// CYCLES ARE LEGAL (D-086) and need no special handling here, PROVIDED phase 1
// completes for every module before phase 2 begins for any. That ordering is the
// entire mechanism, and it falls out of the structure below: loading collects
// declarations only, and body resolution (0.3.5) runs afterwards over the
// finished table. There is no point at which a module's declarations are needed
// and missing.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
mod:module_graph;
error:BoundsIndex;
error:ProvenSlice;

use "./source_location.npk".*;
use "./source.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./token.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./resolve_codes.npk".*;
use "./paths.npk".*;
use "./resolve_path.npk".*;
use "./lexer.npk".*;
use "./parser.npk".*;
use "./parse_type.npk".*;
use "./parse_expr.npk".*;
use "./parse_decorate.npk".*;
use "./parse_stmt.npk".*;
use "./parse_pick.npk".*;
use "./parse_decl.npk".*;
use "./symbols.npk".*;
use "./prelude.npk".*;
use "./prelude_source.npk".*;

pub struct:ModuleEntry = {
    int32:file;      // index into the SourceManager
    int32:root;      // the ModuleDecl
    int32:scope;     // its module scope in the symbol table
};

pub struct:ModuleGraph = {
    SourceManager:sm;
    Ast:ast;
    SymbolTable:tab;
    InternTable->:interns;
    DiagList->:diags;
    RootList->:roots;
    string:stdlib;

    List<ModuleEntry>:v;

    // WHICH ENTRY IS THE PRELUDE, or -1. Its members are collected INTO the root
    // scope rather than into a scope of their own, and that is the one thing about
    // it that differs from every other module — so it is one index rather than a
    // flag on every entry.
    int32:prelude;

    // WHICH ENTRY IS THE ROOT -- the file the driver was given -- or -1 before
    // `graph_load_all` (D-248, 1.5.1b): the one module that may declare `main`
    // and `failsafe`, which `graph_check_entry_points` reads.
    int32:root_index;
};

pub func:graph_init = ModuleGraph(InternTable->:interns, DiagList->:diags,
                                  RootList->:roots, move string:stdlib) never fails {
    ModuleGraph:g = ModuleGraph{
        sm: raw srcmgr_init(),
        ast: raw ast_init(),
        tab: raw symtab_init(),
        interns: interns,
        diags: diags,
        roots: roots,
        stdlib: move(stdlib),
        prelude: 0i32 - 1i32,
        root_index: 0i32 - 1i32,
        v: raw list_init::<ModuleEntry>(16i64)
    };
    pass g;
};

func:graph_id = int32(int64:n) never fails {
    if (n > 2147483647i64) { !!! BoundsIndex; }
    pass (n =>! int32);
};

pub func:graph_count = int32(ModuleGraph->:g) never fails { pass (raw graph_id(g.v.count)); };
pub func:graph_at = ModuleEntry(ModuleGraph->:g, int32:i) never fails {
    if (i < 0i32) { !!! BoundsIndex; }
    if ((i => int64) >= g.v.count) { !!! BoundsIndex; }
    pass g.v.items[i => int64];
};

// Already in the graph? Returns its index, or -1.
pub func:graph_find = int32(ModuleGraph->:g, int32:file) never fails {
    int32:i = 0i32;
    while ((i => int64) < g.v.count) {
        if (g.v.items[i => int64].file == file) {
            pass i;
        }
        i = i + 1i32;
    }
    pass (0i32 - 1i32);
};

// --- loading -----------------------------------------------------------------------

// Load one module, parse it, and collect its declarations. Returns its index in
// the graph, or -1 if it could not be read.
//
// THE PATH IS NORMALISED HERE, unconditionally, rather than trusting the caller
// to have done it. `./a/../b.npk` and `b.npk` name one file, and if two spellings
// reach `srcmgr_load` the module loads twice — every symbol in it declared twice,
// so 0.3.1's duplicate diagnostic fires on a file the reader never edited.
//
// Normalising is idempotent and costs a scan of a short string. Making the
// guarantee structural rather than a convention every call site has to remember
// is worth far more than that, and this function was written the other way first:
// the comment said the path "has been through path_normalise by the time it
// arrives", and the first caller that had not was a test.
pub func:graph_load = int32(ModuleGraph->:g, string:raw_path, Span:from) never fails {
    string:path = raw path_normalise(raw_path);
    Result<int32>:loaded = srcmgr_load(@g.sm, string_concat(path, ""));
    if (loaded.is_error) {
        string:m1 = string_concat("cannot read `", path);
        string:m2 = string_concat(m1, "`");
        drop diaglist_push(g.diags,
            raw diag_error(raw RESOLVE_NO_SUCH_FILE(), move(m2), from));
        pass (0i32 - 1i32);
    }
    int32:file = loaded.value;

    int32:existing = raw graph_find(g, file);
    if (existing >= 0i32) {
        pass existing;
    }

    string:text = raw srcmgr_text_proven(@g.sm, file);
    TokenList:toks = raw lex_all(file, text, g.interns, g.diags);
    Parser:p = raw parser_init(@toks, @g.ast, g.diags, g.interns);
    DeclId:root = raw p_parse_module(@p);
    drop check_file_header(g, file, root);

    // COLLECTION USED TO RUN HERE, per module as it was loaded. It moved out to
    // `graph_collect_all`, and the reason is macro expansion:
    //
    //   **A macro emits declarations, and collection is what records
    //   declarations.** Collecting as a file loads means collecting before any
    //   macro in it has expanded, so everything a macro emits is invisible to
    //   every name lookup — which is exactly what cycle 0.6.1 found: the emitted
    //   functions existed in the tree and resolved to nothing.
    //
    // What made collection safe to run per-module still holds and is why the split
    // costs nothing: collecting a declaration records its name and where it was
    // declared and needs NO other module, so it does not matter when it runs as
    // long as it runs before anything looks a name up. That is also what lets the
    // graph contain a cycle without the loader having to break it.
    // The scope is filled in by `graph_collect_all`; 0 until then.
    ModuleEntry:e = ModuleEntry{ file: file, root: root.index, scope: 0i32 };
    int32:index = raw graph_id(g.v.count);
    drop list_push(@g.v, e);
    pass index;
};

// THE FILE'S FIRST DECLARATION IS ITS HEADER (D-248, 1.5.1b step 1): a
// member-less `mod:<basename>;` -- `mod:<dir>;` for a `dir/mod.npk`, since the
// module a `mod.npk` supplies is named by its directory (MODULE_REFERENCE 1.1).
// The header binds nothing and loads nothing; `graph_load_imports` skips the
// slot. Until this rule a header was INDISTINGUISHABLE from an import written
// first -- both are a member-less `mod:name;` -- so the loader resolved it like
// any import, found the file itself, and returned; and when the name was WRONG
// and a sibling carried it, the sibling was loaded and merged, two `main`s were
// emitted at exit 0, and `llc` refused the result (the workbench's DEF-2,
// OPEN_DECISIONS §2f). Every file now says what it is, and the loader says so
// when it does not: one code, two texts. A file with no declarations at all is
// refused at its first line.
func:check_file_header = NIL(ModuleGraph->:g, int32:file, DeclId:root) never fails {
    string:path = raw srcmgr_resolved_proven(@g.sm, file);
    string:want = raw path_basename(path);
    string:shown = string_concat(want, ".npk");
    if (raw string_eq(want, "mod")) {
        want = raw path_basename(raw path_dirname(path));
        shown = string_concat(want, "/mod.npk");
    }
    DeclNode:m = raw ast_decl(@g.ast, root);
    int32:n = raw item_member_count(@g.ast, m);
    if (n == 0i32) {
        string:e1 = string_concat("file `", shown);
        string:e2 = string_concat(e1, "` has no header: its first declaration must be `mod:");
        string:e3 = string_concat(e2, want);
        drop diaglist_push(g.diags, raw diag_error(raw RESOLVE_NO_HEADER(),
            string_concat(e3, ";` (D-248)"), raw span_point(file, 0i32, 1i32, 1i32)));
        pass NIL;
    }
    DeclNode:d0 = raw ast_decl(@g.ast, raw item_member(@g.ast, m, 0i32));
    bool:header_shape = false;
    if (d0.kind == DeclKind.DeclModuleDecl) {
        if ((raw item_member_count(@g.ast, d0)) == 0i32) { header_shape = true; }
    }
    if (!header_shape) {
        string:m1 = string_concat("file `", shown);
        string:m2 = string_concat(m1, "` has no header: its first declaration must be `mod:");
        string:m3 = string_concat(m2, want);
        drop diaglist_push(g.diags, raw diag_error(raw RESOLVE_NO_HEADER(),
            string_concat(m3, ";` (D-248)"), d0.span));
        pass NIL;
    }
    string:name = raw intern_get(g.interns, raw decl_name(d0));
    if (raw string_eq(name, want)) { pass NIL; }
    string:w1 = string_concat("file `", shown);
    string:w2 = string_concat(w1, "` declares `mod:");
    string:w3 = string_concat(w2, name);
    string:w4 = string_concat(w3, ";` first: a file's header names the file -- `mod:");
    string:w5 = string_concat(w4, want);
    string:w6 = string_concat(w5, ";` -- and an import of `");
    string:w7 = string_concat(w6, name);
    drop diaglist_push(g.diags, raw diag_error(raw RESOLVE_NO_HEADER(),
        string_concat(w7, "` is written after it (D-248)"), d0.span));
    pass NIL;
};

// THE PRELUDE, LOADED LIKE ANY OTHER MODULE AND COLLECTED UNLIKE ONE.
//
// Its text is a constant rather than a file (`prelude_source.npk`), so there is no
// path to find and nothing to be missing — but from the lexer onward it goes
// through exactly what a program's own source does. There is no second way for a
// declaration to come into existence.
//
// IT IS LOADED FIRST, before the root module, because everything that follows may
// name what it declares.
pub func:graph_load_prelude = int32(ModuleGraph->:g) never fails {
    int32:file = raw srcmgr_add_synthetic(@g.sm, raw PRELUDE_PATH(), raw PRELUDE_SOURCE());
    string:text = raw srcmgr_text_proven(@g.sm, file);
    TokenList:toks = raw lex_all(file, text, g.interns, g.diags);
    Parser:p = raw parser_init(@toks, @g.ast, g.diags, g.interns);
    DeclId:root = raw p_parse_module(@p);

    // SCOPE 0 IS RECORDED, NOT OPENED. Every other module gets a scope of its own
    // whose parent is 0; the prelude's members go INTO 0, which is what makes them
    // visible everywhere without an import. `graph_collect_all` reads this to know
    // which of the two a module is.
    ModuleEntry:e = ModuleEntry{ file: file, root: root.index, scope: 0i32 };
    int32:index = raw graph_id(g.v.count);
    g.prelude = index;
    drop list_push(@g.v, e);
    pass index;
};

// PHASE 1, over every module the graph holds, after macro expansion has finished.
//
// One pass rather than one per file, so that "every declaration in the program has
// been recorded" is a state the caller can be in rather than a thing it has to
// track — and so that expansion, which rewrites what the declarations ARE, has a
// place to run before any of them is written down.
pub func:graph_collect_all = NIL(ModuleGraph->:g) never fails {
    int32:i = 0i32;
    while ((i => int64) < g.v.count) {
        ModuleEntry:e = g.v.items[i => int64];
        DeclId:root = DeclId{ index: e.root };
        // past the header slot: a file's `mod:name;` binds nothing (D-248)
        e.scope = raw collect_file_module(@g.tab, @g.ast, g.diags, root, 0i32);
        // THE PRELUDE'S SCOPE (D-247; 1.5.1b step 5b): module 0 is the prelude,
        // and `List<T>` -- compiler-known and owning -- is declared there.
        if (i == 0i32) { g.tab.prelude_scope = e.scope; }
        g.v.items[i => int64] = e;
        i = i + 1i32;
    }
    pass NIL;
};

// THE PRELUDE IS A MODULE EVERY MODULE IMPLICITLY IMPORTS.
//
// The first attempt collected it into the ROOT scope, on the reasoning that every
// module's scope has scope 0 as its parent so a name in 0 is in scope everywhere.
// It is not: `scope_lookup` STOPS AT THE FIRST MODULE SCOPE. **A module is a closed
// namespace**, reachable only through `use`, and that is the whole of what a module
// means here — so there is nothing above one to put a prelude in.
//
// So it is bound the way `use "./prelude.npk".*` would bind it, into every module
// scope in the program. That is the honest model rather than a workaround: the
// prelude is not magic, it is an import nobody has to write.
//
// EVERY MODULE SCOPE, INCLUDING NESTED ONES, and by walking the scope table rather
// than the module list — a `mod:inner = { … }` opens a scope of its own that the
// module list has no entry for, and it cannot see its parent's names either.
pub func:graph_apply_prelude = NIL(ModuleGraph->:g) never fails {
    if (g.prelude < 0i32) { pass NIL; }
    ModuleEntry:pe = raw graph_at(g, g.prelude);
    if (pe.scope == 0i32) { pass NIL; }

    int32:n = raw symtab_scope_count(@g.tab);
    int32:s = 1i32;
    while (s < n) {
        if (s != pe.scope) {
            if ((raw scope_kind(@g.tab, s)) == (raw SCOPE_MODULE())) {
                drop bind_prelude_into(g, s, pe.scope);
            }
        }
        s = s + 1i32;
    }
    pass NIL;
};

// A PRELUDE NAME DECLARED BY THE PROGRAM IS AN ERROR, not the warning a wildcard
// collision gets.
//
// A module's own scope is searched first, so a program's `trait:Eq` would silently
// take over — and then `#[derive(Eq)]` would generate an implementation of a trait
// the compiler knows nothing about, against methods it guessed. One name, one
// meaning, which is the same reason a variable cannot be called `if`.
func:bind_prelude_into = NIL(ModuleGraph->:g, int32:scope, int32:src_scope) never fails {
    int32:n = raw scope_symbol_count(@g.tab, src_scope);
    for (int32:i in 0i32...n) {
        int32:sym = raw scope_symbol_at(@g.tab, src_scope, i);
        if (sym != 0i32) {
            Symbol:s = raw symtab_get(@g.tab, sym);
            if (raw symbol_is_exported(s)) {
                int32:bound = raw symtab_bind_import(@g.tab, scope, s.name,
                                                     s.origin_kind, s.origin, 0i32);
                if (bound == 0i32) {
                    int32:clash = raw scope_lookup_local(@g.tab, scope, s.name);
                    Span:at = raw span_none();
                    if (clash != 0i32) {
                        at = raw symbol_span(@g.ast, @g.tab, clash);
                    }
                    string:nm = raw intern_get(g.interns, s.name);
                    string:m1 = string_concat("`", nm);
                    string:m2 = string_concat(m1,
                        "` is declared by the prelude, so a program cannot declare it: a local one would silently take over, and `#[derive]` would then generate an implementation of a trait the compiler knows nothing about");
                    drop diaglist_push(g.diags,
                        raw diag_error(raw RESOLVE_DUPLICATE(), move(m2), at));
                }
            }
        }
    }
    pass NIL;
};

// --- owned names (D-239, 1.4.8c) -----------------------------------------------------------
//
// A NAME THE COMPILER OR THE PRELUDE OWNS CANNOT BE DECLARED BY A PROGRAM, at any
// type-namespace declaration. `bind_prelude_into` has refused a MODULE-SCOPE
// declaration named after a prelude export since 0.3 ("a local one would silently
// take over"), and 1.4.8b's exact matching found the two places that rule did not
// reach. `Error` (D-179) is compiler-known -- resolved BY NAME ahead of every user
// lookup (`type_resolve.npk`), declared by no module -- so the prelude clash never
// saw a `struct:Error`, and a program could declare one that nothing would ever
// resolve to. An ASSOCIATED TYPE or a GENERIC PARAMETER is a trait member or a
// window entry, not a scope symbol, so `assoc:Duration = int32;` shadowed the
// prelude's `Duration` inside its trait under D-160's nearer-binding rule, and
// `assoc:Error = int32;` was read two ways by one checker: the signature
// comparison saw the builtin, the object-safety walk (matching by name) saw the
// assoc. One name, one meaning: all of it is refused here, by the loader, under
// the code the module-scope clash already carries.
//
// MODULE-SCOPE names are checked against `Error` only -- the prelude clash is
// `bind_prelude_into`'s report, and a second line for one mistake is what D-240
// forbids. Associated types and generic parameters are checked against both,
// because nothing else sees them. Fields, variants and methods are members reached
// through their owner and shadow nothing; they are not this rule's business.
pub func:graph_check_owned_names = NIL(ModuleGraph->:g) never fails {
    int32:pscope = 0i32;
    if (g.prelude >= 0i32) {
        ModuleEntry:pe = raw graph_at(g, g.prelude);
        pscope = pe.scope;
    }
    int32:mi = 0i32;
    while ((mi => int64) < g.v.count) {
        if (mi != g.prelude) {
            ModuleEntry:e = raw graph_at(g, mi);
            drop owned_names_in_module(g, DeclId{ index: e.root }, pscope);
        }
        mi = mi + 1i32;
    }
    pass NIL;
};

// --- entry points (D-248, 1.5.1b step 1) ---------------------------------------------
//
// `main` AND `failsafe` ARE THE ROOT MODULE'S, at its top level. They are the two
// functions the runtime calls by NAME (`@main` from `_start`, `@npk_failsafe`
// from the trap route), and the emitter names them by name alone -- so a second
// declaration anywhere in the program is a second `define` of one symbol, which
// `llc` refuses after an exit 0 (DEF-2's shape), and a library that declared one
// would smuggle an entry point into every program importing it. The rule is
// upstream, here, so the four by-name sites downstream are safe by construction:
// only the file the driver was given, at its top level, declares either.
pub func:graph_check_entry_points = NIL(ModuleGraph->:g) never fails {
    int32:mi = 0i32;
    while ((mi => int64) < g.v.count) {
        if (mi != g.prelude) {
            ModuleEntry:e = raw graph_at(g, mi);
            string:path = raw srcmgr_resolved_proven(@g.sm, e.file);
            string:holder = string_concat(raw path_basename(path), ".npk");
            drop entry_points_in(g, DeclId{ index: e.root }, mi == g.root_index, holder);
        }
        mi = mi + 1i32;
    }
    pass NIL;
};

func:entry_points_in = NIL(ModuleGraph->:g, DeclId:mod_id, bool:allowed, string:holder) never fails {
    DeclNode:m = raw ast_decl(@g.ast, mod_id);
    int32:n = raw item_member_count(@g.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(@g.ast, m, i);
        DeclNode:d = raw ast_decl(@g.ast, item);
        if (d.kind == DeclKind.DeclFunctionDecl) {
            if (allowed) { continue; }
            string:nm = raw intern_get(g.interns, raw decl_name(d));
            bool:entry = false;
            if (raw string_eq(nm, "main"))     { entry = true; }
            if (raw string_eq(nm, "failsafe")) { entry = true; }
            if (!entry) { continue; }
            string:m1 = string_concat("`", nm);
            string:m2 = string_concat(m1, "` is an entry point and is declared at the root module's top level -- the file the driver was given; `");
            string:m3 = string_concat(m2, holder);
            drop diaglist_push(g.diags, raw diag_error(raw RESOLVE_ENTRY_OUTSIDE_ROOT(),
                string_concat(m3, "` is a module of this program (D-248)"), d.span));
            continue;
        }
        if (d.kind == DeclKind.DeclModuleDecl) {
            if ((raw item_member_count(@g.ast, d)) > 0i32) {
                // an inline module is a module inside the file, never the root
                string:inner = string_concat("mod:", raw intern_get(g.interns, raw decl_name(d)));
                drop entry_points_in(g, item, false, inner);
            }
        }
    }
    pass NIL;
};

// Does the prelude EXPORT `name`? False when there is no prelude.
func:prelude_owns = bool(ModuleGraph->:g, int32:pscope, int32:name) never fails {
    if (pscope == 0i32) { pass false; }
    int32:sym = raw scope_lookup_local(@g.tab, pscope, name);
    if (sym == 0i32) { pass false; }
    pass (raw symbol_is_exported(raw symtab_get(@g.tab, sym)));
};

// One declaration's own name; `what` says which kind, for the message.
func:owned_name_error = NIL(ModuleGraph->:g, int32:pscope, int32:name, string:what,
                            Span:at, bool:against_prelude) never fails {
    if (raw intern_is_none(name)) { pass NIL; }
    string:nm = raw intern_get(g.interns, name);
    if (raw string_eq(nm, "Error")) {
        string:m1 = "`Error` is the compiler's error type (D-179), so a program cannot declare it as ";
        string:m2 = string_concat(m1, what);
        drop diaglist_push(g.diags, raw diag_error(raw RESOLVE_DUPLICATE(),
            string_concat(m2, ": the name resolves to that type in every scope and cannot be shadowed into meaning less (D-239)"),
            at));
        pass NIL;
    }
    if (against_prelude) {
        if (raw prelude_owns(g, pscope, name)) {
            string:p1 = string_concat("`", nm);
            string:p2 = string_concat(p1, "` is declared by the prelude, so a program cannot declare it as ");
            string:p3 = string_concat(p2, what);
            drop diaglist_push(g.diags, raw diag_error(raw RESOLVE_DUPLICATE(),
                string_concat(p3, ": a nearer binding would silently take the name over inside its own scope (D-239)"),
                at));
        }
    }
    pass NIL;
};

func:owned_what = string(DeclNode:d) never fails {
    if (d.kind == DeclKind.DeclFunctionDecl) { pass "a function"; }
    if (d.kind == DeclKind.DeclStructDecl)   { pass "a struct"; }
    if (d.kind == DeclKind.DeclEnumDecl)     { pass "an enum"; }
    if (d.kind == DeclKind.DeclTraitDecl)    { pass "a trait"; }
    if (d.kind == DeclKind.DeclMacroDecl)    { pass "a macro"; }
    if (d.kind == DeclKind.DeclOpaqueDecl)   { pass "an opaque struct"; }
    if (d.kind == DeclKind.DeclGlobalDecl)   { pass "a module binding"; }
    if (d.kind == DeclKind.DeclUnitDecl)     { pass "a unit"; }
    if (d.kind == DeclKind.DeclErrorDecl)    { pass "an error identity"; }
    if (d.kind == DeclKind.DeclModuleDecl)   { pass "a module"; }
    pass "a declaration";
};

// The generic parameters a declaration opens, `<T, U>` -- a window of
// DeclGenericParam declarations, each a name nothing but this walk checks.
func:owned_generic_params = NIL(ModuleGraph->:g, int32:pscope, DeclNode:d) never fails {
    IdSpan:gw = raw decl_generic_window(@g.ast, d);
    for (int32:k in 0i32...gw.count) {
        DeclId:gpid = DeclId{ index: raw ast_id_at(@g.ast, gw.start, k) };
        DeclNode:p = raw ast_decl(@g.ast, gpid);
        if (p.kind == DeclKind.DeclGenericParam) {
            drop owned_name_error(g, pscope, raw decl_name(p), "a generic parameter", p.span, true);
        }
    }
    pass NIL;
};

// A trait's or an impl's members: an `assoc` is a type name checked against both
// owners; a method opens generic parameters of its own.
func:owned_names_in_members = NIL(ModuleGraph->:g, int32:pscope, DeclNode:d, bool:is_impl) never fails {
    int32:n = 0i32;
    if (is_impl) { n = raw impl_member_count(@g.ast, d); }
    else { n = raw item_member_count(@g.ast, d); }
    for (int32:i in 0i32...n) {
        DeclId:mid = DeclId{ index: 0i32 };
        if (is_impl) { mid = raw impl_member(@g.ast, d, i); }
        else { mid = raw item_member(@g.ast, d, i); }
        DeclNode:m = raw ast_decl(@g.ast, mid);
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            drop owned_name_error(g, pscope, raw decl_name(m), "an associated type", m.span, true);
        }
        if (m.kind == DeclKind.DeclFunctionDecl) {
            drop owned_generic_params(g, pscope, m);
        }
    }
    pass NIL;
};

func:owned_names_in_module = NIL(ModuleGraph->:g, DeclId:mod_id, int32:pscope) never fails {
    DeclNode:m = raw ast_decl(@g.ast, mod_id);
    int32:n = raw item_member_count(@g.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(@g.ast, m, i);
        DeclNode:d = raw ast_decl(@g.ast, item);
        if (d.kind == DeclKind.DeclImportDecl) { continue; }
        if (d.kind == DeclKind.DeclExternBlock) { continue; }
        if (d.kind == DeclKind.DeclImplDecl) {
            // an impl declares no name of its own; its parameters and its
            // methods' parameters are names
            drop owned_generic_params(g, pscope, d);
            drop owned_names_in_members(g, pscope, d, true);
            continue;
        }
        drop owned_name_error(g, pscope, raw decl_name(d), raw owned_what(d), d.span, false);
        drop owned_generic_params(g, pscope, d);
        if (d.kind == DeclKind.DeclTraitDecl) {
            drop owned_names_in_members(g, pscope, d, false);
        }
        if (d.kind == DeclKind.DeclModuleDecl) {
            drop owned_names_in_module(g, item, pscope);
        }
    }
    pass NIL;
};

// Load a root file and everything it reaches, transitively.
//
// Breadth-first over discovery order, which is deterministic given the root: the
// queue is the graph's own module list, walked with an index that never moves
// backward. Nothing here is decided by "whichever came first" in a sense the
// source does not define.
pub func:graph_load_all = int32(ModuleGraph->:g, string:root_path) never fails {
    int32:first = raw graph_load(g, root_path, raw span_none());
    if (first < 0i32) {
        pass first;
    }
    g.root_index = first;

    // The list grows as imports are discovered, so this walks past its own tail.
    //
    // THE PRELUDE IS SKIPPED, and the reason is the shape of a file's own header.
    // `mod:name;` with no members is an EXTERNAL FILE MODULE (MODULE_REFERENCE
    // 1.1) — the body lives in `name.npk` — and a file's own first line is exactly
    // that shape. For an ordinary file it is harmless: the load finds the file
    // itself, already in the graph, and returns. The prelude's text is a constant
    // with no file behind it, so the same walk goes looking for `prelude.npk` on
    // disk and reports that it is missing.
    int32:i = 0i32;
    while ((i => int64) < g.v.count) {
        if (i != g.prelude) { drop graph_load_imports(g, i); }
        i = i + 1i32;
    }
    pass first;
};

func:graph_load_imports = NIL(ModuleGraph->:g, int32:index) never fails {
    ModuleEntry:e = raw graph_at(g, index);
    string:from = raw srcmgr_resolved_proven(@g.sm, e.file);   // resolution walks the OPENED path (D-236)
    DeclId:rootId = DeclId{ index: e.root };
    DeclNode:m = raw ast_decl(@g.ast, rootId);

    int32:n = raw item_member_count(@g.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(@g.ast, m, i);
        DeclNode:d = raw ast_decl(@g.ast, item);

        if (d.kind == DeclKind.DeclImportDecl) {
            drop graph_load_import(g, from, d);
        }
        // `mod:name;` with an empty member list is an EXTERNAL FILE MODULE
        // (MODULE_REFERENCE 1.1) -- the body lives in name.npk. An inline
        // `mod:name = { … };` has its members already and loads nothing.
        if (d.kind == DeclKind.DeclModuleDecl) {
            if ((raw item_member_count(@g.ast, d)) == 0i32) {
                // THE FIRST ITEM IS THE HEADER SLOT (D-248, 1.5.1b step 1):
                // `check_file_header` judged it when the file was parsed, and
                // whatever it says it loads NOTHING -- a wrong header used to
                // load the sibling it named. A member-less `mod:name;` anywhere
                // after it is the import it always was.
                if (i == 0i32) { continue; }
                drop graph_load_file_module(g, from, d);
            }
        }
    }
    pass NIL;
};

func:graph_load_import = NIL(ModuleGraph->:g, string:from, DeclNode:d) never fails {
    int32:path_idx = raw import_path(d);
    if (raw intern_is_none(path_idx)) {
        // A LOGICAL path (`use std.math.*`). Its segments are held separately;
        // joining them to a file is the standard library's business and lands
        // with the driver, which is what knows where the standard library is.
        pass NIL;
    }
    string:target = raw intern_get(g.interns, path_idx);
    Resolution:r = raw resolve_use(from, target, g.roots, g.stdlib);
    if (r.status != (raw RESOLVED_OK())) {
        drop report_resolution(g.diags, r, target, d.span);
        pass NIL;
    }
    discard(raw graph_load(g, r.path, d.span));
    pass NIL;
};

// `mod:network;` searches for `network.npk` OR `network/mod.npk` relative to the
// declaring file. FINDING BOTH IS AN ERROR by the same rule as 0.3.2: two files
// can supply one module, and picking one silently makes the answer depend on
// something the reader cannot see.
func:graph_load_file_module = NIL(ModuleGraph->:g, string:from, DeclNode:d) never fails {
    string:name = raw intern_get(g.interns, raw decl_name(d));
    string:dir = raw path_dirname(from);

    string:flat = raw path_normalise(
        raw path_join(dir, string_concat(name, ".npk")));
    string:nested = raw path_normalise(
        raw path_join(dir, string_concat(name, "/mod.npk")));

    // A path with an interior NUL names no file (D-049), so the probe's
    // answer for one is FALSE — not an error to propagate. The only way a NUL
    // gets here is a user-written import string, so this is reachable input,
    // never a defect.
    Result<cstring>:fc = to_cstring(flat);
    Result<cstring>:nc = to_cstring(nested);
    bool:has_flat = false;
    if (!fc.is_error) { has_flat = path_exists(fc.value); }
    bool:has_nested = false;
    if (!nc.is_error) { has_nested = path_exists(nc.value); }

    if (has_flat) {
        if (has_nested) {
            string:m1 = string_concat("module `", name);
            string:m2 = string_concat(m1, "` is supplied by both ");
            string:m3 = string_concat(m2, flat);
            string:m4 = string_concat(m3, " and ");
            string:m5 = string_concat(m4, nested);
            drop diaglist_push(g.diags,
                raw diag_error(raw RESOLVE_AMBIGUOUS(), move(m5), d.span));
            pass NIL;
        }
        discard(raw graph_load(g, flat, d.span));
        pass NIL;
    }
    if (has_nested) {
        discard(raw graph_load(g, nested, d.span));
        pass NIL;
    }

    string:n1 = string_concat("cannot find module `", name);
    string:n2 = string_concat(n1, "`: neither ");
    string:n3 = string_concat(n2, flat);
    string:n4 = string_concat(n3, " nor ");
    string:n5 = string_concat(n4, nested);
    // The "if this line is the file's own header" hint (1.0.8) retired at
    // 1.5.1b step 1: a header is checked directly now (`check_file_header`,
    // D-248), so a member-less `mod:` that reaches here is an import and the
    // file it names is what is missing.
    drop diaglist_push(g.diags,
        raw diag_error(raw RESOLVE_NO_SUCH_FILE(), move(n5), d.span));
    pass NIL;
};

// --- struct-size cycles ------------------------------------------------------------------
//
// D-086 says to report a cycle ONLY when it is genuinely unresolvable, and names
// the first case: a struct whose size depends on itself other than through a
// pointer.
//
//     struct:A = { B:b; };  struct:B = { A:a; };     // unresolvable
//     struct:A = { B->:b; };  struct:B = { A:a; };   // fine: a pointer is one word
//
// A pointer breaks the cycle because its size does not depend on what it points
// at (D-038, thin pointers). This is checked HERE rather than in cycle 0.4
// because it needs no types — only the shape of the field's type node, which the
// parser already built.
//
// The `const` case D-086 also names — an initialiser depending on itself — needs
// name resolution and lands in 0.3.5.

// Does this type node refer DIRECTLY to a named type, with no pointer between?
func:direct_named_type = int32(Ast->:ast, TypeId:t) never fails {
    if (raw type_is_none(t)) {
        pass 0i32;
    }
    TypeNode:n = raw ast_type(ast, t);
    if (n.kind == TypeKind.TypeNamedType) {
        // A BUILTIN TYPE KEYWORD CARRIES A TOKEN KIND, NOT AN INTERN INDEX
        // (0.2.2) — the same two-meanings slot `resolve_named` had to learn.
        // This read it raw for four cycles, so every `int32:` field grew a
        // containment edge to whatever identifier happened to sit at intern
        // index ~85-175: garbage edges that both powered the walk's exponential
        // fanout and, once the walk was memoised deep enough to follow them,
        // manufactured "cycles" between structs made of plain integers.
        if (raw type_name_is_builtin(n)) {
            pass 0i32;
        }
        pass (n.payload =>! int32);
    }
    // A fixed array of T contains its elements, so its size DOES depend on T.
    // A slice does not: it is {ptr, i64} whatever it points at (D-070).
    if (n.kind == TypeKind.TypeArrayType) {
        if (raw type_is_slice(n)) {
            pass 0i32;
        }
        pass (raw direct_named_type(ast, raw type_element(n)));
    }
    // AN OPTIONAL LAYS ITS VALUE OUT INLINE — `{ i8, T }` (TYPE_REFERENCE
    // §11.1), so `struct:A = { A?:a; }` is as infinite as `A:a;` would be.
    // This said "a pointer or an optional breaks the dependency: one word",
    // and `tt_optional` has never laid it out as one: the self-containing
    // struct escaped the RESOLVE-006 check (found by the 1.0.8 audit, fixed
    // before any program relied on it). A pointer IS one word.
    if (n.kind == TypeKind.TypeOptionalType) {
        pass (raw direct_named_type(ast, raw type_element(n)));
    }
    pass 0i32;
};

// Walk from `start` following direct containment, looking for `start` again.
//
// MEMOISED PER QUERY (0.8.3). The first version was a bare DFS, and a bare DFS
// over a DAG is exponential in the sharing: every struct that contains two
// already-visited structs doubles the walk. It held for four cycles because no
// program's containment graph had a real hub — and then `Front` arrived, ten
// aggregate fields each containing the table structs the others also contain,
// and self-checking the compiler went from seconds to past the harness's
// ten-minute timeout. The `seen` set makes revisits O(1); correctness is
// unchanged because containment is being tested for REACHABILITY of `start`,
// and a name that failed to reach it once cannot reach it later in the same
// query.
func:struct_reaches_self = bool(ModuleGraph->:g, int32:scope, int32:start,
                                int32:current, int32:fuel) never fails {
    // The seen-set is intern-indexed. Interns only grow, so the capacity is
    // read once per query.
    int32:cap = raw intern_count(g.interns);
    wild int8->:seen = calloc(cap => int64, 1i64);
    pass (raw reaches_memo(g, scope, start, current, fuel, seen, cap));
};

func:reaches_memo = bool(ModuleGraph->:g, int32:scope, int32:start,
                         int32:current, int32:fuel, wild int8->:seen,
                         int32:cap) never fails {
    if (fuel <= 0i32) {
        pass false;
    }
    if (current < cap) {
        if (seen[current => int64] != 0i8) { pass false; }
        seen[current => int64] = 1i8;
    }
    int32:sym = raw scope_lookup(@g.tab, scope, current);
    if (sym == 0i32) {
        pass false;
    }
    Symbol:s = raw symtab_get(@g.tab, sym);
    if (s.origin_kind != (raw SYM_DECL())) {
        pass false;
    }
    DeclId:did = DeclId{ index: s.origin };
    DeclNode:d = raw ast_decl(@g.ast, did);
    if (d.kind != DeclKind.DeclStructDecl) {
        pass false;
    }

    int32:n = raw item_member_count(@g.ast, d);
    for (int32:i in 0i32...n) {
        DeclId:fid = raw item_member(@g.ast, d, i);
        DeclNode:f = raw ast_decl(@g.ast, fid);
        int32:named = raw direct_named_type(@g.ast, raw field_type(f));
        if (named != 0i32) {
            if (named == start) {
                pass true;
            }
            if (raw reaches_memo(g, scope, start, named, fuel - 1i32,
                                   seen, cap)) {
                pass true;
            }
        }
    }
    pass false;
};

// Report every struct whose size depends on itself.
//
// Modules are visited in graph order and structs within a module in declaration
// order, so the diagnostics come out in the same sequence on every run — which is
// the order-independence D-086 requires, applied to the output as well as to the
// result.
pub func:graph_check_struct_cycles = NIL(ModuleGraph->:g) never fails {
    int32:mi = 0i32;
    while ((mi => int64) < g.v.count) {
        ModuleEntry:e = raw graph_at(g, mi);
        DeclId:rootId = DeclId{ index: e.root };
        DeclNode:m = raw ast_decl(@g.ast, rootId);

        int32:n = raw item_member_count(@g.ast, m);
        for (int32:i in 0i32...n) {
            DeclId:item = raw item_member(@g.ast, m, i);
            DeclNode:d = raw ast_decl(@g.ast, item);
            if (d.kind == DeclKind.DeclStructDecl) {
                int32:name = raw decl_name(d);
                if (raw struct_reaches_self(g, e.scope, name, name, 64i32)) {
                    string:nm = raw intern_get(g.interns, name);
                    string:m1 = string_concat("`", nm);
                    string:m2 = string_concat(m1,
                        "` contains itself, so its size cannot be computed; a `->` breaks the cycle because a pointer is one word whatever it points at");
                    drop diaglist_push(g.diags,
                        raw diag_error(raw RESOLVE_CYCLE(), move(m2), d.span));
                }
            }
        }
        mi = mi + 1i32;
    }
    pass NIL;
};

// --- one name per member ------------------------------------------------------------------
//
// TWO FIELDS OF ONE NAME WERE ACCEPTED, and the second was unreachable: field
// lookup returns the FIRST match, while layout gives both storage. So the struct
// was the size of two fields and only one of them could ever be read or written —
// silently, with no diagnostic anywhere.
//
// FOUND VIA MACRO SPLICING (0.6.3), WHICH IS NOT WHERE IT LIVES. `struct:P = {
// #xy(); #xy(); };` produces the collision by accident, which is what made it worth
// looking for — but `struct:P = { int32:x; int32:x; };` was accepted just the same,
// so the rule is about STRUCTS and not about macros. A check that fired only on
// spliced fields would be the construct-means-something-different-by-context defect
// that the whole language is arranged to avoid.
//
// IT IS ALSO THE ANSWER TO WHETHER EMITTED NAMES ARE HYGIENIC (D-128). They are
// not renamed — a renamed field could not be named by the caller, and a renamed
// emitted function could not be called — so a collision is an error like any other
// name declared twice, and this is what makes it one.
pub func:graph_check_dup_members = NIL(ModuleGraph->:g) never fails {
    int32:mi = 0i32;
    while ((mi => int64) < g.v.count) {
        ModuleEntry:e = raw graph_at(g, mi);
        drop check_dup_in_module(g, DeclId{ index: e.root });
        mi = mi + 1i32;
    }
    pass NIL;
};

func:check_dup_in_module = NIL(ModuleGraph->:g, DeclId:mod_id) never fails {
    DeclNode:m = raw ast_decl(@g.ast, mod_id);
    int32:n = raw item_member_count(@g.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(@g.ast, m, i);
        DeclNode:d = raw ast_decl(@g.ast, item);
        if (d.kind == DeclKind.DeclStructDecl) {
            drop check_dup_members(g, d, "field");
        }
        if (d.kind == DeclKind.DeclEnumDecl) {
            drop check_dup_members(g, d, "variant");
        }
        // A NESTED MODULE IS WALKED, unlike the struct-cycle check beside this one.
        // Its members are declarations like any other and nothing about them is
        // different for being one level in.
        if (d.kind == DeclKind.DeclModuleDecl) {
            drop check_dup_in_module(g, item);
        }
    }
    pass NIL;
};

// QUADRATIC IN THE MEMBER COUNT, deliberately. A struct has tens of fields, not
// thousands, and the alternative is a set keyed by intern index — a second
// structure to allocate and keep in step for a loop that is already the cheapest
// thing in the pass.
func:check_dup_members = NIL(ModuleGraph->:g, DeclNode:d, string:what) never fails {
    int32:n = raw item_member_count(@g.ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:a = raw ast_decl(@g.ast, raw item_member(@g.ast, d, i));
        int32:anode = raw decl_name(a);
        if (!(raw intern_is_none(anode))) {
            int32:j = i + 1i32;
            while (j < n) {
                DeclNode:b = raw ast_decl(@g.ast, raw item_member(@g.ast, d, j));
                if ((raw decl_name(b)) == anode) {
                    string:nm = raw intern_get(g.interns, anode);
                    string:m1 = string_concat("`", nm);
                    string:m2 = string_concat(m1, "` is declared twice as a ");
                    string:m3 = string_concat(m2, what);
                    string:m4 = string_concat(m3,
                        " of this type; the second is unreachable, because a lookup by name finds the first and gets no say in which was meant");
                    drop diaglist_push(g.diags,
                        raw diag_error(raw RESOLVE_DUPLICATE(), move(m4), b.span));
                }
                j = j + 1i32;
            }
        }
    }
    pass NIL;
};

// --- binding imports ---------------------------------------------------------------------
//
// A THIRD PASS, after every module is loaded and collected.
//
// It cannot run during loading: `use "./b.npk".*` needs b's declarations, and in a
// cycle b's import of a needs a's. Running imports only once everything is
// collected removes the ordering question entirely rather than answering it —
// the same move D-086 makes for bodies, applied one level earlier.
//
// Modules are visited in graph order and imports in declaration order, so the
// bindings and any diagnostics come out identically on every run.

pub func:graph_find_by_path = int32(ModuleGraph->:g, string:path) never fails {
    int32:file = raw srcmgr_find(@g.sm, raw path_normalise(path));
    if (file < 0i32) {
        pass (0i32 - 1i32);
    }
    pass (raw graph_find(g, file));
};

// RUN TO A FIXED POINT, then report once.
//
// A single pass is not enough and the reason is `pub use`. If `user` imports
// `middle` and `middle` re-exports something from `other`, then binding `user`
// before `middle` finds nothing to bring across — and with cycles legal (D-086)
// there is no dependency order to visit in, because a cycle has none.
//
// So the pass repeats until a whole round adds no binding. THE FIXED POINT IS
// WHAT MAKES THE RESULT INDEPENDENT OF MODULE ORDER: it is the same set of
// bindings whichever module is visited first, which is D-086's third obligation
// and a reproducibility requirement before it is a convenience. It terminates
// because bindings only ever grow and the number of names is finite.
//
// Binding is IDEMPOTENT, so the repeats cost nothing and a re-export chain
// reaching one declaration by two routes is not a conflict. Diagnostics are held
// back to a final pass, or every round would report the same collision again.
pub func:graph_apply_imports = NIL(ModuleGraph->:g) never fails {
    while (true) {
        int32:before = raw symtab_count(@g.tab);
        int32:i = 0i32;
        while ((i => int64) < g.v.count) {
            drop module_apply_imports(g, i, false);
            i = i + 1i32;
        }
        if ((raw symtab_count(@g.tab)) == before) {
            break;
        }
    }

    int32:k = 0i32;
    while ((k => int64) < g.v.count) {
        drop module_apply_imports(g, k, true);
        k = k + 1i32;
    }
    pass NIL;
};

func:module_apply_imports = NIL(ModuleGraph->:g, int32:index, bool:report) never fails {
    ModuleEntry:e = raw graph_at(g, index);
    string:from = raw srcmgr_resolved_proven(@g.sm, e.file);   // resolution walks the OPENED path (D-236)
    DeclId:rootId = DeclId{ index: e.root };
    DeclNode:m = raw ast_decl(@g.ast, rootId);

    int32:n = raw item_member_count(@g.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(@g.ast, m, i);
        DeclNode:d = raw ast_decl(@g.ast, item);
        if (d.kind == DeclKind.DeclImportDecl) {
            drop apply_one_import(g, from, e.scope, d, report);
        }
    }
    pass NIL;
};

func:apply_one_import = NIL(ModuleGraph->:g, string:from, int32:scope,
                            DeclNode:d, bool:report) never fails {
    int32:path_idx = raw import_path(d);
    if (raw intern_is_none(path_idx)) {
        pass NIL;          // a logical path; the driver resolves those
    }
    string:target = raw intern_get(g.interns, path_idx);
    Resolution:r = raw resolve_use(from, target, g.roots, g.stdlib);
    if (r.status != (raw RESOLVED_OK())) {
        pass NIL;          // already reported while loading
    }
    int32:mi = raw graph_find_by_path(g, r.path);
    if (mi < 0i32) {
        pass NIL;
    }
    ModuleEntry:src = raw graph_at(g, mi);

    // `pub use` re-exports; a plain `use` does not. The bit set here is the whole
    // of "imports do not chain" -- nothing downstream has to check for it.
    int32:extra = 0i32;
    if (raw import_is_reexport(@g.ast, d)) {
        extra = raw SYM_PUB();
    }

    int32:kind = raw import_kind(d);

    // `use "./m.npk" as math;` binds the MODULE, so `math.sqrt` resolves through
    // it in 0.3.5.
    if (kind == (raw IMPORT_NAMESPACE())) {
        int32:alias = raw import_alias(@g.ast, d);
        DeclId:srcRoot = DeclId{ index: src.root };
        drop bind_or_report(g, scope, alias, raw SYM_DECL(), srcRoot.index,
                            extra, d.span, target, report);
        pass NIL;
    }

    if (kind == (raw IMPORT_WILDCARD())) {
        drop bind_wildcard(g, scope, src.scope, extra, d.span, target, report);
        pass NIL;
    }

    // Single and selective differ only in how many names they name.
    int32:count = raw import_name_count(@g.ast, d);
    for (int32:k in 0i32...count) {
        int32:want = raw import_name(@g.ast, d, k);
        drop bind_named(g, scope, src.scope, want, extra, d.span, target, report);
    }
    pass NIL;
};

// A named import: the symbol must exist AND be exported, and the two failures get
// different diagnostics.
//
// "not found" and "found but private" are different mistakes and the reader can
// act on exactly one of them: the first means check the spelling, the second
// means the other module has to decide to share it. Collapsing them into one
// message makes the reader test both.
func:bind_named = NIL(ModuleGraph->:g, int32:scope, int32:src_scope,
                      int32:name, int32:extra, Span:at, string:target,
                      bool:report) never fails {
    int32:sym = raw scope_lookup_local(@g.tab, src_scope, name);
    string:nm = raw intern_get(g.interns, name);

    if (sym == 0i32) {
        if (!report) { pass NIL; }
        string:m1 = string_concat("`", target);
        string:m2 = string_concat(m1, "` has no `");
        string:m3 = string_concat(m2, nm);
        string:m4 = string_concat(m3, "`");
        drop diaglist_push(g.diags,
            raw diag_error(raw RESOLVE_NO_SUCH_NAME(), move(m4), at));
        pass NIL;
    }

    Symbol:s = raw symtab_get(@g.tab, sym);
    if (!(raw symbol_is_exported(s))) {
        if (!report) { pass NIL; }
        string:p1 = string_concat("`", nm);
        string:p2 = string_concat(p1, "` is private to `");
        string:p3 = string_concat(p2, target);
        string:p4 = string_concat(p3, "`");
        drop diaglist_push(g.diags,
            raw diag_error(raw RESOLVE_PRIVATE(), move(p4), at));
        drop diaglist_push(g.diags,
            raw diag_note(raw RESOLVE_PRIVATE(), "declared here",
                          raw symbol_span(@g.ast, @g.tab, sym)));
        pass NIL;
    }

    drop bind_or_report(g, scope, name, s.origin_kind, s.origin, extra, at,
                        target, report);
    pass NIL;
};

// Every exported symbol of the source module.
//
// A NAME THE IMPORTING FILE ALREADY DECLARES IS NOT OVERWRITTEN, and the
// collision is reported as a warning. The local declaration wins, which is the
// only defensible rule -- a file's own declarations cannot be at the mercy of
// what a dependency happens to export this week -- but a bare name that two
// things could plausibly mean is worth a word to the reader.
func:bind_wildcard = NIL(ModuleGraph->:g, int32:scope, int32:src_scope,
                         int32:extra, Span:at, string:target, bool:report) never fails {
    int32:n = raw scope_symbol_count(@g.tab, src_scope);
    for (int32:i in 0i32...n) {
        int32:sym = raw scope_symbol_at(@g.tab, src_scope, i);
        if (sym != 0i32) {
            Symbol:s = raw symtab_get(@g.tab, sym);
            if (raw symbol_is_exported(s)) {
                int32:bound = raw symtab_bind_import(@g.tab, scope, s.name,
                                                     s.origin_kind, s.origin, extra);
                if (bound == 0i32) {
                    if (report) {
                    string:nm = raw intern_get(g.interns, s.name);
                    string:m1 = string_concat("`", nm);
                    // WHICH CLASH (1.0.8). `symtab_bind_import` declines for any
                    // earlier binding, and an earlier IMPORT is one: with two
                    // wildcard imports exporting one name, this said "declared
                    // here … the local declaration wins" about a file that
                    // declares nothing of the sort, at the `use` line. An
                    // import-against-import is the loader's ambiguity (D-159);
                    // an import-against-declaration is the shadowing, and the
                    // declaration is where "here" is.
                    int32:clash = raw scope_lookup_local(@g.tab, scope, s.name);
                    bool:prior_import = false;
                    if (clash != 0i32) {
                        prior_import = raw symbol_is_imported(raw symtab_get(@g.tab, clash));
                    }
                    // TWO ERROR CONSTANTS SHARING A NAME ARE NOT A CLASH WORTH
                    // A WARNING (D-179): identity is module-qualified by
                    // construction (the code is the hash of `module.Name`), a
                    // module's own sites bind its local constant, and a
                    // `failsafe` arm reaching across modules writes the
                    // qualified spelling. Warning here would fire on every
                    // multi-module error vocabulary — the exact naming pattern
                    // the design encourages.
                    bool:err_pair = false;
                    if (clash != 0i32) {
                        Symbol:cs2 = raw symtab_get(@g.tab, clash);
                        if ((raw ast_decl(@g.ast, DeclId{ index: cs2.origin })).kind
                                == DeclKind.DeclErrorDecl) {
                            if ((raw ast_decl(@g.ast, DeclId{ index: s.origin })).kind
                                    == DeclKind.DeclErrorDecl) {
                                err_pair = true;
                            }
                        }
                    }
                    if (prior_import) { if (!err_pair) {
                        string:i2 = string_concat(m1,
                            "` is exported by an earlier import and also by `");
                        string:i3 = string_concat(i2, target);
                        drop diaglist_push(g.diags,
                            raw diag_warning(raw RESOLVE_SHADOWED(),
                                string_concat(i3, "`; the earlier import is bound — import one of them by name to say which"),
                                at));
                    } } else { if (!err_pair) {
                    string:m2 = string_concat(m1,
                        "` is declared in this file and also exported by `");
                    string:m3 = string_concat(m2, target);
                    string:m4 = string_concat(m3,
                        "`; the local declaration wins");
                    drop diaglist_push(g.diags,
                        raw diag_warning(raw RESOLVE_SHADOWED(), move(m4), at));
                    if (clash != 0i32) {
                        drop diaglist_push(g.diags,
                            raw diag_note(raw RESOLVE_SHADOWED(),
                                string_concat(m1, "` is declared here"),
                                raw symbol_span(@g.ast, @g.tab, clash)));
                    }
                    } }
                    }
                }
            }
        }
    }
    pass NIL;
};

// Bind one name, reporting the collision a NAMED import causes.
//
// A named import that collides is louder than a wildcard one: the author wrote
// this name on this line, so silently doing nothing would be the wrong answer to
// something they asked for explicitly.
func:bind_or_report = NIL(ModuleGraph->:g, int32:scope, int32:name,
                          int32:origin_kind, int32:origin, int32:extra,
                          Span:at, string:target, bool:report) never fails {
    int32:bound = raw symtab_bind_import(@g.tab, scope, name,
                                         origin_kind, origin, extra);
    if (bound == 0i32) {
        if (!report) { pass NIL; }
        string:nm = raw intern_get(g.interns, name);
        string:m1 = string_concat("`", nm);
        // DECLARED, OR IMPORTED EARLIER — two different fixes (1.0.8).
        int32:clash = raw scope_lookup_local(@g.tab, scope, name);
        string:m2 = string_concat(m1, "` is already declared in this module");
        if (clash != 0i32) {
            if (raw symbol_is_imported(raw symtab_get(@g.tab, clash))) {
                m2 = string_concat(m1, "` is already imported into this module by an earlier `use`");
            }
        }
        drop diaglist_push(g.diags,
            raw diag_error(raw RESOLVE_DUPLICATE(), move(m2), at));
    }
    pass NIL;
};

// THE MODULE NAME ERROR CODES HASH UNDER (D-179): the file's basename, minus
// its extension. The `mod:` line must MATCH the basename where present
// (NITPICK-RESOLVE-005), files without one still have a name this way, and
// the seed derives the same string from the same path — which is what keeps
// the two compilers numbering identically.
pub func:module_basename_intern = int32(ModuleGraph->:g, int32:file,
                                        InternTable->:it) never fails {
    string:p = raw srcmgr_resolved_proven(@g.sm, file);
    int64:start = 0i64;
    int64:i = 0i64;
    while (i < p.len) {
        if (p.ptr[i] == 47u8) { start = i + 1i64; }
        i = i + 1i64;
    }
    int64:endx = p.len;
    if (endx >= (start + 4i64)) {
        if (p.ptr[endx - 4i64] == 46u8) {
            if (p.ptr[endx - 3i64] == 110u8) {
                if (p.ptr[endx - 2i64] == 112u8) {
                    if (p.ptr[endx - 1i64] == 107u8) {
                        endx = endx - 4i64;
                    }
                }
            }
        }
    }
    string:b = string_slice(p, start, endx) ?! ProvenSlice;
    pass (raw intern_add(it, move(b)));
};
