// Name resolution — phase 2 of the two-phase load.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.3.5.
//
// Every identifier in every body binds to exactly one symbol, or produces
// exactly one diagnostic. There is no third outcome, and the harness checks
// that there is not.
//
// It runs after every module is loaded, collected and imported, which is what
// makes a `use` cycle resolvable (D-086) and what lets a function call another
// declared below it. By the time anything here runs, every name that exists
// exists.
//
// WHAT IS NOT RESOLVED HERE, and why:
//
//   `p.x`         needs `p`'s TYPE. Resolve `p`; leave `.x` for cycle 0.4.
//   `p.method()`  the same — the receiver is resolved, the method is not.
//   a type name   types are resolved in 0.4, where a type is more than a name.
//
// The line is not arbitrary: everything above needs to know what something IS,
// and this pass only knows what names EXIST. Guessing across that line is how a
// resolver ends up half a type checker.

mod:resolve;
use "./list.npk".*;
use "./source_location.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./resolve_codes.npk".*;
use "./builtins.npk".*;
use "./parse_decl.npk".*;
use "./parse_stmt.npk".*;
use "./parse_expr.npk".*;
use "./parse_pick.npk".*;
use "./parse_decorate.npk".*;
use "./symbols.npk".*;

pub struct:Resolver = {
    Ast->:ast;
    SymbolTable->:tab;
    InternTable->:interns;
    DiagList->:diags;
    int32:module_scope;

    // (`in_ensures` stood here until 1.5.1 step 3: `result` was an ordinary
    // identifier the walk exempted inside `ensures`, so a parameter of that
    // name bound first and shadowed the return value in its own
    // postcondition. `result` is a keyword with its own node now, D-221/S-18,
    // and the resolver has nothing to exempt.)

    // WHERE THE INVOCATION WAS, while a macro expansion is being resolved.
    //
    // Hygiene (D-057) makes an expansion resolve in the scope the macro was
    // WRITTEN in, and `module_scope` is that scope — a macro is invocable only in
    // the module that declares it (D-124), so the two are the same. This is the
    // OTHER one: `#caller(NAME)` is the sole way back out to the invocation site,
    // and this is the scope it reaches. Zero outside an expansion, which is
    // exactly when `#caller` is not a legal thing to have written.
    int32:caller_scope;

    // D-179: whether the module being resolved IS the prelude (the pipeline
    // sets it per module), the module's own name (for code derivation), and
    // the registry of assigned codes for collision refusal. A user
    // constant's code is the FNV hash of `module.Name`, truncated positive —
    // derived from the declaration itself, so the seed and this compiler
    // number identically without sharing a walk order, which is what keeps
    // the stage-1/stage-2 fixpoint honest (D-078).
    bool:in_prelude;
    int32:module_name;
    // SoA KEPT, two Lists (1.4.7 step 2). Both counts move together -- every
    // record pushes both -- which is this pair's invariant now that the shared
    // `ecount` is gone.
    List<int32>:ecodes;
    List<int32>:edecls;
};

pub func:resolver_init = Resolver(Ast->:ast, SymbolTable->:tab,
                                  InternTable->:interns, DiagList->:diags) never fails {
    Resolver:r = Resolver{ ast: ast, tab: tab, interns: interns, diags: diags,
                           module_scope: 0i32,
                           caller_scope: 0i32,
                           in_prelude: false, module_name: 0i32,
                           ecodes: raw list_init::<int32>(16i64),
                           edecls: raw list_init::<int32>(16i64) };
    pass r;
};

// --- the identifier ------------------------------------------------------------------

func:resolve_ident = NIL(Resolver->:r, ExprId:id, int32:scope) never fails {
    ExprNode:e = raw ast_expr(r.ast, id);
    int32:name = (raw expr_name(e)) =>! int32;

    // `#caller(NAME)` LEFT THIS BEHIND. It is the one identifier inside an
    // expansion that binds where the macro was INVOKED rather than where it was
    // written, and the mark is how it is told apart from the ones around it —
    // which are lexically in the same place and mean something else entirely.
    int32:look = scope;
    if (raw ast_expr_flag(r.ast, id, raw HYG_CALLER())) {
        if (r.caller_scope == 0i32) {
            drop diaglist_push(r.diags, raw diag_error(raw RESOLVE_INTERNAL(),
                "this `#caller` name is outside any macro expansion, which the expander should have refused",
                e.span));
            pass NIL;
        }
        look = r.caller_scope;
    }

    int32:sym = raw scope_lookup(r.tab, look, name);
    if (sym != 0i32) {
        // RECORD THE BINDING ON THE NODE. Cycle 0.4 asks what this name means
        // constantly, and repeating the walk each time would make resolution
        // quadratic in nesting depth for no reason.
        drop ast_set_expr_a(r.ast, id, sym);
        pass NIL;
    }

    string:text = raw intern_get(r.interns, name);

    // A bare-name builtin is declared in no module (AST_REFERENCE 3.3): `alloc`,
    // `string_concat`, `sys` and the rest of `builtins.npk`. They are ordinary
    // calls the compiler happens to provide, so they resolve to nothing and that
    // is correct — the binding stays 0 and the emitter recognises the name.
    //
    // This used to name `ok` and `is_err` too, and both halves of that were
    // false: they are KEYWORDS, so they never lex as identifiers and cannot
    // arrive here, and they are not in `builtins.npk` either. They are keyword
    // operators with their own nodes (D-096).
    if (raw is_builtin_name(text)) {
        pass NIL;
    }

    string:m1 = string_concat("cannot find `", text);
    string:m2 = string_concat(m1, "` in this scope");

    // WHICH SCOPE, when it is not the one the reader is looking at. Inside an
    // expansion the name was looked for where the MACRO was written, and a bare
    // "cannot find it in this scope" pointing at an invocation is an answer about
    // a scope the reader is not reading (D-057).
    if (raw ast_expr_flag(r.ast, id, raw HYG_CALLER())) {
        m2 = string_concat(m1, "` at the invocation site; `#caller` names something there, and nothing of that name is in scope where this macro was invoked");
    } else {
        // INSIDE AN EXPANSION is `caller_scope != 0` — it is set around every
        // expansion and cleared after (1.0.8). The test used to be
        // `look != scope`, and in this branch `look` IS `scope`, so the one
        // sentence written for D-057's case was unreachable: the hygiene
        // refusal printed the generic "cannot find it in this scope" at a
        // macro body, the answer about a scope the reader is not reading that
        // the comment above says it avoids.
        if (r.caller_scope != 0i32) {
            m2 = string_concat(m1, "` in the scope this macro was written in; an identifier in a macro body resolves there and never at the invocation site, and `#caller(name)` is the only way to reach the caller's scope");
        }
    }
    drop diaglist_push(r.diags,
        raw diag_error(raw RESOLVE_UNKNOWN(), move(m2), e.span));
    pass NIL;
};

// --- expressions ------------------------------------------------------------------------

// THE HYGIENE SWITCH, AND THE ONLY PLACE IT HAPPENS FOR AN EXPRESSION.
//
// A node marked `HYG_ROOT` is where a macro expansion was substituted in, and
// everything under it resolves where the MACRO was written rather than where it
// was invoked (D-057). A macro is invocable only in the module that declares it
// (D-124), so "where it was written" is `module_scope` and no per-expansion scope
// has to be carried — which is why this is four lines rather than a table.
//
// A WRAPPER RATHER THAN A CHECK INSIDE, because the walk below returns from
// nineteen places and a switch that has to be undone at each of them is a switch
// that will not be, at one of them.
pub func:resolve_expr = NIL(Resolver->:r, ExprId:id, int32:scope) never fails {
    if (raw expr_is_none(id)) {
        pass NIL;
    }
    if (!(raw ast_expr_flag(r.ast, id, raw HYG_ROOT()))) {
        drop resolve_expr_inner(r, id, scope);
        pass NIL;
    }
    int32:saved = r.caller_scope;
    r.caller_scope = scope;
    drop resolve_expr_inner(r, id, r.module_scope);
    r.caller_scope = saved;
    pass NIL;
};

func:resolve_expr_inner = NIL(Resolver->:r, ExprId:id, int32:scope) never fails {
    if (raw expr_is_none(id)) {
        pass NIL;
    }
    ExprNode:e = raw ast_expr(r.ast, id);

    if (e.kind == ExprKind.ExprIdentifierExpr) {
        drop resolve_ident(r, id, scope);
        pass NIL;
    }

    // A MEMBER ACCESS resolves its BASE and stops. `p.x` needs `p`'s type to say
    // anything about `x`, and that is cycle 0.4. `Net.Disconnect` and
    // `math.sqrt` look identical here and are told apart there, for the same
    // reason: one needs to know that `Net` is an enum.
    if (e.kind == ExprKind.ExprMemberAccessExpr) {
        drop resolve_expr(r, raw expr_operand(e), scope);
        pass NIL;
    }
    if (e.kind == ExprKind.ExprSafeNavExpr) {
        drop resolve_expr(r, raw expr_operand(e), scope);
        pass NIL;
    }
    // A method call resolves its RECEIVER and its arguments; the method name is
    // UFCS and needs the receiver's type (D-006).
    if (e.kind == ExprKind.ExprMethodCallExpr) {
        drop resolve_expr(r, raw expr_operand(e), scope);
        drop resolve_expr_window(r, raw expr_list_start(e),
                                 raw expr_list_count(e), scope);
        pass NIL;
    }

    // A struct literal's window alternates NAME, VALUE -- the names are fields
    // and belong to 0.4, so only the odd entries are expressions.
    if (e.kind == ExprKind.ExprStructLiteralExpr) {
        int32:n = raw expr_list_count(e);
        int32:i = 1i32;
        while (i < n) {
            ExprId:v = ExprId{ index: raw ast_id_at(r.ast, raw expr_list_start(e), i) };
            drop resolve_expr(r, v, scope);
            i = i + 2i32;
        }
        pass NIL;
    }

    // A call's window holds generic arguments first and value arguments after;
    // the generics are TYPES and are skipped here.
    if (e.kind == ExprKind.ExprCallExpr) {
        drop resolve_expr(r, raw expr_callee(e), scope);
        int32:gcount = raw expr_generic_count(e);
        drop resolve_expr_window(r, (raw expr_list_start(e)) + gcount,
                                 (raw expr_list_count(e)) - gcount, scope);
        pass NIL;
    }
    if (e.kind == ExprKind.ExprBuiltinExpr) {
        int32:gcount = raw builtin_generic_count(e);
        drop resolve_expr_window(r, (raw expr_list_start(e)) + gcount,
                                 (raw expr_list_count(e)) - gcount, scope);
        pass NIL;
    }

    // An expression-`pick` (D-059) carries statements, so it hands back.
    if (e.kind == ExprKind.ExprPickExpr) {
        drop resolve_expr(r, raw pickx_selector(e), scope);
        drop resolve_arms(r, raw pickx_arm_start(e), raw pickx_arm_count(e), scope);
        pass NIL;
    }

    // EVERYTHING ELSE IS DRIVEN BY `expr_shape` (ast.npk), not by a guess about
    // slot `a`.
    //
    // What stood here walked slot `a` unconditionally, on the strength of a
    // comment claiming it "is an operand on every node that has one". Nothing
    // checked that, and it stopped being true the moment a literal needed
    // somewhere to keep its width suffix: `42i32` began resolving whatever node
    // sat at index `WI32`, and the only symptom was an unrelated name failing to
    // bind two files away. The shape table is that comment, made answerable.
    int32:shape = raw expr_shape(e.kind);

    if (shape == (raw EXPR_SHAPE_LEAF())) { pass NIL; }

    if (shape == (raw EXPR_SHAPE_LIST())) {
        drop resolve_expr_window(r, raw expr_list_start(e),
                                 raw expr_list_count(e), scope);
        pass NIL;
    }

    // A KIND NOBODY HAS CLASSIFIED. Reported rather than walked, because walking
    // means reading slots whose meaning is unknown -- the bug above, again.
    // `tests/frontend/ast.npk` asserts the table is total, so arriving here means
    // the table and the kind list have drifted apart.
    if (shape == (raw EXPR_SHAPE_NONE())) {
        drop diaglist_push(r.diags, raw diag_error(raw RESOLVE_INTERNAL(),
            "this expression kind has no entry in `expr_shape`, so its slots cannot be walked",
            e.span));
        pass NIL;
    }

    drop resolve_expr(r, raw expr_lhs(e), scope);
    if (shape == (raw EXPR_SHAPE_ONE())) { pass NIL; }

    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        drop resolve_expr_window(r, raw expr_list_start(e),
                                 raw expr_list_count(e), scope);
        pass NIL;
    }

    drop resolve_expr(r, raw expr_rhs(e), scope);
    if (shape == (raw EXPR_SHAPE_THREE())) {
        ExprId:third = ExprId{ index: e.c };
        drop resolve_expr(r, third, scope);
    }
    pass NIL;
};

func:resolve_expr_window = NIL(Resolver->:r, int32:start, int32:count, int32:scope) never fails {
    for (int32:i in 0i32...count) {
        ExprId:x = ExprId{ index: raw ast_id_at(r.ast, start, i) };
        drop resolve_expr(r, x, scope);
    }
    pass NIL;
};

// --- statements --------------------------------------------------------------------------

pub func:resolve_stmt = NIL(Resolver->:r, StmtId:id, int32:scope) never fails {
    if (raw stmt_is_none(id)) {
        pass NIL;
    }
    StmtNode:s = raw ast_stmt(r.ast, id);

    if (s.kind == StmtKind.StmtBlockStmt) {
        // A BLOCK IS A SCOPE. Two blocks may each declare `x` without colliding,
        // and an inner one may shadow an outer -- which the language permits and
        // this must not report.
        //
        // AND A MACRO EXPANSION IS A BLOCK WHOSE PARENT IS THE MODULE. That one
        // difference is the whole of statement-position hygiene: the body's own
        // locals live here and cannot collide with the caller's or outlive the
        // invocation, and a free name in the body walks up past the caller's
        // locals to where the macro was written. `#caller(name)` is what reaches
        // back, and `caller_scope` is where it reaches to.
        int32:parent = scope;
        int32:saved_caller = r.caller_scope;
        if (raw ast_stmt_flag(r.ast, id, raw HYG_ROOT())) {
            parent = r.module_scope;
            r.caller_scope = scope;
        }
        int32:inner = raw scope_open(r.tab, parent, raw SCOPE_BLOCK());
        drop resolve_stmt_window(r, raw stmt_list_start(s),
                                 raw stmt_list_count(s), inner);
        r.caller_scope = saved_caller;
        pass NIL;
    }

    if (s.kind == StmtKind.StmtVarDeclStmt) {
        // THE INITIALISER IS RESOLVED BEFORE THE NAME IS DECLARED, so
        // `int32:x = x;` does not silently bind to itself. A local is in scope
        // from its declaration onward, not from the start of the block.
        drop resolve_expr(r, raw stmt_decl_init(r.ast, s), scope);
        // The declaration's `limit<Rule>` names a `Rules` block (1.5.1,
        // D-220) — resolved like any other name, from this scope.
        drop resolve_limit(r, raw stmt_decl_limit(r.ast, s), scope);
        discard(raw symtab_declare(r.tab, r.ast, r.diags, scope, raw stmt_name(s),
                            raw SYM_STMT(), id.index, 0i32));
        pass NIL;
    }

    if (s.kind == StmtKind.StmtAssignStmt) {
        drop resolve_expr(r, raw stmt_target(s), scope);
        drop resolve_expr(r, raw stmt_assigned(s), scope);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtIfStmt) {
        drop resolve_expr(r, raw stmt_cond(s), scope);
        drop resolve_stmt(r, raw stmt_then(s), scope);
        drop resolve_stmt(r, raw stmt_else(s), scope);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtWhileStmt) {
        drop resolve_expr(r, raw stmt_cond(s), scope);
        drop resolve_invariant(r, raw stmt_while_invariant(r.ast, s), scope);
        drop resolve_stmt(r, raw stmt_body(r.ast, s), scope);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtForStmt) {
        // The BINDING is in scope for the body and not for the iterable:
        // `for (int64:i in i)` names nothing.
        drop resolve_expr(r, raw stmt_for_iter(r.ast, s), scope);
        int32:inner = raw scope_open(r.tab, scope, raw SCOPE_BLOCK());
        DeclId:bind = raw stmt_for_binding(s);
        DeclNode:bd = raw ast_decl(r.ast, bind);
        discard(raw symtab_declare(r.tab, r.ast, r.diags, inner, raw decl_name(bd),
                            raw SYM_DECL(), bind.index, 0i32));
        drop resolve_invariant(r, raw stmt_for_invariant(r.ast, s), inner);
        drop resolve_stmt(r, raw stmt_for_body(r.ast, s), inner);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtLoopStmt) {
        drop resolve_counted(r, s, scope);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtTillStmt) {
        drop resolve_counted(r, s, scope);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtWhenStmt) {
        drop resolve_expr(r, raw stmt_cond(s), scope);
        drop resolve_invariant(r, raw stmt_when_invariant(r.ast, s), scope);
        drop resolve_stmt(r, raw stmt_when_body(r.ast, s), scope);
        drop resolve_stmt(r, raw stmt_when_then(r.ast, s), scope);
        drop resolve_stmt(r, raw stmt_when_end(r.ast, s), scope);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtPickStmt) {
        drop resolve_expr(r, raw pick_selector(s), scope);
        drop resolve_arms(r, raw pick_arm_start(s), raw pick_arm_count(s), scope);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtDeferStmt) {
        StmtId:body = StmtId{ index: s.a };
        drop resolve_stmt(r, body, scope);
        pass NIL;
    }

    // Everything left carries at most one expression in slot `a`: pass, fail,
    // return, exit, trap, discard, prove, assert_static, give, and the plain
    // expression statement. `break`, `continue` and `fall` carry a LABEL, which
    // is not a name in this table.
    if (s.kind == StmtKind.StmtBreakStmt)    { pass NIL; }
    if (s.kind == StmtKind.StmtContinueStmt) { pass NIL; }
    if (s.kind == StmtKind.StmtFallStmt)     { pass NIL; }
    drop resolve_expr(r, raw stmt_expr(s), scope);
    pass NIL;
};

func:resolve_counted = NIL(Resolver->:r, StmtNode:s, int32:scope) never fails {
    int32:n = raw stmt_counted_argc(r.ast, s);
    for (int32:i in 0i32...n) {
        drop resolve_expr(r, raw stmt_counted_arg(r.ast, s, i), scope);
    }
    // `$` is the counter and is its own node kind (IterationVarExpr), not an
    // identifier -- so it needs no symbol and cannot be shadowed.
    int32:inner = raw scope_open(r.tab, scope, raw SCOPE_BLOCK());
    drop resolve_invariant(r, raw stmt_counted_invariant(r.ast, s), inner);
    drop resolve_stmt(r, raw stmt_counted_body(s), inner);
    pass NIL;
};

func:resolve_stmt_window = NIL(Resolver->:r, int32:start, int32:count, int32:scope) never fails {
    for (int32:i in 0i32...count) {
        StmtId:x = StmtId{ index: raw ast_id_at(r.ast, start, i) };
        drop resolve_stmt(r, x, scope);
    }
    pass NIL;
};

// --- `pick` arms -------------------------------------------------------------------------

func:resolve_arms = NIL(Resolver->:r, int32:start, int32:count, int32:scope) never fails {
    for (int32:i in 0i32...count) {
        StmtId:armId = raw pick_arm_at(r.ast, start, i);
        StmtNode:arm = raw ast_stmt(r.ast, armId);

        // EACH ARM IS ITS OWN SCOPE, so two arms may bind the same name.
        int32:inner = raw scope_open(r.tab, scope, raw SCOPE_BLOCK());
        drop resolve_pattern(r, raw arm_pattern(arm), inner);
        // The guard sees the pattern's bindings: `(Pair(a, b)) where (a > b)`.
        drop resolve_expr(r, raw arm_guard(arm), inner);
        drop resolve_stmt(r, raw arm_body(arm), inner);
    }
    pass NIL;
};

// A pattern BINDS names rather than referring to them, which is the whole
// difference between a pattern and an expression.
func:resolve_pattern = NIL(Resolver->:r, PatId:id, int32:scope) never fails {
    if (raw pat_is_none(id)) {
        pass NIL;
    }
    PatNode:p = raw ast_pat(r.ast, id);

    if (p.kind == PatKind.PatValue) {
        drop resolve_expr(r, raw pat_value(p), scope);
        pass NIL;
    }
    if (p.kind == PatKind.PatRange) {
        drop resolve_expr(r, raw pat_range_lo(p), scope);
        drop resolve_expr(r, raw pat_range_hi(p), scope);
        pass NIL;
    }
    if (p.kind == PatKind.PatStructDestructure) {
        drop bind_pattern_names(r, id, raw pat_bind_start(p),
                                raw pat_bind_count(p), scope);
        pass NIL;
    }
    if (p.kind == PatKind.PatEnumDestructure) {
        int32:n = raw pat_enum_bind_count(r.ast, p);
        for (int32:i in 0i32...n) {
            int32:nm = raw pat_enum_bind(r.ast, p, i);
            discard(raw symtab_declare(r.tab, r.ast, r.diags, scope, nm,
                                raw SYM_PAT(), id.index, 0i32));
        }
        pass NIL;
    }
    // Wildcard and ERR bind nothing.
    pass NIL;
};

func:bind_pattern_names = NIL(Resolver->:r, PatId:id, int32:start,
                              int32:count, int32:scope) never fails {
    for (int32:i in 0i32...count) {
        int32:nm = raw ast_id_at(r.ast, start, i);
        discard(raw symtab_declare(r.tab, r.ast, r.diags, scope, nm,
                            raw SYM_PAT(), id.index, 0i32));
    }
    pass NIL;
};

// --- contracts and invariants ---------------------------------------------------------------

func:resolve_invariant = NIL(Resolver->:r, VerifyId:id, int32:scope) never fails {
    if (raw verify_is_none(id)) {
        pass NIL;
    }
    VerifyNode:v = raw ast_verify(r.ast, id);
    drop resolve_expr_window(r, raw invariant_start(v),
                             raw invariant_count(v), scope);
    pass NIL;
};

func:resolve_contract = NIL(Resolver->:r, VerifyId:id, int32:scope) never fails {
    if (raw verify_is_none(id)) {
        pass NIL;
    }
    VerifyNode:v = raw ast_verify(r.ast, id);
    // `result` and `old(…)` are keywords with their own nodes (1.5.1, D-221),
    // so the condition resolves like any expression: nothing to exempt.
    drop resolve_expr(r, raw contract_cond(v), scope);
    pass NIL;
};

// --- declarations ------------------------------------------------------------------------------

// D-179: a user error constant's code, derived from the DECLARATION — the
// FNV-1a of `module.Name`, truncated to a positive int32 (never 0, never
// negative: the system domain owns the negatives). Derived, not counted, so
// any compiler that can hash bytes numbers identically.
// THE CODE IS THE HASH (D-179): a user error constant's identity is FNV-1a
// over `module.Name`, so nothing has to be assigned, coordinated or looked up
// across a module graph. The step itself lives in `intern.npk` — one copy for
// the whole compiler since 1.4.2b, because the emitter derives the same value
// when it matches a qualified pattern and the two used to be separate.
func:error_code_of = int32(Resolver->:r, int32:mod_name, int32:decl_nm) never fails {
    uint64:h = raw fnv1a_bytes(raw intern_get(r.interns, mod_name),
                               raw fnv1a_seed());
    h = raw fnv1a_step(h, 46u64);
    h = raw fnv1a_bytes(raw intern_get(r.interns, decl_nm), h);
    pass (((h & 1073741822u64) =>! int32) + 1i32);
};

pub func:resolve_decl = NIL(Resolver->:r, DeclId:id, int32:scope) never fails {
    DeclNode:d = raw ast_decl(r.ast, id);

    if (d.kind == DeclKind.DeclFunctionDecl) {
        int32:fn = raw scope_open(r.tab, scope, raw SCOPE_FUNCTION());

        int32:g = 0i32;
        while (g < (raw fn_generic_count(r.ast, d))) {
            DeclId:gp = raw fn_generic(r.ast, d, g);
            DeclNode:gn = raw ast_decl(r.ast, gp);
            discard(raw symtab_declare(r.tab, r.ast, r.diags, fn, raw decl_name(gn),
                                raw SYM_DECL(), gp.index, 0i32));
            g = g + 1i32;
        }

        int32:pi = 0i32;
        while (pi < (raw fn_param_count(r.ast, d))) {
            DeclId:pd = raw fn_param(r.ast, d, pi);
            DeclNode:pn = raw ast_decl(r.ast, pd);
            discard(raw symtab_declare(r.tab, r.ast, r.diags, fn, raw decl_name(pn),
                                raw SYM_DECL(), pd.index, 0i32));
            // A parameter's `limit<Rule>` names a `Rules` block (1.5.1,
            // D-220), looked up from the function's own scope.
            drop resolve_limit(r, raw param_limit(pn), fn);
            pi = pi + 1i32;
        }

        DeclId:vd = raw fn_variadic(r.ast, d);
        if (!(raw decl_is_none(vd))) {
            DeclNode:vn = raw ast_decl(r.ast, vd);
            discard(raw symtab_declare(r.tab, r.ast, r.diags, fn, raw decl_name(vn),
                                raw SYM_DECL(), vd.index, 0i32));
        }

        int32:c = 0i32;
        while (c < (raw fn_contract_count(r.ast, d))) {
            drop resolve_contract(r, raw fn_contract(r.ast, d, c), fn);
            c = c + 1i32;
        }

        drop resolve_stmt(r, raw fn_body(r.ast, d), fn);
        pass NIL;
    }

    if (d.kind == DeclKind.DeclGlobalDecl) {
        drop resolve_expr(r, raw global_init(d), scope);
        pass NIL;
    }

    // `error:Name;` (D-179): assign the constant's code. The prelude's
    // system family carries explicit D-142 magnitudes and the SYSTEM domain
    // owns the sign (stored negated — an encoding detail, not a user-facing
    // convention); user constants take the next positive number, in
    // module-graph order, so the same program always numbers the same way.
    if (d.kind == DeclKind.DeclErrorDecl) {
        if (d.b != 0i32) {
            if (!r.in_prelude) {
                drop diaglist_push(r.diags, raw diag_error(raw RESOLVE_ERROR_DECL(),
                    "an explicit error code is the prelude's alone (D-179): a user error constant's code is the compiler's to assign — write `error:Name;`",
                    d.span));
                pass NIL;
            }
            ExprNode:cn = raw ast_expr(r.ast, ExprId{ index: d.b });
            if (cn.kind != ExprKind.ExprIntLiteral) {
                drop diaglist_push(r.diags, raw diag_error(raw RESOLVE_ERROR_DECL(),
                    "an error code is a bare integer literal (D-179): a computed code would be an identity decided at runtime",
                    cn.span));
                pass NIL;
            }
            drop ast_set_error_code(r.ast, id, 0i32 - (cn.payload =>! int32));
            pass NIL;
        }
        int32:code = raw error_code_of(r, r.module_name, raw decl_name(d));
        int32:ei = 0i32;
        while ((ei => int64) < r.ecodes.count) {
            if (r.ecodes.items[ei => int64] == code) {
                if (r.edecls.items[ei => int64] != id.index) {
                    drop diaglist_push(r.diags, raw diag_error(raw RESOLVE_ERROR_DECL(),
                        "two error constants derive the same code (D-179, an FNV collision): rename one — identity must be unambiguous",
                        d.span));
                    pass NIL;
                }
            }
            ei = ei + 1i32;
        }
        // BOTH, ALWAYS.
        drop list_push(@r.ecodes, code);
        drop list_push(@r.edecls, id.index);
        drop ast_set_error_code(r.ast, id, code);
        pass NIL;
    }

    if (d.kind == DeclKind.DeclEnumDecl) {
        int32:n = raw item_member_count(r.ast, d);
        int32:i = 0i32;
        while (i < n) {
            DeclNode:v = raw ast_decl(r.ast, raw item_member(r.ast, d, i));
            drop resolve_expr(r, raw variant_value(v), scope);
            i = i + 1i32;
        }
        pass NIL;
    }

    // A `unit:` DECLARATION'S RIGHT-HAND SIDE IS NOT RESOLVED HERE (D-196,
    // 1.3.3), deliberately: its names are the unit vocabulary — the seven SI
    // base names are compiler-known, not symbols — so `resolve_expr` would
    // refuse `Seconds` as unbound. The CHECK walk owns the whole algebra
    // (form, names, exponents, cycles) in one implementation, eagerly per
    // declaration, so a broken definition still refuses when nothing uses it.
    if (d.kind == DeclKind.DeclUnitDecl) {
        pass NIL;
    }

    if (d.kind == DeclKind.DeclRuleDecl) {
        // The refinements name other `Rules` blocks (1.5.1, D-220): each
        // resolves from the module scope like the clauses' own names, and a
        // cycle among them is `check_rule_cycles`'s question once every
        // module has bound.
        int32:rn = raw rule_refine_count(r.ast, d);
        int32:ri = 0i32;
        while (ri < rn) {
            drop resolve_limit(r, raw rule_refine(r.ast, d, ri), scope);
            ri = ri + 1i32;
        }
        int32:n = raw rule_clause_count(r.ast, d);
        int32:i = 0i32;
        while (i < n) {
            drop resolve_expr(r, raw rule_clause(r.ast, d, i), scope);
            i = i + 1i32;
        }
        pass NIL;
    }

    // A nested `mod` has a scope of its own, opened during collection, and the
    // symbol that names it RECORDS which one. Collection ties the two together
    // with `symtab_set_inner` for exactly this reason: a `Scope` stores its
    // parent and not its owner, so a name is the only way back to the scope it
    // opened.
    //
    // WHAT STOOD HERE SEARCHED FOR THE SCOPE INSTEAD, taking the first module
    // scope whose parent matched. With one nested module that is the right
    // answer by luck. With two it is the same answer twice: the second module's
    // members were resolved in the FIRST one's scope, so a call between siblings
    // in the second module failed as an unknown name, and swapping the two
    // declarations fixed it. An analysis whose result depends on declaration
    // order is the failure `symtab_set_inner` was added to prevent.
    if (d.kind == DeclKind.DeclModuleDecl) {
        // A MEMBER-LESS `mod:name;` -- a file's header (D-248, 1.5.1b step 1)
        // or an external-file import -- has nothing inside it to resolve, and
        // the header declares no symbol at all (`collect_file_module`), so the
        // opened-no-scope check below is an inline module's alone.
        if ((raw item_member_count(r.ast, d)) == 0i32) { pass NIL; }
        int32:inner = raw nested_module_scope(r.tab, d, scope);
        if (inner == 0i32) {
            // COLLECTION OPENS THE SCOPE, so a module symbol without one is a
            // defect in this compiler and not in the program. Reported rather
            // than papered over with the enclosing scope, which is what the
            // search used to fall back to — and falling back is how the members
            // of a module quietly end up somewhere else.
            drop diaglist_push(r.diags, raw diag_error(raw RESOLVE_INTERNAL(),
                "this module's name opened no scope during collection",
                d.span));
            pass NIL;
        }
        // `module_scope` FOLLOWS THE NESTING. It is what an expansion resolves
        // against, and a macro declared in a nested module is written in the
        // nested module's scope — so leaving this pointing at the file's own
        // scope would resolve that macro's body one level too far out. Nothing
        // read this field before hygiene did, which is why the omission was
        // invisible.
        int32:saved_mod = r.module_scope;
        r.module_scope = inner;
        drop resolve_members(r, d, inner);
        r.module_scope = saved_mod;
        pass NIL;
    }

    if (d.kind == DeclKind.DeclTraitDecl) {
        drop resolve_members(r, d, scope);
        pass NIL;
    }
    if (d.kind == DeclKind.DeclImplDecl) {
        // A BLANKET IMPL'S PARAMETER IS IN SCOPE FOR THE WHOLE BLOCK (D-105), so
        // the block opens a scope of its own when it declares one. `impl:<T:
        // Printable>:Loggable` names `T` as its target and again in every method
        // signature; without a scope holding it, those are unbound names.
        //
        // A CONCRETE IMPL OPENS NOTHING, so `impl:Point = { … };` resolves in the
        // module scope exactly as it did — a block that opened a scope either way
        // would put its methods somewhere a later lookup does not reach.
        int32:inner = scope;
        int32:g = 0i32;
        int32:gn = raw impl_generic_count(r.ast, d);
        if (gn > 0i32) {
            inner = raw scope_open(r.tab, scope, raw SCOPE_FUNCTION());
            while (g < gn) {
                DeclId:gp = raw impl_generic(r.ast, d, g);
                DeclNode:gd = raw ast_decl(r.ast, gp);
                discard(raw symtab_declare(r.tab, r.ast, r.diags, inner, raw decl_name(gd),
                                    raw SYM_DECL(), gp.index, 0i32));
                g = g + 1i32;
            }
        }
        int32:n = raw impl_member_count(r.ast, d);
        for (int32:i in 0i32...n) {
            drop resolve_decl(r, raw impl_member(r.ast, d, i), inner);
        }
        pass NIL;
    }
    pass NIL;
};

// `module_scope_of` STOOD HERE and searched the scope table for the first module
// scope whose parent matched. Its own comment said "recorded rather than
// recomputed would be better" — and it already WAS recorded, on the symbol, by
// `symtab_set_inner`. The search was the second computation of a fact the table
// already held, and it disagreed with the first as soon as a file declared two
// nested modules.

func:resolve_members = NIL(Resolver->:r, DeclNode:d, int32:scope) never fails {
    int32:n = raw item_member_count(r.ast, d);
    for (int32:i in 0i32...n) {
        drop resolve_decl(r, raw item_member(r.ast, d, i), scope);
    }
    pass NIL;
};

pub func:resolve_module = NIL(Resolver->:r, DeclId:mod_id, int32:scope) never fails {
    r.module_scope = scope;
    DeclNode:m = raw ast_decl(r.ast, mod_id);
    // `module_name` is set by the caller from the file's basename (D-179):
    // the `mod:` line must match it where present, and files without one
    // still have a name to hash error codes under.
    drop resolve_members(r, m, scope);
    pass NIL;
};

// --- the completeness audit --------------------------------------------------------------
//
// EVERY `IdentifierExpr` IS BOUND, IS A BUILTIN, OR PRODUCED A DIAGNOSTIC. There
// is no fourth outcome, and this is what checks it.
//
// The counterpart to `check_kinds_reachable` in cycle 0.2, and it guards the same
// class of defect. If the walk above forgets a construct — a `when` body, a
// `pick` guard, an invariant — the identifiers inside it are never visited, so
// they stay unbound and NOTHING REPORTS IT. Not an error at any point, and
// invisible until cycle 0.4 asks what one of them means and gets nothing.
//
// Run over a program known to resolve cleanly, a non-zero count means the walk
// has a hole. That is a far sharper question than "did the tests pass", because a
// test only covers the constructs somebody thought to write.
pub func:resolve_audit = int32(Ast->:ast, SymbolTable->:_~tab,
                               InternTable->:interns) never fails {
    int32:unbound = 0i32;
    int32:i = 1i32;
    while (i < (raw ast_expr_count(ast))) {
        ExprId:id = ExprId{ index: i };
        ExprNode:e = raw ast_expr(ast, id);
        if (e.kind == ExprKind.ExprIdentifierExpr) {
            if (e.a == 0i32) {
                string:text = raw intern_get(interns,
                                               (raw expr_name(e)) =>! int32);
                bool:excused = raw is_builtin_name(text);
                if (!excused) {
                    unbound = unbound + 1i32;
                }
            }
        }
        i = i + 1i32;
    }
    // EVERY `limit<name>` IS BOUND OR PRODUCED A DIAGNOSTIC (1.5.1, D-220):
    // the same three-outcome rule, for the one node that carries a name
    // without being an identifier. This surface went unresolved for eleven
    // cycles precisely because no audit asked about it.
    int32:v = 1i32;
    while (v < (raw ast_verify_count(ast))) {
        VerifyNode:vn = raw ast_verify(ast, VerifyId{ index: v });
        if (vn.kind == VerifyKind.VerifyLimitNode) {
            if (vn.a == 0i32) {
                unbound = unbound + 1i32;
            }
        }
        v = v + 1i32;
    }
    pass unbound;
};

// --- `const` initialiser cycles ----------------------------------------------------------
//
// The second half of D-086's unresolvable-cycle rule. The first — a struct whose
// size depends on itself — is checked in `module_graph.npk`, because a field's
// type is already in the AST and needs no name resolution.
//
// THIS ONE COULD NOT BE CHECKED THERE. `pub const int32:A = B;` is a question
// about an EXPRESSION, and until every identifier in a body is bound there is no
// way to ask which global `B` refers to. So it waits for phase 2 and runs on the
// bindings phase 2 produced.
//
//     pub const int32:A = B + 1i32;
//     pub const int32:B = A + 1i32;      // neither can be computed
//
// Unlike the struct case there is no `->` to break it: a value is a value.

// Does the expression reach `target` by following bound identifiers into other
// globals? `fuel` bounds the walk so a graph the checker has not yet rejected
// cannot spin.
func:init_reaches = bool(Resolver->:r, ExprId:id, int32:target, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:e = raw ast_expr(r.ast, id);

    if (e.kind == ExprKind.ExprIdentifierExpr) {
        if (e.a == 0i32) { pass false; }
        if (e.a == target) { pass true; }
        Symbol:s = raw symtab_get(r.tab, e.a);
        if (s.origin_kind != (raw SYM_DECL())) { pass false; }
        DeclId:d = DeclId{ index: s.origin };
        DeclNode:dnode = raw ast_decl(r.ast, d);
        if (dnode.kind != DeclKind.DeclGlobalDecl) { pass false; }
        pass (raw init_reaches(r, raw global_init(dnode), target, fuel - 1i32));
    }

    // THE SAME SHAPE TABLE, for the same reason. This walk had its own copy of
    // the slot-`a` assumption and its own partial list of window kinds -- it
    // named three and missed four, so a self-reference through a template
    // literal or a method call's arguments went unseen. One table, two callers,
    // and a kind that gains a shape gains it in both.
    int32:shape = raw expr_shape(e.kind);

    if (shape == (raw EXPR_SHAPE_LEAF())) { pass false; }

    if (shape == (raw EXPR_SHAPE_LIST())) {
        pass (raw init_reaches_window(r, raw expr_list_start(e),
                                        raw expr_list_count(e), target, fuel));
    }
    // A struct literal's window alternates NAME, VALUE; a call's and a builtin's
    // begins with generic TYPE arguments. Walking a name or a type as an
    // expression reads a node from the wrong array, so each is walked as what it
    // is. An id that is not an expression resolves to node 0 and stops.
    if (shape == (raw EXPR_SHAPE_CUSTOM())) {
        // A STRUCT LITERAL'S WINDOW ALTERNATES NAME, VALUE — the names are
        // intern indices, not expressions, so only the values are walked (else a
        // field-name index is read from the expression array as a stray node,
        // the false self-reference D-165's aggregate globals hit, 1.0.9d).
        if (e.kind == ExprKind.ExprStructLiteralExpr) {
            int32:spairs = (raw expr_list_count(e)) / 2i32;
            for (int32:sli in 0i32...spairs) {
                ExprId:sv = ExprId{ index: raw ast_id_at(r.ast,
                                raw expr_list_start(e), (sli * 2i32) + 1i32) };
                if (raw init_reaches(r, sv, target, fuel - 1i32)) { pass true; }
            }
            pass false;
        }
        if (e.kind == ExprKind.ExprPickExpr) {
            ExprId:sel = raw pickx_selector(e);
            pass (raw init_reaches(r, sel, target, fuel - 1i32));
        }
        int32:gcount = 0i32;
        if (e.kind == ExprKind.ExprCallExpr)    { gcount = raw expr_generic_count(e); }
        if (e.kind == ExprKind.ExprBuiltinExpr) { gcount = raw builtin_generic_count(e); }
        if (e.kind == ExprKind.ExprCallExpr) {
            ExprId:callee = raw expr_callee(e);
            if (raw init_reaches(r, callee, target, fuel - 1i32)) { pass true; }
        }
        pass (raw init_reaches_window(r, (raw expr_list_start(e)) + gcount,
                                        (raw expr_list_count(e)) - gcount,
                                        target, fuel));
    }
    if (shape == (raw EXPR_SHAPE_NONE())) { pass false; }

    ExprId:a = ExprId{ index: e.a };
    if (raw init_reaches(r, a, target, fuel - 1i32)) { pass true; }
    if (shape == (raw EXPR_SHAPE_ONE())) { pass false; }

    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        pass (raw init_reaches_window(r, raw expr_list_start(e),
                                        raw expr_list_count(e), target, fuel));
    }

    ExprId:b = ExprId{ index: e.b };
    if (raw init_reaches(r, b, target, fuel - 1i32)) { pass true; }
    if (shape == (raw EXPR_SHAPE_THREE())) {
        ExprId:c = ExprId{ index: e.c };
        if (raw init_reaches(r, c, target, fuel - 1i32)) { pass true; }
    }
    pass false;
};

func:init_reaches_window = bool(Resolver->:r, int32:start, int32:count,
                                int32:target, int32:fuel) never fails {
    for (int32:i in 0i32...count) {
        ExprId:x = ExprId{ index: raw ast_id_at(r.ast, start, i) };
        if (raw init_reaches(r, x, target, fuel - 1i32)) { pass true; }
    }
    pass false;
};

// Report every global whose initialiser depends on itself.
//
// Declaration order, so the output is identical on every run — the same
// order-independence D-086 requires of the result, applied to the diagnostics.
pub func:check_global_cycles = NIL(Resolver->:r, DeclId:mod_id, int32:scope) never fails {
    DeclNode:m = raw ast_decl(r.ast, mod_id);
    int32:n = raw item_member_count(r.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(r.ast, m, i);
        DeclNode:d = raw ast_decl(r.ast, item);
        if (d.kind == DeclKind.DeclGlobalDecl) {
            int32:sym = raw scope_lookup_local(r.tab, scope, raw decl_name(d));
            if (sym != 0i32) {
                if (raw init_reaches(r, raw global_init(d), sym, 64i32)) {
                    string:nm = raw intern_get(r.interns, raw decl_name(d));
                    string:m1 = string_concat("`", nm);
                    string:m2 = string_concat(m1,
                        "` is initialised from itself, so its value cannot be computed");
                    drop diaglist_push(r.diags,
                        raw diag_error(raw RESOLVE_CYCLE(), move(m2), d.span));
                }
            }
        }
    }
    pass NIL;
};

// --- `limit<name>` (1.5.1, D-220) ------------------------------------------------------
//
// A RULE NAME RESOLVES, through the same lookup an identifier gets, from the
// scope of the site — a local's block, a parameter's function scope, a `Rules`
// body's module scope. A miss is the identifier's own miss (RESOLVE-002, the
// same sentence): one lookup rule for every name in the language, so a typo in
// `limit<…>` is the same mistake as a typo anywhere and gets the same answer.
// A hit that is anything but a `Rules` block is RESOLVE-011, and the message
// says what the name is instead. The resolved declaration is written onto the
// node exactly once (`limit_target`), the way an identifier's symbol is written
// onto `ExprNode.a`, so the checker, the obligation walk and the emitter read a
// binding and never look a name up again.
//
// Until 1.5.1 nothing looked the name up at all: `limit<r_poz>` parsed, bound
// nothing, and was refused by the backend as a rung whatever it said — which
// is D-085's shape with a hole in it, since a rung refusal covers a typo as
// completely as it covers the construct.
pub func:resolve_limit = NIL(Resolver->:r, VerifyId:id, int32:scope) never fails {
    if (raw verify_is_none(id)) { pass NIL; }
    VerifyNode:v = raw ast_verify(r.ast, id);
    if (v.kind != VerifyKind.VerifyLimitNode) { pass NIL; }
    int32:name = raw limit_rule(v);
    string:text = raw intern_get(r.interns, name);
    int32:sym = raw scope_lookup(r.tab, scope, name);
    if (sym == 0i32) {
        string:m1 = string_concat("cannot find `", text);
        string:m2 = string_concat(m1, "` in this scope");
        drop diaglist_push(r.diags,
            raw diag_error(raw RESOLVE_UNKNOWN(), move(m2), v.span));
        pass NIL;
    }
    Symbol:s = raw symtab_get(r.tab, sym);
    bool:is_rules = false;
    if (s.origin_kind == (raw SYM_DECL())) {
        DeclNode:dn = raw ast_decl(r.ast, DeclId{ index: s.origin });
        if (dn.kind == DeclKind.DeclRuleDecl) { is_rules = true; }
    }
    if (!is_rules) {
        string:what = "a local binding";
        if (s.origin_kind == (raw SYM_DECL())) {
            DeclNode:dn2 = raw ast_decl(r.ast, DeclId{ index: s.origin });
            what = raw decl_kind_article(dn2);
        }
        string:n1 = string_concat("`limit<", text);
        string:n2 = string_concat(n1, ">` names ");
        string:n3 = string_concat(n2, what);
        string:n4 = string_concat(n3, ", and `limit` takes a `Rules` block");
        drop diaglist_push(r.diags,
            raw diag_error(raw RESOLVE_NOT_RULES(), move(n4), v.span));
        pass NIL;
    }
    drop ast_set_verify_a(r.ast, id, s.origin);
    pass NIL;
};

// Does the `Rules` block `d` reach the declaration `target` by following its
// refinements? Fuel-bounded like `init_reaches`, for the same reason: the walk
// runs on the bindings resolve just wrote, before any refusal has pruned the
// graph, so a cycle it has not yet reported must not be able to spin it.
func:rule_reaches = bool(Resolver->:r, DeclNode:d, int32:target, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    int32:n = raw rule_refine_count(r.ast, d);
    for (int32:i in 0i32...n) {
        VerifyNode:v = raw ast_verify(r.ast, raw rule_refine(r.ast, d, i));
        DeclId:t = raw limit_target(v);
        if (raw decl_is_none(t)) { continue; }
        if (t.index == target) { pass true; }
        DeclNode:dn = raw ast_decl(r.ast, t);
        if (dn.kind != DeclKind.DeclRuleDecl) { continue; }
        if (raw rule_reaches(r, dn, target, fuel - 1i32)) { pass true; }
    }
    pass false;
};

// Report every `Rules` block that refines itself, directly or through a chain
// (1.5.1, D-220) — D-086's unresolvable-cycle rule, third instance. 1.5.2
// discharges a `limit` by expanding its refinements into one conjunction and
// subsumption by an implication over the same expansion; a cycle would never
// finish expanding, and refusing the shape here is cheaper and clearer than a
// fuel counter deep in the encoder. Declaration order, like
// `check_global_cycles`, so the output is identical on every run.
pub func:check_rule_cycles = NIL(Resolver->:r, DeclId:mod_id, int32:_~scope) never fails {
    DeclNode:m = raw ast_decl(r.ast, mod_id);
    int32:n = raw item_member_count(r.ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(r.ast, m, i);
        DeclNode:d = raw ast_decl(r.ast, item);
        if (d.kind == DeclKind.DeclRuleDecl) {
            if (raw rule_reaches(r, d, item.index, 64i32)) {
                string:nm = raw intern_get(r.interns, raw decl_name(d));
                string:m1 = string_concat("`", nm);
                string:m2 = string_concat(m1,
                    "` refines itself through its `limit<…>` chain, so its clauses can never be expanded");
                drop diaglist_push(r.diags,
                    raw diag_error(raw RESOLVE_CYCLE(), move(m2), d.span));
            }
        }
    }
    pass NIL;
};
