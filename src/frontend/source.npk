// The source manager.
//
// Subset 1 (meta/SUBSET_1.md).
//
// `Span.file` is an INDEX into this table, which is why a Span stays five
// int32s rather than carrying a path string. Every AST node carries a Span, so
// that difference is multiplied by the size of the tree.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
error:BoundsOffset;
error:FileUnknown;

use "./source_location.npk".*;
use "./intern.npk".*;

pub struct:SourceFile = {
    string:path;      // as given on the command line or resolved from a `use`
    string:text;      // the whole file; the lexer works over these bytes
};

// Growable over alloc/ralloc. Subset 1 has no generics, so every container is
// hand-written -- the cost SUBSET_1 accepted deliberately, to keep
// monomorphization out of the least-audited artifact in the chain.
pub struct:SourceManager = {
    wild SourceFile->:files;
    int32:count;
    int32:cap;
};

pub func:srcmgr_init = SourceManager() never fails {
    int64:n = 8i64;
    wild int8->:raw_mem = alloc(n * #size_of<SourceFile>());
    SourceManager:m = SourceManager{
        files: raw_mem =>! wild SourceFile->,
        count: 0i32,
        cap: 8i32
    };
    pass m;
};

func:srcmgr_grow = NIL(SourceManager->:m) never fails {
    int32:newcap = m.cap * 2i32;
    wild int8->:bigger = ralloc(m.files =>! wild int8->,
                                (newcap => int64) * #size_of<SourceFile>());
    m.files = bigger =>! wild SourceFile->;
    m.cap = newcap;
    pass NIL;
};

// Returns the file index, which is what a Span carries.
pub func:srcmgr_add = int32(SourceManager->:m, string:path, string:text) never fails {
    if (m.count >= m.cap) {
        drop srcmgr_grow(m);
    }
    SourceFile:f = SourceFile{ path: path, text: text };
    m.files[m.count => int64] = move(f);
    int32:index = m.count;
    m.count = m.count + 1i32;
    pass index;
};

pub func:srcmgr_count = int32(SourceManager->:m) never fails {
    pass m.count;
};

// --- loading by path -----------------------------------------------------------
//
// Cycle 0.3.0. Until now the frontend had never opened a file: `parse_check` read
// stdin because that needed no path handling, which was the honest scope at the
// time. A module loader cannot dodge either.

// Already loaded? Returns the existing file id, or -1.
//
// THE SAME PATH MUST NEVER PRODUCE TWO FILE IDS. A module loaded twice has every
// one of its symbols declared twice, and the duplicate-declaration diagnostic
// then fires on a file the reader never edited (0.3.1). This is the check that
// prevents it, and 0.3.2 adds the normalisation that makes it reliable --
// `./a/../b.npk` and `b.npk` must arrive here as the same text.
pub func:srcmgr_find = int32(SourceManager->:m, string:path) never fails {
    int32:i = 0i32;
    while (i < m.count) {
        if (raw string_eq(m.files[i => int64].path, path)) {
            pass i;
        }
        i = i + 1i32;
    }
    pass (0i32 - 1i32);
};

// Read a file and register it. Returns its id.
//
// The path converts through `to_cstring`, which FAILS on an interior NUL
// (D-049) -- and that fallibility is the point. A `string` is length-carrying,
// so an embedded `0u8` is just a byte; terminating it silently would mean the
// path that was checked and the path that was opened are different paths.
pub func:srcmgr_load = int32(SourceManager->:m, string:path) {
    int32:existing = raw srcmgr_find(m, path);
    if (existing >= 0i32) {
        pass existing;
    }
    cstring:cpath = relay to_cstring(path);
    string:text = relay read_file(cpath);
    pass (raw srcmgr_add(m, path, text));
};

pub func:srcmgr_path = string(SourceManager->:m, int32:file) {
    if (file < 0i32) {
        fail FileUnknown;
    }
    if (file >= m.count) {
        fail FileUnknown;
    }
    pass m.files[file => int64].path;
};

pub func:srcmgr_text = string(SourceManager->:m, int32:file) {
    if (file < 0i32) {
        fail FileUnknown;
    }
    if (file >= m.count) {
        fail FileUnknown;
    }
    pass m.files[file => int64].text;
};

// Byte access, because the lexer works in bytes: the source is UTF-8 and a
// character count would be a second, differently-wrong number to keep in step.
pub func:srcmgr_byte_at = uint8(SourceManager->:m, int32:file, int64:offset) never fails {
    string:t = raw srcmgr_text_proven(m, file);
    if (offset < 0i64) {
        !!! BoundsOffset;
    }
    if (offset >= t.len) {
        !!! BoundsOffset;
    }
    pass t.ptr[offset] => uint8;
};

pub func:srcmgr_length = int64(SourceManager->:m, int32:file) never fails {
    string:t = raw srcmgr_text_proven(m, file);
    pass t.len;
};

// THE PROVEN LOOKUP (D-163, 1.1.1): for a file id the compiler itself minted —
// a module entry's, a span the lexer stamped — a miss is an internal defect,
// trapped. `srcmgr_path` stays may-fail for the one consumer whose misses are
// DATA: `diag_line`, which renders `<unknown file>` for a span synthesised
// outside the manager rather than failing a diagnostic over it.
pub func:srcmgr_path_proven = string(SourceManager->:m, int32:file) never fails {
    Result<string>:r = srcmgr_path(m, file);
    if (r.is_error) { !!! FileUnknown; }
    pass r.value;
};

pub func:srcmgr_text_proven = string(SourceManager->:m, int32:file) never fails {
    Result<string>:r = srcmgr_text(m, file);
    if (r.is_error) { !!! FileUnknown; }
    pass r.value;
};
