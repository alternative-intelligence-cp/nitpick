// AST storage.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.2.0.
//
// A tagged enum over a composable struct, which is what Nitpick has instead of
// base/derived nodes (`CLAUDE.md`): each node is a `kind` plus a `Span` plus a
// small fixed set of slots, and the kind decides what the slots mean.
//
// INDEX-BASED, NEVER POINTER-BASED. A node refers to another by an index into a
// node array. Three things follow, and all three are the point:
//
//   * an index survives the array growing, where a pointer would dangle;
//   * an index graph is easier to verify than a pointer graph;
//   * an index fits in one machine word, which is what lets an enum payload
//     hold one (SUBSET_1 section 1.2).
//
// Handles are DISTINCT TYPES rather than bare int32. An ExprId must not be
// passable where a StmtId is wanted -- the same reasoning that makes `fd` a type
// rather than an integer (D-042). It costs nothing at runtime and removes a
// whole class of mixup from a structure built almost entirely of indices.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
error:BoundsId;
error:BoundsScratch;
error:BoundsWindow;

use "./list.npk".*;
use "./source_location.npk".*;
use "./num_width.npk".*;
use "./ast_kind.npk".*;

pub struct:ExprId = { int32:index; };
pub struct:StmtId = { int32:index; };
pub struct:DeclId = { int32:index; };
pub struct:TypeId = { int32:index; };
pub struct:PatId  = { int32:index; };
pub struct:VerifyId = { int32:index; };

// Index 0 of every array is a reserved NONE node, so a zeroed handle is a
// well-defined absence rather than a silent reference to whatever was created
// first. `Expr?` in the spec is this, not a nullable pointer.
pub func:expr_none = ExprId() never fails { ExprId:i = ExprId{ index: 0i32 }; pass i; };
pub func:stmt_none = StmtId() never fails { StmtId:i = StmtId{ index: 0i32 }; pass i; };
pub func:decl_none = DeclId() never fails { DeclId:i = DeclId{ index: 0i32 }; pass i; };
pub func:type_none = TypeId() never fails { TypeId:i = TypeId{ index: 0i32 }; pass i; };
pub func:pat_none  = PatId() never fails  { PatId:i  = PatId{ index: 0i32 };  pass i; };
pub func:verify_none = VerifyId() never fails { VerifyId:i = VerifyId{ index: 0i32 }; pass i; };

pub func:expr_is_none = bool(ExprId:i) never fails { pass (i.index == 0i32); };
pub func:stmt_is_none = bool(StmtId:i) never fails { pass (i.index == 0i32); };
pub func:decl_is_none = bool(DeclId:i) never fails { pass (i.index == 0i32); };
pub func:type_is_none = bool(TypeId:i) never fails { pass (i.index == 0i32); };
pub func:pat_is_none  = bool(PatId:i) never fails  { pass (i.index == 0i32); };
pub func:verify_is_none = bool(VerifyId:i) never fails { pass (i.index == 0i32); };

// --- nodes ------------------------------------------------------------------
//
// The slots are deliberately few and deliberately unnamed-by-purpose: `a`, `b`,
// `c` are child handles or auxiliary indices whose meaning is fixed by `kind`,
// and `payload` carries a literal value or an intern index.
//
// CALL SITES DO NOT TOUCH SLOTS. Each construct gets named constructor and
// accessor functions, added in the subcycle that parses it, and those are the
// only place a slot is interpreted. Without generics the alternative was one
// growable array per node shape -- ninety hand-written containers -- and the
// accessor layer buys the same readability at no runtime cost.

// SLOTS `a`, `b` AND `c` HOLD NODE REFERENCES OR WINDOW BOUNDS. NEVER A SCALAR.
//
// This is load-bearing, and it is stated here because breaking it produced a bug
// that was never an error at any point. 0.4.2 needed a literal's width suffix and
// put it in slot `a`, which was free on a literal -- and `resolve_expr`'s
// fall-through walks slot `a` as a child on every kind it does not name, so a
// `42i32` began resolving whatever node happened to sit at index `WI32`. Nothing
// crashed; a name in an unrelated file simply started failing to resolve.
//
// A scalar therefore goes in `payload`, or -- when the payload is already spoken
// for, as it is on a literal whose value lives there -- in a field of its own.
// `Token` had already made exactly this choice for exactly this reason.
pub struct:ExprNode = {
    ExprKind:kind;
    Span:span;
    int32:a;
    int32:b;
    int32:c;
    int64:payload;
    NumWidth:width;   // WNone unless the node is a numeric literal
};

pub struct:StmtNode = {
    StmtKind:kind;
    Span:span;
    int32:a;
    int32:b;
    int32:c;
    int64:payload;
};

pub struct:DeclNode = {
    DeclKind:kind;
    Span:span;
    int32:a;
    int32:b;
    int32:c;
    int64:payload;
};

pub struct:TypeNode = {
    TypeKind:kind;
    Span:span;
    int32:a;
    int32:b;
    int32:c;
    int64:payload;
};

pub struct:PatNode = {
    PatKind:kind;
    Span:span;
    int32:a;
    int32:b;
    int32:c;
    int64:payload;
};

// `requires` / `ensures`, loop invariants, and `limit<Rule>`. A SIXTH array,
// because there are six kind enums and 0.2.0 built five -- the verification
// nodes had a `VerifyKind` and nowhere to put one, which 0.2.5 found by needing
// to attach a contract to a function.
pub struct:VerifyNode = {
    VerifyKind:kind;
    Span:span;
    int32:a;
    int32:b;
    int32:c;
    int64:payload;
};

pub struct:Ast = {
    // TEN LISTS (1.4.7 step 2). Every node array and both flag arrays; the
    // caps and counts are the lists' own. An AST id stays int32 BY DESIGN --
    // every node reference is one -- so the counts narrow through `ast_id`
    // below rather than widening the whole tree: the index rule's
    // external-contract arm, reusing errors this module already declares.
    List<ExprNode>:exprs;
    List<StmtNode>:stmts;
    List<DeclNode>:decls;
    List<TypeNode>:types;
    List<PatNode>:pats;
    List<VerifyNode>:verifies;

    // ONE FLAG BYTE PER EXPRESSION AND PER STATEMENT, grown with the array it
    // annotates so an index into one is always an index into the other. What they
    // record is hygiene (0.6.2): whether a node is the root of a macro expansion,
    // and whether an identifier is a `#caller` escape.
    //
    // NOT A SLOT ON THE NODE, because `a`/`b`/`c` hold node references and never
    // scalars — the rule stated above this struct, which a literal's width suffix
    // broke once already. And not a side table sized after the fact, because
    // expansion APPENDS: a table built to the tree's size at any one moment is
    // short by whatever the next round adds, and a short table reads past its
    // allocation rather than answering `false`.
    // THE FLAG ARRAYS ARE PUSHED IN THE SAME FUNCTION as the node they
    // annotate, which is what the warning above preserves: the hazard it names
    // is "growing them is two decisions", and `ast_add_expr_w`/`ast_add_stmt`
    // each push both, in one place, so an index into one is still an index
    // into the other.
    List<int32>:expr_flags;
    List<int32>:stmt_flags;

    // A flat pool of child handles. A node that owns a SEQUENCE -- generic
    // arguments, function parameters, `dyn A & B` traits -- stores a (start,
    // count) window into this pool rather than owning an array of its own.
    // Same reasoning as the node arrays: one growable container instead of one
    // per node kind, and indices that survive the pool being reallocated.
    List<int32>:ids;

    // A SCRATCH stack, distinct from the pool above. Children are gathered here
    // while a node is being parsed and copied into the pool when it completes.
    //
    // Pushing straight into the pool does not work, and the reason is worth
    // stating: parsing a child may itself push, so a (mark, count-since) window
    // taken on the pool CONTAINS the children of nested nodes as well as its
    // own. `Handle<Node<int64>>` reported two arguments instead of one. The
    // windows nest in ORDER but not in EXTENT, which is the trap.
    //
    // With scratch, a nested node copies its entries out and pops them, so what
    // remains above the outer node's mark is exactly its own children.
    List<int32>:scratch;
};

pub struct:IdSpan = {
    int32:start;
    int32:count;
};

// AN AST ID IS int32 BY DESIGN -- every node reference is one -- so a list's
// int64 count narrows to become one. GUARDED, never `=>!`: a silent truncation
// would give two nodes the same id, which is the single failure these tables
// exist to make impossible. `BoundsId` is already this module's declared
// defect, so no `failsafe` grows an arm.
func:ast_id = int32(int64:n) never fails {
    if (n > 2147483647i64) { !!! BoundsId; }
    pass (n =>! int32);
};

func:ast_smark = int32(int64:n) never fails {
    if (n > 2147483647i64) { !!! BoundsScratch; }
    pass (n =>! int32);
};

pub func:ast_init = Ast() never fails {
    int64:n = 256i64;
    Span:z = raw span_none();

    Ast:ast = Ast{
        exprs:    raw list_init::<ExprNode>(n),
        stmts:    raw list_init::<StmtNode>(n),
        decls:    raw list_init::<DeclNode>(n),
        types:    raw list_init::<TypeNode>(n),
        pats:     raw list_init::<PatNode>(n),
        verifies: raw list_init::<VerifyNode>(n),
        expr_flags: raw list_init::<int32>(n),
        stmt_flags: raw list_init::<int32>(n),
        ids:      raw list_init::<int32>(n),
        scratch:  raw list_init::<int32>(n)
    };

    // Reserve index 0 in every array as the NONE node.
    ExprNode:en = ExprNode{ kind: ExprKind.ExprNone, span: z,
                            a: 0i32, b: 0i32, c: 0i32, payload: 0i64,
                            width: NumWidth.WNone };
    drop list_push(@ast.exprs, en);
    drop list_push(@ast.expr_flags, 0i32);

    StmtNode:sn = StmtNode{ kind: StmtKind.StmtNone, span: z,
                            a: 0i32, b: 0i32, c: 0i32, payload: 0i64 };
    drop list_push(@ast.stmts, sn);
    drop list_push(@ast.stmt_flags, 0i32);

    DeclNode:declNone = DeclNode{ kind: DeclKind.DeclNone, span: z,
                            a: 0i32, b: 0i32, c: 0i32, payload: 0i64 };
    ast.decls.items[0i64] = declNone;

    TypeNode:tn = TypeNode{ kind: TypeKind.TypeNone, span: z,
                            a: 0i32, b: 0i32, c: 0i32, payload: 0i64 };
    drop list_push(@ast.types, tn);

    PatNode:pn = PatNode{ kind: PatKind.PatNone, span: z,
                          a: 0i32, b: 0i32, c: 0i32, payload: 0i64 };
    drop list_push(@ast.pats, pn);

    VerifyNode:vn = VerifyNode{ kind: VerifyKind.VerifyNone, span: z,
                                a: 0i32, b: 0i32, c: 0i32, payload: 0i64 };
    drop list_push(@ast.verifies, vn);

    pass ast;
};

// --- expressions -------------------------------------------------------------

pub func:ast_add_expr = ExprId(Ast->:ast, ExprKind:kind, Span:span,
                               int32:a, int32:b, int32:c, int64:payload) never fails {
    pass (raw ast_add_expr_w(ast, kind, span, a, b, c, payload, NumWidth.WNone));
};

// The numeric-literal form. Separate rather than an eighth parameter on every
// call site, because only two kinds have a width and the other forty-two should
// not have to say so.
pub func:ast_add_expr_w = ExprId(Ast->:ast, ExprKind:kind, Span:span,
                                 int32:a, int32:b, int32:c, int64:payload,
                                 NumWidth:width) never fails {
    ExprNode:n = ExprNode{ kind: kind, span: span,
                           a: a, b: b, c: c, payload: payload, width: width };
    ExprId:id = ExprId{ index: raw ast_id(ast.exprs.count) };
    drop list_push(@ast.exprs, n);
    drop list_push(@ast.expr_flags, 0i32);
    pass id;
};

// Out of range is an ERROR, not a sentinel node: returning the NONE node would
// let a corrupt handle read as a legitimate absence, which is the failure
// D-042's "an fd is always valid" reasoning exists to prevent.
pub func:ast_expr = ExprNode(Ast->:ast, ExprId:id) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    pass ast.exprs.items[id.index => int64];
};

pub func:ast_expr_count = int32(Ast->:ast) never fails { pass (raw ast_id(ast.exprs.count)); };

// Write slot `a` of an expression.
//
// The ONLY mutation of a node after it is built, and it exists for one reason:
// name resolution records which symbol an `IdentifierExpr` bound to (0.3.5), so
// cycle 0.4 does not repeat the scope walk every time it asks what a name means.
// A node is otherwise written once and read forever, which is what makes the
// index graph safe to share across modules.
// A DECLARATION'S WINDOW, REPOINTED. Macro expansion rebuilds a module's member
// list — the expanded list is longer than the one that was parsed — and the window
// is a (start, count) pair on the node, so the node has to be told where its
// children moved to.
//
// The only writer is the expander, and it writes a window it has just committed.
// Nothing else may: a window repointed at a range somebody else owns is every
// child of that node silently becoming another node's.
pub func:ast_set_decl_window = NIL(Ast->:ast, DeclId:id, int32:start, int32:count) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.decls.count) { !!! BoundsId; }
    DeclNode:n = ast.decls.items[id.index => int64];
    n.b = start;
    n.c = count;
    ast.decls.items[id.index => int64] = n;
    pass NIL;
};

// A DECLARATION'S FLAG BITS, ADDED TO. One writer: `#[derive]`, marking the impls
// it generated so that a later diagnostic can say so. Same discipline as the two
// mutators above — the tree is written once after expansion, and derive runs inside
// it.
pub func:ast_or_decl_flags = NIL(Ast->:ast, DeclId:id, int32:bits) never fails {
    if (id.index < 1i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.decls.count) { !!! BoundsId; }
    DeclNode:n = ast.decls.items[id.index => int64];
    n.a = n.a | bits;
    ast.decls.items[id.index => int64] = n;
    pass NIL;
};

pub func:ast_set_expr_a = NIL(Ast->:ast, ExprId:id, int32:value) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    ExprNode:n = ast.exprs.items[id.index => int64];
    n.a = value;
    ast.exprs.items[id.index => int64] = n;
    pass NIL;
};

// THE SAME ONCE-WRITTEN BINDING SLOT ON A VERIFICATION NODE (1.5.1, D-220):
// a `limit<name>` records the `Rules` declaration it resolved to in `a`, the
// way an identifier records its symbol. Resolve is the one writer.
pub func:ast_set_verify_a = NIL(Ast->:ast, VerifyId:id, int32:value) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.verifies.count) { !!! BoundsId; }
    VerifyNode:n = ast.verifies.items[id.index => int64];
    n.a = value;
    ast.verifies.items[id.index => int64] = n;
    pass NIL;
};

// The same write-back for a PATTERN: slot `a` on an enum-destructure pattern is
// where the CHECKER records the binding's resolved payload type (0.7.7), the way
// resolution records a symbol on an identifier. Unused by every other pattern
// kind, and zero until the pick that owns the arm is checked.
pub func:ast_set_pat_a = NIL(Ast->:ast, PatId:id, int32:value) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.pats.count) { !!! BoundsId; }
    PatNode:n = ast.pats.items[id.index => int64];
    n.a = value;
    ast.pats.items[id.index => int64] = n;
    pass NIL;
};

// The PATTERN's payload slot, where the checker records the START of a window of
// its bindings' resolved types (1.0.9c) — one per binding, in binding order.
// Enum (single or multi) and struct destructure alike use it; the reference
// checker finds a binding's index by name and reads the type back. Free (zero)
// until the pick that owns the arm is checked, on both pattern kinds.
pub func:ast_set_pat_payload = NIL(Ast->:ast, PatId:id, int64:value) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.pats.count) { !!! BoundsId; }
    PatNode:n = ast.pats.items[id.index => int64];
    n.payload = value;
    ast.pats.items[id.index => int64] = n;
    pass NIL;
};

// --- what a node was made by ---------------------------------------------------
//
// THE AST IS WRITE-ONCE AFTER EXPANSION, and expansion is the one pass that
// rewrites. That is not a loophole in the rule stated above `ast_set_expr_a` — it
// is why expansion runs FIRST. Nothing has read the tree when the expander is
// working except the parser that built it, so a node replaced here is a node no
// pass has an opinion about yet. Every later pass sees a tree that is written once
// and read forever, which is the property the index graph depends on.
//
// TWO BITS PER EXPRESSION, and they answer different questions:
//
//   HYG_ROOT    this node is where an expansion was substituted in. Its free
//               names resolve where the MACRO was written, not where it was
//               invoked (D-057).
//   HYG_CALLER  this identifier came out of `#caller(NAME)` and is the one thing
//               inside an expansion that resolves at the INVOCATION site.
//
// They can both be set on one node — `macro:m = () { #caller(x); };` expands to an
// identifier that is simultaneously the root and the escape — and the resolver
// applies them in that order, which gives the right answer for that case rather
// than needing a third rule for it.
pub func:HYG_ROOT = int32() never fails   { pass 1i32; };
pub func:HYG_CALLER = int32() never fails { pass 2i32; };

// WRITTEN INSIDE A MACRO BODY. A third question about an expression, and the one
// that makes the expansion audit possible: a macro body is a TEMPLATE, so an
// invocation standing in one is consumed when the macro is cloned rather than
// where it appears. Everywhere else a surviving invocation is an error.
pub func:HYG_IN_MACRO = int32() never fails { pass 4i32; };

// THE EXPANSION WALK CAME HERE. Set on every expression the walk enters, so that
// the audit can tell its two failures apart: an invocation still standing that the
// walk VISITED is a name it could not expand — another module's, or nobody's — and
// one it never visited is a hole in the walk itself. Without the bit both read as
// the first, which points the reader at their program for a defect in the compiler.
pub func:HYG_SEEN = int32() never fails { pass 8i32; };

pub func:ast_expr_flag = bool(Ast->:ast, ExprId:id, int32:bit) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    pass ((ast.expr_flags.items[id.index => int64] & bit) != 0i32);
};

pub func:ast_set_expr_flag = NIL(Ast->:ast, ExprId:id, int32:bit) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    ast.expr_flags.items[id.index => int64] = ast.expr_flags.items[id.index => int64] | bit;
    pass NIL;
};

pub func:ast_stmt_flag = bool(Ast->:ast, StmtId:id, int32:bit) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.stmts.count) { !!! BoundsId; }
    pass ((ast.stmt_flags.items[id.index => int64] & bit) != 0i32);
};

pub func:ast_set_stmt_flag = NIL(Ast->:ast, StmtId:id, int32:bit) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.stmts.count) { !!! BoundsId; }
    ast.stmt_flags.items[id.index => int64] = ast.stmt_flags.items[id.index => int64] | bit;
    pass NIL;
};

// A NODE BECOMES WHAT THE MACRO SAID. An invocation is REPLACED IN PLACE rather
// than the tree above it being rebuilt, and the difference is not an optimisation:
// an expression can sit anywhere in an arbitrarily deep expression, so rebuilding
// would mean reconstructing every ancestor up to the enclosing statement, and
// every ancestor reconstructed is another window to get wrong.
//
// The only writer is the expander.
// AND WHAT THE NODE WAS MARKED WITH COMES WITH IT. A replacement copies the node's
// SLOTS, and the marks live beside the array rather than in them — so a clone whose
// root is a `#caller` escape lost the escape on the way into the slot it replaced,
// and the identifier bound in the macro's scope, which is the one scope it exists
// to leave. Visible only for a body that is EXACTLY `#caller(name)`, because
// anything wrapped around it makes the escape a child rather than the root.
pub func:ast_adopt_expr_flags = NIL(Ast->:ast, ExprId:dst, ExprId:src) never fails {
    if (dst.index < 1i32) { !!! BoundsId; }
    if ((dst.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    if (src.index < 1i32) { !!! BoundsId; }
    if ((src.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    ast.expr_flags.items[dst.index => int64] = ast.expr_flags.items[dst.index => int64]
                                       | ast.expr_flags.items[src.index => int64];
    pass NIL;
};

pub func:ast_replace_expr = NIL(Ast->:ast, ExprId:id, ExprNode:n) never fails {
    if (id.index < 1i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    ast.exprs.items[id.index => int64] = n;
    pass NIL;
};

pub func:ast_replace_stmt = NIL(Ast->:ast, StmtId:id, StmtNode:n) never fails {
    if (id.index < 1i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.stmts.count) { !!! BoundsId; }
    ast.stmts.items[id.index => int64] = n;
    pass NIL;
};

// DETACHED, AND SAID SO. When an invocation is instantiated its own subtree stops
// being part of the program — the arguments were CLONED into the body, so the
// originals are referenced by nothing.
//
// They cannot simply be left. Two audits scan the whole array rather than walking
// the tree, precisely so that a walk with a hole cannot hide from them
// (`resolve_audit`, and the recorded-type sweep in `tests/frontend/expr_types.npk`),
// and to those a detached identifier is an unbound one and a detached expression
// is an untyped one. Blanking is how the expander tells them the truth: this node
// is not in the program.
pub func:ast_blank_expr = NIL(Ast->:ast, ExprId:id) never fails {
    if (id.index < 1i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.exprs.count) { !!! BoundsId; }
    ExprNode:n = ast.exprs.items[id.index => int64];
    ExprNode:blank = ExprNode{ kind: ExprKind.ExprNone, span: n.span,
                               a: 0i32, b: 0i32, c: 0i32, payload: 0i64,
                               width: NumWidth.WNone };
    ast.exprs.items[id.index => int64] = blank;
    ast.expr_flags.items[id.index => int64] = 0i32;
    pass NIL;
};

// --- statements ---------------------------------------------------------------

pub func:ast_add_stmt = StmtId(Ast->:ast, StmtKind:kind, Span:span,
                               int32:a, int32:b, int32:c, int64:payload) never fails {
    StmtNode:n = StmtNode{ kind: kind, span: span,
                           a: a, b: b, c: c, payload: payload };
    StmtId:id = StmtId{ index: raw ast_id(ast.stmts.count) };
    drop list_push(@ast.stmts, n);
    drop list_push(@ast.stmt_flags, 0i32);
    pass id;
};

pub func:ast_stmt = StmtNode(Ast->:ast, StmtId:id) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.stmts.count) { !!! BoundsId; }
    pass ast.stmts.items[id.index => int64];
};

pub func:ast_stmt_count = int32(Ast->:ast) never fails { pass (raw ast_id(ast.stmts.count)); };

// --- declarations -------------------------------------------------------------

// AN ERROR CONSTANT'S ASSIGNED CODE (D-179), written into slot `c`. The only
// writer is resolve's `DeclErrorDecl` arm, which numbers user constants in
// module-graph order and fixes the prelude's system family from its
// declared literals. Written once, before anything reads it.
pub func:ast_set_error_code = NIL(Ast->:ast, DeclId:id, int32:code) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.decls.count) { !!! BoundsId; }
    DeclNode:n = ast.decls.items[id.index => int64];
    n.c = code;
    ast.decls.items[id.index => int64] = n;
    pass NIL;
};

pub func:ast_add_decl = DeclId(Ast->:ast, DeclKind:kind, Span:span,
                               int32:a, int32:b, int32:c, int64:payload) never fails {
    DeclNode:n = DeclNode{ kind: kind, span: span,
                           a: a, b: b, c: c, payload: payload };
    DeclId:id = DeclId{ index: raw ast_id(ast.decls.count) };
    drop list_push(@ast.decls, n);
    pass id;
};

pub func:ast_decl = DeclNode(Ast->:ast, DeclId:id) never fails {
    if (id.index < 0i32) { !!! BoundsId; }
    if ((id.index => int64) >= ast.decls.count) { !!! BoundsId; }
    pass ast.decls.items[id.index => int64];
};

pub func:ast_decl_count = int32(Ast->:ast) never fails { pass (raw ast_id(ast.decls.count)); };

