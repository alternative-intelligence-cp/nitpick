pub func:ast_type_count = int32(Ast->:ast) { pass ast.type_count; };

// --- patterns -------------------------------------------------------------------

func:ast_grow_pats = NIL(Ast->:ast) {
    int32:nc = ast.pat_cap * 2i32;
    wild int8->:bigger = ralloc(ast.pats => wild int8->,
                                (nc => int64) * #size_of<PatNode>());
    ast.pats = bigger => wild PatNode->;
    ast.pat_cap = nc;
    pass NIL;
};

pub func:ast_add_pat = PatId(Ast->:ast, PatKind:kind, Span:span,
                             int32:a, int32:b, int32:c, int64:payload) {
    if (ast.pat_count >= ast.pat_cap) {
        drop ast_grow_pats(ast);
    }
    PatNode:n = PatNode{ kind: kind, span: span,
                         a: a, b: b, c: c, payload: payload };
    ast.pats[ast.pat_count => int64] = n;
    PatId:id = PatId{ index: ast.pat_count };
    ast.pat_count = ast.pat_count + 1i32;
    pass id;
};

pub func:ast_pat = PatNode(Ast->:ast, PatId:id) {
    if (id.index < 0i32) { fail 7i32; }
    if (id.index >= ast.pat_count) { fail 7i32; }
    pass ast.pats[id.index => int64];
};

pub func:ast_pat_count = int32(Ast->:ast) { pass ast.pat_count; };

// --- the child-handle pool ------------------------------------------------------
//
// Usage is always: mark, push each child, then window. The mark is taken BEFORE
// the children are parsed, and parsing a child may itself push into the pool --
// which is fine, because a nested sequence completes before the outer one
// resumes pushing, so the windows nest rather than interleave.

pub func:ast_scratch_mark = int32(Ast->:ast) {
    pass ast.scratch_count;
};

func:ast_grow_scratch = NIL(Ast->:ast) {
    int32:nc = ast.scratch_cap * 2i32;
    wild int8->:bigger = ralloc(ast.scratch => wild int8->,
                                (nc => int64) * #size_of<int32>());
    ast.scratch = bigger => wild int32->;
    ast.scratch_cap = nc;
    pass NIL;
};

pub func:ast_scratch_push = NIL(Ast->:ast, int32:value) {
    if (ast.scratch_count >= ast.scratch_cap) {
        drop ast_grow_scratch(ast);
    }
    ast.scratch[ast.scratch_count => int64] = value;
    ast.scratch_count = ast.scratch_count + 1i32;
    pass NIL;
};

// Copy everything pushed since `mark` into the permanent pool, pop it from
// scratch, and return the window. After this the caller's children are
// contiguous in the pool and scratch is exactly as it was.
pub func:ast_scratch_commit = IdSpan(Ast->:ast, int32:mark) {
    int32:n = ast.scratch_count - mark;
    int32:start = ast.id_count;
    int32:i = 0i32;
    while (i < n) {
        drop ast_ids_push(ast, ast.scratch[(mark + i) => int64]);
        i = i + 1i32;
    }
    ast.scratch_count = mark;
    IdSpan:sp = IdSpan{ start: start, count: n };
    pass sp;
};

func:ast_grow_ids = NIL(Ast->:ast) {
    int32:nc = ast.id_cap * 2i32;
    wild int8->:bigger = ralloc(ast.ids => wild int8->,
                                (nc => int64) * #size_of<int32>());
    ast.ids = bigger => wild int32->;
    ast.id_cap = nc;
    pass NIL;
};

pub func:ast_ids_push = NIL(Ast->:ast, int32:value) {
    if (ast.id_count >= ast.id_cap) {
        drop ast_grow_ids(ast);
    }
    ast.ids[ast.id_count => int64] = value;
    ast.id_count = ast.id_count + 1i32;
    pass NIL;
};

pub func:ast_ids_count_since = int32(Ast->:ast, int32:mark) {
    pass (ast.id_count - mark);
};

pub func:ast_id_at = int32(Ast->:ast, int32:start, int32:i) {
    if (i < 0i32) { fail 8i32; }
    int32:at = start + i;
    if (at < 0i32) { fail 8i32; }
    if (at >= ast.id_count) { fail 8i32; }
    pass ast.ids[at => int64];
};
