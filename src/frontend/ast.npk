// --- the child-handle pool ------------------------------------------------------
//
// Usage is always: mark, push each child, then window. The mark is taken BEFORE
// the children are parsed, and parsing a child may itself push into the pool --
// which is fine, because a nested sequence completes before the outer one
// resumes pushing, so the windows nest rather than interleave.
//
// WINDOWS MAY CARRY A FIXED HEADER. A node with more children than `a`/`b`/`c`
// can hold -- a `FunctionDecl` has a return type, a body, generics, parameters,
// contracts and attributes -- puts a fixed-length header at the FRONT of its
// window and the variable-length lists after it, with their counts in the
// header. One rule, applied wherever it is needed, rather than a different
// improvisation per node.
//
// Two properties make this safe, and both are the point:
//
//   * the header is FIXED-LENGTH per node kind, so an absent child is a zero
//     handle in a known slot -- never a shorter window that a reader has to
//     measure to find out what is missing;
//   * only the node's own accessor functions ever index it, so a header slot
//     is named exactly once.
//
// `when`/`then`/`end` in parse_stmt.npk is the smallest instance: three slots,
// always three, two of which are often zero.

pub func:ast_scratch_mark = int32(Ast->:ast) never fails {
    pass (raw ast_smark(ast.scratch.count));
};

pub func:ast_scratch_push = NIL(Ast->:ast, int32:value) never fails {
    drop list_push(@ast.scratch, value);
    pass NIL;
};

// Copy everything pushed since `mark` into the permanent pool, pop it from
// scratch, and return the window. After this the caller's children are
// contiguous in the pool and scratch is exactly as it was.
pub func:ast_scratch_commit = IdSpan(Ast->:ast, int32:mark) never fails {
    int32:n = (raw ast_smark(ast.scratch.count)) - mark;
    int32:start = raw ast_id(ast.ids.count);
    for (int32:i in 0i32...n) {
        drop ast_ids_push(ast, ast.scratch.items[(mark + i) => int64]);
    }
    ast.scratch.count = mark => int64;
    IdSpan:sp = IdSpan{ start: start, count: n };
    pass sp;
};

pub func:ast_ids_push = NIL(Ast->:ast, int32:value) never fails {
    drop list_push(@ast.ids, value);
    pass NIL;
};

pub func:ast_ids_count_since = int32(Ast->:ast, int32:mark) never fails {
    pass ((raw ast_id(ast.ids.count)) - mark);
};

pub func:idspan_empty = IdSpan() never fails {
    IdSpan:s = IdSpan{ start: 0i32, count: 0i32 };
    pass s;
};

// READ AN ENTRY PUSHED SINCE `mark`, WITHOUT COMMITTING. Its counterpart below
// writes one; this reads one, and both are bounds-checked for the same reason.
//
// A list that must not repeat itself has to be searched while it is still being
// built — 0.4.7's bound closure walks a supertrait graph and pushes each trait it
// reaches, and a trait reachable by two routes would otherwise be pushed twice.
// Two copies of one bound is not a harmless duplicate: `find_method` reports a
// name supplied by two bounds as ambiguous, so the same trait counted twice makes
// every one of its methods uncallable.
pub func:ast_scratch_at = int32(Ast->:ast, int32:mark, int32:i) never fails {
    if (i < 0i32) { !!! BoundsScratch; }
    int32:at = mark + i;
    if ((at => int64) >= ast.scratch.count) { !!! BoundsScratch; }
    pass (ast.scratch.items[at => int64]);
};

// ABANDON everything pushed since `mark`, committing nothing.
//
// The counterpart to committing, and it is needed wherever a walk builds a window
// SPECULATIVELY -- 0.4.7's substitution pushes each substituted argument and then
// finds nothing changed, which is the common case. Committing anyway would append
// an identical window to the pool for every type a substitution walked past, and
// the pool only grows.
pub func:ast_scratch_drop = NIL(Ast->:ast, int32:mark) never fails {
    if (mark < 0i32) { !!! BoundsScratch; }
    if ((mark => int64) > ast.scratch.count) { !!! BoundsScratch; }
    ast.scratch.count = mark => int64;
    pass NIL;
};

// Overwrite an entry pushed since `mark`. A header slot whose value is a count of
// things not yet parsed has to be reserved first and filled in afterwards; this
// is that fill-in, and it is bounds-checked so a wrong index is an error rather
// than a silent write into somebody else's window.
pub func:ast_scratch_set = NIL(Ast->:ast, int32:mark, int32:i, int32:value) never fails {
    if (i < 0i32) { !!! BoundsScratch; }
    int32:at = mark + i;
    if ((at => int64) >= ast.scratch.count) { !!! BoundsScratch; }
    ast.scratch.items[at => int64] = value;
    pass NIL;
};

// Push a committed window's contents back onto scratch. A node that gathers
// several lists parses each into its own window and then assembles them behind a
// header; without this the lists would have to be parsed in final order, which
// they cannot be -- a function's parameter count is not known until after the
// parameters are parsed, and the header holding it comes first.
pub func:ast_copy_window = NIL(Ast->:ast, IdSpan:w) never fails {
    int32:i = 0i32;
    while (i < w.count) {
        drop ast_scratch_push(ast, raw ast_id_at(ast, w.start, i));
        i = i + 1i32;
    }
    pass NIL;
};

pub func:ast_id_at = int32(Ast->:ast, int32:start, int32:i) never fails {
    if (i < 0i32) { !!! BoundsWindow; }
    int32:at = start + i;
    if (at < 0i32) { !!! BoundsWindow; }
    if ((at => int64) >= ast.ids.count) { !!! BoundsWindow; }
    pass ast.ids.items[at => int64];
};

// --- expression SHAPES ---------------------------------------------------------------------
//
// WHICH SLOTS OF A NODE HOLD CHILD EXPRESSIONS, stated once for every kind.
//
// Before this existed, `resolve_expr` walked slot `a` on every kind it did not
// name, on the strength of a comment saying "slot `a` is an operand on every node
// that has one". Nothing checked that. It was true until a literal needed
// somewhere to keep its width suffix, and then a `42i32` quietly began resolving
// whatever node sat at index `WI32`.
//
// The list below is the assumption written down, and `EXPR_SHAPE_NONE` is what a
// kind gets when nobody has written it down yet -- which `tests/frontend/ast.npk`
// turns into a failure rather than a guess.
pub func:EXPR_SHAPE_NONE   = int32() never fails { pass 0i32; };  // UNCLASSIFIED -- a bug
pub func:EXPR_SHAPE_LEAF   = int32() never fails { pass 1i32; };  // no child expressions
pub func:EXPR_SHAPE_ONE    = int32() never fails { pass 2i32; };  // a
pub func:EXPR_SHAPE_TWO    = int32() never fails { pass 3i32; };  // a, b
pub func:EXPR_SHAPE_THREE  = int32() never fails { pass 4i32; };  // a, b, c
pub func:EXPR_SHAPE_LIST   = int32() never fails { pass 5i32; };  // window at b, count c
pub func:EXPR_SHAPE_ONELIST = int32() never fails { pass 6i32; }; // a, plus that window
pub func:EXPR_SHAPE_CUSTOM = int32() never fails { pass 7i32; };  // the walker names it

pub func:expr_shape = int32(ExprKind:k) never fails {
    // Leaves. Every one of these has a payload and no children, which is exactly
    // the group that a slot-`a` walk got wrong.
    if (k == ExprKind.ExprIntLiteral)        { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprFloatLiteral)      { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprCharLiteral)       { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprStringLiteral)     { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprRawStringLiteral)  { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprBlockStringLiteral){ pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprBoolLiteral)       { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprSentinelLiteral)   { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprIdentifierExpr)    { pass (raw EXPR_SHAPE_LEAF()); }
    if (k == ExprKind.ExprIterationVarExpr)  { pass (raw EXPR_SHAPE_LEAF()); }

    // One operand in slot `a`.
    if (k == ExprKind.ExprUnaryExpr)         { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprPostfixExpr)       { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprAddressOfExpr)     { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprDerefExpr)         { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprBorrowExpr)        { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprSpreadExpr)        { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprMoveExpr)          { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprIsErrExpr)         { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprComptimeExpr)      { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprRawUnwrapExpr)     { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprDropExpr)          { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprRelayExpr)         { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprAwaitExpr)         { pass (raw EXPR_SHAPE_ONE()); }
    // The cast family carries a TYPE in slot `b`, not an expression, so it is
    // one-operand here and the type is walked by the type resolver.
    if (k == ExprKind.ExprCastExpr)          { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprUncheckedCastExpr) { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprDynCastExpr)       { pass (raw EXPR_SHAPE_ONE()); }
    // Member access resolves its base and stops: the member name needs the base's
    // TYPE, which is why it is an interned name rather than a node.
    if (k == ExprKind.ExprMemberAccessExpr)  { pass (raw EXPR_SHAPE_ONE()); }
    if (k == ExprKind.ExprSafeNavExpr)       { pass (raw EXPR_SHAPE_ONE()); }

    // Two operands, `a` and `b`.
    if (k == ExprKind.ExprBinaryExpr)        { pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprRangeExpr)         { pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprIndexExpr)         { pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprPipeExpr)          { pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprSafeUnwrapExpr)    { pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprNullCoalesceExpr)  { pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprEmphaticUnwrapExpr){ pass (raw EXPR_SHAPE_TWO()); }
    if (k == ExprKind.ExprDefaultsExpr)      { pass (raw EXPR_SHAPE_TWO()); }

    // A `Result` literal is two operands in `a` and `b`, like any binary node.
    if (k == ExprKind.ExprResultLiteralExpr) { pass (raw EXPR_SHAPE_TWO()); }

    if (k == ExprKind.ExprTernaryExpr)       { pass (raw EXPR_SHAPE_THREE()); }

    // A window of ids at `b`, `c`.
    if (k == ExprKind.ExprTemplateLiteral)   { pass (raw EXPR_SHAPE_LIST()); }
    if (k == ExprKind.ExprArrayLiteralExpr)  { pass (raw EXPR_SHAPE_LIST()); }
    if (k == ExprKind.ExprVectorCtorExpr)    { pass (raw EXPR_SHAPE_LIST()); }
    if (k == ExprKind.ExprMethodCallExpr)    { pass (raw EXPR_SHAPE_ONELIST()); }

    // Kinds whose window is not a plain list of expressions, so a walker has to
    // say what it means: a struct literal alternates NAME and VALUE, a call and a
    // builtin put generic TYPE arguments before the value ones, and a `pick`
    // holds arms rather than expressions.
    if (k == ExprKind.ExprStructLiteralExpr) { pass (raw EXPR_SHAPE_CUSTOM()); }
    if (k == ExprKind.ExprCallExpr)          { pass (raw EXPR_SHAPE_CUSTOM()); }
    if (k == ExprKind.ExprBuiltinExpr)       { pass (raw EXPR_SHAPE_CUSTOM()); }
    if (k == ExprKind.ExprPickExpr)          { pass (raw EXPR_SHAPE_CUSTOM()); }

    pass (raw EXPR_SHAPE_NONE());
};
