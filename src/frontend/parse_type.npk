// Type parsing.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.2.
//
// Two facts from AST_REFERENCE.md §4 shape this whole file, and neither is
// obvious from the type system alone:
//
// 1. THERE IS NO SLICE NODE. `T[]` is an `ArrayType` whose `size` is absent, and
//    `T[N]` is one whose size is present. They are wildly different TYPES --
//    D-070 makes one a non-owning second-class view and the other a value type
//    with static bounds -- but they differ in SYNTAX only by the size
//    expression. The AST records syntax; the type checker assigns meaning.
//
// 2. QUALIFIERS ARE NOT PART OF THE TYPE. `stack`, `wild`, `wildx`,
//    `fixed` and the borrow markers live on the `VarDeclStmt`, not on the type
//    node. So `wild int8->:buf` is a declaration qualified `wild` whose type is
//    `int8->` -- and this parser must not consume the qualifier, or the
//    declaration loses it.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./parse_codes.npk".*;
use "./parser.npk".*;
use "./token_name.npk".*;
use "./parse_expr.npk".*;

// --- named accessors ---------------------------------------------------------
//
// Slots are interpreted HERE and nowhere else (ast.npk). A call site that reads
// `.a` directly is a call site that will break silently when a slot's meaning
// moves.

pub func:type_name_index = int64(TypeNode:t) never fails    { pass t.payload; };
// IS THE NAME A BUILTIN TYPE KEYWORD, or an interned identifier? The payload
// means a different thing in each case and there is no way to tell from the
// payload itself -- see the note where this is set.
pub func:type_name_is_builtin = bool(TypeNode:t) never fails { pass (t.c != 0i32); };
pub func:type_args_start = int32(TypeNode:t) never fails    { pass t.a; };
pub func:type_args_count = int32(TypeNode:t) never fails    { pass t.b; };
pub func:type_pointee = TypeId(TypeNode:t) never fails      { TypeId:i = TypeId{ index: t.a }; pass i; };
pub func:type_inner = TypeId(TypeNode:t) never fails        { TypeId:i = TypeId{ index: t.a }; pass i; };
pub func:type_element = TypeId(TypeNode:t) never fails      { TypeId:i = TypeId{ index: t.a }; pass i; };
pub func:type_array_size = ExprId(TypeNode:t) never fails   { ExprId:i = ExprId{ index: t.b }; pass i; };
// FuncType: a,b = the parameter-type window, c = the return type.
pub func:type_return = TypeId(TypeNode:t) never fails       { TypeId:i = TypeId{ index: t.c }; pass i; };
// `never fails` on a function TYPE (D-163) rides the node's payload slot.
pub func:type_func_never_fails = bool(TypeNode:t) never fails { pass (t.payload != 0i64); };
pub func:type_param_start = int32(TypeNode:t) never fails   { pass t.a; };
pub func:type_param_count = int32(TypeNode:t) never fails   { pass t.b; };
pub func:type_param_at = TypeId(Ast->:ast, TypeNode:t, int32:i) never fails {
    TypeId:p = TypeId{ index: raw ast_id_at(ast, t.a, i) };
    pass p;
};

// `T[]` versus `T[N]`: an absent size is the slice.
pub func:type_is_slice = bool(TypeNode:t) never fails {
    if (t.kind != TypeKind.TypeArrayType) { pass false; }
    pass (t.b == 0i32);
};

// A `ComptimeArg`'s value. Its own accessor because slot `a` holds an ExprId
// here and a TypeId on every other node that uses it -- reading one through
// `type_pointee` would hand a type-node index to something expecting an
// expression, which is the misreading the named accessors exist to prevent.
// `T.Item` — the base is `a`, the name is the payload (D-164).
pub func:type_projection_base = TypeId(TypeNode:t) never fails {
    TypeId:i = TypeId{ index: t.a };
    pass i;
};

pub func:type_projection_name = int64(TypeNode:t) never fails { pass t.payload; };

pub func:type_comptime_value = ExprId(TypeNode:t) never fails {
    ExprId:e = ExprId{ index: t.a };
    pass e;
};

// --- one entry in a type-argument list ----------------------------------------
//
// A TYPE ARGUMENT OR A COMPILE-TIME VALUE, and the two are told apart by whether
// the next token can begin a type at all (D-064 §2). `Mutex<Config, 2>` supplies
// one of each, positionally, and `2` begins no type -- so this is a disjoint
// token decision rather than a heuristic or a speculative parse.
//
// AN IDENTIFIER IS PARSED AS A TYPE, always. `Mutex<Config, LEVEL>` cannot be
// told apart here and must not be guessed at: the parser records what was
// WRITTEN, and which of the two a name means is decided where the parameter list
// is known. That is the same division `T[]` versus `T[N]` already follows.
//
// ONE FUNCTION FOR ALL THREE LISTS -- a named type's arguments, the turbofish,
// and a `#`-builtin's brackets. A value accepted in one and refused in the other
// two would make the same list mean different things depending on what opened it,
// which is exactly the context-dependence the blueprint philosophy forbids; a
// builtin that takes no values says so in the checker, where the message can name
// the builtin.
pub func:p_parse_type_arg = TypeId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    if (raw type_arg_starts_type(raw p_kind(p))) {
        pass (raw p_parse_type(p));
    }
    ExprId:v = raw p_parse_const_arg(p);
    pass (raw ast_add_type(p.ast, TypeKind.TypeComptimeArg, sp,
                             v.index, 0i32, 0i32, 0i64));
};

// The tokens `p_parse_type` itself accepts as a first token. Written from that
// function rather than guessed at, so the two cannot drift into disagreeing about
// what a type looks like.
func:type_arg_starts_type = bool(TokenKind:k) never fails {
    if (k == TokenKind.Ident)    { pass true; }
    if (k == TokenKind.KwDyn)    { pass true; }
    if (k == TokenKind.KwFunc)   { pass true; }
    if (k == TokenKind.KwSelf)   { pass true; }
    if (k == TokenKind.KwCstring){ pass true; }
    if (k == TokenKind.KwAny)    { pass true; }
    pass (raw token_kind_is_builtin_type(k));
};

// --- closing a type-argument list --------------------------------------------

// The lexer emits `>>` as ONE token because a type position is not lexically
// detectable (0.1.5): `Handle<Node<int64>>` is indistinguishable from a chain of
// comparisons until something knows it is reading a type. The parser is that
// something, so it asks for the split exactly when it needs a `>`.
//
// This is what D-064 bought by confining type-argument context to a type
// position or `::<` and nowhere else: no feedback channel into the lexer, no
// lookahead heuristic, no speculative parse.
pub func:p_expect_gt = bool(Parser->:p) never fails {
    if (raw p_accept(p, TokenKind.OpGt)) {
        pass true;
    }
    if (raw p_at(p, TokenKind.OpShr)) {
        if (raw tokenlist_split_shr(p.tokens, p.pos)) {
            // The first `>` closes this list; the second stays for the level
            // above, which is the whole reason nested generics work.
            discard(raw p_advance(p));
            pass true;
        }
    }
    pass (raw p_expect(p, TokenKind.OpGt));
};

// --- types --------------------------------------------------------------------

pub func:p_parse_type = TypeId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    TokenKind:k = raw p_kind(p);

    // `dyn A & B` -- a set of traits, combined with `&` (D-029).
    if (k == TokenKind.KwDyn) {
        discard(raw p_advance(p));
        int32:mark = raw ast_scratch_mark(p.ast);
        TypeId:first = raw p_parse_type(p);
        drop ast_scratch_push(p.ast, first.index);
        while (raw p_accept(p, TokenKind.OpAmp)) {
            TypeId:more = raw p_parse_type(p);
            drop ast_scratch_push(p.ast, more.index);
        }
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (raw ast_add_type(p.ast, TypeKind.TypeDynType, sp,
                                 w.start, w.count, 0i32, 0i64));
    }

    // `(` Type `)` GROUPS A TYPE (D-170), exactly as parentheses group an
    // expression: the group IS its inner type, and the suffixes bind to the
    // group. No new node kind — `(dyn A & B)[2]` is an array of the `dyn`,
    // where `dyn A & B[2]` could only be read as `dyn (A & B[2])`, an array
    // that is not a trait. The inner `p_parse_type` consumes any suffixes
    // written INSIDE the parens; `p_suffixes` here takes the ones after.
    if (k == TokenKind.PLParen) {
        discard(raw p_advance(p));
        TypeId:inner = raw p_parse_type(p);
        discard(raw p_expect(p, TokenKind.PRParen));
        pass (raw p_suffixes(p, inner));
    }

    // `cstring` and `any` are BUILTIN TYPE KEYWORDS with nodes of their own, so
    // they must be taken before the named-type path folds every keyword into a
    // NamedType. Both were unreachable until 0.2.8 for exactly that reason.
    if (k == TokenKind.KwCstring) {
        discard(raw p_advance(p));
        pass (raw p_suffixes(p, raw ast_add_type(p.ast, TypeKind.TypeCStringType,
                                                     sp, 0i32, 0i32, 0i32, 0i64)));
    }
    if (k == TokenKind.KwAny) {
        discard(raw p_advance(p));
        // `any` is legal ONLY under `->` (TYPE_REFERENCE section 27). That is a
        // type-checker rule, not a grammar one: bare `any` parses here and is
        // refused there, with the message the spec already writes. Enforcing it
        // in the parser would report "expected `->`" and name neither the type
        // nor the rule (D-085).
        pass (raw p_suffixes(p, raw ast_add_type(p.ast, TypeKind.TypeAnyType,
                                                     sp, 0i32, 0i32, 0i32, 0i64)));
    }

    // `func RetType(ParamTypes)` -- a function type (D-087). The same three parts
    // in the same order as the declaration it is the type of, minus the name:
    // there is nothing for a name to bind to in a type.
    if (k == TokenKind.KwFunc) {
        discard(raw p_advance(p));
        TypeId:ret = raw p_parse_type(p);
        discard(raw p_expect(p, TokenKind.PLParen));
        int32:mark = raw ast_scratch_mark(p.ast);
        while (true) {
            if (raw p_at(p, TokenKind.PRParen)) { break; }
            if (raw p_at_end(p)) { break; }
            TypeId:pt = raw p_parse_type(p);
            drop ast_scratch_push(p.ast, pt.index);
            if (!(raw p_accept(p, TokenKind.PComma))) { break; }
        }
        discard(raw p_expect(p, TokenKind.PRParen));
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        // `never fails` after the parameter list (D-163) — the func type's
        // contract, stored in the node's payload slot and read at resolve.
        int64:nf = 0i64;
        if (raw p_accept(p, TokenKind.KwNever)) {
            discard(raw p_expect(p, TokenKind.KwFails));
            nf = 1i64;
        }
        pass (raw p_suffixes(p, raw ast_add_type(p.ast, TypeKind.TypeFuncType,
                                                     sp, w.start, w.count,
                                                     ret.index, nf)));
    }

    if (k == TokenKind.KwSelf) {
        discard(raw p_advance(p));
        pass (raw p_suffixes(p, raw ast_add_type(p.ast, TypeKind.TypeSelfType,
                                                     sp, 0i32, 0i32, 0i32, 0i64)));
    }

    // A named type: any identifier, and every builtin type keyword. The parser
    // does not check that the name EXISTS -- that is the type checker's job, and
    // a parser that rejected unknown names could not report more than one.
    bool:named = (k == TokenKind.Ident);
    if (raw token_kind_is_builtin_type(k)) { named = true; }

    if (!named) {
        drop p_error(p, raw PARSE_EXPECTED(), "expected a type");
        pass (raw type_none());
    }

    Token:nt = raw p_advance(p);
    int64:name = nt.payload;
    // WHICH KIND OF NAME THIS IS, RECORDED RATHER THAN INFERRED.
    //
    // A builtin type keyword carries no intern index, so the KIND is stored as
    // the name instead. That much was always true; what was missing is anything
    // saying WHICH of the two a payload holds. The comment in `resolve_named`
    // claimed "the two are told apart by which range the payload is in", and
    // nothing separated the ranges: intern indices start at 1 and count up, and
    // the builtin type keywords sit at TokenKind 80-175. So the 88th distinct
    // identifier a program interns resolves as `int32` -- silently, with no
    // diagnostic, in any program large enough to reach it.
    //
    // This is D-096's defect at its root. That decision fixed `Result<int32>`,
    // where the same reinterpretation made a keyword read as an intern index; the
    // representation that allowed it was left alone. One bit ends it.
    int32:is_builtin = 0i32;
    if (nt.kind != TokenKind.Ident) {
        name = (nt.kind =>! int32) =>! int64;
        is_builtin = 1i32;
    }

    int32:astart = 0i32;
    int32:acount = 0i32;
    if (raw p_at(p, TokenKind.OpLt)) {
        discard(raw p_advance(p));
        int32:mark = raw ast_scratch_mark(p.ast);
        if (!(raw p_at(p, TokenKind.OpGt))) {
            TypeId:a1 = raw p_parse_type_arg(p);
            drop ast_scratch_push(p.ast, a1.index);
            while (raw p_accept(p, TokenKind.PComma)) {
                TypeId:argN = raw p_parse_type_arg(p);
                drop ast_scratch_push(p.ast, argN.index);
            }
        }
        discard(raw p_expect_gt(p));
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        astart = w.start;
        acount = w.count;
    }

    TypeId:base = raw ast_add_type(p.ast, TypeKind.TypeNamedType, sp,
                                     astart, acount, is_builtin, name);
    pass (raw p_suffixes(p, base));
};

// `->`, `[]`, `[N]`, `?` -- applied left to right, so `int8->[]` is a slice of
// pointers rather than a pointer to a slice.
pub func:p_suffixes = TypeId(Parser->:p, TypeId:base) never fails {
    TypeId:cur = base;
    while (true) {
        Span:sp = raw p_span(p);

        // `T.Item` — AN ASSOCIATED TYPE, PROJECTED (D-164). It is a suffix
        // because that is what it is: a base type with one more thing applied,
        // exactly like `->`, `?` and `[]` beside it. And it is `.` because an
        // associated type is a MEMBER of its trait and `.` is the language's one
        // member-access operator — the same reasoning that removed `->` from
        // member access for pointing the wrong way.
        //
        // There is no ambiguity with expression-position `.`: types and
        // expressions are separate grammars with separate entry points, and an
        // array size is the only expression inside a type, parsed by
        // `p_parse_expr` between its own brackets.
        if (raw p_accept(p, TokenKind.PDot)) {
            // THE NAME IS TAKEN WHATEVER IT IS, and `p_expect` reports it if it
            // is not an identifier. Consuming it either way keeps the suffix
            // loop moving, which is how the parser stays able to describe a
            // whole program rather than stopping at the first mistake.
            int64:pnm = 0i64;
            if (raw p_at(p, TokenKind.Ident)) {
                pnm = (raw p_advance(p)).payload;
            } else {
                discard(raw p_expect(p, TokenKind.Ident));
            }
            cur = raw ast_add_type(p.ast, TypeKind.TypeProjection, sp,
                                     cur.index, 0i32, 0i32, pnm);
        } else {

        if (raw p_accept(p, TokenKind.OpArrowTo)) {
            cur = raw ast_add_type(p.ast, TypeKind.TypePointerType, sp,
                                     cur.index, 0i32, 0i32, 0i64);
        } else {
            if (raw p_accept(p, TokenKind.OpQuestion)) {
                cur = raw ast_add_type(p.ast, TypeKind.TypeOptionalType, sp,
                                         cur.index, 0i32, 0i32, 0i64);
            } else {
                if (raw p_at(p, TokenKind.PLBracket)) {
                    discard(raw p_advance(p));
                    // An absent size is a SLICE; a present one is a fixed array.
                    //
                    // The size is an EXPRESSION (AST_REFERENCE section 4:
                    // `size: Expr?`). This used to consume exactly one token and
                    // call it an integer literal whatever it was -- so
                    // `int32[COUNT]` produced an array sized by COUNT's
                    // intern-table slot, and `int32[N + 1]` stopped after `N`.
                    // Neither failed. Both meant something other than what was
                    // written, which is the worse of the two ways to be wrong.
                    int32:size = 0i32;
                    if (!(raw p_at(p, TokenKind.PRBracket))) {
                        size = (raw p_parse_expr(p)).index;
                    }
                    discard(raw p_expect(p, TokenKind.PRBracket));
                    cur = raw ast_add_type(p.ast, TypeKind.TypeArrayType, sp,
                                             cur.index, size, 0i32, 0i64);
                } else {
                    break;
                }
            }
        }
        }
    }
    pass cur;
};
