// Tokens.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.1.1.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./num_width.npk".*;

// The payload is ONE MACHINE WORD (SUBSET_1 section 1.2), which is what keeps a
// token small and the AST pointer-free:
//
//   Ident / StringLit / FloatLit   an intern-table index
//   IntLit                         the value
//   CharLit                        the code point
//   everything else                unused, zero
//
// The WIDTH of a numeric literal is a separate field rather than more payload,
// because a literal's width is part of its type and not part of its value --
// and in expression position it is never inferred (SUBSET_1).
pub struct:Token = {
    TokenKind:kind;
    Span:span;
    int64:payload;
    NumWidth:width;   // WNone when the token is not numeric
};

pub func:token_make = Token(TokenKind:kind, Span:span, int64:payload) {
    Token:t = Token{ kind: kind, span: span, payload: payload,
                     width: NumWidth.WNone };
    pass t;
};

pub func:token_numeric = Token(TokenKind:kind, Span:span, int64:value,
                               NumWidth:width) {
    Token:t = Token{ kind: kind, span: span, payload: value, width: width };
    pass t;
};

pub func:token_is = bool(Token:t, TokenKind:kind) {
    pass (t.kind == kind);
};

pub func:token_is_eof = bool(Token:t) {
    pass (t.kind == TokenKind.Eof);
};

// ---------------------------------------------------------------------------
// TokenList
//
// Growable over alloc/ralloc and #size_of<Token>, because subset 1 has no
// generics. Doubling rather than incrementing: a source file's token count is
// not knowable in advance, and repeated ralloc of a large buffer is the one
// place a bump allocator that never frees actually hurts.
// ---------------------------------------------------------------------------

pub struct:TokenList = {
    wild Token->:items;
    int64:count;
    int64:cap;
};

pub func:tokenlist_init = TokenList() {
    int64:n = 256i64;
    wild int8->:raw_mem = alloc(n * #size_of<Token>());
    TokenList:l = TokenList{ items: raw_mem => wild Token->, count: 0i64, cap: n };
    pass l;
};

pub func:tokenlist_grow = NIL(TokenList->:l) {
    int64:newcap = l.cap * 2i64;
    wild int8->:bigger = ralloc(l.items => wild int8->,
                                newcap * #size_of<Token>());
    l.items = bigger => wild Token->;
    l.cap = newcap;
    pass NIL;
};

pub func:tokenlist_push = NIL(TokenList->:l, Token:t) {
    if (l.count >= l.cap) {
        drop tokenlist_grow(l);
    }
    l.items[l.count] = t;
    l.count = l.count + 1i64;
    pass NIL;
};

pub func:tokenlist_count = int64(TokenList->:l) {
    pass l.count;
};

pub func:tokenlist_at = Token(TokenList->:l, int64:i) {
    if (i < 0i64) {
        fail 4i32;
    }
    if (i >= l.count) {
        fail 4i32;
    }
    pass l.items[i];
};

pub func:tokenlist_last = Token(TokenList->:l) {
    if (l.count == 0i64) {
        fail 4i32;
    }
    pass l.items[l.count - 1i64];
};

// Split a `>>` at `i` into two `>` tokens.
//
// LEXICAL_REFERENCE 5.2 requires `>>` to split "when the parser is in a
// type-argument context" -- and that context is the PARSER'S knowledge, not the
// lexer's. A type-argument list is opened by a type position or by `::<`
// (D-064), and a type position is not lexically detectable: `Handle<Node<int64>>`
// is indistinguishable from a chain of comparisons until something knows it is
// reading a type.
//
// So the lexer emits `>>` whole and the parser asks for the split when it needs
// a `>`. That keeps the lexer context-free -- no feedback channel, no lookahead
// heuristic, no speculative parse -- which is what D-064 bought by confining
// type-argument context to two precisely delimited places.
pub func:tokenlist_split_shr = bool(TokenList->:l, int64:i) {
    if (i < 0i64) { pass false; }
    if (i >= l.count) { pass false; }
    if (l.items[i].kind != TokenKind.OpShr) { pass false; }

    if (l.count >= l.cap) {
        drop tokenlist_grow(l);
    }

    Token:orig = l.items[i];

    // Shift the tail up by one to make room for the second `>`.
    int64:j = l.count;
    while (j > i) {
        l.items[j] = l.items[j - 1i64];
        j = j - 1i64;
    }
    l.count = l.count + 1i64;

    // Two one-byte spans, so a diagnostic can point at either half.
    Span:a = raw span_make(orig.span.file, orig.span.offset, orig.span.line,
                           orig.span.col, 1i32);
    Span:b = raw span_make(orig.span.file, orig.span.offset + 1i32,
                           orig.span.line, orig.span.col + 1i32, 1i32);
    l.items[i] = raw token_make(TokenKind.OpGt, a, 0i64);
    l.items[i + 1i64] = raw token_make(TokenKind.OpGt, b, 0i64);
    pass true;
};
