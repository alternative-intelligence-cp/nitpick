// Tokens.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.1.1.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
mod:token;
error:BoundsId;

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./num_width.npk".*;

// The payload is ONE MACHINE WORD (SUBSET_1 section 1.2), which is what keeps a
// token small and the AST pointer-free:
//
//   Ident / StringLit / FloatLit   an intern-table index
//   IntLit                         the value
//   CharLit                        the code point
//   everything else                unused, zero
//
// The WIDTH of a numeric literal is a separate field rather than more payload,
// because a literal's width is part of its type and not part of its value --
// and in expression position it is never inferred (SUBSET_1).
pub struct:Token = {
    TokenKind:kind;
    Span:span;
    int64:payload;
    NumWidth:width;   // WNone when the token is not numeric
};

pub func:token_make = Token(TokenKind:kind, Span:span, int64:payload) never fails {
    Token:t = Token{ kind: kind, span: span, payload: payload,
                     width: NumWidth.WNone };
    pass t;
};

pub func:token_numeric = Token(TokenKind:kind, Span:span, int64:value,
                               NumWidth:width) never fails {
    Token:t = Token{ kind: kind, span: span, payload: value, width: width };
    pass t;
};

pub func:token_is = bool(Token:t, TokenKind:kind) never fails {
    pass (t.kind == kind);
};

pub func:token_is_eof = bool(Token:t) never fails {
    pass (t.kind == TokenKind.Eof);
};

// ---------------------------------------------------------------------------
// TokenList
//
// Storage is `List<Token>` (1.4.7, family 12 of the step-2 conversion). It was
// hand-written over alloc/ralloc and #size_of<Token> because subset 1 had no
// generics — the same story as `SourceManager` — and that constraint expired
// when the seed was retired at 1.4.6. The doubling growth the old code did by
// hand is `list.npk`'s now; the 256-token initial capacity below is the old
// one, kept because a source file's token count is not knowable in advance.
// ---------------------------------------------------------------------------

pub struct:TokenList = {
    List<Token>:v;
};

pub func:tokenlist_init = TokenList() never fails {
    pass TokenList{ v: raw list_init::<Token>(256i64) };
};

pub func:tokenlist_push = NIL(TokenList->:l, Token:t) never fails {
    drop list_push(@l.v, t);
    pass NIL;
};

pub func:tokenlist_count = int64(TokenList->:l) never fails {
    pass l.v.count;
};

pub func:tokenlist_at = Token(TokenList->:l, int64:i) never fails {
    if (i < 0i64) {
        !!! BoundsId;
    }
    if (i >= l.v.count) {
        !!! BoundsId;
    }
    pass l.v.items[i];
};

pub func:tokenlist_last = Token(TokenList->:l) never fails {
    if (l.v.count == 0i64) {
        !!! BoundsId;
    }
    pass l.v.items[l.v.count - 1i64];
};

// Split a `>>` at `i` into two `>` tokens.
//
// LEXICAL_REFERENCE 5.2 requires `>>` to split "when the parser is in a
// type-argument context" -- and that context is the PARSER'S knowledge, not the
// lexer's. A type-argument list is opened by a type position or by `::<`
// (D-064), and a type position is not lexically detectable: `Handle<Node<int64>>`
// is indistinguishable from a chain of comparisons until something knows it is
// reading a type.
//
// So the lexer emits `>>` whole and the parser asks for the split when it needs
// a `>`. That keeps the lexer context-free -- no feedback channel, no lookahead
// heuristic, no speculative parse -- which is what D-064 bought by confining
// type-argument context to two precisely delimited places.
pub func:tokenlist_split_shr = bool(TokenList->:l, int64:i) never fails {
    if (i < 0i64) { pass false; }
    if (i >= l.v.count) { pass false; }
    if (l.v.items[i].kind != TokenKind.OpShr) { pass false; }

    drop list_reserve(@l.v, 1i64);

    Token:orig = l.v.items[i];

    // Shift the tail up by one to make room for the second `>`.
    int64:j = l.v.count;
    while (j > i) {
        l.v.items[j] = l.v.items[j - 1i64];
        j = j - 1i64;
    }
    l.v.count = l.v.count + 1i64;

    // Two one-byte spans, so a diagnostic can point at either half.
    Span:a = raw span_make(orig.span.file, orig.span.offset, orig.span.line,
                           orig.span.col, 1i32);
    Span:b = raw span_make(orig.span.file, orig.span.offset + 1i32,
                           orig.span.line, orig.span.col + 1i32, 1i32);
    l.v.items[i] = raw token_make(TokenKind.OpGt, a, 0i64);
    l.v.items[i + 1i64] = raw token_make(TokenKind.OpGt, b, 0i64);
    pass true;
};
