// Traits and implementations.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.6.
//
// `impl` BLOCKS DECLARE NOTHING AT MODULE SCOPE, and 0.3.1 said so in a comment:
// "Its methods are reached through the type, which needs the type to exist first
// -- so they are collected in cycle 0.4 where coherence is decided, not here."
// This is that cycle, and this is the table it meant.
//
// The consequence of not having had one is worth stating plainly, because it made
// a passing test in 0.4.5 mean less than it looked like it meant: `type_method_call`
// resolves a method by ORDINARY SCOPE LOOKUP, so `p.magnitude()` only ever found a
// module-level free function. The 0.4.5 fixture declared `func:magnitude` at
// module scope and UFCS resolved it, exactly as designed -- but a `magnitude`
// written where the spec puts it, inside `impl:Point`, was invisible. Nothing in
// the language could call a method declared in an impl.
//
// THE TABLE IS BUILT ONCE PER MODULE and answers three questions that all need
// the same walk: which impls exist (coherence), what methods a type has (UFCS),
// and what a trait requires of them (completeness).

use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
// A DECLARED CYCLE with type_access (0.8.1): an impl check reads a
// function type's parameter window through `type_param_at_of`, and access
// checking consults the impl table. Same shape as type_expr <-> type_stmt.
use "./type_access.npk".*;
use "./type_names.npk".*;
use "./parse_decl.npk".*;
use "./parse_type.npk".*;
use "./symbols.npk".*;
use "./resolve_type.npk".*;
use "./type_decl.npk".*;

// One `impl` block. The TARGET IS ALWAYS SLOT ONE (D-031), with or without a
// trait, so `inherent` is `trait_id == 0` rather than a different shape.
pub struct:ImplEntry = {
    int32:target;     // the type being implemented on, or 0 for a blanket impl
    int32:trait_id;   // the trait, or 0 for an inherent impl
    int32:decl;       // the `ImplDecl` node index
    bool:blanket;     // `impl:<T: Bound>:Trait` — the target is a parameter

    // THE SCOPE IT WAS COLLECTED IN. Every later question about this impl —
    // whether its methods match the trait's, whether its supertraits are
    // satisfied — resolves type names, and those names mean what they mean IN
    // THIS MODULE. A whole program has one impl table and many scopes, so a
    // single scope passed to the checks would resolve one module's impls against
    // another module's names: not an error, a different answer.
    int32:scope;
};

pub struct:ImplTable = {
    wild ImplEntry->:items;
    int32:count;
    int32:cap;
};

pub func:impltable_init = ImplTable() {
    int64:n = 16i64;
    wild int8->:mem = alloc(n * #size_of<ImplEntry>());
    ImplTable:t = ImplTable{ items: mem =>! wild ImplEntry->,
                             count: 0i32, cap: 16i32 };
    pass t;
};

func:impl_grow = NIL(ImplTable->:t) {
    int32:nc = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items =>! wild int8->,
                                (nc => int64) * #size_of<ImplEntry>());
    t.items = bigger =>! wild ImplEntry->;
    t.cap = nc;
    pass NIL;
};

pub func:impl_count = int32(ImplTable->:t) { pass t.count; };

pub func:impl_at = ImplEntry(ImplTable->:t, int32:i) {
    if (i < 0i32) { fail 21tbb32; }
    if (i >= t.count) { fail 21tbb32; }
    pass (t.items[i => int64]);
};

func:impl_push = NIL(ImplTable->:t, int32:target, int32:trait_id, int32:decl,
                     bool:blanket, int32:scope) {
    if (t.count >= t.cap) { drop impl_grow(t); }
    ImplEntry:e = ImplEntry{ target: target, trait_id: trait_id, decl: decl,
                             blanket: blanket, scope: scope };
    t.items[t.count => int64] = e;
    t.count = t.count + 1i32;
    pass NIL;
};

// --- building ----------------------------------------------------------------------------

// Walk a module's declarations and record every `impl`. The target and the trait
// are RESOLVED HERE rather than at each use, so that two impls on the same type
// compare as one integer and coherence does not depend on how the annotation was
// spelled -- `Point` and an alias for it are the same interned type (D-090).
pub func:collect_impls = NIL(ImplTable->:t, TypeResolver->:r, DeclId:mod_id,
                             int32:scope) {
    DeclNode:m = relay ast_decl(r.ast, mod_id);
    int32:n = raw item_member_count(r.ast, m);
    int32:i = 0i32;
    while (i < n) {
        DeclId:id = raw item_member(r.ast, m, i);
        DeclNode:d = relay ast_decl(r.ast, id);
        if (d.kind == DeclKind.DeclImplDecl) {
            drop collect_one_impl(t, r, id, d, scope);
        }
        // A NESTED `mod` HOLDS IMPLS TOO, and nothing collected them. An `impl`
        // one level down was absent from this table, which is not a diagnostic —
        // it is coherence never seeing a second implementation, completeness
        // never checking the methods, and a call finding no method at all.
        //
        // Recursion rather than a second walk: this function IS "collect from a
        // module's members", and a nested module is one.
        if (d.kind == DeclKind.DeclModuleDecl) {
            int32:inner = raw nested_module_scope(r.tab, d, scope);
            if (inner != 0i32) {
                drop collect_impls(t, r, id, inner);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:collect_one_impl = NIL(ImplTable->:t, TypeResolver->:r, DeclId:id,
                            DeclNode:d, int32:scope) {
    // A BLANKET IMPL'S TARGET IS THE PARAMETER IT DECLARED (D-105, D-111).
    //
    // 0.4.6 recorded a zero here and skipped every check that reads a target,
    // which was a schedule rather than a silence — bound satisfaction is 0.4.7's.
    // Making the target the PARAMETER TYPE is what pays that schedule off, and it
    // pays it in one line: `Self` inside the block then resolves to the parameter
    // through the machinery D-103 already built, and completeness, supertraits and
    // duplicate names all run on a blanket impl unchanged rather than being
    // skipped. A zero could do none of that, because a zero is not a type.
    if (relay impl_is_blanket(r.ast, d)) {
        TypeId:btt = relay impl_trait(r.ast, d);

        // A BLANKET IMPL IMPLEMENTS A TRAIT. `impl:<T: Bound> = { … };` parses —
        // the grammar is never partial (D-085) — and means adding methods to every
        // type satisfying a bound, which is adding methods to types the writer
        // does not own. §2.6 gives the form with a trait and only with one.
        if (raw type_is_none(btt)) {
            drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(),
                "a blanket impl implements a TRAIT for every type satisfying its bound, so it is written `impl:<T: Bound>:Trait`; an inherent one would add methods to types it does not own",
                d.span));
            pass NIL;
        }

        int32:bt = relay resolve_type(r, btt, scope);
        if (bt == 0i32) { pass NIL; }
        if (raw type_is_invalid(r.types, bt)) { pass NIL; }
        if ((raw type_kind(r.types, bt)) != (raw TY_TRAIT())) {
            string:n1 = relay string_concat("`", relay type_display(r.types, r.interns, bt));
            drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(),
                relay string_concat(n1,
                    "` is not a trait, so it cannot be implemented; in `impl:<T: Bound>:Trait` the trait comes last"),
                d.span));
            pass NIL;
        }

        DeclId:gp = relay impl_generic(r.ast, d, 0i32);
        DeclNode:gpn = relay ast_decl(r.ast, gp);
        drop impl_push(t, raw tt_param(r.types, gp.index, raw decl_name(gpn)),
                       bt, id.index, true, scope);
        pass NIL;
    }

    // A FAMILY IMPL'S TARGET MENTIONS ITS OWN PARAMETERS (1.0.4b):
    // `impl:<T>:Box<T>:Sized2` resolves `Box<T>` with `T` declared right there,
    // so the parameters are bound before the target is read — the same move
    // `bind_own_generics` makes for a function's signature, and for the same
    // reason (a declaration's parameters are in scope for its own annotations).
    // The window is empty for a non-generic impl, so one path serves both.
    IdSpan:igw = raw decl_generic_window(r.ast, d);
    GenericScope:isaved = r.generics;
    r.generics = GenericScope{ params_start: igw.start, params_count: igw.count,
                               args_start: 0i32, args_count: 0i32 };
    int32:target = relay resolve_type(r, relay impl_target(r.ast, d), scope);
    r.generics = isaved;
    if (target == 0i32) { pass NIL; }
    if (raw type_is_invalid(r.types, target)) { pass NIL; }

    TypeId:tyt = relay impl_trait(r.ast, d);
    if (raw type_is_none(tyt)) {
        drop impl_push(t, target, 0i32, id.index, false, scope);
        pass NIL;
    }

    int32:trait_id = relay resolve_type(r, tyt, scope);
    if (trait_id == 0i32) { pass NIL; }
    if (raw type_is_invalid(r.types, trait_id)) { pass NIL; }

    // `impl:Point:Point` — THE SECOND SEGMENT IS A TRAIT AND NOTHING ELSE. It
    // resolves as a type like any other, so a struct name lands here perfectly
    // well-formed and means nothing; saying which segment is wrong is the whole
    // value of the diagnostic, since the two are one character apart.
    if ((raw type_kind(r.types, trait_id)) != (raw TY_TRAIT())) {
        string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, trait_id));
        string:m2 = relay string_concat(m1,
            "` is not a trait, so it cannot be implemented; in `impl:Type:Trait` the type comes first (D-031)");
        drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(), m2, d.span));
        pass NIL;
    }
    drop impl_push(t, target, trait_id, id.index, false, scope);
    pass NIL;
};

// --- coherence (TRAITS_REFERENCE 4.1) ----------------------------------------------------

// AT MOST ONE IMPLEMENTATION OF A TRAIT FOR A TYPE. Two is not an ambiguity the
// compiler could resolve by a rule -- there is no rule that would not be a
// silent choice between two things a programmer wrote on purpose.
//
// INHERENT IMPLS ARE NOT SUBJECT TO THIS. `impl:Point = { … };` twice is two
// groups of methods on one type, which is a formatting choice; what would be
// wrong is the same METHOD twice, and that is a duplicate-name question rather
// than a coherence one.
// TWO BLANKET IMPLS OF ONE TRAIT CONFLICT, FULL STOP (D-111).
//
// The overlap question looks like it needs bound satisfaction and does not, and
// the reason is that the language has NO NEGATIVE BOUNDS: nothing stops a type
// implementing both `A` and `B`, so `impl:<T: A>:Loggable` and
// `impl:<T: B>:Loggable` genuinely overlap wherever a type satisfies both. There
// is no specialization to choose between them (D-064 §7), so choosing either
// would be a silent choice between two things a programmer wrote on purpose.
//
// A BLANKET IMPL AND A CONCRETE ONE ARE NOT A CONFLICT (D-105) — overlapping is
// the point, and §2.6 already says the concrete one wins.
pub func:check_coherence = NIL(ImplTable->:t, TypeResolver->:r) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:a = relay impl_at(t, i);
        if (a.trait_id != 0i32) {
            int32:j = i + 1i32;
            while (j < t.count) {
                ImplEntry:b = relay impl_at(t, j);
                if (b.trait_id == a.trait_id) {
                    if (a.blanket) {
                        if (b.blanket) { drop blanket_overlap(r, a, b); }
                    } else {
                        if (!b.blanket) {
                            if (b.target == a.target) {
                                drop coherence_error(r, a, b);
                            } else {
                                // A FAMILY IMPL COVERS EVERY INSTANCE OF ITS
                                // FAMILY (1.0.4c). `impl:<T>:Box<T>:S` and
                                // `impl:Box<int32>:S` have DIFFERENT targets as
                                // interned types, so the equality above never
                                // fired and the overlap was left to be reported
                                // at a call as an ambiguous method — a library
                                // whose overlap nothing in it calls compiled
                                // clean and handed the error to its consumer.
                                // §4.1 puts the error at the second impl, and
                                // D-064 §7 has no specialization, so "family
                                // plus per-instance" is an overlap rather than
                                // "the specific one wins".
                                if (relay family_covers(r, a, b)) {
                                    drop family_overlap(r, a, b);
                                }
                            }
                        }
                    }
                }
                j = j + 1i32;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// Does one of these impls implement a FAMILY that the other's target belongs
// to? True when either is a family impl (it declared parameters and named a
// target of its own) and both targets share a declaration — which is what
// identity is (D-090), and what makes `Box<int32>` a member of `Box<T>`'s
// family.
func:family_covers = bool(TypeResolver->:r, ImplEntry:a, ImplEntry:b) {
    bool:af = relay impl_is_family(r, a);
    bool:bf = relay impl_is_family(r, b);
    if (!af) {
        if (!bf) { pass false; }
    }
    int32:ad = raw type_decl_of(r.types, a.target);
    if (ad == 0i32) { pass false; }
    pass (ad == (raw type_decl_of(r.types, b.target)));
};

func:impl_is_family = bool(TypeResolver->:r, ImplEntry:e) {
    if (e.blanket) { pass false; }
    DeclNode:d = relay ast_decl(r.ast, DeclId{ index: e.decl });
    pass ((raw impl_generic_count(r.ast, d)) > 0i32);
};

// A family impl beside a per-instance one: both named, the second carrying the
// span, the same shape the other two overlaps use.
//
// THE ROLES ARE READ OFF THE IMPLS, NOT OFF DECLARATION ORDER. `first` is only
// the earlier of the pair — either one may be the family, and both may be
// (`impl:<T>:Box<T>:S` beside `impl:<U>:Box<U>:S` intern differently and reach
// here). Telling a reader that a per-instance impl "covers every instance"
// because it happened to be written first is a refusal that misdescribes what
// it refused, which is worse than a terser one that is true.
func:family_overlap = NIL(TypeResolver->:r, ImplEntry:first, ImplEntry:second) {
    DeclNode:first_d = relay ast_decl(r.ast, DeclId{ index: first.decl });
    DeclNode:second_d = relay ast_decl(r.ast, DeclId{ index: second.decl });

    string:fr = "covers one member of that family";
    string:sr = "covers every instance of it";
    if (relay impl_is_family(r, first)) {
        fr = "covers every instance of that family";
        sr = "covers one member of it";
        if (relay impl_is_family(r, second)) {
            sr = "covers every instance of it as well";
        }
    }

    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, second.trait_id));
    string:m2 = relay string_concat(m1, "` is already implemented for `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, first.target));
    string:m4 = relay string_concat(m3, "` at line ");
    string:m5 = relay string_concat(m4,
                    raw int_to_string(first_d.span.line => int64));
    string:m6 = relay string_concat(m5, ", which ");
    string:m7 = relay string_concat(m6, fr);
    string:m8 = relay string_concat(m7, "; this impl ");
    string:m9 = relay string_concat(m8, sr);
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_COHERENCE(),
        relay string_concat(m9,
            " — with no specialization there is no rule to choose by (D-064 §7), so the two overlap rather than one winning"),
        second_d.span));
    pass NIL;
};

// BOTH ARE NAMED, the same shape the concrete conflict uses — a reader told only
// that two blanket impls overlap has to go and find the other one, which is the
// one thing the compiler already knows.
func:blanket_overlap = NIL(TypeResolver->:r, ImplEntry:first, ImplEntry:second) {
    DeclId:fid = DeclId{ index: first.decl };
    DeclNode:first_d = relay ast_decl(r.ast, fid);
    DeclId:sid = DeclId{ index: second.decl };
    DeclNode:second_d = relay ast_decl(r.ast, sid);

    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, second.trait_id));
    string:m2 = relay string_concat(m1, "` already has a blanket impl at line ");
    string:m3 = relay string_concat(m2, raw int_to_string(first_d.span.line => int64));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_COHERENCE(),
        relay string_concat(m3,
            "; a blanket impl applies to every type satisfying its bound, and nothing stops a type satisfying both bounds — with no specialization there is no rule to choose by (D-064)"),
        second_d.span));
    pass NIL;
};

// BOTH IMPLS ARE NAMED, and the second one carries the span. "conflicting
// implementations" with one location makes the reader search for the other, which
// is the one thing the compiler already knows.
func:coherence_error = NIL(TypeResolver->:r, ImplEntry:first, ImplEntry:second) {
    DeclId:fid = DeclId{ index: first.decl };
    DeclNode:first_d = relay ast_decl(r.ast, fid);
    DeclId:sid = DeclId{ index: second.decl };
    DeclNode:second_d = relay ast_decl(r.ast, sid);

    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, second.trait_id));
    string:m2 = relay string_concat(m1, "` is already implemented for `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, second.target));
    string:m4 = relay string_concat(m3, "` at line ");
    string:m5 = relay string_concat(m4, raw int_to_string(first_d.span.line => int64));

    // ONE OF THE TWO MAY HAVE BEEN GENERATED, and saying so is the difference
    // between a useful sentence and one that sends the reader looking for an `impl`
    // they never wrote. `#[derive(Eq)]` above a hand-written `impl:Point:Eq` is two
    // implementations of one trait, and the derive is the half that is invisible.
    string:tail = "; a trait has at most one implementation per type";
    if (raw decl_has(first_d, raw DECL_DERIVED())) {
        tail = "; `#[derive]` generated one of them, and a trait has at most one implementation per type — remove the derive, or the impl";
    }
    if (raw decl_has(second_d, raw DECL_DERIVED())) {
        tail = "; `#[derive]` generated one of them, and a trait has at most one implementation per type — remove the derive, or the impl";
    }
    drop diaglist_push(r.diags,
        raw diag_error(raw TYPE_COHERENCE(), relay string_concat(m5, tail),
                       second_d.span));
    pass NIL;
};

// --- bounds (TRAITS_REFERENCE 3.1, D-064) ------------------------------------------------
//
// WHAT A GENERIC PARAMETER IS ALLOWED TO DO. `<T: Renderable & Serializable>`
// says `T` implements those two traits, and D-064 §1 says the body may use
// exactly that and nothing else -- so this table is the entire content of "no
// duck typing", and without it a bound is a comment.
//
// The reason to enforce it is not tidiness. Astrée analyses MONOMORPHIZED output,
// so a body checked only against the instantiations a program happens to contain
// can be correct for every one of them and still be wrong in general. The single
// verification run (`astree-verification-one-shot-constraint`) is the worst place
// to find that out. Checking the body against its bounds is what makes the
// property hold for instantiations nobody has written yet.
//
// THE STORED WINDOW IS THE TRANSITIVE CLOSURE, not the bounds as written. §2.2
// makes a supertrait a requirement on the implementing type, so `T: Ordered`
// where `Ordered = Equatable & { … }` genuinely guarantees `Equatable` too, and a
// body may use it. Computing the closure ONCE, here, is what lets every later
// question -- method lookup, bound satisfaction -- be a window scan with no
// resolver and no scope in hand.

pub struct:BoundEntry = {
    int32:param;       // the `GenericParam` decl index — the key
    int32:start;       // window of trait type ids, transitively closed
    int32:count;
    int32:value_type;  // `<comptime int32:LEVEL>` — its type; 0 for a type parameter
};

pub struct:BoundTable = {
    wild BoundEntry->:items;
    int32:count;
    int32:cap;
};

pub func:boundtable_init = BoundTable() {
    int64:n = 16i64;
    wild int8->:mem = alloc(n * #size_of<BoundEntry>());
    BoundTable:t = BoundTable{ items: mem =>! wild BoundEntry->,
                               count: 0i32, cap: 16i32 };
    pass t;
};

func:bound_grow = NIL(BoundTable->:t) {
    int32:nc = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items =>! wild int8->,
                                (nc => int64) * #size_of<BoundEntry>());
    t.items = bigger =>! wild BoundEntry->;
    t.cap = nc;
    pass NIL;
};

pub func:bound_count = int32(BoundTable->:t) { pass t.count; };

pub func:bound_at = BoundEntry(BoundTable->:t, int32:i) {
    if (i < 0i32) { fail 22tbb32; }
    if (i >= t.count) { fail 22tbb32; }
    pass (t.items[i => int64]);
};

func:bound_push = NIL(BoundTable->:t, int32:param, int32:start, int32:count,
                      int32:value_type) {
    if (t.count >= t.cap) { drop bound_grow(t); }
    BoundEntry:e = BoundEntry{ param: param, start: start, count: count,
                               value_type: value_type };
    t.items[t.count => int64] = e;
    t.count = t.count + 1i32;
    pass NIL;
};

// THE ENTRY FOR ONE PARAMETER, or an empty one. A parameter with no entry is not
// an error state: a bare `<T>` declares no bounds, and "no bounds" and "not
// collected" have the same consequence — `T` can do nothing — so they do not need
// telling apart.
pub func:bound_entry_of = BoundEntry(BoundTable->:t, int32:param) {
    int32:i = 0i32;
    while (i < t.count) {
        BoundEntry:e = relay bound_at(t, i);
        if (e.param == param) { pass e; }
        i = i + 1i32;
    }
    BoundEntry:none = BoundEntry{ param: 0i32, start: 0i32, count: 0i32,
                                  value_type: 0i32 };
    pass none;
};

// DOES THIS PARAMETER DECLARE THIS TRAIT? The closure is already stored, so a
// supertrait answers `true` here without a second walk.
pub func:param_declares = bool(BoundTable->:t, int32:param, int32:trait_id,
                               Ast->:ast) {
    BoundEntry:e = relay bound_entry_of(t, param);
    int32:i = 0i32;
    while (i < e.count) {
        if ((relay ast_id_at(ast, e.start, i)) == trait_id) { pass true; }
        i = i + 1i32;
    }
    pass false;
};

// A method supplied by one of a parameter's bounds. Same three-state answer as
// the impl-table lookup, and for the same reason: two bounds declaring one name
// is a real ambiguity that only the programmer can settle.
func:find_in_bounds = MethodFind(BoundTable->:bt, Ast->:ast, TypeTable->:types,
                                 int32:param, int32:name) {
    // A BOUND'S METHOD IS THE TRAIT'S DECLARATION, written in terms of `Self`, so
    // there is no blanket parameter to bind -- the receiver IS the parameter.
    MethodFind:best = raw method_none();
    BoundEntry:e = relay bound_entry_of(bt, param);
    int32:i = 0i32;
    while (i < e.count) {
        int32:trait_id = relay ast_id_at(ast, e.start, i);
        int32:decl = raw type_decl_of(types, trait_id);
        if (decl != 0i32) {
            DeclId:did = DeclId{ index: decl };
            DeclNode:td = relay ast_decl(ast, did);
            int32:m = relay trait_member_named(ast, td, name,
                                               DeclKind.DeclFunctionDecl);
            if (m != 0i32) {
                if (best.found) {
                    best.ambiguous = true;
                    best.other = trait_id;
                } else {
                    best.found = true;
                    best.decl = m;
                    best.owner = trait_id;
                }
            }
        }
        i = i + 1i32;
    }
    pass best;
};

// FUEL, for the same reason `SUPER_FUEL` exists: a supertrait graph is written by
// a program, so `trait:A = B & {…}; trait:B = A & {…};` is a cycle somebody can
// type. The closure walk must terminate before reporting rather than after.
func:BOUND_FUEL = int32() { pass 64i32; };

// Add one trait and everything it requires, skipping what is already present.
//
// THE DUPLICATE CHECK IS NOT AN OPTIMISATION. Two routes to one trait -- `T: A &
// B` where `B` requires `A` -- would push `A` twice, and `find_in_bounds` reads a
// second copy as a second bound declaring the same name. Every method of `A`
// would then be reported as ambiguous, on a program that is perfectly correct.
func:closure_push = NIL(TypeResolver->:r, int32:mark, int32:trait_id,
                        int32:scope, int32:fuel) {
    if (fuel <= 0i32) { pass NIL; }

    int32:have = (raw ast_scratch_mark(r.ast)) - mark;
    int32:i = 0i32;
    while (i < have) {
        if ((relay ast_scratch_at(r.ast, mark, i)) == trait_id) { pass NIL; }
        i = i + 1i32;
    }
    drop ast_scratch_push(r.ast, trait_id);

    int32:decl = raw type_decl_of(r.types, trait_id);
    if (decl == 0i32) { pass NIL; }
    DeclId:did = DeclId{ index: decl };
    DeclNode:td = relay ast_decl(r.ast, did);

    int32:n = raw item_extra_count(r.ast, td);
    int32:j = 0i32;
    while (j < n) {
        int32:sup = relay resolve_type(r, relay item_extra(r.ast, td, j), scope);
        if (sup != 0i32) {
            if (!(raw type_is_invalid(r.types, sup))) {
                // A supertrait that is not a trait is reported by
                // `check_supertraits`, against the trait that named it. Reporting
                // it a second time here would say the same thing about a
                // declaration the reader did not write.
                if ((raw type_kind(r.types, sup)) == (raw TY_TRAIT())) {
                    drop closure_push(r, mark, sup, scope, fuel - 1i32);
                }
            }
        }
        j = j + 1i32;
    }
    pass NIL;
};

// One parameter's bounds, resolved and closed.
func:collect_param_bounds = NIL(BoundTable->:t, TypeResolver->:r, DeclId:gp,
                                int32:scope) {
    DeclNode:g = relay ast_decl(r.ast, gp);

    // A VALUE PARAMETER HAS A TYPE AND NO BOUNDS, and the two are told apart by
    // the type slot rather than by a flag -- `parse_decl.npk` says why that is an
    // exact discriminator rather than a coincidence.
    if (raw generic_is_value(g)) {
        int32:vt = relay resolve_type(r, raw generic_value_type(g), scope);
        drop bound_push(t, gp.index, 0i32, 0i32, vt);
        pass NIL;
    }

    int32:mark = raw ast_scratch_mark(r.ast);
    int32:n = raw generic_bound_count(g);
    int32:i = 0i32;
    while (i < n) {
        // NOT `tid` — that is one of the five kernel identifier types (D-042),
        // and a type name is not an identifier.
        TypeId:bid = TypeId{ index: relay ast_id_at(r.ast,
                                                    raw generic_bound_start(g), i) };
        int32:bound_id = relay resolve_type(r, bid, scope);
        if (bound_id != 0i32) {
            if (!(raw type_is_invalid(r.types, bound_id))) {
                if ((raw type_kind(r.types, bound_id)) != (raw TY_TRAIT())) {
                    drop bound_not_trait(r, g, bound_id);
                } else {
                    drop closure_push(r, mark, bound_id, scope, raw BOUND_FUEL());
                }
            }
        }
        i = i + 1i32;
    }
    IdSpan:w = raw ast_scratch_commit(r.ast, mark);
    drop bound_push(t, gp.index, w.start, w.count, 0i32);
    pass NIL;
};

func:bound_not_trait = NIL(TypeResolver->:r, DeclNode:g, int32:bound_id) {
    string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, bound_id));
    string:m2 = relay string_concat(m1, "` is not a trait, so it cannot bound `");
    string:m3 = relay string_concat(m2, relay intern_get(r.interns, raw decl_name(g)));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(),
        relay string_concat(m3,
            "`; a bound names the traits the parameter must implement, and a parameter binds to exactly one type rather than to types resembling one"),
        g.span));
    pass NIL;
};

// EVERY GENERIC PARAMETER IN THE MODULE, wherever it was declared. The three
// declaration shapes keep their generics in three different slots -- a function's
// behind its own header, an item's behind the item header, an impl's behind that
// -- so this walks each by its own accessor rather than by a shared one that
// would read the wrong slot for two of the three.
pub func:collect_bounds = NIL(BoundTable->:t, TypeResolver->:r, DeclId:mod_id,
                              int32:scope) {
    DeclNode:m = relay ast_decl(r.ast, mod_id);
    int32:n = raw item_member_count(r.ast, m);
    int32:i = 0i32;
    while (i < n) {
        DeclId:id = raw item_member(r.ast, m, i);
        drop collect_decl_bounds(t, r, id, scope);

        // A NESTED `mod`'s generic parameters have bounds too, and a bound that
        // was never collected is a type parameter with NO constraints as far as
        // every later question is concerned — which accepts calls that should be
        // refused rather than refusing ones that should be accepted.
        DeclNode:d = relay ast_decl(r.ast, id);
        if (d.kind == DeclKind.DeclModuleDecl) {
            int32:inner = raw nested_module_scope(r.tab, d, scope);
            if (inner != 0i32) {
                drop collect_bounds(t, r, id, inner);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:collect_decl_bounds = NIL(BoundTable->:t, TypeResolver->:r, DeclId:id,
                               int32:scope) {
    DeclNode:d = relay ast_decl(r.ast, id);

    if (d.kind == DeclKind.DeclFunctionDecl) {
        int32:n = relay fn_generic_count(r.ast, d);
        int32:i = 0i32;
        while (i < n) {
            drop collect_param_bounds(t, r, relay fn_generic(r.ast, d, i), scope);
            i = i + 1i32;
        }
        pass NIL;
    }

    if (d.kind == DeclKind.DeclImplDecl) {
        int32:n = relay impl_generic_count(r.ast, d);
        int32:i = 0i32;
        while (i < n) {
            drop collect_param_bounds(t, r, relay impl_generic(r.ast, d, i), scope);
            i = i + 1i32;
        }
        // A METHOD MAY BE GENERIC ON ITS OWN ACCOUNT. `impl:Point = { func:map<U:
        // Printable> = … };` declares `U` inside a block whose own generic list is
        // empty, so a walk that stopped at the block would leave `U` unbounded and
        // silently duck-typed.
        int32:mn = relay impl_member_count(r.ast, d);
        int32:j = 0i32;
        while (j < mn) {
            drop collect_decl_bounds(t, r, relay impl_member(r.ast, d, j), scope);
            j = j + 1i32;
        }
        pass NIL;
    }

    // A struct, an enum or a trait: generics in the ITEM header, and a trait's
    // methods may declare their own.
    if (d.kind == DeclKind.DeclStructDecl) {
        drop collect_item_bounds(t, r, d, scope);
        pass NIL;
    }
    if (d.kind == DeclKind.DeclEnumDecl) {
        drop collect_item_bounds(t, r, d, scope);
        pass NIL;
    }
    if (d.kind == DeclKind.DeclTraitDecl) {
        drop collect_item_bounds(t, r, d, scope);
        int32:mn = raw item_member_count(r.ast, d);
        int32:j = 0i32;
        while (j < mn) {
            drop collect_decl_bounds(t, r, raw item_member(r.ast, d, j), scope);
            j = j + 1i32;
        }
        pass NIL;
    }
    pass NIL;
};

func:collect_item_bounds = NIL(BoundTable->:t, TypeResolver->:r, DeclNode:d,
                               int32:scope) {
    int32:n = raw item_generic_count(r.ast, d);
    int32:i = 0i32;
    while (i < n) {
        drop collect_param_bounds(t, r, relay item_generic(r.ast, d, i), scope);
        i = i + 1i32;
    }
    pass NIL;
};

// --- method lookup (UFCS, D-006) ---------------------------------------------------------

// WHETHER ONE WAS FOUND IS A SEPARATE ANSWER FROM WHICH ONE, and from whether the
// name was ambiguous. Three states, three fields -- the same `whether` versus
// `which` split that `NsAccess` and `expr_shape` were rebuilt around, applied
// before it could go wrong a fourth time.
pub struct:MethodFind = {
    bool:found;
    bool:ambiguous;
    int32:decl;        // the FunctionDecl's index
    int32:owner;       // the trait it came through, or 0 for an inherent method
    int32:other;       // the OTHER trait, when ambiguous
    // THE PARAMETERISED IMPL IT CAME FROM, or 0. A blanket impl's methods are
    // written in terms of its PARAMETER -- `func:l = int32(T:self)` -- so the
    // caller has to bind that parameter to the receiver before the signature
    // means anything. Without it, `T` resolves to "there is no type named `T`"
    // at a call site that is nowhere near the declaration.
    //
    // A FAMILY IMPL (1.0.4b) needs the same binding and differs only in WHAT the
    // parameters bind to: a blanket impl's single parameter is the receiver
    // itself (`T` = `Point`), while a family impl's are the receiver's own type
    // ARGUMENTS (`impl:<T>:Box<T>` called on `Box<int32>` binds `T` = `int32`).
    // One slot, because the question it answers -- "whose parameters must this
    // call bind?" -- is one question; `bind_impl_params` reads the impl to see
    // which shape it is.
    int32:blanket_impl;

    // THE IMPL THIS METHOD WAS FOUND IN, or 0 when no impl supplied it (a
    // trait's own body, a `dyn`, a bound). D-156's amendment needs it: a
    // method's SYMBOL names its impl, so the call site has to know which impl
    // it reached, and re-deriving that in the backend is impossible — the
    // emitter holds neither the impl table nor the bound table, which is the
    // same reason `exprtypes_callee` exists at all.
    //
    // DISTINCT FROM `blanket_impl`, which is set only for a PARAMETERISED impl
    // and answers "whose parameters must this call bind?". This one is set
    // whenever an impl answered, parameterised or not, and answers "whose
    // symbol is it?". Two questions, two slots — folding them would make the
    // non-parameterised case indistinguishable from no impl at all.
    int32:owner_impl;
};

func:method_none = MethodFind() {
    MethodFind:m = MethodFind{ found: false, ambiguous: false,
                               decl: 0i32, owner: 0i32, other: 0i32,
                               blanket_impl: 0i32, owner_impl: 0i32 };
    pass m;
};

// A method on `target`, by name. Inherent first, then trait impls.
//
// INHERENT WINS, and it is not a tie-break invented here: TRAITS_REFERENCE 2.6
// settles the same question for blanket impls -- "concrete impls take priority" --
// and an inherent method is the most concrete thing there is. A type's own method
// is also the one its author wrote knowing the type, which is the reading a
// programmer would expect to hold.
//
// TWO TRAITS SUPPLYING ONE NAME IS AMBIGUOUS AND IS AN ERROR. Picking either
// would be a silent choice, and the spec gives no rule to pick by -- so the
// caller is told both, and disambiguates by calling the free-function form.
//
// A GENERIC PARAMETER IS ANSWERED FROM ITS BOUNDS AND NOT FROM THIS TABLE
// (D-064). `T` is an opaque type satisfying exactly what it declares, so the
// impls a program happens to contain say nothing about it -- and asking them
// would BE duck typing, arrived at by omission. It is the same question with the
// same shape of answer, so it is this function rather than one the caller has to
// know to reach for; what changes is where the methods come from.
pub func:find_method = MethodFind(ImplTable->:t, BoundTable->:bt,
                                  TypeTable->:types, Ast->:ast,
                                  InternTable->:interns, int32:target,
                                  int32:name, int32:self_trait) {
    if ((raw type_kind(types, target)) == (raw TY_PARAM())) {
        pass (relay find_in_bounds(bt, ast, types,
                                   raw type_decl_of(types, target), name));
    }

    // `Self` INSIDE A TRAIT'S OWN BODY (1.0.4). A default method calls its
    // trait's other methods on `self` — that is what a default is FOR — and
    // `Self` there is the anonymous placeholder D-103 designed, carrying no
    // declaration of its own. The enclosing trait is what it is guaranteed to
    // have, so that is where the name is looked up; reaching an impl's method
    // from here would be reaching past the guarantee into one implementor.
    if ((raw type_kind(types, target)) == (raw TY_SELF())) {
        if (self_trait != 0i32) {
            DeclNode:std = relay ast_decl(ast, DeclId{ index: self_trait });
            int32:sm = relay trait_member_named(ast, std, name,
                           DeclKind.DeclFunctionDecl);
            if (sm != 0i32) {
                MethodFind:sf = MethodFind{ found: true, ambiguous: false,
                                            decl: sm, owner: 0i32,
                                            other: 0i32, blanket_impl: 0i32,
                                            owner_impl: 0i32 };
                pass sf;
            }
        }
        pass (raw method_none());
    }

    if ((raw type_kind(types, target)) == (raw TY_TRAIT())) {
        int32:tdecl = raw type_decl_of(types, target);
        if (tdecl != 0i32) {
            DeclNode:td = relay ast_decl(ast, DeclId{ index: tdecl });
            int32:m = relay trait_member_named(ast, td, name,
                          DeclKind.DeclFunctionDecl);
            if (m != 0i32) {
                MethodFind:sm = MethodFind{ found: true, ambiguous: false,
                                            decl: m, owner: target,
                                            other: 0i32, blanket_impl: 0i32,
                                            owner_impl: 0i32 };
                pass sm;
            }
        }
        pass (raw method_none());
    }

    // `dyn A & B` DISPATCHES THROUGH A VTABLE (D-158, 1.0.5). The methods a
    // `dyn` can reach are the ones its NAMED traits declare — own lists only.
    //
    // A SUPERTRAIT'S METHODS ARE NOT REACHABLE through a `dyn` of the subtrait.
    // The subtrait's vtable holds the subtrait's own declaration list and no
    // super-vtable was built, so code that needs them constructs `dyn Super`
    // from the concrete value, where the vtable exists. This is a decided no,
    // not a gap the implementation left.
    //
    // THE ANSWER IS THE TRAIT'S DECLARATION, NEVER AN IMPL'S. Behind the vtable
    // there is no one impl to name — which is also what makes 1.1's `never
    // fails` licence read the TRAIT's contract for a `dyn` call (D-163 rule 5).
    if ((raw type_kind(types, target)) == (raw TY_DYN())) {
        pass (relay find_in_dyn(types, ast, target, name));
    }

    MethodFind:best = raw method_none();
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        // A FAMILY IMPL MATCHES ANY INSTANCE OF ITS TARGET (1.0.4b).
        // `impl:<T>:Box<T>:Sized2` has target `Box<T>`; a call on `Box<int32>`
        // must reach it, and the two are different interned types. They share a
        // DECLARATION, which is what identity is (D-090), so that is the test —
        // the same shape `blanket_applies` uses for the blanket form, one step
        // less general.
        bool:hit = (e.target == target);
        if (!hit) {
            if ((raw impl_generic_count(ast, relay ast_decl(ast,
                     DeclId{ index: e.decl }))) > 0i32) {
                if (e.target != 0i32) {
                    int32:ed = raw type_decl_of(types, e.target);
                    if (ed != 0i32) {
                        if (ed == (raw type_decl_of(types, target))) {
                            hit = true;
                        }
                    }
                }
            }
        }
        if (hit) {
            bool:parameterised = ((raw impl_generic_count(ast,
                relay ast_decl(ast, DeclId{ index: e.decl }))) > 0i32);
            int32:mdecl = relay impl_method_named(ast, interns, e.decl, name);

            // AN OMITTED METHOD FALLS BACK TO THE TRAIT'S DEFAULT (1.0.4). A
            // trait method with a BODY is inherited by every impl that does not
            // write its own — that is what a default IS — and until now nothing
            // looked past the impl's own members, so `p.doubled_size()` on an
            // impl that inherited it reported "no method". The trait is asked
            // only when the impl is silent, which is the same
            // concrete-outranks-general ordering the blanket search below uses.
            if (mdecl == 0i32) {
                if (e.trait_id != 0i32) {
                    mdecl = relay trait_default_named(ast, interns, types,
                                e.trait_id, name);
                }
            }
            if (mdecl != 0i32) {
                if (e.trait_id == 0i32) {
                    // An inherent method ends the search: nothing outranks it,
                    // and a second inherent one is a duplicate-name error that
                    // belongs to the declaration, not to this lookup.
                    MethodFind:m = MethodFind{ found: true, ambiguous: false,
                                               decl: mdecl, owner: 0i32,
                                               other: 0i32, blanket_impl: 0i32,
                                               owner_impl: e.decl };
                    pass m;
                }
                if (best.found) {
                    best.ambiguous = true;
                    best.other = e.trait_id;
                } else {
                    best.found = true;
                    best.decl = mdecl;
                    best.owner = e.trait_id;
                    best.owner_impl = e.decl;
                    if (parameterised) { best.blanket_impl = e.decl; }
                }
            }
        }
        i = i + 1i32;
    }

    // A BLANKET IMPL IS ASKED LAST, AND ONLY IF NOTHING CONCRETE ANSWERED. That
    // ordering IS §2.6's "concrete impls take priority" — expressed as the order
    // the question is asked rather than as a tie-break afterwards, so there is no
    // moment at which two candidates exist and something has to choose.
    //
    // Among themselves blanket impls are ordinary trait candidates: two supplying
    // one name is the same ambiguity two concrete trait impls would be.
    if (!best.found) {
        int32:j = 0i32;
        while (j < t.count) {
            ImplEntry:e = relay impl_at(t, j);
            if (e.blanket) {
                if (relay blanket_applies(t, bt, ast, types, e, target,
                                          raw IMPL_FUEL())) {
                    int32:mdecl = relay impl_method_named(ast, interns, e.decl, name);
                    if (mdecl != 0i32) {
                        if (best.found) {
                            best.ambiguous = true;
                            best.other = e.trait_id;
                        } else {
                            best.found = true;
                            best.decl = mdecl;
                            best.owner = e.trait_id;
                            best.owner_impl = e.decl;
                            best.blanket_impl = e.decl;
                        }
                    }
                }
            }
            j = j + 1i32;
        }
    }
    pass best;
};

// The named traits' own methods, in bound order, with a name supplied by two of
// them refused rather than resolved.
func:find_in_dyn = MethodFind(TypeTable->:types, Ast->:ast, int32:target,
                              int32:name) {
    int32:n = raw type_dyn_count(types, target);
    int32:start = raw type_dyn_start(types, target);
    MethodFind:best = raw method_none();
    int32:i = 0i32;
    while (i < n) {
        int32:tr = relay ast_id_at(ast, start, i);
        int32:td = raw type_decl_of(types, tr);
        if (td != 0i32) {
            DeclNode:tn = relay ast_decl(ast, DeclId{ index: td });
            int32:m = relay trait_member_named(ast, tn, name,
                          DeclKind.DeclFunctionDecl);
            if (m != 0i32) {
                if (best.found) {
                    // TWO BOUNDS SUPPLYING ONE NAME IS AMBIGUOUS, and there is
                    // deliberately no ordering tie-break: picking the first
                    // would be meaning-by-position, and after D-159's canonical
                    // ordering "first" is decided by how the traits are SPELT,
                    // which is worse than either.
                    best.ambiguous = true;
                    best.other = tr;
                } else {
                    best.found = true;
                    best.decl = m;
                    best.owner = tr;
                }
            }
        }
        i = i + 1i32;
    }
    pass best;
};

// A trait's DEFAULT for `name`: a method the trait declares WITH A BODY. A
// bodiless declaration is a requirement, not a default — an impl that omits one
// of those is incomplete, which is a different diagnostic (and a different
// check) from a method it simply inherited.
func:trait_default_named = int32(Ast->:ast, InternTable->:interns,
                                 TypeTable->:types, int32:trait_id,
                                 int32:name) {
    int32:tdecl = raw type_decl_of(types, trait_id);
    if (tdecl == 0i32) { pass 0i32; }
    DeclNode:td = relay ast_decl(ast, DeclId{ index: tdecl });
    int32:n = relay item_member_count(ast, td);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = relay item_member(ast, td, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if ((raw decl_name(m)) == name) {
                if (!(raw stmt_is_none(raw fn_body(ast, m)))) {
                    pass (mid.index);
                }
            }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// A function member of one `impl` block, by name.
func:impl_method_named = int32(Ast->:ast, InternTable->:interns, int32:decl,
                               int32:name) {
    DeclId:id = DeclId{ index: decl };
    DeclNode:d = relay ast_decl(ast, id);
    int32:n = relay impl_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = relay impl_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// --- what a trait requires of an impl (TRAITS_REFERENCE 2, 2.1, 2.3) ---------------------

// A TRAIT MEMBER IS REQUIRED OR IT IS DEFAULTED, and the AST already says which:
// a method with no body, and an `assoc` with no bound type. Both absences are
// real rather than a flag somebody has to set (`parse_decls.npk` says so of the
// method case: "A trait method has no body, and that is a real absence").
func:trait_method_required = bool(Ast->:ast, DeclNode:m) {
    pass (raw stmt_is_none(relay fn_body(ast, m)));
};

func:assoc_required = bool(DeclNode:m) {
    pass (raw type_is_none(raw assoc_default(m)));
};

// Every impl is checked against the trait it names. THREE QUESTIONS, and each is
// a different mistake with a different fix:
//
//   * a REQUIRED member is missing        -- the impl is incomplete
//   * a member the trait never declared   -- the impl invents surface
//   * a member whose SIGNATURE disagrees  -- the impl is not interchangeable
//
// The third is the one that would otherwise pass. An `impl` supplying
// `func:area = int32(Point:self)` where the trait declares `flt64(Self:self)` has
// every method the trait asked for and satisfies nothing: a caller holding a
// `dyn Sized` would call through a vtable slot typed one way and land in a body
// typed another. Checking names without checking shapes is checking the label.
// A BLANKET IMPL IS CHECKED LIKE ANY OTHER (D-111). It was skipped because its
// target was a zero, and a zero cannot be compared against anything; now it is the
// parameter type, so `Self` substitutes to the parameter and every question below
// has an answer.
pub func:check_impls_complete = NIL(ImplTable->:t, TypeResolver->:r) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (e.trait_id != 0i32) {
            drop check_one_impl_complete(r, e, e.scope);
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:check_one_impl_complete = NIL(TypeResolver->:r, ImplEntry:e, int32:scope) {
    DeclId:trait_did = DeclId{ index: raw type_decl_of(r.types, e.trait_id) };
    DeclNode:td = relay ast_decl(r.ast, trait_did);
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:idl = relay ast_decl(r.ast, iid);

    // --- everything the trait requires is supplied --------------------------------
    int32:tn = raw item_member_count(r.ast, td);
    int32:i = 0i32;
    while (i < tn) {
        DeclId:mid = raw item_member(r.ast, td, i);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if (relay trait_method_required(r.ast, m)) {
                if ((relay impl_member_named(r.ast, idl, raw decl_name(m),
                                             DeclKind.DeclFunctionDecl)) == 0i32) {
                    drop missing_error(r, e, idl, m, "method");
                }
            }
        }
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            if (raw assoc_required(m)) {
                if ((relay impl_member_named(r.ast, idl, raw decl_name(m),
                                             DeclKind.DeclAssocTypeDecl)) == 0i32) {
                    drop missing_error(r, e, idl, m, "associated type");
                }
            }
        }
        i = i + 1i32;
    }

    // --- and nothing the trait did not declare ------------------------------------
    //
    // AN EXTRA METHOD IS NOT A HELPER. `impl:Point = { … };` is where a method
    // with no trait behind it belongs (2.4), and it is one line away -- so the
    // diagnostic points there rather than merely refusing.
    int32:inn = relay impl_member_count(r.ast, idl);
    int32:j = 0i32;
    while (j < inn) {
        DeclId:mid = relay impl_member(r.ast, idl, j);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            int32:decl_in_trait = relay trait_member_named(r.ast, td, raw decl_name(m),
                                                           DeclKind.DeclFunctionDecl);
            if (decl_in_trait == 0i32) {
                drop extra_error(r, e, m, "method");
            } else {
                drop check_signature(r, e, decl_in_trait, mid.index, m, scope);
            }
        }
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            if ((relay trait_member_named(r.ast, td, raw decl_name(m),
                                          DeclKind.DeclAssocTypeDecl)) == 0i32) {
                drop extra_error(r, e, m, "associated type");
            }
        }
        j = j + 1i32;
    }
    pass NIL;
};

// A member of an `impl` block by name AND KIND. The kind matters: a trait may
// declare `assoc:Item` and a method could be named `Item` too, and matching on
// the name alone would let one stand in for the other.
func:impl_member_named = int32(Ast->:ast, DeclNode:d, int32:name, DeclKind:kind) {
    int32:n = relay impl_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = relay impl_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == kind) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

func:trait_member_named = int32(Ast->:ast, DeclNode:d, int32:name, DeclKind:kind) {
    int32:n = raw item_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = raw item_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == kind) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

func:missing_error = NIL(TypeResolver->:r, ImplEntry:e, DeclNode:idl, DeclNode:m,
                         string:what) {
    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, e.trait_id));
    string:m2 = relay string_concat(m1, "` requires ");
    string:m3 = relay string_concat(m2, what);
    string:m4 = relay string_concat(m3, " `");
    string:m5 = relay string_concat(m4, relay intern_get(r.interns, raw decl_name(m)));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5, "`, and this impl does not supply it"), idl.span));
    pass NIL;
};

func:extra_error = NIL(TypeResolver->:r, ImplEntry:e, DeclNode:m, string:what) {
    string:m1 = relay string_concat("`",
                    relay intern_get(r.interns, raw decl_name(m)));
    string:m2 = relay string_concat(m1, "` is not ");
    string:m3 = relay string_concat(m2, relay a_or_an(what));
    string:m4 = relay string_concat(m3, " of `");
    string:m5 = relay string_concat(m4,
                    relay type_display(r.types, r.interns, e.trait_id));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5,
            "`; an inherent `impl:Type = { … };` is where a member with no trait behind it belongs"),
        m.span));
    pass NIL;
};

func:a_or_an = string(string:what) {
    if (raw string_eq(what, "associated type")) { pass "an associated type"; }
    pass "a method";
};

// --- signatures must match (TRAITS_REFERENCE 2) ------------------------------------------

// THE TRAIT'S SIGNATURE IS RESOLVED WITH `Self` AS A PLACEHOLDER; the impl's is
// resolved with `Self` AS THE TARGET. Comparing them therefore means substituting
// one for the other, and the substitution is the whole reason `Self` needed a type
// of its own rather than being an error everywhere (D-103).
//
// `r.self_type` is SAVED AND RESTORED around each resolution. It is state on the
// resolver rather than a parameter for the same reason `e.expected` is: it is
// constant across one signature and a nested construct restores it. Leaking it
// would make the next impl's `Self` mean this impl's target.
func:check_signature = NIL(TypeResolver->:r, ImplEntry:e, int32:trait_fn,
                           int32:impl_fn, DeclNode:im, int32:scope) {
    int32:saved = r.self_type;
    GenericScope:saved_enc = r.enclosing;

    // A GENERIC TRAIT'S PARAMETERS ARE BOUND BY THE IMPL (D-111).
    // `impl:Point:Into<int32>` means `T = int32` in everything `Into` declares, so
    // the trait's `func:into = T(Self:self)` is `int32(Point:self)` here. Without
    // this the comparison is between `Result<T>` and `Result<int32>` and every
    // impl of a generic trait is reported as having the wrong signature.
    r.enclosing = relay trait_binding(r, e.trait_id);

    DeclId:tfid = DeclId{ index: trait_fn };
    DeclNode:tf = relay ast_decl(r.ast, tfid);
    r.self_type = raw tt_self(r.types);
    // THE TRAIT'S SIGNATURE MENTIONS THE TRAIT'S ASSOCS (D-160). `func:next =
    // Item(Self:self)` resolves `Item` the way it resolves `Self` — through the
    // enclosing trait — so the trait has to be set while its signature is read,
    // and cleared before the IMPL's is.
    int32:saved_st = r.self_trait;
    r.self_trait = raw type_decl_of(r.types, e.trait_id);
    int32:want = relay fn_type(r, tfid, raw decl_name(tf), scope);
    r.self_trait = saved_st;

    // THE IMPL'S SIGNATURE IS RESOLVED WITH THE IMPL'S OWN PARAMETERS, which for
    // a blanket impl is where its `T` comes from — `func:log_str = string(T:self)`
    // has no other binding to reach.
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:iblock = relay ast_decl(r.ast, iid);
    IdSpan:ig = raw decl_generic_window(r.ast, iblock);
    GenericScope:ige = GenericScope{ params_start: ig.start, params_count: ig.count,
                                     args_start: 0i32, args_count: 0i32 };
    r.enclosing = ige;

    DeclId:ifid = DeclId{ index: impl_fn };
    DeclNode:f = relay ast_decl(r.ast, ifid);
    r.self_type = e.target;
    int32:got = relay fn_type(r, ifid, raw decl_name(f), scope);

    r.self_type = saved;
    r.enclosing = saved_enc;

    if (want == 0i32) { pass NIL; }
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(r.types, want)) { pass NIL; }
    if (raw type_is_invalid(r.types, got)) { pass NIL; }
    SigCtx:sc = SigCtx{ target: e.target, impl_decl: e.decl, scope: scope };
    if (relay same_signature(r, want, got, sc)) { pass NIL; }

    string:m1 = relay string_concat("`",
                    relay intern_get(r.interns, raw decl_name(f)));
    string:m2 = relay string_concat(m1, "` does not have the signature `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, e.trait_id));
    string:m4 = relay string_concat(m3, "` declares for it");
    drop diaglist_push(r.diags,
        raw diag_error(raw TYPE_IMPL_INCOMPLETE(), m4, im.span));
    pass NIL;
};

// THE TRAIT'S PARAMETERS, BOUND TO WHAT THE IMPL NAMED. `Into<int32>` carries its
// argument window, and the trait declaration carries its parameter window; putting
// the two together is the binding every signature in the trait is read under.
//
// A NON-GENERIC TRAIT BINDS NOTHING, which is the empty scope rather than a
// special case — `params_count == 0` makes every lookup miss, which is exactly
// right for a trait that declares no parameters.
// A GENERIC TRAIT'S PARAMETERS, BOUND FROM AN INSTANCE OF IT. `Producer<int32>`
// means `T = int32` in everything `Producer` declares. Public since 1.0.6b: the
// impl check has always needed it, and so does a CALL through a bound, which
// reads the same trait declaration.
pub func:trait_binding = GenericScope(TypeResolver->:r, int32:trait_id) {
    int32:decl = raw type_decl_of(r.types, trait_id);
    if (decl == 0i32) { pass (raw generic_scope_none()); }
    DeclId:did = DeclId{ index: decl };
    DeclNode:td = relay ast_decl(r.ast, did);
    IdSpan:w = raw decl_generic_window(r.ast, td);
    GenericScope:g = GenericScope{
        params_start: w.start, params_count: w.count,
        args_start: raw type_args_start_of(r.types, trait_id),
        args_count: raw type_args_count_of(r.types, trait_id) };
    pass g;
};

// EQUAL AFTER SUBSTITUTING `Self`. Two function types are interned, so the common
// case is one integer compare; the walk exists only for the signatures that
// mention `Self`, where the trait's and the impl's are DIFFERENT interned types
// naming the same shape.
// WHAT ONE SIGNATURE COMPARISON NEEDS TO KNOW BESIDES THE TWO TYPES: which type
// `Self` stands for, which impl's assoc bindings apply, and the scope those
// bindings' annotations resolve in. Three values that always travel together,
// carried as one rather than as three parameters through four functions — the
// same shape `MethodFind` and `FnSig` use.
pub struct:SigCtx = {
    int32:target;
    int32:impl_decl;
    int32:scope;
};

func:same_signature = bool(TypeResolver->:r, int32:want, int32:got, SigCtx:sc) {
    if (want == got) { pass true; }
    if ((raw type_kind(r.types, want)) != (raw type_kind(r.types, got))) { pass false; }
    if (!(raw type_is_func(r.types, want))) { pass false; }

    // THE RETURN TYPE IS COMPARED THROUGH ITS `Result` WRAPPER, because the
    // wrapper is the LANGUAGE'S and not the author's. Every function returns
    // `Result<T>` (the one rule with no exceptions), so a trait's
    // `func:clone = Self(Self:self);` has the type `Result<Self>` and the impl's
    // has `Result<Point>` — and `Self` is then a level down, where the one-level
    // substitution below cannot see it.
    //
    // Found by the prelude's `Clone` (0.6.5), and it made EVERY trait method
    // returning `Self` unmatchable: the impl was reported as not having the
    // signature the trait declares, about two signatures that were identical.
    // `Self->` and `Self[]` are still refused, and that is a different case — those
    // wrappers are ones somebody wrote.
    if (!(relay same_return(r, raw type_elem(r.types, want),
                            raw type_elem(r.types, got), sc))) {
        pass false;
    }
    int32:n = raw type_param_count_of(r.types, want);
    if (n != (raw type_param_count_of(r.types, got))) { pass false; }
    int32:i = 0i32;
    while (i < n) {
        int32:a = raw type_param_at_of(r.ast, r.types, want, i);
        int32:b = raw type_param_at_of(r.ast, r.types, got, i);
        if (!(relay same_after_self(r, a, b, sc))) { pass false; }
        i = i + 1i32;
    }
    pass true;
};

// ONE LEVEL OF SUBSTITUTION, and one level is what the language can express:
// `Self` is a whole type where it appears, and `Self->` or `Self[]` would need the
// substitution to rebuild the wrapper around it. Those are refused rather than
// silently mismatched, because a trait method taking `Self->` is a shape somebody
// meant and a diagnostic saying the signature disagrees would send them looking at
// the wrong thing.
func:same_return = bool(TypeResolver->:r, int32:want, int32:got, SigCtx:sc) {
    if (want == got) { pass true; }
    if ((raw type_kind(r.types, want)) == (raw TY_RESULT())) {
        if ((raw type_kind(r.types, got)) == (raw TY_RESULT())) {
            pass (relay same_after_self(r, raw type_elem(r.types, want),
                                        raw type_elem(r.types, got), sc));
        }
    }
    pass (relay same_after_self(r, want, got, sc));
};

func:same_after_self = bool(TypeResolver->:r, int32:want, int32:got,
                            SigCtx:sc) {
    if (want == got) { pass true; }
    if ((raw type_kind(r.types, want)) == (raw TY_SELF())) {
        pass (got == sc.target);
    }
    // AN ASSOCIATED TYPE SUBSTITUTES TO THIS IMPL'S BINDING (D-160), which is
    // the same one level `Self` gets and for the same reason: `Item` is a whole
    // type where it appears, and `Item->` or `Item[]` would need the
    // substitution to rebuild the wrapper. Those stay refused rather than
    // silently mismatched.
    if ((raw type_kind(r.types, want)) == (raw TY_ASSOC())) {
        int32:bound = relay assoc_binding(r, sc,
                          raw type_assoc_trait(r.types, want),
                          raw type_assoc_name(r.types, want));
        // NO BINDING IS ALREADY REPORTED, and reporting it again here would be
        // one mistake described twice — the second time as a signature
        // mismatch, which sends the reader to the method rather than to the
        // `assoc:Item = …;` they omitted. The completeness walk above refuses a
        // required assoc the impl does not bind, and that is exactly the case
        // that reaches this branch with 0, so the impl is refused either way and
        // only a misleading second line is dropped. Same judgment as D-157's
        // rules 1 and 2, which do not both fire for one mistake.
        if (bound == 0i32) { pass true; }
        pass (got == bound);
    }
    pass false;
};

// WHAT THIS IMPL BINDS `name` TO, or the trait's DEFAULT, or 0 (D-160). An impl
// that omits a binding inherits the trait's — D-028's surviving half — and one
// that omits a binding the trait gave no default for is an incomplete impl,
// which the caller reports as the signature mismatch it causes.
// WHAT THE IMPL OF `trait_decl` FOR `base` BINDS `name` TO, or 0 (D-164).
//
// Coherence makes (type, trait) unique program-wide (§4.1, and 1.0.4c refuses
// the overlaps), so the first match is the only one. The impl's OWN scope is
// used to resolve the binding's annotation — an impl carries it for exactly this
// reason, and a single scope passed in would resolve one module's impls against
// another module's names, which is not an error but a different answer.
//
// A NULL TABLE ANSWERS 0. The backend substitutes with no impl table, because by
// then every assoc a valid program can contain has been normalised; one that
// survives to lowering means the frontend missed it, and `ll_type` fails closed
// on it — which is the answer wanted there, not a substitution that papers over
// it.
pub func:assoc_binding_of = int32(TypeResolver->:r, wild ImplTable->:t,
                                  int32:base, int32:trait_decl, int32:name) {
    if (t == NULL)        { pass 0i32; }
    if (base == 0i32)     { pass 0i32; }
    if (trait_decl == 0i32) { pass 0i32; }
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (!e.blanket) {
            if (e.target == base) {
                if ((raw type_decl_of(r.types, e.trait_id)) == trait_decl) {
                    SigCtx:sc = SigCtx{ target: base, impl_decl: e.decl,
                                        scope: e.scope };
                    pass (relay assoc_binding(r, sc, trait_decl, name));
                }
            }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

pub func:assoc_binding = int32(TypeResolver->:r, SigCtx:sc,
                               int32:trait_decl, int32:name) {
    if (sc.impl_decl != 0i32) {
        DeclNode:id = relay ast_decl(r.ast, DeclId{ index: sc.impl_decl });
        int32:i = 0i32;
        while (i < (raw impl_member_count(r.ast, id))) {
            DeclNode:m = relay ast_decl(r.ast, raw impl_member(r.ast, id, i));
            if (m.kind == DeclKind.DeclAssocTypeDecl) {
                if ((raw decl_name(m)) == name) {
                    TypeId:b = raw assoc_default(m);
                    if (!(raw type_is_none(b))) {
                        pass (relay resolve_type(r, b, sc.scope));
                    }
                }
            }
            i = i + 1i32;
        }
    }
    // THE TRAIT'S DEFAULT, inherited by any impl that omits the binding.
    if (trait_decl != 0i32) {
        DeclNode:td = relay ast_decl(r.ast, DeclId{ index: trait_decl });
        int32:k = 0i32;
        while (k < (raw item_member_count(r.ast, td))) {
            DeclNode:m2 = relay ast_decl(r.ast, raw item_member(r.ast, td, k));
            if (m2.kind == DeclKind.DeclAssocTypeDecl) {
                if ((raw decl_name(m2)) == name) {
                    TypeId:d2 = raw assoc_default(m2);
                    if (!(raw type_is_none(d2))) {
                        pass (relay resolve_type(r, d2, sc.scope));
                    }
                }
            }
            k = k + 1i32;
        }
    }
    pass 0i32;
};

// --- `dyn` assignment (TRAITS_REFERENCE 5.2, 5.3) ----------------------------------------

// DOES `target` IMPLEMENT `trait_id`? ONE QUESTION, ONE ANSWER, THREE SOURCES.
//
// The three were two functions with the third missing entirely, which is how a
// blanket impl could be recorded and satisfy nothing:
//
//   * A CONCRETE IMPL. The table is the only place that knows — an impl declares
//     nothing at module scope, so there is no symbol to ask.
//   * A PARAMETER'S DECLARED BOUNDS. `T` is a type that does not exist yet, so
//     the impl table holds nothing about it and its bound list is everything
//     known (D-107).
//   * A BLANKET IMPL whose bound `target` satisfies (§2.6). This is what makes a
//     blanket impl mean anything: without it the impl is recorded, its methods
//     are unreachable, and every `dyn` and every bound behaves as though it were
//     not written.
//
// FUEL, because the third case asks the same question again: a blanket impl's
// bound may itself be satisfied by another blanket impl, and a program can write
// that chain.
pub func:IMPL_FUEL = int32() { pass 64i32; };

pub func:type_implements = bool(ImplTable->:t, BoundTable->:bt, Ast->:ast,
                                TypeTable->:types, int32:target, int32:trait_id,
                                int32:fuel) {
    if (fuel <= 0i32) { pass false; }

    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (!e.blanket) {
            if (e.target == target) {
                if (e.trait_id == trait_id) { pass true; }
            }
        }
        i = i + 1i32;
    }

    if ((raw type_kind(types, target)) == (raw TY_PARAM())) {
        pass (relay param_declares(bt, raw type_decl_of(types, target),
                                   trait_id, ast));
    }

    int32:j = 0i32;
    while (j < t.count) {
        ImplEntry:e = relay impl_at(t, j);
        if (e.blanket) {
            if (e.trait_id == trait_id) {
                if (relay blanket_applies(t, bt, ast, types, e, target, fuel)) {
                    pass true;
                }
            }
        }
        j = j + 1i32;
    }
    pass false;
};

// DOES THIS BLANKET IMPL REACH THIS TYPE? Its target is the parameter it
// declared, so what has to be satisfied is that parameter's bounds — every one of
// them, since `<T: A & B>` means both.
//
// A BLANKET IMPL DOES NOT APPLY TO ITSELF. Its own parameter is the target inside
// the block, and letting the impl satisfy the bound that admits it would make
// `impl:<T: Loggable>:Loggable` true of everything by circular reasoning.
pub func:blanket_applies = bool(ImplTable->:t, BoundTable->:bt, Ast->:ast,
                                TypeTable->:types, ImplEntry:e, int32:target,
                                int32:fuel) {
    if (target == e.target) { pass false; }
    BoundEntry:b = relay bound_entry_of(bt, raw type_decl_of(types, e.target));
    int32:i = 0i32;
    while (i < b.count) {
        int32:need = relay ast_id_at(ast, b.start, i);
        if (!(relay type_implements(t, bt, ast, types, target, need, fuel - 1i32))) {
            pass false;
        }
        i = i + 1i32;
    }
    pass true;
};

// MAY A VALUE OF TYPE `got` BE STORED IN A `dyn` SLOT? Two cases, and the second
// is the one §5.3 is about.
//
//   * A CONCRETE TYPE must implement every trait the `dyn` names. `dyn A & B`
//     is a fat pointer with one vtable per trait, and a type implementing only
//     `A` has nothing to put in the second slot.
//   * ANOTHER `dyn` may WIDEN BY DROPPING BOUNDS — `dyn A & B` is assignable to
//     `dyn A`. Every trait the destination names must be one the source already
//     carries; the reverse would be inventing a vtable that was never built.
pub func:dyn_accepts = bool(ImplTable->:t, BoundTable->:bt, Ast->:ast,
                            TypeTable->:types, int32:want, int32:got) {
    int32:n = raw type_dyn_count(types, want);
    int32:start = raw type_dyn_start(types, want);
    bool:from_dyn = ((raw type_kind(types, got)) == (raw TY_DYN()));

    int32:i = 0i32;
    while (i < n) {
        int32:need = raw ast_id_at(ast, start, i);
        if (from_dyn) {
            if (!(relay dyn_carries(ast, types, got, need))) { pass false; }
        } else {
            if (!(relay type_implements(t, bt, ast, types, got, need,
                                        raw IMPL_FUEL()))) { pass false; }
        }
        i = i + 1i32;
    }
    pass true;
};

func:dyn_carries = bool(Ast->:ast, TypeTable->:types, int32:d, int32:trait_id) {
    int32:n = raw type_dyn_count(types, d);
    int32:start = raw type_dyn_start(types, d);
    int32:i = 0i32;
    while (i < n) {
        if ((raw ast_id_at(ast, start, i)) == trait_id) { pass true; }
        i = i + 1i32;
    }
    pass false;
};

// --- supertraits (TRAITS_REFERENCE 2.2, D-029) -------------------------------------------

// `trait:Ordered = Equatable & { … };` — implementing `Ordered` requires an
// implementation of `Equatable` too, and **transitively**: if `C` requires `B`
// and `B` requires `A`, implementing `C` requires all three.
//
// The supertraits parsed and were stored from cycle 0.2 and NOTHING READ THEM.
// A trait could name a struct as a supertrait, and a type could implement a trait
// while satisfying none of what that trait was declared to build on — which is
// the whole content of the feature.
//
// FUEL BOUNDS THE WALK. Supertraits are a graph a program writes, so
// `trait:A = B & {…}; trait:B = A & {…};` is a cycle somebody can type, and a
// recursive walk over it does not return. The cycle is a real error and belongs
// to whoever owns trait declaration checking; what matters here is that the
// checker does not hang before reporting anything, so the depth is capped and the
// cap is stated rather than assumed unreachable.
func:SUPER_FUEL = int32() { pass 64i32; };

// A BLANKET IMPL CARRIES ITS SUPERTRAIT REQUIREMENT TOO, and it lands on the
// PARAMETER: `impl:<T: Printable>:Ordered` where `Ordered` requires `Equatable`
// needs `T` to declare `Equatable`, which `type_implements` answers from the
// bound list. Skipping blanket impls made that requirement unenforced.
pub func:check_supertraits = NIL(ImplTable->:t, BoundTable->:bt,
                                 TypeResolver->:r) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (e.trait_id != 0i32) {
            drop require_supers(t, bt, r, e, e.trait_id, e.scope,
                                raw SUPER_FUEL());
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:require_supers = NIL(ImplTable->:t, BoundTable->:bt, TypeResolver->:r,
                          ImplEntry:e, int32:trait_id, int32:scope, int32:fuel) {
    if (fuel <= 0i32) { pass NIL; }
    int32:decl = raw type_decl_of(r.types, trait_id);
    if (decl == 0i32) { pass NIL; }
    DeclId:did = DeclId{ index: decl };
    DeclNode:td = relay ast_decl(r.ast, did);

    int32:n = raw item_extra_count(r.ast, td);
    int32:i = 0i32;
    while (i < n) {
        int32:sup = relay resolve_type(r, relay item_extra(r.ast, td, i), scope);
        if (sup != 0i32) {
            if (!(raw type_is_invalid(r.types, sup))) {
                if ((raw type_kind(r.types, sup)) != (raw TY_TRAIT())) {
                    drop super_not_trait(r, trait_id, sup, td.span);
                } else {
                    if (!(relay type_implements(t, bt, r.ast, r.types, e.target,
                                                sup, raw IMPL_FUEL()))) {
                        drop super_missing(r, e, trait_id, sup);
                    }
                    // TRANSITIVE (2.2). `C` requiring `B` requiring `A` requires
                    // all three, and the requirement is on the IMPLEMENTING TYPE
                    // rather than on the intermediate trait — so the walk carries
                    // `e` down rather than restarting from `sup`.
                    drop require_supers(t, bt, r, e, sup, scope, fuel - 1i32);
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:super_not_trait = NIL(TypeResolver->:r, int32:trait_id, int32:sup, Span:at) {
    string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, sup));
    string:m2 = relay string_concat(m1, "` is not a trait, so `");
    string:m3 = relay string_concat(m2, relay type_display(r.types, r.interns, trait_id));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(),
        relay string_concat(m3, "` cannot require it; a supertrait clause names traits"),
        at));
    pass NIL;
};

func:super_missing = NIL(TypeResolver->:r, ImplEntry:e, int32:trait_id, int32:sup) {
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:idl = relay ast_decl(r.ast, iid);
    string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, trait_id));
    string:m2 = relay string_concat(m1, "` requires `");
    string:m3 = relay string_concat(m2, relay type_display(r.types, r.interns, sup));
    string:m4 = relay string_concat(m3, "`, and `");
    string:m5 = relay string_concat(m4, relay type_display(r.types, r.interns, e.target));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5, "` does not implement it"), idl.span));
    pass NIL;
};

// --- one method per name (D-106) ---------------------------------------------------------

// TWO INHERENT IMPLS ARE LEGAL AND THE SAME METHOD TWICE IS NOT. Coherence (4.1)
// governs traits, so splitting a type's methods across two `impl:Point = { … };`
// blocks is a formatting choice and deliberately allowed — which leaves the
// duplicate-NAME question with nothing answering it. `find_method` returned the
// first match and the second was unreachable: a method somebody wrote, that
// nothing could ever call, with no diagnostic saying so.
//
// TWO NAMESPACES, and the difference is not cosmetic:
//
//   * A TYPE'S INHERENT METHODS are one namespace across every inherent block, so
//     `scaled` in two of them is one name declared twice.
//   * EACH TRAIT IMPL IS ITS OWN. `Point` implementing both `Ta::tag` and
//     `Tb::tag` is legal — the trait qualifies the name, and D-102 already
//     reports the ambiguity at the CALL, where the reader can act on it.
//
// Inside ONE block a repeat is always wrong, whichever kind of block it is.
pub func:check_duplicate_methods = NIL(ImplTable->:t, TypeResolver->:r) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:a = relay impl_at(t, i);
        // INSIDE ONE BLOCK A REPEAT IS ALWAYS WRONG, and a blanket impl's block is
        // a block. It was skipped along with everything else that read a target.
        drop dup_within(r, a);
        // …and against every LATER inherent impl on the same type. Later rather
        // than all, so one duplicate is reported once. A blanket impl is never
        // inherent (it must name a trait), so it does not reach this.
        if (a.trait_id == 0i32) {
            int32:j = i + 1i32;
            while (j < t.count) {
                ImplEntry:b = relay impl_at(t, j);
                if (b.trait_id == 0i32) {
                    if (b.target == a.target) {
                        drop dup_across(r, a, b);
                    }
                }
                j = j + 1i32;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:dup_within = NIL(TypeResolver->:r, ImplEntry:e) {
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:d = relay ast_decl(r.ast, iid);
    int32:n = relay impl_member_count(r.ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:aid = relay impl_member(r.ast, d, i);
        DeclNode:am = relay ast_decl(r.ast, aid);
        if (am.kind == DeclKind.DeclFunctionDecl) {
            int32:j = i + 1i32;
            while (j < n) {
                DeclId:bid = relay impl_member(r.ast, d, j);
                DeclNode:bm = relay ast_decl(r.ast, bid);
                if (bm.kind == DeclKind.DeclFunctionDecl) {
                    if ((raw decl_name(bm)) == (raw decl_name(am))) {
                        drop dup_error(r, e, am, bm);
                    }
                }
                j = j + 1i32;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:dup_across = NIL(TypeResolver->:r, ImplEntry:first, ImplEntry:second) {
    DeclId:fid = DeclId{ index: first.decl };
    DeclNode:first_block = relay ast_decl(r.ast, fid);
    DeclId:sid = DeclId{ index: second.decl };
    DeclNode:second_block = relay ast_decl(r.ast, sid);

    int32:n = relay impl_member_count(r.ast, first_block);
    int32:i = 0i32;
    while (i < n) {
        DeclId:aid = relay impl_member(r.ast, first_block, i);
        DeclNode:am = relay ast_decl(r.ast, aid);
        if (am.kind == DeclKind.DeclFunctionDecl) {
            int32:other = relay impl_member_named(r.ast, second_block, raw decl_name(am),
                                                  DeclKind.DeclFunctionDecl);
            if (other != 0i32) {
                DeclId:oid = DeclId{ index: other };
                DeclNode:om = relay ast_decl(r.ast, oid);
                drop dup_error(r, first, am, om);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// The SECOND declaration carries the span and the first one's line is named, the
// same shape the coherence diagnostic uses — a reader told only that something is
// duplicated has to go and find the other one.
func:dup_error = NIL(TypeResolver->:r, ImplEntry:e, DeclNode:first,
                     DeclNode:second) {
    string:m1 = relay string_concat("`",
                    relay intern_get(r.interns, raw decl_name(second)));
    string:m2 = relay string_concat(m1, "` is already a method of `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, e.target));
    string:m4 = relay string_concat(m3, "`, declared at line ");
    string:m5 = relay string_concat(m4, raw int_to_string(first.span.line => int64));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5,
            "; two inherent blocks are one namespace, so a name may be declared in only one of them"),
        second.span));
    pass NIL;
};
