// Traits and implementations.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.6.
//
// `impl` BLOCKS DECLARE NOTHING AT MODULE SCOPE, and 0.3.1 said so in a comment:
// "Its methods are reached through the type, which needs the type to exist first
// -- so they are collected in cycle 0.4 where coherence is decided, not here."
// This is that cycle, and this is the table it meant.
//
// The consequence of not having had one is worth stating plainly, because it made
// a passing test in 0.4.5 mean less than it looked like it meant: `type_method_call`
// resolves a method by ORDINARY SCOPE LOOKUP, so `p.magnitude()` only ever found a
// module-level free function. The 0.4.5 fixture declared `func:magnitude` at
// module scope and UFCS resolved it, exactly as designed -- but a `magnitude`
// written where the spec puts it, inside `impl:Point`, was invisible. Nothing in
// the language could call a method declared in an impl.
//
// THE TABLE IS BUILT ONCE PER MODULE and answers three questions that all need
// the same walk: which impls exist (coherence), what methods a type has (UFCS),
// and what a trait requires of them (completeness).

use "source_location.npk".*;
use "intern.npk".*;
use "token_kind.npk".*;
use "ast_kind.npk".*;
use "ast.npk".*;
use "diagnostics.npk".*;
use "type_codes.npk".*;
use "types.npk".*;
use "type_names.npk".*;
use "parse_decl.npk".*;
use "parse_type.npk".*;
use "symbols.npk".*;
use "resolve_type.npk".*;
use "type_decl.npk".*;

// One `impl` block. The TARGET IS ALWAYS SLOT ONE (D-031), with or without a
// trait, so `inherent` is `trait_id == 0` rather than a different shape.
pub struct:ImplEntry = {
    int32:target;     // the type being implemented on, or 0 for a blanket impl
    int32:trait_id;   // the trait, or 0 for an inherent impl
    int32:decl;       // the `ImplDecl` node index
    bool:blanket;     // `impl:<T: Bound>:Trait` — the target is a parameter
};

pub struct:ImplTable = {
    wild ImplEntry->:items;
    int32:count;
    int32:cap;
};

pub func:impltable_init = ImplTable() {
    int64:n = 16i64;
    wild int8->:mem = alloc(n * #size_of<ImplEntry>());
    ImplTable:t = ImplTable{ items: mem => wild ImplEntry->,
                             count: 0i32, cap: 16i32 };
    pass t;
};

func:impl_grow = NIL(ImplTable->:t) {
    int32:nc = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items => wild int8->,
                                (nc => int64) * #size_of<ImplEntry>());
    t.items = bigger => wild ImplEntry->;
    t.cap = nc;
    pass NIL;
};

pub func:impl_count = int32(ImplTable->:t) { pass t.count; };

pub func:impl_at = ImplEntry(ImplTable->:t, int32:i) {
    if (i < 0i32) { fail 21i32; }
    if (i >= t.count) { fail 21i32; }
    pass (t.items[i => int64]);
};

func:impl_push = NIL(ImplTable->:t, int32:target, int32:trait_id, int32:decl,
                     bool:blanket) {
    if (t.count >= t.cap) { drop impl_grow(t); }
    ImplEntry:e = ImplEntry{ target: target, trait_id: trait_id, decl: decl,
                             blanket: blanket };
    t.items[t.count => int64] = e;
    t.count = t.count + 1i32;
    pass NIL;
};

// --- building ----------------------------------------------------------------------------

// Walk a module's declarations and record every `impl`. The target and the trait
// are RESOLVED HERE rather than at each use, so that two impls on the same type
// compare as one integer and coherence does not depend on how the annotation was
// spelled -- `Point` and an alias for it are the same interned type (D-090).
pub func:collect_impls = NIL(ImplTable->:t, TypeResolver->:r, DeclId:mod_id,
                             int32:scope) {
    DeclNode:m = relay ast_decl(r.ast, mod_id);
    int32:n = raw item_member_count(r.ast, m);
    int32:i = 0i32;
    while (i < n) {
        DeclId:id = raw item_member(r.ast, m, i);
        DeclNode:d = relay ast_decl(r.ast, id);
        if (d.kind == DeclKind.DeclImplDecl) {
            drop collect_one_impl(t, r, id, d, scope);
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:collect_one_impl = NIL(ImplTable->:t, TypeResolver->:r, DeclId:id,
                            DeclNode:d, int32:scope) {
    // A BLANKET IMPL HAS NO CONCRETE TARGET TO RESOLVE (D-105). Its target names
    // a parameter it declared itself, which lives in the scope `resolve.npk`
    // opened for the block — not in this one — and what it stands for is decided
    // per instantiation.
    //
    // It is RECORDED AND NOT CHECKED at this rung, and that is a schedule rather
    // than a silence: 0.4.7 owns bound satisfaction and monomorphization, and
    // every question about a blanket impl — which types it applies to, whether a
    // concrete impl outranks it (2.6), what `Self` substitutes to — is one of
    // those. Recording it now is what lets 0.4.7 find them.
    if (relay impl_is_blanket(r.ast, d)) {
        int32:bt = 0i32;
        TypeId:btt = relay impl_trait(r.ast, d);
        if (!(raw type_is_none(btt))) {
            bt = relay resolve_type(r, btt, scope);
        }
        drop impl_push(t, 0i32, bt, id.index, true);
        pass NIL;
    }

    int32:target = relay resolve_type(r, relay impl_target(r.ast, d), scope);
    if (target == 0i32) { pass NIL; }
    if (raw type_is_invalid(r.types, target)) { pass NIL; }

    TypeId:tt = relay impl_trait(r.ast, d);
    if (raw type_is_none(tt)) {
        drop impl_push(t, target, 0i32, id.index, false);
        pass NIL;
    }

    int32:trait_id = relay resolve_type(r, tt, scope);
    if (trait_id == 0i32) { pass NIL; }
    if (raw type_is_invalid(r.types, trait_id)) { pass NIL; }

    // `impl:Point:Point` — THE SECOND SEGMENT IS A TRAIT AND NOTHING ELSE. It
    // resolves as a type like any other, so a struct name lands here perfectly
    // well-formed and means nothing; saying which segment is wrong is the whole
    // value of the diagnostic, since the two are one character apart.
    if ((raw type_kind(r.types, trait_id)) != (raw TY_TRAIT())) {
        string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, trait_id));
        string:m2 = relay string_concat(m1,
            "` is not a trait, so it cannot be implemented; in `impl:Type:Trait` the type comes first (D-031)");
        drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(), m2, d.span));
        pass NIL;
    }
    drop impl_push(t, target, trait_id, id.index, false);
    pass NIL;
};

// --- coherence (TRAITS_REFERENCE 4.1) ----------------------------------------------------

// AT MOST ONE IMPLEMENTATION OF A TRAIT FOR A TYPE. Two is not an ambiguity the
// compiler could resolve by a rule -- there is no rule that would not be a
// silent choice between two things a programmer wrote on purpose.
//
// INHERENT IMPLS ARE NOT SUBJECT TO THIS. `impl:Point = { … };` twice is two
// groups of methods on one type, which is a formatting choice; what would be
// wrong is the same METHOD twice, and that is a duplicate-name question rather
// than a coherence one.
pub func:check_coherence = NIL(ImplTable->:t, TypeResolver->:r) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:a = relay impl_at(t, i);
        // A blanket impl overlaps a concrete one BY DESIGN — 2.6 says the
        // concrete one wins — so it is not a coherence conflict and cannot be
        // decided without bound satisfaction (0.4.7).
        if (a.blanket) { a.trait_id = 0i32; }
        if (a.trait_id != 0i32) {
            int32:j = i + 1i32;
            while (j < t.count) {
                ImplEntry:b = relay impl_at(t, j);
                if (b.trait_id == a.trait_id) {
                    if (b.target == a.target) {
                        drop coherence_error(r, a, b);
                    }
                }
                j = j + 1i32;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// BOTH IMPLS ARE NAMED, and the second one carries the span. "conflicting
// implementations" with one location makes the reader search for the other, which
// is the one thing the compiler already knows.
func:coherence_error = NIL(TypeResolver->:r, ImplEntry:first, ImplEntry:second) {
    DeclId:fid = DeclId{ index: first.decl };
    DeclNode:first_d = relay ast_decl(r.ast, fid);
    DeclId:sid = DeclId{ index: second.decl };
    DeclNode:second_d = relay ast_decl(r.ast, sid);

    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, second.trait_id));
    string:m2 = relay string_concat(m1, "` is already implemented for `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, second.target));
    string:m4 = relay string_concat(m3, "` at line ");
    string:m5 = relay string_concat(m4, raw int_to_string(first_d.span.line => int64));
    drop diaglist_push(r.diags,
        raw diag_error(raw TYPE_COHERENCE(), relay string_concat(m5,
            "; a trait has at most one implementation per type"), second_d.span));
    pass NIL;
};

// --- method lookup (UFCS, D-006) ---------------------------------------------------------

// WHETHER ONE WAS FOUND IS A SEPARATE ANSWER FROM WHICH ONE, and from whether the
// name was ambiguous. Three states, three fields -- the same `whether` versus
// `which` split that `NsAccess` and `expr_shape` were rebuilt around, applied
// before it could go wrong a fourth time.
pub struct:MethodFind = {
    bool:found;
    bool:ambiguous;
    int32:decl;        // the FunctionDecl's index
    int32:owner;       // the trait it came through, or 0 for an inherent method
    int32:other;       // the OTHER trait, when ambiguous
};

func:method_none = MethodFind() {
    MethodFind:m = MethodFind{ found: false, ambiguous: false,
                               decl: 0i32, owner: 0i32, other: 0i32 };
    pass m;
};

// A method on `target`, by name. Inherent first, then trait impls.
//
// INHERENT WINS, and it is not a tie-break invented here: TRAITS_REFERENCE 2.6
// settles the same question for blanket impls -- "concrete impls take priority" --
// and an inherent method is the most concrete thing there is. A type's own method
// is also the one its author wrote knowing the type, which is the reading a
// programmer would expect to hold.
//
// TWO TRAITS SUPPLYING ONE NAME IS AMBIGUOUS AND IS AN ERROR. Picking either
// would be a silent choice, and the spec gives no rule to pick by -- so the
// caller is told both, and disambiguates by calling the free-function form.
pub func:find_method = MethodFind(ImplTable->:t, Ast->:ast, InternTable->:interns,
                                  int32:target, int32:name) {
    MethodFind:best = raw method_none();
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (e.target == target) {
            int32:mdecl = relay impl_method_named(ast, interns, e.decl, name);
            if (mdecl != 0i32) {
                if (e.trait_id == 0i32) {
                    // An inherent method ends the search: nothing outranks it,
                    // and a second inherent one is a duplicate-name error that
                    // belongs to the declaration, not to this lookup.
                    MethodFind:m = MethodFind{ found: true, ambiguous: false,
                                               decl: mdecl, owner: 0i32, other: 0i32 };
                    pass m;
                }
                if (best.found) {
                    best.ambiguous = true;
                    best.other = e.trait_id;
                } else {
                    best.found = true;
                    best.decl = mdecl;
                    best.owner = e.trait_id;
                }
            }
        }
        i = i + 1i32;
    }
    pass best;
};

// A function member of one `impl` block, by name.
func:impl_method_named = int32(Ast->:ast, InternTable->:interns, int32:decl,
                               int32:name) {
    DeclId:id = DeclId{ index: decl };
    DeclNode:d = relay ast_decl(ast, id);
    int32:n = relay impl_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = relay impl_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

// --- what a trait requires of an impl (TRAITS_REFERENCE 2, 2.1, 2.3) ---------------------

// A TRAIT MEMBER IS REQUIRED OR IT IS DEFAULTED, and the AST already says which:
// a method with no body, and an `assoc` with no bound type. Both absences are
// real rather than a flag somebody has to set (`parse_decls.npk` says so of the
// method case: "A trait method has no body, and that is a real absence").
func:trait_method_required = bool(Ast->:ast, DeclNode:m) {
    pass (raw stmt_is_none(relay fn_body(ast, m)));
};

func:assoc_required = bool(DeclNode:m) {
    pass (raw type_is_none(raw assoc_default(m)));
};

// Every impl is checked against the trait it names. THREE QUESTIONS, and each is
// a different mistake with a different fix:
//
//   * a REQUIRED member is missing        -- the impl is incomplete
//   * a member the trait never declared   -- the impl invents surface
//   * a member whose SIGNATURE disagrees  -- the impl is not interchangeable
//
// The third is the one that would otherwise pass. An `impl` supplying
// `func:area = int32(Point:self)` where the trait declares `flt64(Self:self)` has
// every method the trait asked for and satisfies nothing: a caller holding a
// `dyn Sized` would call through a vtable slot typed one way and land in a body
// typed another. Checking names without checking shapes is checking the label.
pub func:check_impls_complete = NIL(ImplTable->:t, TypeResolver->:r, int32:scope) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (e.trait_id != 0i32) {
            if (!e.blanket) {
                drop check_one_impl_complete(r, e, scope);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:check_one_impl_complete = NIL(TypeResolver->:r, ImplEntry:e, int32:scope) {
    DeclId:trait_did = DeclId{ index: raw type_decl_of(r.types, e.trait_id) };
    DeclNode:td = relay ast_decl(r.ast, trait_did);
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:idl = relay ast_decl(r.ast, iid);

    // --- everything the trait requires is supplied --------------------------------
    int32:tn = raw item_member_count(r.ast, td);
    int32:i = 0i32;
    while (i < tn) {
        DeclId:mid = raw item_member(r.ast, td, i);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if (relay trait_method_required(r.ast, m)) {
                if ((relay impl_member_named(r.ast, idl, raw decl_name(m),
                                             DeclKind.DeclFunctionDecl)) == 0i32) {
                    drop missing_error(r, e, idl, m, "method");
                }
            }
        }
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            if (raw assoc_required(m)) {
                if ((relay impl_member_named(r.ast, idl, raw decl_name(m),
                                             DeclKind.DeclAssocTypeDecl)) == 0i32) {
                    drop missing_error(r, e, idl, m, "associated type");
                }
            }
        }
        i = i + 1i32;
    }

    // --- and nothing the trait did not declare ------------------------------------
    //
    // AN EXTRA METHOD IS NOT A HELPER. `impl:Point = { … };` is where a method
    // with no trait behind it belongs (2.4), and it is one line away -- so the
    // diagnostic points there rather than merely refusing.
    int32:inn = relay impl_member_count(r.ast, idl);
    int32:j = 0i32;
    while (j < inn) {
        DeclId:mid = relay impl_member(r.ast, idl, j);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            int32:decl_in_trait = relay trait_member_named(r.ast, td, raw decl_name(m),
                                                           DeclKind.DeclFunctionDecl);
            if (decl_in_trait == 0i32) {
                drop extra_error(r, e, m, "method");
            } else {
                drop check_signature(r, e, decl_in_trait, mid.index, m, scope);
            }
        }
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            if ((relay trait_member_named(r.ast, td, raw decl_name(m),
                                          DeclKind.DeclAssocTypeDecl)) == 0i32) {
                drop extra_error(r, e, m, "associated type");
            }
        }
        j = j + 1i32;
    }
    pass NIL;
};

// A member of an `impl` block by name AND KIND. The kind matters: a trait may
// declare `assoc:Item` and a method could be named `Item` too, and matching on
// the name alone would let one stand in for the other.
func:impl_member_named = int32(Ast->:ast, DeclNode:d, int32:name, DeclKind:kind) {
    int32:n = relay impl_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = relay impl_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == kind) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

func:trait_member_named = int32(Ast->:ast, DeclNode:d, int32:name, DeclKind:kind) {
    int32:n = raw item_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = raw item_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == kind) {
            if ((raw decl_name(m)) == name) { pass (mid.index); }
        }
        i = i + 1i32;
    }
    pass 0i32;
};

func:missing_error = NIL(TypeResolver->:r, ImplEntry:e, DeclNode:idl, DeclNode:m,
                         string:what) {
    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, e.trait_id));
    string:m2 = relay string_concat(m1, "` requires ");
    string:m3 = relay string_concat(m2, what);
    string:m4 = relay string_concat(m3, " `");
    string:m5 = relay string_concat(m4, relay intern_get(r.interns, raw decl_name(m)));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5, "`, and this impl does not supply it"), idl.span));
    pass NIL;
};

func:extra_error = NIL(TypeResolver->:r, ImplEntry:e, DeclNode:m, string:what) {
    string:m1 = relay string_concat("`",
                    relay intern_get(r.interns, raw decl_name(m)));
    string:m2 = relay string_concat(m1, "` is not ");
    string:m3 = relay string_concat(m2, relay a_or_an(what));
    string:m4 = relay string_concat(m3, " of `");
    string:m5 = relay string_concat(m4,
                    relay type_display(r.types, r.interns, e.trait_id));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5,
            "`; an inherent `impl:Type = { … };` is where a member with no trait behind it belongs"),
        m.span));
    pass NIL;
};

func:a_or_an = string(string:what) {
    if (raw string_eq(what, "associated type")) { pass "an associated type"; }
    pass "a method";
};

// --- signatures must match (TRAITS_REFERENCE 2) ------------------------------------------

// THE TRAIT'S SIGNATURE IS RESOLVED WITH `Self` AS A PLACEHOLDER; the impl's is
// resolved with `Self` AS THE TARGET. Comparing them therefore means substituting
// one for the other, and the substitution is the whole reason `Self` needed a type
// of its own rather than being an error everywhere (D-103).
//
// `r.self_type` is SAVED AND RESTORED around each resolution. It is state on the
// resolver rather than a parameter for the same reason `e.expected` is: it is
// constant across one signature and a nested construct restores it. Leaking it
// would make the next impl's `Self` mean this impl's target.
func:check_signature = NIL(TypeResolver->:r, ImplEntry:e, int32:trait_fn,
                           int32:impl_fn, DeclNode:im, int32:scope) {
    int32:saved = r.self_type;

    DeclId:tfid = DeclId{ index: trait_fn };
    DeclNode:tf = relay ast_decl(r.ast, tfid);
    r.self_type = raw tt_self(r.types);
    int32:want = relay fn_type(r, tf, raw decl_name(tf), scope);

    DeclId:ifid = DeclId{ index: impl_fn };
    DeclNode:f = relay ast_decl(r.ast, ifid);
    r.self_type = e.target;
    int32:got = relay fn_type(r, f, raw decl_name(f), scope);

    r.self_type = saved;

    if (want == 0i32) { pass NIL; }
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(r.types, want)) { pass NIL; }
    if (raw type_is_invalid(r.types, got)) { pass NIL; }
    if (relay same_signature(r, want, got, e.target)) { pass NIL; }

    string:m1 = relay string_concat("`",
                    relay intern_get(r.interns, raw decl_name(f)));
    string:m2 = relay string_concat(m1, "` does not have the signature `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, e.trait_id));
    string:m4 = relay string_concat(m3, "` declares for it");
    drop diaglist_push(r.diags,
        raw diag_error(raw TYPE_IMPL_INCOMPLETE(), m4, im.span));
    pass NIL;
};

// EQUAL AFTER SUBSTITUTING `Self`. Two function types are interned, so the common
// case is one integer compare; the walk exists only for the signatures that
// mention `Self`, where the trait's and the impl's are DIFFERENT interned types
// naming the same shape.
func:same_signature = bool(TypeResolver->:r, int32:want, int32:got, int32:target) {
    if (want == got) { pass true; }
    if ((raw type_kind(r.types, want)) != (raw type_kind(r.types, got))) { pass false; }
    if (!(raw type_is_func(r.types, want))) { pass false; }

    if (!(relay same_after_self(r, raw type_elem(r.types, want),
                                raw type_elem(r.types, got), target))) {
        pass false;
    }
    int32:n = raw type_param_count_of(r.types, want);
    if (n != (raw type_param_count_of(r.types, got))) { pass false; }
    int32:i = 0i32;
    while (i < n) {
        int32:a = raw type_param_at_of(r.ast, r.types, want, i);
        int32:b = raw type_param_at_of(r.ast, r.types, got, i);
        if (!(relay same_after_self(r, a, b, target))) { pass false; }
        i = i + 1i32;
    }
    pass true;
};

// ONE LEVEL OF SUBSTITUTION, and one level is what the language can express:
// `Self` is a whole type where it appears, and `Self->` or `Self[]` would need the
// substitution to rebuild the wrapper around it. Those are refused rather than
// silently mismatched, because a trait method taking `Self->` is a shape somebody
// meant and a diagnostic saying the signature disagrees would send them looking at
// the wrong thing.
func:same_after_self = bool(TypeResolver->:r, int32:want, int32:got, int32:target) {
    if (want == got) { pass true; }
    if ((raw type_kind(r.types, want)) == (raw TY_SELF())) {
        pass (got == target);
    }
    pass false;
};

// --- `dyn` assignment (TRAITS_REFERENCE 5.2, 5.3) ----------------------------------------

// DOES `target` IMPLEMENT `trait_id`? A table scan, and the table is the only
// place that knows — an impl declares nothing at module scope, so there is no
// symbol to ask.
pub func:type_implements = bool(ImplTable->:t, int32:target, int32:trait_id) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (e.target == target) {
            if (e.trait_id == trait_id) { pass true; }
        }
        i = i + 1i32;
    }
    pass false;
};

// MAY A VALUE OF TYPE `got` BE STORED IN A `dyn` SLOT? Two cases, and the second
// is the one §5.3 is about.
//
//   * A CONCRETE TYPE must implement every trait the `dyn` names. `dyn A & B`
//     is a fat pointer with one vtable per trait, and a type implementing only
//     `A` has nothing to put in the second slot.
//   * ANOTHER `dyn` may WIDEN BY DROPPING BOUNDS — `dyn A & B` is assignable to
//     `dyn A`. Every trait the destination names must be one the source already
//     carries; the reverse would be inventing a vtable that was never built.
pub func:dyn_accepts = bool(ImplTable->:t, Ast->:ast, TypeTable->:types,
                            int32:want, int32:got) {
    int32:n = raw type_dyn_count(types, want);
    int32:start = raw type_dyn_start(types, want);
    bool:from_dyn = ((raw type_kind(types, got)) == (raw TY_DYN()));

    int32:i = 0i32;
    while (i < n) {
        int32:need = raw ast_id_at(ast, start, i);
        if (from_dyn) {
            if (!(relay dyn_carries(ast, types, got, need))) { pass false; }
        } else {
            if (!(relay type_implements(t, got, need))) { pass false; }
        }
        i = i + 1i32;
    }
    pass true;
};

func:dyn_carries = bool(Ast->:ast, TypeTable->:types, int32:d, int32:trait_id) {
    int32:n = raw type_dyn_count(types, d);
    int32:start = raw type_dyn_start(types, d);
    int32:i = 0i32;
    while (i < n) {
        if ((raw ast_id_at(ast, start, i)) == trait_id) { pass true; }
        i = i + 1i32;
    }
    pass false;
};

// --- supertraits (TRAITS_REFERENCE 2.2, D-029) -------------------------------------------

// `trait:Ordered = Equatable & { … };` — implementing `Ordered` requires an
// implementation of `Equatable` too, and **transitively**: if `C` requires `B`
// and `B` requires `A`, implementing `C` requires all three.
//
// The supertraits parsed and were stored from cycle 0.2 and NOTHING READ THEM.
// A trait could name a struct as a supertrait, and a type could implement a trait
// while satisfying none of what that trait was declared to build on — which is
// the whole content of the feature.
//
// FUEL BOUNDS THE WALK. Supertraits are a graph a program writes, so
// `trait:A = B & {…}; trait:B = A & {…};` is a cycle somebody can type, and a
// recursive walk over it does not return. The cycle is a real error and belongs
// to whoever owns trait declaration checking; what matters here is that the
// checker does not hang before reporting anything, so the depth is capped and the
// cap is stated rather than assumed unreachable.
func:SUPER_FUEL = int32() { pass 64i32; };

pub func:check_supertraits = NIL(ImplTable->:t, TypeResolver->:r, int32:scope) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:e = relay impl_at(t, i);
        if (e.trait_id != 0i32) {
            if (!e.blanket) {
                drop require_supers(t, r, e, e.trait_id, scope, raw SUPER_FUEL());
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:require_supers = NIL(ImplTable->:t, TypeResolver->:r, ImplEntry:e,
                          int32:trait_id, int32:scope, int32:fuel) {
    if (fuel <= 0i32) { pass NIL; }
    int32:decl = raw type_decl_of(r.types, trait_id);
    if (decl == 0i32) { pass NIL; }
    DeclId:did = DeclId{ index: decl };
    DeclNode:td = relay ast_decl(r.ast, did);

    int32:n = raw item_extra_count(r.ast, td);
    int32:i = 0i32;
    while (i < n) {
        int32:sup = relay resolve_type(r, relay item_extra(r.ast, td, i), scope);
        if (sup != 0i32) {
            if (!(raw type_is_invalid(r.types, sup))) {
                if ((raw type_kind(r.types, sup)) != (raw TY_TRAIT())) {
                    drop super_not_trait(r, trait_id, sup, td.span);
                } else {
                    if (!(raw type_implements(t, e.target, sup))) {
                        drop super_missing(r, e, trait_id, sup);
                    }
                    // TRANSITIVE (2.2). `C` requiring `B` requiring `A` requires
                    // all three, and the requirement is on the IMPLEMENTING TYPE
                    // rather than on the intermediate trait — so the walk carries
                    // `e` down rather than restarting from `sup`.
                    drop require_supers(t, r, e, sup, scope, fuel - 1i32);
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:super_not_trait = NIL(TypeResolver->:r, int32:trait_id, int32:sup, Span:at) {
    string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, sup));
    string:m2 = relay string_concat(m1, "` is not a trait, so `");
    string:m3 = relay string_concat(m2, relay type_display(r.types, r.interns, trait_id));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_A_TRAIT(),
        relay string_concat(m3, "` cannot require it; a supertrait clause names traits"),
        at));
    pass NIL;
};

func:super_missing = NIL(TypeResolver->:r, ImplEntry:e, int32:trait_id, int32:sup) {
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:idl = relay ast_decl(r.ast, iid);
    string:m1 = relay string_concat("`", relay type_display(r.types, r.interns, trait_id));
    string:m2 = relay string_concat(m1, "` requires `");
    string:m3 = relay string_concat(m2, relay type_display(r.types, r.interns, sup));
    string:m4 = relay string_concat(m3, "`, and `");
    string:m5 = relay string_concat(m4, relay type_display(r.types, r.interns, e.target));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5, "` does not implement it"), idl.span));
    pass NIL;
};

// --- one method per name (D-106) ---------------------------------------------------------

// TWO INHERENT IMPLS ARE LEGAL AND THE SAME METHOD TWICE IS NOT. Coherence (4.1)
// governs traits, so splitting a type's methods across two `impl:Point = { … };`
// blocks is a formatting choice and deliberately allowed — which leaves the
// duplicate-NAME question with nothing answering it. `find_method` returned the
// first match and the second was unreachable: a method somebody wrote, that
// nothing could ever call, with no diagnostic saying so.
//
// TWO NAMESPACES, and the difference is not cosmetic:
//
//   * A TYPE'S INHERENT METHODS are one namespace across every inherent block, so
//     `scaled` in two of them is one name declared twice.
//   * EACH TRAIT IMPL IS ITS OWN. `Point` implementing both `Ta::tag` and
//     `Tb::tag` is legal — the trait qualifies the name, and D-102 already
//     reports the ambiguity at the CALL, where the reader can act on it.
//
// Inside ONE block a repeat is always wrong, whichever kind of block it is.
pub func:check_duplicate_methods = NIL(ImplTable->:t, TypeResolver->:r) {
    int32:i = 0i32;
    while (i < t.count) {
        ImplEntry:a = relay impl_at(t, i);
        if (!a.blanket) {
            drop dup_within(r, a);
            // …and against every LATER inherent impl on the same type. Later
            // rather than all, so one duplicate is reported once.
            if (a.trait_id == 0i32) {
                int32:j = i + 1i32;
                while (j < t.count) {
                    ImplEntry:b = relay impl_at(t, j);
                    if (!b.blanket) {
                        if (b.trait_id == 0i32) {
                            if (b.target == a.target) {
                                drop dup_across(r, a, b);
                            }
                        }
                    }
                    j = j + 1i32;
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:dup_within = NIL(TypeResolver->:r, ImplEntry:e) {
    DeclId:iid = DeclId{ index: e.decl };
    DeclNode:d = relay ast_decl(r.ast, iid);
    int32:n = relay impl_member_count(r.ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclId:aid = relay impl_member(r.ast, d, i);
        DeclNode:am = relay ast_decl(r.ast, aid);
        if (am.kind == DeclKind.DeclFunctionDecl) {
            int32:j = i + 1i32;
            while (j < n) {
                DeclId:bid = relay impl_member(r.ast, d, j);
                DeclNode:bm = relay ast_decl(r.ast, bid);
                if (bm.kind == DeclKind.DeclFunctionDecl) {
                    if ((raw decl_name(bm)) == (raw decl_name(am))) {
                        drop dup_error(r, e, am, bm);
                    }
                }
                j = j + 1i32;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:dup_across = NIL(TypeResolver->:r, ImplEntry:first, ImplEntry:second) {
    DeclId:fid = DeclId{ index: first.decl };
    DeclNode:first_block = relay ast_decl(r.ast, fid);
    DeclId:sid = DeclId{ index: second.decl };
    DeclNode:second_block = relay ast_decl(r.ast, sid);

    int32:n = relay impl_member_count(r.ast, first_block);
    int32:i = 0i32;
    while (i < n) {
        DeclId:aid = relay impl_member(r.ast, first_block, i);
        DeclNode:am = relay ast_decl(r.ast, aid);
        if (am.kind == DeclKind.DeclFunctionDecl) {
            int32:other = relay impl_member_named(r.ast, second_block, raw decl_name(am),
                                                  DeclKind.DeclFunctionDecl);
            if (other != 0i32) {
                DeclId:oid = DeclId{ index: other };
                DeclNode:om = relay ast_decl(r.ast, oid);
                drop dup_error(r, first, am, om);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// The SECOND declaration carries the span and the first one's line is named, the
// same shape the coherence diagnostic uses — a reader told only that something is
// duplicated has to go and find the other one.
func:dup_error = NIL(TypeResolver->:r, ImplEntry:e, DeclNode:first,
                     DeclNode:second) {
    string:m1 = relay string_concat("`",
                    relay intern_get(r.interns, raw decl_name(second)));
    string:m2 = relay string_concat(m1, "` is already a method of `");
    string:m3 = relay string_concat(m2,
                    relay type_display(r.types, r.interns, e.target));
    string:m4 = relay string_concat(m3, "`, declared at line ");
    string:m5 = relay string_concat(m4, raw int_to_string(first.span.line => int64));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_IMPL_INCOMPLETE(),
        relay string_concat(m5,
            "; two inherent blocks are one namespace, so a name may be declared in only one of them"),
        second.span));
    pass NIL;
};
