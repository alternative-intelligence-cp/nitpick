// Function signatures — where `Result<T>` is added.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.4.
//
// EVERY FUNCTION RETURNS `Result<T>` (D-013). The declared type is the SUCCESS
// type, and the wrapping happens here rather than in the parser, because the AST
// records what was written and this records what it means.
//
// This is the blueprint philosophy's first facet in its purest form: a caller
// never has to ask whether *this particular* function needs error handling. One
// rule, no exceptions to remember, and that is worth more than the keystrokes.
//
// The two exceptions are not exceptions to the rule but to the shape it needs.
// `main` and `failsafe` are where the program ENDS, so there is no caller to
// return a `Result` to — routing an error out of them would have nowhere to go,
// which is precisely the uncontrolled stop the discipline exists to prevent.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./type_names.npk".*;
use "./parse_decl.npk".*;
use "./parse_type.npk".*;
use "./symbols.npk".*;
use "./resolve_type.npk".*;

// The two names whose signature is fixed by the runtime rather than by the
// programmer. Checked by NAME, which is what the spec fixes them by.
pub func:fn_is_terminal = bool(InternTable->:interns, int32:name) {
    string:t = relay intern_get(interns, name);
    if (raw string_eq(t, "main"))     { pass true; }
    if (raw string_eq(t, "failsafe")) { pass true; }
    pass false;
};

pub struct:FnSig = {
    int32:success;    // the declared type — what `pass` must produce
    int32:result;     // `Result<success>`, or the same as `success` for main/failsafe
    bool:terminal;    // main or failsafe: no `Result`, and no `relay`
};

// A SIGNATURE IS RESOLVED IN TERMS OF ITS OWN GENERIC PARAMETERS, so this is
// where the resolver is told which those are. Saved and restored around the
// resolution, for the same reason `self_type` is: a caller resolving `extract`'s
// signature from inside `process` must get `extract`'s `T`, not `process`'s, and
// leaking either way substitutes one function's parameter into another's type.
//
// The window is taken from the DECLARATION, which is the only thing that knows
// it. `fn_type` calls this, so setting it in both would be one save/restore
// nested inside another saying the same thing.
func:bind_own_generics = GenericScope(TypeResolver->:r, DeclNode:d) {
    GenericScope:saved = r.generics;
    IdSpan:w = raw decl_generic_window(r.ast, d);
    GenericScope:g = GenericScope{ params_start: w.start, params_count: w.count,
                                   args_start: 0i32, args_count: 0i32 };
    r.generics = g;
    pass saved;
};

// THE DECLARED TYPE IS THE SUCCESS TYPE; the actual type is wrapped.
//
// RESOLVED IN THE DECLARATION'S HOME SCOPE, not the asker's (0.8.1). A signature
// means what it meant where it was written — resolving it against the CALLING
// module's imports made `tyres_init(Ast->:ast, …)` type or fail depending on who
// asked, and under a name collision it would have silently bound the caller's
// type. The caller's scope survives only as the fallback for a declaration
// nothing collected.
pub func:fn_signature = FnSig(TypeResolver->:r, DeclId:did, int32:name,
                              int32:scope) {
    DeclNode:d = relay ast_decl(r.ast, did);
    int32:home = raw symtab_home_scope(r.tab, did.index, scope);
    GenericScope:saved = raw bind_own_generics(r, d);
    FnSig:s = relay fn_signature_bound(r, d, name, home);
    r.generics = saved;
    pass s;
};

func:fn_signature_bound = FnSig(TypeResolver->:r, DeclNode:d, int32:name,
                                int32:scope) {
    TypeId:ret_id = raw fn_return(r.ast, d);

    // A REFUSED RETURN SPELLING YIELDS THE INVALID TYPE, so the body is not
    // reported as well. `func:f = Result<int32>()` resolves perfectly well — that
    // is the problem with it — so without this the declaration is refused AND
    // every `pass` inside it is reported as returning the wrong type. One bad
    // annotation, one diagnostic: the same rule index 0 of the type table exists
    // for (0.4.0), applied one layer up.
    if (relay check_not_result_return(r, ret_id, scope)) {
        FnSig:bad = FnSig{ success: 0i32, result: 0i32,
                           terminal: raw fn_is_terminal(r.interns, name) };
        pass bad;
    }

    int32:success = relay resolve_type(r, ret_id, scope);
    bool:terminal = raw fn_is_terminal(r.interns, name);

    if (terminal) {
        FnSig:s = FnSig{ success: success, result: success, terminal: true };
        pass s;
    }
    int32:wrapped = raw tt_result(r.types, success,
                                  raw type_size(r.types, success),
                                  raw type_align(r.types, success));
    FnSig:s = FnSig{ success: success, result: wrapped, terminal: false };
    pass s;
};

// A FUNCTION'S OWN TYPE — `func Result<T>(P…)`, which is what an identifier
// naming it has and what 0.4.5 checks a call against.
//
// The RESULT is the return type here, not the success type. A caller receives
// what the function returns, and D-013 says that is always a `Result`.
pub func:fn_type = int32(TypeResolver->:r, DeclId:did, int32:name, int32:scope) {
    DeclNode:d = relay ast_decl(r.ast, did);
    int32:home = raw symtab_home_scope(r.tab, did.index, scope);
    GenericScope:saved = raw bind_own_generics(r, d);
    int32:ft = relay fn_type_bound(r, d, name, home);
    r.generics = saved;
    pass ft;
};

func:fn_type_bound = int32(TypeResolver->:r, DeclNode:d, int32:name, int32:scope) {
    FnSig:s = relay fn_signature_bound(r, d, name, scope);
    // D-163: a `never fails` declaration builds a never-fails function type,
    // distinct in identity from the may-fail one (types.npk `name` slot).
    bool:nf = relay fn_declares_never_fails(r.ast, d);
    int32:mark = raw ast_scratch_mark(r.ast);
    int32:i = 0i32;
    while (i < (raw fn_param_count(r.ast, d))) {
        // NOT `pid` — that is one of the five kernel identifier types (D-042).
        DeclId:param_id = raw fn_param(r.ast, d, i);
        DeclNode:pn = relay ast_decl(r.ast, param_id);
        int32:pt = relay resolve_type(r, raw param_type(pn), scope);
        drop ast_scratch_push(r.ast, pt);
        i = i + 1i32;
    }

    // `..*T[]:rest` — THE VARIADIC PARAMETER IS A PARAMETER. It goes into the
    // window like any other, typed as the slice it is bound to inside the body,
    // and the function's KIND is what says the last one collects (D-070).
    //
    // Carried none of this until now: `fn_type` built a plain `TY_FUNC` from the
    // fixed parameters and dropped the spec on the floor, so `sys(1i64)` and
    // `sys(1i64, 2i64, 3i64)` were both checked against a one-parameter function
    // and the second was reported as passing too many arguments.
    DeclId:vd = raw fn_variadic(r.ast, d);
    if (raw decl_is_none(vd)) {
        IdSpan:w = raw ast_scratch_commit(r.ast, mark);
        // THE SUCCESS TYPE, not the wrapped Result (0.9.6): `func int32(int32)`
        // spells its return the way a declaration does — the success type,
        // with Result implicit (D-069's one rule) — so the type built FROM a
        // declaration must encode the same slot the annotation encodes, or the
        // two spellings of one type never unify. Storing `s.result` here was
        // exactly that mismatch, invisible until function values existed.
        pass (raw tt_func(r.types, s.success, w.start, w.count, nf));
    }

    DeclNode:vn = relay ast_decl(r.ast, vd);
    int32:vt = relay resolve_type(r, raw variadic_type(vn), scope);
    drop ast_scratch_push(r.ast, relay require_variadic_slice(r, vt, vn.span));
    IdSpan:wv = raw ast_scratch_commit(r.ast, mark);
    pass (raw tt_func_variadic(r.types, s.success, wv.start, wv.count, nf));
};

// AN `extern` FUNCTION'S TYPE — and it is a `Result<T>` like every other (D-002).
//
// NOTHING BUILT THIS UNTIL NOW, which made every call to an `extern` function a
// type error: `type_ident` had no case for the kind, so the name fell through to
// "`open` is a type, not a value". The declaration parsed, the name bound, and the
// only way to find out was to call one. That is the D-085 shape a third time in
// this cycle — 0.2 parsed the construct, 0.3 bound it, and nothing downstream ever
// read what they recorded.
//
// THE RETURN IS WRAPPED, which is the whole of D-002. A C function reports failure
// however its author chose, the `fails on` / `never fails` contract is where that
// convention is written down, and the caller receives a `Result` either way — so a
// caller never has to ask whether THIS foreign function needs error handling. The
// contract decides what goes in the error field; it does not decide whether there
// IS one. `never fails` is an audited claim, not a second calling convention.
//
// The failure contract itself is not consumed here. It is a declaration the
// EMITTER reads to synthesise the wrapping at the call boundary (cycle 0.7); what
// this owes the checker is the type a caller sees.
pub func:extern_fn_type = int32(TypeResolver->:r, DeclNode:d, int32:scope) {
    // NOTE: extern signatures still resolve in the ASKER's scope — externs are
    // refused by the backend until the FFI rung, and threading the DeclId here
    // lands with that work rather than as a dead parameter now.
    TypeId:ret_id = raw extern_fn_return(r.ast, d);
    if (relay check_not_result_return(r, ret_id, scope)) { pass 0i32; }

    // A C VARIADIC TAIL HAS NO TYPE TO CHECK AGAINST. `check_args` reads the last
    // window entry as the collector and checks every trailing argument against its
    // element; `..*` in an `extern` names nothing, so there is no entry to read.
    // Emitting a plain `TY_FUNC` instead would silently treat `printf`'s fixed
    // parameters as the whole signature and report every real call as passing too
    // many arguments — refusing loudly is the honest answer until the language
    // settles what a C vararg's type is.
    if (raw decl_has(d, raw DECL_VARIADIC())) {
        drop diaglist_push(r.diags, raw diag_error(raw TYPE_EXTERN_VARIADIC(),
            "an `extern` function's `..*` tail has no type — the driver interface (D-149) gives a parameter a wire type, and a variadic tail has none — so calls to it cannot be checked",
            d.span));
        pass 0i32;
    }

    int32:success = relay resolve_type(r, ret_id, scope);
    int32:wrapped = raw tt_result(r.types, success,
                                  raw type_size(r.types, success),
                                  raw type_align(r.types, success));

    int32:mark = raw ast_scratch_mark(r.ast);
    int32:i = 0i32;
    while (i < (raw extern_fn_param_count(r.ast, d))) {
        DeclId:param_id = raw extern_fn_param(r.ast, d, i);
        DeclNode:pn = relay ast_decl(r.ast, param_id);
        int32:pt = relay resolve_type(r, raw param_type(pn), scope);
        drop ast_scratch_push(r.ast, pt);
        i = i + 1i32;
    }
    IdSpan:w = raw ast_scratch_commit(r.ast, mark);
    pass (raw tt_func(r.types, wrapped, w.start, w.count, false));
};

// `..*T[]` AND NOT `..*T`. The brackets are the type — `rest` is bound to a slice
// inside the body (D-070), and the element every trailing argument is checked
// against is that slice's element. Written without them there is no element to
// recover and no slice to bind, so the parameter would name a type the call site
// and the body disagree about.
//
// The invalid type is handed back rather than a guess, so the call checker refuses
// to check arguments against something that was never a slice.
func:require_variadic_slice = int32(TypeResolver->:r, int32:vt, Span:at) {
    if (vt == 0i32) { pass 0i32; }
    if (raw type_is_invalid(r.types, vt)) { pass 0i32; }
    if ((raw type_kind(r.types, vt)) == (raw TY_SLICE())) { pass vt; }
    string:m1 = relay string_concat("a variadic parameter collects into a slice, so it is written `..*T[]`, and this is `",
                                    relay type_display(r.types, r.interns, vt));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_UNKNOWN(),
        relay string_concat(m1, "`"), at));
    pass 0i32;
};

// D-091 — `func:f = Result<int32>()` IS AN ERROR THAT SAYS SO.
//
// `func:f = int32()` already returns `Result<int32>`, so the spelling means
// either that same type — in which case there are two ways to write one
// signature — or `Result<Result<int32>>`, a nesting nobody asked for that every
// caller unwraps twice. Both readings are defensible, which is exactly the
// problem: a reader would have to know which, and the answer is invisible in the
// signature they are reading.
//
// `Result<T>` stays writable everywhere else. `Result<string>:r = read_file(p);`
// is the ordinary way to hold an outcome before unwrapping, and is how this
// compiler's own sources are written.
func:check_not_result_return = bool(TypeResolver->:r, TypeId:id, int32:_~scope) {
    if (raw type_is_none(id)) { pass false; }
    TypeNode:n = relay ast_type(r.ast, id);
    if (n.kind != TypeKind.TypeNamedType) { pass false; }

    // THE PAYLOAD IS A TOKEN KIND ONLY WHEN THE NODE SAYS IT IS (D-104). Without
    // the guard this compared an intern index against `KwResult` and reported a
    // user type named at that index as a `Result` return — the same
    // reinterpretation, in a second place, reaching the opposite wrong answer.
    if (!(raw type_name_is_builtin(n))) { pass false; }
    TokenKind:as_kind = ((raw type_name_index(n)) =>! int32) =>! TokenKind;
    if (as_kind != TokenKind.KwResult) { pass false; }

    drop diaglist_push(r.diags, raw diag_error(raw TYPE_RESULT_RETURN(),
        "every function returns `Result<T>` already, so a return type is written as the success type — `func:f = int32()` returns `Result<int32>`",
        n.span));
    pass true;
};
