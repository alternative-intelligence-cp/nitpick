// Function signatures — where `Result<T>` is added.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.4.
//
// EVERY FUNCTION RETURNS `Result<T>` (D-013). The declared type is the SUCCESS
// type, and the wrapping happens here rather than in the parser, because the AST
// records what was written and this records what it means.
//
// This is the blueprint philosophy's first facet in its purest form: a caller
// never has to ask whether *this particular* function needs error handling. One
// rule, no exceptions to remember, and that is worth more than the keystrokes.
//
// The two exceptions are not exceptions to the rule but to the shape it needs.
// `main` and `failsafe` are where the program ENDS, so there is no caller to
// return a `Result` to — routing an error out of them would have nowhere to go,
// which is precisely the uncontrolled stop the discipline exists to prevent.

use "source_location.npk".*;
use "intern.npk".*;
use "ast_kind.npk".*;
use "ast.npk".*;
use "diagnostics.npk".*;
use "type_codes.npk".*;
use "types.npk".*;
use "type_names.npk".*;
use "parse_decl.npk".*;
use "parse_type.npk".*;
use "symbols.npk".*;
use "resolve_type.npk".*;

// The two names whose signature is fixed by the runtime rather than by the
// programmer. Checked by NAME, which is what the spec fixes them by.
pub func:fn_is_terminal = bool(InternTable->:interns, int32:name) {
    string:t = relay intern_get(interns, name);
    if (raw string_eq(t, "main"))     { pass true; }
    if (raw string_eq(t, "failsafe")) { pass true; }
    pass false;
};

pub struct:FnSig = {
    int32:success;    // the declared type — what `pass` must produce
    int32:result;     // `Result<success>`, or the same as `success` for main/failsafe
    bool:terminal;    // main or failsafe: no `Result`, and no `relay`
};

// THE DECLARED TYPE IS THE SUCCESS TYPE; the actual type is wrapped.
pub func:fn_signature = FnSig(TypeResolver->:r, DeclNode:d, int32:name,
                              int32:scope) {
    TypeId:ret_id = raw fn_return(r.ast, d);
    drop check_not_result_return(r, ret_id, scope);

    int32:success = relay resolve_type(r, ret_id, scope);
    bool:terminal = raw fn_is_terminal(r.interns, name);

    if (terminal) {
        FnSig:s = FnSig{ success: success, result: success, terminal: true };
        pass s;
    }
    int32:wrapped = raw tt_result(r.types, success,
                                  raw type_size(r.types, success),
                                  raw type_align(r.types, success));
    FnSig:s = FnSig{ success: success, result: wrapped, terminal: false };
    pass s;
};

// A FUNCTION'S OWN TYPE — `func Result<T>(P…)`, which is what an identifier
// naming it has and what 0.4.5 checks a call against.
//
// The RESULT is the return type here, not the success type. A caller receives
// what the function returns, and D-013 says that is always a `Result`.
pub func:fn_type = int32(TypeResolver->:r, DeclNode:d, int32:name, int32:scope) {
    FnSig:s = relay fn_signature(r, d, name, scope);
    int32:mark = raw ast_scratch_mark(r.ast);
    int32:i = 0i32;
    while (i < (raw fn_param_count(r.ast, d))) {
        // NOT `pid` — that is one of the five kernel identifier types (D-042).
        DeclId:param_id = raw fn_param(r.ast, d, i);
        DeclNode:pn = relay ast_decl(r.ast, param_id);
        int32:pt = relay resolve_type(r, raw param_type(pn), scope);
        drop ast_scratch_push(r.ast, pt);
        i = i + 1i32;
    }

    // `..*T[]:rest` — THE VARIADIC PARAMETER IS A PARAMETER. It goes into the
    // window like any other, typed as the slice it is bound to inside the body,
    // and the function's KIND is what says the last one collects (D-070).
    //
    // Carried none of this until now: `fn_type` built a plain `TY_FUNC` from the
    // fixed parameters and dropped the spec on the floor, so `sys(1i64)` and
    // `sys(1i64, 2i64, 3i64)` were both checked against a one-parameter function
    // and the second was reported as passing too many arguments.
    DeclId:vd = raw fn_variadic(r.ast, d);
    if (raw decl_is_none(vd)) {
        IdSpan:w = raw ast_scratch_commit(r.ast, mark);
        pass (raw tt_func(r.types, s.result, w.start, w.count));
    }

    DeclNode:vn = relay ast_decl(r.ast, vd);
    int32:vt = relay resolve_type(r, raw variadic_type(vn), scope);
    drop ast_scratch_push(r.ast, relay require_variadic_slice(r, vt, vn.span));
    IdSpan:wv = raw ast_scratch_commit(r.ast, mark);
    pass (raw tt_func_variadic(r.types, s.result, wv.start, wv.count));
};

// `..*T[]` AND NOT `..*T`. The brackets are the type — `rest` is bound to a slice
// inside the body (D-070), and the element every trailing argument is checked
// against is that slice's element. Written without them there is no element to
// recover and no slice to bind, so the parameter would name a type the call site
// and the body disagree about.
//
// The invalid type is handed back rather than a guess, so the call checker refuses
// to check arguments against something that was never a slice.
func:require_variadic_slice = int32(TypeResolver->:r, int32:vt, Span:at) {
    if (vt == 0i32) { pass 0i32; }
    if (raw type_is_invalid(r.types, vt)) { pass 0i32; }
    if ((raw type_kind(r.types, vt)) == (raw TY_SLICE())) { pass vt; }
    string:m1 = relay string_concat("a variadic parameter collects into a slice, so it is written `..*T[]`, and this is `",
                                    relay type_display(r.types, r.interns, vt));
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_UNKNOWN(),
        relay string_concat(m1, "`"), at));
    pass 0i32;
};

// D-091 — `func:f = Result<int32>()` IS AN ERROR THAT SAYS SO.
//
// `func:f = int32()` already returns `Result<int32>`, so the spelling means
// either that same type — in which case there are two ways to write one
// signature — or `Result<Result<int32>>`, a nesting nobody asked for that every
// caller unwraps twice. Both readings are defensible, which is exactly the
// problem: a reader would have to know which, and the answer is invisible in the
// signature they are reading.
//
// `Result<T>` stays writable everywhere else. `Result<string>:r = read_file(p);`
// is the ordinary way to hold an outcome before unwrapping, and is how this
// compiler's own sources are written.
func:check_not_result_return = NIL(TypeResolver->:r, TypeId:id, int32:_~scope) {
    if (raw type_is_none(id)) { pass NIL; }
    TypeNode:n = relay ast_type(r.ast, id);
    if (n.kind != TypeKind.TypeNamedType) { pass NIL; }

    TokenKind:as_kind = ((raw type_name_index(n)) => int32) => TokenKind;
    if (as_kind != TokenKind.KwResult) { pass NIL; }

    drop diaglist_push(r.diags, raw diag_error(raw TYPE_RESULT_RETURN(),
        "every function returns `Result<T>` already, so a return type is written as the success type — `func:f = int32()` returns `Result<int32>`",
        n.span));
    pass NIL;
};
