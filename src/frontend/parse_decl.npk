// Declaration parsing.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.2.5.
//
// Every top-level item in `AST_REFERENCE.md` section 1, plus the contracts
// (section 5) and attributes (section 6) that decorate them.
//
// ONE SHAPE, no exceptions: `keyword : name = value ;`. `func`, `struct`,
// `enum`, `trait`, `impl`, `Rules`, `macro`, `mod` and `extern` all take it.
//
// `mod` and `extern` used to be spelled `mod name { … }` and
// `extern "libc" { … }` -- no colon, no `=`, no terminator -- and 0.2.5 wrote
// that up as "they GROUP rather than bind". The rule does not survive contact
// with `trait` and `impl`, which group AND bind. There was no rule, only two
// constructs spelled the way another language spells them (D-088).
//
// A declaration with no `=` declares that something exists ELSEWHERE:
// `mod:network;` names a file, exactly as `assoc:Item;` names a type an impl
// must supply.
//
// Declarations carry more children than a node's three slots hold, so they use
// the fixed-header window described in ast.npk. Each header is defined once,
// beside the accessors that read it, and nothing else indexes it.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token_name.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./parse_codes.npk".*;
use "./parser.npk".*;
use "./parse_type.npk".*;
use "./parse_expr.npk".*;
use "./parse_decorate.npk".*;
use "./parse_stmt.npk".*;

// --- flags --------------------------------------------------------------------
//
// Visibility and the function modifiers, in one int32. `extern` is deliberately
// absent: FFI functions are `ExternFn` inside an `ExternBlock`, not ordinary
// functions wearing a modifier, because they carry failure contracts that
// ordinary functions do not (D-002).

pub func:DECL_PUB = int32() never fails       { pass 1i32; };
pub func:DECL_INLINE = int32() never fails    { pass 2i32; };
pub func:DECL_NOINLINE = int32() never fails  { pass 4i32; };
pub func:DECL_COMPTIME = int32() never fails  { pass 8i32; };
pub func:DECL_ASYNC = int32() never fails     { pass 16i32; };
pub func:DECL_VARIADIC = int32() never fails  { pass 32i32; };

// On a ParamDecl: `Type:_~name`, the declaration-site discard (D-089). Reading
// such a parameter is an ERROR rather than a warning -- the annotation is a
// claim about the function, and a claim the compiler does not check is
// decoration. Same shape as D-002's `never fails`.
pub func:DECL_DISCARDED = int32() never fails { pass 2048i32; };

// WRITTEN BY `#[derive]` RATHER THAN BY A PERSON (0.6.5). Set on the impls derive
// generates, and read where a diagnostic would otherwise send the reader looking
// for an `impl` they never wrote — a derived one beside a hand-written one is two
// impls of one trait, and "already implemented at line 2" is unhelpful when line 2
// is a `#[derive]`.
pub func:DECL_DERIVED = int32() never fails   { pass 4096i32; };

// Memory qualifiers on a RETURN type, folded into the declaration's flags.
// They shift up so they never collide with the visibility and modifier bits.
pub func:DECL_RET_WILD = int32() never fails  { pass 64i32; };
pub func:DECL_RET_WILDX = int32() never fails { pass 128i32; };
pub func:DECL_RET_STACK = int32() never fails { pass 256i32; };
pub func:DECL_RET_FIXED = int32() never fails { pass 1024i32; };
// `thread` (D-181): this function is a THREAD BODY — it owns an executor and
// the arena its task frames come from (D-034), which is what makes it a
// different kind of function from a task rather than the same one used
// differently (D-032's pinning).
pub func:DECL_THREAD = int32() never fails    { pass 2048i32; };

func:p_return_quals = int32(Parser->:p) never fails {
    int32:q = 0i32;
    while (true) {
        TokenKind:k = raw p_kind(p);
        int32:bit = 0i32;
        if (k == TokenKind.KwWild)  { bit = raw DECL_RET_WILD(); }
        if (k == TokenKind.KwWildx) { bit = raw DECL_RET_WILDX(); }
        if (k == TokenKind.KwStack) { bit = raw DECL_RET_STACK(); }
        if (k == TokenKind.KwFixed) { bit = raw DECL_RET_FIXED(); }
        if (bit == 0i32) { break; }
        discard(raw p_advance(p));
        q = q | bit;
    }
    pass q;
};

// A GLOBAL KEEPS ITS FLAGS IN THE HIGH HALF OF ITS QUALIFIER SLOT (1.4.8): its
// `a` is the TYPE, and until 1.4.8 `pub` on a module binding was never stored
// at all -- `decl_flags` read the type's node index as the flag word, so
// whether a `pub fixed` binding was exported depended on that index's parity.
// Found by the prelude's first module bindings (D-230's flag constants), which
// no importer could see. One accessor answers for every kind, and the two
// halves of `c` are named by `global_quals`/`global_flags` below.
pub func:decl_flags = int32(DeclNode:d) never fails {
    if (d.kind == DeclKind.DeclGlobalDecl) { pass ((d.c >> 16i32) & 65535i32); }
    pass d.a;
};
pub func:decl_name = int32(DeclNode:d) never fails  { pass (d.payload =>! int32); };
pub func:decl_has = bool(DeclNode:d, int32:bit) never fails { pass (((raw decl_flags(d)) & bit) != 0i32); };
pub func:decl_win_start = int32(DeclNode:d) never fails { pass d.b; };
pub func:decl_win_count = int32(DeclNode:d) never fails { pass d.c; };

func:d_at = int32(Ast->:ast, DeclNode:d, int32:i) never fails {
    pass (raw ast_id_at(ast, d.b, i));
};

// --- the item header ------------------------------------------------------------
//
// `struct`, `enum`, `trait` and `Type` share one layout, because they are the
// same shape: a name, optional generics, a list of members, attributes, and at
// most one kind-specific extra list.
//
//   [0] generic count  [1] member count  [2] attribute count  [3] extra count
//   then generics, members, attributes, extras.
//
// `extras` is a trait's supertraits and is empty for the rest. A fourth list
// rather than a single handle, because a supertrait clause is a LIST and a slot
// holding only its start would lose the count -- the exact mistake this header
// exists to prevent.
func:ITEM_HDR = int32() never fails { pass 4i32; };

pub func:item_generic_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 0i32)); };
pub func:item_member_count = int32(Ast->:ast, DeclNode:d) never fails  { pass (raw d_at(ast, d, 1i32)); };
pub func:item_attr_count = int32(Ast->:ast, DeclNode:d) never fails    { pass (raw d_at(ast, d, 2i32)); };
pub func:item_extra_count = int32(Ast->:ast, DeclNode:d) never fails   { pass (raw d_at(ast, d, 3i32)); };

pub func:item_generic = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    DeclId:g = DeclId{ index: raw d_at(ast, d, (raw ITEM_HDR()) + i) }; pass g;
};
pub func:item_member = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw ITEM_HDR()) + (raw item_generic_count(ast, d));
    DeclId:m = DeclId{ index: raw d_at(ast, d, base + i) }; pass m;
};
pub func:item_attr = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw ITEM_HDR()) + (raw item_generic_count(ast, d))
                 + (raw item_member_count(ast, d));
    DeclId:a = DeclId{ index: raw d_at(ast, d, base + i) }; pass a;
};
// A trait's supertraits, joined by `&` -- the same symbol that joins generic
// bounds and `dyn A & B`, so one operator means "and also this trait" wherever
// it appears (D-029).
pub func:item_extra = TypeId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw ITEM_HDR()) + (raw item_generic_count(ast, d))
                 + (raw item_member_count(ast, d)) + (raw item_attr_count(ast, d));
    TypeId:t = TypeId{ index: raw d_at(ast, d, base + i) }; pass t;
};

// --- FunctionDecl ---------------------------------------------------------------
//
//   [0] return TypeId   [1] body StmtId    [2] variadic DeclId
//   [3] generic count   [4] param count    [5] contract count  [6] attr count
//   then generics, params, contracts, attributes.
func:FN_HDR = int32() never fails { pass 7i32; };

pub func:fn_return = TypeId(Ast->:ast, DeclNode:d) never fails {
    TypeId:t = TypeId{ index: raw d_at(ast, d, 0i32) }; pass t;
};
pub func:fn_body = StmtId(Ast->:ast, DeclNode:d) never fails {
    StmtId:s = StmtId{ index: raw d_at(ast, d, 1i32) }; pass s;
};
pub func:fn_variadic = DeclId(Ast->:ast, DeclNode:d) never fails {
    DeclId:v = DeclId{ index: raw d_at(ast, d, 2i32) }; pass v;
};
pub func:fn_generic_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 3i32)); };
pub func:fn_param_count = int32(Ast->:ast, DeclNode:d) never fails   { pass (raw d_at(ast, d, 4i32)); };
pub func:fn_contract_count = int32(Ast->:ast, DeclNode:d) never fails{ pass (raw d_at(ast, d, 5i32)); };
pub func:fn_attr_count = int32(Ast->:ast, DeclNode:d) never fails    { pass (raw d_at(ast, d, 6i32)); };

pub func:fn_generic = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    DeclId:g = DeclId{ index: raw d_at(ast, d, (raw FN_HDR()) + i) }; pass g;
};
pub func:fn_param = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw FN_HDR()) + (raw fn_generic_count(ast, d));
    DeclId:p = DeclId{ index: raw d_at(ast, d, base + i) }; pass p;
};
pub func:fn_contract = VerifyId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw FN_HDR()) + (raw fn_generic_count(ast, d))
                 + (raw fn_param_count(ast, d));
    VerifyId:c = VerifyId{ index: raw d_at(ast, d, base + i) }; pass c;
};

// Does this function's contract window carry `never fails`? (D-163) The func
// type built from the declaration reads this to set its never-fails bit, and the
// body check reads it to enforce the contract.
pub func:fn_declares_never_fails = bool(Ast->:ast, DeclNode:d) never fails {
    int32:c = 0i32;
    int32:cn = raw fn_contract_count(ast, d);
    while (c < cn) {
        VerifyNode:v = raw ast_verify(ast, raw fn_contract(ast, d, c));
        if (v.kind == VerifyKind.VerifyNeverFails) { pass true; }
        c = c + 1i32;
    }
    pass false;
};

// Does this function declare `gives` (D-183, 1.2.6)? Same window, same walk.
pub func:fn_declares_gives = bool(Ast->:ast, DeclNode:d) never fails {
    int32:c = 0i32;
    int32:cn = raw fn_contract_count(ast, d);
    while (c < cn) {
        VerifyNode:v = raw ast_verify(ast, raw fn_contract(ast, d, c));
        if (v.kind == VerifyKind.VerifyGives) { pass true; }
        c = c + 1i32;
    }
    pass false;
};
pub func:fn_attr = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw FN_HDR()) + (raw fn_generic_count(ast, d))
                 + (raw fn_param_count(ast, d)) + (raw fn_contract_count(ast, d));
    DeclId:a = DeclId{ index: raw d_at(ast, d, base + i) }; pass a;
};

// --- ImplDecl ---------------------------------------------------------------------
//
//   [0] target TypeId   [1] trait TypeId (0 = inherent)
//   [2] member count    [3] attribute count   [4] generic count
//   then generics, members, attributes.
//
// SLOT 0 IS ALWAYS THE TYPE, with or without a trait (D-031). Trait-first
// ordering was rejected for exactly this reason: it would make the one-segment
// form `impl:Point` put a type in slot 1 while the two-segment form put a trait
// there, so the first slot's meaning would change with arity.
//
// A BLANKET IMPL PUTS ITS PARAMETER IN THE SAME SLOT (D-105). `impl:<T: Printable>`
// declares `T` in the generics window and names it as the target, so slot 0 keeps
// meaning "the type being implemented on" for all three forms -- one concrete,
// one inherent, one blanket -- rather than gaining a fourth reading.
func:IMPL_HDR = int32() never fails { pass 5i32; };

pub func:impl_target = TypeId(Ast->:ast, DeclNode:d) never fails {
    TypeId:t = TypeId{ index: raw d_at(ast, d, 0i32) }; pass t;
};
pub func:impl_trait = TypeId(Ast->:ast, DeclNode:d) never fails {
    TypeId:t = TypeId{ index: raw d_at(ast, d, 1i32) }; pass t;
};
pub func:impl_member_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 2i32)); };
pub func:impl_attr_count = int32(Ast->:ast, DeclNode:d) never fails   { pass (raw d_at(ast, d, 3i32)); };
pub func:impl_generic_count = int32(Ast->:ast, DeclNode:d) never fails{ pass (raw d_at(ast, d, 4i32)); };
pub func:impl_generic = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    DeclId:g = DeclId{ index: raw d_at(ast, d, (raw IMPL_HDR()) + i) }; pass g;
};
pub func:impl_member = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw IMPL_HDR()) + (raw impl_generic_count(ast, d));
    DeclId:m = DeclId{ index: raw d_at(ast, d, base + i) }; pass m;
};
// The attributes follow the members, which follow the generics. Added when the
// macro clone needed to rebuild an `impl` and had to read the tail: a raw slot read
// at the call site is how a window whose sections shift silently becomes a defect,
// which is the rule stated above `ITEM_HDR` and the one an `impl` cloned as an item
// had already broken.
pub func:impl_attr = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw IMPL_HDR()) + (raw impl_generic_count(ast, d))
               + (raw impl_member_count(ast, d));
    DeclId:a = DeclId{ index: raw d_at(ast, d, base + i) }; pass a;
};

// A blanket impl is the one whose target is a parameter it declared itself —
// which is to say the one that declared generics and wrote NO target, so the
// parameter stands in the target position (D-105).
//
// A BLANKET IMPL'S TARGET IS A BARE PARAMETER (D-171). Every parameterised
// impl names its target now — `impl:<T: P>:T:Loggable` (blanket, target `T`) vs
// `impl:<T>:Box<T>:Sized` (family, target `Box<T>`) — so the two are told apart
// by the SHAPE of that target: a blanket's is an argument-less name that IS one
// of the declared parameters; a family's is an instantiation that mentions
// them. This reads the AST alone (the target NamedType and the parameter
// names), so it is answerable before resolution, where its callers need it.
pub func:impl_is_blanket = bool(Ast->:ast, DeclNode:d) never fails {
    int32:gc = raw impl_generic_count(ast, d);
    if (gc == 0i32) { pass false; }
    TypeId:tgt = raw impl_target(ast, d);
    if (raw type_is_none(tgt)) { pass false; }
    TypeNode:tn = raw ast_type(ast, tgt);
    if (tn.kind != TypeKind.TypeNamedType) { pass false; }
    if ((raw type_args_count(tn)) > 0i32) { pass false; }
    if (raw type_name_is_builtin(tn)) { pass false; }
    int64:nm = raw type_name_index(tn);
    for (int32:i in 0i32...gc) {
        DeclNode:gpn = raw ast_decl(ast, raw impl_generic(ast, d, i));
        if ((raw decl_name(gpn)) == (nm =>! int32)) { pass true; }
    }
    pass false;
};

// --- MacroDecl ----------------------------------------------------------------------
//
//   [0] body StmtId   [1] param count   [2] attribute count
//   then parameter names (intern indices), then attributes.
// FOUR HEADER SLOTS: body kind, body count, parameter count, attribute count.
// It was three until the body gained a kind — and the count moved with it, because
// a header slot added in the middle shifts everything after, which is exactly what
// a named header constant exists to make survivable.
func:MACRO_HDR = int32() never fails { pass 4i32; };

// The tokens that begin a DECLARATION rather than a statement.
//
// A macro body is one or the other and the first token decides (`MACRO_REFERENCE`
// §1). This is deliberately NOT `is_sync_point`, which answers a different
// question — where it is safe to resume after an error — and includes `if`,
// `while` and every statement keyword. Reading one through the other would make
// every macro body a declaration body.
// THE KEYWORDS THAT OPEN A DECLARATION, as a question about a token rather than
// about the parser's position. Split out because the macro-body parser has to ask
// it of a token it has not reached yet: what a body is MADE of decides how each of
// its items is read, so the answer is needed before the first item is parsed.
pub func:tok_starts_decl = bool(TokenKind:k) never fails {
    if (k == TokenKind.KwPub)    { pass true; }
    if (k == TokenKind.KwFunc)   { pass true; }
    if (k == TokenKind.KwStruct) { pass true; }
    if (k == TokenKind.KwEnum)   { pass true; }
    if (k == TokenKind.KwTrait)  { pass true; }
    if (k == TokenKind.KwImpl)   { pass true; }
    if (k == TokenKind.KwMacro)  { pass true; }
    if (k == TokenKind.KwRules)  { pass true; }
    if (k == TokenKind.KwAssoc)  { pass true; }
    if (k == TokenKind.KwExtern) { pass true; }
    if (k == TokenKind.KwOpaque) { pass true; }
    if (k == TokenKind.KwError)  { pass true; }
    if (k == TokenKind.KwUnit)   { pass true; }
    pass (k == TokenKind.KwUse);
};

pub func:p_at_decl_start = bool(Parser->:p) never fails {
    TokenKind:k = raw p_kind(p);
    if (raw tok_starts_decl(k)) { pass true; }

    // `#name();` COUNTS AS A DECLARATION START, and that is the whole reason a
    // nested invocation works. A macro body containing `#inner(); func:f3 = …;`
    // has TWO declaration-position items — a splice and a function — and without
    // this the splice parsed as an expression STATEMENT while the body was
    // classified as declarations, leaving the window holding a `StmtId` where the
    // clone expected a `DeclId`. It read one as the other and reported an
    // unclassified node kind, which is the symptom a heterogeneous window always
    // produces and never explains.
    pass (k == TokenKind.Hash);
};

// DOES THIS MACRO BODY CONTAIN A DECLARATION? Asked by scanning tokens from the
// `{` to its match, before a single item is parsed.
//
// IT HAS TO BE ASKED FIRST, because `#name(...);` is the one item that does not
// say what it is. Standing among declarations it is a splice and has to be a
// `DeclId`; standing among statements it is an expression statement and has to be
// a `StmtId`; and the window holding the body is read as one or the other, never
// both. Deciding per item — which is what reading the sigil alone amounted to —
// made every body that began with `#` a declaration body, so a statement macro
// could not invoke another statement macro at all.
//
// The rule this implements is the one `MACRO_REFERENCE.md` section 1 already
// states: a body CONTAINS declarations, or it does not.
func:MACRO_BODY_SCAN = int64() never fails { pass 65536i64; };

func:p_macro_body_has_decl = bool(Parser->:p) never fails {
    int64:i = 0i64;
    int32:depth = 0i32;
    while (i < (raw MACRO_BODY_SCAN())) {
        Token:t = raw p_peek_at(p, i);
        if (t.kind == TokenKind.Eof) { pass false; }
        if (t.kind == TokenKind.PLBrace) { depth = depth + 1i32; }
        if (t.kind == TokenKind.PRBrace) {
            depth = depth - 1i32;
            if (depth <= 0i32) { pass false; }
        }
        // AT THE BODY'S OWN LEVEL ONLY. A `func:` nested inside a block is not a
        // thing the language has, and counting one would misread a statement body
        // whose contents merely mention a keyword.
        if (depth == 1i32) {
            if (raw tok_starts_decl(t.kind)) { pass true; }
        }
        i = i + 1i64;
    }

    // THE SCAN RAN OUT BEFORE THE BODY CLOSED. Answering either way would guess at
    // how every item in this body is read, so it refuses instead — the same
    // fail-closed rule the analyses use when they run out of fuel.
    drop p_error(p, raw PARSE_UNEXPECTED(),
        "this macro's body is too long to classify; a body is declarations, statements or one expression, and deciding which requires reading it to its closing brace");
    pass false;
};

// WHAT A MACRO'S BODY IS MADE OF, and therefore where it may be invoked.
//
// Three values rather than a pair of flags, because they are exclusive: a body is
// declarations, or statements, or one expression. Two booleans would make
// "declarations AND an expression" representable, and it is not.
pub func:MACRO_BODY_DECLS = int32() never fails { pass 1i32; };
pub func:MACRO_BODY_STMTS = int32() never fails { pass 2i32; };
pub func:MACRO_BODY_EXPR = int32() never fails  { pass 3i32; };

pub func:macro_body_kind = int32(Ast->:ast, DeclNode:d) never fails  { pass (raw d_at(ast, d, 0i32)); };
pub func:macro_body_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 1i32)); };
pub func:macro_param_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 2i32)); };

// ONE ACCESSOR PER SECTION, and each starts where the previous ended. The body,
// the parameters and the attributes share one window, so reading a parameter as a
// body item is a slot meaning two things — which is the defect shape this compiler
// has paid for repeatedly, and the reason these are named rather than indexed at
// the call site.
pub func:macro_body_at = int32(Ast->:ast, DeclNode:d, int32:i) never fails {
    pass (raw d_at(ast, d, (raw MACRO_HDR()) + i));
};
pub func:macro_param = int32(Ast->:ast, DeclNode:d, int32:i) never fails {
    pass (raw d_at(ast, d, (raw MACRO_HDR()) + (raw macro_body_count(ast, d)) + i));
};

// WHERE THE PARAMETER NAMES LIVE, as an absolute window into the shared pool.
//
// Expansion needs the SPAN rather than an accessor per index, because binding is
// positional and it looks a name up by scanning — and a helper that returned one
// parameter at a time would make the expander recompute the section start on every
// comparison.
pub func:macro_param_span = IdSpan(Ast->:ast, DeclNode:d) never fails {
    IdSpan:w = IdSpan{ start: (raw decl_win_start(d)) + (raw MACRO_HDR())
                              + (raw macro_body_count(ast, d)),
                       count: raw macro_param_count(ast, d) };
    pass w;
};

// The invocation a splice stands for.
pub func:splice_invocation = ExprId(DeclNode:d) never fails {
    ExprId:e = ExprId{ index: d.a }; pass e;
};

// --- ImportDecl -----------------------------------------------------------------------
//
//   [0] alias intern (0 = none)   [1] path-segment count   [2] name count
//   [3] flags -- `pub use` is a RE-EXPORT and the only way to have one, so the
//       bit has to survive parsing. It lives here because `a` already holds the
//       import kind and there is no fourth slot on the node.
//   then path segments, then imported names.
//
// `payload` is the quoted path's intern index for a file import and 0 for a
// logical one, which is what tells the two apart with no separate flag: a file
// import has a path string and no segments, a logical one has segments and no
// string.
func:IMPORT_HDR = int32() never fails { pass 4i32; };

pub func:IMPORT_WILDCARD = int32() never fails { pass 1i32; };
pub func:IMPORT_SINGLE = int32() never fails   { pass 2i32; };
pub func:IMPORT_SELECTIVE = int32() never fails{ pass 3i32; };
pub func:IMPORT_NAMESPACE = int32() never fails{ pass 4i32; };

pub func:import_kind = int32(DeclNode:d) never fails { pass d.a; };
pub func:import_path = int32(DeclNode:d) never fails { pass (d.payload =>! int32); };
pub func:import_alias = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 0i32)); };
pub func:import_segment_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 1i32)); };
pub func:import_name_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 2i32)); };
pub func:import_flags = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 3i32)); };
pub func:import_is_reexport = bool(Ast->:ast, DeclNode:d) never fails {
    pass (((raw import_flags(ast, d)) & (raw DECL_PUB())) != 0i32);
};
pub func:import_segment = int32(Ast->:ast, DeclNode:d, int32:i) never fails {
    pass (raw d_at(ast, d, (raw IMPORT_HDR()) + i));
};
pub func:import_name = int32(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw IMPORT_HDR()) + (raw import_segment_count(ast, d));
    pass (raw d_at(ast, d, base + i));
};

// --- ExternFn -------------------------------------------------------------------------
//
//   [0] return TypeId   [1] failure-contract DeclId   [2] param count
//   then params.
func:EXTERN_HDR = int32() never fails { pass 3i32; };

pub func:externfn_return = TypeId(Ast->:ast, DeclNode:d) never fails {
    TypeId:t = TypeId{ index: raw d_at(ast, d, 0i32) }; pass t;
};
pub func:externfn_failure = DeclId(Ast->:ast, DeclNode:d) never fails {
    DeclId:f = DeclId{ index: raw d_at(ast, d, 1i32) }; pass f;
};
pub func:externfn_param_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 2i32)); };
pub func:externfn_param = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    DeclId:p = DeclId{ index: raw d_at(ast, d, (raw EXTERN_HDR()) + i) }; pass p;
};

pub func:failson_predicate = ExprId(DeclNode:d) never fails { ExprId:e = ExprId{ index: d.a }; pass e; };
// `with errno` is optional; without it a generic FFI error code is used (D-002).
pub func:failson_uses_errno = bool(DeclNode:d) never fails { pass (d.b != 0i32); };

// --- RuleDecl --------------------------------------------------------------------------
//
//   [0] refinement count   [1] clause count
//   then refined rule names (intern indices), then clause expressions.
//
// A `limit<Other>` clause REFINES another ruleset; the rest are predicates. They
// are stored apart because they are different things, not two spellings of one.
func:RULE_HDR = int32() never fails { pass 2i32; };

pub func:rule_subject = TypeId(DeclNode:d) never fails { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:rule_refine_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 0i32)); };
pub func:rule_clause_count = int32(Ast->:ast, DeclNode:d) never fails { pass (raw d_at(ast, d, 1i32)); };
pub func:rule_refine = int32(Ast->:ast, DeclNode:d, int32:i) never fails {
    pass (raw d_at(ast, d, (raw RULE_HDR()) + i));
};
pub func:rule_clause = ExprId(Ast->:ast, DeclNode:d, int32:i) never fails {
    int32:base = (raw RULE_HDR()) + (raw rule_refine_count(ast, d));
    ExprId:e = ExprId{ index: raw d_at(ast, d, base + i) }; pass e;
};

// --- nodes that fit in three slots --------------------------------------------------------

pub func:param_type = TypeId(DeclNode:d) never fails  { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:param_limit = VerifyId(DeclNode:d) never fails { VerifyId:v = VerifyId{ index: d.b }; pass v; };
pub func:param_is_discarded = bool(DeclNode:d) never fails {
    pass ((d.c & (raw DECL_DISCARDED())) != 0i32);
};
pub func:field_type = TypeId(DeclNode:d) never fails  { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:field_quals = int32(DeclNode:d) never fails { pass d.c; };
pub func:param_quals = int32(DeclNode:d) never fails { pass d.c; };
pub func:global_type = TypeId(DeclNode:d) never fails { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:global_init = ExprId(DeclNode:d) never fails { ExprId:e = ExprId{ index: d.b }; pass e; };
pub func:global_quals = int32(DeclNode:d) never fails { pass (d.c & 65535i32); };
pub func:global_flags = int32(DeclNode:d) never fails { pass ((d.c >> 16i32) & 65535i32); };
pub func:assoc_default = TypeId(DeclNode:d) never fails { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:variant_value = ExprId(DeclNode:d) never fails { ExprId:e = ExprId{ index: d.a }; pass e; };
pub func:variant_payload_start = int32(DeclNode:d) never fails { pass d.b; };
pub func:variant_payload_count = int32(DeclNode:d) never fails { pass d.c; };
// THE WHOLE `T[]`, NOT ITS ELEMENT. `..*T[]:rest` parses `T[]` with the ordinary
// type parser, so this slot holds the slice the parameter is bound to. It was
// named `variadic_elem`, which reads as the `T` and is what a caller would use it
// as; the element comes from `type_elem` of this.
pub func:variadic_type = TypeId(DeclNode:d) never fails { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:extern_lib = int32(DeclNode:d) never fails { pass (d.payload =>! int32); };

// An `extern` FUNCTION'S WINDOW: return type, failure contract, parameter count,
// then the parameters. A THREE-SLOT HEADER, where a `DeclFunctionDecl` has seven —
// an extern declaration has no body, no generics, no contracts and no attributes,
// so it carries none of those slots.
//
// THE TWO LAYOUTS ARE NOT INTERCHANGEABLE, which is why these accessors exist
// rather than the `fn_*` ones being pointed at an extern node. `fn_param_count`
// reads slot 4; on an extern function slot 4 is the second PARAMETER. Reading one
// layout through the other is the defect shape that has cost this compiler a
// `till` body typed as an expression and a numeric width resolved as a name.
pub func:EXTERN_FN_HDR = int32() never fails { pass 3i32; };

pub func:extern_fn_return = TypeId(Ast->:ast, DeclNode:d) never fails {
    TypeId:t = TypeId{ index: raw d_at(ast, d, 0i32) }; pass t;
};
pub func:extern_fn_failure = DeclId(Ast->:ast, DeclNode:d) never fails {
    DeclId:f = DeclId{ index: raw d_at(ast, d, 1i32) }; pass f;
};
pub func:extern_fn_param_count = int32(Ast->:ast, DeclNode:d) never fails {
    pass (raw d_at(ast, d, 2i32));
};
pub func:extern_fn_param = DeclId(Ast->:ast, DeclNode:d, int32:i) never fails {
    DeclId:p = DeclId{ index: raw d_at(ast, d, (raw EXTERN_FN_HDR()) + i) }; pass p;
};

// GenericParam: a = value type, b,c = bounds window, payload = name.
//
// The two kinds need no flag, and this is not a shortcut. A compile-time value
// parameter ALWAYS has a type -- `<comptime int32:LEVEL>` cannot be written
// without one -- and a type parameter NEVER has one, since its bounds are traits
// and live in the bounds window. So a non-zero type slot is an exact
// discriminator rather than a coincidence that usually holds.
pub func:generic_is_value = bool(DeclNode:d) never fails { pass (d.a != 0i32); };
pub func:generic_value_type = TypeId(DeclNode:d) never fails { TypeId:t = TypeId{ index: d.a }; pass t; };
pub func:generic_bound_start = int32(DeclNode:d) never fails { pass d.b; };
pub func:generic_bound_count = int32(DeclNode:d) never fails { pass d.c; };

// EVERY DECLARATION'S GENERIC LIST, AS ONE WINDOW.
//
// Three shapes keep their generics behind three different headers, and each is
// CONTIGUOUS immediately after its own -- `fn_generic`, `item_generic` and
// `impl_generic` all index `HDR + i` and differ only in which `HDR`. So the list
// is already a window; this is the one place that says where it starts, which is
// the same rule the individual accessors follow.
//
// 0.4.7 needs the window rather than the elements because a generic parameter has
// to be resolvable from the DECLARATION ALONE. The type checker walks a body with
// the module scope in hand, not the function scope the resolver opened, so `T` in
// `func:f<T> = NIL(T:x)` is a name no lookup from here can reach -- and the same
// is true of a struct's `T`, which is declared into no scope at all. Carrying the
// window means the answer travels with the declaration instead of depending on
// which scope a caller happened to pass.
pub func:decl_generic_window = IdSpan(Ast->:ast, DeclNode:d) never fails {
    if (d.kind == DeclKind.DeclFunctionDecl) {
        IdSpan:w = IdSpan{ start: d.b + (raw FN_HDR()),
                           count: raw fn_generic_count(ast, d) };
        pass w;
    }
    if (d.kind == DeclKind.DeclImplDecl) {
        IdSpan:w = IdSpan{ start: d.b + (raw IMPL_HDR()),
                           count: raw impl_generic_count(ast, d) };
        pass w;
    }
    if (d.kind == DeclKind.DeclStructDecl) { pass (raw item_generic_span(ast, d)); }
    if (d.kind == DeclKind.DeclEnumDecl)   { pass (raw item_generic_span(ast, d)); }
    if (d.kind == DeclKind.DeclTraitDecl)  { pass (raw item_generic_span(ast, d)); }
    pass (raw idspan_empty());
};

func:item_generic_span = IdSpan(Ast->:ast, DeclNode:d) never fails {
    IdSpan:w = IdSpan{ start: d.b + (raw ITEM_HDR()),
                       count: raw item_generic_count(ast, d) };
    pass w;
};

// --- generics ---------------------------------------------------------------------------------
//
// AFTER the name, never before (D-030): `func:process<T: Renderable>`, matching
// `struct:name = ` and every other declaration's shape. Chapter 06 of the draft
// put them before the name and was the outlier.
func:p_parse_generics = IdSpan(Parser->:p) never fails {
    int32:mark = raw ast_scratch_mark(p.ast);
    if (!(raw p_at(p, TokenKind.OpLt))) {
        pass (raw ast_scratch_commit(p.ast, mark));
    }
    discard(raw p_advance(p));
    while (true) {
        if (raw p_at(p, TokenKind.OpGt)) { break; }
        if (raw p_at(p, TokenKind.OpShr)) { break; }
        if (raw p_at_end(p)) { break; }
        Span:sp = raw p_span(p);
        if (raw p_accept(p, TokenKind.KwComptime)) {
            // `<comptime int32:LEVEL>` -- a compile-time VALUE parameter. Type
            // first, name after the colon, the same order a variable declaration
            // uses. A bare `<T>` introduces its name on the OTHER side of that
            // colon, which is why the marker is needed to read them apart
            // (D-064).
            TypeId:vt = raw p_parse_type(p);
            discard(raw p_expect(p, TokenKind.PColon));
            Token:vn = raw p_advance(p);
            DeclId:g = raw ast_add_decl(p.ast, DeclKind.DeclGenericParam, sp,
                                          vt.index, 0i32, 0i32, vn.payload);
            drop ast_scratch_push(p.ast, g.index);
        } else {
            Token:gn = raw p_advance(p);
            int32:bstart = 0i32;
            int32:bcount = 0i32;
            if (raw p_accept(p, TokenKind.PColon)) {
                int32:bmark = raw ast_scratch_mark(p.ast);
                TypeId:b1 = raw p_parse_type(p);
                drop ast_scratch_push(p.ast, b1.index);
                while (raw p_accept(p, TokenKind.OpAmp)) {
                    TypeId:bindN = raw p_parse_type(p);
                    drop ast_scratch_push(p.ast, bindN.index);
                }
                IdSpan:bw = raw ast_scratch_commit(p.ast, bmark);
                bstart = bw.start;
                bcount = bw.count;
            }
            DeclId:g = raw ast_add_decl(p.ast, DeclKind.DeclGenericParam, sp,
                                          0i32, bstart, bcount, gn.payload);
            drop ast_scratch_push(p.ast, g.index);
        }
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    discard(raw p_expect_gt(p));
    pass (raw ast_scratch_commit(p.ast, mark));
};

// --- parameters ---------------------------------------------------------------------------------

pub func:p_parse_param = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);

    // `wild int8->:buf` — A QUALIFIER ON A PARAMETER, read here since 0.7.3.
    // `parse_type.npk` has said since 0.4 that qualifiers are not part of the
    // type and belong to the declaration; the reading of them existed in
    // statement and return position and nowhere else, so the compiler's OWN
    // sources did not parse. Sixteen of its files begin a struct or a signature
    // this way.
    int32:quals = raw p_qualifiers(p);

    int32:lim = 0i32;
    if (raw p_at(p, TokenKind.KwLimit)) {
        lim = (raw p_parse_limit(p)).index;
    }
    TypeId:ty = raw p_parse_type(p);
    discard(raw p_expect(p, TokenKind.PColon));

    // `Type:_~name` -- this parameter is DELIBERATELY unused (D-089). The marker
    // sits between the colon and the name, and the name is kept: `cstring[]:_~argv`
    // still says what the slot is, where a `_` placeholder would say nothing and
    // a second one would collide.
    //
    // This is what `_~` was invented for. `main` used to take `argc` and `argv`,
    // the compiler warned about them going unread, and the only escape was a
    // compiler flag -- so `discard` was added beside `raw` and `drop`, which
    // already existed for unwanted Results and return values.
    int32:flags = quals;
    if (raw p_accept(p, TokenKind.OpUnderTilde)) {
        flags = flags | (raw DECL_DISCARDED());
    }

    Token:name = raw p_advance(p);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclParamDecl, sp,
                             ty.index, lim, flags, name.payload));
};

// --- the entry point ---------------------------------------------------------------------------------

pub func:p_parse_decl = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);

    // Attributes come first and attach to whatever follows.
    int32:amark = raw ast_scratch_mark(p.ast);
    while (raw p_at_attribute(p)) {
        DeclId:a = raw p_parse_attribute(p);
        drop ast_scratch_push(p.ast, a.index);
    }
    IdSpan:attrs = raw ast_scratch_commit(p.ast, amark);

    int32:flags = 0i32;
    if (raw p_accept(p, TokenKind.KwPub)) { flags = flags | (raw DECL_PUB()); }
    while (true) {
        TokenKind:m = raw p_kind(p);
        int32:bit = 0i32;
        if (m == TokenKind.KwInline)   { bit = raw DECL_INLINE(); }
        if (m == TokenKind.KwNoinline) { bit = raw DECL_NOINLINE(); }
        if (m == TokenKind.KwComptime) { bit = raw DECL_COMPTIME(); }
        if (m == TokenKind.KwAsync)    { bit = raw DECL_ASYNC(); }
        if (m == TokenKind.KwThread)   { bit = raw DECL_THREAD(); }
        if (bit == 0i32) { break; }
        flags = flags | bit;
        discard(raw p_advance(p));
    }

    TokenKind:k = raw p_kind(p);

    if (k == TokenKind.KwUse)    { pass (raw p_parse_import(p, sp, flags)); }
    if (k == TokenKind.KwMod)    { pass (raw p_parse_mod(p, sp, flags)); }
    if (k == TokenKind.KwExtern) { pass (raw p_parse_extern(p, sp, flags)); }
    if (k == TokenKind.KwFunc)   { pass (raw p_parse_func(p, sp, flags, attrs)); }
    if (k == TokenKind.KwStruct) { pass (raw p_parse_record(p, sp, flags, attrs, true)); }
    if (k == TokenKind.KwEnum)   { pass (raw p_parse_record(p, sp, flags, attrs, false)); }
    if (k == TokenKind.KwTrait)  { pass (raw p_parse_trait(p, sp, flags, attrs)); }
    if (k == TokenKind.KwImpl)   { pass (raw p_parse_impl(p, sp, flags, attrs)); }
    if (k == TokenKind.KwRules)  { pass (raw p_parse_rules(p, sp, flags)); }
    if (k == TokenKind.KwMacro)  { pass (raw p_parse_macro(p, sp, flags, attrs)); }

    // `#name(args);` WHERE A DECLARATION IS EXPECTED — module level, and an `impl`
    // body, which reaches here through `p_parse_item_block`.
    //
    // The invocation itself is an ordinary `BuiltinExpr` (D-046): the parser sees
    // `#`, a name and arguments, and NOTHING IN THE SYNTAX SAYS whether the name is
    // compiler-provided or user-defined — a macro may be imported, so the file
    // being parsed need not contain its declaration. What this node adds is only
    // the POSITION: an invocation standing where a declaration goes, which
    // expansion replaces with whatever the body emits.
    if (k == TokenKind.Hash) { pass (raw p_parse_macro_splice(p, sp)); }
    if (k == TokenKind.KwAssoc)  { pass (raw p_parse_assoc(p, sp, flags)); }
    // `opaque struct:Name;` is an `extern`-block item (D-066). Parsing it here
    // too means a misplaced one gets "an opaque struct is only legal inside an
    // extern block" from the semantic phase rather than "expected a declaration"
    // from the parser. The parser never restricts (D-085).
    if (k == TokenKind.KwOpaque) { pass (raw p_parse_opaque(p, sp, flags)); }
    if (k == TokenKind.KwError)  { pass (raw p_parse_errdecl(p, sp, flags)); }
    if (k == TokenKind.KwUnit)   { pass (raw p_parse_unitdecl(p, sp, flags)); }

    pass (raw p_parse_global(p, sp, flags));
};

func:p_parse_import = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwUse));
    int32:path = 0i32;
    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, 0i32);   // [0] alias, filled in below
    drop ast_scratch_push(p.ast, 0i32);   // [1] segment count
    drop ast_scratch_push(p.ast, 0i32);   // [2] name count
    drop ast_scratch_push(p.ast, flags);  // [3] flags -- `pub use` re-exports

    int32:segments = 0i32;
    if (raw p_at(p, TokenKind.StringLit)) {
        // A file path: `use "./path/module.npk".*;`
        path = ((raw p_advance(p)).payload) =>! int32;
    } else {
        // A logical path: `use std.math.*;` -- kept as segments rather than one
        // joined string, because joining would mean building and interning a
        // name that appears nowhere in the source.
        Token:s1 = raw p_advance(p);
        drop ast_scratch_push(p.ast, s1.payload =>! int32);
        segments = 1i32;
        while (true) {
            if (!(raw p_at(p, TokenKind.PDot))) { break; }
            if ((raw p_peek_at(p, 1i64)).kind != TokenKind.Ident) { break; }
            discard(raw p_advance(p));
            Token:sn = raw p_advance(p);
            drop ast_scratch_push(p.ast, sn.payload =>! int32);
            segments = segments + 1i32;
        }
    }

    int32:kind = raw IMPORT_WILDCARD();
    int32:alias = 0i32;
    int32:names = 0i32;
    if (raw p_accept(p, TokenKind.KwAs)) {
        kind = raw IMPORT_NAMESPACE();
        alias = ((raw p_advance(p)).payload) =>! int32;
    } else {
        if (raw p_accept(p, TokenKind.PDot)) {
            if (raw p_accept(p, TokenKind.OpStar)) {
                kind = raw IMPORT_WILDCARD();
            } else {
                if (raw p_accept(p, TokenKind.PLBrace)) {
                    kind = raw IMPORT_SELECTIVE();
                    while (!(raw p_at(p, TokenKind.PRBrace))) {
                        if (raw p_at_end(p)) { break; }
                        Token:n = raw p_advance(p);
                        drop ast_scratch_push(p.ast, n.payload =>! int32);
                        names = names + 1i32;
                        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
                    }
                    discard(raw p_expect(p, TokenKind.PRBrace));
                } else {
                    kind = raw IMPORT_SINGLE();
                    Token:n = raw p_advance(p);
                    drop ast_scratch_push(p.ast, n.payload =>! int32);
                    names = 1i32;
                }
            }
        }
    }
    discard(raw p_expect(p, TokenKind.PSemi));

    drop ast_scratch_set(p.ast, mark, 0i32, alias);
    drop ast_scratch_set(p.ast, mark, 1i32, segments);
    drop ast_scratch_set(p.ast, mark, 2i32, names);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclImportDecl, sp,
                             kind, w.start, w.count, path => int64));
};

// `mod:network = { … };` or `mod:network;` (D-088).
func:p_parse_mod = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwMod));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    IdSpan:members = raw idspan_empty();
    if (raw p_accept(p, TokenKind.OpAssign)) {
        members = raw p_parse_item_block(p);
    }
    // With no `=` the body is in network.npk: the same node with an empty member
    // list, which the module loader fills (MODULE_REFERENCE section 1.1).
    discard(raw p_expect(p, TokenKind.PSemi));
    IdSpan:none = raw idspan_empty();
    pass (raw p_finish_item(p, sp, DeclKind.DeclModuleDecl, flags,
                              name.payload, none, members, none, none));
};

func:p_parse_func = DeclId(Parser->:p, Span:sp, int32:flags, IdSpan:attrs) never fails {
    discard(raw p_expect(p, TokenKind.KwFunc));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    IdSpan:generics = raw p_parse_generics(p);

    discard(raw p_expect(p, TokenKind.OpAssign));
    // A RETURN TYPE MAY BE QUALIFIED. `func:malloc = wild any->(int64:size)` is
    // D-002's own example, and the qualifier belongs to the function rather than
    // to the type node (AST_REFERENCE section 4), so it joins the flags.
    flags = flags | (raw p_return_quals(p));
    // The declared type is the SUCCESS type. `Result<T>` is implicit, and the
    // wrapping is a semantic-phase concern -- the AST records what was written.
    TypeId:ret = raw p_parse_type(p);

    discard(raw p_expect(p, TokenKind.PLParen));
    int32:pmark = raw ast_scratch_mark(p.ast);
    int32:variadic = 0i32;
    while (true) {
        if (raw p_at(p, TokenKind.PRParen)) { break; }
        if (raw p_at_end(p)) { break; }
        if (raw p_at(p, TokenKind.OpDotDotStar)) {
            // `..*T[]:name` -- ONE variadic form, homogeneous and typed (D-070).
            // The format-directed form went with `fmt` itself (D-053), so there
            // is no second shape to tell apart from this one.
            Span:vs = raw p_span(p);
            discard(raw p_advance(p));
            TypeId:et = raw p_parse_type(p);
            discard(raw p_expect(p, TokenKind.PColon));
            Token:vn = raw p_advance(p);
            DeclId:v = raw ast_add_decl(p.ast, DeclKind.DeclVariadicSpec, vs,
                                          et.index, 0i32, 0i32, vn.payload);
            variadic = v.index;
            break;
        }
        DeclId:prm = raw p_parse_param(p);
        drop ast_scratch_push(p.ast, prm.index);
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    IdSpan:params = raw ast_scratch_commit(p.ast, pmark);
    discard(raw p_expect(p, TokenKind.PRParen));

    IdSpan:contracts = raw p_parse_contracts(p);

    int32:body = 0i32;
    if (raw p_at(p, TokenKind.PLBrace)) {
        // Absent in a trait declaration, which gives a signature and no body.
        body = (raw p_parse_block(p)).index;
    }
    discard(raw p_expect(p, TokenKind.PSemi));

    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, ret.index);
    drop ast_scratch_push(p.ast, body);
    drop ast_scratch_push(p.ast, variadic);
    drop ast_scratch_push(p.ast, generics.count);
    drop ast_scratch_push(p.ast, params.count);
    drop ast_scratch_push(p.ast, contracts.count);
    drop ast_scratch_push(p.ast, attrs.count);
    drop ast_copy_window(p.ast, generics);
    drop ast_copy_window(p.ast, params);
    drop ast_copy_window(p.ast, contracts);
    drop ast_copy_window(p.ast, attrs);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);

    pass (raw ast_add_decl(p.ast, DeclKind.DeclFunctionDecl, sp,
                             flags, w.start, w.count, name.payload));
};

// struct and enum: one shape, two member rules.
func:p_parse_record = DeclId(Parser->:p, Span:sp, int32:flags, IdSpan:attrs,
                             bool:is_struct) never fails {
    discard(raw p_advance(p));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    IdSpan:generics = raw p_parse_generics(p);
    discard(raw p_expect(p, TokenKind.OpAssign));
    discard(raw p_expect(p, TokenKind.PLBrace));

    int32:imark = raw ast_scratch_mark(p.ast);
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }
        int64:before = raw p_position(p);
        if (raw p_at(p, TokenKind.Hash)) {
            // A splice into a struct or enum body. Whether what it emits FITS is
            // expansion's question, not the parser's (D-085).
            Span:msp = raw p_span(p);
            DeclId:ms = raw p_parse_macro_splice(p, msp);
            drop ast_scratch_push(p.ast, ms.index);
        } else {
        if (is_struct) {
            DeclId:f = raw p_parse_field(p);
            drop ast_scratch_push(p.ast, f.index);
        } else {
            DeclId:v = raw p_parse_variant(p);
            drop ast_scratch_push(p.ast, v.index);
        }}
        drop p_recover(p);
        if ((raw p_position(p)) == before) { drop p_sync(p); }
    }
    IdSpan:members = raw ast_scratch_commit(p.ast, imark);
    discard(raw p_expect(p, TokenKind.PRBrace));
    discard(raw p_expect(p, TokenKind.PSemi));

    DeclKind:kind = DeclKind.DeclEnumDecl;
    if (is_struct) { kind = DeclKind.DeclStructDecl; }
    IdSpan:none = raw idspan_empty();
    pass (raw p_finish_item(p, sp, kind, flags, name.payload,
                              generics, members, attrs, none));
};

func:p_parse_field = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    // Slot `c` IS THE FLAGS SLOT on a field, on a parameter and on a global, so
    // one accessor shape reads all three rather than three conventions to recall.
    int32:quals = raw p_qualifiers(p);
    TypeId:ty = raw p_parse_type(p);
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclFieldDecl, sp,
                             ty.index, 0i32, quals, name.payload));
};

func:p_parse_variant = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    Token:name = raw p_advance(p);
    int32:value = 0i32;
    int32:pstart = 0i32;
    int32:pcount = 0i32;
    if (raw p_accept(p, TokenKind.PLParen)) {
        int32:mark = raw ast_scratch_mark(p.ast);
        if (!(raw p_at(p, TokenKind.PRParen))) {
            TypeId:t1 = raw p_parse_type(p);
            drop ast_scratch_push(p.ast, t1.index);
            while (raw p_accept(p, TokenKind.PComma)) {
                TypeId:tn = raw p_parse_type(p);
                drop ast_scratch_push(p.ast, tn.index);
            }
        }
        discard(raw p_expect(p, TokenKind.PRParen));
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pstart = w.start;
        pcount = w.count;
    } else {
        if (raw p_accept(p, TokenKind.OpAssign)) {
            value = (raw p_parse_expr(p)).index;
        }
    }
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclEnumVariant, sp,
                             value, pstart, pcount, name.payload));
};

// `trait:Ordered = Equatable & { … };` -- supertraits sit before the body, joined
// by `&`.
func:p_parse_trait = DeclId(Parser->:p, Span:sp, int32:flags, IdSpan:attrs) never fails {
    discard(raw p_expect(p, TokenKind.KwTrait));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    IdSpan:generics = raw p_parse_generics(p);
    discard(raw p_expect(p, TokenKind.OpAssign));

    int32:smark = raw ast_scratch_mark(p.ast);
    while (!(raw p_at(p, TokenKind.PLBrace))) {
        if (raw p_at_end(p)) { break; }
        TypeId:s = raw p_parse_type(p);
        drop ast_scratch_push(p.ast, s.index);
        if (!(raw p_accept(p, TokenKind.OpAmp))) { break; }
    }
    IdSpan:supers = raw ast_scratch_commit(p.ast, smark);

    IdSpan:members = raw p_parse_item_block(p);
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw p_finish_item(p, sp, DeclKind.DeclTraitDecl, flags, name.payload,
                              generics, members, attrs, supers));
};

// `impl:Point = { … };` / `impl:Message:Serializable = { … };`
func:p_parse_impl = DeclId(Parser->:p, Span:sp, int32:flags, IdSpan:attrs) never fails {
    discard(raw p_expect(p, TokenKind.KwImpl));
    discard(raw p_expect(p, TokenKind.PColon));

    // The generics window, then the target. `<T: P>` and nothing standing in
    // the target position was the blanket form until D-171; now every impl
    // names its target (below).
    IdSpan:generics = raw p_parse_generics(p);

    // SLOT 1 IS ALWAYS THE TARGET (D-031, made universal by D-171): the type
    // being implemented on, whether or not the impl declares parameters. An
    // optional second `:`-segment is the trait. A blanket impl names its target
    // too now — `impl:<T: P>:T:Loggable` — so there is one shape,
    // `impl:<params>:Target(:Trait)?`, and no segment count to read.
    int32:target = 0i32;
    int32:trait_ty = 0i32;
    if (generics.count == 0i32) {
        target = (raw p_parse_type(p)).index;
        if (raw p_accept(p, TokenKind.PColon)) {
            trait_ty = (raw p_parse_type(p)).index;
        }
    } else {
        // The generics window ends before the `:` that introduces the target.
        if (raw p_accept(p, TokenKind.PColon)) {
            target = (raw p_parse_type(p)).index;
            if (raw p_accept(p, TokenKind.PColon)) {
                trait_ty = (raw p_parse_type(p)).index;
            }
        }
    }
    discard(raw p_expect(p, TokenKind.OpAssign));
    IdSpan:members = raw p_parse_item_block(p);
    discard(raw p_expect(p, TokenKind.PSemi));

    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, target);
    drop ast_scratch_push(p.ast, trait_ty);
    drop ast_scratch_push(p.ast, members.count);
    drop ast_scratch_push(p.ast, attrs.count);
    drop ast_scratch_push(p.ast, generics.count);
    drop ast_copy_window(p.ast, generics);
    drop ast_copy_window(p.ast, members);
    drop ast_copy_window(p.ast, attrs);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclImplDecl, sp,
                             flags, w.start, w.count, 0i64));
};

// `assoc:Item;` declares, `assoc:Item = int32;` binds (D-028).
func:p_parse_assoc = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwAssoc));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    int32:def = 0i32;
    if (raw p_accept(p, TokenKind.OpAssign)) {
        def = (raw p_parse_type(p)).index;
    }
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclAssocTypeDecl, sp,
                             def, 0i32, flags, name.payload));
};

// `opaque struct:OpHandle;` -- no fields, no value semantics (D-066).
func:p_parse_opaque = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwOpaque));
    discard(raw p_expect(p, TokenKind.KwStruct));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclOpaqueDecl, sp,
                             flags, 0i32, 0i32, name.payload));
};

// `error:Name;` — one declared error constant (D-179). The Error type's
// values exist only by naming one of these. The prelude form carries an
// explicit code literal (`error:HeapIntegrity = 4102i32;` — the D-142
// magnitude; the SYSTEM domain owns the sign as an encoding detail);
// everywhere else the code is the compiler's to assign, and resolve refuses
// the explicit form outside the prelude.
func:p_parse_errdecl = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwError));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    int32:code = 0i32;
    if (raw p_accept(p, TokenKind.OpAssign)) {
        code = (raw p_parse_expr(p)).index;
    }
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclErrorDecl, sp,
                             flags, code, 0i32, name.payload));
};

// `unit:Hertz = 1 / Seconds;` — a named unit for `dim256<U>` (D-196, 1.3.3).
// The right-hand side parses as an ORDINARY EXPRESSION; resolve holds it to
// the unit algebra — names, `1`, `*`, `/`, parentheses — because the parser
// never restricts (D-085), and the refusal there can name the rule instead
// of this arm saying "expected".
func:p_parse_unitdecl = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwUnit));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    discard(raw p_expect(p, TokenKind.OpAssign));
    ExprId:rhs = raw p_parse_expr(p);
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclUnitDecl, sp,
                             flags, rhs.index, 0i32, name.payload));
};

// `Rules<int32>:r = { $ > 0i32 };`
// `Rules<int32>:r2 = { limit<r>, $ < 100i32 };`
func:p_parse_rules = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwRules));
    discard(raw p_expect(p, TokenKind.OpLt));
    TypeId:subject = raw p_parse_type(p);
    discard(raw p_expect_gt(p));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    discard(raw p_expect(p, TokenKind.OpAssign));
    discard(raw p_expect(p, TokenKind.PLBrace));

    // Refinements first, then predicates. Two lists in one window, and gathering
    // them in this order is what keeps them contiguous -- `limit<Other>` clauses
    // are conventionally written first, and one that appears later is still
    // stored with its own kind rather than being mistaken for a predicate.
    int32:rmark = raw ast_scratch_mark(p.ast);
    int32:refines = 0i32;
    int32:cmark = raw ast_scratch_mark(p.ast);
    int32:clauses = 0i32;
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }
        if (raw p_at(p, TokenKind.KwLimit)) {
            VerifyId:l = raw p_parse_limit(p);
            VerifyNode:ln = raw ast_verify(p.ast, l);
            drop ast_scratch_push(p.ast, raw limit_rule(ln));
            refines = refines + 1i32;
        } else {
            break;
        }
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }
        ExprId:c = raw p_parse_expr(p);
        drop ast_scratch_push(p.ast, c.index);
        clauses = clauses + 1i32;
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    IdSpan:body = raw ast_scratch_commit(p.ast, rmark);
    discard(raw p_expect(p, TokenKind.PRBrace));
    discard(raw p_expect(p, TokenKind.PSemi));

    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, refines);
    drop ast_scratch_push(p.ast, clauses);
    drop ast_copy_window(p.ast, body);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclRuleDecl, sp,
                             subject.index, w.start, w.count, name.payload));
};

// `macro:name = (params) { body };` (D-046). What expansion DOES with the body is
// cycle 0.6; the declaration's shape is fixed here.
func:p_parse_macro = DeclId(Parser->:p, Span:sp, int32:flags, IdSpan:attrs) never fails {
    discard(raw p_expect(p, TokenKind.KwMacro));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    discard(raw p_expect(p, TokenKind.OpAssign));
    discard(raw p_expect(p, TokenKind.PLParen));
    int32:pmark = raw ast_scratch_mark(p.ast);
    while (true) {
        if (raw p_at(p, TokenKind.PRParen)) { break; }
        if (raw p_at_end(p)) { break; }
        Token:pn = raw p_advance(p);
        drop ast_scratch_push(p.ast, pn.payload =>! int32);
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    IdSpan:params = raw ast_scratch_commit(p.ast, pmark);
    discard(raw p_expect(p, TokenKind.PRParen));
    // THE BODY HAS THREE SHAPES, AND WHAT IS WRITTEN DECIDES WHICH.
    //
    // A macro is not declared to be a declaration-macro or an expression-macro;
    // its body says. Declarations may be emitted at module level or spliced into
    // an `impl`; statements splice into a `struct` as fields; a single expression
    // stands where an expression does (`MACRO_REFERENCE.md` §1).
    //
    // WHAT STOOD HERE PARSED A BLOCK, which is a STATEMENT parser — so
    // `macro:m = () { func:g = …; };` did not parse at all, and emitting
    // declarations is the thing D-057 says macros exist for. It was not a
    // restriction anybody chose; it was the one body shape a statement parser
    // happens to accept.
    int32:bmark = raw ast_scratch_mark(p.ast);
    int32:bkind = raw MACRO_BODY_STMTS();
    int32:bcount = 0i32;
    int32:elo = raw ast_expr_count(p.ast);
    bool:has_decl = raw p_macro_body_has_decl(p);
    discard(raw p_expect(p, TokenKind.PLBrace));
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }
        int64:before = raw p_position(p);

        // `#` IS THE ONE ITEM START THAT DOES NOT SAY WHAT IT IS, and `has_decl`
        // above is what decides: in a declaration body it is a splice, in a
        // statement body it is an expression statement, and the window is read as
        // one kind or the other and never both.
        if (has_decl) {
            if (raw p_at_decl_start(p)) {
                bkind = raw MACRO_BODY_DECLS();
                DeclId:d = raw p_parse_decl(p);
                drop ast_scratch_push(p.ast, d.index);
            } else {
                StmtId:st = raw p_parse_stmt(p);
                drop ast_scratch_push(p.ast, st.index);
            }
        } else {
            StmtId:st2 = raw p_parse_stmt(p);
            drop ast_scratch_push(p.ast, st2.index);
        }
        bcount = bcount + 1i32;
        if ((raw p_position(p)) == before) { drop p_sync(p); }
    }
    IdSpan:body = raw ast_scratch_commit(p.ast, bmark);

    // EVERY EXPRESSION WRITTEN INSIDE THE BODY, MARKED. A macro body is the one
    // place an unexpanded `#name(...)` legitimately survives to the end of
    // expansion — it is a template, and it is consumed when the macro is CLONED,
    // not where it stands. The audit that refuses every other surviving invocation
    // has to be able to tell them apart.
    //
    // A CONTIGUOUS ID RANGE RATHER THAN A WALK, because parsing appends: every node
    // the body produced sits between the count before it and the count after, and a
    // range cannot have the hole a walk can. Clones do not inherit the mark, which
    // is right — a cloned body is program text now.
    int32:ehi = raw ast_expr_count(p.ast);
    int32:em = elo;
    while (em < ehi) {
        drop ast_set_expr_flag(p.ast, ExprId{ index: em }, raw HYG_IN_MACRO());
        em = em + 1i32;
    }
    discard(raw p_expect(p, TokenKind.PRBrace));
    discard(raw p_expect(p, TokenKind.PSemi));

    // ONE STATEMENT THAT IS AN EXPRESSION is the expression form. Recognised here
    // rather than at the invocation, because the invocation cannot see the body —
    // and a macro whose body is one expression is what stands in expression
    // position.
    if (bkind == (raw MACRO_BODY_STMTS())) {
        if (bcount == 1i32) {
            StmtNode:only = raw ast_stmt(p.ast, StmtId{ index: raw ast_id_at(p.ast, body.start, 0i32) });
            if (only.kind == StmtKind.StmtExprStmt) { bkind = raw MACRO_BODY_EXPR(); }
        }
    }

    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, bkind);
    drop ast_scratch_push(p.ast, bcount);
    drop ast_scratch_push(p.ast, params.count);
    drop ast_scratch_push(p.ast, attrs.count);
    drop ast_copy_window(p.ast, body);
    drop ast_copy_window(p.ast, params);
    drop ast_copy_window(p.ast, attrs);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclMacroDecl, sp,
                             flags, w.start, w.count, name.payload));
};

// `#name(args);` standing where a declaration is expected.
func:p_parse_macro_splice = DeclId(Parser->:p, Span:sp) never fails {
    ExprId:inv = raw p_parse_expr(p);
    discard(raw p_expect(p, TokenKind.PSemi));
    pass (raw ast_add_decl(p.ast, DeclKind.DeclMacroSplice, sp,
                             inv.index, 0i32, 0i32, 0i64));
};

// `extern:"libc" = { … };` (D-088). Its items are `ExternFn`, not ordinary
// functions, because each carries a mandatory failure contract (D-002).
//
// The name slot holds a STRING rather than an identifier, because a library name
// is not one -- `libc++`, a bare `m`, a path. That is a value in the name
// position, not a second shape.
func:p_parse_extern = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    discard(raw p_expect(p, TokenKind.KwExtern));
    discard(raw p_expect(p, TokenKind.PColon));
    int32:lib = 0i32;
    if (raw p_at(p, TokenKind.StringLit)) {
        lib = ((raw p_advance(p)).payload) =>! int32;
    }
    discard(raw p_expect(p, TokenKind.OpAssign));
    discard(raw p_expect(p, TokenKind.PLBrace));
    int32:mark = raw ast_scratch_mark(p.ast);
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }
        int64:before = raw p_position(p);
        if (raw p_at(p, TokenKind.KwOpaque)) {
            DeclId:o = raw p_parse_opaque(p, raw p_span(p), 0i32);
            drop ast_scratch_push(p.ast, o.index);
        } else {
            DeclId:f = raw p_parse_extern_fn(p);
            drop ast_scratch_push(p.ast, f.index);
        }
        drop p_recover(p);
        if ((raw p_position(p)) == before) { drop p_sync(p); }
    }
    discard(raw p_expect(p, TokenKind.PRBrace));
    discard(raw p_expect(p, TokenKind.PSemi));
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclExternBlock, sp,
                             flags, w.start, w.count, lib => int64));
};

func:p_parse_extern_fn = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    discard(raw p_expect(p, TokenKind.KwFunc));
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    discard(raw p_expect(p, TokenKind.OpAssign));
    int32:flags = raw p_return_quals(p);
    TypeId:ret = raw p_parse_type(p);
    discard(raw p_expect(p, TokenKind.PLParen));
    int32:pmark = raw ast_scratch_mark(p.ast);
    int32:pcount = 0i32;
    while (true) {
        if (raw p_at(p, TokenKind.PRParen)) { break; }
        if (raw p_at_end(p)) { break; }
        if (raw p_accept(p, TokenKind.OpDotDotStar)) {
            flags = flags | (raw DECL_VARIADIC());
            break;
        }
        DeclId:prm = raw p_parse_param(p);
        drop ast_scratch_push(p.ast, prm.index);
        pcount = pcount + 1i32;
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    IdSpan:params = raw ast_scratch_commit(p.ast, pmark);
    discard(raw p_expect(p, TokenKind.PRParen));

    DeclId:failure = raw p_parse_failure(p);
    discard(raw p_expect(p, TokenKind.PSemi));

    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, ret.index);
    drop ast_scratch_push(p.ast, failure.index);
    drop ast_scratch_push(p.ast, pcount);
    drop ast_copy_window(p.ast, params);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclExternFn, sp,
                             flags, w.start, w.count, name.payload));
};

// The failure contract is REQUIRED, and this is where D-002 is enforced: silence
// must not become a silent `Ok`. `never fails` exists so that "this C function is
// infallible" is a claim someone wrote down and a reviewer can audit, rather than
// a default nobody chose.
//
// Refusing it HERE, in the grammar, is deliberate and does not contradict "the
// parser never restricts" (D-085). D-085 is about constructs the backend cannot
// yet lower. This is not one: an `extern` function without a contract is not a
// construct at all, because the contract is part of its shape and there is no
// node to build without one.
func:p_parse_failure = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    if (raw p_accept(p, TokenKind.KwNever)) {
        discard(raw p_expect(p, TokenKind.KwFails));
        pass (raw ast_add_decl(p.ast, DeclKind.DeclNeverFails, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }
    if (raw p_accept(p, TokenKind.KwFails)) {
        discard(raw p_expect(p, TokenKind.KwOn));
        // Unparenthesised, matching `requires` / `ensures`.
        ExprId:pred = raw p_parse_expr(p);
        int32:errno = 0i32;
        if (raw p_accept(p, TokenKind.KwWith)) {
            discard(raw p_advance(p));
            errno = 1i32;
        }
        pass (raw ast_add_decl(p.ast, DeclKind.DeclFailsOn, sp,
                                 pred.index, errno, 0i32, 0i64));
    }
    // THE BRIDGE LANDED (1.1.13c), AND D-002's REQUIREMENT LIFTS AS D-149
    // SCHEDULED: a driver method carries NO per-function contract — the wire
    // has one universal failure convention, so the contract-less spelling is
    // the legal one, and a contract still WRITTEN is refused by name in the
    // expansion phase (NITPICK-EXTERN-002), where the stubs are generated.
    // The two productions above stay parsed (the parser never restricts,
    // D-085); only the mandatory-ness ends, exactly as the retired message
    // said it would.
    pass (raw decl_none());
};

func:p_parse_global = DeclId(Parser->:p, Span:sp, int32:flags) never fails {
    int32:quals = raw p_qualifiers(p);
    TypeId:ty = raw p_parse_type(p);
    discard(raw p_expect(p, TokenKind.PColon));
    Token:name = raw p_advance(p);
    int32:init = 0i32;
    if (raw p_accept(p, TokenKind.OpAssign)) {
        init = (raw p_parse_expr(p)).index;
    }
    discard(raw p_expect(p, TokenKind.PSemi));
    // `flags` (the `pub`) rides the high half of the qualifier slot -- `a` is
    // the type, `b` the initialiser, `payload` the name, and nothing else is
    // free. Dropped on the floor until 1.4.8 (see `decl_flags`).
    pass (raw ast_add_decl(p.ast, DeclKind.DeclGlobalDecl, sp,
                             ty.index, init, quals | (flags << 16i32), name.payload));
};

// --- shared helpers ----------------------------------------------------------------------------------

func:p_parse_item_block = IdSpan(Parser->:p) never fails {
    discard(raw p_expect(p, TokenKind.PLBrace));
    int32:mark = raw ast_scratch_mark(p.ast);
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }
        int64:before = raw p_position(p);
        DeclId:item = raw p_parse_decl(p);
        drop ast_scratch_push(p.ast, item.index);
        drop p_recover(p);
        if ((raw p_position(p)) == before) { drop p_sync(p); }
    }
    discard(raw p_expect(p, TokenKind.PRBrace));
    pass (raw ast_scratch_commit(p.ast, mark));
};

func:p_finish_item = DeclId(Parser->:p, Span:sp, DeclKind:kind, int32:flags,
                            int64:name, IdSpan:generics, IdSpan:members,
                            IdSpan:attrs, IdSpan:extras) never fails {
    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, generics.count);
    drop ast_scratch_push(p.ast, members.count);
    drop ast_scratch_push(p.ast, attrs.count);
    drop ast_scratch_push(p.ast, extras.count);
    drop ast_copy_window(p.ast, generics);
    drop ast_copy_window(p.ast, members);
    drop ast_copy_window(p.ast, attrs);
    drop ast_copy_window(p.ast, extras);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, kind, sp, flags, w.start, w.count, name));
};

// --- a whole file -------------------------------------------------------------------------------------

// A source file parses to a ModuleDecl (AST_REFERENCE section 1), so the top
// level is not a special case with a loop of its own -- it is a module whose name
// is the reserved empty intern index.
pub func:p_parse_module = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    int32:mark = raw ast_scratch_mark(p.ast);
    while (!(raw p_at_end(p))) {
        int64:before = raw p_position(p);
        DeclId:item = raw p_parse_decl(p);
        drop ast_scratch_push(p.ast, item.index);
        drop p_recover(p);
        if ((raw p_position(p)) == before) { drop p_sync(p); }
    }
    IdSpan:members = raw ast_scratch_commit(p.ast, mark);
    IdSpan:none = raw idspan_empty();
    pass (raw p_finish_item(p, sp, DeclKind.DeclModuleDecl, 0i32, 0i64,
                              none, members, none, none));
};
