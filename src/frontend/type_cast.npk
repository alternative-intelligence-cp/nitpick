// Casts — `=>` and `=>!`.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.3.
//
// `=>` CONVERTS ONLY WHEN NOTHING CAN BE LOST. Not when nothing IS lost — when
// nothing CAN be. The check is on types, the value is not known, and
// `int64 => int32` is refused whatever number happens to be in the variable.
//
// `=>!` is the sole opt-out (D-021), deliberately ugly and greppable so that an
// audit for lossy conversions is a search for one token. There is no third
// spelling: `cast<T>`, `#cast<T>` and `@cast<T>` do not exist.
//
// This module carries most of the weight now that implicit widening is gone
// (D-092, corrected) — a cast is the ONLY way to combine operands of different
// widths, so getting the lossless set exactly right is what decides whether
// ordinary arithmetic is writable.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./type_names.npk".*;

// --- what a type can hold ----------------------------------------------------------------
//
// A range as two facts rather than two numbers, because the numbers do not fit:
// `int4096` is a real type and its bounds are not expressible in anything this
// compiler can compute with. Every question casting asks can be answered from
// the magnitude and the sign.
pub struct:ValueRange = {
    bool:valid;        // false when the type holds no numbers at all
    bool:negatives;    // can it represent a value below zero
    int32:mag_bits;    // bits of magnitude, excluding any sign
};

func:vr = ValueRange(bool:negatives, int32:mag_bits) never fails {
    ValueRange:r = ValueRange{ valid: true, negatives: negatives,
                               mag_bits: mag_bits };
    pass r;
};

func:vr_none = ValueRange() never fails {
    ValueRange:r = ValueRange{ valid: false, negatives: false, mag_bits: 0i32 };
    pass r;
};

// HOW MANY INTEGERS A FLOAT REPRESENTS EXACTLY — its significand width, which is
// the only thing that matters for whether a conversion into it can lose.
//
// The spec names `flt32`, `flt64` and `flt128` against C's `float`, `double` and
// `fp128`, and names `flt256` and `flt512` without saying what they are. Rather
// than guess, these follow **IEEE 754-2008 §3.6**, which defines the binary
// interchange format for every width that is a multiple of 32 at or above 128:
// the exponent field is `round(4 * log2(k)) - 13` bits, and the significand is
// what remains plus the implicit leading bit.
//
//   binary32   exponent  8   significand  24
//   binary64   exponent 11   significand  53
//   binary128  exponent 15   significand 113
//   binary256  exponent 19   significand 237
//   binary512  exponent 23   significand 489
//
// A guess here would not be visible as a guess: it would silently accept or
// refuse conversions at the two widest types and nothing would contradict it.
pub func:float_significand_bits = int32(int32:bits) never fails {
    if (bits == 32i32)  { pass 24i32; }
    if (bits == 64i32)  { pass 53i32; }
    if (bits == 128i32) { pass 113i32; }
    if (bits == 256i32) { pass 237i32; }
    if (bits == 512i32) { pass 489i32; }
    pass 0i32;
};

// The largest Unicode scalar value is U+10FFFF, which needs 21 bits — and NOT
// every 21-bit value is one, because the surrogate range D800..DFFF is excluded.
// So `char32` is the one type whose validity is not a question about width, and
// `uint32 => char32` is refused for that reason rather than for a range reason.
pub func:CHAR32_MAG_BITS = int32() never fails { pass 21i32; };

pub func:type_range = ValueRange(TypeTable->:tyt, int32:t) never fails {
    int32:k = raw type_kind(tyt, t);
    int32:bits = raw type_int_bits(tyt, t);

    if (k == (raw TY_INT())) {
        if (raw type_is_signed(tyt, t)) { pass (raw vr(true, bits - 1i32)); }
        pass (raw vr(false, bits));
    }
    // A `tbb`'s valid range is SYMMETRIC about zero: the most negative value is
    // the ERR sentinel and is excluded (D-008 §1), which is the "balanced" in
    // Twisted Balanced Binary. So `tbbN` holds magnitudes up to `2^(N-1) - 1`,
    // the same as `intN` minus one value.
    if (k == (raw TY_TBB()))   { pass (raw vr(true, bits - 1i32)); }
    // A `tfp`'s INTEGER magnitude — Q(I).(F) holds |v| < 2^(I-1) (D-195).
    // Its own casts are classified by the dedicated arms above; this row
    // exists so the lossy DIAGNOSTIC explains the right direction.
    if (k == (raw TY_TFP()))   { pass (raw vr(true, (bits / 2i32) - 1i32)); }
    // A `dim256` is a tfp256 with a unit (D-196) — same magnitude row, same
    // diagnostic-only purpose; its casts are the dedicated arms'.
    if (k == (raw TY_DIM()))   { pass (raw vr(true, (bits / 2i32) - 1i32)); }
    if (k == (raw TY_FLOAT())) { pass (raw vr(true, raw float_significand_bits(bits))); }
    if (k == (raw TY_BOOL()))  { pass (raw vr(false, 1i32)); }
    if (k == (raw TY_CHAR())) {
        if (bits == 32i32) { pass (raw vr(false, raw CHAR32_MAG_BITS())); }
        pass (raw vr(false, bits));
    }
    // The five kernel identifiers are 32-bit handles (D-042). Their NUMBER is an
    // ordinary integer even though the type is not.
    if (k == (raw TY_KERNEL())) { pass (raw vr(true, 31i32)); }
    pass (raw vr_none());
};

// CAN EVERY VALUE OF `from` BE REPRESENTED IN `to`?
//
// Computed from the ranges rather than from a table of type families, and the
// difference is not academic: `uint8 => int16` is lossless — every value 0..255
// sits inside -32768..32767 — and a "same signedness only" rule would refuse it
// and force `=>!`.
//
// That matters because **`=>!` is an audit tool**. Every provably-safe conversion
// pushed into it is a false positive in the one search an auditor runs to find
// the dangerous ones, and a signal diluted is a signal lost.
pub func:range_fits = bool(ValueRange:from, ValueRange:to) never fails {
    if (!from.valid) { pass false; }
    if (!to.valid)   { pass false; }
    if (from.negatives) {
        if (!to.negatives) { pass false; }
    }
    pass (from.mag_bits <= to.mag_bits);
};

// --- what a cast is allowed to do at all ---------------------------------------------------
//
// Three answers, not two. A conversion can be checked-legal, unchecked-only, or
// not a conversion at all — and collapsing the last two would let `=>!` invent
// semantics that do not exist rather than opt out of a check that does.
pub func:CAST_OK = int32() never fails        { pass 0i32; };  // `=>` accepts it
pub func:CAST_LOSSY = int32() never fails     { pass 1i32; };  // `=>!` only
pub func:CAST_IMPOSSIBLE = int32() never fails{ pass 2i32; };  // neither; there is no such conversion

pub func:cast_class = int32(TypeTable->:tyt, int32:from, int32:to) never fails {
    // A type failing to resolve already produced a diagnostic (0.4.1).
    if (raw type_is_invalid(tyt, from)) { pass (raw CAST_OK()); }
    if (raw type_is_invalid(tyt, to))   { pass (raw CAST_OK()); }

    // A cast to the same type is a no-op and always fine — including for the
    // types below that convert to nothing else.
    if (from == to) { pass (raw CAST_OK()); }

    int32:fk = raw type_kind(tyt, from);
    int32:tk = raw type_kind(tyt, to);

    // --- `simd` casts are ELEMENTWISE (D-194) -----------------------------------
    //
    // Same lane count on both sides — a cast never changes N (the splat
    // constructor is the one broadcast, and nothing narrows lanes) — and the
    // class is the ELEMENT pair's own class: what `=>` accepts scalar-to-
    // scalar it accepts lane-to-lane, `=>!` likewise, and a pair with no
    // scalar conversion has no vector one.
    if (fk == (raw TY_SIMD())) {
        if (tk != (raw TY_SIMD())) { pass (raw CAST_IMPOSSIBLE()); }
        if (((raw tt_get(tyt, from)).b) != ((raw tt_get(tyt, to)).b)) {
            pass (raw CAST_IMPOSSIBLE());
        }
        pass (raw cast_class(tyt, raw type_elem(tyt, from),
                             raw type_elem(tyt, to)));
    }
    if (tk == (raw TY_SIMD())) { pass (raw CAST_IMPOSSIBLE()); }

    // --- `bool` is not a small integer, in either direction ---------------------
    //
    // `bool => uint8` has an obvious meaning and loses nothing, so it is allowed.
    //
    // `intN => bool` is REFUSED OUTRIGHT, and `=>!` does not rescue it. This is
    // not a conversion that loses information — it is a conversion that has no
    // definition. Which integers are true? C answers "everything but zero" and
    // that answer is the truthiness this language does not have (0.4.2). `=>!`
    // exists to opt out of a CHECK, not to invent a meaning.
    if (tk == (raw TY_BOOL())) { pass (raw CAST_IMPOSSIBLE()); }

    // --- `dim256` has ONE cast boundary (D-196, 1.3.3) ---------------------------
    //
    // `dim => tfp256` DROPS the unit — always safe, an IR no-op; `tfp256 =>!
    // dim<U>` ASSERTS one — the acknowledged form, refused without the bang,
    // because a silent unit-gain is how unit bugs are born. Everything else —
    // dim⇄dim, dim⇄int/flt/narrower-tfp — is not a conversion: a relabel is
    // spelled as its two honest halves through `tfp256`. ERR RIDES both legal
    // crossings — relabeling never leaves the twisted family, so the D-144
    // leaving trap does not apply, and the sentinel is the same bit pattern
    // on both sides. BEFORE the `tfp` arms below, which would otherwise
    // swallow both directions as "no conversion".
    if (fk == (raw TY_DIM())) {
        if (tk == (raw TY_TFP())) {
            if ((raw type_int_bits(tyt, to)) == 256i32) { pass (raw CAST_OK()); }
        }
        pass (raw CAST_IMPOSSIBLE());
    }
    if (tk == (raw TY_DIM())) {
        if (fk == (raw TY_TFP())) {
            if ((raw type_int_bits(tyt, from)) == 256i32) { pass (raw CAST_LOSSY()); }
        }
        pass (raw CAST_IMPOSSIBLE());
    }

    // --- `tfp` casts (D-195) — value conversions under the sentinel discipline --
    //
    // Within the family: widening keeps every value (the raw shifts up by the
    // F difference; ERR maps to ERR) so `=>` accepts it; narrowing loses
    // precision, `=>!`. Leaving the family drops the fraction (`=>! intN`,
    // §5's own rule) or precision (`=>!` to a float — except `tfp32 => flt64`,
    // whose 32 raw bits fit a 53-bit mantissa losslessly). Entering it from an
    // integer is lossless exactly when the integer's whole range fits the
    // Q integer half (B < I; the balanced range excludes the one extra
    // negative value, which is why B == I does not fit); from a float it is
    // always `=>!`. `tbb` and everything else has no conversion at all — the
    // raw bits mean different VALUES (scale 2^F), so a reinterpretation would
    // be a forgery, not a cast.
    if (fk == (raw TY_TFP())) {
        int32:fb = raw type_int_bits(tyt, from);
        if (tk == (raw TY_TFP())) {
            if ((raw type_int_bits(tyt, to)) > fb) { pass (raw CAST_OK()); }
            pass (raw CAST_LOSSY());
        }
        if (tk == (raw TY_INT())) { pass (raw CAST_LOSSY()); }
        if (tk == (raw TY_FLOAT())) {
            int32:tfb = raw type_int_bits(tyt, to);
            if (tfb > 64i32) { pass (raw CAST_IMPOSSIBLE()); }
            if (fb == 32i32) {
                if (tfb == 64i32) { pass (raw CAST_OK()); }
            }
            pass (raw CAST_LOSSY());
        }
        pass (raw CAST_IMPOSSIBLE());
    }
    if (tk == (raw TY_TFP())) {
        int32:tb = raw type_int_bits(tyt, to);
        if (fk == (raw TY_INT())) {
            int32:sb = raw type_int_bits(tyt, from);
            if (raw type_is_signed(tyt, from)) {
                if (sb < (tb / 2i32)) { pass (raw CAST_OK()); }
            } else {
                if (sb < (tb / 2i32)) { pass (raw CAST_OK()); }
            }
            pass (raw CAST_LOSSY());
        }
        if (fk == (raw TY_FLOAT())) {
            if ((raw type_int_bits(tyt, from)) > 64i32) { pass (raw CAST_IMPOSSIBLE()); }
            pass (raw CAST_LOSSY());
        }
        pass (raw CAST_IMPOSSIBLE());
    }

    // --- `tbb` is never a straight bit operation (D-008 §6) ----------------------
    //
    // ERR is a DIFFERENT BIT PATTERN AT EVERY WIDTH, so sign-extension and
    // truncation are both wrong: `tbb8`'s ERR is -128, and sign-extended to
    // `tbb32` that is an ordinary valid number. Every cast touching a `tbb` is a
    // conversion with a sentinel test in it, which the backend must emit and
    // which 0.7 lowers.
    if (fk == (raw TY_TBB())) { pass (raw cast_from_tbb(tyt, from, to, tk)); }
    if (tk == (raw TY_TBB())) { pass (raw cast_to_tbb(tyt, from, fk)); }

    // --- a handle's number is readable; a handle is not forgeable ----------------
    //
    // `fd => int32` loses nothing — it reads the number, which is what D-093 tells
    // the programmer to do when the number is what they mean.
    //
    // `int32 => fd` goes the other way and asserts something the compiler cannot
    // check: that this number is a live descriptor. That is exactly the `=>!`
    // contract, and it keeps "where does this code manufacture a handle" a grep.
    // `nlibc` needs it — a syscall returns an integer that has to become an `fd`
    // — and it should be the only place that does.
    //
    // ONLY AN INTEGER (1.0.8). This admitted ANY source — `Point =>! fd`,
    // `string =>! fd`, a pointer, a float — because the arm tested the target
    // alone; D-095 and the paragraph above license `int32 =>! fd` and nothing
    // else, and a struct asserted into a descriptor is not an opt-out of a
    // check, it is a value with no meaning as one.
    if (tk == (raw TY_KERNEL())) {
        if (fk == (raw TY_INT())) { pass (raw CAST_LOSSY()); }
        pass (raw CAST_IMPOSSIBLE());
    }

    // --- pointers ------------------------------------------------------------------
    //
    // `any-> => T->` REQUIRES `=>!`, and this departs from TYPE_REFERENCE §27,
    // which spells it with `=>`. The reason is that `=>` means "nothing can be
    // lost and the compiler proved it", and nothing is proven here: an `any->` is
    // type-erased, so giving it a type is an assertion about memory the checker
    // cannot see. Calling that a checked cast is a lie about which of the two
    // spellings is doing the work.
    if (tk == (raw TY_POINTER())) {
        if (fk == (raw TY_POINTER())) { pass (raw CAST_LOSSY()); }
        pass (raw CAST_IMPOSSIBLE());
    }
    if (fk == (raw TY_POINTER())) { pass (raw CAST_IMPOSSIBLE()); }

    // --- enums: the tag is readable, a variant is not forgeable -------------------
    //
    // `enum =>! intN` READS THE TAG — `=>!` is the spelling for "I know what this
    // does", and reading identity as a number loses nothing; what it costs is the
    // bang, because treating identity as quantity IS an assertion. `enum => intN`
    // is therefore LOSSY, never OK.
    //
    // `intN => enum` is IMPOSSIBLE in both spellings, and the reason is not loss:
    // that direction FABRICATES a value that may be no variant at all, and every
    // `pick` the exhaustiveness analysis proved complete would silently miss it.
    // The asymmetry has precedent one block up: `fd => int32` reads the number,
    // `int32 =>! fd` manufactures a handle and is confined to `nlibc` — but an
    // `fd` carries no exhaustiveness promise, and an enum does.
    if (fk == (raw TY_ENUM())) {
        if (tk == (raw TY_INT())) { pass (raw CAST_LOSSY()); }
        pass (raw CAST_IMPOSSIBLE());
    }
    // `intN =>! enum` MANUFACTURES A TAG, and the first draft refused it outright
    // on the exhaustiveness argument. The compiler's own source overruled the
    // draft within one subcycle: a stored tag has to ROUND-TRIP (`payload =>!
    // TokenKind`, 88 sites), which is precisely the `int32 =>! fd` contract — an
    // assertion the compiler cannot check, spelled with the bang, greppable. A
    // forged tag makes every arm of a proven `pick` miss and the statement fall
    // through; that is the programmer's explicit lie, not the checker's gap.
    // A PAYLOAD-CARRYING target still refuses AT THE BACKEND: a tag is not a
    // whole `{tag, payload}` value, and inventing the other half is not a cast.
    if (tk == (raw TY_ENUM())) {
        if (fk == (raw TY_INT())) { pass (raw CAST_LOSSY()); }
        pass (raw CAST_IMPOSSIBLE());
    }

    // --- everything numeric, by range --------------------------------------------
    ValueRange:fr = raw type_range(tyt, from);
    ValueRange:tr = raw type_range(tyt, to);
    if (!fr.valid) { pass (raw CAST_IMPOSSIBLE()); }
    if (!tr.valid) { pass (raw CAST_IMPOSSIBLE()); }

    // A FLOAT TO AN INTEGER ALWAYS LOSES, whatever the widths. `flt64 => int128`
    // has room for every magnitude and still drops the fractional part, which is
    // information the source had. Range containment cannot see that, so it is
    // stated rather than computed.
    if (fk == (raw TY_FLOAT())) {
        if (tk != (raw TY_FLOAT())) { pass (raw CAST_LOSSY()); }
    }

    if (raw range_fits(fr, tr)) { pass (raw CAST_OK()); }
    pass (raw CAST_LOSSY());
};

// `tbbN => X`. Within the family every width pair is legal in both spellings
// and the SENTINEL maps — ERR is a state, not a number, and the narrowing
// trap/saturation is the type's own discipline (D-008 §3, D-144). LEAVING the
// family, two separate questions, answered separately (D-144 as amended at
// 1.3.2, aligning with tfp's D-195 rule):
//
// - The TAINT: ERR has no image anywhere outside a twisted family, so it
//   TRAPS (−4100) under BOTH spellings. What `=>!` acknowledges is the
//   VALUE's loss; ERR is not a value (D-008 §1), and no acknowledgment
//   converts a taint. Until 1.3.2 the bang read the carrier raw — ERR
//   crossed as INT_MIN, a laundering path.
// - The VALUE: classified by RANGE like every numeric pair, so `tbb64 =>
//   int8` and `tbb32 => uint32` take the bang exactly as `int64 => int8`
//   and `int32 => uint32` would. Until 1.3.2 every int/float target was
//   CAST_OK and the emitter resized the carrier raw — a silent width/sign
//   loss under the checked spelling.
func:cast_from_tbb = int32(TypeTable->:tyt, int32:from, int32:to, int32:tk) never fails {
    if (tk == (raw TY_TBB())) { pass (raw CAST_OK()); }
    if (tk == (raw TY_INT())) {
        ValueRange:fr = raw type_range(tyt, from);
        ValueRange:tr = raw type_range(tyt, to);
        if (raw range_fits(fr, tr)) { pass (raw CAST_OK()); }
        pass (raw CAST_LOSSY());
    }
    if (tk == (raw TY_FLOAT())) {
        ValueRange:fr2 = raw type_range(tyt, from);
        ValueRange:tr2 = raw type_range(tyt, to);
        if (raw range_fits(fr2, tr2)) { pass (raw CAST_OK()); }
        pass (raw CAST_LOSSY());
    }
    pass (raw CAST_IMPOSSIBLE());
};

// `X => tbbN`. A source value equal to the target's ERR sentinel would FORGE A
// TAINT — a number arriving from outside claiming to be an error state — so it
// traps, and everything else is range-checked.
func:cast_to_tbb = int32(TypeTable->:tyt, int32:from, int32:fk) never fails {
    if (fk == (raw TY_INT()))   { pass (raw CAST_OK()); }
    if (fk == (raw TY_FLOAT())) { pass (raw CAST_OK()); }
    pass (raw CAST_IMPOSSIBLE());
};

// --- the diagnostic ------------------------------------------------------------------------

pub func:check_cast = int32(TypeTable->:tyt, InternTable->:interns, DiagList->:diags,
                            int32:from, int32:to, bool:unchecked, Span:at) never fails {
    int32:c = raw cast_class(tyt, from, to);

    if (c == (raw CAST_OK())) {
        // `=>!` WHERE `=>` WOULD DO is not an error, and saying so would be
        // wrong: it is how a programmer writes a conversion whose safety they do
        // not want to depend on the two types staying as they are.
        pass to;
    }

    if (c == (raw CAST_LOSSY())) {
        if (unchecked) { pass to; }
        string:m1 = raw string_concat("`", raw type_display(tyt, interns, from));
        // "DOES NOT FIT … CAN LOSE INFORMATION" IS A RANGE FACT (1.0.8), true
        // of the numeric narrowings and false of the four classes `cast_class`
        // marks unchecked for another reason — a handle, a pointer, an enum's
        // tag in either direction lose nothing; what they need is the bang
        // because the conversion ASSERTS something. The lead-in says which.
        string:m4 = "";
        if (raw cast_is_assertion(tyt, from, to)) {
            string:a2 = raw string_concat(m1, "` => `");
            string:a3 = raw string_concat(a2, raw type_display(tyt, interns, to));
            m4 = raw string_concat(a3, "` is not a checked conversion: ");
        } else {
            string:m2 = raw string_concat(m1, "` does not fit in `");
            string:m3 = raw string_concat(m2, raw type_display(tyt, interns, to));
            m4 = raw string_concat(m3, "`, so this conversion can lose information: ");
        }
        m4 = raw string_concat(m4, raw why_lossy(tyt, from, to));
        m4 = raw string_concat(m4, ". Write `=>!` to accept that.");
        drop diaglist_push(diags, raw diag_error(raw TYPE_LOSSY_CAST(), move(m4), at));
        pass to;
    }

    // CAST_IMPOSSIBLE — and `=>!` does NOT rescue it, because there is nothing
    // here to opt out of. The message says so, since a programmer who reaches for
    // `=>!` after a lossy-cast error will reach for it again here.
    string:n1 = raw string_concat("there is no conversion from `",
                                    raw type_display(tyt, interns, from));
    string:n2 = raw string_concat(n1, "` to `");
    string:n3 = raw string_concat(n2, raw type_display(tyt, interns, to));
    string:n4 = raw string_concat(n3, "`: ");
    n4 = raw string_concat(n4, raw why_impossible(tyt, from, to));
    n4 = raw string_concat(n4, ". `=>!` does not help — it opts out of a check, not of a meaning.");
    drop diaglist_push(diags, raw diag_error(raw TYPE_NO_CAST(), move(n4), at));
    pass to;
};

// The reason, not just the refusal. Which of two familiar-looking widths was too
// small is the whole content of the message.
// Is this `=>!`-only conversion one that loses nothing and ASSERTS something
// instead — a handle manufactured, a pointer retyped, a tag read or forged?
// The lead-in of the refusal reads differently for those (1.0.8).
pub func:cast_is_assertion = bool(TypeTable->:tyt, int32:from, int32:to) never fails {
    int32:fk = raw type_kind(tyt, from);
    int32:tk = raw type_kind(tyt, to);
    if (tk == (raw TY_KERNEL()))  { pass true; }
    if (tk == (raw TY_POINTER())) { pass true; }
    if (fk == (raw TY_ENUM()))    { pass true; }
    if (tk == (raw TY_ENUM()))    { pass true; }
    // `tfp256 =>! dim256<U>` loses no bits — it asserts a UNIT onto a bare
    // number (D-196), which nothing here can check was measured in it.
    if (tk == (raw TY_DIM()))     { pass true; }
    pass false;
};

pub func:why_lossy = string(TypeTable->:tyt, int32:from, int32:to) never fails {
    int32:fk = raw type_kind(tyt, from);
    int32:tk = raw type_kind(tyt, to);
    if (fk == (raw TY_FLOAT())) {
        if (tk == (raw TY_FLOAT())) {
            pass "the narrower float carries fewer significand bits and a smaller exponent range, so precision and magnitude can both be lost";
        }
        pass "the fractional part has nowhere to go";
    }
    if (tk == (raw TY_KERNEL())) {
        pass "a kernel identifier cannot be manufactured from a number the compiler has not seen the kernel return (D-042)";
    }
    if (tk == (raw TY_DIM())) {
        pass "this asserts a physical unit onto a bare number (D-196), and nothing here can check the number was measured in it";
    }
    if (tk == (raw TY_POINTER())) {
        if ((raw type_kind(tyt, raw type_elem(tyt, from))) == (raw TY_ANY())) {
            pass "giving a type-erased pointer a type is an assertion about memory that nothing here can check";
        }
        pass "reinterpreting what a pointer points at is an assertion about memory that nothing here can check";
    }
    // AN ENUM'S TAG, READ OR FORGED (1.0.8). These fell through to the range
    // sentences — "the target is narrower", "the source can be negative" —
    // because an enum has no value range; the reasons are the ones
    // `cast_class` gives in its own comments.
    if (fk == (raw TY_ENUM())) {
        pass "this reads a variant's tag as a number — identity treated as quantity, which is an assertion rather than a conversion";
    }
    if (tk == (raw TY_ENUM())) {
        pass "this manufactures a tag, and nothing checks that the number names a variant — a `pick` proven complete would miss it";
    }
    ValueRange:fr = raw type_range(tyt, from);
    ValueRange:tr = raw type_range(tyt, to);
    if (fr.negatives) {
        if (!tr.negatives) {
            pass "the source can be negative and the target cannot, so those values would come back as large positive ones";
        }
    }
    if (tk == (raw TY_CHAR())) {
        if ((raw type_int_bits(tyt, to)) == 32i32) {
            pass "not every 32-bit number is a Unicode scalar value — the surrogate range is excluded and the maximum is U+10FFFF";
        }
    }
    if (tk == (raw TY_FLOAT())) {
        pass "a float represents integers exactly only up to its significand width, and this source is wider than that";
    }
    pass "the target is narrower than the source";
};

pub func:why_impossible = string(TypeTable->:tyt, int32:from, int32:to) never fails {
    int32:fk = raw type_kind(tyt, from);
    int32:tk = raw type_kind(tyt, to);
    if (tk == (raw TY_BOOL())) {
        pass "there is no rule saying which values are true, and there is no truthiness in Nitpick — write the comparison you mean";
    }
    if (fk == (raw TY_BOOL())) {
        pass "a `bool` converts to a number, but not to this";
    }
    if (fk == (raw TY_DIM())) {
        pass "a `dim256`'s one cast partner is `tfp256` (D-196): drop the unit with `=> tfp256`, assert one with `=>! dim256<U>` — a relabel is spelled as those two halves";
    }
    if (tk == (raw TY_DIM())) {
        pass "a `dim256`'s one cast partner is `tfp256` (D-196): only `tfp256 =>! dim256<U>` asserts a unit — convert to `tfp256` first";
    }
    if (fk == (raw TY_TBB())) {
        pass "a `tbb` converts only to another `tbb`, an integer or a float (D-008); this type is none of those";
    }
    if (tk == (raw TY_TBB())) {
        pass "only a number can become a `tbb`, because the conversion has to range-check against the ERR sentinel (D-008)";
    }
    // THE `#wild_ptr` HINT BELONGS TO THE INTEGER-TO-POINTER DIRECTION (1.0.8);
    // it sat on the pointer-to-integer arm, advising the opposite conversion.
    if (tk == (raw TY_POINTER())) {
        pass "an integer does not become a pointer by casting; `#wild_ptr<T>(addr)` in `wild` context is the one way an address becomes one (D-019)";
    }
    if (fk == (raw TY_POINTER())) {
        pass "a pointer converts only to another pointer; its address is not a number a cast reads";
    }
    if (tk == (raw TY_KERNEL())) {
        pass "only an integer can be asserted into a kernel identifier, and only with `=>!` (D-042, D-095)";
    }
    pass "these types have no values in common";
};
