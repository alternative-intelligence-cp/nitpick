// Diagnostics.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Written early, in cycle 0.0.6, because
// diagnostics are how every later cycle is TESTED: the lexer is verified as much
// by what it rejects as by what it accepts, and a negative test is only
// checkable if its diagnostic can be captured and compared.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
mod:diagnostics;
error:BoundsId;

use "./source_location.npk".*;
// For `string_eq`. `intern.npk` imports nothing, so this adds a leaf edge rather
// than a cycle — which matters here, because the seed emits in dependency order
// and 0.4.6 found a back edge making it emit a caller before its callee.
use "./intern.npk".*;
use "./source.npk".*;   // srcmgr_path, for the one renderer (1.0.8)

pub enum:Severity = {
    Note    = 0i32;
    Warning = 1i32;
    Error   = 2i32;
};

// Codes are STABLE IDENTIFIERS and messages are not. Tests assert on the code
// and the span, never on the message text, so that wording stays free to
// improve without breaking the suite (BUILD_REFERENCE.md section 7.1).
pub struct:Diagnostic = {
    int32:severity;
    string:code;
    string:message;
    Span:span;
};

pub func:diag_make = Diagnostic(int32:severity, move string:code, move string:message,
                                Span:span) never fails {
    Diagnostic:d = Diagnostic{ severity: severity, code: move(code),
                               message: move(message), span: span };
    pass d;
};

pub func:diag_error = Diagnostic(move string:code, move string:message, Span:span) never fails {
    pass (raw diag_make(2i32, move(code), move(message), span));
};

pub func:diag_warning = Diagnostic(move string:code, move string:message, Span:span) never fails {
    pass (raw diag_make(1i32, move(code), move(message), span));
};

pub func:diag_note = Diagnostic(move string:code, move string:message, Span:span) never fails {
    pass (raw diag_make(0i32, move(code), move(message), span));
};

// ---------------------------------------------------------------------------
// Collection
//
// Bounded, with an explicit overflow flag rather than unbounded growth. A
// compiler that emits ten thousand diagnostics has already failed usefully at
// the first few, and a fixed bound keeps the memory deterministic -- which is
// worth more here than the ability to report an unbounded number of errors
// nobody will read.
// ---------------------------------------------------------------------------

pub struct:DiagList = {
    // WILD STORAGE, NOT AN INLINE ARRAY (D-183, 1.2.3). `Diagnostic[256]`
    // by value made the LIST an owning aggregate, and its drop walked all 256
    // slots — roughly 250 of them uninitialised stack garbage. A garbage
    // header whose capacity happened non-zero handed `dalloc` a plausible
    // pointer, which freed an INNOCENT LIVE CHUNK: stage 1's emission of one
    // type string turned to sink garbage, differently each run. Every other
    // table in this compiler is wild storage behind a pointer, which drops
    // walk PAST (a pointer is not an owner); this was the one exception, and
    // the drop machinery is what found it.
    wild Diagnostic->:items;
    int64:count;
    bool:overflowed;
};

pub func:diaglist_init = DiagList() never fails {
    wild int8->:m = alloc(256i64 * #size_of<Diagnostic>());
    DiagList:l = DiagList{ items: m =>! wild Diagnostic->,
                           count: 0i64, overflowed: false };
    pass l;
};

// THE SAME MISTAKE REPORTED TWICE IS ONE MISTAKE.
//
// Same code, same span, same message is the same finding by construction: two
// genuinely different findings never agree on all three, because the code says
// which rule and the span says where. So a repeat is dropped rather than shown.
//
// This is not tidying. The checker legitimately resolves one annotation more than
// once -- a struct's field types are resolved at every access, and 0.4.7's
// inference has to type an argument to solve `T` before it can supply that
// argument's expected type -- and each of those paths is CORRECT to report what
// it finds. Without this, being thorough would mean being noisy, and the only
// alternatives are worse: a resolver that reports on some paths and not others is
// a rule that depends on which path ran, and a checker that visits less to stay
// quiet is checking less.
//
// A LINEAR SCAN over a list bounded at 256 entries. A compiler emitting hundreds
// of diagnostics has already failed usefully at the first few, which is what
// bounds the list in the first place.
pub func:diaglist_push = NIL(DiagList->:list, move Diagnostic:d) never fails {
    if (raw diaglist_has(list, d)) { pass NIL; }
    if (list.count >= 256i64) {
        list.overflowed = true;
        pass NIL;
    }
    list.items[list.count] = move(d);
    list.count = list.count + 1i64;
    pass NIL;
};

func:diaglist_has = bool(DiagList->:list, Diagnostic:d) never fails {
    int64:i = 0i64;
    while (i < list.count) {
        Diagnostic->:e = $$i list.items[i];
        if (e.severity == d.severity) {
            if (e.span.file == d.span.file) {
                if (e.span.offset == d.span.offset) {
                    if (e.span.len == d.span.len) {
                        if (raw string_eq(e.code, d.code)) {
                            if (raw string_eq(e.message, d.message)) { pass true; }
                        }
                    }
                }
            }
        }
        i = i + 1i64;
    }
    pass false;
};

pub func:diaglist_count = int64(DiagList->:list) never fails {
    pass list.count;
};

pub func:diaglist_at = Diagnostic(DiagList->:list, int64:i) never fails {
    if (i < 0i64) {
        !!! BoundsId;
    }
    if (i >= list.count) {
        !!! BoundsId;
    }
    // A DEEP-VIEWED COPY (D-183): the container keeps ownership, and every
    // string field in the returned value is a cap-0 view — so a caller's
    // flagged local dropping it frees nothing. By-value ergonomics for the
    // 40-odd call sites, at the cost of rebuilding one small struct.
    pass (raw diag_make_view(
        list.items[i].severity,
        string_from_bytes(list.items[i].code.ptr, list.items[i].code.len),
        string_from_bytes(list.items[i].message.ptr, list.items[i].message.len),
        list.items[i].span));
};

// The view-building twin of `diag_make`: takes headers that already own
// nothing and stores them as they are.
func:diag_make_view = Diagnostic(int32:severity, move string:code,
                                 move string:message, Span:span) never fails {
    Diagnostic:d = Diagnostic{ severity: severity, code: move(code),
                               message: move(message), span: span };
    pass d;
};

pub func:diaglist_has_errors = bool(DiagList->:list) never fails {
    int64:i = 0i64;
    while (i < list.count) {
        if (list.items[i].severity == 2i32) {
            pass true;
        }
        i = i + 1i64;
    }
    pass false;
};

// Insertion sort by span. Diagnostics are sorted before rendering so that two
// runs over the same input produce byte-identical output (D-078) -- discovery
// order is not a property of the program being compiled.
//
// WRITTEN FOR A `move` THAT LEAVES THE PLACE VACANT (1.5.1b step 5c). Until
// step 5 `move(list.items[k])` left the element's bytes in the slot, and this
// sort's walk-back read slots the shift had already moved out of. The first
// compiler built by the step-5 emitter -- the close-out refresh -- found a
// zeroed diagnostic in second place and the last one gone, in five rejection
// tests at once. Now the sort carries the HOLE the way an insertion sort
// does: the element under consideration is moved out once, its neighbours are
// read through borrows (`$$i`), each shift moves one element up into the
// hole, and the hole is filled once at the insertion point. No slot is read
// after it was moved out of, under either meaning of `move`. Stable: an equal
// span never shifts.
pub func:diaglist_sort = NIL(DiagList->:list) never fails {
    int64:i = 1i64;
    while (i < list.count) {
        Diagnostic:cur = move(list.items[i]);      // the hole is at i
        int64:j = i;
        while (j > 0i64) {
            Diagnostic->:prev = $$i list.items[j - 1i64];
            if (raw span_before(cur.span, prev.span)) {
                list.items[j] = move(list.items[j - 1i64]);   // the hole moves to j-1
                j = j - 1i64;
            } else {
                j = 0i64 - j;                                 // stop: the hole stays at j
            }
        }
        if (j < 0i64) { j = 0i64 - j; }
        list.items[j] = move(cur);
        i = i + 1i64;
    }
    pass NIL;
};

// ---------------------------------------------------------------------------
// The sink
//
// THE SINK IS A PARAMETER, NEVER A GLOBAL. That is the one property D-075 exists
// for: production writes to stderr and the test harness writes to a memory
// buffer, through one code path, so diagnostics are capturable and comparable.
//
// 0.8.5 REMOVED THE FD ARM. Sink carried a runtime `kind` tag -- 0 wrote to a
// descriptor, 1 captured -- which was a write_raw-era workaround AND the exact
// mode-field pattern D-072 rejected. The descriptor role belongs to the floor's
// own write_all and to the text writer above it (lib/nio.npk); what remains
// here is the CAPTURE BUFFER, the thing D-075 needs from diagnostics: one code
// path that a test can read back. IT IS ONE `Writer` IMPL AMONG SEVERAL since
// 1.4.7 (D-229 stage 2), not a special case -- and the impl lives in
// diag_writer.npk beside the one walk, not here: its methods are async, and
// REACH is import-scoped, so an async body in this module would make
// `DeadlineExceeded` reachable in every program that imports it.
// ---------------------------------------------------------------------------

pub struct:Sink = {
    List<int8>:v;
};

// A BUFFER SINK GROWS. It did not, and dropped whatever did not fit — which is a
// defensible answer for a diagnostic renderer, whose total is already bounded by
// `diaglist`'s own cap, and the wrong answer for anything else.
//
// CYCLE 0.7 IS WHAT CHANGED IT. The IR emitter writes through a sink, and IR that is
// silently truncated is a program that compiles to something other than what was
// written, with nothing anywhere reporting it. That is the failure mode this whole
// project is arranged to prevent, and "the buffer was too small" is a poor reason to
// have it.
//
// The bound stays where it belongs: on the DIAGNOSTIC LIST, which is what the fixed
// cap was protecting. One buffer mechanism, and the thing that needs a limit keeps
// its own.
//
// 1.4.7: the growth is `List<int8>`'s. A sink is the family that made
// `list_reserve` take a COUNT — it appends however many bytes the write is,
// not one — and the only one of the twelve that never carried a `=>!` of its
// own, because its elements were already the allocator's `int8`.
pub func:sink_to_buffer = Sink(int64:cap) never fails {
    int64:n = cap;
    if (n < 64i64) { n = 64i64; }
    pass Sink{ v: raw list_init::<int8>(n) };
};

pub func:sink_write = NIL(Sink->:out, string:text) never fails {
    drop list_reserve(@out.v, text.len);
    int64:i = 0i64;
    while (i < text.len) {
        drop list_push(@out.v, text.ptr[i] =>! int8);
        i = i + 1i64;
    }
    pass NIL;
};

// ONE BYTE (1.5.1b step 3): the escapers write their one or three bytes
// straight into the sink they are filling, so a program-sized literal costs
// its length once and allocates nothing per byte.
pub func:sink_write_byte = NIL(Sink->:out, int8:b) never fails {
    drop list_push(@out.v, b);
    pass NIL;
};

pub func:sink_length = int64(Sink->:out) never fails {
    pass out.v.count;
};

// The sink's bytes as a VIEW. `string_from_bytes` is the explicit view
// primitive (D-186): the result is a cap-0 string owning nothing, so the sink
// keeps its buffer and the caller's local drops nothing at scope exit. This
// exists so the IR writer can assemble its mid-function text without knowing
// how a sink stores bytes — it reached into `.buf`/`.len` at five sites until
// 1.4.7 moved the storage.
pub func:sink_view = string(Sink->:out) never fails {
    pass string_from_bytes(out.v.items, out.v.count);
};

// THE SINK'S BYTES AS AN OWNED STRING, CONSUMING THE SINK (1.5.1b step 3):
// the builders that assemble a program-sized text in a sink of their own
// hand it back this way. A `move` parameter, not a borrow, so no analysis
// old or new reads the result as a borrow of the caller's local (D-004's
// conservative rule closes `f(@local)` for every user function, and the
// SNAPSHOT that builds `src/` applies it to a builtin's result too).
pub func:sink_into_string = string(move Sink:s) never fails {
    pass (string_concat(string_from_bytes(s.v.items, s.v.count), ""));
};

pub func:sink_byte_at = uint8(Sink->:out, int64:i) never fails {
    pass (out.v.items[i] =>! uint8);
};

// Empty a sink for reuse; the buffer is kept (1.0.8 gave the IR writer a
// second sink per function, and it is reset at each function's start).
pub func:sink_reset = NIL(Sink->:out) never fails {
    out.v.count = 0i64;
    pass NIL;
};

// Append one sink's bytes to another — how the IR writer splices a function's
// hoisted allocas and its body into the module stream at the function's close
// (1.0.9a).
pub func:sink_append = NIL(Sink->:dst, Sink->:src) never fails {
    drop list_reserve(@dst.v, src.v.count);
    int64:i = 0i64;
    while (i < src.v.count) {
        drop list_push(@dst.v, src.v.items[i]);
        i = i + 1i64;
    }
    pass NIL;
};

// ---------------------------------------------------------------------------
// Rendering
//
// Deterministic: no colour, and no terminal detection. D-076 settled the general
// form of that rule -- behaviour must not depend on whether the output is a
// terminal, because the configuration that gets debugged would not be the one
// that ships.
//
// Messages are built by explicit concatenation. Subset 1 had no string
// interpolation, and a mass `&{ }` re-spell of `src/` was decided OUT at
// D-209 (1.4.0), so the spelling stays.
// ---------------------------------------------------------------------------

// ONE LINE, ONE FORMATTER (1.0.8). `CODE path:line:col: message` — the code
// FIRST, where a reader scanning a wall of output finds the stable identifier
// in the same column every time; a note or a warning says so in front of it,
// an error is the unmarked case; a spanless diagnostic renders `<no span>`
// rather than being dropped (D-162); and the MESSAGE, which is the only part
// that says what to do about the refusal.
//
// Until 1.0.8 there were five renderers and no two agreed: the two real drivers
// printed `CODE path:line:col` and dropped the message, the two single-file
// tools printed `CODE line:col` and dropped both, and the one that kept the
// message (this file's, reached from one test) dropped the path. Seventy-nine
// messages had been written and none had reached a reader — which is also
// why none had been reviewed. The string is built here and WRITTEN by the one
// walk in diag_writer.npk, through whatever `Writer` it was lent -- the
// drivers' `TextWriter<ByteWriter>`, the tests' `Sink` -- because a renderer
// per sink is how the drift began, and a walk per sink (`diaglist_render`,
// retired at D-229 stage 2) is how it would have begun again.
pub func:diag_line = string(Diagnostic:d, SourceManager->:sm) never fails {
    string:m = "";
    if (d.severity == 0i32) { m = "note "; }
    if (d.severity == 1i32) { m = "warning "; }
    m = string_concat(m, d.code);
    m = string_concat(m, " ");
    if (d.span.file < 0i32) {
        m = string_concat(m, "<no span>");
    } else {
        // A FILE THE MANAGER DOES NOT HOLD is rendered, not lost: the same rule
        // as `<no span>`, for the same reason. (`?|` since 1.4.7 step 3; it was
        // spelled out while the seed that built this file could not lower it.)
        m = string_concat(m, srcmgr_path(sm, d.span.file) ?| "<unknown file>");
        m = string_concat(m, ":");
        m = string_concat(m, int_to_string(d.span.line => int64));
        m = string_concat(m, ":");
        m = string_concat(m, int_to_string(d.span.col => int64));
    }
    m = string_concat(m, ": ");
    m = string_concat(m, d.message);
    pass m;
};

// The line that says the list was capped — the one walk prints it (1.0.8);
// before, only the test sink ever mentioned that anything had been dropped.
pub func:diag_overflow_line = string() never fails {
    pass "note NITPICK-DIAG-001 <no span>: further diagnostics suppressed";
};

