// The builtin SCALAR families -- one classification (D-257, 1.5.2b step 2).
//
// GENERATED by bootstrap/generator/gen_tables.py from LEXICAL_REFERENCE.md's
// BuiltinType production. Two consumers read it: the prelude's generated
// `scalar-impls` region (what the prelude implements for each family) and
// the derive reader (D-258: a member spelled with a scalar keyword is reached
// through the prelude's impl of the derived trait, `raw`). A terminal the
// generator cannot place in a family or on the named non-scalar list is a
// hard failure there, so this table cannot silently miss one. `complex` and
// `dim256` are constructors whose INSTANCES are the scalars: the reader looks
// at their argument (a parameter under `complex` refuses by name, D-258).

mod:scalar_table;
use "./token_kind.npk".*;

pub func:SCALAR_NONE = int32() never fails { pass 0i32; };
pub func:SCALAR_INT = int32() never fails { pass 1i32; };
pub func:SCALAR_CHAR = int32() never fails { pass 2i32; };
pub func:SCALAR_TFP = int32() never fails { pass 3i32; };
pub func:SCALAR_TERN = int32() never fails { pass 4i32; };
pub func:SCALAR_FRAC = int32() never fails { pass 5i32; };
pub func:SCALAR_FLOAT = int32() never fails { pass 6i32; };
pub func:SCALAR_FLOAT_STORAGE = int32() never fails { pass 7i32; };
pub func:SCALAR_TBB = int32() never fails { pass 8i32; };
pub func:SCALAR_BOOL = int32() never fails { pass 9i32; };
pub func:SCALAR_KERNEL = int32() never fails { pass 10i32; };
pub func:SCALAR_FLAGS = int32() never fails { pass 11i32; };
pub func:SCALAR_COMPLEX = int32() never fails { pass 12i32; };
pub func:SCALAR_DIM = int32() never fails { pass 13i32; };

// The family of a builtin type keyword, or SCALAR_NONE for a non-scalar
// builtin and for any token that is not a builtin type at all.
pub func:builtin_scalar_family = int32(TokenKind:k) never fails {
    if (k == TokenKind.KwInt8) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt16) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt32) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt64) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt128) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt256) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt512) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt1024) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt2048) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwInt4096) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint8) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint16) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint32) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint64) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint128) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint256) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint512) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint1024) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint2048) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwUint4096) { pass (raw SCALAR_INT()); }
    if (k == TokenKind.KwTbb8) { pass (raw SCALAR_TBB()); }
    if (k == TokenKind.KwTbb16) { pass (raw SCALAR_TBB()); }
    if (k == TokenKind.KwTbb32) { pass (raw SCALAR_TBB()); }
    if (k == TokenKind.KwTbb64) { pass (raw SCALAR_TBB()); }
    if (k == TokenKind.KwTbb128) { pass (raw SCALAR_TBB()); }
    if (k == TokenKind.KwTbb256) { pass (raw SCALAR_TBB()); }
    if (k == TokenKind.KwFrac8) { pass (raw SCALAR_FRAC()); }
    if (k == TokenKind.KwFrac16) { pass (raw SCALAR_FRAC()); }
    if (k == TokenKind.KwFrac32) { pass (raw SCALAR_FRAC()); }
    if (k == TokenKind.KwFrac64) { pass (raw SCALAR_FRAC()); }
    if (k == TokenKind.KwTfp32) { pass (raw SCALAR_TFP()); }
    if (k == TokenKind.KwTfp64) { pass (raw SCALAR_TFP()); }
    if (k == TokenKind.KwTfp128) { pass (raw SCALAR_TFP()); }
    if (k == TokenKind.KwTfp256) { pass (raw SCALAR_TFP()); }
    if (k == TokenKind.KwDim256) { pass (raw SCALAR_DIM()); }
    if (k == TokenKind.KwFlt32) { pass (raw SCALAR_FLOAT()); }
    if (k == TokenKind.KwFlt64) { pass (raw SCALAR_FLOAT()); }
    if (k == TokenKind.KwFlt128) { pass (raw SCALAR_FLOAT_STORAGE()); }
    if (k == TokenKind.KwBool) { pass (raw SCALAR_BOOL()); }
    if (k == TokenKind.KwChar8) { pass (raw SCALAR_CHAR()); }
    if (k == TokenKind.KwChar16) { pass (raw SCALAR_CHAR()); }
    if (k == TokenKind.KwChar32) { pass (raw SCALAR_CHAR()); }
    if (k == TokenKind.KwFd) { pass (raw SCALAR_KERNEL()); }
    if (k == TokenKind.KwPid) { pass (raw SCALAR_KERNEL()); }
    if (k == TokenKind.KwTid) { pass (raw SCALAR_KERNEL()); }
    if (k == TokenKind.KwUid) { pass (raw SCALAR_KERNEL()); }
    if (k == TokenKind.KwGid) { pass (raw SCALAR_KERNEL()); }
    if (k == TokenKind.KwOflags) { pass (raw SCALAR_FLAGS()); }
    if (k == TokenKind.KwProt) { pass (raw SCALAR_FLAGS()); }
    if (k == TokenKind.KwMflags) { pass (raw SCALAR_FLAGS()); }
    if (k == TokenKind.KwFmode) { pass (raw SCALAR_FLAGS()); }
    if (k == TokenKind.KwComplex) { pass (raw SCALAR_COMPLEX()); }
    if (k == TokenKind.KwTrit) { pass (raw SCALAR_TERN()); }
    if (k == TokenKind.KwTryte) { pass (raw SCALAR_TERN()); }
    if (k == TokenKind.KwNit) { pass (raw SCALAR_TERN()); }
    if (k == TokenKind.KwNyte) { pass (raw SCALAR_TERN()); }
    pass 0i32;
};

// The family's name, for diagnostics.
pub func:scalar_family_name = string(int32:fam) never fails {
    if (fam == 1i32) { pass "int"; }
    if (fam == 2i32) { pass "char"; }
    if (fam == 3i32) { pass "tfp"; }
    if (fam == 4i32) { pass "tern"; }
    if (fam == 5i32) { pass "frac"; }
    if (fam == 6i32) { pass "float"; }
    if (fam == 7i32) { pass "float storage"; }
    if (fam == 8i32) { pass "tbb"; }
    if (fam == 9i32) { pass "bool"; }
    if (fam == 10i32) { pass "kernel"; }
    if (fam == 11i32) { pass "flags"; }
    if (fam == 12i32) { pass "complex"; }
    if (fam == 13i32) { pass "dim"; }
    pass "none";
};
