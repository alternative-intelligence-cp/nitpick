// Type-checking diagnostic codes.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.1.
//
// Centralised for the reason 0.1.6, 0.2.1 and 0.3.1 give: a mistyped code
// literal at a call site silently invents a NEW code, and the test asserting the
// old one then fails for a reason unrelated to the bug it guards.

pub func:TYPE_UNKNOWN = string()        { pass "NITPICK-TYPE-001"; };
pub func:TYPE_NOT_A_TYPE = string()     { pass "NITPICK-TYPE-002"; };
pub func:TYPE_BARE_ANY = string()       { pass "NITPICK-TYPE-003"; };
// NOT A COMPILE-TIME CONSTANT. One code for one rule, and the rule reaches two
// spellings: an array size `int32[N]` and a `comptime` generic argument
// `Mutex<Config, 2>`. Both are refused for the same reason and with the same
// sentence, so a reader filtering on this is asking one question -- splitting it
// in two would make the shared rule look like a coincidence.
pub func:TYPE_NOT_CONSTANT = string()   { pass "NITPICK-TYPE-004"; };
pub func:TYPE_SELF_OUTSIDE = string()   { pass "NITPICK-TYPE-005"; };
pub func:TYPE_DYN_NOT_TRAIT = string()  { pass "NITPICK-TYPE-006"; };
pub func:TYPE_MISMATCH = string()       { pass "NITPICK-TYPE-007"; };
pub func:TYPE_NOT_NUMERIC = string()    { pass "NITPICK-TYPE-008"; };
pub func:TYPE_LOSSY_CAST = string()     { pass "NITPICK-TYPE-009"; };
pub func:TYPE_RESULT_RETURN = string()  { pass "NITPICK-TYPE-010"; };

// A DEFECT IN THE COMPILER, not in the program: a statement kind the checker's
// walk has no entry for. Its own code, and not `TYPE_UNKNOWN`, because a reader
// who sees it has found a hole in the checker and there is nothing they can
// change in their source to fix it. `resolve.npk` has `RESOLVE_INTERNAL` for the
// same situation and for the same reason.
pub func:TYPE_INTERNAL = string()       { pass "NITPICK-TYPE-011"; };

// Traits and impls (cycle 0.4.6). Each is its own code rather than a shared
// "bad impl", because the four are found at different points and a reader
// filtering a log by code is asking a different question with each.
pub func:TYPE_NOT_A_TRAIT = string()    { pass "NITPICK-TYPE-012"; };
pub func:TYPE_COHERENCE = string()      { pass "NITPICK-TYPE-013"; };
pub func:TYPE_IMPL_INCOMPLETE = string(){ pass "NITPICK-TYPE-014"; };
pub func:TYPE_NOT_OBJECT_SAFE = string(){ pass "NITPICK-TYPE-015"; };

// Generics (cycle 0.4.7). Three codes rather than one, because the three are
// found at different points and a reader filtering by code is asking a different
// question with each: an arity mistake is in the annotation, an unsatisfied bound
// is in the argument, and a depth overflow is in the shape of the program.
pub func:TYPE_GENERIC_ARITY = string()  { pass "NITPICK-TYPE-016"; };
pub func:TYPE_BOUND_UNMET = string()    { pass "NITPICK-TYPE-017"; };
pub func:TYPE_GENERIC_DEPTH = string()  { pass "NITPICK-TYPE-018"; };

// THREE FINDINGS THAT WERE ALL `TYPE_MISMATCH` OR `TYPE_GENERIC_ARITY`, and are
// not mismatches at all. Codes are the stable identifiers a test may assert on
// (BUILD_REFERENCE 7.1), so a distinction that lives only in the wording is a
// distinction nothing can check -- and each of these is a different mistake with
// a different fix.
//
//   * NO SUCH METHOD -- the receiver has no member by that name. On a generic
//     parameter this is the whole "no duck typing" property: without its own
//     code it reads identically to the argument mismatch that arises when the
//     free function IS wrongly reached.
//   * AMBIGUOUS -- two traits or two bounds supply one name. The program is
//     well-formed and the compiler will not choose (D-102).
//   * WRONG KIND OF GENERIC ARGUMENT -- a type where a `comptime` value was
//     wanted, or the reverse. Not arity: the count is right.
pub func:TYPE_NO_METHOD = string()      { pass "NITPICK-TYPE-019"; };
pub func:TYPE_AMBIGUOUS_METHOD = string(){ pass "NITPICK-TYPE-020"; };
pub func:TYPE_GENERIC_KIND = string()   { pass "NITPICK-TYPE-021"; };

// INFERENCE COULD NOT DECIDE. Its own code because the fix is unlike any
// other: nothing in the call is wrong, and what is missing is a type argument
// the turbofish would have supplied.
pub func:TYPE_CANNOT_INFER = string()   { pass "NITPICK-TYPE-022"; };
