// Expression typing.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.2.
//
// Every expression gets a type, and the operators enforce the rules that make a
// type mean more than its bits.
//
// THIS IS WHERE THE LANGUAGE WINS OVER THE MACHINE. Four families are
// representationally identical to integers and none of them is a number:
//
//   `bool`          one byte, two values. `true + 1i32` means nothing.
//   `char8`         a character is not its code point (D-005).
//   `tbb32`         an error-code type whose arithmetic drags in ERR,
//                   stickiness and saturation (D-008) — operations that belong
//                   to the type, not to `+`.
//   `fd` and family an `fd` plus one is not an `fd` (D-042).
//
// To LLVM all four are `iN`. Nothing downstream will object. This file is the
// only place that can.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./num_width.npk".*;
use "./parse_expr.npk".*;
use "./parse_pick.npk".*;
use "./parse_stmt.npk".*;
use "./type_layout.npk".*;
use "./parse_decl.npk".*;
use "./symbols.npk".*;
use "./resolve_type.npk".*;
use "./type_names.npk".*;
use "./type_cast.npk".*;
use "./type_decl.npk".*;
use "./type_access.npk".*;
// A `use` CYCLE, DECLARED ON PURPOSE. `type_stmt.npk` uses this module because a
// statement contains expressions; this module uses it because an EXPRESSION contains
// statements — an expression-`pick`s arms are statement bodies (D-059). The language
// nests the two inside each other, so the checker does too.
//
// The three other layering problems this cycle turned up — `ensure_layout`,
// `stmt_carries_expr`, `te_assign_mismatch` — were each a function in the wrong
// module, and each was moved. THIS ONE IS NOT THAT: neither direction is wrong, and
// declaring the cycle is more honest than a duplicated statement walk on the
// expression side would be.
use "./type_stmt.npk".*;
use "./type_trait.npk".*;
use "./builtins.npk".*;   // the raw/drop licence reads the builtin column (D-163)
use "./expr_types.npk".*;

pub struct:ExprTyper = {
    Ast->:ast;
    TypeTable->:types;
    SymbolTable->:tab;
    InternTable->:interns;
    DiagList->:diags;

    // The type an unsuffixed literal should take, pushed by whatever position it
    // appears in (D-092). Zero when there is none, and a literal reaching that
    // state is an error rather than a silent `int32`.
    int32:expected;

    // THE SCOPE NAMES ARE LOOKED UP IN. It lives on the typer rather than being
    // threaded through every walk function for the same reason `expected` does:
    // it is constant across an expression tree, and a construct that nests a
    // scope — 0.4.4's expression-`pick` — saves and restores it around the part
    // that differs. `type_of_expr` used to take it as a parameter and DISCARD it,
    // which was honest while nothing needed it and stopped being honest the
    // moment a cast had to resolve `x => MyStruct`.
    int32:scope;

    // THE ENCLOSING FUNCTION'S SUCCESS TYPE, and whether it is `main` or
    // `failsafe`. `relay` needs both: it returns the error from the enclosing
    // function, so it needs something to return into, and in a terminal function
    // there is nothing — which is the whole reason those two are excepted from
    // D-013 rather than an oversight.
    int32:fn_success;
    bool:fn_terminal;
    // D-163: the enclosing function declared `never fails` — its body may not
    // `fail`, `relay`, or `return Result{…}`.
    bool:fn_never_fails;
    // D-163 rule 7: inside a `defer` body, where `fail`/`relay` are refused.
    bool:in_defer;
    // D-177: the enclosing function is `async` — where `await` and the spawn
    // form are legal, and whose locals the across-await liveness walk watches.
    bool:fn_is_async;
    // The one call expression currently blessed to have an `async` callee —
    // the operand of the `await` or spawn-`drop` being typed. Everything else
    // with an `async` callee is a bare call, which has no frame to run the
    // machine in (D-058/D-177) and is refused by `type_call`.
    int32:await_operand;

    // HOW MANY COUNTED LOOPS ENCLOSE THE EXPRESSION BEING TYPED (1.0.8). `$`
    // names the innermost one's counter; outside any, it names nothing — and
    // until 1.0.8 nothing said so before the EMITTER, which reported it as an
    // internal defect ("a node it has no classification for") in the program's
    // own fault.
    int32:counted_depth;

    // THE MODULE'S `impl` BLOCKS. A method call resolves through this rather than
    // through the scope, because an `impl` declares nothing at module scope
    // (0.3.1, deferring the question to here) — so before 0.4.6 the only method
    // UFCS could find was a module-level free function, and a `magnitude` written
    // where the spec puts it was invisible.
    //
    // It is a PARAMETER rather than something set afterwards, so that a caller
    // cannot forget it and get the old behaviour back silently. A context with no
    // impls passes an empty table and says so.
    ImplTable->:impls;

    // THE MODULE'S GENERIC BOUNDS (0.4.7). A parameter's methods are its bounds'
    // methods and nothing else (D-064), so this is what makes a generic body
    // checkable at its definition — and a checker without it does not fall back
    // to something weaker, it duck-types: `T` would find whatever the impl table
    // happened to hold. A parameter here for the same reason `impls` is one.
    BoundTable->:bounds;

    // THE GENERIC PARAMETERS THE BODY BEING WALKED CAN SEE. Set alongside
    // `fn_success` by whoever drives the walk: both come from the same
    // declaration and both are constant across one body.
    GenericScope:generics;
    GenericScope:enclosing;

    // WHAT TYPE EACH EXPRESSION GOT (0.5.0). Recorded here rather than
    // recomputed by every later analysis: two computations of one fact is the
    // shape that has cost this compiler defects repeatedly, and an analysis that
    // reads what the checker recorded agrees with it by construction.
    ExprTypes->:expr_types;

    // WHERE INSTANTIATIONS ARE RECORDED. A body's annotations instantiate as
    // readily as a signature's — `Container<int32>:c;` is a statement — so the
    // checker's resolver has to record into the same table the collection passes
    // did, or a bound violation written inside a body would go unjudged.
    InstanceTable->:instances;

    // THE GENERIC-FUNCTION INSTANTIATIONS THIS PROGRAM REQUESTS (1.0.2b). A
    // generic TYPE's instantiations are the interned type table; a generic
    // FUNCTION's are not recorded anywhere the backend can see, because the
    // substituted signature is an anonymous `TY_FUNC` and — for an inferred call
    // — the arguments exist only in this checker's scratch. Recorded where they
    // are solved, so the emitter can walk the set rather than re-deriving it.
    FnInstTable->:fninsts;

    // THE TRAIT WHOSE BODY IS BEING WALKED, or 0 (1.0.4). `Self` is the
    // anonymous placeholder inside a trait (D-103), so it carries no
    // declaration — and a default method calling `self.other()` needs the
    // guarantee list to look `other` up in. This is that list's owner.
    int32:self_trait;

    // WHAT `Self` MEANS IN THE BODY BEING WALKED. A method inside `impl:Point`
    // may write `Self:other` and a trait's default body may too, so the checker
    // has to carry it the way the resolver does — as the type it stands for, 0
    // where there is none (D-030).
    //
    // `type_method_call` sets it locally around one signature; this is the other
    // half, and until 0.4.8 nothing set it because no `impl` method body was ever
    // walked.
    int32:self_type;
};

pub func:etyper_init = ExprTyper(Ast->:ast, TypeTable->:types, SymbolTable->:tab,
                                 InternTable->:interns, DiagList->:diags,
                                 int32:scope, ImplTable->:impls,
                                 BoundTable->:bounds,
                                 InstanceTable->:instances,
                                 FnInstTable->:fninsts,
                                 ExprTypes->:expr_types) never fails {
    ExprTyper:e = ExprTyper{ ast: ast, types: types, tab: tab, interns: interns,
                             diags: diags, expected: 0i32, scope: scope,
                             fn_success: 0i32, fn_terminal: false, fn_never_fails: false, in_defer: false, fn_is_async: false, await_operand: 0i32,
                             counted_depth: 0i32,
                             impls: impls, bounds: bounds,
                             generics: raw generic_scope_none(),
                             enclosing: raw generic_scope_none(),
                             instances: instances, fninsts: fninsts,
                             self_type: 0i32, self_trait: 0i32,
                             expr_types: expr_types };
    pass e;
};

// THE RESOLVER THIS CHECKER USES, BUILT IN ONE PLACE.
//
// Six call sites made one by hand, and each one that forgot a field got a
// resolver that was subtly not this checker's: a `T` in a body would resolve to
// "there is no type named `T`" inside the one declaration where `T` is guaranteed
// to exist. Context that every resolution needs belongs to the constructor, not
// to whoever remembers.
pub func:etyper_resolver = TypeResolver(ExprTyper->:e) never fails {
    TypeResolver:r = raw tyres_init(e.ast, e.types, e.tab, e.interns, e.diags, e.instances);
    r.generics = e.generics;
    r.enclosing = e.enclosing;
    r.self_type = e.self_type;
    // AND THE TRAIT (D-160). The comment above is about exactly this: a field
    // this constructor forgets gives a resolver that is subtly not the
    // checker's, and `Item` inside its own trait would resolve to "there is no
    // type named `Item`".
    r.self_trait = e.self_trait;
    pass r;
};

pub func:te_error = int32(ExprTyper->:e, string:code, string:message, Span:at) never fails {
    drop diaglist_push(e.diags, raw diag_error(code, message, at));
    pass 0i32;
};

// THE OPERAND OF `@`, `$$i`, `$$m` AND `move` MUST HAVE AN ADDRESS.
//
// A place is a name, a field or element of one, or what a pointer points at. The
// language has no way to spell the address of a temporary, so `@(raw f())` names
// nothing — and until 0.5.3 the real frontend accepted all four of these on any
// expression at all. The SEED refused them, out of necessity: it has to emit an
// address and there is none. So the two disagreed about what a valid program is,
// which is the situation `fixed` was in before 0.5.2.
//
// ONE HELPER FOR ALL FOUR, because it is one rule. Written at each site it would be
// four chances for one to drift, and the drift had already happened in the form of
// nobody writing it anywhere.
pub func:require_place_operand = NIL(ExprTyper->:e, ExprId:id, string:what) never fails {
    if (raw expr_is_none(id)) { pass NIL; }
    if (raw expr_is_place(e.ast, id, raw BORROW_FUEL())) { pass NIL; }
    ExprNode:n = raw ast_expr(e.ast, id);
    string:m1 = raw string_concat("`", what);
    string:m2 = raw string_concat(m1, "` needs a place — a name, a field or element of one, or what a pointer points at — and this expression is a value with no address");
    discard(raw te_error(e, raw TYPE_NOT_A_PLACE(), m2, n.span));
    pass NIL;
};

// --- the common type of two operands (D-092, corrected) ----------------------------------
//
// THERE IS NO IMPLICIT WIDENING. Two operands share a type or they do not, and
// when they do not the programmer writes the cast.
//
// An earlier reading of this had `int32 + int64` widen to `int64` on the grounds
// that `explicit-widening` appears in the `--extra-picky` table, so the default
// must permit what the rule bans. That inference is wrong: every rule in that
// table adds pedantry BEYOND safety -- `shadow` bans shadowing, `wild` bans a
// construct that is already explicit -- and none of them gates a safety property.
// `SAFETY_ARCHITECTURE.md` says so directly a few lines below the table: a
// Nitpick guarantee is "absolute by default, suspended only through a construct
// an auditor can search for."
//
// The concrete harm is not that a same-signedness widening loses a value; it
// cannot. It is that the widening decides WHICH WIDTH THE OPERATION HAPPENS IN.
// `a + b` computing in 64 bits because `b` is an `int64` today will silently
// compute in 32 bits when someone narrows `b` tomorrow, and overflow where it
// used to fit. The expression is unchanged and its meaning is not -- which is a
// small drift in numbers arriving through a conversion nobody wrote.
//
// A LITERAL IS DIFFERENT and is handled before this is reached: an unsuffixed
// literal takes its type from context, so `x + 1` where `x` is `int64` has two
// `int64` operands by the time they get here. Nothing is converted; the literal
// simply had no width of its own to begin with.
pub func:unify = int32(ExprTyper->:e, int32:a, int32:b) never fails {
    if (a == b) { pass a; }
    // FUNCTION TYPES COMPARE STRUCTURALLY (0.9.6). `tt_func` interns the
    // parameter window's START INDEX — an allocation artifact — so two
    // spellings of one function type (the annotation's and the declaration's)
    // never share an id. Nothing consumed function types until values of them
    // existed, which is how the artifact survived 0.4 unnoticed.
    if (raw types_agree(e, a, b)) { pass a; }
    pass 0i32;
};

// Structural agreement for the window-carrying callable kinds; everything else
// is its interned id, exactly as before.
pub func:types_agree = bool(ExprTyper->:e, int32:a, int32:b) never fails {
    if (a == b) { pass true; }
    int32:ka = raw type_kind(e.types, a);
    if (ka != (raw type_kind(e.types, b))) { pass false; }
    if (ka == (raw TY_FUNC()))          { pass (raw func_types_equal(e, a, b)); }
    if (ka == (raw TY_FUNC_VARIADIC())) { pass (raw func_types_equal(e, a, b)); }
    pass false;
};

func:func_types_equal = bool(ExprTyper->:e, int32:a, int32:b) never fails {
    Type:ta = raw tt_get(e.types, a);
    Type:tb = raw tt_get(e.types, b);
    if (ta.c != tb.c) { pass false; }
    if (!(raw types_agree(e, ta.a, tb.a))) { pass false; }
    int32:i = 0i32;
    while (i < ta.c) {
        int32:pa = raw ast_id_at(e.ast, ta.b, i);
        int32:pb = raw ast_id_at(e.ast, tb.b, i);
        if (!(raw types_agree(e, pa, pb))) { pass false; }
        i = i + 1i32;
    }
    pass true;
};

// --- literals ---------------------------------------------------------------------------

// A NUMERIC LITERAL'S TYPE COMES FROM ITS SUFFIX, and with no suffix from
// context (D-092). With neither it is an error rather than a silent `int32`: a
// default would be a type nobody wrote, chosen by a rule nobody read, and every
// later diagnostic about the expression would name it.
//
// ONE FUNCTION FOR EVERY NUMERIC FAMILY. There were two — one for integers, one
// for floats — and between them they recognised twenty-six of the forty-five
// suffixes the language has. `1tbb8` reported "this literal has no width suffix"
// while carrying one, and `1.5tfp256` typed as a `flt256` because the float test
// had swept `tfp` in with the floats. The kind now comes from the generated
// table, so a suffix cannot be silently unclassified.
func:type_numeric_literal = int32(ExprTyper->:e, ExprNode:n, string:example) never fails {
    NumWidth:w = raw expr_num_width(n);
    int32:kind = raw num_width_kind(w);
    int32:bits = raw num_width_bits(w);

    if (kind == (raw TY_INT())) {
        pass (raw lit_ranged(e, n,
                  raw tt_int(e.types, bits, raw num_width_signed(w))));
    }
    if (kind == (raw TY_FLOAT())) {
        // D-143: `flt128` is a storage format — no literals (its constants
        // cannot even be spelled in the IR without soft-float semantics this
        // implementation deliberately does not provide).
        if (bits == 128i32) {
            pass (raw te_error(e, raw TYPE_FLOAT_RULES(),
                "`flt128` is a storage format (D-143): it holds and moves values but has no literals, arithmetic, or comparison",
                n.span));
        }
        // D-143: a `flt32` literal carries at most 15 significant digits. The
        // literal lowers through a correctly-rounded double (the IR's only
        // portable spelling), and decimal→double→float equals direct rounding
        // exactly when the decimal has ≤ 15 significant digits — beyond that,
        // double rounding can differ and the value would be implementation-
        // defined, which a literal must never be.
        if (bits == 32i32) {
            string:txt = raw intern_get(e.interns, n.payload =>! int32);
            int32:sig = 0i32;
            bool:lead = true;
            int64:ti = 0i64;
            while (ti < txt.len) {
                uint8:ch = txt.ptr[ti];
                if (ch == 101u8) { break; }   // 'e' — exponent: digits end
                if (ch == 69u8)  { break; }   // 'E'
                if (ch == 102u8) { break; }   // 'f' — the suffix
                if (ch >= 48u8) {
                    if (ch <= 57u8) {
                        if (ch == 48u8) {
                            if (!lead) { sig = sig + 1i32; }
                        } else {
                            lead = false;
                            sig = sig + 1i32;
                        }
                    }
                }
                ti = ti + 1i64;
            }
            if (sig > 15i32) {
                pass (raw te_error(e, raw TYPE_FLOAT_RULES(),
                    "a `flt32` literal carries at most 15 significant digits (D-143); shorten it, or write it as a `flt64` literal (`…f64`) and narrow it with `=>!` — `flt64 => flt32` is a lossy cast",
                    n.span));
            }
        }
        pass (raw tt_float(e.types, bits));
    }
    if (kind == (raw TY_TBB()))   { pass (raw lit_ranged(e, n, raw tt_tbb(e.types, bits))); }
    if (kind == (raw TY_CHAR()))  { pass (raw lit_ranged(e, n, raw tt_char(e.types, bits))); }

    // A SUFFIX IS PRESENT AND NAMES A TYPE NO RUNG SUPPLIES YET — `frac`, `tfp`,
    // `dim256`. Saying "no suffix" would be false and would send the reader to
    // add one they already wrote (D-085: the parser never restricts, so this is
    // where the rung is named).
    if (w != NumWidth.WNone) {
        pass (raw te_error(e, raw TYPE_UNKNOWN(),
            "this literal's type is not available at this rung yet",
            n.span));
    }

    // `expected_value` rather than `e.expected`, so that `int32?:n = 10;` reads
    // its width from the `int32` inside the wrapper. A literal is a value and an
    // `Optional<U>` slot takes a `U` (D-099); asking the wrapper for a width would
    // report "no width suffix" about a slot that plainly names one.
    int32:want = raw expected_value(e);
    if (want != 0i32) {
        if ((raw type_kind(e.types, want)) == (raw kind_wanted(e, example))) {
            pass (raw lit_ranged(e, n, want));
        }
    }
    // TWO REFUSALS, SAID APART (1.0.8). With no context the literal is homeless;
    // with a context of the WRONG FAMILY (`r ?! 99` wants a `tbb32`, `fail 5;`
    // too, a `string` slot, a struct) something here does say what the slot is,
    // and "write `42i32`" was advice the next check refused: an unsuffixed
    // literal takes its width only from a slot of its own family.
    if (want != 0i32) {
        string:w1 = raw string_concat("this unsuffixed literal sits in a `",
                        raw type_display(e.types, e.interns, want));
        string:w2 = raw string_concat(w1,
            "` slot, and a literal takes its width only from a slot of its own family; write a `");
        string:w3 = raw string_concat(w2, raw type_display(e.types, e.interns, want));
        pass (raw te_error(e, raw TYPE_MISMATCH(),
            raw string_concat(w3, "` value, or change the slot"), n.span));
    }
    string:m = raw string_concat(
        "this literal has no width suffix and nothing here says what it should be; write `",
        example);
    pass (raw te_error(e, raw TYPE_UNKNOWN(),
        raw string_concat(m, "` or give the surrounding expression a type"),
        n.span));
};

// D-148: THE VALUE MUST FIT THE TYPE. Until 0.9.9 nothing checked this --
// `int8:a = 300i8;` survived every stage and emitted `i8 300`, which llc
// refuses as malformed IR when it is caught at all, and a wrapped constant
// when it is not: the number in the program was not the number written, the
// exact drift this language exists to make impossible.
//
// One helper for the suffixed and the contextual case alike (the slot the
// literal lands in is the type it must fit, however it got one). The bounds:
//
//   intN signed    -(2^(N-1)) .. 2^(N-1)-1     N < 64; at 64 the lexer's
//                                              envelope is already exact
//   intN unsigned  0 .. 2^N-1                  and 0 .. envelope at 64+,
//                                              which also refuses a balanced
//                                              literal's negative value
//   tbbN           symmetric, ERR excluded     |v| <= 2^(N-1)-1 (D-008 SS1)
//   charN          0 .. 2^N-1; char32 is a Unicode scalar: <= U+10FFFF and
//                  never a surrogate -- validity, not just width
//   floats         text, not a payload -- D-143 owns their rules
//
// A SIGNED width's most negative value has no decimal spelling (its magnitude
// is one past the positive bound, and `-` is an operator, not part of the
// literal) -- it is spelled in a balanced base or constructed arithmetically,
// the same rule the 64-bit envelope edge and the wide integers already live
// under.
func:lit_ranged = int32(ExprTyper->:e, ExprNode:n, int32:ty) never fails {
    int64:v = n.payload;
    int32:k = raw type_kind(e.types, ty);
    int32:bits = raw type_int_bits(e.types, ty);
    int64:lo = 0i64;
    int64:hi = 0i64;
    bool:check = false;

    if (k == (raw TY_INT())) {
        if (raw type_is_signed(e.types, ty)) {
            if (bits < 64i32) {
                hi = (1i64 << ((bits - 1i32) => int64)) - 1i64;
                lo = (0i64 - hi) - 1i64;
                check = true;
            }
        } else {
            hi = 9223372036854775807i64;
            if (bits < 64i32) { hi = (1i64 << (bits => int64)) - 1i64; }
            check = true;
        }
    }
    if (k == (raw TY_TBB())) {
        hi = 9223372036854775807i64;
        if (bits < 64i32) { hi = (1i64 << ((bits - 1i32) => int64)) - 1i64; }
        lo = 0i64 - hi;
        check = true;
    }
    if (k == (raw TY_CHAR())) {
        if (bits == 32i32) {
            if ((v >= 55296i64) && (v <= 57343i64)) {
                pass (raw te_error(e, raw TYPE_LIT_RANGE(),
                    "this `char32` literal is a surrogate code point (U+D800..U+DFFF), which is not a Unicode scalar value",
                    n.span));
            }
            hi = 1114111i64;
        } else {
            hi = (1i64 << (bits => int64)) - 1i64;
        }
        check = true;
    }

    if (check) {
        if ((v < lo) || (v > hi)) {
            string:m1 = raw string_concat("the value of this literal does not fit `",
                raw type_display(e.types, e.interns, ty));
            pass (raw te_error(e, raw TYPE_LIT_RANGE(),
                raw string_concat(m1,
                    "` (D-148): the number in the program would not be the number written; a signed type's most negative value is spelled in a balanced base or constructed arithmetically"),
                n.span));
        }
    }
    pass ty;
};

// An unsuffixed literal may only take a context type of its OWN family: `42` can
// become an `int64` and never a `flt64`, because `42` and `42.0` are different
// tokens and the one that was written is the one that counts.
func:kind_wanted = int32(ExprTyper->:_~e, string:example) never fails {
    if (raw string_eq(example, "42i32")) { pass (raw TY_INT()); }
    pass (raw TY_FLOAT());
};

// `NIL`, `NULL`, `ERR` — three sentinels, three types (TYPE_REFERENCE §27).
//
// `NULL` AND `NIL` ARE A PAIR, and it is the same pair the language has always
// named: **`NULL` is no pointer, `NIL` is no value.** Both are contextual for the
// same reason an unsuffixed literal is — a null `int32->` and a null `Frame->`
// are not the same value to anything downstream, and neither are an empty
// `int32?` and an empty `Point?`.
//
// `NIL` HAS TWO CONTEXTS AND ONE MEANING (D-099). Where an `Optional<T>` is
// expected it is the empty one; anywhere else it is the zero-sized unit value
// (D-084) that a function returning nothing useful passes. Those are not two
// meanings wearing one spelling — "no value" is what it says in both, which is
// what lets it survive the blueprint rule. Only `NIL` did not read its context
// before this: it typed as the unit value everywhere, so `int32?:a = NIL;` — the
// spelling the prototype's own `test_nil_optional.npk` is built out of — reported
// a mismatch against the very type it constructs.
func:type_sentinel = int32(ExprTyper->:e, ExprNode:n) never fails {
    int64:which = n.payload;
    // `ERR` takes the WIDTH OF ITS SLOT (0.9.5): the sentinel is a state every
    // tbb width has, and `tbb64:e = ERR;` typing as tbb32 was a mismatch about
    // nothing. Bare `ERR` with no tbb context stays tbb32, the working width.
    if (which == 2i64) {
        int32:werr = raw expected_value(e);
        if (werr != 0i32) {
            if ((raw type_kind(e.types, werr)) == (raw TY_TBB())) {
                pass werr;
            }
        }
        pass (e.types.t_tbb32);
    }

    if (which == 0i64) {
        if (e.expected != 0i32) {
            if ((raw type_kind(e.types, e.expected)) == (raw TY_OPTIONAL())) {
                pass (e.expected);
            }
        }
        // NOT AN ERROR WITH NO CONTEXT, and here the two sentinels part company.
        // `NULL` has no type of its own to fall back to, but `NIL` does — it is
        // the unit value, and `pass NIL;` is the most common statement in the
        // language.
        pass (e.types.t_nil);
    }

    int32:want = raw expected_value(e);
    if (want != 0i32) {
        if ((raw type_kind(e.types, want)) == (raw TY_POINTER())) {
            pass want;
        }
    }
    pass (raw te_error(e, raw TYPE_UNKNOWN(),
        "`NULL` is valid only where a pointer type is expected, and nothing here says which pointer",
        n.span));
};

// --- the operators ----------------------------------------------------------------------

// Arithmetic: `+ - * / %`. NUMBERS ONLY, and `type_is_numeric` is deliberately
// narrow (0.4.0).
pub func:type_arithmetic = int32(ExprTyper->:e, Span:at, int32:lt, int32:rt) never fails {
    // A type that already failed produces no second complaint.
    if (raw type_is_invalid(e.types, lt)) { pass 0i32; }
    if (raw type_is_invalid(e.types, rt)) { pass 0i32; }

    // `tbb` ARITHMETIC IS REAL (D-008): saturating, ERR-propagating, sticky —
    // operations that belong to the TYPE, which is exactly why the backend lowers
    // them at 0.9 rather than as one `add`. The CHECKER's job is only the type,
    // and the type of `tbb32 + tbb32` is `tbb32`; refusing here made
    // `tests/rejection/tbb_arithmetic.npk` fail in the wrong stage, with a type
    // error where D-085 promises a rung refusal.
    if ((raw type_kind(e.types, lt)) == (raw TY_TBB())) {
        if (lt == rt) { pass lt; }
    }
    // A `tbb` MIXED WITH ANYTHING ELSE — a plain integer, or another `tbb`
    // width — is the refusal, and it is said as one (1.0.8). This fell through
    // to "is not a number, so it has no arithmetic", which contradicted the
    // branch above it and blamed the type rather than the mixing.
    if ((raw type_kind(e.types, lt)) == (raw TY_TBB())) {
        pass (raw te_tbb_mixed(e, at, lt, rt));
    }
    if ((raw type_kind(e.types, rt)) == (raw TY_TBB())) {
        pass (raw te_tbb_mixed(e, at, rt, lt));
    }

    // D-143: `flt128` stores and moves; it does not compute. (Soft-float
    // binary128 is verification-grade work with no consumer; the decision is
    // recorded, not deferred.)
    if ((raw type_kind(e.types, lt)) == (raw TY_FLOAT())) {
        if ((raw type_int_bits(e.types, lt)) == 128i32) {
            pass (raw te_error(e, raw TYPE_FLOAT_RULES(),
                "`flt128` is a storage format (D-143): it holds and moves values but has no arithmetic",
                at));
        }
    }
    if (!(raw type_is_numeric(e.types, lt))) {
        pass (raw te_operand_error(e, at, lt));
    }
    if (!(raw type_is_numeric(e.types, rt))) {
        pass (raw te_operand_error(e, at, rt));
    }

    int32:common = raw unify(e, lt, rt);
    if (common == 0i32) {
        pass (raw te_mismatch(e, at, lt, rt));
    }
    pass common;
};

func:te_tbb_mixed = int32(ExprTyper->:e, Span:at, int32:tbb, int32:other) never fails {
    string:m1 = raw string_concat("`", raw type_display(e.types, e.interns, tbb));
    string:m2 = raw string_concat(m1, "` computes only with another `");
    string:m3 = raw string_concat(m2, raw type_display(e.types, e.interns, tbb));
    string:m4 = raw string_concat(m3, "`: a `tbb`'s arithmetic carries ERR, stickiness and saturation (D-008), so it does not mix with `");
    string:m5 = raw string_concat(m4, raw type_display(e.types, e.interns, other));
    string:m6 = raw string_concat(m5, "`; cast the other operand to the same `tbb` width");
    pass (raw te_error(e, raw TYPE_NOT_NUMERIC(), m6, at));
};

// The message names the TYPE that made it wrong, and says why that type is not a
// number — because "./invalid operand" leaves the reader to work out which of two
// familiar-looking things the compiler objected to.
func:te_operand_error = int32(ExprTyper->:e, Span:at, int32:t) never fails {
    string:d = raw type_display(e.types, e.interns, t);
    string:m1 = raw string_concat("`", d);
    string:m2 = raw string_concat(m1, "` is not a number, so it has no arithmetic: ");
    string:m3 = raw string_concat(m2, raw why_not_numeric(e, t));
    pass (raw te_error(e, raw TYPE_NOT_NUMERIC(), m3, at));
};

// Each of these is representationally an integer, so the reason has to be stated
// or the diagnostic looks arbitrary.
pub func:why_not_numeric = string(ExprTyper->:e, int32:t) never fails {
    int32:k = raw type_kind(e.types, t);
    if (k == (raw TY_BOOL())) {
        pass "a `bool` is two values, not a small integer";
    }
    if (k == (raw TY_CHAR())) {
        pass "a character is not its code point (D-005); cast if you mean the number";
    }
    if (k == (raw TY_TBB())) {
        pass "a `tbb` computes only with another `tbb` of its own width: its arithmetic carries ERR, stickiness and saturation (D-008), which no other type's does";
    }
    if (k == (raw TY_KERNEL())) {
        pass "a kernel identifier compares but does not compute (D-042): an `fd` plus one is not an `fd`";
    }
    if (k == (raw TY_POINTER())) {
        pass "pointer stepping is spelled `@p[i]` — the address of the i-th element (0.9.7 collapsed the planned `#ptr_add` into it: one mechanism, one spelling)";
    }
    pass "it is not a numeric type";
};

pub func:te_mismatch = int32(ExprTyper->:e, Span:at, int32:lt, int32:rt) never fails {
    string:m1 = raw string_concat("`", raw type_display(e.types, e.interns, lt));
    string:m2 = raw string_concat(m1, "` and `");
    string:m3 = raw string_concat(m2, raw type_display(e.types, e.interns, rt));
    string:m4 = raw string_concat(m3, "` are different types; write the cast you mean");
    // Two integers differing only in width is the case that looks like it ought
    // to work, so it gets the reason rather than just the refusal.
    if (raw type_is_integer(e.types, lt)) {
        if (raw type_is_integer(e.types, rt)) {
            if ((raw type_is_signed(e.types, lt)) == (raw type_is_signed(e.types, rt))) {
                m4 = raw string_concat(m4,
                    "; a widening would decide which width this operation happens in, and that decision must be visible in the source rather than following from the operands");
            } else {
                m4 = raw string_concat(m4,
                    "; signed and unsigned are not two sizes of one thing, and converting between them maps every negative value onto a large positive one");
            }
        }
    }
    pass (raw te_error(e, raw TYPE_MISMATCH(), m4, at));
};

// Comparison: `== != < <= > >= <=>`. Wider than arithmetic — the types that
// COMPARE but do not compute are exactly `tbb` and the kernel identifiers, and
// comparison is what they are for.
func:type_comparison = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt,
                             bool:ordered) never fails {
    if (raw type_is_invalid(e.types, lt)) { pass (e.types.t_bool); }
    if (raw type_is_invalid(e.types, rt)) { pass (e.types.t_bool); }

    int32:common = raw unify(e, lt, rt);
    if (common == 0i32) {
        discard(raw te_mismatch(e, n.span, lt, rt));
        pass (e.types.t_bool);
    }

    // D-143: `flt128` does not compare either — even `fcmp` at that width is a
    // soft-float libcall this implementation does not provide.
    if ((raw type_kind(e.types, common)) == (raw TY_FLOAT())) {
        if ((raw type_int_bits(e.types, common)) == 128i32) {
            discard(raw te_error(e, raw TYPE_FLOAT_RULES(),
                "`flt128` is a storage format (D-143): it holds and moves values but has no comparison",
                n.span));
            pass (e.types.t_bool);
        }
    }

    // EQUALITY IS WIDER THAN ORDERING (D-093). `==` on a `bool` or an `fd` is
    // ordinary; `<` on either is a question nobody means to ask.
    if (ordered) {
        if (!(raw type_is_ordered(e.types, common))) {
            string:m1 = raw string_concat("`", raw type_display(e.types, e.interns, common));
            string:m2 = raw string_concat(m1, "` has no ordering: ");
            m2 = raw string_concat(m2, raw why_not_ordered(e, common));
            discard(raw te_error(e, raw TYPE_NOT_NUMERIC(), m2, n.span));
        }
    } else {
        // `==`/`!=` ON AN AGGREGATE IS REFUSED HERE (D-169, 1.0.9c). Equality on
        // a struct, array, `Result`, `string`, `dyn`, a payload-carrying enum,
        // or two non-`NIL` `Optional`s has no one meaning the language will pick
        // — `Eq` is the spelling that gives it one. It reached the backend as an
        // `icmp` on an aggregate, refused there as a rung (which names valid
        // Nitpick); the refusal is the checker's now. `x == NIL` is the one
        // aggregate equality that stays, because it asks something unambiguous.
        if (!(raw equatable(e, n, common))) {
            string:e1 = raw string_concat("`",
                            raw type_display(e.types, e.interns, common));
            string:e2 = raw string_concat(e1,
                "` has no built-in `==`: derive or implement `Eq` and compare with `a.eq(b)`");
            discard(raw te_error(e, raw TYPE_NOT_COMPARABLE(), e2, n.span));
        }
    }
    pass (e.types.t_bool);
};

// MAY `==`/`!=` COMPARE THESE (D-169)? Scalars, pointers and kernel identifiers
// have a built-in equality; aggregates do not. The one aggregate exception is
// `x == NIL` — one operand written as the `NIL` sentinel — which asks whether an
// `Optional` holds a value, an unambiguous question the backend answers by tag.
// The `NIL` side is found on the AST, not by type: an unsuffixed `NIL` in a
// comparison takes the `Optional`'s type by context (D-092), so by the time this
// runs neither operand's TYPE is `TY_NIL` any more.
func:equatable = bool(ExprTyper->:e, ExprNode:n, int32:common) never fails {
    int32:k = raw type_kind(e.types, common);
    if (k == (raw TY_STRUCT())) { pass false; }
    if (k == (raw TY_ARRAY()))  { pass false; }
    if (k == (raw TY_RESULT())) { pass false; }
    if (k == (raw TY_STRING())) { pass false; }
    if (k == (raw TY_DYN()))    { pass false; }
    if (k == (raw TY_OPTIONAL())) {
        if (raw expr_is_nil_lit(e, raw expr_lhs(n))) { pass true; }
        if (raw expr_is_nil_lit(e, raw expr_rhs(n))) { pass true; }
        pass false;
    }
    if (k == (raw TY_ENUM())) {
        // A payload-less enum is its tag — an integer compare; one that carries
        // a payload is an aggregate, and `Eq` is how its payloads compare.
        pass (!(raw enum_has_payload(e.ast, e.types, common)));
    }
    pass true;
};

// The `NIL` sentinel written as such — `ExprSentinelLiteral` with payload 0
// (NULL and ERR are the other two, with non-zero payloads). Mirrors the
// backend's `expr_is_nil_literal`, so both sides admit the same `== NIL`.
func:expr_is_nil_lit = bool(ExprTyper->:e, ExprId:eid) never fails {
    ExprNode:en = raw ast_expr(e.ast, eid);
    if (en.kind != ExprKind.ExprSentinelLiteral) { pass false; }
    pass (en.payload == 0i64);
};

pub func:why_not_ordered = string(ExprTyper->:e, int32:t) never fails {
    int32:k = raw type_kind(e.types, t);
    if (k == (raw TY_BOOL())) {
        pass "`false < true` is an accident of representation, not a fact about booleans";
    }
    if (k == (raw TY_TBB())) {
        pass "error codes are compared against named constants, not sorted";
    }
    if (k == (raw TY_KERNEL())) {
        pass "a kernel identifier is an opaque handle, and the order the kernel handed them out means nothing (D-042); cast if the number is what is meant";
    }
    pass "only integers, floats and characters have one";
};

// `&& || !` take `bool` AND NOTHING ELSE. There is no truthiness: an integer is
// not a condition, a pointer is not a condition, and `if (n)` is not a shorthand
// for `if (n != 0i32)`.
func:type_logical = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt) never fails {
    drop require_bool(e, lt, n.span);
    drop require_bool(e, rt, n.span);
    pass (e.types.t_bool);
};

pub func:require_bool = NIL(ExprTyper->:e, int32:t, Span:at) never fails {
    if (raw type_is_invalid(e.types, t)) { pass NIL; }
    if (t == e.types.t_bool) { pass NIL; }
    string:m1 = raw string_concat("this must be a `bool`, and is `",
                                    raw type_display(e.types, e.interns, t));
    string:m2 = raw string_concat(m1,
        "`; there is no truthiness in Nitpick, so write the comparison you mean");
    discard(raw te_error(e, raw TYPE_MISMATCH(), m2, at));
    pass NIL;
};

// Bitwise `& | ^ << >>`: INTEGERS ONLY. Not `bool` — `&&` is the logical
// operator and a bitwise `&` on two booleans is someone reaching for it.
pub func:type_bitwise = int32(ExprTyper->:e, Span:at, int32:lt, int32:rt) never fails {
    if (raw type_is_invalid(e.types, lt)) { pass 0i32; }
    if (raw type_is_invalid(e.types, rt)) { pass 0i32; }

    if (!(raw type_is_integer(e.types, lt))) {
        pass (raw te_bitwise_error(e, at, lt));
    }
    if (!(raw type_is_integer(e.types, rt))) {
        pass (raw te_bitwise_error(e, at, rt));
    }
    int32:common = raw unify(e, lt, rt);
    if (common == 0i32) {
        pass (raw te_mismatch(e, at, lt, rt));
    }
    pass common;
};

func:te_bitwise_error = int32(ExprTyper->:e, Span:at, int32:t) never fails {
    string:d = raw type_display(e.types, e.interns, t);
    string:m1 = raw string_concat("`", d);
    string:m2 = raw string_concat(m1, "` has no bitwise operations");
    if (t == e.types.t_bool) {
        m2 = raw string_concat(m2, "; `!`, `&&` and `||` are the logical operators");
    }
    pass (raw te_error(e, raw TYPE_NOT_NUMERIC(), m2, at));
};

// `++` / `--` are STRUCK at parse (D-174) — the parser refuses them by name
// before the checker runs, so this never fires on a clean program. It stays
// because `ExprPostfixExpr` must be typed (`check_kinds_typed`): numbers only,
// the same rule as `+`, so a stray node reached defensively still types honestly.
func:type_postfix = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:t = raw type_of_expr(e, raw expr_operand(n));
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if (t == 0i32) { pass 0i32; }
    if (!(raw type_is_numeric(e.types, t))) {
        pass (raw te_operand_error(e, n.span, t));
    }
    pass t;
};

// `<-p` — full dereference. The arrow points back because it brings the value
// back (the blueprint reading), and the type is what it points at.
func:type_deref = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:t = raw type_of_expr(e, raw expr_operand(n));
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if (t == 0i32) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_POINTER())) {
        string:m1 = raw string_concat("`<-` needs a pointer, and this is `",
                                        raw type_display(e.types, e.interns, t));
        pass (raw te_error(e, raw TYPE_MISMATCH(),
                             raw string_concat(m1, "`"), n.span));
    }
    int32:pointee = raw type_elem(e.types, t);
    // DEREFERENCING AN `any->` IS REFUSED HERE, not left to the backend. The
    // pointee is type-erased, so there is no type to produce and no size to load;
    // `p => T` first is the only correct route (TYPE_REFERENCE §27).
    if ((raw type_kind(e.types, pointee)) == (raw TY_ANY())) {
        pass (raw te_error(e, raw TYPE_MISMATCH(),
            "`any->` is type-erased and cannot be dereferenced; cast it to a concrete pointer first",
            n.span));
    }
    pass pointee;
};

// `lo..hi` / `lo...hi` (D-093). The endpoints must have a common type AND that
// type must have an ordering, because a range whose ends cannot be ordered
// describes no set of values.
func:type_range_expr = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:saved = e.expected;
    int32:lo = 0i32;
    int32:hi = 0i32;
    if (raw takes_type_from_context(e, raw expr_lhs(n))) {
        hi = raw type_of_expr(e, raw expr_rhs(n));
        if (hi != 0i32) { e.expected = hi; }
        lo = raw type_of_expr(e, raw expr_lhs(n));
        e.expected = saved;
    } else {
        lo = raw type_of_expr(e, raw expr_lhs(n));
        if (lo != 0i32) { e.expected = lo; }
        hi = raw type_of_expr(e, raw expr_rhs(n));
        e.expected = saved;
    }
    if (raw type_is_invalid(e.types, lo)) { pass 0i32; }
    if (raw type_is_invalid(e.types, hi)) { pass 0i32; }

    int32:common = raw unify(e, lo, hi);
    if (common == 0i32) {
        pass (raw te_mismatch(e, n.span, lo, hi));
    }
    // D-145: a range normalizes to half-open at construction, which needs a
    // DISCRETE successor — floats have none (`hi + 1` means nothing at 1e300),
    // so floats may not form ranges.
    if ((raw type_kind(e.types, common)) == (raw TY_FLOAT())) {
        pass (raw te_error(e, raw TYPE_FLOAT_RULES(),
            "floats may not form ranges (D-145): a range is half-open over a discrete successor, which a float does not have",
            n.span));
    }
    if (!(raw type_is_ordered(e.types, common))) {
        string:m1 = raw string_concat("a range needs an ordered type, and `",
                                        raw type_display(e.types, e.interns, common));
        string:m2 = raw string_concat(m1, "` has none: ");
        pass (raw te_error(e, raw TYPE_NOT_NUMERIC(),
                             raw string_concat(m2, raw why_not_ordered(e, common)),
                             n.span));
    }
    pass (raw tt_range(e.types, common,
                       raw type_size(e.types, common),
                       raw type_align(e.types, common)));
};

// `is (c) : a : b`. The condition is a strict `bool` like every other condition,
// and the two arms must have a common type — a conditional that produced one type
// or another depending on which way it went would have no type at all.
func:type_ternary = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:c = raw type_of_expr(e, raw expr_lhs(n));
    drop require_bool(e, c, n.span);

    int32:saved = e.expected;
    int32:a = raw type_of_expr(e, raw expr_rhs(n));
    if (a != 0i32) { e.expected = a; }
    int32:b = raw type_of_expr(e, raw expr_third(n));
    e.expected = saved;

    if (raw type_is_invalid(e.types, a)) { pass 0i32; }
    if (raw type_is_invalid(e.types, b)) { pass 0i32; }
    int32:common = raw unify(e, a, b);
    if (common == 0i32) {
        pass (raw te_mismatch(e, n.span, a, b));
    }
    pass common;
};

// `expr ?| fallback` / `expr defaults fallback` — a scoped fallback for an entire
// expression chain (OP_REFERENCE §0.1). Both sides must land on one type, since
// the point is that the reader cannot tell which one they got.
func:type_defaults = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:saved = e.expected;
    int32:a = raw type_of_expr(e, raw expr_lhs(n));
    if (a != 0i32) { e.expected = a; }
    int32:b = raw type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    if (raw type_is_invalid(e.types, a)) { pass 0i32; }
    if (raw type_is_invalid(e.types, b)) { pass 0i32; }
    int32:common = raw unify(e, a, b);
    if (common == 0i32) {
        pass (raw te_mismatch(e, n.span, a, b));
    }
    pass common;
};

// `expr => T` and `expr =>! T`.
//
// THE TARGET TYPE IS THE CONTEXT the operand is typed in, so `1 => int64` works:
// an unsuffixed literal in a cast takes the target's type and the cast is then a
// no-op. Without that, the one place a programmer states a type outright would
// be the one place a bare literal could not be written.
func:type_cast_expr = int32(ExprTyper->:e, ExprNode:n, bool:unchecked) never fails {
    TypeResolver:r = raw etyper_resolver(e);
    TypeId:target_node = TypeId{ index: n.b };
    int32:to = raw resolve_type(@r, target_node, e.scope);

    int32:saved = e.expected;
    e.expected = to;
    int32:from = raw type_of_expr(e, raw expr_operand(n));
    e.expected = saved;

    if (from == 0i32) { pass to; }

    // FORGING A PAYLOAD-CARRYING ENUM FROM AN INTEGER IS REFUSED AT THE CHECKER
    // (1.0.9c). `intN =>! enum` forges a TAG — legal for a payload-LESS enum,
    // whose value IS its tag, and the round-trip 88 sites depend on (D-... the
    // `payload =>! TokenKind` case). A payload-carrying enum is a `{tag,
    // payload}` value; a tag alone leaves the payload invented, which is not a
    // cast. It reached the backend as "a cast between non-scalar types" — a rung,
    // which names valid Nitpick — so the refusal moves here, by name.
    if (!(raw type_is_invalid(e.types, from))) {
        if (!(raw type_is_invalid(e.types, to))) {
            if (raw type_is_integer(e.types, from)) {
                if ((raw type_kind(e.types, to)) == (raw TY_ENUM())) {
                    if (raw enum_has_payload(e.ast, e.types, to)) {
                        string:ce1 = raw string_concat("`",
                            raw type_display(e.types, e.interns, to));
                        pass (raw te_error(e, raw TYPE_NO_CAST(),
                            raw string_concat(ce1,
                                "` carries a payload, so an integer cannot forge it — a tag is not a whole `{tag, payload}` value; construct the variant with its payload, `E.Variant(…)`"),
                            n.span));
                    }
                }
            }
        }
    }
    pass (raw check_cast(e.types, e.interns, e.diags, from, to, unchecked, n.span));
};

// --- unwrapping a `Result` -----------------------------------------------------------------
//
// The shared half of `raw`, `relay`, `drop` and `await`: the operand must be a
// `Result<T>`, and the answer is `T`.
//
// APPLYING ONE OF THESE TO A PLAIN VALUE IS AN ERROR rather than a no-op. A
// permissive `raw` on a non-`Result` would be the kind of harmless-looking
// tolerance that lets `raw x` survive a refactor after `x` stopped being a call
// — and then the next reader believes there is error handling there.
// THE LICENCE (D-163 rules 3-4, 1.1.2). The operand of `raw`/`drop` must be a
// call whose resolved callee declares `never fails` — read from the callee's
// declaration (direct and UFCS/method; for a `dyn` call the checker recorded
// the TRAIT's declaration, which is rule 5's reading), the function TYPE's
// flag (an indirect call), or the builtin column. `drop` additionally requires
// the success type `NIL`, with the spawn form (an `async` callee) exempt.
//
// Returns 0 licensed / 1 unlicensed-callee / 2 not-a-call / 3 value-drop.
func:unwrap_licence_of = int32(ExprTyper->:e, ExprNode:opn, ExprId:opid) never fails {
    // `raw`/`drop` over an AWAIT judge the awaited CALL (D-177): the await is
    // when, the call is what. An `async` callee is never `never fails`
    // (D-163 rule 2), so `raw await f()` is refused with the standard answer.
    if (opn.kind == ExprKind.ExprAwaitExpr) {
        ExprId:ai = raw expr_operand(opn);
        pass (raw unwrap_licence_of(e, raw ast_expr(e.ast, ai), ai));
    }
    if (opn.kind == ExprKind.ExprCallExpr) {
        ExprNode:cal = raw ast_expr(e.ast, raw expr_callee(opn));
        if (cal.kind == ExprKind.ExprIdentifierExpr) {
            if (cal.a != 0i32) {
                Symbol:sym = raw symtab_get(e.tab, cal.a);
                if (sym.origin_kind == (raw SYM_DECL())) {
                    DeclNode:d = raw ast_decl(e.ast, DeclId{ index: sym.origin });
                    if (d.kind == DeclKind.DeclFunctionDecl) {
                        if (raw fn_declares_never_fails(e.ast, d)) { pass 0i32; }
                        pass 1i32;
                    }
                }
                // a LOCAL or PARAM holding a function value: the type's flag
                int32:ft = raw exprtypes_callee_ft(e.expr_types, opid);
                if (ft != 0i32) {
                    if (raw func_never_fails(e.types, ft)) { pass 0i32; }
                }
                pass 1i32;
            }
            string:bn = raw intern_get(e.interns, cal.payload =>! int32);
            if (raw is_builtin_name(bn)) {
                if (raw builtin_never_fails(bn)) { pass 0i32; }
                pass 1i32;
            }
            // unresolved name: already diagnosed by resolution; stay silent
            pass 0i32;
        }
        // a call through a member or any other callee shape: the recorded
        // function type answers (1.0.6e), or the recorded callee decl below
        int32:ft2 = raw exprtypes_callee_ft(e.expr_types, opid);
        if (ft2 != 0i32) {
            if (raw func_never_fails(e.types, ft2)) { pass 0i32; }
        }
        int32:md0 = raw exprtypes_callee(e.expr_types, opid);
        if (md0 != 0i32) {
            DeclNode:md0n = raw ast_decl(e.ast, DeclId{ index: md0 });
            if (raw fn_declares_never_fails(e.ast, md0n)) { pass 0i32; }
        }
        pass 1i32;
    }
    if (opn.kind == ExprKind.ExprMethodCallExpr) {
        int32:md = raw exprtypes_callee(e.expr_types, opid);
        if (md != 0i32) {
            DeclNode:mdn = raw ast_decl(e.ast, DeclId{ index: md });
            if (raw fn_declares_never_fails(e.ast, mdn)) { pass 0i32; }
        }
        pass 1i32;
    }
    pass 2i32;
};

// The callee's ASYNC bit, for the spawn exemption — 0 when there is no
// resolvable declaration (a builtin or an indirect call is never a spawn).
func:unwrap_callee_is_async = bool(ExprTyper->:e, ExprNode:opn, ExprId:opid) never fails {
    int32:d = 0i32;
    if (opn.kind == ExprKind.ExprMethodCallExpr) {
        d = raw exprtypes_callee(e.expr_types, opid);
    }
    if (opn.kind == ExprKind.ExprCallExpr) {
        ExprNode:cal = raw ast_expr(e.ast, raw expr_callee(opn));
        if (cal.kind == ExprKind.ExprIdentifierExpr) {
            if (cal.a != 0i32) {
                Symbol:sym = raw symtab_get(e.tab, cal.a);
                if (sym.origin_kind == (raw SYM_DECL())) { d = sym.origin; }
            }
        }
    }
    if (d == 0i32) { pass false; }
    DeclNode:dn = raw ast_decl(e.ast, DeclId{ index: d });
    if (dn.kind != DeclKind.DeclFunctionDecl) { pass false; }
    pass (raw decl_has(dn, raw DECL_ASYNC()));
};

func:type_unwrap = int32(ExprTyper->:e, ExprNode:n, string:op) never fails {
    int32:t = raw type_of_expr(e, raw expr_operand(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }

    if ((raw type_kind(e.types, t)) != (raw TY_RESULT())) {
        string:m1 = raw string_concat("`", op);
        string:m2 = raw string_concat(m1, "` needs a `Result`, and this is `");
        string:m3 = raw string_concat(m2, raw type_display(e.types, e.interns, t));
        pass (raw te_error(e, raw TYPE_MISMATCH(),
                             raw string_concat(m3, "`"), n.span));
    }
    pass (raw type_elem(e.types, t));
};

// `e ?| d` — unwrap with a fallback (D-175). The fallback must be the SUCCESS type: a
// default of another type would make the expression's type depend on which way it
// went at runtime.
func:type_safe_unwrap = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:t = raw type_of_expr(e, raw expr_lhs(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_RESULT())) {
        pass (raw te_not_result(e, n, t, "?|"));
    }
    int32:inner = raw type_elem(e.types, t);

    int32:saved = e.expected;
    e.expected = inner;
    int32:d = raw type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    if (d == 0i32) { pass inner; }
    if (raw type_is_invalid(e.types, d)) { pass inner; }
    if (!(raw fits(e, inner, d))) {
        discard(raw te_mismatch(e, n.span, inner, d));
    }
    pass inner;
};

// `e ?? d` — the OPTIONAL one, and ONLY the optional one (D-099).
//
// The prototype's checker also accepted a pointer here, unwrapping it to its
// pointee — `ptr ?? 99i32` meaning "the pointed-to value, or the default if the
// pointer is null". Its own test for that is a stub whose body is a comment
// waiting on `<-`, so the behaviour was specified and never once ran. It is not
// carried across: a `??` that dereferences hides the read behind an operator
// whose whole job elsewhere is to unwrap a wrapper, and `<-` exists precisely so
// that bringing a value back is visible in the source. It would also give one
// operator two meanings chosen by operand type, which is the thing the blueprint
// philosophy forbids first.
func:type_null_coalesce = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:t = raw type_of_expr(e, raw expr_lhs(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_OPTIONAL())) {
        string:m1 = raw string_concat("`??` unwraps an `Optional`, and this is `",
                                        raw type_display(e.types, e.interns, t));
        string:m2 = raw string_concat(m1, "`");
        if ((raw type_kind(e.types, t)) == (raw TY_RESULT())) {
            m2 = raw string_concat(m2, "; `?` is the one that unwraps a `Result`");
        }
        // A POINTER IS THE MISTAKE WORTH NAMING, because the prototype accepted
        // it and somebody may arrive expecting it to work. Both halves of what it
        // did are still writable — they are just written down.
        if ((raw type_kind(e.types, t)) == (raw TY_POINTER())) {
            m2 = raw string_concat(m2,
                "; a pointer is not an `Optional` — `p == NULL` asks whether it points anywhere and `<-p` brings the value back");
        }
        pass (raw te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    int32:inner = raw type_elem(e.types, t);

    int32:saved = e.expected;
    e.expected = inner;
    int32:d = raw type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;
    if (d == 0i32) { pass inner; }
    if (raw type_is_invalid(e.types, d)) { pass inner; }
    if (!(raw fits(e, inner, d))) { discard(raw te_mismatch(e, n.span, inner, d)); }
    pass inner;
};

// `e ?! code` — trap on failure. EXACTLY ONE ARGUMENT, TYPED `tbb32` (D-009),
// and the derivation is what fixes it: `?!` calls `failsafe`, whose signature is
// `func:failsafe = int32(tbb32:err)`, so the arity and the type both follow from
// there rather than being chosen.
//
// A `tbb32` that is itself ERR is LEGAL here and deliberately so — `failsafe`
// receiving a tainted code means "the failure code could not itself be computed",
// which is information, not a mistake.
func:type_emphatic_unwrap = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:t = raw type_of_expr(e, raw expr_lhs(n));

    int32:saved = e.expected;
    e.expected = e.types.t_tbb32;
    int32:c = raw type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    if (c != 0i32) {
        if (!(raw type_is_invalid(e.types, c))) {
            if (c != e.types.t_tbb32) {
                string:m1 = raw string_concat(
                    "`?!` hands its argument to `failsafe`, which takes one `tbb32`, and this is `",
                    raw type_display(e.types, e.interns, c));
                discard(raw te_error(e, raw TYPE_MISMATCH(),
                              raw string_concat(m1, "`"), n.span));
            }
        }
    }

    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_RESULT())) {
        pass (raw te_not_result(e, n, t, "?!"));
    }
    pass (raw type_elem(e.types, t));
};

func:te_not_result = int32(ExprTyper->:e, ExprNode:n, int32:t, string:op) never fails {
    string:m1 = raw string_concat("`", op);
    string:m2 = raw string_concat(m1, "` needs a `Result`, and this is `");
    string:m3 = raw string_concat(m2, raw type_display(e.types, e.interns, t));
    pass (raw te_error(e, raw TYPE_MISMATCH(),
                         raw string_concat(m3, "`"), n.span));
};

// `is_err(tbbValue)` — THE ONE TEST IN THE LANGUAGE GUARANTEED NOT TO TRAP.
//
// ITS OPERAND IS A `tbb`, NOT A `Result`. An earlier reading had it testing a
// `Result`, which is a different question that `.is_error` already answers.
// `OP_REFERENCE` §5 is explicit about what this is for: **comparing or branching
// on an ERR value traps to `failsafe`**, because `bool` has two values and cannot
// represent ERR. So a program needs one way to ask "did this go ERR" that is safe
// on every value, and this is it.
//
// It has a node of its own rather than being a recognised call name because 0.5's
// flow analysis and 0.7's lowering both have to SEE which construct carries that
// guarantee. Recovering it from a callee's spelling is a string comparison
// standing in for a language rule.
func:type_is_err = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:t = raw type_of_expr(e, raw expr_operand(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_TBB())) {
        string:m1 = raw string_concat("`is_err` tests a `tbb` for ERR, and this is `",
                                        raw type_display(e.types, e.interns, t));
        string:m2 = raw string_concat(m1, "`");
        if ((raw type_kind(e.types, t)) == (raw TY_RESULT())) {
            m2 = raw string_concat(m2, "; a `Result` answers that with `.is_error`");
        }
        pass (raw te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    pass (e.types.t_bool);
};

// `Result{value: v, error: e}` — THE ONLY CONSTRUCTOR IN THE LANGUAGE.
//
// `<T>` is never written: it comes from the enclosing function's declared success
// type. That is what lets `pass(v)` and `fail(e)` be sugar over this form rather
// than primitives of their own (TYPE_REFERENCE §11):
//
//     pass(retVal);   ->  return Result{error: 0i32, value: retVal};
//     fail(errCode);  ->  return Result{error: errCode, value: zero};
//
// THERE IS NO `is_error` FIELD (D-069). It is derived as `error != 0` on every
// read, so there is nothing for it to disagree with — a stored flag would be a
// second source of truth about one fact, and two sources of truth eventually
// differ. The prototype stored one; this is a deliberate departure.
func:type_result_literal = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:want = e.fn_success;

    int32:saved = e.expected;
    e.expected = want;
    int32:vt = raw type_of_expr(e, raw expr_lhs(n));
    e.expected = e.types.t_tbb32;
    int32:et = raw type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    // An omitted field is the zero for its side, which is what the desugar of
    // `pass` and `fail` produces — each writes one field and leaves the other.
    if (vt == 0i32) { vt = want; }
    if (et == 0i32) { et = e.types.t_tbb32; }

    if (et != e.types.t_tbb32) {
        if (!(raw type_is_invalid(e.types, et))) {
            string:m1 = raw string_concat("a `Result`'s `error` is a `tbb32`, and this is `",
                                            raw type_display(e.types, e.interns, et));
            discard(raw te_error(e, raw TYPE_MISMATCH(),
                          raw string_concat(m1, "`"), n.span));
        }
    }
    // OUTSIDE A FUNCTION there is no success type to infer from, and inventing one
    // would make the literal mean whatever the value field happened to be.
    if (want == 0i32) {
        pass (raw tt_result(e.types, vt,
                            raw type_size(e.types, vt),
                            raw type_align(e.types, vt)));
    }
    if (!(raw fits(e, want, vt))) {
        if (!(raw type_is_invalid(e.types, vt))) {
            discard(raw te_mismatch(e, n.span, want, vt));
        }
    }
    pass (raw tt_result(e.types, want,
                        raw type_size(e.types, want),
                        raw type_align(e.types, want)));
};

// AN IDENTIFIER'S TYPE IS ITS DECLARATION'S.
//
// Resolution already did the hard part: `resolve_ident` stored the SYMBOL INDEX
// in slot `a` (0.3.5), so this is a lookup rather than a second search. That the
// slot holds a symbol index and not a child expression is safe because
// `expr_shape` files this kind as a LEAF — which is the difference between an
// undocumented reuse and a declared one (D-094).
func:type_ident = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:sym = n.a;
    if (sym == 0i32) {
        // A bare-name builtin resolves to no symbol and that is correct
        // (AST_REFERENCE 3.3). Its signature arrives with call checking.
        pass 0i32;
    }
    Symbol:s = raw symtab_get(e.tab, sym);
    TypeResolver:r = raw etyper_resolver(e);

    // A LOCAL — its annotation is the type. Nitpick has no inferred bindings:
    // every declaration states its type, which is why this needs no unification.
    // A PICK BINDING: the checker recorded the payload's type on the pattern
    // when it checked the `pick` (0.7.7); before that this answered UNKNOWN and
    // unknown propagates silently.
    if (s.origin_kind == (raw SYM_PAT())) {
        PatNode:pn = raw ast_pat(e.ast, PatId{ index: s.origin });
        // THE BINDING'S TYPE, FROM THE WINDOW THE PICK CHECK RECORDED (1.0.9c).
        // A pattern's bindings sit in a window on its payload slot, one type per
        // binding in binding order; this reference's index is where its name
        // sits among the pattern's bindings. Unset (0) is a binding the pick
        // check could not type — unknown, which propagates silently, as it did
        // before any binding was typed at all.
        int32:widx = raw pat_binding_index(e.ast, pn, s.name);
        if (widx < 0i32) { pass 0i32; }
        int32:wstart = pn.payload =>! int32;
        if (wstart == 0i32) { pass 0i32; }
        pass (raw ast_id_at(e.ast, wstart, widx));
    }

    if (s.origin_kind == (raw SYM_STMT())) {
        StmtId:sid = StmtId{ index: s.origin };
        StmtNode:sn = raw ast_stmt(e.ast, sid);
        TypeId:ty = TypeId{ index: sn.a };
        pass (raw resolve_type(@r, ty, e.scope));
    }

    if (s.origin_kind == (raw SYM_DECL())) {
        DeclId:did = DeclId{ index: s.origin };
        DeclNode:dnode = raw ast_decl(e.ast, did);
        if (dnode.kind == DeclKind.DeclParamDecl) {
            // READING A DISCARDED PARAMETER IS AN ERROR (D-089). `Type:_~name`
            // says the parameter is deliberately unused, so a later use is either
            // a mistake or a stale annotation — and both are worth hearing about.
            if (raw param_is_discarded(dnode)) {
                pass (raw te_error(e, raw TYPE_MISMATCH(),
                    "this parameter is declared discarded with `_~`, so it cannot be read; drop the `_~` if it is wanted",
                    n.span));
            }
            pass (raw resolve_type(@r, raw param_type(dnode), e.scope));
        }
        if (dnode.kind == DeclKind.DeclFunctionDecl) {
            pass (raw fn_type(@r, did, s.name, e.scope));
        }
        // AN `extern` FUNCTION IS A FUNCTION. Missing here, its name fell through
        // to the "is a type, not a value" ending below — so every call to a
        // foreign function was refused, and refused with a sentence about the
        // wrong thing.
        if (dnode.kind == DeclKind.DeclExternFn) {
            pass (raw extern_fn_type(@r, dnode, e.scope));
        }
        if (dnode.kind == DeclKind.DeclGlobalDecl) {
            TypeId:ty = TypeId{ index: dnode.a };
            pass (raw resolve_type(@r, ty, e.scope));
        }
        // `<comptime int32:LEVEL>` IS A VALUE, and `pass LEVEL;` reads it as one.
        // Its type is the one the parameter declares — that is the whole content
        // of `comptime int32:LEVEL`, and the reason a value parameter carries a
        // type where a type parameter carries bounds.
        //
        // A TYPE PARAMETER FALLS THROUGH to "is a type, not a value", which is
        // exactly right: `T` names a type and `pass T;` names nothing.
        if (dnode.kind == DeclKind.DeclGenericParam) {
            if (raw generic_is_value(dnode)) {
                pass (raw resolve_type(@r, raw generic_value_type(dnode), e.scope));
            }
        }
        // A NAME THAT IS NOT A VALUE SAYS WHAT IT IS rather than "unknown" — and
        // WHICH kind it is (1.0.8): a macro, a module, a `Rules` block and an
        // enum variant all fell through to "is a type, not a value".
        string:text = raw intern_get(e.interns, s.name);
        string:m1 = raw string_concat("`", text);
        string:m2 = raw string_concat(m1, "` is ");
        string:m3 = raw string_concat(m2, raw decl_kind_article(dnode));
        pass (raw te_error(e, raw TYPE_MISMATCH(),
            raw string_concat(m3, ", not a value"), n.span));
    }

    // A `pick` destructuring binding takes its type from the scrutinee, which
    // needs the pattern checked against it — 0.4.6, with the enum variants.
    pass 0i32;
};

// DOES THIS NODE TAKE ITS TYPE FROM WHERE IT SITS? The nodes that do have to be
// typed AFTER the thing that gives them their type, which is the whole reason
// `type_binary` looks before it walks.
//
// It was named `is_untyped_literal` and answered only for unsuffixed integers,
// on the strength of a comment calling that "the one node whose type depends on
// where it sits". It never was: `NULL` has been contextual since 0.4.2 and `NIL`
// became so with D-099, so `NULL == p` and `NIL == opt` typed their left side
// with no context and reported the sentinel as homeless — while `p == NULL` and
// `opt == NIL`, the same question asked the other way round, worked. One list,
// and a sentinel that gains a context gains its place in the order with it.
// A `&{ }` TEMPLATE (D-168, 1.0.9d). Its parts are string literals and
// interpolations mixed; each renders to a `string`, and the whole is a `string`.
// A `string` part renders as itself; any other interpolation renders through the
// prelude trait `ToString`, so a type with no `ToString` impl is refused by name
// here — the backend has no `to_string` to call for it.
func:type_template = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:ts_name = raw intern_add(e.interns, "ToString");
    int32:ts_type = 0i32;
    int32:ts_sym = raw scope_lookup(e.tab, e.scope, ts_name);
    if (ts_sym != 0i32) {
        Symbol:tss = raw symtab_get(e.tab, ts_sym);
        if (tss.origin_kind == (raw SYM_DECL())) {
            ts_type = raw tt_trait(e.types, tss.origin, ts_name);
        }
    }
    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);
    int32:i = 0i32;
    while (i < count) {
        ExprId:itmid = ExprId{ index: raw ast_id_at(e.ast, start, i) };
        int32:pt = raw type_of_expr(e, itmid);
        if (pt != 0i32) {
            if (!(raw type_is_invalid(e.types, pt))) {
                if (pt != e.types.t_string) {
                    bool:ok = false;
                    if (ts_type != 0i32) {
                        ok = raw type_implements(e.impls, e.bounds, e.ast,
                                 e.types, pt, ts_type, raw IMPL_FUEL());
                    }
                    if (!ok) {
                        ExprNode:pn = raw ast_expr(e.ast, itmid);
                        string:m1 = raw string_concat("`",
                            raw type_display(e.types, e.interns, pt));
                        discard(raw te_error(e, raw TYPE_NOT_STRINGABLE(),
                            raw string_concat(m1,
                                "` has no `ToString`, so it cannot be interpolated in a `&{ }` template — a `string` renders as itself, any other type through `ToString`'s `to_string` (D-168); derive or implement it"),
                            pn.span));
                    }
                }
            }
        }
        i = i + 1i32;
    }
    pass (e.types.t_string);
};

pub func:takes_type_from_context = bool(ExprTyper->:e, ExprId:id) never fails {
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = raw ast_expr(e.ast, id);
    // `ERR` is a `tbb32` wherever it appears and is deliberately absent here.
    if (n.kind == ExprKind.ExprSentinelLiteral) { pass (n.payload != 2i64); }
    if (n.kind != ExprKind.ExprIntLiteral) { pass false; }
    pass (!(raw num_width_is_integer(raw expr_num_width(n))));
};

// THE TYPE AN OPERAND SHOULD AIM AT, given the slot it is going into.
//
// An `Optional<U>` slot accepts a bare `U` and wraps it (D-099), so the type a
// VALUE wants there is `U` — the wrapper is supplied by `fits`, not written. The
// sentinels are the exception and read `e.expected` itself, because `NIL` is a
// fact about the wrapper rather than about a value inside it; that is why this is
// a separate accessor instead of a rewrite of `e.expected` at the push sites.
pub func:expected_value = int32(ExprTyper->:e) never fails {
    if (e.expected == 0i32) { pass 0i32; }
    if ((raw type_kind(e.types, e.expected)) == (raw TY_OPTIONAL())) {
        pass (raw type_elem(e.types, e.expected));
    }
    pass (e.expected);
};

// MAY A VALUE OF TYPE `got` BE WRITTEN WHERE `want` IS EXPECTED?
//
// One answer for every slot in the language — a declaration's initialiser, a call
// argument, `pass`, a `Result{…}` field, an unwrap's default. Equality is the
// rule, and D-099's wrap is the single exception: an `Optional<U>` slot takes a
// `U`, which is how an `Optional` holding a value is built now that there is no
// constructor to write.
//
// NOTHING ELSE IS COERCED. No implicit widening (D-092), no numeric conversion,
// no pointer decay. And the wrap is ONE LEVEL, like D-098's dereference: an
// `Optional<Optional<U>>` cannot be written down (see `resolve_type`), so there
// is no second level for this to reach through.
pub func:fits = bool(ExprTyper->:e, int32:want, int32:got) never fails {
    if (want == got) { pass true; }
    // D-163: a `never fails` function SATISFIES a may-fail expectation (it just
    // never uses the error), but a may-fail function CANNOT fill a never-fails
    // slot. `types_agree` compares only the shape (it ignores the never-fails
    // bit), so the one-directional refusal is applied here, before it.
    if (raw type_is_func(e.types, want)) {
        if (raw type_is_func(e.types, got)) {
            if (raw func_never_fails(e.types, want)) {
                if (!(raw func_never_fails(e.types, got))) { pass false; }
            }
        }
    }
    if (raw types_agree(e, want, got)) { pass true; }
    if ((raw type_kind(e.types, want)) == (raw TY_OPTIONAL())) {
        if ((raw type_elem(e.types, want)) == got) { pass true; }
    }
    // A `dyn` SLOT TAKES ANY TYPE THAT IMPLEMENTS ITS TRAITS (5.2), and another
    // `dyn` that carries at least them (5.3). This is not a coercion in the sense
    // the paragraph above rules out — nothing about the value changes, it is a
    // fat pointer either way — it is a question about what was implemented, and
    // the impl table is the only thing that can answer it.
    if ((raw type_kind(e.types, want)) == (raw TY_DYN())) {
        bool:ok = raw dyn_accepts(e.impls, e.bounds, e.ast, e.types, want, got);
        // A COERCION IS A COMMIT, SO IT IS WHERE THE FAMILY INSTANTIATION IS
        // NOTED (1.0.9b). `fits` is a predicate everywhere else; the one place
        // it is a predicate the checker acts on is a `dyn` slot accepting a
        // value, and the vtable that acceptance implies is emitted from a
        // recorded instantiation, which a call would have recorded and a bare
        // coercion would not. Guarded to a family instance inside the recorder.
        if (ok) { drop record_dyn_family_methods(e, want, got); }
        pass ok;
    }
    pass false;
};

// --- the walk ----------------------------------------------------------------------------

// EVERY EXPRESSION'S TYPE IS RECORDED AS IT IS COMPUTED (0.5.0).
//
// A WRAPPER RATHER THAN A RECORDING AT EVERY `pass`. `type_of_expr` returns from
// forty-odd places, several of them error paths, and a recording written at each
// would be forty chances to forget one — and a missing entry is indistinguishable
// from an expression no walk reached, which is the ambiguity the `known` flag
// exists to keep visible.
//
// THE NONE EXPRESSION IS NOT RECORDED. Index 0 is the reserved absence (0.2.0),
// not an expression, so recording it would claim the checker typed something that
// is not there.
// `#name<T>(...)` — the THREE compiler builtins, and nothing else.
//
// `#` is spelled the same for a builtin and a macro invocation (D-046), so anything
// that is not one of these three has already been refused by the expansion audit
// (D-126) — reaching here with an unknown name means the audit was skipped, which
// is a defect in this compiler rather than in the program.
//
// THE GENERIC ARGUMENT NAMES WHAT THE THING IS *OF*, in both pointer forms.
// `#wild_ptr<int8>(a)` is an `int8->` and `#wild_slice<int8>(p, n)` is an `int8[]`,
// which is the reading that makes the two consistent rather than one naming the
// pointee and the other the pointer.
func:type_builtin = int32(ExprTyper->:e, ExprId:id, ExprNode:n) never fails {
    string:name = raw intern_get(e.interns, raw builtin_name(n));
    int32:gc = raw builtin_generic_count(n);
    int32:start = raw expr_list_start(n);
    int32:argc = (raw expr_list_count(n)) - gc;
    TypeResolver:r = raw etyper_resolver(e);

    if (raw string_eq(name, "size_of")) {
        if (gc != 1i32) {
            pass (raw te_error(e, raw TYPE_GENERIC_ARITY(),
                "`#size_of` takes exactly one type argument", n.span));
        }
        if (argc != 0i32) {
            // A VALUE-argument count is a call-arity mistake and carries the
            // call code, as `check_args` does; the type-argument count above
            // keeps `TYPE_GENERIC_ARITY` ("an arity mistake is in the
            // annotation"). Two codes for two questions (1.0.8).
            pass (raw te_error(e, raw TYPE_MISMATCH(),
                "`#size_of` takes no value arguments; it is a question about a type",
                n.span));
        }
        discard(raw resolve_type(@r, TypeId{ index: raw ast_id_at(e.ast, start, 0i32) },
                          e.scope));
        pass (raw tt_int(e.types, 64i32, true));
    }

    if (raw string_eq(name, "wild_ptr")) {
        if (gc != 1i32) {
            pass (raw te_error(e, raw TYPE_GENERIC_ARITY(),
                "`#wild_ptr` takes exactly one type argument, the type it points at",
                n.span));
        }
        if (argc != 1i32) {
            pass (raw te_error(e, raw TYPE_MISMATCH(),
                "`#wild_ptr` takes exactly one value argument, the address", n.span));
        }
        int32:pointee = raw resolve_type(@r,
                            TypeId{ index: raw ast_id_at(e.ast, start, 0i32) }, e.scope);
        int32:addr = raw type_of_expr(e, ExprId{ index: raw ast_id_at(e.ast, start, 1i32) });
        if (!(raw type_is_invalid(e.types, addr))) {
            if (!(raw type_is_integer(e.types, addr))) {
                pass (raw te_error(e, raw TYPE_MISMATCH(),
                    "`#wild_ptr` takes an integer address; it is the one place an integer becomes a pointer (D-019), and that only reads as deliberate if an address is what was written",
                    n.span));
            }
        }
        pass (raw tt_pointer(e.types, pointee));
    }

    if (raw string_eq(name, "wild_slice")) {
        if (gc != 1i32) {
            pass (raw te_error(e, raw TYPE_GENERIC_ARITY(),
                "`#wild_slice` takes exactly one type argument, the element type",
                n.span));
        }
        if (argc != 2i32) {
            pass (raw te_error(e, raw TYPE_MISMATCH(),
                "`#wild_slice` takes two value arguments, a pointer and an element count",
                n.span));
        }
        int32:elem = raw resolve_type(@r,
                          TypeId{ index: raw ast_id_at(e.ast, start, 0i32) }, e.scope);
        int32:ptr = raw type_of_expr(e, ExprId{ index: raw ast_id_at(e.ast, start, 1i32) });
        int32:len = raw type_of_expr(e, ExprId{ index: raw ast_id_at(e.ast, start, 2i32) });
        if (!(raw type_is_invalid(e.types, ptr))) {
            if ((raw type_kind(e.types, ptr)) != (raw TY_POINTER())) {
                pass (raw te_error(e, raw TYPE_MISMATCH(),
                    "`#wild_slice` takes a pointer and an element count; an extent the compiler cannot verify is exactly as privileged as an address it cannot verify (D-070)",
                    n.span));
            }
        }
        if (!(raw type_is_invalid(e.types, len))) {
            if (!(raw type_is_integer(e.types, len))) {
                pass (raw te_error(e, raw TYPE_MISMATCH(),
                    "`#wild_slice`'s second argument is an element count", n.span));
            }
        }
        pass (raw tt_slice(e.types, elem));
    }

    if (raw string_eq(name, "unreachable")) {
        if (gc != 0i32) {
            pass (raw te_error(e, raw TYPE_GENERIC_ARITY(),
                "`#unreachable` takes no type arguments", n.span));
        }
        if (argc != 0i32) {
            pass (raw te_error(e, raw TYPE_MISMATCH(),
                "`#unreachable` takes no arguments; it marks a point control never reaches (D-061)",
                n.span));
        }
        // IT PRODUCES NO VALUE (D-061): control never returns from it, so it
        // takes whatever type its position expects — a `pick` arm's, an
        // assignment's — the way a diverging expression fits anywhere. With no
        // context (a bare `#unreachable();` statement) it is `NIL`, which the
        // statement discards.
        int32:uw = raw expected_value(e);
        if (uw != 0i32) { pass uw; }
        pass (e.types.t_nil);
    }

    drop diaglist_push(e.diags, raw diag_error(raw TYPE_INTERNAL(),
        "this `#name(...)` reached the type checker without being expanded or recognised, which the expansion audit should have refused",
        n.span));
    pass 0i32;
};

// `comptime(expr)` — A FORCING FORM. It says the expression HAS to fold, so failing
// to fold is the error rather than a quiet fall-through to something else.
//
// AN UNTYPED RESULT TAKES THE CONTEXT TYPE, exactly as an unsuffixed literal does
// (D-092): `int64:n = comptime(2i32 * 2i32)` gets its width from the same place
// `int64:n = 4` would.
func:type_comptime = int32(ExprTyper->:e, ExprId:id, ExprNode:n) never fails {
    TypeResolver:r = raw etyper_resolver(e);
    ConstVal:cv = raw fold_const(@r, ExprId{ index: n.a }, e.scope);
    if (!(raw cv_folded(cv))) {
        if (raw fold_gave_up(@r)) { pass 0i32; }
        pass (raw te_error(e, raw TYPE_NOT_CONSTANT(),
            "`comptime` requires an expression that folds at compile time, and this one does not",
            n.span));
    }
    if (cv.type_id != 0i32) { pass cv.type_id; }

    int32:want = raw expected_value(e);
    if (want != 0i32) {
        if (raw type_is_integer(e.types, want)) { pass want; }
        // The slot SAYS what it is, and it is not an integer (1.0.8): the
        // unsuffixed `comptime` value cannot take a width from it.
        string:c1 = raw string_concat("this `comptime` value has no width and sits in a `",
                        raw type_display(e.types, e.interns, want));
        pass (raw te_error(e, raw TYPE_MISMATCH(),
            raw string_concat(c1, "` slot, which is not an integer; write a suffix inside it"),
            n.span));
    }
    pass (raw te_error(e, raw TYPE_UNKNOWN(),
        "this `comptime` value has no width and nothing here says what it should be; write a suffix inside it or give the surrounding expression a type",
        n.span));
};

// MOVED HERE FROM `type_stmt.npk` IN 0.6.7. It is a sentence about two EXPRESSION
// types and needs nothing from a statement, but living in the statement checker made
// every module that reported a mismatch depend on it — and the struct literal rule
// below reports one. `tests/frontend/type_expr.npk` compiles a group with the
// expression checker and without the statement checker, and it did not build.
//
// The third of these this cycle, after `stmt_carries_expr` and `ensure_layout`: a
// dependency that only holds because some other group happens to pull both in is not
// one anybody declared.
// One message for every "this value does not fit there", naming both types in
// the order the reader wrote them.
pub func:te_assign_mismatch = NIL(ExprTyper->:e, int32:want, int32:got, Span:at) never fails {
    // D-163: a may-fail function where a `never fails` one is expected gets its
    // OWN code and message — the shapes agree and only the contract differs, so
    // the generic mismatch would name two types that look almost identical
    // without saying which part disagrees.
    if (raw type_is_func(e.types, want)) {
        if (raw type_is_func(e.types, got)) {
            if (raw func_never_fails(e.types, want)) {
                if (!(raw func_never_fails(e.types, got))) {
                    drop diaglist_push(e.diags, raw diag_error(
                        raw TYPE_NEVER_FAILS_ASSIGN(),
                        "a may-fail function cannot fill a `never fails` slot (D-163): the contract is part of the type, and this function does not make the guarantee",
                        at));
                    pass NIL;
                }
            }
        }
    }
    string:m1 = raw string_concat("expected `",
                                    raw type_display(e.types, e.interns, want));
    string:m2 = raw string_concat(m1, "`, found `");
    string:m3 = raw string_concat(m2, raw type_display(e.types, e.interns, got));
    string:m4 = raw string_concat(m3, "`");
    // The widths case is worth naming, since it is the one that looks like it
    // ought to work and no longer does (D-092, corrected).
    if (raw type_is_integer(e.types, want)) {
        if (raw type_is_integer(e.types, got)) {
            m4 = raw string_concat(m4,
                "; there is no implicit widening, so write the cast");
        }
    }
    drop diaglist_push(e.diags, raw diag_error(raw TYPE_MISMATCH(), m4, at));
    pass NIL;
};

// `vec2(1.0f64, 2.0f64)` — A CONSTRUCTOR FOR A TYPE THAT DOES NOT EXIST YET.
//
// `TYPE_REFERENCE` §15 puts `vec2`, `vec3`, `vec4`, `matrix<T>` and `tensor<T>` in
// **Tier 1**, and nothing implements that tier: the type system has no vector kind,
// and `vec2:v` reports "there is no type named `vec2`" today.
//
// SO IT IS REFUSED, NAMING THE TIER, rather than typed as INVALID. That is D-085's
// rule one layer up — the parser accepts the whole grammar and a construct no rung
// supports produces a diagnostic that says which — and it is the reason this kind
// comes off the untyped list honestly: it is not accepted unchecked, it is refused
// with a reason.
//
// Inventing a type here would be worse than either: the program would mean
// something the language has not decided, and `simd<T, N>` in §14 is Tier 0 with a
// different spelling that has no lexer support at all, so there is a real question
// about which of the two `vec2` should be.
func:type_vector_ctor = int32(ExprTyper->:e, ExprNode:n) never fails {
    // The components are still typed, so a mistake inside one is reported rather
    // than hidden behind the tier.
    int32:start = raw expr_list_start(n);
    int32:cnt = raw expr_list_count(n);
    int32:i = 0i32;
    while (i < cnt) {
        discard(raw type_of_expr(e, ExprId{ index: raw ast_id_at(e.ast, start, i) }));
        i = i + 1i32;
    }
    pass (raw te_error(e, raw TYPE_TIER(),
        "vector, matrix and tensor types are Tier 1 (`TYPE_REFERENCE` section 15) and no rung supplies one yet, so there is no type for this constructor to build",
        n.span));
};

// `pick (n) { (0i32) { give 1i32; }, (*) { give 2i32; } }` — THE ARMS SHARE A TYPE.
//
// The expression form of `pick` (D-059) produces a value, and every arm has to
// produce the same kind of one. The statement form was checked in 0.4; this had no
// case at all, so an expression-`pick` whose arms gave an `int32` and a `string`
// typed as INVALID and said nothing.
//
// COVERAGE IS NOT ASKED HERE. Whether the arms cover the selector is 0.5.4's
// question and `exhaust.npk` answers it for both forms. This asks only about the
// values, which is the half nothing else answers.
//
// THE TYPE COMES FROM THE FIRST `give`, and the rest are measured against it — the
// same rule the array literal uses, and for the same reason: choosing a "common"
// type would need a widening rule, and D-092 says there is not one.
func:type_pick_expr = int32(ExprTyper->:e, ExprNode:n) never fails {
    discard(raw type_of_expr(e, raw pickx_selector(n)));

    int32:start = raw pickx_arm_start(n);
    int32:cnt = raw pickx_arm_count(n);
    int32:want = raw expected_value(e);
    int32:result = want;

    int32:i = 0i32;
    while (i < cnt) {
        StmtId:arm = StmtId{ index: raw ast_id_at(e.ast, start, i) };
        StmtNode:a = raw ast_stmt(e.ast, arm);
        discard(raw type_of_expr(e, raw arm_guard(a)));

        // EVERY ARM IS WALKED AS A STATEMENT, so a mistake anywhere in its body is
        // reported; the `give` is then looked for on top of that rather than
        // instead of it.
        drop check_stmt(e, raw arm_body(a));
        result = raw arm_give_type(e, raw arm_body(a), result, n.span);
        i = i + 1i32;
    }

    if (result == 0i32) {
        pass (raw te_error(e, raw TYPE_CANNOT_INFER(),
            "this `pick` is used as a value and no arm gives one; an arm that falls off its end has nothing to produce",
            n.span));
    }
    pass result;
};

// THE `give` IN AN ARM'S BODY, CHECKED AGAINST WHAT THE OTHERS GAVE.
//
// One level, because `give` belongs to the arm it is written in: a `give` nested
// inside an `if` inside an arm is a shape the corpus does not write, and walking for
// one would mean deciding what an arm with two of them means.
func:arm_give_type = int32(ExprTyper->:e, StmtId:body, int32:sofar, Span:at) never fails {
    if (raw stmt_is_none(body)) { pass sofar; }
    StmtNode:b = raw ast_stmt(e.ast, body);
    if (b.kind != StmtKind.StmtBlockStmt) { pass sofar; }

    int32:n = raw stmt_list_count(b);
    int32:start = raw stmt_list_start(b);
    int32:cur = sofar;
    int32:i = 0i32;
    while (i < n) {
        StmtNode:st = raw ast_stmt(e.ast,
                          StmtId{ index: raw ast_id_at(e.ast, start, i) });
        if (st.kind == StmtKind.StmtGiveStmt) {
            int32:saved = e.expected;
            e.expected = cur;
            int32:got = raw type_of_expr(e, ExprId{ index: st.a });
            e.expected = saved;
            if (!(raw type_is_invalid(e.types, got))) {
                if (got != 0i32) {
                    if (cur == 0i32) { cur = got; }
                    else {
                        if (!(raw fits(e, cur, got))) {
                            drop te_assign_mismatch(e, cur, got, st.span);
                        }
                    }
                }
            }
        }
        i = i + 1i32;
    }
    pass cur;
};

// `[1i32, 2i32, 3i32]` — ONE ELEMENT TYPE, AND A COUNT (D-129, 0.6.7).
//
// THE EXPECTED TYPE IS THE AUTHORITY WHEN THERE IS ONE, because the declaration is
// where the length was written: `int32[3]:a = [1i32, 2i32];` is wrong about the
// COUNT, and only the annotation knows what the count was supposed to be. Without
// one the literal describes itself — its element type from its first element, its
// length from how many there are — which is the only answer available and is never
// wrong, just less useful.
func:type_array_literal = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:start = raw expr_list_start(n);
    int32:cnt = raw expr_list_count(n);

    int32:want = raw expected_value(e);
    int32:want_elem = 0i32;
    if (want != 0i32) {
        if ((raw type_kind(e.types, want)) == (raw TY_ARRAY())) {
            want_elem = raw type_elem(e.types, want);
            // `[]` IS THE ZERO ARRAY of the expected fixed-array type (0.8.1) —
            // the same rule Result{…} has for its omitted fields: absent means
            // zero. Without it there is NO spelling for a zeroed `T[64]` field,
            // and a struct literal cannot omit fields — so the one construct
            // that needs it (`DiagList{ items: [], … }`) had no legal form. A
            // NON-empty literal still has to match the length exactly: partial
            // initialisation stays unspellable, deliberately, because "the
            // first three, then zeros" is a meaning the reader must guess.
            if (cnt == 0i32) { pass want; }
            if ((raw type_array_count(e.types, want)) != cnt) {
                string:c1 = raw string_concat("this array literal has ",
                                raw int_to_string(cnt => int64));
                string:c2 = raw string_concat(c1, " element(s) and `");
                string:c3 = raw string_concat(c2,
                                raw type_display(e.types, e.interns, want));
                discard(raw te_error(e, raw TYPE_MISMATCH(),
                    raw string_concat(c3, "` has a fixed length; an array's length is part of its type"),
                    n.span));
            }
        }
    }

    // EVERY ELEMENT IS TYPED, whichever way the element type was decided, so that a
    // mistake inside one is reported rather than waiting for the first to settle
    // the question.
    int32:elem = want_elem;
    int32:i = 0i32;
    while (i < cnt) {
        ExprId:v = ExprId{ index: raw ast_id_at(e.ast, start, i) };
        int32:saved = e.expected;
        e.expected = elem;
        int32:got = raw type_of_expr(e, v);
        e.expected = saved;

        if (!(raw type_is_invalid(e.types, got))) {
            if (got != 0i32) {
                if (elem == 0i32) {
                    // THE FIRST ELEMENT SETS IT, and the rest are measured against
                    // that. Picking a "common" type instead would need a widening
                    // rule, and D-092 says there is not one.
                    elem = got;
                } else {
                    if (!(raw fits(e, elem, got))) {
                        drop te_assign_mismatch(e, elem, got, n.span);
                    }
                }
            }
        }
        i = i + 1i32;
    }

    if (elem == 0i32) {
        // EVERY ELEMENT ALREADY FAILED (1.0.8): a non-empty literal reaches here
        // with no element type only when each element reported its own error,
        // and "an empty array literal" about a two-element one was a second,
        // false description of the same mistake.
        if (cnt > 0i32) { pass 0i32; }
        // An EMPTY literal with no annotation describes nothing. `int32[0]:a = [];`
        // is fine; a bare `[]` is a value whose type nobody wrote.
        pass (raw te_error(e, raw TYPE_CANNOT_INFER(),
            "an empty array literal has no element type, and nothing here says what it should be",
            n.span));
    }
    pass (raw tt_array(e.types, elem, cnt,
                       raw type_size(e.types, elem), raw type_align(e.types, elem)));
};

// `a |> f` — THE LEFT SIDE IS WHAT THE RIGHT SIDE TAKES (D-129, 0.6.7).
//
// A pipe is a call written the other way round, so it is checked as one: the right
// side has to BE a function of one parameter, and the left has to fit that
// parameter. Reusing `type_call` is not possible — it reads its arguments out of
// the call node's own window, and a pipe's argument is a sibling node.
func:type_pipe = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:lt = raw type_of_expr(e, raw expr_lhs(n));
    int32:rt = raw type_of_expr(e, raw expr_rhs(n));
    if (raw type_is_invalid(e.types, rt)) { pass 0i32; }

    if (!(raw type_is_func(e.types, rt))) {
        pass (raw te_error(e, raw TYPE_MISMATCH(),
            "the right side of a pipe is the function the value is passed to, and this is not a function",
            n.span));
    }
    int32:np = raw type_param_count_of(e.types, rt);
    if (np != 1i32) {
        string:p1 = raw string_concat("a pipe passes exactly one value, and this function takes ",
                        raw int_to_string(np => int64));
        pass (raw te_error(e, raw TYPE_MISMATCH(),
            raw string_concat(p1, " parameter(s)"), n.span));
    }
    int32:want = raw type_param_at_of(e.ast, e.types, rt, 0i32);
    if (!(raw type_is_invalid(e.types, lt))) {
        if (lt != 0i32) {
            if (!(raw fits(e, want, lt))) {
                drop te_assign_mismatch(e, want, lt, n.span);
            }
        }
    }
    // THE PIPE'S TYPE IS `Result<success>`, EXACTLY AS THE CALL'S IS (D-069). A
    // pipe is `g(x)` written the other way round (DECISIONS §D-... the pipe
    // passes the value, not the `Result`), so it returns what the call returns —
    // the func type stores the success slot, and the wrap happens here, the same
    // one rule `check_args` applies. Returning the bare success (before 1.0.9c)
    // made `x |> g` and `g(x)` two different types for one operation, which
    // nothing had lowered so nothing had caught.
    int32:psucc = raw type_elem(e.types, rt);
    pass (raw tt_result(e.types, psucc, raw type_size(e.types, psucc),
                        raw type_align(e.types, psucc)));
};

// `x => dyn Trait` — THE TARGET HAS TO IMPLEMENT IT, AND IT HAS TO BE OBJECT-SAFE.
//
// Both questions were answered in 0.4.6 and neither was asked here: the node had no
// case, so a `dyn` cast of a type implementing nothing produced the invalid type and
// no diagnostic. The node carries the trait window directly (AST_REFERENCE 3.6),
// which is why this does not go back through the type.
func:type_dyn_cast = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:src = raw type_of_expr(e, raw expr_operand(n));
    TypeResolver:r = raw etyper_resolver(e);

    int32:start = raw expr_list_start(n);
    int32:cnt = raw expr_list_count(n);
    int32:mark = raw ast_scratch_mark(e.ast);
    int32:i = 0i32;
    while (i < cnt) {
        TypeId:trait_ty = TypeId{ index: raw ast_id_at(e.ast, start, i) };
        // A `dyn` CAST'S OPERANDS ARE TRAITS (D-172's door): resolved where a
        // trait is wanted, so a bare trait name is not the "not a value type"
        // refusal D-171 gives it everywhere else.
        int32:tr = raw resolve_trait_type(@r, trait_ty, e.scope);
        drop ast_scratch_push(e.ast, tr);

        if (!(raw type_is_invalid(e.types, tr))) {
            drop check_object_safe(@r, tr, n.span);
            if (!(raw type_is_invalid(e.types, src))) {
                if (src != 0i32) {
                    if (!(raw type_implements(e.impls, e.bounds, e.ast, e.types,
                                              src, tr, raw IMPL_FUEL()))) {
                        string:d1 = raw string_concat("`",
                                        raw type_display(e.types, e.interns, src));
                        string:d2 = raw string_concat(d1, "` does not implement `");
                        string:d3 = raw string_concat(d2,
                                        raw type_display(e.types, e.interns, tr));
                        discard(raw te_error(e, raw TYPE_BOUND_UNMET(),
                            raw string_concat(d3, "`, so it cannot become a `dyn` of it"),
                            n.span));
                    }
                }
            }
        }
        i = i + 1i32;
    }
    // CANONICAL ORDER BEFORE INTERNING (D-159), so `dyn A & B` and
    // `dyn B & A` are one interned type with one layout.
    drop dyn_sort_bounds(e.ast, e.types, e.interns, mark);
    IdSpan:w = raw ast_scratch_commit(e.ast, mark);
    pass (raw tt_dyn(e.types, e.ast, e.interns, w.start, w.count));
};

// `Point{ x: 1i32, y: 2i32 }` — THE LITERAL NOTHING CHECKED (D-129, 0.6.7).
//
// `ExprStructLiteralExpr` had no case here, so it fell through to type `0` — the
// INVALID type, which exists to suppress cascades and is therefore silent. Every
// one of these compiled clean:
//
//     P:p = P{ x: 1i32, zzz: 3i32 };   // `zzz` is not a field of P
//     P:q = P{ x: 1i32 };              // `y` never gets a value
//     P:r = P{ x: 1i32, y: true };     // y is an int32
//
// THE SECOND IS THE ONE THAT MATTERS. There is no field-default syntax, so an
// omitted field has no value — and an unassigned binding is exactly what D-010's
// definite assignment refuses everywhere else. It is a safety property, not a
// convenience.
func:struct_literal_type = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:name = (n.payload) =>! int32;

    // D-162: THE LITERAL'S TYPE IS THE DECLARATION ITS NAME RESOLVES TO IN
    // SCOPE. Resolve that first — the literal stores only a name (D-129), and
    // the declaration the name binds to in the scope where the literal is
    // WRITTEN is what it means. The comparison was on the bare name until 1.0.1,
    // which let an `a.Local` in an `a.Local` position capture a `b.Local{…}`
    // literal from another module: meaning changing with context (the blueprint
    // rule's first facet), and silencing D-129's omitted-field check against the
    // declaration the author actually wrote.
    int32:sym = raw scope_lookup(e.tab, e.scope, name);
    if (sym == 0i32) {
        string:t = raw intern_get(e.interns, name);
        string:m1 = raw string_concat("there is no type named `", t);
        pass (raw te_error(e, raw TYPE_UNKNOWN(),
                             raw string_concat(m1, "`"), n.span));
    }
    Symbol:sy = raw symtab_get(e.tab, sym);

    // THE EXPECTED TYPE CONTRIBUTES ONLY GENERIC ARGUMENTS, and only when it is
    // an instance of THIS declaration: `Container<int32>{ … }` has no way to
    // carry its arguments except through the context, so context still wins
    // there — but by the DECLARATION (slot `a`, which a generic instance holds),
    // never the name. An expected type naming a different declaration of the same
    // name falls through and the literal is built as what the author wrote; the
    // mismatch is refused where the value is used (D-090).
    int32:want = raw expected_value(e);
    if (want != 0i32) {
        if ((raw type_kind(e.types, want)) == (raw TY_STRUCT())) {
            if ((raw type_decl_of(e.types, want)) == sy.origin) { pass want; }
        }
    }
    DeclNode:dnode = raw ast_decl(e.ast, DeclId{ index: sy.origin });
    if (dnode.kind != DeclKind.DeclStructDecl) {
        string:t2 = raw intern_get(e.interns, name);
        string:k1 = raw string_concat("`", t2);
        string:k2 = raw string_concat(k1, "` is ");
        string:k3 = raw string_concat(k2, raw decl_kind_article(dnode));
        pass (raw te_error(e, raw TYPE_NOT_A_TYPE(),
                             raw string_concat(k3, ", and a `{ … }` literal builds a struct"),
                             n.span));
    }

    // A GENERIC STRUCT WITH NO CONTEXT HAS NOTHING TO SUBSTITUTE. Refused rather
    // than resolved to the bare declaration, which is what made `Container<int32>`
    // and `Container<string>` one type before 0.4.5.
    IdSpan:gp = raw decl_generic_window(e.ast, dnode);
    if (gp.count != 0i32) {
        string:g1 = raw string_concat("`", raw intern_get(e.interns, name));
        pass (raw te_error(e, raw TYPE_CANNOT_INFER(),
            raw string_concat(g1, "` is generic, and a struct literal carries no type arguments; the type has to come from what the literal is assigned to or passed as"),
            n.span));
    }
    pass (raw tt_struct(e.types, sy.origin, name, 0i64, 1i32));
};

func:type_struct_literal = int32(ExprTyper->:e, ExprNode:n) never fails {
    int32:st = raw struct_literal_type(e, n);
    if (raw type_is_invalid(e.types, st)) { pass 0i32; }

    TypeResolver:r = raw etyper_resolver(e);
    int32:start = raw expr_list_start(n);
    int32:cnt = raw expr_list_count(n);

    // THE WINDOW ALTERNATES NAME, VALUE — one window, so the two cannot get out of
    // step the way a second parallel one could.
    int32:i = 0i32;
    while ((i + 1i32) < cnt) {
        int32:fname = raw ast_id_at(e.ast, start, i);
        ExprId:val = ExprId{ index: raw ast_id_at(e.ast, start, i + 1i32) };

        // THE SAME FIELD TWICE IS NOT AN OVERWRITE. Taking the last one silently
        // discards the first, which is the lost-value defect `Result{…}` already
        // has a code for.
        int32:j = 0i32;
        bool:again = false;
        while (j < i) {
            if ((raw ast_id_at(e.ast, start, j)) == fname) { again = true; }
            j = j + 2i32;
        }
        if (again) {
            string:d1 = raw string_concat("`", raw intern_get(e.interns, fname));
            discard(raw te_error(e, raw TYPE_FIELD_TWICE(),
                raw string_concat(d1, "` is given twice in this literal, and taking the last would discard the first"),
                n.span));
        }

        FieldInfo:f = raw struct_field(@r, st, fname, e.scope);
        if (!(f.found)) {
            string:u1 = raw string_concat("`", raw intern_get(e.interns, fname));
            string:u2 = raw string_concat(u1, "` is not a field of `");
            string:u3 = raw string_concat(u2,
                            raw type_display(e.types, e.interns, st));
            discard(raw te_error(e, raw TYPE_NO_SUCH_FIELD(),
                          raw string_concat(u3, "`"), n.span));
            // The value is still typed, so a mistake inside it is reported too
            // rather than waiting for the name to be fixed first.
            discard(raw type_of_expr(e, val));
        } else {
            int32:saved = e.expected;
            e.expected = f.type_id;
            int32:got = raw type_of_expr(e, val);
            e.expected = saved;
            if (!(raw type_is_invalid(e.types, got))) {
                if (got != 0i32) {
                    if (!(raw fits(e, f.type_id, got))) {
                        drop te_assign_mismatch(e, f.type_id, got, n.span);
                    }
                }
            }
        }
        i = i + 2i32;
    }

    drop check_literal_complete(e, n, st, start, cnt);
    pass st;
};

// EVERY FIELD IS NAMED. The half that is a safety property: there is no default, so
// a field the literal omits holds nothing, and D-010 refuses an unassigned binding
// everywhere else in the language.
func:check_literal_complete = NIL(ExprTyper->:e, ExprNode:n, int32:st,
                                  int32:start, int32:cnt) never fails {
    int32:decl = raw type_decl(e.types, st);
    if (decl == 0i32) { pass NIL; }
    DeclNode:d = raw ast_decl(e.ast, DeclId{ index: decl });

    int32:nm = raw item_member_count(e.ast, d);
    int32:k = 0i32;
    while (k < nm) {
        DeclNode:m = raw ast_decl(e.ast, raw item_member(e.ast, d, k));
        if (m.kind == DeclKind.DeclFieldDecl) {
            int32:fname = raw decl_name(m);
            bool:given = false;
            int32:i = 0i32;
            while ((i + 1i32) < cnt) {
                if ((raw ast_id_at(e.ast, start, i)) == fname) { given = true; }
                i = i + 2i32;
            }
            if (!given) {
                string:m1 = raw string_concat("`",
                                raw type_display(e.types, e.interns, st));
                string:m2 = raw string_concat(m1, "` has a field `");
                string:m3 = raw string_concat(m2,
                                raw intern_get(e.interns, fname));
                discard(raw te_error(e, raw TYPE_MISSING_FIELD(),
                    raw string_concat(m3, "` and this literal does not give it a value; there is no default, so it would hold nothing"),
                    n.span));
            }
        }
        k = k + 1i32;
    }
    pass NIL;
};

pub func:type_of_expr = int32(ExprTyper->:e, ExprId:id) never fails {
    if (raw expr_is_none(id)) {
        pass 0i32;
    }
    int32:t = raw type_of_expr_inner(e, id);
    drop exprtypes_set(e.expr_types, id, t);
    pass t;
};

func:type_of_expr_inner = int32(ExprTyper->:e, ExprId:id) never fails {
    ExprNode:n = raw ast_expr(e.ast, id);

    if (n.kind == ExprKind.ExprIntLiteral)   { pass (raw type_numeric_literal(e, n, "42i32")); }
    if (n.kind == ExprKind.ExprFloatLiteral) { pass (raw type_numeric_literal(e, n, "1.5f64")); }
    if (n.kind == ExprKind.ExprBoolLiteral)  { pass (e.types.t_bool); }
    if (n.kind == ExprKind.ExprCharLiteral)  { pass (raw tt_char(e.types, 8i32)); }
    if (n.kind == ExprKind.ExprStringLiteral)      { pass (e.types.t_string); }
    if (n.kind == ExprKind.ExprRawStringLiteral)   { pass (e.types.t_string); }
    if (n.kind == ExprKind.ExprBlockStringLiteral) { pass (e.types.t_string); }
    if (n.kind == ExprKind.ExprTemplateLiteral)    { pass (raw type_template(e, n)); }

    if (n.kind == ExprKind.ExprSentinelLiteral) {
        pass (raw type_sentinel(e, n));
    }

    // `$` inside `loop`/`till` — a counter with a type and no declaration.
    if (n.kind == ExprKind.ExprIterationVarExpr) {
        if (e.counted_depth == 0i32) {
            pass (raw te_error(e, raw TYPE_UNKNOWN(),
                "`$` is the innermost counted loop's counter, and no `loop` or `till` encloses this",
                n.span));
        }
        pass (raw tt_int(e.types, 64i32, true));
    }

    // --- the two kinds 0.6.4 owes a rule ------------------------------------------
    //
    // BOTH USED TO TYPE AS INVALID, which is the encoding that suppresses cascades
    // and is therefore silent (D-126, D-129). `#totally_not_a_macro(3i32)` compiled
    // clean, and so did `comptime(anything)`.
    if (n.kind == ExprKind.ExprStructLiteralExpr) { pass (raw type_struct_literal(e, n)); }
    if (n.kind == ExprKind.ExprArrayLiteralExpr)  { pass (raw type_array_literal(e, n)); }
    if (n.kind == ExprKind.ExprPipeExpr)          { pass (raw type_pipe(e, n)); }
    if (n.kind == ExprKind.ExprDynCastExpr)       { pass (raw type_dyn_cast(e, n)); }
    if (n.kind == ExprKind.ExprPickExpr)          { pass (raw type_pick_expr(e, n)); }
    if (n.kind == ExprKind.ExprVectorCtorExpr)    { pass (raw type_vector_ctor(e, n)); }
    if (n.kind == ExprKind.ExprBuiltinExpr)  { pass (raw type_builtin(e, id, n)); }
    if (n.kind == ExprKind.ExprComptimeExpr) { pass (raw type_comptime(e, id, n)); }

    if (n.kind == ExprKind.ExprBinaryExpr) {
        pass (raw type_binary(e, id, n));
    }

    if (n.kind == ExprKind.ExprUnaryExpr) {
        pass (raw type_unary(e, id, n));
    }

    if (n.kind == ExprKind.ExprPostfixExpr) {
        pass (raw type_postfix(e, n));
    }

    // --- the `Result` family (OP_REFERENCE §0 level 2, D-081) ------------------
    //
    // Each of these takes a `Result<T>` and differs in what it does with the
    // error. They are separate nodes rather than one with a mode because 0.7 has
    // to lower them differently — `relay` is a normal exit path and runs `defer`,
    // `?!` traps and runs nothing (D-014, amended) — and a shared node would make
    // that distinction something the backend had to reconstruct.
    if (n.kind == ExprKind.ExprRawUnwrapExpr) {
        // THE LICENCE (D-163 rule 3, flipped at 1.1.2): `raw` is the CHECKED,
        // zero-cost unwrap of a call that cannot fail — not a bypass.
        ExprId:ropid = raw expr_operand(n);
        ExprNode:ropn = raw ast_expr(e.ast, ropid);
        // typed FIRST: the licence reads what typing records (the callee decl,
        // the callee's function type), so the order is load-bearing
        int32:rres = raw type_unwrap(e, n, "raw");
        int32:rlic = raw unwrap_licence_of(e, ropn, ropid);
        if (rlic == 2i32) {
            discard(raw te_error(e, raw TYPE_RAW_UNLICENSED(),
                "`raw` takes a CALL whose callee is `never fails` (D-163); for a checked binding read `.value` after an `is_err` branch (D-007), and for a may-fail call write `relay`, `?|`, or `?!`",
                n.span));
        }
        if (rlic == 1i32) {
            discard(raw te_error(e, raw TYPE_RAW_UNLICENSED(),
                "`raw` is licensed only by a `never fails` callee (D-163): declare the callee `never fails` if it cannot fail, or handle the error — `relay` it, `?|` a default, or `?!` a trap code",
                n.span));
        }
        pass rres;
    }
    if (n.kind == ExprKind.ExprRelayExpr) {
        if (e.in_defer) {
            discard(raw te_error(e, raw TYPE_DEFER_EXIT(),
                "a `defer` body may not `relay` (D-163): a cleanup must not propagate an error out while the scope unwinds; handle it inside the `defer`",
                n.span));
        }
        // `relay` IN `main` OR `failsafe` IS REFUSED. There is no `Result` to
        // relay into: the program ends there, so an error propagating out of it
        // has nowhere to go — the uncontrolled stop the discipline prevents.
        if (e.fn_terminal) {
            discard(raw te_error(e, raw TYPE_RESULT_RETURN(),
                "`relay` returns the error from the enclosing function, and `main` and `failsafe` return no `Result` to relay into; handle it here with `?`, `?!` or a `pick`",
                n.span));
        }
        if (e.fn_never_fails) {
            discard(raw te_error(e, raw TYPE_NEVER_FAILS_CAN_FAIL(),
                "a `never fails` function may not `relay` (D-163): it propagates an error the contract says cannot occur; handle it with `?`, `?!` or a `pick`",
                n.span));
        }
        pass (raw type_unwrap(e, n, "relay"));
    }
    // `drop` DISCARDS THE OUTCOME and yields nothing. That it yields `NIL` rather
    // than `T` is the point: `drop f()` in a value position is then a type error
    // instead of silently being the value with its error thrown away.
    if (n.kind == ExprKind.ExprDropExpr) {
        // THE LICENCE (D-163 rule 4): `drop` is the `void` call — a
        // `never fails` callee whose success type is `NIL`. The spawn form is
        // exempt (an un-awaited `async` call is D-058's spawn; its error
        // reaches the D-062 join). A VALUE is not dropped but DISCARDED:
        // `discard(raw f())` spells both claims.
        ExprId:dopid = raw expr_operand(n);
        ExprNode:dopn = raw ast_expr(e.ast, dopid);
        // The spawn's operand is the other blessed home for an `async` callee
        // (D-058) — bare calls are refused by `type_call`.
        int32:sp_saved = e.await_operand;
        e.await_operand = dopid.index;
        discard(raw type_unwrap(e, n, "drop"));
        e.await_operand = sp_saved;
        if (raw unwrap_callee_is_async(e, dopn, dopid)) {
            // THE SPAWN FORM (D-058/D-177). Legal only inside an `async`
            // function: the D-062 join lives in the enclosing frame, and a
            // synchronous scope has none for a child to be joined by.
            if (!e.fn_is_async) {
                discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                    "`drop` of an `async` call is the SPAWN form (D-058), legal only inside an `async` function: the spawned task's error is joined by the enclosing frame's scope exit (D-062), and a synchronous scope has no frame",
                    n.span));
            }
            if (e.in_defer) {
                discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                    "a task cannot be spawned inside `defer` (D-177): the join that would collect its error sits at the scope exit the defer is already part of",
                    n.span));
            }
            // THE SPAWN'S CALLEE DECLARES `NIL` (D-177 stage E): `drop` is the
            // void call, sync or async — one meaning, no context. A spawned
            // value would have nowhere to go (only errors reach the join), and
            // the uniform `{ i32 }` result slot is what lets one join walk a
            // heterogeneous child list. Checked only when the position was
            // legal, so a site reports its one real problem.
            if (e.fn_is_async) { if (!e.in_defer) {
                int32:sp_t = raw exprtypes_get(e.expr_types, dopid);
                bool:sp_nil = false;
                if (sp_t != 0i32) {
                    if ((raw type_kind(e.types, sp_t)) == (raw TY_RESULT())) {
                        if ((raw type_elem(e.types, sp_t)) == e.types.t_nil) {
                            sp_nil = true;
                        }
                    }
                }
                if (!sp_nil) {
                    discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                        "a spawned task's value has nowhere to go — only its error reaches the join (D-177): declare the function's success type `NIL`, or `await` the call for its value",
                        n.span));
                }
            } }
        }
        if (!(raw unwrap_callee_is_async(e, dopn, dopid))) {
            int32:dlic = raw unwrap_licence_of(e, dopn, dopid);
            if (dlic == 2i32) {
                discard(raw te_error(e, raw TYPE_RAW_UNLICENSED(),
                    "`drop` takes a CALL — the `void` call of a `never fails`, `NIL`-returning callee (D-163)",
                    n.span));
            }
            if (dlic == 1i32) {
                discard(raw te_error(e, raw TYPE_RAW_UNLICENSED(),
                    "`drop` is licensed only by a `never fails` callee (D-163): declare the callee `never fails`, or handle its error — `relay f();`, `f() ?! c;`, or `f() ?| NIL;`",
                    n.span));
            }
            if (dlic == 0i32) {
                // the NIL rule; a builtin operand types as unknown, so the
                // NIL-returning builtins are the four named void ones
                int32:dt = raw exprtypes_get(e.expr_types, dopid);
                bool:d_ok_nil = false;
                if (dt != 0i32) {
                    if ((raw type_kind(e.types, dt)) == (raw TY_RESULT())) {
                        if ((raw type_elem(e.types, dt)) == e.types.t_nil) { d_ok_nil = true; }
                    }
                }
                if (dt == 0i32) {
                    if (dopn.kind == ExprKind.ExprCallExpr) {
                        ExprNode:dcal = raw ast_expr(e.ast, raw expr_callee(dopn));
                        if (dcal.kind == ExprKind.ExprIdentifierExpr) {
                            if (dcal.a == 0i32) {
                                string:dbn = raw intern_get(e.interns, dcal.payload =>! int32);
                                if (raw string_eq(dbn, "dalloc"))           { d_ok_nil = true; }
                                if (raw string_eq(dbn, "wild_release_all")) { d_ok_nil = true; }
                                if (raw string_eq(dbn, "wildx_seal"))       { d_ok_nil = true; }
                                if (raw string_eq(dbn, "wildx_free"))       { d_ok_nil = true; }
                            }
                        }
                    }
                }
                if (!d_ok_nil) {
                    discard(raw te_error(e, raw TYPE_RAW_UNLICENSED(),
                        "`drop` discards a VALUE here (D-163 rule 4): a value deliberately unused is `discard(raw f());` — two words, two claims, both checked",
                        n.span));
                }
            }
        }
        pass (e.types.t_nil);
    }
    if (n.kind == ExprKind.ExprAwaitExpr) {
        // D-177: `await` only inside an `async` function, and only on a call
        // whose callee is itself `async` — a sync call has nothing to suspend
        // on, and an `await` outside a coroutine has no frame to suspend.
        if (!e.fn_is_async) {
            discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                "`await` is legal only inside an `async` function (D-177): a synchronous function has no frame to suspend",
                n.span));
        }
        // Inside `defer` it is refused outright: a defer body is cleanup, and
        // cleanup is synchronous — the JOIN, not a defer, is where a scope
        // waits on concurrent work (D-062). D-163 already bars `fail` and
        // `relay` there; suspension joins that family.
        if (e.in_defer) {
            discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                "`await` cannot appear inside `defer` (D-177): a defer body is synchronous cleanup, and a suspension inside it would hold the scope's exit open",
                n.span));
        }
        ExprId:awop = raw expr_operand(n);
        ExprNode:awn = raw ast_expr(e.ast, awop);
        if (!(raw unwrap_callee_is_async(e, awn, awop))) {
            discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                "`await` takes a call to an `async` function (D-177): a synchronous call completes without suspending and is not awaited",
                n.span));
        }
        // `await` yields what the call yields — the suspension is WHEN, not
        // WHAT. The unwrap keywords sit outside (`relay await f(x)`), exactly
        // as they sit outside a synchronous call. (`raw await` is refused by
        // D-163's licence: an `async` callee can never be `never fails`.)
        int32:aw_saved = e.await_operand;
        e.await_operand = awop.index;
        int32:aw_ty = raw type_of_expr(e, awop);
        e.await_operand = aw_saved;
        pass aw_ty;
    }

    // `e ?| d` — a fallback. `e ?! c` — trap with a code. Both yield `T`.
    if (n.kind == ExprKind.ExprSafeUnwrapExpr) {
        pass (raw type_safe_unwrap(e, n));
    }
    if (n.kind == ExprKind.ExprEmphaticUnwrapExpr) {
        pass (raw type_emphatic_unwrap(e, n));
    }
    // `??` IS THE OPTIONAL ONE, not the Result one (OP_REFERENCE §14). Two
    // operators one character apart doing different things is worth being exact
    // about: `?` unwraps a `Result`, `??` unwraps an `Optional`.
    if (n.kind == ExprKind.ExprNullCoalesceExpr) {
        pass (raw type_null_coalesce(e, n));
    }

    // --- casts (D-021) --------------------------------------------------------------
    // Slot `b` is a TypeId, not an expression, which is why `expr_shape` files
    // both of these as one-operand nodes.
    if (n.kind == ExprKind.ExprCastExpr) {
        pass (raw type_cast_expr(e, n, false));
    }
    if (n.kind == ExprKind.ExprUncheckedCastExpr) {
        pass (raw type_cast_expr(e, n, true));
    }

    // --- the pointer family (OP_REFERENCE §0 level 5) -----------------------------
    if (n.kind == ExprKind.ExprAddressOfExpr) {
        drop require_place_operand(e, raw expr_operand(n), "@");
        int32:t = raw type_of_expr(e, raw expr_operand(n));
        if (t == 0i32) { pass 0i32; }
        pass (raw tt_pointer(e.types, t));
    }
    if (n.kind == ExprKind.ExprDerefExpr) {
        pass (raw type_deref(e, n));
    }
    // `$$i` / `$$m` — a SECOND-CLASS borrow (D-004). It is a pointer at the type
    // level and the borrow checker (0.5) is what makes it second-class; the
    // distinction is about where the value may travel, not about what it is.
    if (n.kind == ExprKind.ExprBorrowExpr) {
        drop require_place_operand(e, raw expr_operand(n), "a borrow");
        int32:t = raw type_of_expr(e, raw expr_operand(n));
        if (t == 0i32) { pass 0i32; }
        pass (raw tt_pointer(e.types, t));
    }

    if (n.kind == ExprKind.ExprRangeExpr) {
        pass (raw type_range_expr(e, n));
    }
    if (n.kind == ExprKind.ExprTernaryExpr) {
        pass (raw type_ternary(e, n));
    }
    if (n.kind == ExprKind.ExprDefaultsExpr) {
        pass (raw type_defaults(e, n));
    }

    // `move(place)` (D-065) transfers ownership and yields the same type; what it
    // does to the SOURCE is the borrow checker's business in 0.5.
    if (n.kind == ExprKind.ExprMoveExpr) {
        drop require_place_operand(e, raw expr_operand(n), "move");
        pass (raw type_of_expr(e, raw expr_operand(n)));
    }

    // `..^coll` (D-026) expands a collection AT A CALL SITE and nowhere else.
    // Its type here is the collection's; 0.4.5 is where the position is checked,
    // because that is where an argument list exists to check it against.
    if (n.kind == ExprKind.ExprSpreadExpr) {
        pass (raw type_of_expr(e, raw expr_operand(n)));
    }

    // `is_err(x)` tests a `tbb` without trapping, and `Result{…}` is the only way
    // to construct a `Result` (D-097). An `Optional` has no counterpart to the
    // second of these: `NIL` is its empty value and a bare `T` is its full one
    // (D-099), so there is nothing here for it.
    if (n.kind == ExprKind.ExprIsErrExpr)        { pass (raw type_is_err(e, n)); }
    if (n.kind == ExprKind.ExprResultLiteralExpr) { pass (raw type_result_literal(e, n)); }


    if (n.kind == ExprKind.ExprIdentifierExpr) {
        pass (raw type_ident(e, n));
    }

    // Member access, indexing and calls live in `type_access.npk` — they are one
    // subject ("reaching into a value") and they all need the layout rules. The
    // hook keeps this module from depending on that one, since the traffic runs
    // the other way.
    pass (raw type_access(e, id, n));

};

func:type_binary = int32(ExprTyper->:e, ExprId:id, ExprNode:n) never fails {
    TokenKind:op = raw expr_op(n);

    // An unsuffixed literal on one side takes the OTHER side's type (D-092), so
    // `x + 1` where `x` is `int64` is `int64` rather than an error about a
    // literal with no context.
    //
    // THE ORDER IS DECIDED UP FRONT rather than by typing one side and retrying.
    // A retry would have already emitted the "no context" diagnostic by the time
    // it succeeded, so `1 + x` reported an error and then produced the right
    // type -- the worst of both. One look at the node kind avoids it.
    int32:saved = e.expected;
    int32:lt = 0i32;
    int32:rt = 0i32;

    if (raw takes_type_from_context(e, raw expr_lhs(n))) {
        rt = raw type_of_expr(e, raw expr_rhs(n));
        if (rt != 0i32) { e.expected = rt; }
        lt = raw type_of_expr(e, raw expr_lhs(n));
        e.expected = saved;
    } else {
        lt = raw type_of_expr(e, raw expr_lhs(n));
        if (lt != 0i32) { e.expected = lt; }
        rt = raw type_of_expr(e, raw expr_rhs(n));
        e.expected = saved;
    }

    // `+` ON TWO STRINGS IS CONCATENATION (TYPE_REFERENCE §4) — real Nitpick
    // that until 0.7.7 nothing typed: `tests/rejection/nonscalar_operators.npk`
    // promised the BACKEND refuses it at this rung, and the checker refused it
    // first, so the file could never reach the stage its expectation names. The
    // hole was invisible while that suite could only run against the seed.
    if (op == TokenKind.OpPlus) {
        if ((raw type_kind(e.types, lt)) == (raw TY_STRING())) {
            if ((raw type_kind(e.types, rt)) == (raw TY_STRING())) {
                pass (e.types.t_string);
            }
        }
        pass (raw type_arithmetic(e, n.span, lt, rt));
    }
    if (op == TokenKind.OpMinus)   { pass (raw type_arithmetic(e, n.span, lt, rt)); }
    if (op == TokenKind.OpStar)    { pass (raw type_arithmetic(e, n.span, lt, rt)); }
    if (op == TokenKind.OpSlash)   { pass (raw type_arithmetic(e, n.span, lt, rt)); }
    if (op == TokenKind.OpPercent) { pass (raw type_arithmetic(e, n.span, lt, rt)); }

    if (op == TokenKind.OpEqEq)  { pass (raw type_comparison(e, n, lt, rt, false)); }
    if (op == TokenKind.OpNotEq) { pass (raw type_comparison(e, n, lt, rt, false)); }
    if (op == TokenKind.OpLt)    { pass (raw type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpLtEq)  { pass (raw type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpGt)    { pass (raw type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpGtEq)  { pass (raw type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpSpaceship) {
        discard(raw type_comparison(e, n, lt, rt, true));
        pass (raw tt_int(e.types, 32i32, true));
    }

    if (op == TokenKind.OpAndAnd) { pass (raw type_logical(e, n, lt, rt)); }
    if (op == TokenKind.OpOrOr)   { pass (raw type_logical(e, n, lt, rt)); }

    if (op == TokenKind.OpAmp)   { pass (raw type_bitwise(e, n.span, lt, rt)); }
    if (op == TokenKind.OpPipe)  { pass (raw type_bitwise(e, n.span, lt, rt)); }
    if (op == TokenKind.OpCaret) { pass (raw type_bitwise(e, n.span, lt, rt)); }
    if (op == TokenKind.OpShl)   { pass (raw type_bitwise(e, n.span, lt, rt)); }
    if (op == TokenKind.OpShr)   { pass (raw type_bitwise(e, n.span, lt, rt)); }

    pass 0i32;
};

func:type_unary = int32(ExprTyper->:e, ExprId:id, ExprNode:n) never fails {
    TokenKind:op = raw expr_op(n);
    int32:t = raw type_of_expr(e, raw expr_operand(n));

    if (op == TokenKind.OpBang) {
        drop require_bool(e, t, n.span);
        pass (e.types.t_bool);
    }
    if (op == TokenKind.OpMinus) {
        if (raw type_is_invalid(e.types, t)) { pass 0i32; }
        // NEGATION IS TOTAL ON A `tbb` (D-008 §2, admitted at 1.0.9): the
        // sentinel is the one value whose negation would overflow, and it is
        // not a value. `-x` is the same `tbb`, and ERR stays ERR (sticky).
        if ((raw type_kind(e.types, t)) == (raw TY_TBB())) { pass t; }
        if (!(raw type_is_numeric(e.types, t))) {
            pass (raw te_operand_error(e, n.span, t));
        }
        // Negating an UNSIGNED value is a question with no good answer, so it is
        // not asked: the result is either wrong or a different type.
        if (raw type_is_integer(e.types, t)) {
            if (!(raw type_is_signed(e.types, t))) {
                string:m1 = raw string_concat("`", raw type_display(e.types, e.interns, t));
                string:m2 = raw string_concat(m1,
                    "` is unsigned, so it has no negation");
                pass (raw te_error(e, raw TYPE_NOT_NUMERIC(), m2, n.span));
            }
        }
        pass t;
    }
    if (op == TokenKind.OpTilde) {
        if (raw type_is_invalid(e.types, t)) { pass 0i32; }
        if (!(raw type_is_integer(e.types, t))) {
            pass (raw te_bitwise_error(e, n.span, t));
        }
        pass t;
    }
    pass t;
};
