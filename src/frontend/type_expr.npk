// Expression typing.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.2.
//
// Every expression gets a type, and the operators enforce the rules that make a
// type mean more than its bits.
//
// THIS IS WHERE THE LANGUAGE WINS OVER THE MACHINE. Four families are
// representationally identical to integers and none of them is a number:
//
//   `bool`          one byte, two values. `true + 1i32` means nothing.
//   `char8`         a character is not its code point (D-005).
//   `tbb32`         an error-code type whose arithmetic drags in ERR,
//                   stickiness and saturation (D-008) — operations that belong
//                   to the type, not to `+`.
//   `fd` and family an `fd` plus one is not an `fd` (D-042).
//
// To LLVM all four are `iN`. Nothing downstream will object. This file is the
// only place that can.

use "source_location.npk".*;
use "intern.npk".*;
use "token_kind.npk".*;
use "ast_kind.npk".*;
use "ast.npk".*;
use "diagnostics.npk".*;
use "type_codes.npk".*;
use "types.npk".*;
use "num_width.npk".*;
use "parse_expr.npk".*;
use "symbols.npk".*;
use "resolve_type.npk".*;
use "type_names.npk".*;
use "type_cast.npk".*;
use "type_decl.npk".*;
use "type_access.npk".*;

pub struct:ExprTyper = {
    Ast->:ast;
    TypeTable->:types;
    SymbolTable->:tab;
    InternTable->:interns;
    DiagList->:diags;

    // The type an unsuffixed literal should take, pushed by whatever position it
    // appears in (D-092). Zero when there is none, and a literal reaching that
    // state is an error rather than a silent `int32`.
    int32:expected;

    // THE SCOPE NAMES ARE LOOKED UP IN. It lives on the typer rather than being
    // threaded through every walk function for the same reason `expected` does:
    // it is constant across an expression tree, and a construct that nests a
    // scope — 0.4.4's expression-`pick` — saves and restores it around the part
    // that differs. `type_of_expr` used to take it as a parameter and DISCARD it,
    // which was honest while nothing needed it and stopped being honest the
    // moment a cast had to resolve `x => MyStruct`.
    int32:scope;

    // THE ENCLOSING FUNCTION'S SUCCESS TYPE, and whether it is `main` or
    // `failsafe`. `relay` needs both: it returns the error from the enclosing
    // function, so it needs something to return into, and in a terminal function
    // there is nothing — which is the whole reason those two are excepted from
    // D-013 rather than an oversight.
    int32:fn_success;
    bool:fn_terminal;
};

pub func:etyper_init = ExprTyper(Ast->:ast, TypeTable->:types, SymbolTable->:tab,
                                 InternTable->:interns, DiagList->:diags,
                                 int32:scope) {
    ExprTyper:e = ExprTyper{ ast: ast, types: types, tab: tab, interns: interns,
                             diags: diags, expected: 0i32, scope: scope,
                             fn_success: 0i32, fn_terminal: false };
    pass e;
};

func:te_error = int32(ExprTyper->:e, string:code, string:message, Span:at) {
    drop diaglist_push(e.diags, raw diag_error(code, message, at));
    pass 0i32;
};

// --- the common type of two operands (D-092, corrected) ----------------------------------
//
// THERE IS NO IMPLICIT WIDENING. Two operands share a type or they do not, and
// when they do not the programmer writes the cast.
//
// An earlier reading of this had `int32 + int64` widen to `int64` on the grounds
// that `explicit-widening` appears in the `--extra-picky` table, so the default
// must permit what the rule bans. That inference is wrong: every rule in that
// table adds pedantry BEYOND safety -- `shadow` bans shadowing, `wild` bans a
// construct that is already explicit -- and none of them gates a safety property.
// `SAFETY_ARCHITECTURE.md` says so directly a few lines below the table: a
// Nitpick guarantee is "absolute by default, suspended only through a construct
// an auditor can search for."
//
// The concrete harm is not that a same-signedness widening loses a value; it
// cannot. It is that the widening decides WHICH WIDTH THE OPERATION HAPPENS IN.
// `a + b` computing in 64 bits because `b` is an `int64` today will silently
// compute in 32 bits when someone narrows `b` tomorrow, and overflow where it
// used to fit. The expression is unchanged and its meaning is not -- which is a
// small drift in numbers arriving through a conversion nobody wrote.
//
// A LITERAL IS DIFFERENT and is handled before this is reached: an unsuffixed
// literal takes its type from context, so `x + 1` where `x` is `int64` has two
// `int64` operands by the time they get here. Nothing is converted; the literal
// simply had no width of its own to begin with.
pub func:unify = int32(ExprTyper->:e, int32:a, int32:b) {
    if (a == b) { pass a; }
    pass 0i32;
};

// --- literals ---------------------------------------------------------------------------

// A NUMERIC LITERAL'S TYPE COMES FROM ITS SUFFIX, and with no suffix from
// context (D-092). With neither it is an error rather than a silent `int32`: a
// default would be a type nobody wrote, chosen by a rule nobody read, and every
// later diagnostic about the expression would name it.
//
// ONE FUNCTION FOR EVERY NUMERIC FAMILY. There were two — one for integers, one
// for floats — and between them they recognised twenty-six of the forty-five
// suffixes the language has. `1tbb8` reported "this literal has no width suffix"
// while carrying one, and `1.5tfp256` typed as a `flt256` because the float test
// had swept `tfp` in with the floats. The kind now comes from the generated
// table, so a suffix cannot be silently unclassified.
func:type_numeric_literal = int32(ExprTyper->:e, ExprNode:n, string:example) {
    NumWidth:w = raw expr_num_width(n);
    int32:kind = raw num_width_kind(w);
    int32:bits = raw num_width_bits(w);

    if (kind == (raw TY_INT())) {
        pass (raw tt_int(e.types, bits, raw num_width_signed(w)));
    }
    if (kind == (raw TY_FLOAT())) { pass (raw tt_float(e.types, bits)); }
    if (kind == (raw TY_TBB()))   { pass (raw tt_tbb(e.types, bits)); }
    if (kind == (raw TY_CHAR()))  { pass (raw tt_char(e.types, bits)); }

    // A SUFFIX IS PRESENT AND NAMES A TYPE NO RUNG SUPPLIES YET — `frac`, `tfp`,
    // `dim256`. Saying "no suffix" would be false and would send the reader to
    // add one they already wrote (D-085: the parser never restricts, so this is
    // where the rung is named).
    if (w != NumWidth.WNone) {
        pass (relay te_error(e, raw TYPE_UNKNOWN(),
            "this literal's type is not available at this rung yet",
            n.span));
    }

    // `expected_value` rather than `e.expected`, so that `int32?:n = 10;` reads
    // its width from the `int32` inside the wrapper. A literal is a value and an
    // `Optional<U>` slot takes a `U` (D-099); asking the wrapper for a width would
    // report "no width suffix" about a slot that plainly names one.
    int32:want = raw expected_value(e);
    if (want != 0i32) {
        if ((raw type_kind(e.types, want)) == (raw kind_wanted(e, example))) {
            pass want;
        }
    }
    string:m = relay string_concat(
        "this literal has no width suffix and nothing here says what it should be; write `",
        example);
    pass (relay te_error(e, raw TYPE_UNKNOWN(),
        relay string_concat(m, "` or give the surrounding expression a type"),
        n.span));
};

// An unsuffixed literal may only take a context type of its OWN family: `42` can
// become an `int64` and never a `flt64`, because `42` and `42.0` are different
// tokens and the one that was written is the one that counts.
func:kind_wanted = int32(ExprTyper->:_~e, string:example) {
    if (raw string_eq(example, "42i32")) { pass (raw TY_INT()); }
    pass (raw TY_FLOAT());
};

// `NIL`, `NULL`, `ERR` — three sentinels, three types (TYPE_REFERENCE §27).
//
// `NULL` AND `NIL` ARE A PAIR, and it is the same pair the language has always
// named: **`NULL` is no pointer, `NIL` is no value.** Both are contextual for the
// same reason an unsuffixed literal is — a null `int32->` and a null `Frame->`
// are not the same value to anything downstream, and neither are an empty
// `int32?` and an empty `Point?`.
//
// `NIL` HAS TWO CONTEXTS AND ONE MEANING (D-099). Where an `Optional<T>` is
// expected it is the empty one; anywhere else it is the zero-sized unit value
// (D-084) that a function returning nothing useful passes. Those are not two
// meanings wearing one spelling — "no value" is what it says in both, which is
// what lets it survive the blueprint rule. Only `NIL` did not read its context
// before this: it typed as the unit value everywhere, so `int32?:a = NIL;` — the
// spelling the prototype's own `test_nil_optional.npk` is built out of — reported
// a mismatch against the very type it constructs.
func:type_sentinel = int32(ExprTyper->:e, ExprNode:n) {
    int64:which = n.payload;
    if (which == 2i64) { pass (e.types.t_tbb32); }

    if (which == 0i64) {
        if (e.expected != 0i32) {
            if ((raw type_kind(e.types, e.expected)) == (raw TY_OPTIONAL())) {
                pass (e.expected);
            }
        }
        // NOT AN ERROR WITH NO CONTEXT, and here the two sentinels part company.
        // `NULL` has no type of its own to fall back to, but `NIL` does — it is
        // the unit value, and `pass NIL;` is the most common statement in the
        // language.
        pass (e.types.t_nil);
    }

    int32:want = raw expected_value(e);
    if (want != 0i32) {
        if ((raw type_kind(e.types, want)) == (raw TY_POINTER())) {
            pass want;
        }
    }
    pass (relay te_error(e, raw TYPE_UNKNOWN(),
        "`NULL` is valid only where a pointer type is expected, and nothing here says which pointer",
        n.span));
};

// --- the operators ----------------------------------------------------------------------

// Arithmetic: `+ - * / %`. NUMBERS ONLY, and `type_is_numeric` is deliberately
// narrow (0.4.0).
func:type_arithmetic = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt) {
    // A type that already failed produces no second complaint.
    if (raw type_is_invalid(e.types, lt)) { pass 0i32; }
    if (raw type_is_invalid(e.types, rt)) { pass 0i32; }

    if (!(raw type_is_numeric(e.types, lt))) {
        pass (relay te_operand_error(e, n, lt));
    }
    if (!(raw type_is_numeric(e.types, rt))) {
        pass (relay te_operand_error(e, n, rt));
    }

    int32:common = raw unify(e, lt, rt);
    if (common == 0i32) {
        pass (relay te_mismatch(e, n, lt, rt));
    }
    pass common;
};

// The message names the TYPE that made it wrong, and says why that type is not a
// number — because "invalid operand" leaves the reader to work out which of two
// familiar-looking things the compiler objected to.
func:te_operand_error = int32(ExprTyper->:e, ExprNode:n, int32:t) {
    string:d = relay type_display(e.types, e.interns, t);
    string:m1 = relay string_concat("`", d);
    string:m2 = relay string_concat(m1, "` is not a number, so it has no arithmetic: ");
    string:m3 = relay string_concat(m2, relay why_not_numeric(e, t));
    pass (relay te_error(e, raw TYPE_NOT_NUMERIC(), m3, n.span));
};

// Each of these is representationally an integer, so the reason has to be stated
// or the diagnostic looks arbitrary.
pub func:why_not_numeric = string(ExprTyper->:e, int32:t) {
    int32:k = raw type_kind(e.types, t);
    if (k == (raw TY_BOOL())) {
        pass "a `bool` is two values, not a small integer";
    }
    if (k == (raw TY_CHAR())) {
        pass "a character is not its code point (D-005); cast if you mean the number";
    }
    if (k == (raw TY_TBB())) {
        pass "a `tbb` is an error-code type, and its arithmetic carries ERR, stickiness and saturation (D-008) rather than being `+`";
    }
    if (k == (raw TY_KERNEL())) {
        pass "a kernel identifier compares but does not compute (D-042): an `fd` plus one is not an `fd`";
    }
    if (k == (raw TY_POINTER())) {
        pass "pointer arithmetic goes through `#ptr_add<T>(p, n)`";
    }
    pass "it is not a numeric type";
};

func:te_mismatch = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt) {
    string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, lt));
    string:m2 = relay string_concat(m1, "` and `");
    string:m3 = relay string_concat(m2, relay type_display(e.types, e.interns, rt));
    string:m4 = relay string_concat(m3, "` are different types; write the cast you mean");
    // Two integers differing only in width is the case that looks like it ought
    // to work, so it gets the reason rather than just the refusal.
    if (raw type_is_integer(e.types, lt)) {
        if (raw type_is_integer(e.types, rt)) {
            if ((raw type_is_signed(e.types, lt)) == (raw type_is_signed(e.types, rt))) {
                m4 = relay string_concat(m4,
                    "; a widening would decide which width this operation happens in, and that decision must be visible in the source rather than following from the operands");
            } else {
                m4 = relay string_concat(m4,
                    "; signed and unsigned are not two sizes of one thing, and converting between them maps every negative value onto a large positive one");
            }
        }
    }
    pass (relay te_error(e, raw TYPE_MISMATCH(), m4, n.span));
};

// Comparison: `== != < <= > >= <=>`. Wider than arithmetic — the types that
// COMPARE but do not compute are exactly `tbb` and the kernel identifiers, and
// comparison is what they are for.
func:type_comparison = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt,
                             bool:ordered) {
    if (raw type_is_invalid(e.types, lt)) { pass (e.types.t_bool); }
    if (raw type_is_invalid(e.types, rt)) { pass (e.types.t_bool); }

    int32:common = raw unify(e, lt, rt);
    if (common == 0i32) {
        drop te_mismatch(e, n, lt, rt);
        pass (e.types.t_bool);
    }

    // EQUALITY IS WIDER THAN ORDERING (D-093). `==` on a `bool` or an `fd` is
    // ordinary; `<` on either is a question nobody means to ask.
    if (ordered) {
        if (!(raw type_is_ordered(e.types, common))) {
            string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, common));
            string:m2 = relay string_concat(m1, "` has no ordering: ");
            m2 = relay string_concat(m2, relay why_not_ordered(e, common));
            drop te_error(e, raw TYPE_NOT_NUMERIC(), m2, n.span);
        }
    }
    pass (e.types.t_bool);
};

pub func:why_not_ordered = string(ExprTyper->:e, int32:t) {
    int32:k = raw type_kind(e.types, t);
    if (k == (raw TY_BOOL())) {
        pass "`false < true` is an accident of representation, not a fact about booleans";
    }
    if (k == (raw TY_TBB())) {
        pass "error codes are compared against named constants, not sorted";
    }
    if (k == (raw TY_KERNEL())) {
        pass "a kernel identifier is an opaque handle, and the order the kernel handed them out means nothing (D-042); cast if the number is what is meant";
    }
    pass "only integers, floats and characters have one";
};

// `&& || !` take `bool` AND NOTHING ELSE. There is no truthiness: an integer is
// not a condition, a pointer is not a condition, and `if (n)` is not a shorthand
// for `if (n != 0i32)`.
func:type_logical = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt) {
    drop require_bool(e, lt, n.span);
    drop require_bool(e, rt, n.span);
    pass (e.types.t_bool);
};

pub func:require_bool = NIL(ExprTyper->:e, int32:t, Span:at) {
    if (raw type_is_invalid(e.types, t)) { pass NIL; }
    if (t == e.types.t_bool) { pass NIL; }
    string:m1 = relay string_concat("this must be a `bool`, and is `",
                                    relay type_display(e.types, e.interns, t));
    string:m2 = relay string_concat(m1,
        "`; there is no truthiness in Nitpick, so write the comparison you mean");
    drop te_error(e, raw TYPE_MISMATCH(), m2, at);
    pass NIL;
};

// Bitwise `& | ^ << >>`: INTEGERS ONLY. Not `bool` — `&&` is the logical
// operator and a bitwise `&` on two booleans is someone reaching for it.
func:type_bitwise = int32(ExprTyper->:e, ExprNode:n, int32:lt, int32:rt) {
    if (raw type_is_invalid(e.types, lt)) { pass 0i32; }
    if (raw type_is_invalid(e.types, rt)) { pass 0i32; }

    if (!(raw type_is_integer(e.types, lt))) {
        pass (relay te_bitwise_error(e, n, lt));
    }
    if (!(raw type_is_integer(e.types, rt))) {
        pass (relay te_bitwise_error(e, n, rt));
    }
    int32:common = raw unify(e, lt, rt);
    if (common == 0i32) {
        pass (relay te_mismatch(e, n, lt, rt));
    }
    pass common;
};

func:te_bitwise_error = int32(ExprTyper->:e, ExprNode:n, int32:t) {
    string:d = relay type_display(e.types, e.interns, t);
    string:m1 = relay string_concat("`", d);
    string:m2 = relay string_concat(m1, "` has no bitwise operations");
    if (t == e.types.t_bool) {
        m2 = relay string_concat(m2, "; `&&` and `||` are the logical operators");
    }
    pass (relay te_error(e, raw TYPE_NOT_NUMERIC(), m2, n.span));
};

// `++` / `--`. Numbers only — the same rule as `+`, because that is what they
// are, and a `char8++` that walked to the next code point would make a character
// an integer in exactly one place in the grammar.
func:type_postfix = int32(ExprTyper->:e, ExprNode:n) {
    int32:t = relay type_of_expr(e, raw expr_operand(n));
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if (t == 0i32) { pass 0i32; }
    if (!(raw type_is_numeric(e.types, t))) {
        pass (relay te_operand_error(e, n, t));
    }
    pass t;
};

// `<-p` — full dereference. The arrow points back because it brings the value
// back (the blueprint reading), and the type is what it points at.
func:type_deref = int32(ExprTyper->:e, ExprNode:n) {
    int32:t = relay type_of_expr(e, raw expr_operand(n));
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if (t == 0i32) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_POINTER())) {
        string:m1 = relay string_concat("`<-` needs a pointer, and this is `",
                                        relay type_display(e.types, e.interns, t));
        pass (relay te_error(e, raw TYPE_MISMATCH(),
                             relay string_concat(m1, "`"), n.span));
    }
    int32:pointee = raw type_elem(e.types, t);
    // DEREFERENCING AN `any->` IS REFUSED HERE, not left to the backend. The
    // pointee is type-erased, so there is no type to produce and no size to load;
    // `p => T` first is the only correct route (TYPE_REFERENCE §27).
    if ((raw type_kind(e.types, pointee)) == (raw TY_ANY())) {
        pass (relay te_error(e, raw TYPE_MISMATCH(),
            "`any->` is type-erased and cannot be dereferenced; cast it to a concrete pointer first",
            n.span));
    }
    pass pointee;
};

// `lo..hi` / `lo...hi` (D-093). The endpoints must have a common type AND that
// type must have an ordering, because a range whose ends cannot be ordered
// describes no set of values.
func:type_range_expr = int32(ExprTyper->:e, ExprNode:n) {
    int32:saved = e.expected;
    int32:lo = 0i32;
    int32:hi = 0i32;
    if (raw takes_type_from_context(e, raw expr_lhs(n))) {
        hi = relay type_of_expr(e, raw expr_rhs(n));
        if (hi != 0i32) { e.expected = hi; }
        lo = relay type_of_expr(e, raw expr_lhs(n));
        e.expected = saved;
    } else {
        lo = relay type_of_expr(e, raw expr_lhs(n));
        if (lo != 0i32) { e.expected = lo; }
        hi = relay type_of_expr(e, raw expr_rhs(n));
        e.expected = saved;
    }
    if (raw type_is_invalid(e.types, lo)) { pass 0i32; }
    if (raw type_is_invalid(e.types, hi)) { pass 0i32; }

    int32:common = raw unify(e, lo, hi);
    if (common == 0i32) {
        pass (relay te_mismatch(e, n, lo, hi));
    }
    if (!(raw type_is_ordered(e.types, common))) {
        string:m1 = relay string_concat("a range needs an ordered type, and `",
                                        relay type_display(e.types, e.interns, common));
        string:m2 = relay string_concat(m1, "` has none: ");
        pass (relay te_error(e, raw TYPE_NOT_NUMERIC(),
                             relay string_concat(m2, relay why_not_ordered(e, common)),
                             n.span));
    }
    pass (raw tt_range(e.types, common,
                       raw type_size(e.types, common),
                       raw type_align(e.types, common)));
};

// `is (c) : a : b`. The condition is a strict `bool` like every other condition,
// and the two arms must have a common type — a conditional that produced one type
// or another depending on which way it went would have no type at all.
func:type_ternary = int32(ExprTyper->:e, ExprNode:n) {
    int32:c = relay type_of_expr(e, raw expr_lhs(n));
    drop require_bool(e, c, n.span);

    int32:saved = e.expected;
    int32:a = relay type_of_expr(e, raw expr_rhs(n));
    if (a != 0i32) { e.expected = a; }
    int32:b = relay type_of_expr(e, raw expr_third(n));
    e.expected = saved;

    if (raw type_is_invalid(e.types, a)) { pass 0i32; }
    if (raw type_is_invalid(e.types, b)) { pass 0i32; }
    int32:common = raw unify(e, a, b);
    if (common == 0i32) {
        pass (relay te_mismatch(e, n, a, b));
    }
    pass common;
};

// `expr ?| fallback` / `expr defaults fallback` — a scoped fallback for an entire
// expression chain (OP_REFERENCE §0.1). Both sides must land on one type, since
// the point is that the reader cannot tell which one they got.
func:type_defaults = int32(ExprTyper->:e, ExprNode:n) {
    int32:saved = e.expected;
    int32:a = relay type_of_expr(e, raw expr_lhs(n));
    if (a != 0i32) { e.expected = a; }
    int32:b = relay type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    if (raw type_is_invalid(e.types, a)) { pass 0i32; }
    if (raw type_is_invalid(e.types, b)) { pass 0i32; }
    int32:common = raw unify(e, a, b);
    if (common == 0i32) {
        pass (relay te_mismatch(e, n, a, b));
    }
    pass common;
};

// `expr => T` and `expr =>! T`.
//
// THE TARGET TYPE IS THE CONTEXT the operand is typed in, so `1 => int64` works:
// an unsuffixed literal in a cast takes the target's type and the cast is then a
// no-op. Without that, the one place a programmer states a type outright would
// be the one place a bare literal could not be written.
func:type_cast_expr = int32(ExprTyper->:e, ExprNode:n, bool:unchecked) {
    TypeResolver:r = raw tyres_init(e.ast, e.types, e.tab, e.interns, e.diags);
    TypeId:target_node = TypeId{ index: n.b };
    int32:to = relay resolve_type(@r, target_node, e.scope);

    int32:saved = e.expected;
    e.expected = to;
    int32:from = relay type_of_expr(e, raw expr_operand(n));
    e.expected = saved;

    if (from == 0i32) { pass to; }
    pass (relay check_cast(e.types, e.interns, e.diags, from, to, unchecked, n.span));
};

// --- unwrapping a `Result` -----------------------------------------------------------------
//
// The shared half of `raw`, `relay`, `drop` and `await`: the operand must be a
// `Result<T>`, and the answer is `T`.
//
// APPLYING ONE OF THESE TO A PLAIN VALUE IS AN ERROR rather than a no-op. A
// permissive `raw` on a non-`Result` would be the kind of harmless-looking
// tolerance that lets `raw x` survive a refactor after `x` stopped being a call
// — and then the next reader believes there is error handling there.
func:type_unwrap = int32(ExprTyper->:e, ExprNode:n, string:op) {
    int32:t = relay type_of_expr(e, raw expr_operand(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }

    if ((raw type_kind(e.types, t)) != (raw TY_RESULT())) {
        string:m1 = relay string_concat("`", op);
        string:m2 = relay string_concat(m1, "` needs a `Result`, and this is `");
        string:m3 = relay string_concat(m2, relay type_display(e.types, e.interns, t));
        pass (relay te_error(e, raw TYPE_MISMATCH(),
                             relay string_concat(m3, "`"), n.span));
    }
    pass (raw type_elem(e.types, t));
};

// `e ? d` — unwrap with a fallback. The fallback must be the SUCCESS type: a
// default of another type would make the expression's type depend on which way it
// went at runtime.
func:type_safe_unwrap = int32(ExprTyper->:e, ExprNode:n) {
    int32:t = relay type_of_expr(e, raw expr_lhs(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_RESULT())) {
        pass (relay te_not_result(e, n, t, "?"));
    }
    int32:inner = raw type_elem(e.types, t);

    int32:saved = e.expected;
    e.expected = inner;
    int32:d = relay type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    if (d == 0i32) { pass inner; }
    if (raw type_is_invalid(e.types, d)) { pass inner; }
    if (!(raw fits(e, inner, d))) {
        drop te_mismatch(e, n, inner, d);
    }
    pass inner;
};

// `e ?? d` — the OPTIONAL one, and ONLY the optional one (D-099).
//
// The prototype's checker also accepted a pointer here, unwrapping it to its
// pointee — `ptr ?? 99i32` meaning "the pointed-to value, or the default if the
// pointer is null". Its own test for that is a stub whose body is a comment
// waiting on `<-`, so the behaviour was specified and never once ran. It is not
// carried across: a `??` that dereferences hides the read behind an operator
// whose whole job elsewhere is to unwrap a wrapper, and `<-` exists precisely so
// that bringing a value back is visible in the source. It would also give one
// operator two meanings chosen by operand type, which is the thing the blueprint
// philosophy forbids first.
func:type_null_coalesce = int32(ExprTyper->:e, ExprNode:n) {
    int32:t = relay type_of_expr(e, raw expr_lhs(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_OPTIONAL())) {
        string:m1 = relay string_concat("`??` unwraps an `Optional`, and this is `",
                                        relay type_display(e.types, e.interns, t));
        string:m2 = relay string_concat(m1, "`");
        if ((raw type_kind(e.types, t)) == (raw TY_RESULT())) {
            m2 = relay string_concat(m2, "; `?` is the one that unwraps a `Result`");
        }
        // A POINTER IS THE MISTAKE WORTH NAMING, because the prototype accepted
        // it and somebody may arrive expecting it to work. Both halves of what it
        // did are still writable — they are just written down.
        if ((raw type_kind(e.types, t)) == (raw TY_POINTER())) {
            m2 = relay string_concat(m2,
                "; a pointer is not an `Optional` — `p == NULL` asks whether it points anywhere and `<-p` brings the value back");
        }
        pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    int32:inner = raw type_elem(e.types, t);

    int32:saved = e.expected;
    e.expected = inner;
    int32:d = relay type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;
    if (d == 0i32) { pass inner; }
    if (raw type_is_invalid(e.types, d)) { pass inner; }
    if (!(raw fits(e, inner, d))) { drop te_mismatch(e, n, inner, d); }
    pass inner;
};

// `e ?! code` — trap on failure. EXACTLY ONE ARGUMENT, TYPED `tbb32` (D-009),
// and the derivation is what fixes it: `?!` calls `failsafe`, whose signature is
// `func:failsafe = int32(tbb32:err)`, so the arity and the type both follow from
// there rather than being chosen.
//
// A `tbb32` that is itself ERR is LEGAL here and deliberately so — `failsafe`
// receiving a tainted code means "the failure code could not itself be computed",
// which is information, not a mistake.
func:type_emphatic_unwrap = int32(ExprTyper->:e, ExprNode:n) {
    int32:t = relay type_of_expr(e, raw expr_lhs(n));

    int32:saved = e.expected;
    e.expected = e.types.t_tbb32;
    int32:c = relay type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    if (c != 0i32) {
        if (!(raw type_is_invalid(e.types, c))) {
            if (c != e.types.t_tbb32) {
                string:m1 = relay string_concat(
                    "`?!` hands its argument to `failsafe`, which takes one `tbb32`, and this is `",
                    relay type_display(e.types, e.interns, c));
                drop te_error(e, raw TYPE_MISMATCH(),
                              relay string_concat(m1, "`"), n.span);
            }
        }
    }

    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_RESULT())) {
        pass (relay te_not_result(e, n, t, "?!"));
    }
    pass (raw type_elem(e.types, t));
};

func:te_not_result = int32(ExprTyper->:e, ExprNode:n, int32:t, string:op) {
    string:m1 = relay string_concat("`", op);
    string:m2 = relay string_concat(m1, "` needs a `Result`, and this is `");
    string:m3 = relay string_concat(m2, relay type_display(e.types, e.interns, t));
    pass (relay te_error(e, raw TYPE_MISMATCH(),
                         relay string_concat(m3, "`"), n.span));
};

// `is_err(tbbValue)` — THE ONE TEST IN THE LANGUAGE GUARANTEED NOT TO TRAP.
//
// ITS OPERAND IS A `tbb`, NOT A `Result`. An earlier reading had it testing a
// `Result`, which is a different question that `.is_error` already answers.
// `OP_REFERENCE` §5 is explicit about what this is for: **comparing or branching
// on an ERR value traps to `failsafe`**, because `bool` has two values and cannot
// represent ERR. So a program needs one way to ask "did this go ERR" that is safe
// on every value, and this is it.
//
// It has a node of its own rather than being a recognised call name because 0.5's
// flow analysis and 0.7's lowering both have to SEE which construct carries that
// guarantee. Recovering it from a callee's spelling is a string comparison
// standing in for a language rule.
func:type_is_err = int32(ExprTyper->:e, ExprNode:n) {
    int32:t = relay type_of_expr(e, raw expr_operand(n));
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_TBB())) {
        string:m1 = relay string_concat("`is_err` tests a `tbb` for ERR, and this is `",
                                        relay type_display(e.types, e.interns, t));
        string:m2 = relay string_concat(m1, "`");
        if ((raw type_kind(e.types, t)) == (raw TY_RESULT())) {
            m2 = relay string_concat(m2, "; a `Result` answers that with `.is_error`");
        }
        pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    pass (e.types.t_bool);
};

// `Result{value: v, error: e}` — THE ONLY CONSTRUCTOR IN THE LANGUAGE.
//
// `<T>` is never written: it comes from the enclosing function's declared success
// type. That is what lets `pass(v)` and `fail(e)` be sugar over this form rather
// than primitives of their own (TYPE_REFERENCE §11):
//
//     pass(retVal);   ->  return Result{error: 0i32, value: retVal};
//     fail(errCode);  ->  return Result{error: errCode, value: zero};
//
// THERE IS NO `is_error` FIELD (D-069). It is derived as `error != 0` on every
// read, so there is nothing for it to disagree with — a stored flag would be a
// second source of truth about one fact, and two sources of truth eventually
// differ. The prototype stored one; this is a deliberate departure.
func:type_result_literal = int32(ExprTyper->:e, ExprNode:n) {
    int32:want = e.fn_success;

    int32:saved = e.expected;
    e.expected = want;
    int32:vt = relay type_of_expr(e, raw expr_lhs(n));
    e.expected = e.types.t_tbb32;
    int32:et = relay type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    // An omitted field is the zero for its side, which is what the desugar of
    // `pass` and `fail` produces — each writes one field and leaves the other.
    if (vt == 0i32) { vt = want; }
    if (et == 0i32) { et = e.types.t_tbb32; }

    if (et != e.types.t_tbb32) {
        if (!(raw type_is_invalid(e.types, et))) {
            string:m1 = relay string_concat("a `Result`'s `error` is a `tbb32`, and this is `",
                                            relay type_display(e.types, e.interns, et));
            drop te_error(e, raw TYPE_MISMATCH(),
                          relay string_concat(m1, "`"), n.span);
        }
    }
    // OUTSIDE A FUNCTION there is no success type to infer from, and inventing one
    // would make the literal mean whatever the value field happened to be.
    if (want == 0i32) {
        pass (raw tt_result(e.types, vt,
                            raw type_size(e.types, vt),
                            raw type_align(e.types, vt)));
    }
    if (!(raw fits(e, want, vt))) {
        if (!(raw type_is_invalid(e.types, vt))) {
            drop te_mismatch(e, n, want, vt);
        }
    }
    pass (raw tt_result(e.types, want,
                        raw type_size(e.types, want),
                        raw type_align(e.types, want)));
};

// AN IDENTIFIER'S TYPE IS ITS DECLARATION'S.
//
// Resolution already did the hard part: `resolve_ident` stored the SYMBOL INDEX
// in slot `a` (0.3.5), so this is a lookup rather than a second search. That the
// slot holds a symbol index and not a child expression is safe because
// `expr_shape` files this kind as a LEAF — which is the difference between an
// undocumented reuse and a declared one (D-094).
func:type_ident = int32(ExprTyper->:e, ExprNode:n) {
    int32:sym = n.a;
    if (sym == 0i32) {
        // A bare-name builtin resolves to no symbol and that is correct
        // (AST_REFERENCE 3.3). Its signature arrives with call checking.
        pass 0i32;
    }
    Symbol:s = raw symtab_get(e.tab, sym);
    TypeResolver:r = raw tyres_init(e.ast, e.types, e.tab, e.interns, e.diags);

    // A LOCAL — its annotation is the type. Nitpick has no inferred bindings:
    // every declaration states its type, which is why this needs no unification.
    if (s.origin_kind == (raw SYM_STMT())) {
        StmtId:sid = StmtId{ index: s.origin };
        StmtNode:sn = relay ast_stmt(e.ast, sid);
        TypeId:ty = TypeId{ index: sn.a };
        pass (relay resolve_type(@r, ty, e.scope));
    }

    if (s.origin_kind == (raw SYM_DECL())) {
        DeclId:did = DeclId{ index: s.origin };
        DeclNode:dn = relay ast_decl(e.ast, did);
        if (dn.kind == DeclKind.DeclParamDecl) {
            // READING A DISCARDED PARAMETER IS AN ERROR (D-089). `Type:_~name`
            // says the parameter is deliberately unused, so a later use is either
            // a mistake or a stale annotation — and both are worth hearing about.
            if (raw param_is_discarded(dn)) {
                pass (relay te_error(e, raw TYPE_MISMATCH(),
                    "this parameter is declared discarded with `_~`, so it cannot be read; drop the `_~` if it is wanted",
                    n.span));
            }
            pass (relay resolve_type(@r, raw param_type(dn), e.scope));
        }
        if (dn.kind == DeclKind.DeclFunctionDecl) {
            pass (relay fn_type(@r, dn, s.name, e.scope));
        }
        if (dn.kind == DeclKind.DeclGlobalDecl) {
            TypeId:ty = TypeId{ index: dn.a };
            pass (relay resolve_type(@r, ty, e.scope));
        }
        // A TYPE NAME IN VALUE POSITION says what it is rather than "unknown".
        string:text = relay intern_get(e.interns, s.name);
        string:m1 = relay string_concat("`", text);
        pass (relay te_error(e, raw TYPE_MISMATCH(),
            relay string_concat(m1, "` is a type, not a value"), n.span));
    }

    // A `pick` destructuring binding takes its type from the scrutinee, which
    // needs the pattern checked against it — 0.4.6, with the enum variants.
    pass 0i32;
};

// DOES THIS NODE TAKE ITS TYPE FROM WHERE IT SITS? The nodes that do have to be
// typed AFTER the thing that gives them their type, which is the whole reason
// `type_binary` looks before it walks.
//
// It was named `is_untyped_literal` and answered only for unsuffixed integers,
// on the strength of a comment calling that "the one node whose type depends on
// where it sits". It never was: `NULL` has been contextual since 0.4.2 and `NIL`
// became so with D-099, so `NULL == p` and `NIL == opt` typed their left side
// with no context and reported the sentinel as homeless — while `p == NULL` and
// `opt == NIL`, the same question asked the other way round, worked. One list,
// and a sentinel that gains a context gains its place in the order with it.
pub func:takes_type_from_context = bool(ExprTyper->:e, ExprId:id) {
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = relay ast_expr(e.ast, id);
    // `ERR` is a `tbb32` wherever it appears and is deliberately absent here.
    if (n.kind == ExprKind.ExprSentinelLiteral) { pass (n.payload != 2i64); }
    if (n.kind != ExprKind.ExprIntLiteral) { pass false; }
    pass (!(raw num_width_is_integer(raw expr_num_width(n))));
};

// THE TYPE AN OPERAND SHOULD AIM AT, given the slot it is going into.
//
// An `Optional<U>` slot accepts a bare `U` and wraps it (D-099), so the type a
// VALUE wants there is `U` — the wrapper is supplied by `fits`, not written. The
// sentinels are the exception and read `e.expected` itself, because `NIL` is a
// fact about the wrapper rather than about a value inside it; that is why this is
// a separate accessor instead of a rewrite of `e.expected` at the push sites.
pub func:expected_value = int32(ExprTyper->:e) {
    if (e.expected == 0i32) { pass 0i32; }
    if ((raw type_kind(e.types, e.expected)) == (raw TY_OPTIONAL())) {
        pass (raw type_elem(e.types, e.expected));
    }
    pass (e.expected);
};

// MAY A VALUE OF TYPE `got` BE WRITTEN WHERE `want` IS EXPECTED?
//
// One answer for every slot in the language — a declaration's initialiser, a call
// argument, `pass`, a `Result{…}` field, an unwrap's default. Equality is the
// rule, and D-099's wrap is the single exception: an `Optional<U>` slot takes a
// `U`, which is how an `Optional` holding a value is built now that there is no
// constructor to write.
//
// NOTHING ELSE IS COERCED. No implicit widening (D-092), no numeric conversion,
// no pointer decay. And the wrap is ONE LEVEL, like D-098's dereference: an
// `Optional<Optional<U>>` cannot be written down (see `resolve_type`), so there
// is no second level for this to reach through.
pub func:fits = bool(ExprTyper->:e, int32:want, int32:got) {
    if (want == got) { pass true; }
    if ((raw type_kind(e.types, want)) == (raw TY_OPTIONAL())) {
        if ((raw type_elem(e.types, want)) == got) { pass true; }
    }
    pass false;
};

// --- the walk ----------------------------------------------------------------------------

pub func:type_of_expr = int32(ExprTyper->:e, ExprId:id) {
    if (raw expr_is_none(id)) {
        pass 0i32;
    }
    ExprNode:n = relay ast_expr(e.ast, id);

    if (n.kind == ExprKind.ExprIntLiteral)   { pass (relay type_numeric_literal(e, n, "42i32")); }
    if (n.kind == ExprKind.ExprFloatLiteral) { pass (relay type_numeric_literal(e, n, "1.5f64")); }
    if (n.kind == ExprKind.ExprBoolLiteral)  { pass (e.types.t_bool); }
    if (n.kind == ExprKind.ExprCharLiteral)  { pass (raw tt_char(e.types, 8i32)); }
    if (n.kind == ExprKind.ExprStringLiteral)      { pass (e.types.t_string); }
    if (n.kind == ExprKind.ExprRawStringLiteral)   { pass (e.types.t_string); }
    if (n.kind == ExprKind.ExprBlockStringLiteral) { pass (e.types.t_string); }
    if (n.kind == ExprKind.ExprTemplateLiteral)    { pass (e.types.t_string); }

    if (n.kind == ExprKind.ExprSentinelLiteral) {
        pass (relay type_sentinel(e, n));
    }

    // `$` inside `loop`/`till` — a counter with a type and no declaration.
    if (n.kind == ExprKind.ExprIterationVarExpr) {
        pass (raw tt_int(e.types, 64i32, true));
    }

    if (n.kind == ExprKind.ExprBinaryExpr) {
        pass (relay type_binary(e, id, n));
    }

    if (n.kind == ExprKind.ExprUnaryExpr) {
        pass (relay type_unary(e, id, n));
    }

    if (n.kind == ExprKind.ExprPostfixExpr) {
        pass (relay type_postfix(e, n));
    }

    // --- the `Result` family (OP_REFERENCE §0 level 2, D-081) ------------------
    //
    // Each of these takes a `Result<T>` and differs in what it does with the
    // error. They are separate nodes rather than one with a mode because 0.7 has
    // to lower them differently — `relay` is a normal exit path and runs `defer`,
    // `?!` traps and runs nothing (D-014, amended) — and a shared node would make
    // that distinction something the backend had to reconstruct.
    if (n.kind == ExprKind.ExprRawUnwrapExpr) {
        pass (relay type_unwrap(e, n, "raw"));
    }
    if (n.kind == ExprKind.ExprRelayExpr) {
        // `relay` IN `main` OR `failsafe` IS REFUSED. There is no `Result` to
        // relay into: the program ends there, so an error propagating out of it
        // has nowhere to go — the uncontrolled stop the discipline prevents.
        if (e.fn_terminal) {
            drop te_error(e, raw TYPE_RESULT_RETURN(),
                "`relay` returns the error from the enclosing function, and `main` and `failsafe` return no `Result` to relay into; handle it here with `?`, `?!` or a `pick`",
                n.span);
        }
        pass (relay type_unwrap(e, n, "relay"));
    }
    // `drop` DISCARDS THE OUTCOME and yields nothing. That it yields `NIL` rather
    // than `T` is the point: `drop f()` in a value position is then a type error
    // instead of silently being the value with its error thrown away.
    if (n.kind == ExprKind.ExprDropExpr) {
        drop type_unwrap(e, n, "drop");
        pass (e.types.t_nil);
    }
    if (n.kind == ExprKind.ExprAwaitExpr) {
        pass (relay type_unwrap(e, n, "await"));
    }

    // `e ? d` — a fallback. `e ?! c` — trap with a code. Both yield `T`.
    if (n.kind == ExprKind.ExprSafeUnwrapExpr) {
        pass (relay type_safe_unwrap(e, n));
    }
    if (n.kind == ExprKind.ExprEmphaticUnwrapExpr) {
        pass (relay type_emphatic_unwrap(e, n));
    }
    // `??` IS THE OPTIONAL ONE, not the Result one (OP_REFERENCE §14). Two
    // operators one character apart doing different things is worth being exact
    // about: `?` unwraps a `Result`, `??` unwraps an `Optional`.
    if (n.kind == ExprKind.ExprNullCoalesceExpr) {
        pass (relay type_null_coalesce(e, n));
    }

    // --- casts (D-021) --------------------------------------------------------------
    // Slot `b` is a TypeId, not an expression, which is why `expr_shape` files
    // both of these as one-operand nodes.
    if (n.kind == ExprKind.ExprCastExpr) {
        pass (relay type_cast_expr(e, n, false));
    }
    if (n.kind == ExprKind.ExprUncheckedCastExpr) {
        pass (relay type_cast_expr(e, n, true));
    }

    // --- the pointer family (OP_REFERENCE §0 level 5) -----------------------------
    if (n.kind == ExprKind.ExprAddressOfExpr) {
        int32:t = relay type_of_expr(e, raw expr_operand(n));
        if (t == 0i32) { pass 0i32; }
        pass (raw tt_pointer(e.types, t));
    }
    if (n.kind == ExprKind.ExprDerefExpr) {
        pass (relay type_deref(e, n));
    }
    // `$$i` / `$$m` — a SECOND-CLASS borrow (D-004). It is a pointer at the type
    // level and the borrow checker (0.5) is what makes it second-class; the
    // distinction is about where the value may travel, not about what it is.
    if (n.kind == ExprKind.ExprBorrowExpr) {
        int32:t = relay type_of_expr(e, raw expr_operand(n));
        if (t == 0i32) { pass 0i32; }
        pass (raw tt_pointer(e.types, t));
    }

    if (n.kind == ExprKind.ExprRangeExpr) {
        pass (relay type_range_expr(e, n));
    }
    if (n.kind == ExprKind.ExprTernaryExpr) {
        pass (relay type_ternary(e, n));
    }
    if (n.kind == ExprKind.ExprDefaultsExpr) {
        pass (relay type_defaults(e, n));
    }

    // `move(place)` (D-065) transfers ownership and yields the same type; what it
    // does to the SOURCE is the borrow checker's business in 0.5.
    if (n.kind == ExprKind.ExprMoveExpr) {
        pass (relay type_of_expr(e, raw expr_operand(n)));
    }
    // `..^coll` (D-026) expands a collection AT A CALL SITE and nowhere else.
    // Its type here is the collection's; 0.4.5 is where the position is checked,
    // because that is where an argument list exists to check it against.
    if (n.kind == ExprKind.ExprSpreadExpr) {
        pass (relay type_of_expr(e, raw expr_operand(n)));
    }

    // `is_err(x)` tests a `tbb` without trapping, and `Result{…}` is the only way
    // to construct a `Result` (D-097). An `Optional` has no counterpart to the
    // second of these: `NIL` is its empty value and a bare `T` is its full one
    // (D-099), so there is nothing here for it.
    if (n.kind == ExprKind.ExprIsErrExpr)        { pass (relay type_is_err(e, n)); }
    if (n.kind == ExprKind.ExprResultLiteralExpr) { pass (relay type_result_literal(e, n)); }


    if (n.kind == ExprKind.ExprIdentifierExpr) {
        pass (relay type_ident(e, n));
    }

    // Member access, indexing and calls live in `type_access.npk` — they are one
    // subject ("reaching into a value") and they all need the layout rules. The
    // hook keeps this module from depending on that one, since the traffic runs
    // the other way.
    pass (relay type_access(e, id, n));

};

func:type_binary = int32(ExprTyper->:e, ExprId:id, ExprNode:n) {
    TokenKind:op = raw expr_op(n);

    // An unsuffixed literal on one side takes the OTHER side's type (D-092), so
    // `x + 1` where `x` is `int64` is `int64` rather than an error about a
    // literal with no context.
    //
    // THE ORDER IS DECIDED UP FRONT rather than by typing one side and retrying.
    // A retry would have already emitted the "no context" diagnostic by the time
    // it succeeded, so `1 + x` reported an error and then produced the right
    // type -- the worst of both. One look at the node kind avoids it.
    int32:saved = e.expected;
    int32:lt = 0i32;
    int32:rt = 0i32;

    if (raw takes_type_from_context(e, raw expr_lhs(n))) {
        rt = relay type_of_expr(e, raw expr_rhs(n));
        if (rt != 0i32) { e.expected = rt; }
        lt = relay type_of_expr(e, raw expr_lhs(n));
        e.expected = saved;
    } else {
        lt = relay type_of_expr(e, raw expr_lhs(n));
        if (lt != 0i32) { e.expected = lt; }
        rt = relay type_of_expr(e, raw expr_rhs(n));
        e.expected = saved;
    }

    if (op == TokenKind.OpPlus)    { pass (relay type_arithmetic(e, n, lt, rt)); }
    if (op == TokenKind.OpMinus)   { pass (relay type_arithmetic(e, n, lt, rt)); }
    if (op == TokenKind.OpStar)    { pass (relay type_arithmetic(e, n, lt, rt)); }
    if (op == TokenKind.OpSlash)   { pass (relay type_arithmetic(e, n, lt, rt)); }
    if (op == TokenKind.OpPercent) { pass (relay type_arithmetic(e, n, lt, rt)); }

    if (op == TokenKind.OpEqEq)  { pass (relay type_comparison(e, n, lt, rt, false)); }
    if (op == TokenKind.OpNotEq) { pass (relay type_comparison(e, n, lt, rt, false)); }
    if (op == TokenKind.OpLt)    { pass (relay type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpLtEq)  { pass (relay type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpGt)    { pass (relay type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpGtEq)  { pass (relay type_comparison(e, n, lt, rt, true)); }
    if (op == TokenKind.OpSpaceship) {
        drop type_comparison(e, n, lt, rt, true);
        pass (raw tt_int(e.types, 32i32, true));
    }

    if (op == TokenKind.OpAndAnd) { pass (relay type_logical(e, n, lt, rt)); }
    if (op == TokenKind.OpOrOr)   { pass (relay type_logical(e, n, lt, rt)); }

    if (op == TokenKind.OpAmp)   { pass (relay type_bitwise(e, n, lt, rt)); }
    if (op == TokenKind.OpPipe)  { pass (relay type_bitwise(e, n, lt, rt)); }
    if (op == TokenKind.OpCaret) { pass (relay type_bitwise(e, n, lt, rt)); }
    if (op == TokenKind.OpShl)   { pass (relay type_bitwise(e, n, lt, rt)); }
    if (op == TokenKind.OpShr)   { pass (relay type_bitwise(e, n, lt, rt)); }

    pass 0i32;
};

func:type_unary = int32(ExprTyper->:e, ExprId:id, ExprNode:n) {
    TokenKind:op = raw expr_op(n);
    int32:t = relay type_of_expr(e, raw expr_operand(n));

    if (op == TokenKind.OpBang) {
        drop require_bool(e, t, n.span);
        pass (e.types.t_bool);
    }
    if (op == TokenKind.OpMinus) {
        if (raw type_is_invalid(e.types, t)) { pass 0i32; }
        if (!(raw type_is_numeric(e.types, t))) {
            pass (relay te_operand_error(e, n, t));
        }
        // Negating an UNSIGNED value is a question with no good answer, so it is
        // not asked: the result is either wrong or a different type.
        if (raw type_is_integer(e.types, t)) {
            if (!(raw type_is_signed(e.types, t))) {
                string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, t));
                string:m2 = relay string_concat(m1,
                    "` is unsigned, so it has no negation");
                pass (relay te_error(e, raw TYPE_NOT_NUMERIC(), m2, n.span));
            }
        }
        pass t;
    }
    if (op == TokenKind.OpTilde) {
        if (raw type_is_invalid(e.types, t)) { pass 0i32; }
        if (!(raw type_is_integer(e.types, t))) {
            pass (relay te_bitwise_error(e, n, t));
        }
        pass t;
    }
    pass t;
};
