// Keyword recognition.
//
// GENERATED by bootstrap/generator/gen_tables.py from
// meta/specs/LEXICAL_REFERENCE.md section 4.
//
// Keywords are recognised AFTER a whole identifier has been scanned, never by
// prefix matching -- so `iffy` is an identifier and not `if` followed by `fy`.
// Dispatching on LENGTH first turns 154 comparisons into a handful.

use "token_kind.npk".*;
use "intern.npk".*;

pub func:keyword_kind_of = TokenKind(string:text) {
    int64:n = text.len;
    if (n == 2i64) {
        if (raw string_eq(text, "as")) { pass TokenKind.KwAs; }
        if (raw string_eq(text, "fd")) { pass TokenKind.KwFd; }
        if (raw string_eq(text, "if")) { pass TokenKind.KwIf; }
        if (raw string_eq(text, "in")) { pass TokenKind.KwIn; }
        if (raw string_eq(text, "is")) { pass TokenKind.KwIs; }
        if (raw string_eq(text, "on")) { pass TokenKind.KwOn; }
    }
    if (n == 3i64) {
        if (raw string_eq(text, "ERR")) { pass TokenKind.KwERR; }
        if (raw string_eq(text, "NIL")) { pass TokenKind.KwNIL; }
        if (raw string_eq(text, "any")) { pass TokenKind.KwAny; }
        if (raw string_eq(text, "cfg")) { pass TokenKind.KwCfg; }
        if (raw string_eq(text, "dyn")) { pass TokenKind.KwDyn; }
        if (raw string_eq(text, "end")) { pass TokenKind.KwEnd; }
        if (raw string_eq(text, "for")) { pass TokenKind.KwFor; }
        if (raw string_eq(text, "gid")) { pass TokenKind.KwGid; }
        if (raw string_eq(text, "mod")) { pass TokenKind.KwMod; }
        if (raw string_eq(text, "nit")) { pass TokenKind.KwNit; }
        if (raw string_eq(text, "pid")) { pass TokenKind.KwPid; }
        if (raw string_eq(text, "pub")) { pass TokenKind.KwPub; }
        if (raw string_eq(text, "raw")) { pass TokenKind.KwRaw; }
        if (raw string_eq(text, "tid")) { pass TokenKind.KwTid; }
        if (raw string_eq(text, "uid")) { pass TokenKind.KwUid; }
        if (raw string_eq(text, "use")) { pass TokenKind.KwUse; }
    }
    if (n == 4i64) {
        if (raw string_eq(text, "NULL")) { pass TokenKind.KwNULL; }
        if (raw string_eq(text, "Self")) { pass TokenKind.KwSelf; }
        if (raw string_eq(text, "bool")) { pass TokenKind.KwBool; }
        if (raw string_eq(text, "drop")) { pass TokenKind.KwDrop; }
        if (raw string_eq(text, "else")) { pass TokenKind.KwElse; }
        if (raw string_eq(text, "enum")) { pass TokenKind.KwEnum; }
        if (raw string_eq(text, "exit")) { pass TokenKind.KwExit; }
        if (raw string_eq(text, "fail")) { pass TokenKind.KwFail; }
        if (raw string_eq(text, "fall")) { pass TokenKind.KwFall; }
        if (raw string_eq(text, "func")) { pass TokenKind.KwFunc; }
        if (raw string_eq(text, "give")) { pass TokenKind.KwGive; }
        if (raw string_eq(text, "impl")) { pass TokenKind.KwImpl; }
        if (raw string_eq(text, "int1")) { pass TokenKind.KwInt1; }
        if (raw string_eq(text, "int2")) { pass TokenKind.KwInt2; }
        if (raw string_eq(text, "int4")) { pass TokenKind.KwInt4; }
        if (raw string_eq(text, "int8")) { pass TokenKind.KwInt8; }
        if (raw string_eq(text, "loop")) { pass TokenKind.KwLoop; }
        if (raw string_eq(text, "move")) { pass TokenKind.KwMove; }
        if (raw string_eq(text, "nyte")) { pass TokenKind.KwNyte; }
        if (raw string_eq(text, "pass")) { pass TokenKind.KwPass; }
        if (raw string_eq(text, "pick")) { pass TokenKind.KwPick; }
        if (raw string_eq(text, "simd")) { pass TokenKind.KwSimd; }
        if (raw string_eq(text, "tbb8")) { pass TokenKind.KwTbb8; }
        if (raw string_eq(text, "then")) { pass TokenKind.KwThen; }
        if (raw string_eq(text, "till")) { pass TokenKind.KwTill; }
        if (raw string_eq(text, "trit")) { pass TokenKind.KwTrit; }
        if (raw string_eq(text, "true")) { pass TokenKind.KwTrue; }
        if (raw string_eq(text, "when")) { pass TokenKind.KwWhen; }
        if (raw string_eq(text, "wild")) { pass TokenKind.KwWild; }
        if (raw string_eq(text, "with")) { pass TokenKind.KwWith; }
    }
    if (n == 5i64) {
        if (raw string_eq(text, "Rules")) { pass TokenKind.KwRules; }
        if (raw string_eq(text, "arena")) { pass TokenKind.KwArena; }
        if (raw string_eq(text, "array")) { pass TokenKind.KwArray; }
        if (raw string_eq(text, "assoc")) { pass TokenKind.KwAssoc; }
        if (raw string_eq(text, "async")) { pass TokenKind.KwAsync; }
        if (raw string_eq(text, "await")) { pass TokenKind.KwAwait; }
        if (raw string_eq(text, "break")) { pass TokenKind.KwBreak; }
        if (raw string_eq(text, "char8")) { pass TokenKind.KwChar8; }
        if (raw string_eq(text, "const")) { pass TokenKind.KwConst; }
        if (raw string_eq(text, "defer")) { pass TokenKind.KwDefer; }
        if (raw string_eq(text, "fails")) { pass TokenKind.KwFails; }
        if (raw string_eq(text, "false")) { pass TokenKind.KwFalse; }
        if (raw string_eq(text, "fixed")) { pass TokenKind.KwFixed; }
        if (raw string_eq(text, "flt32")) { pass TokenKind.KwFlt32; }
        if (raw string_eq(text, "flt64")) { pass TokenKind.KwFlt64; }
        if (raw string_eq(text, "frac8")) { pass TokenKind.KwFrac8; }
        if (raw string_eq(text, "int16")) { pass TokenKind.KwInt16; }
        if (raw string_eq(text, "int32")) { pass TokenKind.KwInt32; }
        if (raw string_eq(text, "int64")) { pass TokenKind.KwInt64; }
        if (raw string_eq(text, "limit")) { pass TokenKind.KwLimit; }
        if (raw string_eq(text, "macro")) { pass TokenKind.KwMacro; }
        if (raw string_eq(text, "never")) { pass TokenKind.KwNever; }
        if (raw string_eq(text, "prove")) { pass TokenKind.KwProve; }
        if (raw string_eq(text, "relay")) { pass TokenKind.KwRelay; }
        if (raw string_eq(text, "stack")) { pass TokenKind.KwStack; }
        if (raw string_eq(text, "tbb16")) { pass TokenKind.KwTbb16; }
        if (raw string_eq(text, "tbb32")) { pass TokenKind.KwTbb32; }
        if (raw string_eq(text, "tbb64")) { pass TokenKind.KwTbb64; }
        if (raw string_eq(text, "tfp32")) { pass TokenKind.KwTfp32; }
        if (raw string_eq(text, "tfp64")) { pass TokenKind.KwTfp64; }
        if (raw string_eq(text, "trait")) { pass TokenKind.KwTrait; }
        if (raw string_eq(text, "tryte")) { pass TokenKind.KwTryte; }
