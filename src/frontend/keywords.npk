        if (raw string_eq(text, "uint2")) { pass TokenKind.KwUint2; }
        if (raw string_eq(text, "uint4")) { pass TokenKind.KwUint4; }
        if (raw string_eq(text, "uint8")) { pass TokenKind.KwUint8; }
        if (raw string_eq(text, "where")) { pass TokenKind.KwWhere; }
        if (raw string_eq(text, "while")) { pass TokenKind.KwWhile; }
        if (raw string_eq(text, "wildx")) { pass TokenKind.KwWildx; }
    }
    if (n == 6i64) {
        if (raw string_eq(text, "Future")) { pass TokenKind.KwFuture; }
        if (raw string_eq(text, "Handle")) { pass TokenKind.KwHandle; }
        if (raw string_eq(text, "Result")) { pass TokenKind.KwResult; }
        if (raw string_eq(text, "atomic")) { pass TokenKind.KwAtomic; }
        if (raw string_eq(text, "buffer")) { pass TokenKind.KwBuffer; }
        if (raw string_eq(text, "char16")) { pass TokenKind.KwChar16; }
        if (raw string_eq(text, "char32")) { pass TokenKind.KwChar32; }
        if (raw string_eq(text, "derive")) { pass TokenKind.KwDerive; }
        if (raw string_eq(text, "dim256")) { pass TokenKind.KwDim256; }
        if (raw string_eq(text, "extern")) { pass TokenKind.KwExtern; }
        if (raw string_eq(text, "flt128")) { pass TokenKind.KwFlt128; }
        if (raw string_eq(text, "flt256")) { pass TokenKind.KwFlt256; }
        if (raw string_eq(text, "flt512")) { pass TokenKind.KwFlt512; }
        if (raw string_eq(text, "frac16")) { pass TokenKind.KwFrac16; }
        if (raw string_eq(text, "frac32")) { pass TokenKind.KwFrac32; }
        if (raw string_eq(text, "frac64")) { pass TokenKind.KwFrac64; }
        if (raw string_eq(text, "inline")) { pass TokenKind.KwInline; }
        if (raw string_eq(text, "int128")) { pass TokenKind.KwInt128; }
        if (raw string_eq(text, "int256")) { pass TokenKind.KwInt256; }
        if (raw string_eq(text, "int512")) { pass TokenKind.KwInt512; }
        if (raw string_eq(text, "is_err")) { pass TokenKind.KwIs_err; }
        if (raw string_eq(text, "nodrop")) { pass TokenKind.KwNodrop; }
        if (raw string_eq(text, "opaque")) { pass TokenKind.KwOpaque; }
        if (raw string_eq(text, "return")) { pass TokenKind.KwReturn; }
        if (raw string_eq(text, "string")) { pass TokenKind.KwString; }
        if (raw string_eq(text, "struct")) { pass TokenKind.KwStruct; }
        if (raw string_eq(text, "tbb128")) { pass TokenKind.KwTbb128; }
        if (raw string_eq(text, "tbb256")) { pass TokenKind.KwTbb256; }
        if (raw string_eq(text, "tfp128")) { pass TokenKind.KwTfp128; }
        if (raw string_eq(text, "tfp256")) { pass TokenKind.KwTfp256; }
        if (raw string_eq(text, "uint16")) { pass TokenKind.KwUint16; }
        if (raw string_eq(text, "uint32")) { pass TokenKind.KwUint32; }
        if (raw string_eq(text, "uint64")) { pass TokenKind.KwUint64; }
    }
    if (n == 7i64) {
        if (raw string_eq(text, "acq_rel")) { pass TokenKind.KwAcq_rel; }
        if (raw string_eq(text, "acquire")) { pass TokenKind.KwAcquire; }
        if (raw string_eq(text, "complex")) { pass TokenKind.KwComplex; }
        if (raw string_eq(text, "cstring")) { pass TokenKind.KwCstring; }
        if (raw string_eq(text, "discard")) { pass TokenKind.KwDiscard; }
        if (raw string_eq(text, "ensures")) { pass TokenKind.KwEnsures; }
        if (raw string_eq(text, "int1024")) { pass TokenKind.KwInt1024; }
