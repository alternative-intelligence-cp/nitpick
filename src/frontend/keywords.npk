        if (raw string_eq(text, "continue")) { pass TokenKind.KwContinue; }
        if (raw string_eq(text, "defaults")) { pass TokenKind.KwDefaults; }
        if (raw string_eq(text, "noinline")) { pass TokenKind.KwNoinline; }
        if (raw string_eq(text, "requires")) { pass TokenKind.KwRequires; }
        if (raw string_eq(text, "uint1024")) { pass TokenKind.KwUint1024; }
        if (raw string_eq(text, "uint2048")) { pass TokenKind.KwUint2048; }
        if (raw string_eq(text, "uint4096")) { pass TokenKind.KwUint4096; }
    }
    if (n == 9i64) {
        if (raw string_eq(text, "invariant")) { pass TokenKind.KwInvariant; }
    }
    if (n == 12i64) {
        if (raw string_eq(text, "shared_arena")) { pass TokenKind.KwShared_arena; }
    }
    if (n == 13i64) {
        if (raw string_eq(text, "assert_static")) { pass TokenKind.KwAssert_static; }
    }

    // Not a keyword. The caller keeps it as an identifier.
    pass TokenKind.Ident;
};

pub func:is_keyword = bool(string:text) {
    TokenKind:k = raw keyword_kind_of(text);
    pass (k != TokenKind.Ident);
};
