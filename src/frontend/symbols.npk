// The symbol table.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.3.1.
//
// One place that knows what every name in the program means.
//
// A symbol binds a NAME to the node that DECLARED it, in a SCOPE. It stores no
// type, no span and no text of its own: all of that is already on the node, and
// copying it here would make a second place for one fact to live — the defect
// this cycle set has spent its whole length removing. `symbol_span` reads through
// to the declaration rather than caching it.
//
// THE TWO-PHASE COLLECT (D-086). Every declaration in the graph is collected
// before any body is resolved. That is not an optimisation: it is the property
// that makes a `use` cycle resolvable at all, and it is the same one that already
// lets a function call another declared below it in the same file. Phase 1 walks
// declarations and never looks inside a `BlockStmt`; phase 2 (cycle 0.3.5)
// resolves bodies against the finished table.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
mod:symbols;
error:BoundsId;

use "./source_location.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./resolve_codes.npk".*;
use "./parse_decl.npk".*;

// --- what introduced a name ------------------------------------------------------
//
// Three node arrays can introduce one, so the symbol records WHICH along with the
// index. A single discriminated index rather than three slots two of which are
// always empty.
pub func:SYM_DECL = int32() never fails { pass 1i32; };   // func, struct, param, generic, …
pub func:SYM_STMT = int32() never fails { pass 2i32; };   // a local `VarDeclStmt`
pub func:SYM_PAT = int32() never fails  { pass 3i32; };   // a `pick` destructuring binding

pub func:SYM_PUB = int32() never fails { pass 1i32; };
// Bound by a `use` rather than declared here. Kept for diagnostics -- "you
// imported this" reads differently from "you declared this" -- and NOT consulted
// when deciding what a module exports.
pub func:SYM_IMPORTED = int32() never fails { pass 2i32; };

// WHAT A MODULE EXPORTS IS EXACTLY `SYM_PUB`, and the flags are arranged so that
// no second rule is needed:
//
//   own declaration, `pub`      PUB                  exported
//   own declaration, private    --                   not exported
//   plain `use`                 IMPORTED             not exported
//   `pub use`                   IMPORTED | PUB       exported
//
// So "imports do not chain" (MODULE_REFERENCE 2.3) is not a check anywhere: a
// plain import simply never sets the bit that makes something visible outward.
// Re-export is `pub use` and nothing else, which keeps a module's surface its
// own rather than the transitive closure of everything its dependencies
// happened to import.
pub func:symbol_is_exported = bool(Symbol:s) never fails {
    pass ((s.flags & (raw SYM_PUB())) != 0i32);
};

pub func:symbol_is_imported = bool(Symbol:s) never fails {
    pass ((s.flags & (raw SYM_IMPORTED())) != 0i32);
};

pub struct:Symbol = {
    int32:name;          // intern index; 0 is the reserved empty string
    int32:scope;
    int32:origin_kind;
    int32:origin;        // index into the array `origin_kind` names
    int32:flags;
    int32:next;          // next symbol in the SAME scope, or 0

    // THE SCOPE THIS NAME OPENS, for a symbol that names a NAMESPACE — a nested
    // `mod:name = { … }`. Zero for everything else.
    //
    // A `Scope` records its parent and not its owner, so without this a module's
    // members were unreachable from its name: `math.sqrt` had the symbol for
    // `math` and no way to get from there to the scope holding `sqrt`. Walking
    // the scope tree looking for one whose parent matches would find every
    // sibling block as well.
    int32:inner;
};

// A scope is a node in a tree. `first` heads a chain through `Symbol.next`, so a
// lookup walks only this scope's own symbols rather than the whole table --
// which matters, because name resolution is the most-repeated operation in the
// frontend after lexing.
pub func:SCOPE_MODULE = int32() never fails   { pass 1i32; };
pub func:SCOPE_FUNCTION = int32() never fails { pass 2i32; };
pub func:SCOPE_BLOCK = int32() never fails    { pass 3i32; };

pub struct:Scope = {
    int32:parent;
    int32:kind;
    int32:first;
};

pub struct:SymbolTable = {
    List<Symbol>:syms;
    List<Scope>:scopes;

    // WHICH MODULE SCOPE A DECLARATION WAS DECLARED IN, indexed by DeclId (0.8.1).
    //
    // A declaration's type annotations mean what they mean WHERE IT WAS WRITTEN —
    // the blueprint rule, applied to name lookup. Until this table existed, a
    // signature or a field type was resolved in whatever scope the USE happened
    // to sit in: `tyres_init(Ast->:ast, …)` typed fine from a caller that
    // imported `ast.npk` and reported "no type named `Ast`" from one that did
    // not — and with a name collision it would not have erred at all, it would
    // have silently bound the CALLER's type. Found by the first whole-graph
    // self-check; invisible before it because every test's caller happened to
    // import what the callee's types needed.
    // A SPARSE MAP, not an append: the count is the high-water mark and the
    // caller's DeclId is the index. See `symtab_set_home`.
    List<int32>:decl_home;

    // THE LIST MODULE'S SCOPE (D-247, 1.5.1b step 5), or 0: the file module
    // named `list`, whose `struct:List<T>` the compiler knows as OWNING. The
    // loader records it; the layout and the drop generator ask. Keyed on the
    // module until the snapshot refresh lets the declaration move into the
    // prelude (D-205: the builder's embedded prelude has no `List`, so `src/`
    // cannot yet use one there), where D-239 makes the name unique.
    int32:prelude_scope;   // the scope module 0 (the prelude) collected into; `List<T>` is found there (D-247)
};

pub func:symtab_init = SymbolTable() never fails {
    int64:n = 128i64;
    SymbolTable:t = SymbolTable{
        syms:   raw list_init::<Symbol>(n),
        scopes: raw list_init::<Scope>(n),
        decl_home: raw list_init::<int32>(256i64),
        prelude_scope: 0i32
    };

    // Index 0 is reserved in BOTH arrays, matching the AST's convention: a zeroed
    // handle is a well-defined absence rather than a silent reference to whatever
    // was created first.
    Symbol:none = Symbol{ name: 0i32, scope: 0i32, origin_kind: 0i32,
                          origin: 0i32, flags: 0i32, next: 0i32, inner: 0i32 };
    drop list_push(@t.syms, none);

    Scope:root = Scope{ parent: 0i32, kind: 0i32, first: 0i32 };
    drop list_push(@t.scopes, root);

    pass t;
};

// --- scopes -------------------------------------------------------------------------

// A SCOPE ID AND A SYMBOL ID ARE int32 BY CONTRACT (D-226): both are stored in
// `Scope` and `Symbol` slots and held as int32 locals across resolve.npk and
// module_graph.npk, so the count's width cannot follow them out. The narrow is
// guarded and reuses `BoundsId`, which this module already declares -- the
// middle arm of the rule, and the one that costs no `failsafe` an arm.
func:symtab_id = int32(int64:n) never fails {
    if (n > 2147483647i64) { !!! BoundsId; }
    pass (n =>! int32);
};

pub func:scope_open = int32(SymbolTable->:t, int32:parent, int32:kind) never fails {
    Scope:s = Scope{ parent: parent, kind: kind, first: 0i32 };
    // READ BEFORE THE PUSH -- `list_push` performs the increment.
    int32:id = raw symtab_id(t.scopes.count);
    drop list_push(@t.scopes, s);
    pass id;
};

pub func:scope_parent = int32(SymbolTable->:t, int32:scope) never fails {
    pass t.scopes.items[scope => int64].parent;
};

pub func:scope_kind = int32(SymbolTable->:t, int32:scope) never fails {
    pass t.scopes.items[scope => int64].kind;
};

// --- symbols ------------------------------------------------------------------------

// A module's name and the scope it opens, tied together. `math.sqrt` needs to
// get from one to the other, and a `Scope` records only its parent.
pub func:symtab_set_inner = NIL(SymbolTable->:t, int32:sym, int32:scope) never fails {
    if (sym == 0i32) { pass NIL; }
    Symbol:s = t.syms.items[sym => int64];
    s.inner = scope;
    t.syms.items[sym => int64] = s;
    pass NIL;
};

// THE SCOPE A NESTED `mod:name = { … };` OPENED, or 0 if there is not one.
//
// EVERY WALK OVER A MODULE'S MEMBERS NEEDS THIS, and each one that did without it
// skipped the nested module entirely: the type checker never descended into one,
// and neither did the impl or bound collection — so a function inside a `mod`
// block was resolved and never checked, and an `impl` inside one was invisible to
// coherence, to completeness, and to method lookup. None of the three announced
// itself, because a walk with no entry for a kind reports nothing by
// construction.
//
// One function rather than the same six lines in each caller, for the reason the
// scope search it replaced demonstrates: three copies of a lookup are three
// chances for one of them to answer differently.
pub func:nested_module_scope = int32(SymbolTable->:t, DeclNode:d, int32:scope) never fails {
    int32:sym = raw scope_lookup_local(t, scope, raw decl_name(d));
    if (sym == 0i32) { pass 0i32; }
    Symbol:s = raw symtab_get(t, sym);
    pass s.inner;
};

func:symtab_set_home = NIL(SymbolTable->:t, int32:decl, int32:scope) never fails {
    if (decl < 0i32) { pass NIL; }
    // GROW TO COVER THE INDEX, as a bulk append: reserve the whole span first
    // (one doubling does not cover a jump), then write "no home" into every
    // new slot. The zero is explicit now rather than the allocator's.
    int64:want = (decl => int64) + 1i64;
    if (t.decl_home.count < want) {
        drop list_reserve(@t.decl_home, want - t.decl_home.count);
        while (t.decl_home.count < want) { drop list_push(@t.decl_home, 0i32); }
    }
    // FIRST WRITER WINS. The declaration's own module collects it first; a
    // re-collection round after expansion must not move it.
    if (t.decl_home.items[decl => int64] == 0i32) {
        t.decl_home.items[decl => int64] = scope;
    }
    pass NIL;
};

// The scope a declaration's OWN annotations resolve in — its module's, however
// far away the code asking about it sits. Zero when the declaration was never
// collected, in which case the caller's scope is the only one there is.
pub func:symtab_home_scope = int32(SymbolTable->:t, int32:decl, int32:fallback) never fails {
    if (decl < 0i32) { pass fallback; }
    if ((decl => int64) >= t.decl_home.count) { pass fallback; }
    int32:h = t.decl_home.items[decl => int64];
    if (h == 0i32) { pass fallback; }
    pass h;
};

pub func:symtab_get = Symbol(SymbolTable->:t, int32:id) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if ((id => int64) >= t.syms.count) { !!! BoundsId; }
    pass t.syms.items[id => int64];
};

pub func:symtab_count = int32(SymbolTable->:t) never fails { pass (raw symtab_id(t.syms.count)); };
pub func:symtab_scope_count = int32(SymbolTable->:t) never fails { pass (raw symtab_id(t.scopes.count)); };

// Look a name up in ONE scope, without walking outward.
pub func:scope_lookup_local = int32(SymbolTable->:t, int32:scope, int32:name) never fails {
    int32:cur = t.scopes.items[scope => int64].first;
    while (cur != 0i32) {
        if (t.syms.items[cur => int64].name == name) {
            pass cur;
        }
        cur = t.syms.items[cur => int64].next;
    }
    pass 0i32;
};

// Look outward through enclosing scopes, stopping AT the module boundary.
//
// It stops rather than continuing because a nested `mod` is a different module,
// and reaching into an enclosing one would make a module's surface depend on
// where it happens to be written. Crossing a module boundary is what `use` is
// for, and 0.3.4 handles it.
pub func:scope_lookup = int32(SymbolTable->:t, int32:scope, int32:name) never fails {
    int32:cur = scope;
    while (cur != 0i32) {
        int32:hit = raw scope_lookup_local(t, cur, name);
        if (hit != 0i32) {
            pass hit;
        }
        if ((raw scope_kind(t, cur)) == (raw SCOPE_MODULE())) {
            break;
        }
        cur = raw scope_parent(t, cur);
    }
    pass 0i32;
};

// Where a symbol was declared. Read THROUGH the origin rather than stored, so
// there is one span for one declaration and it cannot go stale.
pub func:symbol_span = Span(Ast->:ast, SymbolTable->:t, int32:id) never fails {
    Symbol:s = raw symtab_get(t, id);
    if (s.origin_kind == (raw SYM_DECL())) {
        DeclId:d = DeclId{ index: s.origin };
        pass ((raw ast_decl(ast, d)).span);
    }
    if (s.origin_kind == (raw SYM_STMT())) {
        StmtId:st = StmtId{ index: s.origin };
        pass ((raw ast_stmt(ast, st)).span);
    }
    if (s.origin_kind == (raw SYM_PAT())) {
        PatId:pt = PatId{ index: s.origin };
        pass ((raw ast_pat(ast, pt)).span);
    }
    pass (raw span_none());
};

// Declare a name in a scope.
//
// A DUPLICATE IS AN ERROR, and it names both places: the error sits on the second
// declaration and a note points at the first. "First wins" is not a policy, it is
// a coin toss the reader cannot see -- and the reader is the one who has to work
// out which of two identical-looking declarations the program actually used.
//
// Returns the symbol id, or 0 when it was a duplicate.
pub func:symtab_declare = int32(SymbolTable->:t, Ast->:ast, DiagList->:diags,
                                int32:scope, int32:name,
                                int32:origin_kind, int32:origin, int32:flags) never fails {
    int32:prior = raw scope_lookup_local(t, scope, name);
    if (prior != 0i32) {
        Span:here = raw span_none();
        if (origin_kind == (raw SYM_DECL())) {
            DeclId:d = DeclId{ index: origin };
            here = (raw ast_decl(ast, d)).span;
        }
        if (origin_kind == (raw SYM_STMT())) {
            StmtId:st = StmtId{ index: origin };
            here = (raw ast_stmt(ast, st)).span;
        }
        // A PATTERN BINDING HAS A PLACE TOO (1.0.8): `Net.Disconnect(a, a)`
        // reported its duplicate with no span at all, because this listed two
        // of the three origin kinds `symbol_span` already knows.
        if (origin_kind == (raw SYM_PAT())) {
            PatId:pt = PatId{ index: origin };
            here = (raw ast_pat(ast, pt)).span;
        }
        drop diaglist_push(diags,
            raw diag_error(raw RESOLVE_DUPLICATE(),
                           "this name is already declared in this scope", here));
        drop diaglist_push(diags,
            raw diag_note(raw RESOLVE_DUPLICATE(),
                          "the first declaration is here",
                          raw symbol_span(ast, t, prior)));
        pass 0i32;
    }

    // A DECLARATION REMEMBERS ITS HOME as a side effect of being declared —
    // collection is the one walk that holds both the DeclId and the scope, so
    // recording here needs no second traversal. Imported bindings do NOT pass
    // this way (`symtab_bind_import` is a different function), which is exactly
    // right: an import must never relabel a declaration's home.
    if (origin_kind == (raw SYM_DECL())) {
        drop symtab_set_home(t, origin, scope);
    }
    Symbol:s = Symbol{ name: name, scope: scope,
                       origin_kind: origin_kind, origin: origin,
                       flags: flags, next: t.scopes.items[scope => int64].first, inner: 0i32 };
    int32:id = raw symtab_id(t.syms.count);   // BEFORE the push
    drop list_push(@t.syms, s);

    // Push onto the head of the scope's chain. Order within a scope does not
    // matter for lookup, because a duplicate is refused above -- so at most one
    // symbol per name is ever reachable.
    Scope:sc = t.scopes.items[scope => int64];
    sc.first = id;
    t.scopes.items[scope => int64] = sc;
    pass id;
};

// Bind a name that came from a `use`.
//
// Returns 0 without complaint when the scope already has the name. A LOCAL
// DECLARATION WINS over an import, and the caller decides whether that silence
// deserves a diagnostic: for a wildcard it does (0.3.4), because a program whose
// meaning turns on which of two things a bare name refers to is worth a word.
// IDEMPOTENT. Binding the same name to the same origin twice succeeds and
// changes nothing, which is what lets the import pass run repeatedly to a fixed
// point (0.3.4) without every repetition looking like a collision.
pub func:symtab_bind_import = int32(SymbolTable->:t, int32:scope, int32:name,
                                    int32:origin_kind, int32:origin, int32:flags) never fails {
    int32:prior = raw scope_lookup_local(t, scope, name);
    if (prior != 0i32) {
        Symbol:p = t.syms.items[prior => int64];
        if (p.origin_kind == origin_kind) {
            if (p.origin == origin) {
                // The same thing, bound again. A re-export chain reaching the
                // same declaration by two routes is not a conflict.
                //
                // ...AND A `pub use` AFTER A PLAIN `use` RE-EXPORTS (1.5.1b
                // step 3c, the workbench's O-N13). The repeat carried
                // `SYM_PUB` and this return discarded it, so the same two
                // lines meant different things in the two orders, and the
                // consumer's "cannot find X" pointed a file away from the
                // cause. The prior binding takes the visibility the repeat
                // asks for; a plain repeat of a `pub use` keeps it.
                if (((flags & (raw SYM_PUB())) != 0i32) && ((p.flags & (raw SYM_PUB())) == 0i32)) {
                    p.flags = p.flags | (raw SYM_PUB());
                    t.syms.items[prior => int64] = p;
                }
                pass prior;
            }
        }
        pass 0i32;
    }
    Symbol:s = Symbol{ name: name, scope: scope,
                       origin_kind: origin_kind, origin: origin,
                       flags: flags | (raw SYM_IMPORTED()),
                       next: t.scopes.items[scope => int64].first, inner: 0i32 };
    int32:id = raw symtab_id(t.syms.count);   // BEFORE the push
    drop list_push(@t.syms, s);
    Scope:sc = t.scopes.items[scope => int64];
    sc.first = id;
    t.scopes.items[scope => int64] = sc;
    pass id;
};

// Every symbol declared directly in a scope, in declaration order.
//
// The chain is built head-first, so walking it yields the REVERSE of declaration
// order -- and anything that iterates a module's exports must be deterministic
// (D-086), so this reverses it back rather than leaving the order to how the
// list happens to be built.
pub func:scope_symbol_at = int32(SymbolTable->:t, int32:scope, int32:i) never fails {
    int32:n = raw scope_symbol_count(t, scope);
    if (i < 0i32) { pass 0i32; }
    if (i >= n) { pass 0i32; }
    int32:want = n - 1i32 - i;
    int32:cur = t.scopes.items[scope => int64].first;
    int32:k = 0i32;
    while (cur != 0i32) {
        if (k == want) { pass cur; }
        cur = t.syms.items[cur => int64].next;
        k = k + 1i32;
    }
    pass 0i32;
};

pub func:scope_symbol_count = int32(SymbolTable->:t, int32:scope) never fails {
    int32:cur = t.scopes.items[scope => int64].first;
    int32:n = 0i32;
    while (cur != 0i32) {
        cur = t.syms.items[cur => int64].next;
        n = n + 1i32;
    }
    pass n;
};

// --- phase 1: collect declarations ----------------------------------------------------
//
// Walks the declaration structure and NOTHING ELSE. It does not enter a function
// body, an initialiser or a contract: those are phase 2, and entering them here
// would defeat the whole arrangement by requiring a name to be declared before it
// is used.

pub func:collect_module = int32(SymbolTable->:t, Ast->:ast, DiagList->:diags,
                                DeclId:mod_id, int32:parent_scope) never fails {
    DeclNode:m = raw ast_decl(ast, mod_id);
    int32:scope = raw scope_open(t, parent_scope, raw SCOPE_MODULE());

    int32:n = raw item_member_count(ast, m);
    for (int32:i in 0i32...n) {
        DeclId:item = raw item_member(ast, m, i);
        drop collect_decl(t, ast, diags, item, scope);
    }
    pass scope;
};

// THE HEADER SLOT: 1 when a module's first item is a member-less `mod:name;`
// -- a FILE's header under D-248 (1.5.1b step 1) -- else 0. A file root's
// walk starts past it; an inline module's does not, since only a file has one.
pub func:header_slot = int32(Ast->:ast, DeclId:mod_id) never fails {
    DeclNode:m = raw ast_decl(ast, mod_id);
    if ((raw item_member_count(ast, m)) == 0i32) { pass 0i32; }
    DeclNode:d0 = raw ast_decl(ast, raw item_member(ast, m, 0i32));
    if (d0.kind != DeclKind.DeclModuleDecl) { pass 0i32; }
    if ((raw item_member_count(ast, d0)) != 0i32) { pass 0i32; }
    pass 1i32;
};

// A FILE's root module: `collect_module` past the header slot. THE HEADER BINDS
// NOTHING (D-248): until 1.5.1b step 1 a file's `mod:foo;` was collected like
// any member-less module declaration -- a symbol `foo` in the file's own scope
// -- which is what made a file unable to declare a function named after itself
// (`resolve_type.npk`'s `resolve_type` is why that file had no header). The
// snapshot that builds `src/` still binds it, so the two such files were
// renamed rather than exempted; every compiler built from this source skips.
pub func:collect_file_module = int32(SymbolTable->:t, Ast->:ast, DiagList->:diags,
                                     DeclId:mod_id, int32:parent_scope) never fails {
    DeclNode:m = raw ast_decl(ast, mod_id);
    int32:scope = raw scope_open(t, parent_scope, raw SCOPE_MODULE());

    int32:n = raw item_member_count(ast, m);
    int32:first = raw header_slot(ast, mod_id);
    for (int32:i in first...n) {
        DeclId:item = raw item_member(ast, m, i);
        drop collect_decl(t, ast, diags, item, scope);
    }
    pass scope;
};

pub func:collect_decl = NIL(SymbolTable->:t, Ast->:ast, DiagList->:diags,
                            DeclId:id, int32:scope) never fails {
    DeclNode:d = raw ast_decl(ast, id);

    // A nested `mod:name = { … };` is a namespace of its own, so it declares its
    // name here and its members in a scope of its own.
    if (d.kind == DeclKind.DeclModuleDecl) {
        int32:sym = raw symtab_declare(t, ast, diags, scope, raw decl_name(d),
                                         raw SYM_DECL(), id.index,
                                         raw decl_flag_bits(d));
        int32:inner = raw collect_module(t, ast, diags, id, scope);
        // The name and the scope it opens, tied together — `math.sqrt` needs to
        // get from one to the other and a `Scope` records only its parent.
        drop symtab_set_inner(t, sym, inner);
        pass NIL;
    }

    // An `extern` block declares its FUNCTIONS, not itself: a caller writes
    // `open(...)`, never `libc.open(...)`. The block is a grouping and a place to
    // hang the library name, which is why it has no name of its own to collide
    // with anything.
    if (d.kind == DeclKind.DeclExternBlock) {
        // THE BLOCK IS THE INTERFACE RECORD, NOT A DECLARER (D-190, 1.1.13c).
        // Its methods' names are carried by the GENERATED stubs, spliced into
        // this module in the expansion phase before collection ran — binding
        // the raw declarations too would declare every name twice. (Until the
        // Bridge landed, the block's functions were the old in-process FFI
        // surface and collected here; D-149 ended that model.)
        pass NIL;
    }

    // An `impl` block declares nothing at module scope. Its methods are reached
    // through the type, which needs the type to exist first -- so they are
    // collected in cycle 0.4 where coherence is decided, not here.
    if (d.kind == DeclKind.DeclImplDecl) {
        pass NIL;
    }

    // `use` binds names too, but what it binds depends on another module having
    // been collected already. That is 0.3.4.
    if (d.kind == DeclKind.DeclImportDecl) {
        pass NIL;
    }

    // Everything else declares its own name: func, struct, enum, trait, Rules,
    // macro, opaque, global, extern fn, assoc.
    int32:name = raw decl_name(d);
    if (raw intern_is_none(name)) {
        pass NIL;
    }
    int32:fbits = raw decl_flag_bits(d);
    // AN ERROR CONSTANT IS IMPLICITLY PUBLIC (D-179): its identity crosses
    // every boundary a `Result` can, and `failsafe` must be able to NAME
    // whatever can reach it — a private identity that still arrives would be
    // unhandleable by construction.
    if (d.kind == DeclKind.DeclErrorDecl) {
        fbits = fbits | (raw SYM_PUB());
    }
    discard(raw symtab_declare(t, ast, diags, scope, name,
                        raw SYM_DECL(), id.index, fbits));
    pass NIL;
};

// `pub` on the declaration becomes `pub` on the symbol. Visibility is BINARY
// (MODULE_REFERENCE section 3) -- no `pub(crate)`, no friends -- so one bit
// carries it.
pub func:decl_flag_bits = int32(DeclNode:d) never fails {
    if (raw decl_has(d, raw DECL_PUB())) {
        pass (raw SYM_PUB());
    }
    pass 0i32;
};

pub func:symbol_is_pub = bool(Symbol:s) never fails {
    pass ((s.flags & (raw SYM_PUB())) != 0i32);
};
