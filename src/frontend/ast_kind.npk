    StmtForStmt                  = 8i32;
    StmtLoopStmt                 = 9i32;
    StmtTillStmt                 = 10i32;
    StmtWhenStmt                 = 11i32;
    StmtBreakStmt                = 12i32;
    StmtContinueStmt             = 13i32;
    StmtPassStmt                 = 14i32;
    StmtFailStmt                 = 15i32;
    StmtReturnStmt               = 16i32;
    StmtExitStmt                 = 17i32;
    StmtTrapStmt                 = 18i32;
    StmtDeferStmt                = 19i32;
    StmtDiscardStmt              = 20i32;
    StmtProveStmt                = 21i32;
    StmtAssertStaticStmt         = 22i32;
