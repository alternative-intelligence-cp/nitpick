// AST node kinds.
//
// GENERATED by bootstrap/generator/gen_tables.py from
// meta/specs/AST_REFERENCE.md, categorised by the SECTION each node is
// defined in rather than by its name -- IntLiteral is an expression, and a
// name-suffix guess would file it somewhere else.
//
// Every kind exists, including those for constructs no backend rung can
// lower. The parser never restricts (D-085).
//
// Each enum reserves 0 for "none", so a zeroed node is inert rather than
// silently claiming to be whichever kind happens to be first.

pub enum:DeclKind = {
    DeclNone                     = 0i32;   // no node / not yet set
    DeclModuleDecl               = 1i32;
    DeclImportDecl               = 2i32;
    DeclFunctionDecl             = 3i32;
    DeclStructDecl               = 4i32;
    DeclEnumDecl                 = 5i32;
    DeclTraitDecl                = 6i32;
    DeclImplDecl                 = 7i32;
    DeclTypeDecl                 = 8i32;
    DeclRuleDecl                 = 9i32;
    DeclMacroDecl                = 10i32;
    DeclExternBlock              = 11i32;
    DeclOpaqueDecl               = 12i32;
    DeclGlobalDecl               = 13i32;
    DeclTraitMethod              = 14i32;
    DeclAssocTypeDecl            = 15i32;
    DeclGenericParam             = 16i32;
    DeclParamDecl                = 17i32;
    DeclFieldDecl                = 18i32;
    DeclEnumVariant              = 19i32;
    DeclExternFn                 = 20i32;
    DeclVariadicSpec             = 21i32;
    DeclFailureContract          = 22i32;
};

