// `use` path resolution.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.3.2.
//
// A `use` path resolves in exactly ONE way, decided by its first character
// (`BUILD_REFERENCE.md` §3):
//
//   `use "./util.npk"`, `use "../x/y.npk"`   the IMPORTING FILE's directory
//   `use "./nfs/path.npk"`                     the DEPENDENCY ROOTS
//   `use std.math.*`                         the STANDARD LIBRARY
//
// A dependency named `nfs` declared at `../nfs` roots at `../nfs/src/`, so
// `use "./nfs/path.npk"` is `../nfs/src/path.npk`.
//
// THERE IS NO FALLBACK BETWEEN CLASSES. A `./` path that does not exist is an
// error, not a retry against the roots. The first character decides, and one
// rule with no exception is worth more here than a resolver that "helpfully"
// finds something.
//
// The roots arrive as a LIST rather than being read from `nitpick.toml` here.
// This module owns the rule; where the roots came from is the driver's business,
// and a manifest parser inside the resolver would be two jobs in one file.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./diagnostics.npk".*;
use "./resolve_codes.npk".*;
use "./paths.npk".*;

// A dependency root: the name a `use` path starts with, and where it lives.
pub struct:Root = {
    string:name;    // "nfs"
    string:dir;     // "../nfs/src"  -- already the src/ subdirectory
};

pub struct:RootList = {
    wild Root->:items;
    int32:count;
    int32:cap;
};

pub func:rootlist_init = RootList() {
    int64:n = 8i64;
    wild int8->:mem = alloc(n * #size_of<Root>());
    RootList:r = RootList{ items: mem => wild Root->, count: 0i32, cap: 8i32 };
    pass r;
};

func:rootlist_grow = NIL(RootList->:l) {
    int32:nc = l.cap * 2i32;
    wild int8->:bigger = ralloc(l.items => wild int8->,
                                (nc => int64) * #size_of<Root>());
    l.items = bigger => wild Root->;
    l.cap = nc;
    pass NIL;
};

// A dependency declared at `../nfs` roots at `../nfs/src` (BUILD_REFERENCE §3),
// so the `/src` is appended HERE rather than at every use site.
pub func:rootlist_add = NIL(RootList->:l, string:name, string:dir) {
    if (l.count >= l.cap) {
        drop rootlist_grow(l);
    }
    Root:r = Root{ name: name, dir: relay path_join(dir, "src") };
    l.items[l.count => int64] = r;
    l.count = l.count + 1i32;
    pass NIL;
};

pub func:rootlist_count = int32(RootList->:l) { pass l.count; };
pub func:rootlist_at = Root(RootList->:l, int32:i) {
    if (i < 0i32) { fail 12i32; }
    if (i >= l.count) { fail 12i32; }
    pass l.items[i => int64];
};

// --- the outcome -----------------------------------------------------------------
//
// A resolution either found exactly one file or it did not, and "did not" splits
// into two cases a reader acts on differently: nothing matched, or several did.
pub func:RESOLVED_OK = int32()        { pass 0i32; };
pub func:RESOLVED_NOT_FOUND = int32() { pass 1i32; };
pub func:RESOLVED_AMBIGUOUS = int32() { pass 2i32; };

pub struct:Resolution = {
    int32:status;
    string:path;      // the file, when status is OK
    string:first;     // the two candidates, when AMBIGUOUS
    string:second;
};

// --- resolving ---------------------------------------------------------------------

pub func:resolve_use = Resolution(string:from, string:target, RootList->:roots,
                                  string:stdlib) {
    if (raw path_is_relative(target)) {
        pass (relay resolve_relative(from, target));
    }
    if (raw path_is_absolute(target)) {
        // An absolute path names one file and consults no root at all.
        pass (relay resolve_single(relay path_normalise(target)));
    }
    pass (relay resolve_in_roots(target, roots, stdlib));
};

func:resolve_single = Resolution(string:candidate) {
    Resolution:r = Resolution{ status: raw RESOLVED_NOT_FOUND(),
                               path: candidate, first: "", second: "" };
    cstring:c = relay to_cstring(candidate);
    if (path_exists(c)) {
        r.status = raw RESOLVED_OK();
    }
    pass r;
};

func:resolve_relative = Resolution(string:from, string:target) {
    pass (relay resolve_single(relay path_relative_to(from, target)));
};

// EVERY root is probed before deciding.
//
// A resolver that returned on the first hit could not report the second, and
// ambiguity would then be settled by whichever root the manifest happened to
// declare first. Adding a dependency could silently change which file an
// existing `use` resolves to, in a module nobody edited — so the build fails and
// names both instead (BUILD_REFERENCE §3).
func:resolve_in_roots = Resolution(string:target, RootList->:roots, string:stdlib) {
    Resolution:r = Resolution{ status: raw RESOLVED_NOT_FOUND(),
                               path: target, first: "", second: "" };
    int32:found = 0i32;

    int32:i = 0i32;
    while (i < (raw rootlist_count(roots))) {
        Root:root = relay rootlist_at(roots, i);
        string:candidate = relay path_normalise(relay path_join(root.dir, target));
        cstring:c = relay to_cstring(candidate);
        if (path_exists(c)) {
            if (found == 0i32) {
                r.path = candidate;
                r.first = candidate;
            } else {
                if (found == 1i32) {
                    r.second = candidate;
                }
            }
            found = found + 1i32;
        }
        i = i + 1i32;
    }

    // The standard library is a root like any other, probed last but with no
    // precedence: a name it supplies and a dependency also supplies is still
    // ambiguous, because silently preferring one is the behaviour this rule
    // exists to prevent.
    if (stdlib.len != 0i64) {
        string:scand = relay path_normalise(relay path_join(stdlib, target));
        cstring:sc = relay to_cstring(scand);
        if (path_exists(sc)) {
            if (found == 0i32) {
                r.path = scand;
                r.first = scand;
            } else {
                if (found == 1i32) {
                    r.second = scand;
                }
            }
            found = found + 1i32;
        }
    }

    if (found == 1i32) {
        r.status = raw RESOLVED_OK();
        pass r;
    }
    if (found > 1i32) {
        r.status = raw RESOLVED_AMBIGUOUS();
        pass r;
    }
    pass r;
};

// --- reporting ------------------------------------------------------------------------
//
// The diagnostic NAMES BOTH candidates. "Ambiguous path" on its own tells a
// reader they have a problem and not which two files to choose between.
pub func:report_resolution = NIL(DiagList->:diags, Resolution:r,
                                 string:target, Span:span) {
    if (r.status == (raw RESOLVED_OK())) {
        pass NIL;
    }
    if (r.status == (raw RESOLVED_AMBIGUOUS())) {
        string:m1 = relay string_concat("`", target);
        string:m2 = relay string_concat(m1, "` is supplied by more than one root: ");
        string:m3 = relay string_concat(m2, r.first);
        string:m4 = relay string_concat(m3, " and ");
        string:m5 = relay string_concat(m4, r.second);
        drop diaglist_push(diags,
            raw diag_error(raw RESOLVE_AMBIGUOUS(), m5, span));
        pass NIL;
    }
    string:n1 = relay string_concat("cannot find `", target);
    string:n2 = relay string_concat(n1, "`");
    drop diaglist_push(diags,
        raw diag_error(raw RESOLVE_NO_SUCH_FILE(), n2, span));
    pass NIL;
};
