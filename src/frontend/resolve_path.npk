// `use` path resolution.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.3.2.
//
// A `use` path resolves in exactly ONE way, decided by its first character
// (`BUILD_REFERENCE.md` §3):
//
//   `use "./util.npk"`, `use "../x/y.npk"`   the IMPORTING FILE's directory
//   `use "./nfs/path.npk"`                     the DEPENDENCY ROOTS
//   `use std.math.*`                         the STANDARD LIBRARY
//
// A dependency named `nfs` declared at `../nfs` roots at `../nfs/src/`, so
// `use "./nfs/path.npk"` is `../nfs/src/path.npk`.
//
// THERE IS NO FALLBACK BETWEEN CLASSES. A `./` path that does not exist is an
// error, not a retry against the roots. The first character decides, and one
// rule with no exception is worth more here than a resolver that "helpfully"
// finds something.
//
// The roots arrive as a LIST rather than being read from `nitpick.toml` here.
// This module owns the rule; where the roots came from is the driver's business,
// and a manifest parser inside the resolver would be two jobs in one file.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
mod:resolve_path;
error:BoundsIndex;

use "./source_location.npk".*;
use "./intern.npk".*;
use "./diagnostics.npk".*;
use "./resolve_codes.npk".*;
use "./paths.npk".*;

// A dependency root: the name a `use` path starts with, and where it lives.
pub struct:Root = {
    string:name;    // "nfs"
    string:dir;     // "../nfs/src"  -- already the src/ subdirectory
};

// THE ROOT LIST (1.4.7): storage is `List<Root>`, so the doubling and the
// `=>!` that used to live here are the generic's, checked once. What stays is
// what was always this file's own — where a root's `/src` is appended, and the
// deep view a caller gets back.
pub struct:RootList = {
    List<Root>:v;
};

pub func:rootlist_init = RootList() never fails {
    pass RootList{ v: raw list_init::<Root>(8i64) };
};

// A dependency declared at `../nfs` roots at `../nfs/src` (BUILD_REFERENCE §3),
// so the `/src` is appended HERE rather than at every use site.
pub func:rootlist_add = NIL(RootList->:l, move string:name, move string:dir) never fails {
    Root:r = Root{ name: move(name), dir: raw path_join(dir, "src") };
    drop list_push(@l.v, move(r));
    pass NIL;
};

pub func:rootlist_count = int64(RootList->:l) never fails { pass l.v.count; };
pub func:rootlist_at = Root(RootList->:l, int64:i) never fails {
    if (i < 0i64) { !!! BoundsIndex; }
    if (i >= l.v.count) { !!! BoundsIndex; }
    // A DEEP-VIEWED COPY (D-183): the container keeps ownership, and every
    // string field in the returned value is a cap-0 view — so a caller's
    // flagged local dropping it frees nothing. By-value ergonomics for the
    // 40-odd call sites, at the cost of rebuilding one small struct.
    Root:r = Root{
        name: string_from_bytes(l.v.items[i].name.ptr,
                                    l.v.items[i].name.len),
        dir: string_from_bytes(l.v.items[i].dir.ptr,
                                   l.v.items[i].dir.len) };
    pass r;
};

// --- the outcome -----------------------------------------------------------------
//
// A resolution either found exactly one file or it did not, and "did not" splits
// into two cases a reader acts on differently: nothing matched, or several did.
pub func:RESOLVED_OK = int32() never fails        { pass 0i32; };
pub func:RESOLVED_NOT_FOUND = int32() never fails { pass 1i32; };
pub func:RESOLVED_AMBIGUOUS = int32() never fails { pass 2i32; };

pub struct:Resolution = {
    int32:status;
    // The file when OK; the FIRST candidate when AMBIGUOUS — one value, and it
    // was two fields until D-183's move-only sweep asked who owned the copy.
    // `first` always equalled `path` in the ambiguous case and was read once,
    // in the report; a field that duplicates another is two owners of one
    // body the moment drops exist.
    string:path;
    string:second;    // the second candidate, when AMBIGUOUS
};

// --- resolving ---------------------------------------------------------------------

pub func:resolve_use = Resolution(string:from, string:target, RootList->:roots,
                                  string:stdlib) never fails {
    if (raw path_is_relative(target)) {
        pass (raw resolve_relative(from, target));
    }
    if (raw path_is_absolute(target)) {
        // An absolute path names one file and consults no root at all.
        pass (raw resolve_single(raw path_normalise(target)));
    }
    pass (raw resolve_in_roots(target, roots, stdlib));
};

func:resolve_single = Resolution(move string:candidate) never fails {
    // A candidate with an interior NUL names no file (D-049): not-found,
    // never an error — the NUL can only come from a user-written import.
    // Probed BEFORE the struct is built, so the candidate is loaned to the
    // probe and then MOVED into the result — the literal used to store it
    // while `to_cstring` still needed it, which is a copy and two owners.
    int32:st = raw RESOLVED_NOT_FOUND();
    Result<cstring>:c = to_cstring(candidate);
    if (!c.is_error) {
        if (path_exists(c.value)) {
            st = raw RESOLVED_OK();
        }
    }
    Resolution:r = Resolution{ status: st, path: move(candidate), second: "" };
    pass r;
};


func:resolve_relative = Resolution(string:from, string:target) never fails {
    pass (raw resolve_single(raw path_relative_to(from, target)));
};

// EVERY root is probed before deciding.
//
// A resolver that returned on the first hit could not report the second, and
// ambiguity would then be settled by whichever root the manifest happened to
// declare first. Adding a dependency could silently change which file an
// existing `use` resolves to, in a module nobody edited — so the build fails and
// names both instead (BUILD_REFERENCE §3).
func:resolve_in_roots = Resolution(string:target, RootList->:roots, string:stdlib) never fails {
    // `path` starts empty rather than holding a copy of `target`: the loop
    // still needs `target` to build every candidate, and the not-found report
    // names the target it was given rather than reading it back out of here.
    Resolution:r = Resolution{ status: raw RESOLVED_NOT_FOUND(),
                               path: "", second: "" };
    int32:found = 0i32;

    int64:i = 0i64;
    while (i < (raw rootlist_count(roots))) {
        Root:root = raw rootlist_at(roots, i);
        string:candidate = raw path_normalise(raw path_join(root.dir, target));
        Result<cstring>:c = to_cstring(candidate);
        bool:c_there = false;
        if (!c.is_error) { c_there = path_exists(c.value); }
        if (c_there) {
            if (found == 0i32) {
                r.path = move(candidate);
            } else {
                if (found == 1i32) {
                    r.second = move(candidate);
                }
            }
            found = found + 1i32;
        }
        i = i + 1i64;
    }

    // The standard library is a root like any other, probed last but with no
    // precedence: a name it supplies and a dependency also supplies is still
    // ambiguous, because silently preferring one is the behaviour this rule
    // exists to prevent.
    if (stdlib.len != 0i64) {
        string:scand = raw path_normalise(raw path_join(stdlib, target));
        Result<cstring>:sc = to_cstring(scand);
        bool:sc_there = false;
        if (!sc.is_error) { sc_there = path_exists(sc.value); }
        if (sc_there) {
            if (found == 0i32) {
                r.path = move(scand);
            } else {
                if (found == 1i32) {
                    r.second = move(scand);
                }
            }
            found = found + 1i32;
        }
    }

    if (found == 1i32) {
        r.status = raw RESOLVED_OK();
        pass r;
    }
    if (found > 1i32) {
        r.status = raw RESOLVED_AMBIGUOUS();
        pass r;
    }
    pass r;
};

// --- reporting ------------------------------------------------------------------------
//
// The diagnostic NAMES BOTH candidates. "Ambiguous path" on its own tells a
// reader they have a problem and not which two files to choose between.
pub func:report_resolution = NIL(DiagList->:diags, Resolution:r,
                                 string:target, Span:span) never fails {
    if (r.status == (raw RESOLVED_OK())) {
        pass NIL;
    }
    if (r.status == (raw RESOLVED_AMBIGUOUS())) {
        string:m1 = string_concat("`", target);
        string:m2 = string_concat(m1, "` is supplied by more than one root: ");
        string:m3 = string_concat(m2, r.path);
        string:m4 = string_concat(m3, " and ");
        string:m5 = string_concat(m4, r.second);
        drop diaglist_push(diags,
            raw diag_error(raw RESOLVE_AMBIGUOUS(), move(m5), span));
        pass NIL;
    }
    string:n1 = string_concat("cannot find `", target);
    string:n2 = string_concat(n1, "`");
    drop diaglist_push(diags,
        raw diag_error(raw RESOLVE_NO_SUCH_FILE(), move(n2), span));
    pass NIL;
};
