ToString   = { func:to_string = string(int8:self) never fails   { pass (raw int_to_string(self => int64)); }; };\nimpl:int16:ToString  = { func:to_string = string(int16:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:int32:ToString  = { func:to_string = string(int32:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:int64:ToString  = { func:to_string = string(int64:self) never fails  { pass (raw int_to_string(self)); }; };\nimpl:uint8:ToString  = { func:to_string = string(uint8:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:uint16:ToString = { func:to_string = string(uint16:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:uint32:ToString = { func:to_string = string(uint32:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:bool:ToString   = { func:to_string = string(bool:self) never fails   { if (self) { pass \"true\"; } pass \"false\"; }; };\n\nimpl:uint64:ToString = { func:to_string = string(uint64:self) never fails { pass (raw uint_to_decimal(self)); }; };\n\n// THE `tbb` WIDTHS RENDER `ERR` OR THE NUMBER (D-008, D-168). ERR is the taint,\n// shown as itself; everything else is the value, read through the checked cast\n// the `is_err` guard makes safe.\nimpl:tbb8:ToString  = { func:to_string = string(tbb8:self) never fails  { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\nimpl:tbb16:ToString = { func:to_string = string(tbb16:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\nimpl:tbb32:ToString = { func:to_string = string(tbb32:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\nimpl:tbb64:ToString = { func:to_string = string(tbb64:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\n\n// THE KERNEL IDENTIFIERS RENDER THEIR NUMBER (D-042, D-168): a handle's value is\n// readable even though a handle is not forgeable.\nimpl:fd:ToString  = { func:to_string = string(fd:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:pid:ToString = { func:to_string = string(pid:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:tid:ToString = { func:to_string = string(tid:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:uid:ToString = { func:to_string = string(uid:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:gid:ToString = { func:to_string = string(gid:self) never fails { pass (raw int_to_string(self => int64)); }; };\n\n// UNSIGNED DECIMAL (D-168), for `uint64`, whose high half the floor's signed\n// `int_to_string` renders as a negative. Unsigned division here is the language's\n// own — `uint64 / 10` and `% 10` are unsigned because the type is — so the digits\n// come out right whatever the high bit. The lower unsigned widths fit in `int64`\n// and go through `int_to_string` losslessly; only `uint64` needs this.\npub func:digit_char = string(uint64:d) never fails {\n    if (d == 0u64) { pass \"0\"; }\n    if (d == 1u64) { pass \"1\"; }\n    if (d == 2u64) { pass \"2\"; }\n    if (d == 3u64) { pass \"3\"; }\n    if (d == 4u64) { pass \"4\"; }\n    if (d == 5u64) { pass \"5\"; }\n    if (d == 6u64) { pass \"6\"; }\n    if (d == 7u64) { pass \"7\"; }\n    if (d == 8u64) { pass \"8\"; }\n    pass \"9\";\n};\n\npub func:uint_to_decimal = string(uint64:v) never fails {\n    if (v == 0u64) { pass \"0\"; }\n    string:acc = \"\";\n    uint64:n = v;\n    while (n > 0u64) {\n        string:d = raw digit_char(n % 10u64);\n        acc = raw string_concat(d, acc);\n        n = n / 10u64;\n    }\n    pass acc;\n};\n\n// FNV-1a, THE DERIVED HASH (D-123). The combiner is specified so a derived hash\n// is the same across builds -- a verified compiler cannot have one that drifts.\n// The offset basis (0xcbf29ce484222325) is past the 64-bit literal envelope, so it\n// is built from its two words; the prime fits.\npub func:fnv_offset = uint64() never fails { pass ((3421887204u64 << 32u64) | 2216829733u64); };\npub func:fnv_mix = uint64(uint64:h, uint64:v) never fails { pass ((h ^ v) * 1099511628211u64); };\n\n// A SCALAR HASHES ITS VALUE (D-123); a derived struct hash combines its fields\n// the same way, so the whole is FNV-1a over the parts.\nimpl:int8:Hash = { func:hash = uint64(int8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int16:Hash = { func:hash = uint64(int16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int32:Hash = { func:hash = uint64(int32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int64:Hash = { func:hash = uint64(int64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:uint8:Hash = { func:hash = uint64(uint8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint16:Hash = { func:hash = uint64(uint16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint32:Hash = { func:hash = uint64(uint32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint64:Hash = { func:hash = uint64(uint64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self)); }; };\nimpl:bool:Hash = { func:hash = uint64(bool:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:char8:Hash = { func:hash = uint64(char8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:char16:Hash = { func:hash = uint64(char16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:char32:Hash = { func:hash = uint64(char32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:fd:Hash = { func:hash = uint64(fd:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:pid:Hash = { func:hash = uint64(pid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:tid:Hash = { func:hash = uint64(tid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:uid:Hash = { func:hash = uint64(uid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:gid:Hash = { func:hash = uint64(gid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\n\n// A tbb HASHES ERR AS A FIXED WORD, ITS VALUE OTHERWISE (D-008): the checked read\n// cannot touch ERR, so the guard comes first.\nimpl:tbb8:Hash = { func:hash = uint64(tbb8:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:tbb16:Hash = { func:hash = uint64(tbb16:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:tbb32:Hash = { func:hash = uint64(tbb32:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:tbb64:Hash = { func:hash = uint64(tbb64:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\n\n// A string HASHES ITS BYTES (D-123) -- FNV-1a is over bytes, and self.ptr[i] walks\n// them.\nimpl:string:Hash = { func:hash = uint64(string:self) never fails {\n    uint64:h = raw fnv_offset();\n    int64:i = 0i64;\n    while (i < self.len) {\n        h = raw fnv_mix(h, self.ptr[i] => uint64);\n        i = i + 1i64;\n    }\n    pass h;\n}; };\n\n// --- the deadline substrate (D-176, 1.1.3) -----------------------------------\n//\n// `Duration` is a span of time as int64 NANOSECONDS — one word, one compare,\n// ±292 years. Deadline parameters take one, RELATIVE, named `within`; the\n// executor converts to an absolute monotonic timepoint once, at suspension\n// entry. The constructors' multiplications ride ordinary int64 arithmetic,\n// whose overflow traps (D-142) — a span past ±292 years is a controlled stop.\npub struct:Duration = { int64:ns; };\n\npub func:duration_ns = Duration(int64:n) never fails {\n    pass Duration{ ns: n };\n};\npub func:duration_ms = Duration(int64:ms) never fails {\n    pass Duration{ ns: ms * 1000000i64 };\n};\npub func:duration_secs = Duration(int64:s) never fails {\n    pass Duration{ ns: s * 1000000000i64 };\n};\n\n// --- the system error family (D-179) -----------------------------------------------\n//\n// D-142's table as DECLARATIONS — the same fixed codes npkrt.ll hardcodes\n// (its values are the stability constraint), now named. The explicit-code\n// form is legal here and nowhere else: the SYSTEM domain is exactly what the\n// prelude declares, its sign an encoding detail the compiler owns (stored\n// negated). User programs name these in `failsafe` picks; they cannot\n// declare into the family, so identity can never be forged.\npub error:DivByZero = 4097i32;         // division or remainder by zero (the 0.7 guard)\npub error:DivOverflow = 4098i32;       // MIN / -1 — the one signed division that overflows\npub error:OutOfBounds = 4099i32;       // an index outside its array, slice or range\npub error:TbbErr = 4100i32;            // ERR at a bare comparison / checked cast out of tbb (D-008 s5, D-144)\npub error:BadStep = 4101i32;           // a counted loop's step was not positive at runtime (D-142)\npub error:Unreachable = 4102i32;       // #unreachable() reached, and the runtime's integrity defects (D-061, D-153)\npub error:HeapOom = 4103i32;           // mmap failure — the allocation-free trap path (D-153)\npub error:HeapBadRequest = 4104i32;    // negative size; count*size overflow (D-153)\npub error:WildLeak = 4105i32;          // a `wild` allocation outlived exit 0 (D-151)\npub error:StaleHandle = 4106i32;       // an arena handle outlived its slot's generation (D-152)\npub error:DeadlineExceeded = 4107i32;  // time ran out (D-176): the Result error AND the join's trap\npub error:ChannelClosed = 4108i32;     // a `send` to, or a drained `recv` from, a closed channel (D-072/D-182)\npub error:IoEof = 4096i32;             // end of input (the io floor's marker, distinct from every errno)\n\n// --- waiting (D-071, 1.1.8) --------------------------------------------------\n//\n// THE ONE WAITING PRIMITIVE, and everything that blocks is built from it.\n// `await sleep(within)` suspends the TASK: the executor takes the park\n// request and sleeps the thread only when it has nothing else runnable, so\n// a waiting task can never stall a sibling (D-071's whole point). The\n// deadline is ABSOLUTE and monotonic by the time the kernel sees it — the\n// span is converted once, here, at suspension entry (D-176 rule 2).\npub async func:sleep = NIL(Duration:within) {\n    drop suspend_until((raw mono_now()) + within.ns);\n    pass NIL;\n};\n"; };
