// The prelude's source, as the compiler carries it.
//
// GENERATED by bootstrap/generator/gen_tables.py from
// src/prelude/prelude.npk. Edit that file, not this one.
//
// One line with escapes, because the real lexer refuses a newline inside a
// plain string literal and the seed has no block-string form -- so this is the
// one spelling both accept. The text is decoded before it is lexed, so spans
// inside the prelude point at real lines.

pub func:PRELUDE_SOURCE = string() never fails { pass "// The prelude — what the compiler itself declares.\n//\n// NOT COMPILED AS PART OF THE FRONTEND. Nothing `use`s this file. It is read by\n// `bootstrap/generator/gen_tables.py`, which emits it into\n// `src/frontend/prelude_source.npk` as a string constant, and the compiler then\n// puts that text through the same lexer, the same parser and the same collector as\n// any other module.\n//\n// SOURCE RATHER THAN SYNTHESIS, and generated rather than hand-escaped, for the two\n// reasons the token tables give: a declaration built in code is one a person cannot\n// read, and a constant written twice is one that can differ in one of the places.\n//\n// COLLECTED INTO THE ROOT SCOPE, so these names are in scope everywhere with no\n// import. Every module's scope has scope 0 as its parent, so the place already\n// existed.\n\nmod:prelude;\n\n// HOW TWO VALUES COMPARE, AS A TYPE RATHER THAN A NUMBER. The prototype's\n// `partial_cmp` returned an `int32` meaning less, equal or greater by sign — three\n// meanings in one number, which is the shape D-036 rejects for `bool` and `char`.\n// An ordering is not an integer either.\npub enum:Ordering = {\n    Less;\n    Equal;\n    Greater;\n};\n\n// EQUALITY. Derived field by field, in declaration order.\npub trait:Eq = {\n    func:eq = bool(Self:self, Self:other);\n};\n\n// A TOTAL ORDER. Every two values compare, which is what makes the result an\n// `Ordering` and not an `Ordering?`.\n//\n// The prototype generated `less_than` returning `bool`, which carries strictly less\n// information than a three-way comparison and made `Ord` WEAKER than `PartialOrd` —\n// backwards, since `Ord` is the stronger promise.\npub trait:Ord = {\n    func:cmp = Ordering(Self:self, Self:other);\n};\n\n// AN ORDER THAT MAY HAVE NO ANSWER. Not a second spelling of `Ord` but a different\n// promise, which is why it survives where `Display` did not: a `flt64` is IEEE 754\n// with `nan` and no trap (OP_REFERENCE), so two of them genuinely may not compare,\n// and a total `cmp` over one would have to lie.\npub trait:PartialOrd = {\n    func:partial_cmp = Ordering?(Self:self, Self:other);\n};\n\n// A VALUE OF THE SAME TYPE, MADE FROM THIS ONE.\npub trait:Clone = {\n    func:clone = Self(Self:self);\n};\n\n// A HASH FOR A MAP, AND NOT CRYPTOGRAPHY. The derived combiner is FNV-1a and is\n// specified rather than left open (D-123), because a derived hash that varies\n// between builds is not something a verified compiler can have. Real cryptography\n// is `ncrypto`, a separately audited artifact.\npub trait:Hash = {\n    func:hash = uint64(Self:self);\n};\n\n// THE VALUE AS A STRING, which is what `&{ }` interpolation asks for.\npub trait:ToString = {\n    func:to_string = string(Self:self);\n};\n\n// THE SAME, IN A DIAGNOSTIC FORM naming the type and its fields. A separate trait\n// from `ToString` because the two are read by different audiences: one is what a\n// program shows a person, the other is what a person reads while debugging.\npub trait:Debug = {\n    func:debug = string(Self:self);\n};\n\n// WHAT A `for` LOOP DRIVES (D-166). `next` advances and yields the element, or\n// `NIL` when the iteration is over — `Item?` is why this was undecidable before\n// `Optional` lowered (1.0.7). The receiver is `Self->`: `next` mutates the\n// iterator's position, so it takes it by pointer, the one trait method that does.\npub trait:Iterator = {\n    assoc:Item;\n    func:next = Item?(Self->:self);\n};\n\n// `to_string` FOR THE BUILTIN SCALARS (D-168, 1.0.9d), so `&{ x }` renders\n// without a program writing the impl. The integers widen losslessly into `i64`\n// and go through the floor's `int_to_string`; `bool` is its two words. The\n// remaining scalars — the characters (UTF-8), the `tbb` widths (ERR), the kernel\n// identifiers, `uint64` (its high bit) and the floats (a correct float->decimal\n// in the floor) — arrive with their own careful conversions.\nimpl:int8:ToString   = { func:to_string = string(int8:self) never fails   { pass (raw int_to_string(self => int64)); }; };\nimpl:int16:ToString  = { func:to_string = string(int16:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:int32:ToString  = { func:to_string = string(int32:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:int64:ToString  = { func:to_string = string(int64:self) never fails  { pass (raw int_to_string(self)); }; };\nimpl:uint8:ToString  = { func:to_string = string(uint8:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:uint16:ToString = { func:to_string = string(uint16:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:uint32:ToString = { func:to_string = string(uint32:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:bool:ToString   = { func:to_string = string(bool:self) never fails   { if (self) { pass \"true\"; } pass \"false\"; }; };\n\nimpl:uint64:ToString = { func:to_string = string(uint64:self) never fails { pass (raw uint_to_decimal(self)); }; };\n\n// THE `tbb` WIDTHS RENDER `ERR` OR THE NUMBER (D-008, D-168). ERR is the taint,\n// shown as itself; everything else is the value, read through the checked cast\n// the `is_err` guard makes safe.\nimpl:tbb8:ToString  = { func:to_string = string(tbb8:self) never fails  { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\nimpl:tbb16:ToString = { func:to_string = string(tbb16:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\nimpl:tbb32:ToString = { func:to_string = string(tbb32:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\nimpl:tbb64:ToString = { func:to_string = string(tbb64:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (raw int_to_string(self => int64)); }; };\n\n// THE KERNEL IDENTIFIERS RENDER THEIR NUMBER (D-042, D-168): a handle's value is\n// readable even though a handle is not forgeable.\nimpl:fd:ToString  = { func:to_string = string(fd:self) never fails  { pass (raw int_to_string(self => int64)); }; };\nimpl:pid:ToString = { func:to_string = string(pid:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:tid:ToString = { func:to_string = string(tid:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:uid:ToString = { func:to_string = string(uid:self) never fails { pass (raw int_to_string(self => int64)); }; };\nimpl:gid:ToString = { func:to_string = string(gid:self) never fails { pass (raw int_to_string(self => int64)); }; };\n\n// UNSIGNED DECIMAL (D-168), for `uint64`, whose high half the floor's signed\n// `int_to_string` renders as a negative. Unsigned division here is the language's\n// own — `uint64 / 10` and `% 10` are unsigned because the type is — so the digits\n// come out right whatever the high bit. The lower unsigned widths fit in `int64`\n// and go through `int_to_string` losslessly; only `uint64` needs this.\npub func:digit_char = string(uint64:d) never fails {\n    if (d == 0u64) { pass \"0\"; }\n    if (d == 1u64) { pass \"1\"; }\n    if (d == 2u64) { pass \"2\"; }\n    if (d == 3u64) { pass \"3\"; }\n    if (d == 4u64) { pass \"4\"; }\n    if (d == 5u64) { pass \"5\"; }\n    if (d == 6u64) { pass \"6\"; }\n    if (d == 7u64) { pass \"7\"; }\n    if (d == 8u64) { pass \"8\"; }\n    pass \"9\";\n};\n\npub func:uint_to_decimal = string(uint64:v) never fails {\n    if (v == 0u64) { pass \"0\"; }\n    string:acc = \"\";\n    uint64:n = v;\n    while (n > 0u64) {\n        string:d = raw digit_char(n % 10u64);\n        acc = raw string_concat(d, acc);\n        n = n / 10u64;\n    }\n    pass acc;\n};\n\n// FNV-1a, THE DERIVED HASH (D-123). The combiner is specified so a derived hash\n// is the same across builds -- a verified compiler cannot have one that drifts.\n// The offset basis (0xcbf29ce484222325) is past the 64-bit literal envelope, so it\n// is built from its two words; the prime fits.\npub func:fnv_offset = uint64() never fails { pass ((3421887204u64 << 32u64) | 2216829733u64); };\npub func:fnv_mix = uint64(uint64:h, uint64:v) never fails { pass ((h ^ v) * 1099511628211u64); };\n\n// A SCALAR HASHES ITS VALUE (D-123); a derived struct hash combines its fields\n// the same way, so the whole is FNV-1a over the parts.\nimpl:int8:Hash = { func:hash = uint64(int8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int16:Hash = { func:hash = uint64(int16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int32:Hash = { func:hash = uint64(int32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int64:Hash = { func:hash = uint64(int64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:uint8:Hash = { func:hash = uint64(uint8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint16:Hash = { func:hash = uint64(uint16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint32:Hash = { func:hash = uint64(uint32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint64:Hash = { func:hash = uint64(uint64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self)); }; };\nimpl:bool:Hash = { func:hash = uint64(bool:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:char8:Hash = { func:hash = uint64(char8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:char16:Hash = { func:hash = uint64(char16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:char32:Hash = { func:hash = uint64(char32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:fd:Hash = { func:hash = uint64(fd:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:pid:Hash = { func:hash = uint64(pid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:tid:Hash = { func:hash = uint64(tid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:uid:Hash = { func:hash = uint64(uid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:gid:Hash = { func:hash = uint64(gid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\n\n// A tbb HASHES ERR AS A FIXED WORD, ITS VALUE OTHERWISE (D-008): the checked read\n// cannot touch ERR, so the guard comes first.\nimpl:tbb8:Hash = { func:hash = uint64(tbb8:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:tbb16:Hash = { func:hash = uint64(tbb16:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:tbb32:Hash = { func:hash = uint64(tbb32:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:tbb64:Hash = { func:hash = uint64(tbb64:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\n\n// A string CLONES BY ALLOCATING A FRESH BODY (D-183). This is the language's\n// one spelling for \"I genuinely want a second owner\": explicit at the call\n// site (`x.clone()`), greppable, and it allocates — which is exactly why it is\n// not what assignment does. Concatenation with the empty string IS the fresh\n// copy, and the result carries `cap = n`, so the clone owns its body and drops\n// it independently of the original.\nimpl:string:Clone = { func:clone = string(string:self) {\n    pass (relay string_concat(self, \"\"));\n}; };\n\n// A string HASHES ITS BYTES (D-123) -- FNV-1a is over bytes, and self.ptr[i] walks\n// them.\nimpl:string:Hash = { func:hash = uint64(string:self) never fails {\n    uint64:h = raw fnv_offset();\n    int64:i = 0i64;\n    while (i < self.len) {\n        h = raw fnv_mix(h, self.ptr[i] => uint64);\n        i = i + 1i64;\n    }\n    pass h;\n}; };\n\n// --- the deadline substrate (D-176, 1.1.3) -----------------------------------\n//\n// `Duration` is a span of time as int64 NANOSECONDS — one word, one compare,\n// ±292 years. Deadline parameters take one, RELATIVE, named `within`; the\n// executor converts to an absolute monotonic timepoint once, at suspension\n// entry. The constructors' multiplications ride ordinary int64 arithmetic,\n// whose overflow traps (D-142) — a span past ±292 years is a controlled stop.\npub struct:Duration = { int64:ns; };\n\npub func:duration_ns = Duration(int64:n) never fails {\n    pass Duration{ ns: n };\n};\npub func:duration_ms = Duration(int64:ms) never fails {\n    pass Duration{ ns: ms * 1000000i64 };\n};\npub func:duration_secs = Duration(int64:s) never fails {\n    pass Duration{ ns: s * 1000000000i64 };\n};\n\n// --- the system error family (D-179) -----------------------------------------------\n//\n// D-142's table as DECLARATIONS — the same fixed codes npkrt.ll hardcodes\n// (its values are the stability constraint), now named. The explicit-code\n// form is legal here and nowhere else: the SYSTEM domain is exactly what the\n// prelude declares, its sign an encoding detail the compiler owns (stored\n// negated). User programs name these in `failsafe` picks; they cannot\n// declare into the family, so identity can never be forged.\npub error:DivByZero = 4097i32;         // division or remainder by zero (the 0.7 guard)\npub error:DivOverflow = 4098i32;       // MIN / -1 — the one signed division that overflows\npub error:OutOfBounds = 4099i32;       // an index outside its array, slice or range\npub error:TbbErr = 4100i32;            // ERR at a bare comparison / checked cast out of tbb (D-008 s5, D-144)\npub error:BadStep = 4101i32;           // a counted loop's step was not positive at runtime (D-142)\npub error:Unreachable = 4102i32;       // #unreachable() reached, and the runtime's integrity defects (D-061, D-153)\npub error:HeapOom = 4103i32;           // mmap failure — the allocation-free trap path (D-153)\npub error:HeapBadRequest = 4104i32;    // negative size; count*size overflow (D-153)\npub error:WildLeak = 4105i32;          // a `wild` allocation outlived exit 0 (D-151)\npub error:StaleHandle = 4106i32;       // an arena handle outlived its slot's generation (D-152)\npub error:DeadlineExceeded = 4107i32;  // time ran out (D-176): the Result error AND the join's trap\npub error:ChannelClosed = 4108i32;     // a `send` to, or a drained `recv` from, a closed channel (D-072/D-182)\npub error:IoEof = 4096i32;             // end of input (the io floor's marker, distinct from every errno)\n\n// --- waiting (D-071, 1.1.8) --------------------------------------------------\n//\n// THE ONE WAITING PRIMITIVE, and everything that blocks is built from it.\n// `await sleep(within)` suspends the TASK: the executor takes the park\n// request and sleeps the thread only when it has nothing else runnable, so\n// a waiting task can never stall a sibling (D-071's whole point). The\n// deadline is ABSOLUTE and monotonic by the time the kernel sees it — the\n// span is converted once, here, at suspension entry (D-176 rule 2).\npub async func:sleep = NIL(Duration:within) {\n    drop suspend_until((raw mono_now()) + within.ns);\n    pass NIL;\n};\n\n// `await io_ready(fd, events, within)` (B-3a, 1.1.12a): suspend until the\n// descriptor is ready for `events` (EPOLLIN 1, EPOLLOUT 4) or the deadline\n// passes — the reactor's one wait. One registration, one park, one return:\n// a resume past the deadline is the deadline's, and reports it; a resume\n// before it means READINESS WAS SIGNALLED — retry the syscall, and if it\n// still would block (stolen by a sibling, a spurious wake), call this\n// again. The stream types are loops around exactly that.\npub async func:io_ready = NIL(int32:iofd, int32:events, Duration:within) {\n    int64:io_abs = (raw mono_now()) + within.ns;\n    // The registration lives exactly as long as the wait: a one-shot left\n    // armed past this frame would fire into freed memory. Every exit --\n    // readiness, deadline, wind-up -- runs this.\n    defer { drop io_unwatch(iofd); }\n    drop suspend_io(iofd, events, io_abs);\n    if ((raw mono_now()) >= io_abs) { fail DeadlineExceeded; }\n    pass NIL;\n};\n\n// --- the streams (D-185, 1.1.12b; IO_REFERENCE) -------------------------------\n//\n// TWO ERRNOS, NAMED, because every stream loop must tell them from real\n// failures: the kernel's own codes ride the error word verbatim (negative,\n// disjoint from the 4096+ system family), and these are the two that mean\n// \"again\", not \"broken\". Naming more of the errno space is a decision for\n// the code that needs it.\npub error:WouldBlock = 11i32;      // EAGAIN — not ready; wait for readiness and retry\npub error:Interrupted = 4i32;      // EINTR — a signal cut the call; retry immediately\n\n// A PATH IS PARSED, NOT PASSED AROUND AS A STRING (D-051/D-054): absolute,\n// lexically normalized, no interior NUL. Normalization here is LEXICAL —\n// D-054's warning stands: it does not survive symlinks, and containment\n// wants openat + O_NOFOLLOW, not a string check.\npub error:BadPath;\npub struct:Path = { string:text; };\n\npub func:path_parse = Path(string:s) {\n    if (s.len == 0i64)        { fail BadPath; }\n    if (s.ptr[0i64] != 47u8)  { fail BadPath; }   // absolute, or it is not a Path\n    string:out = \"\";\n    int64:depth = 0i64;\n    int64:i = 1i64;\n    int64:seg = 1i64;\n    while (i <= s.len) {\n        bool:at_end = (i == s.len);\n        uint8:c = 0u8;\n        if (!at_end) {\n            c = s.ptr[i];\n            if (c == 0u8) { fail BadPath; }       // interior NUL: the poison byte\n        }\n        if (at_end || (c == 47u8)) {\n            int64:sl = i - seg;\n            if (sl > 0i64) {\n                string:sgt = relay string_slice(s, seg, i);\n                bool:dot = string_equals(sgt, \".\");\n                if (!dot) {\n                    if (string_equals(sgt, \"..\")) {\n                        // \"..\" above the root is not a path, it is an escape.\n                        if (depth == 0i64) { fail BadPath; }\n                        int64:j = out.len - 1i64;\n                        while (j >= 0i64) {\n                            if (out.ptr[j] == 47u8) { break; }\n                            j = j - 1i64;\n                        }\n                        // string_slice returns a VIEW (cap 0) into the\n                        // body this assignment is about to free — concat\n                        // with \"\" copies it into a body of its own first.\n                        // (The silent view-over-owner hazard is recorded in\n                        // D-185 / OPEN_DECISIONS: the type cannot yet say\n                        // \"view\", so the discipline is the author's.)\n                        string:kept = relay string_slice(out, 0i64, j);\n                        out = relay string_concat(kept, \"\");\n                        depth = depth - 1i64;\n                    }\n                    if (!(string_equals(sgt, \"..\"))) {\n                        out = relay string_concat(out, \"/\");\n                        out = relay string_concat(out, sgt);\n                        depth = depth + 1i64;\n                    }\n                }\n            }\n            seg = i + 1i64;\n        }\n        i = i + 1i64;\n    }\n    if (out.len == 0i64) {\n        string:root = relay string_concat(\"/\", \"\");\n        pass Path{ text: move(root) };\n    }\n    pass Path{ text: move(out) };\n};\n\n// THE STREAM TRAITS (IO_REFERENCE §1): every operation is async, returns\n// Result, and carries a deadline — there is no unbounded read. Receivers are\n// `Self->` (the spec's by-value self predates the move-only rule for owners:\n// a by-value receiver would CONSUME the stream per call). `dyn Writer` is\n// 1.1.12d's stage; concrete impls dispatch statically today.\npub trait:Reader = {\n    async func:read = int64(Self->:self, uint8[]:dest, Duration:within);\n};\npub trait:Writer = {\n    async func:write = int64(Self->:self, fixed uint8[]:wsrc, Duration:within);\n    async func:flush = NIL(Self->:self, Duration:within);\n};\n\n// WHERE A SEEK MEASURES FROM (IO_REFERENCE §7) — an enum, not an integer.\npub enum:Whence = { Start; Current; End; };\n\n// THE BYTE STREAMS (IO_REFERENCE §3): no translation, ever. The OwnedFd\n// field is the lifetime story — scope exit drops the stream, the struct\n// drop reaches the descriptor, and the descriptor's drop closes it. That is\n// the whole of \"there is no close in the surface\" (§6). Descriptors are\n// opened NONBLOCK + CLOEXEC: every wait is a task suspension through\n// io_ready, never a parked thread (D-071).\npub struct:ByteReader = { OwnedFd:src; };\npub struct:ByteWriter = { OwnedFd:sink; };\n\n// The open itself is the one synchronous hop (epoll cannot wait for open;\n// io_uring is refused before Astrée — D-184): `within` governs the waits\n// the stream performs after it.\npub func:byte_reader_open = ByteReader(Path:p, Duration:_~within) {\n    cstring:cp = relay to_cstring(p.text);\n    // O_RDONLY | O_NONBLOCK | O_CLOEXEC\n    fd:f = relay open(cp, 526336i64, 0i64);\n    pass ByteReader{ src: own_fd(f) };\n};\n\npub func:byte_writer_create = ByteWriter(Path:p, Duration:_~within) {\n    cstring:cp = relay to_cstring(p.text);\n    // O_WRONLY | O_CREAT | O_TRUNC | O_NONBLOCK | O_CLOEXEC, mode 0644\n    fd:f = relay open(cp, 526913i64, 420i64);\n    pass ByteWriter{ sink: own_fd(f) };\n};\n\n// THE RETRY LOOP (D-184's contract): a resume from io_ready means readiness\n// was SIGNALLED — the syscall is re-tried, and a retry that still would\n// block waits again on the time that remains. EAGAIN and EINTR retry;\n// everything else — IoEof included — is the caller's to handle, forwarded\n// verbatim (`fail r.err`, the 05_result rule).\nimpl:ByteReader:Reader = {\n    async func:read = int64(ByteReader->:self, uint8[]:dest, Duration:within) {\n        int64:give_up = (raw mono_now()) + within.ns;\n        while (true) {\n            Result<int64>:r = read(self.src.value, dest.ptr, dest.len);\n            if (!r.is_error) { pass r.value; }\n            bool:retry = false;\n            if (r.err == WouldBlock)  { retry = true; }\n            if (r.err == Interrupted) { retry = true; }\n            if (!retry) { fail r.err; }\n            if (r.err == WouldBlock) {\n                int64:rem = give_up - (raw mono_now());\n                if (rem <= 0i64) { fail DeadlineExceeded; }\n                Result<NIL>:w = await io_ready((self.src.value) =>! int32, 1i32,\n                                               raw duration_ns(rem));\n                if (w.is_error) { fail w.err; }\n            }\n        }\n    };\n};\n\nimpl:ByteWriter:Writer = {\n    async func:write = int64(ByteWriter->:self, fixed uint8[]:wsrc, Duration:within) {\n        int64:give_up = (raw mono_now()) + within.ns;\n        while (true) {\n            Result<int64>:r = write(self.sink.value, wsrc.ptr, wsrc.len);\n            if (!r.is_error) { pass r.value; }\n            bool:retry = false;\n            if (r.err == WouldBlock)  { retry = true; }\n            if (r.err == Interrupted) { retry = true; }\n            if (!retry) { fail r.err; }\n            if (r.err == WouldBlock) {\n                int64:rem = give_up - (raw mono_now());\n                if (rem <= 0i64) { fail DeadlineExceeded; }\n                Result<NIL>:w = await io_ready((self.sink.value) =>! int32, 4i32,\n                                               raw duration_ns(rem));\n                if (w.is_error) { fail w.err; }\n            }\n        }\n    };\n    // Nothing is buffered at this layer (buffering is an explicit wrapper —\n    // IO_REFERENCE §4), so a flush has nothing to move — but the trait\n    // carries it so a buffered writer can stand wherever this one does.\n    async func:flush = NIL(ByteWriter->:self, Duration:_~within) {\n        pass NIL;\n    };\n};\n\n// SEEK (IO_REFERENCE §7): the new position, from an enum'd origin. lseek\n// does not block, so the deadline is carried for shape and unspent.\nimpl:ByteReader = {\n    async func:seek = int64(ByteReader->:self, Whence:w, int64:off, Duration:_~within) {\n        int64:wh = 0i64;\n        pick (w) {\n            (Whence.Start)   { wh = 0i64; },\n            (Whence.Current) { wh = 1i64; },\n            (Whence.End)     { wh = 2i64; }\n        }\n        int64:np = relay sys(8i64, (self.src.value) =>! int64, off, wh);\n        pass np;\n    };\n};\n"; };
