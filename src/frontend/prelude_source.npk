// The prelude's source, as the compiler carries it.
//
// GENERATED by bootstrap/generator/gen_tables.py from
// src/prelude/prelude.npk. Edit that file, not this one.
//
// One line with escapes, because the real lexer refuses a newline inside a
// plain string literal and the seed has no block-string form -- so this is the
// one spelling both accept. The text is decoded before it is lexed, so spans
// inside the prelude point at real lines.

pub func:PRELUDE_SOURCE = string() { pass "// The prelude — what the compiler itself declares.\n//\n// NOT COMPILED AS PART OF THE FRONTEND. Nothing `use`s this file. It is read by\n// `bootstrap/generator/gen_tables.py`, which emits it into\n// `src/frontend/prelude_source.npk` as a string constant, and the compiler then\n// puts that text through the same lexer, the same parser and the same collector as\n// any other module.\n//\n// SOURCE RATHER THAN SYNTHESIS, and generated rather than hand-escaped, for the two\n// reasons the token tables give: a declaration built in code is one a person cannot\n// read, and a constant written twice is one that can differ in one of the places.\n//\n// COLLECTED INTO THE ROOT SCOPE, so these names are in scope everywhere with no\n// import. Every module's scope has scope 0 as its parent, so the place already\n// existed.\n\nmod:prelude;\n\n// HOW TWO VALUES COMPARE, AS A TYPE RATHER THAN A NUMBER. The prototype's\n// `partial_cmp` returned an `int32` meaning less, equal or greater by sign — three\n// meanings in one number, which is the shape D-036 rejects for `bool` and `char`.\n// An ordering is not an integer either.\npub enum:Ordering = {\n    Less;\n    Equal;\n    Greater;\n};\n\n// EQUALITY. Derived field by field, in declaration order.\npub trait:Eq = {\n    func:eq = bool(Self:self, Self:other);\n};\n\n// A TOTAL ORDER. Every two values compare, which is what makes the result an\n// `Ordering` and not an `Ordering?`.\n//\n// The prototype generated `less_than` returning `bool`, which carries strictly less\n// information than a three-way comparison and made `Ord` WEAKER than `PartialOrd` —\n// backwards, since `Ord` is the stronger promise.\npub trait:Ord = {\n    func:cmp = Ordering(Self:self, Self:other);\n};\n\n// AN ORDER THAT MAY HAVE NO ANSWER. Not a second spelling of `Ord` but a different\n// promise, which is why it survives where `Display` did not: a `flt64` is IEEE 754\n// with `nan` and no trap (OP_REFERENCE), so two of them genuinely may not compare,\n// and a total `cmp` over one would have to lie.\npub trait:PartialOrd = {\n    func:partial_cmp = Ordering?(Self:self, Self:other);\n};\n\n// A VALUE OF THE SAME TYPE, MADE FROM THIS ONE.\npub trait:Clone = {\n    func:clone = Self(Self:self);\n};\n\n// A HASH FOR A MAP, AND NOT CRYPTOGRAPHY. The derived combiner is FNV-1a and is\n// specified rather than left open (D-123), because a derived hash that varies\n// between builds is not something a verified compiler can have. Real cryptography\n// is `ncrypto`, a separately audited artifact.\npub trait:Hash = {\n    func:hash = uint64(Self:self);\n};\n\n// THE VALUE AS A STRING, which is what `&{ }` interpolation asks for.\npub trait:ToString = {\n    func:to_string = string(Self:self);\n};\n\n// THE SAME, IN A DIAGNOSTIC FORM naming the type and its fields. A separate trait\n// from `ToString` because the two are read by different audiences: one is what a\n// program shows a person, the other is what a person reads while debugging.\npub trait:Debug = {\n    func:debug = string(Self:self);\n};\n\n// WHAT A `for` LOOP DRIVES (D-166). `next` advances and yields the element, or\n// `NIL` when the iteration is over — `Item?` is why this was undecidable before\n// `Optional` lowered (1.0.7). The receiver is `Self->`: `next` mutates the\n// iterator's position, so it takes it by pointer, the one trait method that does.\npub trait:Iterator = {\n    assoc:Item;\n    func:next = Item?(Self->:self);\n};\n"; };
