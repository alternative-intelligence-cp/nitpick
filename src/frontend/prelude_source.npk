// The prelude's source, as the compiler carries it.
//
// GENERATED by bootstrap/generator/gen_tables.py from
// src/prelude/prelude.npk. Edit that file, not this one.
//
// One line with escapes, because the real lexer refuses a newline inside a
// plain string literal and the seed has no block-string form -- so this is the
// one spelling both accept. The text is decoded before it is lexed, so spans
// inside the prelude point at real lines.

pub func:PRELUDE_SOURCE = string() never fails { pass "// The prelude — what the compiler itself declares.\n//\n// NOT COMPILED AS PART OF THE FRONTEND. Nothing `use`s this file. It is read by\n// `bootstrap/generator/gen_tables.py`, which emits it into\n// `src/frontend/prelude_source.npk` as a string constant, and the compiler then\n// puts that text through the same lexer, the same parser and the same collector as\n// any other module.\n//\n// SOURCE RATHER THAN SYNTHESIS, and generated rather than hand-escaped, for the two\n// reasons the token tables give: a declaration built in code is one a person cannot\n// read, and a constant written twice is one that can differ in one of the places.\n//\n// COLLECTED INTO THE ROOT SCOPE, so these names are in scope everywhere with no\n// import. Every module's scope has scope 0 as its parent, so the place already\n// existed.\n\nmod:prelude;\n\n// HOW TWO VALUES COMPARE, AS A TYPE RATHER THAN A NUMBER. The prototype's\n// `partial_cmp` returned an `int32` meaning less, equal or greater by sign — three\n// meanings in one number, which is the shape D-036 rejects for `bool` and `char`.\n// An ordering is not an integer either.\npub enum:Ordering = {\n    Less;\n    Equal;\n    Greater;\n};\n\n// EQUALITY. Derived field by field, in declaration order.\npub trait:Eq = {\n    func:eq = bool(Self:self, Self:other);\n};\n\n// A TOTAL ORDER. Every two values compare, which is what makes the result an\n// `Ordering` and not an `Ordering?`.\n//\n// The prototype generated `less_than` returning `bool`, which carries strictly less\n// information than a three-way comparison and made `Ord` WEAKER than `PartialOrd` —\n// backwards, since `Ord` is the stronger promise.\npub trait:Ord = {\n    func:cmp = Ordering(Self:self, Self:other);\n};\n\n// AN ORDER THAT MAY HAVE NO ANSWER. Not a second spelling of `Ord` but a different\n// promise, which is why it survives where `Display` did not: a `flt64` is IEEE 754\n// with `nan` and no trap (OP_REFERENCE), so two of them genuinely may not compare,\n// and a total `cmp` over one would have to lie.\npub trait:PartialOrd = {\n    func:partial_cmp = Ordering?(Self:self, Self:other);\n};\n\n// A VALUE OF THE SAME TYPE, MADE FROM THIS ONE.\npub trait:Clone = {\n    func:clone = Self(Self:self);\n};\n\n// A HASH FOR A MAP, AND NOT CRYPTOGRAPHY. The derived combiner is FNV-1a and is\n// specified rather than left open (D-123), because a derived hash that varies\n// between builds is not something a verified compiler can have. Real cryptography\n// is `ncrypto`, a separately audited artifact.\npub trait:Hash = {\n    func:hash = uint64(Self:self);\n};\n\n// THE VALUE AS A STRING, which is what `&{ }` interpolation asks for.\npub trait:ToString = {\n    func:to_string = string(Self:self);\n};\n\n// THE SAME, IN A DIAGNOSTIC FORM naming the type and its fields. A separate trait\n// from `ToString` because the two are read by different audiences: one is what a\n// program shows a person, the other is what a person reads while debugging.\npub trait:Debug = {\n    func:debug = string(Self:self);\n};\n\n// WHAT A `for` LOOP DRIVES (D-166). `next` advances and yields the element, or\n// `NIL` when the iteration is over — `Item?` is why this was undecidable before\n// `Optional` lowered (1.0.7). The receiver is `Self->`: `next` mutates the\n// iterator's position, so it takes it by pointer, the one trait method that does.\npub trait:Iterator = {\n    assoc:Item;\n    func:next = Item?(Self->:self);\n};\n\n// `to_string` FOR THE BUILTIN SCALARS (D-168, 1.0.9d), so `&{ x }` renders\n// without a program writing the impl. The integers widen losslessly into `i64`\n// and go through the floor's `int_to_string`; `bool` is its two words. The\n// remaining scalars — the characters (UTF-8), the `tbb` widths (ERR), the kernel\n// identifiers, `uint64` (its high bit) and the floats (a correct float->decimal\n// in the floor) — arrive with their own careful conversions.\nimpl:int8:ToString   = { func:to_string = string(int8:self) never fails   { pass (int_to_string(self => int64)); }; };\nimpl:int16:ToString  = { func:to_string = string(int16:self) never fails  { pass (int_to_string(self => int64)); }; };\nimpl:int32:ToString  = { func:to_string = string(int32:self) never fails  { pass (int_to_string(self => int64)); }; };\nimpl:int64:ToString  = { func:to_string = string(int64:self) never fails  { pass (int_to_string(self)); }; };\nimpl:uint8:ToString  = { func:to_string = string(uint8:self) never fails  { pass (int_to_string(self => int64)); }; };\nimpl:uint16:ToString = { func:to_string = string(uint16:self) never fails { pass (int_to_string(self => int64)); }; };\nimpl:uint32:ToString = { func:to_string = string(uint32:self) never fails { pass (int_to_string(self => int64)); }; };\nimpl:bool:ToString   = { func:to_string = string(bool:self) never fails   { if (self) { pass \"true\"; } pass \"false\"; }; };\n\nimpl:uint64:ToString = { func:to_string = string(uint64:self) never fails { pass (raw uint_to_decimal(self)); }; };\n\n// THE `tbb` WIDTHS RENDER `ERR` OR THE NUMBER (D-008, D-168). ERR is the taint,\n// shown as itself; everything else is the value, read through the checked cast\n// the `is_err` guard makes safe.\nimpl:tbb8:ToString  = { func:to_string = string(tbb8:self) never fails  { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\nimpl:tbb16:ToString = { func:to_string = string(tbb16:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\nimpl:tbb32:ToString = { func:to_string = string(tbb32:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\nimpl:tbb64:ToString = { func:to_string = string(tbb64:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\n\n// THE TERNARY FAMILY RENDERS THE SAME WAY (D-197, D-168): the VALUE is a\n// number and shows as one; the balanced digit string is what `.trit(i)` /\n// `.nit(i)` are for.\nimpl:trit:ToString  = { func:to_string = string(trit:self) never fails  { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\nimpl:tryte:ToString = { func:to_string = string(tryte:self) never fails { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\nimpl:nit:ToString   = { func:to_string = string(nit:self) never fails   { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\nimpl:nyte:ToString  = { func:to_string = string(nyte:self) never fails  { if (is_err(self)) { pass \"ERR\"; } pass (int_to_string(self => int64)); }; };\n\n// THE KERNEL IDENTIFIERS RENDER THEIR NUMBER (D-042, D-168): a handle's value is\n// readable even though a handle is not forgeable.\nimpl:fd:ToString  = { func:to_string = string(fd:self) never fails  { pass (int_to_string(self => int64)); }; };\nimpl:pid:ToString = { func:to_string = string(pid:self) never fails { pass (int_to_string(self => int64)); }; };\nimpl:tid:ToString = { func:to_string = string(tid:self) never fails { pass (int_to_string(self => int64)); }; };\nimpl:uid:ToString = { func:to_string = string(uid:self) never fails { pass (int_to_string(self => int64)); }; };\nimpl:gid:ToString = { func:to_string = string(gid:self) never fails { pass (int_to_string(self => int64)); }; };\n\n// UNSIGNED DECIMAL (D-168), for `uint64`, whose high half the floor's signed\n// `int_to_string` renders as a negative. Unsigned division here is the language's\n// own — `uint64 / 10` and `% 10` are unsigned because the type is — so the digits\n// come out right whatever the high bit. The lower unsigned widths fit in `int64`\n// and go through `int_to_string` losslessly; only `uint64` needs this.\npub func:digit_char = string(uint64:d) never fails {\n    if (d == 0u64) { pass \"0\"; }\n    if (d == 1u64) { pass \"1\"; }\n    if (d == 2u64) { pass \"2\"; }\n    if (d == 3u64) { pass \"3\"; }\n    if (d == 4u64) { pass \"4\"; }\n    if (d == 5u64) { pass \"5\"; }\n    if (d == 6u64) { pass \"6\"; }\n    if (d == 7u64) { pass \"7\"; }\n    if (d == 8u64) { pass \"8\"; }\n    pass \"9\";\n};\n\npub func:uint_to_decimal = string(uint64:v) never fails {\n    if (v == 0u64) { pass \"0\"; }\n    string:acc = \"\";\n    uint64:n = v;\n    while (n > 0u64) {\n        string:d = raw digit_char(n % 10u64);\n        acc = string_concat(d, acc);\n        n = n / 10u64;\n    }\n    pass acc;\n};\n\n// A UNICODE SCALAR VALUE AS ONE OWNED STRING (§6b, D-168). The encoder is\n// TOTAL: a surrogate half or a value past U+10FFFF renders as U+FFFD, the\n// replacement character — never a fabricated byte sequence, because a\n// `string` is UTF-8 by convention and an innocent-looking total function\n// must not be the way an invalid one is minted. The owned copy rides\n// D-186's `string_slice` over a `string_from_bytes` view of a scratch\n// buffer, which is what unblocked this without a floor primitive.\npub func:codepoint_to_string = string(uint32:cp) never fails {\n    uint32:c = cp;\n    if (c > 1114111u32)                     { c = 65533u32; }\n    if ((c >= 55296u32) && (c <= 57343u32)) { c = 65533u32; }\n    wild int8->:b = alloc(4i64);\n    int64:len = 0i64;\n    if (c < 128u32) {\n        b[0i64] = c =>! int8;\n        len = 1i64;\n    }\n    if ((c >= 128u32) && (c < 2048u32)) {\n        b[0i64] = (192u32 | (c >> 6u32)) =>! int8;\n        b[1i64] = (128u32 | (c & 63u32)) =>! int8;\n        len = 2i64;\n    }\n    if ((c >= 2048u32) && (c < 65536u32)) {\n        b[0i64] = (224u32 | (c >> 12u32)) =>! int8;\n        b[1i64] = (128u32 | ((c >> 6u32) & 63u32)) =>! int8;\n        b[2i64] = (128u32 | (c & 63u32)) =>! int8;\n        len = 3i64;\n    }\n    if (c >= 65536u32) {\n        b[0i64] = (240u32 | (c >> 18u32)) =>! int8;\n        b[1i64] = (128u32 | ((c >> 12u32) & 63u32)) =>! int8;\n        b[2i64] = (128u32 | ((c >> 6u32) & 63u32)) =>! int8;\n        b[3i64] = (128u32 | (c & 63u32)) =>! int8;\n        len = 4i64;\n    }\n    string:v = string_from_bytes(b, len);\n    string:owned = string_slice(v, 0i64, len) ?| \"\";\n    dalloc(b);\n    pass owned;\n};\n\n// THE CHARACTERS RENDER THEIR TEXT (D-005, D-168, §6b). `char32` is a\n// Unicode SCALAR VALUE and renders as itself. `char16` is a UTF-16 CODE\n// UNIT: a lone surrogate half has no text, and the encoder's own guard\n// renders it U+FFFD. `char8` is a UTF-8 CODE UNIT: a non-ASCII unit alone\n// is not a character either — it is a fragment of one — so only the ASCII\n// range renders as itself. The masks pin the unit's unsigned value\n// whatever the cast does with the storage type's sign bit.\nimpl:char8:ToString  = { func:to_string = string(char8:self) never fails {\n    uint32:u = (self =>! uint32) & 255u32;\n    if (u < 128u32) { pass (raw codepoint_to_string(u)); }\n    pass (raw codepoint_to_string(65533u32));\n}; };\nimpl:char16:ToString = { func:to_string = string(char16:self) never fails {\n    pass (raw codepoint_to_string((self =>! uint32) & 65535u32));\n}; };\nimpl:char32:ToString = { func:to_string = string(char32:self) never fails {\n    pass (raw codepoint_to_string(self =>! uint32));\n}; };\n\n// A FLOAT'S SHORTEST ROUND-TRIP DECIMAL (§6b, D-168). Exact integer\n// arithmetic end to end — the Steele–White (Dragon4) discipline over the\n// wide-integer tier — because a NAIVE conversion drifts, and numeric drift\n// is the safety rationale's own named failure. NO WIDE DIVISION is used:\n// every ×10 is a shift-and-add, and a digit is at most nine subtractions,\n// so nothing here can lower to a runtime library call the zero-dependency\n// scan would have to provide.\n//\n// The loop maintains value = R/S with the half-gaps MP (above) and MM\n// (below) of the float's neighbourhood; a digit is emitted while neither\n// gap is entered, and the last digit rounds toward the true value, ties to\n// even. An EVEN mantissa owns its boundaries (IEEE round-nearest-even), so\n// every gap test carries the inclusive arm. Worst case fits comfortably:\n// R, S and the boundaries stay under 2^1130 for flt64's full range,\n// subnormals included, against uint2048's headroom.\n//\n// The format is fixed notation while the decimal exponent E sits in\n// [-4, 15] — with a mandatory \".0\" or fraction — and `d[.ddd]e±EE`\n// outside it; \"0.0\"/\"-0.0\", \"inf\"/\"-inf\" and \"nan\" are spelled directly.\npub func:flt_bits_shortest = string(uint64:bits, uint64:mant_bits,\n                                    uint64:exp_bits) never fails {\n    uint64:mant_mask = (1u64 << mant_bits) - 1u64;\n    uint64:exp_mask = (1u64 << exp_bits) - 1u64;\n    uint64:sgn = (bits >> (mant_bits + exp_bits)) & 1u64;\n    uint64:biased = (bits >> mant_bits) & exp_mask;\n    uint64:frac = bits & mant_mask;\n    string:neg = \"\";\n    if (sgn == 1u64) { neg = \"-\"; }\n    if (biased == exp_mask) {\n        if (frac == 0u64) { pass (string_concat(neg, \"inf\")); }\n        pass \"nan\";\n    }\n    if ((biased == 0u64) && (frac == 0u64)) {\n        pass (string_concat(neg, \"0.0\"));\n    }\n    // Decode: value = f × 2^e. A normal carries the implicit bit and\n    // e = biased - bias - mant_bits; a subnormal is the bare fraction at\n    // the minimum exponent.\n    uint64:bias = (1u64 << (exp_bits - 1u64)) - 1u64;\n    uint64:f = frac;\n    int64:e = (1i64 - (bias =>! int64)) - (mant_bits =>! int64);\n    if (biased != 0u64) {\n        f = frac | (1u64 << mant_bits);\n        e = ((biased =>! int64) - (bias =>! int64)) - (mant_bits =>! int64);\n    }\n    bool:even = ((f & 1u64) == 0u64);\n    uint2048:F = f => uint2048;\n    uint2048:R = 0u2048;\n    uint2048:S = 0u2048;\n    uint2048:MP = 0u2048;\n    if (e >= 0i64) {\n        uint2048:ew = ((e =>! uint64) => uint2048);\n        R = (F << ew) << 1u2048;\n        S = 2u2048;\n        MP = 1u2048 << ew;\n    }\n    if (e < 0i64) {\n        uint2048:nw = (((0i64 - e) =>! uint64) => uint2048);\n        R = F << 1u2048;\n        S = (1u2048 << nw) << 1u2048;\n        MP = 1u2048;\n    }\n    uint2048:MM = MP;\n    // A power-of-two mantissa above the smallest normal exponent has a\n    // HALF-gap below (its lower neighbour is twice as close): scale all\n    // but MM by two.\n    if ((frac == 0u64) && (biased > 1u64)) {\n        R = R << 1u2048;\n        S = S << 1u2048;\n        MP = MP << 1u2048;\n    }\n    // Scale into [first digit ≥ 1]: while the upper boundary reaches past\n    // one, take a power of ten into S; while ×10 would still not reach it,\n    // take one into the numerator side.\n    int32:k = 0i32;\n    bool:go = true;\n    while (go) {\n        uint2048:hp = R + MP;\n        bool:hi = false;\n        if (hp > S) { hi = true; }\n        if (even && (hp == S)) { hi = true; }\n        if (hi) {\n            S = (S << 3u2048) + (S << 1u2048);\n            k = k + 1i32;\n        } else { go = false; }\n    }\n    go = true;\n    while (go) {\n        uint2048:hp = R + MP;\n        uint2048:h10 = (hp << 3u2048) + (hp << 1u2048);\n        bool:lo = false;\n        if (h10 < S) { lo = true; }\n        if ((!even) && (h10 == S)) { lo = true; }\n        if (lo) {\n            R = (R << 3u2048) + (R << 1u2048);\n            MP = (MP << 3u2048) + (MP << 1u2048);\n            MM = (MM << 3u2048) + (MM << 1u2048);\n            k = k - 1i32;\n        } else { go = false; }\n    }\n    // Digits, high to low. `d` is at most nine subtractions because\n    // R < S entering each round; the stop tests are the two gaps.\n    wild int8->:db = alloc(24i64);\n    int64:dn = 0i64;\n    bool:more = true;\n    while (more) {\n        R = (R << 3u2048) + (R << 1u2048);\n        MP = (MP << 3u2048) + (MP << 1u2048);\n        MM = (MM << 3u2048) + (MM << 1u2048);\n        uint64:d = 0u64;\n        while (R >= S) {\n            R = R - S;\n            d = d + 1u64;\n        }\n        bool:lo = false;\n        if (R < MM) { lo = true; }\n        if (even && (R == MM)) { lo = true; }\n        uint2048:hp = R + MP;\n        bool:hi = false;\n        if (hp > S) { hi = true; }\n        if (even && (hp == S)) { hi = true; }\n        uint64:emitd = d;\n        if ((!lo) && hi) { emitd = d + 1u64; }\n        if (lo && hi) {\n            // Both gaps open: round to the nearer, an exact tie to even.\n            uint2048:t2 = R << 1u2048;\n            if (t2 > S) { emitd = d + 1u64; }\n            if (t2 == S) {\n                if ((d & 1u64) == 1u64) { emitd = d + 1u64; }\n            }\n        }\n        db[dn] = (48u64 + emitd) =>! int8;\n        dn = dn + 1i64;\n        if (lo)  { more = false; }\n        if (hi)  { more = false; }\n        if (dn >= 20i64) { more = false; }\n    }\n    // A round-up of a trailing 9 carries left; all nines collapse to \"1\"\n    // one decimal position up.\n    bool:overflowed = false;\n    int64:ci = dn - 1i64;\n    while (ci >= 0i64) {\n        if (db[ci] == 58i8) {\n            db[ci] = 48i8;\n            if (ci == 0i64) { overflowed = true; }\n            if (ci > 0i64) { db[ci - 1i64] = db[ci - 1i64] + 1i8; }\n        }\n        ci = ci - 1i64;\n    }\n    if (overflowed) {\n        db[0i64] = 49i8;\n        dn = 1i64;\n        k = k + 1i32;\n    }\n    string:dview = string_from_bytes(db, dn);\n    string:digits = string_slice(dview, 0i64, dn) ?| \"\";\n    dalloc(db);\n    // Compose. value = 0.digits × 10^k; E is the scientific exponent.\n    int32:big_e = k - 1i32;\n    string:out = \"\";\n    if ((big_e >= (0i32 - 4i32)) && (big_e <= 15i32)) {\n        if (k <= 0i32) {\n            out = \"0.\";\n            int32:z = 0i32 - k;\n            while (z > 0i32) {\n                out = string_concat(out, \"0\");\n                z = z - 1i32;\n            }\n            out = string_concat(out, digits);\n        }\n        if ((k > 0i32) && ((k => int64) < dn)) {\n            string:hd = string_slice(digits, 0i64, k => int64) ?| \"\";\n            string:tl = string_slice(digits, k => int64, dn) ?| \"\";\n            out = string_concat(hd, \".\");\n            out = string_concat(out, tl);\n        }\n        if ((k > 0i32) && ((k => int64) >= dn)) {\n            out = string_concat(out, digits);\n            int64:z2 = (k => int64) - dn;\n            while (z2 > 0i64) {\n                out = string_concat(out, \"0\");\n                z2 = z2 - 1i64;\n            }\n            out = string_concat(out, \".0\");\n        }\n    } else {\n        string:fs = string_slice(digits, 0i64, 1i64) ?| \"\";\n        out = string_concat(out, fs);\n        if (dn > 1i64) {\n            string:rs = string_slice(digits, 1i64, dn) ?| \"\";\n            out = string_concat(out, \".\");\n            out = string_concat(out, rs);\n        }\n        out = string_concat(out, \"e\");\n        int32:ea = big_e;\n        if (big_e < 0i32) {\n            out = string_concat(out, \"-\");\n            ea = 0i32 - big_e;\n        }\n        if (big_e >= 0i32) { out = string_concat(out, \"+\"); }\n        if (ea < 10i32) { out = string_concat(out, \"0\"); }\n        out = string_concat(out, int_to_string(ea => int64));\n    }\n    pass (string_concat(neg, out));\n};\n\n// THE FLOATS RENDER SHORTEST-ROUND-TRIP (§6b). The bits travel through a\n// scratch buffer — a store as the float, a load as the integer — because\n// `=>!` is a VALUE conversion everywhere and must not quietly mean\n// \"reinterpret\" for one pair of types.\nimpl:flt64:ToString = { func:to_string = string(flt64:self) never fails {\n    wild int8->:b = alloc(8i64);\n    wild flt64->:fp = b =>! wild flt64->;\n    <-fp = self;\n    wild uint64->:ip = b =>! wild uint64->;\n    uint64:w = <-ip;\n    dalloc(b);\n    pass (raw flt_bits_shortest(w, 52u64, 11u64));\n}; };\nimpl:flt32:ToString = { func:to_string = string(flt32:self) never fails {\n    wild int8->:b = alloc(4i64);\n    wild flt32->:fp = b =>! wild flt32->;\n    <-fp = self;\n    wild uint32->:ip = b =>! wild uint32->;\n    uint32:w = <-ip;\n    dalloc(b);\n    pass (raw flt_bits_shortest(w => uint64, 23u64, 8u64));\n}; };\n\n// FNV-1a, THE DERIVED HASH (D-123). The combiner is specified so a derived hash\n// is the same across builds -- a verified compiler cannot have one that drifts.\n// The offset basis (0xcbf29ce484222325) is past the 64-bit literal envelope, so it\n// is built from its two words; the prime fits.\npub func:fnv_offset = uint64() never fails { pass ((3421887204u64 << 32u64) | 2216829733u64); };\n// FNV's multiply is DELIBERATELY MODULAR — the mixing IS the wraparound — so\n// since D-210 it is spelled the way deliberate modularity is spelled: widen,\n// compute, truncate, with `=>!` carrying the acknowledged loss (D-210.3). The\n// product of a 64-bit word and the prime needs 104 bits, which `uint128` has.\n// All THREE copies of this step (here, `resolve.err_fnv_step`, and\n// `ir_stmt.pat_err_fnv`) must agree to the bit — D-179's error identity is\n// derived from it on both sides of the compiler — so all three are spelled\n// identically.\npub func:fnv_mix = uint64(uint64:h, uint64:v) never fails {\n    pass ((((h ^ v) => uint128) * 1099511628211u128) =>! uint64);\n};\n\n// A SCALAR HASHES ITS VALUE (D-123); a derived struct hash combines its fields\n// the same way, so the whole is FNV-1a over the parts.\nimpl:int8:Hash = { func:hash = uint64(int8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int16:Hash = { func:hash = uint64(int16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int32:Hash = { func:hash = uint64(int32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:int64:Hash = { func:hash = uint64(int64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:uint8:Hash = { func:hash = uint64(uint8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint16:Hash = { func:hash = uint64(uint16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint32:Hash = { func:hash = uint64(uint32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:uint64:Hash = { func:hash = uint64(uint64:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self)); }; };\nimpl:bool:Hash = { func:hash = uint64(bool:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self => uint64)); }; };\nimpl:char8:Hash = { func:hash = uint64(char8:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:char16:Hash = { func:hash = uint64(char16:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:char32:Hash = { func:hash = uint64(char32:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:fd:Hash = { func:hash = uint64(fd:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:pid:Hash = { func:hash = uint64(pid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:tid:Hash = { func:hash = uint64(tid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:uid:Hash = { func:hash = uint64(uid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:gid:Hash = { func:hash = uint64(gid:self) never fails { pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\n\n// A tbb HASHES ERR AS A FIXED WORD, ITS VALUE OTHERWISE (D-008): the guard\n// comes first, so the cast's ERR trap (both spellings, D-144 as amended at\n// 1.3.2) cannot fire; the bang is the signed→unsigned acknowledgment, the\n// same spelling the plain matrix requires of `int64 =>! uint64`.\nimpl:tbb8:Hash = { func:hash = uint64(tbb8:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:tbb16:Hash = { func:hash = uint64(tbb16:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:tbb32:Hash = { func:hash = uint64(tbb32:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\nimpl:tbb64:Hash = { func:hash = uint64(tbb64:self) never fails { if (is_err(self)) { pass (raw fnv_mix(raw fnv_offset(), 0u64)); } pass (raw fnv_mix(raw fnv_offset(), self =>! uint64)); }; };\n\n// A string CLONES BY ALLOCATING A FRESH BODY (D-183). This is the language's\n// one spelling for \"I genuinely want a second owner\": explicit at the call\n// site (`x.clone()`), greppable, and it allocates — which is exactly why it is\n// not what assignment does. Concatenation with the empty string IS the fresh\n// copy, and the result carries `cap = n`, so the clone owns its body and drops\n// it independently of the original.\nimpl:string:Clone = { func:clone = string(string:self) {\n    pass (string_concat(self, \"\"));\n}; };\n\n// A string HASHES ITS BYTES (D-123) -- FNV-1a is over bytes, and self.ptr[i] walks\n// them.\nimpl:string:Hash = { func:hash = uint64(string:self) never fails {\n    uint64:h = raw fnv_offset();\n    int64:i = 0i64;\n    while (i < self.len) {\n        h = raw fnv_mix(h, self.ptr[i] => uint64);\n        i = i + 1i64;\n    }\n    pass h;\n}; };\n\n// --- the deadline substrate (D-176, 1.1.3) -----------------------------------\n//\n// `Duration` is a span of time as int64 NANOSECONDS — one word, one compare,\n// ±292 years. Deadline parameters take one, RELATIVE, named `within`; the\n// executor converts to an absolute monotonic timepoint once, at suspension\n// entry. The constructors' multiplications ride ordinary int64 arithmetic,\n// whose overflow traps (D-142) — a span past ±292 years is a controlled stop.\npub struct:Duration = { int64:ns; };\n\npub func:duration_ns = Duration(int64:n) never fails {\n    pass Duration{ ns: n };\n};\npub func:duration_ms = Duration(int64:ms) never fails {\n    pass Duration{ ns: ms * 1000000i64 };\n};\npub func:duration_secs = Duration(int64:s) never fails {\n    pass Duration{ ns: s * 1000000000i64 };\n};\n\n// --- the system error family (D-179) -----------------------------------------------\n//\n// D-142's table as DECLARATIONS — the same fixed codes npkrt.ll hardcodes\n// (its values are the stability constraint), now named. The explicit-code\n// form is legal here and nowhere else: the SYSTEM domain is exactly what the\n// prelude declares, its sign an encoding detail the compiler owns (stored\n// negated). User programs name these in `failsafe` picks; they cannot\n// declare into the family, so identity can never be forged.\npub error:DivByZero = 4097i32;         // division or remainder by zero (the 0.7 guard)\npub error:DivOverflow = 4098i32;       // MIN / -1 — the one signed division that overflows\npub error:OutOfBounds = 4099i32;       // an index outside its array, slice or range\npub error:TbbErr = 4100i32;            // ERR at a bare comparison / checked cast out of tbb (D-008 s5, D-144)\npub error:BadStep = 4101i32;           // a counted loop's step was not positive at runtime (D-142)\npub error:Unreachable = 4102i32;       // #unreachable() reached, and the runtime's integrity defects (D-061, D-153)\npub error:HeapOom = 4103i32;           // mmap failure — the allocation-free trap path (D-153)\npub error:HeapBadRequest = 4104i32;    // negative size; count*size overflow (D-153)\npub error:WildLeak = 4105i32;          // a `wild` allocation outlived exit 0 (D-151)\npub error:StaleHandle = 4106i32;       // an arena handle outlived its slot's generation (D-152)\npub error:DeadlineExceeded = 4107i32;  // time ran out (D-176): the Result error AND the join's trap\npub error:ChannelClosed = 4108i32;     // a `send` to, or a drained `recv` from, a closed channel (D-072/D-182)\npub error:IntOverflow = 4110i32;      // plain-integer `+ - *` overflowed (D-210) — the DEFAULT integer is the checked one\npub error:DriverLeak = 4109i32;        // exit 0 with a driver still registered (D-188) — a clean exit never abandons a supervised process\npub error:IoEof = 4096i32;             // end of input (the io floor's marker, distinct from every errno)\n\n// --- waiting (D-071, 1.1.8) --------------------------------------------------\n//\n// THE ONE WAITING PRIMITIVE, and everything that blocks is built from it.\n// `await sleep(within)` suspends the TASK: the executor takes the park\n// request and sleeps the thread only when it has nothing else runnable, so\n// a waiting task can never stall a sibling (D-071's whole point). The\n// deadline is ABSOLUTE and monotonic by the time the kernel sees it — the\n// span is converted once, here, at suspension entry (D-176 rule 2).\npub async func:sleep = NIL(Duration:within) {\n    suspend_until((mono_now()) + within.ns);\n    pass NIL;\n};\n\n// `await io_ready(fd, events, within)` (B-3a, 1.1.12a): suspend until the\n// descriptor is ready for `events` (EPOLLIN 1, EPOLLOUT 4) or the deadline\n// passes — the reactor's one wait. One registration, one park, one return:\n// a resume past the deadline is the deadline's, and reports it; a resume\n// before it means READINESS WAS SIGNALLED — retry the syscall, and if it\n// still would block (stolen by a sibling, a spurious wake), call this\n// again. The stream types are loops around exactly that.\npub async func:io_ready = NIL(int32:iofd, int32:events, Duration:within) {\n    int64:io_abs = (mono_now()) + within.ns;\n    // The registration lives exactly as long as the wait: a one-shot left\n    // armed past this frame would fire into freed memory. Every exit --\n    // readiness, deadline, wind-up -- runs this.\n    defer { io_unwatch(iofd); }\n    suspend_io(iofd, events, io_abs);\n    if ((mono_now()) >= io_abs) { fail DeadlineExceeded; }\n    pass NIL;\n};\n\n// `await io_ready2(fda, eva, fdb, evb, within)` (1.1.13b): suspend until\n// EITHER descriptor is ready or the deadline passes -- the dual wait the\n// Bridge's dispatch needs (the ctrl socket and the pidfd are both\n// descriptors, which is why the reactor needs no special case). The first\n// is REGISTERED only (`io_watch`); the second carries the park. Both\n// registrations are removed on every exit, and a resume before the\n// deadline says only that SOMETHING was signalled -- the caller re-tries\n// its syscalls to learn what, exactly io_ready's contract.\npub async func:io_ready2 = NIL(int32:fda, int32:eva, int32:fdb, int32:evb, Duration:within) {\n    int64:io_abs = (mono_now()) + within.ns;\n    defer { io_unwatch(fda); }\n    defer { io_unwatch(fdb); }\n    io_watch(fda, eva);\n    suspend_io(fdb, evb, io_abs);\n    if ((mono_now()) >= io_abs) { fail DeadlineExceeded; }\n    pass NIL;\n};\n\n// --- the streams (D-185, 1.1.12b; IO_REFERENCE) -------------------------------\n//\n// TWO ERRNOS, NAMED, because every stream loop must tell them from real\n// failures: the kernel's own codes ride the error word verbatim (negative,\n// disjoint from the 4096+ system family), and these are the two that mean\n// \"again\", not \"broken\". Naming more of the errno space is a decision for\n// the code that needs it.\npub error:WouldBlock = 11i32;      // EAGAIN — not ready; wait for readiness and retry\npub error:Interrupted = 4i32;      // EINTR — a signal cut the call; retry immediately\n\n// --- the flag families' members (D-044/D-230, 1.4.8) --------------------------\n//\n// A KERNEL FLAG WORD IS NOT A NUMBER. `oflags`, `prot`, `mflags` and `fmode`\n// are TYPES (one kind, `TY_FLAGS`, the family in the operand window like\n// `fd`'s); these are their named bits, as `fixed` prelude bindings — a\n// literal asserted into its family, which is exactly the shape the read-back\n// crossing `int32 =>! oflags` has. GENERATED between the two markers by\n// bootstrap/generator/gen_tables.py from TYPE_REFERENCE §8's marked region,\n// the one authority; edit the table there, never these lines. Lowered to an\n// LLVM `constant` each (D-165/D-222), and a derived set is an ordinary module\n// binding that folds: `fixed oflags:CREATE_RW = (O_RDWR | O_CREAT) | O_CLOEXEC;`.\n// --- flags:begin (GENERATED — do not edit between the markers) ---\npub fixed oflags:O_RDONLY = 0i32 =>! oflags;\npub fixed oflags:O_WRONLY = 1i32 =>! oflags;\npub fixed oflags:O_RDWR = 2i32 =>! oflags;\npub fixed oflags:O_CREAT = 64i32 =>! oflags;\npub fixed oflags:O_EXCL = 128i32 =>! oflags;\npub fixed oflags:O_NOCTTY = 256i32 =>! oflags;\npub fixed oflags:O_TRUNC = 512i32 =>! oflags;\npub fixed oflags:O_APPEND = 1024i32 =>! oflags;\npub fixed oflags:O_NONBLOCK = 2048i32 =>! oflags;\npub fixed oflags:O_DSYNC = 4096i32 =>! oflags;\npub fixed oflags:O_DIRECTORY = 65536i32 =>! oflags;\npub fixed oflags:O_NOFOLLOW = 131072i32 =>! oflags;\npub fixed oflags:O_CLOEXEC = 524288i32 =>! oflags;\npub fixed oflags:O_SYNC = 1052672i32 =>! oflags;\npub fixed oflags:O_PATH = 2097152i32 =>! oflags;\npub fixed prot:PROT_NONE = 0i32 =>! prot;\npub fixed prot:PROT_READ = 1i32 =>! prot;\npub fixed prot:PROT_WRITE = 2i32 =>! prot;\npub fixed prot:PROT_EXEC = 4i32 =>! prot;\npub fixed mflags:MAP_SHARED = 1i32 =>! mflags;\npub fixed mflags:MAP_PRIVATE = 2i32 =>! mflags;\npub fixed mflags:MAP_FIXED = 16i32 =>! mflags;\npub fixed mflags:MAP_ANONYMOUS = 32i32 =>! mflags;\npub fixed mflags:MAP_NORESERVE = 16384i32 =>! mflags;\npub fixed mflags:MAP_POPULATE = 32768i32 =>! mflags;\npub fixed mflags:MAP_FIXED_NOREPLACE = 1048576i32 =>! mflags;\npub fixed fmode:S_NONE = 0i32 =>! fmode;\npub fixed fmode:S_IXOTH = 1i32 =>! fmode;\npub fixed fmode:S_IWOTH = 2i32 =>! fmode;\npub fixed fmode:S_IROTH = 4i32 =>! fmode;\npub fixed fmode:S_IRWXO = 7i32 =>! fmode;\npub fixed fmode:S_IXGRP = 8i32 =>! fmode;\npub fixed fmode:S_IWGRP = 16i32 =>! fmode;\npub fixed fmode:S_IRGRP = 32i32 =>! fmode;\npub fixed fmode:S_IRWXG = 56i32 =>! fmode;\npub fixed fmode:S_IXUSR = 64i32 =>! fmode;\npub fixed fmode:S_IWUSR = 128i32 =>! fmode;\npub fixed fmode:S_IRUSR = 256i32 =>! fmode;\npub fixed fmode:S_IRWXU = 448i32 =>! fmode;\npub fixed fmode:S_ISVTX = 512i32 =>! fmode;\npub fixed fmode:S_ISGID = 1024i32 =>! fmode;\npub fixed fmode:S_ISUID = 2048i32 =>! fmode;\n// --- flags:end ---\n\n// A PATH IS PARSED, NOT PASSED AROUND AS A STRING (D-051/D-054): absolute,\n// lexically normalized, no interior NUL. Normalization here is LEXICAL —\n// D-054's warning stands: it does not survive symlinks, and containment\n// wants openat + O_NOFOLLOW, not a string check.\npub error:BadPath;\npub struct:Path = { string:text; };\n\npub func:path_parse = Path(string:s) {\n    if (s.len == 0i64)        { fail BadPath; }\n    if (s.ptr[0i64] != 47u8)  { fail BadPath; }   // absolute, or it is not a Path\n    string:out = \"\";\n    int64:depth = 0i64;\n    int64:i = 1i64;\n    int64:seg = 1i64;\n    while (i <= s.len) {\n        bool:at_end = (i == s.len);\n        uint8:c = 0u8;\n        if (!at_end) {\n            c = s.ptr[i];\n            if (c == 0u8) { fail BadPath; }       // interior NUL: the poison byte\n        }\n        if (at_end || (c == 47u8)) {\n            int64:sl = i - seg;\n            if (sl > 0i64) {\n                string:sgt = relay string_slice(s, seg, i);\n                bool:dot = string_equals(sgt, \".\");\n                if (!dot) {\n                    if (string_equals(sgt, \"..\")) {\n                        // \"..\" above the root is not a path, it is an escape.\n                        if (depth == 0i64) { fail BadPath; }\n                        int64:j = out.len - 1i64;\n                        while (j >= 0i64) {\n                            if (out.ptr[j] == 47u8) { break; }\n                            j = j - 1i64;\n                        }\n                        // `string_slice` returns an OWNED COPY (D-186),\n                        // so slicing a string over itself is safe — this\n                        // exact line, as a view, was the use-after-free\n                        // that settled the decision.\n                        out = relay string_slice(out, 0i64, j);\n                        depth = depth - 1i64;\n                    }\n                    if (!(string_equals(sgt, \"..\"))) {\n                        out = string_concat(out, \"/\");\n                        out = string_concat(out, sgt);\n                        depth = depth + 1i64;\n                    }\n                }\n            }\n            seg = i + 1i64;\n        }\n        i = i + 1i64;\n    }\n    if (out.len == 0i64) {\n        string:root = string_concat(\"/\", \"\");\n        pass Path{ text: move(root) };\n    }\n    pass Path{ text: move(out) };\n};\n\n// THE STREAM TRAITS (IO_REFERENCE §1): every operation is async, returns\n// Result, and carries a deadline — there is no unbounded read. Receivers are\n// `Self->` (the spec's by-value self predates the move-only rule for owners:\n// a by-value receiver would CONSUME the stream per call). `dyn Writer` is\n// 1.1.12d's stage; concrete impls dispatch statically today.\npub trait:Reader = {\n    async func:read = int64(Self->:self, uint8[]:dest, Duration:within);\n};\npub trait:Writer = {\n    async func:write = int64(Self->:self, fixed uint8[]:wsrc, Duration:within);\n    async func:flush = NIL(Self->:self, Duration:within);\n};\n\n// WHERE A SEEK MEASURES FROM (IO_REFERENCE §7) — an enum, not an integer.\npub enum:Whence = { Start; Current; End; };\n\n// THE OTHER TWO ENUMERATIONS OF D-044's SEVEN (the user's families answer,\n// 2026-09-02, closing 1.4.7b's question): a `fcntl` command and a `madvise`\n// advice are ONE value per call, never OR-ed -- `F_GETFL | F_SETFL` must not\n// be spellable -- so they are enums of `Whence`'s shape, not flag families.\n// The kernel's numbers are the wrappers' business (`lib/nsys.npk`'s\n// `fcntl_cmd`/`madvise_word`), exactly as `seek` maps `Whence`.\npub enum:Fcmd = { GetFd; SetFd; GetFl; SetFl; DupFdCloexec; AddSeals; GetSeals; };\npub enum:Advice = { Normal; Random; Sequential; WillNeed; DontNeed; Free; HugePage; NoHugePage; };\n\n// THE BYTE STREAMS (IO_REFERENCE §3): no translation, ever. The OwnedFd\n// field is the lifetime story — scope exit drops the stream, the struct\n// drop reaches the descriptor, and the descriptor's drop closes it. That is\n// the whole of \"there is no close in the surface\" (§6). Descriptors are\n// opened NONBLOCK + CLOEXEC: every wait is a task suspension through\n// io_ready, never a parked thread (D-071).\npub struct:ByteReader = { OwnedFd:src; };\npub struct:ByteWriter = { OwnedFd:sink; };\n\n// The open itself is the one synchronous hop (epoll cannot wait for open;\n// io_uring is refused before Astrée — D-184): `within` governs the waits\n// the stream performs after it.\npub func:byte_reader_open = ByteReader(Path:p, Duration:_~within) {\n    cstring:cp = relay to_cstring(p.text);\n    // The families, crossed to the floor's word at the call (D-230, 1.4.8).\n    fd:f = relay open(cp, (((O_RDONLY | O_NONBLOCK) | O_CLOEXEC) => int32) => int64,\n                      (S_NONE => int32) => int64);\n    pass ByteReader{ src: own_fd(f) };\n};\n\npub func:byte_writer_create = ByteWriter(Path:p, Duration:_~within) {\n    cstring:cp = relay to_cstring(p.text);\n    fd:f = relay open(cp,\n                      (((((O_WRONLY | O_CREAT) | O_TRUNC) | O_NONBLOCK) | O_CLOEXEC) => int32) => int64,\n                      ((((S_IRUSR | S_IWUSR) | S_IRGRP) | S_IROTH) => int32) => int64);   // 0644\n    pass ByteWriter{ sink: own_fd(f) };\n};\n\n// THE RETRY LOOP (D-184's contract): a resume from io_ready means readiness\n// was SIGNALLED — the syscall is re-tried, and a retry that still would\n// block waits again on the time that remains. EAGAIN and EINTR retry;\n// everything else — IoEof included — is the caller's to handle, forwarded\n// verbatim (`fail r.err`, the 05_result rule).\nimpl:ByteReader:Reader = {\n    async func:read = int64(ByteReader->:self, uint8[]:dest, Duration:within) {\n        int64:give_up = (mono_now()) + within.ns;\n        while (true) {\n            Result<int64>:r = read(self.src.value, dest.ptr, dest.len);\n            if (!r.is_error) { pass r.value; }\n            bool:retry = false;\n            if (r.err == WouldBlock)  { retry = true; }\n            if (r.err == Interrupted) { retry = true; }\n            if (!retry) { fail r.err; }\n            if (r.err == WouldBlock) {\n                int64:rem = give_up - (mono_now());\n                if (rem <= 0i64) { fail DeadlineExceeded; }\n                Result<NIL>:w = await io_ready((self.src.value) =>! int32, 1i32,\n                                               raw duration_ns(rem));\n                if (w.is_error) { fail w.err; }\n            }\n        }\n    };\n};\n\nimpl:ByteWriter:Writer = {\n    async func:write = int64(ByteWriter->:self, fixed uint8[]:wsrc, Duration:within) {\n        int64:give_up = (mono_now()) + within.ns;\n        while (true) {\n            Result<int64>:r = write(self.sink.value, wsrc.ptr, wsrc.len);\n            if (!r.is_error) { pass r.value; }\n            bool:retry = false;\n            if (r.err == WouldBlock)  { retry = true; }\n            if (r.err == Interrupted) { retry = true; }\n            if (!retry) { fail r.err; }\n            if (r.err == WouldBlock) {\n                int64:rem = give_up - (mono_now());\n                if (rem <= 0i64) { fail DeadlineExceeded; }\n                Result<NIL>:w = await io_ready((self.sink.value) =>! int32, 4i32,\n                                               raw duration_ns(rem));\n                if (w.is_error) { fail w.err; }\n            }\n        }\n    };\n    // Nothing is buffered at this layer (buffering is an explicit wrapper —\n    // IO_REFERENCE §4), so a flush has nothing to move — but the trait\n    // carries it so a buffered writer can stand wherever this one does.\n    async func:flush = NIL(ByteWriter->:self, Duration:_~within) {\n        pass NIL;\n    };\n};\n\n// SEEK (IO_REFERENCE §7): the new position, from an enum'd origin. lseek\n// does not block, so the deadline is carried for shape and unspent.\nimpl:ByteReader = {\n    async func:seek = int64(ByteReader->:self, Whence:w, int64:off, Duration:_~within) {\n        int64:wh = 0i64;\n        pick (w) {\n            (Whence.Start)   { wh = 0i64; },\n            (Whence.Current) { wh = 1i64; },\n            (Whence.End)     { wh = 2i64; }\n        }\n        int64:np = relay sys(8i64, (self.src.value) =>! int64, off, wh);\n        pass np;\n    };\n};\n\n// --- the text layer (D-185, 1.1.12c; IO_REFERENCE §3/§4/§8) -------------------\n//\n// LINE-ENDING POLICY BELONGS TO THE STREAM (D-050), and buffering is a TYPE\n// you chose, never a mode a field selects at runtime (the D-072 rejection)\n// and never inferred from a terminal (D-076): `TextWriter<W>` translates,\n// `LineBufWriter<W>` buffers by line, and composing them is spelling the\n// policy in the type. Readers translate unconditionally — `\\r\\n`, `\\n` and\n// a lone `\\r` all yield one line break; there is no reader knob to get\n// wrong. Writers write `\\n` unless created asking for `CrLf` — the\n// greppable opt-in.\npub enum:LineEnding = { Lf; CrLf; };\n\npub struct:LineBufWriter<BW: Writer> = { BW:inner; string:pend; };\npub struct:TextWriter<W: Writer> = { W:inner; LineEnding:ending; };\npub struct:TextReader<R: Reader> = { R:inner; string:acc; int64:pos; bool:pend_cr; bool:seen_eof; };\n\npub func:text_writer<W: Writer> = TextWriter<W>(move W:inner, LineEnding:e) never fails {\n    pass TextWriter{ inner: move(inner), ending: e };\n};\npub func:text_reader<R: Reader> = TextReader<R>(move R:inner) never fails {\n    pass TextReader{ inner: move(inner), acc: \"\", pos: 0i64,\n                     pend_cr: false, seen_eof: false };\n};\npub func:line_buf_writer<BW: Writer> = LineBufWriter<BW>(move BW:inner) never fails {\n    pass LineBufWriter{ inner: move(inner), pend: \"\" };\n};\n\n// EVERY BYTE REACHES THE INNER WRITER OR THE CALL FAILS. The trait's `write`\n// may be partial per call (POSIX's shape); a wrapper that translated a\n// buffer and delivered half of it would tear a line, so the wrappers loop.\nasync func:tw_write_all<W: Writer> = NIL(W->:sink, string:s, Duration:within) {\n    int64:give_up = (mono_now()) + within.ns;\n    int64:done = 0i64;\n    while (done < s.len) {\n        int64:rem = give_up - (mono_now());\n        if (rem <= 0i64) { fail DeadlineExceeded; }\n        string:sview = relay string_slice(s, done, s.len);\n        uint8[]:bytes = string_bytes(sview);\n        int64:n = relay await sink.write(bytes, raw duration_ns(rem));\n        done = done + n;\n    }\n    pass NIL;\n};\n\n// `text_write_str(@w, s, within)`: `\\n` becomes the writer's ending. The\n// free-function spelling is D-161's rule — an inherent impl over a family\n// cannot be spelled — with `W` inferred from the receiver (D-064).\npub async func:text_write_str<W: Writer> = NIL(TextWriter<W>->:tw, string:s, Duration:within) {\n    bool:crlf = false;\n    pick (tw.ending) {\n        (LineEnding.Lf)   { crlf = false; },\n        (LineEnding.CrLf) { crlf = true; }\n    }\n    if (!crlf) {\n        relay await tw_write_all(@(tw.inner), s, within);\n        pass NIL;\n    }\n    string:out = \"\";\n    int64:i = 0i64;\n    int64:seg = 0i64;\n    while (i < s.len) {\n        if (s.ptr[i] == 10u8) {\n            string:part = relay string_slice(s, seg, i);\n            out = string_concat(out, part);\n            out = string_concat(out, \"\\r\\n\");\n            seg = i + 1i64;\n        }\n        i = i + 1i64;\n    }\n    string:tail = relay string_slice(s, seg, s.len);\n    out = string_concat(out, tail);\n    relay await tw_write_all(@(tw.inner), out, within);\n    pass NIL;\n};\n\npub async func:text_write_line<W: Writer> = NIL(TextWriter<W>->:tw, string:s, Duration:within) {\n    relay await text_write_str(tw, s, within);\n    bool:crlf2 = false;\n    pick (tw.ending) {\n        (LineEnding.Lf)   { crlf2 = false; },\n        (LineEnding.CrLf) { crlf2 = true; }\n    }\n    if (crlf2) {\n        relay await tw_write_all(@(tw.inner), \"\\r\\n\", within);\n        pass NIL;\n    }\n    relay await tw_write_all(@(tw.inner), \"\\n\", within);\n    pass NIL;\n};\n\npub async func:text_flush<W: Writer> = NIL(TextWriter<W>->:tw, Duration:within) {\n    relay await tw.inner.flush(within);\n    pass NIL;\n};\n\n// ONE LINE, WITHOUT ITS TERMINATOR — `\\r\\n`, `\\n`, and a lone `\\r` are one\n// break (IO_REFERENCE §3), a `\\r` split from its `\\n` by a refill boundary\n// included. End of input: a final unterminated line is still a line;\n// `IoEof` only when nothing remains at all.\npub async func:text_read_line<R: Reader> = string(TextReader<R>->:tr, Duration:within) {\n    int64:give_up = (mono_now()) + within.ns;\n    while (true) {\n        // a pending `\\r` saw its `\\n` arrive: consume the second half\n        if (tr.pend_cr) {\n            if (tr.pos < tr.acc.len) {\n                tr.pend_cr = false;\n                if (tr.acc.ptr[tr.pos] == 10u8) { tr.pos = tr.pos + 1i64; }\n            }\n        }\n        // scan the unconsumed bytes for a break\n        int64:i = tr.pos;\n        while (i < tr.acc.len) {\n            uint8:c = tr.acc.ptr[i];\n            if (c == 10u8) {\n                string:line = relay string_slice(tr.acc, tr.pos, i);\n                tr.pos = i + 1i64;\n                pass line;\n            }\n            if (c == 13u8) {\n                string:line2 = relay string_slice(tr.acc, tr.pos, i);\n                tr.pos = i + 1i64;\n                if (tr.pos < tr.acc.len) {\n                    if (tr.acc.ptr[tr.pos] == 10u8) { tr.pos = tr.pos + 1i64; }\n                }\n                if (tr.pos >= tr.acc.len) {\n                    if (!tr.seen_eof) { tr.pend_cr = true; }\n                }\n                pass line2;\n            }\n            i = i + 1i64;\n        }\n        // no break in what we hold\n        if (tr.seen_eof) {\n            if (tr.pos >= tr.acc.len) { fail IoEof; }\n            string:last = relay string_slice(tr.acc, tr.pos, tr.acc.len);\n            tr.pos = tr.acc.len;\n            pass last;\n        }\n        // refill: drop consumed bytes, then ask the inner reader\n        tr.acc = relay string_slice(tr.acc, tr.pos, tr.acc.len);\n        tr.pos = 0i64;\n        int64:rem = give_up - (mono_now());\n        if (rem <= 0i64) { fail DeadlineExceeded; }\n        wild int8->:cbuf = alloc(512i64);\n        defer { dalloc(cbuf); }\n        uint8[]:cslice = #wild_slice<uint8>(cbuf =>! wild uint8->, 512i64);\n        Result<int64>:got = await tr.inner.read(cslice, raw duration_ns(rem));\n        if (got.is_error) {\n            if (got.err == IoEof) { tr.seen_eof = true; }\n            if (got.err != IoEof) { fail got.err; }\n        }\n        if (!got.is_error) {\n            string:fresh = string_from_bytes(cbuf, got.value);\n            tr.acc = string_concat(tr.acc, fresh);\n        }\n    }\n};\n\n// LINE BUFFERING AS A TYPE (§4): bytes gather until a `\\n`, then everything\n// through the LAST `\\n` goes down in one write. A partial line lives in the\n// buffer until its `\\n` or an explicit `flush` — and `defer` does not run\n// on a trap (D-014), so what a trap loses is exactly the partial line, as\n// §4.1 states. NOTE: a partial line also does not flush ITSELF at scope\n// exit (drops are generated, never user hooks) — finish lines or flush.\nimpl:<BW: Writer>:LineBufWriter<BW>:Writer = {\n    async func:write = int64(LineBufWriter<BW>->:self, fixed uint8[]:wsrc, Duration:within) {\n        string:added = string_from_bytes(wsrc.ptr =>! wild int8->, wsrc.len);\n        self.pend = string_concat(self.pend, added);\n        int64:nl = 0i64 - 1i64;\n        int64:i = 0i64;\n        while (i < self.pend.len) {\n            if (self.pend.ptr[i] == 10u8) { nl = i; }\n            i = i + 1i64;\n        }\n        if (nl >= 0i64) {\n            string:ship = relay string_slice(self.pend, 0i64, nl + 1i64);\n            self.pend = relay string_slice(self.pend, nl + 1i64, self.pend.len);\n            relay await tw_write_all(@(self.inner), ship, within);\n        }\n        pass wsrc.len;\n    };\n    async func:flush = NIL(LineBufWriter<BW>->:self, Duration:within) {\n        if (self.pend.len > 0i64) {\n            string:all = string_concat(self.pend, \"\");\n            self.pend = \"\";\n            relay await tw_write_all(@(self.inner), all, within);\n        }\n        relay await self.inner.flush(within);\n        pass NIL;\n    };\n};\n\n// TRANSLATION ON THE BYTE PATH TOO (§3: a text stream translates, always) —\n// `TextWriter` implements `Writer` so a buffered wrapper can stand inside\n// or outside it, and the byte-trait write is `text_write_str` over the\n// bytes read as text.\nimpl:<W: Writer>:TextWriter<W>:Writer = {\n    async func:write = int64(TextWriter<W>->:self, fixed uint8[]:wsrc, Duration:within) {\n        string:s = string_from_bytes(wsrc.ptr =>! wild int8->, wsrc.len);\n        relay await text_write_str(self, s, within);\n        pass wsrc.len;\n    };\n    async func:flush = NIL(TextWriter<W>->:self, Duration:within) {\n        relay await self.inner.flush(within);\n        pass NIL;\n    };\n};\n\n// THE STANDARD STREAMS (§8): built IN `main`'s scope by these constructors\n// and passed down — they are not globals. Each construction OWNS A DUP of\n// the inherited descriptor (F_DUPFD_CLOEXEC), so its scope-exit close can\n// never close descriptor 0/1/2 out from under anything else. Buffering per\n// §4, in the TYPE: stdout line-buffered always, stderr unbuffered always,\n// stdin buffered by its reader. The inherited descriptors stay BLOCKING —\n// O_NONBLOCK on them would ride the shared open-file description into the\n// parent process (a real-world footgun) — so a write to a stuffed stdout\n// pipe blocks the thread, bounded by the consumer, exactly as every unix\n// tool is; that stated exception to D-071 lives here and nowhere else.\nfunc:std_dup = OwnedFd(int32:which) {\n    // fcntl(fd, F_DUPFD_CLOEXEC = 1030, 0)\n    int64:d = relay sys(72i64, which => int64, 1030i64, 0i64);\n    pass own_fd((d =>! int32) =>! fd);\n};\n\npub func:std_in = TextReader<ByteReader>() {\n    OwnedFd:d = relay std_dup(0i32);\n    pass (raw text_reader(ByteReader{ src: move(d) }));\n};\npub func:std_out = TextWriter<LineBufWriter<ByteWriter>>() {\n    OwnedFd:d = relay std_dup(1i32);\n    pass (raw text_writer(raw line_buf_writer(ByteWriter{ sink: move(d) }), LineEnding.Lf));\n};\npub func:std_err = TextWriter<ByteWriter>() {\n    OwnedFd:d = relay std_dup(2i32);\n    pass (raw text_writer(ByteWriter{ sink: move(d) }, LineEnding.Lf));\n};\n\n// A `tfp`'S EXACT DECIMAL (D-195, §6b's discipline continued): a Q value is\n// a binary fraction whose decimal expansion is finite (≤ F digits), and the\n// canonical rendering IS that exact expansion — determinism is the family's\n// whole point, so \"shortest that round-trips\" (a float concept) does not\n// apply. One `uint256` core serves every width: the fraction's digits fall\n// out of repeated ×10-and-shift (never division), the integer half through\n// divmod-10 at width (inline-expanded, no libcall). \"ERR\" renders the\n// sentinel; the sign rides the raw carrier's.\npub func:tfp_render = string(bool:neg, uint256:ipart, uint256:frac,\n                             uint64:fbits) never fails {\n    string:ip = \"\";\n    if (ipart == 0u256) { ip = \"0\"; }\n    uint256:n = ipart;\n    while (n != 0u256) {\n        uint256:q = n / 10u256;\n        uint256:r = n - (q * 10u256);\n        ip = string_concat(raw digit_char((r =>! uint64)), ip);\n        n = q;\n    }\n    string:fp = \"\";\n    int64:emitted = 0i64;\n    int64:lastnz = 0i64;\n    uint256:f = frac;\n    uint256:mask = (1u256 << (fbits => uint256)) - 1u256;\n    while (emitted < (fbits =>! int64)) {\n        if (f == 0u256) { emitted = fbits =>! int64; } else {\n            uint256:t = f * 10u256;\n            uint256:d = t >> (fbits => uint256);\n            f = t & mask;\n            fp = string_concat(fp, raw digit_char((d =>! uint64)));\n            emitted = emitted + 1i64;\n            if (d != 0u256) { lastnz = emitted; }\n        }\n    }\n    if (lastnz == 0i64) { fp = \"0\"; }\n    if (lastnz > 0i64) {\n        if (lastnz < fp.len) {\n            fp = string_slice(fp, 0i64, lastnz) ?| \"0\";\n        }\n    }\n    string:out = \"\";\n    if (neg) { out = \"-\"; }\n    out = string_concat(out, ip);\n    out = string_concat(out, \".\");\n    pass (string_concat(out, fp));\n};\n\nimpl:tfp32:ToString = { func:to_string = string(tfp32:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    wild int8->:b = alloc(4i64);\n    wild tfp32->:tp = b =>! wild tfp32->;\n    <-tp = self;\n    wild int32->:ip2 = b =>! wild int32->;\n    int32:rawv = <-ip2;\n    dalloc(b);\n    bool:neg = false;\n    if (rawv < 0i32) { neg = true; rawv = 0i32 - rawv; }\n    uint256:mag = (rawv =>! uint32) => uint256;\n    pass (raw tfp_render(neg, mag >> 16u256, mag & 65535u256, 16u64));\n}; };\nimpl:tfp64:ToString = { func:to_string = string(tfp64:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    wild int8->:b = alloc(8i64);\n    wild tfp64->:tp = b =>! wild tfp64->;\n    <-tp = self;\n    wild int64->:ip2 = b =>! wild int64->;\n    int64:rawv = <-ip2;\n    dalloc(b);\n    bool:neg = false;\n    if (rawv < 0i64) { neg = true; rawv = 0i64 - rawv; }\n    uint256:mag = (rawv =>! uint64) => uint256;\n    pass (raw tfp_render(neg, mag >> 32u256, mag & 4294967295u256, 32u64));\n}; };\nimpl:tfp128:ToString = { func:to_string = string(tfp128:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    wild int8->:b = alloc(16i64);\n    wild tfp128->:tp = b =>! wild tfp128->;\n    <-tp = self;\n    wild int128->:ip2 = b =>! wild int128->;\n    int128:rawv = <-ip2;\n    dalloc(b);\n    bool:neg = false;\n    if (rawv < 0i128) { neg = true; rawv = 0i128 - rawv; }\n    uint256:mag = (rawv =>! uint128) => uint256;\n    uint256:fmask = (1u256 << 64u256) - 1u256;\n    pass (raw tfp_render(neg, mag >> 64u256, mag & fmask, 64u64));\n}; };\nimpl:tfp256:ToString = { func:to_string = string(tfp256:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    wild int8->:b = alloc(32i64);\n    wild tfp256->:tp = b =>! wild tfp256->;\n    <-tp = self;\n    wild int256->:ip2 = b =>! wild int256->;\n    int256:rawv = <-ip2;\n    dalloc(b);\n    bool:neg = false;\n    if (rawv < 0i256) { neg = true; rawv = 0i256 - rawv; }\n    uint256:mag = rawv =>! uint256;\n    uint256:fmask2 = (1u256 << 128u256) - 1u256;\n    pass (raw tfp_render(neg, mag >> 128u256, mag & fmask2, 128u64));\n}; };\n\n// THE SI DERIVED UNITS (D-196, 1.3.3). The seven base names are\n// compiler-known — Kilograms, Meters, Seconds, Amperes, Kelvin, Moles,\n// Candela — and everything else is THIS: the same `unit:` declaration any\n// program writes, which is the point. One mechanism, exercised by the\n// prelude itself. A name is a name for a VECTOR — `Hertz` and `Becquerels`\n// naming the same vector is physics, not a conflict, and diagnostics render\n// the base-product form rather than guessing which name was meant.\n// `Radians` and `Steradians` are the DIMENSIONLESS ratios, so `dim256<Radians>`\n// IS `tfp256` — honest, and exactly what the algebra says.\npub unit:Radians = 1;\npub unit:Steradians = 1;\npub unit:Hertz = 1 / Seconds;\npub unit:Newtons = Kilograms * Meters / (Seconds * Seconds);\npub unit:Pascals = Newtons / (Meters * Meters);\npub unit:Joules = Newtons * Meters;\npub unit:Watts = Joules / Seconds;\npub unit:Coulombs = Amperes * Seconds;\npub unit:Volts = Watts / Amperes;\npub unit:Farads = Coulombs / Volts;\npub unit:Ohms = Volts / Amperes;\npub unit:Siemens = Amperes / Volts;\npub unit:Webers = Volts * Seconds;\npub unit:Teslas = Webers / (Meters * Meters);\npub unit:Henries = Webers / Amperes;\npub unit:Lumens = Candela * Steradians;\npub unit:Lux = Lumens / (Meters * Meters);\npub unit:Becquerels = 1 / Seconds;\npub unit:Grays = Joules / Kilograms;\npub unit:Sieverts = Joules / Kilograms;\npub unit:Katals = Moles / Seconds;\npub unit:MetersPerSecond = Meters / Seconds;\npub unit:MetersPerSecondSquared = Meters / (Seconds * Seconds);\n\n// THE FRAC CORE (D-198, 1.3.5): the exact-rational algorithms, in Nitpick,\n// in int256 — ONE implementation for all four widths, the width's balanced\n// bound a parameter, `ok` the answer to \"does the reduced form fit\". The\n// EMITTER lowers the frac operators to calls of these (every prelude\n// function emits into every program under its deterministic symbol), so the\n// arithmetic a verifier reads is this source, not hand-written IR. int256\n// because frac64's cross-products reach 2^127 and their SUM overflows i128;\n// nothing below can overflow 256 bits (the largest intermediate is a mul\n// product at ~2^254). The core is TAINT-BLIND: the emitter tests the\n// operands' ERR and discards the result under taint — stickiness is the\n// caller's, exactness is ours.\npub struct:FracParts = {\n    bool:ok;\n    int256:whole;\n    int256:num;\n    int256:denom;\n};\n\nfunc:frac_bad = FracParts() never fails {\n    FracParts:b = FracParts{ ok: false, whole: 0i256, num: 0i256, denom: 0i256 };\n    pass b;\n};\n\npub func:npk_gcd256 = int256(int256:a, int256:b) never fails {\n    int256:x = a;\n    int256:y = b;\n    while (y != 0i256) {\n        int256:t = x % y;\n        x = y;\n        y = t;\n    }\n    pass x;\n};\n\n// Canonical form — D-198's five invariants — from any {w, n, d} with d > 0;\n// d ≤ 0 is ERR (`ok: false`), and so is a reduced form whose components\n// exceed the width's bounds: \"exact or ERR\", never rounded. The width's\n// valid component ranges are balanced (±bound for whole and num — the\n// most-negative is the sentinel) and 1..2·bound+1 for the unsigned denom.\npub func:npk_frac_norm = FracParts(int256:w0, int256:n0, int256:d0,\n                                   int256:bound) never fails {\n    if (d0 <= 0i256) { pass (raw frac_bad()); }\n    int256:w = w0;\n    int256:n = n0;\n    int256:d = d0;\n    if (n < 0i256) {\n        int256:an = 0i256 - n;\n        if (an >= d) {\n            w = w - (an / d);\n            n = 0i256 - (an % d);\n        }\n    } else {\n        if (n >= d) {\n            w = w + (n / d);\n            n = n % d;\n        }\n    }\n    if (n != 0i256) {\n        int256:an2 = n;\n        if (an2 < 0i256) { an2 = 0i256 - an2; }\n        int256:g = raw npk_gcd256(an2, d);\n        if (g > 1i256) {\n            n = n / g;\n            d = d / g;\n        }\n    } else {\n        d = 1i256;\n    }\n    if (w != 0i256) {\n        if (n < 0i256) {\n            w = w - 1i256;\n            n = d + n;\n        }\n    }\n    if (w > bound)                     { pass (raw frac_bad()); }\n    if (w < (0i256 - bound))           { pass (raw frac_bad()); }\n    if (n > bound)                     { pass (raw frac_bad()); }\n    if (n < (0i256 - bound))           { pass (raw frac_bad()); }\n    if (d > ((2i256 * bound) + 1i256)) { pass (raw frac_bad()); }\n    FracParts:out = FracParts{ ok: true, whole: w, num: n, denom: d };\n    pass out;\n};\n\n// The improper form w·d + n — exact under the sign convention for negatives\n// too: -2 + 5/8 is -11 over 8.\nfunc:frac_improper = int256(int256:w, int256:n, int256:d) never fails {\n    pass ((w * d) + n);\n};\n\npub func:npk_frac_add = FracParts(int256:aw, int256:an, int256:ad,\n                                  int256:bw, int256:bn, int256:bd,\n                                  int256:bound) never fails {\n    if (ad <= 0i256) { pass (raw frac_bad()); }\n    if (bd <= 0i256) { pass (raw frac_bad()); }\n    pass (raw npk_frac_norm(aw + bw, (an * bd) + (bn * ad), ad * bd, bound));\n};\n\npub func:npk_frac_sub = FracParts(int256:aw, int256:an, int256:ad,\n                                  int256:bw, int256:bn, int256:bd,\n                                  int256:bound) never fails {\n    if (ad <= 0i256) { pass (raw frac_bad()); }\n    if (bd <= 0i256) { pass (raw frac_bad()); }\n    pass (raw npk_frac_norm(aw - bw, (an * bd) - (bn * ad), ad * bd, bound));\n};\n\npub func:npk_frac_mul = FracParts(int256:aw, int256:an, int256:ad,\n                                  int256:bw, int256:bn, int256:bd,\n                                  int256:bound) never fails {\n    if (ad <= 0i256) { pass (raw frac_bad()); }\n    if (bd <= 0i256) { pass (raw frac_bad()); }\n    int256:pa = raw frac_improper(aw, an, ad);\n    int256:pb = raw frac_improper(bw, bn, bd);\n    pass (raw npk_frac_norm(0i256, pa * pb, ad * bd, bound));\n};\n\npub func:npk_frac_div = FracParts(int256:aw, int256:an, int256:ad,\n                                  int256:bw, int256:bn, int256:bd,\n                                  int256:bound) never fails {\n    if (ad <= 0i256) { pass (raw frac_bad()); }\n    if (bd <= 0i256) { pass (raw frac_bad()); }\n    int256:pa = raw frac_improper(aw, an, ad);\n    int256:pb = raw frac_improper(bw, bn, bd);\n    // Division by an exact zero is ERR (D-007's twisted row): pb = 0 makes\n    // the new denominator 0, which `norm` refuses — but the sign fix below\n    // must not run on it, so it is said here too.\n    int256:nn = pa * bd;\n    int256:nd = ad * pb;\n    if (nd == 0i256) { pass (raw frac_bad()); }\n    if (nd < 0i256) {\n        nn = 0i256 - nn;\n        nd = 0i256 - nd;\n    }\n    pass (raw npk_frac_norm(0i256, nn, nd, bound));\n};\n\n// Exact three-way comparison by cross-multiplied improper forms — the\n// common denominator ad·bd is positive, so the numerators' order IS the\n// values'. -1, 0, 1.\npub func:npk_frac_cmp = int32(int256:aw, int256:an, int256:ad,\n                              int256:bw, int256:bn, int256:bd) never fails {\n    int256:pa = (raw frac_improper(aw, an, ad)) * bd;\n    int256:pb = (raw frac_improper(bw, bn, bd)) * ad;\n    if (pa < pb) { pass (0i32 - 1i32); }\n    if (pa > pb) { pass 1i32; }\n    pass 0i32;\n};\n\n// A frac RENDERS ITS MIXED NUMBER (D-198, D-168): \"3 1/3\", \"-2 5/8\", \"0\",\n// \"ERR\" — exact by construction; the sign rides whole, or num when whole\n// is 0. The members are the read-only component views (1.3.5).\nimpl:frac8:ToString = { func:to_string = string(frac8:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    if (self.num == 0i8) { pass (int_to_string(self.whole => int64)); }\n    string:head = \"\";\n    if (self.whole != 0i8) {\n        head = string_concat(int_to_string(self.whole => int64), \" \");\n    }\n    string:fr = string_concat(int_to_string(self.num => int64), \"/\");\n    pass (string_concat(head,\n              string_concat(fr, raw uint_to_decimal(self.denom => uint64))));\n}; };\nimpl:frac16:ToString = { func:to_string = string(frac16:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    if (self.num == 0i16) { pass (int_to_string(self.whole => int64)); }\n    string:head = \"\";\n    if (self.whole != 0i16) {\n        head = string_concat(int_to_string(self.whole => int64), \" \");\n    }\n    string:fr = string_concat(int_to_string(self.num => int64), \"/\");\n    pass (string_concat(head,\n              string_concat(fr, raw uint_to_decimal(self.denom => uint64))));\n}; };\nimpl:frac32:ToString = { func:to_string = string(frac32:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    if (self.num == 0i32) { pass (int_to_string(self.whole => int64)); }\n    string:head = \"\";\n    if (self.whole != 0i32) {\n        head = string_concat(int_to_string(self.whole => int64), \" \");\n    }\n    string:fr = string_concat(int_to_string(self.num => int64), \"/\");\n    pass (string_concat(head,\n              string_concat(fr, raw uint_to_decimal(self.denom => uint64))));\n}; };\nimpl:frac64:ToString = { func:to_string = string(frac64:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    if (self.num == 0i64) { pass (int_to_string(self.whole)); }\n    string:head = \"\";\n    if (self.whole != 0i64) {\n        head = string_concat(int_to_string(self.whole), \" \");\n    }\n    string:fr = string_concat(int_to_string(self.num), \"/\");\n    pass (string_concat(head,\n              string_concat(fr, raw uint_to_decimal(self.denom))));\n}; };\n\n// THE COMPLEX CORES (D-199, 1.3.6): per element type, in Nitpick — the tfp\n// bodies use the LANGUAGE'S OWN tfp operators, so Q scaling, saturation and\n// stickiness arrive for free and the any-component-ERR → BOTH\n// canonicalization is an explicit line a verifier reads; the float bodies\n// are IEEE-total, with division by SMITH'S algorithm — the naive formula\n// overflows at |denominator| ≈ √max, a silent-wrong-answer class. flt32\n// computes IN flt32: widening through double would double-round. The\n// emitter unpacks `complex<T>`'s `{T, T}`, calls the deterministic prelude\n// symbol, and the returned pair IS the value.\n\npub struct:CplxF32 = {\n    flt32:re;\n    flt32:im;\n};\n\npub func:npk_cplx_add_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\n    CplxF32:r = CplxF32{ re: a + c, im: b + d };\n    pass r;\n};\n\npub func:npk_cplx_sub_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\n    CplxF32:r = CplxF32{ re: a - c, im: b - d };\n    pass r;\n};\n\npub func:npk_cplx_mul_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\n    CplxF32:r = CplxF32{ re: (a * c) - (b * d), im: (a * d) + (b * c) };\n    pass r;\n};\n\n// Smith's algorithm: scale by the larger of |c|, |d| so the denominator\n// never overflows where the value itself is representable.\npub func:npk_cplx_div_f32 = CplxF32(flt32:a, flt32:b, flt32:c, flt32:d) never fails {\n    flt32:ac = c;\n    if (ac < 0.0f32) { ac = 0.0f32 - ac; }\n    flt32:ad = d;\n    if (ad < 0.0f32) { ad = 0.0f32 - ad; }\n    if (ac >= ad) {\n        flt32:ratio = d / c;\n        flt32:den = c + (d * ratio);\n        CplxF32:r = CplxF32{ re: (a + (b * ratio)) / den,\n                                  im: (b - (a * ratio)) / den };\n        pass r;\n    }\n    flt32:ratio2 = c / d;\n    flt32:den2 = (c * ratio2) + d;\n    CplxF32:r2 = CplxF32{ re: ((a * ratio2) + b) / den2,\n                               im: ((b * ratio2) - a) / den2 };\n    pass r2;\n};\n\npub func:npk_cplx_abs2_f32 = flt32(flt32:a, flt32:b) never fails {\n    pass ((a * a) + (b * b));\n};\n\npub struct:CplxF64 = {\n    flt64:re;\n    flt64:im;\n};\n\npub func:npk_cplx_add_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\n    CplxF64:r = CplxF64{ re: a + c, im: b + d };\n    pass r;\n};\n\npub func:npk_cplx_sub_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\n    CplxF64:r = CplxF64{ re: a - c, im: b - d };\n    pass r;\n};\n\npub func:npk_cplx_mul_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\n    CplxF64:r = CplxF64{ re: (a * c) - (b * d), im: (a * d) + (b * c) };\n    pass r;\n};\n\n// Smith's algorithm: scale by the larger of |c|, |d| so the denominator\n// never overflows where the value itself is representable.\npub func:npk_cplx_div_f64 = CplxF64(flt64:a, flt64:b, flt64:c, flt64:d) never fails {\n    flt64:ac = c;\n    if (ac < 0.0f64) { ac = 0.0f64 - ac; }\n    flt64:ad = d;\n    if (ad < 0.0f64) { ad = 0.0f64 - ad; }\n    if (ac >= ad) {\n        flt64:ratio = d / c;\n        flt64:den = c + (d * ratio);\n        CplxF64:r = CplxF64{ re: (a + (b * ratio)) / den,\n                                  im: (b - (a * ratio)) / den };\n        pass r;\n    }\n    flt64:ratio2 = c / d;\n    flt64:den2 = (c * ratio2) + d;\n    CplxF64:r2 = CplxF64{ re: ((a * ratio2) + b) / den2,\n                               im: ((b * ratio2) - a) / den2 };\n    pass r2;\n};\n\npub func:npk_cplx_abs2_f64 = flt64(flt64:a, flt64:b) never fails {\n    pass ((a * a) + (b * b));\n};\n\npub struct:CplxT32 = {\n    tfp32:re;\n    tfp32:im;\n};\n\n// The tfp cores canonicalize: any component ERR makes BOTH ERR (D-199 —\n// half a taint steering the other half is the hole stickiness closes).\nfunc:cplx_fix_t32 = CplxT32(tfp32:re2, tfp32:im2) never fails {\n    if (is_err(re2)) {\n        CplxT32:e = CplxT32{ re: ERR, im: ERR };\n        pass e;\n    }\n    if (is_err(im2)) {\n        CplxT32:e2 = CplxT32{ re: ERR, im: ERR };\n        pass e2;\n    }\n    CplxT32:ok = CplxT32{ re: re2, im: im2 };\n    pass ok;\n};\n\npub func:npk_cplx_add_t32 = CplxT32(tfp32:a, tfp32:b, tfp32:c, tfp32:d) never fails {\n    pass (raw cplx_fix_t32(a + c, b + d));\n};\n\npub func:npk_cplx_sub_t32 = CplxT32(tfp32:a, tfp32:b, tfp32:c, tfp32:d) never fails {\n    pass (raw cplx_fix_t32(a - c, b - d));\n};\n\npub func:npk_cplx_mul_t32 = CplxT32(tfp32:a, tfp32:b, tfp32:c, tfp32:d) never fails {\n    pass (raw cplx_fix_t32((a * c) - (b * d), (a * d) + (b * c)));\n};\n\n// The direct formulas (D-199): the elements' own division carries the ERR\n// discipline — a zero denominator IS the tfp zero-divisor rule.\npub func:npk_cplx_div_t32 = CplxT32(tfp32:a, tfp32:b, tfp32:c, tfp32:d) never fails {\n    tfp32:den = (c * c) + (d * d);\n    pass (raw cplx_fix_t32(((a * c) + (b * d)) / den,\n                                     ((b * c) - (a * d)) / den));\n};\n\npub func:npk_cplx_abs2_t32 = tfp32(tfp32:a, tfp32:b) never fails {\n    tfp32:s = (a * a) + (b * b);\n    if (is_err(s)) { pass ERR; }\n    pass s;\n};\n\npub struct:CplxT64 = {\n    tfp64:re;\n    tfp64:im;\n};\n\n// The tfp cores canonicalize: any component ERR makes BOTH ERR (D-199 —\n// half a taint steering the other half is the hole stickiness closes).\nfunc:cplx_fix_t64 = CplxT64(tfp64:re2, tfp64:im2) never fails {\n    if (is_err(re2)) {\n        CplxT64:e = CplxT64{ re: ERR, im: ERR };\n        pass e;\n    }\n    if (is_err(im2)) {\n        CplxT64:e2 = CplxT64{ re: ERR, im: ERR };\n        pass e2;\n    }\n    CplxT64:ok = CplxT64{ re: re2, im: im2 };\n    pass ok;\n};\n\npub func:npk_cplx_add_t64 = CplxT64(tfp64:a, tfp64:b, tfp64:c, tfp64:d) never fails {\n    pass (raw cplx_fix_t64(a + c, b + d));\n};\n\npub func:npk_cplx_sub_t64 = CplxT64(tfp64:a, tfp64:b, tfp64:c, tfp64:d) never fails {\n    pass (raw cplx_fix_t64(a - c, b - d));\n};\n\npub func:npk_cplx_mul_t64 = CplxT64(tfp64:a, tfp64:b, tfp64:c, tfp64:d) never fails {\n    pass (raw cplx_fix_t64((a * c) - (b * d), (a * d) + (b * c)));\n};\n\n// The direct formulas (D-199): the elements' own division carries the ERR\n// discipline — a zero denominator IS the tfp zero-divisor rule.\npub func:npk_cplx_div_t64 = CplxT64(tfp64:a, tfp64:b, tfp64:c, tfp64:d) never fails {\n    tfp64:den = (c * c) + (d * d);\n    pass (raw cplx_fix_t64(((a * c) + (b * d)) / den,\n                                     ((b * c) - (a * d)) / den));\n};\n\npub func:npk_cplx_abs2_t64 = tfp64(tfp64:a, tfp64:b) never fails {\n    tfp64:s = (a * a) + (b * b);\n    if (is_err(s)) { pass ERR; }\n    pass s;\n};\n\n// A COMPLEX RENDERS \"3+4i\" / \"3-4i\" via the element's own rendering\n// (D-199); a tfp-element ERR pair renders \"ERR\". The sign splice reads the\n// imaginary component: negative imaginaries render their magnitude behind\n// `-`, everything else behind `+` (a float NaN imaginary lands on `+nan i`,\n// which is the honest reading of an unordered sign).\nimpl:complex<flt32>:ToString = { func:to_string = string(complex<flt32>:self) never fails {\n    flt32:im2 = self.im();\n    string:sign = \"+\";\n    if (im2 < 0.0f32) { sign = \"-\"; im2 = 0.0f32 - im2; }\n    string:h = string_concat(`&{self.re()}`, sign);\n    pass (string_concat(h, string_concat(`&{im2}`, \"i\")));\n}; };\nimpl:complex<flt64>:ToString = { func:to_string = string(complex<flt64>:self) never fails {\n    flt64:im2 = self.im();\n    string:sign = \"+\";\n    if (im2 < 0.0f64) { sign = \"-\"; im2 = 0.0f64 - im2; }\n    string:h = string_concat(`&{self.re()}`, sign);\n    pass (string_concat(h, string_concat(`&{im2}`, \"i\")));\n}; };\nimpl:complex<tfp32>:ToString = { func:to_string = string(complex<tfp32>:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    tfp32:im2 = self.im();\n    string:sign = \"+\";\n    if (im2 < 0.0tfp32) { sign = \"-\"; im2 = 0.0tfp32 - im2; }\n    string:h = string_concat(`&{self.re()}`, sign);\n    pass (string_concat(h, string_concat(`&{im2}`, \"i\")));\n}; };\nimpl:complex<tfp64>:ToString = { func:to_string = string(complex<tfp64>:self) never fails {\n    if (is_err(self)) { pass \"ERR\"; }\n    tfp64:im2 = self.im();\n    string:sign = \"+\";\n    if (im2 < 0.0tfp64) { sign = \"-\"; im2 = 0.0tfp64 - im2; }\n    string:h = string_concat(`&{self.re()}`, sign);\n    pass (string_concat(h, string_concat(`&{im2}`, \"i\")));\n}; };\n"; };
