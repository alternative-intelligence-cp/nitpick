// Decorations: attributes, `limit<Rule>`, contracts, and loop invariants.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.2.5.
//
// These four attach to things rather than being things. Attributes and `limit`
// decorate BOTH declarations and statements -- `#[align(16)]` on a struct and
// `limit<r_pos> int32:x = 5i32;` on a local -- so they cannot live in either
// parser without the other importing it.
//
// That is why this module exists. Putting them in the declaration parser would
// make the statement parser import it, and the declaration parser already
// imports the statement parser for function bodies: a cycle, created for no
// reason other than where the code was written. A shared lower layer costs one
// file and removes the question.
//
// Everything here parses to a VERIFICATION node (AST_REFERENCE section 5) except
// attributes, which are declaration nodes (section 6) because that array is
// already where declaration sub-structures live.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token_name.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./parse_codes.npk".*;
use "./parser.npk".*;
use "./parse_type.npk".*;
use "./parse_expr.npk".*;

// --- accessors ------------------------------------------------------------------

pub func:CONTRACT_REQUIRES = int32() never fails { pass 1i32; };
pub func:CONTRACT_ENSURES = int32() never fails  { pass 2i32; };

// `acquires N` and `acquires <= N` — the third contract kind (D-113, D-056).
//
// TWO FORMS, ONE KEYWORD, AND THE DIFFERENCE IS WHAT THEY CLAIM. `acquires N`
// states a FACT: this function takes lock level N. `acquires <= N` states a
// BOUND: whatever this function reaches takes nothing above N, which is what a
// trait method declares so that a call through a trait object has a finite
// acquisition set instead of an unbounded one.
//
// A declaration and an obligation on the same axis, which is why they share a
// keyword rather than getting two — and the `<=` is what a reader sees the
// difference in, at the point where it matters.
pub func:CONTRACT_ACQUIRES = int32() never fails { pass 3i32; };

// Set on an `acquires` contract whose form is `<= N` rather than bare `N`.
pub func:CONTRACT_BOUNDED = int32() never fails  { pass 1i32; };

pub func:contract_kind = int32(VerifyNode:v) never fails { pass v.a; };
pub func:contract_cond = ExprId(VerifyNode:v) never fails { ExprId:e = ExprId{ index: v.b }; pass e; };

// Is this `acquires` clause the `<= N` form? Named rather than read as `v.c != 0`
// at each site, because a raw slot read is a comment that cannot be checked.
pub func:contract_is_bounded = bool(VerifyNode:v) never fails {
    pass ((v.c & (raw CONTRACT_BOUNDED())) != 0i32);
};
pub func:invariant_start = int32(VerifyNode:v) never fails { pass v.b; };
pub func:invariant_count = int32(VerifyNode:v) never fails { pass v.c; };
pub func:limit_rule = int32(VerifyNode:v) never fails { pass (v.payload =>! int32); };

// THE `Rules` DECLARATION A `limit<name>` RESOLVED TO (1.5.1, D-220): slot
// `a`, written exactly once by `resolve_limit` the way an identifier's binding
// is written onto `ExprNode.a`, and `decl_none()` until then — so "this limit
// is unbound" is a value every later pass can ask for rather than a name it
// would have to look up again. The parser leaves the slot zero on purpose.
pub func:limit_target = DeclId(VerifyNode:v) never fails { DeclId:d = DeclId{ index: v.a }; pass d; };

pub func:attr_arg_start = int32(DeclNode:d) never fails { pass d.b; };
pub func:attr_arg_count = int32(DeclNode:d) never fails { pass d.c; };
pub func:attr_name = int32(DeclNode:d) never fails { pass (d.payload =>! int32); };

// --- attributes ------------------------------------------------------------------
//
// `#[name]` and `#[name(args)]`. `#` is one token and the `[` is what separates
// an attribute from `#name(…)`, which is a builtin or a macro invocation (D-020,
// D-046) -- so one token of lookahead decides, with no speculative parse.
pub func:p_at_attribute = bool(Parser->:p) never fails {
    if (!(raw p_at(p, TokenKind.Hash))) { pass false; }
    pass ((raw p_peek_at(p, 1i64)).kind == TokenKind.PLBracket);
};

// AN ATTRIBUTE'S NAME IS ALWAYS AN INTERN INDEX, whatever kind of token spelled it.
//
// `derive` IS A KEYWORD, and the lexer gives a keyword token a payload of ZERO —
// only an identifier gets an intern index. So `#[derive(Eq)]` and `#[align(16i32)]`
// stored their names in two different ways, and the first stored no name at all:
// reading `attr_name` on a derive returned 0, and every consumer that asked "is
// this the derive attribute" got the empty string and said no.
//
// It was invisible for as long as nothing read an attribute's name, which was until
// 0.6.5. Interning the keyword's spelling here means one representation with one
// reading, rather than a slot that means an intern index on some attributes and
// nothing on others.
func:p_attr_name = int32(Parser->:p, Token:name) never fails {
    if (name.payload != 0i64) { pass ((name.payload) =>! int32); }
    pass (raw intern_add(p.interns, raw token_kind_name(name.kind)));
};

pub func:p_parse_attribute = DeclId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    discard(raw p_expect(p, TokenKind.Hash));
    discard(raw p_expect(p, TokenKind.PLBracket));
    Token:name = raw p_advance(p);
    int32:mark = raw ast_scratch_mark(p.ast);
    if (raw p_accept(p, TokenKind.PLParen)) {
        if (!(raw p_at(p, TokenKind.PRParen))) {
            ExprId:a1 = raw p_parse_expr(p);
            drop ast_scratch_push(p.ast, a1.index);
            while (raw p_accept(p, TokenKind.PComma)) {
                ExprId:argN = raw p_parse_expr(p);
                drop ast_scratch_push(p.ast, argN.index);
            }
        }
        discard(raw p_expect(p, TokenKind.PRParen));
    }
    discard(raw p_expect(p, TokenKind.PRBracket));
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_decl(p.ast, DeclKind.DeclAttribute, sp,
                             0i32, w.start, w.count,
                             (raw p_attr_name(p, name)) => int64));
};

// Gather however many attributes precede something.
pub func:p_parse_attributes = IdSpan(Parser->:p) never fails {
    int32:mark = raw ast_scratch_mark(p.ast);
    while (raw p_at_attribute(p)) {
        DeclId:a = raw p_parse_attribute(p);
        drop ast_scratch_push(p.ast, a.index);
    }
    pass (raw ast_scratch_commit(p.ast, mark));
};

// --- `limit<Rule>` -----------------------------------------------------------------
//
// Binds a `Rules` block to a declaration or parameter. Enforced in EVERY build;
// `--verify` decides only whether the obligation is discharged statically or
// checked at runtime (D-068). That is why it is a node on the declaration and
// not a comment on it -- a build without the verifier still has to emit the
// check.
pub func:p_parse_limit = VerifyId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    discard(raw p_expect(p, TokenKind.KwLimit));
    discard(raw p_expect(p, TokenKind.OpLt));
    Token:rule = raw p_advance(p);
    discard(raw p_expect_gt(p));
    pass (raw ast_add_verify(p.ast, VerifyKind.VerifyLimitNode, sp,
                               0i32, 0i32, 0i32, rule.payload));
};

// --- contracts -----------------------------------------------------------------------
//
// `requires` / `ensures`, between a function's parameter list and its body.
// Predicates are UNPARENTHESISED, matching the FFI contracts and unlike
// `if` / `while`. The line is drawn by position rather than taste:
// expression-site conditions take parentheses, declaration-site contracts take
// keywords and bare predicates (D-002).
pub func:p_parse_contracts = IdSpan(Parser->:p) never fails {
    int32:mark = raw ast_scratch_mark(p.ast);
    while (true) {
        Span:sp = raw p_span(p);
        // `never fails` (D-163) — a marker contract with no predicate, filed in
        // the contracts window as `VerifyNeverFails`. The body check reads it.
        // A following `requires`/`ensures` still parses (the grammar is never
        // partial, D-085); the body check is what refuses the combination.
        if (raw p_at(p, TokenKind.KwNever)) {
            discard(raw p_advance(p));
            discard(raw p_expect(p, TokenKind.KwFails));
            VerifyId:nf = raw ast_add_verify(p.ast, VerifyKind.VerifyNeverFails, sp,
                                               0i32, 0i32, 0i32, 0i64);
            drop ast_scratch_push(p.ast, nf.index);
        } else {
            // `gives` (D-183, 1.2.6) — a marker contract: the return value
            // HANDS ITS CHANNELS TO THE CALLER, whose function exit owns
            // their reclaim. Without it, a channel-returning function is a
            // getter — a view of channels owned elsewhere — and CREATING a
            // channel inside one is the type error that keeps the silent
            // process-lifetime leak unreachable.
            if (raw p_at(p, TokenKind.KwGives)) {
                discard(raw p_advance(p));
                VerifyId:gv = raw ast_add_verify(p.ast, VerifyKind.VerifyGives, sp,
                                                   0i32, 0i32, 0i32, 0i64);
                drop ast_scratch_push(p.ast, gv.index);
                continue;
            }
            // `pure` (1.5.1, D-221, S-15) — a marker clause: the body is a
            // function of its arguments and nothing else. Checked in the
            // body (TYPE-061), read by name where a contract calls it.
            if (raw p_at(p, TokenKind.KwPure)) {
                discard(raw p_advance(p));
                VerifyId:pv = raw ast_add_verify(p.ast, VerifyKind.VerifyPure, sp,
                                                   0i32, 0i32, 0i32, 0i64);
                drop ast_scratch_push(p.ast, pv.index);
                continue;
            }
            // `joins <const Duration>` (D-181) — a thread's join deadline,
            // stated where its executor is created (D-083). A marker-plus-
            // expression clause: the deadline is an ordinary constant
            // expression, and the body check is what requires it to be one.
            if (raw p_at(p, TokenKind.KwJoins)) {
                discard(raw p_advance(p));
                ExprId:jd = raw p_parse_expr(p);
                // THE DEADLINE GOES IN SLOT `b` — where `contract_cond`
                // reads every other clause's expression. Putting it in `a`
                // (the kind slot) made resolve walk `expr_none`, so the
                // name was never bound and the emitter met an unresolved
                // identifier: a clause the walkers cannot see is a clause
                // that silently does nothing.
                VerifyId:jv = raw ast_add_verify(p.ast, VerifyKind.VerifyJoinsWithin,
                                                   sp, 0i32, jd.index, 0i32, 0i64);
                drop ast_scratch_push(p.ast, jv.index);
                continue;
            }
            int32:kind = 0i32;
            if (raw p_at(p, TokenKind.KwRequires)) { kind = raw CONTRACT_REQUIRES(); }
            if (raw p_at(p, TokenKind.KwEnsures))  { kind = raw CONTRACT_ENSURES(); }
            if (raw p_at(p, TokenKind.KwAcquires)) { kind = raw CONTRACT_ACQUIRES(); }
            if (kind == 0i32) { break; }
            discard(raw p_advance(p));

            // `acquires <= N` — the BOUND form. The `<=` is consumed here rather
            // than parsed as a comparison, because `acquires x <= 3i32` is not a
            // predicate about anything: the level stands alone and the operator
            // is part of the clause's shape.
            int32:flags = 0i32;
            if (kind == (raw CONTRACT_ACQUIRES())) {
                if (raw p_accept(p, TokenKind.OpLtEq)) {
                    flags = raw CONTRACT_BOUNDED();
                }
            }

            // `ensures` may name `result` and `old(…)` — keywords with their own
            // expression nodes since 1.5.1 (D-221, S-16/S-18); the checker says
            // where each is legal, the grammar never restricts (D-085).
            ExprId:cond = raw p_parse_expr(p);
            VerifyId:c = raw ast_add_verify(p.ast, VerifyKind.VerifyContractNode, sp,
                                              kind, cond.index, flags, 0i64);
            drop ast_scratch_push(p.ast, c.index);
        }
    }
    pass (raw ast_scratch_commit(p.ast, mark));
};

// --- loop invariants -------------------------------------------------------------------
//
// `while (i < n) invariant total >= 0i32, i >= 0i32 { … }` -- between the head
// and the body, comma-separated, unparenthesised like the contracts they belong
// with. All the conditions of one loop are ONE node holding a list, because they
// are conjuncts of a single obligation rather than separate ones.
//
// Returns the reserved NONE handle when there is no clause, so "this loop has no
// invariant" is a value rather than an absence to test for.
pub func:p_parse_invariant = VerifyId(Parser->:p) never fails {
    if (!(raw p_at(p, TokenKind.KwInvariant))) {
        pass (raw verify_none());
    }
    Span:sp = raw p_span(p);
    discard(raw p_advance(p));
    int32:mark = raw ast_scratch_mark(p.ast);
    ExprId:c1 = raw p_parse_expr(p);
    drop ast_scratch_push(p.ast, c1.index);
    while (raw p_accept(p, TokenKind.PComma)) {
        ExprId:condN = raw p_parse_expr(p);
        drop ast_scratch_push(p.ast, condN.index);
    }
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_verify(p.ast, VerifyKind.VerifyInvariantNode, sp,
                               0i32, w.start, w.count, 0i64));
};
