// Struct and enum layout — sizes, alignments, and field offsets.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.5.
//
// 0.4.1 interned a named type from its DECLARATION and left the size at zero:
// "the layout is computed once every field's type is known". Field types become
// known here, so this is where that debt is paid — and it was a debt worth
// tracking, because a `Result<Point>` built from a zero-sized `Point` is 4 bytes
// where it should be twelve, and nothing downstream would have said so.
//
// A HAND-WRITTEN SIZE THAT DISAGREES WITH THE MACHINE SURVIVES TESTING AND
// CORRUPTS MEMORY LATER. `tests/frontend/types.npk` already asserts every scalar
// against `#size_of<T>` for that reason; the same discipline applies here, and
// the rules below are the C/LLVM ones because that is what `llc` will lay out.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./parse_decl.npk".*;
use "./parse_type.npk".*;
use "./symbols.npk".*;
use "./resolve_type.npk".*;

pub struct:FieldInfo = {
    bool:found;
    int32:type_id;
    int64:offset;
    int32:index;
};

func:fi_none = FieldInfo() {
    FieldInfo:f = FieldInfo{ found: false, type_id: 0i32, offset: 0i64,
                             index: 0i32 };
    pass f;
};

// `align_up` AND THE `Lay` ACCUMULATOR LIVE IN `types.npk` since 0.7.2, beside the
// interning that computes a `Result<T>`'s total at the moment it is constructed.
// This module still does most of the laying out; it no longer owns the arithmetic,
// because a module that cannot import it is a module that restates it.

// LOOK UP A FIELD BY NAME, and compute its offset on the way.
//
// The walk and the layout are the same walk. Splitting them would mean two
// traversals that have to agree about padding, which is two chances to disagree.
pub func:struct_field = FieldInfo(TypeResolver->:r, int32:struct_type,
                                  int32:name, int32:scope) {
    if ((raw type_kind(r.types, struct_type)) != (raw TY_STRUCT())) {
        pass (raw fi_none());
    }
    GenericScope:saved = raw bind_instance(r, struct_type);
    FieldInfo:f = relay struct_field_bound(r, struct_type, name, scope);
    r.generics = saved;
    pass f;
};

// A FIELD OF A GENERIC STRUCT IS RESOLVED WITH THE INSTANCE'S ARGUMENTS BOUND.
//
// `Container<int32>`'s `value` is an `int32` and `Container<string>`'s is a
// `string`, from one `T:value` written once. Without the binding, `T` resolves in
// whatever scope the ACCESS was written in — where it does not exist — so
// `c.value` reported "there is no type named `T`" against a program with no
// mistake in it.
//
// A NON-GENERIC STRUCT BINDS AN EMPTY SCOPE rather than being left alone. That
// matters: leaving the caller's binding in place would let a `T` from the
// surrounding generic function leak into an unrelated struct's field types and
// resolve to something plausible.
func:bind_instance = GenericScope(TypeResolver->:r, int32:struct_type) {
    GenericScope:saved = r.generics;
    DeclId:did = DeclId{ index: raw type_decl(r.types, struct_type) };
    DeclNode:d = relay ast_decl(r.ast, did);
    IdSpan:gp = raw decl_generic_window(r.ast, d);
    GenericScope:g = GenericScope{
        params_start: gp.start, params_count: gp.count,
        args_start: raw type_args_start_of(r.types, struct_type),
        args_count: raw type_args_count_of(r.types, struct_type) };
    r.generics = g;
    pass saved;
};

func:struct_field_bound = FieldInfo(TypeResolver->:r, int32:struct_type,
                                    int32:name, int32:scope) {
    DeclId:did = DeclId{ index: raw type_decl(r.types, struct_type) };
    DeclNode:d = relay ast_decl(r.ast, did);

    Lay:l = raw lay_start();
    int32:i = 0i32;
    while (i < (raw item_member_count(r.ast, d))) {
        DeclId:mid = raw item_member(r.ast, d, i);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFieldDecl) {
            int32:ft = relay resolve_type(r, raw field_type(m), scope);
            // A FIELD WHOSE LAYOUT IS NOT YET COMPUTED PUTS EVERY LATER FIELD AT
            // THE WRONG OFFSET — silently, since zero is a perfectly good number
            // to add to a running sum.
            drop ensure_layout(r, ft, scope, raw LAYOUT_FUEL());
            int64:at = raw lay_field(@l, raw type_size(r.types, ft),
                                     raw type_align(r.types, ft));
            if ((raw decl_name(m)) == name) {
                FieldInfo:f = FieldInfo{ found: true, type_id: ft,
                                         offset: at, index: i };
                pass f;
            }
        }
        i = i + 1i32;
    }
    pass (raw fi_none());
};

// The whole struct: size rounded up to its own alignment, which is the widest
// alignment any field wanted.
//
// A ZERO-FIELD STRUCT IS ONE BYTE, not zero. Two distinct empty structs must have
// distinct addresses, and a zero-sized one would place them on top of each other
// — the same reason C++ gives, and the reason `NIL` being genuinely zero-sized
// (D-084) is a property of `NIL` rather than of empty aggregates.
pub func:struct_layout = int32(TypeResolver->:r, int32:struct_type, int32:scope) {
    if ((raw type_kind(r.types, struct_type)) != (raw TY_STRUCT())) {
        pass struct_type;
    }
    GenericScope:saved = raw bind_instance(r, struct_type);
    int32:t = relay struct_layout_bound(r, struct_type, scope);
    r.generics = saved;
    pass t;
};

func:struct_layout_bound = int32(TypeResolver->:r, int32:struct_type, int32:scope) {
    DeclId:did = DeclId{ index: raw type_decl(r.types, struct_type) };
    DeclNode:d = relay ast_decl(r.ast, did);

    // THE SIZE IS WRITTEN BEFORE THE FIELDS ARE WALKED, so a struct reached again
    // while its own layout is in progress does not recurse forever. One byte is a
    // safe placeholder rather than a guess: a by-value containment cycle is
    // already refused by `module_graph.npk`, so nothing correct can observe it,
    // and a `Node->` field never asks for the pointee's layout at all.
    drop tt_set_layout(r.types, struct_type, 1i64, 1i32);

    Lay:l = raw lay_start();
    int32:i = 0i32;
    while (i < (raw item_member_count(r.ast, d))) {
        DeclId:mid = raw item_member(r.ast, d, i);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFieldDecl) {
            int32:ft = relay resolve_type(r, raw field_type(m), scope);
            // A FIELD'S OWN LAYOUT FIRST. A struct containing a struct needs the
            // inner one's real size, and a demand-driven walk gets that without an
            // ordering pass — the containment graph is acyclic because the loader
            // already refused the cycles (D-086).
            drop ensure_layout(r, ft, scope, raw LAYOUT_FUEL());
            drop lay_field(@l, raw type_size(r.types, ft),
                           raw type_align(r.types, ft));
        }
        i = i + 1i32;
    }
    drop lay_end(@l);
    // A ZERO-FIELD STRUCT IS ONE BYTE, and that rule belongs HERE rather than in
    // the accumulator: `Result<NIL>` is `{i32}` and genuinely four, and an
    // accumulator that refused to return zero would have no way to say so.
    if (l.size == 0i64) { l.size = 1i64; }
    drop tt_set_layout(r.types, struct_type, l.size, l.align);
    pass struct_type;
};

// FUEL, as a belt to the loader's braces. A by-value containment cycle is refused
// before this runs, so the walk is acyclic — but "acyclic because something else
// checked" is exactly the assumption worth bounding, since the cost of being
// wrong is a compiler that does not terminate.
func:LAYOUT_FUEL = int32() { pass 64i32; };

// THE LAYOUT OF WHATEVER THIS TYPE NEEDS BEFORE ITS SIZE MEANS ANYTHING.
//
// Four kinds are built FROM another type's size and were therefore built from
// zero: a struct, an array of one, and the two wrappers. Each was interned with a
// total computed at the moment it was constructed, which was before any struct had
// a size — so `Point[4]` was 0 bytes and `Result<Point>` was 4.
//
// A POINTER AND A SLICE ARE NOT HERE, and that is the whole reason this walk
// terminates: a pointer is one word whatever it points at (D-038) and a slice is
// `{ptr, len}` whatever it holds (D-070), so neither needs the pointee's layout —
// which is exactly why `Node->` breaks a containment cycle and `Node` does not.
pub func:ensure_layout = NIL(TypeResolver->:r, int32:t, int32:scope, int32:fuel) {
    if (fuel <= 0i32) { pass NIL; }
    if (t == 0i32) { pass NIL; }
    int32:k = raw type_kind(r.types, t);

    if (k == (raw TY_STRUCT())) {
        // Already laid out: a real struct is at least one byte, so zero is the
        // "not computed" state and nothing else.
        if ((raw type_size(r.types, t)) != 0i64) { pass NIL; }
        drop struct_layout(r, t, scope);
        pass NIL;
    }

    if (k == (raw TY_ARRAY())) {
        int32:el = raw type_elem(r.types, t);
        drop ensure_layout(r, el, scope, fuel - 1i32);
        drop tt_set_layout(r.types, t,
                           (raw type_size(r.types, el)) * ((raw type_array_count(r.types, t)) => int64),
                           raw type_align(r.types, el));
        pass NIL;
    }

    // `{i8 has_value, T value}` (TYPE_REFERENCE §11.1) and `{T, tbb32}` (D-069) —
    // recomputed THROUGH THE SAME ACCUMULATOR `tt_optional` and `tt_result` use, so
    // that a wrapper interned before its inner type had a size ends up with the
    // number the constructor would have given it. Two spellings of one layout is
    // how `Result<int64>` came to be twelve bytes in one place and sixteen in the
    // machine.
    if (k == (raw TY_OPTIONAL())) {
        int32:inner = raw type_elem(r.types, t);
        drop ensure_layout(r, inner, scope, fuel - 1i32);
        Lay:l = raw lay_start();
        drop lay_field(@l, 1i64, 1i32);
        drop lay_field(@l, raw type_size(r.types, inner),
                       raw type_align(r.types, inner));
        drop lay_end(@l);
        drop tt_set_layout(r.types, t, l.size, l.align);
        pass NIL;
    }

    if (k == (raw TY_RESULT())) {
        int32:inner = raw type_elem(r.types, t);
        drop ensure_layout(r, inner, scope, fuel - 1i32);
        Lay:l = raw lay_start();
        drop lay_field(@l, raw type_size(r.types, inner),
                       raw type_align(r.types, inner));
        drop lay_field(@l, 4i64, 4i32);
        drop lay_end(@l);
        drop tt_set_layout(r.types, t, l.size, l.align);
        pass NIL;
    }

    // AN ENUM HAD NO ARM HERE AT ALL UNTIL 0.7.2, and both of the places that
    // intern one pass size zero and alignment one. So every enum in every program
    // was zero bytes, and a struct with an enum field was laid out as though the
    // field were not there — the same defect 0.4.8 found for structs, in the one
    // kind that pass did not cover.
    //
    // Nothing caught it because nothing asked: the checker compares types and
    // almost never needs a size, and `Net` appears in no `#size_of`.
    if (k == (raw TY_ENUM())) {
        if ((raw type_size(r.types, t)) != 0i64) { pass NIL; }
        Lay:l = raw lay_start();
        drop lay_field(@l, 4i64, 4i32);
        // `{i32 tag, i64 payload}` WHEN ANY VARIANT CARRIES ONE, and a plain `i32`
        // when none does (TYPE_REFERENCE §9.3, SUBSET_1 §1.2).
        //
        // THE UNIFORM WORD IS THE RUNG'S SHAPE, NOT THE LANGUAGE'S. Sizing the
        // payload to the widest variant — which §9.3 shows with explicit padding
        // arrays — is cycle 0.9's, and doing it here would be WORSE than this:
        // the seed emits `{i32, i64}` for every tagged enum, so an enum whose only
        // payload is an `int32` would be eight bytes here and sixteen in the IR
        // the seed produced for it, and the two compilers' output has to
        // interoperate until the fixpoint closes.
        if (relay enum_has_payload(r.ast, r.types, t)) {
            drop lay_field(@l, 8i64, 8i32);
        }
        drop lay_end(@l);
        drop tt_set_layout(r.types, t, l.size, l.align);
        pass NIL;
    }
    pass NIL;
};

// DOES ANY VARIANT CARRY A PAYLOAD — which is the whole difference between an enum
// that is an `i32` and one that is a struct.
//
// It takes the AST and the table rather than a `TypeResolver`, because the BACKEND
// asks this question too and a backend that had to construct a resolver to ask it
// would be a backend that depends on name resolution.
pub func:enum_has_payload = bool(Ast->:ast, TypeTable->:types, int32:enum_type) {
    if ((raw type_kind(types, enum_type)) != (raw TY_ENUM())) { pass false; }
    DeclId:did = DeclId{ index: raw type_decl(types, enum_type) };
    DeclNode:d = relay ast_decl(ast, did);
    int32:i = 0i32;
    while (i < (raw item_member_count(ast, d))) {
        DeclId:mid = raw item_member(ast, d, i);
        DeclNode:m = relay ast_decl(ast, mid);
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw variant_payload_count(m)) > 0i32) { pass true; }
        }
        i = i + 1i32;
    }
    pass false;
};

// AN ENUM VARIANT'S TYPE IS THE ENUM, whatever the variant carries.
//
// `Net.Disconnect` and `Net.Connect(reason)` are both `Net` — the payload is
// reached by destructuring in a `pick`, never by member access, which is what
// keeps a variant from being a type of its own that a signature could name.
pub func:enum_variant = FieldInfo(TypeResolver->:r, int32:enum_type, int32:name) {
    if ((raw type_kind(r.types, enum_type)) != (raw TY_ENUM())) {
        pass (raw fi_none());
    }
    DeclId:did = DeclId{ index: raw type_decl(r.types, enum_type) };
    DeclNode:d = relay ast_decl(r.ast, did);

    int32:i = 0i32;
    while (i < (raw item_member_count(r.ast, d))) {
        DeclId:mid = raw item_member(r.ast, d, i);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == name) {
                FieldInfo:f = FieldInfo{ found: true, type_id: enum_type,
                                         offset: 0i64, index: i };
                pass f;
            }
        }
        i = i + 1i32;
    }
    pass (raw fi_none());
};

// --- finishing the table ------------------------------------------------------------------
//
// EVERY TYPE IN THE PROGRAM, LAID OUT, ONCE THE PROGRAM IS KNOWN.
//
// Demand-driven layout answers whatever is asked for, and the checker asks for
// very little — it compares types and almost never needs a size. That is fine for
// checking and not fine for what comes after: Phase B lowers these types, and a
// `Result<Point>` interned before `Point` had a size is four bytes with nothing
// saying so. A wrong size does not fail; it corrupts memory later, which is the
// failure mode `types.npk` opens by warning about.
//
// So the table is completed rather than left to whatever happened to be asked.
// Order-independent by construction: `ensure_layout` recurses into what a type is
// built from before computing the type itself, so one sweep suffices however the
// entries happen to be arranged.
//
// THE COUNT IS RE-READ EVERY ITERATION, because laying a struct out resolves its
// field types and resolving a type can intern new ones. A count read once would
// stop short of exactly the entries this pass created.
pub func:finish_layouts = NIL(TypeResolver->:r, int32:scope) {
    int32:i = 0i32;
    while (i < (raw tt_count(r.types))) {
        drop ensure_layout(r, i, scope, raw LAYOUT_FUEL());
        i = i + 1i32;
    }
    pass NIL;
};
