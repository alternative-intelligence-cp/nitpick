// Parse diagnostic codes.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.1.
//
// Written once, for the reason 0.1.6 gives: a mistyped code literal at a call
// site silently invents a NEW code, and the test asserting the old one then
// fails for a reason unrelated to the bug it guards.

pub func:PARSE_EXPECTED = string()      { pass "NITPICK-PARSE-001"; };
pub func:PARSE_UNEXPECTED = string()    { pass "NITPICK-PARSE-002"; };
pub func:PARSE_UNCLOSED = string()      { pass "NITPICK-PARSE-003"; };
pub func:PARSE_ASSIGN_EXPR = string()   { pass "NITPICK-PARSE-004"; };
pub func:PARSE_BAD_PATTERN = string()   { pass "NITPICK-PARSE-005"; };

// D-002: an `extern` function with no failure contract. A parse error rather
// than a semantic one because the contract is part of the declaration's SHAPE --
// there is no `extern` function without one to build a node for.
pub func:PARSE_EXTERN_NO_CONTRACT = string() { pass "NITPICK-PARSE-006"; };
