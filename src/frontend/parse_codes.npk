// Parse diagnostic codes.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.1.
//
// Written once, for the reason 0.1.6 gives: a mistyped code literal at a call
// site silently invents a NEW code, and the test asserting the old one then
// fails for a reason unrelated to the bug it guards.

pub func:PARSE_EXPECTED = string()      { pass "NITPICK-PARSE-001"; };
pub func:PARSE_UNEXPECTED = string()    { pass "NITPICK-PARSE-002"; };
pub func:PARSE_UNCLOSED = string()      { pass "NITPICK-PARSE-003"; };
pub func:PARSE_ASSIGN_EXPR = string()   { pass "NITPICK-PARSE-004"; };
pub func:PARSE_BAD_PATTERN = string()   { pass "NITPICK-PARSE-005"; };

// D-002: an `extern` function with no failure contract. A parse error rather
// than a semantic one because the contract is part of the declaration's SHAPE --
// there is no `extern` function without one to build a node for.
pub func:PARSE_EXTERN_NO_CONTRACT = string() { pass "NITPICK-PARSE-006"; };

// D-061: `(!)`, the removed unreachable marker. It gets a code of its own rather
// than a generic "bad pattern" so the diagnostic can name the replacement --
// somebody writing `(!)` learned it from an older document and needs to be told
// what to write instead, not merely that this is wrong.
pub func:PARSE_UNREACHABLE_MARKER = string() { pass "NITPICK-PARSE-007"; };

// A bad field in a `Result{…}` literal: a name that is not `value` or `error`,
// one of them written twice, or something that is not a name at all. Its own
// code for the same reason PARSE-007 has one -- `is_error` was a real field in
// the prototype (D-069), so the diagnostic has to name what replaced it, and a
// generic "unexpected token" cannot.
pub func:PARSE_WRAPPER_FIELD = string() { pass "NITPICK-PARSE-008"; };

// D-167: `?|` / `defaults`, the removed second spelling of `?`. Its own code for
// the reason PARSE-007 has one -- somebody writing it learned it from an older
// document (or the prototype, where it was literally the same node as `?`), and
// the diagnostic has to say what to write instead.
pub func:PARSE_DEFAULTS_REMOVED = string() { pass "NITPICK-PARSE-009"; };
