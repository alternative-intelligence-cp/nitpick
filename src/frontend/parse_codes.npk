// Parse diagnostic codes.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.1.
//
// Written once, for the reason 0.1.6 gives: a mistyped code literal at a call
// site silently invents a NEW code, and the test asserting the old one then
// fails for a reason unrelated to the bug it guards.

pub func:PARSE_EXPECTED = string() never fails      { pass "NITPICK-PARSE-001"; };
pub func:PARSE_UNEXPECTED = string() never fails    { pass "NITPICK-PARSE-002"; };
pub func:PARSE_UNCLOSED = string() never fails      { pass "NITPICK-PARSE-003"; };
pub func:PARSE_ASSIGN_EXPR = string() never fails   { pass "NITPICK-PARSE-004"; };
pub func:PARSE_BAD_PATTERN = string() never fails   { pass "NITPICK-PARSE-005"; };

// NITPICK-PARSE-006 lived here: D-002's mandatory failure contract on an
// `extern` function. The Bridge (1.1.13c, D-149/D-190) lifted the
// requirement — a driver method carries NO per-function contract, the wire
// has one convention — so the code is RETIRED, and a contract that IS
// written refuses as NITPICK-EXTERN-002 in the expansion phase. The number
// is not reused.

// D-061: `(!)`, the removed unreachable marker. It gets a code of its own rather
// than a generic "bad pattern" so the diagnostic can name the replacement --
// somebody writing `(!)` learned it from an older document and needs to be told
// what to write instead, not merely that this is wrong.
pub func:PARSE_UNREACHABLE_MARKER = string() never fails { pass "NITPICK-PARSE-007"; };

// A bad field in a `Result{…}` literal: a name that is not `value` or `error`,
// one of them written twice, or something that is not a name at all. Its own
// code for the same reason PARSE-007 has one -- `is_error` was a real field in
// the prototype (D-069), so the diagnostic has to name what replaced it, and a
// generic "unexpected token" cannot.
pub func:PARSE_WRAPPER_FIELD = string() never fails { pass "NITPICK-PARSE-008"; };

// `++` / `--` (D-174). Struck for the same reason as `?|`: a construct the
// prototype carried that this language does not want -- an increment that also
// YIELDS a value hides a write inside an expression, and `x += 1` already does
// the job with no hidden mutation. The diagnostic names the replacement.
pub func:PARSE_INCDEC_REMOVED = string() never fails { pass "NITPICK-PARSE-010"; };

// D-175 (amends D-167): a bare `?` and the word `defaults` are NOT the `Result`
// fallback -- `?|` is. D-167 kept the wrong survivor; `?` reads as Rust's
// error-propagation while Nitpick's fallback yields a value, and `?|` is the
// two-character `?`-family form (`?|` / `??` / `?!`). Named so old code learns
// the spelling. (PARSE-009, which removed `?|`, retired with the reversal.)
pub func:PARSE_BARE_QUESTION_REMOVED = string() never fails { pass "NITPICK-PARSE-011"; };
