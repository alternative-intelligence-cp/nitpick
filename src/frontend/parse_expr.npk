// Expression parsing.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.3.
//
// Precedence climbing over OP_REFERENCE.md §0, tightest level first:
//
//    1  postfix          ++ -- () [] . ?.
//    2  Result unary     raw _!  drop _?  await  relay _^        (right-assoc)
//    3  pipeline         |> <|
//    4  cast             => =>!
//    5  unary            ! ~ - @ <- $$i $$m
//    6  multiplicative   * / %
//    7  additive         + -
//    8  shift            << >>
//    9  range / spread   .. ... ..* ..^
//   10  relational       < <= > >= <=>
//   11  equality         == !=
//   12  bitwise and      &
//   13  bitwise xor      ^
//   14  bitwise or       |
//   15  logical and      &&
//   16  logical or       ||
//   17  null coalescing  ??
//   18  ternary/defaults is ?| defaults
//
// LEVEL 19 -- ASSIGNMENT -- IS ABSENT ON PURPOSE. Assignment is a STATEMENT,
// not an expression (D-060), so `a = b = 5` does not parse and `if (a = b)` is
// not expressible rather than being caught by a rule. The statement parser
// handles it; there is nothing here to handle.
//
// Level 2 is the one to get right (D-081). It is LOOSER than postfix, so
// `raw a.eq(b)` takes the whole call rather than the receiver; and TIGHTER than
// cast and pipeline, so it is the VALUE that gets cast or piped, a Result being
// meaningless to either. Getting this wrong does not fail -- it changes what
// programs mean.

use "source_location.npk".*;
use "token_kind.npk".*;
use "token_name.npk".*;
use "token.npk".*;
use "intern.npk".*;
use "ast_kind.npk".*;
use "ast.npk".*;
use "diagnostics.npk".*;
use "parse_codes.npk".*;
use "parser.npk".*;
use "parse_type.npk".*;

// --- named accessors ---------------------------------------------------------

pub func:expr_op = TokenKind(ExprNode:e) {
    pass ((e.payload => int32) => TokenKind);
};
pub func:expr_lhs = ExprId(ExprNode:e)      { ExprId:i = ExprId{ index: e.a }; pass i; };
pub func:expr_rhs = ExprId(ExprNode:e)      { ExprId:i = ExprId{ index: e.b }; pass i; };
pub func:expr_operand = ExprId(ExprNode:e)  { ExprId:i = ExprId{ index: e.a }; pass i; };
pub func:expr_cast_type = TypeId(ExprNode:e){ TypeId:i = TypeId{ index: e.b }; pass i; };
pub func:expr_callee = ExprId(ExprNode:e)   { ExprId:i = ExprId{ index: e.a }; pass i; };
pub func:expr_list_start = int32(ExprNode:e){ pass e.b; };
pub func:expr_list_count = int32(ExprNode:e){ pass e.c; };
pub func:expr_name = int64(ExprNode:e)      { pass e.payload; };

// A call's window holds its generic arguments first, then its value arguments.
// `payload` records how many of the leading entries are generic, so the two are
// separable without a second window.
pub func:expr_generic_count = int32(ExprNode:e) { pass (e.payload => int32); };

// --- entry -------------------------------------------------------------------

pub func:p_parse_expr = ExprId(Parser->:p) {
    pass (relay p_ternary(p));
};

// 18 -- ternary and defaults
func:p_ternary = ExprId(Parser->:p) {
    Span:sp = relay p_span(p);
    if (relay p_at(p, TokenKind.KwIs)) {
        drop p_advance(p);
        drop p_expect(p, TokenKind.PLParen);
        ExprId:c = relay p_parse_expr(p);
        drop p_expect(p, TokenKind.PRParen);
        drop p_expect(p, TokenKind.PColon);
        ExprId:a = relay p_parse_expr(p);
        drop p_expect(p, TokenKind.PColon);
        ExprId:b = relay p_parse_expr(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprTernaryExpr, sp,
                                 c.index, a.index, b.index, 0i64));
    }
    ExprId:lhs = relay p_coalesce(p);
    while (true) {
        if (relay p_at(p, TokenKind.OpQuestionPipe)) {
            drop p_advance(p);
        } else {
            if (relay p_at(p, TokenKind.KwDefaults)) {
                drop p_advance(p);
            } else {
                break;
            }
        }
        ExprId:rhs = relay p_coalesce(p);
        lhs = relay ast_add_expr(p.ast, ExprKind.ExprDefaultsExpr, sp,
                                 lhs.index, rhs.index, 0i32, 0i64);
    }
    pass lhs;
};

// 17 -- null coalescing, and the ?-family that shares its shape
func:p_coalesce = ExprId(Parser->:p) {
    ExprId:lhs = relay p_binary(p, 16i32);
    while (true) {
        Span:sp = relay p_span(p);
        TokenKind:k = relay p_kind(p);
        ExprKind:node = ExprKind.ExprNone;
        if (k == TokenKind.OpQuestionQuestion) { node = ExprKind.ExprNullCoalesceExpr; }
        if (k == TokenKind.OpQuestion)         { node = ExprKind.ExprSafeUnwrapExpr; }
        if (k == TokenKind.OpQuestionBang)     { node = ExprKind.ExprEmphaticUnwrapExpr; }
        if (node == ExprKind.ExprNone) { break; }
        drop p_advance(p);
        ExprId:rhs = relay p_binary(p, 16i32);
        lhs = relay ast_add_expr(p.ast, node, sp, lhs.index, rhs.index, 0i32, 0i64);
    }
    pass lhs;
};

// 16 down to 6 -- the binary levels, one function driven by a level number.
// Writing eleven near-identical functions would be eleven places to get the
// operator set wrong.
func:p_level_has = bool(int32:level, TokenKind:k) {
    if (level == 16i32) { pass (k == TokenKind.OpOrOr); }
    if (level == 15i32) { pass (k == TokenKind.OpAndAnd); }
    if (level == 14i32) { pass (k == TokenKind.OpPipe); }
    if (level == 13i32) { pass (k == TokenKind.OpCaret); }
    if (level == 12i32) { pass (k == TokenKind.OpAmp); }
    if (level == 11i32) {
        if (k == TokenKind.OpEqEq)  { pass true; }
        pass (k == TokenKind.OpNotEq);
    }
    if (level == 10i32) {
        if (k == TokenKind.OpLt)    { pass true; }
        if (k == TokenKind.OpLtEq)  { pass true; }
        if (k == TokenKind.OpGt)    { pass true; }
        if (k == TokenKind.OpGtEq)  { pass true; }
        pass (k == TokenKind.OpSpaceship);
    }
    if (level == 9i32) {
        if (k == TokenKind.OpDotDot) { pass true; }
        pass (k == TokenKind.OpDotDotDot);
    }
    if (level == 8i32) {
        if (k == TokenKind.OpShl)   { pass true; }
        pass (k == TokenKind.OpShr);
    }
    if (level == 7i32) {
        if (k == TokenKind.OpPlus)  { pass true; }
        pass (k == TokenKind.OpMinus);
    }
    if (level == 6i32) {
        if (k == TokenKind.OpStar)    { pass true; }
        if (k == TokenKind.OpSlash)   { pass true; }
        pass (k == TokenKind.OpPercent);
    }
    pass false;
};

func:p_binary = ExprId(Parser->:p, int32:level) {
    if (level < 6i32) {
        pass (relay p_unary(p));
    }
    ExprId:lhs = relay p_binary(p, level - 1i32);
    while (true) {
        Span:sp = relay p_span(p);
        TokenKind:k = relay p_kind(p);
        if (!(raw p_level_has(level, k))) { break; }
        drop p_advance(p);
        ExprId:rhs = relay p_binary(p, level - 1i32);
        // Range is its own node: `lo..hi` is not arithmetic, and `...` is the
        // exclusive form (LEXICAL_REFERENCE §5.1).
        if (level == 9i32) {
            int64:inclusive = 1i64;
            if (k == TokenKind.OpDotDotDot) { inclusive = 0i64; }
            lhs = relay ast_add_expr(p.ast, ExprKind.ExprRangeExpr, sp,
                                     lhs.index, rhs.index, 0i32, inclusive);
        } else {
            lhs = relay ast_add_expr(p.ast, ExprKind.ExprBinaryExpr, sp,
                                     lhs.index, rhs.index, 0i32,
                                     (k => int32) => int64);
        }
    }
    pass lhs;
};

// 5 -- unary prefixes
func:p_unary = ExprId(Parser->:p) {
    Span:sp = relay p_span(p);
    TokenKind:k = relay p_kind(p);

    if (k == TokenKind.OpAt) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprAddressOfExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpArrowBack) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprDerefExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpBorrowImm) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprBorrowExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpBorrowMut) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprBorrowExpr, sp,
                                 o.index, 0i32, 0i32, 1i64));
    }
    if (k == TokenKind.OpDotDotCaret) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprSpreadExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpBang) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprUnaryExpr, sp,
                                 o.index, 0i32, 0i32, (k => int32) => int64));
    }
    if (k == TokenKind.OpTilde) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprUnaryExpr, sp,
                                 o.index, 0i32, 0i32, (k => int32) => int64));
    }
    if (k == TokenKind.OpMinus) {
        drop p_advance(p);
        ExprId:o = relay p_unary(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprUnaryExpr, sp,
                                 o.index, 0i32, 0i32, (k => int32) => int64));
    }
    pass (relay p_cast(p));
};

// 4 -- casts. `=>` is checked; `=>!` is the unchecked form, and only these two
// exist (D-021).
func:p_cast = ExprId(Parser->:p) {
    ExprId:e = relay p_pipeline(p);
    while (true) {
        Span:sp = relay p_span(p);
        TokenKind:k = relay p_kind(p);
        ExprKind:node = ExprKind.ExprNone;
        if (k == TokenKind.OpFatArrow)          { node = ExprKind.ExprCastExpr; }
        if (k == TokenKind.OpFatArrowUnchecked) { node = ExprKind.ExprUncheckedCastExpr; }
        if (node == ExprKind.ExprNone) { break; }
        drop p_advance(p);
        TypeId:t = relay p_parse_type(p);
        e = relay ast_add_expr(p.ast, node, sp, e.index, t.index, 0i32, 0i64);
    }
    pass e;
};

// 3 -- pipelines
func:p_pipeline = ExprId(Parser->:p) {
    ExprId:e = relay p_result_unary(p);
    while (true) {
        Span:sp = relay p_span(p);
        TokenKind:k = relay p_kind(p);
        bool:fwd = (k == TokenKind.OpPipeFwd);
        bool:back = (k == TokenKind.OpPipeBack);
        if (!fwd) {
            if (!back) { break; }
        }
        drop p_advance(p);
        ExprId:rhs = relay p_result_unary(p);
        int64:dir = 0i64;
        if (back) { dir = 1i64; }
        e = relay ast_add_expr(p.ast, ExprKind.ExprPipeExpr, sp,
                               e.index, rhs.index, 0i32, dir);
    }
    pass e;
};

// 2 -- the Result unary operators (D-081). Right-associative, because they are
// prefixes: `raw relay f()` is `raw (relay f())`.
func:p_result_unary = ExprId(Parser->:p) {
    Span:sp = relay p_span(p);
    TokenKind:k = relay p_kind(p);
    ExprKind:node = ExprKind.ExprNone;

    if (k == TokenKind.KwRaw)          { node = ExprKind.ExprRawUnwrapExpr; }
    if (k == TokenKind.OpUnderBang)    { node = ExprKind.ExprRawUnwrapExpr; }
    if (k == TokenKind.KwDrop)         { node = ExprKind.ExprDropExpr; }
    if (k == TokenKind.OpUnderQuestion){ node = ExprKind.ExprDropExpr; }
    if (k == TokenKind.KwRelay)        { node = ExprKind.ExprRelayExpr; }
    if (k == TokenKind.OpUnderCaret)   { node = ExprKind.ExprRelayExpr; }
    if (k == TokenKind.KwAwait)        { node = ExprKind.ExprAwaitExpr; }

    if (node != ExprKind.ExprNone) {
        drop p_advance(p);
        ExprId:o = relay p_result_unary(p);
        pass (relay ast_add_expr(p.ast, node, sp, o.index, 0i32, 0i32, 0i64));
    }
    pass (relay p_postfix(p));
};

// 1 -- postfix chains
func:p_postfix = ExprId(Parser->:p) {
    ExprId:e = relay p_primary(p);
    while (true) {
        Span:sp = relay p_span(p);
        TokenKind:k = relay p_kind(p);

        if (k == TokenKind.PDot) {
            drop p_advance(p);
            Token:n = relay p_advance(p);
            e = relay ast_add_expr(p.ast, ExprKind.ExprMemberAccessExpr, sp,
                                   e.index, 0i32, 0i32, n.payload);
        } else {
            if (k == TokenKind.OpQuestionDot) {
                drop p_advance(p);
                Token:n = relay p_advance(p);
                e = relay ast_add_expr(p.ast, ExprKind.ExprSafeNavExpr, sp,
                                       e.index, 0i32, 0i32, n.payload);
            } else {
                if (k == TokenKind.PLBracket) {
                    drop p_advance(p);
                    ExprId:ix = relay p_parse_expr(p);
                    drop p_expect(p, TokenKind.PRBracket);
                    e = relay ast_add_expr(p.ast, ExprKind.ExprIndexExpr, sp,
                                           e.index, ix.index, 0i32, 0i64);
                } else {
                    if (k == TokenKind.PLParen) {
                        e = relay p_call(p, e, sp, 0i32, 0i32);
                    } else {
                        // Turbofish. In EXPRESSION position this is the ONLY form
                        // for explicit type arguments (D-064): bare `f<T>(x)` is
                        // not a generic call, it is two comparisons.
                        bool:turbo = false;
                        if (k == TokenKind.PColon) {
                            if ((relay p_peek_at(p, 1i64)).kind == TokenKind.PColon) {
                                if ((relay p_peek_at(p, 2i64)).kind == TokenKind.OpLt) {
                                    turbo = true;
                                }
                            }
                        }
                        if (!turbo) { break; }
                        drop p_advance(p);
                        drop p_advance(p);
                        drop p_advance(p);
                        int32:mark = raw ast_scratch_mark(p.ast);
                        if (!(relay p_at(p, TokenKind.OpGt))) {
                            TypeId:g1 = relay p_parse_type(p);
                            drop ast_scratch_push(p.ast, g1.index);
                            while (relay p_accept(p, TokenKind.PComma)) {
                                TypeId:gn = relay p_parse_type(p);
                                drop ast_scratch_push(p.ast, gn.index);
                            }
                        }
                        drop p_expect_gt(p);
                        e = relay p_call(p, e, sp, mark, 1i32);
                    }
                }
            }
        }
    }
    pass e;
};

// A call, optionally with generic arguments already on scratch above `gmark`.
// Generics and value arguments share one window: `payload` records how many
// leading entries are generic, so the two are separable without a second window.
func:p_call = ExprId(Parser->:p, ExprId:callee, Span:sp,
                     int32:gmark, int32:has_generics) {
    int32:mark = gmark;
    if (has_generics == 0i32) {
        mark = raw ast_scratch_mark(p.ast);
    }
    int32:gcount = raw ast_scratch_mark(p.ast) - mark;

    drop p_expect(p, TokenKind.PLParen);
    if (!(relay p_at(p, TokenKind.PRParen))) {
        ExprId:a1 = relay p_parse_expr(p);
        drop ast_scratch_push(p.ast, a1.index);
        while (relay p_accept(p, TokenKind.PComma)) {
            ExprId:an = relay p_parse_expr(p);
            drop ast_scratch_push(p.ast, an.index);
        }
    }
    drop p_expect(p, TokenKind.PRParen);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (relay ast_add_expr(p.ast, ExprKind.ExprCallExpr, sp,
                             callee.index, w.start, w.count,
                             gcount => int64));
};

// --- primary ------------------------------------------------------------------

func:p_primary = ExprId(Parser->:p) {
    Span:sp = relay p_span(p);
    TokenKind:k = relay p_kind(p);

    if (k == TokenKind.IntLit) {
        Token:t = relay p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprIntLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.FloatLit) {
        Token:t = relay p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprFloatLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.CharLit) {
        Token:t = relay p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprCharLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.StringLit) {
        Token:t = relay p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprStringLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.RawStringLit) {
        Token:t = relay p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprRawStringLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.MultiStringLit) {
        Token:t = relay p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprBlockStringLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.KwTrue) {
        drop p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprBoolLiteral, sp,
                                 0i32, 0i32, 0i32, 1i64));
    }
    if (k == TokenKind.KwFalse) {
        drop p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprBoolLiteral, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpDollar) {
        drop p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprIterationVarExpr, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }

    // `move(place)` and `comptime(expr)` are KEYWORD OPERATORS with a
    // parenthesised operand, not calls (D-065). `move`'s operand is a place,
    // which is why it has its own node rather than being a UnaryExpr.
    if (k == TokenKind.KwMove) {
        drop p_advance(p);
        drop p_expect(p, TokenKind.PLParen);
        ExprId:o = relay p_parse_expr(p);
        drop p_expect(p, TokenKind.PRParen);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprMoveExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.KwComptime) {
        drop p_advance(p);
        drop p_expect(p, TokenKind.PLParen);
        ExprId:o = relay p_parse_expr(p);
        drop p_expect(p, TokenKind.PRParen);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprComptimeExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }

    // `#name<T>(args)` -- a compiler builtin. The sigil is the disambiguator, so
    // bare brackets are unambiguous here where they would not be on a plain
    // identifier (D-020, D-064).
    if (k == TokenKind.Hash) {
        drop p_advance(p);
        Token:name = relay p_advance(p);
        int32:mark = raw ast_scratch_mark(p.ast);
        if (relay p_accept(p, TokenKind.OpLt)) {
            if (!(relay p_at(p, TokenKind.OpGt))) {
                TypeId:g1 = relay p_parse_type(p);
                drop ast_scratch_push(p.ast, g1.index);
                while (relay p_accept(p, TokenKind.PComma)) {
                    TypeId:gn = relay p_parse_type(p);
                    drop ast_scratch_push(p.ast, gn.index);
                }
            }
            drop p_expect_gt(p);
        }
        int32:gcount = raw ast_scratch_mark(p.ast) - mark;
        if (relay p_accept(p, TokenKind.PLParen)) {
            if (!(relay p_at(p, TokenKind.PRParen))) {
                ExprId:a1 = relay p_parse_expr(p);
                drop ast_scratch_push(p.ast, a1.index);
                while (relay p_accept(p, TokenKind.PComma)) {
                    ExprId:an = relay p_parse_expr(p);
                    drop ast_scratch_push(p.ast, an.index);
                }
            }
            drop p_expect(p, TokenKind.PRParen);
        }
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprBuiltinExpr, sp,
                                 gcount, w.start, w.count, name.payload));
    }

    // `[a, b, c]`
    if (k == TokenKind.PLBracket) {
        drop p_advance(p);
        int32:mark = raw ast_scratch_mark(p.ast);
        if (!(relay p_at(p, TokenKind.PRBracket))) {
            ExprId:e1 = relay p_parse_expr(p);
            drop ast_scratch_push(p.ast, e1.index);
            while (relay p_accept(p, TokenKind.PComma)) {
                if (relay p_at(p, TokenKind.PRBracket)) { break; }
                ExprId:en = relay p_parse_expr(p);
                drop ast_scratch_push(p.ast, en.index);
            }
        }
        drop p_expect(p, TokenKind.PRBracket);
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprArrayLiteralExpr, sp,
                                 0i32, w.start, w.count, 0i64));
    }

    if (k == TokenKind.PLParen) {
        drop p_advance(p);
        ExprId:inner = relay p_parse_expr(p);
        drop p_expect(p, TokenKind.PRParen);
        pass inner;
    }

    // A template: TemplateStart (TemplatePart | InterpStart expr InterpEnd)*
    // TemplateEnd. `&{ }` is the WHOLE formatting mechanism (D-053) -- there is
    // no specifier language -- so this is where formatting enters the AST.
    if (k == TokenKind.TemplateStart) {
        drop p_advance(p);
        int32:mark = raw ast_scratch_mark(p.ast);
        while (true) {
            TokenKind:tk = relay p_kind(p);
            if (tk == TokenKind.TemplateEnd) { drop p_advance(p); break; }
            if (tk == TokenKind.Eof) { break; }
            if (tk == TokenKind.TemplatePart) {
                Token:part = relay p_advance(p);
                ExprId:pe = relay ast_add_expr(p.ast, ExprKind.ExprStringLiteral,
                                               part.span, 0i32, 0i32, 0i32,
                                               part.payload);
                drop ast_scratch_push(p.ast, pe.index);
            } else {
                if (tk == TokenKind.InterpStart) {
                    drop p_advance(p);
                    ExprId:ie = relay p_parse_expr(p);
                    drop p_expect(p, TokenKind.InterpEnd);
                    drop ast_scratch_push(p.ast, ie.index);
                } else {
                    drop p_error(p, raw PARSE_UNEXPECTED(),
                                 "unexpected token in a template literal");
                    break;
                }
            }
        }
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprTemplateLiteral, sp,
                                 0i32, w.start, w.count, 0i64));
    }

    if (k == TokenKind.KwNIL) {
        drop p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprSentinelLiteral, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.KwNULL) {
        drop p_advance(p);
        pass (relay ast_add_expr(p.ast, ExprKind.ExprSentinelLiteral, sp,
                                 0i32, 0i32, 0i32, 1i64));
    }

    if (k == TokenKind.Ident) {
        Token:t = relay p_advance(p);
        // `Name { field: value, ... }` -- a struct literal. Distinguished from a
        // block by the `ident :` that must follow the brace.
        if (relay p_at(p, TokenKind.PLBrace)) {
            if ((relay p_peek_at(p, 1i64)).kind == TokenKind.Ident) {
                if ((relay p_peek_at(p, 2i64)).kind == TokenKind.PColon) {
                    pass (relay p_struct_literal(p, sp, t.payload));
                }
            }
        }
        pass (relay ast_add_expr(p.ast, ExprKind.ExprMemberAccessExpr, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }

    drop p_error(p, raw PARSE_UNEXPECTED(), "expected an expression");
    pass (raw expr_none());
};

// Each field contributes TWO entries to the window: the name's intern index and
// then the value's handle. One window, documented once, rather than a second
// parallel one to keep in step.
func:p_struct_literal = ExprId(Parser->:p, Span:sp, int64:name) {
    drop p_expect(p, TokenKind.PLBrace);
    int32:mark = raw ast_scratch_mark(p.ast);
    while (!(relay p_at(p, TokenKind.PRBrace))) {
        if (relay p_at_end(p)) { break; }
        Token:f = relay p_advance(p);
        drop p_expect(p, TokenKind.PColon);
        ExprId:v = relay p_parse_expr(p);
        drop ast_scratch_push(p.ast, f.payload => int32);
        drop ast_scratch_push(p.ast, v.index);
        if (!(relay p_accept(p, TokenKind.PComma))) { break; }
    }
    drop p_expect(p, TokenKind.PRBrace);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (relay ast_add_expr(p.ast, ExprKind.ExprStructLiteralExpr, sp,
                             0i32, w.start, w.count, name));
};
