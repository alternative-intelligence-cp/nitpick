// Expression parsing.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.3.
//
// Precedence climbing over OP_REFERENCE.md §0, tightest level first:
//
//    1  postfix          ++ -- () [] . ?.
//    2  Result unary     raw _!  drop _?  await  relay _^        (right-assoc)
//    3  pipeline         |> <|
//    4  cast             => =>!
//    5  unary            ! ~ - @ <- $$i $$m
//    6  multiplicative   * / %
//    7  additive         + -
//    8  shift            << >>
//    9  range / spread   .. ... ..* ..^
//   10  relational       < <= > >= <=>
//   11  equality         == !=
//   12  bitwise and      &
//   13  bitwise xor      ^
//   14  bitwise or       |
//   15  logical and      &&
//   16  logical or       ||
//   17  null coalescing  ??
//   18  ternary/defaults is ?| defaults
//
// LEVEL 19 -- ASSIGNMENT -- IS ABSENT ON PURPOSE. Assignment is a STATEMENT,
// not an expression (D-060), so `a = b = 5` does not parse and `if (a = b)` is
// not expressible rather than being caught by a rule. The statement parser
// handles it; there is nothing here to handle.
//
// Level 2 is the one to get right (D-081). It is LOOSER than postfix, so
// `raw a.eq(b)` takes the whole call rather than the receiver; and TIGHTER than
// cast and pipeline, so it is the VALUE that gets cast or piped, a Result being
// meaningless to either. Getting this wrong does not fail -- it changes what
// programs mean.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token_name.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./parse_codes.npk".*;
use "./parser.npk".*;
use "./num_width.npk".*;
use "./parse_type.npk".*;
use "./parse_pick.npk".*;

// --- named accessors ---------------------------------------------------------

pub func:expr_op = TokenKind(ExprNode:e) never fails {
    pass ((e.payload =>! int32) =>! TokenKind);
};
pub func:expr_lhs = ExprId(ExprNode:e) never fails      { ExprId:i = ExprId{ index: e.a }; pass i; };
pub func:expr_rhs = ExprId(ExprNode:e) never fails      { ExprId:i = ExprId{ index: e.b }; pass i; };
pub func:expr_operand = ExprId(ExprNode:e) never fails  { ExprId:i = ExprId{ index: e.a }; pass i; };
pub func:expr_cast_type = TypeId(ExprNode:e) never fails{ TypeId:i = TypeId{ index: e.b }; pass i; };
// The memory qualifier written on a cast's target, on every cast kind.
pub func:expr_cast_quals = int32(ExprNode:e) never fails { pass (e.payload =>! int32); };
pub func:expr_callee = ExprId(ExprNode:e) never fails   { ExprId:i = ExprId{ index: e.a }; pass i; };
// The ternary's third operand. Named rather than reached through `e.c`, because
// slot `c` is a WINDOW COUNT on most kinds and a call site that reads it raw has
// to know which it is looking at.
pub func:expr_third = ExprId(ExprNode:e) never fails   { ExprId:i = ExprId{ index: e.c }; pass i; };
pub func:expr_list_start = int32(ExprNode:e) never fails{ pass e.b; };
pub func:expr_list_count = int32(ExprNode:e) never fails{ pass e.c; };
pub func:expr_name = int64(ExprNode:e) never fails      { pass e.payload; };

// A call's window holds its generic arguments first, then its value arguments.
// `payload` records how many of the leading entries are generic, so the two are
// separable without a second window.
// GENERIC ARGUMENTS AT THE FRONT OF A CALL'S WINDOW -- and ONLY on `CallExpr`
// and `BuiltinExpr`, which are the two kinds whose payload is a count. A
// `MethodCallExpr`'s payload is the method NAME, so asking it for a generic count
// yields an intern index and slices the argument window by it.
// THE TURBOFISH COUNT ON A `CallExpr`, WHERE IT LIVES IN THE PAYLOAD.
//
// NOT VALID ON A `BuiltinExpr`, and that is the whole reason this comment exists.
// The two kinds have OPPOSITE layouts:
//
//   CallExpr      a = callee,        payload = generic count
//   BuiltinExpr   a = generic count, payload = the NAME
//
// so reading a builtin's generic count through this returns its name's intern
// index — a large number — and every `count - gcount` computed from it goes
// negative. Cycle 0.6.1 found seven sites doing exactly that, with the result that
// **the arguments of `#builtin(…)` were never walked by anything**: not resolved,
// not typed, not seen by a single 0.5 analysis. `#wild_ptr<int32>(undefined_name)`
// compiled clean.
//
// One accessor per layout, named for the kind it belongs to. That is the fix for a
// slot meaning two things, and it is the same fix `stmt_cond` versus
// `stmt_counted_body` needed for the same reason.
pub func:expr_generic_count = int32(ExprNode:e) never fails { pass (e.payload =>! int32); };

// The turbofish count on a `BuiltinExpr`, where it lives in slot `a`.
pub func:builtin_generic_count = int32(ExprNode:e) never fails { pass e.a; };

// A builtin's NAME, as an intern index.
pub func:builtin_name = int32(ExprNode:e) never fails { pass (e.payload =>! int32); };

// `$$m` RATHER THAN `$$i`. Both spell a borrow and build the same node, and the
// difference is exclusive-versus-shared — which is what decides whether the callee
// may WRITE through it, and therefore whether handing it an unassigned binding is
// a use-before-write or the endorsed way to fill one (D-004).
//
// Named rather than read as `payload != 0` at each site, for the reason every
// other slot in this file is named: a raw slot read is a comment that cannot be
// checked.
pub func:borrow_is_mut = bool(ExprNode:e) never fails { pass (e.payload != 0i64); };

// A numeric literal's width suffix, in slot `a`. `WNone` when none was written,
// which is what makes the literal contextually typed (D-092).
pub func:expr_num_width = NumWidth(ExprNode:e) never fails { pass e.width; };

// --- entry -------------------------------------------------------------------

pub func:p_parse_expr = ExprId(Parser->:p) never fails {
    pass (raw p_ternary(p));
};

// 18 -- ternary and defaults
func:p_ternary = ExprId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    if (raw p_at(p, TokenKind.KwIs)) {
        discard(raw p_advance(p));
        discard(raw p_expect(p, TokenKind.PLParen));
        ExprId:c = raw p_parse_expr(p);
        discard(raw p_expect(p, TokenKind.PRParen));
        discard(raw p_expect(p, TokenKind.PColon));
        ExprId:a = raw p_parse_expr(p);
        discard(raw p_expect(p, TokenKind.PColon));
        ExprId:b = raw p_parse_expr(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprTernaryExpr, sp,
                                 c.index, a.index, b.index, 0i64));
    }
    ExprId:lhs = raw p_coalesce(p);
    while (true) {
        Span:qsp = raw p_span(p);
        if (raw p_at(p, TokenKind.OpQuestionPipe)) {
            // `?|` IS the `Result` fallback (D-175, restoring the design and
            // amending D-167): `expr ?| fallback` yields `expr`'s value, or
            // `fallback` if it errored. D-167 kept the wrong survivor — it
            // struck `?|` and left a bare `?`, which reads as Rust's
            // error-propagation while Nitpick's fallback yields a value. `?|` is
            // the two-character `?`-family form (`?|` / `??` / `?!`). It builds
            // the SafeUnwrap node — the same one the seed produces for `?|`
            // — so the AST agrees; a bare `?` and the word `defaults` are
            // refused (the `?` in p_coalesce, `defaults` just below).
            discard(raw p_advance(p));
            ExprId:rhs = raw p_coalesce(p);
            lhs = raw ast_add_expr(p.ast, ExprKind.ExprSafeUnwrapExpr, qsp,
                                     lhs.index, rhs.index, 0i32, 0i64);
        } else {
            if (raw p_at(p, TokenKind.KwDefaults)) {
                discard(raw p_advance(p));
                // The word `defaults` is not a spelling of the fallback (D-175):
                // `?|` is the one form. Parsed (grammar never partial, D-085),
                // refused by name, filed under the otherwise-unused ExprDefaultsExpr.
                drop p_error(p, raw PARSE_BARE_QUESTION_REMOVED(),
                    "`defaults` is not the `Result` fallback (D-175): write `expr ?| fallback`");
                ExprId:drhs = raw p_coalesce(p);
                lhs = raw ast_add_expr(p.ast, ExprKind.ExprDefaultsExpr, qsp,
                                         lhs.index, drhs.index, 0i32, 0i64);
            } else {
                break;
            }
        }
    }
    pass lhs;
};

// 17 -- null coalescing, and the ?-family that shares its shape
func:p_coalesce = ExprId(Parser->:p) never fails {
    ExprId:lhs = raw p_binary(p, 16i32);
    while (true) {
        Span:sp = raw p_span(p);
        TokenKind:k = raw p_kind(p);
        ExprKind:node = ExprKind.ExprNone;
        if (k == TokenKind.OpQuestionQuestion) { node = ExprKind.ExprNullCoalesceExpr; }
        // A bare `?` is STRUCK (D-175): it mirrors Rust's error-propagation but
        // Nitpick's fallback yields a value; the fallback is `?|` (p_ternary).
        // Filed under the otherwise-unused ExprDefaultsExpr so the kind stays
        // reachable, and refused by name after the advance.
        if (k == TokenKind.OpQuestion)         { node = ExprKind.ExprDefaultsExpr; }
        if (k == TokenKind.OpQuestionBang)     { node = ExprKind.ExprEmphaticUnwrapExpr; }
        if (node == ExprKind.ExprNone) { break; }
        discard(raw p_advance(p));
        if (k == TokenKind.OpQuestion) {
            drop p_error(p, raw PARSE_BARE_QUESTION_REMOVED(),
                "a bare `?` is not the `Result` fallback (D-175): write `expr ?| fallback` — `?` reads as Rust's error-propagation, but Nitpick's fallback yields a value");
        }
        ExprId:rhs = raw p_binary(p, 16i32);
        lhs = raw ast_add_expr(p.ast, node, sp, lhs.index, rhs.index, 0i32, 0i64);
    }
    pass lhs;
};

// 16 down to 6 -- the binary levels, one function driven by a level number.
// Writing eleven near-identical functions would be eleven places to get the
// operator set wrong.
func:p_level_has = bool(int32:level, TokenKind:k) never fails {
    if (level == 16i32) { pass (k == TokenKind.OpOrOr); }
    if (level == 15i32) { pass (k == TokenKind.OpAndAnd); }
    if (level == 14i32) { pass (k == TokenKind.OpPipe); }
    if (level == 13i32) { pass (k == TokenKind.OpCaret); }
    if (level == 12i32) { pass (k == TokenKind.OpAmp); }
    if (level == 11i32) {
        if (k == TokenKind.OpEqEq)  { pass true; }
        pass (k == TokenKind.OpNotEq);
    }
    if (level == 10i32) {
        if (k == TokenKind.OpLt)    { pass true; }
        if (k == TokenKind.OpLtEq)  { pass true; }
        if (k == TokenKind.OpGt)    { pass true; }
        if (k == TokenKind.OpGtEq)  { pass true; }
        pass (k == TokenKind.OpSpaceship);
    }
    if (level == 9i32) {
        if (k == TokenKind.OpDotDot) { pass true; }
        pass (k == TokenKind.OpDotDotDot);
    }
    if (level == 8i32) {
        if (k == TokenKind.OpShl)   { pass true; }
        pass (k == TokenKind.OpShr);
    }
    if (level == 7i32) {
        if (k == TokenKind.OpPlus)  { pass true; }
        pass (k == TokenKind.OpMinus);
    }
    if (level == 6i32) {
        if (k == TokenKind.OpStar)    { pass true; }
        if (k == TokenKind.OpSlash)   { pass true; }
        pass (k == TokenKind.OpPercent);
    }
    pass false;
};

func:p_binary = ExprId(Parser->:p, int32:level) never fails {
    if (level < 6i32) {
        pass (raw p_unary(p));
    }
    ExprId:lhs = raw p_binary(p, level - 1i32);
    while (true) {
        Span:sp = raw p_span(p);
        TokenKind:k = raw p_kind(p);
        if (!(raw p_level_has(level, k))) { break; }
        discard(raw p_advance(p));
        ExprId:rhs = raw p_binary(p, level - 1i32);
        // Range is its own node: `lo..hi` is not arithmetic, and `...` is the
        // exclusive form (LEXICAL_REFERENCE §5.1).
        if (level == 9i32) {
            int64:inclusive = 1i64;
            if (k == TokenKind.OpDotDotDot) { inclusive = 0i64; }
            lhs = raw ast_add_expr(p.ast, ExprKind.ExprRangeExpr, sp,
                                     lhs.index, rhs.index, 0i32, inclusive);
        } else {
            lhs = raw ast_add_expr(p.ast, ExprKind.ExprBinaryExpr, sp,
                                     lhs.index, rhs.index, 0i32,
                                     (k =>! int32) =>! int64);
        }
    }
    pass lhs;
};

// 5 -- unary prefixes
// A COMPILE-TIME VALUE IN A TYPE-ARGUMENT LIST — `Mutex<Config, 2>` (D-064 §2).
//
// IT STOPS BELOW THE BINARY OPERATORS, and that is the whole reason it is a
// separate entry point rather than `p_parse_expr`. Inside `<…>` a `>` CLOSES THE
// LIST, so an expression parser that could take `>` as a comparison would read
// `Mutex<Config, 2>` as `Mutex < Config, (2 > …)` and consume the closing bracket
// as an operator. There is no lookahead that fixes that; there is only a rule
// about where the value ends.
//
// So a value argument is a literal, a name, a unary expression, or a
// PARENTHESIZED one — `Mutex<Config, (A > B)>` if a comparison is genuinely meant.
// The parentheses are how the language already resolves this everywhere else, and
// the alternative is a `>` whose meaning depends on what precedes it.
pub func:p_parse_const_arg = ExprId(Parser->:p) never fails {
    pass (raw p_unary(p));
};

func:p_unary = ExprId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    TokenKind:k = raw p_kind(p);

    if (k == TokenKind.OpAt) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprAddressOfExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpArrowBack) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprDerefExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpBorrowImm) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprBorrowExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpBorrowMut) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprBorrowExpr, sp,
                                 o.index, 0i32, 0i32, 1i64));
    }
    if (k == TokenKind.OpDotDotCaret) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprSpreadExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpBang) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprUnaryExpr, sp,
                                 o.index, 0i32, 0i32, (k =>! int32) =>! int64));
    }
    if (k == TokenKind.OpTilde) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprUnaryExpr, sp,
                                 o.index, 0i32, 0i32, (k =>! int32) =>! int64));
    }
    if (k == TokenKind.OpMinus) {
        discard(raw p_advance(p));
        ExprId:o = raw p_unary(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprUnaryExpr, sp,
                                 o.index, 0i32, 0i32, (k =>! int32) =>! int64));
    }
    pass (raw p_cast(p));
};

// 4 -- casts. `=>` is checked; `=>!` is the unchecked form, and only these two
// exist (D-021).
func:p_cast = ExprId(Parser->:p) never fails {
    ExprId:e = raw p_pipeline(p);
    while (true) {
        Span:sp = raw p_span(p);
        TokenKind:k = raw p_kind(p);
        ExprKind:node = ExprKind.ExprNone;
        if (k == TokenKind.OpFatArrow)          { node = ExprKind.ExprCastExpr; }
        if (k == TokenKind.OpFatArrowUnchecked) { node = ExprKind.ExprUncheckedCastExpr; }
        if (node == ExprKind.ExprNone) { break; }
        discard(raw p_advance(p));

        // `p => wild int8->` — A MEMORY QUALIFIER ON THE TARGET, read here since
        // 0.7.3. It is load-bearing rather than decoration: to LLVM a `wild`
        // pointer and a managed one are the same word, and the distinction is
        // enforced ENTIRELY by the type checker (D-038) — so the cast target is
        // where a program says the result is unmanaged. Sixteen of the compiler's
        // own files write one, and none of them parsed.
        int32:quals = raw p_qualifiers(p);

        TypeId:t = raw p_parse_type(p);
        // A cast TO a `dyn` type is its own node (AST_REFERENCE 3.6). Building a
        // fat pointer is not a checked scalar conversion, and one node for both
        // would hide that at every use. The DynType already holds the trait
        // window, so the node carries it directly rather than through the type.
        TypeNode:tn = raw ast_type(p.ast, t);
        // THE QUALIFIER GOES IN THE PAYLOAD ON ALL THREE CAST KINDS, not in a
        // spare slot on two of them. A dyn cast has used `b` and `c` for its trait
        // window since 0.4, so a qualifier put in `c` would be recorded for a
        // `=>` and silently dropped for a `=> dyn A` — and "wild dyn A" would then
        // be a thing nothing could refuse, because nothing would know it was
        // written.
        if (tn.kind == TypeKind.TypeDynType) {
            e = raw ast_add_expr(p.ast, ExprKind.ExprDynCastExpr, sp,
                                   e.index, raw type_args_start(tn),
                                   raw type_args_count(tn), quals => int64);
        } else {
            e = raw ast_add_expr(p.ast, node, sp, e.index, t.index, 0i32,
                                   quals => int64);
        }
    }
    pass e;
};

// 3 -- pipelines
func:p_pipeline = ExprId(Parser->:p) never fails {
    ExprId:e = raw p_result_unary(p);
    while (true) {
        Span:sp = raw p_span(p);
        TokenKind:k = raw p_kind(p);
        bool:fwd = (k == TokenKind.OpPipeFwd);
        bool:back = (k == TokenKind.OpPipeBack);
        if (!fwd) {
            if (!back) { break; }
        }
        discard(raw p_advance(p));
        ExprId:rhs = raw p_result_unary(p);
        int64:dir = 0i64;
        if (back) { dir = 1i64; }
        e = raw ast_add_expr(p.ast, ExprKind.ExprPipeExpr, sp,
                               e.index, rhs.index, 0i32, dir);
    }
    pass e;
};

// 2 -- the Result unary operators (D-081). Right-associative, because they are
// prefixes: `raw raw f()` is `raw (raw f())`.
func:p_result_unary = ExprId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    TokenKind:k = raw p_kind(p);
    ExprKind:node = ExprKind.ExprNone;

    if (k == TokenKind.KwRaw)          { node = ExprKind.ExprRawUnwrapExpr; }
    if (k == TokenKind.OpUnderBang)    { node = ExprKind.ExprRawUnwrapExpr; }
    if (k == TokenKind.KwDrop)         { node = ExprKind.ExprDropExpr; }
    if (k == TokenKind.OpUnderQuestion){ node = ExprKind.ExprDropExpr; }
    if (k == TokenKind.KwRelay)        { node = ExprKind.ExprRelayExpr; }
    if (k == TokenKind.OpUnderCaret)   { node = ExprKind.ExprRelayExpr; }
    if (k == TokenKind.KwAwait)        { node = ExprKind.ExprAwaitExpr; }

    if (node != ExprKind.ExprNone) {
        discard(raw p_advance(p));
        ExprId:o = raw p_result_unary(p);
        pass (raw ast_add_expr(p.ast, node, sp, o.index, 0i32, 0i32, 0i64));
    }
    pass (raw p_postfix(p));
};

// 1 -- postfix chains
func:p_postfix = ExprId(Parser->:p) never fails {
    ExprId:e = raw p_primary(p);
    while (true) {
        Span:sp = raw p_span(p);
        TokenKind:k = raw p_kind(p);

        // `a++` / `a--` -- PostfixExpr (AST_REFERENCE 3.2). Its own node rather
        // than a UnaryExpr, because the operator's POSITION is what distinguishes
        // it from nothing else: there is no prefix `++` in Nitpick, so a single
        // node discriminated by `op` would leave the position unrecorded.
        if (k == TokenKind.OpPlusPlus) {
            discard(raw p_advance(p));
            drop p_error(p, raw PARSE_INCDEC_REMOVED(),
                "`++` / `--` are removed (D-174): write `x += 1` or `x -= 1` — an increment that also yields a value hides a write inside an expression, and `+=` already does the job");
            e = raw ast_add_expr(p.ast, ExprKind.ExprPostfixExpr, sp,
                                   e.index, 0i32, 0i32, (k =>! int32) =>! int64);
        } else {
        if (k == TokenKind.OpMinusMinus) {
            discard(raw p_advance(p));
            drop p_error(p, raw PARSE_INCDEC_REMOVED(),
                "`++` / `--` are removed (D-174): write `x += 1` or `x -= 1` — an increment that also yields a value hides a write inside an expression, and `+=` already does the job");
            e = raw ast_add_expr(p.ast, ExprKind.ExprPostfixExpr, sp,
                                   e.index, 0i32, 0i32, (k =>! int32) =>! int64);
        } else {

        if (k == TokenKind.PDot) {
            discard(raw p_advance(p));
            Token:n = raw p_advance(p);
            // `acquire` WAS RESERVED FOR THE MUTEX OPERATION (D-056), and a
            // keyword token carries no intern — its one legal home is exactly
            // this position, the name after the dot, so it interns its own
            // spelling here and reaches the method dispatch like any name.
            int64:mnm = n.payload;
            if (n.kind == TokenKind.KwAcquire) {
                mnm = (raw intern_add(p.interns, "acquire")) => int64;
            }
            // `p.magnitude()` is a METHOD CALL, not a call over a member access
            // (AST_REFERENCE 3.3). UFCS resolves it to `Point_magnitude(p)`
            // (D-006), which needs the receiver kept apart from the callee --
            // and a `CallExpr` whose callee is a `MemberAccessExpr` buries it one
            // level down, leaving every consumer to test for both shapes.
            if (raw p_at(p, TokenKind.PLParen)) {
                e = raw p_method_call(p, e, sp, mnm);
            } else {
                e = raw ast_add_expr(p.ast, ExprKind.ExprMemberAccessExpr, sp,
                                       e.index, 0i32, 0i32, mnm);
            }
        } else {
            if (k == TokenKind.OpQuestionDot) {
                discard(raw p_advance(p));
                Token:n = raw p_advance(p);
                e = raw ast_add_expr(p.ast, ExprKind.ExprSafeNavExpr, sp,
                                       e.index, 0i32, 0i32, n.payload);
            } else {
                if (k == TokenKind.PLBracket) {
                    discard(raw p_advance(p));
                    ExprId:ix = raw p_parse_expr(p);
                    discard(raw p_expect(p, TokenKind.PRBracket));
                    e = raw ast_add_expr(p.ast, ExprKind.ExprIndexExpr, sp,
                                           e.index, ix.index, 0i32, 0i64);
                } else {
                    if (k == TokenKind.PLParen) {
                        e = raw p_call(p, e, sp, 0i32, 0i32);
                    } else {
                        // Turbofish. In EXPRESSION position this is the ONLY form
                        // for explicit type arguments (D-064): bare `f<T>(x)` is
                        // not a generic call, it is two comparisons.
                        bool:turbo = false;
                        if (k == TokenKind.PColon) {
                            if ((raw p_peek_at(p, 1i64)).kind == TokenKind.PColon) {
                                if ((raw p_peek_at(p, 2i64)).kind == TokenKind.OpLt) {
                                    turbo = true;
                                }
                            }
                        }
                        if (!turbo) { break; }
                        discard(raw p_advance(p));
                        discard(raw p_advance(p));
                        discard(raw p_advance(p));
                        int32:mark = raw ast_scratch_mark(p.ast);
                        if (!(raw p_at(p, TokenKind.OpGt))) {
                            TypeId:g1 = raw p_parse_type_arg(p);
                            drop ast_scratch_push(p.ast, g1.index);
                            while (raw p_accept(p, TokenKind.PComma)) {
                                TypeId:gn = raw p_parse_type_arg(p);
                                drop ast_scratch_push(p.ast, gn.index);
                            }
                        }
                        discard(raw p_expect_gt(p));
                        e = raw p_call(p, e, sp, mark, 1i32);
                    }
                }
            }
        }
        } }
    }
    pass e;
};

// `receiver.method(args)`. The receiver stays in slot `a` and the method name in
// `payload`, so UFCS resolution reads both without unwrapping anything.
func:p_method_call = ExprId(Parser->:p, ExprId:receiver, Span:sp, int64:method) never fails {
    discard(raw p_expect(p, TokenKind.PLParen));
    int32:mark = raw ast_scratch_mark(p.ast);
    if (!(raw p_at(p, TokenKind.PRParen))) {
        ExprId:a1 = raw p_parse_expr(p);
        drop ast_scratch_push(p.ast, a1.index);
        while (raw p_accept(p, TokenKind.PComma)) {
            ExprId:argN = raw p_parse_expr(p);
            drop ast_scratch_push(p.ast, argN.index);
        }
    }
    discard(raw p_expect(p, TokenKind.PRParen));
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_expr(p.ast, ExprKind.ExprMethodCallExpr, sp,
                             receiver.index, w.start, w.count, method));
};

// A call, optionally with generic arguments already on scratch above `gmark`.
// Generics and value arguments share one window: `payload` records how many
// leading entries are generic, so the two are separable without a second window.
func:p_call = ExprId(Parser->:p, ExprId:callee, Span:sp,
                     int32:gmark, int32:has_generics) never fails {
    int32:mark = gmark;
    if (has_generics == 0i32) {
        mark = raw ast_scratch_mark(p.ast);
    }
    int32:gcount = raw ast_scratch_mark(p.ast) - mark;

    discard(raw p_expect(p, TokenKind.PLParen));
    if (!(raw p_at(p, TokenKind.PRParen))) {
        ExprId:a1 = raw p_parse_expr(p);
        drop ast_scratch_push(p.ast, a1.index);
        while (raw p_accept(p, TokenKind.PComma)) {
            ExprId:argN = raw p_parse_expr(p);
            drop ast_scratch_push(p.ast, argN.index);
        }
    }
    discard(raw p_expect(p, TokenKind.PRParen));
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_expr(p.ast, ExprKind.ExprCallExpr, sp,
                             callee.index, w.start, w.count,
                             gcount => int64));
};

// --- primary ------------------------------------------------------------------

func:p_primary = ExprId(Parser->:p) never fails {
    Span:sp = raw p_span(p);
    TokenKind:k = raw p_kind(p);

    if (k == TokenKind.IntLit) {
        Token:t = raw p_advance(p);
        // THE WIDTH SUFFIX IS KEPT. A literal's width is part of its TYPE
        // (num_width.npk says so from the other side), and dropping it left the
        // type checker unable to tell `42i32` from `42` -- so every literal looked
        // contextually typed and D-092's rule could not be applied.
        pass (raw ast_add_expr_w(p.ast, ExprKind.ExprIntLiteral, sp,
                                   0i32, 0i32, 0i32, t.payload, t.width));
    }
    if (k == TokenKind.FloatLit) {
        Token:t = raw p_advance(p);
        pass (raw ast_add_expr_w(p.ast, ExprKind.ExprFloatLiteral, sp,
                                   0i32, 0i32, 0i32, t.payload, t.width));
    }
    if (k == TokenKind.CharLit) {
        Token:t = raw p_advance(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprCharLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.StringLit) {
        Token:t = raw p_advance(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprStringLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.RawStringLit) {
        Token:t = raw p_advance(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprRawStringLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.MultiStringLit) {
        Token:t = raw p_advance(p);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprBlockStringLiteral, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }
    if (k == TokenKind.KwTrue) {
        discard(raw p_advance(p));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprBoolLiteral, sp,
                                 0i32, 0i32, 0i32, 1i64));
    }
    if (k == TokenKind.KwFalse) {
        discard(raw p_advance(p));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprBoolLiteral, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.OpDollar) {
        discard(raw p_advance(p));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprIterationVarExpr, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }

    // `move(place)` and `comptime(expr)` are KEYWORD OPERATORS with a
    // parenthesised operand, not calls (D-065). `move`'s operand is a place,
    // which is why it has its own node rather than being a UnaryExpr.
    if (k == TokenKind.KwMove) {
        discard(raw p_advance(p));
        discard(raw p_expect(p, TokenKind.PLParen));
        ExprId:o = raw p_parse_expr(p);
        discard(raw p_expect(p, TokenKind.PRParen));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprMoveExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.KwComptime) {
        discard(raw p_advance(p));
        discard(raw p_expect(p, TokenKind.PLParen));
        ExprId:o = raw p_parse_expr(p);
        discard(raw p_expect(p, TokenKind.PRParen));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprComptimeExpr, sp,
                                 o.index, 0i32, 0i32, 0i64));
    }

    // `#name<T>(args)` -- a compiler builtin. The sigil is the disambiguator, so
    // bare brackets are unambiguous here where they would not be on a plain
    // identifier (D-020, D-064).
    if (k == TokenKind.Hash) {
        discard(raw p_advance(p));
        Token:name = raw p_advance(p);
        int32:mark = raw ast_scratch_mark(p.ast);
        if (raw p_accept(p, TokenKind.OpLt)) {
            if (!(raw p_at(p, TokenKind.OpGt))) {
                TypeId:g1 = raw p_parse_type_arg(p);
                drop ast_scratch_push(p.ast, g1.index);
                while (raw p_accept(p, TokenKind.PComma)) {
                    TypeId:gn = raw p_parse_type_arg(p);
                    drop ast_scratch_push(p.ast, gn.index);
                }
            }
            discard(raw p_expect_gt(p));
        }
        int32:gcount = raw ast_scratch_mark(p.ast) - mark;
        if (raw p_accept(p, TokenKind.PLParen)) {
            if (!(raw p_at(p, TokenKind.PRParen))) {
                ExprId:a1 = raw p_parse_expr(p);
                drop ast_scratch_push(p.ast, a1.index);
                while (raw p_accept(p, TokenKind.PComma)) {
                    ExprId:argN = raw p_parse_expr(p);
                    drop ast_scratch_push(p.ast, argN.index);
                }
            }
            discard(raw p_expect(p, TokenKind.PRParen));
        }
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprBuiltinExpr, sp,
                                 gcount, w.start, w.count, name.payload));
    }

    // `[a, b, c]`
    if (k == TokenKind.PLBracket) {
        discard(raw p_advance(p));
        int32:mark = raw ast_scratch_mark(p.ast);
        if (!(raw p_at(p, TokenKind.PRBracket))) {
            ExprId:e1 = raw p_parse_expr(p);
            drop ast_scratch_push(p.ast, e1.index);
            while (raw p_accept(p, TokenKind.PComma)) {
                if (raw p_at(p, TokenKind.PRBracket)) { break; }
                ExprId:en = raw p_parse_expr(p);
                drop ast_scratch_push(p.ast, en.index);
            }
        }
        discard(raw p_expect(p, TokenKind.PRBracket));
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprArrayLiteralExpr, sp,
                                 0i32, w.start, w.count, 0i64));
    }

    if (k == TokenKind.PLParen) {
        discard(raw p_advance(p));
        ExprId:inner = raw p_parse_expr(p);
        discard(raw p_expect(p, TokenKind.PRParen));
        pass inner;
    }

    // A template: TemplateStart (TemplatePart | InterpStart expr InterpEnd)*
    // TemplateEnd. `&{ }` is the WHOLE formatting mechanism (D-053) -- there is
    // no specifier language -- so this is where formatting enters the AST.
    if (k == TokenKind.TemplateStart) {
        discard(raw p_advance(p));
        int32:mark = raw ast_scratch_mark(p.ast);
        while (true) {
            TokenKind:tk = raw p_kind(p);
            if (tk == TokenKind.TemplateEnd) { discard(raw p_advance(p)); break; }
            if (tk == TokenKind.Eof) { break; }
            if (tk == TokenKind.TemplatePart) {
                Token:part = raw p_advance(p);
                ExprId:pe = raw ast_add_expr(p.ast, ExprKind.ExprStringLiteral,
                                               part.span, 0i32, 0i32, 0i32,
                                               part.payload);
                drop ast_scratch_push(p.ast, pe.index);
            } else {
                if (tk == TokenKind.InterpStart) {
                    discard(raw p_advance(p));
                    ExprId:ie = raw p_parse_expr(p);
                    discard(raw p_expect(p, TokenKind.InterpEnd));
                    drop ast_scratch_push(p.ast, ie.index);
                } else {
                    drop p_error(p, raw PARSE_UNEXPECTED(),
                                 "unexpected token in a template literal");
                    break;
                }
            }
        }
        IdSpan:w = raw ast_scratch_commit(p.ast, mark);
        pass (raw ast_add_expr(p.ast, ExprKind.ExprTemplateLiteral, sp,
                                 0i32, w.start, w.count, 0i64));
    }

    if (k == TokenKind.KwNIL) {
        discard(raw p_advance(p));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprSentinelLiteral, sp,
                                 0i32, 0i32, 0i32, 0i64));
    }
    if (k == TokenKind.KwNULL) {
        discard(raw p_advance(p));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprSentinelLiteral, sp,
                                 0i32, 0i32, 0i32, 1i64));
    }
    // AST_REFERENCE 3.1 names THREE sentinels and only two were here. `ERR` is
    // the `tbb` taint value (D-008), so a missing case meant no program could
    // name the state the whole type exists to carry.
    if (k == TokenKind.KwERR) {
        discard(raw p_advance(p));
        pass (raw ast_add_expr(p.ast, ExprKind.ExprSentinelLiteral, sp,
                                 0i32, 0i32, 0i32, 2i64));
    }

    // `simd(x, y, z)` -- a VECTOR CONSTRUCTOR. The name is a builtin TYPE keyword,
    // so it never reaches the identifier path and would read as "expected an
    // expression" (AST_REFERENCE 3.6).
    //
    // `simd` AND NOTHING ELSE, since D-135. This fired for EVERY builtin type
    // keyword followed by `(`, which was right while `vec2`, `vec3` and `vec9` were
    // keywords — and wrong for the rest of them: `int32(5i32)` read as a vector
    // constructor, and a cast is `x => int32` rather than a call, so what it should
    // read as is a parse error.
    //
    // The vector names are LIBRARY types now, so `vec3(1.0f64, 2.0f64, 3.0f64)` is
    // an ordinary call over an ordinary identifier and needs nothing here.
    if (k == TokenKind.KwSimd) {
        if ((raw p_peek_at(p, 1i64)).kind == TokenKind.PLParen) {
            Token:vt = raw p_advance(p);
            discard(raw p_advance(p));
            int32:vmark = raw ast_scratch_mark(p.ast);
            if (!(raw p_at(p, TokenKind.PRParen))) {
                ExprId:c1 = raw p_parse_expr(p);
                drop ast_scratch_push(p.ast, c1.index);
                while (raw p_accept(p, TokenKind.PComma)) {
                    ExprId:cN = raw p_parse_expr(p);
                    drop ast_scratch_push(p.ast, cN.index);
                }
            }
            discard(raw p_expect(p, TokenKind.PRParen));
            IdSpan:vw = raw ast_scratch_commit(p.ast, vmark);
            pass (raw ast_add_expr(p.ast, ExprKind.ExprVectorCtorExpr, sp,
                                     0i32, vw.start, vw.count,
                                     (vt.kind =>! int32) =>! int64));
        }
    }

    // `is_err(tbbValue)` -- a KEYWORD OPERATOR with a parenthesised operand, the
    // same shape `move(place)` has (D-065).
    //
    // It is a keyword, so it never reached the identifier path below and
    // `is_err(x)` read as "expected an expression" -- while `OP_REFERENCE` §5
    // requires it as the one test that does not trap on an ERR value. Nothing
    // could have caught it: no node existed for it to parse into (D-096).
    if (k == TokenKind.KwIs_err) {
        pass (raw p_keyword_operand(p, sp, ExprKind.ExprIsErrExpr));
    }

    // `Result{value: v, err: e}` -- THE ONLY CONSTRUCTOR IN THE LANGUAGE, and
    // per AST_REFERENCE §2 the only legal operand of `return`. `pass` and `fail`
    // are sugar over it (TYPE_REFERENCE §11).
    //
    // It could not be written. The struct-literal path below is gated on
    // `TokenKind.Ident` and `Result` is `KwResult`, so the real parser answered
    // "expected an expression" for the form every function in the language
    // ultimately returns (D-097).
    if (k == TokenKind.KwResult) {
        pass (raw p_result_literal(p, sp));
    }

    // An expression-`pick` -- one whose arms `give` (D-059). It is the only way
    // to initialize a variable by matching, since an uninitialized variable is a
    // compile error, which is why D-059 kept it.
    if (k == TokenKind.KwPick) {
        pass (raw p_parse_pick_expr(p));
    }

    if (k == TokenKind.Ident) {
        Token:t = raw p_advance(p);
        // `Name { field: value, ... }` -- a struct literal. Distinguished from a
        // block by the `ident :` that must follow the brace — and, since
        // 1.1.12c, by what follows THAT: `Name { Type:name = ...` is a BLOCK
        // whose first statement declares a local of a user-named type, found
        // when `joins JOIN_2S {` swallowed a thread body whose first
        // statement was `ByteWriter:w = ...` as a literal. A field's value
        // can never be followed by `=` or `;` (assignment is a statement,
        // not an expression), so those two settle it.
        if (raw p_at(p, TokenKind.PLBrace)) {
            if ((raw p_peek_at(p, 1i64)).kind == TokenKind.Ident) {
                if ((raw p_peek_at(p, 2i64)).kind == TokenKind.PColon) {
                    TokenKind:p4 = (raw p_peek_at(p, 4i64)).kind;
                    bool:is_decl = (p4 == TokenKind.OpAssign);
                    if (p4 == TokenKind.PSemi) { is_decl = true; }
                    if (!is_decl) {
                        pass (raw p_struct_literal(p, sp, t.payload));
                    }
                }
            }
        }
        // A NAME, not an access with a missing operand. Emitting a
        // MemberAccessExpr with a zero base would make `x` and `(nothing).x` the
        // same node, and every walker of an access chain would have to know that
        // a zero base secretly means "stop, this was a name" (AST_REFERENCE §3.3).
        pass (raw ast_add_expr(p.ast, ExprKind.ExprIdentifierExpr, sp,
                                 0i32, 0i32, 0i32, t.payload));
    }

    drop p_error(p, raw PARSE_UNEXPECTED(), "expected an expression");
    pass (raw expr_none());
};

// `kw ( expr )` -- the shape shared by `move` and `is_err`. The parens are part
// of the operator rather than a grouping, so they are required.
func:p_keyword_operand = ExprId(Parser->:p, Span:sp, ExprKind:kind) never fails {
    discard(raw p_advance(p));
    discard(raw p_expect(p, TokenKind.PLParen));
    ExprId:o = raw p_parse_expr(p);
    discard(raw p_expect(p, TokenKind.PRParen));
    pass (raw ast_add_expr(p.ast, kind, sp, o.index, 0i32, 0i32, 0i64));
};

// `Result{value: v, err: e}` -- A FIXED SHAPE, not a general struct literal.
//
// Exactly two fields, in either written order, either omissible, held in slots
// `a` and `b`. It does not reuse `StructLiteralExpr` because that node's window
// alternates INTERNED NAMES with values, and `Result` is a keyword with no intern
// index -- putting a token kind where a name index belongs is the same confusion
// that made `Result<int32>` report "there is no type named" (D-096).
//
// `<T>` is never written: it comes from the enclosing function's declared success
// type, which is what makes `pass(v)` and `fail(e)` expressible as sugar.
//
// `Optional` HAS NO COUNTERPART HERE and deliberately so (D-099). Its empty value
// is `NIL` and its full one is the value itself, so there is nothing for a
// literal form to build. A draft of this function was generalised to serve both
// wrappers before that was checked; the note is left because the near-miss is the
// same one D-097 records.
//
// EVERY NAME IS ANSWERED. What stood here matched the two it knew and let any
// other fall through untouched, so `Result{value: v, is_error: true}` parsed
// clean and dropped a field the writer believed they had set -- the prototype
// stored `is_error` (D-069), so that is a spelling somebody arrives with rather
// than an idle typo. A silently discarded field is the failure mode this whole
// literal exists to avoid.
func:p_result_literal = ExprId(Parser->:p, Span:sp) never fails {
    discard(raw p_advance(p));
    discard(raw p_expect(p, TokenKind.PLBrace));
    int32:value = 0i32;
    int32:errv = 0i32;
    bool:saw_value = false;
    bool:saw_error = false;
    while (true) {
        if (raw p_at(p, TokenKind.PRBrace)) { break; }
        if (raw p_at_end(p)) { break; }

        // THE FIELD NAME MUST BE AN IDENTIFIER BEFORE ITS PAYLOAD IS READ AS ONE.
        // `field.payload` is an intern index only for `Ident`; on any other token
        // it is that token's own payload, so `Result{5: v}` either named whatever
        // string sits at index five or ran `intern_get` off the end of the table,
        // which fails the parse through `relay` instead of producing a diagnostic.
        Token:field = raw p_advance(p);
        bool:named = (field.kind == TokenKind.Ident);
        if (!named) {
            drop p_error_at(p, raw PARSE_WRAPPER_FIELD(),
                "a `Result{…}` field is named `value` or `error`, and this is not a name",
                field.span);
        }
        discard(raw p_expect(p, TokenKind.PColon));
        ExprId:v = raw p_parse_expr(p);

        // The names are matched HERE rather than kept, so the node's slots mean
        // one thing regardless of the order they were written in.
        if (named) {
            string:text = raw intern_get(p.interns, (field.payload =>! int32));
            if (raw string_eq(text, "value")) {
                // A REPEATED FIELD IS NOT AN OVERWRITE. Taking the last one
                // silently discards the first, which is the same lost-value
                // defect as an unknown name wearing different clothes.
                if (saw_value) {
                    drop p_error_at(p, raw PARSE_WRAPPER_FIELD(),
                        "`value` is given twice here, and a `Result{…}` has one of each field",
                        field.span);
                }
                saw_value = true;
                value = v.index;
            } else {
                if (raw string_eq(text, "err")) {
                    if (saw_error) {
                        drop p_error_at(p, raw PARSE_WRAPPER_FIELD(),
                            "`error` is given twice here, and a `Result{…}` has one of each field",
                            field.span);
                    }
                    saw_error = true;
                    errv = v.index;
                } else {
                    // `is_error` EARNS ITS OWN SENTENCE. The prototype stored it
                    // as a third field and D-069 made it derived, so somebody
                    // writing it learned it somewhere real and needs to be told
                    // what replaced it -- not merely that the name is unknown.
                    string:m1 = raw string_concat("`", text);
                    string:m2 = raw string_concat(m1,
                        "` is not a field of `Result{…}`, which has `value` and `error`");
                    if (raw string_eq(text, "is_error")) {
                        m2 = raw string_concat(m2,
                            "; `.is_error` is derived from `error` and is read, never written (D-069)");
                    }
                    drop p_error_at(p, raw PARSE_WRAPPER_FIELD(), move(m2), field.span);
                }
            }
        }
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    discard(raw p_expect(p, TokenKind.PRBrace));
    pass (raw ast_add_expr(p.ast, ExprKind.ExprResultLiteralExpr, sp,
                             value, errv, 0i32, 0i64));
};

// Each field contributes TWO entries to the window: the name's intern index and
// then the value's handle. One window, documented once, rather than a second
// parallel one to keep in step.
func:p_struct_literal = ExprId(Parser->:p, Span:sp, int64:name) never fails {
    discard(raw p_expect(p, TokenKind.PLBrace));
    int32:mark = raw ast_scratch_mark(p.ast);
    while (!(raw p_at(p, TokenKind.PRBrace))) {
        if (raw p_at_end(p)) { break; }
        Token:f = raw p_advance(p);
        discard(raw p_expect(p, TokenKind.PColon));
        ExprId:v = raw p_parse_expr(p);
        drop ast_scratch_push(p.ast, f.payload =>! int32);
        drop ast_scratch_push(p.ast, v.index);
        if (!(raw p_accept(p, TokenKind.PComma))) { break; }
    }
    discard(raw p_expect(p, TokenKind.PRBrace));
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (raw ast_add_expr(p.ast, ExprKind.ExprStructLiteralExpr, sp,
                             0i32, w.start, w.count, name));
};
