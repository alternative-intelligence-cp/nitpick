// The identifier intern table.
//
// Written in subset 1 (meta/SUBSET_1.md §4).
//
// Identifier text is interned to an int32 so that a token payload fits in ONE
// MACHINE WORD -- the restriction SUBSET_1 section 1.2 records, and the reason
// the AST needs no pointers. Interning also makes identifier comparison an
// integer compare rather than a byte loop, which matters in a symbol table.

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
mod:intern;
error:BoundsId;
error:ProvenSlice;


pub struct:InternTable = {
    List<string>:v;

    // THE INDEX (1.5.2d, D-262 §2): open addressing over the text's FNV-1a
    // hash in a power-of-two table of intern ids, −1 empty, rebuilt at half
    // load. `intern_add` compared every interned string at every identifier
    // the lexer met until 1.5.2d — a scan inside the lexer's 12% of a
    // floor-only program's compile.
    List<int32>:index;
    int32:index_mask;
};

// Written here rather than added to the runtime floor: it is ordinary Nitpick
// over .ptr and .len, and every symbol in the runtime is one more thing that
// must be hand-written in LLVM IR and audited.
pub func:string_eq = bool(string:a, string:b) never fails {
    if (a.len != b.len) {
        pass false;
    }
    int64:i = 0i64;
    while (i < a.len) {
        if (a.ptr[i] != b.ptr[i]) {
            pass false;
        }
        i = i + 1i64;
    }
    pass true;
};

// STRICT LESS-THAN OVER IDENTIFIER NAMES, byte by byte, shorter-is-smaller on a
// shared prefix. It is named for its domain rather than being a general
// `string_lt`, because it compares `.ptr` bytes as int8 — SIGNED — and that is
// lexicographic order only while the bytes are ASCII. The lexer admits letters,
// digits and underscore in an identifier, so every name reaching here is; a
// general string comparison over arbitrary bytes would need the unsigned
// widening this deliberately does not do, and would be a different function.
//
// D-159 needs it: `dyn A & B` and `dyn B & A` must be ONE type with one layout,
// so the bound list is canonically ordered by name at interning.
pub func:name_lt = bool(string:a, string:b) never fails {
    int64:n = a.len;
    if (b.len < n) { n = b.len; }
    for (int64:i in 0i64...n) {
        if (a.ptr[i] != b.ptr[i]) {
            pass (a.ptr[i] < b.ptr[i]);
        }
    }
    pass (a.len < b.len);
};

pub func:intern_init = InternTable() never fails {
    InternTable:t = InternTable{ v: raw list_init::<string>(64i64),
                                 index: raw list_init::<int32>(512i64),
                                 index_mask: 0i32 };
    drop intern_index_reset(@t, 512i64);
    // INDEX 0 IS RESERVED for the empty string, the same convention the AST node
    // arrays use for their NONE node -- and for the same reason. An AST node
    // records an optional name as an intern index, and without a reserved zero
    // there is no value that means "absent": a `while` with no label and a
    // `while` labelled with whatever identifier happened to be interned first
    // would carry the identical payload. `break outer;` would then match an
    // unlabelled loop. Reserving the slot costs one entry and makes that state
    // unrepresentable.
    discard(raw intern_add(@t, ""));
    pass t;
};

pub func:intern_none = int32() never fails { pass 0i32; };
pub func:intern_is_none = bool(int32:i) never fails { pass (i == 0i32); };

// AN INTERN ID IS int32 BY AST DESIGN — every node stores a name as an int32
// index — so the table's int64 count has to narrow to become one. The
// narrowing is GUARDED rather than spelled `=>!`: a silent truncation would
// alias two different names to one id, which is the single failure this table
// exists to make impossible, and a table of more than 2^31 names is a defect
// long before it is a capacity.
func:intern_id = int32(int64:n) never fails {
    if (n > 2147483647i64) { !!! BoundsId; }
    pass (n =>! int32);
};

// Interning the same text twice yields the same index. That is the whole point:
// downstream, two identifiers are the same name exactly when their indices are
// equal.
// `text` IS KEPT (D-183): the table stores it and outlives this call, so the
// caller transfers ownership rather than lending. Note the early return above
// — an already-interned string is NOT stored, and the transferred value is
// dropped at this function's exit like any owned local. That is correct: the
// caller gave it up, and the table already has an equal one.
// THE TABLE, EMPTIED TO A CAPACITY (a power of two, at least 16): every slot −1.
func:intern_index_reset = NIL(InternTable->:t, int64:cap) never fails {
    int64:c = 16i64;
    while (c < cap) { c = c * 2i64; }
    t.index.count = 0i64;   // an int32 list: truncating drops nothing
    drop list_reserve(@t.index, c);
    int64:i = 0i64;
    while (i < c) { drop list_push(@t.index, 0i32 - 1i32); i = i + 1i64; }
    t.index_mask = (c - 1i64) =>! int32;
    pass NIL;
};

// The slot a text lives in, or the empty slot it would take: linear probing
// under the mask, the text compared on every occupied slot met.
func:intern_index_slot = int64(InternTable->:t, string:text) never fails {
    int64:mask = t.index_mask => int64;
    int64:slot = ((raw fnv1a_bytes(text, raw fnv1a_seed())) =>! int64) & mask;
    bool:searching = true;
    while (searching) {
        int32:e = t.index.items[slot];
        if (e < 0i32) { searching = false; }
        else {
            if (raw string_eq(t.v.items[e => int64], text)) { searching = false; }
            else { slot = (slot + 1i64) & mask; }
        }
    }
    pass slot;
};

// AT HALF LOAD THE TABLE DOUBLES and every string is re-entered from `v`.
func:intern_index_grow_if_needed = NIL(InternTable->:t) never fails {
    int64:cap = t.index.count;
    if (((t.v.count + 1i64) * 2i64) <= cap) { pass NIL; }
    drop intern_index_reset(t, cap * 2i64);
    int64:i = 0i64;
    while (i < t.v.count) {
        int64:slot = raw intern_index_slot(t, t.v.items[i]);
        t.index.items[slot] = i =>! int32;
        i = i + 1i64;
    }
    pass NIL;
};

pub func:intern_add = int32(InternTable->:t, move string:text) never fails {
    // ONE PROBE (1.5.2d, D-262 §2) where a scan with a string comparison per
    // interned string stood.
    drop intern_index_grow_if_needed(t);
    int64:slot = raw intern_index_slot(t, text);
    int32:found = t.index.items[slot];
    if (found >= 0i32) { pass found; }
    int32:index = raw intern_id(t.v.count);
    drop list_push(@t.v, move(text));
    t.index.items[slot] = index;
    pass index;
};

pub func:intern_get = string(InternTable->:t, int32:index) never fails {
    if (index < 0i32) {
        !!! BoundsId;
    }
    if ((index => int64) >= t.v.count) {
        !!! BoundsId;
    }
    // A VIEW of container-owned storage (D-183): cap 0, drops free nothing.
    pass (string_from_bytes(t.v.items[index => int64].ptr, t.v.items[index => int64].len));
};

pub func:intern_count = int32(InternTable->:t) never fails {
    pass (raw intern_id(t.v.count));
};

// A BOUNDS-PROVEN SLICE (D-163, 1.1.1). The caller has already established
// `0 <= lo <= hi <= s.len`, so the builtin cannot fail — and a failure anyway
// is an internal defect, trapped with the one greppable proven-slice code.
// A wrapper rather than `?!` at each site because a bare-builtin call carries
// no checker type, which the `?!` lowering needs; the Result binding below is
// the shape the emitter has always lowered.
pub func:slice_proven = string(string:s, int64:lo, int64:hi) never fails {
    pass (string_slice(s, lo, hi) ?! ProvenSlice);
};

// --- FNV-1a, THE COMPILER'S ONE COPY (D-123, D-179; collapsed at 1.4.2b) -----
//
// D-179 derives every error constant's identity from `module.Name` through
// this step, and both the RESOLVER (which assigns the code) and the EMITTER
// (which matches a qualified pattern against one) must get the same answer.
// They had a copy each until 1.4.2b, kept in step by a comment asking them not
// to drift; now there is one function and the question cannot arise. The
// `extern` INTERFACE HASH (D-149, `bridge_stubs.npk`) rides these same three
// functions since 1.4.7 — it carried its own copy of all three, which the
// 1.4.2b collapse did not see and the 1.4.6 switch found overflowing.
//
// THE MULTIPLY IS DELIBERATELY MODULAR — the mixing IS the wraparound — which
// D-210 made a trap for plain integers. The spelling is the documented idiom,
// widen-compute-truncate (D-210.3), the one the prelude's `fnv_mix` uses: the
// product of two 64-bit values fits in 128 bits, so it cannot overflow, and
// the `=>!` back to `uint64` STATES the truncation — which IS the reduction
// mod 2^64 that FNV specifies. Until 1.4.7 the product was assembled here from
// 32-bit halves instead, because `src/` was bounded by what the SEED could
// compile and the seed lowered no `uint128`; the builder switch (1.4.6)
// retired that bound, and the decomposition with it.
pub func:fnv1a_seed = uint64() never fails {
    pass ((3421887204u64 << 32u64) | 2216829733u64);
};

pub func:fnv1a_step = uint64(uint64:h, uint64:v) never fails {
    pass ((((h ^ v) => uint128) * 1099511628211u128) =>! uint64);
};

// The step over a name's bytes, low byte first (D-123's specified order).
pub func:fnv1a_bytes = uint64(string:sv, uint64:h0) never fails {
    uint64:h = h0;
    int64:i = 0i64;
    while (i < sv.len) {
        h = raw fnv1a_step(h, (sv.ptr[i] =>! uint64) & 255u64);
        i = i + 1i64;
    }
    pass h;
};
