// The identifier intern table.
//
// Subset 1 (meta/SUBSET_1.md).
//
// Identifier text is interned to an int32 so that a token payload fits in ONE
// MACHINE WORD -- the restriction SUBSET_1 section 1.2 records, and the reason
// the AST needs no pointers. Interning also makes identifier comparison an
// integer compare rather than a byte loop, which matters in a symbol table.

pub struct:InternTable = {
    wild string->:items;
    int32:count;
    int32:cap;
};

// Written here rather than added to the runtime floor: it is ordinary Nitpick
// over .ptr and .len, and every symbol in the runtime is one more thing that
// must be hand-written in LLVM IR and audited.
pub func:string_eq = bool(string:a, string:b) never fails {
    if (a.len != b.len) {
        pass false;
    }
    int64:i = 0i64;
    while (i < a.len) {
        if (a.ptr[i] != b.ptr[i]) {
            pass false;
        }
        i = i + 1i64;
    }
    pass true;
};

// STRICT LESS-THAN OVER IDENTIFIER NAMES, byte by byte, shorter-is-smaller on a
// shared prefix. It is named for its domain rather than being a general
// `string_lt`, because it compares `.ptr` bytes as int8 — SIGNED — and that is
// lexicographic order only while the bytes are ASCII. The lexer admits letters,
// digits and underscore in an identifier, so every name reaching here is; a
// general string comparison over arbitrary bytes would need the unsigned
// widening this deliberately does not do, and would be a different function.
//
// D-159 needs it: `dyn A & B` and `dyn B & A` must be ONE type with one layout,
// so the bound list is canonically ordered by name at interning.
pub func:name_lt = bool(string:a, string:b) never fails {
    int64:n = a.len;
    if (b.len < n) { n = b.len; }
    int64:i = 0i64;
    while (i < n) {
        if (a.ptr[i] != b.ptr[i]) {
            pass (a.ptr[i] < b.ptr[i]);
        }
        i = i + 1i64;
    }
    pass (a.len < b.len);
};

pub func:intern_init = InternTable() never fails {
    int64:n = 64i64;
    wild int8->:raw_mem = alloc(n * #size_of<string>());
    InternTable:t = InternTable{
        items: raw_mem =>! wild string->,
        count: 0i32,
        cap: 64i32
    };
    // INDEX 0 IS RESERVED for the empty string, the same convention the AST node
    // arrays use for their NONE node -- and for the same reason. An AST node
    // records an optional name as an intern index, and without a reserved zero
    // there is no value that means "absent": a `while` with no label and a
    // `while` labelled with whatever identifier happened to be interned first
    // would carry the identical payload. `break outer;` would then match an
    // unlabelled loop. Reserving the slot costs one entry and makes that state
    // unrepresentable.
    discard(raw intern_add(@t, ""));
    pass t;
};

pub func:intern_none = int32() never fails { pass 0i32; };
pub func:intern_is_none = bool(int32:i) never fails { pass (i == 0i32); };

func:intern_grow = NIL(InternTable->:t) never fails {
    int32:newcap = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items =>! wild int8->,
                                (newcap => int64) * #size_of<string>());
    t.items = bigger =>! wild string->;
    t.cap = newcap;
    pass NIL;
};

// Interning the same text twice yields the same index. That is the whole point:
// downstream, two identifiers are the same name exactly when their indices are
// equal.
pub func:intern_add = int32(InternTable->:t, string:text) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        if (raw string_eq(t.items[i => int64], text)) {
            pass i;
        }
        i = i + 1i32;
    }
    if (t.count >= t.cap) {
        drop intern_grow(t);
    }
    t.items[t.count => int64] = text;
    int32:index = t.count;
    t.count = t.count + 1i32;
    pass index;
};

pub func:intern_get = string(InternTable->:t, int32:index) never fails {
    if (index < 0i32) {
        !!! 3tbb32;
    }
    if (index >= t.count) {
        !!! 3tbb32;
    }
    pass t.items[index => int64];
};

pub func:intern_count = int32(InternTable->:t) never fails {
    pass t.count;
};

// A BOUNDS-PROVEN SLICE (D-163, 1.1.1). The caller has already established
// `0 <= lo <= hi <= s.len`, so the builtin cannot fail — and a failure anyway
// is an internal defect, trapped with the one greppable proven-slice code.
// A wrapper rather than `?!` at each site because a bare-builtin call carries
// no checker type, which the `?!` lowering needs; the Result binding below is
// the shape the emitter has always lowered.
pub func:slice_proven = string(string:s, int64:lo, int64:hi) never fails {
    Result<string>:r = string_slice(s, lo, hi);
    if (r.is_error) { !!! 5tbb32; }
    pass r.value;
};
