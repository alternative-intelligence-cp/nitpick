// `#[derive(…)]` — reading the attribute, and refusing what cannot be generated.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.6.5.
//
// `#[derive(Copy, Clone)]` PARSED AND MEANT NOTHING until this existed — an
// ordinary `DeclAttribute` named `derive` with its arguments in a window, read by
// no one. That is the same "parses and means nothing" shape cycle 0.5 spent eight
// subcycles clearing out, and it was the last one in the frontend.
//
// SEVEN, NOT NINE (D-123). `TRAITS_REFERENCE.md` §2.5 listed `Default` and
// `Display` too, and both left the list for reasons a reader who writes one needs
// to be told — they are not typos, and a message that treats them as unknown names
// sends someone to check their spelling.
//
// DERIVE IS A MACRO THAT DOES NOT LOOK LIKE ONE. It emits declarations, so it runs
// in the expansion phase and inherits the constraint that its output is complete
// before resolution begins.

mod:derive_gen;
use "../source_location.npk".*;
use "../ast_kind.npk".*;
use "../ast.npk".*;
use "../intern.npk".*;
use "../diagnostics.npk".*;
use "../parse_expr.npk".*;
use "../parse_decl.npk".*;
use "../parse_decorate.npk".*;
use "../token.npk".*;
use "../token_kind.npk".*;
use "../token_name.npk".*;   // token_kind_name (D-250)
use "../parse_type.npk".*;
use "../lexer.npk".*;
use "../parser.npk".*;
use "../source.npk".*;
use "../module_graph.npk".*;
use "./derive_codes.npk".*;
use "../scalar_table.npk".*;   // builtin_scalar_family -- the one classification (D-257, D-258)

// --- the seven ------------------------------------------------------------------
//
// Named by index rather than by string at every call site, for the reason the token
// table is generated rather than hand-listed: a name compared in two places is a
// name that can be spelled differently in one of them.
pub func:DERIVE_NONE = int32() never fails       { pass 0i32; };
pub func:DERIVE_EQ = int32() never fails         { pass 1i32; };
pub func:DERIVE_ORD = int32() never fails        { pass 2i32; };
pub func:DERIVE_PARTIAL_ORD = int32() never fails{ pass 3i32; };
pub func:DERIVE_CLONE = int32() never fails      { pass 4i32; };
pub func:DERIVE_HASH = int32() never fails       { pass 5i32; };
pub func:DERIVE_TO_STRING = int32() never fails  { pass 6i32; };
pub func:DERIVE_DEBUG = int32() never fails      { pass 7i32; };
pub func:DERIVE_MAX = int32() never fails        { pass 7i32; };

pub func:derive_of_name = int32(string:n) never fails {
    if (raw string_eq(n, "Eq"))         { pass (raw DERIVE_EQ()); }
    if (raw string_eq(n, "Ord"))        { pass (raw DERIVE_ORD()); }
    if (raw string_eq(n, "PartialOrd")) { pass (raw DERIVE_PARTIAL_ORD()); }
    if (raw string_eq(n, "Clone"))      { pass (raw DERIVE_CLONE()); }
    if (raw string_eq(n, "Hash"))       { pass (raw DERIVE_HASH()); }
    if (raw string_eq(n, "ToString"))   { pass (raw DERIVE_TO_STRING()); }
    if (raw string_eq(n, "Debug"))      { pass (raw DERIVE_DEBUG()); }
    pass (raw DERIVE_NONE());
};

// WHY A REMOVED ONE IS NOT DERIVABLE, in the message rather than in a document the
// reader has to go and find. Both sentences are D-123's, compressed.
func:removed_reason = string(string:n) never fails {
    if (raw string_eq(n, "Default")) {
        pass "`Default` is not derivable: deriving it means the compiler choosing values that carry meaning, and several obvious choices are false here — `fd` zero is stdin, `tbb32` zero claims `no error`, a pointer zero is NULL. If a type wants a default, write one, and then the reason it is that value is somewhere a reviewer can read";
    }
    pass "`Display` is not derivable: it was a second name for `ToString`'s job, and both would generate a function returning `string` since formatting is `&{ }` interpolation. Derive `ToString`";
};

func:is_removed = bool(string:n) never fails {
    if (raw string_eq(n, "Default")) { pass true; }
    pass (raw string_eq(n, "Display"));
};

// --- reading one attribute ------------------------------------------------------

pub struct:DeriveSet = {
    // ONE FLAG PER DERIVE, indexed by the constants above. A count would answer
    // "how many" and this has to answer "which", and a duplicate is a question
    // about one of them rather than about the total.
    bool[8]:wanted;
    int32:count;
};

pub func:deriveset_none = DeriveSet() never fails {
    // EIGHT `false`S, WRITTEN OUT. The fill loop this replaces was refused by
    // definite assignment (a loop that happens to cover every index is coverage
    // the analysis cannot see), and `[]` — D-139's zero array — is not usable
    // HERE yet: this module is seed-compiled until 1.3, and the seed lowers an
    // empty literal for a sized array wrongly. The explicit literal means the
    // same thing under both compilers.
    DeriveSet:s = DeriveSet{ wanted: [false, false, false, false,
                                      false, false, false, false],
                             count: 0i32 };
    pass s;
};

pub func:derive_wants = bool(DeriveSet:s, int32:which) never fails {
    if (which < 0i32) { pass false; }
    if (which > (raw DERIVE_MAX())) { pass false; }
    pass (s.wanted[which => int64]);
};

// EVERY `#[derive]` ON ONE DECLARATION, READ TOGETHER. Two attributes are one list
// as far as the type is concerned — `#[derive(Eq)] #[derive(Eq)]` is the same
// duplicate `#[derive(Eq, Eq)]` is, and finding one and not the other would make
// the rule depend on how the author happened to lay it out.
pub func:read_derives = DeriveSet(Ast->:ast, InternTable->:interns,
                                  DiagList->:diags, DeclNode:d, int32:attr_count,
                                  bool:is_type) never fails {
    DeriveSet:want = raw deriveset_none();
    for (int32:a in 0i32...attr_count) {
        DeclNode:at = raw ast_decl(ast, raw item_attr(ast, d, a));
        string:aname = raw intern_get(interns, raw attr_name(at));
        if (raw string_eq(aname, "derive")) {
            drop read_one_derive(ast, interns, diags, at, @want, is_type);
        }
    }
    pass want;
};

func:read_one_derive = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                           DeclNode:at, DeriveSet->:want, bool:is_type) never fails {
    // THE TARGET IS CHECKED ONCE, AT THE ATTRIBUTE, and before the names are. Every
    // one of the seven is generated FROM a type's shape, so on a function there is
    // nothing to generate from and the names do not matter yet.
    if (!is_type) {
        drop diaglist_push(diags, raw diag_error(raw DERIVE_TARGET(),
            "`#[derive]` generates an implementation from a type's shape — its fields, or its variants — so it belongs on a `struct` or an `enum` and there is nothing here to generate from",
            at.span));
        pass NIL;
    }

    int32:n = raw attr_arg_count(at);
    int32:i = 0i32;
    while (i < n) {
        ExprId:arg = ExprId{ index: raw ast_id_at(ast, raw attr_arg_start(at), i) };
        ExprNode:ae = raw ast_expr(ast, arg);

        // A DERIVE ARGUMENT IS A BARE NAME. Anything else is a program that means
        // something the attribute cannot express, and reading only the ones that
        // happen to be identifiers would silently ignore the rest.
        if (ae.kind != ExprKind.ExprIdentifierExpr) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_UNKNOWN(),
                "`#[derive]` takes the names of traits to generate, and this argument is not a name",
                ae.span));
            i = i + 1i32;
            continue;
        }

        string:tname = raw intern_get(interns, (raw expr_name(ae)) =>! int32);
        if (raw is_removed(tname)) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_REMOVED(),
                raw removed_reason(tname), ae.span));
            i = i + 1i32;
            continue;
        }

        int32:which = raw derive_of_name(tname);
        if (which == (raw DERIVE_NONE())) {
            string:m1 = string_concat("`", tname);
            string:m2 = string_concat(m1,
                "` is not one of the seven traits `#[derive]` can generate: Eq, Ord, PartialOrd, Clone, Hash, ToString, Debug. A trait the program declares is implemented by writing an `impl`, because the compiler has no way to know what its methods should do");
            drop diaglist_push(diags, raw diag_error(raw DERIVE_UNKNOWN(), move(m2), ae.span));
            i = i + 1i32;
            continue;
        }

        if (want.wanted[which => int64]) {
            string:d1 = string_concat("`", tname);
            string:d2 = string_concat(d1,
                "` is derived twice for this type, which would generate two implementations of one trait — the thing coherence refuses when they are written by hand");
            drop diaglist_push(diags, raw diag_error(raw DERIVE_DUPLICATE(), move(d2), ae.span));
            i = i + 1i32;
            continue;
        }

        want.wanted[which => int64] = true;
        want.count = want.count + 1i32;
        i = i + 1i32;
    }
    pass NIL;
};

// --- generating the implementations ---------------------------------------------
//
// AS SOURCE, PARSED. Building `DeclImplDecl` and `DeclFunctionDecl` nodes by hand
// would be several hundred lines of slot-filling for seven derives, and every one
// of those slots is a chance to write a member count into the field a trait id
// lives in — which is the defect this compiler has paid for seven times. Generated
// TEXT goes through the same parser as everything else, so it cannot produce a
// malformed tree; the worst it can do is fail to parse, loudly.
//
// It is also readable. `--emit-derived` is a thing a driver can offer later, and
// what it would print is exactly what is built here.

func:PRIME_TEXT = string() never fails { pass "100000001B3hexu64"; };
// The FNV-1a 64 offset basis is 0xCBF29CE484222325 = 14695981039346656037,
// which is ABOVE the 64-bit literal envelope (D-148): values past 2^63-1 are
// constructed, not spelled. 2^64 - 14695981039346656037 = 3750763034362895579,
// and unsigned subtraction wraps by definition (D-037), so this difference IS
// the basis, bit for bit.
func:BASIS_TEXT = string() never fails { pass "(0u64 - 3750763034362895579u64)"; };

// IS THIS FIELD'S SPELLED TYPE `simd<…>`? Derive runs before collection,
// so the TYPE TABLE does not exist yet — but the field's own type NODE
// does, and a builtin-named node carries its TokenKind (D-194's derives
// branch on it: `Eq` collapses lanes, five others refuse by name).
func:dv_field_is_simd = bool(Ast->:ast, DeclNode:m) never fails {
    TypeNode:tn = raw ast_type(ast, raw field_type(m));
    if (tn.kind != TypeKind.TypeNamedType) { pass false; }
    if (!(raw type_name_is_builtin(tn))) { pass false; }
    pass ((raw type_name_index(tn)) == ((TokenKind.KwSimd =>! int32) =>! int64));
};

func:dv_has_simd_field = bool(Ast->:ast, DeclNode:d) never fails {
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            if (raw dv_field_is_simd(ast, m)) { pass true; }
        }
    }
    pass false;
};

// Three and five pieces, joined -- the frontend has no `cat3`/`cat5` (those
// are the IR writer's), and a generated body is a handful of pieces per line.
func:dvc3 = string(string:a, string:b, string:c) never fails {
    pass (string_concat(string_concat(a, b), c));
};
func:dvc5 = string(string:a, string:b, string:c, string:d, string:e) never fails {
    pass (string_concat(string_concat(raw dvc3(a, b, c), d), e));
};

// --- the sink every generated line goes through (D-259, 1.5.2b step 4) -----------
//
// ONE SEAM. Every piece of generated text is written by `dv_put`, which counts
// the newlines it appends and records, per line, the subject declaration, the
// trait being derived and the member the line reaches (`DerivedOrigin`). The
// generated module's header `mod:derived;` is line 1, so the sink starts at 2.
// `rehome_derived` reads the table after the front half ran; a diagnostic that
// reports inside `<derived-N>` -- a named field whose type turns out to lack the
// trait or to own, a builtin the prelude has no impl for under this trait -- is
// moved to the subject's declaration with the derive and the member named. The
// residue after D-258's classes is exactly those checker verdicts, each with a
// good message that only needs the right span; a table in the generator of
// what the checker will say would be the two-places-that-must-agree shape.
pub struct:DvSink = {
    string:text;
    int32:line;
    int32:subject;
    int32:trait_name;
    int32:member;
    bool:is_variant;
    List<DerivedOrigin>:origins;
};

func:dv_sink_init = DvSink() never fails {
    pass DvSink{ text: "", line: 2i32, subject: 0i32, trait_name: 0i32,
                 member: 0i32, is_variant: false,
                 origins: raw list_init::<DerivedOrigin>(64i64) };
};

func:dv_put = NIL(DvSink->:out, string:chunk) never fails {
    int64:i = 0i64;
    while (i < chunk.len) {
        if (chunk.ptr[i] == 10u8) {
            DerivedOrigin:o = DerivedOrigin{ file: 0i32, line: out.line,
                                             subject: out.subject,
                                             trait_name: out.trait_name,
                                             member: out.member,
                                             is_variant: out.is_variant };
            drop list_push(@out.origins, o);
            out.line = out.line + 1i32;
        }
        i = i + 1i64;
    }
    out.text = string_concat(out.text, chunk);
    pass NIL;
};

// The member the next lines reach, and the end of it.
func:dv_at_field = NIL(DvSink->:out, DeclNode:m) never fails {
    out.member = raw decl_name(m);
    out.is_variant = false;
    pass NIL;
};
func:dv_at_variant = NIL(DvSink->:out, DeclNode:m) never fails {
    out.member = raw decl_name(m);
    out.is_variant = true;
    pass NIL;
};
func:dv_at_none = NIL(DvSink->:out) never fails {
    out.member = 0i32;
    out.is_variant = false;
    pass NIL;
};

// --- member classes (D-258, 1.5.2b step 3) --------------------------------------
//
// ONE RULE FOR EVERY MEMBER: a derived body reaches each member through the
// trait it is deriving -- a builtin SCALAR through the PRELUDE's impl (D-257;
// `raw`, the region's bodies being `never fails`), a NAMED type or a PARAMETER
// of the subject through its own (`relay`, the trait declaring may-fail), a
// `string` FIELD through the prelude's four (`raw` but for `clone`, which
// allocates), a `simd` by `.any()` under `Eq` and by copy under `Clone`
// (D-194), a POINTER by `!=` under `Eq` (address identity) and by copy under
// `Clone`, an array of scalars by copy under `Clone` -- and a member no
// derived body can be written for refuses at the USER's declaration by name
// (DERIVE-006), never as a type error at a `<derived-N>` line nobody wrote.
//
// The generator sees SPELLINGS, not types -- derive runs before collection --
// so the spelling decides, through `builtin_scalar_family`: the one
// classification the prelude's generated region is also written from, so a
// scalar the prelude implements the trait for is a scalar this reaches. What
// the prelude does NOT implement (`bool` under `Ord`, a float under `Ord`, a
// `tfp` under `Hash`) is the checker's "no method", re-homed to the derive
// (D-259).
//
// This replaces D-250's operator form for builtins (D-161's no-bound story
// with it): a derived `partial_cmp` over a `flt64` field answered `Equal` for
// `nan` and a derived `cmp` presented a total order the type does not have;
// the answer lives in the prelude's one `flt64:PartialOrd` now, and a `Box<T>`
// under `#[derive(Eq)]` carries `T: Eq` instead of an `!=` on an opaque `T`
// that the emitter met at `Box<Point>` (DEF-16).
func:DVC_SCALAR = int32() never fails  { pass 1i32; };
func:DVC_NAMED = int32() never fails   { pass 2i32; };
func:DVC_PARAM = int32() never fails   { pass 3i32; };
func:DVC_STRING = int32() never fails  { pass 4i32; };
func:DVC_SIMD = int32() never fails    { pass 5i32; };
func:DVC_POINTER = int32() never fails { pass 6i32; };
func:DVC_ARRAY = int32() never fails   { pass 7i32; };
func:DVC_REFUSED = int32() never fails { pass 8i32; };

func:dv_kw = TokenKind(TypeNode:tn) never fails {
    pass (((raw type_name_index(tn)) =>! int32) =>! TokenKind);
};

// Is this spelled type a builtin scalar keyword -- one with a row in the
// prelude's region? `complex<X>` counts for a builtin element and for
// nothing else (the prelude implements the four ratified instances, D-199;
// over a parameter there is no impl to reach).
func:dv_is_scalar_node = bool(Ast->:ast, TypeNode:tn) never fails {
    if (tn.kind != TypeKind.TypeNamedType) { pass false; }
    if (!(raw type_name_is_builtin(tn))) { pass false; }
    TokenKind:k = raw dv_kw(tn);
    if (k == TokenKind.KwString) { pass false; }
    if (k == TokenKind.KwSimd)   { pass false; }
    int32:fam = raw builtin_scalar_family(k);
    if (fam == (raw SCALAR_NONE())) { pass false; }
    if (fam == (raw SCALAR_COMPLEX())) {
        if ((raw type_args_count(tn)) != 1i32) { pass false; }
        TypeNode:an = raw ast_type(ast, TypeId{ index: raw ast_id_at(ast, raw type_args_start(tn), 0i32) });
        if (an.kind != TypeKind.TypeNamedType) { pass false; }
        if (!(raw type_name_is_builtin(an))) { pass false; }
    }
    pass true;
};

func:dv_class = int32(Ast->:ast, InternTable->:interns, DeclNode:subject,
                      TypeId:t) never fails {
    TypeNode:tn = raw ast_type(ast, t);
    if (tn.kind == TypeKind.TypePointerType) { pass (raw DVC_POINTER()); }
    if (tn.kind == TypeKind.TypeArrayType)   { pass (raw DVC_ARRAY()); }
    if (tn.kind != TypeKind.TypeNamedType)   { pass (raw DVC_REFUSED()); }
    if (raw type_name_is_builtin(tn)) {
        TokenKind:k = raw dv_kw(tn);
        if (k == TokenKind.KwString) { pass (raw DVC_STRING()); }
        if (k == TokenKind.KwSimd)   { pass (raw DVC_SIMD()); }
        if (raw dv_is_scalar_node(ast, tn)) { pass (raw DVC_SCALAR()); }
        pass (raw DVC_REFUSED());
    }
    string:nm = raw intern_get(interns, (raw type_name_index(tn)) =>! int32);
    // `List<T>` is compiler-known and OWNING (D-247): a name, not a keyword.
    if (raw string_eq(nm, "List")) { pass (raw DVC_REFUSED()); }
    IdSpan:gw = raw decl_generic_window(ast, subject);
    for (int32:gi in 0i32...gw.count) {
        DeclNode:gp = raw ast_decl(ast, DeclId{ index: raw ast_id_at(ast, gw.start, gi) });
        if (raw string_eq(nm, raw intern_get(interns, raw decl_name(gp)))) { pass (raw DVC_PARAM()); }
    }
    pass (raw DVC_NAMED());
};

// THE LICENCE WORD a member's method call carries (D-163): the prelude's
// scalar rows and `string`'s comparisons and hash are `never fails` (`raw`); a
// named type's or a parameter's method is the trait's may-fail declaration,
// and `string:Clone` allocates (`relay`).
func:dv_lic = string(int32:cls, bool:is_clone) never fails {
    if (cls == (raw DVC_SCALAR())) { pass "raw "; }
    if (cls == (raw DVC_STRING())) {
        if (is_clone) { pass "relay "; }
        pass "raw ";
    }
    pass "relay ";
};

// An array whose element is spelled with a scalar keyword copies under `Clone`.
func:dv_array_of_scalars = bool(Ast->:ast, TypeId:t) never fails {
    TypeNode:tn = raw ast_type(ast, t);
    if (tn.kind != TypeKind.TypeArrayType) { pass false; }
    pass (raw dv_is_scalar_node(ast, raw ast_type(ast, raw type_element(tn))));
};

// The spelled text of a type node, for a refusal that names it.
func:dv_type_text = string(Ast->:ast, InternTable->:interns, TypeId:t) never fails {
    TypeNode:tn = raw ast_type(ast, t);
    if (tn.kind == TypeKind.TypePointerType)  { pass "a pointer"; }
    if (tn.kind == TypeKind.TypeArrayType)    { pass "an array or slice"; }
    if (tn.kind == TypeKind.TypeOptionalType) { pass "an `Optional`"; }
    if (tn.kind == TypeKind.TypeDynType)      { pass "a `dyn`"; }
    if (tn.kind == TypeKind.TypeFuncType)     { pass "a function type"; }
    if (tn.kind == TypeKind.TypeCStringType)  { pass "a `cstring`"; }
    if (tn.kind == TypeKind.TypeAnyType)      { pass "`any`"; }
    if (tn.kind != TypeKind.TypeNamedType)    { pass "this type"; }
    if (raw type_name_is_builtin(tn)) {
        pass (raw dvc3("`", raw token_kind_name(raw dv_kw(tn)), "`"));
    }
    pass (raw dvc3("`", raw intern_get(interns, (raw type_name_index(tn)) =>! int32), "`"));
};

// Does this derive's body reach the members at all? A struct's every derive
// reads its fields; an enum's `Hash` is the tag's (D-123) and its `ToString`/
// `Debug` the variant's name, so a payload is never read by those three.
func:dv_reaches_members = bool(bool:is_enum, int32:which) never fails {
    if (!is_enum) { pass true; }
    if (which == (raw DERIVE_HASH()))      { pass false; }
    if (which == (raw DERIVE_TO_STRING())) { pass false; }
    if (which == (raw DERIVE_DEBUG()))     { pass false; }
    pass true;
};

// WHY A DERIVE CANNOT BE WRITTEN OVER A MEMBER, by class and by derive -- or
// "" when it can. The classes the checker decides (a scalar, a named type, a
// parameter) are never refused here: what they lack is the checker's "no
// method", re-homed to the derive (D-259).
func:dv_refusal = string(Ast->:ast, int32:cls, TypeId:t, int32:which,
                         bool:payload) never fails {
    bool:comparison = false;
    if (which == (raw DERIVE_EQ()))          { comparison = true; }
    if (which == (raw DERIVE_ORD()))         { comparison = true; }
    if (which == (raw DERIVE_PARTIAL_ORD())) { comparison = true; }
    bool:is_clone = (which == (raw DERIVE_CLONE()));
    if (cls == (raw DVC_REFUSED())) {
        pass "no derived body can be written for that spelling -- an owning or erased type is compared, hashed, rendered or copied by a rule only its author can choose";
    }
    // A `string` PAYLOAD AND A BARE-`T` PAYLOAD BIND AS VIEWS (D-266, 1.5.2h):
    // the generated lending `pick` reads each in place, and `eq`, `cmp`,
    // `partial_cmp` and `clone` take their operands by value -- the lend. Until
    // D-266 both classes were refused under `Eq`, `Ord`, `PartialOrd` and
    // `Clone` (D-250; D-264, 1.5.2f), since a lending binding was a COPY and a
    // copy of an owning payload a second owner.
    if (cls == (raw DVC_STRING())) { pass ""; }
    if (cls == (raw DVC_PARAM()))  { pass ""; }
    if (cls == (raw DVC_POINTER())) {
        if (which == (raw DERIVE_EQ())) { pass ""; }
        if (is_clone) { pass ""; }
        pass "a pointer has identity and nothing else to derive from: it compares and copies by address, and has no order, hash or rendering of its own";
    }
    if (cls == (raw DVC_ARRAY())) {
        if (is_clone) {
            if (raw dv_array_of_scalars(ast, t)) { pass ""; }
            pass "an array copies under `Clone` only when its elements are scalars; anything else needs its own clone rule";
        }
        pass "an array has no `==`, no order, no hash and no rendering of its own";
    }
    pass "";
};

// What the refused derive would have had to decide -- the message's last clause.
func:dv_meaning = string(int32:which) never fails {
    if (which == (raw DERIVE_CLONE()))     { pass "the copy"; }
    if (which == (raw DERIVE_HASH()))      { pass "the hash"; }
    if (which == (raw DERIVE_TO_STRING())) { pass "the rendering"; }
    if (which == (raw DERIVE_DEBUG()))     { pass "the rendering"; }
    pass "the comparison";
};

// EVERY MEMBER A DERIVE WOULD READ IS CHECKED FIRST (D-258): a struct's fields,
// an enum's payloads where the derive binds them. One refusal per derive, at
// the user's declaration, naming the first member it cannot serve and why.
// True when the derive may be generated.
func:dv_admissible = bool(Ast->:ast, InternTable->:interns, DiagList->:diags,
                          DeclNode:d, bool:is_enum, int32:which,
                          string:trait_name) never fails {
    if (!(raw dv_reaches_members(is_enum, which))) { pass true; }
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            TypeId:ft = raw field_type(m);
            string:why = raw dv_refusal(ast, raw dv_class(ast, interns, d, ft), ft, which, false);
            if (why.len > 0i64) {
                drop diaglist_push(diags, raw diag_error(raw DERIVE_UNCOMPARABLE(),
                    raw dvc5("`", trait_name, "` cannot be derived over the field `",
                             raw intern_get(interns, raw decl_name(m)),
                             raw dvc5("` of ", raw dv_type_text(ast, interns, ft),
                                      " (D-258): ", why,
                                      raw dvc3("; write the impl and say what ", raw dv_meaning(which), " means"))),
                    d.span));
                pass false;
            }
        }
        if (m.kind == DeclKind.DeclEnumVariant) {
            int32:pc = raw variant_payload_count(m);
            for (int32:pi in 0i32...pc) {
                TypeId:pt = TypeId{ index: raw ast_id_at(ast, raw variant_payload_start(m), pi) };
                string:pwhy = raw dv_refusal(ast, raw dv_class(ast, interns, d, pt), pt, which, true);
                if (pwhy.len > 0i64) {
                    drop diaglist_push(diags, raw diag_error(raw DERIVE_UNCOMPARABLE(),
                        raw dvc5("`", trait_name, "` cannot be derived over the payload of `",
                                 raw intern_get(interns, raw decl_name(m)),
                                 raw dvc5("`, ", raw dv_type_text(ast, interns, pt),
                                          " (D-258): ", pwhy,
                                          raw dvc3("; write the impl and say what ", raw dv_meaning(which), " means"))),
                        d.span));
                    pass false;
                }
            }
        }
    }
    pass true;
};

// THE PARAMETERS A MEMBER'S SPELLING REACHES (D-258): a parameter names
// itself; a named type WITH arguments is walked into them (`Box<T>` as a
// member needs `Box<T>: Eq`, whose derived impl needs `T: Eq` -- conservative,
// and the checker will ask); a pointer, a `simd`, an array or any builtin stops
// the walk. One slot per subject parameter on the scratch at `mark`, set to 1
// when reached.
func:dv_mark_params = NIL(Ast->:ast, InternTable->:interns, DeclNode:subject,
                          TypeId:t, int32:mark) never fails {
    TypeNode:tn = raw ast_type(ast, t);
    if (tn.kind != TypeKind.TypeNamedType) { pass NIL; }
    if (raw type_name_is_builtin(tn)) { pass NIL; }
    string:nm = raw intern_get(interns, (raw type_name_index(tn)) =>! int32);
    IdSpan:gw = raw decl_generic_window(ast, subject);
    for (int32:gi in 0i32...gw.count) {
        DeclNode:gp = raw ast_decl(ast, DeclId{ index: raw ast_id_at(ast, gw.start, gi) });
        if (raw string_eq(nm, raw intern_get(interns, raw decl_name(gp)))) {
            drop ast_scratch_set(ast, mark, gi, 1i32);
            pass NIL;
        }
    }
    int32:n = raw type_args_count(tn);
    int32:start = raw type_args_start(tn);
    for (int32:i in 0i32...n) {
        drop dv_mark_params(ast, interns, subject,
                            TypeId{ index: raw ast_id_at(ast, start, i) }, mark);
    }
    pass NIL;
};

// THE HEAD OF ONE DERIVED IMPL (D-258): `impl:` for a plain subject;
// `impl:<T: X, U>:` for a generic one, with `: X` on EXACTLY the parameters
// that occur in a member the body reaches through X -- a parameter no reached
// member mentions gets no bound (`Tagged<T> = { int32:id; }` derives `Eq` for
// every `T`), and an enum's tag-only `Hash` reaches no member. The subject's
// OWN bounds are not copied: its instantiation already checks them.
func:dv_head = string(Ast->:ast, InternTable->:interns, DeclNode:d, bool:is_enum,
                      int32:which, string:trait_name) never fails {
    IdSpan:gw = raw decl_generic_window(ast, d);
    if (gw.count == 0i32) { pass "impl:"; }
    int32:mark = raw ast_scratch_mark(ast);
    for (int32:z in 0i32...gw.count) { drop ast_scratch_push(ast, 0i32); }
    if (raw dv_reaches_members(is_enum, which)) {
        int32:n = raw item_member_count(ast, d);
        for (int32:i in 0i32...n) {
            DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
            if (m.kind == DeclKind.DeclFieldDecl) {
                TypeId:ft = raw field_type(m);
                int32:cls = raw dv_class(ast, interns, d, ft);
                if ((cls == (raw DVC_NAMED())) || (cls == (raw DVC_PARAM()))) {
                    drop dv_mark_params(ast, interns, d, ft, mark);
                }
            }
            if (m.kind == DeclKind.DeclEnumVariant) {
                int32:pc = raw variant_payload_count(m);
                for (int32:pi in 0i32...pc) {
                    TypeId:pt = TypeId{ index: raw ast_id_at(ast, raw variant_payload_start(m), pi) };
                    int32:pcls = raw dv_class(ast, interns, d, pt);
                    if ((pcls == (raw DVC_NAMED())) || (pcls == (raw DVC_PARAM()))) {
                        drop dv_mark_params(ast, interns, d, pt, mark);
                    }
                }
            }
        }
    }
    string:params = "<";
    for (int32:gi in 0i32...gw.count) {
        if (gi > 0i32) { params = string_concat(params, ", "); }
        DeclNode:gp = raw ast_decl(ast, DeclId{ index: raw ast_id_at(ast, gw.start, gi) });
        params = string_concat(params, raw intern_get(interns, raw decl_name(gp)));
        if ((raw ast_scratch_at(ast, mark, gi)) != 0i32) {
            params = string_concat(params, string_concat(": ", trait_name));
        }
    }
    drop ast_scratch_drop(ast, mark);
    pass (raw dvc3("impl:", params, ">:"));
};

// Does any variant carry a payload? A payload-less enum keeps the body it
// always had (the tag IS the value), byte for byte.
func:dv_enum_has_payload = bool(Ast->:ast, DeclNode:d) never fails {
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw variant_payload_count(m)) > 0i32) { pass true; }
        }
    }
    pass false;
};

// `dvN_K`: the K-th payload binding of the N-th operand (`self` 0, `other` 1).
func:dv_bind = string(int32:operand, int32:k) never fails {
    pass (raw dvc5("dv", int_to_string(operand => int64), "_", int_to_string(k => int64), ""));
};

// THE EQUALITY OF TWO OPERANDS BY CLASS (D-258): `(a != b).any()` for a
// `simd`, `a != b` for a pointer (address identity), the member's own `eq`
// with its licence for everything else. Emits the statement that passes
// `false` when they differ.
func:dv_eq_stmt = string(int32:cls, string:a, string:b) never fails {
    if (cls == (raw DVC_SIMD())) {
        pass (raw dvc5("if ((", a, " != ", b, ").any()) { pass false; }\n"));
    }
    if (cls == (raw DVC_POINTER())) {
        pass (raw dvc5("if (", a, " != ", b, ") { pass false; }\n"));
    }
    pass (raw dvc5("if (!(", raw dv_lic(cls, false), a, ".eq(",
                   raw dvc3(b, "))) { pass false; }\n", "")));
};

// THE ORDER OF TWO OPERANDS (D-258): the member's own `cmp`/`partial_cmp`
// with its licence, the three-way result passed through when it is not
// `Equal` -- `Ordering?` under `PartialOrd`, where an absent answer is the
// whole answer (`pass NIL`). `slot` names the locals.
func:dv_cmp_stmt = string(int32:cls, string:a, string:b, bool:partial,
                          string:slot) never fails {
    string:lic = raw dv_lic(cls, false);
    if (partial) {
        string:o = string_concat("dvo", slot);
        string:v = string_concat("dvv", slot);
        string:s1 = raw dvc5("Ordering?:", o, " = ", lic, a);
        string:s2 = raw dvc5(".partial_cmp(", b, ");\nif (", o, " == NIL) { pass NIL; }\n");
        string:s3 = raw dvc5("Ordering:", v, " = ", o, " ?? Ordering.Equal;\n");
        string:s4 = raw dvc5("if (", v, " != Ordering.Equal) { pass ", v, "; }\n");
        pass (raw dvc5(s1, s2, s3, s4, ""));
    }
    string:oo = string_concat("dvo", slot);
    string:t1 = raw dvc5("Ordering:", oo, " = ", lic, a);
    string:t2 = raw dvc5(".cmp(", b, ");\nif (", oo, " != Ordering.Equal) { pass ");
    pass (raw dvc3(t1, t2, raw dvc3(oo, "; }\n", "")));
};

// THE CLONE OF ONE MEMBER (D-258): the member's own `clone` with its licence;
// a pointer, a `simd` or an array of scalars is the plain value it is.
func:dv_clone_of = string(int32:cls, string:a) never fails {
    if (cls == (raw DVC_POINTER())) { pass (string_concat(a, "")); }
    if (cls == (raw DVC_SIMD()))    { pass (string_concat(a, "")); }
    if (cls == (raw DVC_ARRAY()))   { pass (string_concat(a, "")); }
    pass (raw dvc3(raw dv_lic(cls, true), a, ".clone()"));
};

// `(Enum.Variant(dv0_0, dv0_1))` -- the arm pattern binding a variant's
// payloads for operand `op`; `(Enum.Variant)` when it carries none. THE BARE
// name (1.3.7's rule for a generic struct literal, applied to a variant): the
// enum's arguments come from the scrutinee, never from the pattern.
func:dv_pattern = string(Ast->:ast, InternTable->:interns, string:bare, DeclNode:m,
                         int32:op) never fails {
    string:s = raw dvc5("(", bare, ".", raw intern_get(interns, raw decl_name(m)), "");
    int32:pc = raw variant_payload_count(m);
    if (pc == 0i32) { pass (string_concat(s, ")")); }
    s = string_concat(s, "(");
    for (int32:k in 0i32...pc) {
        if (k > 0i32) { s = string_concat(s, ", "); }
        s = string_concat(s, raw dv_bind(op, k));
    }
    pass (string_concat(s, "))"));
};

// `impl:Point:Eq = { pub func:eq = bool(Point:self, Point:other) { … }; };`
// FIELD BY FIELD, IN DECLARATION ORDER, each through its class (D-258).
func:gen_eq_struct = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                         string:tn, string:head, DvSink->:out) never fails {
    drop dv_put(out, raw dvc5(head, tn, ":Eq = { pub func:eq = bool(", tn, ":self, "));
    drop dv_put(out, string_concat(tn, ":other) {\n"));
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = raw intern_get(interns, raw decl_name(m));
            drop dv_at_field(out, m);
            drop dv_put(out, raw dv_eq_stmt(raw dv_class(ast, interns, d, raw field_type(m)),
                                     string_concat("self.", f), string_concat("other.", f)));
            drop dv_at_none(out);
        }
    }
    drop dv_put(out, "pass true; }; };\n");
    pass NIL;
};

// LEXICOGRAPHIC, IN DECLARATION ORDER (D-123). The cost is stated rather than
// hidden: reordering a struct's fields becomes a semantic change.
func:gen_cmp_struct = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                          string:tn, bool:partial, string:head, DvSink->:out) never fails {
    string:tr = "Ord";
    string:mn = "cmp";
    string:rt = "Ordering";
    if (partial) { tr = "PartialOrd"; mn = "partial_cmp"; rt = "Ordering?"; }
    drop dv_put(out, raw dvc5(head, tn, ":", tr, " = { pub func:"));
    drop dv_put(out, raw dvc5(mn, " = ", rt, "(", tn));
    drop dv_put(out, raw dvc3(":self, ", tn, ":other) {\n"));
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = raw intern_get(interns, raw decl_name(m));
            drop dv_at_field(out, m);
            drop dv_put(out, raw dv_cmp_stmt(raw dv_class(ast, interns, d, raw field_type(m)),
                                     string_concat("self.", f), string_concat("other.", f),
                                     partial, int_to_string(i => int64)));
            drop dv_at_none(out);
        }
    }
    drop dv_put(out, "pass Ordering.Equal; }; };\n");
    pass NIL;
};

// ORD / PARTIALORD ON AN ENUM ORDER BY TAG FIRST (D-123, 1.0.9d): `enum =>!
// int32` reads a variant's tag (0.8.0), and the tag IS the declaration order —
// so a later variant is greater. THEN, FOR EQUAL TAGS, THE PAYLOAD (D-250,
// 1.5.1b step 3b; D-258's classes): a `pick` over `self` per variant whose
// arm picks `other` for the same variant and compares the bound payloads.
// A payload-less enum keeps the body it always had, byte for byte. The same
// body serves `PartialOrd`: `pass Ordering.Less` wraps into `Ordering?`
// (D-099), so a total order reads as an always-present one.
func:gen_cmp_enum = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                        string:tn, string:bare, bool:partial, string:head,
                        DvSink->:out) never fails {
    string:tr = "Ord";
    string:mn = "cmp";
    string:rt = "Ordering";
    if (partial) { tr = "PartialOrd"; mn = "partial_cmp"; rt = "Ordering?"; }
    drop dv_put(out, raw dvc5(head, tn, ":", tr, " = { pub func:"));
    drop dv_put(out, raw dvc5(mn, " = ", rt, "(", tn));
    drop dv_put(out, raw dvc3(":self, ", tn, ":other) {\n"));
    drop dv_put(out, "int32:a = self =>! int32;\n");
    drop dv_put(out, "int32:b = other =>! int32;\n");
    drop dv_put(out, "if (a < b) { pass Ordering.Less; }\n");
    drop dv_put(out, "if (a > b) { pass Ordering.Greater; }\n");
    if (raw dv_enum_has_payload(ast, d)) {
        drop dv_put(out, "pick (self) {\n");
        int32:n = raw item_member_count(ast, d);
        bool:first = true;
        for (int32:i in 0i32...n) {
            DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
            if (m.kind == DeclKind.DeclEnumVariant) {
                if (!first) { drop dv_put(out, ",\n"); }
                first = false;
                drop dv_at_variant(out, m);
                drop dv_put(out, raw dv_pattern(ast, interns, bare, m, 0i32));
                int32:pc = raw variant_payload_count(m);
                if (pc == 0i32) {
                    drop dv_put(out, " { pass Ordering.Equal; }");
                } else {
                    drop dv_put(out, " { pick (other) {\n");
                    drop dv_put(out, raw dv_pattern(ast, interns, bare, m, 1i32));
                    drop dv_put(out, " {\n");
                    for (int32:k in 0i32...pc) {
                        TypeId:pt = TypeId{ index: raw ast_id_at(ast, raw variant_payload_start(m), k) };
                        drop dv_put(out, raw dv_cmp_stmt(raw dv_class(ast, interns, d, pt),
                                                 raw dv_bind(0i32, k), raw dv_bind(1i32, k), partial,
                                                 raw dvc3(int_to_string(i => int64), "_", int_to_string(k => int64))));
                    }
                    drop dv_put(out, "pass Ordering.Equal; },\n(*) { pass Ordering.Equal; } } }");
                }
                drop dv_at_none(out);
            }
        }
        drop dv_put(out, "\n}\n");
    }
    drop dv_put(out, "pass Ordering.Equal; }; };\n");
    pass NIL;
};

// A DERIVED STRUCT HASH COMBINES ITS FIELDS' HASHES (D-123, FNV-1a): each field
// mixes its own hash into the running one, so the whole is FNV-1a over the
// parts -- each field through its class (D-258): the prelude's rows for a
// scalar or a `string` (`raw`), a nested type's or a parameter's own (`relay`).
func:gen_hash_struct = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                           string:tn, string:head, DvSink->:out) never fails {
    drop dv_put(out, raw dvc5(head, tn, ":Hash = { pub func:hash = uint64(", tn, ":self) {\n"));
    drop dv_put(out, "uint64:h = raw fnv_offset();\n");
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = raw intern_get(interns, raw decl_name(m));
            drop dv_at_field(out, m);
            drop dv_put(out, raw dvc5("h = raw fnv_mix(h, ",
                                      raw dv_lic(raw dv_class(ast, interns, d, raw field_type(m)), false),
                                      "self.", f, ".hash());\n"));
            drop dv_at_none(out);
        }
    }
    drop dv_put(out, "pass h; }; };\n");
    pass NIL;
};

// A DERIVED ENUM HASH HASHES THE TAG (D-123). A payload is not mixed, so two
// values of one variant collide — which a hash is allowed to do (equal implies
// equal hash, not the reverse); the identity a `pick` sees is the tag.
func:gen_hash_enum = NIL(string:tn, string:head, DvSink->:out) never fails {
    drop dv_put(out, raw dvc5(head, tn, ":Hash = { pub func:hash = uint64(", tn, ":self) {\n"));
    drop dv_put(out, "int32:t = self =>! int32;\n");
    drop dv_put(out, "pass (raw fnv_mix(raw fnv_offset(), t =>! uint64)); }; };\n");
    pass NIL;
};

// A DERIVED STRUCT CLONE IS MEMBER-WISE (D-258; closes DEF-17's `Clone` half
// and DEF-18): `pass Subject{ f: <clone of f>, … }` -- every field listed, one
// per line so a refusal names it, the BARE literal for a generic subject
// (1.3.7: `Subject<T>{ … }` does not parse), each member through its class.
// `pass self` was the body since 0.6.5, and `pass self` of a lent owner is
// TYPE-047 for a struct with a `string` field, and for `Box<string>` -- checked
// with `T` opaque -- an ALIAS: two headers over one body, freed twice. A
// struct with no fields keeps `pass self`: there is nothing to copy.
func:gen_clone_struct = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                            string:tn, string:bare, string:head, DvSink->:out) never fails {
    drop dv_put(out, raw dvc5(head, tn, ":Clone = { pub func:clone = ", tn, "("));
    drop dv_put(out, string_concat(tn, ":self) {\n"));
    int32:n = raw item_member_count(ast, d);
    bool:has_field = false;
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) { has_field = true; }
    }
    if (!has_field) {
        drop dv_put(out, "pass self; }; };\n");
        pass NIL;
    }
    drop dv_put(out, raw dvc3("pass ", bare, "{\n"));
    bool:first = true;
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            if (!first) { drop dv_put(out, ",\n"); }
            first = false;
            string:f = raw intern_get(interns, raw decl_name(m));
            drop dv_at_field(out, m);
            drop dv_put(out, raw dvc3(f, ": ",
                      raw dv_clone_of(raw dv_class(ast, interns, d, raw field_type(m)),
                                      string_concat("self.", f))));
        }
    }
    drop dv_put(out, "\n");
    drop dv_at_none(out);
    drop dv_put(out, "}; }; };\n");
    pass NIL;
};

// A DERIVED ENUM CLONE REBUILDS THE VARIANT (D-258): a `pick` per variant,
// each payload through its class; a payload-less enum keeps `pass self`,
// byte for byte (the tag is the value). The `pick` LENDS `self` (D-266,
// 1.5.2h), so an owning payload is read in place and `.clone()`d by value;
// a payload no derived body can rebuild is refused before this is written.
func:gen_clone_enum = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                          string:tn, string:bare, string:head, DvSink->:out) never fails {
    drop dv_put(out, raw dvc5(head, tn, ":Clone = { pub func:clone = ", tn, "("));
    if (!(raw dv_enum_has_payload(ast, d))) {
        drop dv_put(out, string_concat(tn, ":self) { pass self; }; };\n"));
        pass NIL;
    }
    drop dv_put(out, string_concat(tn, ":self) {\npick (self) {\n"));
    int32:n = raw item_member_count(ast, d);
    bool:first = true;
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if (!first) { drop dv_put(out, ",\n"); }
            first = false;
            drop dv_at_variant(out, m);
            drop dv_put(out, raw dv_pattern(ast, interns, bare, m, 0i32));
            string:v = raw intern_get(interns, raw decl_name(m));
            int32:pc = raw variant_payload_count(m);
            if (pc == 0i32) {
                drop dv_put(out, raw dvc5(" { pass ", bare, ".", v, "; }"));
            } else {
                drop dv_put(out, raw dvc5(" { pass ", bare, ".", v, "("));
                for (int32:k in 0i32...pc) {
                    if (k > 0i32) { drop dv_put(out, ", "); }
                    TypeId:pt = TypeId{ index: raw ast_id_at(ast, raw variant_payload_start(m), k) };
                    drop dv_put(out, raw dv_clone_of(raw dv_class(ast, interns, d, pt),
                                                     raw dv_bind(0i32, k)));
                }
                drop dv_put(out, "); }");
            }
            drop dv_at_none(out);
        }
    }
    drop dv_put(out, "\n}\n}; };\n");
    pass NIL;
};

// `Point { x: &{self.x}, y: &{self.y} }`, built with interpolation (D-053) because
// that is the only formatting mechanism the language has. `ToString` renders
// every member by `&{ }`, which IS the member's `to_string` (a parameter's
// through the `T: ToString` bound the head carries, a `string`'s as itself).
// `Debug` renders a scalar, a named type or a parameter through its own
// `debug` (D-258 -- the trait derived is the trait reached; until this step a
// nested field rendered through its `ToString`), hoisted into locals so the
// licence word sits outside the template; a `string` field renders as itself.
func:gen_to_string_struct = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                                string:tn, bool:dbg, string:head, DvSink->:out) never fails {
    string:tr = "ToString";
    string:mn = "to_string";
    if (dbg) { tr = "Debug"; mn = "debug"; }
    drop dv_put(out, raw dvc5(head, tn, ":", tr, " = { pub func:"));
    drop dv_put(out, raw dvc5(mn, " = string(", tn, ":self) {\n", ""));

    string:body = raw dvc3("pass `", tn, " { ");
    int32:n = raw item_member_count(ast, d);
    bool:first = true;
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = raw intern_get(interns, raw decl_name(m));
            if (!first) { body = string_concat(body, ", "); }
            first = false;
            body = string_concat(body, f);
            int32:cls = raw dv_class(ast, interns, d, raw field_type(m));
            bool:own_debug = dbg;
            if (cls == (raw DVC_STRING())) { own_debug = false; }
            if (own_debug) {
                string:loc = string_concat("dvs", int_to_string(i => int64));
                drop dv_at_field(out, m);
                drop dv_put(out, raw dvc5("string:", loc, " = ", raw dv_lic(cls, false),
                                          raw dvc3("self.", f, ".debug();\n")));
                drop dv_at_none(out);
                body = string_concat(body, raw dvc3(": &{", loc, "}"));
            } else {
                body = string_concat(body, raw dvc3(": &{self.", f, "}"));
            }
        }
    }
    drop dv_put(out, body);
    drop dv_put(out, " }`; }; };\n");
    pass NIL;
};

// EQ ON AN ENUM: the tag first, then the payloads of equal tags (D-250,
// 1.5.1b step 3b; D-258's classes) -- `self == other` alone is what a
// payload-less enum has always compiled to and keeps, byte for byte; an enum
// with a payload has no built-in `==`, so the body is a `pick` per variant
// comparing the bound payloads.
func:gen_eq_enum = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                       string:tn, string:bare, string:head, DvSink->:out) never fails {
    drop dv_put(out, raw dvc5(head, tn, ":Eq = { pub func:eq = bool(", tn, ":self, "));
    if (!(raw dv_enum_has_payload(ast, d))) {
        drop dv_put(out, string_concat(tn, ":other) { pass (self == other); }; };\n"));
        pass NIL;
    }
    drop dv_put(out, string_concat(tn, ":other) {\n"));
    drop dv_put(out, "if ((self =>! int32) != (other =>! int32)) { pass false; }\n");
    drop dv_put(out, "pick (self) {\n");
    int32:n = raw item_member_count(ast, d);
    bool:first = true;
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if (!first) { drop dv_put(out, ",\n"); }
            first = false;
            drop dv_at_variant(out, m);
            drop dv_put(out, raw dv_pattern(ast, interns, bare, m, 0i32));
            int32:pc = raw variant_payload_count(m);
            if (pc == 0i32) {
                drop dv_put(out, " { pass true; }");
            } else {
                drop dv_put(out, " { pick (other) {\n");
                drop dv_put(out, raw dv_pattern(ast, interns, bare, m, 1i32));
                drop dv_put(out, " {\n");
                for (int32:k in 0i32...pc) {
                    TypeId:pt = TypeId{ index: raw ast_id_at(ast, raw variant_payload_start(m), k) };
                    drop dv_put(out, raw dv_eq_stmt(raw dv_class(ast, interns, d, pt),
                                             raw dv_bind(0i32, k), raw dv_bind(1i32, k)));
                }
                drop dv_put(out, "pass true; },\n(*) { pass false; } } }");
            }
            drop dv_at_none(out);
        }
    }
    drop dv_put(out, "\n}\n");
    drop dv_put(out, "pass true; }; };\n");
    pass NIL;
};

// THE VARIANT'S NAME, through a `pick` — which is expressible, exhaustive by
// construction, and checked as such by 0.5.4.
//
// NOT `&{self}`: interpolation is what CALLS `to_string`, so a body built out of it
// would call itself.
func:gen_to_string_enum = NIL(Ast->:ast, InternTable->:interns, DeclNode:d,
                              string:tn, string:bare, bool:dbg, string:head,
                              DvSink->:out) never fails {
    string:tr = "ToString";
    string:mn = "to_string";
    if (dbg) { tr = "Debug"; mn = "debug"; }
    drop dv_put(out, raw dvc5(head, tn, ":", tr, " = { pub func:"));
    // `pick (selector) { (pattern) { … }, … }` — THE SELECTOR IS PARENTHESISED and
    // THE ARMS ARE COMMA-SEPARATED. Written from memory the first time and neither
    // was right, which is what the generated source being real source catches: it
    // failed to parse, loudly, instead of building a tree nobody could have read.
    drop dv_put(out, raw dvc5(mn, " = string(", tn, ":self) {\npick (self) {\n", ""));
    int32:n = raw item_member_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            string:v = raw intern_get(interns, raw decl_name(m));
            drop dv_at_variant(out, m);
            drop dv_put(out, raw dvc5("(", bare, ".", v, ") { pass \""));
            if (dbg) { drop dv_put(out, raw dvc3(bare, ".", "")); }
            drop dv_put(out, raw dvc3(v, "\"; }", ""));
            if (i < (n - 1i32)) { drop dv_put(out, ","); }
            drop dv_put(out, "\n");
            drop dv_at_none(out);
        }
    }
    drop dv_put(out, "}\n}; };\n");
    pass NIL;
};

// --- the walk -------------------------------------------------------------------
//
// Over declarations rather than over the attribute array, because an attribute's
// meaning depends entirely on what it is attached to and the array does not say.

// EVERY MODULE, READ AND THEN REWRITTEN. Reading reports; rewriting appends the
// generated implementations to the module's member list, so that everything
// downstream — collection, coherence, completeness — sees them as members like any
// other. That is what makes a derived impl beside a hand-written one a coherence
// violation rather than a special case.
pub func:derive_apply = NIL(ModuleGraph->:g) never fails {
    int32:i = 0i32;
    while (i < (raw graph_count(g))) {
        ModuleEntry:e = raw graph_at(g, i);
        if (i != g.prelude) {
            drop derive_in_module(g, DeclId{ index: e.root }, i);
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:derive_in_module = NIL(ModuleGraph->:g, DeclId:mod_id, int32:index) never fails {
    drop derive_module(@g.ast, g.interns, g.diags, mod_id);

    DvSink:out = raw derive_text(@g.ast, g.interns, g.diags, mod_id);
    if (out.text.len == 0i64) { pass NIL; }

    // THE GENERATED TEXT IS A MODULE, PARSED LIKE ANY OTHER. Its own name is
    // irrelevant — only its members are taken — but it needs one, because a source
    // file without a `mod:` line is not a source file.
    string:path = string_concat("<derived-",
                      string_concat(int_to_string(index => int64), ">"));
    string:full = string_concat("mod:derived;\n", out.text);
    // The manager OWNS the derived source (D-183); the lexer takes the
    // manager's cap-0 view, like every real file.
    int32:file = raw srcmgr_add_synthetic(@g.sm, move(path), move(full));
    // THE ORIGINS LEARN THEIR FILE (D-259): the sink counted lines before the
    // manager issued the id, so every row of this module's derived text is
    // stamped with it here and appended to the graph's registry.
    for (int64:oi in 0i64...out.origins.count) {
        DerivedOrigin:o = out.origins.items[oi];
        o.file = file;
        drop list_push(@g.origins, o);
    }
    string:dtext = raw srcmgr_text_proven(@g.sm, file);
    TokenList:toks = raw lex_all(file, dtext, g.interns, g.diags);
    Parser:p = raw parser_init(@toks, @g.ast, g.diags, g.interns);
    DeclId:groot = raw p_parse_module(@p);

    DeclNode:gm = raw ast_decl(@g.ast, groot);
    DeclNode:m = raw ast_decl(@g.ast, mod_id);
    int32:gc = raw item_generic_count(@g.ast, m);
    int32:mc = raw item_member_count(@g.ast, m);
    int32:ac = raw item_attr_count(@g.ast, m);
    int32:ec = raw item_extra_count(@g.ast, m);
    int32:added = raw item_member_count(@g.ast, gm);

    int32:mark = raw ast_scratch_mark(@g.ast);
    drop ast_scratch_push(@g.ast, gc);
    drop ast_scratch_push(@g.ast, mc + added);
    drop ast_scratch_push(@g.ast, ac);
    drop ast_scratch_push(@g.ast, ec);

    for (int32:q in 0i32...gc) {
        drop ast_scratch_push(@g.ast, (raw item_generic(@g.ast, m, q)).index);
    }
    for (int32:j in 0i32...mc) {
        drop ast_scratch_push(@g.ast, (raw item_member(@g.ast, m, j)).index);
    }
    // THE GENERATED IMPLS GO LAST. Order among members does not decide anything —
    // collection is two-phase (D-086) — and appending keeps every index the user's
    // own declarations already had.
    for (int32:k in 0i32...added) {
        DeclId:genid = raw item_member(@g.ast, gm, k);
        // MARKED AS DERIVED, so a diagnostic about it can say so rather than
        // sending the reader to look for an `impl` they never wrote.
        drop ast_or_decl_flags(@g.ast, genid, raw DECL_DERIVED());
        drop ast_scratch_push(@g.ast, genid.index);
    }
    for (int32:a2 in 0i32...ac) {
        drop ast_scratch_push(@g.ast, (raw item_attr(@g.ast, m, a2)).index);
    }
    for (int32:e2 in 0i32...ec) {
        drop ast_scratch_push(@g.ast, (raw item_extra(@g.ast, m, e2)).index);
    }
    IdSpan:w = raw ast_scratch_commit(@g.ast, mark);
    drop ast_set_decl_window(@g.ast, mod_id, w.start, w.count);
    pass NIL;
};

// EVERY DERIVE IN ONE MODULE, AS ONE SOURCE. One parse rather than one per type,
// because a parse is a lexer, a token list and a parser, and the number of them is
// not something the number of `#[derive]`s in a file should decide.
func:derive_text = DvSink(Ast->:ast, InternTable->:interns, DiagList->:diags,
                          DeclId:mod_id) never fails {
    DeclNode:m = raw ast_decl(ast, mod_id);
    DvSink:out = raw dv_sink_init();
    int32:n = raw item_member_count(ast, m);
    for (int32:i in 0i32...n) {
        DeclId:id = raw item_member(ast, m, i);
        DeclNode:d = raw ast_decl(ast, id);
        bool:is_struct = (d.kind == DeclKind.DeclStructDecl);
        bool:is_enum = (d.kind == DeclKind.DeclEnumDecl);
        if (is_struct || is_enum) {
            DeriveSet:want = raw read_derives(ast, interns, diags, d,
                                              raw item_attr_count(ast, d), true);
            if (want.count > 0i32) {
                out.subject = id.index;
                drop derive_one(ast, interns, diags, d, want, is_enum, @out);
                out.subject = 0i32;
            }
        }
    }
    pass (move(out));
};

func:derive_one = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                      DeclNode:d, DeriveSet:want, bool:is_enum, DvSink->:out) never fails {
    string:bare = raw intern_get(interns, raw decl_name(d));

    // A GENERIC SUBJECT DERIVES THE FAMILY FORM (D-161, 1.0.4c): `impl:<T>:Box<T>:Eq`,
    // which is what a person would write. THE BOUND IS SYNTHESIZED (D-258,
    // 1.5.2b step 3, ending D-161's no-bound story): `dv_head` writes `: X`
    // on exactly the parameters a member the body reaches through X mentions,
    // per derive -- `impl:<A: Eq, B: Eq>:Pair<A, B>:Eq` -- so `Box<Point>`
    // needs `Point: Eq` at the FRONTEND (D-256 asks it where the impl is
    // used) instead of an `!=` on an opaque `T` that the emitter met at
    // `Box<Point>` and could not lower (DEF-16). `tn` is the type as the
    // signatures spell it (`Box<T>`); `bare` is the name a literal, a pattern
    // or a constructor uses (1.3.7).
    string:tn = string_concat(bare, "");
    IdSpan:gw = raw decl_generic_window(ast, d);
    if (gw.count > 0i32) {
        string:params = "<";
        int32:gi = 0i32;
        while (gi < gw.count) {
            if (gi > 0i32) { params = string_concat(params, ", "); }
            DeclNode:gp = raw ast_decl(ast,
                              DeclId{ index: raw ast_id_at(ast, gw.start, gi) });
            params = string_concat(params,
                         raw intern_get(interns, raw decl_name(gp)));
            gi = gi + 1i32;
        }
        params = string_concat(params, ">");
        tn = string_concat(bare, params);
    }

    if (raw derive_wants(want, raw DERIVE_CLONE())) {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_CLONE(), "Clone")) {
            out.trait_name = raw intern_add(interns, "Clone");
            string:hc = raw dv_head(ast, interns, d, is_enum, raw DERIVE_CLONE(), "Clone");
            if (is_enum) { drop gen_clone_enum(ast, interns, d, tn, bare, hc, out); }
            else { drop gen_clone_struct(ast, interns, d, tn, bare, hc, out); }
        }
    }
    if (raw derive_wants(want, raw DERIVE_EQ())) {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_EQ(), "Eq")) {
            out.trait_name = raw intern_add(interns, "Eq");
            string:he = raw dv_head(ast, interns, d, is_enum, raw DERIVE_EQ(), "Eq");
            if (is_enum) { drop gen_eq_enum(ast, interns, d, tn, bare, he, out); }
            else { drop gen_eq_struct(ast, interns, d, tn, he, out); }
        }
    }
    // THE FIVE DERIVES A `simd` FIELD REFUSES (D-194): an order over a
    // vector has no scalar verdict, a hash and a rendering have no impls to
    // call — and generating them would point diagnostics at source nobody
    // wrote (the enum-ordering rule, applied again).
    bool:has_simd = false;
    if (!is_enum) { has_simd = raw dv_has_simd_field(ast, d); }
    if (raw derive_wants(want, raw DERIVE_TO_STRING())) {
        if (has_simd) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_SIMD_FIELD(),
                "`ToString` cannot be derived over a `simd` field (D-194): a vector has no built-in rendering — write the impl and say what the lanes mean",
                d.span));
        } else {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_TO_STRING(), "ToString")) {
            out.trait_name = raw intern_add(interns, "ToString");
            string:ht = raw dv_head(ast, interns, d, is_enum, raw DERIVE_TO_STRING(), "ToString");
            if (is_enum) { drop gen_to_string_enum(ast, interns, d, tn, bare, false, ht, out); }
            else { drop gen_to_string_struct(ast, interns, d, tn, false, ht, out); }
        }
        }
    }
    if (raw derive_wants(want, raw DERIVE_DEBUG())) {
        if (has_simd) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_SIMD_FIELD(),
                "`Debug` cannot be derived over a `simd` field (D-194): a vector has no built-in rendering — write the impl and say what the lanes mean",
                d.span));
        } else {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_DEBUG(), "Debug")) {
            out.trait_name = raw intern_add(interns, "Debug");
            string:hd = raw dv_head(ast, interns, d, is_enum, raw DERIVE_DEBUG(), "Debug");
            if (is_enum) { drop gen_to_string_enum(ast, interns, d, tn, bare, true, hd, out); }
            else { drop gen_to_string_struct(ast, interns, d, tn, true, hd, out); }
        }
        }
    }

    // AN ORDER OVER AN ENUM IS THE TAG'S, THEN THE PAYLOAD'S (D-123, D-250):
    // `enum =>! int32` yields the tag the operator cannot, and the payloads of
    // equal tags compare through a `pick` per variant (1.5.1b step 3b). A
    // member no comparison can be written for refuses here, by name, at the
    // user's declaration -- never a type error at a line nobody wrote.
    if (raw derive_wants(want, raw DERIVE_ORD())) {
        if (has_simd) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_SIMD_FIELD(),
                "`Ord` cannot be derived over a `simd` field (D-194): an order over a vector has no scalar verdict — write the impl and say which order you mean",
                d.span));
        } else {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_ORD(), "Ord")) {
            out.trait_name = raw intern_add(interns, "Ord");
            string:ho = raw dv_head(ast, interns, d, is_enum, raw DERIVE_ORD(), "Ord");
            if (is_enum) { drop gen_cmp_enum(ast, interns, d, tn, bare, false, ho, out); }
            else { drop gen_cmp_struct(ast, interns, d, tn, false, ho, out); }
        }
        }
    }
    if (raw derive_wants(want, raw DERIVE_PARTIAL_ORD())) {
        if (has_simd) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_SIMD_FIELD(),
                "`PartialOrd` cannot be derived over a `simd` field (D-194): an order over a vector has no scalar verdict — write the impl and say which order you mean",
                d.span));
        } else {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_PARTIAL_ORD(), "PartialOrd")) {
            out.trait_name = raw intern_add(interns, "PartialOrd");
            string:hp = raw dv_head(ast, interns, d, is_enum, raw DERIVE_PARTIAL_ORD(), "PartialOrd");
            if (is_enum) { drop gen_cmp_enum(ast, interns, d, tn, bare, true, hp, out); }
            else { drop gen_cmp_struct(ast, interns, d, tn, true, hp, out); }
        }
        }
    }

    if (raw derive_wants(want, raw DERIVE_HASH())) {
        if (has_simd) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_SIMD_FIELD(),
                "`Hash` cannot be derived over a `simd` field (D-194): the lanes have no built-in hash — write the impl and fold them deliberately",
                d.span));
        } else {
        if (raw dv_admissible(ast, interns, diags, d, is_enum, raw DERIVE_HASH(), "Hash")) {
            out.trait_name = raw intern_add(interns, "Hash");
            string:hh = raw dv_head(ast, interns, d, is_enum, raw DERIVE_HASH(), "Hash");
            if (is_enum) { drop gen_hash_enum(tn, hh, out); }
            else { drop gen_hash_struct(ast, interns, d, tn, hh, out); }
        }
        }
    }
    out.trait_name = 0i32;
    pass NIL;
};

// A DERIVED DIAGNOSTIC IS REPORTED AT THE DERIVE (D-259, 1.5.2b step 4). After
// the front half has run, every diagnostic whose span lies in a `<derived-N>`
// synthetic file -- the registry says which files those are -- is rewritten in
// place: its span becomes the subject declaration's (the span DERIVE-006
// already uses), its message is prefixed "in the `Ord` that `#[derive(Ord)]`
// generates for `Box` (at the field `v`): ", its code and severity stay, so
// D-237's set equality reads the same finding. The residue D-258 leaves --
// a named user type without the trait or owning, a builtin the prelude has no
// impl for under this trait -- is exactly a checker verdict with a good
// message that needed the right span. A line no row covers (the header, or a
// parse error in generated text -- a generator defect) is left where it is,
// and both runners refuse a `<derived-` path by name, so it fails loudly.
pub func:rehome_derived = NIL(ModuleGraph->:g) never fails {
    int64:n = raw diaglist_count(g.diags);
    for (int64:i in 0i64...n) {
        Diagnostic:d = raw diaglist_at(g.diags, i);
        int64:best = 0i64 - 1i64;
        int32:best_line = 0i32;
        for (int64:k in 0i64...g.origins.count) {
            DerivedOrigin:o = g.origins.items[k];
            if (o.file == d.span.file) {
                if (o.line <= d.span.line) {
                    if ((best < 0i64) || (o.line >= best_line)) {
                        best = k;
                        best_line = o.line;
                    }
                }
            }
        }
        if (best < 0i64) { continue; }
        DerivedOrigin:src = g.origins.items[best];
        DeclNode:sd = raw ast_decl(@g.ast, DeclId{ index: src.subject });
        string:p1 = string_concat("in the `", raw intern_get(g.interns, src.trait_name));
        string:p2 = string_concat(p1, "` that `#[derive(");
        string:p3 = string_concat(p2, raw intern_get(g.interns, src.trait_name));
        string:p4 = string_concat(p3, ")]` generates for `");
        string:p5 = string_concat(p4, raw intern_get(g.interns, raw decl_name(sd)));
        string:p6 = string_concat(p5, "`");
        if (src.member != 0i32) {
            string:kind = " (at the field `";
            if (src.is_variant) { kind = " (at the variant `"; }
            string:m1 = string_concat(p6, kind);
            string:m2 = string_concat(m1, raw intern_get(g.interns, src.member));
            p6 = string_concat(m2, "`)");
        }
        drop diaglist_rehome(g.diags, i, sd.span, string_concat(p6, ": "));
    }
    pass NIL;
};

pub func:derive_module = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                             DeclId:mod_id) never fails {
    DeclNode:m = raw ast_decl(ast, mod_id);
    int32:n = raw item_member_count(ast, m);
    for (int32:i in 0i32...n) {
        DeclId:id = raw item_member(ast, m, i);
        DeclNode:d = raw ast_decl(ast, id);

        bool:is_type = (d.kind == DeclKind.DeclStructDecl);
        if (d.kind == DeclKind.DeclEnumDecl) { is_type = true; }

        if (d.kind == DeclKind.DeclModuleDecl) {
            drop derive_module(ast, interns, diags, id);
        } else {
            // ONLY THE ITEM KINDS CARRY AN ATTRIBUTE WINDOW IN THIS SHAPE. A
            // function's attributes are in its own layout and an `impl`'s in a
            // third; reading `item_attr_count` on either would read a slot that
            // means something else, which is the defect this compiler has paid for
            // seven times.
            if (d.kind == DeclKind.DeclStructDecl) {
                drop discard_set(raw read_derives(ast, interns, diags, d,
                                                  raw item_attr_count(ast, d), is_type));
            }
            if (d.kind == DeclKind.DeclEnumDecl) {
                drop discard_set(raw read_derives(ast, interns, diags, d,
                                                  raw item_attr_count(ast, d), is_type));
            }
            if (d.kind == DeclKind.DeclTraitDecl) {
                drop discard_set(raw read_derives(ast, interns, diags, d,
                                                  raw item_attr_count(ast, d), false));
            }
            if (d.kind == DeclKind.DeclFunctionDecl) {
                drop derive_on_function(ast, interns, diags, d);
            }
        }
    }
    pass NIL;
};

// The set is read for its diagnostics here; generation is what will consume it.
func:discard_set = NIL(DeriveSet:_~s) never fails { pass NIL; };

func:derive_on_function = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                              DeclNode:d) never fails {
    int32:n = raw fn_attr_count(ast, d);
    for (int32:i in 0i32...n) {
        DeclNode:at = raw ast_decl(ast, raw fn_attr(ast, d, i));
        string:aname = raw intern_get(interns, raw attr_name(at));
        if (raw string_eq(aname, "derive")) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_TARGET(),
                "`#[derive]` generates an implementation from a type's shape — its fields, or its variants — so it belongs on a `struct` or an `enum` and there is nothing here to generate from",
                at.span));
        }
    }
    pass NIL;
};
