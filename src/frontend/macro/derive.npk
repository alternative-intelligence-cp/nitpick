// `#[derive(…)]` — reading the attribute, and refusing what cannot be generated.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.6.5.
//
// `#[derive(Copy, Clone)]` PARSED AND MEANT NOTHING until this existed — an
// ordinary `DeclAttribute` named `derive` with its arguments in a window, read by
// no one. That is the same "parses and means nothing" shape cycle 0.5 spent eight
// subcycles clearing out, and it was the last one in the frontend.
//
// SEVEN, NOT NINE (D-123). `TRAITS_REFERENCE.md` §2.5 listed `Default` and
// `Display` too, and both left the list for reasons a reader who writes one needs
// to be told — they are not typos, and a message that treats them as unknown names
// sends someone to check their spelling.
//
// DERIVE IS A MACRO THAT DOES NOT LOOK LIKE ONE. It emits declarations, so it runs
// in the expansion phase and inherits the constraint that its output is complete
// before resolution begins.

use "../source_location.npk".*;
use "../ast_kind.npk".*;
use "../ast.npk".*;
use "../intern.npk".*;
use "../diagnostics.npk".*;
use "../parse_expr.npk".*;
use "../parse_decl.npk".*;
use "../parse_decorate.npk".*;
use "../token.npk".*;
use "../lexer.npk".*;
use "../parser.npk".*;
use "../source.npk".*;
use "../module_graph.npk".*;
use "./derive_codes.npk".*;

// --- the seven ------------------------------------------------------------------
//
// Named by index rather than by string at every call site, for the reason the token
// table is generated rather than hand-listed: a name compared in two places is a
// name that can be spelled differently in one of them.
pub func:DERIVE_NONE = int32()       { pass 0i32; };
pub func:DERIVE_EQ = int32()         { pass 1i32; };
pub func:DERIVE_ORD = int32()        { pass 2i32; };
pub func:DERIVE_PARTIAL_ORD = int32(){ pass 3i32; };
pub func:DERIVE_CLONE = int32()      { pass 4i32; };
pub func:DERIVE_HASH = int32()       { pass 5i32; };
pub func:DERIVE_TO_STRING = int32()  { pass 6i32; };
pub func:DERIVE_DEBUG = int32()      { pass 7i32; };
pub func:DERIVE_MAX = int32()        { pass 7i32; };

pub func:derive_of_name = int32(string:n) {
    if (raw string_eq(n, "Eq"))         { pass (raw DERIVE_EQ()); }
    if (raw string_eq(n, "Ord"))        { pass (raw DERIVE_ORD()); }
    if (raw string_eq(n, "PartialOrd")) { pass (raw DERIVE_PARTIAL_ORD()); }
    if (raw string_eq(n, "Clone"))      { pass (raw DERIVE_CLONE()); }
    if (raw string_eq(n, "Hash"))       { pass (raw DERIVE_HASH()); }
    if (raw string_eq(n, "ToString"))   { pass (raw DERIVE_TO_STRING()); }
    if (raw string_eq(n, "Debug"))      { pass (raw DERIVE_DEBUG()); }
    pass (raw DERIVE_NONE());
};

// WHY A REMOVED ONE IS NOT DERIVABLE, in the message rather than in a document the
// reader has to go and find. Both sentences are D-123's, compressed.
func:removed_reason = string(string:n) {
    if (raw string_eq(n, "Default")) {
        pass "`Default` is not derivable: deriving it means the compiler choosing values that carry meaning, and several obvious choices are false here — `fd` zero is stdin, `tbb32` zero claims `no error`, a pointer zero is NULL. If a type wants a default, write one, and then the reason it is that value is somewhere a reviewer can read";
    }
    pass "`Display` is not derivable: it was a second name for `ToString`'s job, and both would generate a function returning `string` since formatting is `&{ }` interpolation. Derive `ToString`";
};

func:is_removed = bool(string:n) {
    if (raw string_eq(n, "Default")) { pass true; }
    pass (raw string_eq(n, "Display"));
};

// --- reading one attribute ------------------------------------------------------

pub struct:DeriveSet = {
    // ONE FLAG PER DERIVE, indexed by the constants above. A count would answer
    // "how many" and this has to answer "which", and a duplicate is a question
    // about one of them rather than about the total.
    bool[8]:wanted;
    int32:count;
};

pub func:deriveset_none = DeriveSet() {
    // EIGHT `false`S, WRITTEN OUT. The fill loop this replaces was refused by
    // definite assignment (a loop that happens to cover every index is coverage
    // the analysis cannot see), and `[]` — D-139's zero array — is not usable
    // HERE yet: this module is seed-compiled until 1.2, and the seed lowers an
    // empty literal for a sized array wrongly. The explicit literal means the
    // same thing under both compilers.
    DeriveSet:s = DeriveSet{ wanted: [false, false, false, false,
                                      false, false, false, false],
                             count: 0i32 };
    pass s;
};

pub func:derive_wants = bool(DeriveSet:s, int32:which) {
    if (which < 0i32) { pass false; }
    if (which > (raw DERIVE_MAX())) { pass false; }
    pass (s.wanted[which => int64]);
};

// EVERY `#[derive]` ON ONE DECLARATION, READ TOGETHER. Two attributes are one list
// as far as the type is concerned — `#[derive(Eq)] #[derive(Eq)]` is the same
// duplicate `#[derive(Eq, Eq)]` is, and finding one and not the other would make
// the rule depend on how the author happened to lay it out.
pub func:read_derives = DeriveSet(Ast->:ast, InternTable->:interns,
                                  DiagList->:diags, DeclNode:d, int32:attr_count,
                                  bool:is_type) {
    DeriveSet:want = raw deriveset_none();
    int32:a = 0i32;
    while (a < attr_count) {
        DeclNode:at = relay ast_decl(ast, raw item_attr(ast, d, a));
        string:aname = relay intern_get(interns, raw attr_name(at));
        if (raw string_eq(aname, "derive")) {
            drop read_one_derive(ast, interns, diags, at, @want, is_type);
        }
        a = a + 1i32;
    }
    pass want;
};

func:read_one_derive = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                           DeclNode:at, DeriveSet->:want, bool:is_type) {
    // THE TARGET IS CHECKED ONCE, AT THE ATTRIBUTE, and before the names are. Every
    // one of the seven is generated FROM a type's shape, so on a function there is
    // nothing to generate from and the names do not matter yet.
    if (!is_type) {
        drop diaglist_push(diags, raw diag_error(raw DERIVE_TARGET(),
            "`#[derive]` generates an implementation from a type's shape — its fields, or its variants — so it belongs on a `struct` or an `enum` and there is nothing here to generate from",
            at.span));
        pass NIL;
    }

    int32:n = raw attr_arg_count(at);
    int32:i = 0i32;
    while (i < n) {
        ExprId:arg = ExprId{ index: raw ast_id_at(ast, raw attr_arg_start(at), i) };
        ExprNode:ae = relay ast_expr(ast, arg);

        // A DERIVE ARGUMENT IS A BARE NAME. Anything else is a program that means
        // something the attribute cannot express, and reading only the ones that
        // happen to be identifiers would silently ignore the rest.
        if (ae.kind != ExprKind.ExprIdentifierExpr) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_UNKNOWN(),
                "`#[derive]` takes the names of traits to generate, and this argument is not a name",
                ae.span));
            i = i + 1i32;
            continue;
        }

        string:tname = relay intern_get(interns, (raw expr_name(ae)) =>! int32);
        if (raw is_removed(tname)) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_REMOVED(),
                raw removed_reason(tname), ae.span));
            i = i + 1i32;
            continue;
        }

        int32:which = raw derive_of_name(tname);
        if (which == (raw DERIVE_NONE())) {
            string:m1 = relay string_concat("`", tname);
            string:m2 = relay string_concat(m1,
                "` is not one of the seven traits `#[derive]` can generate: Eq, Ord, PartialOrd, Clone, Hash, ToString, Debug. A trait the program declares is implemented by writing an `impl`, because the compiler has no way to know what its methods should do");
            drop diaglist_push(diags, raw diag_error(raw DERIVE_UNKNOWN(), m2, ae.span));
            i = i + 1i32;
            continue;
        }

        if (want.wanted[which => int64]) {
            string:d1 = relay string_concat("`", tname);
            string:d2 = relay string_concat(d1,
                "` is derived twice for this type, which would generate two implementations of one trait — the thing coherence refuses when they are written by hand");
            drop diaglist_push(diags, raw diag_error(raw DERIVE_DUPLICATE(), d2, ae.span));
            i = i + 1i32;
            continue;
        }

        want.wanted[which => int64] = true;
        want.count = want.count + 1i32;
        i = i + 1i32;
    }
    pass NIL;
};

// --- generating the implementations ---------------------------------------------
//
// AS SOURCE, PARSED. Building `DeclImplDecl` and `DeclFunctionDecl` nodes by hand
// would be several hundred lines of slot-filling for seven derives, and every one
// of those slots is a chance to write a member count into the field a trait id
// lives in — which is the defect this compiler has paid for seven times. Generated
// TEXT goes through the same parser as everything else, so it cannot produce a
// malformed tree; the worst it can do is fail to parse, loudly.
//
// It is also readable. `--emit-derived` is a thing a driver can offer later, and
// what it would print is exactly what is built here.

func:PRIME_TEXT = string() { pass "100000001B3hexu64"; };
// The FNV-1a 64 offset basis is 0xCBF29CE484222325 = 14695981039346656037,
// which is ABOVE the 64-bit literal envelope (D-148): values past 2^63-1 are
// constructed, not spelled. 2^64 - 14695981039346656037 = 3750763034362895579,
// and unsigned subtraction wraps by definition (D-037), so this difference IS
// the basis, bit for bit.
func:BASIS_TEXT = string() { pass "(0u64 - 3750763034362895579u64)"; };

// `impl:Point:Eq = { pub func:eq = bool(Point:self, Point:other) { … }; };`
//
// FIELD BY FIELD, IN DECLARATION ORDER, and by `!=` rather than by calling the
// field's own `eq` — the language has the operator, and a derived implementation
// that went through a trait would need `int32` to implement one.
func:gen_eq_struct = string(Ast->:ast, InternTable->:interns, DeclNode:d,
                            string:tn, string:head) {
    string:s = relay string_concat(head, tn);
    s = relay string_concat(s, ":Eq = { pub func:eq = bool(");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, ":self, ");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, ":other) {\n");

    int32:n = raw item_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclNode:m = relay ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = relay intern_get(interns, raw decl_name(m));
            s = relay string_concat(s, "if (self.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, " != other.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, ") { pass false; }\n");
        }
        i = i + 1i32;
    }
    pass (relay string_concat(s, "pass true; }; };\n"));
};

// LEXICOGRAPHIC, IN DECLARATION ORDER (D-123). The cost is stated rather than
// hidden: reordering a struct's fields becomes a semantic change.
func:gen_cmp_struct = string(Ast->:ast, InternTable->:interns, DeclNode:d,
                             string:tn, bool:partial, string:head) {
    string:tr = "Ord";
    string:mn = "cmp";
    string:rt = "Ordering";
    if (partial) { tr = "PartialOrd"; mn = "partial_cmp"; rt = "Ordering?"; }

    string:s = relay string_concat(head, tn);
    s = relay string_concat(s, ":");
    s = relay string_concat(s, tr);
    s = relay string_concat(s, " = { pub func:");
    s = relay string_concat(s, mn);
    s = relay string_concat(s, " = ");
    s = relay string_concat(s, rt);
    s = relay string_concat(s, "(");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, ":self, ");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, ":other) {\n");

    int32:n = raw item_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclNode:m = relay ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = relay intern_get(interns, raw decl_name(m));
            s = relay string_concat(s, "if (self.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, " < other.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, ") { pass Ordering.Less; }\n");
            s = relay string_concat(s, "if (self.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, " > other.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, ") { pass Ordering.Greater; }\n");
        }
        i = i + 1i32;
    }
    pass (relay string_concat(s, "pass Ordering.Equal; }; };\n"));
};

// `pass self` IS THE CLONE. A struct is a value; passing one is a copy, and the
// prototype's derived `clone` is the same single statement.
func:gen_clone = string(string:tn, string:head) {
    string:s = relay string_concat(head, tn);
    s = relay string_concat(s, ":Clone = { pub func:clone = ");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, "(");
    s = relay string_concat(s, tn);
    pass (relay string_concat(s, ":self) { pass self; }; };\n"));
};

// `Point { x: &{self.x}, y: &{self.y} }`, built with interpolation (D-053) because
// that is the only formatting mechanism the language has.
func:gen_to_string_struct = string(Ast->:ast, InternTable->:interns, DeclNode:d,
                                   string:tn, bool:dbg, string:head) {
    string:tr = "ToString";
    string:mn = "to_string";
    if (dbg) { tr = "Debug"; mn = "debug"; }

    string:s = relay string_concat(head, tn);
    s = relay string_concat(s, ":");
    s = relay string_concat(s, tr);
    s = relay string_concat(s, " = { pub func:");
    s = relay string_concat(s, mn);
    s = relay string_concat(s, " = string(");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, ":self) { pass `");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, " { ");

    int32:n = raw item_member_count(ast, d);
    bool:first = true;
    int32:i = 0i32;
    while (i < n) {
        DeclNode:m = relay ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            string:f = relay intern_get(interns, raw decl_name(m));
            if (!first) { s = relay string_concat(s, ", "); }
            first = false;
            s = relay string_concat(s, f);
            s = relay string_concat(s, ": &{self.");
            s = relay string_concat(s, f);
            s = relay string_concat(s, "}");
        }
        i = i + 1i32;
    }
    pass (relay string_concat(s, " }`; }; };\n"));
};

// AN ENUM COMPARES BY `==` AND NOTHING ELSE. `<` on an enum is refused by the type
// checker (measured), so ordering a variant would need its tag, which no operator
// yields — that is why `Ord` on an enum is refused rather than generated.
func:gen_eq_enum = string(string:tn, string:head) {
    string:s = relay string_concat(head, tn);
    s = relay string_concat(s, ":Eq = { pub func:eq = bool(");
    s = relay string_concat(s, tn);
    s = relay string_concat(s, ":self, ");
    s = relay string_concat(s, tn);
    pass (relay string_concat(s, ":other) { pass (self == other); }; };\n"));
};

// THE VARIANT'S NAME, through a `pick` — which is expressible, exhaustive by
// construction, and checked as such by 0.5.4.
//
// NOT `&{self}`: interpolation is what CALLS `to_string`, so a body built out of it
// would call itself.
func:gen_to_string_enum = string(Ast->:ast, InternTable->:interns, DeclNode:d,
                                 string:tn, bool:dbg, string:head) {
    string:tr = "ToString";
    string:mn = "to_string";
    if (dbg) { tr = "Debug"; mn = "debug"; }

    string:s = relay string_concat(head, tn);
    s = relay string_concat(s, ":");
    s = relay string_concat(s, tr);
    s = relay string_concat(s, " = { pub func:");
    s = relay string_concat(s, mn);
    s = relay string_concat(s, " = string(");
    s = relay string_concat(s, tn);
    // `pick (selector) { (pattern) { … }, … }` — THE SELECTOR IS PARENTHESISED and
    // THE ARMS ARE COMMA-SEPARATED. Written from memory the first time and neither
    // was right, which is what the generated source being real source catches: it
    // failed to parse, loudly, instead of building a tree nobody could have read.
    s = relay string_concat(s, ":self) {\npick (self) {\n");

    int32:n = raw item_member_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclNode:m = relay ast_decl(ast, raw item_member(ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            string:v = relay intern_get(interns, raw decl_name(m));
            s = relay string_concat(s, "(");
            s = relay string_concat(s, tn);
            s = relay string_concat(s, ".");
            s = relay string_concat(s, v);
            s = relay string_concat(s, ") { pass \"");
            if (dbg) {
                s = relay string_concat(s, tn);
                s = relay string_concat(s, ".");
            }
            s = relay string_concat(s, v);
            s = relay string_concat(s, "\"; }");
            if (i < (n - 1i32)) { s = relay string_concat(s, ","); }
            s = relay string_concat(s, "\n");
        }
        i = i + 1i32;
    }
    pass (relay string_concat(s, "}\n}; };\n"));
};

// --- the walk -------------------------------------------------------------------
//
// Over declarations rather than over the attribute array, because an attribute's
// meaning depends entirely on what it is attached to and the array does not say.

// EVERY MODULE, READ AND THEN REWRITTEN. Reading reports; rewriting appends the
// generated implementations to the module's member list, so that everything
// downstream — collection, coherence, completeness — sees them as members like any
// other. That is what makes a derived impl beside a hand-written one a coherence
// violation rather than a special case.
pub func:derive_apply = NIL(ModuleGraph->:g) {
    int32:i = 0i32;
    while (i < (raw graph_count(g))) {
        ModuleEntry:e = raw graph_at(g, i);
        if (i != g.prelude) {
            drop derive_in_module(g, DeclId{ index: e.root }, i);
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:derive_in_module = NIL(ModuleGraph->:g, DeclId:mod_id, int32:index) {
    drop derive_module(@g.ast, g.interns, g.diags, mod_id);

    string:src = relay derive_text(@g.ast, g.interns, g.diags, mod_id);
    if (src.len == 0i64) { pass NIL; }

    // THE GENERATED TEXT IS A MODULE, PARSED LIKE ANY OTHER. Its own name is
    // irrelevant — only its members are taken — but it needs one, because a source
    // file without a `mod:` line is not a source file.
    string:path = relay string_concat("<derived-",
                      relay string_concat(raw int_to_string(index => int64), ">"));
    string:full = relay string_concat("mod:derived;\n", src);
    int32:file = relay srcmgr_add(@g.sm, path, full);
    TokenList:toks = raw lex_all(file, full, g.interns, g.diags);
    Parser:p = raw parser_init(@toks, @g.ast, g.diags, g.interns);
    DeclId:groot = relay p_parse_module(@p);

    DeclNode:gm = relay ast_decl(@g.ast, groot);
    DeclNode:m = relay ast_decl(@g.ast, mod_id);
    int32:gc = raw item_generic_count(@g.ast, m);
    int32:mc = raw item_member_count(@g.ast, m);
    int32:ac = raw item_attr_count(@g.ast, m);
    int32:ec = raw item_extra_count(@g.ast, m);
    int32:added = raw item_member_count(@g.ast, gm);

    int32:mark = raw ast_scratch_mark(@g.ast);
    drop ast_scratch_push(@g.ast, gc);
    drop ast_scratch_push(@g.ast, mc + added);
    drop ast_scratch_push(@g.ast, ac);
    drop ast_scratch_push(@g.ast, ec);

    int32:q = 0i32;
    while (q < gc) {
        drop ast_scratch_push(@g.ast, (raw item_generic(@g.ast, m, q)).index);
        q = q + 1i32;
    }
    int32:j = 0i32;
    while (j < mc) {
        drop ast_scratch_push(@g.ast, (raw item_member(@g.ast, m, j)).index);
        j = j + 1i32;
    }
    // THE GENERATED IMPLS GO LAST. Order among members does not decide anything —
    // collection is two-phase (D-086) — and appending keeps every index the user's
    // own declarations already had.
    int32:k = 0i32;
    while (k < added) {
        DeclId:genid = raw item_member(@g.ast, gm, k);
        // MARKED AS DERIVED, so a diagnostic about it can say so rather than
        // sending the reader to look for an `impl` they never wrote.
        drop ast_or_decl_flags(@g.ast, genid, raw DECL_DERIVED());
        drop ast_scratch_push(@g.ast, genid.index);
        k = k + 1i32;
    }
    int32:a2 = 0i32;
    while (a2 < ac) {
        drop ast_scratch_push(@g.ast, (raw item_attr(@g.ast, m, a2)).index);
        a2 = a2 + 1i32;
    }
    int32:e2 = 0i32;
    while (e2 < ec) {
        drop ast_scratch_push(@g.ast, (raw item_extra(@g.ast, m, e2)).index);
        e2 = e2 + 1i32;
    }
    IdSpan:w = raw ast_scratch_commit(@g.ast, mark);
    drop ast_set_decl_window(@g.ast, mod_id, w.start, w.count);
    pass NIL;
};

// EVERY DERIVE IN ONE MODULE, AS ONE SOURCE. One parse rather than one per type,
// because a parse is a lexer, a token list and a parser, and the number of them is
// not something the number of `#[derive]`s in a file should decide.
func:derive_text = string(Ast->:ast, InternTable->:interns, DiagList->:diags,
                          DeclId:mod_id) {
    DeclNode:m = relay ast_decl(ast, mod_id);
    string:out = "";
    int32:n = raw item_member_count(ast, m);
    int32:i = 0i32;
    while (i < n) {
        DeclId:id = raw item_member(ast, m, i);
        DeclNode:d = relay ast_decl(ast, id);
        bool:is_struct = (d.kind == DeclKind.DeclStructDecl);
        bool:is_enum = (d.kind == DeclKind.DeclEnumDecl);
        if (is_struct || is_enum) {
            DeriveSet:want = raw read_derives(ast, interns, diags, d,
                                              raw item_attr_count(ast, d), true);
            if (want.count > 0i32) {
                out = relay string_concat(out,
                          relay derive_one(ast, interns, diags, d, want, is_enum));
            }
        }
        i = i + 1i32;
    }
    pass out;
};

func:derive_one = string(Ast->:ast, InternTable->:interns, DiagList->:diags,
                         DeclNode:d, DeriveSet:want, bool:is_enum) {
    string:bare = relay intern_get(interns, raw decl_name(d));

    // A GENERIC SUBJECT DERIVES THE FAMILY FORM (D-161, 1.0.4c). `#[derive(Eq)]`
    // on `struct:Box<T>` used to synthesize `impl:Box:Eq` — the bare
    // declaration with no arguments — and the author was shown three
    // "generic arity" errors pointing at `<derived-1>`, source they never
    // wrote. Now it writes `impl:<T>:Box<T>:Eq`, which is what a person would
    // write, and which family impls made real at 1.0.4b.
    //
    // NO BOUND IS SYNTHESIZED. `T: Eq` looks right and is not needed: the
    // generated body compares fields with the OPERATOR (`!=`), never by calling
    // a trait method, so what it requires of `T` is what the operator requires
    // — the same rule that let a derived `Eq` work on an `int32` field, which
    // implements no trait at all. Writing a bound would refuse
    // `Box<int32>` for failing to implement a trait its own field type does not
    // implement either.
    string:tn = bare;
    string:head = "impl:";
    IdSpan:gw = raw decl_generic_window(ast, d);
    if (gw.count > 0i32) {
        string:params = "<";
        int32:gi = 0i32;
        while (gi < gw.count) {
            if (gi > 0i32) { params = relay string_concat(params, ", "); }
            DeclNode:gp = relay ast_decl(ast,
                              DeclId{ index: relay ast_id_at(ast, gw.start, gi) });
            params = relay string_concat(params,
                         relay intern_get(interns, raw decl_name(gp)));
            gi = gi + 1i32;
        }
        params = relay string_concat(params, ">");
        tn = relay string_concat(bare, params);
        head = relay string_concat("impl:", relay string_concat(params, ":"));
    }

    string:s = "";

    if (raw derive_wants(want, raw DERIVE_CLONE())) {
        s = relay string_concat(s, relay gen_clone(tn, head));
    }
    if (raw derive_wants(want, raw DERIVE_EQ())) {
        if (is_enum) { s = relay string_concat(s, relay gen_eq_enum(tn, head)); }
        else { s = relay string_concat(s, relay gen_eq_struct(ast, interns, d, tn, head)); }
    }
    if (raw derive_wants(want, raw DERIVE_TO_STRING())) {
        if (is_enum) { s = relay string_concat(s, relay gen_to_string_enum(ast, interns, d, tn, false, head)); }
        else { s = relay string_concat(s, relay gen_to_string_struct(ast, interns, d, tn, false, head)); }
    }
    if (raw derive_wants(want, raw DERIVE_DEBUG())) {
        if (is_enum) { s = relay string_concat(s, relay gen_to_string_enum(ast, interns, d, tn, true, head)); }
        else { s = relay string_concat(s, relay gen_to_string_struct(ast, interns, d, tn, true, head)); }
    }

    // ORDERING AN ENUM NEEDS ITS TAG, WHICH NO OPERATOR YIELDS. `<` on an enum is
    // refused by the type checker, so there is nothing to compare with — refused
    // rather than generated into something that does not compile, because a
    // diagnostic inside generated code points at a line nobody wrote.
    if (raw derive_wants(want, raw DERIVE_ORD())) {
        if (is_enum) { drop enum_order_error(diags, d, bare, "Ord"); }
        else { s = relay string_concat(s, relay gen_cmp_struct(ast, interns, d, tn, false, head)); }
    }
    if (raw derive_wants(want, raw DERIVE_PARTIAL_ORD())) {
        if (is_enum) { drop enum_order_error(diags, d, bare, "PartialOrd"); }
        else { s = relay string_concat(s, relay gen_cmp_struct(ast, interns, d, tn, true, head)); }
    }

    if (raw derive_wants(want, raw DERIVE_HASH())) {
        drop hash_unavailable(diags, d, bare);
    }
    pass s;
};

func:enum_order_error = NIL(DiagList->:diags, DeclNode:d, string:tn, string:tr) {
    string:m1 = relay string_concat("`", tr);
    string:m2 = relay string_concat(m1, "` cannot be derived for the enum `");
    string:m3 = relay string_concat(m2, tn);
    string:m4 = relay string_concat(m3,
        "`: ordering a variant means comparing its tag, and no operator yields one — `<` on an enum is refused. Write the comparison, and then the order the variants are in is a thing somebody chose");
    drop diaglist_push(diags, raw diag_error(raw DERIVE_UNKNOWN(), m4, d.span));
    pass NIL;
};

// `Hash` IS THE ONE OF THE SEVEN THAT CANNOT BE WRITTEN YET, and it is refused
// rather than skipped: a derive that silently generated nothing would leave
// `#[derive(Hash)]` meaning nothing at all, which is the shape 0.6.5 exists to
// remove.
//
// WHAT IS MISSING IS A BYTE VIEW OF A `string`. FNV-1a folds bytes; an integer,
// `bool` or `char` field can supply its bits through `=>!`, and a nested type that
// derived `Hash` can supply its own — but nothing in `builtins.npk` exposes a
// string's bytes, and a derived hash that quietly skipped string fields would vary
// with data it ignored. That is worse than not having one.
func:hash_unavailable = NIL(DiagList->:diags, DeclNode:d, string:tn) {
    string:m1 = relay string_concat("`Hash` cannot be derived for `", tn);
    string:m2 = relay string_concat(m1,
        "` yet: FNV-1a folds bytes, and nothing exposes a `string`'s bytes to Nitpick source — a derived hash that skipped string fields would vary with data it ignored");
    drop diaglist_push(diags, raw diag_error(raw DERIVE_UNKNOWN(), m2, d.span));
    pass NIL;
};

pub func:derive_module = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                             DeclId:mod_id) {
    DeclNode:m = relay ast_decl(ast, mod_id);
    int32:n = raw item_member_count(ast, m);
    int32:i = 0i32;
    while (i < n) {
        DeclId:id = raw item_member(ast, m, i);
        DeclNode:d = relay ast_decl(ast, id);

        bool:is_type = (d.kind == DeclKind.DeclStructDecl);
        if (d.kind == DeclKind.DeclEnumDecl) { is_type = true; }

        if (d.kind == DeclKind.DeclModuleDecl) {
            drop derive_module(ast, interns, diags, id);
        } else {
            // ONLY THE ITEM KINDS CARRY AN ATTRIBUTE WINDOW IN THIS SHAPE. A
            // function's attributes are in its own layout and an `impl`'s in a
            // third; reading `item_attr_count` on either would read a slot that
            // means something else, which is the defect this compiler has paid for
            // seven times.
            if (d.kind == DeclKind.DeclStructDecl) {
                drop discard_set(raw read_derives(ast, interns, diags, d,
                                                  raw item_attr_count(ast, d), is_type));
            }
            if (d.kind == DeclKind.DeclEnumDecl) {
                drop discard_set(raw read_derives(ast, interns, diags, d,
                                                  raw item_attr_count(ast, d), is_type));
            }
            if (d.kind == DeclKind.DeclTraitDecl) {
                drop discard_set(raw read_derives(ast, interns, diags, d,
                                                  raw item_attr_count(ast, d), false));
            }
            if (d.kind == DeclKind.DeclFunctionDecl) {
                drop derive_on_function(ast, interns, diags, d);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// The set is read for its diagnostics here; generation is what will consume it.
func:discard_set = NIL(DeriveSet:_~s) { pass NIL; };

func:derive_on_function = NIL(Ast->:ast, InternTable->:interns, DiagList->:diags,
                              DeclNode:d) {
    int32:n = raw fn_attr_count(ast, d);
    int32:i = 0i32;
    while (i < n) {
        DeclNode:at = relay ast_decl(ast, raw fn_attr(ast, d, i));
        string:aname = relay intern_get(interns, raw attr_name(at));
        if (raw string_eq(aname, "derive")) {
            drop diaglist_push(diags, raw diag_error(raw DERIVE_TARGET(),
                "`#[derive]` generates an implementation from a type's shape — its fields, or its variants — so it belongs on a `struct` or an `enum` and there is nothing here to generate from",
                at.span));
        }
        i = i + 1i32;
    }
    pass NIL;
};
