// Parser core.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.1: the cursor, the expectation
// helpers, and the recovery strategy -- fixed BEFORE any rule depends on it,
// because recovery is a design decision and not a detail.
//
// A parser that stops at the first error reports one problem per run, so fixing
// a file becomes one compile per mistake. A parser that recovers BADLY is worse
// than one that stops: it emits a cascade of phantom errors after the real one,
// and the reader cannot tell which diagnostic is the cause. So the rule here is
// one diagnostic per error region, and silence until the parser has genuinely
// resynchronised.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token_name.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./parse_codes.npk".*;

pub struct:Parser = {
    TokenList->:tokens;
    Ast->:ast;
    DiagList->:diags;
    InternTable->:interns;

    int64:pos;

    // Panic mode: set when a diagnostic is reported, cleared only by a
    // successful resynchronisation. While set, further diagnostics are
    // suppressed -- that is the whole anti-cascade mechanism.
    bool:panic;

    int32:paren_depth;
    int32:bracket_depth;
    int32:brace_depth;
};

pub func:parser_init = Parser(TokenList->:tokens, Ast->:ast,
                              DiagList->:diags, InternTable->:interns) {
    Parser:p = Parser{ tokens: tokens, ast: ast, diags: diags,
                       interns: interns, pos: 0i64, panic: false,
                       paren_depth: 0i32, bracket_depth: 0i32,
                       brace_depth: 0i32 };
    pass p;
};

// --- cursor -----------------------------------------------------------------
//
// Reading past the end yields the Eof token rather than failing, so no rule
// needs a bounds test before every peek. The lexer guarantees exactly one Eof
// at the end (lex_all), which is what makes that safe.

pub func:p_peek = Token(Parser->:p) {
    int64:n = raw tokenlist_count(p.tokens);
    if (p.pos >= n) {
        pass (relay tokenlist_at(p.tokens, n - 1i64));
    }
    pass (relay tokenlist_at(p.tokens, p.pos));
};

pub func:p_peek_at = Token(Parser->:p, int64:k) {
    int64:n = raw tokenlist_count(p.tokens);
    int64:i = p.pos + k;
    if (i >= n) {
        pass (relay tokenlist_at(p.tokens, n - 1i64));
    }
    pass (relay tokenlist_at(p.tokens, i));
};

pub func:p_kind = TokenKind(Parser->:p) {
    Token:t = relay p_peek(p);
    pass t.kind;
};

pub func:p_at = bool(Parser->:p, TokenKind:k) {
    pass ((relay p_kind(p)) == k);
};

pub func:p_at_end = bool(Parser->:p) {
    pass ((relay p_kind(p)) == TokenKind.Eof);
};

pub func:p_span = Span(Parser->:p) {
    Token:t = relay p_peek(p);
    pass t.span;
};

pub func:p_advance = Token(Parser->:p) {
    Token:t = relay p_peek(p);
    if (t.kind == TokenKind.PLParen)   { p.paren_depth = p.paren_depth + 1i32; }
    if (t.kind == TokenKind.PRParen)   { p.paren_depth = p.paren_depth - 1i32; }
    if (t.kind == TokenKind.PLBracket) { p.bracket_depth = p.bracket_depth + 1i32; }
    if (t.kind == TokenKind.PRBracket) { p.bracket_depth = p.bracket_depth - 1i32; }
    if (t.kind == TokenKind.PLBrace)   { p.brace_depth = p.brace_depth + 1i32; }
    if (t.kind == TokenKind.PRBrace)   { p.brace_depth = p.brace_depth - 1i32; }
    if (t.kind != TokenKind.Eof) {
        p.pos = p.pos + 1i64;
    }
    pass t;
};

pub func:p_accept = bool(Parser->:p, TokenKind:k) {
    if (relay p_at(p, k)) {
        drop p_advance(p);
        pass true;
    }
    pass false;
};

// --- diagnostics -------------------------------------------------------------

pub func:p_error = NIL(Parser->:p, string:code, string:message) {
    // Suppressed while in panic mode. One error region, one diagnostic.
    if (p.panic) {
        pass NIL;
    }
    p.panic = true;
    drop diaglist_push(p.diags,
        raw diag_error(code, message, relay p_span(p)));
    pass NIL;
};

// An error about somewhere ELSE in the file. An unclosed `{` is discovered at
// end of file and belongs at the brace; a diagnostic pointing at the last line
// names the one place the mistake certainly is not.
pub func:p_error_at = NIL(Parser->:p, string:code, string:message, Span:span) {
    if (p.panic) {
        pass NIL;
    }
    p.panic = true;
    drop diaglist_push(p.diags, raw diag_error(code, message, span));
    pass NIL;
};

pub func:p_expect = bool(Parser->:p, TokenKind:k) {
    if (relay p_accept(p, k)) {
        pass true;
    }
    // Naming both halves is the difference between a usable message and a
    // riddle: the token carries a kind, not the text it was scanned from.
    string:want = raw token_kind_name(k);
    string:got = raw token_kind_name(relay p_kind(p));
    string:m1 = relay string_concat("expected `", want);
    string:m2 = relay string_concat(m1, "`, found `");
    string:m3 = relay string_concat(m2, got);
    string:m4 = relay string_concat(m3, "`");
    drop p_error(p, raw PARSE_EXPECTED(), m4);
    pass false;
};

// --- recovery -----------------------------------------------------------------

// Tokens that can legitimately begin a statement or declaration. Skipping TO one
// of these is what makes the next diagnostic trustworthy rather than an artefact
// of where the previous one stopped.
pub func:is_sync_point = bool(TokenKind:k) {
    if (k == TokenKind.Eof)        { pass true; }
    if (k == TokenKind.PSemi)      { pass true; }
    if (k == TokenKind.PRBrace)    { pass true; }

    if (k == TokenKind.KwPub)      { pass true; }
    if (k == TokenKind.KwFunc)     { pass true; }
    if (k == TokenKind.KwStruct)   { pass true; }
    if (k == TokenKind.KwEnum)     { pass true; }
    if (k == TokenKind.KwTrait)    { pass true; }
    if (k == TokenKind.KwImpl)     { pass true; }
    if (k == TokenKind.KwUse)      { pass true; }
    if (k == TokenKind.KwMod)      { pass true; }
    if (k == TokenKind.KwExtern)   { pass true; }
    if (k == TokenKind.KwMacro)    { pass true; }

    if (k == TokenKind.KwIf)       { pass true; }
    if (k == TokenKind.KwWhile)    { pass true; }
    if (k == TokenKind.KwFor)      { pass true; }
    if (k == TokenKind.KwLoop)     { pass true; }
    if (k == TokenKind.KwTill)     { pass true; }
    if (k == TokenKind.KwWhen)     { pass true; }
    if (k == TokenKind.KwPick)     { pass true; }
    if (k == TokenKind.KwReturn)   { pass true; }
    if (k == TokenKind.KwPass)     { pass true; }
    if (k == TokenKind.KwFail)     { pass true; }
    if (k == TokenKind.KwExit)     { pass true; }
    if (k == TokenKind.KwDefer)    { pass true; }
    if (k == TokenKind.KwBreak)    { pass true; }
    if (k == TokenKind.KwContinue) { pass true; }
    if (k == TokenKind.KwDiscard)  { pass true; }
    if (k == TokenKind.KwProve)    { pass true; }
    pass false;
};

// Skip to the next point a rule can restart from, then leave panic mode.
//
// Always consumes AT LEAST ONE token unless already at Eof. Without that, a rule
// that fails on a sync point would call sync, get nowhere, and loop -- a
// non-terminating parser is a worse failure than a bad diagnostic.
pub func:p_sync = NIL(Parser->:p) {
    if (relay p_at_end(p)) {
        p.panic = false;
        pass NIL;
    }
    drop p_advance(p);
    while (true) {
        TokenKind:k = relay p_kind(p);
        if (k == TokenKind.Eof) { break; }
        if (raw is_sync_point(k)) { break; }
        drop p_advance(p);
    }
    // A `;` marks the end of the broken construct, so step over it: leaving it
    // would make the next rule start on a terminator and fail immediately.
    if (relay p_at(p, TokenKind.PSemi)) {
        drop p_advance(p);
    }
    p.panic = false;
    pass NIL;
};

// Can this token begin a statement or a declaration? A superset of
// `is_sync_point`, because recovery needs to STOP at a plausible item start
// while `p_sync` needs a small, certain set to skip TO.
pub func:p_can_start_item = bool(Parser->:p) {
    TokenKind:k = relay p_kind(p);
    if (raw is_sync_point(k))               { pass true; }
    if (k == TokenKind.Ident)               { pass true; }
    if (raw token_kind_is_builtin_type(k))  { pass true; }
    if (k == TokenKind.Hash)                { pass true; }
    if (k == TokenKind.PLBrace)             { pass true; }
    if (k == TokenKind.KwStack)             { pass true; }
    if (k == TokenKind.KwWild)              { pass true; }
    if (k == TokenKind.KwWildx)             { pass true; }
    if (k == TokenKind.KwConst)             { pass true; }
    if (k == TokenKind.KwFixed)             { pass true; }
    if (k == TokenKind.KwNodrop)            { pass true; }
    if (k == TokenKind.KwLimit)             { pass true; }
    pass false;
};

// --- memory qualifiers --------------------------------------------------------
//
// The bits, and the one loop that reads them. They live HERE rather than beside
// the statement parser that first needed them, because 0.7.3 gave a struct field,
// a parameter and a cast target the same qualifier -- and `parse_expr.npk` cannot
// import `parse_stmt.npk`, which imports IT. The shared rule has to sit below
// both, which is what this module is.
//
// A QUALIFIER IS NOT PART OF THE TYPE (AST_REFERENCE section 4), which is why the
// type parser refuses to consume one: a type that swallowed `wild` would drop it
// on the floor. It belongs to whatever is being declared, or cast to.

pub func:QUAL_STACK = int32()  { pass 1i32; };
pub func:QUAL_WILD = int32()   { pass 2i32; };
pub func:QUAL_WILDX = int32()  { pass 4i32; };
pub func:QUAL_CONST = int32()  { pass 8i32; };
pub func:QUAL_FIXED = int32()  { pass 16i32; };
pub func:QUAL_NODROP = int32() { pass 32i32; };

pub func:p_qualifier_bit = int32(TokenKind:k) {
    if (k == TokenKind.KwStack)  { pass (raw QUAL_STACK()); }
    if (k == TokenKind.KwWild)   { pass (raw QUAL_WILD()); }
    if (k == TokenKind.KwWildx)  { pass (raw QUAL_WILDX()); }
    if (k == TokenKind.KwConst)  { pass (raw QUAL_CONST()); }
    if (k == TokenKind.KwFixed)  { pass (raw QUAL_FIXED()); }
    if (k == TokenKind.KwNodrop) { pass (raw QUAL_NODROP()); }
    pass 0i32;
};

// EVERY LEADING MEMORY QUALIFIER, WHEREVER ONE CAN BE WRITTEN.
//
// The loop was written out twice before 0.7.3 and would have been written out
// three more times after it. Five copies is five places for a qualifier added
// later to be read in four of them.
//
// IT DOES NOT RESTRICT. `nodrop` on a struct field may well be meaningless;
// saying so is the type checker's, because the parser never restricts (D-085) and
// a qualifier refused here would be a parse error where the rule is semantic.
pub func:p_qualifiers = int32(Parser->:p) {
    int32:q = 0i32;
    while (true) {
        int32:bit = raw p_qualifier_bit(relay p_kind(p));
        if (bit == 0i32) { break; }
        drop p_advance(p);
        q = q | bit;
    }
    pass q;
};

// Called by every loop that reads a SEQUENCE of items -- block statements,
// module items, struct fields, `pick` arms.
//
// Panic mode is entered by the first diagnostic and must be left again, or one
// mistake silences the rest of the file. It used to be cleared only by `p_sync`,
// and `p_sync` ran only when a rule consumed nothing -- so a rule that erred and
// then advanced left panic set forever. A file with three independent errors
// reported one, which looks exactly like a file with one error (0.2.7).
//
// The rule now: at an item boundary, if the parser is still in panic, skip
// forward to something that could begin the next item and leave panic. There is
// NO mandatory advance here, unlike `p_sync` -- the caller may already be sitting
// on a perfectly good next item, and eating it would turn one lost construct into
// two.
pub func:p_recover = NIL(Parser->:p) {
    if (!p.panic) {
        pass NIL;
    }
    while (true) {
        if (relay p_at_end(p))        { break; }
        if (relay p_can_start_item(p)) { break; }
        drop p_advance(p);
    }
    // A `;` here terminates the construct that failed. Leaving it would make the
    // next rule start on a terminator and fail immediately -- a phantom, which is
    // the thing this whole mechanism exists to prevent.
    if (relay p_at(p, TokenKind.PSemi)) {
        drop p_advance(p);
    }
    p.panic = false;
    pass NIL;
};

pub func:p_in_panic = bool(Parser->:p) { pass p.panic; };
pub func:p_position = int64(Parser->:p) { pass p.pos; };
