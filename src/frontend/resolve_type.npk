// Type resolution — `TypeNode` → `Type`.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.1.
//
// The parser records what was WRITTEN; this decides what it MEANS. A `NamedType`
// is a name and a window of generic arguments until something looks the name up,
// and that something is here.
//
// EVERY FAILURE RETURNS THE INVALID TYPE RATHER THAN NOTHING. Index 0 is a real
// entry (0.4.0), so one bad annotation produces one diagnostic instead of a
// cascade of "cannot compare" from everything downstream that touched it. This is
// the same reasoning as the AST's reserved NONE nodes and the parser's panic
// mode, applied one layer up.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./builtin_types.npk".*;
use "./num_width.npk".*;
use "./parse_type.npk".*;
use "./parse_expr.npk".*;
use "./parse_decl.npk".*;
use "./symbols.npk".*;
use "./type_names.npk".*;
use "./parse_stmt.npk".*;
use "./parser.npk".*;   // QUAL_CONST, for what may stand in a constant expression
use "./builtins.npk".*;     // is_builtin_name, for the four with compile-time answers

// WHICH GENERIC PARAMETERS ARE IN SCOPE, AND WHAT THEY STAND FOR.
//
// ONE STRUCTURE FOR BOTH HALVES OF D-064, because they are the same question
// asked with and without an answer:
//
//   * UNBOUND (`args_count == 0`) is the DEFINITION. `T` is an opaque type
//     satisfying exactly its declared bounds — the body is checked once, here.
//   * BOUND is an INSTANTIATION. `T` is `int32`, and nothing about the body is
//     re-examined; only the arguments are checked against the bounds.
//
// Writing it as two mechanisms would make `T` mean one thing in a definition and
// another in an instantiation, which is precisely the context-dependence the
// blueprint philosophy exists to prevent. It means the same thing in both; only
// the binding differs, and that difference is one field.
pub struct:GenericScope = {
    int32:params_start;   // window of `GenericParam` decl ids
    int32:params_count;
    int32:args_start;     // window of concrete type ids; count 0 = UNBOUND
    int32:args_count;
};

pub func:generic_scope_none = GenericScope() {
    GenericScope:g = GenericScope{ params_start: 0i32, params_count: 0i32,
                                   args_start: 0i32, args_count: 0i32 };
    pass g;
};

// WHETHER A NAME IS A PARAMETER IS A SEPARATE ANSWER FROM WHICH TYPE IT IS. A
// bound parameter can legitimately resolve to type id 0 when its argument failed
// to resolve, and 0 is also "not a parameter" — so the two are different fields,
// the same split `MethodFind` and `FieldInfo` are built around.
pub struct:ParamBind = {
    bool:found;
    int32:type_id;
};

pub struct:TypeResolver = {
    Ast->:ast;
    TypeTable->:types;
    SymbolTable->:tab;
    InternTable->:interns;
    DiagList->:diags;

    // `Self` is valid only inside a `trait` or `impl` body (D-030). Held as the
    // type it stands for, or 0 when there is none — so "Self outside an impl" is
    // a state the resolver can see rather than a rule it has to remember.
    int32:self_type;

    // THE TRAIT WHOSE BODY IS BEING RESOLVED, or 0 (D-160, 1.0.6). An associated
    // type is spelled BARE inside its trait — `func:next = Item(Self:self)` —
    // and `Item` is in no scope: it is a member of the trait, the way `Self` is
    // the trait's implementor. This is what makes it findable.
    //
    // CARRIED BESIDE `Self` RATHER THAN FOLDED INTO IT, the same choice the
    // checker's `self_trait` made at 1.0.4: `Self` is D-103's anonymous
    // placeholder and carries no declaration, so the trait has to travel
    // separately or neither question can be answered.
    int32:self_trait;

    // TWO LAYERS, because the language has exactly two. A method inside
    // `impl:<T: Printable>:Loggable` sees the impl's `T` and its own `<U>`, and
    // nothing nests deeper — a function cannot declare a function. The
    // declaration's own layer is searched first, so a method that reuses a name
    // shadows rather than collides.
    GenericScope:generics;
    GenericScope:enclosing;

    // EVERY INSTANTIATION BUILT, so that bound satisfaction can be decided after
    // the impl table exists rather than while it is still being filled. A
    // required pointer rather than something set afterwards: a resolver without
    // one would record nothing and every bound would go unchecked, silently.
    InstanceTable->:instances;

    // HOW DEEP INTO NESTED TYPE ARGUMENTS THIS IS. Capped at 64 (D-064 §6), and
    // exceeding it is an error naming the cap rather than a silent truncation.
    int32:depth;

    // THE CHAIN THAT GOT HERE (1.0.2). D-064 §6 requires the depth-cap error to
    // print "the instantiation stack", and a number alone does not tell an author
    // WHICH nesting ran away — with 64 frames the culprit is never at the top.
    // Names only (intern indices), pushed and popped with `depth`, so the cost is
    // one store per frame and the report reads like the source: `A -> B -> A`.
    int32[64]:inst_chain;

    // THE LOCALS OF THE `comptime func:` BEING EVALUATED, if one is (0.6.4). Empty
    // outside a call, saved and restored around one, for the same reason `generics`
    // is: it is constant across one evaluation and a nested call needs a frame of
    // its own.
    FoldEnv:env;

    // THE BUDGET WAS EXHAUSTED, and it has been said once. Without this a
    // non-terminating `comptime` reports at every frame it unwinds through, which
    // buries the one sentence that matters under a hundred copies of itself.
    bool:fold_blown;

    // HOW MANY `comptime func:` CALLS DEEP THIS IS. A SECOND BOUND, and the reason
    // is the same one D-057 gives for expansion having two: they fail differently.
    // Total work is bounded by the fuel; RECURSION DEPTH is not, and a comptime
    // function that calls itself blows the COMPILER'S OWN STACK long before a
    // budget measured in total steps runs out. Measured: `comptime func:forever =
    // int32(int32:n) { pass (raw forever(n)); };` segfaulted the checker.
    int32:fold_depth;

    // `$` — THE COUNTER OF THE `loop` BEING EVALUATED. It is not a name, so it
    // cannot live in the frame with the locals: `ExprIterationVarExpr` is its own
    // node kind precisely because a counter is not a binding anybody declared.
    int64:fold_counter;
    bool:fold_counting;
};

pub func:tyres_init = TypeResolver(Ast->:ast, TypeTable->:types,
                                   SymbolTable->:tab, InternTable->:interns,
                                   DiagList->:diags, InstanceTable->:instances) {
    TypeResolver:r = TypeResolver{ ast: ast, types: types, tab: tab,
                                   interns: interns, diags: diags,
                                   self_type: 0i32, self_trait: 0i32,
                                   generics: raw generic_scope_none(),
                                   enclosing: raw generic_scope_none(),
                                   instances: instances, depth: 0i32,
                                   inst_chain: [],
                                   env: raw foldenv_none(),
                                   fold_blown: false, fold_depth: 0i32,
                                   fold_counter: 0i64, fold_counting: false };
    pass r;
};

// A NAME THAT IS A GENERIC PARAMETER OF SOMETHING CURRENTLY IN SCOPE.
pub func:generic_lookup = ParamBind(TypeResolver->:r, int32:name) {
    ParamBind:own = relay generic_bind_in(r, r.generics, name);
    if (own.found) { pass own; }
    pass (relay generic_bind_in(r, r.enclosing, name));
};

func:generic_bind_in = ParamBind(TypeResolver->:r, GenericScope:g, int32:name) {
    int32:i = 0i32;
    while (i < g.params_count) {
        // NOT `pid` — one of the five kernel identifier types (D-042), and a type
        // name is not an identifier.
        DeclId:gpid = DeclId{ index: relay ast_id_at(r.ast, g.params_start, i) };
        DeclNode:pn = relay ast_decl(r.ast, gpid);
        if ((raw decl_name(pn)) == name) {
            // A VALUE PARAMETER IS NOT A TYPE. `<comptime int32:LEVEL>` names a
            // compile-time constant, and `LEVEL:x` is as wrong as `MAX:x` would
            // be — refused by name rather than becoming an opaque type that then
            // fails somewhere further along with a worse message.
            if (raw generic_is_value(pn)) {
                ParamBind:v = ParamBind{ found: true,
                    type_id: relay value_param_in_type_position(r, pn) };
                pass v;
            }
            // BOUND OR OPAQUE. Fewer arguments than parameters is an arity error
            // reported where the arguments were written; the parameters past the
            // end stay opaque here rather than reading off the end of a window.
            if (i < g.args_count) {
                ParamBind:b = ParamBind{ found: true,
                    type_id: relay ast_id_at(r.ast, g.args_start, i) };
                pass b;
            }
            ParamBind:b = ParamBind{ found: true,
                type_id: raw tt_param(r.types, gpid.index, name) };
            pass b;
        }
        i = i + 1i32;
    }
    ParamBind:none = ParamBind{ found: false, type_id: 0i32 };
    pass none;
};

func:value_param_in_type_position = int32(TypeResolver->:r, DeclNode:pn) {
    string:m1 = relay string_concat("`", relay intern_get(r.interns, raw decl_name(pn)));
    pass (relay ty_error(r, raw TYPE_NOT_A_TYPE(),
        relay string_concat(m1,
            "` is a `comptime` value parameter, not a type; it supplies a constant, and `comptime` is the marker that says which of the two a parameter is (D-064)"),
        pn.span));
};

func:ty_error = int32(TypeResolver->:r, string:code, string:message, Span:at) {
    drop diaglist_push(r.diags, raw diag_error(code, message, at));
    pass 0i32;      // the INVALID type
};

// --- the entry ---------------------------------------------------------------------

pub func:resolve_type = int32(TypeResolver->:r, TypeId:id, int32:scope) {
    if (raw type_is_none(id)) {
        pass 0i32;
    }
    TypeNode:n = relay ast_type(r.ast, id);

    if (n.kind == TypeKind.TypeNamedType) {
        pass (relay resolve_named(r, n, scope));
    }

    if (n.kind == TypeKind.TypePointerType) {
        // `resolve_pointee`, NOT `resolve_type`: the pointee is the one position
        // where a bare `any` is legal, and it is legal at every depth.
        // `wild any->` in a struct field is the same case as one in a signature.
        int32:pointee = relay resolve_pointee(r, raw type_pointee(n), scope);
        pass (raw tt_pointer(r.types, pointee));
    }

    if (n.kind == TypeKind.TypeOptionalType) {
        int32:inner = relay resolve_type(r, raw type_inner(n), scope);
        pass (relay make_optional(r, inner, n.span));
    }

    // ONE NODE, TWO TYPES. `T[]` and `T[N]` differ in syntax only by the size
    // expression and are wildly different types (D-070): a slice is a non-owning
    // {ptr, len} view, a fixed array is a value that contains its elements. The
    // AST records the syntax; this is where the meaning is assigned.
    if (n.kind == TypeKind.TypeArrayType) {
        int32:elem = relay resolve_type(r, raw type_element(n), scope);
        if (raw type_is_slice(n)) {
            pass (raw tt_slice(r.types, elem));
        }
        pass (relay resolve_fixed_array(r, n, elem, scope));
    }

    if (n.kind == TypeKind.TypeCStringType) {
        pass (r.types.t_cstring);
    }

    // `any` IS LEGAL ONLY UNDER `->` (TYPE_REFERENCE section 27). A bare one is
    // refused here rather than silently promoted, because a checker that
    // helpfully fixed it would make `any` mean two different things depending on
    // where it was written — and the spec already supplies the message.
    //
    // The pointer case never reaches this: `any->` resolves through the pointer
    // branch above, which asks for `any` as a POINTEE and gets it from
    // `resolve_pointee` rather than from here.
    if (n.kind == TypeKind.TypeAnyType) {
        pass (relay ty_error(r, raw TYPE_BARE_ANY(),
            "`any` must be used as a pointer type: `any->`. Bare `any` is not a valid type.",
            n.span));
    }

    if (n.kind == TypeKind.TypeFuncType) {
        pass (relay resolve_func_type(r, n, scope));
    }

    if (n.kind == TypeKind.TypeDynType) {
        pass (relay resolve_dyn(r, n, scope));
    }

    if (n.kind == TypeKind.TypeSelfType) {
        if (r.self_type == 0i32) {
            pass (relay ty_error(r, raw TYPE_SELF_OUTSIDE(),
                "`Self` names the implementing type and is valid only inside a `trait` or `impl` body",
                n.span));
        }
        pass (r.self_type);
    }

    if (n.kind == TypeKind.TypeProjection) {
        pass (relay resolve_projection(r, n, scope));
    }

    pass 0i32;
};

// `T.Item` — AN ASSOCIATED TYPE, PROJECTED FROM A TYPE (D-164).
//
// The base decides where to look, and the two cases are the two things a base
// can be:
//
//   * A GENERIC PARAMETER. `T` is a type that does not exist yet, so its BOUNDS
//     are everything known about it (D-107) — the same rule `find_in_bounds`
//     follows for methods. The assoc is sought among the traits `T` is bounded
//     by, and two of them declaring one name is an ambiguity naming both, which
//     is the answer D-158 gives a method supplied by two bounds and for the same
//     reason: an ordering tiebreak would be meaning-by-position.
//   * A CONCRETE TYPE. `Counter.Item` is the binding the impl wrote, so the impl
//     table is asked. This is the case that makes a projection usable outside
//     generic code at all.
//
// A NAME NO BOUND DECLARES IS REFUSED BY NAME. Falling through to the invalid
// type would be the silent wrong answer a new type kind most easily becomes.
func:resolve_projection = int32(TypeResolver->:r, TypeNode:n, int32:scope) {
    int32:base = relay resolve_type(r, raw type_projection_base(n), scope);
    if (base == 0i32) { pass 0i32; }
    if (raw type_is_invalid(r.types, base)) { pass base; }

    int32:name = (raw type_projection_name(n)) =>! int32;
    int32:found = 0i32;
    int32:owner = 0i32;
    int32:other = 0i32;

    if ((raw type_kind(r.types, base)) == (raw TY_PARAM())) {
        // THE BOUNDS ARE READ FROM THE PARAMETER'S DECLARATION, not from the
        // bound table. The window travels with the declaration, so the answer
        // does not depend on which scope a caller passed — the same reasoning
        // `generic_lookup` gives above — and the resolver needs no new required
        // pointer to answer a question the AST already holds.
        DeclNode:pdn = relay ast_decl(r.ast,
                           DeclId{ index: raw type_decl_of(r.types, base) });
        int32:bstart = raw generic_bound_start(pdn);
        int32:bcount = raw generic_bound_count(pdn);
        int32:i = 0i32;
        while (i < bcount) {
            TypeId:bt = TypeId{ index: relay ast_id_at(r.ast, bstart, i) };
            int32:btrait = relay resolve_type(r, bt, scope);
            int32:tdecl = raw type_decl_of(r.types, btrait);
            if (tdecl != 0i32) {
                int32:hit = relay assoc_of_trait(r, tdecl, name);
                if (hit != 0i32) {
                    if (found != 0i32) { other = btrait; } else {
                        found = raw tt_assoc(r.types, base, tdecl, name);
                        owner = btrait;
                    }
                }
            }
            i = i + 1i32;
        }
        if (other != 0i32) {
            string:a1 = relay string_concat("`",
                            relay intern_get(r.interns, name));
            string:a2 = relay string_concat(a1, "` is declared by both `");
            string:a3 = relay string_concat(a2,
                            relay type_display(r.types, r.interns, owner));
            string:a4 = relay string_concat(a3, "` and `");
            string:a5 = relay string_concat(a4,
                            relay type_display(r.types, r.interns, other));
            pass (relay ty_error(r, raw TYPE_AMBIGUOUS_METHOD(),
                relay string_concat(a5,
                    "`; there is no rule to choose by, so name the trait whose associated type you mean"),
                n.span));
        }
        if (found != 0i32) { pass found; }
    }

    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, base));
    string:m2 = relay string_concat(m1, "` has no associated type `");
    string:m3 = relay string_concat(m2, relay intern_get(r.interns, name));
    pass (relay ty_error(r, raw TYPE_UNKNOWN(),
        relay string_concat(m3, "`"), n.span));
};

// A pointer's pointee, which is the one position where a bare `any` is legal.
func:resolve_pointee = int32(TypeResolver->:r, TypeId:id, int32:scope) {
    if (raw type_is_none(id)) {
        pass 0i32;
    }
    TypeNode:n = relay ast_type(r.ast, id);
    if (n.kind == TypeKind.TypeAnyType) {
        pass (r.types.t_any);
    }
    pass (relay resolve_type(r, id, scope));
};

// --- named types ---------------------------------------------------------------------

func:resolve_named = int32(TypeResolver->:r, TypeNode:n, int32:scope) {
    int64:payload = raw type_name_index(n);

    // A BUILTIN TYPE KEYWORD carries no intern index: the parser stored the
    // token KIND as the name, because a keyword is not an identifier (0.2.2).
    // WHICH ONE THIS IS COMES FROM THE NODE, not from the payload's value.
    //
    // What stood here said "the two are told apart by which range the payload is
    // in" and then asked `builtin_type_spec` about every payload. Nothing
    // separated the ranges. Intern indices start at 1 and count up; the builtin
    // type keywords are TokenKind 80-175. So a program's 88th distinct identifier,
    // used as a type name, resolved to `int32` -- no diagnostic, no trace, just a
    // different type from the one written. Found while a two-trait `dyn` in a
    // long test file reported both of its perfectly good traits as "not a trait".
    if (!(raw type_name_is_builtin(n))) {
        pass (relay resolve_user_named(r, n, payload =>! int32, scope));
    }

    TokenKind:as_kind = ((payload =>! int32) =>! TokenKind);
    BuiltinTypeSpec:spec = raw builtin_type_spec(as_kind);
    if (spec.known) {
        pass (relay builtin_to_type(r, spec, n));
    }

    // A BUILTIN THAT TAKES GENERIC ARGUMENTS — `Result<T>`, `Optional<T>`, and
    // the constructors whose kinds arrive at a later rung. None of them matches
    // the scalar table, and before this they fell through to the user-name
    // lookup below, where a TOKEN KIND was reinterpreted as an intern index.
    // `Result<int32>` therefore reported "there is no type named" against
    // whatever string happened to sit at that index — and D-091 requires that
    // spelling to keep working, since it is how the compiler's own sources hold
    // a call's outcome before unwrapping.
    if (raw builtin_is_generic(as_kind)) {
        pass (relay resolve_generic_builtin(r, n, as_kind, scope));
    }

    // A BUILTIN TYPE KEYWORD THE TABLES DO NOT KNOW. Reaching here means the
    // keyword list and the type tables have drifted apart, which is a compiler
    // defect rather than a program one.
    pass (relay ty_error(r, raw TYPE_UNKNOWN(),
        "this builtin type keyword has no entry in the type tables", n.span));
};

func:resolve_user_named = int32(TypeResolver->:r, TypeNode:n, int32:name,
                                int32:scope) {
    // A GENERIC PARAMETER OF THE DECLARATION BEING RESOLVED IS ASKED FIRST, and
    // being first is the point: it is the innermost binding, so `T` inside
    // `struct:Container<T>` means the parameter even where a module-level type is
    // also called `T`.
    //
    // It is asked HERE rather than through the scope because a parameter is not
    // reliably in one. `resolve.npk` declares a function's into the scope it
    // opens, but the type checker walks a body holding the MODULE scope; a
    // struct's are declared into no scope at all, and a struct's field types are
    // resolved on demand from wherever the access happened to be written. The
    // window travels with the declaration, so the answer does not depend on which
    // scope a caller passed.
    ParamBind:gb = relay generic_lookup(r, name);
    if (gb.found) { pass (gb.type_id); }

    // AN ASSOCIATED TYPE IS A MEMBER OF ITS TRAIT, NOT A NAME IN A SCOPE
    // (D-160). Inside `trait:Iterator`, `Item` means "whatever the implementor
    // binds" — so it is asked of the enclosing trait, before the scope, for the
    // same reason a generic parameter is: the nearer binding wins, and a
    // module-level `Item` is not what the trait body meant.
    if (r.self_trait != 0i32) {
        int32:at = relay assoc_of_trait(r, r.self_trait, name);
        if (at != 0i32) { pass at; }
    }

    int32:sym = raw scope_lookup(r.tab, scope, name);
    if (sym == 0i32) {
        string:text = relay intern_get(r.interns, name);
        string:m1 = relay string_concat("there is no type named `", text);
        string:m2 = relay string_concat(m1, "`");
        pass (relay ty_error(r, raw TYPE_UNKNOWN(), m2, n.span));
    }

    Symbol:s = raw symtab_get(r.tab, sym);
    DeclId:d = DeclId{ index: s.origin };
    DeclNode:dnode = relay ast_decl(r.ast, d);

    if (dnode.kind == DeclKind.DeclStructDecl) {
        // The layout is computed in 0.4.2 once every field's type is known; the
        // identity is the declaration and is available now (D-090).
        pass (relay resolve_aggregate(r, n, name, d, dnode, scope, raw TY_STRUCT()));
    }
    if (dnode.kind == DeclKind.DeclEnumDecl) {
        pass (relay resolve_aggregate(r, n, name, d, dnode, scope, raw TY_ENUM()));
    }
    // A TRAIT MAY BE GENERIC TOO, and it was the same hole one declaration kind
    // over: `p_parse_trait` calls `p_parse_generics`, so `trait:Printable<T>`
    // parses, and this built a `tt_trait` from the declaration and dropped the
    // arguments — making `Printable<int32>` and `Printable<string>` one trait.
    if (dnode.kind == DeclKind.DeclTraitDecl) {
        pass (relay resolve_aggregate(r, n, name, d, dnode, scope, raw TY_TRAIT()));
    }
    if (dnode.kind == DeclKind.DeclGenericParam) {
        pass (raw tt_param(r.types, d.index, name));
    }

    // A NAME THAT IS NOT A TYPE SAYS WHAT IT IS. "unknown type `helper`" would
    // send the reader hunting for a missing declaration that is right there;
    // "`helper` is a function, not a type" ends the search immediately.
    string:text = relay intern_get(r.interns, name);
    string:k1 = relay string_concat("`", text);
    string:k2 = relay string_concat(k1, "` is ");
    string:k3 = relay string_concat(k2, raw decl_kind_article(dnode));
    string:k4 = relay string_concat(k3, ", not a type");
    pass (relay ty_error(r, raw TYPE_NOT_A_TYPE(), k4, n.span));
};

// --- instantiation (TRAITS_REFERENCE 3.3, D-064) --------------------------------------
//
// `Container<int32>` AND `Container<string>` ARE DIFFERENT TYPES, and until this
// existed they were the same one: the arguments were parsed, stored, and never
// read, so every instantiation of a generic struct resolved to the bare
// declaration. A field of type `T` then had nothing to substitute and `c.value`
// answered "there is no type named `T`".
//
// ARITY IS ANSWERED HERE and bound satisfaction is not, and the split is not
// arbitrary: counting needs nothing but the annotation, while "does `int32`
// implement `Printable`" needs an impl table that is still being filled when this
// runs. So this counts, records, and moves on; `type_generic.npk` decides.
func:resolve_aggregate = int32(TypeResolver->:r, TypeNode:n, int32:name,
                               DeclId:d, DeclNode:dnode, int32:scope, int32:kind) {
    IdSpan:gp = raw decl_generic_window(r.ast, dnode);
    int32:given = raw type_args_count(n);

    if (given != gp.count) {
        pass (relay arity_error(r, n, name, gp.count, given));
    }

    // NOT GENERIC: the identity is the declaration (D-090), and there is nothing
    // to substitute or to record.
    if (gp.count == 0i32) {
        if (kind == (raw TY_STRUCT())) {
            pass (raw tt_struct(r.types, d.index, name, 0i64, 1i32));
        }
        if (kind == (raw TY_TRAIT())) {
            pass (raw tt_trait(r.types, d.index, name));
        }
        pass (raw tt_enum(r.types, d.index, name, 0i64, 1i32));
    }

    // DEPTH IS CAPPED AT 64 (D-064 §6). What it bounds at this rung is the
    // resolver's own recursion through nested type arguments — `Handle<Node<…>>`
    // — since a body is checked once at its definition and nothing here expands
    // an instantiation into more of them. Phase B's monomorphizer inherits the
    // same constant for the expansion case, which is why it is one number rather
    // than two that could drift apart.
    //
    // EXCEEDING IT IS AN ERROR THAT SAYS SO, never a silent truncation: a type
    // quietly resolved to its 64th level would be a different type from the one
    // written, and nothing downstream would know.
    if (r.depth >= (raw GENERIC_DEPTH())) {
        // THE STACK, NOT JUST THE NUMBER (D-064 §6, 1.0.2). At 64 frames the
        // runaway nesting is never the one at the top, so the chain that got
        // here is printed — `A -> B -> A` is the shape that says "this recurses".
        string:chain = relay depth_chain(r, name);
        pass (relay ty_error(r, raw TYPE_GENERIC_DEPTH(),
            relay string_concat(
                "generic instantiation is nested more than 64 deep, which is the cap (D-064); the expansion is refused rather than truncated, because a type resolved to a different depth than the one written is a different type. The instantiation stack: ",
                chain),
            n.span));
    }

    if (r.depth < (raw GENERIC_DEPTH())) {
        r.inst_chain[r.depth => int64] = name;
    }
    r.depth = r.depth + 1i32;
    int32:mark = raw ast_scratch_mark(r.ast);
    int32:i = 0i32;
    while (i < given) {
        TypeId:a = TypeId{ index: relay ast_id_at(r.ast, raw type_args_start(n), i) };
        DeclId:gpid = DeclId{ index: relay ast_id_at(r.ast, gp.start, i) };
        drop ast_scratch_push(r.ast, relay resolve_one_arg(r, a, gpid, scope));
        i = i + 1i32;
    }
    IdSpan:w = raw ast_scratch_commit(r.ast, mark);
    r.depth = r.depth - 1i32;

    int32:mangled = relay intern_add(r.interns,
                        relay mangle_instance(r, name, w));
    int32:t = raw tt_instance(r.types, r.ast, kind, d.index, mangled,
                              w.start, w.count, 0i64, 1i32);
    drop inst_record(r.instances, t, n.span);
    pass t;
};

// `Outer -> Middle -> Inner -> …` — the names on the instantiation stack, in the
// order they were entered, with the one that overflowed last.
func:depth_chain = string(TypeResolver->:r, int32:name) {
    string:out = "";
    int32:i = 0i32;
    while (i < r.depth) {
        if (i > 0i32) { out = relay string_concat(out, " -> "); }
        out = relay string_concat(out,
                  relay intern_get(r.interns, r.inst_chain[i => int64]));
        i = i + 1i32;
    }
    if (r.depth > 0i32) { out = relay string_concat(out, " -> "); }
    pass (relay string_concat(out, relay intern_get(r.interns, name)));
};

func:GENERIC_DEPTH = int32() { pass 64i32; };

// ONE ARGUMENT, AGAINST THE PARAMETER IT FILLS. Which of the two kinds it must be
// is decided by the PARAMETER, not by what was written -- the parser cannot tell
// `Mutex<Config, LEVEL>`'s second argument apart from a type on its own, and the
// declaration is the thing that knows (D-064 §2).
//
// SUPPLYING THE WRONG KIND SAYS WHICH KIND WAS WANTED. "there is no type named
// `2`" would be true and useless; the mistake is that the position takes a value.
// --- constant folding -------------------------------------------------------------
//
// THE FIVE DEBTS, PAID. Four sites in this compiler refused anything but a literal
// and said so by name, each pointing here: an array size `int32[N]`, a `comptime`
// generic argument `Mutex<Config, 2>`, an `acquires N` level, and a `const` global's
// initialiser. Every one of them was written to refuse rather than silently take a
// wrong value, because 0.2.8 found that exact path reading an intern-table slot as
// an array length.
//
// IT LIVES HERE, IN `resolve_type`, AND THAT IS NOT ARBITRARY. Folding needs to
// resolve types — `#size_of<T>` is a constant whose value is a type's size — and
// resolving a type needs to fold — `int32[N]` is a type whose shape is a constant.
// The two are mutually recursive, so they are one module. Split into two, each
// would have to `use` the other, and the frontend has no forward declaration to
// break that with.
//
// FOLDING IS WHERE A COMPILER RUNS THE PROGRAM IT IS COMPILING, so it is bounded
// for the same reason expansion is (D-057): a `comptime` expression that does not
// terminate hangs the build, which is the same failure arriving through the other
// door.

pub func:CV_NONE = int32()   { pass 0i32; };   // did not fold
pub func:CV_INT = int32()    { pass 1i32; };
pub func:CV_BOOL = int32()   { pass 2i32; };
pub func:CV_CHAR = int32()   { pass 3i32; };
pub func:CV_STRING = int32() { pass 4i32; };

// WHETHER IT FOLDED AND WHAT IT IS ARE TWO QUESTIONS, and `kind` answers both
// without merging them: `CV_NONE` is "no value", and every other kind carries one.
// A single `int64` with a validity flag beside it would be the `{error, is_error}`
// encoding D-069 removed — two fields that can disagree.
//
// THE TYPE COMES WITH THE VALUE. `Mutex<Config, 2>` needs `2` to be an `int32`
// because the parameter says so and D-092 forbids implicit widening, so a site that
// gets a folded value still has to check what type it got. `type_id` is 0 for an
// UNSUFFIXED integer literal, which is not a type error: it means "no width was
// written", and the site decides what that becomes.
pub struct:ConstVal = {
    int32:kind;
    int32:type_id;
    int64:num;       // int, bool and char
    string:text;     // string
};

pub func:cv_none = ConstVal() {
    ConstVal:v = ConstVal{ kind: raw CV_NONE(), type_id: 0i32, num: 0i64, text: "" };
    pass v;
};
pub func:cv_int = ConstVal(int32:ty, int64:n) {
    ConstVal:v = ConstVal{ kind: raw CV_INT(), type_id: ty, num: n, text: "" };
    pass v;
};
pub func:cv_bool = ConstVal(int32:ty, bool:b) {
    int64:n = 0i64;
    if (b) { n = 1i64; }
    ConstVal:v = ConstVal{ kind: raw CV_BOOL(), type_id: ty, num: n, text: "" };
    pass v;
};
pub func:cv_char = ConstVal(int32:ty, int64:n) {
    ConstVal:v = ConstVal{ kind: raw CV_CHAR(), type_id: ty, num: n, text: "" };
    pass v;
};
pub func:cv_str = ConstVal(int32:ty, string:t) {
    ConstVal:v = ConstVal{ kind: raw CV_STRING(), type_id: ty, num: 0i64, text: t };
    pass v;
};

pub func:cv_folded = bool(ConstVal:v) { pass (v.kind != (raw CV_NONE())); };
pub func:cv_is_int = bool(ConstVal:v) { pass (v.kind == (raw CV_INT())); };

// How far evaluation will follow. One number, because there is one thing being
// bounded: the total work of folding one expression, including every constant it
// reads through and every `comptime func:` it calls.
pub func:FOLD_FUEL = int32() { pass 4096i32; };

// The same 64 `GENERIC_DEPTH` uses, for the same reason: a nesting a person wrote
// on purpose is nowhere near it, and one that is not stops before the machine does.
pub func:FOLD_DEPTH = int32() { pass 64i32; };

// THE LOCALS OF A `comptime func:` BEING EVALUATED. A comptime function is an
// interpreter's stack frame and nothing more: parameters bound on entry, locals
// added as they are declared, assignment rebinding in place.
//
// IT LIVES ON THE RESOLVER, saved and restored around a call, for the same reason
// `generics` does — it is constant across one evaluation and a nested call needs a
// frame of its own, so threading it through every folding function would be one
// more parameter that eight functions have to pass correctly.
pub struct:FoldEnv = {
    wild int32->:names;
    wild ConstVal->:vals;
    int32:count;
    int32:cap;
};

pub func:foldenv_none = FoldEnv() {
    FoldEnv:e = FoldEnv{ names: NULL, vals: NULL, count: 0i32, cap: 0i32 };
    pass e;
};

func:foldenv_new = FoldEnv() {
    int64:n = 16i64;
    wild int8->:a = alloc(n * #size_of<int32>());
    wild int8->:b = alloc(n * #size_of<ConstVal>());
    FoldEnv:e = FoldEnv{ names: a =>! wild int32->, vals: b =>! wild ConstVal->,
                         count: 0i32, cap: 16i32 };
    pass e;
};

// LAST BINDING WINS, and it is a REBIND rather than a shadow: a comptime function
// has one frame, `x = x + 1i32` writes the `x` that is there, and there is no
// nested scope in a body this evaluator accepts. Searching backwards would be the
// same answer more slowly.
func:foldenv_set = NIL(FoldEnv->:e, int32:name, ConstVal:v) {
    int32:i = 0i32;
    while (i < e.count) {
        if (e.names[i => int64] == name) {
            e.vals[i => int64] = v;
            pass NIL;
        }
        i = i + 1i32;
    }
    if (e.count >= e.cap) {
        int32:nc = e.cap * 2i32;
        if (nc < 16i32) { nc = 16i32; }
        wild int8->:a = ralloc(e.names =>! wild int8->,
                               (nc => int64) * #size_of<int32>());
        wild int8->:b = ralloc(e.vals =>! wild int8->,
                               (nc => int64) * #size_of<ConstVal>());
        e.names = a =>! wild int32->;
        e.vals = b =>! wild ConstVal->;
        e.cap = nc;
    }
    e.names[e.count => int64] = name;
    e.vals[e.count => int64] = v;
    e.count = e.count + 1i32;
    pass NIL;
};

func:foldenv_get = ConstVal(FoldEnv->:e, int32:name) {
    int32:i = 0i32;
    while (i < e.count) {
        if (e.names[i => int64] == name) { pass (e.vals[i => int64]); }
        i = i + 1i32;
    }
    pass (raw cv_none());
};

// WHETHER A STATEMENT RETURNED, AND WITH WHAT, AND WHETHER IT GAVE UP. Three
// questions and three fields: `pass 1i32;` returned a value, a `while` that ran out
// of fuel gave up, and an `if` whose branch did neither did neither. Merging
// "returned nothing" with "could not evaluate" would make a comptime function that
// falls off its end look like one the evaluator does not understand.
pub struct:FoldFlow = {
    bool:returned;
    bool:failed;
    ConstVal:value;
};

func:flow_none = FoldFlow() {
    FoldFlow:f = FoldFlow{ returned: false, failed: false, value: raw cv_none() };
    pass f;
};
func:flow_fail = FoldFlow() {
    FoldFlow:f = FoldFlow{ returned: false, failed: true, value: raw cv_none() };
    pass f;
};
func:flow_ret = FoldFlow(ConstVal:v) {
    FoldFlow:f = FoldFlow{ returned: true, failed: false, value: v };
    pass f;
};

pub func:fold_const = ConstVal(TypeResolver->:r, ExprId:id, int32:scope) {
    r.fold_blown = false;
    r.fold_depth = 0i32;
    pass (relay fold_expr(r, id, scope, raw FOLD_FUEL()));
};

// THE BUDGET IS ITS OWN DIAGNOSTIC, not "this is not a constant". A `comptime func:`
// that does not terminate IS a constant expression as far as the reader is
// concerned — it just never finishes — and telling them it is not constant sends
// them to change the wrong thing.
//
// FOLDING IS WHERE A COMPILER RUNS THE PROGRAM IT IS COMPILING, so the bound is not
// optional: without it the build hangs, which is the failure D-057 bounds expansion
// for, arriving through the other door.
// DID THE FOLD ALREADY SAY WHAT WENT WRONG? Asked by every site that folds, so that
// one failure produces ONE sentence — the same reason the expansion audit does not
// run over an expansion that already reported (D-126).
//
// It covers every specific thing the evaluator can report: the budget, the depth
// bound, a division by zero, a loop that never advances. Each of those is a
// narrower and more useful sentence than "this is not a constant expression", and
// printing the general one after the specific one sends the reader nowhere.
pub func:fold_gave_up = bool(TypeResolver->:r) { pass r.fold_blown; };

// THE FOLD REPORTED SOMETHING, AND IT SAYS SO ONCE. Without the guard a failure
// deep in a nested evaluation reports at every frame it unwinds through, which
// buries the one sentence that matters under copies of itself.
func:fold_reported = NIL(TypeResolver->:r, string:code, string:msg, Span:sp) {
    if (r.fold_blown) { pass NIL; }
    r.fold_blown = true;
    drop diaglist_push(r.diags, raw diag_error(code, msg, sp));
    pass NIL;
};

func:fold_exhausted = NIL(TypeResolver->:r, Span:sp) {
    drop fold_reported(r, raw TYPE_COMPTIME_BUDGET(),
        "this compile-time evaluation did not finish within its budget; a `comptime func:` that recurses or loops without bound never terminates, and the compiler is the thing running it",
        sp);
    pass NIL;
};

func:fold_expr = ConstVal(TypeResolver->:r, ExprId:id, int32:scope, int32:fuel) {
    if (raw expr_is_none(id)) { pass (raw cv_none()); }
    ExprNode:e = relay ast_expr(r.ast, id);
    if (fuel <= 0i32) {
        drop fold_exhausted(r, e.span);
        pass (raw cv_none());
    }
    int32:f = fuel - 1i32;

    if (e.kind == ExprKind.ExprIntLiteral) {
        // AN UNSUFFIXED LITERAL CARRIES NO TYPE, and says so with 0 rather than
        // guessing `int32`. The site that receives it supplies the context type,
        // which is D-092's rule applied where it belongs.
        NumWidth:w = raw expr_num_width(e);
        int32:ty = 0i32;
        if (raw num_width_is_integer(w)) {
            ty = raw tt_int(r.types, raw num_width_bits(w), raw num_width_signed(w));
        }
        pass (raw cv_int(ty, e.payload));
    }
    if (e.kind == ExprKind.ExprBoolLiteral) {
        pass (raw cv_bool(r.types.t_bool, e.payload != 0i64));
    }
    if (e.kind == ExprKind.ExprCharLiteral) {
        pass (raw cv_char(raw tt_char(r.types, 8i32), e.payload));
    }
    if (e.kind == ExprKind.ExprStringLiteral) {
        pass (raw cv_str(r.types.t_string, relay intern_get(r.interns,
                                                            e.payload =>! int32)));
    }

    // `comptime(expr)` IS A FORCING FORM, not a different evaluator. It says "this
    // has to fold", and what folds inside it is what folds anywhere.
    if (e.kind == ExprKind.ExprComptimeExpr) {
        pass (relay fold_expr(r, raw expr_operand(e), scope, f));
    }

    if (e.kind == ExprKind.ExprUnaryExpr)  { pass (relay fold_unary(r, e, scope, f)); }
    if (e.kind == ExprKind.ExprBinaryExpr) { pass (relay fold_binary(r, e, scope, f)); }

    // A CAST IS A CONVERSION AND KEEPS THE VALUE. `=>` between integer types is the
    // only folding form: a checked cast that would not hold is a question for the
    // cast rules (0.4.4), and this does not answer it.
    if (e.kind == ExprKind.ExprCastExpr) {
        ConstVal:v = relay fold_expr(r, raw expr_operand(e), scope, f);
        if (!(raw cv_is_int(v))) { pass (raw cv_none()); }
        int32:target = relay resolve_type(r, raw expr_cast_type(e), scope);
        if (!(raw type_is_integer(r.types, target))) { pass (raw cv_none()); }
        pass (raw cv_int(target, v.num));
    }

    if (e.kind == ExprKind.ExprBuiltinExpr) {
        pass (relay fold_builtin(r, e, scope, f));
    }

    if (e.kind == ExprKind.ExprIdentifierExpr) {
        pass (relay fold_ident(r, e, scope, f));
    }

    if (e.kind == ExprKind.ExprCallExpr) {
        pass (relay fold_call(r, e, scope, f));
    }

    if (e.kind == ExprKind.ExprIterationVarExpr) {
        if (!(r.fold_counting)) { pass (raw cv_none()); }
        pass (raw cv_int(raw tt_int(r.types, 64i32, true), r.fold_counter));
    }

    // `raw f(x)` AND `relay f(x)` ARE THE CALL WITH ITS ERROR HANDLING SPELLED.
    // A comptime function cannot fail — there is no runtime for it to fail into —
    // so folding through the wrapper is folding the call.
    if (e.kind == ExprKind.ExprRawUnwrapExpr) {
        pass (relay fold_expr(r, raw expr_operand(e), scope, f));
    }

    // EVERYTHING ELSE DOES NOT FOLD, and that is not an error here. `fold_const`
    // answers "is this a constant"; the caller decides whether a non-constant is
    // one, because an array size and a `const` initialiser want different sentences
    // about the same non-answer.
    pass (raw cv_none());
};

func:fold_unary = ConstVal(TypeResolver->:r, ExprNode:e, int32:scope, int32:fuel) {
    ConstVal:v = relay fold_expr(r, raw expr_operand(e), scope, fuel);
    if (!(raw cv_folded(v))) { pass (raw cv_none()); }
    TokenKind:op = raw expr_op(e);

    if (op == TokenKind.OpMinus) {
        if (v.kind != (raw CV_INT())) { pass (raw cv_none()); }
        pass (raw cv_int(v.type_id, 0i64 - v.num));
    }
    if (op == TokenKind.OpTilde) {
        if (v.kind != (raw CV_INT())) { pass (raw cv_none()); }
        pass (raw cv_int(v.type_id, ~v.num));
    }
    if (op == TokenKind.OpBang) {
        if (v.kind != (raw CV_BOOL())) { pass (raw cv_none()); }
        pass (raw cv_bool(v.type_id, v.num == 0i64));
    }
    pass (raw cv_none());
};

// THE TYPE OF A BINARY RESULT IS WHICHEVER SIDE HAD ONE. An unsuffixed literal
// carries no type (0), so `SIZE * 2` takes `SIZE`'s and `2 * 2` takes neither —
// which is what lets the SITE apply its own context rule afterwards rather than
// this inventing one.
func:fold_join_type = int32(int32:a, int32:b) {
    if (a != 0i32) { pass a; }
    pass b;
};

func:fold_binary = ConstVal(TypeResolver->:r, ExprNode:e, int32:scope, int32:fuel) {
    ConstVal:l = relay fold_expr(r, raw expr_lhs(e), scope, fuel);
    if (!(raw cv_folded(l))) { pass (raw cv_none()); }
    ConstVal:rr = relay fold_expr(r, raw expr_rhs(e), scope, fuel);
    if (!(raw cv_folded(rr))) { pass (raw cv_none()); }
    TokenKind:op = raw expr_op(e);

    // BOOLEAN CONNECTIVES FIRST, because they are the only ones whose operands are
    // not integers.
    if (l.kind == (raw CV_BOOL())) {
        if (rr.kind != (raw CV_BOOL())) { pass (raw cv_none()); }
        bool:a = (l.num != 0i64);
        bool:b = (rr.num != 0i64);
        if (op == TokenKind.OpAndAnd) { pass (raw cv_bool(l.type_id, a && b)); }
        if (op == TokenKind.OpOrOr)   { pass (raw cv_bool(l.type_id, a || b)); }
        if (op == TokenKind.OpEqEq)   { pass (raw cv_bool(l.type_id, a == b)); }
        if (op == TokenKind.OpNotEq)  { pass (raw cv_bool(l.type_id, a != b)); }
        pass (raw cv_none());
    }

    // EQUALITY ON STRINGS AND CHARS FOLDS; ARITHMETIC ON THEM DOES NOT. A `char` is
    // not an integer and permits no arithmetic (D-036), and that rule does not
    // relax because the compiler is the one evaluating it.
    if (l.kind == (raw CV_STRING())) {
        if (rr.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        if (op == TokenKind.OpEqEq) {
            pass (raw cv_bool(r.types.t_bool, raw string_eq(l.text, rr.text)));
        }
        if (op == TokenKind.OpNotEq) {
            pass (raw cv_bool(r.types.t_bool, !(raw string_eq(l.text, rr.text))));
        }
        pass (raw cv_none());
    }
    if (l.kind == (raw CV_CHAR())) {
        if (rr.kind != (raw CV_CHAR())) { pass (raw cv_none()); }
        if (op == TokenKind.OpEqEq)  { pass (raw cv_bool(r.types.t_bool, l.num == rr.num)); }
        if (op == TokenKind.OpNotEq) { pass (raw cv_bool(r.types.t_bool, l.num != rr.num)); }
        pass (raw cv_none());
    }

    if (l.kind != (raw CV_INT()))  { pass (raw cv_none()); }
    if (rr.kind != (raw CV_INT())) { pass (raw cv_none()); }
    int32:ty = raw fold_join_type(l.type_id, rr.type_id);

    if (op == TokenKind.OpPlus)  { pass (raw cv_int(ty, l.num + rr.num)); }
    if (op == TokenKind.OpMinus) { pass (raw cv_int(ty, l.num - rr.num)); }
    if (op == TokenKind.OpStar)  { pass (raw cv_int(ty, l.num * rr.num)); }

    // DIVISION BY ZERO DOES NOT FOLD TO ANYTHING. Returning zero would be the
    // silent wrong value this whole mechanism exists to avoid, and the site's own
    // "must be constant" refusal is a worse sentence than the one it deserves — so
    // it is reported here, where what happened is known.
    if (op == TokenKind.OpSlash) {
        if (rr.num == 0i64) {
            drop fold_reported(r, raw TYPE_NOT_CONSTANT(),
                "this constant expression divides by zero", e.span);
            pass (raw cv_none());
        }
        pass (raw cv_int(ty, l.num / rr.num));
    }
    if (op == TokenKind.OpPercent) {
        if (rr.num == 0i64) {
            drop fold_reported(r, raw TYPE_NOT_CONSTANT(),
                "this constant expression takes a remainder by zero", e.span);
            pass (raw cv_none());
        }
        pass (raw cv_int(ty, l.num % rr.num));
    }

    if (op == TokenKind.OpAmp)   { pass (raw cv_int(ty, l.num & rr.num)); }
    if (op == TokenKind.OpPipe)  { pass (raw cv_int(ty, l.num | rr.num)); }
    if (op == TokenKind.OpCaret) { pass (raw cv_int(ty, l.num ^ rr.num)); }

    // A SHIFT BY A SILLY DISTANCE IS UNDEFINED IN THE MACHINE AND SO IT IS HERE.
    // Folding it to whatever this host happens to produce would make the compiler's
    // answer depend on the compiler's own build, which is the one thing a
    // constant must never do.
    if (op == TokenKind.OpShl) {
        if (rr.num < 0i64) { pass (raw cv_none()); }
        if (rr.num >= 64i64) { pass (raw cv_none()); }
        pass (raw cv_int(ty, l.num << rr.num));
    }
    if (op == TokenKind.OpShr) {
        if (rr.num < 0i64) { pass (raw cv_none()); }
        if (rr.num >= 64i64) { pass (raw cv_none()); }
        pass (raw cv_int(ty, l.num >> rr.num));
    }

    if (op == TokenKind.OpEqEq)   { pass (raw cv_bool(r.types.t_bool, l.num == rr.num)); }
    if (op == TokenKind.OpNotEq)  { pass (raw cv_bool(r.types.t_bool, l.num != rr.num)); }
    if (op == TokenKind.OpLt)     { pass (raw cv_bool(r.types.t_bool, l.num < rr.num)); }
    if (op == TokenKind.OpLtEq)   { pass (raw cv_bool(r.types.t_bool, l.num <= rr.num)); }
    if (op == TokenKind.OpGt)     { pass (raw cv_bool(r.types.t_bool, l.num > rr.num)); }
    if (op == TokenKind.OpGtEq)   { pass (raw cv_bool(r.types.t_bool, l.num >= rr.num)); }
    pass (raw cv_none());
};

// `#size_of<T>` IS A CONSTANT WHOSE VALUE IS A TYPE'S SIZE, which is the whole
// reason folding and type resolution are one module: this line resolves a type in
// the middle of folding, and `int32[N]` folds in the middle of resolving one.
func:fold_builtin = ConstVal(TypeResolver->:r, ExprNode:e, int32:scope,
                             int32:_~fuel) {
    string:name = relay intern_get(r.interns, raw builtin_name(e));
    if (!(raw string_eq(name, "size_of"))) { pass (raw cv_none()); }
    if ((raw builtin_generic_count(e)) != 1i32) { pass (raw cv_none()); }

    TypeId:arg = TypeId{ index: raw ast_id_at(r.ast, raw expr_list_start(e), 0i32) };
    int32:t = relay resolve_type(r, arg, scope);
    if (t == 0i32) { pass (raw cv_none()); }

    // NO `ensure_layout` CALL HERE, and that is a layering fact rather than an
    // oversight: `type_layout.npk` uses this module, so this module cannot use it.
    // Resolving the type is what computes its layout — `resolve_aggregate` does it
    // on the way — so by the time there is a type id there is a size.
    pass (raw cv_int(raw tt_int(r.types, 64i32, true), raw type_size(r.types, t)));
};

// A CALL TO A `comptime func:`, EVALUATED.
//
// `comptime` on a declaration is the marker that says a function may run at compile
// time (D-064's shape: the marker says which of two things a thing is). Nothing is
// inferred — a function that happens to be foldable is not one, because whether the
// compiler runs your code is not a thing to discover by accident.
//
// THIS IS WHERE A COMPILER RUNS THE PROGRAM IT IS COMPILING, which is why the fuel
// is not decoration. A `comptime func:` that recurses without bound would hang the
// build, and a hung build is the same failure D-057 bounds expansion for, arriving
// through the other door.
func:fold_call = ConstVal(TypeResolver->:r, ExprNode:e, int32:scope, int32:fuel) {
    if (fuel <= 0i32) { pass (raw cv_none()); }
    ExprNode:callee = relay ast_expr(r.ast, raw expr_callee(e));
    if (callee.kind != ExprKind.ExprIdentifierExpr) { pass (raw cv_none()); }

    // A BARE-NAME BUILTIN RESOLVES TO NO SYMBOL, so it is answered before the
    // lookup rather than after it fails.
    string:cname = relay intern_get(r.interns, (raw expr_name(callee)) =>! int32);
    if (raw is_builtin_name(cname)) {
        pass (relay fold_string_builtin(r, e, cname, scope, fuel - 1i32));
    }

    int32:symid = callee.a;
    if (symid == 0i32) {
        symid = raw scope_lookup(r.tab, scope, (raw expr_name(callee)) =>! int32);
    }
    if (symid == 0i32) { pass (raw cv_none()); }
    Symbol:sym = relay symtab_get(r.tab, symid);
    if (sym.origin_kind != (raw SYM_DECL())) { pass (raw cv_none()); }

    DeclNode:fndecl = relay ast_decl(r.ast, DeclId{ index: sym.origin });
    if (fndecl.kind != DeclKind.DeclFunctionDecl) { pass (raw cv_none()); }
    if (!(raw decl_has(fndecl, raw DECL_COMPTIME()))) { pass (raw cv_none()); }

    int32:pc = raw fn_param_count(r.ast, fndecl);
    int32:gc = raw expr_generic_count(e);
    int32:ac = (raw expr_list_count(e)) - gc;
    if (ac != pc) { pass (raw cv_none()); }

    // THE ARGUMENTS ARE FOLDED IN THE CALLER'S FRAME, and the new frame is built
    // only once they all have values. Building it first and folding into it would
    // let an argument see a parameter it is being passed to.
    FoldEnv:frame = raw foldenv_new();
    int32:i = 0i32;
    while (i < pc) {
        ExprId:arg = ExprId{ index: raw ast_id_at(r.ast, (raw expr_list_start(e)) + gc, i) };
        ConstVal:av = relay fold_expr(r, arg, scope, fuel - 1i32);
        if (!(raw cv_folded(av))) { pass (raw cv_none()); }
        DeclNode:pn = relay ast_decl(r.ast, raw fn_param(r.ast, fndecl, i));
        drop foldenv_set(@frame, raw decl_name(pn), av);
        i = i + 1i32;
    }

    if (r.fold_depth >= (raw FOLD_DEPTH())) {
        drop fold_exhausted(r, e.span);
        pass (raw cv_none());
    }

    FoldEnv:saved = r.env;
    int32:saved_depth = r.fold_depth;
    r.env = frame;
    r.fold_depth = saved_depth + 1i32;
    FoldFlow:flow = relay fold_stmt(r, raw fn_body(r.ast, fndecl), sym.scope, fuel - 1i32);
    r.env = saved;
    r.fold_depth = saved_depth;

    if (flow.failed) { pass (raw cv_none()); }
    if (!(flow.returned)) { pass (raw cv_none()); }
    pass (flow.value);
};

// THE STATEMENTS A `comptime func:` BODY MAY CONTAIN, and no others.
//
// `MACRO_REFERENCE.md` section 8 recovered the list from the corpus: locals,
// assignment, loops, calls, and `pass`. A kind not named here FAILS the fold rather
// than being skipped — a body with a statement the evaluator cannot run has not
// been evaluated, and quietly returning what the earlier statements happened to
// leave behind is the silent wrong value this whole mechanism exists to avoid.
func:fold_stmt = FoldFlow(TypeResolver->:r, StmtId:id, int32:scope, int32:fuel) {
    if (raw stmt_is_none(id)) { pass (raw flow_none()); }
    StmtNode:st = relay ast_stmt(r.ast, id);
    if (fuel <= 0i32) {
        drop fold_exhausted(r, st.span);
        pass (raw flow_fail());
    }
    int32:f = fuel - 1i32;

    if (st.kind == StmtKind.StmtBlockStmt) {
        int32:n = raw stmt_list_count(st);
        int32:i = 0i32;
        while (i < n) {
            StmtId:s2 = StmtId{ index: raw ast_id_at(r.ast, raw stmt_list_start(st), i) };
            FoldFlow:fl = relay fold_stmt(r, s2, scope, f);
            if (fl.failed) { pass fl; }
            if (fl.returned) { pass fl; }
            i = i + 1i32;
        }
        pass (raw flow_none());
    }

    if (st.kind == StmtKind.StmtVarDeclStmt) {
        ConstVal:v = relay fold_expr(r, relay stmt_decl_init(r.ast, st), scope, f);
        if (!(raw cv_folded(v))) { pass (raw flow_fail()); }
        drop foldenv_set(@r.env, raw stmt_name(st), v);
        pass (raw flow_none());
    }

    if (st.kind == StmtKind.StmtAssignStmt) {
        // ONLY A BARE NAME IS ASSIGNABLE HERE. A comptime frame holds values, not
        // storage, so `p.x = 1i32` and `a[i] = 1i32` have nowhere to land — and
        // pretending otherwise would evaluate the right-hand side and drop it.
        ExprNode:target = relay ast_expr(r.ast, raw stmt_target(st));
        if (target.kind != ExprKind.ExprIdentifierExpr) { pass (raw flow_fail()); }
        ConstVal:v = relay fold_expr(r, raw stmt_assigned(st), scope, f);
        if (!(raw cv_folded(v))) { pass (raw flow_fail()); }
        drop foldenv_set(@r.env, (raw expr_name(target)) =>! int32, v);
        pass (raw flow_none());
    }

    if (st.kind == StmtKind.StmtIfStmt) {
        ConstVal:c = relay fold_expr(r, raw stmt_cond(st), scope, f);
        if (c.kind != (raw CV_BOOL())) { pass (raw flow_fail()); }
        if (c.num != 0i64) { pass (relay fold_stmt(r, raw stmt_then(st), scope, f)); }
        pass (relay fold_stmt(r, raw stmt_else(st), scope, f));
    }

    if (st.kind == StmtKind.StmtPassStmt) {
        ConstVal:v = relay fold_expr(r, ExprId{ index: st.a }, scope, f);
        if (!(raw cv_folded(v))) { pass (raw flow_fail()); }
        pass (raw flow_ret(v));
    }

    if (st.kind == StmtKind.StmtWhileStmt) {
        pass (relay fold_while(r, st, scope, f));
    }

    // `loop(lo, hi, step)` AND `till(...)` — the language's counted forms, and the
    // ones the corpus actually uses inside a `comptime func:` (`COMPTIME-001`).
    // `while` was implemented first and is the easier shape; a comptime function
    // that could not use the language's primary loop would be a hole in the feature
    // rather than a smaller version of it.
    if (st.kind == StmtKind.StmtLoopStmt) { pass (relay fold_counted(r, st, scope, f)); }
    if (st.kind == StmtKind.StmtTillStmt) { pass (relay fold_counted(r, st, scope, f)); }

    if (st.kind == StmtKind.StmtDiscardStmt) {
        // Evaluated for nothing, which is what `discard` means. It still has to
        // FOLD: a discard of something the evaluator cannot run is a body it has
        // not run.
        ConstVal:v = relay fold_expr(r, ExprId{ index: st.a }, scope, f);
        if (!(raw cv_folded(v))) { pass (raw flow_fail()); }
        pass (raw flow_none());
    }

    pass (raw flow_fail());
};

// A LOOP, WITH THE FUEL AS ITS BOUND. The fuel is shared with everything else the
// fold is doing, so a loop cannot spend a budget that the expression around it has
// already used — which is the property that makes one number enough.
func:fold_while = FoldFlow(TypeResolver->:r, StmtNode:st, int32:scope, int32:fuel) {
    int32:left = fuel;
    while (left > 0i32) {
        ConstVal:c = relay fold_expr(r, raw stmt_cond(st), scope, left);
        if (c.kind != (raw CV_BOOL())) { pass (raw flow_fail()); }
        if (c.num == 0i64) { pass (raw flow_none()); }
        FoldFlow:fl = relay fold_stmt(r, relay stmt_body(r.ast, st), scope, left);
        if (fl.failed) { pass fl; }
        if (fl.returned) { pass fl; }
        left = left - 1i32;
    }
    drop fold_exhausted(r, st.span);
    pass (raw flow_fail());
};

// A COUNTED LOOP. `loop(hi)`, `loop(lo, hi)` and `loop(lo, hi, step)` are the three
// arities, and `$` is the counter — which is why it has a node kind of its own
// rather than a name: nobody declared it.
//
// THE BOUNDS ARE FOLDED ONCE, BEFORE THE FIRST ITERATION, because they are the
// loop's arguments and not part of its body. A bound that mentions a local the body
// then assigns would otherwise mean something different on every pass, which is not
// what the form says.
func:fold_counted = FoldFlow(TypeResolver->:r, StmtNode:st, int32:scope, int32:fuel) {
    int32:argc = raw stmt_counted_argc(r.ast, st);
    if (argc < 1i32) { pass (raw flow_fail()); }
    if (argc > 3i32) { pass (raw flow_fail()); }

    int64:lo = 0i64;
    int64:hi = 0i64;
    int64:step = 1i64;

    ConstVal:a0 = relay fold_expr(r, relay stmt_counted_arg(r.ast, st, 0i32), scope, fuel);
    if (!(raw cv_is_int(a0))) { pass (raw flow_fail()); }
    if (argc == 1i32) { hi = a0.num; }
    else {
        lo = a0.num;
        ConstVal:a1 = relay fold_expr(r, relay stmt_counted_arg(r.ast, st, 1i32), scope, fuel);
        if (!(raw cv_is_int(a1))) { pass (raw flow_fail()); }
        hi = a1.num;
        if (argc == 3i32) {
            ConstVal:a2 = relay fold_expr(r, relay stmt_counted_arg(r.ast, st, 2i32), scope, fuel);
            if (!(raw cv_is_int(a2))) { pass (raw flow_fail()); }
            step = a2.num;
        }
    }

    // A ZERO STEP NEVER ARRIVES. Refused rather than run to the fuel bound, because
    // the fuel's sentence is "this did not finish" and the sentence this deserves is
    // narrower than that.
    if (step == 0i64) {
        drop fold_reported(r, raw TYPE_NOT_CONSTANT(),
            "this compile-time loop has a step of zero, so its counter never reaches its bound",
            st.span);
        pass (raw flow_fail());
    }

    bool:saved_counting = r.fold_counting;
    int64:saved_counter = r.fold_counter;
    r.fold_counting = true;

    int32:left = fuel;
    int64:i = lo;
    while (left > 0i32) {
        bool:more = (i < hi);
        if (step < 0i64) { more = (i > hi); }
        if (!more) {
            r.fold_counting = saved_counting;
            r.fold_counter = saved_counter;
            pass (raw flow_none());
        }
        r.fold_counter = i;
        FoldFlow:fl = relay fold_stmt(r, raw stmt_counted_body(st), scope, left);
        if (fl.failed) {
            r.fold_counting = saved_counting;
            r.fold_counter = saved_counter;
            pass fl;
        }
        if (fl.returned) {
            r.fold_counting = saved_counting;
            r.fold_counter = saved_counter;
            pass fl;
        }
        i = i + step;
        left = left - 1i32;
    }
    r.fold_counting = saved_counting;
    r.fold_counter = saved_counter;
    drop fold_exhausted(r, st.span);
    pass (raw flow_fail());
};

// THE STRING BUILTINS A CONSTANT EXPRESSION MAY CONTAIN (`COMPTIME-005`).
//
// A bare-name builtin is declared in no module (AST_REFERENCE 3.3), so it resolves
// to no symbol — which is why it cannot go through `fold_call`, whose whole first
// half is finding the declaration. These four have compile-time answers; every
// other builtin allocates, opens a file or talks to the kernel, and none of those
// is a thing the compiler does on the program's behalf while compiling it.
func:fold_string_builtin = ConstVal(TypeResolver->:r, ExprNode:e, string:name,
                                    int32:scope, int32:fuel) {
    int32:gc = raw expr_generic_count(e);
    int32:start = (raw expr_list_start(e)) + gc;
    int32:argc = (raw expr_list_count(e)) - gc;

    if (raw string_eq(name, "string_concat")) {
        if (argc != 2i32) { pass (raw cv_none()); }
        ConstVal:a = relay fold_expr(r, ExprId{ index: raw ast_id_at(r.ast, start, 0i32) }, scope, fuel);
        ConstVal:b = relay fold_expr(r, ExprId{ index: raw ast_id_at(r.ast, start, 1i32) }, scope, fuel);
        if (a.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        if (b.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        pass (raw cv_str(r.types.t_string, relay string_concat(a.text, b.text)));
    }
    if (raw string_eq(name, "string_equals")) {
        if (argc != 2i32) { pass (raw cv_none()); }
        ConstVal:a = relay fold_expr(r, ExprId{ index: raw ast_id_at(r.ast, start, 0i32) }, scope, fuel);
        ConstVal:b = relay fold_expr(r, ExprId{ index: raw ast_id_at(r.ast, start, 1i32) }, scope, fuel);
        if (a.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        if (b.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        pass (raw cv_bool(r.types.t_bool, raw string_eq(a.text, b.text)));
    }
    if (raw string_eq(name, "string_byte_length")) {
        if (argc != 1i32) { pass (raw cv_none()); }
        ConstVal:a = relay fold_expr(r, ExprId{ index: raw ast_id_at(r.ast, start, 0i32) }, scope, fuel);
        if (a.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        pass (raw cv_int(raw tt_int(r.types, 64i32, true), a.text.len));
    }
    if (raw string_eq(name, "string_is_empty")) {
        if (argc != 1i32) { pass (raw cv_none()); }
        ConstVal:a = relay fold_expr(r, ExprId{ index: raw ast_id_at(r.ast, start, 0i32) }, scope, fuel);
        if (a.kind != (raw CV_STRING())) { pass (raw cv_none()); }
        pass (raw cv_bool(r.types.t_bool, a.text.len == 0i64));
    }
    pass (raw cv_none());
};

// A NAME FOLDS WHEN IT IS A `const` GLOBAL, and only then. `const` is the marker
// that says a binding has one value for the whole program (D-010), so it is the
// marker that says a name may stand in a constant expression — nothing has to be
// inferred, and a `fixed` binding, which is assigned once at RUN time, is correctly
// not one.
func:fold_ident = ConstVal(TypeResolver->:r, ExprNode:e, int32:scope, int32:fuel) {
    // A LOCAL OF THE `comptime func:` BEING EVALUATED SHADOWS EVERYTHING, because
    // it is the innermost thing in scope and because a parameter named after a
    // `const` global is a program somebody may well write.
    if (r.env.count > 0i32) {
        ConstVal:local = raw foldenv_get(@r.env, (raw expr_name(e)) =>! int32);
        if (raw cv_folded(local)) { pass local; }
    }

    // A NAME IN A TYPE POSITION WAS NEVER BOUND BY THE RESOLVER, and that is by
    // design: `resolve.npk` does not enter type nodes, because a type is more than
    // a name and answering that is this module's job (0.3.5's header says so). So
    // `int32[SIZE]` reaches here with no binding recorded, and looking it up is not
    // a second computation of a fact somebody else already has — it is the first.
    //
    // A `const` initialiser arrives the other way round, already bound, because an
    // initialiser is an ordinary expression in a declaration. Both are handled, and
    // the recorded binding wins where there is one.
    int32:symid = e.a;
    if (symid == 0i32) {
        symid = raw scope_lookup(r.tab, scope, (raw expr_name(e)) =>! int32);
    }
    if (symid == 0i32) { pass (raw cv_none()); }
    Symbol:sym = relay symtab_get(r.tab, symid);
    if (sym.origin_kind != (raw SYM_DECL())) { pass (raw cv_none()); }

    DeclNode:d = relay ast_decl(r.ast, DeclId{ index: sym.origin });
    if (d.kind != DeclKind.DeclGlobalDecl) { pass (raw cv_none()); }
    if (((raw global_quals(d)) & (raw QUAL_CONST())) == 0i32) { pass (raw cv_none()); }

    // THE INITIALISER IS FOLDED IN THE SCOPE IT WAS WRITTEN IN, not the one the
    // reference stands in. A `const` in another module means what it meant there.
    // The fuel is what stops `const A = B; const B = A;` — a cycle the resolver
    // already refuses (D-086), so this only has to terminate rather than diagnose.
    pass (relay fold_expr(r, raw global_init(d), sym.scope, fuel));
};

pub func:resolve_one_arg = int32(TypeResolver->:r, TypeId:a, DeclId:gpid, int32:scope) {
    DeclNode:gpn = relay ast_decl(r.ast, gpid);
    TypeNode:anode = relay ast_type(r.ast, a);
    bool:wants_value = raw generic_is_value(gpn);
    bool:is_value = (anode.kind == TypeKind.TypeComptimeArg);

    if (wants_value) {
        if (!is_value) {
            pass (relay arg_kind_error(r, gpn, anode.span, true));
        }
        pass (relay resolve_value_arg(r, anode, gpn, scope));
    }
    if (is_value) {
        pass (relay arg_kind_error(r, gpn, anode.span, false));
    }
    pass (relay resolve_type(r, a, scope));
};

func:arg_kind_error = int32(TypeResolver->:r, DeclNode:gpn, Span:at,
                            bool:wants_value) {
    string:m1 = relay string_concat("`", relay intern_get(r.interns, raw decl_name(gpn)));
    if (wants_value) {
        pass (relay ty_error(r, raw TYPE_GENERIC_KIND(),
            relay string_concat(m1,
                "` is declared `comptime`, so this position supplies a compile-time value, not a type"),
            at));
    }
    pass (relay ty_error(r, raw TYPE_GENERIC_KIND(),
        relay string_concat(m1,
            "` is a type parameter, so this position supplies a type; a value belongs to a parameter declared `comptime`"),
        at));
};

// `Mutex<Config, 2>` — THE VALUE, CHECKED AGAINST THE TYPE THE PARAMETER DECLARES.
//
// FOLDED SINCE 0.6.4, so `Mutex<Config, LEVEL>` and `Mutex<Config, BASE * 2>` are
// arguments like any other. What did NOT change is the check underneath: the debt
// paid was "must be a literal", never "must be valid", and a folded value still has
// to be an integer of the declared type.
func:resolve_value_arg = int32(TypeResolver->:r, TypeNode:anode, DeclNode:gpn,
                               int32:scope) {
    int32:want = relay resolve_type(r, raw generic_value_type(gpn), scope);
    ExprNode:v = relay ast_expr(r.ast, raw type_comptime_value(anode));

    ConstVal:cv = relay fold_const(r, raw type_comptime_value(anode), scope);
    if (!(raw cv_is_int(cv))) {
        if (raw fold_gave_up(r)) { pass 0i32; }
        pass (relay ty_error(r, raw TYPE_NOT_CONSTANT(),
            "a `comptime` argument must be a constant expression; a name folds only if it is a `const` global",
            v.span));
    }

    // AN UNSUFFIXED LITERAL TAKES THE PARAMETER'S TYPE, which is D-092's context
    // rule applied to the one context a generic argument has. A SUFFIXED one must
    // already be that type: `Mutex<Config, 2i64>` against `comptime int32:LEVEL`
    // is a mismatch somebody wrote, not a width to be adjusted.
    //
    // A FOLDED VALUE CARRIES ITS TYPE, and `0` means the expression never wrote one
    // — so `Mutex<Config, 2>` and `Mutex<Config, SIZE * 2>` take the parameter's
    // type while `Mutex<Config, 2i64>` is checked against it. The debt paid here was
    // "must be a literal", never "must be valid": this check stays.
    if (cv.type_id != 0i32) {
        int32:got = cv.type_id;
        if (got != want) {
            string:m1 = relay string_concat("this `comptime` argument is `",
                            relay type_display(r.types, r.interns, got));
            string:m2 = relay string_concat(m1, "` and `");
            string:m3 = relay string_concat(m2,
                            relay intern_get(r.interns, raw decl_name(gpn)));
            string:m4 = relay string_concat(m3, "` is declared `");
            string:m5 = relay string_concat(m4,
                            relay type_display(r.types, r.interns, want));
            pass (relay ty_error(r, raw TYPE_MISMATCH(),
                relay string_concat(m5, "`"), v.span));
        }
    }

    // THE FOLDED VALUE, NOT THE LITERAL'S PAYLOAD. `Mutex<Config, SIZE>` and
    // `Mutex<Config, 2>` must intern to the same instance when `SIZE` is 2, which
    // is what makes them the same type — reading the node's payload here would make
    // them different types that behave identically, which is the shape D-090's
    // interning exists to prevent.
    pass (raw tt_comptime(r.types, want,
                          relay intern_add(r.interns, raw int_to_string(cv.num))));
};

// `Container<int32>` — THE SOURCE SPELLING, which is the most reversible mangling
// there is. A nested instance renders through its own stored name, so
// `Handle<Container<int32>>` comes out whole and costs one lookup rather than a
// re-walk.
//
// This doubles as the DISPLAY name, because `type_display` prints a named type's
// name — so every diagnostic about an instantiation says which one without
// anything extra being written.
pub func:mangle_instance = string(TypeResolver->:r, int32:name, IdSpan:w) {
    string:m = relay string_concat(relay intern_get(r.interns, name), "<");
    int32:i = 0i32;
    while (i < w.count) {
        if (i > 0i32) { m = relay string_concat(m, ", "); }
        m = relay string_concat(m,
                relay type_display(r.types, r.interns,
                                   relay ast_id_at(r.ast, w.start, i)));
        i = i + 1i32;
    }
    pass (relay string_concat(m, ">"));
};

// BOTH COUNTS ARE NAMED, and the direction is named too. "wrong number of type
// arguments" makes the reader go and count the parameters, which is the one thing
// the compiler already did — and a generic type written with none is the common
// case, so the message says plainly that the type is generic.
func:arity_error = int32(TypeResolver->:r, TypeNode:n, int32:name,
                         int32:want, int32:given) {
    string:m1 = relay string_concat("`", relay intern_get(r.interns, name));
    if (want == 0i32) {
        pass (relay ty_error(r, raw TYPE_GENERIC_ARITY(),
            relay string_concat(m1, "` is not generic, so it takes no type arguments"),
            n.span));
    }
    string:m2 = relay string_concat(m1, "` takes ");
    string:m3 = relay string_concat(m2, raw int_to_string(want => int64));
    string:m4 = relay string_concat(m3, " type argument(s) and this supplies ");
    string:m5 = relay string_concat(m4, raw int_to_string(given => int64));
    if (given == 0i32) {
        m5 = relay string_concat(m5,
            "; a generic type is written with its arguments — `Container<int32>`, never bare `Container`");
    }
    pass (relay ty_error(r, raw TYPE_GENERIC_ARITY(), m5, n.span));
};

pub func:decl_kind_article = string(DeclNode:d) {
    if (d.kind == DeclKind.DeclFunctionDecl) { pass "a function"; }
    if (d.kind == DeclKind.DeclGlobalDecl)   { pass "a global"; }
    if (d.kind == DeclKind.DeclModuleDecl)   { pass "a module"; }
    if (d.kind == DeclKind.DeclParamDecl)    { pass "a parameter"; }
    if (d.kind == DeclKind.DeclFieldDecl)    { pass "a field"; }
    if (d.kind == DeclKind.DeclEnumVariant)  { pass "an enum variant"; }
    if (d.kind == DeclKind.DeclMacroDecl)    { pass "a macro"; }
    if (d.kind == DeclKind.DeclRuleDecl)     { pass "a `Rules` block"; }
    if (d.kind == DeclKind.DeclExternFn)     { pass "an extern function"; }
    if (d.kind == DeclKind.DeclOpaqueDecl)   { pass "an opaque type"; }
    pass "not a type";
};

// `Result<T>` and `Optional<T>` — one argument each, and the argument is a type.
func:resolve_generic_builtin = int32(TypeResolver->:r, TypeNode:n,
                                     TokenKind:as_kind, int32:scope) {
    int32:kind = raw builtin_generic_kind(as_kind);
    if (kind == 0i32) {
        // A REAL constructor whose kind no rung supplies yet. Naming the rung
        // beats "there is no type named", which would send the reader looking
        // for a declaration that was never theirs to write (D-085).
        if (as_kind == TokenKind.KwAtomic) {
            pass (relay ty_error(r, raw TYPE_UNKNOWN(),
                "`atomic<T>` lands with 1.1's concurrency work",
                n.span));
        }
        pass (relay ty_error(r, raw TYPE_UNKNOWN(),
            "this builtin type constructor is not available at this rung yet",
            n.span));
    }

    int32:count = raw type_args_count(n);
    if (count != 1i32) {
        pass (relay ty_error(r, raw TYPE_UNKNOWN(),
            "this type takes exactly one type argument", n.span));
    }
    TypeId:arg = TypeId{ index: raw ast_id_at(r.ast, raw type_args_start(n), 0i32) };
    int32:inner = relay resolve_type(r, arg, scope);

    if (kind == (raw TY_OPTIONAL())) {
        pass (relay make_optional(r, inner, n.span));
    }
    if (kind == (raw TY_ARENA())) {
        // The slab is 16-aligned heap memory, so an element demanding more
        // has nowhere to stand (D-152).
        if ((raw type_align(r.types, inner)) > 16i32) {
            pass (relay ty_error(r, raw TYPE_UNKNOWN(),
                "an arena element's alignment is capped at 16, the slab's own",
                n.span));
        }
        pass (raw tt_arena(r.types, inner));
    }
    if (kind == (raw TY_HANDLE())) {
        pass (raw tt_handle(r.types, inner));
    }
    if (kind == (raw TY_SHARED_ARENA())) {
        if ((raw type_align(r.types, inner)) > 16i32) {
            pass (relay ty_error(r, raw TYPE_UNKNOWN(),
                "a shared arena element's alignment is capped at 16, the slab's own",
                n.span));
        }
        pass (raw tt_shared_arena(r.types, inner));
    }
    pass (raw tt_result(r.types, inner,
                        raw type_size(r.types, inner),
                        raw type_align(r.types, inner)));
};

// `T?` AND `Optional<T>` ARE ONE TYPE AND SO ARE ITS RULES. Two spellings reach
// here — the postfix `?` and the generic form — and a check written at only one
// of them would be a rule you could step around by changing how you wrote the
// annotation, which is precisely the context-dependence to avoid.
//
// TWO INNER TYPES ARE REFUSED, and both for the same reason: they name a type
// with a state nobody can write down.
//
//   `NIL?`  — `NIL` is the zero-sized unit value (D-084) and also the empty
//             `Optional` (D-099), so `NIL?:x = NIL;` is genuinely ambiguous:
//             empty, or holding the one value `NIL` has? Both readings are
//             defensible, which is what makes the spelling wrong rather than
//             merely unusual.
//
//   `T??`   — the inner absence is unreachable. `x = NIL` sets the OUTER tag and
//             nothing sets the inner one, so `Optional<Optional<T>>` has a state
//             that exists in the layout and not in the language. `?.` flattens
//             for the same reason, which is what leaves this the only way in.
func:make_optional = int32(TypeResolver->:r, int32:inner, Span:at) {
    if (inner == 0i32) { pass 0i32; }
    if (raw type_is_invalid(r.types, inner)) { pass 0i32; }

    if (inner == r.types.t_nil) {
        pass (relay ty_error(r, raw TYPE_UNKNOWN(),
            "`NIL` is already the empty value, so an `Optional` of it has two ways to be empty and no way to tell them apart; a function that returns nothing useful returns `NIL` on its own",
            at));
    }
    if ((raw type_kind(r.types, inner)) == (raw TY_OPTIONAL())) {
        pass (relay ty_error(r, raw TYPE_UNKNOWN(),
            "an `Optional` of an `Optional` has an inner absence nothing can set — `NIL` sets the outer one; the single wrapper already says the value may not be there",
            at));
    }
    pass (raw tt_optional(r.types, inner,
                          raw type_size(r.types, inner),
                          raw type_align(r.types, inner)));
};

func:builtin_to_type = int32(TypeResolver->:r, BuiltinTypeSpec:spec, TypeNode:n) {
    if (spec.kind == (raw TY_INT()))    { pass (raw tt_int(r.types, spec.bits, spec.signed)); }
    if (spec.kind == (raw TY_CHAR()))   { pass (raw tt_char(r.types, spec.bits)); }
    if (spec.kind == (raw TY_FLOAT()))  { pass (raw tt_float(r.types, spec.bits)); }
    if (spec.kind == (raw TY_TBB()))    { pass (raw tt_tbb(r.types, spec.bits)); }
    if (spec.kind == (raw TY_KERNEL())) { pass (raw tt_kernel(r.types, spec.which)); }
    if (spec.kind == (raw TY_BOOL()))   { pass (r.types.t_bool); }
    if (spec.kind == (raw TY_STRING())) { pass (r.types.t_string); }
    if (spec.kind == (raw TY_CSTRING())){ pass (r.types.t_cstring); }
    if (spec.kind == (raw TY_NIL()))    { pass (r.types.t_nil); }
    // A bare `any` reaching here is the same error as the node form.
    if (spec.kind == (raw TY_ANY())) {
        pass (relay ty_error(r, raw TYPE_BARE_ANY(),
            "`any` must be used as a pointer type: `any->`. Bare `any` is not a valid type.",
            n.span));
    }
    pass 0i32;
};

// --- the composites ---------------------------------------------------------------------

// An array size is a CONSTANT EXPRESSION. 0.2.8 made it a real expression rather
// than one token, so `int32[COUNT]` and `int32[N + 1]` both parse — and this is
// where a size that cannot be computed is refused rather than becoming whatever
// number happened to be lying around.
func:resolve_fixed_array = int32(TypeResolver->:r, TypeNode:n, int32:elem,
                                 int32:scope) {
    ExprId:size = raw type_array_size(n);
    ExprNode:se = relay ast_expr(r.ast, size);

    // FOLDED, NOT MATCHED. `int32[SIZE]`, `int32[N * 2]` and `int32[#size_of<T>()]`
    // are all constants, and until 0.6.4 only a bare literal was one.
    ConstVal:cv = relay fold_const(r, size, scope);
    if (!(raw cv_is_int(cv))) {
        if (raw fold_gave_up(r)) { pass 0i32; }
        pass (relay ty_error(r, raw TYPE_NOT_CONSTANT(),
            "an array size must be a constant expression; a name folds only if it is a `const` global",
            se.span));
    }

    int64:count = cv.num;
    if (count < 0i64) {
        pass (relay ty_error(r, raw TYPE_NOT_CONSTANT(),
            "an array size may not be negative", se.span));
    }
    pass (raw tt_array(r.types, elem, count =>! int32,
                       raw type_size(r.types, elem),
                       raw type_align(r.types, elem)));
};

// `func RetType(ParamTypes)` (D-087).
func:resolve_func_type = int32(TypeResolver->:r, TypeNode:n, int32:scope) {
    int32:ret = relay resolve_type(r, raw type_return(n), scope);
    int32:mark = raw ast_scratch_mark(r.ast);
    int32:i = 0i32;
    while (i < (raw type_param_count(n))) {
        int32:pt = relay resolve_type(r, relay type_param_at(r.ast, n, i), scope);
        drop ast_scratch_push(r.ast, pt);
        i = i + 1i32;
    }
    IdSpan:w = raw ast_scratch_commit(r.ast, mark);
    pass (raw tt_func(r.types, ret, w.start, w.count));
};

// `dyn A & B` — a trait object over a set of traits. Object safety is checked in
// 0.4.6, where the trait's methods are known; this is only the type.
func:resolve_dyn = int32(TypeResolver->:r, TypeNode:n, int32:scope) {
    int32:mark = raw ast_scratch_mark(r.ast);
    int32:i = 0i32;
    while (i < (raw type_args_count(n))) {
        TypeId:operand = TypeId{ index: raw ast_id_at(r.ast, raw type_args_start(n), i) };
        int32:t = relay resolve_type(r, operand, scope);
        // EVERY OPERAND OF `dyn` MUST BE A TRAIT. `dyn int32` is not a dynamic
        // anything, and catching it here means 0.4.6 can assume it has traits.
        if (!(raw type_is_invalid(r.types, t))) {
            if ((raw type_kind(r.types, t)) != (raw TY_TRAIT())) {
                drop ty_error(r, raw TYPE_DYN_NOT_TRAIT(),
                    "every operand of `dyn` must be a trait", n.span);
            } else {
                // EACH TRAIT MUST BE OBJECT-SAFE (4.2), and `dyn A & B` checks
                // BOTH — §5.3 requires it of each, and a widening from `dyn A & B`
                // to `dyn A` would otherwise pass through a vtable that could not
                // have been built.
                drop check_object_safe(r, t, n.span);
            }
        }
        drop ast_scratch_push(r.ast, t);
        i = i + 1i32;
    }
    // CANONICAL ORDER BEFORE INTERNING (D-159), so `dyn A & B` and
    // `dyn B & A` are one interned type with one layout.
    drop dyn_sort_bounds(r.ast, r.types, r.interns, mark);
    IdSpan:w = raw ast_scratch_commit(r.ast, mark);
    pass (raw tt_dyn(r.types, r.ast, r.interns, w.start, w.count));
};

// --- object safety (TRAITS_REFERENCE 4.2) ------------------------------------------------

// THREE RULES, AND THE DIAGNOSTIC SAYS WHICH ONE. "Trait is not object safe"
// sends the reader to re-derive the list; "method `new` takes no `self`, so
// `dyn Drawable` cannot dispatch it" does not. The plan for this subcycle called
// that out by name, and it is the only reason these are three checks rather than
// one predicate.
//
// The rules are not arbitrary and each has a mechanical reason:
//
//   1. EVERY METHOD TAKES `self`. A vtable dispatches on a receiver; a method
//      with none has nothing to dispatch on.
//   2. NO METHOD RETURNS `Self`. Behind `dyn` the concrete type is erased, so its
//      size is unknown and there is nowhere to put the result.
//   3. NO METHOD HAS COMPTIME PARAMETERS. Those monomorphize -- one body per
//      argument -- and a vtable slot is one address.
//
// Verified against the prototype (`type_checker_stmts.cpp`, TRAIT-022), which
// implements the same three. TWO DELIBERATE DEPARTURES, both stricter:
//
//   * It accepts a parameter named `self` ANYWHERE in the list. Here it must be
//     FIRST, because UFCS binds the receiver to parameter zero (0.4.5) -- a
//     `self` in position two would be dispatched with the receiver in position
//     zero, which is a mismatch rather than a style.
//   * It refuses comptime TYPE parameters and says nothing about value ones.
//     Both are refused here: `<comptime int32:LEVEL>` monomorphizes exactly as a
//     type parameter does, so it cannot sit in a vtable either, and the message
//     names which kind it found.
// `Item` on this trait, as a `TY_ASSOC`, or 0. Supertraits are NOT searched: a
// trait's own declaration list is its guarantee (the same rule D-158 gives `dyn`
// dispatch), and an assoc reached through a supertrait would be a member of a
// different trait wearing this one's name.
func:assoc_of_trait = int32(TypeResolver->:r, int32:trait_decl, int32:name) {
    DeclNode:td = relay ast_decl(r.ast, DeclId{ index: trait_decl });
    int32:k = 0i32;
    while (k < (raw item_member_count(r.ast, td))) {
        DeclNode:m = relay ast_decl(r.ast, raw item_member(r.ast, td, k));
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            if ((raw decl_name(m)) == name) {
                // THE BASE IS WHATEVER `Self` MEANS HERE, not the literal
                // `Self` type. Inside the trait's own body that IS `Self`; at a
                // call site the resolver has been told the receiver, so `Item`
                // in the signature means the RECEIVER's `Item`. Hardcoding
                // `tt_self()` made `T.Item` and the `Item` in `next`'s
                // signature two different types, so the function that returned
                // one and called the other did not typecheck.
                int32:abase = r.self_type;
                if (abase == 0i32) { abase = raw tt_self(r.types); }
                pass (raw tt_assoc(r.types, abase, trait_decl, name));
            }
        }
        k = k + 1i32;
    }
    pass 0i32;
};

// Does this trait declare an assoc called `name`?
func:trait_declares_assoc = bool(Ast->:ast, int32:trait_decl, int32:name) {
    DeclNode:td = relay ast_decl(ast, DeclId{ index: trait_decl });
    int32:k = 0i32;
    while (k < (raw item_member_count(ast, td))) {
        DeclNode:m = relay ast_decl(ast, raw item_member(ast, td, k));
        if (m.kind == DeclKind.DeclAssocTypeDecl) {
            if ((raw decl_name(m)) == name) { pass true; }
        }
        k = k + 1i32;
    }
    pass false;
};

// --- the `Self` walk (D-157) -------------------------------------------------
//
// `Self` MAY APPEAR IN EXACTLY ONE PLACE: as the receiver's type. Anywhere else
// — a later parameter, the return, or NESTED anywhere in a type tree
// (`Optional<Self>`, `Self[]`, `Handle<Self>`, `Self->`) — the trait is not
// object-safe, because behind a vtable the concrete type is erased and the
// value would be read at the wrong layout.
//
// NO SIZE-BASED CARVE-OUT. `Handle<Self>` is 16 bytes whatever it holds, so its
// size does survive erasure — and it is refused anyway. One uniform rule is the
// point: an exception here is exactly the context-dependence the blueprint
// philosophy exists to prevent, and it would be one more thing a reviewer has
// to hold.
struct:SelfScan = {
    bool:found;
    bool:exhausted;
    // AN ASSOCIATED TYPE DISQUALIFIES A TRAIT TOO (D-160), for the same erasure
    // reason `Self` does: behind a vtable the projection's layout is unknowable,
    // so `dyn Iterator` cannot be built. Asked by the SAME walk rather than a
    // second one — it is the same tree, and two walks over one tree is two
    // things to keep in step.
    bool:assoc_type;
};

func:scan_clear = SelfScan() {
    SelfScan:s = SelfScan{ found: false, exhausted: false, assoc_type: false };
    pass s;
};

// A type tree deeper than this is a compiler defect, not a program's fault.
func:SELF_SCAN_FUEL = int32() { pass 64i32; };

// EXHAUSTION REFUSES, and says so separately. Returning "no `Self` here" for a
// tree the walk could not finish would be a safety check that fails OPEN on the
// one input it could not read — so `found` is set too, and the caller reports
// the internal defect alongside the refusal rather than instead of it.
func:type_mentions_self = SelfScan(Ast->:ast, int32:trait_decl,
                                   TypeId:id, int32:fuel) {
    if (fuel <= 0i32) {
        SelfScan:x = SelfScan{ found: true, exhausted: true, assoc_type: false };
        pass x;
    }
    if (raw type_is_none(id)) { pass (raw scan_clear()); }

    TypeNode:n = relay ast_type(ast, id);

    if (n.kind == TypeKind.TypeSelfType) {
        SelfScan:f = SelfScan{ found: true, exhausted: false, assoc_type: false };
        pass f;
    }

    // A NAMED TYPE'S ARGUMENTS ARE PART OF IT — `Optional<Self>` and
    // `Handle<Self>` are the two D-157 names, and both arrive here.
    if (n.kind == TypeKind.TypeNamedType) {
        // A BARE NAME MAY BE ONE OF THIS TRAIT'S ASSOCS. It is matched by name
        // rather than by resolving, because object safety is asked about the
        // trait's own declarations where the assoc is in scope by construction —
        // and resolving here would need a scope this walk does not carry.
        if (trait_decl != 0i32) {
            if (relay trait_declares_assoc(ast, trait_decl,
                    (raw type_name_index(n)) =>! int32)) {
                SelfScan:a = SelfScan{ found: false, exhausted: false,
                                       assoc_type: true };
                pass a;
            }
        }
        pass (relay window_mentions_self(ast, trait_decl,
                                         raw type_args_start(n),
                                         raw type_args_count(n), fuel));
    }

    // One child in `a`. An array's `b` is an EXPRESSION, not a type, so it is
    // not walked: `Self[N]` hides its `Self` in the element, never the size.
    if (n.kind == TypeKind.TypePointerType) {
        pass (relay type_mentions_self(ast, trait_decl, raw type_pointee(n), fuel - 1i32));
    }
    if (n.kind == TypeKind.TypeOptionalType) {
        pass (relay type_mentions_self(ast, trait_decl, raw type_inner(n), fuel - 1i32));
    }
    if (n.kind == TypeKind.TypeArrayType) {
        pass (relay type_mentions_self(ast, trait_decl, raw type_element(n), fuel - 1i32));
    }

    // `func Self(Self)` — a function TYPE hides one in either half.
    if (n.kind == TypeKind.TypeFuncType) {
        SelfScan:ps = relay window_mentions_self(ast, trait_decl,
                                                raw type_param_start(n),
                                                raw type_param_count(n), fuel);
        if (ps.found) { pass ps; }
        if (ps.assoc_type) { pass ps; }
        pass (relay type_mentions_self(ast, trait_decl, raw type_return(n), fuel - 1i32));
    }

    // `dyn A & B` — the trait operands share the window slots.
    if (n.kind == TypeKind.TypeDynType) {
        pass (relay window_mentions_self(ast, trait_decl,
                                         raw type_args_start(n),
                                         raw type_args_count(n), fuel));
    }

    // Leaves: `cstring`, `any`, a comptime argument, and the absent type.
    pass (raw scan_clear());
};

func:window_mentions_self = SelfScan(Ast->:ast, int32:trait_decl,
                                     int32:start, int32:count, int32:fuel) {
    int32:i = 0i32;
    while (i < count) {
        TypeId:c = TypeId{ index: relay ast_id_at(ast, start, i) };
        SelfScan:s = relay type_mentions_self(ast, trait_decl, c, fuel - 1i32);
        if (s.found) { pass s; }
        if (s.assoc_type) { pass s; }
        i = i + 1i32;
    }
    pass (raw scan_clear());
};

pub func:check_object_safe = NIL(TypeResolver->:r, int32:trait_id, Span:at) {
    drop object_safety(r, trait_id, at, true);
    pass NIL;
};

// THE SAME RULES, ASKED RATHER THAN REPORTED (1.0.5b). The backend needs to know
// whether a trait has a vtable before it emits one: a trait that is not
// object-safe has methods that cannot be thunked, and building the table anyway
// would turn a legal program — a non-object-safe trait nobody uses as `dyn` —
// into a rung refusal.
//
// ONE COPY OF THE RULES, reached two ways. Two implementations of "is this
// object-safe" would be two things to keep in step, and the one that drifted
// would be the one nothing reports on.
pub func:trait_is_object_safe = bool(TypeResolver->:r, int32:trait_id) {
    pass (!(relay object_safety(r, trait_id, raw span_none(), false)));
};

// True if any rule fired. `report` decides whether the diagnostics are pushed;
// the walk is identical either way.
func:object_safety = bool(TypeResolver->:r, int32:trait_id, Span:at,
                          bool:report) {
    int32:decl = raw type_decl_of(r.types, trait_id);
    if (decl == 0i32) { pass false; }
    DeclId:did = DeclId{ index: decl };
    DeclNode:td = relay ast_decl(r.ast, did);

    bool:bad = false;
    int32:n = raw item_member_count(r.ast, td);
    int32:i = 0i32;
    while (i < n) {
        DeclId:mid = raw item_member(r.ast, td, i);
        DeclNode:m = relay ast_decl(r.ast, mid);
        if (m.kind == DeclKind.DeclFunctionDecl) {
            if (relay object_safe_method(r, trait_id, m, at, report)) {
                bad = true;
            }
        }
        i = i + 1i32;
    }
    pass bad;
};

func:object_safe_method = bool(TypeResolver->:r, int32:trait_id, DeclNode:m,
                               Span:at, bool:report) {
    string:mname = relay intern_get(r.interns, raw decl_name(m));
    bool:bad = false;
    int32:tdecl = raw type_decl_of(r.types, trait_id);

    // Rule 1 — a receiver to dispatch on.
    bool:has_self = false;
    if ((relay fn_param_count(r.ast, m)) > 0i32) {
        DeclId:p0 = raw fn_param(r.ast, m, 0i32);
        DeclNode:pn = relay ast_decl(r.ast, p0);
        has_self = raw string_eq(relay intern_get(r.interns, raw decl_name(pn)), "self");
    }
    if (!has_self) {
        bad = true;
        if (report) {
            drop not_object_safe(r, trait_id, mname,
                "takes no `self`, so there is no receiver to dispatch on", at);
        }
    }

    // Rule 2 — `Self` NOWHERE BUT THE RECEIVER (D-157, extended at 1.0.5).
    // This read the RETURN's top node and nothing else, so
    // `bool(Self:self, Self:other)` passed object safety outright, and behind a
    // vtable the erased second argument would be read at the wrong layout. The
    // walk is now over the FULL type tree of every parameter and the return.
    // WITH NO RECEIVER, "nowhere but the receiver" HAS NO REFERENT, so the
    // parameter scan is skipped when rule 1 already fired. `int32(int32:k,
    // Self:self)` is ONE mistake — `self` in the wrong position — and reporting
    // it twice made the second message misdescribe it outright: "mentions
    // `Self` in parameter `self`, and only the receiver may", of a parameter
    // that IS named `self`. Nothing is lost by staying quiet: rule 1 has already
    // refused the trait, so this only removes a second line, never a refusal.
    // The RETURN is still scanned below, because where `self` sits says nothing
    // about what the method gives back.
    int32:pcount = 0i32;
    if (has_self) { pcount = relay fn_param_count(r.ast, m); }
    int32:pidx = 0i32;
    while (pidx < pcount) {
        DeclNode:pdecl = relay ast_decl(r.ast, raw fn_param(r.ast, m, pidx));
        TypeId:ptype = raw param_type(pdecl);

        // THE RECEIVER MAY *BE* `Self`; IT MAY NOT *CONTAIN* ONE. That is the
        // entire exception — `Optional<Self>:self` nests, so it is refused like
        // any other nesting.
        bool:recv_is_self = false;
        if (pidx == 0i32) {
            TypeNode:rt0 = relay ast_type(r.ast, ptype);
            recv_is_self = (rt0.kind == TypeKind.TypeSelfType);
        }

        if (!recv_is_self) {
            SelfScan:sc = relay type_mentions_self(r.ast, tdecl, ptype,
                                                   raw SELF_SCAN_FUEL());
            if (sc.found) {
                bad = true;
                if (report) {
                    string:sw1 = relay string_concat("mentions `Self` in parameter `",
                                     relay intern_get(r.interns, raw decl_name(pdecl)));
                    drop not_object_safe(r, trait_id, mname,
                        relay string_concat(sw1,
                            "`, and only the receiver may — behind a vtable the concrete type is erased, so the value would be read at the wrong layout"),
                        at);
                }
            }
            if (sc.assoc_type) {
                bad = true;
                if (report) {
                    drop not_object_safe(r, trait_id, mname,
                        "mentions an associated type, whose layout is unknowable once the concrete type is erased — the same reason `Self` outside the receiver disqualifies a trait (D-160)",
                        at);
                }
            }
            if (sc.exhausted) {
                bad = true;
                if (report) { drop self_scan_defect(r, mname, at); }
            }
        }
        pidx = pidx + 1i32;
    }

    SelfScan:rsc = relay type_mentions_self(r.ast, tdecl,
                                            raw fn_return(r.ast, m),
                                            raw SELF_SCAN_FUEL());
    if (rsc.found) {
        bad = true;
        if (report) {
            drop not_object_safe(r, trait_id, mname,
                "mentions `Self` in its return type, whose size is unknown once the concrete type is erased", at);
        }
    }
    if (rsc.assoc_type) {
        bad = true;
        if (report) {
            drop not_object_safe(r, trait_id, mname,
                "returns an associated type, whose layout is unknowable once the concrete type is erased — the same reason `Self` in a return does (D-160)",
                at);
        }
    }
    if (rsc.exhausted) {
        bad = true;
        if (report) { drop self_scan_defect(r, mname, at); }
    }

    // Rule 3 — nothing that monomorphizes.
    int32:g = relay fn_generic_count(r.ast, m);
    if (g > 0i32) {
        bad = true;
        if (report) {
            DeclId:g0 = raw fn_generic(r.ast, m, 0i32);
            DeclNode:gn = relay ast_decl(r.ast, g0);
            string:what = "a comptime type parameter";
            if (raw generic_is_value(gn)) { what = "a comptime value parameter"; }
            string:w1 = relay string_concat("has ", what);
            drop not_object_safe(r, trait_id, mname,
                relay string_concat(w1,
                    ", which monomorphizes into one body per argument, and a vtable slot is one address"),
                at);
        }
    }
    pass bad;
};

// A TYPE TREE THAT RAN THE WALK OUT OF FUEL IS A COMPILER DEFECT, and is
// reported as one. The trait is refused as well (the walk sets `found` on
// exhaustion), because a safety check that fails OPEN on the one input it could
// not read is worse than one that refuses something legal.
func:self_scan_defect = NIL(TypeResolver->:r, string:mname, Span:at) {
    string:d1 = relay string_concat(
        "object safety ran out of fuel walking the types of method `", mname);
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_INTERNAL(),
        relay string_concat(d1,
            "`; the trait is refused to stay safe, but this is a defect in the compiler rather than a fault in this program"),
        at));
    pass NIL;
};

func:not_object_safe = NIL(TypeResolver->:r, int32:trait_id, string:mname,
                           string:why, Span:at) {
    string:m1 = relay string_concat("`",
                    relay type_display(r.types, r.interns, trait_id));
    string:m2 = relay string_concat(m1, "` cannot be used as `dyn`: method `");
    string:m3 = relay string_concat(m2, mname);
    string:m4 = relay string_concat(m3, "` ");
    drop diaglist_push(r.diags, raw diag_error(raw TYPE_NOT_OBJECT_SAFE(),
        relay string_concat(m4, why), at));
    pass NIL;
};
