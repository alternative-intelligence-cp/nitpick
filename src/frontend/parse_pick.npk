// `pick` -- arms, patterns, destructuring, guards, and explicit fallthrough.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.2.6.
//
// `pick` is BOTH a statement and an expression, and its arms decide which
// (D-059): arms that `give` form an expression, arms that do not form a
// statement. Both positions parse the same arms, so this module is reached from
// the statement parser and the expression parser alike -- a `use` cycle, which
// D-086 settles as legal precisely because cases like this one are properties of
// the language rather than of where the code was put.
//
// PATTERNS ARE NOT EXPRESSIONS. They look alike -- `(Net.Disconnect(reason))`
// reads exactly like a call -- but a pattern MATCHES where an expression
// COMPUTES, and no pattern ever calls anything. So in pattern position a `(`
// after a path is destructuring and a `{` is a struct match, with no ambiguity to
// resolve and no speculative parse. That is not a construct changing meaning by
// context: patterns and expressions are different syntactic categories, and a
// category is allowed its own grammar.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token_name.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./parse_codes.npk".*;
use "./parser.npk".*;
use "./parse_type.npk".*;
use "./parse_expr.npk".*;
use "./parse_stmt.npk".*;

// --- accessors ------------------------------------------------------------------
//
//   PickStmt / PickExpr   a = selector, b,c = arm window
//   PickArm               a = pattern, b = guard, c = body, payload = label
//
// The statement and expression forms carry IDENTICAL layouts, so these read both
// (AST_REFERENCE section 3.6). Only the kind differs, and it differs only because
// the two terminate differently: a statement-`pick` ends at its brace, while an
// expression-`pick` ends wherever its enclosing statement does.

pub func:pick_selector = ExprId(StmtNode:s) { ExprId:e = ExprId{ index: s.a }; pass e; };
pub func:pick_arm_start = int32(StmtNode:s) { pass s.b; };
pub func:pick_arm_count = int32(StmtNode:s) { pass s.c; };

pub func:pickx_selector = ExprId(ExprNode:e) { ExprId:i = ExprId{ index: e.a }; pass i; };
pub func:pickx_arm_start = int32(ExprNode:e) { pass e.b; };
pub func:pickx_arm_count = int32(ExprNode:e) { pass e.c; };

pub func:pick_arm_at = StmtId(Ast->:ast, int32:start, int32:i) {
    StmtId:s = StmtId{ index: raw ast_id_at(ast, start, i) };
    pass s;
};

pub func:arm_pattern = PatId(StmtNode:s) { PatId:p = PatId{ index: s.a }; pass p; };
pub func:arm_guard = ExprId(StmtNode:s)  { ExprId:e = ExprId{ index: s.b }; pass e; };
pub func:arm_body = StmtId(StmtNode:s)   { StmtId:b = StmtId{ index: s.c }; pass b; };
pub func:arm_label = int32(StmtNode:s)   { pass (s.payload =>! int32); };

pub func:pat_value = ExprId(PatNode:p)   { ExprId:e = ExprId{ index: p.a }; pass e; };
pub func:pat_range_lo = ExprId(PatNode:p){ ExprId:e = ExprId{ index: p.a }; pass e; };
pub func:pat_range_hi = ExprId(PatNode:p){ ExprId:e = ExprId{ index: p.b }; pass e; };
// `..` is INCLUSIVE and `...` is EXCLUSIVE (OP_REFERENCE section 6) -- the
// reverse of the languages that spell them the other way round, which is exactly
// why this is recorded on the node instead of being re-derived by whoever reads
// it next.
pub func:pat_range_inclusive = bool(PatNode:p) { pass (p.c != 0i32); };
pub func:pat_struct_type = TypeId(PatNode:p) { TypeId:t = TypeId{ index: p.a }; pass t; };

// A struct pattern's bindings are a plain window of intern indices.
pub func:pat_bind_start = int32(PatNode:p) { pass p.b; };
pub func:pat_bind_count = int32(PatNode:p) { pass p.c; };

// An enum pattern's path may have several segments (`Net.Disconnect`), so it
// carries a header: [0] segment count, [1] binding count, then the segments, then
// the bindings.
func:ENUM_PAT_HDR = int32() { pass 2i32; };

pub func:pat_enum_segment_count = int32(Ast->:ast, PatNode:p) {
    pass (raw ast_id_at(ast, p.b, 0i32));
};
pub func:pat_enum_bind_count = int32(Ast->:ast, PatNode:p) {
    pass (raw ast_id_at(ast, p.b, 1i32));
};
pub func:pat_enum_segment = int32(Ast->:ast, PatNode:p, int32:i) {
    pass (raw ast_id_at(ast, p.b, (raw ENUM_PAT_HDR()) + i));
};
pub func:pat_enum_bind = int32(Ast->:ast, PatNode:p, int32:i) {
    int32:base = (raw ENUM_PAT_HDR()) + (raw pat_enum_segment_count(ast, p));
    pass (raw ast_id_at(ast, p.b, base + i));
};

// --- patterns ---------------------------------------------------------------------

// The contents of one `( … )`.
func:p_parse_pattern = PatId(Parser->:p) {
    Span:sp = relay p_span(p);

    // `(*)` -- the catch-all. It may NOT absorb an `ERR` selector; that is a
    // semantic rule (D-008 section 5.1), enforced where exhaustiveness is, and
    // deliberately not here -- the parser has no idea what the selector's type
    // is, and a rule enforced in the wrong phase is a rule that reports the
    // wrong thing.
    if (relay p_accept(p, TokenKind.OpStar)) {
        pass (relay ast_add_pat(p.ast, PatKind.PatWildcard, sp,
                                0i32, 0i32, 0i32, 0i64));
    }

    // `(!)` is REMOVED (D-061). Reporting it by name matters more than usual:
    // anyone writing it learned it from an older document, and the reason it went
    // is not obvious from the spelling. It let an arm be elided from
    // exhaustiveness, and the arm most likely to be elided is the `ERR:` one that
    // D-008 requires -- asserting a `tbb` cannot be tainted, which is the least
    // safe assumption the type admits.
    if (relay p_at(p, TokenKind.OpBang)) {
        if ((relay p_peek_at(p, 1i64)).kind == TokenKind.PRParen) {
            drop p_advance(p);
            drop p_error(p, raw PARSE_UNREACHABLE_MARKER(),
                "`(!)` is removed; write the arm normally with `#unreachable()` as its body, which traps");
            pass (raw pat_none());
        }
    }

    // A name, possibly dotted, possibly followed by a destructuring form.
    if (relay p_at(p, TokenKind.Ident)) {
        TokenKind:after = (relay p_peek_at(p, 1i64)).kind;
        bool:destructures = false;
        if (after == TokenKind.PLParen) { destructures = true; }
        if (after == TokenKind.PLBrace) { destructures = true; }
        if (after == TokenKind.PDot)    { destructures = true; }
        if (destructures) {
            pass (relay p_parse_destructure(p, sp));
        }
    }

    // Two mistakes get named rather than left to the expression parser, which
    // could only say "expected an expression" -- true, unhelpful, and pointing
    // at a construct the reader thought was a pattern.
    if (relay p_at(p, TokenKind.PRParen)) {
        drop p_error(p, raw PARSE_BAD_PATTERN(),
            "a pattern may not be empty; the catch-all is `(*)`");
        pass (raw pat_none());
    }
    if (raw token_kind_is_builtin_type(relay p_kind(p))) {
        drop p_error(p, raw PARSE_BAD_PATTERN(),
            "a pattern matches a value, and this is a type; to match on a type use a destructuring pattern");
        drop p_advance(p);
        pass (raw pat_none());
    }

    // Anything else is a VALUE, and a range is a value expression the expression
    // parser already builds -- `(500..599)` is one `RangeExpr`. Splitting it back
    // out here rather than storing the expression whole keeps `lo`, `hi` and
    // `inclusive` on the pattern where AST_REFERENCE section 2.1 puts them, so an
    // exhaustiveness check reads bounds from the pattern and never has to know
    // which expression node shape hides them.
    ExprId:e = relay p_parse_expr(p);
    ExprNode:en = relay ast_expr(p.ast, e);
    if (en.kind == ExprKind.ExprRangeExpr) {
        int32:inc = 0i32;
        if (en.payload != 0i64) { inc = 1i32; }
        pass (relay ast_add_pat(p.ast, PatKind.PatRange, sp,
                                en.a, en.b, inc, 0i64));
    }
    pass (relay ast_add_pat(p.ast, PatKind.PatValue, sp,
                            e.index, 0i32, 0i32, 0i64));
};

// `Struct { a, b }` or `Enum.Variant(binding)`.
func:p_parse_destructure = PatId(Parser->:p, Span:sp) {
    int32:mark = raw ast_scratch_mark(p.ast);
    drop ast_scratch_push(p.ast, 0i32);   // [0] segment count
    drop ast_scratch_push(p.ast, 0i32);   // [1] binding count

    Token:first = relay p_advance(p);
    drop ast_scratch_push(p.ast, first.payload =>! int32);
    int32:segments = 1i32;
    while (relay p_at(p, TokenKind.PDot)) {
        if ((relay p_peek_at(p, 1i64)).kind != TokenKind.Ident) { break; }
        drop p_advance(p);
        Token:sn = relay p_advance(p);
        drop ast_scratch_push(p.ast, sn.payload =>! int32);
        segments = segments + 1i32;
    }

    if (relay p_at(p, TokenKind.PLBrace)) {
        // `MouseClick { x, y }` -- a struct. Its NAME is a type, so it is stored
        // as one: a struct pattern has to be matched against a type either way,
        // and a segment list would make the checker rebuild what the type parser
        // already knows how to read.
        drop ast_scratch_commit(p.ast, mark);
        TypeId:ty = relay ast_add_type(p.ast, TypeKind.TypeNamedType, sp,
                                       0i32, 0i32, 0i32, first.payload);
        drop p_advance(p);
        int32:bmark = raw ast_scratch_mark(p.ast);
        while (true) {
            if (relay p_at(p, TokenKind.PRBrace)) { break; }
            if (relay p_at_end(p)) { break; }
            Token:b = relay p_advance(p);
            drop ast_scratch_push(p.ast, b.payload =>! int32);
            if (!(relay p_accept(p, TokenKind.PComma))) { break; }
        }
        drop p_expect(p, TokenKind.PRBrace);
        IdSpan:bw = raw ast_scratch_commit(p.ast, bmark);
        pass (relay ast_add_pat(p.ast, PatKind.PatStructDestructure, sp,
                                ty.index, bw.start, bw.count, 0i64));
    }

    int32:binds = 0i32;
    if (relay p_accept(p, TokenKind.PLParen)) {
        while (true) {
            if (relay p_at(p, TokenKind.PRParen)) { break; }
            if (relay p_at_end(p)) { break; }
            Token:b = relay p_advance(p);
            drop ast_scratch_push(p.ast, b.payload =>! int32);
            binds = binds + 1i32;
            if (!(relay p_accept(p, TokenKind.PComma))) { break; }
        }
        drop p_expect(p, TokenKind.PRParen);
    }
    drop ast_scratch_set(p.ast, mark, 0i32, segments);
    drop ast_scratch_set(p.ast, mark, 1i32, binds);
    IdSpan:w = raw ast_scratch_commit(p.ast, mark);
    pass (relay ast_add_pat(p.ast, PatKind.PatEnumDestructure, sp,
                            0i32, w.start, w.count, 0i64));
};

// --- arms ---------------------------------------------------------------------------

func:p_parse_arm = StmtId(Parser->:p) {
    Span:sp = relay p_span(p);
    int64:label = 0i64;

    // `ERR:` -- the tainted-selector arm (D-008 section 5.1). It takes no
    // parentheses, and `ERR` is a KEYWORD rather than an identifier, so it can
    // never be confused with the `label:` that precedes an ordinary arm.
    if (relay p_at(p, TokenKind.KwERR)) {
        if ((relay p_peek_at(p, 1i64)).kind == TokenKind.PColon) {
            drop p_advance(p);
            drop p_advance(p);
            PatId:ep = relay ast_add_pat(p.ast, PatKind.PatErrPattern, sp,
                                         0i32, 0i32, 0i32, 0i64);
            StmtId:eb = relay p_parse_block(p);
            pass (relay ast_add_stmt(p.ast, StmtKind.StmtPickArm, sp,
                                     ep.index, 0i32, eb.index, 0i64));
        }
    }

    // `one: (1i32) { … }` -- a labelled arm, which is what `fall one;` targets.
    // There is NO implicit fallthrough, so a label is only ever written because
    // something falls to it.
    if (relay p_at(p, TokenKind.Ident)) {
        if ((relay p_peek_at(p, 1i64)).kind == TokenKind.PColon) {
            label = (relay p_advance(p)).payload;
            drop p_advance(p);
        }
    }

    drop p_expect(p, TokenKind.PLParen);
    PatId:pat = relay p_parse_pattern(p);
    drop p_expect(p, TokenKind.PRParen);

    // `where (a > b)` -- PARENTHESISED, unlike `requires` / `ensures`. A guard is
    // an expression-site condition like `if` and `while`, and the contracts are
    // declaration-site ones; the line is drawn by position, and it is drawn the
    // same way here (D-002).
    int32:guard = 0i32;
    if (relay p_accept(p, TokenKind.KwWhere)) {
        drop p_expect(p, TokenKind.PLParen);
        guard = (relay p_parse_expr(p)).index;
        drop p_expect(p, TokenKind.PRParen);
    }

    StmtId:body = relay p_parse_block(p);
    pass (relay ast_add_stmt(p.ast, StmtKind.StmtPickArm, sp,
                             pat.index, guard, body.index, label));
};

// `pick (selector)` -- shared by both positions, so the two entry points differ
// only in the node they build.
func:p_parse_pick_selector = ExprId(Parser->:p) {
    drop p_expect(p, TokenKind.KwPick);
    drop p_expect(p, TokenKind.PLParen);
    ExprId:sel = relay p_parse_expr(p);
    drop p_expect(p, TokenKind.PRParen);
    pass sel;
};

// Arms are separated by COMMAS, and a trailing one is accepted -- adding an arm
// should not require editing the line above it.
func:p_parse_arms = IdSpan(Parser->:p) {
    drop p_expect(p, TokenKind.PLBrace);
    int32:mark = raw ast_scratch_mark(p.ast);
    while (true) {
        if (relay p_at(p, TokenKind.PRBrace)) { break; }
        if (relay p_at_end(p)) { break; }
        int64:before = raw p_position(p);
        StmtId:arm = relay p_parse_arm(p);
        drop ast_scratch_push(p.ast, arm.index);
        drop p_recover(p);
        if ((raw p_position(p)) == before) { drop p_sync(p); }
        if (!(relay p_accept(p, TokenKind.PComma))) { break; }
    }
    drop p_expect(p, TokenKind.PRBrace);
    pass (raw ast_scratch_commit(p.ast, mark));
};

// --- the two entry points -----------------------------------------------------------

pub func:p_parse_pick_stmt = StmtId(Parser->:p) {
    Span:sp = relay p_span(p);
    ExprId:sel = relay p_parse_pick_selector(p);
    IdSpan:arms = relay p_parse_arms(p);
    // No trailing `;`: a control-flow block ends at its brace
    // (CONTROL_REFERENCE, the rule at the top).
    pass (relay ast_add_stmt(p.ast, StmtKind.StmtPickStmt, sp,
                             sel.index, arms.start, arms.count, 0i64));
};

pub func:p_parse_pick_expr = ExprId(Parser->:p) {
    Span:sp = relay p_span(p);
    ExprId:sel = relay p_parse_pick_selector(p);
    IdSpan:arms = relay p_parse_arms(p);
    // The enclosing statement supplies the `;`, which is the entire reason this
    // is a second node kind and not the same one used in two places.
    pass (relay ast_add_expr(p.ast, ExprKind.ExprPickExpr, sp,
                             sel.index, arms.start, arms.count, 0i64));
};

// Does an arm list `give`? That is what decides whether a `pick` is an expression
// (D-059), and the checker asks it -- one scan, one answer, rather than every
// consumer re-deriving it.
pub func:pick_arms_give = bool(Ast->:ast, int32:start, int32:count) {
    int32:i = 0i32;
    while (i < count) {
        StmtNode:arm = relay ast_stmt(ast, raw pick_arm_at(ast, start, i));
        StmtNode:body = relay ast_stmt(ast, raw arm_body(arm));
        if (raw block_gives(ast, body)) { pass true; }
        i = i + 1i32;
    }
    pass false;
};

// A `give` anywhere directly in the block, not nested inside another `pick`. A
// nested one belongs to its own `pick`, which is why this does not recurse into
// arm bodies.
func:block_gives = bool(Ast->:ast, StmtNode:b) {
    if (b.kind != StmtKind.StmtBlockStmt) { pass false; }
    int32:i = 0i32;
    int32:n = raw stmt_list_count(b);
    while (i < n) {
        StmtId:sid = StmtId{ index: raw ast_id_at(ast, raw stmt_list_start(b), i) };
        StmtNode:s = relay ast_stmt(ast, sid);
        if (s.kind == StmtKind.StmtGiveStmt) { pass true; }
        if (s.kind == StmtKind.StmtBlockStmt) {
            if (raw block_gives(ast, s)) { pass true; }
        }
        i = i + 1i32;
    }
    pass false;
};
