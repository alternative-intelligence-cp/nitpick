// Numeric literal width suffixes.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.1.3.
//
// GENERATED from meta/specs/LEXICAL_REFERENCE.md section 6.2 (TypeSuffix).
//
// A literal's width is part of its TYPE, not part of its value, which is why a
// token carries it as a separate field rather than folding it into the payload.
// In expression position it is never inferred (SUBSET_1).

pub enum:NumWidth = {
    WNone                = 0i32;   // no suffix written
    WU1                  = 1i32;   // u1
    WU2                  = 2i32;   // u2
    WU4                  = 3i32;   // u4
    WU8                  = 4i32;   // u8
    WU16                 = 5i32;   // u16
    WU32                 = 6i32;   // u32
    WU64                 = 7i32;   // u64
    WU128                = 8i32;   // u128
    WU256                = 9i32;   // u256
    WU512                = 10i32;   // u512
    WU1024               = 11i32;   // u1024
    WU2048               = 12i32;   // u2048
    WU4096               = 13i32;   // u4096
    WI1                  = 14i32;   // i1
    WI2                  = 15i32;   // i2
    WI4                  = 16i32;   // i4
    WI8                  = 17i32;   // i8
    WI16                 = 18i32;   // i16
    WI32                 = 19i32;   // i32
    WI64                 = 20i32;   // i64
    WI128                = 21i32;   // i128
    WI256                = 22i32;   // i256
    WI512                = 23i32;   // i512
    WI1024               = 24i32;   // i1024
    WI2048               = 25i32;   // i2048
    WI4096               = 26i32;   // i4096
    WTbb8                = 27i32;   // tbb8
    WTbb16               = 28i32;   // tbb16
    WTbb32               = 29i32;   // tbb32
    WTbb64               = 30i32;   // tbb64
    WTbb128              = 31i32;   // tbb128
    WTbb256              = 32i32;   // tbb256
    WF32                 = 33i32;   // f32
    WF64                 = 34i32;   // f64
    WF128                = 35i32;   // f128
    WF256                = 36i32;   // f256
    WF512                = 37i32;   // f512
    WTfp32               = 38i32;   // tfp32
    WTfp64               = 39i32;   // tfp64
    WTfp128              = 40i32;   // tfp128
    WTfp256              = 41i32;   // tfp256
    WDim256              = 42i32;   // dim256
    WChar8               = 43i32;   // char8
    WChar16              = 44i32;   // char16
    WChar32              = 45i32;   // char32
};

use "intern.npk".*;

// Longest match matters: "i128" must beat "i1", and "tbb32" must beat "tbb8"
// only where it actually fits. Dispatching on length first makes that automatic.
pub func:num_width_of = NumWidth(string:text) {
    int64:n = text.len;
    if (n == 2i64) {
        if (raw string_eq(text, "i1")) { pass NumWidth.WI1; }
        if (raw string_eq(text, "i2")) { pass NumWidth.WI2; }
        if (raw string_eq(text, "i4")) { pass NumWidth.WI4; }
        if (raw string_eq(text, "i8")) { pass NumWidth.WI8; }
        if (raw string_eq(text, "u1")) { pass NumWidth.WU1; }
        if (raw string_eq(text, "u2")) { pass NumWidth.WU2; }
        if (raw string_eq(text, "u4")) { pass NumWidth.WU4; }
        if (raw string_eq(text, "u8")) { pass NumWidth.WU8; }
    }
    if (n == 3i64) {
        if (raw string_eq(text, "f32")) { pass NumWidth.WF32; }
        if (raw string_eq(text, "f64")) { pass NumWidth.WF64; }
        if (raw string_eq(text, "i16")) { pass NumWidth.WI16; }
        if (raw string_eq(text, "i32")) { pass NumWidth.WI32; }
        if (raw string_eq(text, "i64")) { pass NumWidth.WI64; }
        if (raw string_eq(text, "u16")) { pass NumWidth.WU16; }
        if (raw string_eq(text, "u32")) { pass NumWidth.WU32; }
        if (raw string_eq(text, "u64")) { pass NumWidth.WU64; }
    }
    if (n == 4i64) {
        if (raw string_eq(text, "f128")) { pass NumWidth.WF128; }
        if (raw string_eq(text, "f256")) { pass NumWidth.WF256; }
        if (raw string_eq(text, "f512")) { pass NumWidth.WF512; }
        if (raw string_eq(text, "i128")) { pass NumWidth.WI128; }
        if (raw string_eq(text, "i256")) { pass NumWidth.WI256; }
        if (raw string_eq(text, "i512")) { pass NumWidth.WI512; }
        if (raw string_eq(text, "tbb8")) { pass NumWidth.WTbb8; }
        if (raw string_eq(text, "u128")) { pass NumWidth.WU128; }
        if (raw string_eq(text, "u256")) { pass NumWidth.WU256; }
        if (raw string_eq(text, "u512")) { pass NumWidth.WU512; }
    }
    if (n == 5i64) {
        if (raw string_eq(text, "char8")) { pass NumWidth.WChar8; }
        if (raw string_eq(text, "i1024")) { pass NumWidth.WI1024; }
        if (raw string_eq(text, "i2048")) { pass NumWidth.WI2048; }
        if (raw string_eq(text, "i4096")) { pass NumWidth.WI4096; }
        if (raw string_eq(text, "tbb16")) { pass NumWidth.WTbb16; }
        if (raw string_eq(text, "tbb32")) { pass NumWidth.WTbb32; }
        if (raw string_eq(text, "tbb64")) { pass NumWidth.WTbb64; }
        if (raw string_eq(text, "tfp32")) { pass NumWidth.WTfp32; }
        if (raw string_eq(text, "tfp64")) { pass NumWidth.WTfp64; }
        if (raw string_eq(text, "u1024")) { pass NumWidth.WU1024; }
        if (raw string_eq(text, "u2048")) { pass NumWidth.WU2048; }
        if (raw string_eq(text, "u4096")) { pass NumWidth.WU4096; }
    }
    if (n == 6i64) {
        if (raw string_eq(text, "char16")) { pass NumWidth.WChar16; }
        if (raw string_eq(text, "char32")) { pass NumWidth.WChar32; }
        if (raw string_eq(text, "dim256")) { pass NumWidth.WDim256; }
        if (raw string_eq(text, "tbb128")) { pass NumWidth.WTbb128; }
        if (raw string_eq(text, "tbb256")) { pass NumWidth.WTbb256; }
        if (raw string_eq(text, "tfp128")) { pass NumWidth.WTfp128; }
        if (raw string_eq(text, "tfp256")) { pass NumWidth.WTfp256; }
    }
    pass NumWidth.WNone;
};

pub func:num_width_is_float = bool(NumWidth:w) {
    if (w == NumWidth.WF32) { pass true; }
    if (w == NumWidth.WF64) { pass true; }
    if (w == NumWidth.WF128) { pass true; }
    if (w == NumWidth.WF256) { pass true; }
    if (w == NumWidth.WF512) { pass true; }
    if (w == NumWidth.WTfp32) { pass true; }
    if (w == NumWidth.WTfp64) { pass true; }
    if (w == NumWidth.WTfp128) { pass true; }
    if (w == NumWidth.WTfp256) { pass true; }
    if (w == NumWidth.WDim256) { pass true; }
    pass false;
};
