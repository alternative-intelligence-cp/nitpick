// `i` is signed, `u` is not. A suffix that names neither is not an
// integer suffix and the caller has already checked that.
pub func:num_width_signed = bool(NumWidth:w) never fails {
    if (w == NumWidth.WI1) { pass true; }
    if (w == NumWidth.WI2) { pass true; }
    if (w == NumWidth.WI4) { pass true; }
    if (w == NumWidth.WI8) { pass true; }
    if (w == NumWidth.WI16) { pass true; }
    if (w == NumWidth.WI32) { pass true; }
    if (w == NumWidth.WI64) { pass true; }
    if (w == NumWidth.WI128) { pass true; }
    if (w == NumWidth.WI256) { pass true; }
    if (w == NumWidth.WI512) { pass true; }
    if (w == NumWidth.WI1024) { pass true; }
    if (w == NumWidth.WI2048) { pass true; }
    if (w == NumWidth.WI4096) { pass true; }
    pass false;
};

