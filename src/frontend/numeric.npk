// Numeric literal scanning.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.1.3.
//
// The base is given by a SUFFIX, uniform across every base
// (LEXICAL_REFERENCE.md §6.2): `0FFhex`, `1010bin`, `777oct`, `1T0t`, `2An`.
//
// D-147: EVERY NUMERIC LITERAL BEGINS WITH A DECIMAL DIGIT (0-9), and no
// identifier ever does. A value whose leading significant digit is a letter --
// hex's a-f, ternary's T, nonary's a-d -- takes a value-neutral leading zero:
// `0FFhex`, `0Tt`, `0an`. The literal/identifier split is therefore decided by
// the FIRST character, and `FFhex`, `an`, `ban`, `tt` are ordinary names.
//
// Before D-147 the split was decided from the RIGHT -- scan the whole run,
// strip the type suffix, strip the base suffix, test what remains against the
// base's digits -- which made whole English words into numbers (`ban`, `can`,
// `dan`, `chex`) and cost an edit-build-fail cycle every time a variable name
// was secretly one of them. The suffix machinery below is unchanged; the guard
// at the top of `num_scan` is the rule.
//
// The legacy C-style prefixes (0x/0b/0o) were REMOVED by the same decision:
// two spellings for one literal is what the blueprint philosophy refuses, and
// with the prefix gone `0xFF` is a bad-digit error at the `x`, not a number.

mod:numeric;
use "./num_width.npk".*;
use "./intern.npk".*;

pub enum:NumBase = {
    BaseDecimal = 0i32;
    BaseHex     = 1i32;
    BaseBinary  = 2i32;
    BaseOctal   = 3i32;
    BaseTernary = 4i32;   // balanced: T/t is -1
    BaseNonary  = 5i32;   // balanced: a..d / A..D are -1..-4
};

pub struct:NumScan = {
    bool:is_numeric;    // false means the run was an identifier
    bool:is_float;
    bool:overflow;
    bool:bad_digit;
    int64:value;        // integers only; a float keeps its text
    NumBase:base;
    NumWidth:width;
};

func:num_fail = NumScan() never fails {
    NumScan:r = NumScan{ is_numeric: false, is_float: false, overflow: false,
                         bad_digit: false, value: 0i64,
                         base: NumBase.BaseDecimal, width: NumWidth.WNone };
    pass r;
};

// --- digit values -----------------------------------------------------------
//
// Returns the digit's value, or a sentinel far outside any base's range. The
// caller compares against the base's radix rather than against a magic number.

func:digit_value = int64(uint8:c, NumBase:base) never fails {
    if (base == NumBase.BaseTernary) {
        // Balanced ternary: T and t denote -1.
        if (c == 48u8) { pass 0i64; }
        if (c == 49u8) { pass 1i64; }
        if (c == 84u8) { pass 0i64 - 1i64; }
        if (c == 116u8) { pass 0i64 - 1i64; }
        pass 99i64;
    }
    if (base == NumBase.BaseNonary) {
        // Balanced nonary: a..d and A..D denote -1..-4.
        if ((c >= 48u8) && (c <= 52u8)) { pass (c - 48u8) => int64; }
        if ((c >= 97u8) && (c <= 100u8)) { pass 0i64 - (((c - 96u8) => int64)); }
        if ((c >= 65u8) && (c <= 68u8)) { pass 0i64 - (((c - 64u8) => int64)); }
        pass 99i64;
    }
    if ((c >= 48u8) && (c <= 57u8)) { pass (c - 48u8) => int64; }
    if ((c >= 97u8) && (c <= 102u8)) { pass ((c - 97u8) => int64) + 10i64; }
    if ((c >= 65u8) && (c <= 70u8)) { pass ((c - 65u8) => int64) + 10i64; }
    pass 99i64;
};

func:base_radix = int64(NumBase:base) never fails {
    if (base == NumBase.BaseHex)     { pass 16i64; }
    if (base == NumBase.BaseBinary)  { pass 2i64; }
    if (base == NumBase.BaseOctal)   { pass 8i64; }
    if (base == NumBase.BaseTernary) { pass 3i64; }
    if (base == NumBase.BaseNonary)  { pass 9i64; }
    pass 10i64;
};

// Balanced bases admit negative digits, so their bound is |digit| < radix rather
// than 0 <= digit < radix.
func:digit_in_base = bool(int64:d, NumBase:base) never fails {
    int64:r = raw base_radix(base);
    if (d == 99i64) { pass false; }
    if (d < 0i64) {
        if (base == NumBase.BaseTernary) { pass ((0i64 - d) <= 1i64); }
        if (base == NumBase.BaseNonary)  { pass ((0i64 - d) <= 4i64); }
        pass false;
    }
    pass (d < r);
};

// --- suffix stripping -------------------------------------------------------

func:ends_with = bool(string:s, string:tail) never fails {
    if (tail.len > s.len) { pass false; }
    string:back = raw slice_proven(s, s.len - tail.len, s.len);
    pass (raw string_eq(back, tail));
};

// Longest first, so "tri" beats "t" and "non" beats "n".
func:strip_base_suffix = int64(string:run) never fails {
    if (raw ends_with(run, "hex")) { pass 3i64; }
    if (raw ends_with(run, "bin")) { pass 3i64; }
    if (raw ends_with(run, "oct")) { pass 3i64; }
    if (raw ends_with(run, "ter")) { pass 3i64; }
    if (raw ends_with(run, "tri")) { pass 3i64; }
    if (raw ends_with(run, "non")) { pass 3i64; }
    if (raw ends_with(run, "t"))   { pass 1i64; }
    if (raw ends_with(run, "n"))   { pass 1i64; }
    pass 0i64;
};

func:base_from_suffix = NumBase(string:sfx) never fails {
    if (raw string_eq(sfx, "hex")) { pass NumBase.BaseHex; }
    if (raw string_eq(sfx, "bin")) { pass NumBase.BaseBinary; }
    if (raw string_eq(sfx, "oct")) { pass NumBase.BaseOctal; }
    if (raw string_eq(sfx, "ter")) { pass NumBase.BaseTernary; }
    if (raw string_eq(sfx, "tri")) { pass NumBase.BaseTernary; }
    if (raw string_eq(sfx, "t"))   { pass NumBase.BaseTernary; }
    if (raw string_eq(sfx, "non")) { pass NumBase.BaseNonary; }
    if (raw string_eq(sfx, "n"))   { pass NumBase.BaseNonary; }
    pass NumBase.BaseDecimal;
};

// The longest type suffix the run ends with, leaving a non-empty remainder.
func:strip_type_suffix = int64(string:run) never fails {
    int64:n = 6i64;
    while (n >= 2i64) decreases n - 2i64 {
        if (run.len > n) {
            string:tail = raw slice_proven(run, run.len - n, run.len);
            NumWidth:w = raw num_width_of(tail);
            if (w != NumWidth.WNone) {
                pass n;
            }
        }
        n = n - 1i64;
    }
    pass 0i64;
};

// --- the float literal (LEXICAL_REFERENCE §6.2; DEF-166, 1.6.1e step 3) --------
//
//   FloatLiteral ::= DecimalLiteral "." DecimalLiteral Exponent? TypeSuffix?
//   Exponent     ::= [eE] [+-]? DecimalLiteral
//
// THE BODY IS READ BY THE PRODUCTION, AND WHAT FOLLOWS IT IS THE TAIL. Until
// this step the lexer scanned `digits . ident-part*`, then ANY sign, then
// `ident-part*` again, kept the whole run as the literal's text, and asked only
// whether the run ENDED in a suffix. Three defects came of it, each measured on
// `5fbaf4a`:
//   - a tail naming no suffix was never looked at: `1.5f512`, `3.14flt32` and
//     `1.0f64x` compiled as the number in front (the library listener's
//     `ty0178` and `ty0189b`; the emitter cut the text at its first `f`), and
//     `1.5garbage` was handed to `llc` as written;
//   - a sign after ANY float was swallowed with what followed it: `3.5f64-x`
//     was one literal, whose value the emitter read up to its `f` -- the
//     subtraction vanished and the program computed 3.5, in silence -- while
//     `3.5-x` reached `llc` as `double 3.5-x` and `2.5-1.5` was the literal
//     `2.5-1` and a member access `.5` (TYPE-019);
//   - a `_` separator, which §6.2 permits and ignores, rode into the kept text:
//     `1_000.5f64` reached `llc` as `double 1_000.5`, and `1_000.5tfp64` folded
//     to 1.0 -- `tfp_q_decimal` below stops at the first byte it does not know.
// So the body is digits, a dot, digits, and an exponent ONLY where an `e`/`E`
// is followed by a digit, or by a sign and then a digit; a `_` is admitted in
// each digit run after its first digit, where the integer scan admits it; the
// tail is the [0-9a-zA-Z_] run after the body, for the lexer to hold to the
// `TypeSuffix` production (NITPICK-LEX-009); and the text a float keeps is its
// body WITHOUT the separators, then its tail -- so the four readers of that
// text (the checker's digit count, the Q fold, the emitter, the encoder) read
// the number that was written.

pub struct:FloatScan = {
    bool:is_float;     // false: not `digits . digit`, and the caller scans an integer
    int64:body_end;    // one past the numeric body
    int64:end;         // one past the tail: where the token ends
};

func:dec_digit = bool(uint8:c) never fails {
    pass ((c >= 48u8) && (c <= 57u8));
};

// One past the digits and `_` separators from `at` on. The caller has seen a
// DIGIT at `at`, so a separator never leads a run.
func:skip_digit_run = int64(string:text, int64:at) never fails {
    int64:p = at;
    while (p < text.len) decreases text.len - p {
        uint8:c = text.ptr[p] => uint8;
        if (!(raw dec_digit(c))) {
            if (c != 95u8) { pass p; }
        }
        p = p + 1i64;
    }
    pass p;
};

// `text` is the SOURCE, `start` the literal's first byte and `dot` the byte
// after the lexer's first [0-9a-zA-Z_] run -- where a float's dot stands.
pub func:num_float_scan = FloatScan(string:text, int64:start, int64:dot) never fails {
    FloatScan:no = FloatScan{ is_float: false, body_end: dot, end: dot };
    // A FLOAT NEEDS A DIGIT AFTER THE DOT: `0...4` is a range, and this is the
    // check that keeps it one (the seed walked into that case in 0.0.2).
    if ((dot + 1i64) >= text.len) { pass no; }
    if ((text.ptr[dot] => uint8) != 46u8) { pass no; }
    if (!(raw dec_digit(text.ptr[dot + 1i64] => uint8))) { pass no; }
    // AND DECIMAL DIGITS BEFORE IT: `0FFhex.5`, `12i32.5` and `1e5.0` are an
    // integer (or a bad one), a dot and an integer, for the integer scan and
    // the parser to answer. They were floats whose text no reader understood.
    int64:i = start;
    while (i < dot) decreases dot - i {
        uint8:c = text.ptr[i] => uint8;
        if (!(raw dec_digit(c))) {
            if (c != 95u8) { pass no; }
        }
        i = i + 1i64;
    }
    int64:p = raw skip_digit_run(text, dot + 1i64);
    // THE EXPONENT IS `e`, AN OPTIONAL SIGN, AND A DIGIT -- all three looked at
    // before any is taken, so `3.5e-x` is the literal `3.5e` (a bad tail), a
    // minus and a name, and `3.5-x` is a literal, a minus and a name.
    if (p < text.len) {
        uint8:x = text.ptr[p] => uint8;
        if ((x == 101u8) || (x == 69u8)) {
            int64:q = p + 1i64;
            if (q < text.len) {
                uint8:sg = text.ptr[q] => uint8;
                if ((sg == 43u8) || (sg == 45u8)) { q = q + 1i64; }
            }
            if (q < text.len) {
                if (raw dec_digit(text.ptr[q] => uint8)) {
                    p = raw skip_digit_run(text, q);
                }
            }
        }
    }
    int64:body_end = p;
    while (p < text.len) decreases text.len - p {
        uint8:t = text.ptr[p] => uint8;
        bool:part = raw dec_digit(t);
        if ((t >= 97u8) && (t <= 122u8)) { part = true; }   // a-z
        if ((t >= 65u8) && (t <= 90u8))  { part = true; }   // A-Z
        if (t == 95u8)                   { part = true; }   // _
        if (!part) { break; }
        p = p + 1i64;
    }
    pass FloatScan{ is_float: true, body_end: body_end, end: p };
};

// THE TEXT A FLOAT KEEPS: its numeric body without the `_` separators, then
// its tail -- `1_000.5f64` keeps "1000.5f64".
pub func:num_float_text = string(string:text, int64:start, FloatScan:fs) never fails {
    string:out = "";
    int64:lo = start;
    int64:i = start;
    while (i < fs.body_end) decreases fs.body_end - i {
        if ((text.ptr[i] => uint8) == 95u8) {
            out = string_concat(out, raw slice_proven(text, lo, i));
            lo = i + 1i64;
        }
        i = i + 1i64;
    }
    out = string_concat(out, raw slice_proven(text, lo, fs.body_end));
    pass (string_concat(out, raw slice_proven(text, fs.body_end, fs.end)));
};

// --- the scan ---------------------------------------------------------------

// `run` is a maximal [0-9a-zA-Z_] sequence. Returns is_numeric = false when it
// was an identifier after all.
pub func:num_scan = NumScan(string:run) never fails {
    if (run.len == 0i64) {
        pass (raw num_fail());
    }

    // D-147: a run that does not begin with a decimal digit is an identifier,
    // full stop. Everything below may assume run[0] is 0-9.
    uint8:first = run.ptr[0i64] => uint8;
    if ((first < 48u8) || (first > 57u8)) {
        pass (raw num_fail());
    }

    NumScan:out = raw num_fail();

    int64:tlen = raw strip_type_suffix(run);
    string:body = raw slice_proven(run, 0i64, run.len - tlen);
    NumWidth:width = NumWidth.WNone;
    if (tlen > 0i64) {
        width = raw num_width_of(raw slice_proven(run, run.len - tlen, run.len));
    }

    int64:blen = raw strip_base_suffix(body);
    NumBase:base = NumBase.BaseDecimal;
    if (blen > 0i64) {
        base = raw base_from_suffix(
            raw slice_proven(body, body.len - blen, body.len));
    }
    string:digits = raw slice_proven(body, 0i64, body.len - blen);

    // A base suffix with no digits in front of it is just an identifier --
    // `hex`, `bin` and `non` are perfectly good names.
    if (digits.len == 0i64) {
        pass out;
    }

    int64:radix = raw base_radix(base);
    int64:acc = 0i64;
    bool:seen_digit = false;
    bool:bad = false;
    bool:over = false;

    int64:i = 0i64;
    while (i < digits.len) decreases digits.len - i {
        uint8:c = digits.ptr[i] => uint8;
        if (c == 95u8) {
            // Underscores are permitted for readability and ignored (§6.2).
            i = i + 1i64;
        } else {
            int64:d = raw digit_value(c, base);
            if (!(raw digit_in_base(d, base))) {
                bad = true;
                i = digits.len;
            } else {
                // Overflow is DETECTED, not wrapped -- and EXACTLY (D-148). The
                // old guard compared against int64_max/10 whatever the radix,
                // so a hex literal near 2^64 could slip past it and WRAP: the
                // number in the program was not the number written, silently.
                //
                // Non-balanced digits are non-negative and the accumulator
                // stays non-negative, so `acc > (MAX - d) / radix` is the
                // exact pre-multiplication test. The balanced bases carry
                // negative digits (|d| <= 4), so both ends are guarded with a
                // 4-count margin: the envelope's outermost four values per
                // side are refused rather than risking a wrapped
                // intermediate -- LOUDLY, like i64's most negative value,
                // which no non-balanced literal can spell either. A type's
                // outermost values are constructed, not spelled.
                bool:balanced = false;
                if (base == NumBase.BaseTernary) { balanced = true; }
                if (base == NumBase.BaseNonary)  { balanced = true; }
                if (balanced) {
                    if (acc > (9223372036854775803i64 / radix)) { over = true; }
                    if (acc < ((0i64 - 9223372036854775804i64) / radix)) { over = true; }
                } else {
                    if (acc > ((9223372036854775807i64 - d) / radix)) { over = true; }
                }
                if (!over) {
                    acc = (acc * radix) + d;
                }
                seen_digit = true;
                i = i + 1i64;
            }
        }
    }

    if (bad) {
        // The run begins with 0-9 (the D-147 guard above), so it was MEANT as
        // a number: a bad digit is a real error, never an identifier rescue.
        out.is_numeric = true;
        out.bad_digit = true;
        out.base = base;
        out.width = width;
        pass out;
    }

    if (!seen_digit) {
        pass out;
    }

    out.is_numeric = true;
    out.is_float = false;
    out.overflow = over;
    out.value = acc;
    out.base = base;
    out.width = width;
    pass out;
};

// --- tfp literal folding (D-195, 1.3.2) --------------------------------------------
//
// EXACT decimal → Q(N/2).(N/2), in ONE `uint512` (1.4.7b). Until then the
// value lived in ten u64 limbs each holding 32 bits, written that way because
// the SEED built this file and wide integers were outside its subset; the
// user ratified the respell at the 1.4.7 close once D-231 had pinned the wide
// ladder by execution. The result is exact by construction either way, and
// every program that folds a tfp literal emits the same bytes as before
// (measured at the respell). The integer digits accumulate
// by ×10+digit; the fraction digits yield their F bits by the
// multiply-the-decimal-by-two carry method; the result rounds to NEAREST
// with ties to even (one extra bit plus a sticky over the remaining digits).
//
// Returns the raw Q value as DECIMAL TEXT for the `iN` constant — "" when
// the value exceeds the width's valid range (the sentinel's magnitude
// included, D-008 §1), so the CALLER refuses TYPE-031. The checker's range
// question and the emitter's constant come from this ONE conversion, which
// is what keeps them from drifting.
//
// Exponents are handled by moving the point; past |e| = 350 the answer is
// forced — every width's range tops out near 5.8e76, and anything below
// 1e-350 is under half of tfp256's smallest step — so the digit buffers
// stay bounded.

// THE ACCUMULATOR IS ONE `uint512`. 512 is the smallest rung above the 320
// bits the limbs had; the value never needs more than 256 + F + 1 bits, and
// the integer accumulation is CAPPED at 2^256 (`tfpq_over`) so `v * 10 + 9`
// and `v << F` stay inside 512 bits -- no operation can wrap and no shift
// can lose a high bit, which is what makes the fold exact by construction.

// value ≤ 2^(bits-1) − 1 — the widest VALID magnitude (the sentinel's
// magnitude 2^(bits-1) itself refuses, D-008 §1's balance).
func:tfpq_in_range = bool(uint512:v, int32:bits) never fails {
    pass (v < (1u512 << ((bits - 1i32) =>! uint512)));
};

// Any integer part at or past 2^256 is beyond every width's range (2^127 at
// tfp256), so refusing it is what `tfpq_in_range` would do anyway; stopping
// the accumulation there is what keeps the arithmetic inside 512 bits.
func:tfpq_over = bool(uint512:v) never fails {
    pass (v >= (1u512 << 256u512));
};

func:tfpq_decimal = string(uint512:v0) never fails {
    if (v0 == 0u512) { pass "0"; }
    uint512:v = v0;
    string:acc = "";
    while (v != 0u512) decreases v {
        uint512:rem = v % 10u512;
        v = v / 10u512;
        acc = string_concat(int_to_string(rem =>! int64), acc);
    }
    pass acc;
};

pub func:tfp_q_decimal = string(string:text, int32:bits) never fails {
    int32:frac_bits = bits / 2i32;
    // --- parse: integer digits, fraction digits, exponent; stop at a suffix ---
    // (A float's kept text carries no `_` separator -- `num_float_text` drops
    // them -- which matters HERE: this loop ends at the first byte it does not
    // know, and `1_000.5tfp64` folded to 1.0 until the lexer kept the body bare.)
    wild uint8->:ints = alloc(text.len + 408i64) =>! wild uint8->;
    wild uint8->:frs = alloc(text.len + 408i64) =>! wild uint8->;
    int64:ni = 0i64;
    int64:nf = 0i64;
    int64:ex = 0i64;
    bool:negex = false;
    int32:st = 0i32;    // 0 int, 1 frac, 2 exp, 3 done
    int64:i = 0i64;
    while (i < text.len) decreases text.len - i {
        uint8:c = text.ptr[i];
        bool:handled = false;
        if (c >= 48u8) {
            if (c <= 57u8) {
                handled = true;
                if (st == 0i32) { ints[ni] = c - 48u8; ni = ni + 1i64; }
                if (st == 1i32) { frs[nf] = c - 48u8; nf = nf + 1i64; }
                if (st == 2i32) {
                    if (ex < 100000i64) { ex = (ex * 10i64) + ((c - 48u8) => int64); }
                }
            }
        }
        if (!handled) {
            if (c == 46u8) { st = 1i32; handled = true; }          // '.'
            if (!handled) {
                if (c == 101u8) { st = 2i32; handled = true; }     // 'e'
                if (c == 69u8)  { st = 2i32; handled = true; }     // 'E'
            }
            if (!handled) {
                if (st == 2i32) {
                    if (c == 45u8) { negex = true; handled = true; }   // '-'
                    if (c == 43u8) { handled = true; }                 // '+'
                }
            }
            if (!handled) { i = text.len; }    // the suffix: done
        }
        if (i < text.len) { i = i + 1i64; }
    }
    if (negex) { ex = 0i64 - ex; }

    // --- the exponent moves the point ---
    if (ex > 350i64) {
        dalloc(ints);
        dalloc(frs);
        pass "";
    }
    if (ex < (0i64 - 350i64)) {
        dalloc(ints);
        dalloc(frs);
        pass "0";
    }
    while (ex > 0i64) decreases ex {
        uint8:mv = 0u8;
        if (nf > 0i64) {
            mv = frs[0i64];
            int64:j = 0i64;
            while (j < (nf - 1i64)) decreases ((nf - 1i64)) - j { frs[j] = frs[j + 1i64]; j = j + 1i64; }
            nf = nf - 1i64;
        }
        ints[ni] = mv;
        ni = ni + 1i64;
        ex = ex - 1i64;
    }
    while (ex < 0i64) decreases 0i64 - ex {
        uint8:mv2 = 0u8;
        if (ni > 0i64) {
            mv2 = ints[ni - 1i64];
            ni = ni - 1i64;
        }
        int64:j2 = nf;
        while (j2 > 0i64) decreases j2 { frs[j2] = frs[j2 - 1i64]; j2 = j2 - 1i64; }
        frs[0i64] = mv2;
        nf = nf + 1i64;
        ex = ex + 1i64;
    }

    // --- integer digits into the accumulator; at 2^256 it refuses ---
    uint512:val = 0u512;
    bool:over = false;
    for (int64:k in 0i64...ni) {
        if (!over) {
            if (raw tfpq_over(val)) { over = true; }
            else { val = (val * 10u512) + ((ints[k]) => uint512); }
        }
    }
    // --- shift by F, then the fraction's bits ---
    if (!over) {
        val = val << (frac_bits =>! uint512);
        for (int32:b in 0i32...frac_bits) {
            // ×2 over the decimal fraction, right to left; the carry OUT is
            // the next bit below the point, most significant first.
            uint64:carry = 0u64;
            int64:j3 = nf - 1i64;
            while (j3 >= 0i64) decreases j3 {
                uint64:t2 = (((frs[j3]) => uint64) * 2u64) + carry;
                carry = 0u64;
                if (t2 >= 10u64) { t2 = t2 - 10u64; carry = 1u64; }
                frs[j3] = t2 =>! uint8;
                j3 = j3 - 1i64;
            }
            if (carry != 0u64) {
                int64:pos = ((frac_bits - 1i32 - b) => int64);
                val = val | (1u512 << (pos =>! uint512));
            }
        }
        // --- rounding: one more doubled bit, sticky over what remains ---
        uint64:rcarry = 0u64;
        int64:j4 = nf - 1i64;
        while (j4 >= 0i64) decreases j4 {
            uint64:t3 = (((frs[j4]) => uint64) * 2u64) + rcarry;
            rcarry = 0u64;
            if (t3 >= 10u64) { t3 = t3 - 10u64; rcarry = 1u64; }
            frs[j4] = t3 =>! uint8;
            j4 = j4 - 1i64;
        }
        bool:sticky = false;
        for (int64:j5 in 0i64...nf) {
            if (frs[j5] != 0u8) { sticky = true; }
        }
        if (rcarry != 0u64) {
            bool:up = sticky;
            if (!up) {
                if ((val & 1u512) == 1u512) { up = true; }   // ties to even
            }
            if (up) { val = val + 1u512; }
        }
    }
    dalloc(ints);
    dalloc(frs);
    if (over) { pass ""; }
    if (!(raw tfpq_in_range(val, bits))) { pass ""; }
    pass (raw tfpq_decimal(val));
};

// THE Q CONSTANT UNDER A SIGN (DEF-197, 1.6.1e). `tfp_q_decimal` reads digits and
// never a sign: handed "-1" it stopped at the minus and answered "0", which is
// what a balanced-base literal under a `tfp` suffix was (`0Tttfp64`, the
// literal -1, compiled as 0). The magnitude goes through the one conversion and
// the sign is written in front -- exact, because the valid range is symmetric
// (D-008 SS1: the sentinel's magnitude is excluded, so no magnitude that fits
// has a negation that does not). "" when the magnitude does not fit.
pub func:tfp_q_signed = string(string:text, int32:bits, bool:neg) never fails {
    string:q = raw tfp_q_decimal(text, bits);
    if (!neg) { pass q; }
    if (q.len == 0i64) { pass q; }
    if ((q.len == 1i64) && (q.ptr[0i64] == 48u8)) { pass q; }
    pass (string_concat("-", q));
};

// THE Q CONSTANT OF AN INTEGER-FORM LITERAL (`5tfp64`), whose payload is a signed
// value: the checker's range question and the emitter's constant, as the
// fractional form's are one conversion.
pub func:tfp_q_of_int = string(int64:payload, int32:bits) never fails {
    if (payload >= 0i64) { pass (raw tfp_q_decimal(int_to_string(payload), bits)); }
    if (payload < (0i64 - 9223372036854775807i64)) { pass ""; }
    pass (raw tfp_q_signed(int_to_string(0i64 - payload), bits, true));
};

// --- float literal rounding (DEF-203, DEF-209; 1.6.1e) -------------------------------
//
// THE NEAREST FLOAT TO THE NUMBER WRITTEN, IN ONE ROUNDING. A `flt32` literal
// rode a `double` until this landed -- `fptrunc double <text> to float`: LLVM
// rounded the decimal to 53 bits and the instruction rounded that to 24. D-143
// held the two roundings equal to one "exactly when the decimal has <= 15
// significant digits", and that is false: where the decimal sits within half a
// double's unit of the midpoint between two floats, the double IS the midpoint
// and the tie goes to even, whichever side the decimal was on.
// `9.51125303839185e-19f32` compiled to 0x218C5C80; the nearest float is
// 0x218C5C7F. One literal in about 2^30 -- and silent.
//
// So the compiler converts the decimal itself: EXACTLY, to nearest, ties to
// even, at the precision of the type that was written. Nothing here rounds
// before the one rounding: the digits are halved (the integer part's bits,
// least significant first) and doubled (the fraction's, most significant
// first) as DECIMAL DIGIT RUNS, the schoolbook way, so every bit that comes out
// is a bit of the number written; a window of p + 1 of them is kept -- the
// significand and the round bit -- and `sticky` remembers whether anything
// nonzero lay below. No wide integer and no division but a digit's by two.
//
// GENERIC IN THE FORMAT (24 bits / 127 and 53 bits / 1023), because the
// checker's range question, the emitter's constant and the solver's
// `to_fp RNE` of the exact real must be ONE number for either width --
// `tfp_q_decimal`'s rule above, kept for the floats. The emitter's constant
// is this conversion's at BOTH widths (DEF-209): a `flt64` literal was left
// to LLVM's decimal parser until then, and that parser caps the exponent it
// reads at 24,000 -- past it, the number in the program was another number.
//
// THE ANSWER CARRIES TWO FLAGS and decides nothing about them: `inf`, the
// number rounds to infinity; `zero`, a NONZERO number rounds to zero. What a
// literal that does not fit should be is DEF-205's and the user's (S-126);
// the caller reads the flags.
//
// The work is bounded whatever is written: a number at or past 10^310 is
// infinity and one below 10^-330 is zero for both formats (2^1024 < 1.8e308,
// 2^-1075 > 2.4e-324), so the digit runs hold at most the literal's own digits
// and 330 zeros, and the halving ends inside four trips per digit.

pub struct:FloatBits = {
    uint64:bits;    // the IEEE encoding at the format's own width; a literal carries no sign
    bool:inf;       // the number written rounds to infinity
    bool:zero;      // a NONZERO number written rounds to zero
};

// x2 over a decimal fraction's digits, right to left, in place. The carry out
// is the fraction's next bit below the point.
func:frac_double = uint64(List<uint8>->:f) never fails {
    uint64:carry = 0u64;
    int64:j = f.count - 1i64;
    while (j >= 0i64) decreases j {
        uint64:t = (((<-f)[j] => uint64) * 2u64) + carry;
        carry = 0u64;
        if (t >= 10u64) { t = t - 10u64; carry = 1u64; }
        (<-f)[j] = t =>! uint8;
        j = j - 1i64;
    }
    pass carry;
};

// `text` is a float literal's kept text (or an integer body's decimal digits);
// the read ends at the first byte that is not the number's, which is where a
// suffix begins. `width` is 32 or 64.
pub func:float_round = FloatBits(string:text, int32:width) never fails {
    int64:p = 53i64;
    int64:emax = 1023i64;
    if (width == 32i32) { p = 24i64; emax = 127i64; }
    int64:emin = 1i64 - emax;
    uint64:top = ((2i64 * emax) + 1i64) =>! uint64;      // the exponent field of infinity
    uint64:inf_bits = top << ((p - 1i64) =>! uint64);

    // --- parse: every digit into ONE run, the point's place counted ---
    List<uint8>:dg = raw list_init::<uint8>(text.len + 1i64);
    int64:pt = 0i64;
    int64:ex = 0i64;
    bool:negex = false;
    int32:st = 0i32;    // 0 integer digits, 1 fraction digits, 2 the exponent
    int64:i = 0i64;
    while (i < text.len) decreases text.len - i {
        uint8:c = text.ptr[i];
        bool:handled = false;
        if ((c >= 48u8) && (c <= 57u8)) {
            handled = true;
            if (st == 2i32) {
                // The exponent stops growing once it is past anything the
                // text's own digits can bring back into range: the point moves
                // by at most the text's length, so an exponent beyond that and
                // a thousand more forces the answer whatever digits follow.
                // (A fixed cap would be wrong for a fraction with a hundred
                // thousand leading zeros and the exponent that undoes them.)
                if (ex <= (text.len + 1000i64)) { ex = (ex * 10i64) + ((c - 48u8) => int64); }
            } else {
                drop list_push(@dg, c - 48u8);
                if (st == 0i32) { pt = pt + 1i64; }
            }
        }
        if (!handled) {
            if ((c == 46u8) && (st == 0i32)) { st = 1i32; handled = true; }       // '.'
            if (!handled) {
                if (((c == 101u8) || (c == 69u8)) && (st < 2i32)) { st = 2i32; handled = true; }   // 'e' 'E'
            }
            if (!handled) {
                if (st == 2i32) {
                    if (c == 45u8) { negex = true; handled = true; }                // '-'
                    if (c == 43u8) { handled = true; }                              // '+'
                }
            }
            if (!handled) { i = text.len; }    // the suffix: done
        }
        if (i < text.len) { i = i + 1i64; }
    }
    if (negex) { ex = 0i64 - ex; }

    // --- leading zeros leave and the point follows them; trailing zeros leave ---
    int64:lead = 0i64;
    while (lead < dg.count) decreases dg.count - lead {
        if (dg[lead] != 0u8) { break; }
        lead = lead + 1i64;
    }
    int64:nd = dg.count;
    while (nd > lead) decreases nd - lead {
        if (dg[nd - 1i64] != 0u8) { break; }
        nd = nd - 1i64;
    }
    pt = (pt - lead) + ex;
    // Zero, exactly: the one zero that is the number written.
    if (nd == lead) { pass FloatBits{ bits: 0u64, inf: false, zero: false }; }
    // --- the forced answers: past both formats' range ---
    if (pt > 310i64) { pass FloatBits{ bits: inf_bits, inf: true, zero: false }; }
    if (pt < (0i64 - 330i64)) { pass FloatBits{ bits: 0u64, inf: false, zero: true }; }

    // --- the integer's digits and the fraction's, the point between them ---
    List<uint8>:ig = raw list_init::<uint8>(312i64);
    int64:k = 0i64;
    while (k < pt) decreases pt - k {
        uint8:dv = 0u8;
        if ((lead + k) < nd) { dv = dg[lead + k]; }
        drop list_push(@ig, dv);
        k = k + 1i64;
    }
    List<uint8>:fr = raw list_init::<uint8>((nd - lead) + 332i64);
    int64:z = pt;
    while (z < 0i64) decreases 0i64 - z {
        drop list_push(@fr, 0u8);
        z = z + 1i64;
    }
    int64:k2 = lead;
    if (pt > 0i64) { k2 = lead + pt; }
    while (k2 < nd) decreases nd - k2 {
        drop list_push(@fr, dg[k2]);
        k2 = k2 + 1i64;
    }

    // --- the integer's bits, least significant first: halve the digits until
    //     none is left. `w` keeps the newest p + 1 of them -- the top of the
    //     number -- and `sticky` what fell out below. An integer of n digits is
    //     below 2^(4n), so the measure is its bits still to come. ---
    uint64:w = 0u64;
    int64:nbi = 0i64;
    bool:sticky = false;
    int64:first = 0i64;
    int64:bitcap = ig.count * 4i64;
    while (first < ig.count) decreases bitcap - nbi {
        uint64:carry = 0u64;
        for (int64:j in first...ig.count) {
            uint64:cur = (carry * 10u64) + (ig[j] => uint64);
            ig[j] = (cur >> 1u64) =>! uint8;
            carry = cur & 1u64;
        }
        if ((w & 1u64) == 1u64) { sticky = true; }
        w = (w >> 1u64) | (carry << (p =>! uint64));
        nbi = nbi + 1i64;
        while (first < ig.count) decreases ig.count - first {
            if (ig[first] != 0u8) { break; }
            first = first + 1i64;
        }
    }

    // `e` is the exponent of the number's leading 1; `need` the fraction bits
    // the window is still owed.
    int64:e = 0i64;
    int64:need = 0i64;
    if (nbi > 0i64) {
        e = nbi - 1i64;
        int64:have = nbi;
        if (have > (p + 1i64)) { have = p + 1i64; }
        need = (p + 1i64) - have;
        w = w >> (need =>! uint64);     // the bits it has come down; the owed ones fill in below
    } else {
        // --- no integer part: double the fraction until its first 1 comes out.
        //     Below the round bit's place a leading 1 is zero. ---
        bool:found = false;
        int64:floor_e = emin - p;
        while ((!found) && (e >= floor_e)) decreases e - floor_e {
            if ((raw frac_double(@fr)) == 1u64) { found = true; }
            e = e - 1i64;
        }
        if ((!found) || (e < floor_e)) { pass FloatBits{ bits: 0u64, inf: false, zero: true }; }
        w = 1u64;
        need = p;
        if (e < emin) { need = e - floor_e; }    // a subnormal keeps fewer bits
    }

    // --- the owed fraction bits, most significant first; then what is left ---
    for (int64:b in 0i64...need) {
        w = (w << 1u64) | (raw frac_double(@fr));
    }
    for (int64:j2 in 0i64...fr.count) {
        if (fr[j2] != 0u8) { sticky = true; }
    }

    // --- round to nearest, ties to even. The encoding absorbs the carry: a
    //     significand that rounds up to 2^p is the next exponent's first value,
    //     and the largest exponent's is infinity's own pattern. ---
    uint64:m = w >> 1u64;
    if ((w & 1u64) == 1u64) {
        if (sticky || ((m & 1u64) == 1u64)) { m = m + 1u64; }
    }
    if (m == 0u64) { pass FloatBits{ bits: 0u64, inf: false, zero: true }; }
    int64:base = e;
    if (base < emin) { base = emin; }
    uint64:bits = (((base - emin) =>! uint64) << ((p - 1i64) =>! uint64)) + m;
    if ((bits >> ((p - 1i64) =>! uint64)) >= top) {
        pass FloatBits{ bits: inf_bits, inf: true, zero: false };
    }
    pass FloatBits{ bits: bits, inf: false, zero: false };
};

// A `flt32`'s BITS AS THE BITS OF THE `flt64` HOLDING THE SAME VALUE -- the one
// spelling LLVM gives a `float` constant that is not a short decimal: sixteen
// hex digits, the double's pattern, accepted only where that double is exactly
// a float. This one is by construction: the float's fraction moves up 29 bits
// and its exponent is re-biased; a subnormal float is a NORMAL double, found
// by its leading bit.
pub func:flt32_bits_as_flt64 = uint64(uint64:b32) never fails {
    uint64:ef = (b32 >> 23u64) & 255u64;
    uint64:fr = b32 & 8388607u64;
    if (ef == 255u64) { pass ((2047u64 << 52u64) | (fr << 29u64)); }
    if (ef == 0u64) {
        if (fr == 0u64) { pass 0u64; }
        uint64:t = 22u64;
        while (((fr >> t) & 1u64) == 0u64) decreases t { t = t - 1u64; }
        // 2^(t - 149): the exponent field is t - 149 + 1023
        pass (((t + 874u64) << 52u64) | ((fr - (1u64 << t)) << (52u64 - t)));
    }
    pass (((ef + 896u64) << 52u64) | (fr << 29u64));     // ef - 127 + 1023
};
