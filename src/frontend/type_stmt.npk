// Statement checking.
//
// Written in subset 1 (meta/SUBSET_1.md §4). Cycle 0.4.4, completing the `Result` discipline.
//
// Three jobs, and they are the ones that make the expression rules load-bearing:
//
//   * A DECLARATION'S INITIALISER MUST MATCH ITS ANNOTATION. Nitpick has no
//     inferred bindings, so every local states its type and this is where the
//     statement is held to it.
//   * `pass` AND `fail` ARE SUGAR over `return Result{…}` (TYPE_REFERENCE §11),
//     so they are checked as what they desugar to rather than as their own rules.
//   * EVERY CONDITION IS A STRICT `bool`. There is no truthiness, and a condition
//     is where a tainted or mistyped value would otherwise steer a decision.

mod:type_stmt;
use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./type_names.npk".*;
use "./parse_stmt.npk".*;
use "./parser.npk".*;   // QUAL_FIXED (D-165, D-211)
use "./parse_expr.npk".*;
use "./parse_pick.npk".*;
use "./parse_decl.npk".*;
use "./parse_decorate.npk".*;
use "./symbols.npk".*;
use "./type_resolve.npk".*;
use "./type_decls.npk".*;
use "./type_layout.npk".*;
use "./expr_types.npk".*;
use "./type_expr.npk".*;
use "./type_members.npk".*;
use "./type_trait.npk".*;   // assoc_binding_of (D-166)
use "./resolve_codes.npk".*;   // RESOLVE_UNKNOWN: a `(module.Name)` arm naming nothing is the identifier's own code (D-275, D-240)
use "./builtins.npk".*;        // is_builtin_name: the names a CALLABLE binding cannot take (D-296)

// A CALLABLE BINDING MAY NOT TAKE A BUILTIN'S NAME (D-296, 1.5.6b step 4b) --
// D-294 inside a function. A bare-name builtin is admitted by the resolver only
// when nothing in scope binds the name, so a PARAMETER, a LOCAL, a `for`
// binding or a `pick` PATTERN binding whose TYPE is a function type takes the
// name over for its whole scope: `func int64() never fails:path_exists = f;`
// made `raw path_exists()` call the local (measured, exit 8). D-294's principle
// is that the builtin table's names are the compiler's IN THE FUNCTION
// NAMESPACE, and a function-typed binding is in it -- it is called by its bare
// name. Decided HERE, by the binding's TYPE and never by its spelling: a
// pattern binding has no annotation to read, and one predicate at every site
// that types a binding is one rule. A binding of any OTHER type is left alone
// (calling `int64:read` is a type error, loud); a function-typed FIELD is
// reached through its receiver, as a method is, and is no binding at all.
// The code is the loader's (D-239/D-294's `RESOLVE-001`: this name already
// means something here), reported by the checker because only the checker
// knows a binding's type -- D-275's precedent.
func:check_callable_name = NIL(ExprTyper->:e, int32:name, int32:t, string:what, Span:at) never fails {
    if (t == 0i32) { pass NIL; }
    if (!(raw type_is_func(e.types, t))) { pass NIL; }
    if (raw intern_is_none(name)) { pass NIL; }
    string:nm = raw intern_get(e.interns, name);
    if (!(raw is_builtin_name(nm))) { pass NIL; }
    string:m1 = string_concat("`", nm);
    string:m2 = string_concat(m1, "` is a builtin (BUILTIN_REFERENCE), so ");
    string:m3 = string_concat(m2, what);
    string:m4 = string_concat(m3, " of function type cannot take the name: inside its scope `");
    string:m5 = string_concat(m4, nm);
    discard(raw te_error(e, raw RESOLVE_DUPLICATE(),
        string_concat(m5, "(…)` would call the binding and not the builtin (D-296) -- rename it; a struct pattern's binding carries its field's name, so reach that field through its receiver instead"),
        at));
    pass NIL;
};

// THE WALK IS TOTAL, AND IT WAS NOT.
//
// What stood here answered nine of the twenty-five statement kinds and returned
// quietly for the other sixteen — including every kind that CONTAINS statements.
// So an `if` had its condition checked and its body ignored, and nothing inside
// any block, loop, `pick` arm or `defer` was type-checked at all. The tests did
// not see it because the harness put each case at the top level of a function
// body, with a comment saying so.
//
// That is the same hole `resolve_audit` and `check_kinds_reachable` were built
// for, arriving a third time in a third pass, so it gets the same answer: every
// kind reached explicitly, an out-loud "nothing to check" for the ones that carry
// nothing, and an INTERNAL DIAGNOSTIC where a walk used to return quietly.
// `stmt_is_classified` is the total table over that, and
// `tests/frontend/type_stmt.npk` walks `1..STMT_KIND_MAX` against it so the next
// statement kind cannot arrive unvisited the way sixteen of them did.
pub func:check_stmt = NIL(ExprTyper->:e, StmtId:id) never fails {
    if (raw stmt_is_none(id)) { pass NIL; }
    StmtNode:s = raw ast_stmt(e.ast, id);

    if (s.kind == StmtKind.StmtVarDeclStmt) { drop check_var_decl(e, id, s); pass NIL; }
    if (s.kind == StmtKind.StmtAssignStmt)  { drop check_assign(e, s);   pass NIL; }
    if (s.kind == StmtKind.StmtPassStmt)    { drop check_pass(e, s);     pass NIL; }
    if (s.kind == StmtKind.StmtFailStmt)    { drop check_fail(e, s);     pass NIL; }
    if (s.kind == StmtKind.StmtTrapStmt)    { drop check_trap(e, s);     pass NIL; }
    if (s.kind == StmtKind.StmtReturnStmt)  { drop check_return(e, s);   pass NIL; }
    if (s.kind == StmtKind.StmtExitStmt)    { drop check_exit(e, s);     pass NIL; }

    if (s.kind == StmtKind.StmtBlockStmt) {
        drop check_stmt_window(e, raw stmt_list_start(s), raw stmt_list_count(s));
        pass NIL;
    }

    // EVERY CONDITION IS A `bool`, and the check is one line because
    // `require_bool` already says why (0.4.2). Grouped rather than listed
    // per-statement so a new conditional form cannot arrive without one — and
    // each now walks its BODY, which is the part that was missing.
    if (s.kind == StmtKind.StmtIfStmt) {
        drop check_cond(e, s);
        drop check_stmt(e, raw stmt_then(s));
        drop check_stmt(e, raw stmt_else(s));
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        drop check_cond(e, s);
        drop check_measure(e, raw stmt_while_measure(e.ast, s), false, "a `while` loop", s.span);
        drop check_invariants(e, raw stmt_while_invariant(e.ast, s));
        drop check_stmt(e, raw stmt_body(e.ast, s));
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        drop check_cond(e, s);
        drop check_measure(e, raw stmt_when_measure(e.ast, s), false, "a `when` loop", s.span);
        drop check_invariants(e, raw stmt_when_invariant(e.ast, s));
        drop check_stmt(e, raw stmt_when_body(e.ast, s));
        drop check_stmt(e, raw stmt_when_then(e.ast, s));
        drop check_stmt(e, raw stmt_when_end(e.ast, s));
        pass NIL;
    }
    // `loop`/`till` — HEAD ARGUMENTS AND A BODY, AND NO CONDITION.
    //
    // `check_cond` used to be called on a `till`, and slot `a` on a counted
    // statement is the BODY: a `StmtId` read as an `ExprId`, so the checker typed
    // whatever expression node happened to sit at the body's index. `stmt_cond`
    // and `stmt_counted_body` both read slot `a` and mean different things by it,
    // which is the third time a slot meaning two things has cost this compiler a
    // defect. `till(limit, step)` bounds itself with head arguments; there is no
    // condition anywhere in either form.
    if (s.kind == StmtKind.StmtLoopStmt) { drop check_counted(e, s); pass NIL; }
    if (s.kind == StmtKind.StmtTillStmt) { drop check_counted(e, s); pass NIL; }

    if (s.kind == StmtKind.StmtForStmt) {
        drop check_for(e, s);
        drop check_measure(e, raw stmt_for_measure(e.ast, s), true, "a `for` loop", s.span);
        drop check_invariants(e, raw stmt_for_invariant(e.ast, s));
        drop check_stmt(e, raw stmt_for_body(e.ast, s));
        pass NIL;
    }

    // A `pick`'s selector, its arms' BINDING TYPES, and then the bodies. A
    // destructuring arm's binding takes its type from the variant's payload, and
    // until 0.7.7 nothing recorded it: `type_ident` answered UNKNOWN for every
    // pattern binding, and unknown propagates silently — `d + "x"` inside an arm
    // type-checked. Found by the backend's first `pick` program, not by a test.
    // The type is written onto the PATTERN's spare slot, the way resolution
    // writes a symbol onto an identifier, and `type_ident` reads it back.
    if (s.kind == StmtKind.StmtPickStmt) {
        int32:selt = raw type_of_expr(e, raw pick_selector(s));
        // THE RULES BOTH SPELLINGS SHARE (`type_pick_rules`), then the arms.
        PickRules:pr = raw type_pick_rules(e, raw pick_selector(s), selt,
                                           raw pick_arm_start(s),
                                           raw pick_arm_count(s), s.span);
        if (!pr.ok) { pass NIL; }
        drop check_arms(e, raw pick_selector(s), pr.consuming,
                        raw pick_arm_start(s), raw pick_arm_count(s));
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPickArm) {
        discard(raw type_of_expr(e, raw arm_guard(s)));
        drop check_stmt(e, raw arm_body(s));
        pass NIL;
    }

    if (s.kind == StmtKind.StmtDeferStmt) {
        StmtId:body = StmtId{ index: s.a };
        // D-163 rule 7: `fail`/`relay` are refused anywhere in a `defer` body.
        bool:saved_defer = e.in_defer;
        e.in_defer = true;
        drop check_stmt(e, body);
        e.in_defer = saved_defer;
        pass NIL;
    }

    // `break`, `continue` and `fall` carry a LABEL and no expression, so there is
    // nothing here to type. Said out loud rather than reached by falling off the
    // end, because "./nothing to check" and "nobody has looked" are the two answers
    // this function exists to keep apart.
    if (s.kind == StmtKind.StmtBreakStmt)    { pass NIL; }
    if (s.kind == StmtKind.StmtContinueStmt) { pass NIL; }
    if (s.kind == StmtKind.StmtFallStmt)     { pass NIL; }

    // A BARE EXPRESSION STATEMENT — rule 6 of D-163's closed list. A `Result`
    // may never be discarded without a keyword, and every call yields one. The
    // handled forms are accepted by SHAPE — `drop`, `relay`, `?!`, `?|` each
    // deal with the error — and everything else is refused: a bare call (its
    // `Result` dropped), a computed value thrown away, or `raw` in statement
    // position (its unwrapped value discarded).
    if (s.kind == StmtKind.StmtExprStmt) {
        ExprId:xid = raw stmt_expr(s);
        ExprNode:xn = raw ast_expr(e.ast, xid);
        if (xn.kind == ExprKind.ExprDropExpr)          { discard(raw type_of_expr(e, xid)); pass NIL; }
        bool:kw = xn.kind == ExprKind.ExprRelayExpr;
        if (xn.kind == ExprKind.ExprEmphaticUnwrapExpr) { kw = true; }
        if (xn.kind == ExprKind.ExprSafeUnwrapExpr)     { kw = true; }
        if (kw) {
            // `raw f();` / `f() ?! c;` / `f() ?| NIL;` — the keyword deals
            // with the ERROR; the statement's own type must still be `NIL`, or
            // a VALUE is being discarded (rule 6: `discard(…)` is the spelling
            // for that, and it must be deliberate).
            int32:kt = raw type_of_expr(e, xid);
            if (kt == 0i32) { pass NIL; }
            if (raw type_is_invalid(e.types, kt)) { pass NIL; }
            if (kt != e.types.t_nil) {
                discard(raw te_error(e, raw TYPE_RESULT_DISCARDED(),
                    "the error is handled but the VALUE is discarded (D-163): a statement is an effect — `discard(…)` it deliberately, or use the value",
                    s.span));
            }
            pass NIL;
        }
        if (xn.kind == ExprKind.ExprRawUnwrapExpr) {
            discard(raw type_of_expr(e, xid));
            discard(raw te_error(e, raw TYPE_RESULT_DISCARDED(),
                "`raw f()` in statement position discards the unwrapped value; run it for effect with `drop f();` (D-163)",
                s.span));
            pass NIL;
        }
        // (A BARE BUILTIN CALL used to be caught HERE, by shape, because it
        // typed as unknown and the Result test below could not see it. Since
        // D-201 it has a real type and the general rules answer: a may-fail
        // builtin's statement is a discarded `Result`, a never-fails one
        // returning a value is a discarded value, and one returning nothing is
        // a statement — `dalloc(p);`, which is what it reads as. 1.4.2.)
        int32:xt = raw type_of_expr(e, xid);
        if (xt == 0i32) { pass NIL; }
        if (raw type_is_invalid(e.types, xt)) { pass NIL; }
        if ((raw type_kind(e.types, xt)) == (raw TY_RESULT())) {
            discard(raw te_error(e, raw TYPE_RESULT_DISCARDED(),
                "a `Result` is discarded here with no keyword (D-163): `drop` it (a `never fails` call), `relay` it, or handle it with `?|`, `?!`, `is_err`, or a `pick`",
                s.span));
            pass NIL;
        }
        if (xt != e.types.t_nil) {
            discard(raw te_error(e, raw TYPE_RESULT_DISCARDED(),
                "this expression's value is discarded (D-163): a statement is an effect, not a computed value thrown away",
                s.span));
            pass NIL;
        }
        pass NIL;
    }
    // `discard(expr)` throws away a plain value ON PURPOSE — but a `Result` is
    // not a plain value, and must be handled, not discarded (D-163 rule 6).
    if (s.kind == StmtKind.StmtDiscardStmt) {
        ExprId:did = raw stmt_expr(s);
        int32:dt = raw type_of_expr(e, did);
        if (dt == 0i32) { pass NIL; }
        if (raw type_is_invalid(e.types, dt)) { pass NIL; }
        if ((raw type_kind(e.types, dt)) == (raw TY_RESULT())) {
            discard(raw te_error(e, raw TYPE_RESULT_DISCARDED(),
                "`discard` throws away a plain value; a `Result` must be handled — `drop`, `relay`, `?|`, `?!`, or `is_err`/`pick` (D-163)",
                s.span));
        }
        pass NIL;
    }

    // `prove(e)` AND `assert_static(e)` ARE PROPOSITIONS (1.5.1, D-221): a
    // `bool`, under the contract rules. Whether an `assert_static` FOLDS is
    // 1.5.4's (the frontend fold); whether a `prove` HOLDS is 1.5.4's
    // obligation. Until 1.5.1 both fell to the "typed for its own sake" arm
    // below and an operand of any type was accepted.
    if (s.kind == StmtKind.StmtProveStmt) {
        drop check_proposition(e, raw stmt_expr(s), raw CTX_PROVE());
        pass NIL;
    }
    if (s.kind == StmtKind.StmtAssertStaticStmt) {
        drop check_proposition(e, raw stmt_expr(s), raw CTX_PROVE());
        // THE FOLD (1.5.4 step 4, L-17; VERIFICATION §1.1): the proposition
        // must fold to a constant `bool` through 0.6's evaluator, and a
        // `false` halts compilation. Asked only of a proposition the rule
        // above typed `bool` (one mistake, one report, D-240), and not in a
        // `comptime` body, where the evaluator folds it per call (L-18) and
        // a parameter has no value yet.
        ExprId:ax = raw stmt_expr(s);
        if ((raw type_of_expr(e, ax)) != e.types.t_bool) { pass NIL; }
        if (e.fn_comptime) { pass NIL; }
        TypeResolver:r = raw etyper_resolver(e);
        ConstVal:cv = raw fold_const(@r, ax, e.scope);
        if (!(raw cv_folded(cv)) || (cv.kind != (raw CV_BOOL()))) {
            if (!(raw fold_gave_up(@r))) {
                discard(raw te_error(e, raw TYPE_ASSERT_STATIC(),
                    "an `assert_static` proposition must fold to a constant at compile time, and this one reads a value the evaluator cannot see -- `prove` is the claim about a run-time value, decided by the solver in the verified build",
                    s.span));
            }
            pass NIL;
        }
        if (cv.num == 0i64) {
            discard(raw te_error(e, raw TYPE_ASSERT_STATIC(),
                "this `assert_static` is false: its proposition folds to `false` at compile time",
                s.span));
        }
        pass NIL;
    }

    // One expression in slot `a`, typed for its own sake: `trap`, `give`. A
    // mistake inside one is worth reporting even where the value goes nowhere.
    if (raw stmt_carries_expr(s.kind)) {
        discard(raw type_of_expr(e, raw stmt_expr(s)));
        pass NIL;
    }

    discard(raw te_error(e, raw TYPE_INTERNAL(),
        "this statement kind has no entry in the checker's walk, so its contents cannot be checked",
        s.span));
    pass NIL;
};


// EVERY STATEMENT KIND IS ACCOUNTED FOR — the mechanical half of the check, and
// the half a test can prove. Whether each rule is RIGHT is not answerable this
// way, which is what 0.4.8's negative coverage is for; whether each kind is
// VISITED is, and that is the failure that just happened.
pub func:stmt_is_classified = bool(StmtKind:k) never fails {
    if (k == StmtKind.StmtNone) { pass false; }
    if (raw stmt_carries_expr(k)) { pass true; }
    if (k == StmtKind.StmtBlockStmt)     { pass true; }
    if (k == StmtKind.StmtVarDeclStmt)   { pass true; }
    if (k == StmtKind.StmtAssignStmt)    { pass true; }
    if (k == StmtKind.StmtIfStmt)        { pass true; }
    if (k == StmtKind.StmtPickStmt)      { pass true; }
    if (k == StmtKind.StmtPickArm)       { pass true; }
    if (k == StmtKind.StmtWhileStmt)     { pass true; }
    if (k == StmtKind.StmtForStmt)       { pass true; }
    if (k == StmtKind.StmtLoopStmt)      { pass true; }
    if (k == StmtKind.StmtTillStmt)      { pass true; }
    if (k == StmtKind.StmtWhenStmt)      { pass true; }
    if (k == StmtKind.StmtBreakStmt)     { pass true; }
    if (k == StmtKind.StmtContinueStmt)  { pass true; }
    if (k == StmtKind.StmtFallStmt)      { pass true; }
    if (k == StmtKind.StmtPassStmt)      { pass true; }
    if (k == StmtKind.StmtFailStmt)      { pass true; }
    if (k == StmtKind.StmtReturnStmt)    { pass true; }
    if (k == StmtKind.StmtExitStmt)      { pass true; }
    pass (k == StmtKind.StmtDeferStmt);
};

pub func:check_stmt_window = NIL(ExprTyper->:e, int32:start, int32:count) never fails {
    for (int32:i in 0i32...count) {
        StmtId:x = StmtId{ index: raw ast_id_at(e.ast, start, i) };
        drop check_stmt(e, x);
        // `wild_release_all()` IS FOLLOWED BY `exit` (TYPE-062, 1.5.1b step 5):
        // the call unmaps every chunk of both regimes (D-151), so no drop, no
        // allocation and not even the trap route can run after it. The next
        // statement of the same block must be `exit`; a measurement that has
        // to happen after the release goes into `exit`'s operand.
        if (raw stmt_is_release_all(e, x)) {
            bool:ok = false;
            if ((i + 1i32) < count) {
                StmtId:nx = StmtId{ index: raw ast_id_at(e.ast, start, i + 1i32) };
                if ((raw ast_stmt(e.ast, nx)).kind == StmtKind.StmtExitStmt) { ok = true; }
            }
            if (!ok) {
                drop diaglist_push(e.diags, raw diag_error(raw TYPE_RELEASE_THEN_EXIT(),
                    "`wild_release_all()` unmaps every chunk of both regimes (D-151), so nothing may run after it but `exit` -- not a drop, not an allocation, not even the trap route; the next statement in this block must be `exit`, and what has to be measured after the release goes into its operand",
                    (raw ast_stmt(e.ast, x)).span));
            }
        }
    }
    pass NIL;
};

// Is this statement the bare call `wild_release_all();`? The callee is the
// builtin's own name -- no declaration may take it -- read off the identifier.
func:stmt_is_release_all = bool(ExprTyper->:e, StmtId:id) never fails {
    StmtNode:s = raw ast_stmt(e.ast, id);
    if (s.kind != StmtKind.StmtExprStmt) { pass false; }
    ExprId:eid = raw stmt_expr(s);
    if (raw expr_is_none(eid)) { pass false; }
    ExprNode:c = raw ast_expr(e.ast, eid);
    if (c.kind != ExprKind.ExprCallExpr) { pass false; }
    ExprNode:cal = raw ast_expr(e.ast, raw expr_callee(c));
    if (cal.kind != ExprKind.ExprIdentifierExpr) { pass false; }
    pass (raw string_eq(raw intern_get(e.interns, cal.payload =>! int32), "wild_release_all"));
};

// A LENDING `pick`'S BINDING IS A VIEW (D-266, 1.5.2h): the payload in place,
// read-only, typed as itself. Nothing is copied at the bind, so an owning
// payload -- a `string`, a `List`, a bare `T` (D-264) -- binds as freely as a
// scalar: the second-owner hazard that made 1.4.3b refuse the bind (a binding
// that was a bitwise COPY, `cap` included, outliving its enum) has no copy to
// ride. What a view cannot be is a value whose EVERY operation writes through
// its address -- an arena, a lock, a guard, an atomic, a channel, a `dyn`
// (`type_kind_stateful`) -- since a view has no address to write through;
// `pick (move(v))` is the form for those. `_` binds nothing and views
// nothing. The consuming form owns its bindings and is not asked.
func:check_pick_view_binds = NIL(ExprTyper->:e, int32:selt, bool:consuming,
                                 int32:start, int32:count) never fails {
    if (consuming) { pass NIL; }
    if (selt == 0i32) { pass NIL; }
    int32:i = 0i32;
    while (i < count) decreases count - i {
        StmtNode:arm = raw ast_stmt(e.ast, raw pick_arm_at(e.ast, start, i));
        PatId:pid3 = raw arm_pattern(arm);
        if (!(raw pat_is_none(pid3))) {
            PatNode:pn3 = raw ast_pat(e.ast, pid3);
            // The binding-type window `type_pick_bindings` just recorded on
            // the pattern (1.0.9c), read the way `type_ident` reads it back.
            int32:bw = pn3.payload =>! int32;
            int32:bn = 0i32;
            if (pn3.kind == PatKind.PatEnumDestructure) {
                bn = raw pat_enum_bind_count(e.ast, pn3);
            }
            if (pn3.kind == PatKind.PatStructDestructure) {
                bn = raw pat_bind_count(pn3);
            }
            for (int32:b in 0i32...bn) {
                int32:bt = raw ast_id_at(e.ast, bw, b);
                int32:bnm = 0i32;
                if (pn3.kind == PatKind.PatEnumDestructure) {
                    bnm = raw pat_enum_bind(e.ast, pn3, b);
                }
                if (pn3.kind == PatKind.PatStructDestructure) {
                    bnm = raw ast_id_at(e.ast, raw pat_bind_start(pn3), b);
                }
                if (bnm != 0i32) {
                    if (raw string_eq(raw intern_get(e.interns, bnm), "_")) {
                        bt = 0i32;
                    }
                }
                if (bt != 0i32) {
                    if (raw type_kind_stateful(raw type_kind(e.types, bt))) {
                        drop diaglist_push(e.diags, raw diag_error(
                            raw TYPE_VIEW_READ_ONLY(),
                            "this arm would bind a VIEW of a payload whose every operation writes through its address -- an arena, a lock, a guard, an atomic, a channel or a `dyn` (D-266) -- and a view has no address: consume the value with `pick (move(v))`, or bind nothing and read through the selector",
                            arm.span));
                    }
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// DOES THIS ARM BIND A NAME? `_` binds nothing (D-266: it views nothing and
// freezes nothing). Read by both spellings' arm walks and by the freeze.
pub func:arm_binds_name = bool(ExprTyper->:e, StmtNode:arm) never fails {
    PatId:apid = raw arm_pattern(arm);
    if (raw pat_is_none(apid)) { pass false; }
    PatNode:pn = raw ast_pat(e.ast, apid);
    int32:bn = 0i32;
    if (pn.kind == PatKind.PatEnumDestructure) { bn = raw pat_enum_bind_count(e.ast, pn); }
    if (pn.kind == PatKind.PatStructDestructure) { bn = raw pat_bind_count(pn); }
    for (int32:b in 0i32...bn) {
        int32:bnm = 0i32;
        if (pn.kind == PatKind.PatEnumDestructure) { bnm = raw pat_enum_bind(e.ast, pn, b); }
        if (pn.kind == PatKind.PatStructDestructure) { bnm = raw ast_id_at(e.ast, raw pat_bind_start(pn), b); }
        if (bnm != 0i32) {
            if (!(raw string_eq(raw intern_get(e.interns, bnm), "_"))) { pass true; }
        }
    }
    pass false;
};

// One binding, one payload, one recorded type. A variant carrying MORE than one
// payload is 0.9's — the backend rungs it, and its multi-binding typing lands
// with that lift; until then those bindings stay unknown exactly as before.
func:type_pick_bindings = NIL(ExprTyper->:e, int32:selt, int32:start,
                              int32:count) never fails {
    if (selt == 0i32) { pass NIL; }
    int32:sk = raw type_kind(e.types, selt);
    if (sk != (raw TY_ENUM())) {
        if (sk != (raw TY_STRUCT())) { pass NIL; }
    }
    int32:i = 0i32;
    while (i < count) decreases count - i {
        StmtNode:arm = raw ast_stmt(e.ast, raw pick_arm_at(e.ast, start, i));
        PatId:pid2 = raw arm_pattern(arm);
        if (!(raw pat_is_none(pid2))) {
            PatNode:pn = raw ast_pat(e.ast, pid2);
            if (pn.kind == PatKind.PatEnumDestructure) {
                drop type_enum_bindings(e, pid2, pn, selt);
            }
            if (pn.kind == PatKind.PatStructDestructure) {
                drop type_struct_bindings(e, pid2, pn, selt);
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// THE RULES A `pick` SHARES BETWEEN ITS TWO SPELLINGS (1.5.2c step 1): the
// selector kinds that have no arms of their own (a frac, D-198; a complex,
// D-199; an `Optional`, D-260), the consuming `move(v)` selector (D-216) and
// its meaningless-move refusal, the arm bindings' TYPES, and the lending
// form's refusal of an owning binding (1.4.3b). Until this step only the
// STATEMENT form applied them: the EXPRESSION form typed no binding at all,
// so a bound `t` in `pick (s) { (Some(t)) { give t.x; } … }` was an unknown
// the checker asked nothing of, and the emitter met its member read as
// EMIT-002 -- found by this step's first generic-enum program, on a PLAIN
// enum. One function, called by both forms with their own arm window and
// span: a construct means the same thing in both of its spellings.
//
// `ok` is false when the selector was refused and the arms must not be read
// against it; `consuming` says whether the selector is `move(v)`.
pub struct:PickRules = { bool:ok; bool:consuming; };

pub func:type_pick_rules = PickRules(ExprTyper->:e, ExprId:selid, int32:selt,
                                     int32:start, int32:count, Span:at) never fails {
    PickRules:refused = PickRules{ ok: false, consuming: false };
    // A FRAC SELECTOR IS REFUSED BY NAME (D-198, 1.3.5): a frac has no
    // enumerable cases beyond ERR — `is_err` is the look, comparisons
    // are the decisions — and the scalar pick machinery compares one
    // register where a frac is three.
    if (selt != 0i32) {
        if ((raw type_kind(e.types, selt)) == (raw TY_FRAC())) {
            drop diaglist_push(e.diags, raw diag_error(raw TYPE_FRAC_RULES(),
                "a `pick` does not select on a frac (D-198): its only nameable case is ERR — `is_err` is the look, and comparisons are the decisions",
                at));
            pass refused;
        }
        // The same posture for a complex (D-199): equality is the one
        // decision, and its cases are not enumerable.
        if ((raw type_kind(e.types, selt)) == (raw TY_COMPLEX())) {
            drop diaglist_push(e.diags, raw diag_error(raw TYPE_COMPLEX_RULES(),
                "a `pick` does not select on a complex (D-199): equality is its one comparison, and `is_err` looks at tfp elements",
                at));
            pass refused;
        }
        // AND AN `Optional` (D-260, 1.5.2c step 0): it has no arms of its
        // own, and the emitter switches on a selector as its own
        // discriminant -- `{ i8, T }` is not one. `??` reaches the value,
        // `== NIL` tests it; the arms are not walked, having no selector
        // to be read against.
        if ((raw type_kind(e.types, selt)) == (raw TY_OPTIONAL())) {
            drop diaglist_push(e.diags, raw diag_error(raw TYPE_PICK_OPTIONAL(),
                "a `pick` does not select on an `Optional` (D-260): an `Optional` has no arms of its own — reach the value with `??` (`pick (o ?? default) { … }`) or test it with `== NIL`",
                at));
            pass refused;
        }
    }
    // THE CONSUMING SELECTOR (D-216): `pick (move(v))` takes the value
    // apart, so its arms may bind owning payloads — that is the whole
    // point of the form. `move(v)` already parses as a selector
    // expression; nothing in the grammar changed.
    bool:consuming = false;
    if (!(raw expr_is_none(selid))) {
        if ((raw ast_expr(e.ast, selid)).kind == ExprKind.ExprMoveExpr) {
            consuming = true;
        }
    }
    // ...and `move` on a selector that owns NOTHING is the same meaningless
    // move it is anywhere else.
    if (consuming) {
        if (selt != 0i32) {
            // THE DROP FLAG IS MEMOISED BY THE LAYOUT PASS, and an enum's
            // is 0 until something asks for its layout — so the question
            // has to make sure it has been computed before reading the
            // answer, or every consuming pick is told its selector owns
            // nothing.
            TypeResolver:lr = raw etyper_resolver(e);
            if (!(raw type_drops(@lr, selt, e.scope, 64i32))) {
                drop diaglist_push(e.diags, raw diag_error(raw TYPE_MOVE_REQUIRED(),
                    "`pick (move(v))` consumes a value that OWNS something (D-216); this selector's type owns nothing, so there is nothing to transfer — select on it directly",
                    at));
            }
        }
    }
    // AN `Error` SELECTOR'S ARMS ARE READ HERE (D-275, 1.5.4d): it binds
    // nothing and enumerates nothing, so the two walks below have no work
    // on it, and until this step no rule read an arm over one at all.
    if (selt != 0i32) {
        if ((raw type_kind(e.types, selt)) == (raw TY_ERROR())) {
            drop check_error_arms(e, start, count);
        }
    }
    drop type_pick_bindings(e, selt, start, count);
    drop check_pick_view_binds(e, selt, consuming, start, count);
    pass (PickRules{ ok: true, consuming: consuming });
};

// EVERY ARM OVER AN `Error` SELECTOR (D-275, 1.5.4d step 1) -- `failsafe`'s
// pick and any other, both spellings. An arm is `(*)`, a name bound to an
// error constant (`(Boom)`, `(DeadlineExceeded)`), or the two-segment
// bind-free IDENTITY `(file.Name)`: the FILE that declares a constant
// qualifies it, an inline module qualifies nothing (D-179). The identity is
// checked as a PAIR against the constants the program declares (R-3): its
// hash must be a code the resolver assigned, else RESOLVE-002 at the arm
// with the fix named -- `(hidden.Boom)`, `(file.Nosuch)` and `(nosuch.Boom)`
// all hashed to a code no constant has and matched nothing, silently, until
// this step. Any other shape -- a literal, a global, a range, a struct
// destructure, a destructure with bindings or with one or three-plus
// segments, an `ERR:` arm -- is TYPE-007 here (R-4), where it reached the
// emitter and died as EMIT-002, a compiler-defect report for a program
// mistake. One mistake, one report (D-240): a refused shape is not also
// asked its identity, and an identity that names nothing is one sentence.
func:check_error_arms = NIL(ExprTyper->:e, int32:start, int32:count) never fails {
    int32:i = 0i32;
    while (i < count) decreases count - i {
        StmtNode:arm = raw ast_stmt(e.ast, raw pick_arm_at(e.ast, start, i));
        PatId:apid = raw arm_pattern(arm);
        if (!(raw pat_is_none(apid))) {
            PatNode:pn = raw ast_pat(e.ast, apid);
            bool:ok = false;
            if (pn.kind == PatKind.PatWildcard) { ok = true; }
            if (pn.kind == PatKind.PatValue) { ok = raw error_value_pattern(e, pn); }
            if (pn.kind == PatKind.PatEnumDestructure) {
                ok = true;
                drop check_error_identity_arm(e, pn);
            }
            if (!ok) { drop error_arm_shape(e, pn.span); }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// `(Name)`: an identifier the resolver bound to an error constant's
// declaration -- a user constant imported or declared here, or a system
// constant the prelude binds into every scope.
func:error_value_pattern = bool(ExprTyper->:e, PatNode:pn) never fails {
    ExprId:v = raw pat_value(pn);
    if (raw expr_is_none(v)) { pass false; }
    ExprNode:vn = raw ast_expr(e.ast, v);
    if (vn.kind != ExprKind.ExprIdentifierExpr) { pass false; }
    if (vn.a == 0i32) { pass false; }
    Symbol:s = raw symtab_get(e.tab, vn.a);
    if (s.origin_kind != (raw SYM_DECL())) { pass false; }
    DeclNode:d = raw ast_decl(e.ast, DeclId{ index: s.origin });
    pass (d.kind == DeclKind.DeclErrorDecl);
};

func:error_arm_shape = NIL(ExprTyper->:e, Span:at) never fails {
    discard(raw te_error(e, raw TYPE_MISMATCH(),
        "an `Error` arm names an error constant -- `(Name)`, or `(file.Name)` qualified by the file that declares it (D-179, D-275): an error carries no payload to bind, no range and no `ERR`, and a literal, a binding or a global is not an identity",
        at));
    pass NIL;
};

// `(file.Name)`: two segments, no binding, and a pair some loaded file's
// constant hashes to -- else the refusal says which file declares `Name`
// (a note at each such declaration) and, when the first segment is a module
// symbol in scope whose scope holds the constant, the `use` spelling.
func:check_error_identity_arm = NIL(ExprTyper->:e, PatNode:pn) never fails {
    if ((raw pat_enum_segment_count(e.ast, pn)) != 2i32) {
        drop error_arm_shape(e, pn.span);
        pass NIL;
    }
    if ((raw pat_enum_bind_count(e.ast, pn)) != 0i32) {
        drop error_arm_shape(e, pn.span);
        pass NIL;
    }
    int32:qual = raw pat_enum_segment(e.ast, pn, 0i32);
    int32:name = raw pat_enum_segment(e.ast, pn, 1i32);
    if ((raw symtab_error_by_code(e.tab, raw error_identity(e.interns, qual, name))) != 0i32) {
        pass NIL;
    }
    string:m1 = string_concat("`", raw intern_get(e.interns, qual));
    string:m2 = string_concat(m1, ".");
    string:m3 = string_concat(m2, raw intern_get(e.interns, name));
    string:msg = string_concat(m3, "` names no error constant of this program (D-275): an identity is `file.Name`, qualified by the FILE that declares it -- an inline module qualifies nothing (D-179)");
    int32:n = raw symtab_error_count(e.tab);
    bool:any_named = false;
    for (int32:i in 0i32...n) {
        DeclNode:ed = raw ast_decl(e.ast, DeclId{ index: raw symtab_error_decl_at(e.tab, i) });
        if ((raw decl_name(ed)) == name) {
            any_named = true;
            string:q = raw intern_get(e.interns, raw symtab_error_qual_at(e.tab, i));
            msg = string_concat(msg, "; `");
            msg = string_concat(msg, raw intern_get(e.interns, name));
            msg = string_concat(msg, "` is declared in `");
            msg = string_concat(msg, q);
            msg = string_concat(msg, "` -- write `(");
            msg = string_concat(msg, q);
            msg = string_concat(msg, ".");
            msg = string_concat(msg, raw intern_get(e.interns, name));
            msg = string_concat(msg, ")`");
        }
    }
    if (!any_named) {
        msg = string_concat(msg, "; no loaded file declares `");
        msg = string_concat(msg, raw intern_get(e.interns, name));
        msg = string_concat(msg, "`");
    }
    int32:msym = raw scope_lookup(e.tab, e.scope, qual);
    if (msym != 0i32) {
        int32:mscope = raw module_symbol_scope(e, msym);
        if (mscope != 0i32) {
            int32:csym = raw scope_lookup_local(e.tab, mscope, name);
            if (csym != 0i32) {
                Symbol:cs = raw symtab_get(e.tab, csym);
                if (cs.origin_kind == (raw SYM_DECL())) {
                    if ((raw ast_decl(e.ast, DeclId{ index: cs.origin })).kind == DeclKind.DeclErrorDecl) {
                        msg = string_concat(msg, "; or `use ");
                        msg = string_concat(msg, raw intern_get(e.interns, qual));
                        msg = string_concat(msg, ".{");
                        msg = string_concat(msg, raw intern_get(e.interns, name));
                        msg = string_concat(msg, "};` and `(");
                        msg = string_concat(msg, raw intern_get(e.interns, name));
                        msg = string_concat(msg, ")`");
                    }
                }
            }
        }
    }
    discard(raw te_error(e, raw RESOLVE_UNKNOWN(), move(msg), pn.span));
    for (int32:j in 0i32...n) {
        DeclNode:nd = raw ast_decl(e.ast, DeclId{ index: raw symtab_error_decl_at(e.tab, j) });
        if ((raw decl_name(nd)) == name) {
            drop diaglist_push(e.diags, raw diag_note(raw RESOLVE_UNKNOWN(), "declared here", nd.span));
        }
    }
    pass NIL;
};

// A WINDOW OF BINDING TYPES, one per binding in binding order, its start on the
// pattern's payload slot (1.0.9c). A single-payload enum used to record its one
// type on slot `a`; a multi-payload binding recorded nothing and typed as
// unknown, and a struct binding was skipped entirely — both left the arm body
// checked against nothing. `type_ident` reads a binding's type back by finding
// its index among the pattern's names, so the checker holds the body to the
// destructured types the way construction and binding do at the backend.
func:type_enum_bindings = NIL(ExprTyper->:e, PatId:pid2, PatNode:pn,
                              int32:selt) never fails {
    int32:bc = raw pat_enum_bind_count(e.ast, pn);
    if (bc == 0i32) { pass NIL; }
    int32:segs = raw pat_enum_segment_count(e.ast, pn);
    if (segs <= 0i32) { pass NIL; }
    int32:vname = raw pat_enum_segment(e.ast, pn, segs - 1i32);
    DeclId:did = DeclId{ index: raw type_decl(e.types, selt) };
    DeclNode:d = raw ast_decl(e.ast, did);
    int32:home = raw symtab_home_scope(e.tab, did.index, e.scope);
    TypeResolver:r = raw etyper_resolver(e);
    // THE INSTANCE'S ARGUMENTS BOUND (D-261, 1.5.2c): a binding in
    // `(Opt.Some(v))` over an `Opt<string>` selector is a `string`, over an
    // `Opt<T>` inside a generic body the parameter -- the struct rule
    // (`struct_field`) applied to a payload.
    GenericScope:bsaved = raw bind_instance(@r, selt);
    int32:vi = 0i32;
    int32:nmembers = raw item_member_count(e.ast, d);
    while (vi < nmembers) decreases nmembers - vi {
        DeclNode:m = raw ast_decl(e.ast, raw item_member(e.ast, d, vi));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == vname) {
                int32:mark = raw ast_scratch_mark(e.ast);
                for (int32:j in 0i32...bc) {
                    int32:pt = 0i32;
                    if (j < (raw variant_payload_count(m))) {
                        pt = raw resolve_type(@r,
                            TypeId{ index: raw ast_id_at(e.ast,
                                        raw variant_payload_start(m), j) },
                            home);
                    }
                    // a callable pattern binding may not take a builtin's name (D-296)
                    drop check_callable_name(e, raw pat_enum_bind(e.ast, pn, j), pt, "a `pick` pattern's binding", pn.span);
                    drop ast_scratch_push(e.ast, pt);
                }
                IdSpan:w = raw ast_scratch_commit(e.ast, mark);
                drop ast_set_pat_payload(e.ast, pid2, w.start => int64);
                r.generics = bsaved;
                pass NIL;
            }
        }
        vi = vi + 1i32;
    }
    r.generics = bsaved;
    pass NIL;
};

// A STRUCT PATTERN'S BINDINGS ARE ITS FIELDS BY NAME (1.0.9c): `(Point{ x, y })`
// binds `x` and `y` to the fields so named. The window holds each binding's
// field type in binding order; a name that is no field is left `0` (unknown),
// the struct-literal checker's own "no such field" is the diagnostic for it.
func:type_struct_bindings = NIL(ExprTyper->:e, PatId:pid2, PatNode:pn,
                                int32:selt) never fails {
    int32:bc = raw pat_bind_count(pn);
    if (bc == 0i32) { pass NIL; }
    int32:bstart = raw pat_bind_start(pn);
    TypeResolver:r = raw etyper_resolver(e);
    int32:mark = raw ast_scratch_mark(e.ast);
    for (int32:j in 0i32...bc) {
        int32:fname = raw ast_id_at(e.ast, bstart, j);
        FieldInfo:fi = raw struct_field(@r, selt, fname, e.scope);
        int32:ft = 0i32;
        if (fi.found) { ft = fi.type_id; }
        // A `hidden` FIELD IS NOT BOUND FROM OUTSIDE ITS MODULE (D-314,
        // TYPE-080): binding it by name reads it.
        if (fi.found) {
            discard(raw refuse_hidden_touch(e, selt, fname, "struct pattern", pn.span));
        }
        // a callable pattern binding may not take a builtin's name (D-296): a
        // struct pattern binds its field BY NAME, so a function-typed field
        // named after a builtin is declared and called through its receiver,
        // and is not destructured
        drop check_callable_name(e, fname, ft, "a `pick` pattern's binding", pn.span);
        drop ast_scratch_push(e.ast, ft);
    }
    IdSpan:w = raw ast_scratch_commit(e.ast, mark);
    drop ast_set_pat_payload(e.ast, pid2, w.start => int64);
    pass NIL;
};

// THE SELECTOR IS FROZEN INSIDE AN ARM THAT BINDS A VIEW (D-266, 1.5.2h): its
// root -- through views, so `pick (s.kind)` freezes `s` -- is pushed for the
// arm's guard and body and popped after; every write path asks `place_frozen`.
// An arm that binds nothing lends nothing and pushes nothing; a selector with
// no root (a temporary) has nothing to freeze. The consuming form owns.
func:check_arms = NIL(ExprTyper->:e, ExprId:sel, bool:consuming, int32:start,
                      int32:count) never fails {
    int32:froot = 0i32;
    if (!consuming) { froot = raw root_sym_through_views(e, sel, 64i32); }
    for (int32:i in 0i32...count) {
        StmtId:aid = raw pick_arm_at(e.ast, start, i);
        bool:frz = false;
        if (froot != 0i32) {
            if (raw arm_binds_name(e, raw ast_stmt(e.ast, aid))) { frz = true; }
        }
        if (frz) { drop list_push(@e.frozen, froot); }
        drop check_stmt(e, aid);
        if (frz) { discard(raw list_pop(@e.frozen)); }
    }
    pass NIL;
};

// `for (T:x in e)` — WHAT `e` IS, AND THAT `T` IS ITS ELEMENT (D-166, 1.0.9).
// Until 1.0.9 this typed the iterable and the body and never looked at the
// binding: `for (int8:i in 300i64..302i64)` passed and `llc` refused the IR,
// and `for (int32:v in p)` over a struct reached the backend, which refused
// it as a rung — calling it valid. A range, a slice and an array iterate
// their element; an `Iterator` implementor joins them at 1.0.9d with its
// lowering; anything else is refused here by name.
func:check_for = NIL(ExprTyper->:e, StmtNode:s) never fails {
    int32:it = raw type_of_expr(e, raw stmt_for_iter(e.ast, s));
    if (it == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, it)) { pass NIL; }
    // ONE LEVEL OF AUTO-DEREFERENCE (D-098), as `.` and UFCS do: `for` over a
    // BORROW of a collection — `@arr`, an `int32[4]->` — reaches the element,
    // and the borrow analysis is what refuses it (D-004: a for-binding over a
    // borrowed collection is untracked). Preempting it here with a type error
    // would move a safety refusal to the wrong stage and lose its diagnostic.
    int32:it1 = it;
    if ((raw type_kind(e.types, it)) == (raw TY_POINTER())) {
        it1 = raw type_elem(e.types, it);
    }
    int32:k = raw type_kind(e.types, it1);
    TypeResolver:r = raw etyper_resolver(e);
    int32:elem = 0i32;
    if (k == (raw TY_RANGE())) { elem = raw type_elem(e.types, it1); }
    if (k == (raw TY_SLICE())) { elem = raw type_elem(e.types, it1); }
    if (k == (raw TY_ARRAY())) { elem = raw type_elem(e.types, it1); }
    // AN `Iterator` IMPLEMENTOR (D-166, 1.0.9d): the element is the trait's
    // `Item` associated type as this type binds it. `assoc_binding_of` returns 0
    // when the type has no `Iterator` impl, which is exactly the not-iterable
    // case below — so no separate `type_implements` is needed.
    if (elem == 0i32) {
        int32:iter_name = raw intern_add(e.interns, "Iterator");
        int32:iter_sym = raw scope_lookup(e.tab, e.scope, iter_name);
        if (iter_sym != 0i32) {
            Symbol:isym = raw symtab_get(e.tab, iter_sym);
            if (isym.origin_kind == (raw SYM_DECL())) {
                elem = raw assoc_binding_of(@r, e.impls, it1, isym.origin,
                           raw intern_add(e.interns, "Item"));
            }
        }
    }
    if (elem == 0i32) {
        string:n1 = string_concat("`",
                        raw type_display(e.types, e.interns, it));
        discard(raw te_error(e, raw TYPE_NOT_ITERABLE(),
            string_concat(n1,
                "` is not iterable: `for` takes a range, a slice, an array, or a type implementing `Iterator` (D-023, D-166); `loop`/`till` count"),
            s.span));
        pass NIL;
    }
    DeclNode:bd = raw ast_decl(e.ast, raw stmt_for_binding(s));
    int32:bt = raw resolve_type(@r, raw param_type(bd), e.scope);
    if (bt == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, bt)) { pass NIL; }
    // a callable `for` binding may not take a builtin's name (D-296)
    drop check_callable_name(e, raw decl_name(bd), bt, "a `for` binding", bd.span);
    // EQUAL, NOT `fits`: a typed binding is the element, with no wrap and no
    // widening — the same rule every other typed binding has (D-092).
    if (bt != elem) {
        string:b1 = string_concat("a `for` binding's type is the element type: this iterable yields `",
                        raw type_display(e.types, e.interns, elem));
        string:b2 = string_concat(b1, "` and the binding declares `");
        string:b3 = string_concat(b2, raw type_display(e.types, e.interns, bt));
        discard(raw te_error(e, raw TYPE_MISMATCH(), string_concat(b3, "`"), bd.span));
    }
    pass NIL;
};

func:check_counted = NIL(ExprTyper->:e, StmtNode:s) never fails {
    int32:n = raw stmt_counted_argc(e.ast, s);
    // THE HEAD'S SHAPE (D-022; 1.5.4 step 0, DEF-30): `loop(start, limit,
    // step)` takes three arguments and `till(limit, step)` two. The count was
    // never checked: a two-argument `loop` typed clean, folded under the
    // evaluator's own two-argument reading (DEF-29), and died at the emitter
    // as EMIT-002 with no span.
    int32:want = 3i32;
    string:form = "`loop(start, limit, step)` takes three arguments";
    if (s.kind == StmtKind.StmtTillStmt) {
        want = 2i32;
        form = "`till(limit, step)` takes two arguments";
    }
    if (n != want) {
        string:h1 = string_concat(form, ", and this head has ");
        string:h2 = string_concat(h1, int_to_string(n => int64));
        discard(raw te_error(e, raw TYPE_LOOP_HEAD(),
            string_concat(h2, " (D-022: direction is inferred from the bounds, so the step is never optional and never signed)"),
            s.span));
    }
    for (int32:i in 0i32...n) {
        discard(raw type_of_expr(e, raw stmt_counted_arg(e.ast, s, i)));
    }
    // A LITERAL STEP IS POSITIVE (D-022; DEF-28): a zero step never reaches
    // the bound and a negative one puts the sign in the wrong clause. What
    // the parser can read is refused here (REACH-004's precedent); a computed
    // step is the runtime guard's (`BadStep`) and the `loop-step` row's
    // (1.5.4 step 3). Asked only of a well-formed head: with the count wrong
    // the last argument is not the step.
    if (n == want) {
        StepLit:sl = raw counted_step_literal(e.ast, s);
        if (sl.is_lit && (!sl.positive)) {
            ExprNode:sx = raw ast_expr(e.ast, raw stmt_counted_arg(e.ast, s, n - 1i32));
            discard(raw te_error(e, raw TYPE_LOOP_HEAD(),
                "a counted loop's step must be positive (D-022): direction is inferred from the bounds, so the step only sizes the jump -- a zero step never reaches the bound, and a negative one puts the sign in the wrong clause",
                sx.span));
        }
    }
    e.counted_depth = e.counted_depth + 1i32;
    // The invariant may name `$`, so it is typed inside the counter's window.
    drop check_invariants(e, raw stmt_counted_invariant(e.ast, s));
    string:cform = "a `loop` statement";
    if (s.kind == StmtKind.StmtTillStmt) { cform = "a `till` statement"; }
    drop check_measure(e, raw stmt_counted_measure(e.ast, s), true, cform, s.span);
    drop check_stmt(e, raw stmt_counted_body(s));
    e.counted_depth = e.counted_depth - 1i32;
    pass NIL;
};

func:check_cond = NIL(ExprTyper->:e, StmtNode:s) never fails {
    ExprId:c = raw stmt_cond(s);
    if (raw expr_is_none(c)) { pass NIL; }
    int32:t = raw type_of_expr(e, c);
    if (t == 0i32) { pass NIL; }
    drop require_bool(e, t, s.span);
    pass NIL;
};

// --- the verification surface (1.5.1, D-220/D-221) ---------------------------------------

// A PROPOSITION: typed under its contract context and held to `bool` — the
// sentence every `if` gets. 0 is "already reported": stay silent.
pub func:check_proposition = NIL(ExprTyper->:e, ExprId:c, int32:ctx) never fails {
    if (raw expr_is_none(c)) { pass NIL; }
    int32:saved = e.contract_ctx;
    e.contract_ctx = ctx;
    int32:t = raw type_of_expr(e, c);
    e.contract_ctx = saved;
    if (t == 0i32) { pass NIL; }
    ExprNode:cn = raw ast_expr(e.ast, c);
    drop require_bool(e, t, cn.span);
    pass NIL;
};

// A LOOP'S TERMINATION CLAUSE (D-304, 1.5.8c step 1): `decreases E` or
// `unbounded`, exactly one, before `invariant`, on a `while` or a `when` --
// every other shape is TYPE-072 by name: `for`, `loop` and `till` are bounded
// by construction (D-234, D-022) and take neither; two clauses say two things
// about one loop; a clause after the invariant is out of the one order the
// blueprint asks for. The measure is a PLAIN INTEGER (TYPE-073): a whole
// number that shrinks on every trip and never goes below zero, and only
// `intN`/`uintN` can be one -- a float rounds, a twisted kind carries ERR, a
// `bool` has no order. Typed under CTX_DECREASES, so a contract's rules
// (TYPE-060) hold of it: nothing that fails, suspends, moves or stores.
// A `while`/`when` with NO clause is TYPE-072 too, since 1.5.8c step 4 (D-304
// (6): the tree was swept at step 3, then the `neither` shape joined).
pub func:check_measure = NIL(ExprTyper->:e, VerifyId:m, bool:bounded_form, string:form, Span:at) never fails {
    if (raw verify_is_none(m)) {
        // THE `neither` SHAPE (D-304 (4), (6); live since 1.5.8c step 4, the tree
        // swept at step 3): a `while`/`when` says why it ends, or that it may not.
        if (!bounded_form) {
            discard(raw te_error(e, raw TYPE_LOOP_CLAUSE(),
                "a `while`/`when` states why it ends (D-304): `decreases E`, a whole number that shrinks on every trip and never goes below zero, or `unbounded` -- the acknowledgment that it may not, with the reason on the line above",
                at));
        }
        pass NIL;
    }
    VerifyNode:v = raw ast_verify(e.ast, m);
    if (bounded_form) {
        discard(raw te_error(e, raw TYPE_LOOP_CLAUSE(),
            string_concat(form, " is bounded by construction (D-234, D-022) and takes neither `decreases` nor `unbounded` (D-304)"),
            v.span));
        pass NIL;
    }
    if ((raw measure_count(v)) > 1i32) {
        discard(raw te_error(e, raw TYPE_LOOP_CLAUSE(),
            string_concat(form, " states exactly one of `decreases E` and `unbounded` (D-304): this one states more than one"),
            v.span));
        pass NIL;
    }
    if (raw measure_after_invariant(v)) {
        discard(raw te_error(e, raw TYPE_LOOP_CLAUSE(),
            "the termination clause comes before `invariant` (D-304): `while (c) decreases E invariant P { … }` -- the measure says why the loop ends, the invariant what holds while it runs",
            v.span));
        pass NIL;
    }
    if (raw measure_is_unbounded(v)) { pass NIL; }
    ExprId:me = raw measure_expr(v);
    if (raw expr_is_none(me)) { pass NIL; }
    discard(raw check_measure_expr(e, me));
    pass NIL;
};

// THE MEASURE'S TYPE (TYPE-073): typed under the measure context, a plain
// integer or refused naming the kind it was. Answers the type, 0 when refused
// or already reported.
pub func:check_measure_expr = int32(ExprTyper->:e, ExprId:me) never fails {
    int32:saved = e.contract_ctx;
    e.contract_ctx = raw CTX_DECREASES();
    int32:t = raw type_of_expr(e, me);
    e.contract_ctx = saved;
    if (t == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, t)) { pass 0i32; }
    if ((raw type_kind(e.types, t)) != (raw TY_INT())) {
        ExprNode:mn = raw ast_expr(e.ast, me);
        string:k1 = string_concat("a `decreases` measure is a plain integer (`intN`/`uintN`, D-304) -- a whole number that shrinks on every trip and never goes below zero; this one is `",
                                  raw type_display(e.types, e.interns, t));
        discard(raw te_error(e, raw TYPE_MEASURE_KIND(),
            string_concat(k1, "`"), mn.span));
        pass 0i32;
    }
    pass t;
};

// A loop's invariants: each conjunct a proposition. The reserved NONE handle
// is "no clause", a value rather than an absence to test for.
pub func:check_invariants = NIL(ExprTyper->:e, VerifyId:inv) never fails {
    if (raw verify_is_none(inv)) { pass NIL; }
    VerifyNode:v = raw ast_verify(e.ast, inv);
    int32:n = raw invariant_count(v);
    for (int32:i in 0i32...n) {
        ExprId:c = ExprId{ index: raw ast_id_at(e.ast, raw invariant_start(v), i) };
        drop check_proposition(e, c, raw CTX_INVARIANT());
    }
    pass NIL;
};

// THE SUBJECT OF A `Rules` DECLARATION, resolved in its home scope — SILENTLY.
// The declaration's own arm in `check_decl` is the one reporter of a broken
// subject (a `Rules<Nope>`); every `limit` that names the rule resolves the
// subject again against a scratch diagnostic list, and a subject that does not
// resolve answers 0 here, so one mistake is reported once (D-240).
func:rules_subject_type = int32(ExprTyper->:e, DeclId:rd) never fails {
    DeclNode:dn = raw ast_decl(e.ast, rd);
    if (dn.kind != DeclKind.DeclRuleDecl) { pass 0i32; }
    int32:home = raw symtab_home_scope(e.tab, rd.index, e.scope);
    DiagList:scratch = raw diaglist_init();
    TypeResolver:rr = raw tyres_init(e.ast, e.types, e.tab, e.interns, @scratch, e.instances);
    int32:subject = raw resolve_type(@rr, raw rule_subject(dn), home);
    if ((raw diaglist_count(@scratch)) != 0i64) { pass 0i32; }
    pass subject;
};

// A LIMITED BINDING'S TYPE IS THE RULE'S SUBJECT, BY IDENTITY (1.5.1, D-220):
// the check runs at the binding's own write points on the binding's own
// value, so a rule over another type would need a conversion the author did
// not write. No widening, no `fits`, no `Optional` wrap, no type parameter.
pub func:check_limit_subject = NIL(ExprTyper->:e, VerifyId:lim, int32:declared, Span:at) never fails {
    if (raw verify_is_none(lim)) { pass NIL; }
    if (declared == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, declared)) { pass NIL; }
    VerifyNode:lv = raw ast_verify(e.ast, lim);
    DeclId:rd = raw limit_target(lv);
    if (raw decl_is_none(rd)) { pass NIL; }     // resolution already refused it
    int32:subject = raw rules_subject_type(e, rd);
    if (subject == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, subject)) { pass NIL; }
    if (subject == declared) { pass NIL; }
    string:m1 = string_concat("`limit<", raw intern_get(e.interns, raw limit_rule(lv)));
    string:m2 = string_concat(m1, ">` constrains a `");
    string:m3 = string_concat(m2, raw type_display(e.types, e.interns, subject));
    string:m4 = string_concat(m3, "`, and this binding is a `");
    string:m5 = string_concat(m4, raw type_display(e.types, e.interns, declared));
    string:m6 = string_concat(m5,
        "` (D-220): a rule checks the binding's own value at every write, so the two are one type — write the concrete type the rule names");
    discard(raw te_error(e, raw TYPE_RULES_SUBJECT(), move(m6), at));
    pass NIL;
};

// A LIMITED FIELD'S RULE HOLDS OF THE FIELD'S VACANT VALUE (D-308 SS5; TYPE-077).
// A declared-uninitialised aggregate holds the vacant value (D-225), and a move
// or `pass` out of the field leaves it (S-26). Neither is a write point, so no
// check would ever see that value: the rule is decided over it HERE, once, by
// the constant folder with `$` bound to it. Refused when a clause folds to
// `false`, and refused when a clause is not something the folder evaluates --
// a rule nothing can decide now has no later point to be decided at. The
// vacant value is a number for a plain integer (0), a `bool` (`false`) and a
// `char` (0); every other subject has none the folder holds, and is refused
// with the reason. Refinements are walked: a rule is its own clauses AND its
// refinements', over ONE subject (`check_refine_subject`).
func:field_limit_vacant_walk = int32(ExprTyper->:e, DeclId:rd, int32:subject, int32:fuel) never fails {
    // 0: every clause holds. 1: a clause is false. 2: a clause cannot be decided.
    if (fuel <= 0i32) { pass 2i32; }
    DeclNode:dn = raw ast_decl(e.ast, rd);
    if (dn.kind != DeclKind.DeclRuleDecl) { pass 0i32; }     // resolution already refused it
    int32:home = raw symtab_home_scope(e.tab, rd.index, e.scope);
    TypeResolver:fr = raw etyper_resolver(e);
    int32:rn = raw rule_refine_count(e.ast, dn);
    for (int32:ri in 0i32...rn) {
        VerifyNode:rv = raw ast_verify(e.ast, raw rule_refine(e.ast, dn, ri));
        DeclId:rrd = raw limit_target(rv);
        if (raw decl_is_none(rrd)) { continue; }
        int32:sub = raw field_limit_vacant_walk(e, rrd, subject, fuel - 1i32);
        if (sub != 0i32) { pass sub; }
    }
    int32:cn = raw rule_clause_count(e.ast, dn);
    for (int32:ci in 0i32...cn) {
        ConstVal:cv = raw fold_rule_clause_at(@fr, raw rule_clause(e.ast, dn, ci), home, subject, 0i64);
        if (cv.kind != (raw CV_BOOL())) { pass 2i32; }
        if (cv.num == 0i64) { pass 1i32; }
    }
    pass 0i32;
};

pub func:check_field_limit_vacant = NIL(ExprTyper->:e, VerifyId:lim, int32:declared, int32:sname,
                                        int32:fname, Span:at) never fails {
    if (raw verify_is_none(lim)) { pass NIL; }
    if (declared == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, declared)) { pass NIL; }
    VerifyNode:lv = raw ast_verify(e.ast, lim);
    DeclId:rd = raw limit_target(lv);
    if (raw decl_is_none(rd)) { pass NIL; }                 // resolution already refused it
    int32:subject = raw rules_subject_type(e, rd);
    if (subject != declared) { pass NIL; }                   // TYPE-059 said so already (D-240)
    string:who = string_concat("`", raw intern_get(e.interns, sname));
    who = string_concat(who, ".");
    who = string_concat(who, raw intern_get(e.interns, fname));
    who = string_concat(who, "`");
    string:rname = raw intern_get(e.interns, raw limit_rule(lv));
    int32:k = raw type_kind(e.types, declared);
    bool:numeric = (raw type_is_integer(e.types, declared)) || (k == (raw TY_BOOL())) || (k == (raw TY_CHAR()));
    if (!numeric) {
        string:n1 = string_concat(who, " is limited by `");
        n1 = string_concat(n1, rname);
        n1 = string_concat(n1, "`, and a `");
        n1 = string_concat(n1, raw type_display(e.types, e.interns, declared));
        discard(raw te_error(e, raw TYPE_FIELD_LIMIT_VACANT(), string_concat(n1,
            "` field's vacant value is not one the constant folder holds (D-308): a declared-uninitialised aggregate and a move out of the field both leave the vacant value WITHOUT passing a write point, so a field's rule must be decidable over it at the declaration -- which today means a plain integer, a `bool` or a `char` field"),
            at));
        pass NIL;
    }
    int32:verdict = raw field_limit_vacant_walk(e, rd, declared, 32i32);
    if (verdict == 0i32) { pass NIL; }
    string:vtext = "`0`";
    if (k == (raw TY_BOOL())) { vtext = "`false`"; }
    if (verdict == 1i32) {
        string:m1 = string_concat("`limit<", rname);
        m1 = string_concat(m1, ">` does not hold of ");
        m1 = string_concat(m1, who);
        m1 = string_concat(m1, "'s vacant value, ");
        m1 = string_concat(m1, vtext);
        discard(raw te_error(e, raw TYPE_FIELD_LIMIT_VACANT(), string_concat(m1,
            " (D-308): a declared-uninitialised aggregate holds it (D-225) and a move out of the field leaves it, and neither passes a write point -- so a field's rule must admit the vacant value, or the field can hold a value its rule refuses with no check ever having run"),
            at));
        pass NIL;
    }
    string:u1 = string_concat("`limit<", rname);
    u1 = string_concat(u1, ">` cannot be decided over ");
    u1 = string_concat(u1, who);
    u1 = string_concat(u1, "'s vacant value, ");
    u1 = string_concat(u1, vtext);
    discard(raw te_error(e, raw TYPE_FIELD_LIMIT_VACANT(), string_concat(u1,
        " (D-308): a field's rule is folded at the declaration with `$` bound to the vacant value, and a clause here is not a constant expression over `$` -- a call, a member access or a name the folder does not evaluate. Nothing checks the vacant value later, so the rule must be one the folder can decide"),
        at));
    pass NIL;
};

// A REFINEMENT NAMES A RULE OVER THE SAME SUBJECT (1.5.1, D-220): a refinement
// is a conjunction, and a conjunction has one subject.
func:check_refine_subject = NIL(ExprTyper->:e, VerifyId:ref, int32:subject) never fails {
    VerifyNode:rv = raw ast_verify(e.ast, ref);
    DeclId:rd = raw limit_target(rv);
    if (raw decl_is_none(rd)) { pass NIL; }     // resolution already refused it
    int32:theirs = raw rules_subject_type(e, rd);
    if (theirs == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, theirs)) { pass NIL; }
    if (theirs == subject) { pass NIL; }
    string:m1 = string_concat("`limit<", raw intern_get(e.interns, raw limit_rule(rv)));
    string:m2 = string_concat(m1, ">` refines a rule over `");
    string:m3 = string_concat(m2, raw type_display(e.types, e.interns, theirs));
    string:m4 = string_concat(m3, "` from a rule over `");
    string:m5 = string_concat(m4, raw type_display(e.types, e.interns, subject));
    string:m6 = string_concat(m5,
        "` (D-220): a refinement is a conjunction over ONE subject, so the two rules constrain one type");
    discard(raw te_error(e, raw TYPE_RULES_SUBJECT(), move(m6), rv.span));
    pass NIL;
};

// IS THIS PLACE ROOTED IN THE FRAME'S OWN STORAGE (1.5.1 step 4, D-221)? A
// local, a `pick` binding, or a parameter — the callee's own copy — reached
// through fields and array elements of VALUE types; never through a pointer,
// a slice, a handle (arena storage), a `<-` dereference, or a local that
// holds a borrow of someone else's storage. Reassigning a local that HOLDS a
// pointer is a local store (the address changes, nothing behind it does); a
// store THROUGH it is the member, index or dereference arm's refusal.
func:place_is_local = bool(ExprTyper->:e, ExprId:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = raw ast_expr(e.ast, id);
    if (n.kind == ExprKind.ExprIdentifierExpr) {
        if (n.a == 0i32) { pass false; }
        Symbol:s = raw symtab_get(e.tab, n.a);
        if (s.origin_kind == (raw SYM_PAT())) { pass true; }
        if (s.origin_kind == (raw SYM_STMT())) {
            // A local initialised from a borrow or an address IS that storage.
            StmtNode:sn = raw ast_stmt(e.ast, StmtId{ index: s.origin });
            ExprId:init = raw stmt_decl_init(e.ast, sn);
            if (!(raw expr_is_none(init))) {
                ExprNode:inn = raw ast_expr(e.ast, init);
                if (inn.kind == ExprKind.ExprBorrowExpr)    { pass false; }
                if (inn.kind == ExprKind.ExprAddressOfExpr) { pass false; }
            }
            pass true;
        }
        if (s.origin_kind == (raw SYM_DECL())) {
            DeclNode:dn = raw ast_decl(e.ast, DeclId{ index: s.origin });
            if (dn.kind == DeclKind.DeclParamDecl) { pass true; }
        }
        pass false;
    }
    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_operand(n));
        if (bt != 0i32) {
            int32:bk = raw type_kind(e.types, bt);
            if (bk == (raw TY_POINTER())) { pass false; }
            if (bk == (raw TY_HANDLE()))  { pass false; }
        }
        pass (raw place_is_local(e, raw expr_operand(n), fuel - 1i32));
    }
    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_lhs(n));
        if (bt != 0i32) {
            int32:bk = raw type_kind(e.types, bt);
            if (bk == (raw TY_POINTER())) { pass false; }
            if (bk == (raw TY_SLICE()))   { pass false; }
            if (bk == (raw TY_HANDLE()))  { pass false; }
        }
        pass (raw place_is_local(e, raw expr_lhs(n), fuel - 1i32));
    }
    pass false;
};

// A PLACE ROOTED AT A LIMITED BINDING (1.5.2 step 1, D-251): the root
// identifier's declaration -- a local's `StmtVarDeclStmt` or a parameter's
// `DeclParamDecl` -- carries a `limit<Rules>`. Walks member and index
// operands exactly as `place_is_local` does and never through a pointer,
// slice or handle base, where the storage is not the binding's own. Asked
// AFTER the operand is typed, so the bases' recorded types are there to read.
pub func:place_limited = bool(ExprTyper->:e, ExprId:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = raw ast_expr(e.ast, id);
    if (n.kind == ExprKind.ExprIdentifierExpr) {
        if (n.a == 0i32) { pass false; }
        Symbol:s = raw symtab_get(e.tab, n.a);
        if (s.origin_kind == (raw SYM_STMT())) {
            StmtNode:sn = raw ast_stmt(e.ast, StmtId{ index: s.origin });
            if (sn.kind != StmtKind.StmtVarDeclStmt) { pass false; }
            pass (!(raw verify_is_none(raw stmt_decl_limit(e.ast, sn))));
        }
        if (s.origin_kind == (raw SYM_DECL())) {
            DeclNode:dn = raw ast_decl(e.ast, DeclId{ index: s.origin });
            if (dn.kind != DeclKind.DeclParamDecl) { pass false; }
            pass (!(raw verify_is_none(raw param_limit(dn))));
        }
        pass false;
    }
    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        // A LIMITED FIELD IS LIMITED WHEREVER ITS STRUCT LIVES (D-308 SS4, 1.5.8b
        // step 6): asked BEFORE the pointer-base exit below, because the rule is
        // the field's and not a binding's -- `@p.f` through a pointer is an
        // address no write point sees, exactly as `@s.f` is.
        if (raw member_names_limited_field(e, n)) { pass true; }
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_operand(n));
        if (bt != 0i32) {
            int32:bk = raw type_kind(e.types, bt);
            if (bk == (raw TY_POINTER())) { pass false; }
            if (bk == (raw TY_HANDLE()))  { pass false; }
        }
        pass (raw place_limited(e, raw expr_operand(n), fuel - 1i32));
    }
    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_lhs(n));
        if (bt != 0i32) {
            int32:bk = raw type_kind(e.types, bt);
            if (bk == (raw TY_POINTER())) { pass false; }
            if (bk == (raw TY_SLICE()))   { pass false; }
            if (bk == (raw TY_HANDLE()))  { pass false; }
        }
        pass (raw place_limited(e, raw expr_lhs(n), fuel - 1i32));
    }
    pass false;
};

// A PLACE ROOTED AT A `fixed` BINDING, OR REACHING THROUGH A `fixed` FIELD
// (D-287, 1.5.5 step 1; TYPE-071): a local's `fixed` qualifier, a parameter's,
// a module binding's -- and a field's, wherever the struct lives, since the
// qualifier is the field's own (the bindings analysis's `field_declares_fixed`
// reads the same bit). The root question stops at a pointer, slice or handle
// base exactly as `place_limited` does (the storage there is not the
// binding's own); the field question does not, because `p.f` through a
// pointer reaches the pointee's `fixed` field all the same.
pub func:place_fixed = bool(ExprTyper->:e, ExprId:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = raw ast_expr(e.ast, id);
    if (n.kind == ExprKind.ExprIdentifierExpr) {
        if (n.a == 0i32) { pass false; }
        Symbol:s = raw symtab_get(e.tab, n.a);
        if (s.origin_kind == (raw SYM_STMT())) {
            StmtNode:sn = raw ast_stmt(e.ast, StmtId{ index: s.origin });
            if (sn.kind != StmtKind.StmtVarDeclStmt) { pass false; }
            pass (((raw stmt_quals(e.ast, sn)) & (raw QUAL_FIXED())) != 0i32);
        }
        if (s.origin_kind == (raw SYM_DECL())) {
            DeclNode:dn = raw ast_decl(e.ast, DeclId{ index: s.origin });
            if (dn.kind == DeclKind.DeclParamDecl) {
                pass (((raw param_quals(dn)) & (raw QUAL_FIXED())) != 0i32);
            }
            if (dn.kind == DeclKind.DeclGlobalDecl) {
                pass (((raw global_quals(dn)) & (raw QUAL_FIXED())) != 0i32);
            }
            pass false;
        }
        pass false;
    }
    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_operand(n));
        if (bt != 0i32) {
            int32:st = bt;
            int32:bk = raw type_kind(e.types, bt);
            if (bk == (raw TY_POINTER())) { st = raw type_elem(e.types, bt); }
            if (raw struct_field_fixed(e, st, (raw expr_name(n)) =>! int32)) { pass true; }
            if (bk == (raw TY_POINTER())) { pass false; }
            if (bk == (raw TY_HANDLE()))  { pass false; }
        }
        pass (raw place_fixed(e, raw expr_operand(n), fuel - 1i32));
    }
    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_lhs(n));
        if (bt != 0i32) {
            int32:bk = raw type_kind(e.types, bt);
            if (bk == (raw TY_POINTER())) { pass false; }
            if (bk == (raw TY_SLICE()))   { pass false; }
            if (bk == (raw TY_HANDLE()))  { pass false; }
        }
        pass (raw place_fixed(e, raw expr_lhs(n), fuel - 1i32));
    }
    pass false;
};

// Does this struct type declare the named field `fixed`?
func:struct_field_fixed = bool(ExprTyper->:e, int32:sty, int32:name) never fails {
    pass (((raw struct_field_quals(e, sty, name)) & (raw QUAL_FIXED())) != 0i32);
};

// --- WHO MAY TOUCH A FIELD (D-313, D-314; 1.5.8b step 1) -------------------------
//
// `sealed`: read anywhere, written only by code inside the module that declares
// the struct. `hidden`: neither read nor written outside it. The field's own
// qualifier bits say which; the struct's HOME -- the module scope its
// declaration was collected into (`symtab_home_scope`) -- says whose.

// THE FIELD'S DECLARATION IN A STRUCT TYPE, by name: its DeclId index, or 0 when
// the type is not a struct or declares no such field. A generic instance answers
// through its template's declaration, so an instance's field carries the
// template's qualifiers and the template's module (K-4).
pub func:struct_field_decl = int32(ExprTyper->:e, int32:sty, int32:name) never fails {
    // ONE lookup, shared with the emitter and the encoder (1.5.8b step 6).
    pass (raw struct_field_decl_of(e.ast, e.types, sty, name));
};

// THE NAME A STRUCT WAS DECLARED UNDER -- `Box`, where the type displays as
// `Box<int32>`: a module declares the template, never an instance.
pub func:struct_decl_name = string(ExprTyper->:e, int32:sty) never fails {
    int32:sd = raw type_decl_of(e.types, sty);
    if (sd == 0i32) { pass (raw type_display(e.types, e.interns, sty)); }
    pass (raw intern_get(e.interns, raw decl_name(raw ast_decl(e.ast, DeclId{ index: sd }))));
};

// The named field's qualifier bits, or 0 when there is no such field.
// THE FIELD'S `limit<Rules>` (D-308, 1.5.8b step 6), or none: the one lookup the
// address refusal, the write points and the encoder's read facts share.
pub func:struct_field_limit = VerifyId(ExprTyper->:e, int32:sty, int32:name) never fails {
    int32:fldd = raw struct_field_decl(e, sty, name);
    if (fldd == 0i32) { pass (raw verify_none()); }
    pass (raw field_limit(raw ast_decl(e.ast, DeclId{ index: fldd })));
};

// DOES THIS MEMBER ACCESS NAME A LIMITED FIELD? The base's struct is read
// THROUGH a pointer (`.` auto-dereferences, D-098): a field's rule belongs to
// the field wherever its struct lives, which is what makes `p.f = v` a write
// point and `@p.f` an address no write point could see.
pub func:member_names_limited_field = bool(ExprTyper->:e, ExprNode:n) never fails {
    if (n.kind != ExprKind.ExprMemberAccessExpr) { pass false; }
    int32:bt = raw exprtypes_get(e.expr_types, raw expr_operand(n));
    if (bt == 0i32) { pass false; }
    if ((raw type_kind(e.types, bt)) == (raw TY_POINTER())) { bt = raw type_elem(e.types, bt); }
    if (bt == 0i32) { pass false; }
    if ((raw type_kind(e.types, bt)) != (raw TY_STRUCT())) { pass false; }
    pass (!(raw verify_is_none(raw struct_field_limit(e, bt, n.payload =>! int32))));
};

pub func:struct_field_quals = int32(ExprTyper->:e, int32:sty, int32:name) never fails {
    int32:fldd = raw struct_field_decl(e, sty, name);
    if (fldd == 0i32) { pass 0i32; }
    pass (raw field_quals(raw ast_decl(e.ast, DeclId{ index: fldd })));
};

// IS THE CODE BEING TYPED OUTSIDE THE MODULE THAT DECLARES THIS STRUCT? The line
// a private member draws (MODULE_REFERENCE §3; `ns_visible`): code whose scope
// sits within the struct's home module scope -- a nested inline module's
// included -- is inside, and everything else is outside. A struct whose home
// was never recorded counts as outside: a rule that cannot find the owner
// refuses rather than guesses (DEF-54's lesson -- the default of an enumeration
// is the safe reading).
pub func:struct_outside = bool(ExprTyper->:e, int32:sty) never fails {
    int32:sd = raw type_decl_of(e.types, sty);
    if (sd == 0i32) { pass true; }
    int32:home = raw symtab_home_scope(e.tab, sd, 0i32);
    if (home == 0i32) { pass true; }
    pass (!(raw scope_is_inside(e.tab, e.scope, home)));
};

// A COMPILER-KNOWN CONTAINER'S HEADER (D-313 §4): `ptr`, `len` and `cap` of a
// string, a `cstring`, a slice and a `buffer` -- the words that say where the
// storage is and how much of it the value may touch. No module declares them,
// so they are SEALED in every module, the prelude's included: a header is
// written where its value is made, by the floor or the emitter, and nowhere
// else. `bt` is the base's type after auto-dereference.
pub func:is_container_header = bool(ExprTyper->:e, int32:bt, int32:name) never fails {
    if (bt == 0i32) { pass false; }
    int32:k = raw type_kind(e.types, bt);
    // AN `OwnedFd`'s `.value` IS ITS IDENTITY WORD (D-185): the number its drop
    // closes, written by `own_fd` and nowhere else -- a header in every sense
    // the containers' are, and until 1.5.8b refused only as the direct target
    // of an assignment (`@f.value` was accepted, and a store through it leaked
    // one descriptor and double-closed another).
    if (k == (raw TY_OWNEDFD())) {
        pass (raw string_eq(raw intern_get(e.interns, name), "value"));
    }
    bool:kind_ok = (k == (raw TY_STRING()));
    if (k == (raw TY_CSTRING())) { kind_ok = true; }
    if (k == (raw TY_SLICE()))   { kind_ok = true; }
    if (k == (raw TY_BUFFER()))  { kind_ok = true; }
    if (!kind_ok) { pass false; }
    string:f = raw intern_get(e.interns, name);
    if (raw string_eq(f, "ptr")) { pass true; }
    if (raw string_eq(f, "len")) { pass true; }
    if (raw string_eq(f, "cap")) { pass true; }
    pass false;
};

// AN `RGuard`'s `.value` IS A SHARED HOLD'S VIEW OF THE ELEMENT (D-056): read
// through it, never written -- a write is the unsynchronized mutation the write
// lock exists to serialize. Until 1.5.8b it was refused only as the direct
// target of an assignment: `g.value.x = 5`, `@g.value.y` and `$$m g.value.x`
// were accepted, each a write through a hold other readers share.
pub func:is_rguard_value = bool(ExprTyper->:e, int32:bt, int32:name) never fails {
    if (bt == 0i32) { pass false; }
    if ((raw type_kind(e.types, bt)) != (raw TY_RGUARD())) { pass false; }
    pass (raw string_eq(raw intern_get(e.interns, name), "value"));
};

// THE MEMBER ACCESS A WRITE TO THIS PLACE WRITES THAT IT MAY NOT, or 0: walked
// outward-in, each member access's field is asked -- a `sealed` field of a
// struct this code is outside, a compiler-known header, a read hold's view --
// and a place that is a part of a VALUE is part of what is written, so the walk
// continues into the value. It stops at a pointer, a slice or a handle base, as `place_fixed`'s
// root question does: a write through `p.f`'s pointer writes the pointee, not the
// pointer, and the pointee's own field was asked at `.f` already.
pub func:place_sealed_access = int32(ExprTyper->:e, ExprId:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass 0i32; }
    if (raw expr_is_none(id)) { pass 0i32; }
    ExprNode:n = raw ast_expr(e.ast, id);
    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        int32:bt = raw exprtypes_get(e.expr_types, raw expr_operand(n));
        if (bt == 0i32) { pass 0i32; }
        int32:bk = raw type_kind(e.types, bt);
        int32:st = bt;
        if (bk == (raw TY_POINTER())) { st = raw type_elem(e.types, bt); }
        int32:fname = (raw expr_name(n)) =>! int32;
        if (raw is_container_header(e, st, fname)) { pass id.index; }
        if (raw is_rguard_value(e, st, fname)) { pass id.index; }
        if (((raw struct_field_quals(e, st, fname)) & (raw QUAL_SEALED())) != 0i32) {
            if (raw struct_outside(e, st)) { pass id.index; }
        }
        if (bk == (raw TY_POINTER())) { pass 0i32; }
        if (bk == (raw TY_HANDLE()))  { pass 0i32; }
        pass (raw place_sealed_access(e, raw expr_operand(n), fuel - 1i32));
    }
    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:ib = raw exprtypes_get(e.expr_types, raw expr_lhs(n));
        if (ib == 0i32) { pass 0i32; }
        int32:ik = raw type_kind(e.types, ib);
        if (ik == (raw TY_POINTER())) { pass 0i32; }
        if (ik == (raw TY_SLICE()))   { pass 0i32; }
        if (ik == (raw TY_HANDLE()))  { pass 0i32; }
        pass (raw place_sealed_access(e, raw expr_lhs(n), fuel - 1i32));
    }
    pass 0i32;
};

// TYPE-079 FOR FIELD `fname` OF `st` (the base's type after auto-dereference):
// a container's header, or a declared `sealed` field this code is outside.
// `what` names the write form ("assignment", "address (`@`)", …) as
// `refuse_write_path` does.
pub func:report_sealed = NIL(ExprTyper->:e, int32:st, int32:fname, string:what,
                             Span:at) never fails {
    // A SHARED HOLD IS READ-ONLY (D-056, 1.1.11b), at every write form.
    if (raw is_rguard_value(e, st, fname)) {
        string:r1 = string_concat("an `RGuard`'s `.value` is READ-ONLY (D-056): a read hold is shared, and this ", what);
        discard(raw te_error(e, raw TYPE_MISMATCH(),
            string_concat(r1, " would write through it -- the unsynchronized mutation the write lock exists to serialize; acquire `write` for a `Guard`"),
            at));
        pass NIL;
    }
    string:fs = raw intern_get(e.interns, fname);
    string:ts = raw type_display(e.types, e.interns, st);
    if ((raw type_kind(e.types, st)) == (raw TY_OWNEDFD())) {
        string:o1 = string_concat("an `OwnedFd`'s `.value` is its identity, SEALED by definition (D-185, D-313): the number its drop closes, written by `own_fd` alone -- this ", what);
        discard(raw te_error(e, raw TYPE_SEALED_WRITE(),
            string_concat(o1, " would leak one descriptor and double-close another; wrap a new descriptor with `own_fd` instead"),
            at));
        pass NIL;
    }
    if (raw is_container_header(e, st, fname)) {
        string:h1 = string_concat("`", fs);
        string:h2 = string_concat(h1, "` of this `");
        string:h3 = string_concat(h2, ts);
        string:h4 = string_concat(h3, "` is its header, SEALED by definition (D-313): a string's, a `cstring`'s, a slice's and a `buffer`'s `ptr`, `len` and `cap` say where the storage is and how much of it the value may touch, and they are written only where the value is made -- this ");
        string:h5 = string_concat(h4, what);
        discard(raw te_error(e, raw TYPE_SEALED_WRITE(),
            string_concat(h5, " would change what the storage claims to hold; make a new value instead (`string_slice`, `string_concat`, `buffer_new`)"),
            at));
        pass NIL;
    }
    string:s1 = string_concat("`", ts);
    string:s2 = string_concat(s1, ".");
    string:s3 = string_concat(s2, fs);
    string:s4 = string_concat(s3, "` is `sealed` (D-313): it is read anywhere and written only by the module that declares `");
    string:s5 = string_concat(s4, raw struct_decl_name(e, st));
    string:s6 = string_concat(s5, "`, and this ");
    string:s7 = string_concat(s6, what);
    discard(raw te_error(e, raw TYPE_SEALED_WRITE(),
        string_concat(s7, " is outside it -- call a function of that module, which keeps what the seal protects"),
        at));
    int32:fldd = raw struct_field_decl(e, st, fname);
    if (fldd != 0i32) {
        drop diaglist_push(e.diags, raw diag_note(raw TYPE_SEALED_WRITE(), "declared `sealed` here",
                                                  (raw ast_decl(e.ast, DeclId{ index: fldd })).span));
    }
    pass NIL;
};

// TYPE-079 WHERE A WRITE FORM MEETS A PLACE: true when reported; the caller then
// types as invalid and says nothing more (D-240).
pub func:refuse_sealed_write = bool(ExprTyper->:e, ExprId:place, string:what, Span:at) never fails {
    int32:hit = raw place_sealed_access(e, place, 64i32);
    if (hit == 0i32) { pass false; }
    ExprNode:hn = raw ast_expr(e.ast, ExprId{ index: hit });
    int32:bt = raw exprtypes_get(e.expr_types, raw expr_operand(hn));
    int32:st = bt;
    if ((raw type_kind(e.types, bt)) == (raw TY_POINTER())) { st = raw type_elem(e.types, bt); }
    drop report_sealed(e, st, (raw expr_name(hn)) =>! int32, what, at);
    pass true;
};

// A `move` OR `pass` OUT OF AN OWNING SEALED FIELD, OR OUT OF ANY PART OF ONE:
// the type's vacant value is left in the place (D-254), which is a write --
// refused from outside the module as every write is. A copyable field is
// copied out and nothing is written; the whole binding may be moved. Asked
// after the operand is typed; `refuse_move_out_of_limited`'s twin.
pub func:refuse_move_out_of_sealed = NIL(ExprTyper->:e, ExprId:id, int32:ty,
                                         Span:at) never fails {
    if (ty == 0i32) { pass NIL; }
    if (raw expr_is_none(id)) { pass NIL; }
    ExprNode:n = raw ast_expr(e.ast, id);
    if (n.kind == ExprKind.ExprIdentifierExpr) { pass NIL; }
    TypeResolver:r = raw etyper_resolver(e);
    if (!(raw type_drops(@r, ty, e.scope, 64i32))) { pass NIL; }
    discard(raw refuse_sealed_write(e, id,
        "move out (the vacant value it leaves behind is a write, D-254)", at));
    pass NIL;
};

// A FIELD QUALIFIER OFF A FIELD (TYPE-081): `sealed` and `hidden` say which code
// may write, or touch, a struct FIELD -- and only a field has an owner (the
// module that declares its struct) distinct from the code that uses it. On a
// local, a parameter, a module binding or a cast target there is no such
// owner, and the word would claim a protection nothing gives. (A `for` binding
// takes no qualifier at all: its parser reads a type first.)
pub func:refuse_field_quals = NIL(ExprTyper->:e, int32:q, string:what, Span:at) never fails {
    int32:fq = (raw QUAL_SEALED()) | (raw QUAL_HIDDEN());
    if ((q & fq) == 0i32) { pass NIL; }
    string:m1 = string_concat("`sealed` and `hidden` qualify a struct FIELD (D-313, D-314): they say which code may write it, or touch it, and only a field has an owner -- the module that declares its struct -- distinct from the code that uses it; this is ", what);
    discard(raw te_error(e, raw TYPE_FIELD_QUAL(), string_concat(m1, ", which has none"), at));
    pass NIL;
};

// TYPE-080 AT A TOUCH OF A `hidden` FIELD FROM OUTSIDE ITS MODULE: a member
// access in any position, a struct literal naming it, a struct pattern binding
// it, a call through a function-valued one. `sty` is the struct type, `fname`
// the field's name; true when reported.
pub func:refuse_hidden_touch = bool(ExprTyper->:e, int32:sty, int32:fname, string:what,
                                    Span:at) never fails {
    if (((raw struct_field_quals(e, sty, fname)) & (raw QUAL_HIDDEN())) == 0i32) { pass false; }
    if (!(raw struct_outside(e, sty))) { pass false; }
    string:ts = raw type_display(e.types, e.interns, sty);
    string:h1 = string_concat("`", ts);
    string:h2 = string_concat(h1, ".");
    string:h3 = string_concat(h2, raw intern_get(e.interns, fname));
    string:h4 = string_concat(h3, "` is `hidden` (D-314): no code outside the module that declares `");
    string:h5 = string_concat(h4, raw struct_decl_name(e, sty));
    string:h6 = string_concat(h5, "` reads or writes it, and this ");
    string:h7 = string_concat(h6, what);
    discard(raw te_error(e, raw TYPE_HIDDEN_FIELD(),
        string_concat(h7, " is outside it -- use the functions that module gives"),
        at));
    int32:fldd = raw struct_field_decl(e, sty, fname);
    if (fldd != 0i32) {
        drop diaglist_push(e.diags, raw diag_note(raw TYPE_HIDDEN_FIELD(), "declared `hidden` here",
                                                  (raw ast_decl(e.ast, DeclId{ index: fldd })).span));
    }
    pass true;
};

// `Type:name = init;` — the initialiser is checked against the ANNOTATION, and
// the annotation is also what an unsuffixed literal in the initialiser takes its
// type from. `int8:n = 10;` works for that reason and for no other: nothing is
// inferred, the type was written down and the literal reads it.
func:check_var_decl = NIL(ExprTyper->:e, StmtId:sid, StmtNode:s) never fails {
    TypeResolver:r = raw etyper_resolver(e);
    TypeId:ann = raw stmt_decl_type(s);
    int32:want = raw resolve_type(@r, ann, e.scope);

    // a callable local may not take a builtin's name (D-296)
    drop check_callable_name(e, raw stmt_name(s), want, "a local", s.span);
    // a local has no owner distinct from its user (D-313, D-314; TYPE-081)
    drop refuse_field_quals(e, raw stmt_quals(e.ast, s), "a local", s.span);

    // A LOCAL'S `limit<Rules>` (1.5.1, D-220): the rule's subject is the
    // declared type, by identity.
    drop check_limit_subject(e, raw stmt_decl_limit(e.ast, s), want, s.span);

    // A `limit` WHERE NO WRITE POINT EXISTS (1.5.2 step 1, D-251): a
    // `wild`/`wildx` binding is written through pointers, by the manual
    // regime, where no write point sees it; a `comptime` function's local is
    // evaluated by the frontend folder, and the check is the emitter's.
    VerifyId:vlim = raw stmt_decl_limit(e.ast, s);
    if (!(raw verify_is_none(vlim))) {
        int32:lq = raw stmt_quals(e.ast, s);
        if ((lq & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32) {
            discard(raw te_error(e, raw TYPE_LIMIT_NO_WRITE_POINT(),
                "a `wild`/`wildx` binding cannot carry a `limit` (D-251): its writes are the manual regime's, through pointers, and no write point sees them",
                s.span));
        }
        if (e.fn_comptime) {
            discard(raw te_error(e, raw TYPE_LIMIT_NO_WRITE_POINT(),
                "a `comptime` function's local cannot carry a `limit` (D-251): the frontend folder evaluates it, and the check is the emitter's",
                s.span));
        }
    }

    // A `pure` BODY DECLARES NO MANUAL MEMORY AND NO OWNER (1.5.1, D-221):
    // `wild`/`wildx` storage is an effect by definition, and an owning local's
    // scope-exit drop is generated code that frees.
    if (e.fn_pure) {
        int32:pq = raw stmt_quals(e.ast, s);
        if ((pq & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32) {
            discard(raw te_error(e, raw TYPE_PURE_RULES(),
                "a `pure` body declares no `wild`/`wildx` storage (D-221): manual memory is an effect by definition",
                s.span));
        } else {
            if (want != 0i32) {
                if (!(raw type_is_invalid(e.types, want))) {
                    if (raw type_drops(@r, want, e.scope, 64i32)) {
                        discard(raw te_error(e, raw TYPE_PURE_RULES(),
                            "a `pure` body declares no owning local (D-221): its scope-exit drop frees storage, an effect — read the owners passed in, and compute scalars",
                            s.span));
                    }
                }
            }
        }
    }

    // AN OWNING DECL IS RECORDED FOR THE SUSPEND WALK (D-183, 1.2.4b): its
    // drop at scope exit is a use the source text does not show, so a local
    // of an owning type must be frame-resident whenever a suspension sits
    // between its declaration and the function's end — even when its last
    // MENTION is earlier. The checker is where the declared type is resolved,
    // so the fact is recorded here and travels on `ExprTypes` like `cross`.
    // Before the init check: an uninitialised owning decl still drops.
    if (want != 0i32) {
        if (raw type_drops(@r, want, e.scope, 64i32)) {
            drop exprtypes_mark_owning_decl(e.expr_types, sid.index);
        }
    }

    ExprId:init = raw stmt_decl_init(e.ast, s);
    if (raw expr_is_none(init)) { pass NIL; }
    // AN ALIASED ATOMIC IS FUSED-ONLY (D-187): storing it would give it a
    // slot that is not the cell it aliases. Use it in place —
    // `atomic_from_ptr::<T>(p).load()`.
    if (raw expr_is_atomic_from_ptr(e, init)) {
        discard(raw te_error(e, raw TYPE_MISMATCH(),
            "`atomic_from_ptr` is used in place, never stored (D-187): its result aliases the pointer's cell, and a binding would give it a different one. Write `atomic_from_ptr::<T>(p).load()` / `.store(v)` / ` directly",
            s.span));
        pass NIL;
    }

    int32:saved = e.expected;
    e.expected = want;
    int32:got = raw type_of_expr(e, init);
    e.expected = saved;

    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (raw type_is_invalid(e.types, want)) { pass NIL; }
    // `fits` rather than equality, so that `int32?:b = 42i32;` builds the
    // `Optional` holding a value (D-099). That wrap is the only thing `fits`
    // permits beyond equality.
    if (!(raw fits(e, want, got))) {
        drop te_assign_mismatch(e, want, got, s.span);
        // ONE MISTAKE, ONE REPORT (D-240): a mismatched initialiser is refused
        // here, and the move rule is not asked of a value that will never be
        // stored -- under D-264 a `T:z = y` with `y: U` reported both.
        pass NIL;
    }
    // D-183 §4: an owning value copied out of a place leaves two owners.
    drop require_move_if_owning(e, init, got, s.span);
    pass NIL;
};

// `x = v;` AND `x op= v;` — the statement that was never checked at all.
//
// It parsed from cycle 0.2, resolved both sides from 0.3, and `check_stmt` had no
// case for it, so `int32:x = 1i32; x = true;` passed clean. Three separate
// questions, and each was unasked:
//
//   1. IS THE TARGET SOMETHING THAT CAN BE ASSIGNED TO? `5i32 = x;` parses.
//   2. DOES THE VALUE FIT? The same `fits` every other slot uses (D-099), so an
//      `int32?` target takes a bare `int32` here exactly as it does in a
//      declaration — a rule that differed between the two would be one more
//      thing to remember.
//   3. FOR `op=`, DO THE OPERANDS SUPPORT THE OPERATION? `x += 1i32` on a `bool`
//      is the arithmetic rule asked of a type that has none.
func:check_assign = NIL(ExprTyper->:e, StmtNode:s) never fails {
    ExprId:target = raw stmt_target(s);
    ExprId:value = raw stmt_assigned(s);

    // An aliased atomic is fused-only, on the RHS as at a declaration (D-187).
    if (raw expr_is_atomic_from_ptr(e, value)) {
        discard(raw te_error(e, raw TYPE_MISMATCH(),
            "`atomic_from_ptr` is used in place, never stored (D-187): use `atomic_from_ptr::<T>(p).load()` / `.store(v)` directly",
            s.span));
        pass NIL;
    }

    int32:want = raw type_of_expr(e, target);
    drop require_place(e, target, s.span);
    // A WRITE INTO A VIEW OR A FROZEN SELECTOR (D-266, 1.5.2h): the compound
    // spelling routes through here too.
    if (raw refuse_write_path(e, target, "assignment", s.span)) { pass NIL; }
    // A WRITE TO A `sealed` FIELD FROM OUTSIDE ITS MODULE, OR TO A CONTAINER'S
    // HEADER (D-313, TYPE-079) -- the compound spelling included. Asked only of
    // a target that typed: a `hidden` field in the path was reported at its
    // access (TYPE-080), and one mistake gets one report (D-240).
    if (want != 0i32) {
        if (raw refuse_sealed_write(e, target, "assignment", s.span)) { pass NIL; }
    }
    // A `pure` BODY STORES ONLY INTO ITS OWN LOCALS (1.5.1, D-221): a store
    // through a pointer, a borrow, a slice, a handle — anything rooted
    // outside this frame — is the effect the caller can see. Asked after the
    // target is typed, so its parts' types are recorded.
    if (e.fn_pure) {
        if (!(raw place_is_local(e, target, 64i32))) {
            discard(raw te_error(e, raw TYPE_PURE_RULES(),
                "a `pure` body stores only into its own locals (D-221): this target reaches memory the caller can see — through a pointer, a borrow, a slice or a handle",
                s.span));
        }
    }
    // A SHARED HOLD'S `.value` (D-056) AND AN `OwnedFd`'s (D-185) are READ-ONLY
    // -- refused by `refuse_sealed_write` above, at this write form and at
    // every other (1.5.8b step 1). Until then this statement asked the two here
    // and only of a target that WAS the member, so a part of it, its address
    // and an exclusive claim of it were accepted.

    int32:saved = e.expected;
    e.expected = want;
    int32:got = raw type_of_expr(e, value);
    e.expected = saved;

    if (want == 0i32) { pass NIL; }
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, want)) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }

    // `x op= v` IS `x = x op v`, so it is held to the operator's own operand rule
    // before the result is held to the target. Reusing `type_arithmetic` and
    // `type_bitwise` rather than restating them is the point: `+=` refusing what
    // `+` accepts, or the reverse, is a difference nobody would predict.
    TokenKind:op = raw stmt_op(s);
    if (op != TokenKind.OpAssign) {
        // `x +%= v` IS `x = x +% v` (D-312, 1.5.8b step 4), and its kind rule is
        // the expression form's, through the one function -- BEFORE every tier
        // gate below, so a wrap on a kind that owns its own arithmetic reports
        // TYPE-078 naming the kind rather than that tier's own message. One
        // mistake, one report (D-240).
        if (raw wrap_arith_op(raw assign_base_op(op))) {
            discard(raw type_wrap_arith(e, s.span, raw assign_base_op(op), want, got));
            pass NIL;
        }
        // A `dim256` ON EITHER SIDE takes the unit algebra with the REAL
        // operator (D-196, 1.3.3) — and the RESULT must keep the slot's
        // unit, which `x op= v` cannot restate: `d *= d` computes
        // `Meters^2` into a `Meters` slot and refuses here.
        bool:dimside = ((raw type_kind(e.types, want)) == (raw TY_DIM()));
        if ((raw type_kind(e.types, got)) == (raw TY_DIM())) { dimside = true; }
        if (dimside) {
            if (!(raw is_bitwise_assign(op))) {
                int32:dres = raw type_dim_arith(e, s.span, raw assign_base_op(op),
                                                want, got);
                if (dres != 0i32) {
                    if (dres != want) {
                        string:c1 = string_concat(
                            "this compound assignment changes the unit: the result is `",
                            raw type_display(e.types, e.interns, dres));
                        string:c2 = string_concat(c1, "` and the slot holds `");
                        string:c3 = string_concat(c2,
                            raw type_display(e.types, e.interns, want));
                        drop diaglist_push(e.diags, raw diag_error(raw TYPE_DIM_MISMATCH(),
                            string_concat(c3, "` (D-196)"), s.span));
                    }
                }
                pass NIL;
            }
        }
        // The ternary family's gates need the REAL operator too (D-197):
        // `/=` and `%=` exist at the multi-digit types only, and `&=`/`|=`
        // are the Kleene pair on the single digits — `x op= v` IS
        // `x = x op v`, so the compound spelling takes the same rules.
        bool:ternside = ((raw type_kind(e.types, want)) == (raw TY_TERN()));
        if ((raw type_kind(e.types, got)) == (raw TY_TERN())) { ternside = true; }
        if (ternside) {
            if (raw is_bitwise_assign(op)) {
                bool:kop = (op == TokenKind.OpAmpAssign);
                if (op == TokenKind.OpPipeAssign) { kop = true; }
                if (kop) {
                    if (raw tern_kleene_ok(e, want, got)) { pass NIL; }
                }
                discard(raw type_bitwise(e, s.span, want, got));
                pass NIL;
            }
            discard(raw type_tern_arith(e, s.span, raw assign_base_op(op),
                                        want, got));
            pass NIL;
        }
        // And the frac gate (D-198): no `%=`, no bitwise-assign.
        bool:fracside = ((raw type_kind(e.types, want)) == (raw TY_FRAC()));
        if ((raw type_kind(e.types, got)) == (raw TY_FRAC())) { fracside = true; }
        if (fracside) {
            if (raw is_bitwise_assign(op)) {
                discard(raw type_bitwise(e, s.span, want, got));
                pass NIL;
            }
            discard(raw type_frac_arith(e, s.span, raw assign_base_op(op),
                                        want, got));
            pass NIL;
        }
        // And the complex gate (D-199), the same shape.
        bool:cplxside = ((raw type_kind(e.types, want)) == (raw TY_COMPLEX()));
        if ((raw type_kind(e.types, got)) == (raw TY_COMPLEX())) { cplxside = true; }
        if (cplxside) {
            if (raw is_bitwise_assign(op)) {
                discard(raw type_bitwise(e, s.span, want, got));
                pass NIL;
            }
            discard(raw type_complex_arith(e, s.span, raw assign_base_op(op),
                                           want, got));
            pass NIL;
        }
        // A FLAG SET on either side (D-044/D-230, 1.4.8): the REAL operator
        // decides — `&=`/`|=` within one family, nothing else exists for the
        // kind — and `x op= v` IS `x = x op v`, so it is the expression's rule.
        bool:flagside = ((raw type_kind(e.types, want)) == (raw TY_FLAGS()));
        if ((raw type_kind(e.types, got)) == (raw TY_FLAGS())) { flagside = true; }
        if (flagside) {
            discard(raw type_flags_op(e, s.span, raw assign_base_op(op), want, got));
            pass NIL;
        }
        if (raw is_bitwise_assign(op)) {
            discard(raw type_bitwise(e, s.span, want, got));
            // `x <<= n` IS `x = x << n` (D-277): the amount rule of the
            // expression form, through the one function.
            if ((op == TokenKind.OpShlAssign) || (op == TokenKind.OpShrAssign)) {
                drop check_shift_amount(e, raw stmt_assigned(s), want, s.span);
            }
        } else {
            discard(raw type_arithmetic(e, s.span, want, got));
        }
        pass NIL;
    }

    if (!(raw fits(e, want, got))) {
        drop te_assign_mismatch(e, want, got, s.span);
        pass NIL;   // one mistake, one report (D-240): a mismatched value is never stored
    }
    drop require_move_if_owning(e, value, got, s.span);
    pass NIL;
};

// The operator inside `x op= v`, for the paths that need the REAL operator —
// the `dim256` unit algebra is the one consumer: `*=` and `/=` combine units
// where `+= -= %=` demand agreement, a difference `type_arithmetic` (which
// never sees the operator) cannot carry.
func:assign_base_op = TokenKind(TokenKind:op) never fails {
    if (op == TokenKind.OpPlusAssign)    { pass TokenKind.OpPlus; }
    if (op == TokenKind.OpMinusAssign)   { pass TokenKind.OpMinus; }
    if (op == TokenKind.OpStarAssign)    { pass TokenKind.OpStar; }
    if (op == TokenKind.OpSlashAssign)   { pass TokenKind.OpSlash; }
    if (op == TokenKind.OpPercentAssign) { pass TokenKind.OpPercent; }
    // The bitwise five too (1.4.8): a flag set's rule reads the real operator.
    if (op == TokenKind.OpAmpAssign)     { pass TokenKind.OpAmp; }
    if (op == TokenKind.OpPipeAssign)    { pass TokenKind.OpPipe; }
    if (op == TokenKind.OpCaretAssign)   { pass TokenKind.OpCaret; }
    if (op == TokenKind.OpShlAssign)     { pass TokenKind.OpShl; }
    if (op == TokenKind.OpShrAssign)     { pass TokenKind.OpShr; }
    // The wrapping compound forms (D-312, 1.5.8b step 4): `x +%= v` IS
    // `x = x +% v`, so every path that reads the real operator reads the
    // wrapping one.
    if (op == TokenKind.OpPlusWrapAssign)  { pass TokenKind.OpPlusWrap; }
    if (op == TokenKind.OpMinusWrapAssign) { pass TokenKind.OpMinusWrap; }
    if (op == TokenKind.OpStarWrapAssign)  { pass TokenKind.OpStarWrap; }
    pass op;
};

func:is_bitwise_assign = bool(TokenKind:op) never fails {
    if (op == TokenKind.OpAmpAssign)   { pass true; }
    if (op == TokenKind.OpPipeAssign)  { pass true; }
    if (op == TokenKind.OpCaretAssign) { pass true; }
    if (op == TokenKind.OpShlAssign)   { pass true; }
    pass (op == TokenKind.OpShrAssign);
};

// WHAT CAN BE ASSIGNED TO — the same question `@`, `$$i`, `$$m` and `move` ask,
// so it is answered by the same function.
//
// WHAT STOOD HERE LOOKED AT THE TOP NODE ONLY: an identifier, a member access, an
// index or a dereference passed, whatever they were built on. `f().x = 5i32;` is a
// member access and was accepted — a store into a field of a value that has no
// home. `expr_is_place` walks to the ROOT, so the answer is about where the
// storage is rather than about what the outermost operator happens to be.
//
// The message names the form rather than saying "not assignable", because the
// mistake is usually a comparison written with one `=` and the reader needs to be
// pointed at that rather than at a definition.
func:require_place = NIL(ExprTyper->:e, ExprId:id, Span:at) never fails {
    if (raw expr_is_none(id)) { pass NIL; }
    if (raw expr_is_place(e.ast, id, raw BORROW_FUEL())) { pass NIL; }
    discard(raw te_error(e, raw TYPE_NOT_A_PLACE(),
        "this is a value, not somewhere to store one; only a name, a field, an element or a `<-` dereference can be assigned to — and `==` is the comparison",
        at));
    pass NIL;
};

// `pass v;` desugars to `return Result{err: 0tbb32, value: v};` — so `v` is
// checked against the function's SUCCESS type, not its `Result` type.
func:check_pass = NIL(ExprTyper->:e, StmtNode:s) never fails {
    ExprId:v = raw stmt_operand(s);
    int32:want = e.fn_success;

    // `pass;` with no value is `pass NIL;`. Void functions do not exist, so the
    // bare form is the one that returns `Result<NIL>`.
    //
    // AND IN A FUNCTION RETURNING AN `Optional` IT IS THE EMPTY ONE, because that
    // is what `pass NIL;` means there (D-099) and the bare form is defined as that
    // spelling. `func:find = int32?() { pass; }` therefore returns nothing found.
    //
    // This is written out rather than folded into `fits`, and the difference
    // matters: `fits` answers about a VALUE of type `NIL`, and letting one become
    // an empty `Optional` would make `int32?:x = drop f();` typecheck — `drop`
    // yields `NIL` precisely so that using it as a value is an error.
    if (raw expr_is_none(v)) {
        if (want != 0i32) {
            bool:ok = (want == e.types.t_nil);
            if ((raw type_kind(e.types, want)) == (raw TY_OPTIONAL())) { ok = true; }
            if (!ok) {
                drop te_assign_mismatch(e, want, e.types.t_nil, s.span);
            }
        }
        pass NIL;
    }

    int32:saved = e.expected;
    e.expected = want;
    // THE TRANSIT POSITION (D-183, 1.2.6): in a `gives` function, a call to
    // another `gives` function is legal only HERE — the value in flight to
    // the caller, with no local reclaim scoped to this frame.
    int32:gsaved = e.give_operand;
    e.give_operand = v.index;
    int32:got = raw type_of_expr(e, v);
    e.give_operand = gsaved;
    e.expected = saved;
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (want == 0i32) { pass NIL; }
    // `pass` MOVES (D-183), and you cannot give what you were only lent: a
    // lent owning parameter passed back up hands the caller a header whose
    // body the CALLER'S caller still owns — `nio_normalize`'s unchanged path
    // did exactly this, and the first drop to run freed the returned value
    // out from under everyone. The same rule `move(p)` answers to, asked of
    // the implicit move.
    drop refuse_move_of_borrowed(e, v, got, s.span);
    // AND THE SAME AGAIN THROUGH A POINTER: `pass m.files[i].text` returns a
    // cap-carrying copy of a value the POINTEE owns, and the first flagged
    // local it lands in frees the container's body — which is precisely how
    // `srcmgr_text` freed every source file out from under the interns, the
    // spans, and the lexer. The pointer-root exemption on `move` is for
    // permuting WITHIN a container; `pass` LEAVES, so it gets no exemption.
    // The fix at the site is a view (`string_from_bytes`) or a clone.
    drop refuse_pass_of_pointee_owned(e, v, got, s.span);
    // AND OUT OF A LIMITED BINDING'S FIELD OR ELEMENT (1.5.2 step 1, D-251).
    drop refuse_move_out_of_limited(e, v, got, s.span);
    // AND OUT OF AN OWNING `sealed` FIELD FROM OUTSIDE ITS MODULE (D-313).
    drop refuse_move_out_of_sealed(e, v, got, s.span);
    if (!(raw fits(e, want, got))) {
        drop te_assign_mismatch(e, want, got, s.span);
    }
    pass NIL;
};

// `fail c;` desugars to `return Result{err: c, value: zero};` — so `c` is a
// `tbb32`, the same type `Result.err` holds and the same one `failsafe` takes.
//
// `fail` IN `main` OR `failsafe` IS REFUSED for the reason `relay` is: there is
// no `Result` to fail into, and an error leaving the program's last frame has
// nowhere to go. That is the uncontrolled stop the discipline exists to prevent.
func:check_fail = NIL(ExprTyper->:e, StmtNode:s) never fails {
    if (e.in_defer) {
        discard(raw te_error(e, raw TYPE_DEFER_EXIT(),
            "a `defer` body may not `fail` (D-163): a cleanup runs while the scope unwinds and must not itself exit; handle the error inside the `defer`",
            s.span));
    }
    if (e.fn_terminal) {
        discard(raw te_error(e, raw TYPE_RESULT_RETURN(),
            "`fail` returns an error from the enclosing function, and `main` and `failsafe` return no `Result` to fail into; `exit` is how a program stops",
            s.span));
    }
    if (e.fn_never_fails) {
        discard(raw te_error(e, raw TYPE_NEVER_FAILS_CAN_FAIL(),
            "a `never fails` function may not `fail` (D-163): drop the clause, or handle the error and `pass`",
            s.span));
    }
    ExprId:c = raw stmt_operand(s);
    if (raw expr_is_none(c)) { pass NIL; }

    int32:saved = e.expected;
    e.expected = e.types.t_error;
    int32:got = raw type_of_expr(e, c);
    e.expected = saved;
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (got != e.types.t_error) {
        drop te_assign_mismatch(e, e.types.t_error, got, s.span);
    }
    pass NIL;
};

// `!!! e;` HANDS `failsafe` AN `Error` TOO (D-179): the trap and the `?!`
// escalation land in the same place, so they carry the same type — one rule,
// no context.
func:check_trap = NIL(ExprTyper->:e, StmtNode:s) never fails {
    ExprId:c = raw stmt_expr(s);
    if (raw expr_is_none(c)) { pass NIL; }
    int32:saved = e.expected;
    e.expected = e.types.t_error;
    int32:got = raw type_of_expr(e, c);
    e.expected = saved;
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (got != e.types.t_error) {
        drop te_assign_mismatch(e, e.types.t_error, got, s.span);
    }
    pass NIL;
};

// `return` TAKES A `Result{…}` LITERAL AND NOTHING ELSE (AST_REFERENCE §2).
//
// The restriction is what keeps `pass` and `fail` honest: they are sugar over
// this form, so the form has to exist and has to be the only other way in. A
// `return v;` accepting a bare value would give the language two spellings for
// the success path, one of which silently supplies an error field nobody wrote.
func:check_return = NIL(ExprTyper->:e, StmtNode:s) never fails {
    ExprId:v = raw stmt_operand(s);
    if (e.fn_never_fails) {
        discard(raw te_error(e, raw TYPE_NEVER_FAILS_CAN_FAIL(),
            "a `never fails` function returns with `pass`; an explicit `return Result{…}` can carry an error (D-163)",
            s.span));
    }
    if (raw expr_is_none(v)) {
        discard(raw te_error(e, raw TYPE_RESULT_RETURN(),
            "`return` takes a `Result{…}` literal; `pass` and `fail` are the shorthands for one field at a time",
            s.span));
        pass NIL;
    }
    ExprNode:n = raw ast_expr(e.ast, v);
    if (n.kind != ExprKind.ExprResultLiteralExpr) {
        discard(raw te_error(e, raw TYPE_RESULT_RETURN(),
            "`return` takes a `Result{…}` literal and nothing else; write `pass v;` for a value or `fail c;` for an error",
            s.span));
        pass NIL;
    }
    discard(raw type_of_expr(e, v));
    pass NIL;
};

// `exit` IS LEGAL ONLY IN `main` AND `failsafe` — the whole reason those two are
// shaped differently. Anywhere else, stopping the program bypasses every caller's
// error handling and every `defer` between here and the top, which is exactly the
// uncontrolled shutdown the language exists to make impossible.
func:check_exit = NIL(ExprTyper->:e, StmtNode:s) never fails {
    if (!e.fn_terminal) {
        discard(raw te_error(e, raw TYPE_RESULT_RETURN(),
            "`exit` is legal only in `main` and `failsafe`; elsewhere it would stop the program past every caller's error handling and every pending `defer` — `fail` is how a function reports failure",
            s.span));
    }
    ExprId:c = raw stmt_operand(s);
    if (raw expr_is_none(c)) { pass NIL; }
    int32:saved = e.expected;
    e.expected = raw tt_int(e.types, 32i32, true);
    discard(raw type_of_expr(e, c));
    e.expected = saved;
    pass NIL;
};

// --- the walk over a module (cycle 0.4.8) -------------------------------------------------
//
// EVERY DECLARATION, WHETHER OR NOT ANYTHING REACHES IT.
//
// Three gaps closed at once, and they were one gap wearing three faces — there
// was no driver, so every test fixture hand-rolled a walk and each one walked
// only what its own cases needed:
//
//   * AN `impl` METHOD'S BODY WAS NEVER TYPE-CHECKED. `resolve.npk` descends into
//     impl members and binds their names; nothing type-checked them, in any
//     cycle. A method written exactly where TRAITS_REFERENCE 2.4 puts it had its
//     names resolved and its types never looked at.
//   * A DECLARATION NOTHING REACHES WAS NEVER TYPE-RESOLVED. `tests/frontend/
//     type_members.npk` says so in a comment — "a case testing a bad signature has
//     to CALL the function" — so a bad return type in an uncalled function, or a
//     bound violation in an unused global's annotation, went unreported.
//   * A TRAIT'S DEFAULT METHOD BODY was in neither set.
//
// WHAT MADE THIS AFFORDABLE IS DIAGNOSTIC DEDUPLICATION (D-110). Resolving every
// signature means resolving the reached ones twice — once here and once when
// something reaches them — and each of those resolutions is correct to report
// what it finds. Without deduplication, being complete would mean being noisy,
// and the alternatives are worse: reporting on some paths and not others is a
// rule that depends on which path ran, and visiting less to stay quiet is
// checking less.
// THE RESOLVER IS DERIVED FROM THE CHECKER, NEVER THREADED THROUGH IT.
//
// This walk first took a `TypeResolver` as a parameter, and the trait case then
// set `Self` on the CHECKER while every signature was resolved through the
// resolver that had been handed in — so a trait's own `func:show = string(Self:self)`
// reported "`Self` is valid only inside a `trait` or `impl` body" from inside a
// trait body. Two places holding one piece of context, and they disagreed.
//
// `etyper_resolver` exists precisely to stop that (D-110): context every
// resolution needs belongs to the constructor rather than to whoever remembers to
// pass it. So the walk sets the context on `e` and builds a resolver from `e`
// wherever it needs one.
pub func:check_module = NIL(ExprTyper->:e, DeclId:mod_id, int32:scope) never fails {
    DeclNode:m = raw ast_decl(e.ast, mod_id);
    int32:n = raw item_member_count(e.ast, m);
    for (int32:i in 0i32...n) {
        drop check_decl(e, raw item_member(e.ast, m, i), scope);
    }
    pass NIL;
};

func:check_decl = NIL(ExprTyper->:e, DeclId:id, int32:scope) never fails {
    DeclNode:d = raw ast_decl(e.ast, id);

    if (d.kind == DeclKind.DeclFunctionDecl) {
        drop check_function(e, id, scope);
        pass NIL;
    }

    // A `unit:` DECLARATION EVALUATES HERE (D-196, 1.3.3) — eagerly, so a
    // broken definition refuses even when nothing writes the name. The
    // evaluation memoizes on the TypeTable: an annotation that used this
    // unit first already paid, and this asks the cache. Resolve deliberately
    // left the right-hand side alone — the check walk owns the whole unit
    // algebra in one implementation.
    if (d.kind == DeclKind.DeclUnitDecl) {
        discard(raw dim_unit_of_name(e.ast, e.types, e.tab, e.interns, e.diags,
                                     raw decl_name(d), scope, d.span, 0i32));
        pass NIL;
    }

    // A `Rules` BLOCK TYPES EAGERLY (1.5.1, D-220): its subject resolves (a
    // broken one refuses even when nothing uses the rule — the `unit:`
    // precedent above), every clause is a proposition over `$` of that type,
    // and every refinement names a rule over the SAME subject. Nothing typed
    // a `Rules` body before 1.5.1: `check_decl` had no arm for the kind, so a
    // clause of any type — or none — was accepted in silence.
    if (d.kind == DeclKind.DeclRuleDecl) {
        TypeResolver:rr = raw etyper_resolver(e);
        int32:subject = raw resolve_type(@rr, raw rule_subject(d), scope);
        if (subject != 0i32) {
            if (!(raw type_is_invalid(e.types, subject))) {
                int32:saved_subject = e.rules_subject;
                e.rules_subject = subject;
                int32:rcn = raw rule_clause_count(e.ast, d);
                for (int32:rci in 0i32...rcn) {
                    drop check_proposition(e, raw rule_clause(e.ast, d, rci),
                                           raw CTX_RULES());
                }
                e.rules_subject = saved_subject;
                int32:rrn = raw rule_refine_count(e.ast, d);
                for (int32:rri in 0i32...rrn) {
                    drop check_refine_subject(e, raw rule_refine(e.ast, d, rri), subject);
                }
            }
        }
        pass NIL;
    }

    // A NESTED `mod:name = { … };` IS CHECKED, in the scope its name opened.
    //
    // NOTHING CHECKED IT AT ALL until now. The resolver descends into a nested
    // module and binds every name inside it, and this walk had no entry for the
    // kind — so a function one nesting level down was resolved and then never
    // type-checked. `pass "not an int32";` from an `int32` function was reported
    // at the top level and accepted, silently, inside a `mod` block.
    //
    // That is D-085's shape exactly: 0.2 parsed the construct, 0.3 resolved it,
    // and the checker's silence about it was invisible because there was nothing
    // to see. A missing case in a walk reports nothing by construction.
    if (d.kind == DeclKind.DeclModuleDecl) {
        int32:inner = raw nested_module_scope(e.tab, d, scope);
        if (inner == 0i32) {
            // The resolver reports this as an internal defect and refuses the
            // program, so reaching here means it already has. Checking a module's
            // members in the WRONG scope would report a second, misleading thing
            // about a program that is already being refused.
            pass NIL;
        }
        // AND THE TYPER'S OWN SCOPE FOLLOWS (1.5.4c step 1, found by the
        // first program to use a struct declared inside an inline module):
        // a body's type annotations, struct literals and UFCS lookups read
        // `e.scope`, which `etyper_init` set to the FILE's scope once and this
        // walk never moved -- so `S:s = S{ … }` inside `mod:m = { pub
        // struct:S … }` reported "there is no type named `S`" from the
        // module's own function, while the signature, resolved through the
        // `scope` parameter, saw it. Saved and restored around the members.
        int32:saved_scope = e.scope;
        e.scope = inner;
        int32:mn2 = raw item_member_count(e.ast, d);
        for (int32:q in 0i32...mn2) {
            drop check_decl(e, raw item_member(e.ast, d, q), inner);
        }
        e.scope = saved_scope;
        pass NIL;
    }

    // AN `impl` BLOCK'S MEMBERS ARE WALKED WITH THE BLOCK'S CONTEXT — its generic
    // parameters as the enclosing scope, and its target as `Self`. A blanket
    // impl's methods are written in terms of its parameter and a concrete impl's
    // may be written in terms of `Self`; neither has any other binding to reach.
    if (d.kind == DeclKind.DeclImplDecl) {
        GenericScope:saved_enc = e.enclosing;
        int32:saved_self = e.self_type;

        IdSpan:gw = raw decl_generic_window(e.ast, d);
        GenericScope:g = GenericScope{ params_start: gw.start, params_count: gw.count,
                                       args_start: 0i32, args_count: 0i32 };
        e.enclosing = g;
        e.self_type = raw impl_self_type(e, d, scope);

        int32:mn = raw impl_member_count(e.ast, d);
        for (int32:j in 0i32...mn) {
            DeclId:mid = raw impl_member(e.ast, d, j);
            DeclNode:mm = raw ast_decl(e.ast, mid);
            if (mm.kind == DeclKind.DeclFunctionDecl) {
                drop check_function(e, mid, scope);
            }
        }

        e.enclosing = saved_enc;
        e.self_type = saved_self;
        pass NIL;
    }

    // A TRAIT'S DEFAULT METHOD BODY (2.1). `Self` there is the PLACEHOLDER, not a
    // concrete type — the implementing type does not exist until an impl names
    // one — which is exactly what `TY_SELF` is for (D-103).
    if (d.kind == DeclKind.DeclTraitDecl) {
        GenericScope:saved_enc = e.enclosing;
        int32:saved_self = e.self_type;

        IdSpan:gw = raw decl_generic_window(e.ast, d);
        GenericScope:g = GenericScope{ params_start: gw.start, params_count: gw.count,
                                       args_start: 0i32, args_count: 0i32 };
        e.enclosing = g;
        e.self_type = raw tt_self(e.types);

        // THE TRAIT WHOSE BODY THIS IS (1.0.4). `Self` stays the anonymous
        // placeholder D-103 designed — the implementing type does not exist yet
        // — but a DEFAULT method calling `self.other()` needs somewhere to look
        // `other` up, and the answer is the guarantee list: what this trait
        // declares. Carried beside `Self` rather than folded into it, so the
        // placeholder keeps meaning exactly what D-103 says it means.
        int32:saved_st = e.self_trait;
        e.self_trait = id.index;

        int32:tn = raw item_member_count(e.ast, d);
        for (int32:k in 0i32...tn) {
            DeclId:tmid = raw item_member(e.ast, d, k);
            DeclNode:tm = raw ast_decl(e.ast, tmid);
            if (tm.kind == DeclKind.DeclFunctionDecl) {
                drop check_function(e, tmid, scope);
            }
        }

        e.enclosing = saved_enc;
        e.self_type = saved_self;
        e.self_trait = saved_st;
        pass NIL;
    }

    // A STRUCT'S FIELD TYPES, resolved so that a field annotation nothing reads is
    // still checked. `struct_layout` does the walk and the binding; asking it for
    // the layout is how the field types get resolved at all.
    if (d.kind == DeclKind.DeclStructDecl) {
        drop resolve_struct_fields(e, id, d, scope);
        // `sealed` AND `hidden` ON ONE FIELD CONTRADICT (D-313, D-314; TYPE-081):
        // sealed is read everywhere, hidden nowhere outside -- one of the two
        // sentences is false, and a reader cannot tell which was meant.
        int32:both = (raw QUAL_SEALED()) | (raw QUAL_HIDDEN());
        int32:sfn = raw item_member_count(e.ast, d);
        for (int32:sfi in 0i32...sfn) {
            DeclNode:sfm = raw ast_decl(e.ast, raw item_member(e.ast, d, sfi));
            if (sfm.kind == DeclKind.DeclFieldDecl) {
                if (((raw field_quals(sfm)) & both) == both) {
                    discard(raw te_error(e, raw TYPE_FIELD_QUAL(),
                        "a field is `sealed` (read anywhere, written only by its module, D-313) or `hidden` (neither read nor written outside it, D-314), never both: the two contradict -- write the one that is true; `hidden` already forbids the writes",
                        sfm.span));
                }
                // A FIELD'S `limit<Rules>` (D-308, 1.5.8b step 6): the subject is
                // the field's own type BY IDENTITY (TYPE-059, the binding's rule --
                // so a limited `T` field of a generic struct refuses, D-220's "no
                // type parameter"), and the rule holds of the field's VACANT value
                // (TYPE-077). The type comes through the layout walk, never a raw
                // re-resolve (1.1.12c's lesson, above).
                VerifyId:sfl = raw field_limit(sfm);
                if (!(raw verify_is_none(sfl))) {
                    TypeResolver:sflr = raw etyper_resolver(e);
                    int32:sfst = raw tt_struct(e.types, id.index, raw decl_name(d), 0i64, 1i32);
                    FieldInfo:sffi = raw struct_field(@sflr, sfst, raw decl_name(sfm), scope);
                    if (sffi.found) {
                        drop check_limit_subject(e, sfl, sffi.type_id, sfm.span);
                        drop check_field_limit_vacant(e, sfl, sffi.type_id, raw decl_name(d),
                                                      raw decl_name(sfm), sfm.span);
                    }
                }
            }
        }
        pass NIL;
    }

    // A GLOBAL'S ANNOTATION AND ITS INITIALISER. The annotation is a type nothing
    // else resolves; the initialiser is an expression nothing else walks.
    if (d.kind == DeclKind.DeclGlobalDecl) {
        drop refuse_field_quals(e, raw global_quals(d), "a module binding", d.span);
        TypeResolver:gr = raw etyper_resolver(e);
        int32:want = raw resolve_type(@gr, raw global_type(d), scope);
        ExprId:init = raw global_init(d);
        if (!(raw expr_is_none(init))) {
            int32:saved = e.expected;
            e.expected = want;
            int32:got = raw type_of_expr(e, init);
            e.expected = saved;
            if (want != 0i32) {
                if (got != 0i32) {
                    if (!(raw type_is_invalid(e.types, got))) {
                        // EXACT, NOT `fits` (D-165): a module binding's value is
                        // a compile-time constant, and a constant is not coerced
                        // — a `T` into an `Optional<T>` or a concrete value into
                        // a `dyn` both need construction that only runs at run
                        // time. `NIL` into an `Optional` is the one wrap that
                        // survives, and it survives because the sentinel types AS
                        // the `Optional` here, so the two already agree.
                        if (want != got) {
                            if (!(raw types_agree(e, want, got))) {
                                drop te_assign_mismatch(e, want, got, d.span);
                            }
                        }
                    }
                }
            }
            // D-211 (1.4.2b): MODULE STATE IS `fixed`, AND NOTHING ELSE.
            // A plain binding lowered to a mutable global that any task
            // could write with no rule anywhere about the crossing — process
            // state that changes, reachable from everywhere, ordered by
            // nothing. The compiler is the largest program in this ecosystem
            // and has never declared one (measured at 1.4.2b: zero in `src/`,
            // `lib/` and `tools/`), which is the evidence the restriction
            // costs nothing real. Mutable process state lives in `main`'s
            // scope and flows explicitly through the calls that need it.
            if (((raw global_quals(d)) & (raw QUAL_FIXED())) == 0i32) {
                discard(raw te_error(e, raw TYPE_GLOBAL_MUTABLE(),
                    "module state is `fixed` (D-211): a plain module-level binding is a mutable global any task can write, ordered by nothing — write `fixed` for a value assigned exactly once, and keep mutable process state in `main`'s scope where it flows through the calls that need it",
                    d.span));
            }
            // D-165: EVERY MODULE BINDING'S INITIALISER IS A COMPILE-TIME
            // CONSTANT. No module initialiser runs before `main`, so a value
            // that had to run would appear in an order nobody wrote — refused
            // by name. Checked for every module binding since `const` retired
            // (1.4.2c): the qualifier used to gate this, which meant the one
            // spelling that skipped the check was the one that lowered to
            // writable memory.
            if (!(raw is_const_initialiser(e, init))) {
                discard(raw te_error(e, raw TYPE_GLOBAL_NOT_CONSTANT(),
                    "a module-level binding's initialiser must be a compile-time constant — a literal, a sentinel, a struct or array of constants, another module binding, or `comptime(…)`, never a call or a value that must run (D-165); no initialiser runs before `main`",
                    d.span));
            }
        }
        pass NIL;
    }
    pass NIL;
};

// D-165: IS THIS A COMPILE-TIME CONSTANT INITIALISER for a module-level binding?
// Struct and array literals are constant when every member is; everything else
// is constant exactly when the folder folds it (a literal, a sentinel, an
// arithmetic expression, another module binding, a `comptime(…)`). A call folds
// to nothing, which is the refusal D-165 wants.
func:is_const_initialiser = bool(ExprTyper->:e, ExprId:eid) never fails {
    ExprNode:n = raw ast_expr(e.ast, eid);
    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:pairs = (raw expr_list_count(n)) / 2i32;
        int32:i = 0i32;
        while (i < pairs) decreases pairs - i {
            ExprId:vid = ExprId{ index: raw ast_id_at(e.ast,
                             raw expr_list_start(n), (i * 2i32) + 1i32) };
            if (!(raw is_const_initialiser(e, vid))) { pass false; }
            i = i + 1i32;
        }
        pass true;
    }
    if (n.kind == ExprKind.ExprArrayLiteralExpr) {
        int32:c = raw expr_list_count(n);
        for (int32:i in 0i32...c) {
            ExprId:vid = ExprId{ index: raw ast_id_at(e.ast,
                             raw expr_list_start(n), i) };
            if (!(raw is_const_initialiser(e, vid))) { pass false; }
        }
        pass true;
    }
    if (n.kind == ExprKind.ExprSentinelLiteral) { pass true; }
    TypeResolver:cr = raw etyper_resolver(e);
    ConstVal:cv = raw fold_const(@cr, eid, e.scope);
    // A FOLD THAT ALREADY SAID WHAT WENT WRONG -- a constant overflow (D-310),
    // a division by zero -- is not also "not a constant" (D-240: one mistake,
    // one report; the specific sentence is the useful one).
    if (raw fold_gave_up(@cr)) { pass true; }
    pass (raw cv_folded(cv));
};

// A STRUCT'S FIELD TYPES. Resolving them IS the layout walk, so asking for the
// layout is how they get resolved — and a field whose annotation is wrong is
// reported whether or not anything ever reads that field.
//
// A GENERIC STRUCT IS RESOLVED WITH ITS PARAMETERS OPAQUE, which is the whole of
// D-064 applied to a declaration: `T:value` is checked once, at the definition,
// against a `T` that satisfies its bounds and nothing else.
func:resolve_struct_fields = NIL(ExprTyper->:e, DeclId:id, DeclNode:d,
                                 int32:scope) never fails {
    TypeResolver:r = raw etyper_resolver(e);
    int32:t = raw tt_struct(e.types, id.index, raw decl_name(d), 0i64, 1i32);
    discard(raw struct_layout(@r, t, scope));
    pass NIL;
};

// ONE FUNCTION, WITH ITS OWN SIGNATURE AND ITS OWN PARAMETERS IN HAND.
//
// `fn_type` rather than `fn_signature`, because the signature alone resolves only
// the RETURN type — and a bad parameter type is a mistake in a declaration
// exactly as much as a bad return is. That asymmetry is what let `..*int64`
// without the brackets sit unreported in an uncalled function.

// THE SHAPE A `gives` RETURN MAY TAKE (D-183, 1.2.6): its channels sit where
// the caller's stash can name them at compile time — bare, or as DIRECT
// fields of the returned struct. A channel behind a tag, an array or a
// second nesting level has no statically known offset to stash from.
func:gives_shape_ok = bool(ExprTyper->:e, int32:t) never fails {
    int32:k = raw type_kind(e.types, t);
    if (k == (raw TY_CHANNEL())) { pass true; }
    if (k != (raw TY_STRUCT())) { pass false; }
    int32:sdecl = raw type_decl(e.types, t);
    if (sdecl == 0i32) { pass false; }
    DeclNode:sd = raw ast_decl(e.ast, DeclId{ index: sdecl });
    TypeResolver:sr = raw etyper_resolver(e);
    int32:home = raw symtab_home_scope(e.tab, sdecl, e.scope);
    int32:nm = raw item_member_count(e.ast, sd);
    for (int32:kk in 0i32...nm) {
        DeclNode:m = raw ast_decl(e.ast, raw item_member(e.ast, sd, kk));
        if (m.kind == DeclKind.DeclFieldDecl) {
            // THROUGH THE LAYOUT WALK, NEVER A RAW RE-RESOLVE (1.1.12c). The
            // first cut resolved the TEMPLATE's field node with no generic
            // binding, so a generic struct's `W:inner` reported "there is no
            // type named `W`" against a correct program — and only when an
            // instance existed to bring this check here. `struct_field` binds
            // the instance's arguments before it resolves anything.
            FieldInfo:fi = raw struct_field(@sr, t, raw decl_name(m), home);
            int32:ft = 0i32;
            if (fi.found) { ft = fi.type_id; }
            if ((raw type_kind(e.types, ft)) != (raw TY_CHANNEL())) {
                if (raw type_contains_channel(@sr, ft, e.scope, 64i32)) { pass false; }
            }
        }
    }
    pass true;
};
func:check_function = NIL(ExprTyper->:e, DeclId:fid, int32:scope) never fails {
    DeclNode:d = raw ast_decl(e.ast, fid);
    int32:name = raw decl_name(d);
    TypeResolver:r = raw etyper_resolver(e);
    FnSig:sg = raw fn_signature(@r, fid, name, scope);
    discard(raw fn_type(@r, fid, name, scope));

    GenericScope:saved = e.generics;
    IdSpan:gw = raw decl_generic_window(e.ast, d);
    GenericScope:g = GenericScope{ params_start: gw.start, params_count: gw.count,
                                   args_start: 0i32, args_count: 0i32 };
    e.generics = g;
    e.fn_success = sg.success;
    e.fn_decl = fid.index;
    e.fn_terminal = sg.terminal;
    e.fn_never_fails = raw fn_declares_never_fails(e.ast, d);
    e.fn_is_async = raw decl_has(d, raw DECL_ASYNC());
    e.fn_gives = raw fn_declares_gives(e.ast, d);
    e.fn_pure = raw fn_declares_pure(e.ast, d);
    e.fn_comptime = raw decl_has(d, raw DECL_COMPTIME());
    // `pure` (1.5.1, D-221, S-15): a function of its arguments and nothing
    // else. Its header rules: not `async` or `thread` (an executor deciding
    // when a body runs is an effect, and so is a suspension inside it), not
    // `main`/`failsafe` (their exit is the program's), and no `move`
    // parameter (a consumed owner is dropped at exit — a deallocation the
    // caller can see). The body rules are read in the arms that already
    // exist for calls, declarations and assignment.
    if (e.fn_pure) {
        bool:runs_on_executor = e.fn_is_async;
        if (raw decl_has(d, raw DECL_THREAD())) { runs_on_executor = true; }
        if (runs_on_executor) {
            discard(raw te_error(e, raw TYPE_PURE_RULES(),
                "a `pure` function is not `async` or `thread` (D-221): an executor deciding when a body runs, and a suspension inside it, are effects a function of its arguments cannot have",
                d.span));
        }
        if (e.fn_terminal) {
            discard(raw te_error(e, raw TYPE_PURE_RULES(),
                "`main` and `failsafe` are not `pure` (D-221): their exit is the program's, which is the largest effect there is",
                d.span));
        }
        int32:ppi = 0i32;
        int32:nparams = raw fn_param_count(e.ast, d);
        while (ppi < nparams) decreases nparams - ppi {
            DeclNode:ppd = raw ast_decl(e.ast, raw fn_param(e.ast, d, ppi));
            if (((raw param_quals(ppd)) & (raw QUAL_MOVE())) != 0i32) {
                discard(raw te_error(e, raw TYPE_PURE_RULES(),
                    "a `pure` function takes no `move` parameter (D-221): a consumed owner is dropped at its exit, and a deallocation is an effect the caller can see",
                    ppd.span));
            }
            ppi = ppi + 1i32;
        }
    }
    // `gives` STATES A HAND-OFF (D-183, 1.2.6): the return carries channels
    // whose reclaim becomes the caller's. A `gives` with no channel in the
    // return is a claim about nothing; and the channels must sit at the TOP
    // LEVEL of the return type — bare, or direct fields of a returned
    // struct — because the caller's stash reads them at statically known
    // offsets, and a channel behind a tag or a nesting level is one the
    // stash cannot name.
    // A GENERIC template's return is not laid out and its parameters are
    // unbound, so the two type-shaped validations wait: every behavioural
    // rule keys on the `gives` bit itself, and an instantiation whose
    // return carries no channel simply stashes nothing.
    if (e.fn_gives) { if (gw.count == 0i32) {
        if (!(raw type_contains_channel(@r, sg.success, e.scope, 64i32))) {
            discard(raw te_error(e, raw TYPE_MISMATCH(),
                "`gives` hands the return's CHANNELS to the caller (D-183), and this return type carries none",
                d.span));
        } else {
            if (!(raw gives_shape_ok(e, sg.success))) {
                discard(raw te_error(e, raw TYPE_MISMATCH(),
                    "a `gives` return carries its channels at the TOP LEVEL — bare, or as direct fields of the returned struct (D-183): behind a tag, an array or a nesting level the caller's stash cannot name them",
                    d.span));
            }
        }
    } }
    // `async main` is D-058's entry shim; `async failsafe` is refused: the
    // crash path may not depend on an executor that may itself be the
    // casualty of whatever is being escaped from (D-177).
    if (e.fn_is_async) {
        if (raw string_eq(raw intern_get(e.interns, raw decl_name(d)), "failsafe")) {
            discard(raw te_error(e, raw TYPE_AWAIT_RULES(),
                "`failsafe` cannot be `async` (D-177): it is the controlled-stop path, and it must run without an executor",
                d.span));
        }
    }
    // THE `joins` CLAUSE IS TYPED HERE (D-181), unlike `requires`/`ensures`,
    // which are the verifier's (1.4) and are typed nowhere yet. This one is
    // not a proof obligation but a VALUE the spawn emits — an expression
    // nobody types is an expression the emitter cannot lower, which is
    // exactly what the first cut produced. It must be a `Duration`, and it
    // may only appear on a `thread`: a join deadline on a function that
    // creates no executor states a property of nothing.
    int32:jci = 0i32;
    int32:ncontracts = raw fn_contract_count(e.ast, d);
    while (jci < ncontracts) decreases ncontracts - jci {
        VerifyNode:jcv = raw ast_verify(e.ast, raw fn_contract(e.ast, d, jci));
        if (jcv.kind == VerifyKind.VerifyJoinsWithin) {
            if (!(raw decl_has(d, raw DECL_THREAD()))) {
                discard(raw te_error(e, raw TYPE_THREAD_RULES(),
                    "`joins` states the join deadline of a THREAD's executor (D-181/D-083), and this function creates no executor",
                    jcv.span));
            }
            int32:jt = raw type_of_expr(e, raw contract_cond(jcv));
            if (jt != 0i32) {
                if (!(raw type_is_invalid(e.types, jt))) {
                    if (!(raw string_eq(raw type_display(e.types, e.interns, jt),
                                        "Duration"))) {
                        discard(raw te_error(e, raw TYPE_THREAD_RULES(),
                            "`joins` takes a `Duration` (D-181): a deadline is a span, and the executor converts it to an absolute monotonic timepoint once, where it is created",
                            jcv.span));
                    }
                }
            }
        }
        jci = jci + 1i32;
    }

    // THE `thread` MODIFIER'S RULES (D-181). A thread body owns an executor
    // and the arena its frames come from (D-034), which is why it is a
    // different kind of function rather than the same one used differently:
    // it is `async` (D-071 — a thread's entry point is an async func), its
    // success is `NIL` (nothing can collect a thread's value; only its error
    // reaches the join), and the two functions outside the Result regime
    // cannot be threads at all.
    if (raw decl_has(d, raw DECL_THREAD())) {
        if (!e.fn_is_async) {
            discard(raw te_error(e, raw TYPE_THREAD_RULES(),
                "a `thread` function is `async` (D-071/D-181): a thread's entry point runs on its own executor, and `await` is how anything on an executor waits",
                d.span));
        }
        if (e.fn_terminal) {
            discard(raw te_error(e, raw TYPE_THREAD_RULES(),
                "`main` and `failsafe` cannot be `thread` functions (D-181): `main` already owns the program's first executor, and `failsafe` runs on the trapping thread as a plain call (D-063)",
                d.span));
        }
        if ((raw type_kind(e.types, sg.success)) != (raw TY_NIL())) {
            discard(raw te_error(e, raw TYPE_THREAD_RULES(),
                "a `thread` function's success type is `NIL` (D-181, inheriting D-179's spawn rule): a thread is started by `drop f(…)`, and only its ERROR reaches the join — a value would have nowhere to go",
                d.span));
        }
    }

    // `failsafe` TAKES EXACTLY ONE `Error` (D-179): the runtime routes every
    // uncaught failure through it, and the route has one shape. Checked here
    // because this is where the function's identity is already in hand.
    if (raw string_eq(raw intern_get(e.interns, raw decl_name(d)), "failsafe")) {
        bool:fs_ok = ((raw fn_param_count(e.ast, d)) == 1i32);
        if (fs_ok) {
            DeclNode:fsp = raw ast_decl(e.ast, raw fn_param(e.ast, d, 0i32));
            TypeResolver:fsr = raw etyper_resolver(e);
            int32:fspt = raw resolve_type(@fsr, raw param_type(fsp), e.scope);
            if (fspt != e.types.t_error) {
                if (!(raw type_is_invalid(e.types, fspt))) { fs_ok = false; }
            }
        }
        if (!fs_ok) {
            discard(raw te_error(e, raw TYPE_FAILSAFE_SIG(),
                "`failsafe` takes exactly one `Error` (D-179): `func:failsafe = int32(Error:e) { … }` — the runtime routes every uncaught failure through it",
                d.span));
        }
    }
    if (e.fn_never_fails) {
        // A terminal function returns no `Result`, so `never fails` says nothing
        // there (D-163). The clause MAY combine with `requires`/`ensures` and
        // `limit<Rules>` since D-241 (1.5.1): D-163's row delegated the
        // violation channel to C-15/C-16, D-220/D-221 chose the trap route,
        // and a never-fails body already admits that channel (`?!`, an
        // overflow, a division) — so a contract is not a failure channel, and
        // the functions a contract may CALL are exactly the never-failing ones.
        if (e.fn_terminal) {
            discard(raw te_error(e, raw TYPE_NEVER_FAILS_CAN_FAIL(),
                "`main`/`failsafe` return no `Result`, so `never fails` says nothing there (D-163)",
                d.span));
        }
        if (raw decl_has(d, raw DECL_ASYNC())) {
            discard(raw te_error(e, raw TYPE_NEVER_FAILS_CAN_FAIL(),
                "an `async` function may not be `never fails` (D-163): a suspended task can be cancelled, and cancellation is an error the contract would deny",
                d.span));
        }
    }

    // THE CONTRACTS ARE TYPED (1.5.1, D-221): `requires` and `ensures` are
    // propositions — `bool`, evaluable anywhere — and `ensures` may name
    // `result`, the SUCCESS value. Typed before the body, under the
    // function's own generic scope, so a contract over a generic parameter
    // types under the binding the signature did. `acquires` is the lock
    // analysis's (a level, folded there), `joins` was typed above, and the
    // marker clauses carry no expression. Until 1.5.1 these were "the
    // verifier's, typed nowhere" — the sentence above the `joins` loop —
    // which is how a contract of any type at all was accepted.
    int32:cci = 0i32;
    int32:fn_measures = 0i32;
    while (cci < ncontracts) decreases ncontracts - cci {
        VerifyNode:ccv = raw ast_verify(e.ast, raw fn_contract(e.ast, d, cci));
        if (ccv.kind == VerifyKind.VerifyContractNode) {
            int32:ck = raw contract_kind(ccv);
            // A FUNCTION'S `decreases E` (D-304 (1), (5); 1.5.8c step 1): the
            // measure over the parameters, a plain integer (TYPE-073), typed
            // under the measure context; one at most (TYPE-072); none on
            // `main`/`failsafe` (D-244). And, until step 4 computes the
            // recursive groups (1.5.8c step 4, `analysis/recursion.npk`), which
            // report TYPE-074 and TYPE-075 -- the checker only types the measure.
            if (ck == (raw CONTRACT_DECREASES())) {
                fn_measures = fn_measures + 1i32;
                if (e.fn_terminal) {
                    discard(raw te_error(e, raw TYPE_CONTRACT_RULES(),
                        "`main` and `failsafe` carry no contract (D-244): nobody calls them, so a `decreases` has no recursive call to be checked at",
                        ccv.span));
                } else {
                    if (fn_measures > 1i32) {
                        discard(raw te_error(e, raw TYPE_LOOP_CLAUSE(),
                            "a function states `decreases` at most once (D-304): a second measure would compare against which?",
                            ccv.span));
                    } else {
                        // TYPED HERE; JUDGED BY THE GROUPS (1.5.8c step 4): a measure on a
                        // function whose recursive group has no cycle is TYPE-075, and a
                        // cyclic group with a measure on some member and none on another
                        // is TYPE-074 -- both reported by `analysis/recursion.npk`, which
                        // computes the groups after every body is typed.
                        int32:fmt = raw check_measure_expr(e, raw contract_cond(ccv));
                        // AT MOST 64 BITS WIDE (1.5.8c step 4): a function's measure is
                        // compared against the OTHER members' at every call inside the
                        // group -- `m1 < m0` across two declarations whose measures may
                        // differ in width and sign -- so the predicates widen every
                        // measure into one signed 128-bit domain, which holds every
                        // plain integer of at most 64 bits exactly and nothing wider.
                        // A loop's measure compares only with itself and keeps its
                        // own width (any width, the prelude's `uint2048` loops among
                        // them).
                        if (fmt != 0i32) {
                            if ((raw type_int_bits(e.types, fmt)) > 64i32) {
                                ExprNode:fmn = raw ast_expr(e.ast, raw contract_cond(ccv));
                                discard(raw te_error(e, raw TYPE_MEASURE_KIND(),
                                    "a function's `decreases` measure is at most 64 bits wide (D-304): every member of a recursive group compares its measure against the others' in one signed 128-bit domain at each call inside the group, and a wider width does not fit it",
                                    fmn.span));
                            }
                        }
                    }
                }
            }
            int32:cctx = 0i32;
            if (ck == (raw CONTRACT_REQUIRES())) { cctx = raw CTX_REQUIRES(); }
            if (ck == (raw CONTRACT_ENSURES()))  { cctx = raw CTX_ENSURES(); }
            if (cctx != 0i32) {
                // `main` AND `failsafe` CARRY NO CONTRACT (D-244, 1.5.1 step
                // 5): nobody calls them, so a `requires` has no caller to hold
                // to it; their exit is not a return, so `ensures result` names
                // nothing; and D-014's postcondition on `failsafe` is the
                // COMPILER's (1.5.3), never the author's. Refused at the clause
                // and not typed, so one mistake is one sentence.
                if (e.fn_terminal) {
                    discard(raw te_error(e, raw TYPE_CONTRACT_RULES(),
                        "`main` and `failsafe` carry no contract (D-244): nobody calls them, their exit is not a return, and `failsafe`'s positive-return postcondition is the compiler's own (D-014)",
                        ccv.span));
                } else {
                    drop check_proposition(e, raw contract_cond(ccv), cctx);
                }
            }
        }
        cci = cci + 1i32;
    }
    // A PARAMETER'S `limit<Rules>` (1.5.1, D-220): the rule's subject is the
    // parameter's own type, by identity. A type parameter is never it.
    int32:lpi = 0i32;
    int32:nparams = raw fn_param_count(e.ast, d);
    while (lpi < nparams) decreases nparams - lpi {
        DeclNode:lpd = raw ast_decl(e.ast, raw fn_param(e.ast, d, lpi));
        // a callable parameter may not take a builtin's name (D-296) -- of a
        // function, a method or a bodiless signature alike: one rule
        TypeResolver:cpr = raw etyper_resolver(e);
        drop check_callable_name(e, raw decl_name(lpd), raw resolve_type(@cpr, raw param_type(lpd), scope),
                                 "a parameter", lpd.span);
        drop refuse_field_quals(e, raw param_quals(lpd), "a parameter", lpd.span);
        VerifyId:lpl = raw param_limit(lpd);
        if (!(raw verify_is_none(lpl))) {
            TypeResolver:lpr = raw etyper_resolver(e);
            int32:lpt = raw resolve_type(@lpr, raw param_type(lpd), scope);
            drop check_limit_subject(e, lpl, lpt, lpd.span);
            // WHERE NO WRITE POINT EXISTS (1.5.2 step 1, D-251): a declaration
            // without a body has no entry to check at, and a `comptime`
            // function's entry is the folder's, not the emitter's.
            if (raw stmt_is_none(raw fn_body(e.ast, d))) {
                discard(raw te_error(e, raw TYPE_LIMIT_NO_WRITE_POINT(),
                    "a parameter of a declaration without a body cannot carry a `limit` (D-251): a trait signature has no entry to check at -- the impl's own parameter may",
                    lpd.span));
            }
            if (raw decl_has(d, raw DECL_COMPTIME())) {
                discard(raw te_error(e, raw TYPE_LIMIT_NO_WRITE_POINT(),
                    "a `comptime` function's parameter cannot carry a `limit` (D-251): the frontend folder evaluates the call, and the check is the emitter's",
                    lpd.span));
            }
            // `main` AND `failsafe` CARRY NO CONTRACT (D-244), a parameter's
            // `limit` included: nobody but the runtime calls them, and a trap
            // at `failsafe`'s own entry re-enters the route.
            if (e.fn_terminal) {
                discard(raw te_error(e, raw TYPE_CONTRACT_RULES(),
                    "`main` and `failsafe` carry no contract (D-244), a parameter's `limit` included: nobody but the runtime calls them",
                    lpd.span));
            }
        }
        lpi = lpi + 1i32;
    }

    // A TRAIT METHOD WITH NO BODY IS A DECLARATION, not an empty function. The
    // absence is real (`parse_decls.npk` says so), so there is nothing to walk —
    // and walking the NONE statement would report every required trait method as
    // failing to return a value.
    StmtId:body = raw fn_body(e.ast, d);
    if (!(raw stmt_is_none(body))) {
        drop check_stmt(e, body);
    }
    e.generics = saved;
    pass NIL;
};

// `Self` INSIDE AN `impl` BLOCK IS ITS TARGET (D-171): the target is written in
// every form now — `T` for a blanket, `Box<T>` for a family, `Point` for a
// concrete one — so it resolves the same way for all three, under the impl's
// own parameters (a blanket's `T` and a family's `Box<T>` both need them).
func:impl_self_type = int32(ExprTyper->:e, DeclNode:d, int32:scope) never fails {
    TypeId:tgt = raw impl_target(e.ast, d);
    if (raw type_is_none(tgt)) { pass 0i32; }
    TypeResolver:r = raw etyper_resolver(e);
    // THE OLD BLANKET SPELLING WAS REFUSED BY NAME at collection (TYPE-012,
    // D-171); resolving its trait as a value type here would add the generic
    // TYPE-002 to that report -- one mistake, one report (D-240).
    if ((raw impl_old_blanket_trait(@r, d, scope)) != 0i32) { pass 0i32; }
    IdSpan:gw = raw decl_generic_window(e.ast, d);
    GenericScope:saved = r.generics;
    r.generics = GenericScope{ params_start: gw.start, params_count: gw.count,
                               args_start: 0i32, args_count: 0i32 };
    int32:st = raw resolve_type(@r, tgt, scope);
    r.generics = saved;
    pass st;
};

