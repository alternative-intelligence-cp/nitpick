// Statement checking.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.4, completing the `Result` discipline.
//
// Three jobs, and they are the ones that make the expression rules load-bearing:
//
//   * A DECLARATION'S INITIALISER MUST MATCH ITS ANNOTATION. Nitpick has no
//     inferred bindings, so every local states its type and this is where the
//     statement is held to it.
//   * `pass` AND `fail` ARE SUGAR over `return Result{…}` (TYPE_REFERENCE §11),
//     so they are checked as what they desugar to rather than as their own rules.
//   * EVERY CONDITION IS A STRICT `bool`. There is no truthiness, and a condition
//     is where a tainted or mistyped value would otherwise steer a decision.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./type_names.npk".*;
use "./parse_stmt.npk".*;
use "./parse_expr.npk".*;
use "./parse_pick.npk".*;
use "./parse_decl.npk".*;
use "./symbols.npk".*;
use "./resolve_type.npk".*;
use "./type_decl.npk".*;
use "./type_layout.npk".*;
use "./expr_types.npk".*;
use "./type_expr.npk".*;

// THE WALK IS TOTAL, AND IT WAS NOT.
//
// What stood here answered nine of the twenty-five statement kinds and returned
// quietly for the other sixteen — including every kind that CONTAINS statements.
// So an `if` had its condition checked and its body ignored, and nothing inside
// any block, loop, `pick` arm or `defer` was type-checked at all. The tests did
// not see it because the harness put each case at the top level of a function
// body, with a comment saying so.
//
// That is the same hole `resolve_audit` and `check_kinds_reachable` were built
// for, arriving a third time in a third pass, so it gets the same answer: every
// kind reached explicitly, an out-loud "nothing to check" for the ones that carry
// nothing, and an INTERNAL DIAGNOSTIC where a walk used to return quietly.
// `stmt_is_classified` is the total table over that, and
// `tests/frontend/type_stmt.npk` walks `1..STMT_KIND_MAX` against it so the next
// statement kind cannot arrive unvisited the way sixteen of them did.
pub func:check_stmt = NIL(ExprTyper->:e, StmtId:id) {
    if (raw stmt_is_none(id)) { pass NIL; }
    StmtNode:s = relay ast_stmt(e.ast, id);

    if (s.kind == StmtKind.StmtVarDeclStmt) { drop check_var_decl(e, s); pass NIL; }
    if (s.kind == StmtKind.StmtAssignStmt)  { drop check_assign(e, s);   pass NIL; }
    if (s.kind == StmtKind.StmtPassStmt)    { drop check_pass(e, s);     pass NIL; }
    if (s.kind == StmtKind.StmtFailStmt)    { drop check_fail(e, s);     pass NIL; }
    if (s.kind == StmtKind.StmtReturnStmt)  { drop check_return(e, s);   pass NIL; }
    if (s.kind == StmtKind.StmtExitStmt)    { drop check_exit(e, s);     pass NIL; }

    if (s.kind == StmtKind.StmtBlockStmt) {
        drop check_stmt_window(e, raw stmt_list_start(s), raw stmt_list_count(s));
        pass NIL;
    }

    // EVERY CONDITION IS A `bool`, and the check is one line because
    // `require_bool` already says why (0.4.2). Grouped rather than listed
    // per-statement so a new conditional form cannot arrive without one — and
    // each now walks its BODY, which is the part that was missing.
    if (s.kind == StmtKind.StmtIfStmt) {
        drop check_cond(e, s);
        drop check_stmt(e, raw stmt_then(s));
        drop check_stmt(e, raw stmt_else(s));
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        drop check_cond(e, s);
        drop check_stmt(e, relay stmt_body(e.ast, s));
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        drop check_cond(e, s);
        drop check_stmt(e, relay stmt_when_body(e.ast, s));
        drop check_stmt(e, relay stmt_when_then(e.ast, s));
        drop check_stmt(e, relay stmt_when_end(e.ast, s));
        pass NIL;
    }
    // `loop`/`till` — HEAD ARGUMENTS AND A BODY, AND NO CONDITION.
    //
    // `check_cond` used to be called on a `till`, and slot `a` on a counted
    // statement is the BODY: a `StmtId` read as an `ExprId`, so the checker typed
    // whatever expression node happened to sit at the body's index. `stmt_cond`
    // and `stmt_counted_body` both read slot `a` and mean different things by it,
    // which is the third time a slot meaning two things has cost this compiler a
    // defect. `till(limit, step)` bounds itself with head arguments; there is no
    // condition anywhere in either form.
    if (s.kind == StmtKind.StmtLoopStmt) { drop check_counted(e, s); pass NIL; }
    if (s.kind == StmtKind.StmtTillStmt) { drop check_counted(e, s); pass NIL; }

    if (s.kind == StmtKind.StmtForStmt) {
        drop check_for(e, s);
        drop check_stmt(e, relay stmt_for_body(e.ast, s));
        pass NIL;
    }

    // A `pick`'s selector, its arms' BINDING TYPES, and then the bodies. A
    // destructuring arm's binding takes its type from the variant's payload, and
    // until 0.7.7 nothing recorded it: `type_ident` answered UNKNOWN for every
    // pattern binding, and unknown propagates silently — `d + "x"` inside an arm
    // type-checked. Found by the backend's first `pick` program, not by a test.
    // The type is written onto the PATTERN's spare slot, the way resolution
    // writes a symbol onto an identifier, and `type_ident` reads it back.
    if (s.kind == StmtKind.StmtPickStmt) {
        int32:selt = relay type_of_expr(e, raw pick_selector(s));
        drop type_pick_bindings(e, s, selt);
        drop check_arms(e, raw pick_arm_start(s), raw pick_arm_count(s));
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPickArm) {
        drop type_of_expr(e, raw arm_guard(s));
        drop check_stmt(e, raw arm_body(s));
        pass NIL;
    }

    if (s.kind == StmtKind.StmtDeferStmt) {
        StmtId:body = StmtId{ index: s.a };
        drop check_stmt(e, body);
        pass NIL;
    }

    // `break`, `continue` and `fall` carry a LABEL and no expression, so there is
    // nothing here to type. Said out loud rather than reached by falling off the
    // end, because "./nothing to check" and "nobody has looked" are the two answers
    // this function exists to keep apart.
    if (s.kind == StmtKind.StmtBreakStmt)    { pass NIL; }
    if (s.kind == StmtKind.StmtContinueStmt) { pass NIL; }
    if (s.kind == StmtKind.StmtFallStmt)     { pass NIL; }

    // One expression in slot `a`, typed for its own sake: an expression
    // statement, `trap`, `discard`, `give`, `prove`, `assert_static`. A mistake
    // inside one is worth reporting even where the value goes nowhere.
    if (raw stmt_carries_expr(s.kind)) {
        drop type_of_expr(e, raw stmt_expr(s));
        pass NIL;
    }

    drop te_error(e, raw TYPE_INTERNAL(),
        "this statement kind has no entry in the checker's walk, so its contents cannot be checked",
        s.span);
    pass NIL;
};


// EVERY STATEMENT KIND IS ACCOUNTED FOR — the mechanical half of the check, and
// the half a test can prove. Whether each rule is RIGHT is not answerable this
// way, which is what 0.4.8's negative coverage is for; whether each kind is
// VISITED is, and that is the failure that just happened.
pub func:stmt_is_classified = bool(StmtKind:k) {
    if (k == StmtKind.StmtNone) { pass false; }
    if (raw stmt_carries_expr(k)) { pass true; }
    if (k == StmtKind.StmtBlockStmt)     { pass true; }
    if (k == StmtKind.StmtVarDeclStmt)   { pass true; }
    if (k == StmtKind.StmtAssignStmt)    { pass true; }
    if (k == StmtKind.StmtIfStmt)        { pass true; }
    if (k == StmtKind.StmtPickStmt)      { pass true; }
    if (k == StmtKind.StmtPickArm)       { pass true; }
    if (k == StmtKind.StmtWhileStmt)     { pass true; }
    if (k == StmtKind.StmtForStmt)       { pass true; }
    if (k == StmtKind.StmtLoopStmt)      { pass true; }
    if (k == StmtKind.StmtTillStmt)      { pass true; }
    if (k == StmtKind.StmtWhenStmt)      { pass true; }
    if (k == StmtKind.StmtBreakStmt)     { pass true; }
    if (k == StmtKind.StmtContinueStmt)  { pass true; }
    if (k == StmtKind.StmtFallStmt)      { pass true; }
    if (k == StmtKind.StmtPassStmt)      { pass true; }
    if (k == StmtKind.StmtFailStmt)      { pass true; }
    if (k == StmtKind.StmtReturnStmt)    { pass true; }
    if (k == StmtKind.StmtExitStmt)      { pass true; }
    pass (k == StmtKind.StmtDeferStmt);
};

pub func:check_stmt_window = NIL(ExprTyper->:e, int32:start, int32:count) {
    int32:i = 0i32;
    while (i < count) {
        StmtId:x = StmtId{ index: raw ast_id_at(e.ast, start, i) };
        drop check_stmt(e, x);
        i = i + 1i32;
    }
    pass NIL;
};

// One binding, one payload, one recorded type. A variant carrying MORE than one
// payload is 0.9's — the backend rungs it, and its multi-binding typing lands
// with that lift; until then those bindings stay unknown exactly as before.
func:type_pick_bindings = NIL(ExprTyper->:e, StmtNode:s, int32:selt) {
    if (selt == 0i32) { pass NIL; }
    if ((raw type_kind(e.types, selt)) != (raw TY_ENUM())) { pass NIL; }
    int32:i = 0i32;
    while (i < (raw pick_arm_count(s))) {
        StmtNode:arm = relay ast_stmt(e.ast, raw pick_arm_at(e.ast,
                                          raw pick_arm_start(s), i));
        PatId:pid2 = raw arm_pattern(arm);
        if (!(raw pat_is_none(pid2))) {
            PatNode:pn = relay ast_pat(e.ast, pid2);
            if (pn.kind == PatKind.PatEnumDestructure) {
                if ((relay pat_enum_bind_count(e.ast, pn)) == 1i32) {
                    drop type_one_binding(e, pid2, pn, selt);
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:type_one_binding = NIL(ExprTyper->:e, PatId:pid2, PatNode:pn, int32:selt) {
    int32:segs = relay pat_enum_segment_count(e.ast, pn);
    if (segs <= 0i32) { pass NIL; }
    int32:vname = relay pat_enum_segment(e.ast, pn, segs - 1i32);
    DeclId:did = DeclId{ index: raw type_decl(e.types, selt) };
    DeclNode:d = relay ast_decl(e.ast, did);
    int32:i = 0i32;
    while (i < (raw item_member_count(e.ast, d))) {
        DeclNode:m = relay ast_decl(e.ast, raw item_member(e.ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == vname) {
                if ((raw variant_payload_count(m)) == 1i32) {
                    TypeResolver:r = raw etyper_resolver(e);
                    int32:home = raw symtab_home_scope(e.tab, did.index, e.scope);
                    int32:pt = relay resolve_type(@r,
                        TypeId{ index: relay ast_id_at(e.ast,
                                    raw variant_payload_start(m), 0i32) },
                        home);
                    drop ast_set_pat_a(e.ast, pid2, pt);
                }
                pass NIL;
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:check_arms = NIL(ExprTyper->:e, int32:start, int32:count) {
    int32:i = 0i32;
    while (i < count) {
        drop check_stmt(e, raw pick_arm_at(e.ast, start, i));
        i = i + 1i32;
    }
    pass NIL;
};

// `for (T:x in e)` — WHAT `e` IS, AND THAT `T` IS ITS ELEMENT (D-166, 1.0.9).
// Until 1.0.9 this typed the iterable and the body and never looked at the
// binding: `for (int8:i in 300i64..302i64)` passed and `llc` refused the IR,
// and `for (int32:v in p)` over a struct reached the backend, which refused
// it as a rung — calling it valid. A range, a slice and an array iterate
// their element; an `Iterator` implementor joins them at 1.0.9d with its
// lowering; anything else is refused here by name.
func:check_for = NIL(ExprTyper->:e, StmtNode:s) {
    int32:it = relay type_of_expr(e, relay stmt_for_iter(e.ast, s));
    if (it == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, it)) { pass NIL; }
    // ONE LEVEL OF AUTO-DEREFERENCE (D-098), as `.` and UFCS do: `for` over a
    // BORROW of a collection — `@arr`, an `int32[4]->` — reaches the element,
    // and the borrow analysis is what refuses it (D-004: a for-binding over a
    // borrowed collection is untracked). Preempting it here with a type error
    // would move a safety refusal to the wrong stage and lose its diagnostic.
    int32:it1 = it;
    if ((raw type_kind(e.types, it)) == (raw TY_POINTER())) {
        it1 = raw type_elem(e.types, it);
    }
    int32:k = raw type_kind(e.types, it1);
    int32:elem = 0i32;
    if (k == (raw TY_RANGE())) { elem = raw type_elem(e.types, it1); }
    if (k == (raw TY_SLICE())) { elem = raw type_elem(e.types, it1); }
    if (k == (raw TY_ARRAY())) { elem = raw type_elem(e.types, it1); }
    if (elem == 0i32) {
        string:n1 = relay string_concat("`",
                        relay type_display(e.types, e.interns, it));
        drop te_error(e, raw TYPE_NOT_ITERABLE(),
            relay string_concat(n1,
                "` is not iterable: `for` takes a range, a slice or an array (D-023, D-166); `loop`/`till` count, and an `Iterator` implementor arrives with 1.0.9d"),
            s.span);
        pass NIL;
    }
    TypeResolver:r = raw etyper_resolver(e);
    DeclNode:bd = relay ast_decl(e.ast, raw stmt_for_binding(s));
    int32:bt = relay resolve_type(@r, raw param_type(bd), e.scope);
    if (bt == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, bt)) { pass NIL; }
    // EQUAL, NOT `fits`: a typed binding is the element, with no wrap and no
    // widening — the same rule every other typed binding has (D-092).
    if (bt != elem) {
        string:b1 = relay string_concat("a `for` binding's type is the element type: this iterable yields `",
                        relay type_display(e.types, e.interns, elem));
        string:b2 = relay string_concat(b1, "` and the binding declares `");
        string:b3 = relay string_concat(b2, relay type_display(e.types, e.interns, bt));
        drop te_error(e, raw TYPE_MISMATCH(), relay string_concat(b3, "`"), bd.span);
    }
    pass NIL;
};

func:check_counted = NIL(ExprTyper->:e, StmtNode:s) {
    int32:n = relay stmt_counted_argc(e.ast, s);
    int32:i = 0i32;
    while (i < n) {
        drop type_of_expr(e, relay stmt_counted_arg(e.ast, s, i));
        i = i + 1i32;
    }
    e.counted_depth = e.counted_depth + 1i32;
    drop check_stmt(e, raw stmt_counted_body(s));
    e.counted_depth = e.counted_depth - 1i32;
    pass NIL;
};

func:check_cond = NIL(ExprTyper->:e, StmtNode:s) {
    ExprId:c = raw stmt_cond(s);
    if (raw expr_is_none(c)) { pass NIL; }
    int32:t = relay type_of_expr(e, c);
    if (t == 0i32) { pass NIL; }
    drop require_bool(e, t, s.span);
    pass NIL;
};

// `Type:name = init;` — the initialiser is checked against the ANNOTATION, and
// the annotation is also what an unsuffixed literal in the initialiser takes its
// type from. `int8:n = 10;` works for that reason and for no other: nothing is
// inferred, the type was written down and the literal reads it.
func:check_var_decl = NIL(ExprTyper->:e, StmtNode:s) {
    TypeResolver:r = raw etyper_resolver(e);
    TypeId:ann = raw stmt_decl_type(s);
    int32:want = relay resolve_type(@r, ann, e.scope);

    ExprId:init = raw stmt_decl_init(e.ast, s);
    if (raw expr_is_none(init)) { pass NIL; }

    int32:saved = e.expected;
    e.expected = want;
    int32:got = relay type_of_expr(e, init);
    e.expected = saved;

    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (raw type_is_invalid(e.types, want)) { pass NIL; }
    // `fits` rather than equality, so that `int32?:b = 42i32;` builds the
    // `Optional` holding a value (D-099). That wrap is the only thing `fits`
    // permits beyond equality.
    if (!(raw fits(e, want, got))) {
        drop te_assign_mismatch(e, want, got, s.span);
    }
    pass NIL;
};

// `x = v;` AND `x op= v;` — the statement that was never checked at all.
//
// It parsed from cycle 0.2, resolved both sides from 0.3, and `check_stmt` had no
// case for it, so `int32:x = 1i32; x = true;` passed clean. Three separate
// questions, and each was unasked:
//
//   1. IS THE TARGET SOMETHING THAT CAN BE ASSIGNED TO? `5i32 = x;` parses.
//   2. DOES THE VALUE FIT? The same `fits` every other slot uses (D-099), so an
//      `int32?` target takes a bare `int32` here exactly as it does in a
//      declaration — a rule that differed between the two would be one more
//      thing to remember.
//   3. FOR `op=`, DO THE OPERANDS SUPPORT THE OPERATION? `x += 1i32` on a `bool`
//      is the arithmetic rule asked of a type that has none.
func:check_assign = NIL(ExprTyper->:e, StmtNode:s) {
    ExprId:target = raw stmt_target(s);
    ExprId:value = raw stmt_assigned(s);

    int32:want = relay type_of_expr(e, target);
    drop require_place(e, target, s.span);

    int32:saved = e.expected;
    e.expected = want;
    int32:got = relay type_of_expr(e, value);
    e.expected = saved;

    if (want == 0i32) { pass NIL; }
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, want)) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }

    // `x op= v` IS `x = x op v`, so it is held to the operator's own operand rule
    // before the result is held to the target. Reusing `type_arithmetic` and
    // `type_bitwise` rather than restating them is the point: `+=` refusing what
    // `+` accepts, or the reverse, is a difference nobody would predict.
    TokenKind:op = raw stmt_op(s);
    if (op != TokenKind.OpAssign) {
        if (raw is_bitwise_assign(op)) {
            drop type_bitwise(e, s.span, want, got);
        } else {
            drop type_arithmetic(e, s.span, want, got);
        }
        pass NIL;
    }

    if (!(raw fits(e, want, got))) {
        drop te_assign_mismatch(e, want, got, s.span);
    }
    pass NIL;
};

func:is_bitwise_assign = bool(TokenKind:op) {
    if (op == TokenKind.OpAmpAssign)   { pass true; }
    if (op == TokenKind.OpPipeAssign)  { pass true; }
    if (op == TokenKind.OpCaretAssign) { pass true; }
    if (op == TokenKind.OpShlAssign)   { pass true; }
    pass (op == TokenKind.OpShrAssign);
};

// WHAT CAN BE ASSIGNED TO — the same question `@`, `$$i`, `$$m` and `move` ask,
// so it is answered by the same function.
//
// WHAT STOOD HERE LOOKED AT THE TOP NODE ONLY: an identifier, a member access, an
// index or a dereference passed, whatever they were built on. `f().x = 5i32;` is a
// member access and was accepted — a store into a field of a value that has no
// home. `expr_is_place` walks to the ROOT, so the answer is about where the
// storage is rather than about what the outermost operator happens to be.
//
// The message names the form rather than saying "not assignable", because the
// mistake is usually a comparison written with one `=` and the reader needs to be
// pointed at that rather than at a definition.
func:require_place = NIL(ExprTyper->:e, ExprId:id, Span:at) {
    if (raw expr_is_none(id)) { pass NIL; }
    if (relay expr_is_place(e.ast, id, raw BORROW_FUEL())) { pass NIL; }
    drop te_error(e, raw TYPE_NOT_A_PLACE(),
        "this is a value, not somewhere to store one; only a name, a field, an element or a `<-` dereference can be assigned to — and `==` is the comparison",
        at);
    pass NIL;
};

// `pass v;` desugars to `return Result{error: 0tbb32, value: v};` — so `v` is
// checked against the function's SUCCESS type, not its `Result` type.
func:check_pass = NIL(ExprTyper->:e, StmtNode:s) {
    ExprId:v = raw stmt_operand(s);
    int32:want = e.fn_success;

    // `pass;` with no value is `pass NIL;`. Void functions do not exist, so the
    // bare form is the one that returns `Result<NIL>`.
    //
    // AND IN A FUNCTION RETURNING AN `Optional` IT IS THE EMPTY ONE, because that
    // is what `pass NIL;` means there (D-099) and the bare form is defined as that
    // spelling. `func:find = int32?() { pass; }` therefore returns nothing found.
    //
    // This is written out rather than folded into `fits`, and the difference
    // matters: `fits` answers about a VALUE of type `NIL`, and letting one become
    // an empty `Optional` would make `int32?:x = drop f();` typecheck — `drop`
    // yields `NIL` precisely so that using it as a value is an error.
    if (raw expr_is_none(v)) {
        if (want != 0i32) {
            bool:ok = (want == e.types.t_nil);
            if ((raw type_kind(e.types, want)) == (raw TY_OPTIONAL())) { ok = true; }
            if (!ok) {
                drop te_assign_mismatch(e, want, e.types.t_nil, s.span);
            }
        }
        pass NIL;
    }

    int32:saved = e.expected;
    e.expected = want;
    int32:got = relay type_of_expr(e, v);
    e.expected = saved;
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (want == 0i32) { pass NIL; }
    if (!(raw fits(e, want, got))) {
        drop te_assign_mismatch(e, want, got, s.span);
    }
    pass NIL;
};

// `fail c;` desugars to `return Result{error: c, value: zero};` — so `c` is a
// `tbb32`, the same type `Result.error` holds and the same one `failsafe` takes.
//
// `fail` IN `main` OR `failsafe` IS REFUSED for the reason `relay` is: there is
// no `Result` to fail into, and an error leaving the program's last frame has
// nowhere to go. That is the uncontrolled stop the discipline exists to prevent.
func:check_fail = NIL(ExprTyper->:e, StmtNode:s) {
    if (e.fn_terminal) {
        drop te_error(e, raw TYPE_RESULT_RETURN(),
            "`fail` returns an error from the enclosing function, and `main` and `failsafe` return no `Result` to fail into; `exit` is how a program stops",
            s.span);
    }
    ExprId:c = raw stmt_operand(s);
    if (raw expr_is_none(c)) { pass NIL; }

    int32:saved = e.expected;
    e.expected = e.types.t_tbb32;
    int32:got = relay type_of_expr(e, c);
    e.expected = saved;
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (got != e.types.t_tbb32) {
        drop te_assign_mismatch(e, e.types.t_tbb32, got, s.span);
    }
    pass NIL;
};

// `return` TAKES A `Result{…}` LITERAL AND NOTHING ELSE (AST_REFERENCE §2).
//
// The restriction is what keeps `pass` and `fail` honest: they are sugar over
// this form, so the form has to exist and has to be the only other way in. A
// `return v;` accepting a bare value would give the language two spellings for
// the success path, one of which silently supplies an error field nobody wrote.
func:check_return = NIL(ExprTyper->:e, StmtNode:s) {
    ExprId:v = raw stmt_operand(s);
    if (raw expr_is_none(v)) {
        drop te_error(e, raw TYPE_RESULT_RETURN(),
            "`return` takes a `Result{…}` literal; `pass` and `fail` are the shorthands for one field at a time",
            s.span);
        pass NIL;
    }
    ExprNode:n = relay ast_expr(e.ast, v);
    if (n.kind != ExprKind.ExprResultLiteralExpr) {
        drop te_error(e, raw TYPE_RESULT_RETURN(),
            "`return` takes a `Result{…}` literal and nothing else; write `pass v;` for a value or `fail c;` for an error",
            s.span);
        pass NIL;
    }
    drop type_of_expr(e, v);
    pass NIL;
};

// `exit` IS LEGAL ONLY IN `main` AND `failsafe` — the whole reason those two are
// shaped differently. Anywhere else, stopping the program bypasses every caller's
// error handling and every `defer` between here and the top, which is exactly the
// uncontrolled shutdown the language exists to make impossible.
func:check_exit = NIL(ExprTyper->:e, StmtNode:s) {
    if (!e.fn_terminal) {
        drop te_error(e, raw TYPE_RESULT_RETURN(),
            "`exit` is legal only in `main` and `failsafe`; elsewhere it would stop the program past every caller's error handling and every pending `defer` — `fail` is how a function reports failure",
            s.span);
    }
    ExprId:c = raw stmt_operand(s);
    if (raw expr_is_none(c)) { pass NIL; }
    int32:saved = e.expected;
    e.expected = raw tt_int(e.types, 32i32, true);
    drop type_of_expr(e, c);
    e.expected = saved;
    pass NIL;
};

// --- the walk over a module (cycle 0.4.8) -------------------------------------------------
//
// EVERY DECLARATION, WHETHER OR NOT ANYTHING REACHES IT.
//
// Three gaps closed at once, and they were one gap wearing three faces — there
// was no driver, so every test fixture hand-rolled a walk and each one walked
// only what its own cases needed:
//
//   * AN `impl` METHOD'S BODY WAS NEVER TYPE-CHECKED. `resolve.npk` descends into
//     impl members and binds their names; nothing type-checked them, in any
//     cycle. A method written exactly where TRAITS_REFERENCE 2.4 puts it had its
//     names resolved and its types never looked at.
//   * A DECLARATION NOTHING REACHES WAS NEVER TYPE-RESOLVED. `tests/frontend/
//     type_access.npk` says so in a comment — "a case testing a bad signature has
//     to CALL the function" — so a bad return type in an uncalled function, or a
//     bound violation in an unused global's annotation, went unreported.
//   * A TRAIT'S DEFAULT METHOD BODY was in neither set.
//
// WHAT MADE THIS AFFORDABLE IS DIAGNOSTIC DEDUPLICATION (D-110). Resolving every
// signature means resolving the reached ones twice — once here and once when
// something reaches them — and each of those resolutions is correct to report
// what it finds. Without deduplication, being complete would mean being noisy,
// and the alternatives are worse: reporting on some paths and not others is a
// rule that depends on which path ran, and visiting less to stay quiet is
// checking less.
// THE RESOLVER IS DERIVED FROM THE CHECKER, NEVER THREADED THROUGH IT.
//
// This walk first took a `TypeResolver` as a parameter, and the trait case then
// set `Self` on the CHECKER while every signature was resolved through the
// resolver that had been handed in — so a trait's own `func:show = string(Self:self)`
// reported "`Self` is valid only inside a `trait` or `impl` body" from inside a
// trait body. Two places holding one piece of context, and they disagreed.
//
// `etyper_resolver` exists precisely to stop that (D-110): context every
// resolution needs belongs to the constructor rather than to whoever remembers to
// pass it. So the walk sets the context on `e` and builds a resolver from `e`
// wherever it needs one.
pub func:check_module = NIL(ExprTyper->:e, DeclId:mod_id, int32:scope) {
    DeclNode:m = relay ast_decl(e.ast, mod_id);
    int32:n = raw item_member_count(e.ast, m);
    int32:i = 0i32;
    while (i < n) {
        drop check_decl(e, raw item_member(e.ast, m, i), scope);
        i = i + 1i32;
    }
    pass NIL;
};

func:check_decl = NIL(ExprTyper->:e, DeclId:id, int32:scope) {
    DeclNode:d = relay ast_decl(e.ast, id);

    if (d.kind == DeclKind.DeclFunctionDecl) {
        drop check_function(e, id, scope);
        pass NIL;
    }

    // A NESTED `mod:name = { … };` IS CHECKED, in the scope its name opened.
    //
    // NOTHING CHECKED IT AT ALL until now. The resolver descends into a nested
    // module and binds every name inside it, and this walk had no entry for the
    // kind — so a function one nesting level down was resolved and then never
    // type-checked. `pass "not an int32";` from an `int32` function was reported
    // at the top level and accepted, silently, inside a `mod` block.
    //
    // That is D-085's shape exactly: 0.2 parsed the construct, 0.3 resolved it,
    // and the checker's silence about it was invisible because there was nothing
    // to see. A missing case in a walk reports nothing by construction.
    if (d.kind == DeclKind.DeclModuleDecl) {
        int32:inner = raw nested_module_scope(e.tab, d, scope);
        if (inner == 0i32) {
            // The resolver reports this as an internal defect and refuses the
            // program, so reaching here means it already has. Checking a module's
            // members in the WRONG scope would report a second, misleading thing
            // about a program that is already being refused.
            pass NIL;
        }
        int32:mn2 = raw item_member_count(e.ast, d);
        int32:q = 0i32;
        while (q < mn2) {
            drop check_decl(e, raw item_member(e.ast, d, q), inner);
            q = q + 1i32;
        }
        pass NIL;
    }

    // AN `impl` BLOCK'S MEMBERS ARE WALKED WITH THE BLOCK'S CONTEXT — its generic
    // parameters as the enclosing scope, and its target as `Self`. A blanket
    // impl's methods are written in terms of its parameter and a concrete impl's
    // may be written in terms of `Self`; neither has any other binding to reach.
    if (d.kind == DeclKind.DeclImplDecl) {
        GenericScope:saved_enc = e.enclosing;
        int32:saved_self = e.self_type;

        IdSpan:gw = raw decl_generic_window(e.ast, d);
        GenericScope:g = GenericScope{ params_start: gw.start, params_count: gw.count,
                                       args_start: 0i32, args_count: 0i32 };
        e.enclosing = g;
        e.self_type = relay impl_self_type(e, d, scope);

        int32:mn = relay impl_member_count(e.ast, d);
        int32:j = 0i32;
        while (j < mn) {
            DeclId:mid = relay impl_member(e.ast, d, j);
            DeclNode:mm = relay ast_decl(e.ast, mid);
            if (mm.kind == DeclKind.DeclFunctionDecl) {
                drop check_function(e, mid, scope);
            }
            j = j + 1i32;
        }

        e.enclosing = saved_enc;
        e.self_type = saved_self;
        pass NIL;
    }

    // A TRAIT'S DEFAULT METHOD BODY (2.1). `Self` there is the PLACEHOLDER, not a
    // concrete type — the implementing type does not exist until an impl names
    // one — which is exactly what `TY_SELF` is for (D-103).
    if (d.kind == DeclKind.DeclTraitDecl) {
        GenericScope:saved_enc = e.enclosing;
        int32:saved_self = e.self_type;

        IdSpan:gw = raw decl_generic_window(e.ast, d);
        GenericScope:g = GenericScope{ params_start: gw.start, params_count: gw.count,
                                       args_start: 0i32, args_count: 0i32 };
        e.enclosing = g;
        e.self_type = raw tt_self(e.types);

        // THE TRAIT WHOSE BODY THIS IS (1.0.4). `Self` stays the anonymous
        // placeholder D-103 designed — the implementing type does not exist yet
        // — but a DEFAULT method calling `self.other()` needs somewhere to look
        // `other` up, and the answer is the guarantee list: what this trait
        // declares. Carried beside `Self` rather than folded into it, so the
        // placeholder keeps meaning exactly what D-103 says it means.
        int32:saved_st = e.self_trait;
        e.self_trait = id.index;

        int32:tn = raw item_member_count(e.ast, d);
        int32:k = 0i32;
        while (k < tn) {
            DeclId:tmid = raw item_member(e.ast, d, k);
            DeclNode:tm = relay ast_decl(e.ast, tmid);
            if (tm.kind == DeclKind.DeclFunctionDecl) {
                drop check_function(e, tmid, scope);
            }
            k = k + 1i32;
        }

        e.enclosing = saved_enc;
        e.self_type = saved_self;
        e.self_trait = saved_st;
        pass NIL;
    }

    // A STRUCT'S FIELD TYPES, resolved so that a field annotation nothing reads is
    // still checked. `struct_layout` does the walk and the binding; asking it for
    // the layout is how the field types get resolved at all.
    if (d.kind == DeclKind.DeclStructDecl) {
        drop resolve_struct_fields(e, id, d, scope);
        pass NIL;
    }

    // A GLOBAL'S ANNOTATION AND ITS INITIALISER. The annotation is a type nothing
    // else resolves; the initialiser is an expression nothing else walks.
    if (d.kind == DeclKind.DeclGlobalDecl) {
        TypeResolver:gr = raw etyper_resolver(e);
        int32:want = relay resolve_type(@gr, raw global_type(d), scope);
        ExprId:init = raw global_init(d);
        if (!(raw expr_is_none(init))) {
            int32:saved = e.expected;
            e.expected = want;
            int32:got = relay type_of_expr(e, init);
            e.expected = saved;
            if (want != 0i32) {
                if (got != 0i32) {
                    if (!(raw type_is_invalid(e.types, got))) {
                        if (!(raw fits(e, want, got))) {
                            drop te_assign_mismatch(e, want, got, d.span);
                        }
                    }
                }
            }
        }
        pass NIL;
    }
    pass NIL;
};

// A STRUCT'S FIELD TYPES. Resolving them IS the layout walk, so asking for the
// layout is how they get resolved — and a field whose annotation is wrong is
// reported whether or not anything ever reads that field.
//
// A GENERIC STRUCT IS RESOLVED WITH ITS PARAMETERS OPAQUE, which is the whole of
// D-064 applied to a declaration: `T:value` is checked once, at the definition,
// against a `T` that satisfies its bounds and nothing else.
func:resolve_struct_fields = NIL(ExprTyper->:e, DeclId:id, DeclNode:d,
                                 int32:scope) {
    TypeResolver:r = raw etyper_resolver(e);
    int32:t = raw tt_struct(e.types, id.index, raw decl_name(d), 0i64, 1i32);
    drop struct_layout(@r, t, scope);
    pass NIL;
};

// ONE FUNCTION, WITH ITS OWN SIGNATURE AND ITS OWN PARAMETERS IN HAND.
//
// `fn_type` rather than `fn_signature`, because the signature alone resolves only
// the RETURN type — and a bad parameter type is a mistake in a declaration
// exactly as much as a bad return is. That asymmetry is what let `..*int64`
// without the brackets sit unreported in an uncalled function.
func:check_function = NIL(ExprTyper->:e, DeclId:fid, int32:scope) {
    DeclNode:d = relay ast_decl(e.ast, fid);
    int32:name = raw decl_name(d);
    TypeResolver:r = raw etyper_resolver(e);
    FnSig:sg = relay fn_signature(@r, fid, name, scope);
    drop fn_type(@r, fid, name, scope);

    GenericScope:saved = e.generics;
    IdSpan:gw = raw decl_generic_window(e.ast, d);
    GenericScope:g = GenericScope{ params_start: gw.start, params_count: gw.count,
                                   args_start: 0i32, args_count: 0i32 };
    e.generics = g;
    e.fn_success = sg.success;
    e.fn_terminal = sg.terminal;

    // A TRAIT METHOD WITH NO BODY IS A DECLARATION, not an empty function. The
    // absence is real (`parse_decls.npk` says so), so there is nothing to walk —
    // and walking the NONE statement would report every required trait method as
    // failing to return a value.
    StmtId:body = raw fn_body(e.ast, d);
    if (!(raw stmt_is_none(body))) {
        drop check_stmt(e, body);
    }
    e.generics = saved;
    pass NIL;
};

// `Self` INSIDE AN `impl` BLOCK IS THE TARGET, and for a blanket impl it is the
// parameter (D-111) — which `impl_target` cannot give, because a blanket impl
// writes no type in that position at all.
func:impl_self_type = int32(ExprTyper->:e, DeclNode:d, int32:scope) {
    if (relay impl_is_blanket(e.ast, d)) {
        if ((relay impl_generic_count(e.ast, d)) == 0i32) { pass 0i32; }
        DeclId:gp = relay impl_generic(e.ast, d, 0i32);
        DeclNode:gpn = relay ast_decl(e.ast, gp);
        pass (raw tt_param(e.types, gp.index, raw decl_name(gpn)));
    }
    TypeResolver:r = raw etyper_resolver(e);
    pass (relay resolve_type(@r, relay impl_target(e.ast, d), scope));
};

