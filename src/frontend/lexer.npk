// The lexer.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.1.2 covers trivia, identifiers and
// keywords; literals are 0.1.3 and 0.1.4, operators 0.1.5.
//
// The lexer works in BYTES. Nitpick source is UTF-8 (LEXICAL_REFERENCE.md §1)
// and a character count would be a second, differently-wrong number to keep in
// step with the byte offsets every Span carries.

use "./source_location.npk".*;
use "./token_kind.npk".*;
use "./token.npk".*;
use "./intern.npk".*;
use "./keywords.npk".*;
use "./num_width.npk".*;
use "./numeric.npk".*;
use "./escapes.npk".*;
use "./operators.npk".*;
use "./diag_codes.npk".*;
use "./diagnostics.npk".*;

pub struct:Lexer = {
    string:text;
    int32:file;
    int64:pos;       // byte offset of the next unread byte
    int32:line;      // 1-based
    int32:col;       // 1-based, in bytes

    // Template state. `&{ ... }` interpolation means the lexer must know
    // whether a `}` closes an interpolation or a block -- after the former it
    // resumes TEMPLATE scanning, after the latter it does not
    // (LEXICAL_REFERENCE 6.4). Bounded at 8: templates nested deeper than that
    // are pathological, and a fixed bound keeps the memory deterministic.
    bool:in_template;
    int32:interp_depth;
    int32:brace_depth;
    int32[8]:interp_brace;   // brace depth at each open interpolation
};

pub func:lexer_init = Lexer(int32:file, string:text) {
    Lexer:lx = Lexer{ text: text, file: file, pos: 0i64, line: 1i32, col: 1i32,
                      in_template: false, interp_depth: 0i32, brace_depth: 0i32,
                      interp_brace: [] };
    pass lx;
};

pub func:lexer_at_end = bool(Lexer->:lx) {
    pass (lx.pos >= lx.text.len);
};

// Reading past the end yields 0, which is not a legal source byte, so callers
// need no separate bounds test before every peek.
func:lexer_peek = uint8(Lexer->:lx) {
    if (lx.pos >= lx.text.len) {
        pass 0u8;
    }
    pass lx.text.ptr[lx.pos] => uint8;
};

func:lexer_peek2 = uint8(Lexer->:lx) {
    if ((lx.pos + 1i64) >= lx.text.len) {
        pass 0u8;
    }
    pass lx.text.ptr[lx.pos + 1i64] => uint8;
};

func:lexer_advance = uint8(Lexer->:lx) {
    uint8:c = raw lexer_peek(lx);
    lx.pos = lx.pos + 1i64;
    if (c == 10u8) {
        lx.line = lx.line + 1i32;
        lx.col = 1i32;
    } else {
        lx.col = lx.col + 1i32;
    }
    pass c;
};

// --- classification ---------------------------------------------------------
//
// On uint8 rather than char8: these are raw source bytes, and `char8` is a
// semantic type that permits no arithmetic. The distinction is the point --
// a byte in a buffer is not a character.

pub func:is_space = bool(uint8:c) {
    if (c == 32u8) { pass true; }      // space
    if (c == 9u8)  { pass true; }      // tab
    if (c == 13u8) { pass true; }      // carriage return
    if (c == 10u8) { pass true; }      // newline
    pass false;
};

pub func:is_digit = bool(uint8:c) {
    pass ((c >= 48u8) && (c <= 57u8));
};

pub func:is_alpha = bool(uint8:c) {
    if ((c >= 97u8) && (c <= 122u8)) { pass true; }   // a-z
    if ((c >= 65u8) && (c <= 90u8))  { pass true; }   // A-Z
    pass false;
};

pub func:is_ident_start = bool(uint8:c) {
    if (raw is_alpha(c)) { pass true; }
    pass (c == 95u8);                                  // _
};

pub func:is_ident_part = bool(uint8:c) {
    if (raw is_alpha(c))  { pass true; }
    if (raw is_digit(c))  { pass true; }
    pass (c == 95u8);
};

// --- trivia -----------------------------------------------------------------

func:lexer_span_from = Span(Lexer->:lx, int64:start, int32:line, int32:col) {
    pass (raw span_make(lx.file, start => int32, line, col,
                        (lx.pos - start) => int32));
};

// Whitespace and both comment forms. Returns NIL; trivia produces no tokens.
func:lexer_skip_trivia = NIL(Lexer->:lx, DiagList->:diags) {
    while (true) {
        uint8:c = raw lexer_peek(lx);

        if (raw is_space(c)) {
            drop lexer_advance(lx);
        } else {
            if (c == 47u8) {                            // '/'
                uint8:d = raw lexer_peek2(lx);

                if (d == 47u8) {                        // line comment
                    while (true) {
                        uint8:e = raw lexer_peek(lx);
                        if (e == 0u8)  { pass NIL; }
                        if (e == 10u8) { break; }
                        drop lexer_advance(lx);
                    }
                } else {
                    if (d == 42u8) {                    // block comment
                        int64:start = lx.pos;
                        int32:sl = lx.line;
                        int32:sc = lx.col;
                        drop lexer_advance(lx);
                        drop lexer_advance(lx);
                        // Block comments do NOT nest (LEXICAL_REFERENCE §2).
                        // That is a decision to preserve, not a limitation to
                        // fix: nesting makes an unterminated comment swallow
                        // the rest of the file silently.
                        while (true) {
                            uint8:e = raw lexer_peek(lx);
                            if (e == 0u8) {
                                Span:sp = raw lexer_span_from(lx, start, sl, sc);
                                drop diaglist_push(diags,
                                    raw diag_error(raw LEX_UNTERMINATED_COMMENT(),
                                        "unterminated block comment", sp));
                                pass NIL;
                            }
                            if (e == 42u8) {
                                if ((raw lexer_peek2(lx)) == 47u8) {
                                    drop lexer_advance(lx);
                                    drop lexer_advance(lx);
                                    break;
                                }
                            }
                            drop lexer_advance(lx);
                        }
                    } else {
                        pass NIL;                       // a real '/' operator
                    }
                }
            } else {
                pass NIL;
            }
        }
    }
    pass NIL;
};

// --- tokens -----------------------------------------------------------------

pub func:lexer_next = Token(Lexer->:lx, InternTable->:interns,
                            DiagList->:diags) {
    drop lexer_skip_trivia(lx, diags);

    int64:start = lx.pos;
    int32:line = lx.line;
    int32:col = lx.col;
    uint8:c = raw lexer_peek(lx);

    if (raw lexer_at_end(lx)) {
        pass (raw token_make(TokenKind.Eof,
                             raw lexer_span_from(lx, start, line, col), 0i64));
    }

    // `_?`, `_!`, `_~` and `_^` are OPERATORS, and they are resolved BEFORE
    // identifiers that begin with an underscore (LEXICAL_REFERENCE §3). An
    // identifier scanner that ran first would eat the `_` and strand the `^`.
    if (c == 95u8) {
        uint8:d = raw lexer_peek2(lx);
        TokenKind:op = TokenKind.Error;
        bool:matched = false;
        if (d == 63u8) { op = TokenKind.OpUnderQuestion; matched = true; }  // _?
        if (d == 33u8) { op = TokenKind.OpUnderBang;     matched = true; }  // _!
        if (d == 126u8) { op = TokenKind.OpUnderTilde;   matched = true; }  // _~
        if (d == 94u8) { op = TokenKind.OpUnderCaret;    matched = true; }  // _^
        if (matched) {
            drop lexer_advance(lx);
            drop lexer_advance(lx);
            pass (raw token_make(op,
                                 raw lexer_span_from(lx, start, line, col), 0i64));
        }
    }

    // --- template content ---------------------------------------------------
    if (lx.in_template) {
        // Accumulate until ` or &{ . A part is emitted even when empty only if
        // nothing else follows, so `&{x}` produces no spurious empty part.
        int64:tstart = lx.pos;
        while (true) {
            uint8:t = raw lexer_peek(lx);
            if (t == 0u8) {
                Span:sp = raw lexer_span_from(lx, start, line, col);
                drop diaglist_push(diags,
                    raw diag_error(raw LEX_UNTERMINATED_TEMPLATE(),
                        "unterminated template literal", sp));
                lx.in_template = false;
                pass (raw token_make(TokenKind.Error, sp, 0i64));
            }
            if (t == 96u8) { break; }                       // `
            if (t == 38u8) {                                // &
                if ((raw lexer_peek2(lx)) == 123u8) { break; }   // &{
            }
            drop lexer_advance(lx);
        }

        if (lx.pos > tstart) {
            string:part = raw string_slice(lx.text, tstart, lx.pos);
            pass (raw token_make(TokenKind.TemplatePart,
                      raw lexer_span_from(lx, tstart, line, col),
                      (raw intern_add(interns, part)) => int64));
        }

        uint8:t2 = raw lexer_peek(lx);
        if (t2 == 96u8) {
            drop lexer_advance(lx);
            lx.in_template = false;
            pass (raw token_make(TokenKind.TemplateEnd,
                                 raw lexer_span_from(lx, start, line, col), 0i64));
        }
        // &{ -- leave template mode; the expression is lexed normally.
        drop lexer_advance(lx);
        drop lexer_advance(lx);
        lx.in_template = false;
        if (lx.interp_depth < 8i32) {
            lx.interp_brace[lx.interp_depth => int64] = lx.brace_depth;
            lx.interp_depth = lx.interp_depth + 1i32;
        }
        pass (raw token_make(TokenKind.InterpStart,
                             raw lexer_span_from(lx, start, line, col), 0i64));
    }

    // --- a `}` that closes an interpolation ---------------------------------
    if (c == 125u8) {
        if (lx.interp_depth > 0i32) {
            if (lx.brace_depth == lx.interp_brace[(lx.interp_depth - 1i32) => int64]) {
                drop lexer_advance(lx);
                lx.interp_depth = lx.interp_depth - 1i32;
                lx.in_template = true;
                pass (raw token_make(TokenKind.InterpEnd,
                                     raw lexer_span_from(lx, start, line, col), 0i64));
            }
        }
        drop lexer_advance(lx);
        lx.brace_depth = lx.brace_depth - 1i32;
        pass (raw token_make(TokenKind.PRBrace,
                             raw lexer_span_from(lx, start, line, col), 0i64));
    }
    if (c == 123u8) {
        drop lexer_advance(lx);
        lx.brace_depth = lx.brace_depth + 1i32;
        pass (raw token_make(TokenKind.PLBrace,
                             raw lexer_span_from(lx, start, line, col), 0i64));
    }
    if (c == 96u8) {
        drop lexer_advance(lx);
        lx.in_template = true;
        pass (raw token_make(TokenKind.TemplateStart,
                             raw lexer_span_from(lx, start, line, col), 0i64));
    }

    // --- strings ------------------------------------------------------------
    // Raw strings first: `r"..."` must not be read as the identifier `r`
    // followed by a string (D-024).
    if (c == 114u8) {
        if ((raw lexer_peek2(lx)) == 34u8) {
            drop lexer_advance(lx);
            drop lexer_advance(lx);
            int64:rstart = lx.pos;
            while (true) {
                uint8:q = raw lexer_peek(lx);
                if (q == 0u8) {
                    Span:sp = raw lexer_span_from(lx, start, line, col);
                    drop diaglist_push(diags,
                        raw diag_error(raw LEX_UNTERMINATED_STRING(),
                            "unterminated raw string literal", sp));
                    pass (raw token_make(TokenKind.Error, sp, 0i64));
                }
                if (q == 34u8) { break; }
                drop lexer_advance(lx);
            }
            string:body = raw string_slice(lx.text, rstart, lx.pos);
            drop lexer_advance(lx);
            // No escape processing at all -- that is what "raw" means.
            pass (raw token_make(TokenKind.RawStringLit,
                      raw lexer_span_from(lx, start, line, col),
                      (raw intern_add(interns, body)) => int64));
        }
    }

    if (c == 34u8) {
        bool:block = false;
        if ((raw lexer_peek2(lx)) == 34u8) {
            drop lexer_advance(lx);
            drop lexer_advance(lx);
            if ((raw lexer_peek(lx)) == 34u8) {
                drop lexer_advance(lx);
                block = true;
            } else {
                // An empty plain string: the two quotes were the whole literal.
                pass (raw token_make(TokenKind.StringLit,
                          raw lexer_span_from(lx, start, line, col),
                          (raw intern_add(interns, "")) => int64));
            }
        } else {
            drop lexer_advance(lx);
        }

        int64:sstart = lx.pos;
        while (true) {
            uint8:q = raw lexer_peek(lx);
            if (q == 0u8) {
                Span:sp = raw lexer_span_from(lx, start, line, col);
                drop diaglist_push(diags,
                    raw diag_error(raw LEX_UNTERMINATED_STRING(),
                        "unterminated string literal", sp));
                pass (raw token_make(TokenKind.Error, sp, 0i64));
            }
            if (block) {
                if (q == 34u8) {
                    if ((raw lexer_peek2(lx)) == 34u8) { break; }
                }
            } else {
                // A newline inside a plain string is an error: the closing quote
                // is almost certainly missing, and running on would swallow the
                // rest of the file into one literal.
                if (q == 10u8) {
                    Span:sp = raw lexer_span_from(lx, start, line, col);
                    drop diaglist_push(diags,
                        raw diag_error(raw LEX_UNTERMINATED_STRING(),
                            "newline in a string literal", sp));
                    pass (raw token_make(TokenKind.Error, sp, 0i64));
                }
                if (q == 34u8) { break; }
            }
            if (q == 92u8) {
                drop lexer_advance(lx);
            }
            drop lexer_advance(lx);
        }

        string:content = raw string_slice(lx.text, sstart, lx.pos);
        drop lexer_advance(lx);
        if (block) {
            drop lexer_advance(lx);
            drop lexer_advance(lx);
        }
        Span:ssp = raw lexer_span_from(lx, start, line, col);
        DecodedString:dec = raw decode_string(content);
        if (!(dec.valid)) {
            drop diaglist_push(diags,
                raw diag_error(raw LEX_BAD_ESCAPE(), "invalid escape sequence", ssp));
        }
        TokenKind:sk = TokenKind.StringLit;
        if (block) { sk = TokenKind.MultiStringLit; }
        pass (raw token_make(sk, ssp,
                  (raw intern_add(interns, dec.value)) => int64));
    }

    // --- characters ----------------------------------------------------------
    if (c == 39u8) {
        drop lexer_advance(lx);
        int64:cp = 0i64;
        uint8:q = raw lexer_peek(lx);
        if (q == 92u8) {
            EscapeResult:e = raw escape_decode(lx.text, lx.pos);
            if (!(e.valid)) {
                Span:sp = raw lexer_span_from(lx, start, line, col);
                drop diaglist_push(diags,
                    raw diag_error(raw LEX_BAD_ESCAPE(),
                        "invalid escape sequence", sp));
                pass (raw token_make(TokenKind.Error, sp, 0i64));
            }
            cp = e.codepoint;
            int64:k = 0i64;
            while (k < e.consumed) {
                drop lexer_advance(lx);
                k = k + 1i64;
            }
        } else {
            cp = q => int64;
            drop lexer_advance(lx);
        }
        if ((raw lexer_peek(lx)) != 39u8) {
            Span:sp = raw lexer_span_from(lx, start, line, col);
            drop diaglist_push(diags,
                raw diag_error(raw LEX_UNTERMINATED_CHAR(),
                    "unterminated character literal", sp));
            pass (raw token_make(TokenKind.Error, sp, 0i64));
        }
        drop lexer_advance(lx);
        pass (raw token_numeric(TokenKind.CharLit,
                  raw lexer_span_from(lx, start, line, col), cp,
                  NumWidth.WNone));
    }

    if ((raw is_ident_start(c)) || (raw is_digit(c))) {
        // One maximal [0-9a-zA-Z_] run. A hex literal can begin with a letter
        // (`FFhex`), so a numeric literal and an identifier are the same
        // characters until the end -- only reading the run from the RIGHT tells
        // them apart (numeric.npk).
        while (raw is_ident_part(raw lexer_peek(lx))) {
            drop lexer_advance(lx);
        }

        // A float needs a DIGIT after the dot. `0...4` is a range, not a
        // malformed float, and this is the check that keeps it one.
        if (raw is_digit(c)) {
            if ((raw lexer_peek(lx)) == 46u8) {
                if (raw is_digit(raw lexer_peek2(lx))) {
                    drop lexer_advance(lx);                    // the dot
                    while (raw is_ident_part(raw lexer_peek(lx))) {
                        drop lexer_advance(lx);
                    }
                    // An exponent may carry a sign, which is not an ident part.
                    uint8:e = raw lexer_peek(lx);
                    if ((e == 43u8) || (e == 45u8)) {
                        drop lexer_advance(lx);
                        while (raw is_ident_part(raw lexer_peek(lx))) {
                            drop lexer_advance(lx);
                        }
                    }
                    string:ftext = raw string_slice(lx.text, start, lx.pos);
                    Span:fsp = raw lexer_span_from(lx, start, line, col);
                    // A float keeps its TEXT, interned, rather than a converted
                    // value: converting at scan time would round once here and
                    // again later, and the source form is what the const
                    // evaluator needs to get it right the first time.
                    pass (raw token_numeric(TokenKind.FloatLit, fsp,
                              (raw intern_add(interns, ftext)) => int64,
                              raw num_float_width(ftext)));
                }
            }
        }

        string:text = raw string_slice(lx.text, start, lx.pos);

        NumScan:ns = raw num_scan(text);
        if (ns.is_numeric) {
            Span:nsp = raw lexer_span_from(lx, start, line, col);
            if (ns.bad_digit) {
                drop diaglist_push(diags,
                    raw diag_error(raw LEX_BAD_DIGIT(),
                        "digit is not valid for this base", nsp));
                pass (raw token_make(TokenKind.Error, nsp, 0i64));
            }
            if (ns.overflow) {
                // Detected, never wrapped. Wrapping here would put a different
                // number in the program than the one written.
                drop diaglist_push(diags,
                    raw diag_error(raw LEX_INT_TOO_LARGE(),
                        "integer literal does not fit in 64 bits", nsp));
                pass (raw token_make(TokenKind.Error, nsp, 0i64));
            }
            pass (raw token_numeric(TokenKind.IntLit, nsp, ns.value, ns.width));
        }
        // Keywords are recognised from the WHOLE identifier, never by prefix,
        // so `iffy` is an identifier rather than `if` followed by `fy`.
        TokenKind:kind = raw keyword_kind_of(text);
        int64:payload = 0i64;
        if (kind == TokenKind.Ident) {
            payload = (raw intern_add(interns, text)) => int64;
        }
        pass (raw token_make(kind,
                             raw lexer_span_from(lx, start, line, col), payload));
    }

    // --- operators and punctuation -------------------------------------------
    // Longest match first, from the generated table: `<=>` beats `<=`, `..*`
    // beats `..`, `=>!` beats `=>`, `!!!` beats `!`.
    //
    // `>>` is emitted as ONE token here. Splitting it into two `>` belongs to
    // the parser, which is the only thing that knows whether it is inside a
    // type-argument list -- see tokenlist_split_shr in token.npk.
    OpMatch:om = raw op_match(lx.text, lx.pos);
    if (om.found) {
        int64:k = 0i64;
        while (k < om.length) {
            drop lexer_advance(lx);
            k = k + 1i64;
        }
        pass (raw token_make(om.kind,
                             raw lexer_span_from(lx, start, line, col), 0i64));
    }

    // An unhandled byte is an Error token WITH a diagnostic -- never silently
    // skipped, which would make a lexer bug look like a parser bug.
    //
    // Recovery consumes the whole run of unrecognised bytes rather than one at a
    // time. A multi-byte UTF-8 character outside a literal is a single mistake
    // and should read as one, not as three; and a lexer that reports per byte
    // buries the real first error under its own noise.
    drop lexer_advance(lx);
    while (true) {
        uint8:r = raw lexer_peek(lx);
        if (r == 0u8) { break; }
        if (raw is_space(r)) { break; }
        if (raw is_ident_start(r)) { break; }
        if (raw is_digit(r)) { break; }
        OpMatch:rec = raw op_match(lx.text, lx.pos);
        if (rec.found) { break; }
        if (r == 34u8) { break; }
        if (r == 39u8) { break; }
        drop lexer_advance(lx);
    }
    Span:sp = raw lexer_span_from(lx, start, line, col);
    drop diaglist_push(diags,
        raw diag_error(raw LEX_UNEXPECTED_CHAR(), "unexpected character", sp));
    pass (raw token_make(TokenKind.Error, sp, 0i64));
};

// Lex a whole file. Always ends with exactly one Eof token, so consumers need
// no separate end test.
pub func:lex_all = TokenList(int32:file, string:text, InternTable->:interns,
                             DiagList->:diags) {
    Lexer:lx = raw lexer_init(file, text);
    TokenList:out = raw tokenlist_init();
    while (true) {
        Token:t = raw lexer_next(@lx, interns, diags);
        drop tokenlist_push(@out, t);
        if (raw token_is_eof(t)) {
            break;
        }
    }
    pass out;
};
