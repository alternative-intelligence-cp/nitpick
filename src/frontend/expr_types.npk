// What type the checker gave each expression.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.5.0.
//
// RECORDED ONCE, READ MANY TIMES. Cycle 0.4 computes an expression's type and
// keeps nothing: `type_of_expr` returns it and the caller uses it and it is gone.
// That was right while typing was the only consumer. It stops being right the
// moment a second pass needs the same fact — exhaustiveness needs a `pick`
// selector's type, taint needs to know a `Result`, lock levels need
// `Mutex<T, LEVEL>`'s argument — because the alternative is each analysis
// recomputing it.
//
// TWO COMPUTATIONS OF ONE FACT IS THE SHAPE THAT HAS COST THIS COMPILER DEFECTS
// REPEATEDLY. `is_error` stored beside `error`, where both `{error: 0,
// is_error: true}` and `{error: 5, is_error: false}` were constructible (D-069).
// `expr_shape` read two ways. A type name read as a token kind (D-104). Each was
// one fact with two representations that could disagree, and each disagreed.
//
// An analysis that recomputes a type agrees with the checker only for as long as
// both are maintained together. One that reads what the checker recorded agrees
// with it BY CONSTRUCTION, and the difference is not stylistic: an analysis whose
// idea of a type has drifted from the checker's rejects programs the checker
// accepted, or worse, accepts what it should not.
//
// THE TABLE IS INDEXED BY `ExprId`, dense, and covers the whole AST rather than
// one function. Expressions are already indices into one flat array (0.2.0), so
// the table is the same shape as the thing it annotates and needs no lookup.

use "source_location.npk".*;
use "ast_kind.npk".*;
use "ast.npk".*;
use "parse_expr.npk".*;
use "types.npk".*;

// A TYPE PER EXPRESSION, plus whether one was ever recorded.
//
// THOSE ARE TWO DIFFERENT QUESTIONS AND THEY GET TWO FIELDS. Type id 0 is the
// INVALID type — a real entry, deliberately, so one bad annotation produces one
// diagnostic rather than a cascade (0.4.0) — so "the checker typed this and it
// was invalid" and "nothing has typed this" are both 0 in a single-field
// encoding. An analysis cannot tell those apart, and they call for opposite
// behaviour: the first is already reported and should be passed over quietly, the
// second means the analysis is walking something the checker never reached, which
// is a hole in one of the two walks.
//
// This is the same `whether` versus `which` split `FieldInfo`, `MethodFind`,
// `NsAccess` and `ParamBind` are each built around, and it is here for the fourth
// time because the encoding that merges them has been wrong every previous time.
pub struct:ExprTypes = {
    wild int32->:items;      // the type id
    wild bool->:known;       // was anything recorded at all
    int32:count;
};

pub func:exprtypes_init = ExprTypes(int32:n) {
    int64:size = n => int64;
    if (size < 1i64) { size = 1i64; }
    wild int8->:mem = alloc(size * #size_of<int32>());
    wild int8->:flags = alloc(size * #size_of<bool>());

    ExprTypes:t = ExprTypes{ items: mem => wild int32->,
                             known: flags => wild bool->,
                             count: size => int32 };
    int64:i = 0i64;
    while (i < size) {
        t.items[i] = 0i32;
        t.known[i] = false;
        i = i + 1i64;
    }
    pass t;
};

// SIZED FROM THE AST, so the table cannot be short. An expression index past the
// end would otherwise read whatever followed the allocation, which is the failure
// mode a bounds check turns into a diagnostic.
pub func:exprtypes_for = ExprTypes(Ast->:ast) {
    pass (raw exprtypes_init(raw ast_expr_count(ast)));
};

// RECORDING IS UNCONDITIONAL, including on the paths that report an error and
// return the invalid type. An expression the checker reached and refused is a
// different thing from one it never reached, and only recording the successes
// would collapse them.
pub func:exprtypes_set = NIL(ExprTypes->:t, ExprId:id, int32:type_id) {
    if (id.index < 0i32) { fail 24i32; }
    if (id.index >= t.count) { fail 24i32; }
    t.items[id.index => int64] = type_id;
    t.known[id.index => int64] = true;
    pass NIL;
};

pub func:exprtypes_known = bool(ExprTypes->:t, ExprId:id) {
    if (id.index < 0i32) { pass false; }
    if (id.index >= t.count) { pass false; }
    pass (t.known[id.index => int64]);
};

// THE TYPE, OR THE INVALID TYPE WHEN NOTHING WAS RECORDED. A caller that wants to
// tell those apart asks `exprtypes_known` first; one that does not gets the
// answer that makes it stop, which is what index 0 is for.
pub func:exprtypes_get = int32(ExprTypes->:t, ExprId:id) {
    if (id.index < 0i32) { pass 0i32; }
    if (id.index >= t.count) { pass 0i32; }
    pass (t.items[id.index => int64]);
};

pub func:exprtypes_count = int32(ExprTypes->:t) { pass t.count; };

// --- is this expression a borrow? -----------------------------------------------------------
//
// A BORROW IS A PROPERTY OF AN EXPRESSION, NOT A TYPE (D-004).
//
// `$$i x` and `@x` are POINTERS at the type level, and the borrow checker is what
// makes them second-class. Making borrow-ness a distinct type kind would force
// every pointer operation to accept two kinds of pointer and decide which rules
// apply — which is the context-dependence the blueprint philosophy forbids, and
// the opposite of D-004's argument that validity is bounded by the callee frame
// STRUCTURALLY, with no lifetime variables at all.
//
// So the question is answered from the expression's shape, and the type system is
// left alone.
//
// A BORROW DERIVED FROM A BORROW IS STILL A BORROW. `$$m rec.field` and
// `$$m arr[i]` borrow the same frame as `$$m rec` does, and a classifier that
// recognised only the operator itself would let one field access launder
// second-class into first-class — which is exactly the escape D-004 exists to
// prevent, reached by writing a `.` .
//
// FUEL, because the derivation chain is written by a program: `@a.b.c[i].d` is a
// walk down an expression tree, and every walk in this compiler that follows
// program structure is bounded.
//
// WHAT THIS ANSWERS IS SYNTACTIC DERIVATION, AND THAT IS HALF THE QUESTION.
//
// `Point->:p = $$i q; … p.x` holds a borrow in a BINDING, and reaching into `p`
// reaches the same frame — but nothing in the expression `p.x` says so. Deciding
// that needs the binding's state along the path, which is dataflow rather than
// shape, and it belongs to the escape analysis in 0.5.1 with the rest of the
// per-binding state.
//
// The split is deliberate and is not a hole: this function is total on what it
// claims to answer, and 0.5.1 composes with it rather than replacing it. Saying
// which half is which is the point — a classifier that quietly answered `false`
// for a borrow held in a binding would be a checker that lets one assignment
// launder second-class into first-class.
//
// `borrow_imm` / `borrow_mut` DO NOT EXIST AS SPELLINGS. `AST_REFERENCE.md` lists
// both as `VarDeclStmt` qualifiers and neither is a keyword — the operators are
// the only way to write a borrow today. That is a spec-versus-parser gap of the
// kind cycle 0.4 kept finding, recorded in 0.5.1's plan rather than worked around
// here.
pub func:BORROW_FUEL = int32() { pass 64i32; };

// WHERE A PLACE EXPRESSION COMES FROM, and whether the walk got there.
//
// ONE WALK, TWO QUESTIONS ASKED OF ITS ANSWER. `@a.b[i].c` is a borrow because
// its root is `@a`; `p.x` is a borrow when the binding `p` holds one. Those are
// the syntactic and the dataflow halves of D-004, and they differ only in what
// they ask about the ROOT — the walk down to it is the same walk.
//
// Written as two recursions it would be two walks, and the shape rules would live
// in two places that have to agree about which forms preserve a borrow. That is
// the "two computations of one fact" shape this file's header is about, so the
// walk is factored out and the questions are asked separately.
pub struct:PlaceRoot = {
    ExprId:id;
    bool:exhausted;
};

pub func:place_root = PlaceRoot(Ast->:ast, ExprId:id, int32:fuel) {
    ExprId:cur = id;
    int32:left = fuel;
    while (left > 0i32) {
        if (raw expr_is_none(cur)) { pass PlaceRoot{ id: cur, exhausted: false }; }
        ExprNode:n = relay ast_expr(ast, cur);

        // The two forms that PRESERVE a borrow. Reaching into one yields a place
        // in the same frame; the indirection did not make it live longer.
        if (n.kind == ExprKind.ExprMemberAccessExpr) {
            cur = raw expr_operand(n);
        } else {
        if (n.kind == ExprKind.ExprIndexExpr) {
            cur = raw expr_lhs(n);
        } else {
            // Everything else IS the root — including `<-`, which is worth saying
            // out loud rather than reaching by falling off the end. Dereferencing
            // a borrow yields the VALUE, copied or moved like any other; it is the
            // pointer that was second-class, not what it pointed at.
            pass PlaceRoot{ id: cur, exhausted: false };
        }}
        left = left - 1i32;
    }
    pass PlaceRoot{ id: cur, exhausted: true };
};

// Does this expression EVALUATE TO a borrow, from its shape alone?
//
// EXHAUSTION ANSWERS `true`, WHICH IS THE SAFE DIRECTION AND IS NOT WHAT THIS USED
// TO DO. A classifier that answers "not a borrow" when it has run out of fuel lets
// an escape through, and a borrow checker that fails OPEN is worse than no borrow
// checker, because the property was claimed. The escape pass reports exhaustion as
// its own diagnostic rather than as a borrow error, so a reader is told what
// actually happened; any other caller gets the conservative answer.
pub func:expr_is_borrow = bool(Ast->:ast, ExprId:id, int32:fuel) {
    PlaceRoot:r = relay place_root(ast, id, fuel);
    if (r.exhausted) { pass true; }
    if (raw expr_is_none(r.id)) { pass false; }
    ExprNode:n = relay ast_expr(ast, r.id);

    // The two that PRODUCE a borrow. `@` yields one (D-004 rule 1), and `$$i` /
    // `$$m` are the declaration-site spellings of the same thing — immutable
    // (many) and mutable (exclusive).
    if (n.kind == ExprKind.ExprAddressOfExpr) { pass true; }
    pass (n.kind == ExprKind.ExprBorrowExpr);
};

// --- is this expression a PLACE? ---------------------------------------------------------
//
// A place is something with an address: a name, a field or element of one, or what
// a pointer points at. `@place`, `$$i place`, `$$m place` and `move(place)` all
// require one, and the language has no way to spell the address of a temporary.
//
// NOTHING IN THE REAL FRONTEND ASKED THIS UNTIL NOW. The SEED refuses `@(raw f())`
// — "not a place expression" comes out of `bootstrap/generator/emit.py`, which
// needs an address to emit and has nowhere to get one — and the real frontend
// accepted it, so the two disagreed about a program's validity. That is the seed
// enforcing a rule the compiler being built does not have, which is the same
// situation `fixed` was in before 0.5.2.
//
// THE ROOT DECIDES, over the same walk everything else in this file uses. `a.b[i].c`
// is a place because `a` is one; `f().x` is not, because a call's result is a
// value with no home to take the address of.
//
// `<-p` IS A PLACE, and that is the one people get backwards. Dereferencing yields
// what the pointer points at, which is somewhere real — `<-p = 5i32;` writes
// through it and `@(<-p)` is `p` again.
//
// EXHAUSTION ANSWERS `false`, which refuses rather than accepts. That is the safe
// direction here and the opposite of `expr_is_borrow`'s: there, "might be a borrow"
// is the cautious answer, and here it is "might not be addressable".
pub func:expr_is_place = bool(Ast->:ast, ExprId:id, int32:fuel) {
    PlaceRoot:r = relay place_root(ast, id, fuel);
    if (r.exhausted)             { pass false; }
    if (raw expr_is_none(r.id))  { pass false; }
    ExprNode:n = relay ast_expr(ast, r.id);
    if (n.kind == ExprKind.ExprIdentifierExpr) { pass true; }
    pass (n.kind == ExprKind.ExprDerefExpr);
};
