    }
    if (raw string_eq(name, "wildx_alloc")) {
        if (i == 0i32) { pass "int64"; }
    }
    if (raw string_eq(name, "wildx_call")) {
        if (i == 0i32) { pass "wildx any->"; }
        if (i == 1i32) { pass "int64"; }
    }
    if (raw string_eq(name, "wildx_free")) {
        if (i == 0i32) { pass "wildx any->"; }
    }
    if (raw string_eq(name, "wildx_seal")) {
        if (i == 0i32) { pass "wildx any->"; }
    }
    if (raw string_eq(name, "write")) {
        if (i == 0i32) { pass "fd"; }
        if (i == 1i32) { pass "wild any->"; }
        if (i == 2i32) { pass "int64"; }
    }
    if (raw string_eq(name, "write_file")) {
        if (i == 0i32) { pass "cstring"; }
        if (i == 1i32) { pass "string"; }
    }
    pass "";
};

// Which parameters CONSUME (D-183). `release_fd` is the whole list: it
// takes the owner apart, so the caller may not still hold it.
pub func:builtin_sig_param_move = bool(string:name, int32:i) never fails {
    if (raw string_eq(name, "release_fd")) {
        if (i == 0i32) { pass true; }
    }
    pass false;
};

// The SUCCESS type's text. A may-fail builtin's call types as
// `Result<this>`; a never-fails one's as this, bare (D-201 §4).
pub func:builtin_sig_ret = string(string:name) never fails {
    if (raw string_eq(name, "aalloc")) { pass "wild int8->"; }
    if (raw string_eq(name, "alloc")) { pass "wild int8->"; }
    if (raw string_eq(name, "buffer_new")) { pass "buffer"; }
    if (raw string_eq(name, "calloc")) { pass "wild int8->"; }
    if (raw string_eq(name, "chain_depth")) { pass "int32"; }
    if (raw string_eq(name, "chain_site")) { pass "int32"; }
    if (raw string_eq(name, "clone_exec")) { pass "int64"; }
    if (raw string_eq(name, "close")) { pass "NIL"; }
    if (raw string_eq(name, "dalloc")) { pass "NIL"; }
    if (raw string_eq(name, "driver_retire")) { pass "NIL"; }
    if (raw string_eq(name, "environ")) { pass "cstring[]"; }
    if (raw string_eq(name, "int_to_string")) { pass "string"; }
    if (raw string_eq(name, "io_unwatch")) { pass "NIL"; }
    if (raw string_eq(name, "io_watch")) { pass "NIL"; }
    if (raw string_eq(name, "mcpy")) { pass "wild int8->"; }
    if (raw string_eq(name, "memset")) { pass "wild int8->"; }
    if (raw string_eq(name, "mmov")) { pass "wild int8->"; }
    if (raw string_eq(name, "mono_now")) { pass "int64"; }
    if (raw string_eq(name, "open")) { pass "fd"; }
    if (raw string_eq(name, "own_fd")) { pass "OwnedFd"; }
    if (raw string_eq(name, "path_exists")) { pass "bool"; }
    if (raw string_eq(name, "ralloc")) { pass "wild int8->"; }
    if (raw string_eq(name, "read")) { pass "int64"; }
    if (raw string_eq(name, "read_file")) { pass "string"; }
    if (raw string_eq(name, "read_stdin")) { pass "string"; }
    if (raw string_eq(name, "release_fd")) { pass "fd"; }
    if (raw string_eq(name, "site_line")) { pass "int32"; }
    if (raw string_eq(name, "site_path")) { pass "string"; }
    if (raw string_eq(name, "string_byte_length")) { pass "int64"; }
    if (raw string_eq(name, "string_bytes")) { pass "uint8[]"; }
    if (raw string_eq(name, "string_concat")) { pass "string"; }
    if (raw string_eq(name, "string_equals")) { pass "bool"; }
    if (raw string_eq(name, "string_from_bytes")) { pass "string"; }
    if (raw string_eq(name, "string_is_empty")) { pass "bool"; }
    if (raw string_eq(name, "string_slice")) { pass "string"; }
    if (raw string_eq(name, "suspend_io")) { pass "NIL"; }
    if (raw string_eq(name, "suspend_until")) { pass "NIL"; }
    if (raw string_eq(name, "to_cstring")) { pass "cstring"; }
    if (raw string_eq(name, "wild_live_count")) { pass "int64"; }
    if (raw string_eq(name, "wild_release_all")) { pass "NIL"; }
    if (raw string_eq(name, "wildx_alloc")) { pass "wildx int8->"; }
    if (raw string_eq(name, "wildx_call")) { pass "int64"; }
    if (raw string_eq(name, "wildx_free")) { pass "NIL"; }
    if (raw string_eq(name, "wildx_seal")) { pass "NIL"; }
    if (raw string_eq(name, "write")) { pass "int64"; }
    if (raw string_eq(name, "write_file")) { pass "NIL"; }
    pass "";
};

// The `#`-sigil builtins -- the OTHER kind, the ones the compiler treats
// specially. `#foo(...)` is also how a macro is invoked (D-046), so this is
// what tells a builtin that survived expansion from a macro that was never
// declared. `caller` is deliberately ABSENT: it is legal only inside a macro
// body, expansion consumes it, and one that reaches here is one written
// somewhere it means nothing.
pub func:is_hash_builtin = bool(string:name) never fails {
    if (raw string_eq(name, "ptr_add")) { pass true; }
    if (raw string_eq(name, "size_of")) { pass true; }
    if (raw string_eq(name, "sqrt")) { pass true; }
    if (raw string_eq(name, "unreachable")) { pass true; }
    if (raw string_eq(name, "wild_ptr")) { pass true; }
    if (raw string_eq(name, "wild_slice")) { pass true; }
    pass false;
};

// Every builtin whose REFERENCE ROW declares a `wild` (or `wildx`) return —
// the whitelist D-223's BORROW-011 consults. Both tables feed it: a bare
// builtin's Signature column and a `#`-sigil one's Return column, because a
// SPECIAL builtin is generic in `T` and has no concrete signature row, and
// the two pointer-returning specials are where wild pointers come FROM.
pub func:builtin_returns_wild = bool(string:name) never fails {
    if (raw string_eq(name, "aalloc")) { pass true; }
    if (raw string_eq(name, "alloc")) { pass true; }
    if (raw string_eq(name, "calloc")) { pass true; }
    if (raw string_eq(name, "mcpy")) { pass true; }
    if (raw string_eq(name, "memset")) { pass true; }
    if (raw string_eq(name, "mmov")) { pass true; }
    if (raw string_eq(name, "ptr_add")) { pass true; }
    if (raw string_eq(name, "ralloc")) { pass true; }
    if (raw string_eq(name, "wild_ptr")) { pass true; }
    if (raw string_eq(name, "wildx_alloc")) { pass true; }
    pass false;
};
