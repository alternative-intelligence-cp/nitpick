    }
    if (raw string_eq(name, "own_fd")) {
        if (i == 0i32) { pass "fd"; }
    }
    if (raw string_eq(name, "path_exists")) {
        if (i == 0i32) { pass "cstring"; }
    }
    if (raw string_eq(name, "ralloc")) {
        if (i == 0i32) { pass "wild any->"; }
        if (i == 1i32) { pass "int64"; }
    }
    if (raw string_eq(name, "read")) {
        if (i == 0i32) { pass "fd"; }
        if (i == 1i32) { pass "wild any->"; }
        if (i == 2i32) { pass "int64"; }
