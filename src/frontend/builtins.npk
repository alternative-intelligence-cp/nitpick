// Bare-name builtins.
//
// GENERATED by bootstrap/generator/gen_tables.py from
// meta/specs/BUILTIN_REFERENCE.md.
//
// These are ordinary calls the compiler happens to provide -- they take
// arguments, return Result<T>, and obey the same rules as any function
// (AST_REFERENCE 3.3). The `#` sigil marks the OTHER kind, the ones the
// compiler must treat specially.
//
// The resolver needs this list because a bare-name builtin is declared in no
// module. Without it every `alloc` in every program resolves to nothing.

pub func:is_builtin_name = bool(string:name) {
    if (raw string_eq(name, "alloc")) { pass true; }
    if (raw string_eq(name, "calloc")) { pass true; }
    if (raw string_eq(name, "dalloc")) { pass true; }
    if (raw string_eq(name, "int_to_string")) { pass true; }
    if (raw string_eq(name, "mcpy")) { pass true; }
    if (raw string_eq(name, "memset")) { pass true; }
    if (raw string_eq(name, "mmov")) { pass true; }
    if (raw string_eq(name, "path_exists")) { pass true; }
    if (raw string_eq(name, "ralloc")) { pass true; }
    if (raw string_eq(name, "read_file")) { pass true; }
    if (raw string_eq(name, "read_stdin")) { pass true; }
    if (raw string_eq(name, "string_byte_length")) { pass true; }
    if (raw string_eq(name, "string_char_count")) { pass true; }
    if (raw string_eq(name, "string_concat")) { pass true; }
    if (raw string_eq(name, "string_contains")) { pass true; }
    if (raw string_eq(name, "string_count")) { pass true; }
    if (raw string_eq(name, "string_ends_with")) { pass true; }
    if (raw string_eq(name, "string_equals")) { pass true; }
    if (raw string_eq(name, "string_format_float")) { pass true; }
    if (raw string_eq(name, "string_from_bytes")) { pass true; }
    if (raw string_eq(name, "string_from_char")) { pass true; }
    if (raw string_eq(name, "string_from_int")) { pass true; }
    if (raw string_eq(name, "string_from_int_hex")) { pass true; }
    if (raw string_eq(name, "string_index_of")) { pass true; }
    if (raw string_eq(name, "string_is_empty")) { pass true; }
    if (raw string_eq(name, "string_is_valid_utf8")) { pass true; }
    if (raw string_eq(name, "string_last_index_of")) { pass true; }
    if (raw string_eq(name, "string_length")) { pass true; }
    if (raw string_eq(name, "string_pad_left")) { pass true; }
    if (raw string_eq(name, "string_pad_right")) { pass true; }
    if (raw string_eq(name, "string_repeat")) { pass true; }
    if (raw string_eq(name, "string_replace")) { pass true; }
    if (raw string_eq(name, "string_slice")) { pass true; }
    if (raw string_eq(name, "string_starts_with")) { pass true; }
    if (raw string_eq(name, "string_substring")) { pass true; }
    if (raw string_eq(name, "string_to_int")) { pass true; }
    if (raw string_eq(name, "string_to_lower")) { pass true; }
    if (raw string_eq(name, "string_to_upper")) { pass true; }
    if (raw string_eq(name, "string_trim")) { pass true; }
    if (raw string_eq(name, "string_trim_end")) { pass true; }
    if (raw string_eq(name, "string_trim_start")) { pass true; }
    if (raw string_eq(name, "sys")) { pass true; }
    if (raw string_eq(name, "to_cstring")) { pass true; }
    if (raw string_eq(name, "write_raw")) { pass true; }
    pass false;
};

// The `#`-sigil builtins -- the OTHER kind, the ones the compiler treats
// specially. `#foo(...)` is also how a macro is invoked (D-046), so this is
// what tells a builtin that survived expansion from a macro that was never
// declared. `caller` is deliberately ABSENT: it is legal only inside a macro
// body, expansion consumes it, and one that reaches here is one written
// somewhere it means nothing.
pub func:is_hash_builtin = bool(string:name) {
    if (raw string_eq(name, "size_of")) { pass true; }
    if (raw string_eq(name, "wild_ptr")) { pass true; }
    if (raw string_eq(name, "wild_slice")) { pass true; }
    pass false;
};
