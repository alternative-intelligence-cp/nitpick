    if (raw string_eq(name, "dalloc")) { pass true; }
    if (raw string_eq(name, "driver_retire")) { pass true; }
    if (raw string_eq(name, "environ")) { pass true; }
    if (raw string_eq(name, "int_to_string")) { pass true; }
    if (raw string_eq(name, "io_unwatch")) { pass true; }
    if (raw string_eq(name, "io_watch")) { pass true; }
    if (raw string_eq(name, "mcpy")) { pass true; }
    if (raw string_eq(name, "memset")) { pass true; }
    if (raw string_eq(name, "mmov")) { pass true; }
    if (raw string_eq(name, "mono_now")) { pass true; }
    if (raw string_eq(name, "own_fd")) { pass true; }
    if (raw string_eq(name, "path_exists")) { pass true; }
    if (raw string_eq(name, "ralloc")) { pass true; }
    if (raw string_eq(name, "release_fd")) { pass true; }
    if (raw string_eq(name, "shared_arena_make")) { pass true; }
    if (raw string_eq(name, "site_line")) { pass true; }
