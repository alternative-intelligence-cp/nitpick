// Which bare-name builtins are `pure` (D-221, 1.5.1) -- the reference's Pure
// column, generated. A `pure` body (TYPE-061) and a contract expression
// (TYPE-060) admit these and refuse every other builtin by name.
pub func:builtin_pure = bool(string:name) never fails {
    if (raw string_eq(name, "string_byte_length")) { pass true; }
    if (raw string_eq(name, "string_bytes")) { pass true; }
    if (raw string_eq(name, "string_equals")) { pass true; }
    if (raw string_eq(name, "string_from_bytes")) { pass true; }
    if (raw string_eq(name, "string_is_empty")) { pass true; }
    pass false;
};

// The irregulars (D-201): typed by a bespoke `type_call` arm, because no
// signature can state what they do -- `sys` is variadic, `atomic_from_ptr`
// reads its element from a turbofish, and the seven constructors read
// theirs from the annotation the call is given.
pub func:builtin_sig_special = bool(string:name) never fails {
    if (raw string_eq(name, "arena_make")) { pass true; }
    if (raw string_eq(name, "atomic_from_ptr")) { pass true; }
    if (raw string_eq(name, "barrier")) { pass true; }
    if (raw string_eq(name, "channel")) { pass true; }
    if (raw string_eq(name, "condvar")) { pass true; }
    if (raw string_eq(name, "mutex")) { pass true; }
    if (raw string_eq(name, "rwlock")) { pass true; }
    if (raw string_eq(name, "shared_arena_make")) { pass true; }
    if (raw string_eq(name, "sys")) { pass true; }
    pass false;
};

// How many parameters a regular builtin takes. A special's answer is 0 and
// means nothing -- ask `builtin_sig_special` first.
pub func:builtin_sig_count = int32(string:name) never fails {
    if (raw string_eq(name, "aalloc")) { pass 2i32; }
    if (raw string_eq(name, "alloc")) { pass 1i32; }
    if (raw string_eq(name, "buffer_new")) { pass 1i32; }
    if (raw string_eq(name, "calloc")) { pass 2i32; }
    if (raw string_eq(name, "chain_site")) { pass 1i32; }
    if (raw string_eq(name, "clone_exec")) { pass 1i32; }
    if (raw string_eq(name, "close")) { pass 1i32; }
    if (raw string_eq(name, "dalloc")) { pass 1i32; }
    if (raw string_eq(name, "driver_retire")) { pass 1i32; }
    if (raw string_eq(name, "int_to_string")) { pass 1i32; }
    if (raw string_eq(name, "io_unwatch")) { pass 1i32; }
    if (raw string_eq(name, "io_watch")) { pass 2i32; }
    if (raw string_eq(name, "mcpy")) { pass 3i32; }
    if (raw string_eq(name, "memset")) { pass 3i32; }
    if (raw string_eq(name, "mmov")) { pass 3i32; }
    if (raw string_eq(name, "open")) { pass 3i32; }
    if (raw string_eq(name, "own_fd")) { pass 1i32; }
    if (raw string_eq(name, "path_exists")) { pass 1i32; }
    if (raw string_eq(name, "ralloc")) { pass 2i32; }
    if (raw string_eq(name, "read")) { pass 3i32; }
    if (raw string_eq(name, "read_file")) { pass 1i32; }
    if (raw string_eq(name, "release_fd")) { pass 1i32; }
    if (raw string_eq(name, "site_line")) { pass 1i32; }
    if (raw string_eq(name, "site_path")) { pass 1i32; }
    if (raw string_eq(name, "string_byte_length")) { pass 1i32; }
    if (raw string_eq(name, "string_bytes")) { pass 1i32; }
    if (raw string_eq(name, "string_concat")) { pass 2i32; }
    if (raw string_eq(name, "string_equals")) { pass 2i32; }
    if (raw string_eq(name, "string_from_bytes")) { pass 2i32; }
    if (raw string_eq(name, "string_is_empty")) { pass 1i32; }
    if (raw string_eq(name, "string_slice")) { pass 3i32; }
    if (raw string_eq(name, "suspend_io")) { pass 3i32; }
    if (raw string_eq(name, "suspend_until")) { pass 1i32; }
    if (raw string_eq(name, "to_cstring")) { pass 1i32; }
    if (raw string_eq(name, "wildx_alloc")) { pass 1i32; }
    if (raw string_eq(name, "wildx_call")) { pass 2i32; }
    if (raw string_eq(name, "wildx_free")) { pass 1i32; }
    if (raw string_eq(name, "wildx_seal")) { pass 1i32; }
    if (raw string_eq(name, "write")) { pass 3i32; }
    if (raw string_eq(name, "write_file")) { pass 2i32; }
    pass 0i32;
};

// The i-th parameter's TYPE TEXT, for the checker's resolver to intern.
// The memory qualifier rides along as documentation exactly as it does in
// source -- qualifiers are not part of a type (parse_type.npk).
pub func:builtin_sig_param = string(string:name, int32:i) never fails {
    if (raw string_eq(name, "aalloc")) {
        if (i == 0i32) { pass "int64"; }
        if (i == 1i32) { pass "int64"; }
    }
    if (raw string_eq(name, "alloc")) {
        if (i == 0i32) { pass "int64"; }
    }
    if (raw string_eq(name, "buffer_new")) {
