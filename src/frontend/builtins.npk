        if (i == 0i32) { pass "int32"; }
    }
    if (raw string_eq(name, "clone_exec")) {
        if (i == 0i32) { pass "wild any->"; }
    }
    if (raw string_eq(name, "close")) {
        if (i == 0i32) { pass "fd"; }
    }
    if (raw string_eq(name, "dalloc")) {
        if (i == 0i32) { pass "wild any->"; }
