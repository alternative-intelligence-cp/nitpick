// The type representation.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.0.
//
// NITPICK IS NOMINALLY TYPED AND TYPES ARE INTERNED (D-090).
//
// One `int32` for the whole program: constructing `int32->` twice yields the same
// index, and **type equality is an integer compare**. There is no structural walk,
// so there is nothing structural to get subtly wrong — which matters here more
// than usual, because a comparison that is *almost* right produces a program that
// compiles and misbehaves rather than one that fails.
//
// Nominal identity is the language half of the same decision:
//
//     struct:Meters = { flt64:v; };
//     struct:Seconds = { flt64:v; };      // a DIFFERENT type
//
// The reason to declare two structs rather than one is that they mean different
// things, and a type system that ignored the declaration would ignore the only
// place that meaning was written down. Nitpick already makes this choice
// everywhere: `bool`/`char8`/`uint8` are one byte and three types; `fd`, `pid`,
// `tid`, `uid` and `gid` are integers and five types (D-042); `cstring` and a
// byte slice share a layout and are two types (D-049).
//
// A LAYOUT HERE IS NOT THROWAWAY. The seed's layouts and this table's have to
// agree until the bootstrap fixpoint closes, because their output interoperates
// (bootstrap/generator/ntypes.py says the same thing from the other side).

// THE MODULE'S OWN DEFECTS (D-179): a module names what it traps with, and
// declares it privately — the code is the FNV of `module.Name`, so identity
// is unforgeable and no import rides along. `Bounds*` are the D-061-family
// index guards; the rest are named for the invariant they hold.
error:BoundsId;
error:BoundsIndex;

use "./source_location.npk".*;
use "./intern.npk".*;
use "./ast.npk".*;

// --- kinds -------------------------------------------------------------------------
//
// A kind plus its operands. The operands mean different things per kind, and —
// as in the AST — the accessors are the only place that is interpreted.

pub func:TY_INVALID = int32() never fails  { pass 0i32; };   // a type that failed to resolve
pub func:TY_NIL = int32() never fails      { pass 1i32; };
pub func:TY_BOOL = int32() never fails     { pass 2i32; };
pub func:TY_INT = int32() never fails      { pass 3i32; };   // a = bits, b = signed
pub func:TY_CHAR = int32() never fails     { pass 4i32; };   // a = bits
pub func:TY_FLOAT = int32() never fails    { pass 5i32; };   // a = bits
pub func:TY_TBB = int32() never fails      { pass 6i32; };   // a = bits
pub func:TY_KERNEL = int32() never fails   { pass 7i32; };   // fd/pid/tid/uid/gid; a = which
pub func:TY_STRING = int32() never fails   { pass 8i32; };
pub func:TY_CSTRING = int32() never fails  { pass 9i32; };
pub func:TY_ANY = int32() never fails      { pass 10i32; };
pub func:TY_POINTER = int32() never fails  { pass 11i32; };  // a = pointee
pub func:TY_SLICE = int32() never fails    { pass 12i32; };  // a = element
pub func:TY_ARRAY = int32() never fails    { pass 13i32; };  // a = element, b = count
pub func:TY_OPTIONAL = int32() never fails { pass 14i32; };  // a = inner
pub func:TY_RESULT = int32() never fails   { pass 15i32; };  // a = success type
pub func:TY_STRUCT = int32() never fails   { pass 16i32; };  // a = DeclId
pub func:TY_ENUM = int32() never fails     { pass 17i32; };  // a = DeclId
pub func:TY_TRAIT = int32() never fails    { pass 18i32; };  // a = DeclId
pub func:TY_DYN = int32() never fails      { pass 19i32; };  // a,b = trait window
pub func:TY_FUNC = int32() never fails     { pass 20i32; };  // a = return, b,c = param window
pub func:TY_SELF = int32() never fails     { pass 21i32; };
pub func:TY_PARAM = int32() never fails    { pass 22i32; };  // a generic parameter; a = DeclId
pub func:TY_RANGE = int32() never fails    { pass 23i32; };  // a = element (D-093)

// A VARIADIC FUNCTION IS A DIFFERENT KIND, not `TY_FUNC` with a flag beside it.
//
// The window is the same shape and its LAST entry is the variadic parameter,
// typed as the slice `T[]` it actually is inside the body (D-070) — so the
// element every trailing argument is checked against is `type_elem` of it, and
// nothing extra is stored.
//
// The reason for a kind rather than a boolean is the one `AST_REFERENCE.md` gives
// for `FailsOn` and `NeverFails` being separate node kinds: a shared kind plus a
// flag makes the two the same until somebody reads the right slot, and "an
// encoding that can be misread by ignoring a field" is exactly what happened here
// — `fn_type` carried no variadic information at all, so every variadic call
// checked as fixed arity and said nothing.
pub func:TY_FUNC_VARIADIC = int32() never fails { pass 24i32; };

// A COMPILE-TIME VALUE STANDING IN A TYPE-ARGUMENT WINDOW — `Mutex<Config, 2>`
// (D-064 §2). `a` is the value's TYPE and `name` is its rendering.
//
// IT IS NOT A TYPE AND NOTHING CAN DECLARE ONE. A generic argument list is
// positional and holds both kinds, so every entry has to be one index; making the
// value an index too keeps the window uniform, rather than a mixture that only
// the parameter list can tell apart — an encoding that can be misread by ignoring
// a field is the mistake `TY_FUNC_VARIADIC` exists to avoid, one line above.
//
// IDENTITY IS THE RENDERING, and that is what makes `2` and `2` the same argument
// and `2` and `3` different ones. `2i32` and `2i64` differ in slot `a` and are
// also different, which is right: a value parameter has a declared type and the
// argument's has to be it.
pub func:TY_COMPTIME = int32() never fails { pass 25i32; };  // a = the value's type
pub func:TY_ARENA = int32() never fails    { pass 26i32; };  // a = element (D-017, D-152)
pub func:TY_HANDLE = int32() never fails   { pass 27i32; };  // a = element (MEMORY_REFERENCE 4.1)
pub func:TY_SHARED_ARENA = int32() never fails { pass 28i32; };  // a = element (D-017, D-154)

// AN ASSOCIATED TYPE, UNRESOLVED (D-160). `a` is the declaring TRAIT's decl and
// `b` is the assoc's name — the pair, because the name alone is not an identity:
// two traits may each declare `Item` and they are two different types.
//
// LIKE `Self`, IT IS A REAL TYPE THAT HAS NOT BEEN SUBSTITUTED YET. Inside a
// trait body `Item` means "whatever the implementor binds"; at an impl it
// becomes that binding. It has no representation of its own, which is why it is
// zero-sized here and a rung at lowering — anything that reaches emission
// carrying one has escaped its substitution.
pub func:TY_ASSOC = int32() never fails { pass 29i32; };  // a = trait decl, b = name
pub func:TY_ERROR = int32() never fails { pass 30i32; };  // D-179: a nominal non-number over 4 bytes
pub func:TY_ATOMIC = int32() never fails { pass 31i32; };  // D-182: a = element; storage-only, no allocating ctor (D-033)
// D-182: a CHANNEL ENDPOINT — `a` = element, `b` = lock level, `c` = capacity.
// The VALUE is an opaque generation-checked handle, not an address: that is
// what lets it cross a spawn (D-004/D-180 refuse a borrow there) and ride in
// a message, while the creating scope still owns the channel's life.
pub func:TY_MUTEX = int32() never fails { pass 33i32; };  // D-056: a = element, b = LEVEL; the value is one ptr to an owned cell
pub func:TY_GUARD = int32() never fails { pass 34i32; };  // D-056: a = element; holds the cell ptr, its DROP is the release
pub func:TY_RWLOCK = int32() never fails { pass 35i32; };  // D-056 1.1.11b: a = element, b = LEVEL; one ptr to the owned cell
pub func:TY_RGUARD = int32() never fails { pass 36i32; };  // D-056 1.1.11b: a = element; a READ hold — `.value` is read-only, the drop releases a reader
pub func:TY_CONDVAR = int32() never fails { pass 37i32; };  // D-056 1.1.11b: a = LEVEL; `timedwait` only, over a lent Guard
pub func:TY_BARRIER = int32() never fails { pass 38i32; };  // D-056 1.1.11b: a = N, b = LEVEL; `arrive` is the one operation
pub func:TY_CHANNEL = int32() never fails { pass 32i32; };
// D-185 (1.1.12b): AN OWNING DESCRIPTOR — the value is the kernel's i32, and
// the OWNERSHIP is the point: its generated drop closes it at scope exit,
// which is what IO_REFERENCE §6's "there is no close in the surface" lowers
// to. `own_fd(f)` wraps, `release_fd(move o)` unwraps for a caller that must
// observe close's verdict through the floor's `close`. Move-only like every
// owner; refused across channels and spawns (a stream cannot escape the
// scope discipline that closes it).
pub func:TY_OWNEDFD = int32() never fails { pass 39i32; };

// D-135/D-194 (1.3.1): the vector MECHANISM — an LLVM vector in a register
// is what makes SIMD fast, so the type IS that shape. a = element, b = lane
// count; both are the type's identity (one instantiation, one behaviour —
// the Channel precedent). Elements are the plain scalars only; the twisted
// and ternary families are excluded by D-194 (per-lane sticky-ERR chains
// erase the hardware-vector win).
pub func:TY_SIMD = int32() never fails { pass 40i32; };

// D-036/D-037/D-195 (1.3.2): TWISTED FIXED POINT — Q(N/2).(N/2) on a native
// iN carrier, the most negative raw value the sticky ERR sentinel (the tbb
// tables serve both twisted families — same carrier, same sentinel).
// a = total bits; F = bits/2.
pub func:TY_TFP = int32() never fails { pass 41i32; };

pub struct:Type = {
    int32:kind;
    int32:a;
    int32:b;
    int32:c;
    int64:size;      // bytes
    int32:align;
    int32:name;      // intern index, for a named type; 0 otherwise
};

pub struct:TypeTable = {
    wild Type->:items;
    int32:count;
    int32:cap;

    // The scalars, interned once at startup so the common comparisons need no
    // lookup at all.
    int32:t_nil;
    int32:t_bool;
    int32:t_string;
    int32:t_cstring;
    int32:t_any;
    int32:t_tbb32;
    int32:t_error;   // D-179: the one Error type — every Result's error half

    // The layout-recorded pointer-bearing bits, parallel to `items` — see
    // `tt_set_haspt` for why this is not a `Type` slot.
    wild int32->:haspt;

    // THE LAYOUT-RECORDED DROP BITS (D-183, 1.2.0), parallel in the same way
    // and for the same reason. Whether a struct or enum OWNS anything is a
    // question about its fields, and layout is the one pass that walks every
    // field's resolved type; asking again later would mean re-resolving, and
    // storing it in a `Type` slot would make two structurally identical
    // structs intern as different types. 0 = not computed, 1 = owns nothing,
    // 2 = owns something and must be dropped.
    wild int32->:drops;
    // Channel containment, same discipline (D-183, 1.2.5).
    wild int32->:haschan;
    // Borrow containment (D-183, 1.2.5b): pointers that are NOT owned bodies.
    wild int32->:hasborrow;
};

// --- construction ----------------------------------------------------------------------

func:tt_grow = NIL(TypeTable->:t) never fails {
    int32:nc = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items =>! wild int8->,
                                (nc => int64) * #size_of<Type>());
    t.items = bigger =>! wild Type->;
    wild int8->:hp = ralloc(t.haspt =>! wild int8->, (nc => int64) * 4i64);
    wild int32->:hw = hp =>! wild int32->;
    wild int8->:dp = ralloc(t.drops =>! wild int8->, (nc => int64) * 4i64);
    wild int8->:hcp = ralloc(t.haschan =>! wild int8->, (nc => int64) * 4i64);
    wild int8->:hbp = ralloc(t.hasborrow =>! wild int8->, (nc => int64) * 4i64);
    wild int32->:dw = dp =>! wild int32->;
    // The grown tail must read "not computed" — ralloc copies only the old block.
    int32:z = t.cap;
    while (z < nc) { hw[z => int64] = 0i32; dw[z => int64] = 0i32; z = z + 1i32; }
    t.haspt = hw;
    t.drops = dw;
    t.haschan = hcp =>! wild int32->;
    t.hasborrow = hbp =>! wild int32->;
    t.cap = nc;
    pass NIL;
};

// THE INTERNING. A type already present returns its existing index, which is what
// makes equality an integer compare everywhere else.
pub func:tt_intern = int32(TypeTable->:t, int32:kind, int32:a, int32:b, int32:c,
                           int64:size, int32:align, int32:name) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        Type:e = t.items[i => int64];
        if (e.kind == kind) {
            if (e.a == a) {
                if (e.b == b) {
                    if (e.c == c) {
                        if (e.name == name) {
                            pass i;
                        }
                    }
                }
            }
        }
        i = i + 1i32;
    }
    if (t.count >= t.cap) {
        drop tt_grow(t);
    }
    Type:n = Type{ kind: kind, a: a, b: b, c: c,
                   size: size, align: align, name: name };
    t.items[t.count => int64] = n;
    int32:id = t.count;
    t.count = t.count + 1i32;
    pass id;
};

// A LAYOUT IS WRITTEN IN PLACE, NEVER RE-INTERNED.
//
// `tt_intern` keys on kind and the three operand slots and the name, and DOES NOT
// COMPARE SIZE — deliberately, because a type's identity is what it IS and not how
// wide it happens to be. The consequence was that `struct_layout` could not work:
// it computed a size, called `tt_struct` with it, and got back the original
// zero-sized entry. Every struct in the program was size 0, so `Result<Point>` was
// four bytes where it should be sixteen, and nothing said so — which is why
// nothing called `struct_layout` at all.
//
// SIZE ZERO MEANS "NOT YET COMPUTED", and that reading is safe rather than
// convenient: a laid-out struct is at least one byte (two distinct empty structs
// must have distinct addresses), so zero cannot be a real answer. `NIL` is
// genuinely zero-sized (D-084) and is not a struct.
//
// This is the ONE mutation of an interned type, and it is a completion rather than
// a change: the entry is written once, from absent to known, and every id already
// handed out keeps meaning the same type.
// WHETHER A STRUCT CAN HOLD AN ADDRESS, recorded by layout (0.8.1) in a SIDE
// ARRAY, deliberately not in a `Type` slot: `tt_intern` compares every slot to
// decide identity, so a bit written after interning would make the same struct
// intern twice — the first draft used the spare `c` and broke type equality
// program-wide. 0 = not computed, 1 = no pointers anywhere, 2 = holds or may.
// The escape analysis reads it: a struct of plain scalars (`ModuleEntry`,
// `Token`, `Span`) can no more carry a borrow than an `int32` can.
pub func:tt_set_haspt = NIL(TypeTable->:t, int32:id, bool:has) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if (id >= t.count) { !!! BoundsId; }
    t.haspt[id => int64] = 1i32;
    if (has) { t.haspt[id => int64] = 2i32; }
    pass NIL;
};

// The drop bit, written once by layout from absent to known — the same
// once-only discipline `tt_set_haspt` documents.
pub func:tt_set_drops = NIL(TypeTable->:t, int32:id, bool:has) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if (id >= t.count) { !!! BoundsId; }
    t.drops[id => int64] = 1i32;
    if (has) { t.drops[id => int64] = 2i32; }
    pass NIL;
};

pub func:tt_drops = int32(TypeTable->:t, int32:id) never fails {
    if (id < 0i32) { pass 0i32; }
    if (id >= t.count) { pass 0i32; }
    pass (t.drops[id => int64]);
};

// The channel-containment bit, written once by layout (D-183, 1.2.5).
pub func:tt_set_haschan = NIL(TypeTable->:t, int32:id, bool:has) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if (id >= t.count) { !!! BoundsId; }
    t.haschan[id => int64] = 1i32;
    if (has) { t.haschan[id => int64] = 2i32; }
    pass NIL;
};
pub func:tt_haschan = int32(TypeTable->:t, int32:id) never fails {
    if (id < 0i32) { pass 0i32; }
    if (id >= t.count) { pass 0i32; }
    pass (t.haschan[id => int64]);
};

// The borrow-containment bit, written once by layout (D-183, 1.2.5b).
pub func:tt_set_hasborrow = NIL(TypeTable->:t, int32:id, bool:has) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if (id >= t.count) { !!! BoundsId; }
    t.hasborrow[id => int64] = 1i32;
    if (has) { t.hasborrow[id => int64] = 2i32; }
    pass NIL;
};
pub func:tt_hasborrow = int32(TypeTable->:t, int32:id) never fails {
    if (id < 0i32) { pass 0i32; }
    if (id >= t.count) { pass 0i32; }
    pass (t.hasborrow[id => int64]);
};

// DOES A VALUE OF THIS TYPE OWN ANYTHING THAT MUST BE RELEASED (D-183)?
//
// The answer for a struct or enum is layout's, recorded above; every other
// kind answers from its own shape. Most answer NO, and that is the point: a
// type with no drop generates no call, so the feature costs nothing for the
// scalars that dominate every program.
//
// NOT owning: scalars of every width, `Error`, the kernel ids, `NIL`; a
// POINTER (`wild` memory is manual, via `defer`/`dalloc` — that is what makes
// the regime explicit); a SLICE (a borrow, D-070); a `Handle<T>` and a channel
// endpoint (indices, not owners — D-152/D-182).
//
// `arena<T>`, `shared_arena<T>` and `Channel<T, …>` answer NO *for now* and
// must answer YES at 1.2.5, which is where slab release and channel-slot
// reclamation land. That is written down rather than left implicit because
// the channel one is load-bearing: reclaiming a slot is what moves its
// generation, and until it does, D-182's `StaleHandle` cannot be provoked
// from source at all.
pub func:type_drops = bool(TypeTable->:t, int32:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass false; }
    if (id <= 0i32) { pass false; }
    int32:k = raw type_kind(t, id);
    // A string owns its body unless the body is a literal's, and `cap == 0`
    // is how it says so (D-183) — the drop is conditional, but the TYPE needs
    // one either way.
    if (k == (raw TY_STRING()))   { pass true; }
    if (k == (raw TY_ARRAY()))    {
        pass (raw type_drops(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_OPTIONAL())) {
        pass (raw type_drops(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_RESULT()))   {
        pass (raw type_drops(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_ATOMIC()))   {
        pass (raw type_drops(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_STRUCT()))   { pass ((raw tt_drops(t, id)) == 2i32); }
    if (k == (raw TY_ENUM()))     { pass ((raw tt_drops(t, id)) == 2i32); }
    // A MUTEX OWNS ITS CELL AND ITS ELEMENT (D-056, 1.1.11): the drop frees
    // both — by the join discipline nobody can still hold it at the owner's
    // exit. A GUARD owns an OBLIGATION rather than memory: its drop is the
    // RELEASE, which is what "the guard's scope is the critical section"
    // lowers to, and why both are move-only like every owner.
    if (k == (raw TY_MUTEX()))    { pass true; }
    if (k == (raw TY_GUARD()))    { pass true; }
    // The same reasoning kind for kind (1.1.11b): an RwLock owns cell and
    // element; an RGuard owns a READ obligation its drop discharges; a
    // CondVar and a Barrier own their cells.
    if (k == (raw TY_RWLOCK()))   { pass true; }
    if (k == (raw TY_RGUARD()))   { pass true; }
    if (k == (raw TY_CONDVAR()))  { pass true; }
    if (k == (raw TY_BARRIER()))  { pass true; }
    // A `dyn` OWNS the heap cell its coercion moved the concrete value into
    // (D-183, 1.2.4). Erasure needs indirection; indirection that survives
    // the frame needs the heap (the alloca spill dangled the moment a `dyn`
    // was returned — dyn_slots.npk's `choose` dispatched through a dead
    // frame); and a heap cell needs exactly one owner. TRUE unconditionally:
    // whether the CONCRETE type also owns something is the vtable's slot-0
    // business, not the fat pointer's — the cell itself must be freed either
    // way, so every `dyn` is move-only and carries a drop.
    if (k == (raw TY_DYN()))      { pass true; }
    // AN ARENA OWNS ITS SLABS (D-003/D-183, 1.2.5c): the binding's scope
    // exit destroys them — dropping any still-live owning elements first —
    // which is what lets arenas replace a collector WITHOUT the manual
    // `destroy` being the only reclaimer. `shared_arena` stays out: its
    // value is a pointer into shared storage whose teardown needs the
    // per-scope join machinery (OPEN_DECISIONS C-22).
    if (k == (raw TY_ARENA()))    { pass true; }
    // AN OwnedFd OWNS ITS DESCRIPTOR (D-185, 1.1.12b): the drop closes it.
    if (k == (raw TY_OWNEDFD()))  { pass true; }
    // A `simd` VALUE IS LANES OF PLAIN SCALARS (D-194) — nothing to drop,
    // stated rather than defaulted per the B-7 walker discipline.
    if (k == (raw TY_SIMD()))     { pass false; }
    // A `tfp` IS ITS CARRIER'S BITS (D-195) — nothing to drop.
    if (k == (raw TY_TFP()))      { pass false; }
    pass false;
};

// The one OwnedFd type — interned like any scalar singleton; 4 bytes, the
// kernel's descriptor number, owning (type_drops says so).
pub func:tt_ownedfd = int32(TypeTable->:t) never fails {
    pass (raw tt_intern(t, raw TY_OWNEDFD(), 0i32, 0i32, 0i32, 4i64, 4i32, 0i32));
};

pub func:tt_haspt = int32(TypeTable->:t, int32:id) never fails {
    if (id < 0i32) { pass 0i32; }
    if (id >= t.count) { pass 0i32; }
    pass (t.haspt[id => int64]);
};

pub func:tt_set_layout = NIL(TypeTable->:t, int32:id, int64:size, int32:align) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if (id >= t.count) { !!! BoundsId; }
    Type:e = t.items[id => int64];
    e.size = size;
    e.align = align;
    t.items[id => int64] = e;
    pass NIL;
};

pub func:tt_get = Type(TypeTable->:t, int32:id) never fails {
    if (id < 0i32) { !!! BoundsId; }
    if (id >= t.count) { !!! BoundsId; }
    pass t.items[id => int64];
};

pub func:tt_count = int32(TypeTable->:t) never fails { pass t.count; };

// --- how an aggregate is laid out ------------------------------------------------------
//
// ONE ARITHMETIC, AND EVERY AGGREGATE GOES THROUGH IT. A struct, a `Result<T>`, an
// `Optional<T>` and a range are all the same shape of question — fields in order,
// each moved up to its own alignment, the total rounded up to the widest — and
// until 0.7.2 each answered it with a formula of its own.
//
// TWO OF THE FOUR WERE WRONG, and both in the direction that does not fail:
//
//   - `Result<T>` was `size(T) + 4`, which forgets the padding LLVM inserts on
//     BOTH sides of the error field. `Result<int64>` is `{i64, i32}` — sixteen
//     bytes, because the whole must round up to the eight the `i64` demands — and
//     this said twelve. `Result<int8>` is eight and this said five.
//   - AN ENUM HAD NO LAYOUT AT ALL: `tt_enum` was called with size zero from both
//     of its call sites and nothing ever fixed it, so every struct with an enum
//     field was laid out as though the field were not there.
//
// Neither could be caught by the tests that existed, because `tests/frontend/
// type_layout.npk` asserted `Result<Pair>` — where `Pair` is `{i32,i32}`, needs no
// padding, and gives the right answer by accident.
//
// The fix is not four corrected formulas. It is ONE, used four times: a formula
// per aggregate is four chances to disagree about padding, which is the same
// argument `struct_field` makes for walking and laying out in a single pass.

pub struct:Lay = { int64:size; int32:align; };

// Round `n` up to the next multiple of `align`. The one arithmetic rule the whole
// layout rests on, so it is a function rather than N copies of the same expression.
//
// It lives HERE, beside the interning that needs it, rather than in
// `type_layout.npk` where it was written: `tt_result` and `tt_optional` compute a
// total at the moment they intern, and a module they cannot import is a module
// whose rule they end up restating.
pub func:align_up = int64(int64:n, int32:align) never fails {
    if (align <= 1i32) { pass n; }
    int64:a = align => int64;
    int64:rem = n % a;
    if (rem == 0i64) { pass n; }
    pass (n + (a - rem));
};

pub func:lay_start = Lay() never fails {
    Lay:l = Lay{ size: 0i64, align: 1i32 };
    pass l;
};

// ONE FIELD, IN DECLARATION ORDER — AND IT RETURNS THE OFFSET IT LANDED AT.
//
// That return is what lets the offset walk and the size walk be ONE walk rather
// than two that have to agree about padding. `struct_field` used to keep a
// running sum of its own beside this one; now it reads the answer out of the
// same call that produced it, so there is no second sum to drift.
pub func:lay_field = int64(Lay->:l, int64:fsize, int32:falign) never fails {
    if (falign > l.align) { l.align = falign; }
    l.size = raw align_up(l.size, falign);
    int64:at = l.size;
    l.size = l.size + fsize;
    pass at;
};

// THE TAIL PADDING, which is the half that was missing. An aggregate's size is a
// multiple of its alignment, so that `T[2]` puts the second element where the
// first one's alignment says it goes — and that rounding is the difference
// between `Result<int64>` being sixteen bytes and being twelve.
pub func:lay_end = NIL(Lay->:l) never fails {
    l.size = raw align_up(l.size, l.align);
    pass NIL;
};

// --- the scalars ---------------------------------------------------------------------
//
// Sizes and alignments are `TYPE_REFERENCE.md` §§1–2, 9–11. They are asserted
// against `#size_of` in the test rather than trusted, because a hand-written size
// that disagrees with what LLVM lays out survives testing and corrupts memory
// later.

// ALIGNMENT CAPS AT 16 (0.9.3, measured): the x86-64 datalayout aligns i128 at
// 16 and every wider integer inherits that cap — an executed probe confirmed
// {i8,i128} is 32 bytes and {i8,i256} is 48, so bits/8 (which said 32 for
// i256) was the memory-corruption-class disagreement the audit flagged: the
// frontend's struct offsets would not have been LLVM's.
func:int_align = int32(int32:bits) never fails {
    int32:al = bits / 8i32;
    if (al > 16i32) { al = 16i32; }
    pass al;
};

pub func:tt_int = int32(TypeTable->:t, int32:bits, bool:signed) never fails {
    int32:sg = 0i32;
    if (signed) { sg = 1i32; }
    int64:bytes = (bits => int64) / 8i64;
    pass (raw tt_intern(t, raw TY_INT(), bits, sg, 0i32, bytes,
                        raw int_align(bits), 0i32));
};

pub func:tt_char = int32(TypeTable->:t, int32:bits) never fails {
    int64:bytes = (bits => int64) / 8i64;
    pass (raw tt_intern(t, raw TY_CHAR(), bits, 0i32, 0i32, bytes, bits / 8i32, 0i32));
};

pub func:tt_float = int32(TypeTable->:t, int32:bits) never fails {
    int64:bytes = (bits => int64) / 8i64;
    pass (raw tt_intern(t, raw TY_FLOAT(), bits, 0i32, 0i32, bytes, bits / 8i32, 0i32));
};

pub func:tt_tbb = int32(TypeTable->:t, int32:bits) never fails {
    int64:bytes = (bits => int64) / 8i64;
    // b = 1: SIGNED. Balanced ternary is symmetric about zero — negative codes
    // are half the space, and INT32_MIN is tbb32's ERR sentinel — so the binary
    // carrier is signed by construction. Widening a negative code by zext
    // turned -9 into four billion, found by fd_io's write-after-close (0.8.5).
    pass (raw tt_intern(t, raw TY_TBB(), bits, 1i32, 0i32, bytes,
                        raw int_align(bits), 0i32));
};

// `tfpN` — the twisted twin (D-195): same carrier, same signedness reasoning,
// same sentinel; the Q scale (F = N/2) lives in the OPERATIONS, not the layout.
pub func:tt_tfp = int32(TypeTable->:t, int32:bits) never fails {
    int64:bytes = (bits => int64) / 8i64;
    pass (raw tt_intern(t, raw TY_TFP(), bits, 1i32, 0i32, bytes,
                        raw int_align(bits), 0i32));
};

// `fd`, `pid`, `tid`, `uid`, `gid` — five DISTINCT types that all lower to `i32`
// (D-042). They compare and they do not add, and this is the layer that has to
// hold that line because nothing downstream will: to LLVM they are identical.
pub func:KERNEL_FD = int32() never fails  { pass 0i32; };
pub func:KERNEL_PID = int32() never fails { pass 1i32; };
pub func:KERNEL_TID = int32() never fails { pass 2i32; };
pub func:KERNEL_UID = int32() never fails { pass 3i32; };
pub func:KERNEL_GID = int32() never fails { pass 4i32; };

pub func:tt_kernel = int32(TypeTable->:t, int32:which) never fails {
    pass (raw tt_intern(t, raw TY_KERNEL(), which, 0i32, 0i32, 4i64, 4i32, 0i32));
};

// --- composites ------------------------------------------------------------------------

// A pointer is THIN: one word, no bounds metadata (D-038). That is why a slice
// exists as a separate type rather than a pointer knowing its length.
// `arena<T>` (D-017, D-152): the single-threaded arena VALUE — five words,
// { slab ptr, gens ptr, cap i64, top i64, free_head i64 }. It moves, it is
// never copied implicitly (a copy would fork the freelist), and its slab is
// WILD-role heap: an un-destroyed arena is a countable leak (D-151).
pub func:tt_arena = int32(TypeTable->:t, int32:elem) never fails {
    int32:id = raw tt_intern(t, raw TY_ARENA(), elem, 0i32, 0i32, 40i64, 8i32, 0i32);
    drop tt_set_haspt(t, id, true);
    pass id;
};

// `shared_arena<T>` (D-017, D-154): the concurrent arena VALUE is one
// POINTER to a runtime-owned structure — shareable by reference is the
// contract, so the value is the reference. Chunked storage never moves;
// slots are written once at `alloc(v)` and immutable after, which is what
// makes concurrent `get` race-free with no per-slot synchronization.
// `atomic<T>` IS ITS ELEMENT'S STORAGE, not a box around it: same size, same
// alignment, so an `atomic<int32>` field costs exactly what an `int32` field
// costs and `atomic_from_ptr` can alias existing memory (D-033/D-182). What
// differs is the OPERATIONS — every access names an ordering, and there is
// no plain read.
pub func:tt_atomic = int32(TypeTable->:t, int32:elem, int64:size,
                           int32:align) never fails {
    pass (raw tt_intern(t, raw TY_ATOMIC(), elem, 0i32, 0i32, size, align, 0i32));
};

// `simd<T, N>` (D-194): size = element × lanes; alignment = the next power
// of two at or above the size, capped at 64 — the shape LLVM lays vectors
// out in, stated here so the frontend's layout agrees with the backend's.
pub func:tt_simd = int32(TypeTable->:t, int32:elem, int32:lanes,
                         int64:elem_size) never fails {
    int64:sz = elem_size * (lanes => int64);
    int32:al = 1i32;
    while (((al => int64) < sz) && (al < 64i32)) { al = al * 2i32; }
    pass (raw tt_intern(t, raw TY_SIMD(), elem, lanes, 0i32, sz, al, 0i32));
};

// A channel handle is 8 bytes: a 32-bit index and a 32-bit generation, the
// same shape `Handle<T>` (D-152) uses and for the same reason — a stale one
// is a caught error rather than a dangling read.
pub func:tt_channel = int32(TypeTable->:t, int32:elem, int32:level,
                            int32:cap) never fails {
    pass (raw tt_intern(t, raw TY_CHANNEL(), elem, level, cap, 8i64, 8i32, 0i32));
};

// `Mutex<T, LEVEL>` (D-056, 1.1.11): one pointer to a heap cell the mutex
// owns — the lock word, the waiter list, and the element live behind it.
pub func:tt_mutex = int32(TypeTable->:t, int32:elem, int32:level) never fails {
    pass (raw tt_intern(t, raw TY_MUTEX(), elem, level, 0i32, 8i64, 8i32, 0i32));
};

// `Guard<T>` (D-056, 1.1.11): the acquisition's receipt. Holds the cell
// pointer; its generated DROP is the release, which is the entire reason
// the managed lowering had to precede this type.
pub func:tt_guard = int32(TypeTable->:t, int32:elem) never fails {
    pass (raw tt_intern(t, raw TY_GUARD(), elem, 0i32, 0i32, 8i64, 8i32, 0i32));
};

// `RwLock<T, LEVEL>` and its READ hold (D-056, 1.1.11b).
pub func:tt_rwlock = int32(TypeTable->:t, int32:elem, int32:level) never fails {
    pass (raw tt_intern(t, raw TY_RWLOCK(), elem, level, 0i32, 8i64, 8i32, 0i32));
};
pub func:tt_rguard = int32(TypeTable->:t, int32:elem) never fails {
    pass (raw tt_intern(t, raw TY_RGUARD(), elem, 0i32, 0i32, 8i64, 8i32, 0i32));
};
// `CondVar<LEVEL>` and `Barrier<N, LEVEL>` (D-056, 1.1.11b).
pub func:tt_condvar = int32(TypeTable->:t, int32:level) never fails {
    pass (raw tt_intern(t, raw TY_CONDVAR(), level, 0i32, 0i32, 8i64, 8i32, 0i32));
};
pub func:tt_barrier = int32(TypeTable->:t, int32:n, int32:level) never fails {
    pass (raw tt_intern(t, raw TY_BARRIER(), n, level, 0i32, 8i64, 8i32, 0i32));
};

pub func:tt_shared_arena = int32(TypeTable->:t, int32:elem) never fails {
    int32:id = raw tt_intern(t, raw TY_SHARED_ARENA(), elem, 0i32, 0i32, 8i64, 8i32, 0i32);
    drop tt_set_haspt(t, id, true);
    pass id;
};

// `Handle<T>` (MEMORY_REFERENCE 4.1): { i64 index, i32 generation }, 16 bytes
// with tail padding. An INDEX, not a pointer — which is exactly why it does
// not set haspt: handles cross scopes, live in struct fields, and express
// cycles freely, and that is the design.
pub func:tt_handle = int32(TypeTable->:t, int32:elem) never fails {
    pass (raw tt_intern(t, raw TY_HANDLE(), elem, 0i32, 0i32, 16i64, 8i32, 0i32));
};

pub func:tt_pointer = int32(TypeTable->:t, int32:pointee) never fails {
    pass (raw tt_intern(t, raw TY_POINTER(), pointee, 0i32, 0i32, 8i64, 8i32, 0i32));
};

// `{ptr, i64 len}` (D-070). Non-owning, and a second-class view.
pub func:tt_slice = int32(TypeTable->:t, int32:elem) never fails {
    pass (raw tt_intern(t, raw TY_SLICE(), elem, 0i32, 0i32, 16i64, 8i32, 0i32));
};

// A VALUE type with static bounds, which does not decay. Its size is the
// element's times the count — which is exactly why a struct containing one of
// itself cannot be sized, and why 0.3.3 treats a fixed array as containment and a
// slice as not.
pub func:tt_array = int32(TypeTable->:t, int32:elem, int32:count,
                          int64:elem_size, int32:elem_align) never fails {
    int64:total = elem_size * (count => int64);
    pass (raw tt_intern(t, raw TY_ARRAY(), elem, count, 0i32, total, elem_align, 0i32));
};

// `lo..hi` IS A TYPED VALUE (D-093), not the type of its endpoints.
//
// A range is consumed by `for` and by `pick` patterns and by nothing else, so it
// would have been tempting to give the expression its element type and let those
// two check the node kind. That would make `int32:x = 1i32..5i32;` typecheck,
// silently, as `int32`. Giving the range a type of its own means the mismatch is
// reported where it happens and names what it found.
pub func:tt_range = int32(TypeTable->:t, int32:elem, int64:elem_size,
                          int32:elem_align) never fails {
    // `{T lo, T hi}` — two fields, through the same accumulator as every other
    // aggregate. The answer is `2 * size` for any `T`, which is exactly why it
    // was written that way and exactly why it is not written that way now: a
    // formula that happens to agree is still a second place the rule lives.
    Lay:l = raw lay_start();
    discard(raw lay_field(@l, elem_size, elem_align));
    discard(raw lay_field(@l, elem_size, elem_align));
    drop lay_end(@l);
    pass (raw tt_intern(t, raw TY_RANGE(), elem, 0i32, 0i32, l.size, l.align, 0i32));
};

// `{i8 has_value, T value}` — the TAG FIRST (TYPE_REFERENCE §11.1). An `i8`
// rather than an `i1` because a bit is not addressable, and the three bytes of
// padding after it are the machine's, not a rule this restates.
pub func:tt_optional = int32(TypeTable->:t, int32:inner, int64:inner_size,
                             int32:inner_align) never fails {
    Lay:l = raw lay_start();
    discard(raw lay_field(@l, 1i64, 1i32));
    discard(raw lay_field(@l, inner_size, inner_align));
    drop lay_end(@l);
    pass (raw tt_intern(t, raw TY_OPTIONAL(), inner, 0i32, 0i32, l.size, l.align, 0i32));
};

// `{T, tbb32}` (D-069) — NO is_error field, because `.is_error` is derived as
// `error != 0`. A stored flag would be a second place for one fact to live, and
// the two could then disagree about whether a call failed.
//
// `Result<NIL>` is `{i32}`: NIL is zero-sized (D-084).
pub func:tt_result = int32(TypeTable->:t, int32:inner, int64:inner_size,
                           int32:inner_align) never fails {
    // THE ERROR FIELD IS SECOND, so the padding falls on both sides of it: before,
    // when `T` is not already a multiple of four, and after, when `T` is wider
    // than four. `size(T) + 4` had neither, and was right only for a `T` that
    // needed neither.
    Lay:l = raw lay_start();
    discard(raw lay_field(@l, inner_size, inner_align));
    discard(raw lay_field(@l, 4i64, 4i32));
    drop lay_end(@l);
    pass (raw tt_intern(t, raw TY_RESULT(), inner, 0i32, 0i32, l.size, l.align, 0i32));
};

// A named aggregate. Its identity is its DECLARATION (D-090): two structs with
// identical fields and different names are different types, and interning on the
// DeclId is what makes that true by construction rather than by a comparison
// somebody has to remember to write.
pub func:tt_struct = int32(TypeTable->:t, int32:decl, int32:name,
                           int64:size, int32:align) never fails {
    pass (raw tt_intern(t, raw TY_STRUCT(), decl, 0i32, 0i32, size, align, name));
};

pub func:tt_enum = int32(TypeTable->:t, int32:decl, int32:name,
                         int64:size, int32:align) never fails {
    pass (raw tt_intern(t, raw TY_ENUM(), decl, 0i32, 0i32, size, align, name));
};

// AN INSTANTIATION'S IDENTITY IS ITS DECLARATION AND ITS ARGUMENTS (D-064 §6).
//
// `tt_intern` compares every slot, and an argument WINDOW cannot be compared that
// way. Two spellings of `Container<int32>` commit two windows at two different
// starts, so comparing the START would make them two types — and `type_eq` is
// an integer compare everywhere else in this compiler, so the two would
// silently fail to be the same type in every comparison downstream. The
// window's CONTENTS are compared instead: each argument is itself an interned
// id, so element-wise equality is canonical.
//
// UNTIL 1.0.7 THE NAME WAS THE IDENTITY, on the claim that the mangled name is
// a total function of the declaration and the arguments. It is not: a generic
// PARAMETER renders by its name, and two declarations may each call theirs
// `T`. `func:first<T> = T(List<T>:l)` and `func:second<T> = T(List<T>:l)` both
// spelled `List<T>`, so the second's was the FIRST's instance, whose argument
// window held the first's parameter — and `l.items[0]` in the second reported
// "expected `T`, found `T`". Found at 1.0.7 writing the first generic
// collection; every earlier program had one generic function per generic
// struct, or different parameter names.
//
// The name stays what it was for: DISPLAY and D-156's symbols, readable and
// reversible with NO HASH — `Container<int32>` maps back to its declaration by
// inspection, which is what an auditor reading a verification report has to
// do. A concrete instantiation's name is still unique; only a template-shaped
// one can share its name with another, and those are never emitted.
pub func:tt_instance = int32(TypeTable->:t, Ast->:ast, int32:kind, int32:decl,
                             int32:name, int32:arg_start, int32:arg_count,
                             int64:size, int32:align) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        Type:e = t.items[i => int64];
        if (e.kind == kind) {
            if (e.a == decl) {
                if (e.c == arg_count) {
                    bool:same = true;
                    int32:k = 0i32;
                    while (k < arg_count) {
                        if ((raw ast_id_at(ast, e.b, k))
                                != (raw ast_id_at(ast, arg_start, k))) {
                            same = false;
                            k = arg_count;
                        } else {
                            k = k + 1i32;
                        }
                    }
                    if (same) { pass i; }
                }
            }
        }
        i = i + 1i32;
    }
    pass (raw tt_intern(t, kind, decl, arg_start, arg_count, size, align, name));
};

pub func:tt_trait = int32(TypeTable->:t, int32:decl, int32:name) never fails {
    // A trait is not a value type; it has no size of its own.
    pass (raw tt_intern(t, raw TY_TRAIT(), decl, 0i32, 0i32, 0i64, 0i32, name));
};

// `dyn A & B` — the data word and ONE VTABLE WORD PER TRAIT (D-159), so
// (N+1) x 8. This was a flat 16 bytes whatever the bound count, which is right
// for `dyn A` and wrong for every wider one: `dyn A & B & C` needs four words
// and was told it had two, so the last two vtable pointers had nowhere to live.
// The bound window arrives CANONICALLY ORDERED (`dyn_sort_bounds`), which is
// what makes each word's slot a compile-time constant.
//
// A `dyn`'s IDENTITY IS ITS BOUND SET, NOT ITS WINDOW (1.0.7). `tt_intern`
// compares slots, and the window START is a slot — so two spellings of
// `dyn Speaks` committed two windows and were two types, each with its own
// layout entry. Nothing compared two `dyn` ids directly while names masked it:
// `fits` reaches `dyn_accepts` for dyn-to-dyn, and an instance `Pair<dyn S>`
// deduped by its mangled NAME. When instance identity became its arguments
// (`tt_instance`), `Pair<dyn Speaks>` interned once per spelling and `llc`
// refused the redefinition — the same defect one table away. The contents
// are compared, as for an instance; the bounds arrive canonically ordered
// (`dyn_sort_bounds`), so element-wise equality is set equality.
//
// AND IT CARRIES ITS SPELLING AS ITS NAME (1.0.7) — `dyn Speaks & Walks`, the
// bounds' own names in canonical order — so `type_display` renders it and an
// instance over it mangles reversibly: `Pair<dyn Speaks>` was `Pair<<type>>`,
// one symbol for every `Pair<dyn …>` a program could write. Trait names are
// program-unique (the loader refuses two modules exporting one name,
// NITPICK-RESOLVE-008), so the spelling identifies the set.
pub func:tt_dyn = int32(TypeTable->:t, Ast->:ast, InternTable->:interns,
                        int32:start, int32:count) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        Type:e = t.items[i => int64];
        if (e.kind == (raw TY_DYN())) {
            if (e.b == count) {
                bool:same = true;
                int32:k = 0i32;
                while (k < count) {
                    if ((raw ast_id_at(ast, e.a, k))
                            != (raw ast_id_at(ast, start, k))) {
                        same = false;
                        k = count;
                    } else {
                        k = k + 1i32;
                    }
                }
                if (same) { pass i; }
            }
        }
        i = i + 1i32;
    }
    int32:words = count + 1i32;
    if (count < 1i32) { words = 2i32; }
    int64:size = (words => int64) * 8i64;
    string:spelled = "dyn ";
    int32:j = 0i32;
    while (j < count) {
        if (j > 0i32) { spelled = raw string_concat(spelled, " & "); }
        int32:tn = raw type_name(t, raw ast_id_at(ast, start, j));
        if (raw intern_is_none(tn)) {
            spelled = raw string_concat(spelled, "<trait>");
        } else {
            spelled = raw string_concat(spelled, raw intern_get(interns, tn));
        }
        j = j + 1i32;
    }
    pass (raw tt_intern(t, raw TY_DYN(), start, count, 0i32, size, 8i32,
                        raw intern_add(interns, move(spelled))));
};

// `func RetType(ParamTypes)` (D-087). One word: a code address, with no captured
// environment, because closures are removed (D-018).
// THE `never_fails` BIT RIDES THE `name` SLOT (D-163). A func type has no name,
// so the slot is free, and `tt_intern` keys identity on it — so a `never fails`
// function type and an otherwise-identical may-fail one intern as DISTINCT types,
// which is exactly what `fits` and the D-156 mangle need, with no new `Type` slot.
pub func:tt_func = int32(TypeTable->:t, int32:ret, int32:start, int32:count,
                         bool:never_fails) never fails {
    int32:nf = 0i32;
    if (never_fails) { nf = 1i32; }
    pass (raw tt_intern(t, raw TY_FUNC(), ret, start, count, 8i64, 8i32, nf));
};

// `func RetType(ParamTypes, ..*T[])`. Same shape, different kind, and the last
// entry of the window is the `T[]` the variadic parameter is bound to.
pub func:tt_func_variadic = int32(TypeTable->:t, int32:ret, int32:start,
                                  int32:count, bool:never_fails) never fails {
    int32:nf = 0i32;
    if (never_fails) { nf = 1i32; }
    pass (raw tt_intern(t, raw TY_FUNC_VARIADIC(), ret, start, count, 8i64, 8i32, nf));
};

// The never-fails bit of a function type (D-163), read from the `name` slot.
// `false` for anything that is not a function type — the slot is a name there,
// and the callers guard on `type_is_func` first.
pub func:func_never_fails = bool(TypeTable->:t, int32:id) never fails {
    Type:e = raw tt_get(t, id);
    pass (e.name != 0i32);
};

// IS THIS CALLABLE AT ALL? Two kinds now, and every place that asked
// `k == TY_FUNC()` has to ask this instead or it will report a perfectly good
// variadic function as not being a function.
pub func:type_is_func = bool(TypeTable->:t, int32:id) never fails {
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_FUNC()))          { pass true; }
    pass (k == (raw TY_FUNC_VARIADIC()));
};

pub func:type_is_variadic = bool(TypeTable->:t, int32:id) never fails {
    pass ((raw type_kind(t, id)) == (raw TY_FUNC_VARIADIC()));
};

// `Self` INSIDE A TRAIT BODY, where the implementing type is not yet known.
//
// A trait's methods are written against a type that does not exist until an impl
// names one, so `Self` there is a placeholder rather than a type — and it has to
// BE something, because a trait's declared signature is what an impl's is compared
// against (D-103). Inside an `impl` body `Self` is the target type itself and this
// never appears; the two are told apart by what the resolver was given, not by a
// rule the reader has to remember.
pub func:tt_self = int32(TypeTable->:t) never fails {
    pass (raw tt_intern(t, raw TY_SELF(), 0i32, 0i32, 0i32, 0i64, 1i32, 0i32));
};

// `Iterator`'s `Item` — the DECLARING TRAIT and the NAME, interned as a pair.
// Not the name alone: two traits each declaring `Item` declare two types, and
// merging them would let an impl of one satisfy the other.
pub func:tt_assoc = int32(TypeTable->:t, int32:base, int32:trait_decl,
                          int32:name) never fails {
    pass (raw tt_intern(t, raw TY_ASSOC(), base, trait_decl, name, 0i64, 1i32,
                        0i32));
};

pub func:type_assoc_base = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).a);
};

// Is this a generic parameter? Asked by the emitter, which must substitute one
// before it can name the impl a call through a bound reaches.
pub func:type_is_param_kind = bool(TypeTable->:t, int32:id) never fails {
    pass ((raw type_kind(t, id)) == (raw TY_PARAM()));
};

pub func:type_assoc_trait = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b);
};

pub func:type_assoc_name = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).c);
};

// A comptime value argument. Zero-sized like `NIL`, because it is not a value the
// program stores anywhere — it is a compile-time argument, and it is gone by the
// time anything has a layout.
pub func:tt_comptime = int32(TypeTable->:t, int32:value_type, int32:rendering) never fails {
    pass (raw tt_intern(t, raw TY_COMPTIME(), value_type, 0i32, 0i32,
                        0i64, 1i32, rendering));
};

pub func:tt_param = int32(TypeTable->:t, int32:decl, int32:name) never fails {
    // A generic parameter has no layout: its size is not known at the definition,
    // which is the point of checking the body there (D-064).
    pass (raw tt_intern(t, raw TY_PARAM(), decl, 0i32, 0i32, 0i64, 0i32, name));
};

// --- startup ------------------------------------------------------------------------------

pub func:typetable_init = TypeTable() never fails {
    int64:n = 64i64;
    wild int8->:mem = alloc(n * #size_of<Type>());
    wild int8->:hmem = calloc(n, 4i64);
    TypeTable:t = TypeTable{
        items: mem =>! wild Type->, count: 0i32, cap: 64i32,
        t_nil: 0i32, t_bool: 0i32, t_string: 0i32,
        t_cstring: 0i32, t_any: 0i32, t_tbb32: 0i32, t_error: 0i32,
        haspt: hmem =>! wild int32->,
        drops: (calloc(n, 4i64)) =>! wild int32->,
        haschan: (calloc(n, 4i64)) =>! wild int32->,
        hasborrow: (calloc(n, 4i64)) =>! wild int32->
    };

    // Index 0 is the INVALID type, reserved like every other index-0 in this
    // compiler: a type that failed to resolve is a value rather than an absence,
    // so one bad annotation produces one diagnostic instead of a cascade of
    // "cannot compare" from everything that touched it.
    discard(raw tt_intern(@t, raw TY_INVALID(), 0i32, 0i32, 0i32, 0i64, 0i32, 0i32));

    // NIL is ZERO-SIZED (D-084). It is the absence of a value, not a value that
    // happens to be empty, and giving it a byte would put it in structs.
    t.t_nil = raw tt_intern(@t, raw TY_NIL(), 0i32, 0i32, 0i32, 0i64, 1i32, 0i32);

    // `bool` is `i1` STORED AS `i8` — one byte, and not an integer. `i1` appears
    // only inside a condition.
    t.t_bool = raw tt_intern(@t, raw TY_BOOL(), 0i32, 0i32, 0i32, 1i64, 1i32, 0i32);

    // `{ptr, len, cap}` and NOT NUL-terminated, which is the entire reason
    // `cstring` exists as a separate type (D-049).
    t.t_string = raw tt_intern(@t, raw TY_STRING(), 0i32, 0i32, 0i32, 24i64, 8i32, 0i32);
    t.t_cstring = raw tt_intern(@t, raw TY_CSTRING(), 0i32, 0i32, 0i32, 16i64, 8i32, 0i32);

    // `any` is the type-erased pointer. It has a layout because `any->` needs one;
    // a BARE `any` is a type error, and 0.4.1 is where that is said.
    t.t_any = raw tt_intern(@t, raw TY_ANY(), 0i32, 0i32, 0i32, 8i64, 8i32, 0i32);

    t.t_tbb32 = raw tt_tbb(@t, 32i32);

    // `Error` (D-179): four bytes that are NOT a number — the `bool`/`char`
    // doctrine applied to failure identity. No arithmetic, no ordering, no
    // casts; equality and `pick`; values only by naming a declared constant.
    t.t_error = raw tt_intern(@t, raw TY_ERROR(), 0i32, 0i32, 0i32, 4i64, 4i32, 0i32);
    pass t;
};

// --- what was instantiated, and where ----------------------------------------------------

// EVERY INSTANTIATION THE RESOLVER BUILDS, WITH THE SPAN IT WAS FIRST WRITTEN AT.
//
// BOUND SATISFACTION CANNOT BE DECIDED WHERE THE INSTANTIATION IS BUILT.
// `resolve_type` runs during collection — `collect_impls` resolves an impl's
// target, `collect_bounds` resolves a bound — and at that point the impl table is
// still being filled. "Does `Point` implement `Printable`" would answer `false`
// for an impl recorded on the very next line, so checking there would report a
// correct program as wrong. That is the one failure worse than a missing check.
//
// So the resolver RECORDS and a later pass DECIDES. There is no mode and no flag
// anywhere in this: resolution always records, the check always runs after
// collection, and neither behaves differently depending on when it was called.
//
// ONE RECORD PER DISTINCT INSTANTIATION, keyed by the interned type. Two sites
// writing `Container<Point>` are the same instantiation with the same arguments,
// so a bound violation is ONE mistake — reported once, at the first site, which
// is a real place in the source rather than a summary. Reporting it at every site
// would be N copies of one sentence.
pub struct:Instance = {
    int32:type_id;
    Span:at;
};

pub struct:InstanceTable = {
    wild Instance->:items;
    int32:count;
    int32:cap;
};

pub func:insttable_init = InstanceTable() never fails {
    int64:n = 16i64;
    wild int8->:mem = alloc(n * #size_of<Instance>());
    InstanceTable:t = InstanceTable{ items: mem =>! wild Instance->,
                                     count: 0i32, cap: 16i32 };
    pass t;
};

func:inst_grow = NIL(InstanceTable->:t) never fails {
    int32:nc = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items =>! wild int8->,
                                (nc => int64) * #size_of<Instance>());
    t.items = bigger =>! wild Instance->;
    t.cap = nc;
    pass NIL;
};

pub func:inst_count = int32(InstanceTable->:t) never fails { pass t.count; };

pub func:inst_at = Instance(InstanceTable->:t, int32:i) never fails {
    if (i < 0i32) { !!! BoundsIndex; }
    if (i >= t.count) { !!! BoundsIndex; }
    pass (t.items[i => int64]);
};

// --- generic FUNCTION instantiations (1.0.2b) -------------------------------
//
// A generic TYPE's instantiations are the interned type table itself: an
// instance IS a type, so interning dedups it (D-108) and the emitter walks the
// table. A generic FUNCTION's are not — a call's substituted signature is a
// `TY_FUNC`, which says nothing about WHICH function it came from, and the
// argument window that produced it lives in the frontend's scratch. Nothing the
// backend can see records "`extract` was called at `int32`", and for an INFERRED
// call (`extract(c)`, the common form) the turbofish is not in the AST either.
//
// So the frontend records the requests, here, where it has already solved them.
// One entry per (declaration, argument window), deduped by comparing the
// arguments — which is D-108's rule applied to functions: the mangled name is a
// total function of the declaration and the arguments, so equal arguments are
// the same instantiation.
pub struct:FnInstance = {
    int32:decl;         // the generic function's DeclId index
    int32:args_start;   // window of concrete type ids
    int32:args_count;

    // WHICH PARAMETERS THESE ARGUMENTS BIND (1.0.4b). For a generic function
    // they are its own declaration's, and the emitter could read them from the
    // declaration — but a FAMILY IMPL's method is generic in its IMPL's
    // parameters, which the method's own declaration does not carry and the
    // emitter cannot reach (there is no decl->owner link). The checker knows
    // both, so it records the window rather than making the emitter re-derive
    // something it has no path to.
    int32:params_start;
    int32:params_count;

    // THE IMPL THIS METHOD BELONGS TO, or 0 (1.0.4b). A family impl's method
    // needs `Self` bound to the impl's target while it is emitted — the same
    // binding `emit_impl_block` makes — and the emitter has no decl->owner
    // link to find the impl with. The checker knows it, so it says so.
    int32:owner_impl;

    int32:type_id;      // the substituted TY_FUNC
    Span:at;
};

pub struct:FnInstTable = {
    wild FnInstance->:items;
    int32:count;
    int32:cap;
};

pub func:fninst_init = FnInstTable() never fails {
    int64:n = 16i64;
    wild int8->:mem = alloc(n * #size_of<FnInstance>());
    FnInstTable:t = FnInstTable{ items: mem =>! wild FnInstance->,
                                 count: 0i32, cap: 16i32 };
    pass t;
};

func:fninst_grow = NIL(FnInstTable->:t) never fails {
    int32:nc = t.cap * 2i32;
    wild int8->:bigger = ralloc(t.items =>! wild int8->,
                                (nc => int64) * #size_of<FnInstance>());
    t.items = bigger =>! wild FnInstance->;
    t.cap = nc;
    pass NIL;
};

pub func:fninst_count = int32(FnInstTable->:t) never fails { pass t.count; };

pub func:fninst_at = FnInstance(FnInstTable->:t, int32:i) never fails {
    if (i < 0i32) { !!! BoundsIndex; }
    if (i >= t.count) { !!! BoundsIndex; }
    pass (t.items[i => int64]);
};

// Record one generic-function instantiation, deduped by (decl, arguments).
// Comparing the ARGUMENTS rather than the substituted type is deliberate: two
// calls to different generics can substitute to the same `TY_FUNC` (both
// `int32(int32)`), and they are two functions to emit, not one.
pub func:fninst_record = NIL(FnInstTable->:t, Ast->:ast, int32:decl,
                             int32:args_start, int32:args_count,
                             int32:params_start, int32:params_count,
                             int32:owner_impl, int32:type_id, Span:at) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        FnInstance:e = t.items[i => int64];
        if (e.decl == decl) {
            if (e.args_count == args_count) {
                bool:same = true;
                int32:k = 0i32;
                while (k < args_count) {
                    if ((raw ast_id_at(ast, e.args_start, k))
                            != (raw ast_id_at(ast, args_start, k))) {
                        same = false;
                        k = args_count;
                    } else {
                        k = k + 1i32;
                    }
                }
                if (same) { pass NIL; }
            }
        }
        i = i + 1i32;
    }
    if (t.count >= t.cap) { drop fninst_grow(t); }
    FnInstance:n = FnInstance{ decl: decl, args_start: args_start,
                               args_count: args_count,
                               params_start: params_start,
                               params_count: params_count,
                               owner_impl: owner_impl,
                               type_id: type_id, at: at };
    t.items[t.count => int64] = n;
    t.count = t.count + 1i32;
    pass NIL;
};

pub func:inst_record = NIL(InstanceTable->:t, int32:type_id, Span:at) never fails {
    int32:i = 0i32;
    while (i < t.count) {
        if ((t.items[i => int64]).type_id == type_id) { pass NIL; }
        i = i + 1i32;
    }
    if (t.count >= t.cap) { drop inst_grow(t); }
    Instance:e = Instance{ type_id: type_id, at: at };
    t.items[t.count => int64] = e;
    t.count = t.count + 1i32;
    pass NIL;
};

// --- questions the checker asks constantly ----------------------------------------------------

pub func:type_kind = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).kind);
};

// DOES THIS TYPE CARRY A BORROW-LIKE POINTER (D-183, 1.2.5b) — an address
// whose target the value does NOT own? A `string` and a `dyn`'s fat pointer
// own their bodies and transfer whole under `move`; a `T->`, a slice, and
// anything holding one names storage that stays behind — which is exactly
// what may not cross a task boundary. Channel elements ask this question:
// owning types ride (their bodies transfer with them), borrows do not.
// A `dyn` is refused here anyway: its CONCRETE content is erased, so whether
// a borrow hides behind it is unknowable — fail closed.
pub func:type_contains_borrow = bool(TypeTable->:t, int32:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass true; }
    if (id <= 0i32) { pass false; }
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_POINTER())) { pass true; }
    if (k == (raw TY_SLICE()))   { pass true; }
    if (k == (raw TY_DYN()))     { pass true; }
    if (k == (raw TY_CSTRING())) { pass true; }
    if (k == (raw TY_ANY()))     { pass true; }
    // A GUARD borrows its mutex's cell — it may not outrun the mutex, and a
    // task boundary is exactly where it would. A MUTEX owns its cell like a
    // string owns its body: it transfers whole.
    if (k == (raw TY_GUARD()))   { pass true; }
    if (k == (raw TY_RGUARD()))  { pass true; }
    // An OwnedFd — and so every stream holding one — is SCOPE-BOUND (D-185,
    // IO_REFERENCE §6): the scope that owns it closes it, so it may not ride
    // a channel or cross a spawn any more than a Guard may. Same wall, same
    // reasoning: the boundary is where the closing scope would be outrun.
    if (k == (raw TY_OWNEDFD())) { pass true; }
    if (k == (raw TY_STRING()))  { pass false; }
    if (k == (raw TY_MUTEX()))   { pass false; }
    if (k == (raw TY_RWLOCK()))  { pass false; }
    if (k == (raw TY_CONDVAR())) { pass false; }
    if (k == (raw TY_BARRIER())) { pass false; }
    if (k == (raw TY_ARRAY()))   {
        pass (raw type_contains_borrow(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_OPTIONAL())) {
        pass (raw type_contains_borrow(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_RESULT()))  {
        pass (raw type_contains_borrow(t, raw type_elem(t, id), fuel - 1i32));
    }
    // Structs and enums answer from layout's walk, like `tt_drops`.
    if (k == (raw TY_STRUCT()))  { pass ((raw tt_hasborrow(t, id)) == 2i32); }
    if (k == (raw TY_ENUM()))    { pass ((raw tt_hasborrow(t, id)) == 2i32); }
    pass false;
};

// DOES THIS TYPE CARRY A CHANNEL HANDLE anywhere a value copy would carry it
// (D-183, 1.2.5)? The reclaim machinery asks it of RETURN types: a function
// whose return carries a channel is a FACTORY — its creations are handed to
// the caller by type, so the creation site registers no reclaim. Pointees are
// NOT contained: a pointer in the value does not put the handle in the copy.
pub func:type_contains_channel = bool(TypeTable->:t, int32:id, int32:fuel) never fails {
    if (fuel <= 0i32) { pass true; }
    if (id <= 0i32) { pass false; }
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_CHANNEL()))  { pass true; }
    if (k == (raw TY_ARRAY()))    {
        pass (raw type_contains_channel(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_OPTIONAL())) {
        pass (raw type_contains_channel(t, raw type_elem(t, id), fuel - 1i32));
    }
    if (k == (raw TY_RESULT()))   {
        pass (raw type_contains_channel(t, raw type_elem(t, id), fuel - 1i32));
    }
    // Structs and enums answer from layout's walk, like `tt_drops` — the
    // one pass that sees every field's resolved type recorded the bit.
    if (k == (raw TY_STRUCT()))   { pass ((raw tt_haschan(t, id)) == 2i32); }
    if (k == (raw TY_ENUM()))     { pass ((raw tt_haschan(t, id)) == 2i32); }
    pass false;
};

pub func:type_size = int64(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).size);
};

pub func:type_align = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).align);
};

// Equality IS an integer compare. Written as a function anyway, so that the one
// place it could ever stop being true has a name.
pub func:type_eq = bool(int32:a, int32:b) never fails {
    pass (a == b);
};

pub func:type_is_invalid = bool(TypeTable->:t, int32:id) never fails {
    pass ((raw type_kind(t, id)) == (raw TY_INVALID()));
};

// IS THIS A NUMBER? Deliberately narrow, and the narrowness is the point.
//
// `bool` is not: it is one byte and two values, and `true + 1i32` means nothing.
// `char8` is not: a character is not its code point (D-005).
// `tbb32` is not: it is an error-code type whose arithmetic drags in ERR,
//   stickiness and saturation (D-008), which belong to the type's own operations.
// `fd` and its family are not: an `fd` plus one is not an `fd` (D-042).
//
// Every one of those is representationally identical to an integer. This function
// is where the language wins over the machine.
pub func:type_is_numeric = bool(TypeTable->:t, int32:id) never fails {
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_INT()))   { pass true; }
    if (k == (raw TY_FLOAT())) { pass true; }
    pass false;
};

pub func:type_is_integer = bool(TypeTable->:t, int32:id) never fails {
    pass ((raw type_kind(t, id)) == (raw TY_INT()));
};

pub func:type_int_bits = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).a);
};

pub func:type_is_signed = bool(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b != 0i32);
};

// Types that COMPARE but do not compute: `tbb` error codes and the kernel
// identifiers. Grouped because the rule is the same and stating it twice would
// be two places to change it.
pub func:type_is_comparable_only = bool(TypeTable->:t, int32:id) never fails {
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_TBB()))    { pass true; }
    if (k == (raw TY_KERNEL())) { pass true; }
    pass false;
};

// DOES THIS TYPE HAVE AN ORDERING? Narrower than equality, and narrower than
// `type_is_comparable_only` — which answers a different question.
//
// `tbb` and the kernel identifiers compare for EQUALITY and nothing more. An
// error code is compared against a named constant; `err < ERR` is not a question.
// An `fd` is an opaque handle whose number is an allocation artifact, so `fd1 <
// fd2` invites code that reads meaning into the order the kernel handed them out
// — the same mistake as `fd + 1`, one operator over. Cast if the number is what
// is meant.
//
// A `char8` DOES order: code-point order is a real ordering, and `'a' <= c` is a
// question about letters rather than about numbers. Ordering is not arithmetic.
pub func:type_is_ordered = bool(TypeTable->:t, int32:id) never fails {
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_INT()))   { pass true; }
    if (k == (raw TY_FLOAT())) { pass true; }
    if (k == (raw TY_CHAR()))  { pass true; }
    // A `tfp` is a NUMBER and orders as one (D-195) — unlike `tbb`, whose
    // values are codes compared only for identity. An ERR operand at any
    // comparison still traps (D-008 §5); the ordering here is for values.
    if (k == (raw TY_TFP()))   { pass true; }
    pass false;
};

pub func:type_elem = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).a);
};

// A FUNCTION TYPE's parameter window — `b` is the start, `c` the count, and the
// window lives in the AST's id pool because that is where `resolve_func_type`
// built it. Named accessors so no call site reads `b` and `c` raw and has to
// remember which of the several window-shaped kinds it is looking at.
pub func:type_param_count_of = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).c);
};

// A `dyn A & B`'s TRAIT WINDOW. Slots `a` and `b` this time rather than `b` and
// `c`, which is exactly why these are named accessors — reading a `dyn` through
// `type_param_start_of` would return its count and slice the window by whatever
// followed it.
pub func:type_dyn_start = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).a);
};
pub func:type_dyn_count = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b);
};

pub func:type_param_start_of = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b);
};

// A `Channel<T, LEVEL, CAP>`'s two CONSTANTS (D-072/D-182). `type_elem` is the
// element; the level rides `b` and the capacity `c`. Named for the same reason
// the windows above are: read raw, `.c` is a capacity here, a parameter count
// on a function type, and an argument count on an instance — three questions
// that look identical at the call site.
pub func:type_chan_level = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b);
};
pub func:type_chan_cap = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).c);
};

// AN INSTANTIATION'S ARGUMENT WINDOW. Slots `b` and `c` again, and reading one
// through `type_param_start_of` would return a struct's arguments as a function's
// parameters — which is the whole reason these are named accessors rather than a
// comment saying which slot to read. `type_elem` of a slice is what it holds;
// slot `b` of an instance is what it was instantiated with. Different questions,
// different names, one slot.
//
// ZERO COUNT FOR EVERYTHING ELSE, so a caller that reaches here with a plain
// `Point` gets an empty window rather than a window into somebody else's data.
// A FIXED ARRAY'S ELEMENT COUNT. Slot `b` on `TY_ARRAY`, and a third accessor
// over that slot -- a function's parameter start, an instance's argument start,
// and now a count. Each answers a different question, which is why each has a
// name rather than a comment saying which kind to read it as.
pub func:type_array_count = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b);
};

pub func:type_args_start_of = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).b);
};
pub func:type_args_count_of = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).c);
};

pub func:type_decl = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).a);
};

pub func:type_name = int32(TypeTable->:t, int32:id) never fails {
    pass ((raw tt_get(t, id)).name);
};

// THE DECLARATION A NAMED TYPE CAME FROM — a struct's, an enum's, a trait's, or a
// generic parameter's. Slot `a` again, and `type_elem` would return it perfectly
// well; the point of a second accessor over the same slot is that the two answer
// different questions. `type_elem` of a slice is what it holds; slot `a` of a
// trait is where it was written. Reading one through the other is how `expr_shape`
// and `stmt_cond` each cost a defect, so the name is the guard.
//
// ZERO FOR ANYTHING ELSE, so a caller that reaches here with an `int32` gets an
// answer it can test rather than an index into the declaration array.
pub func:type_decl_of = int32(TypeTable->:t, int32:id) never fails {
    int32:k = raw type_kind(t, id);
    if (k == (raw TY_STRUCT())) { pass ((raw tt_get(t, id)).a); }
    if (k == (raw TY_ENUM()))   { pass ((raw tt_get(t, id)).a); }
    if (k == (raw TY_TRAIT()))  { pass ((raw tt_get(t, id)).a); }
    if (k == (raw TY_PARAM()))  { pass ((raw tt_get(t, id)).a); }
    // AN ASSOC NAMES ITS DECLARING TRAIT (D-160). Answering 0 here would make
    // every "which declaration is this" question silently miss one, and 1.0.4c's
    // coherence check is one of them.
    if (k == (raw TY_ASSOC()))  { pass ((raw tt_get(t, id)).b); }
    pass 0i32;
};
