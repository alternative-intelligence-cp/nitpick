// A builtin type name that takes GENERIC ARGUMENTS.
//
// `TY_INVALID` means the name is a real constructor whose kind
// arrives at a later rung -- `Handle`, `arena`, `simd`, `atomic`.
// `builtin_is_generic` tells that apart from a name that is not a
// builtin at all, so the resolver can name the rung instead of
// claiming the type does not exist (D-085).
pub func:builtin_generic_kind = int32(TokenKind:k) {
    if (k == TokenKind.KwOptional) { pass (raw TY_OPTIONAL()); }
    if (k == TokenKind.KwResult) { pass (raw TY_RESULT()); }
    pass 0i32;
};

pub func:builtin_is_generic = bool(TokenKind:k) {
    if (k == TokenKind.KwFuture) { pass true; }
    if (k == TokenKind.KwHandle) { pass true; }
    if (k == TokenKind.KwOptional) { pass true; }
    if (k == TokenKind.KwResult) { pass true; }
    if (k == TokenKind.KwArena) { pass true; }
    if (k == TokenKind.KwArray) { pass true; }
    if (k == TokenKind.KwAtomic) { pass true; }
    if (k == TokenKind.KwBuffer) { pass true; }
    if (k == TokenKind.KwComplex) { pass true; }
    if (k == TokenKind.KwDyn) { pass true; }
    if (k == TokenKind.KwFunc) { pass true; }
    if (k == TokenKind.KwMatrix) { pass true; }
    if (k == TokenKind.KwShared_arena) { pass true; }
    if (k == TokenKind.KwSimd) { pass true; }
    if (k == TokenKind.KwTensor) { pass true; }
    if (k == TokenKind.KwTmatrix) { pass true; }
    if (k == TokenKind.KwTtensor) { pass true; }
    if (k == TokenKind.KwVec2) { pass true; }
    if (k == TokenKind.KwVec3) { pass true; }
    if (k == TokenKind.KwVec9) { pass true; }
    pass false;
};
