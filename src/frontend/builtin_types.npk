    if (k == TokenKind.KwInt32) { pass (raw bt_spec(true, raw TY_INT(), 32i32, true, 0i32)); }
    if (k == TokenKind.KwInt64) { pass (raw bt_spec(true, raw TY_INT(), 64i32, true, 0i32)); }
    if (k == TokenKind.KwInt128) { pass (raw bt_spec(true, raw TY_INT(), 128i32, true, 0i32)); }
    if (k == TokenKind.KwInt256) { pass (raw bt_spec(true, raw TY_INT(), 256i32, true, 0i32)); }
    if (k == TokenKind.KwInt512) { pass (raw bt_spec(true, raw TY_INT(), 512i32, true, 0i32)); }
