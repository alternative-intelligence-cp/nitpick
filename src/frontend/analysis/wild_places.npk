// WILD PROVENANCE, THE ONE READING (D-223; 1.6.1d step 3).
//
// Written in subset 1 (meta/SUBSET_1.md §4).
//
// QUALIFIERS ARE NOT PART OF THE TYPE (`parse_type.npk`'s second header fact):
// `wild int32->` and `int32->` are one type id, so whether a place or a value
// is MANUAL storage is read off declarations and producers, never off a type.
// The escape analysis asked this question first, for D-223's rule that a
// borrow never enters a `wild` slot (BORROW-011); the emitter asks the same
// question at 1.6.1d step 3, in the other direction: a store through a
// pointer drops the old pointee ONLY when the pointer names managed storage
// (DEF-120), because the manual regime's storage holds no value until the
// author writes one, and the closed direction for a wrong free is no free.
// SINCE LANDING 177d1 THE EMITTER'S STORE ASKS ITS OWN WALK, `store_place_manual`
// below (DEF-483): this predicate's answers are the typer's to lean on (TYPE-104,
// TYPE-032), and a checked cast's target or a by-value binding must not move a drop.
//
// WILD PROVENANCE IS A WHITELIST, not a borrow blacklist: `=>! wild …->`, a
// read of a `QUAL_WILD` place, a builtin whose signature hands back wild
// storage, a user function or method declaring a wild return, or `NULL`. Everything else
// — a plain pointer parameter, a plain-slot read, a call this walk cannot see
// through — is provenance-UNKNOWN and answers `false`. For the escape analysis
// `false` refuses (fail closed). A plain `T->` names a LIVE managed value by the
// language's contract, and a `wild` block laundered into a plain pointer by
// `=>! T->` is the author's assertion of exactly that.
mod:wild_places;

use "../ast_kind.npk".*;
use "../ast.npk".*;
use "../intern.npk".*;
use "../symbols.npk".*;
use "../parse_expr.npk".*;
use "../parse_stmt.npk".*;
use "../parse_decl.npk".*;
use "../parser.npk".*;      // QUAL_WILD / QUAL_WILDX (D-223)
use "../builtins.npk".*;    // builtin_returns_wild (D-223)
use "../types.npk".*;
use "../expr_types.npk".*;

// Does this EXPRESSION's value come from manual storage?
pub func:expr_wild_provenance = bool(Ast->:ast, SymbolTable->:tab, InternTable->:interns,
                                     ExprTypes->:etypes, TypeTable->:types,
                                     ExprId:id, int32:d) never fails {
    if (raw expr_is_none(id)) { pass true; }        // nothing stored
    if (d <= 0i32) { pass false; }
    ExprNode:n = raw ast_expr(ast, id);

    // `v =>! wild T->` — the explicit surrender of tracking (D-019).
    if (n.kind == ExprKind.ExprUncheckedCastExpr) {
        if (((raw expr_cast_quals(n)) & (raw QUAL_WILD())) != 0i32) { pass true; }
        if (((raw expr_cast_quals(n)) & (raw QUAL_WILDX())) != 0i32) { pass true; }
        pass false;
    }
    // A METHOD'S DECLARED `wild` RETURN COUNTS AS AN IDENTIFIER'S DOES (DEF-477, R9): `int64->:p = raw h.getw();` had no `=>!` on the page.
    if (n.kind == ExprKind.ExprMethodCallExpr) { pass (raw door_call_wild(ast, tab, interns, etypes, types, id, n)); }
    // NULL is no address at all, so it cannot be a frame address (D-006).
    if (n.kind == ExprKind.ExprSentinelLiteral) { pass true; }
    // A builtin that HANDS BACK wild storage is the origin of every legitimate
    // wild pointer: `alloc`, `ralloc`, `aalloc`, the wildx family. Read off the
    // one signature table (D-201) rather than a name list here.
    if (n.kind == ExprKind.ExprCallExpr) {
        ExprId:cal = raw expr_callee(n);
        if (!(raw expr_is_none(cal))) {
            ExprNode:cn = raw ast_expr(ast, cal);
            if (cn.kind == ExprKind.ExprIdentifierExpr) {
                // A BARE BUILTIN: the generated signature table carries the
                // qualifier in its return text.
                if (cn.a == 0i32) {
                    if (raw builtin_returns_wild(raw intern_get(interns,
                            cn.payload =>! int32))) { pass true; }
                }
                // A USER FUNCTION DECLARING A WILD RETURN. `func:grow =
                // wild int32->(…)` states its result is unmanaged storage as
                // plainly as a builtin's signature does — D-002's own example
                // is `func:malloc = wild any->(int64:size)`, and the language
                // has recorded it since 0.4 as `DECL_RET_WILD` on the
                // declaration, because qualifiers are not part of the type.
                // Restricting wild provenance to BUILTINS would refuse every
                // allocator written in Nitpick and push an `=>!` onto each of
                // its call sites, which is how an opt-out becomes a habit.
                if (cn.a != 0i32) {
                    Symbol:cs = raw symtab_get(tab, cn.a);
                    if (cs.origin_kind == (raw SYM_DECL())) {
                        DeclNode:cd = raw ast_decl(ast, DeclId{ index: cs.origin });
                        if (cd.kind == DeclKind.DeclFunctionDecl) {
                            if (raw decl_has(cd, raw DECL_RET_WILD())) { pass true; }
                            if (raw decl_has(cd, raw DECL_RET_WILDX())) { pass true; }
                        }
                    }
                }
            }
        }
        pass false;
    }
    // THE SIGIL FORM `#name<T>(…)` IS A BUILTIN TOO. `ExprBuiltinExpr` is a
    // separate node kind from `ExprCallExpr`, and a whitelist that checked
    // only the latter refused every `#ptr_add<T>(p, i)` in the tree —
    // pointer arithmetic on wild storage, which is the one thing the manual
    // regime is FOR.
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        pass (raw builtin_returns_wild(raw intern_get(interns, n.payload =>! int32)));
    }
    // A READ OF A WILD PLACE keeps its provenance: `fe.dframes` is wild
    // storage, and moving it to another wild slot moves wild storage.
    if (n.kind == ExprKind.ExprIdentifierExpr)   { pass (raw place_wild(ast, tab, etypes, types, id)); }
    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        // THE COMPILER-KNOWN HEADER'S `ptr` IS THE ALLOCATOR'S BLOCK POINTER (D-355, 1.6.1e landing
        // 119): a `string`'s, `cstring`'s, slice's or `buffer`'s `.ptr` is manual storage by the floor's
        // own representation -- null for an empty body (TYPE_REFERENCE §23: `buffer_new(n)` for
        // `n <= 0` is "null ptr, cap == 0") -- exactly what the prelude's `List` declares as
        // `hidden wild T->:items`. So `b.ptr != NULL` is a wild pointer's question and stands.
        int32:hb = raw exprtypes_get(etypes, raw expr_operand(n));
        if (hb != 0i32) {
            if ((raw type_kind(types, hb)) == (raw TY_POINTER())) { hb = raw type_elem(types, hb); }
            int32:hk = raw type_kind(types, hb);
            bool:header = (hk == (raw TY_STRING())) || (hk == (raw TY_CSTRING())) || (hk == (raw TY_SLICE())) || (hk == (raw TY_BUFFER()));
            if (header) {
                if (raw string_eq(raw intern_get(interns, n.payload =>! int32), "ptr")) { pass true; }
            }
        }
        pass (raw place_wild(ast, tab, etypes, types, id));
    }
    if (n.kind == ExprKind.ExprIndexExpr)        { pass (raw place_wild(ast, tab, etypes, types, id)); }
    // `move(p)`, `raw f()` and `relay f()` pass the operand's provenance through unchanged.
    if (n.kind == ExprKind.ExprMoveExpr) {
        pass (raw expr_wild_provenance(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if (n.kind == ExprKind.ExprRawUnwrapExpr) {
        pass (raw expr_wild_provenance(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if (n.kind == ExprKind.ExprRelayExpr) {
        pass (raw expr_wild_provenance(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    pass false;
};

// THE DOOR'S PROVENANCE (DEF-423, landing 177c; D-223 amended). What a `wild` slot takes with no cast, whatever the pointee, and
// what a plain pointer's index asks (DEF-425). `expr_wild_provenance` above keeps its answers for its own readers (TYPE-032,
// TYPE-097, `b.ptr != NULL`, TYPE-104's walk); this one differs in three ways. A header's `.ptr` is never
// wild here: the door's `door_header_admits` is that value's one road. The `mcpy` family's result is its destination's. An address
// counts only when it lands inside a wild pointee. Closed at the end.
pub func:door_wild = bool(Ast->:ast, SymbolTable->:tab, InternTable->:interns, ExprTypes->:etypes, TypeTable->:types,
                          ExprId:id, int32:d) decreases d never fails {
    if (raw expr_is_none(id)) { pass true; }
    if (d <= 0i32) { pass false; }
    ExprNode:n = raw ast_expr(ast, id);
    ExprKind:k = n.kind;
    if (k == ExprKind.ExprSentinelLiteral) { pass true; }
    if (k == ExprKind.ExprUncheckedCastExpr) { pass ((raw expr_cast_quals(n)) & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32; }
    if ((k == ExprKind.ExprCallExpr) || (k == ExprKind.ExprMethodCallExpr)) { pass (raw door_call_wild(ast, tab, interns, etypes, types, id, n)); }
    // A sigil's pointer operand was judged at its own slot, so its result answers yes and the mistake has one report (D-240);
    // `#wild_ptr` is the integer road, and `#wild_slice`, absent from the signature table's wild returns, is a view of what it was handed.
    if (k == ExprKind.ExprBuiltinExpr) {
        string:bn = raw intern_get(interns, raw builtin_name(n));
        pass (raw string_eq(bn, "wild_slice")) || (raw builtin_returns_wild(bn));
    }
    if (k == ExprKind.ExprIdentifierExpr) { pass (raw place_wild(ast, tab, etypes, types, id)); }
    // A range is a view of what it ranges over, so it lands as an address does: `arr[0...4]` over a frame's `wild` array is a frame address.
    if ((k == ExprKind.ExprIndexExpr) && ((raw ast_expr(ast, raw expr_rhs(n))).kind == ExprKind.ExprRangeExpr)) { pass (raw door_place_step(ast, tab, interns, etypes, types, id, d - 1i32)); }
    if (k == ExprKind.ExprIndexExpr) { pass (raw place_wild(ast, tab, etypes, types, id)); }
    if (k == ExprKind.ExprMemberAccessExpr) {
        if (raw header_ptr_read(ast, interns, etypes, types, id)) { pass false; }
        pass (raw place_wild(ast, tab, etypes, types, id));
    }
    if (k == ExprKind.ExprAddressOfExpr) { pass (raw door_place_step(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32)); }
    if ((k == ExprKind.ExprMoveExpr) || (k == ExprKind.ExprRawUnwrapExpr) || (k == ExprKind.ExprRelayExpr) || (k == ExprKind.ExprEmphaticUnwrapExpr)
        || (k == ExprKind.ExprEmphaticCoalesceExpr) || (k == ExprKind.ExprAwaitExpr)) {
        pass (raw door_wild(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if (k == ExprKind.ExprTernaryExpr) {
        pass (raw door_wild(ast, tab, interns, etypes, types, raw expr_rhs(n), d - 1i32)) && (raw door_wild(ast, tab, interns, etypes, types, raw expr_third(n), d - 1i32));
    }
    if ((k == ExprKind.ExprNullCoalesceExpr) || (k == ExprKind.ExprSafeUnwrapExpr)) {
        pass (raw door_wild(ast, tab, interns, etypes, types, raw expr_lhs(n), d - 1i32)) && (raw door_wild(ast, tab, interns, etypes, types, raw expr_rhs(n), d - 1i32));
    }
    pass false;
};

// A call's value: the declaration the call resolved to says, a method's as an identifier's; a function value says nothing and is closed.
func:door_call_wild = bool(Ast->:ast, SymbolTable->:tab, InternTable->:interns, ExprTypes->:etypes, TypeTable->:types,
                           ExprId:id, ExprNode:n) never fails {
    int32:cdecl = raw exprtypes_callee(etypes, id);
    if (n.kind == ExprKind.ExprCallExpr) {
        ExprId:cal = raw expr_callee(n);
        if (raw expr_is_none(cal)) { pass false; }
        ExprNode:cn = raw ast_expr(ast, cal);
        if (cn.kind == ExprKind.ExprIdentifierExpr) {
            if (cn.a == 0i32) {
                string:bn = raw intern_get(interns, cn.payload =>! int32);
                if (!(raw builtin_returns_wild(bn))) { pass false; }
                // THE `mcpy` FAMILY HANDS BACK ITS DESTINATION (rulings W2 (e)). A destination the door admitted as a header's
                // `.ptr` is no wild block; any other was judged at its own slot, so the mistake has one report (D-240).
                if ((raw string_eq(bn, "mcpy")) || (raw string_eq(bn, "mmov")) || (raw string_eq(bn, "memset"))) {
                    if ((raw expr_list_count(n)) < 1i32) { pass false; }
                    pass !(raw header_ptr_read(ast, interns, etypes, types, ExprId{ index: raw ast_id_at(ast, raw expr_list_start(n), 0i32) }));
                }
                pass true;
            }
            Symbol:cs = raw symtab_get(tab, cn.a);
            if (cs.origin_kind == (raw SYM_DECL())) { cdecl = cs.origin; }
        }
    }
    if (cdecl == 0i32) { pass false; }
    DeclNode:cd = raw ast_decl(ast, DeclId{ index: cdecl });
    if (cd.kind != DeclKind.DeclFunctionDecl) { pass false; }
    pass (raw decl_has(cd, raw DECL_RET_WILD())) || (raw decl_has(cd, raw DECL_RET_WILDX()));
};

// AN ADDRESS LANDS WHERE THE LAST DEREFERENCE ON ITS PATH LANDS (rulings W2 (d)): an index, a `<-` or an auto-dereferencing member
// whose base is a pointer or slice VALUE. Wild when that base is; a path with no such step is a frame address, a `wild` binding's
// own included (`@h.wf`, `@w`, `@arr[0]` over a frame's `wild T->[N]`).
pub func:door_place_step = bool(Ast->:ast, SymbolTable->:tab, InternTable->:interns, ExprTypes->:etypes, TypeTable->:types,
                            ExprId:id, int32:d) decreases d never fails {
    if (d <= 0i32) { pass false; }
    ExprNode:n = raw ast_expr(ast, id);
    ExprId:b = raw expr_operand(n);
    if (n.kind == ExprKind.ExprDerefExpr) { pass (raw door_wild(ast, tab, interns, etypes, types, b, d - 1i32)); }
    if (n.kind == ExprKind.ExprIndexExpr) { b = raw expr_lhs(n); }
    if ((n.kind != ExprKind.ExprIndexExpr) && (n.kind != ExprKind.ExprMemberAccessExpr)) { pass false; }
    int32:bk = raw type_kind(types, raw exprtypes_get(etypes, b));
    if ((bk == (raw TY_POINTER())) || ((bk == (raw TY_SLICE())) && (n.kind == ExprKind.ExprIndexExpr))) {
        pass (raw door_wild(ast, tab, interns, etypes, types, b, d - 1i32));
    }
    pass (raw door_place_step(ast, tab, interns, etypes, types, b, d - 1i32));
};

// A STORE'S TARGET: IS IT INSIDE MANUAL STORAGE? (DEF-483, RULED N, landing 177d1; `MANAGEMENT/briefs/def483-ruling-2026-11-02.md`.) A store to a place inside manual storage never
// drops the old value, the rule `(<-p) = v` already had: the storage holds no value until the author writes one, and the closed direction for a wrong free is no free. To replace a live
// owner the author says it's live, `(<-(w =>! S->)).f = v`, and that drops. Walk the target from the store outward. Inline steps inherit: a member of a by-value struct, an element of a
// fixed array, a payload, parentheses (no node). The first step that follows a reference decides: `<-e`, a member through a pointer, an index through a pointer or slice, by `e`'s value
// (`store_value_manual`). A `List`'s index ends the walk, not manual: its element is the `List`'s (R5). No reference step at all is not manual: a local, a by-value `wild` binding. NOT
// `expr_wild_provenance`: that reading relaxes TYPE-104 and TYPE-032, so a checked cast must not answer there (R7), and here it must. Fuel's end or an unread kind answers MANUAL, no drop,
// a leak at worst; no arm answers "not manual" by default. `wild_table.py` holds the list of kinds. THE FUEL IS ONE NO PARSED PROGRAM REACHES, so it can't lose a drop in silence: every call
// goes one level down a tree PARSE-012 holds to 256 levels, and a range's second question is one more at that node, 512 at most.
pub func:STORE_WALK_FUEL = int32() never fails { pass 1024i32; };
pub func:store_place_manual = bool(Ast->:ast, SymbolTable->:tab, InternTable->:interns, ExprTypes->:etypes, TypeTable->:types,
                                   ExprId:id, int32:d) decreases d never fails {
    if (d <= 0i32) { pass true; }
    if (raw expr_is_none(id)) { pass true; }
    ExprNode:n = raw ast_expr(ast, id);
    ExprKind:k = n.kind;
    if (k == ExprKind.ExprIdentifierExpr) { pass false; }
    if (k == ExprKind.ExprDerefExpr) { pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32)); }
    if ((k == ExprKind.ExprMemberAccessExpr) || (k == ExprKind.ExprSafeNavExpr)) {
        int32:bt = raw exprtypes_get(etypes, raw expr_operand(n));
        if (bt == 0i32) { pass true; }
        if ((raw type_kind(types, bt)) == (raw TY_OPTIONAL())) { bt = raw type_elem(types, bt); }
        if ((raw type_kind(types, bt)) == (raw TY_POINTER())) { pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32)); }
        pass (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if (k == ExprKind.ExprIndexExpr) {
        int32:ibk = raw type_kind(types, raw exprtypes_get(etypes, raw expr_lhs(n)));
        if ((ibk == (raw TY_POINTER())) || (ibk == (raw TY_SLICE()))) { pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_lhs(n), d - 1i32)); }
        if (ibk == (raw TY_ARRAY())) { pass (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_lhs(n), d - 1i32)); }
        if (ibk == (raw TY_STRUCT())) { pass false; }
        pass true;
    }
    if (k == ExprKind.ExprTernaryExpr) {
        pass (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_rhs(n), d - 1i32)) || (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_third(n), d - 1i32));
    }
    // A BY-VALUE TEMPORARY HAS NO REFERENCE STEP, so it isn't manual; `raw`, `move`, a cast and the unwraps ask what they hold, so `(move(<-w)).s` is `w`'s. The typer refuses each of these as a
    // store's target today (TYPE-024, cells `y3a` to `y3j`), so these arms are defensive: a rule that opens one mustn't lose its drop to the closed answer below.
    if ((k == ExprKind.ExprCallExpr) || (k == ExprKind.ExprMethodCallExpr) || (k == ExprKind.ExprBuiltinExpr) || (k == ExprKind.ExprStructLiteralExpr) || (k == ExprKind.ExprArrayLiteralExpr)
        || (k == ExprKind.ExprBinaryExpr) || (k == ExprKind.ExprUnaryExpr)) { pass false; }
    if ((k == ExprKind.ExprMoveExpr) || (k == ExprKind.ExprRawUnwrapExpr) || (k == ExprKind.ExprRelayExpr) || (k == ExprKind.ExprEmphaticUnwrapExpr) || (k == ExprKind.ExprEmphaticCoalesceExpr)
        || (k == ExprKind.ExprAwaitExpr) || (k == ExprKind.ExprCastExpr) || (k == ExprKind.ExprUncheckedCastExpr)) {
        pass (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if ((k == ExprKind.ExprNullCoalesceExpr) || (k == ExprKind.ExprSafeUnwrapExpr)) {
        pass (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_lhs(n), d - 1i32)) || (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_rhs(n), d - 1i32));
    }
    pass true;
};

// The value a reference step follows. A checked cast asks its operand, whatever its target says (R7); `=>! T->` asserts a live value and `=>! wild T->` says manual, over a plain pointer
// too; any arm of a ternary, `??` or `?|`; `<-(@x)` is the place `x`'s answer and `<-e` reads what `e` reaches; a field by its declaration; a call by its declared return. A range is a view
// of what it ranges over, so it asks as a place does (`w.a[0...2][0].s` is inside `w`). A slice `#wild_slice` made is manual, as its name says. Closed at the end, `pick` and `NULL` among it.
pub func:store_value_manual = bool(Ast->:ast, SymbolTable->:tab, InternTable->:interns, ExprTypes->:etypes, TypeTable->:types,
                                   ExprId:id, int32:d) decreases d never fails {
    if (d <= 0i32) { pass true; }
    if (raw expr_is_none(id)) { pass true; }
    ExprNode:n = raw ast_expr(ast, id);
    ExprKind:k = n.kind;
    if (k == ExprKind.ExprCastExpr) { pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32)); }
    if (k == ExprKind.ExprUncheckedCastExpr) { pass ((raw expr_cast_quals(n)) & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32; }
    if (k == ExprKind.ExprTernaryExpr) {
        pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_rhs(n), d - 1i32)) || (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_third(n), d - 1i32));
    }
    if ((k == ExprKind.ExprNullCoalesceExpr) || (k == ExprKind.ExprSafeUnwrapExpr)) {
        pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_lhs(n), d - 1i32)) || (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_rhs(n), d - 1i32));
    }
    if ((k == ExprKind.ExprMoveExpr) || (k == ExprKind.ExprRawUnwrapExpr) || (k == ExprKind.ExprRelayExpr) || (k == ExprKind.ExprEmphaticUnwrapExpr)
        || (k == ExprKind.ExprEmphaticCoalesceExpr) || (k == ExprKind.ExprAwaitExpr)) {
        pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if ((k == ExprKind.ExprAddressOfExpr) || (k == ExprKind.ExprBorrowExpr)) { pass (raw store_place_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32)); }
    if (k == ExprKind.ExprDerefExpr) {
        ExprNode:dn = raw ast_expr(ast, raw expr_operand(n));
        if ((dn.kind == ExprKind.ExprAddressOfExpr) || (dn.kind == ExprKind.ExprBorrowExpr)) { pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(dn), d - 1i32)); }
        pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32));
    }
    if (k == ExprKind.ExprIdentifierExpr) { pass (raw place_wild(ast, tab, etypes, types, id)); }
    if (k == ExprKind.ExprIndexExpr) {
        if ((raw ast_expr(ast, raw expr_rhs(n))).kind == ExprKind.ExprRangeExpr) { pass (raw store_place_manual(ast, tab, interns, etypes, types, id, d - 1i32)); }
        pass (raw place_wild(ast, tab, etypes, types, id));
    }
    if ((k == ExprKind.ExprMemberAccessExpr) || (k == ExprKind.ExprSafeNavExpr)) {
        if (raw header_ptr_read(ast, interns, etypes, types, id)) { pass true; }
        // A name before the dot with no type is a qualifier, unread; a `Result`'s `.value` has no field to declare anything, so its holder says (`wild Result<T->>:r`).
        int32:vb = raw exprtypes_get(etypes, raw expr_operand(n));
        if (vb == 0i32) { pass true; }
        if ((raw type_kind(types, vb)) == (raw TY_RESULT())) { pass (raw store_value_manual(ast, tab, interns, etypes, types, raw expr_operand(n), d - 1i32)); }
        pass (raw place_wild(ast, tab, etypes, types, id));
    }
    if ((k == ExprKind.ExprCallExpr) || (k == ExprKind.ExprMethodCallExpr)) { pass (raw expr_wild_provenance(ast, tab, interns, etypes, types, id, d)); }
    if (k == ExprKind.ExprBuiltinExpr) {
        string:bn = raw intern_get(interns, raw builtin_name(n));
        pass (raw string_eq(bn, "wild_slice")) || (raw builtin_returns_wild(bn));
    }
    // A number is no reference (TYPE-008 refuses its pointer arithmetic, so neither can be a store's base: `y4a`, `y4b`).
    if ((k == ExprKind.ExprBinaryExpr) || (k == ExprKind.ExprUnaryExpr)) { pass false; }
    pass true;
};

// `x.ptr`, the compiler-known header's block pointer, `x` a `string`, `cstring`, slice or `buffer` or a pointer to one, `wild` or not. THE ONE PREDICATE of I2 and I3 (DEF-425):
// `x.ptr[i]` over it is the header's own checked read, what `x[i]` does, a write form or an address through it is TYPE-106, and I3 gives the value itself five uses (`type_of_expr`).
pub func:header_ptr_read = bool(Ast->:ast, InternTable->:interns, ExprTypes->:etypes, TypeTable->:types, ExprId:id) never fails {
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = raw ast_expr(ast, id);
    if (n.kind != ExprKind.ExprMemberAccessExpr) { pass false; }
    if (!(raw string_eq(raw intern_get(interns, n.payload =>! int32), "ptr"))) { pass false; }
    pass (raw header_kind_of(types, raw exprtypes_get(etypes, raw expr_operand(n)))) != 0i32;
};

// The header kind of a base's type, through one pointer, or 0.
pub func:header_kind_of = int32(TypeTable->:types, int32:t0) never fails {
    int32:t = t0;
    if (t == 0i32) { pass 0i32; }
    if ((raw type_kind(types, t)) == (raw TY_POINTER())) { t = raw type_elem(types, t); }
    int32:k = raw type_kind(types, t);
    if ((k == (raw TY_STRING())) || (k == (raw TY_CSTRING())) || (k == (raw TY_SLICE())) || (k == (raw TY_BUFFER()))) { pass k; }
    pass 0i32;
};

// Is this PLACE a `wild`-qualified slot? A local's qualifier rides its
// declaration, a parameter's its parameter, a field's the field decl — the
// three spellings a store site can see. An element is its array's, its slice's or its pointer's; a `List`'s,
// or any other indexable struct's, is a plain slot of its own, whatever the struct's binding says (R5 of 177c's
// second rulings: `wild List<int64->>:wl = move(l); dalloc(wl[0i64]);` freed a frame address).
pub func:place_wild = bool(Ast->:ast, SymbolTable->:tab, ExprTypes->:etypes,
                           TypeTable->:types, ExprId:id) never fails {
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = raw ast_expr(ast, id);
    if (n.kind == ExprKind.ExprIndexExpr) {
        int32:ibk = raw type_kind(types, raw exprtypes_get(etypes, raw expr_lhs(n)));
        if ((ibk != (raw TY_ARRAY())) && (ibk != (raw TY_SLICE())) && (ibk != (raw TY_POINTER()))) { pass false; }
        pass (raw place_wild(ast, tab, etypes, types, raw expr_lhs(n)));
    }
    if (n.kind == ExprKind.ExprIdentifierExpr) {
        if (n.a == 0i32) { pass false; }
        Symbol:sy = raw symtab_get(tab, n.a);
        if (sy.origin_kind == (raw SYM_STMT())) {
            StmtNode:ds = raw ast_stmt(ast, StmtId{ index: sy.origin });
            if (ds.kind != StmtKind.StmtVarDeclStmt) { pass false; }
            pass (((raw stmt_quals(ast, ds)) & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32);
        }
        // A `wild`-QUALIFIED PARAMETER IS A WILD PLACE TOO. Found by the D-223
        // audit itself, in `llctx_set_impls(LlCtx->:c, wild ImplTable->:t, …)`
        // storing `t` into a wild field: wild provenance arrives through a
        // parameter as readily as through a local, and reading only the
        // declaring STATEMENT missed every one of them.
        if (sy.origin_kind == (raw SYM_DECL())) {
            DeclNode:pd = raw ast_decl(ast, DeclId{ index: sy.origin });
            if (pd.kind == DeclKind.DeclParamDecl) {
                pass (((raw param_quals(pd)) & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32);
            }
            // A `wild` MODULE BINDING IS A WILD PLACE TOO (D-355, 1.6.1e landing 119): `fixed wild
            // int64->:P = NULL;` is the module-level spelling that keeps `NULL`, and a comparison
            // against `P` reads its regime here. Found by the landing's own probe: the initialiser
            // was admitted by the declaration's qualifier and `P != NULL` refused by this walk.
            if (pd.kind == DeclKind.DeclGlobalDecl) {
                pass (((raw global_quals(pd)) & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32);
            }
        }
        pass false;
    }
    if ((n.kind == ExprKind.ExprMemberAccessExpr) || (n.kind == ExprKind.ExprSafeNavExpr)) {
        int32:base = raw exprtypes_get(etypes, raw expr_operand(n));
        if (base == 0i32) { pass false; }
        if ((raw type_kind(types, base)) == (raw TY_OPTIONAL())) { base = raw type_elem(types, base); }
        if ((raw type_kind(types, base)) == (raw TY_POINTER())) {
            base = raw type_elem(types, base);
        }
        if ((raw type_kind(types, base)) != (raw TY_STRUCT())) { pass false; }
        pass (raw field_named_wild(ast, types, base, n.payload =>! int32));
    }
    pass false;
};

// Is the named field of this struct type `wild`-qualified? The literal's
// window carries field NAMES as intern indices, so the lookup is by name
// rather than through a place expression.
pub func:field_named_wild = bool(Ast->:ast, TypeTable->:types, int32:sty,
                                 int32:fname) never fails {
    if (sty == 0i32) { pass false; }
    if ((raw type_kind(types, sty)) != (raw TY_STRUCT())) { pass false; }
    DeclId:did = DeclId{ index: raw type_decl(types, sty) };
    DeclNode:sd = raw ast_decl(ast, did);
    int32:i = 0i32;
    int32:nmembers = raw item_member_count(ast, sd);
    while (i < nmembers) decreases nmembers - i {
        DeclNode:m = raw ast_decl(ast, raw item_member(ast, sd, i));
        if (m.kind == DeclKind.DeclFieldDecl) {
            if ((raw decl_name(m)) == fname) {
                pass (((raw field_quals(m)) & ((raw QUAL_WILD()) | (raw QUAL_WILDX()))) != 0i32);
            }
        }
        i = i + 1i32;
    }
    pass false;
};
