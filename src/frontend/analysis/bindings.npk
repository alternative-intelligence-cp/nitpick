// Binding validity: assigned before read, written once if `fixed`, and not used
// after it has been moved or freed (D-010, D-065).
//
// Subset 1 (meta/SUBSET_1.md). Cycles 0.5.2 and 0.5.3.
//
// FOUR QUESTIONS, ONE WALK. Whether a binding has been assigned, whether it has
// been assigned twice, whether it has been moved out of, and whether it has been
// freed are all the same shape: per-binding state, threaded through the same
// statements, merged at the same branches. Two walks would be two sets of merge
// points that have to agree about what an `if` does, and this compiler has paid
// for that shape enough times.
//
// THE FOUR SETS DO NOT MERGE THE SAME WAY, and that asymmetry is the single
// easiest thing here to get backwards — so all four are written side by side in
// `state_merge` where they can be read against each other.
//
// NITPICK HAS NO IMPLICIT DEFAULT VALUE, and D-010 chose that deliberately over
// the alternative of poisoning every scalar with `ERR`. The argument is worth
// keeping in front of whoever reads this: a default makes an uninitialised read
// DEFINED, whereas this analysis makes it IMPOSSIBLE. One costs an O(n) pass over
// memory for every array Nikola allocates; the other costs nothing at runtime and
// is strictly stronger.
//
// So this file is what that decision rests on. If it is wrong, `int32:x;` followed
// by a read of `x` compiles into a load of whatever the stack happened to hold.
//
// THE MERGE IS THE WHOLE CONTENT. Straight-line definite assignment is a loop over
// statements and is not where analyses go wrong; a branch is. Assigned on one arm
// of an `if` and not the other is NOT assigned, a `while` body may run zero times,
// and a binding assigned only after an early `pass` is not assigned on the path
// that took it.
//
// TWO SETS, NOT ONE, and they merge in opposite directions:
//
//   MUST — assigned on EVERY path that reaches here. Intersected at a merge.
//          A read needs this.
//   MAY  — assigned on AT LEAST ONE path. Unioned at a merge.
//          A second assignment to a `fixed` binding is refused on this.
//
// One set cannot answer both. `if (c) { x = 1i32; }` leaves `x` readable-nowhere
// and assignable-never-again, and a single set has to pick which of those two
// questions it gets right.
//
// WHY THIS NEEDS NO FIXPOINT, where the borrow marking did (D-116). That analysis
// is a MAY analysis with a union merge, and it was written with no merge at all —
// so a binding marked late in a loop body was missed by a use earlier in it. This
// one treats a loop body as running ZERO times for the purposes of what follows,
// which is both the correct answer and a fixed point on the first pass: a read
// inside the body is checked against the state at the top of the body, which is
// exactly the state the first iteration sees.

use "../source_location.npk".*;
use "../ast_kind.npk".*;
use "../ast.npk".*;
use "../intern.npk".*;
use "../diagnostics.npk".*;
use "../symbols.npk".*;
use "../token_kind.npk".*;
use "../parse_expr.npk".*;
use "../parse_stmt.npk".*;
use "../parse_pick.npk".*;
use "../parse_decl.npk".*;
use "../types.npk".*;
use "../expr_types.npk".*;
use "../resolve_type.npk".*;   // `fold_const` — one evaluator, one idea of constant
use "../type_codes.npk".*;
use "analysis_codes.npk".*;
use "exhaust.npk".*;

pub func:ASSIGN_DEPTH = int32() { pass 256i32; };

// THE STATE AT A POINT IN THE PROGRAM. Indexed by the index of the statement that
// DECLARED the binding, which is what `Symbol.origin` holds for a local.
//
// TWO ARRAYS BEHIND ONE HANDLE, and the handle is copied freely while the arrays
// are not. Every fork takes an explicit `state_copy`; anything that forgets one is
// two branches writing to the same arrays, which reads as a merge that never
// happened.
pub struct:AssignState = {
    wild bool->:must;
    wild bool->:may;

    // MOVED AND FREED — the two ways a binding stops being valid without being
    // unassigned (D-065). A moved-from binding is INVALID, not "valid but
    // unspecified": there is no such thing in this language as a value you may
    // hold and not inspect.
    //
    // A FREE IS A MOVE INTO THE ALLOCATOR, which is why it is the same machinery
    // and not a second analysis. `dalloc(p)` transfers ownership of the allocation
    // out of `p` exactly as `move(p)` transfers it to another binding, and D-065
    // says outright that `move` is "the mechanism that prevents double-free on
    // `wild` allocations". Use-after-free and double-free then fall out of
    // use-after-move with no new state at all.
    //
    // TWO SETS RATHER THAN ONE WITH A REASON CODE, so the message can say which
    // happened without the merge having to decide which of two reasons wins when
    // two paths disagree.
    wild bool->:moved;
    wild bool->:freed;

    // HAS THIS `Result` BEEN CHECKED FOR AN ERROR? (D-007, `TYPE_REFERENCE` §27.)
    //
    // `Result.value` carries a compiler-assigned TAINT when the `Result` holds an
    // error — `unknown`, which is not a type anyone can write. Reading it without
    // checking `is_error` first is reading a value the compiler knows may be
    // meaningless, and D-007's own argument for trapping over tainting is that
    // "a tainted value that reaches an actuator command produces a WRONG ACTION,
    // which is worse than no action".
    //
    // IT INTERSECTS AT A MERGE, like `must` and unlike the other three. Checked on
    // one arm and not the other is NOT checked, because the read after the merge
    // happens on both paths.
    wild bool->:checked;
    int32:count;
};

pub struct:Assign = {
    Ast->:ast;
    SymbolTable->:tab;
    InternTable->:interns;

    // WHAT A `pick` COVERS is 0.5.4's question, and these are what it takes to
    // ask it. Carried here rather than re-derived, so that "is this `pick`
    // exhaustive" has one answer in this compiler and not two.
    TypeTable->:types;
    ExprTypes->:etypes;

    DiagList->:diags;

    // WHAT FOLDS IS ONE QUESTION WITH ONE ANSWER (0.6.4). "Is this `const`
    // initialiser constant" is the same question an array size asks, and it is
    // answered by the same evaluator rather than by a second idea of what a
    // constant is — which is how `is_error` and `error` came to disagree (D-069).
    TypeResolver->:tyres;

    // A LOOP BODY IS WALKED TWICE AND REPORTED ONCE — see `assign_loop_body`. The
    // first walk is silent, and this is what silences it.
    bool:quiet;
};

pub func:assign_init = Assign(Ast->:ast, SymbolTable->:tab,
                              InternTable->:interns, TypeTable->:types,
                              ExprTypes->:etypes, DiagList->:diags,
                              TypeResolver->:tyres) {
    Assign:x = Assign{ ast: ast, tab: tab, interns: interns, types: types,
                       etypes: etypes, diags: diags, tyres: tyres,
                       quiet: false };
    pass x;
};

pub func:state_new = AssignState(int32:n) {
    int64:size = n => int64;
    if (size < 1i64) { size = 1i64; }
    wild int8->:m1 = alloc(size * #size_of<bool>());
    wild int8->:m2 = alloc(size * #size_of<bool>());
    wild int8->:m3 = alloc(size * #size_of<bool>());
    wild int8->:m4 = alloc(size * #size_of<bool>());
    wild int8->:m5 = alloc(size * #size_of<bool>());
    AssignState:s = AssignState{ must: m1 => wild bool->,
                                 may: m2 => wild bool->,
                                 moved: m3 => wild bool->,
                                 freed: m4 => wild bool->,
                                 checked: m5 => wild bool->,
                                 count: size => int32 };
    int64:i = 0i64;
    while (i < size) {
        s.must[i] = false;
        s.may[i] = false;
        s.moved[i] = false;
        s.freed[i] = false;
        s.checked[i] = false;
        i = i + 1i64;
    }
    pass s;
};

func:state_copy = AssignState(AssignState:src) {
    AssignState:d = raw state_new(src.count);
    int64:i = 0i64;
    while (i < (src.count => int64)) {
        d.must[i] = src.must[i];
        d.may[i] = src.may[i];
        d.moved[i] = src.moved[i];
        d.freed[i] = src.freed[i];
        d.checked[i] = src.checked[i];
        i = i + 1i64;
    }
    pass d;
};

func:state_overwrite = NIL(AssignState:dst, AssignState:src) {
    int64:i = 0i64;
    while (i < (dst.count => int64)) {
        dst.must[i] = src.must[i];
        dst.may[i] = src.may[i];
        dst.moved[i] = src.moved[i];
        dst.freed[i] = src.freed[i];
        dst.checked[i] = src.checked[i];
        i = i + 1i64;
    }
    pass NIL;
};

// TWO BRANCHES REJOINING. `must` intersects and `may` unions, which is the whole
// of what "assigned on one arm and not the other is not assigned" means.
//
// AN ARM THAT EXITS CONTRIBUTES NOTHING. `if (c) { pass 0i32; } else { x = 1i32; }`
// reaches the merge only through the second arm, so intersecting with the first
// would forget that `x` was assigned. That is not a refinement — it is the
// difference between accepting correct code and refusing it.
func:state_merge = NIL(AssignState:dst, AssignState:a, bool:a_exits,
                       AssignState:b, bool:b_exits) {
    if (a_exits) {
        if (b_exits) {
            // Nothing reaches here at all. `dst` keeps the state from before the
            // branch, which is sound for the unreachable code that follows.
            pass NIL;
        }
        drop state_overwrite(dst, b);
        pass NIL;
    }
    if (b_exits) {
        drop state_overwrite(dst, a);
        pass NIL;
    }
    // THE FOUR DIRECTIONS, SIDE BY SIDE, because they are not all the same and the
    // asymmetry is the thing to get wrong.
    //
    //   must     INTERSECTS — assigned on one arm and not the other is NOT assigned.
    //   may      UNIONS     — assigned on either is possibly assigned.
    //   moved    UNIONS     — moved on one arm and not the other IS moved.
    //   freed    UNIONS     — likewise.
    //   checked  INTERSECTS — checked on one arm only is NOT checked.
    //
    // TWO INTERSECT AND THREE UNION, and the split is not arbitrary: `must` and
    // `checked` are the two that PERMIT something — a read, or a read of a tainted
    // value — and the other three FORBID something. A permission has to hold on
    // every path; a prohibition has to fire on any of them. Being wrong towards
    // `false` refuses correct code for the first pair and lets a defect through for
    // the second, so a shared helper taking one direction would be right about two
    // of the five and silently wrong about three.
    int64:i = 0i64;
    while (i < (dst.count => int64)) {
        dst.must[i] = a.must[i] && b.must[i];
        dst.may[i] = a.may[i] || b.may[i];
        dst.moved[i] = a.moved[i] || b.moved[i];
        dst.freed[i] = a.freed[i] || b.freed[i];
        dst.checked[i] = a.checked[i] && b.checked[i];
        i = i + 1i64;
    }
    pass NIL;
};

// A LOOP BODY MAY RUN ZERO TIMES, so nothing it assigns is assigned after it — but
// everything it assigns is still POSSIBLY assigned, which is what stops a `fixed`
// binding being written once per iteration.
func:state_absorb_may = NIL(AssignState:dst, AssignState:body) {
    int64:i = 0i64;
    while (i < (dst.count => int64)) {
        dst.may[i] = dst.may[i] || body.may[i];
        // A LOOP BODY THAT MOVES SOMETHING MOVES IT ON THE SECOND ITERATION TOO,
        // so what the body moved or freed survives the loop even though what it
        // ASSIGNED does not. The three that union survive; the one that intersects
        // does not.
        dst.moved[i] = dst.moved[i] || body.moved[i];
        dst.freed[i] = dst.freed[i] || body.freed[i];
        i = i + 1i64;
    }
    pass NIL;
};

// AN ASSIGNMENT MAKES A BINDING VALID AGAIN. D-065: a moved-from binding "may be
// reinitialized by assignment, after which it is live again" — so writing to one
// clears both invalidations rather than only recording a new write.
func:state_mark = NIL(AssignState:s, int32:slot) {
    if (slot < 0i32)        { pass NIL; }
    if (slot >= s.count)    { pass NIL; }
    s.must[slot => int64] = true;
    s.may[slot => int64] = true;
    s.moved[slot => int64] = false;
    s.freed[slot => int64] = false;
    // A NEW VALUE IS A NEW `Result`, and nothing has checked it. Clearing this on
    // assignment is what stops one check licensing every later read of the name.
    s.checked[slot => int64] = false;
    pass NIL;
};

func:state_mark_checked = NIL(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass NIL; }
    if (slot >= s.count) { pass NIL; }
    s.checked[slot => int64] = true;
    pass NIL;
};

func:state_checked = bool(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass false; }
    if (slot >= s.count) { pass false; }
    pass (s.checked[slot => int64]);
};

func:state_mark_moved = NIL(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass NIL; }
    if (slot >= s.count) { pass NIL; }
    s.moved[slot => int64] = true;
    pass NIL;
};

func:state_mark_freed = NIL(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass NIL; }
    if (slot >= s.count) { pass NIL; }
    s.freed[slot => int64] = true;
    pass NIL;
};

func:state_moved = bool(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass false; }
    if (slot >= s.count) { pass false; }
    pass (s.moved[slot => int64]);
};

func:state_freed = bool(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass false; }
    if (slot >= s.count) { pass false; }
    pass (s.freed[slot => int64]);
};

func:state_must = bool(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass false; }
    if (slot >= s.count) { pass false; }
    pass (s.must[slot => int64]);
};

func:state_may = bool(AssignState:s, int32:slot) {
    if (slot < 0i32)     { pass false; }
    if (slot >= s.count) { pass false; }
    pass (s.may[slot => int64]);
};

// The eight expression kinds that ARE a value, with nothing to evaluate. Listed
// rather than derived from `expr_shape`, because "has no child expressions" and
// "is a constant" are different questions that agree today — an identifier is a
// leaf and is not a constant.
func:expr_is_literal = bool(ExprKind:k) {
    if (k == ExprKind.ExprIntLiteral)         { pass true; }
    if (k == ExprKind.ExprFloatLiteral)       { pass true; }
    if (k == ExprKind.ExprCharLiteral)        { pass true; }
    if (k == ExprKind.ExprStringLiteral)      { pass true; }
    if (k == ExprKind.ExprRawStringLiteral)   { pass true; }
    if (k == ExprKind.ExprBlockStringLiteral) { pass true; }
    if (k == ExprKind.ExprBoolLiteral)        { pass true; }
    pass (k == ExprKind.ExprSentinelLiteral);
};

func:assign_err = NIL(Assign->:x, string:code, string:msg, Span:sp) {
    if (x.quiet) { pass NIL; }
    drop diaglist_push(x.diags, raw diag_error(code, msg, sp));
    pass NIL;
};

// --- declarations ------------------------------------------------------------
//
// The same walk `check_module` and `escape_module` make, and for the same reason:
// a function inside an `impl`, a trait's default body and a function inside a
// nested `mod` are all function bodies.

pub func:assign_module = NIL(Assign->:x, DeclId:mod_id, int32:scope) {
    DeclNode:m = relay ast_decl(x.ast, mod_id);
    int32:n = raw item_member_count(x.ast, m);
    int32:i = 0i32;
    while (i < n) {
        drop assign_decl(x, raw item_member(x.ast, m, i), scope);
        i = i + 1i32;
    }
    pass NIL;
};

func:assign_decl = NIL(Assign->:x, DeclId:id, int32:scope) {
    DeclNode:d = relay ast_decl(x.ast, id);

    if (d.kind == DeclKind.DeclFunctionDecl) {
        StmtId:body = raw fn_body(x.ast, d);
        if (raw stmt_is_none(body)) { pass NIL; }

        // A FRESH STATE PER FUNCTION, and nothing is assigned in it. Parameters
        // are assigned by the caller and are never `SYM_STMT`, so they are not in
        // this table at all — which is the right answer rather than a convenient
        // one: a parameter is assigned before the body starts, always.
        AssignState:st = raw state_new(raw ast_stmt_count(x.ast));
        drop assign_stmt(x, st, body, raw ASSIGN_DEPTH());
        pass NIL;
    }

    if (d.kind == DeclKind.DeclModuleDecl) {
        int32:inner = raw nested_module_scope(x.tab, d, scope);
        if (inner == 0i32) { pass NIL; }
        drop assign_module(x, id, inner);
        pass NIL;
    }

    // `const` AT MODULE SCOPE IS `fixed` WITH NOWHERE ELSE TO BE WRITTEN. A global
    // has no enclosing body, so its declaration is the only place an assignment
    // could appear — which makes the rule two halves rather than one: the
    // initialiser has to be there, and it has to be constant.
    if (d.kind == DeclKind.DeclGlobalDecl) {
        if (((raw global_quals(d)) & (raw QUAL_CONST())) == 0i32) { pass NIL; }

        ExprId:init = raw global_init(d);
        if (raw expr_is_none(init)) {
            // NOTHING CAN EVER WRITE IT. Reported at the declaration rather than
            // at every read, because there is one mistake here and it is not at
            // the reads.
            drop assign_err(x, raw ASSIGN_UNASSIGNED(),
                "a `const` global is assigned only by its initialiser, so one without an initialiser can never hold a value",
                d.span);
            pass NIL;
        }

        ExprNode:ie = relay ast_expr(x.ast, init);
        // THE SAME CODE AS AN ARRAY SIZE AND A `comptime` ARGUMENT, because it is
        // the same question — is this expression constant — and now the same
        // evaluator answers it. A reader filtering on this code is asking one thing.
        ConstVal:cv = relay fold_const(x.tyres, init, scope);
        if (!(raw cv_folded(cv))) {
            if (raw fold_gave_up(x.tyres)) { pass NIL; }
            drop assign_err(x, raw TYPE_NOT_CONSTANT(),
                "a `const` initialiser must be a constant expression; a name folds only if it is itself a `const` global",
                ie.span);
        }
        pass NIL;
    }

    if (d.kind == DeclKind.DeclImplDecl) {
        int32:mn = relay impl_member_count(x.ast, d);
        int32:j = 0i32;
        while (j < mn) {
            drop assign_decl(x, relay impl_member(x.ast, d, j), scope);
            j = j + 1i32;
        }
        pass NIL;
    }

    if (d.kind == DeclKind.DeclTraitDecl) {
        int32:tn = raw item_member_count(x.ast, d);
        int32:k = 0i32;
        while (k < tn) {
            drop assign_decl(x, raw item_member(x.ast, d, k), scope);
            k = k + 1i32;
        }
        pass NIL;
    }

    pass NIL;
};

// --- does this statement leave, rather than fall through? --------------------
//
// WRONG TOWARDS `false` COSTS PRECISION; WRONG TOWARDS `true` COSTS SOUNDNESS. A
// statement wrongly called an exit removes its arm from the merge, and whatever it
// failed to assign is then treated as assigned by the other arm alone. So the
// answer is `false` for everything not listed, and each `true` is one this walk
// has actually looked at.
func:stmt_exits = bool(Assign->:x, StmtId:id, int32:depth) {
    if (depth <= 0i32)         { pass false; }
    if (raw stmt_is_none(id))  { pass false; }
    StmtNode:s = relay ast_stmt(x.ast, id);

    if (s.kind == StmtKind.StmtPassStmt)     { pass true; }
    if (s.kind == StmtKind.StmtFailStmt)     { pass true; }
    if (s.kind == StmtKind.StmtReturnStmt)   { pass true; }
    if (s.kind == StmtKind.StmtExitStmt)     { pass true; }
    if (s.kind == StmtKind.StmtTrapStmt)     { pass true; }

    // `break` and `continue` do not leave the FUNCTION, and they do leave the
    // straight-line flow this is asked about — control does not reach the
    // statement after them, which is the only thing a merge cares about. What they
    // assigned still reaches the code after the LOOP, and that is carried by the
    // loop's `may` absorption rather than here.
    if (s.kind == StmtKind.StmtBreakStmt)    { pass true; }
    if (s.kind == StmtKind.StmtContinueStmt) { pass true; }
    if (s.kind == StmtKind.StmtFallStmt)     { pass true; }

    if (s.kind == StmtKind.StmtBlockStmt) {
        int32:n = raw stmt_list_count(s);
        int32:i = 0i32;
        while (i < n) {
            StmtId:sub = StmtId{ index: raw ast_id_at(x.ast, raw stmt_list_start(s), i) };
            if (relay stmt_exits(x, sub, depth - 1i32)) { pass true; }
            i = i + 1i32;
        }
        pass false;
    }

    // AN `if` LEAVES ONLY IF BOTH ARMS DO, and a missing `else` is an arm that
    // falls through — which is the case a reader is likeliest to get wrong.
    if (s.kind == StmtKind.StmtIfStmt) {
        StmtId:e = raw stmt_else(s);
        if (raw stmt_is_none(e)) { pass false; }
        if (!(relay stmt_exits(x, raw stmt_then(s), depth - 1i32))) { pass false; }
        pass (relay stmt_exits(x, e, depth - 1i32));
    }

    pass false;
};

// --- statements --------------------------------------------------------------

func:assign_stmt = NIL(Assign->:x, AssignState:st, StmtId:id, int32:depth) {
    if (raw stmt_is_none(id)) { pass NIL; }
    if (depth <= 0i32) {
        StmtNode:deep = relay ast_stmt(x.ast, id);
        drop assign_err(x, raw ASSIGN_TOO_DEEP(),
            "this statement nests deeper than the definite-assignment analysis will follow, so its bindings cannot be shown assigned before use",
            deep.span);
        pass NIL;
    }
    StmtNode:s = relay ast_stmt(x.ast, id);
    int32:d = depth - 1i32;

    // A DECLARATION. The initialiser is walked BEFORE the binding is marked, which
    // is the order the program has.
    //
    // Nothing here depends on that today: `int32:x = x + 1i32;` is refused one
    // stage earlier, by the RESOLVER, because the name is not in scope until the
    // declaration completes — and where an outer `x` exists the inner initialiser
    // binds to that one, so there is no self-reference to catch either way. The
    // order is kept because it is the order that is true, not because it is
    // currently load-bearing; a marking done first would be a statement about
    // program order that happens to be wrong.
    if (s.kind == StmtKind.StmtVarDeclStmt) {
        drop check_qualifiers(x, s);
        ExprId:init = relay stmt_decl_init(x.ast, s);
        if (raw expr_is_none(init)) { pass NIL; }
        drop assign_expr(x, st, init, d);
        drop state_mark(st, id.index);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtAssignStmt) {
        drop assign_assign(x, st, s, d);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtBlockStmt) {
        drop assign_stmt_window(x, st, raw stmt_list_start(s),
                                raw stmt_list_count(s), d);
        pass NIL;
    }

    // THE MERGE. Each arm gets its own copy of the state, and what rejoins is the
    // intersection of what they agree on.
    if (s.kind == StmtKind.StmtIfStmt) {
        drop assign_expr(x, st, raw stmt_cond(s), d);
        StmtId:then_id = raw stmt_then(s);
        StmtId:else_id = raw stmt_else(s);

        // THE CONDITION REFINES THE ARMS. `if (r.is_error) { … } else { HERE }`
        // proves, on the else path only, that `r.value` is safe to read — which is
        // the whole of how the taint is cleared. The early-exit form falls out of
        // this for free: a `then` arm that leaves contributes nothing to the merge,
        // so what survives is the else arm's state, checked and all.
        ErrTest:et = relay err_test_of(x, raw stmt_cond(s));

        AssignState:a = raw state_copy(st);
        if (et.found) {
            if (et.then_checked) { drop state_mark_checked(a, et.slot); }
        }
        drop assign_stmt(x, a, then_id, d);

        AssignState:b = raw state_copy(st);
        if (et.found) {
            if (!et.then_checked) { drop state_mark_checked(b, et.slot); }
        }
        drop assign_stmt(x, b, else_id, d);

        // NO `else` IS AN ARM THAT ASSIGNS NOTHING, not an arm that is absent. `b`
        // is the untouched copy, so the intersection below is exactly "assigned
        // before the `if` as well" — which is why a one-armed `if` cannot make
        // anything definitely assigned.
        drop state_merge(st, a, relay stmt_exits(x, then_id, raw ASSIGN_DEPTH()),
                         b, relay stmt_exits(x, else_id, raw ASSIGN_DEPTH()));
        pass NIL;
    }

    // A LOOP BODY MAY RUN ZERO TIMES. The body is analysed from the state at the
    // top of the loop — which is what the first iteration actually sees — and what
    // it assigns does not survive the loop.
    if (s.kind == StmtKind.StmtWhileStmt) {
        drop assign_expr(x, st, raw stmt_cond(s), d);
        drop assign_loop_body(x, st, relay stmt_body(x.ast, s), d);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtForStmt) {
        drop assign_expr(x, st, relay stmt_for_iter(x.ast, s), d);
        drop assign_loop_body(x, st, relay stmt_for_body(x.ast, s), d);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtLoopStmt) {
        drop assign_counted(x, st, s, d);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtTillStmt) {
        drop assign_counted(x, st, s, d);
        pass NIL;
    }

    // `when` IS A `while` THAT TRACKS HOW IT TERMINATED (D-027), so its body is a
    // loop body and its `then` / `end` blocks are two ways out. Which one runs is
    // not decided here, so NEITHER contributes to `must` — conservative, and
    // `when` is rare enough that buying precision here would be paying for
    // something nobody has asked for.
    if (s.kind == StmtKind.StmtWhenStmt) {
        drop assign_expr(x, st, raw stmt_cond(s), d);
        drop assign_loop_body(x, st, relay stmt_when_body(x.ast, s), d);
        drop assign_loop_body(x, st, relay stmt_when_then(x.ast, s), d);
        drop assign_loop_body(x, st, relay stmt_when_end(x.ast, s), d);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtPickStmt) {
        drop assign_pick(x, st, s, d);
        pass NIL;
    }

    // An arm reached on its own rather than through `assign_pick` — nothing else
    // constructs one, and walking it in isolation is the safe reading.
    if (s.kind == StmtKind.StmtPickArm) {
        drop assign_expr(x, st, raw arm_guard(s), d);
        drop assign_stmt(x, st, raw arm_body(s), d);
        pass NIL;
    }

    // A `defer` BODY RUNS AT SCOPE EXIT, and it is checked against the state HERE —
    // at the point it was registered. That is the rule 0.5.2 owes: a `defer` that
    // names a binding assigned later in the block would run before that assignment
    // on any path that leaves early, which is the same use-before-write the rest of
    // this file exists to refuse.
    //
    // Its assignments do not survive it, because the code after a `defer` runs
    // BEFORE the deferred body does.
    if (s.kind == StmtKind.StmtDeferStmt) {
        StmtId:body = StmtId{ index: s.a };
        AssignState:dv = raw state_copy(st);
        drop assign_stmt(x, dv, body, d);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtBreakStmt)    { pass NIL; }
    if (s.kind == StmtKind.StmtContinueStmt) { pass NIL; }
    if (s.kind == StmtKind.StmtFallStmt)     { pass NIL; }

    // `pass`, `fail`, `return`, `exit` and the six that carry one expression. Each
    // READS its operand, which is the whole of what this analysis owes them.
    if (s.kind == StmtKind.StmtPassStmt)   { drop assign_expr(x, st, raw stmt_operand(s), d); pass NIL; }
    if (s.kind == StmtKind.StmtFailStmt)   { drop assign_expr(x, st, raw stmt_operand(s), d); pass NIL; }
    if (s.kind == StmtKind.StmtReturnStmt) { drop assign_expr(x, st, raw stmt_operand(s), d); pass NIL; }
    if (s.kind == StmtKind.StmtExitStmt)   { drop assign_expr(x, st, raw stmt_expr(s), d); pass NIL; }

    if (raw stmt_carries_expr(s.kind)) {
        drop assign_expr(x, st, raw stmt_expr(s), d);
        pass NIL;
    }

    drop assign_err(x, raw ASSIGN_INTERNAL(),
        "this statement kind has no entry in the definite-assignment walk, so its contents cannot be checked",
        s.span);
    pass NIL;
};

func:assign_stmt_window = NIL(Assign->:x, AssignState:st, int32:start,
                              int32:count, int32:depth) {
    int32:i = 0i32;
    while (i < count) {
        StmtId:sid = StmtId{ index: raw ast_id_at(x.ast, start, i) };
        drop assign_stmt(x, st, sid, depth);
        i = i + 1i32;
    }
    pass NIL;
};

// A BODY THAT MAY NOT RUN, AND MAY RUN AGAIN. Analysed from the current state, and
// only its `may` survives — not enough to call anything definitely assigned
// afterwards, and enough to refuse a second write to a `fixed` binding.
//
// WALKED TWICE, REPORTED ONCE, and the first walk is what makes the second one
// see a second iteration:
//
//     fixed int32:k;
//     while (c) { k = 1i32; }        // written once per iteration, which is once
//                                    // too many
//
// On a single walk from the entry state, `k` is unassigned when `k = 1i32;` is
// reached and nothing fires. The silent pre-pass grows `may` to everything the
// body can assign; the real pass then sees `k` as possibly-already-assigned and
// refuses it. That is D-116 generalising exactly as the decision said it would —
// this is the third analysis in this cycle to need a body walked more than once,
// and the second to have shipped the bug first.
//
// ONE PRE-PASS IS ENOUGH, unlike the borrow marking's open-ended fixpoint. `may`
// is set by an assignment statement and by `$$m`, and neither chains: one walk
// visits every assignment in the body whatever its order or nesting, so the second
// walk starts from the answer.
func:assign_loop_body = NIL(Assign->:x, AssignState:st, StmtId:body, int32:depth) {
    if (raw stmt_is_none(body)) { pass NIL; }

    bool:saved = x.quiet;
    x.quiet = true;
    AssignState:pre = raw state_copy(st);
    drop assign_stmt(x, pre, body, depth);
    drop state_absorb_may(st, pre);
    x.quiet = saved;

    AssignState:inner = raw state_copy(st);
    drop assign_stmt(x, inner, body, depth);
    drop state_absorb_may(st, inner);
    pass NIL;
};

func:assign_counted = NIL(Assign->:x, AssignState:st, StmtNode:s, int32:depth) {
    int32:n = raw stmt_counted_argc(x.ast, s);
    int32:i = 0i32;
    while (i < n) {
        drop assign_expr(x, st, relay stmt_counted_arg(x.ast, s, i), depth);
        i = i + 1i32;
    }
    drop assign_loop_body(x, st, raw stmt_counted_body(s), depth);
    pass NIL;
};

func:state_intersect_must = NIL(AssignState:dst, AssignState:other) {
    int64:i = 0i64;
    while (i < (dst.count => int64)) {
        dst.must[i] = dst.must[i] && other.must[i];
        dst.moved[i] = dst.moved[i] || other.moved[i];
        dst.freed[i] = dst.freed[i] || other.freed[i];
        dst.checked[i] = dst.checked[i] && other.checked[i];
        i = i + 1i64;
    }
    pass NIL;
};

func:state_take_must = NIL(AssignState:dst, AssignState:src) {
    int64:i = 0i64;
    while (i < (dst.count => int64)) {
        dst.must[i] = src.must[i];
        i = i + 1i64;
    }
    pass NIL;
};

// A `pick`, WHICH IS AN N-WAY MERGE AND NOT A LOOP.
//
// "A binding assigned on every arm of an EXHAUSTIVE pick is assigned after it" is
// the rule, and the qualifier does all the work: a `pick` that might match nothing
// is a path on which no arm ran, and that path assigns nothing.
//
// EXHAUSTIVENESS IS 0.5.4's QUESTION, AND IT IS ASKED RATHER THAN RE-DERIVED.
//
// This used to recognise a wildcard arm and nothing else, because nothing could
// answer better yet — so a `pick` covering every variant of an enum
// under-approximated and refused correct code. 0.5.2 wrote that down as a debt
// owed to 0.5.4, and this is it being paid.
//
// `pick_covers_all` takes no `DiagList` and therefore cannot report. Two analyses
// looking at one `pick` must not both be able to speak about it, or the same
// construct produces two findings a reader cannot tell apart.
func:pick_is_total = bool(Assign->:x, ExprId:selector, int32:start, int32:count) {
    pass (relay pick_covers_all(x.ast, x.types, x.etypes, selector, start, count));
};

func:assign_pick = NIL(Assign->:x, AssignState:st, StmtNode:s, int32:depth) {
    drop assign_expr(x, st, raw pick_selector(s), depth);
    ErrTest:et = relay err_test_of(x, raw pick_selector(s));

    int32:start = raw pick_arm_start(s);
    int32:count = raw pick_arm_count(s);
    bool:total = relay pick_is_total(x, raw pick_selector(s), start, count);

    AssignState:acc = raw state_new(st.count);
    bool:seen = false;

    int32:i = 0i32;
    while (i < count) {
        StmtId:aid = relay pick_arm_at(x.ast, start, i);
        StmtNode:arm = relay ast_stmt(x.ast, aid);

        AssignState:one = raw state_copy(st);
        if (et.found) {
            // `pick (r.is_error) { (true) { … }, (false) { HERE } }` — the same
            // refinement an `if` gets, on the arm that matched the safe value.
            // Recognising only the `if` would push people toward the less
            // idiomatic form, which is the opposite of what an analysis should do.
            int32:want = 2i32;
            if (et.then_checked) { want = 1i32; }
            if ((relay arm_bool(x.ast, arm)) == want) {
                drop state_mark_checked(one, et.slot);
            }
        }
        drop assign_expr(x, one, raw arm_guard(arm), depth);
        drop assign_stmt(x, one, raw arm_body(arm), depth);
        drop state_absorb_may(st, one);

        if (!(relay stmt_exits(x, raw arm_body(arm), raw ASSIGN_DEPTH()))) {
            if (seen) {
                drop state_intersect_must(acc, one);
            } else {
                drop state_overwrite(acc, one);
                seen = true;
            }
        }
        i = i + 1i32;
    }

    // Only an exhaustive `pick` with at least one arm that falls through can make
    // anything definitely assigned. `may` was absorbed arm by arm above and is
    // kept whatever the answer here.
    if (total) {
        if (seen) {
            drop state_take_must(st, acc);
        }
    }
    pass NIL;
};

// --- assignment --------------------------------------------------------------

func:assign_assign = NIL(Assign->:x, AssignState:st, StmtNode:s, int32:depth) {
    ExprId:tgt = raw stmt_target(s);
    ExprId:val = raw stmt_assigned(s);

    // THE VALUE IS READ BEFORE THE TARGET IS WRITTEN, so `x = x + 1i32;` on an
    // unassigned `x` is refused for the read rather than accepted for the write.
    drop assign_expr(x, st, val, depth);

    if (raw expr_is_none(tgt)) { pass NIL; }
    ExprNode:tn = relay ast_expr(x.ast, tgt);

    // A BARE NAME IS THE ONLY THING THAT ASSIGNS THE WHOLE BINDING. `h.field = v`
    // and `arr[i] = v` write a PART, and reaching the part means the aggregate has
    // to be there already — so those are READS of the root, checked below like any
    // other, and they do not mark anything assigned.
    //
    // The stricter reading is deliberate. Nitpick has no implicit default (D-010),
    // so `Holder:h;` followed by `h.inner = NULL;` is writing through a slot whose
    // other fields nothing has established, and treating field-by-field filling as
    // initialisation is how partially-initialised aggregates get read as whole
    // ones.
    if (tn.kind != ExprKind.ExprIdentifierExpr) {
        drop assign_expr(x, st, tgt, depth);
        pass NIL;
    }

    if (tn.a == 0i32) { pass NIL; }
    Symbol:sym = raw symtab_get(x.tab, tn.a);

    // A GLOBAL. `const` at module scope is the same rule as `fixed` in a body, and
    // it is checked here because this is where an assignment to one arrives.
    if (sym.origin_kind == (raw SYM_DECL())) {
        DeclId:did = DeclId{ index: sym.origin };
        DeclNode:gd = relay ast_decl(x.ast, did);
        if (gd.kind == DeclKind.DeclGlobalDecl) {
            if (((raw global_quals(gd)) & (raw QUAL_CONST())) != 0i32) {
                drop assign_err(x, raw ASSIGN_IMMUTABLE(),
                    "a `const` global is assigned once, where it is declared, and cannot be assigned again",
                    tn.span);
            }
        }
        pass NIL;
    }

    if (sym.origin_kind != (raw SYM_STMT())) { pass NIL; }

    // `fixed` — ASSIGNED ONCE, ON ANY PATH. `may` and not `must` is the whole
    // point: `if (c) { k = 1i32; } k = 2i32;` writes twice on the path that took
    // the branch, and `must` says nothing about it.
    StmtId:decl = StmtId{ index: sym.origin };
    StmtNode:dn = relay ast_stmt(x.ast, decl);
    if (dn.kind == StmtKind.StmtVarDeclStmt) {
        if (((relay stmt_quals(x.ast, dn)) & (raw QUAL_FIXED())) != 0i32) {
            if (raw state_may(st, sym.origin)) {
                drop assign_err(x, raw ASSIGN_IMMUTABLE(),
                    "a `fixed` binding is assigned once and this may be the second time; drop `fixed` if it is meant to change",
                    tn.span);
            }
        }
    }

    drop state_mark(st, sym.origin);
    pass NIL;
};

// --- expressions -------------------------------------------------------------
//
// EVERY MENTION OF A BINDING IS A READ, with two exceptions that are not
// exceptions to the rule so much as to what "mention" means.
//
// `$$m x` HANDS THE CALLEE SOMETHING TO WRITE, and D-004 names that as the way a
// callee fills a caller-owned destination — one of the four mechanisms that
// replaced `gc` for returning references. Refusing it on an unassigned binding
// would refuse the pattern the decision endorses, so `$$m` on a place ASSIGNS the
// binding under it.
//
// `@x` AND `$$i x` DO NOT. `$$i` is a shared borrow and shared means readable, and
// `@` is plain address-of with nothing in it that says which way the data will
// travel. So both are reads, and `$$m` is the explicit, greppable way to say
// otherwise — which is the shape every other opt-out in this language has.
func:assign_expr = NIL(Assign->:x, AssignState:st, ExprId:id, int32:depth) {
    if (raw expr_is_none(id)) { pass NIL; }
    ExprNode:n = relay ast_expr(x.ast, id);

    if (depth <= 0i32) {
        drop assign_err(x, raw ASSIGN_TOO_DEEP(),
            "this expression nests deeper than the definite-assignment analysis will follow, so its bindings cannot be shown assigned before use",
            n.span);
        pass NIL;
    }
    int32:d = depth - 1i32;

    if (n.kind == ExprKind.ExprIdentifierExpr) {
        drop assign_read(x, st, n);
        pass NIL;
    }

    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        drop check_value_read(x, st, n);
        drop assign_expr(x, st, raw expr_operand(n), d);
        pass NIL;
    }

    // `move(place)` (D-065) TRANSFERS OWNERSHIP OUT OF THE SOURCE. Nothing moves
    // because it was assigned or passed — ownership moves only where `move` is
    // written, which is what makes this a question about one operator rather than
    // about every expression.
    //
    // The operand is READ before it is invalidated, in that order: moving out of a
    // binding that was never assigned, or that was already moved, is refused for
    // what it is rather than silently accepted because the move overwrote the
    // question.
    if (n.kind == ExprKind.ExprMoveExpr) {
        drop assign_expr(x, st, raw expr_operand(n), d);
        drop invalidate_place(x, st, raw expr_operand(n), false);
        pass NIL;
    }

    if (n.kind == ExprKind.ExprBorrowExpr) {
        if (raw borrow_is_mut(n)) {
            drop assign_mark_place(x, st, raw expr_operand(n), d);
            pass NIL;
        }
        drop assign_expr(x, st, raw expr_operand(n), d);
        pass NIL;
    }

    // A struct literal's window alternates NAME, VALUE; only the odd entries are
    // expressions.
    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            ExprId:v = ExprId{ index: raw ast_id_at(x.ast, raw expr_list_start(n), i) };
            drop assign_expr(x, st, v, d);
            i = i + 2i32;
        }
        pass NIL;
    }

    // A call's window holds generic arguments first and value arguments after.
    if (n.kind == ExprKind.ExprCallExpr) {
        int32:gc = raw expr_generic_count(n);
        drop assign_expr(x, st, raw expr_callee(n), d);
        int32:start = (raw expr_list_start(n)) + gc;
        int32:count = (raw expr_list_count(n)) - gc;
        drop assign_expr_window(x, st, start, count, d);

        // A DEALLOCATOR TAKES OWNERSHIP OF WHAT IT IS GIVEN, which is a move by
        // another name — so the binding that held the allocation stops being
        // valid, and using it again is a use-after-free while freeing it again is
        // a double-free. Both fall out of the moved-from machinery because a free
        // IS a move, and D-065 says as much: `move` is "the mechanism that
        // prevents double-free on `wild` allocations".
        if (raw callee_frees(x, n)) {
            if (count > 0i32) {
                ExprId:owned = ExprId{ index: raw ast_id_at(x.ast, start, 0i32) };
                drop invalidate_place(x, st, owned, true);
            }
        }
        pass NIL;
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        int32:bg = raw builtin_generic_count(n);
        drop assign_expr_window(x, st, (raw expr_list_start(n)) + bg,
                                (raw expr_list_count(n)) - bg, d);
        pass NIL;
    }

    // AN EXPRESSION `pick` CARRIES STATEMENTS (D-059) and merges like the statement
    // form, so it hands back to the statement walk rather than being flattened
    // here. Its arms `give` a value on every path an exhaustive one can take, which
    // is exactly the merge `assign_pick` performs.
    if (n.kind == ExprKind.ExprPickExpr) {
        StmtNode:as_stmt = StmtNode{ kind: StmtKind.StmtPickStmt, span: n.span,
                                     a: n.a, b: n.b, c: n.c, payload: 0i64 };
        drop assign_pick(x, st, as_stmt, d);
        pass NIL;
    }

    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        drop assign_expr_window(x, st, raw expr_list_start(n),
                                raw expr_list_count(n), d);
        pass NIL;
    }
    if (shape == (raw EXPR_SHAPE_NONE())) {
        drop assign_err(x, raw ASSIGN_INTERNAL(),
            "this expression kind has no entry in `expr_shape`, so its slots cannot be walked",
            n.span);
        pass NIL;
    }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) {
        drop assign_err(x, raw ASSIGN_INTERNAL(),
            "this expression kind has a custom shape the definite-assignment walk has no case for, so its contents cannot be checked",
            n.span);
        pass NIL;
    }

    drop assign_expr(x, st, raw expr_lhs(n), d);
    if (shape == (raw EXPR_SHAPE_ONE())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        drop assign_expr_window(x, st, raw expr_list_start(n),
                                raw expr_list_count(n), d);
        pass NIL;
    }
    drop assign_expr(x, st, raw expr_rhs(n), d);
    if (shape == (raw EXPR_SHAPE_TWO())) { pass NIL; }
    drop assign_expr(x, st, raw expr_third(n), d);
    pass NIL;
};

func:assign_expr_window = NIL(Assign->:x, AssignState:st, int32:start,
                              int32:count, int32:depth) {
    int32:i = 0i32;
    while (i < count) {
        ExprId:e = ExprId{ index: raw ast_id_at(x.ast, start, i) };
        drop assign_expr(x, st, e, depth);
        i = i + 1i32;
    }
    pass NIL;
};

// ONE MENTION OF A BINDING, READ.
func:assign_read = NIL(Assign->:x, AssignState:st, ExprNode:n) {
    if (n.a == 0i32) { pass NIL; }
    Symbol:s = raw symtab_get(x.tab, n.a);

    // ONLY A LOCAL CAN BE UNASSIGNED. A parameter is written by the caller, a
    // global by its initialiser, and a `pick` or `for` binding by the construct
    // that introduced it — none of them has a path on which nothing wrote.
    if (s.origin_kind != (raw SYM_STMT())) { pass NIL; }

    // MOVED OR FREED IS REPORTED FIRST, because it is the more specific answer to
    // the same question. A binding that was moved out of is not assigned either —
    // `state_mark` clears both and nothing sets `must` back — so reporting
    // "not assigned" here would be true, useless, and would send the reader
    // looking for a missing initialiser instead of at the `move` above it.
    if (raw state_freed(st, s.origin)) {
        drop assign_err(x, raw MOVE_USE_AFTER_FREE(),
            "this binding was freed and is invalid; a freed pointer is not a value that may be held and not inspected (D-065)",
            n.span);
        pass NIL;
    }
    if (raw state_moved(st, s.origin)) {
        drop assign_err(x, raw MOVE_USE_AFTER(),
            "this binding was moved out of and is invalid until it is assigned again (D-065)",
            n.span);
        pass NIL;
    }

    if (raw state_must(st, s.origin))      { pass NIL; }

    drop assign_err(x, raw ASSIGN_UNASSIGNED(),
        "this binding is not assigned on every path that reaches here, and Nitpick has no default value to read (D-010)",
        n.span);
    pass NIL;
};

// `$$m place` — the binding under the place becomes assigned, because the callee
// this is handed to may write it. The place itself is NOT walked as a read, which
// is the point.
func:assign_mark_place = NIL(Assign->:x, AssignState:st, ExprId:place, int32:depth) {
    if (raw expr_is_none(place)) { pass NIL; }
    PlaceRoot:r = relay place_root(x.ast, place, raw BORROW_FUEL());
    if (r.exhausted) { pass NIL; }
    if (raw expr_is_none(r.id)) { pass NIL; }
    ExprNode:rn = relay ast_expr(x.ast, r.id);

    // A DERIVED PLACE STILL NEEDS ITS BASE. `$$m rec.field` writes one field and
    // reads `rec` to find it, so the base is a read and only a bare name is a
    // whole-binding assignment.
    if (rn.kind != ExprKind.ExprIdentifierExpr) {
        drop assign_expr(x, st, place, depth);
        pass NIL;
    }
    if (r.id.index != place.index) {
        drop assign_read(x, st, rn);
        pass NIL;
    }
    if (rn.a == 0i32) { pass NIL; }
    Symbol:s = raw symtab_get(x.tab, rn.a);
    if (s.origin_kind != (raw SYM_STMT())) { pass NIL; }
    drop state_mark(st, s.origin);
    pass NIL;
};

// --- what invalidates a binding ------------------------------------------------
//
// `move(place)` and a deallocator both transfer ownership OUT of a binding, and
// both leave it invalid until something assigns it again.

// The bare-name builtins that take ownership of what they are given.
//
// TWO NAMES, AND NOT A HEURISTIC ABOUT NAMES. `dalloc` and `ralloc` are the native
// deallocator and reallocator; `ralloc` is here because a reallocation invalidates
// the pointer it was given and hands back a different one, so holding the old one
// afterwards is the same dangling pointer as holding a freed one.
//
// `malloc` AND `free` ARE NOT BUILTINS AND NOT ALIASES (D-119). They are C
// functions, reachable only through an `extern` block — and an `extern` callee is
// opaque by design. Past the FFI barrier the runtime cannot intercept a fault, and
// it cannot know what the callee did with a pointer either; a program that frees
// through `extern` has suspended the guarantee explicitly, which is how every other
// Nitpick guarantee is suspended.
//
// THE PROTOTYPE DECIDED THIS BY MATCHING THE SPELLING, and that is the part not to
// carry over. Its `KNOWN_DEALLOCATORS` held `close`, `release`, `destroy`,
// `cleanup`, `dispose` and `drop`, and it also matched any name ENDING in `_free`,
// `_close`, `_destroy` or `_release`. So `window_close` acquired ownership
// semantics it never declared and `deallocate_thing` did not — behaviour that
// varies by what something happens to be called, which is the context-dependence
// the blueprint philosophy exists to refuse and a list a reader would have to
// memorise.
func:callee_frees = bool(Assign->:x, ExprNode:n) {
    ExprId:c = raw expr_callee(n);
    if (raw expr_is_none(c)) { pass false; }
    ExprNode:cn = relay ast_expr(x.ast, c);
    if (cn.kind != ExprKind.ExprIdentifierExpr) { pass false; }

    // A BARE-NAME BUILTIN RESOLVES TO NO SYMBOL, which is what tells it apart from
    // a user function that happens to be called `dalloc` — that one would have one,
    // and it is not this one.
    if (cn.a != 0i32) { pass false; }

    string:name = relay intern_get(x.interns, raw expr_name(cn) => int32);
    if (raw string_eq(name, "dalloc")) { pass true; }
    pass (raw string_eq(name, "ralloc"));
};

// THE BINDING UNDER A PLACE, INVALIDATED.
//
// `move(rec.field)` and `dalloc(rec.field)` invalidate the WHOLE binding, not the
// field. Tracking per-field ownership means tracking partial validity, which is
// the same complexity D-004 chose second-class borrows to avoid — and the
// conservative answer refuses code that is fine rather than accepting code that is
// not.
func:invalidate_place = NIL(Assign->:x, AssignState:st, ExprId:place, bool:freed) {
    if (raw expr_is_none(place)) { pass NIL; }
    PlaceRoot:r = relay place_root(x.ast, place, raw BORROW_FUEL());
    if (r.exhausted)            { pass NIL; }
    if (raw expr_is_none(r.id)) { pass NIL; }
    ExprNode:rn = relay ast_expr(x.ast, r.id);
    if (rn.kind != ExprKind.ExprIdentifierExpr) { pass NIL; }
    if (rn.a == 0i32) { pass NIL; }
    Symbol:s = raw symtab_get(x.tab, rn.a);
    if (s.origin_kind != (raw SYM_STMT())) { pass NIL; }

    if (freed) {
        drop state_mark_freed(st, s.origin);
        pass NIL;
    }
    drop state_mark_moved(st, s.origin);
    pass NIL;
};

// --- what the qualifiers on a declaration have to agree about --------------------

// `nodrop` SUPPRESSES A DROP, so there has to be one to suppress.
//
// It exists for the one case where NOT dropping is correct rather than a leak: a
// `wild` allocation whose ownership has gone somewhere the compiler cannot see, so
// running the drop would free something twice. On a managed binding there is no
// manual allocation and nothing is suppressed — the qualifier then says something
// untrue about the binding it is written on, and a reader who believes it is
// reasoning about a lifetime that is not there.
//
// This is the last of the four qualifiers cycle 0.5 inherited as "parses and
// nothing reads it". `stack` and `wild` got their meaning from the escape rules in
// 0.5.1, `fixed` from assignment in 0.5.2, and this one had nowhere to attach until
// there was an ownership analysis to attach it to.
func:check_qualifiers = NIL(Assign->:x, StmtNode:s) {
    int32:q = relay stmt_quals(x.ast, s);
    if ((q & (raw QUAL_NODROP())) == 0i32) { pass NIL; }

    int32:manual = (raw QUAL_WILD()) | (raw QUAL_WILDX());
    if ((q & manual) != 0i32) { pass NIL; }

    drop assign_err(x, raw MOVE_NODROP_MANAGED(),
        "`nodrop` suppresses the drop of a manual allocation, and a binding that is not `wild` or `wildx` has none to suppress",
        s.span);
    pass NIL;
};

// --- the `unknown` taint on `Result.value` (D-007) ------------------------------
//
// `Result.value` CARRIES A COMPILER-ASSIGNED TAINT when the `Result` holds an
// error. `unknown` is not a type anybody can write — `TYPE_REFERENCE` §27 says so,
// and D-007 removed the user-writable form because two mechanisms for degraded
// computation is one too many. What survives is this one thing, and reading it
// unchecked is reading a value the compiler already knows may be meaningless.
//
// D-007's own argument for trapping rather than tainting is why this matters: "a
// tainted value that reaches an actuator command produces a WRONG ACTION, which is
// worse than no action." The taint exists so that reaching an actuator with one is
// a compile error rather than a discipline.
//
// `ok()` DOES NOT CLEAR IT, BECAUSE `ok` NO LONGER EXISTS. 0.5.5's plan says the
// taint is "cleared by `ok()` or by checking `is_error`", which was true when it
// was written and stopped being true at D-097: `ok(x)` asked whether an ordinary
// value was `unknown`, D-007 had already removed user-writable `unknown`, and an
// operator whose subject does not exist went with it. Checking `is_error` is the
// remaining route and was always the one that composed with the `Result`
// discipline.
//
// `raw` AND `?!` STILL GO THROUGH, and need nothing here: they do not read
// `.value`, they unwrap. That is the whole point of an escape hatch — explicit,
// greppable, and already both.

// WHAT AN `is_error` TEST SAYS, AND ABOUT WHICH BINDING.
//
// Three fields for the reason `FieldInfo` and `ParamBind` have three: whether a
// test was recognised at all is a different question from which binding it names,
// and `slot` 0 is a real statement index rather than an absence.
pub struct:ErrTest = {
    bool:found;
    int32:slot;
    bool:then_checked;   // does the TRUE branch prove the value is safe to read?
};

func:no_err_test = ErrTest() {
    ErrTest:t = ErrTest{ found: false, slot: 0i32, then_checked: false };
    pass t;
};

// `r.is_error` AND `!r.is_error`, WHICH ARE THE TWO FORMS PEOPLE WRITE.
//
// The plan asks for "the forms a programmer writes it in rather than one blessed
// spelling", and these are they: the test itself, and its negation. `.is_error` is
// DERIVED and not stored (D-069) — `r.is_error` is `error != 0` with no field
// behind it — so there is nothing else to recognise, and a spelling this does not
// know simply fails to clear the taint rather than being mistaken for one that
// does.
func:err_test_of = ErrTest(Assign->:x, ExprId:cond) {
    if (raw expr_is_none(cond)) { pass (raw no_err_test()); }
    ExprNode:n = relay ast_expr(x.ast, cond);

    // `!c` — the same test with the arms swapped.
    if (n.kind == ExprKind.ExprUnaryExpr) {
        if ((raw expr_op(n)) == TokenKind.OpBang) {
            ErrTest:inner = relay err_test_of(x, raw expr_operand(n));
            if (!inner.found) { pass (raw no_err_test()); }
            ErrTest:flipped = ErrTest{ found: true, slot: inner.slot,
                                       then_checked: !inner.then_checked };
            pass flipped;
        }
        pass (raw no_err_test());
    }

    if (n.kind != ExprKind.ExprMemberAccessExpr) { pass (raw no_err_test()); }
    string:f = relay intern_get(x.interns, (raw expr_name(n)) => int32);
    if (!(raw string_eq(f, "is_error"))) { pass (raw no_err_test()); }

    int32:slot = relay binding_slot(x, raw expr_operand(n));
    if (slot < 0i32) { pass (raw no_err_test()); }

    // `r.is_error` being TRUE means the value is NOT safe, so the THEN branch is
    // the tainted one and the ELSE branch is where the read is allowed.
    ErrTest:t = ErrTest{ found: true, slot: slot, then_checked: false };
    pass t;
};

// The declaring statement of the binding a place expression is rooted at, or -1.
func:binding_slot = int32(Assign->:x, ExprId:place) {
    if (raw expr_is_none(place)) { pass (0i32 - 1i32); }
    PlaceRoot:r = relay place_root(x.ast, place, raw BORROW_FUEL());
    if (r.exhausted)            { pass (0i32 - 1i32); }
    if (raw expr_is_none(r.id)) { pass (0i32 - 1i32); }
    ExprNode:rn = relay ast_expr(x.ast, r.id);
    if (rn.kind != ExprKind.ExprIdentifierExpr) { pass (0i32 - 1i32); }
    if (rn.a == 0i32) { pass (0i32 - 1i32); }
    Symbol:s = raw symtab_get(x.tab, rn.a);
    if (s.origin_kind != (raw SYM_STMT())) { pass (0i32 - 1i32); }
    pass s.origin;
};

// READING `.value` OFF A `Result` THAT NOTHING HAS CHECKED.
//
// ONLY A BINDING-ROOTED READ IS CHECKED, and that is not a hole so much as the
// shape of the language: `f().value` calls `f` and reads the field of a temporary,
// and there is no way to have checked THAT temporary — the check would call `f` a
// second time and get a different `Result`. So the idiom is to bind it, and the
// binding is what this tracks.
func:check_value_read = NIL(Assign->:x, AssignState:st, ExprNode:n) {
    string:f = relay intern_get(x.interns, (raw expr_name(n)) => int32);
    if (!(raw string_eq(f, "value"))) { pass NIL; }

    ExprId:base = raw expr_operand(n);
    int32:ty = raw exprtypes_get(x.etypes, base);
    if ((raw type_kind(x.types, ty)) != (raw TY_RESULT())) { pass NIL; }

    int32:slot = relay binding_slot(x, base);
    if (slot < 0i32) { pass NIL; }
    if (raw state_checked(st, slot)) { pass NIL; }

    drop assign_err(x, raw TAINT_UNCHECKED_VALUE(),
        "this `Result` has not been checked for an error, so its `value` carries the `unknown` taint; test `is_error` first, or use `raw` to say the check is not wanted (D-007)",
        n.span);
    pass NIL;
};
