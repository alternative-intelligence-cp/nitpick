// The liveness-across-await walk (D-177, 1.1.4). For each `async` function,
// which locals' live ranges CROSS a suspension point — recorded for the
// backend, which lays a crossing local into the coroutine frame (stage D)
// where a plain alloca would die between `resume` calls. This is also the
// surface C-8's borrow-across-await narrowing reads.
//
// THE POSITION MODEL IS SOURCE ORDER, NOT DATAFLOW. A local crosses if a
// suspension point sits between its declaration and its last use — with three
// widenings that make source order sound where control flow bends:
//
//   LOOPS RE-ENTER. A suspension inside a loop is crossed by any local
//   declared OUTSIDE that loop and used at-or-after the loop's start: the back
//   edge can carry the suspension before a textually earlier use. Each
//   suspension therefore records the start of every enclosing loop, and the
//   crossing test measures against those as well as the point itself.
//
//   `defer` RUNS AT SCOPE EXIT. A use inside a `defer` body happens at the
//   function's end, wherever the text sits — so it is recorded there. (When
//   scope-exit drop glue lands for managed locals, droppable locals gain the
//   same end-of-scope use HERE, for the same reason.)
//
//   AN ADDRESS OUTLIVES ITS MENTION. `@x` hands out a pointer this walk does
//   not follow, so the local is treated as used to the function's end. C-8
//   narrows what a borrow may cross; this walk only keeps the SLOT alive.
//
// A `drop work()` spawn is NOT a suspension: the spawn allocates and links,
// and control continues without yielding. The join that later drives the
// child sits at the function's exits, where every local's scope has already
// ended (D-177: defers run before the join) — so it contributes nothing to
// liveness either.
//
// BINDERS ARE KEYED BY STATEMENT INDEX — the var-decl statement a local's
// symbol names as its origin — which is the same key the emitter holds at the
// declaration site, so the mark travels on `ExprTypes` like every other
// checker-to-emitter fact. A var-decl registers when walked, positioned at
// the STATEMENT'S END: the name binds after the initialiser runs, so a
// suspension inside the initialiser is before the local exists, not across
// it. A binder this walk does not visit (a `for` element, a pick arm's
// pattern binding) registers lazily at its first use, positioned at its
// origin statement's start — sound today because the backend refuses a
// suspension inside a `for` body or a `pick` until stage D lifts those
// rungs, and stage D's obligation includes registering those binders
// eagerly (a never-used droppable arm binding is invisible to lazy
// registration).

mod:suspend;

use "../source_location.npk".*;
use "../ast_kind.npk".*;
use "../ast.npk".*;
use "../intern.npk".*;
use "../diagnostics.npk".*;
use "../symbols.npk".*;
use "../parse_expr.npk".*;
use "../parse_stmt.npk".*;
use "../parse_pick.npk".*;
use "../parse_decl.npk".*;
use "../parse_decorate.npk".*;
use "../types.npk".*;
use "../expr_types.npk".*;
use "./analysis_codes.npk".*;

pub func:SUSPEND_DEPTH = int32() never fails { pass 256i32; };
func:LOOP_STACK_CAP = int32() never fails { pass 64i32; };

pub struct:Suspend = {
    Ast->:ast;
    SymbolTable->:tab;
    ExprTypes->:ets;
    TypeTable->:types;      // D-182: to recognise a channel await's receiver
    DiagList->:diags;

    // The locals registry, reset per function: binder stmt index, binder
    // position, last-use position.
    wild int32->:lstmt;
    wild int64->:ldecl;
    wild int64->:luse;
    int32:lcount;
    int32:lcap;

    // Suspension points: position, and a window into `lsflat` holding the
    // start position of every loop enclosing the point.
    wild int64->:spos;
    wild int32->:sls;
    wild int32->:slc;
    int32:scount;
    int32:scap;
    wild int64->:lsflat;
    int32:fcount;
    int32:fcap;

    // The current enclosing-loop stack (start positions), and the walk state.
    wild int64->:lstack;
    int32:ldepth;
    int64:fn_end;
    bool:in_defer;

    // THE WALK'S CURSOR — the largest position touched so far. Statement and
    // expression spans in this compiler are FIRST-TOKEN spans, so "the end of
    // the statement" cannot be read off a span; the cursor supplies it: a
    // binder or suspension that must sit AFTER everything just walked takes
    // `max(its own span end, cursor + 1)`. Positions grow with the text, so
    // the cursor never overtakes anything later.
    int64:cursor;
};

pub func:suspend_init = Suspend(Ast->:ast, SymbolTable->:tab, ExprTypes->:ets,
                                TypeTable->:types, DiagList->:diags) never fails {
    wild int8->:a = alloc(64i64 * #size_of<int32>());
    wild int8->:b = alloc(64i64 * #size_of<int64>());
    wild int8->:c = alloc(64i64 * #size_of<int64>());
    wild int8->:d = alloc(32i64 * #size_of<int64>());
    wild int8->:e = alloc(32i64 * #size_of<int32>());
    wild int8->:f = alloc(32i64 * #size_of<int32>());
    wild int8->:g = alloc(64i64 * #size_of<int64>());
    wild int8->:h = alloc(((raw LOOP_STACK_CAP()) => int64) * #size_of<int64>());
    Suspend:x = Suspend{ ast: ast, tab: tab, ets: ets, types: types, diags: diags,
                         lstmt: a =>! wild int32->,
                         ldecl: b =>! wild int64->,
                         luse: c =>! wild int64->,
                         lcount: 0i32, lcap: 64i32,
                         spos: d =>! wild int64->,
                         sls: e =>! wild int32->,
                         slc: f =>! wild int32->,
                         scount: 0i32, scap: 32i32,
                         lsflat: g =>! wild int64->,
                         fcount: 0i32, fcap: 64i32,
                         lstack: h =>! wild int64->,
                         ldepth: 0i32, fn_end: 0i64, in_defer: false,
                         cursor: 0i64 };
    pass x;
};

func:suspend_err = NIL(Suspend->:x, move string:msg, Span:sp) never fails {
    drop diaglist_push(x.diags, raw diag_error(raw SUSPEND_INTERNAL(), move(msg), sp));
    pass NIL;
};

// A span's place in the one order this walk measures with: file first, offset
// within it. Positions from different files (a macro splice) still get a total
// order — an artificial one, which can only err toward MORE crossing, never
// less, because every comparison stays consistent within the walk.
func:pos_of = int64(Span:sp) never fails {
    pass ((sp.file => int64) * 4294967296i64) + (sp.offset => int64);
};

func:pos_end = int64(Span:sp) never fails {
    pass ((sp.file => int64) * 4294967296i64)
         + ((sp.offset + sp.len) => int64);
};

// --- the locals registry ------------------------------------------------------------

func:cur_touch = NIL(Suspend->:x, int64:at) never fails {
    if (at > x.cursor) { x.cursor = at; }
    pass NIL;
};

func:reg_find = int32(Suspend->:x, int32:stmt_index) never fails {
    int32:i = 0i32;
    while (i < x.lcount) {
        if (x.lstmt[i => int64] == stmt_index) { pass i; }
        i = i + 1i32;
    }
    pass 0i32 - 1i32;
};

func:reg_add = int32(Suspend->:x, int32:stmt_index, int64:at) never fails {
    if (x.lcount >= x.lcap) {
        int64:ncap = (x.lcap => int64) * 2i64;
        wild int8->:na = ralloc(x.lstmt =>! wild int8->, ncap * #size_of<int32>());
        wild int8->:nb = ralloc(x.ldecl =>! wild int8->, ncap * #size_of<int64>());
        wild int8->:nc = ralloc(x.luse =>! wild int8->, ncap * #size_of<int64>());
        x.lstmt = na =>! wild int32->;
        x.ldecl = nb =>! wild int64->;
        x.luse = nc =>! wild int64->;
        x.lcap = ncap =>! int32;
    }
    drop cur_touch(x, at);
    x.lstmt[x.lcount => int64] = stmt_index;
    x.ldecl[x.lcount => int64] = at;
    x.luse[x.lcount => int64] = at;
    x.lcount = x.lcount + 1i32;
    pass (x.lcount - 1i32);
};

// One mention of a name. Only a LOCAL registers — a symbol whose origin is a
// statement. Parameters are frame-resident by construction (the caller stored
// them into the frame), so they are exactly the bindings this walk exempts.
// Extend a local's recorded use to `at` WITHOUT moving the walk's cursor
// — the address-taken extension. The use is SEMANTIC (the alias lives on
// to `at`), not textual (the walk is still standing where it stood), and
// routing it through `reg_use` slammed the cursor to `fn_end`: every
// suspension after the first `@x` was then positioned past the function's
// end, and nothing declared before it ever crossed again (1.1.13-close —
// found when the range-view rule below inherited the slam).
func:reg_extend = NIL(Suspend->:x, int32:sym_id, int64:at) never fails {
    if (sym_id == 0i32) { pass NIL; }
    Symbol:s = raw symtab_get(x.tab, sym_id);
    if (s.origin_kind != (raw SYM_STMT())) { pass NIL; }
    int32:idx = raw reg_find(x, s.origin);
    if (idx < 0i32) {
        StmtNode:o = raw ast_stmt(x.ast, StmtId{ index: s.origin });
        idx = raw reg_add(x, s.origin, raw pos_of(o.span));
    }
    if (at > x.luse[idx => int64]) { x.luse[idx => int64] = at; }
    pass NIL;
};

func:reg_use = NIL(Suspend->:x, int32:sym_id, int64:at) never fails {
    if (sym_id == 0i32) { pass NIL; }
    Symbol:s = raw symtab_get(x.tab, sym_id);
    if (s.origin_kind != (raw SYM_STMT())) { pass NIL; }
    int32:idx = raw reg_find(x, s.origin);
    if (idx < 0i32) {
        StmtNode:o = raw ast_stmt(x.ast, StmtId{ index: s.origin });
        idx = raw reg_add(x, s.origin, raw pos_of(o.span));
    }
    // The cursor takes the TEXTUAL position; the recorded use takes the
    // semantic one (a defer body runs at scope exit).
    drop cur_touch(x, at);
    int64:pt = at;
    if (x.in_defer) { pt = x.fn_end; }
    if (pt > x.luse[idx => int64]) { x.luse[idx => int64] = pt; }
    pass NIL;
};

// --- suspension points --------------------------------------------------------------

func:susp_add = NIL(Suspend->:x, int64:at) never fails {
    if ((x.fcount + x.ldepth) > x.fcap) {
        int64:ncap = (x.fcap => int64) * 2i64;
        while (ncap < ((x.fcount + x.ldepth) => int64)) { ncap = ncap * 2i64; }
        wild int8->:ng = ralloc(x.lsflat =>! wild int8->, ncap * #size_of<int64>());
        x.lsflat = ng =>! wild int64->;
        x.fcap = ncap =>! int32;
    }
    if (x.scount >= x.scap) {
        int64:ncap = (x.scap => int64) * 2i64;
        wild int8->:nd = ralloc(x.spos =>! wild int8->, ncap * #size_of<int64>());
        wild int8->:ne = ralloc(x.sls =>! wild int8->, ncap * #size_of<int32>());
        wild int8->:nf = ralloc(x.slc =>! wild int8->, ncap * #size_of<int32>());
        x.spos = nd =>! wild int64->;
        x.sls = ne =>! wild int32->;
        x.slc = nf =>! wild int32->;
        x.scap = ncap =>! int32;
    }
    drop cur_touch(x, at);
    x.spos[x.scount => int64] = at;
    x.sls[x.scount => int64] = x.fcount;
    x.slc[x.scount => int64] = x.ldepth;
    int32:i = 0i32;
    while (i < x.ldepth) {
        x.lsflat[x.fcount => int64] = x.lstack[i => int64];
        x.fcount = x.fcount + 1i32;
        i = i + 1i32;
    }
    x.scount = x.scount + 1i32;
    pass NIL;
};

// --- the walk -----------------------------------------------------------------------

pub func:suspend_module = NIL(Suspend->:x, DeclId:mod_id) never fails {
    DeclNode:m = raw ast_decl(x.ast, mod_id);
    int32:n = raw item_member_count(x.ast, m);
    int32:i = 0i32;
    while (i < n) {
        drop suspend_decl(x, raw item_member(x.ast, m, i));
        i = i + 1i32;
    }
    pass NIL;
};

func:suspend_decl = NIL(Suspend->:x, DeclId:id) never fails {
    DeclNode:d = raw ast_decl(x.ast, id);

    if (d.kind == DeclKind.DeclFunctionDecl) {
        if (!(raw decl_has(d, raw DECL_ASYNC()))) { pass NIL; }
        StmtId:body = raw fn_body(x.ast, d);
        if (raw stmt_is_none(body)) { pass NIL; }
        StmtNode:bn = raw ast_stmt(x.ast, body);

        x.lcount = 0i32;
        x.scount = 0i32;
        x.fcount = 0i32;
        x.ldepth = 0i32;
        // "TO THE FUNCTION'S END" MEANS PAST EVERY SUSPENSION IN THIS
        // SETTLE, and reading it off the body block's SPAN never delivered
        // that: a block's span covers its opening region, so `fn_end` sat
        // near the function's TOP and every extension through it — the
        // address-taken rule, the defer-use rule — was a silent no-op from
        // birth (1.1.13-close; found when the first awaited
        // slice-of-local-array read a dead resume stack). The settle only
        // ever compares positions within one function, so the honest value
        // is the order's ceiling.
        x.fn_end = 9223372036854775807i64;
        x.in_defer = false;
        x.cursor = 0i64;

        drop suspend_stmt(x, body, raw SUSPEND_DEPTH());
        drop suspend_settle(x);
        pass NIL;
    }
    if (d.kind == DeclKind.DeclModuleDecl) {
        drop suspend_module(x, id);
        pass NIL;
    }
    if (d.kind == DeclKind.DeclImplDecl) {
        int32:mn = raw impl_member_count(x.ast, d);
        int32:j = 0i32;
        while (j < mn) {
            drop suspend_decl(x, raw impl_member(x.ast, d, j));
            j = j + 1i32;
        }
        pass NIL;
    }
    if (d.kind == DeclKind.DeclTraitDecl) {
        int32:tn = raw item_member_count(x.ast, d);
        int32:k = 0i32;
        while (k < tn) {
            drop suspend_decl(x, raw item_member(x.ast, d, k));
            k = k + 1i32;
        }
        pass NIL;
    }
    pass NIL;
};

// The crossing test, run once per function after its walk. A local (D, U)
// crosses suspension P when D < P < U — or, for each loop start L enclosing
// P, when D < L and U > L: the local was alive when the loop began, so the
// back edge can put the suspension between two of its moments.
func:suspend_settle = NIL(Suspend->:x) never fails {
    int32:i = 0i32;
    while (i < x.lcount) {
        int64:dpos = x.ldecl[i => int64];
        int64:upos = x.luse[i => int64];
        bool:crossed = false;
        int32:j = 0i32;
        while (j < x.scount) {
            int64:p = x.spos[j => int64];
            if (dpos < p) { if (p < upos) { crossed = true; } }
            int32:w = 0i32;
            while (w < x.slc[j => int64]) {
                int64:ls = x.lsflat[(x.sls[j => int64] + w) => int64];
                if (dpos < ls) { if (upos > ls) { crossed = true; } }
                w = w + 1i32;
            }
            j = j + 1i32;
        }
        if (crossed) {
            drop exprtypes_mark_crossing(x.ets, x.lstmt[i => int64]);
        }
        i = i + 1i32;
    }
    pass NIL;
};

func:loop_push = NIL(Suspend->:x, Span:sp) never fails {
    if (x.ldepth >= (raw LOOP_STACK_CAP())) {
        drop suspend_err(x,
            "loops nest deeper than the suspend walk's stack, so suspension points inside cannot be measured",
            sp);
        pass NIL;
    }
    x.lstack[x.ldepth => int64] = raw pos_of(sp);
    x.ldepth = x.ldepth + 1i32;
    pass NIL;
};

func:loop_pop = NIL(Suspend->:x) never fails {
    if (x.ldepth > 0i32) { x.ldepth = x.ldepth - 1i32; }
    pass NIL;
};

func:suspend_stmt = NIL(Suspend->:x, StmtId:id, int32:fuel) never fails {
    if (raw stmt_is_none(id)) { pass NIL; }
    StmtNode:s = raw ast_stmt(x.ast, id);
    if (fuel <= 0i32) {
        drop suspend_err(x,
            "statements nest deeper than the suspend walk follows, so suspension points inside cannot be measured",
            s.span);
        pass NIL;
    }

    if (s.kind == StmtKind.StmtVarDeclStmt) {
        ExprId:init = raw stmt_decl_init(x.ast, s);
        if (!(raw expr_is_none(init))) {
            drop check_first_eval(x, init);
            drop suspend_expr(x, init, fuel - 1i32);
        }
        // AFTER the initialiser: the name binds once the initialiser has run,
        // so a suspension inside it is before this local, not across it — the
        // cursor places the binder past everything the initialiser touched.
        int32:idx = raw reg_find(x, id.index);
        if (idx < 0i32) {
            int64:dat = raw pos_end(s.span);
            if (x.cursor >= dat) { dat = x.cursor + 1i64; }
            int32:ni = raw reg_add(x, id.index, dat);
            // A DROPPABLE LOCAL IS USED AT ITS SCOPE'S EXIT (D-183, 1.2.4b):
            // the drop reads the value there, so its life runs past its last
            // textual mention. Recorded at the function's end — the same
            // conservative position `defer` bodies and `@x` already take,
            // under the walk's doctrine that source order may only err
            // toward MORE crossing. The checker marked which var-decls own;
            // a function with no suspensions never consults any of this.
            if (raw exprtypes_owning_decl(x.ets, id.index)) {
                if (x.fn_end > x.luse[ni => int64]) {
                    x.luse[ni => int64] = x.fn_end;
                }
            }
        }
        pass NIL;
    }
    if (s.kind == StmtKind.StmtAssignStmt) {
        drop check_first_eval_assign(x, s);
        drop suspend_expr(x, raw stmt_target(s), fuel - 1i32);
        drop suspend_expr(x, raw stmt_assigned(s), fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPassStmt) {
        drop suspend_operand(x, s, fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtFailStmt) {
        drop suspend_operand(x, s, fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtReturnStmt) {
        drop suspend_operand(x, s, fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtExitStmt) {
        drop check_first_eval(x, raw stmt_expr(s));
        drop suspend_expr(x, raw stmt_expr(s), fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtBlockStmt) {
        drop suspend_window(x, raw stmt_list_start(s), raw stmt_list_count(s), fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtIfStmt) {
        drop check_first_eval(x, raw stmt_cond(s));
        drop suspend_expr(x, raw stmt_cond(s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_then(s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_else(s), fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhileStmt) {
        drop loop_push(x, s.span);
        drop check_first_eval(x, raw stmt_cond(s));
        drop suspend_expr(x, raw stmt_cond(s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_body(x.ast, s), fuel - 1i32);
        drop loop_pop(x);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtWhenStmt) {
        drop check_first_eval(x, raw stmt_cond(s));
        drop suspend_expr(x, raw stmt_cond(s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_when_body(x.ast, s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_when_then(x.ast, s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_when_end(x.ast, s), fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtLoopStmt) {
        drop suspend_counted(x, s, fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtTillStmt) {
        drop suspend_counted(x, s, fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtForStmt) {
        drop loop_push(x, s.span);
        drop check_first_eval(x, raw stmt_for_iter(x.ast, s));
        drop suspend_expr(x, raw stmt_for_iter(x.ast, s), fuel - 1i32);
        drop suspend_stmt(x, raw stmt_for_body(x.ast, s), fuel - 1i32);
        drop loop_pop(x);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPickStmt) {
        drop check_first_eval(x, raw pick_selector(s));
        drop suspend_expr(x, raw pick_selector(s), fuel - 1i32);
        drop suspend_window(x, raw pick_arm_start(s), raw pick_arm_count(s), fuel);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtPickArm) {
        // AN AWAIT MAY NOT SIT IN A `where` GUARD (1.1.13-close, D-191):
        // the guard runs between arm selection and entry, and no value of
        // its can survive a suspension there — arm BODIES are
        // frame-resident, the selection machinery is not, by design.
        ExprId:agd = raw arm_guard(s);
        if (!(raw expr_is_none(agd))) {
            if (raw has_susp(x, agd, 64i32)) {
                drop diaglist_push(x.diags, raw diag_error(raw SUSPEND_GUARD(),
                    "an `await` may not sit in a `where` guard: the guard runs between arm selection and entry, and nothing there survives a suspension — move the wait before the `pick`, or into the arm's body",
                    s.span));
            }
        }
        drop suspend_expr(x, raw arm_guard(s), fuel - 1i32);
        drop suspend_stmt(x, raw arm_body(s), fuel - 1i32);
        pass NIL;
    }
    if (s.kind == StmtKind.StmtDeferStmt) {
        bool:saved = x.in_defer;
        x.in_defer = true;
        drop suspend_stmt(x, StmtId{ index: s.a }, fuel - 1i32);
        x.in_defer = saved;
        pass NIL;
    }
    if (s.kind == StmtKind.StmtBreakStmt)    { pass NIL; }
    if (s.kind == StmtKind.StmtContinueStmt) { pass NIL; }
    if (s.kind == StmtKind.StmtFallStmt)     { pass NIL; }

    if (raw stmt_carries_expr(s.kind)) {
        drop check_first_eval(x, raw stmt_expr(s));
        drop suspend_expr(x, raw stmt_expr(s), fuel - 1i32);
        pass NIL;
    }

    drop suspend_err(x,
        "this statement kind has no entry in the suspend walk, so suspension points inside it cannot be measured",
        s.span);
    pass NIL;
};

func:suspend_operand = NIL(Suspend->:x, StmtNode:s, int32:fuel) never fails {
    ExprId:v = raw stmt_operand(s);
    if (raw expr_is_none(v)) { pass NIL; }
    drop check_first_eval(x, v);
    drop suspend_expr(x, v, fuel - 1i32);
    pass NIL;
};

func:suspend_window = NIL(Suspend->:x, int32:start, int32:count, int32:fuel) never fails {
    int32:i = 0i32;
    while (i < count) {
        drop suspend_stmt(x, StmtId{ index: raw ast_id_at(x.ast, start, i) },
                          fuel - 1i32);
        i = i + 1i32;
    }
    pass NIL;
};

func:suspend_counted = NIL(Suspend->:x, StmtNode:s, int32:fuel) never fails {
    drop loop_push(x, s.span);
    int32:n = raw stmt_counted_argc(x.ast, s);
    int32:i = 0i32;
    while (i < n) {
        drop check_first_eval(x, raw stmt_counted_arg(x.ast, s, i));
        drop suspend_expr(x, raw stmt_counted_arg(x.ast, s, i), fuel - 1i32);
        i = i + 1i32;
    }
    drop suspend_stmt(x, raw stmt_counted_body(s), fuel - 1i32);
    drop loop_pop(x);
    pass NIL;
};

func:suspend_expr = NIL(Suspend->:x, ExprId:id, int32:fuel) never fails {
    if (raw expr_is_none(id)) { pass NIL; }
    ExprNode:n = raw ast_expr(x.ast, id);
    if (fuel <= 0i32) {
        drop suspend_err(x,
            "expressions nest deeper than the suspend walk follows, so suspension points inside cannot be measured",
            n.span);
        pass NIL;
    }

    if (n.kind == ExprKind.ExprIdentifierExpr) {
        drop reg_use(x, n.a, raw pos_of(n.span));
        pass NIL;
    }

    // THE SUSPENSION POINT, positioned past the operand: the arguments
    // evaluate before the machine can yield, so the point lands after their
    // uses (walked first) and they do not cross it.
    if (n.kind == ExprKind.ExprAwaitExpr) {
        // A CHANNEL await's operand is RE-READ AFTER the suspension: the
        // retry loop loads the handle again on every turn, so its receiver
        // is live across the wait and must be frame-resident. An ordinary
        // await consumes its arguments INTO the callee's frame before
        // suspending, so those uses are genuinely before the point. The
        // difference is which side of `susp_add` the operand is walked on,
        // and getting it wrong left the handle in an alloca that the resume
        // path found full of garbage — a stale-handle error with no stale
        // handle in sight.
        ExprId:awop2 = raw expr_operand(n);
        ExprNode:awn2 = raw ast_expr(x.ast, awop2);
        bool:chan_await = false;
        if (awn2.kind == ExprKind.ExprMethodCallExpr) {
            int32:awrt2 = raw exprtypes_get(x.ets, raw expr_operand(awn2));
            if (awrt2 != 0i32) {
                if ((raw type_kind(x.types, awrt2)) == (raw TY_CHANNEL())) {
                    chan_await = true;
                }
            }
        }
        if (chan_await) {
            int64:cat = raw pos_of(n.span);
            if (x.cursor >= cat) { cat = x.cursor + 1i64; }
            drop susp_add(x, cat);
            drop suspend_expr(x, awop2, fuel - 1i32);
            pass NIL;
        }
        // (An INDIRECT await needs no rule of its own: TYPE-043 refuses an
        // await of any non-async call, a sync function value is that, and
        // an async function VALUE is unspellable — the func-type grammar
        // carries no `async` — so the case has no program to arise in.)
        drop suspend_expr(x, awop2, fuel - 1i32);
        int64:sat = raw pos_end(n.span);
        if (x.cursor >= sat) { sat = x.cursor + 1i64; }
        drop susp_add(x, sat);
        pass NIL;
    }

    // `@x` hands out an address the walk does not follow: the local stays
    // live to the function's end, whatever C-8 later says about the borrow.
    if (n.kind == ExprKind.ExprBorrowExpr) {
        drop suspend_expr(x, raw expr_operand(n), fuel - 1i32);
        PlaceRoot:r = raw place_root(x.ast, raw expr_operand(n),
                                     raw SUSPEND_DEPTH());
        if (!(raw expr_is_none(r.id))) {
            ExprNode:rn = raw ast_expr(x.ast, r.id);
            if (rn.kind == ExprKind.ExprIdentifierExpr) {
                drop reg_extend(x, rn.a, x.fn_end);
            }
        }
        pass NIL;
    }

    // A RANGE-VIEW ALIASES ITS ARRAY (1.1.13-close, D-191): `arr[lo...hi]`
    // hands out `arr`'s address exactly as `@arr` does — the emitter
    // literally takes addr_of of the place — so the rooted local stays live
    // to the function's end like any address-taken one. Without this the
    // array stayed a resume-stack alloca while the VIEW was framed, and a
    // slice seeded into an awaited child pointed into a dead stack — found
    // by the first awaited slice-of-local-array ever driven.
    if (n.kind == ExprKind.ExprIndexExpr) {
        ExprNode:rix = raw ast_expr(x.ast, raw expr_rhs(n));
        if (rix.kind == ExprKind.ExprRangeExpr) {
            PlaceRoot:vr = raw place_root(x.ast, raw expr_lhs(n),
                                          raw SUSPEND_DEPTH());
            if (!(raw expr_is_none(vr.id))) {
                ExprNode:vrn = raw ast_expr(x.ast, vr.id);
                if (vrn.kind == ExprKind.ExprIdentifierExpr) {
                    drop reg_extend(x, vrn.a, x.fn_end);
                }
            }
        }
        drop suspend_expr(x, raw expr_lhs(n), fuel - 1i32);
        drop suspend_expr(x, raw expr_rhs(n), fuel - 1i32);
        pass NIL;
    }

    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            drop suspend_expr(x, ExprId{ index: raw ast_id_at(x.ast,
                                  raw expr_list_start(n), i) }, fuel - 1i32);
            i = i + 2i32;
        }
        pass NIL;
    }
    if (n.kind == ExprKind.ExprCallExpr) {
        int32:gc = raw expr_generic_count(n);
        drop suspend_expr(x, raw expr_callee(n), fuel - 1i32);
        drop suspend_expr_window(x, (raw expr_list_start(n)) + gc,
                                 (raw expr_list_count(n)) - gc, fuel);
        pass NIL;
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        int32:bg = raw builtin_generic_count(n);
        drop suspend_expr_window(x, (raw expr_list_start(n)) + bg,
                                 (raw expr_list_count(n)) - bg, fuel);
        pass NIL;
    }
    if (n.kind == ExprKind.ExprPickExpr) {
        StmtNode:as_stmt = StmtNode{ kind: StmtKind.StmtPickStmt, span: n.span,
                                     a: n.a, b: n.b, c: n.c, payload: 0i64 };
        drop suspend_expr(x, raw pick_selector(as_stmt), fuel - 1i32);
        drop suspend_window(x, raw pick_arm_start(as_stmt),
                            raw pick_arm_count(as_stmt), fuel);
        pass NIL;
    }

    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        drop suspend_expr_window(x, raw expr_list_start(n),
                                 raw expr_list_count(n), fuel);
        pass NIL;
    }
    if (shape == (raw EXPR_SHAPE_NONE())) {
        drop suspend_err(x,
            "this expression kind has no entry in `expr_shape`, so the suspend walk cannot follow its slots",
            n.span);
        pass NIL;
    }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) {
        drop suspend_err(x,
            "this expression kind has a custom shape the suspend walk has no case for, so its contents cannot be measured",
            n.span);
        pass NIL;
    }

    drop suspend_expr(x, raw expr_lhs(n), fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_ONE())) { pass NIL; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        drop suspend_expr_window(x, raw expr_list_start(n),
                                 raw expr_list_count(n), fuel);
        pass NIL;
    }
    drop suspend_expr(x, raw expr_rhs(n), fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_TWO())) { pass NIL; }
    drop suspend_expr(x, raw expr_third(n), fuel - 1i32);
    pass NIL;
};

func:suspend_expr_window = NIL(Suspend->:x, int32:start, int32:count,
                               int32:fuel) never fails {
    int32:i = 0i32;
    while (i < count) {
        drop suspend_expr(x, ExprId{ index: raw ast_id_at(x.ast, start, i) },
                          fuel - 1i32);
        i = i + 1i32;
    }
    pass NIL;
};

// --- D-178: the first-evaluation rule -----------------------------------------------
//
// A statement suspends AT MOST ONCE, BEFORE anything else it computes. The
// walk is in evaluation order: literals may precede the suspension (they
// lower inline and cost no temporary); anything else evaluated before it
// would be an SSA value the resume path cannot reproduce. The `await`'s own
// arguments are exempt — they evaluate before the suspension and are
// consumed into the callee's frame. A value-`pick` whose arms suspend is
// itself a suspension of the enclosing statement (its selector is consumed
// by the dispatch, exempt like the await's arguments); the arm bodies'
// statements each carry their own copy of this rule via the ordinary walk.

// The literal kinds — the evaluations that cost no temporary, so they may
// precede a suspension.
func:expr_is_literal_kind = bool(ExprKind:k) never fails {
    if (k == ExprKind.ExprIntLiteral)         { pass true; }
    if (k == ExprKind.ExprFloatLiteral)       { pass true; }
    if (k == ExprKind.ExprCharLiteral)        { pass true; }
    if (k == ExprKind.ExprStringLiteral)      { pass true; }
    if (k == ExprKind.ExprRawStringLiteral)   { pass true; }
    if (k == ExprKind.ExprBlockStringLiteral) { pass true; }
    if (k == ExprKind.ExprBoolLiteral)        { pass true; }
    pass (k == ExprKind.ExprSentinelLiteral);
};

func:fe_err = NIL(Suspend->:x, move string:msg, Span:sp) never fails {
    drop diaglist_push(x.diags, raw diag_error(raw SUSPEND_FIRST_EVAL(), move(msg), sp));
    pass NIL;
};

// Does this expression suspend anywhere inside — an `await`, or a
// value-`pick` any of whose arm statements suspend?
func:has_susp = bool(Suspend->:x, ExprId:id, int32:fuel) never fails {
    if (raw expr_is_none(id)) { pass false; }
    if (fuel <= 0i32) { pass true; }
    ExprNode:n = raw ast_expr(x.ast, id);
    if (n.kind == ExprKind.ExprAwaitExpr) { pass true; }
    if (n.kind == ExprKind.ExprPickExpr) {
        StmtNode:ps = StmtNode{ kind: StmtKind.StmtPickStmt, span: n.span,
                                a: n.a, b: n.b, c: n.c, payload: 0i64 };
        if (raw has_susp(x, raw pick_selector(ps), fuel - 1i32)) { pass true; }
        int32:j = 0i32;
        while (j < (raw pick_arm_count(ps))) {
            if (raw stmt_has_susp(x, StmtId{ index: raw ast_id_at(x.ast,
                    raw pick_arm_start(ps), j) }, fuel - 1i32)) { pass true; }
            j = j + 1i32;
        }
        pass false;
    }
    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            if (raw has_susp(x, ExprId{ index: raw ast_id_at(x.ast,
                    raw expr_list_start(n), i) }, fuel - 1i32)) { pass true; }
            i = i + 2i32;
        }
        pass false;
    }
    if (n.kind == ExprKind.ExprCallExpr) {
        if (raw has_susp(x, raw expr_callee(n), fuel - 1i32)) { pass true; }
        pass (raw has_susp_window(x, (raw expr_list_start(n))
                  + (raw expr_generic_count(n)),
                  (raw expr_list_count(n)) - (raw expr_generic_count(n)), fuel));
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        pass (raw has_susp_window(x, (raw expr_list_start(n))
                  + (raw builtin_generic_count(n)),
                  (raw expr_list_count(n)) - (raw builtin_generic_count(n)), fuel));
    }
    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LEAF())) { pass false; }
    if (shape == (raw EXPR_SHAPE_LIST())) {
        pass (raw has_susp_window(x, raw expr_list_start(n),
                  raw expr_list_count(n), fuel));
    }
    if (shape == (raw EXPR_SHAPE_NONE()))   { pass false; }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) { pass false; }
    if (raw has_susp(x, raw expr_lhs(n), fuel - 1i32)) { pass true; }
    if (shape == (raw EXPR_SHAPE_ONE())) { pass false; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        pass (raw has_susp_window(x, raw expr_list_start(n),
                  raw expr_list_count(n), fuel));
    }
    if (raw has_susp(x, raw expr_rhs(n), fuel - 1i32)) { pass true; }
    if (shape == (raw EXPR_SHAPE_TWO())) { pass false; }
    pass (raw has_susp(x, raw expr_third(n), fuel - 1i32));
};

func:has_susp_window = bool(Suspend->:x, int32:start, int32:count,
                            int32:fuel) never fails {
    int32:i = 0i32;
    while (i < count) {
        if (raw has_susp(x, ExprId{ index: raw ast_id_at(x.ast, start, i) },
                         fuel - 1i32)) { pass true; }
        i = i + 1i32;
    }
    pass false;
};

func:stmt_has_susp = bool(Suspend->:x, StmtId:id, int32:fuel) never fails {
    if (raw stmt_is_none(id)) { pass false; }
    if (fuel <= 0i32) { pass true; }
    StmtNode:s = raw ast_stmt(x.ast, id);
    if (s.kind == StmtKind.StmtVarDeclStmt) {
        pass (raw has_susp(x, raw stmt_decl_init(x.ast, s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtAssignStmt) {
        if (raw has_susp(x, raw stmt_target(s), fuel - 1i32)) { pass true; }
        pass (raw has_susp(x, raw stmt_assigned(s), fuel - 1i32));
    }
    if (s.kind == StmtKind.StmtBlockStmt) {
        int32:i = 0i32;
        while (i < (raw stmt_list_count(s))) {
            if (raw stmt_has_susp(x, StmtId{ index: raw ast_id_at(x.ast,
                    raw stmt_list_start(s), i) }, fuel - 1i32)) { pass true; }
            i = i + 1i32;
        }
        pass false;
    }
    if (s.kind == StmtKind.StmtPickArm) {
        if (raw has_susp(x, raw arm_guard(s), fuel - 1i32)) { pass true; }
        pass (raw stmt_has_susp(x, raw arm_body(s), fuel - 1i32));
    }
    if (raw stmt_carries_expr(s.kind)) {
        pass (raw has_susp(x, raw stmt_expr(s), fuel - 1i32));
    }
    // Any other statement kind (a loop, an if, a nested pick) walks its own
    // statements through `suspend_stmt`, where each inner statement gets its
    // own copy of the rule; for the ENCLOSING statement's prefix question
    // those forms cannot appear inside an expression at all.
    pass false;
};

// The evaluation-order walk. State: 0 = before the suspension (literals
// only), 1 = the suspension happened (unconstrained after), 2 = reported.
func:fe_walk = int32(Suspend->:x, ExprId:id, int32:st, int32:fuel) never fails {
    if (raw expr_is_none(id)) { pass st; }
    if (st == 2i32) { pass 2i32; }
    if (fuel <= 0i32) { pass st; }
    ExprNode:n = raw ast_expr(x.ast, id);
    if (st == 1i32) {
        // The suspension already happened; what follows is unconstrained —
        // unless it suspends AGAIN, which is the second re-entry the rule
        // exists to forbid.
        if (raw has_susp(x, id, raw SUSPEND_DEPTH())) {
            drop fe_err(x,
                "a statement suspends at most once (D-178): bind the first `await`'s result, then take the second in its own statement",
                n.span);
            pass 2i32;
        }
        pass 1i32;
    }

    if (n.kind == ExprKind.ExprAwaitExpr) {
        // The operand's arguments are exempt — but an inner suspension in
        // them is a SECOND one, and the second re-entry is what the rule
        // forbids.
        if (raw has_susp(x, raw expr_operand(n), raw SUSPEND_DEPTH())) {
            drop fe_err(x,
                "a statement suspends at most once (D-178): this `await`'s operand suspends again — bind the inner result first",
                n.span);
            pass 2i32;
        }
        pass 1i32;
    }
    if (n.kind == ExprKind.ExprPickExpr) {
        // A value-pick that suspends counts as the suspension; its selector
        // is consumed by the dispatch, and its arm statements carry their
        // own copies of this rule.
        if (raw has_susp(x, id, raw SUSPEND_DEPTH())) { pass 1i32; }
        pass 0i32;
    }
    if (raw expr_is_literal_kind(n.kind)) { pass 0i32; }

    if (!(raw has_susp(x, id, raw SUSPEND_DEPTH()))) {
        // A non-literal evaluated with the suspension still ahead.
        drop fe_err(x,
            "an `await` is the first evaluation its statement performs (D-178): everything before it must be a bare literal — bind the await first (`T:t = relay await f(…);`) and compute from `t`",
            n.span);
        pass 2i32;
    }

    // The suspension is inside this node: descend in evaluation order.
    if (n.kind == ExprKind.ExprCallExpr) {
        int32:st2 = st;
        ExprNode:cal = raw ast_expr(x.ast, raw expr_callee(n));
        if (cal.kind != ExprKind.ExprIdentifierExpr) {
            st2 = raw fe_walk(x, raw expr_callee(n), st2, fuel - 1i32);
        }
        pass (raw fe_walk_window(x, (raw expr_list_start(n))
                  + (raw expr_generic_count(n)),
                  (raw expr_list_count(n)) - (raw expr_generic_count(n)),
                  st2, fuel));
    }
    if (n.kind == ExprKind.ExprBuiltinExpr) {
        pass (raw fe_walk_window(x, (raw expr_list_start(n))
                  + (raw builtin_generic_count(n)),
                  (raw expr_list_count(n)) - (raw builtin_generic_count(n)),
                  st, fuel));
    }
    if (n.kind == ExprKind.ExprStructLiteralExpr) {
        int32:st3 = st;
        int32:cnt = raw expr_list_count(n);
        int32:i = 1i32;
        while (i < cnt) {
            st3 = raw fe_walk(x, ExprId{ index: raw ast_id_at(x.ast,
                      raw expr_list_start(n), i) }, st3, fuel - 1i32);
            i = i + 2i32;
        }
        pass st3;
    }
    int32:shape = raw expr_shape(n.kind);
    if (shape == (raw EXPR_SHAPE_LIST())) {
        pass (raw fe_walk_window(x, raw expr_list_start(n),
                  raw expr_list_count(n), st, fuel));
    }
    if (shape == (raw EXPR_SHAPE_NONE()))   { pass st; }
    if (shape == (raw EXPR_SHAPE_CUSTOM())) { pass st; }
    int32:st4 = raw fe_walk(x, raw expr_lhs(n), st, fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_ONE())) { pass st4; }
    if (shape == (raw EXPR_SHAPE_ONELIST())) {
        pass (raw fe_walk_window(x, raw expr_list_start(n),
                  raw expr_list_count(n), st4, fuel));
    }
    st4 = raw fe_walk(x, raw expr_rhs(n), st4, fuel - 1i32);
    if (shape == (raw EXPR_SHAPE_TWO())) { pass st4; }
    pass (raw fe_walk(x, raw expr_third(n), st4, fuel - 1i32));
};

func:fe_walk_window = int32(Suspend->:x, int32:start, int32:count, int32:st,
                            int32:fuel) never fails {
    int32:s2 = st;
    int32:i = 0i32;
    while (i < count) {
        s2 = raw fe_walk(x, ExprId{ index: raw ast_id_at(x.ast, start, i) },
                         s2, fuel - 1i32);
        i = i + 1i32;
    }
    pass s2;
};

// One statement position's rule: nothing to say unless it suspends.
func:check_first_eval = NIL(Suspend->:x, ExprId:root) never fails {
    if (raw expr_is_none(root)) { pass NIL; }
    if (!(raw has_susp(x, root, raw SUSPEND_DEPTH()))) { pass NIL; }
    int32:st = raw fe_walk(x, root, 0i32, raw SUSPEND_DEPTH());
    if (st == 0i32) {
        // has_susp saw a suspension fe_walk never reached — a shape hole in
        // this rule's own walk. Fail closed, the walk's standing posture.
        ExprNode:rn = raw ast_expr(x.ast, root);
        drop suspend_err(x,
            "this statement suspends somewhere the first-evaluation walk cannot see, so the rule cannot be checked",
            rn.span);
    }
    pass NIL;
};

// The assignment form: a value that suspends writes through a BARE NAME —
// a field or element target computes its address before the suspension.
func:check_first_eval_assign = NIL(Suspend->:x, StmtNode:s) never fails {
    ExprId:val = raw stmt_assigned(s);
    if (raw expr_is_none(val)) { pass NIL; }
    if (!(raw has_susp(x, val, raw SUSPEND_DEPTH()))) { pass NIL; }
    ExprId:tgt = raw stmt_target(s);
    if (!(raw expr_is_none(tgt))) {
        ExprNode:tn = raw ast_expr(x.ast, tgt);
        if (tn.kind != ExprKind.ExprIdentifierExpr) {
            drop fe_err(x,
                "an assignment whose value suspends writes through a bare name (D-178): a field or element target computes its address before the suspension — bind the await first, then store",
                tn.span);
            pass NIL;
        }
    }
    drop check_first_eval(x, val);
    pass NIL;
};
