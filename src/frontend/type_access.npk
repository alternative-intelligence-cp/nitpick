// Reaching into a value — member access, indexing, and calls.
//
// Subset 1 (meta/SUBSET_1.md). Cycle 0.4.5.
//
// `.` IS THE ONLY MEMBER OPERATOR (D-006). `->` is type-position only, because
// member access brings data *toward* the reader and an away-pointing arrow
// contradicted the operation it named. One spelling, and it auto-dereferences.
//
// **AUTO-DEREFERENCE IS ONE LEVEL ONLY** (D-098). `p.x` where `p` is `Point->`
// works; `pp.x` where `pp` is `Point->->` is an error telling the reader to write
// the dereference. A rule that peeled until it found a struct would make the
// number of indirections invisible at the use site, and in a language where
// direction is deliberately spelled out that is the wrong trade.

use "./source_location.npk".*;
use "./intern.npk".*;
use "./token_kind.npk".*;
use "./ast_kind.npk".*;
use "./ast.npk".*;
use "./diagnostics.npk".*;
use "./type_codes.npk".*;
use "./types.npk".*;
use "./type_names.npk".*;
use "./parse_expr.npk".*;
use "./parse_decl.npk".*;
use "./symbols.npk".*;
use "./resolve_type.npk".*;
use "./type_layout.npk".*;
use "./type_decl.npk".*;
use "./type_expr.npk".*;
use "./expr_types.npk".*;
use "./type_trait.npk".*;
use "./type_generic.npk".*;

// --- the dispatcher ----------------------------------------------------------------------
//
// `type_of_expr` hands every access form here. The two modules `use` each other,
// which D-086 makes legal — the loader collects all declarations before resolving
// any body, so a cycle among modules resolves rather than being an ordering
// puzzle for whoever writes the next one.
pub func:type_access = int32(ExprTyper->:e, ExprId:id, ExprNode:n) {
    if (n.kind == ExprKind.ExprMemberAccessExpr) {
        pass (relay type_member_access(e, n, false));
    }
    if (n.kind == ExprKind.ExprSafeNavExpr) {
        pass (relay type_member_access(e, n, true));
    }
    if (n.kind == ExprKind.ExprIndexExpr)      { pass (relay type_index(e, n)); }
    if (n.kind == ExprKind.ExprCallExpr)       { pass (relay type_call(e, n)); }
    if (n.kind == ExprKind.ExprMethodCallExpr) { pass (relay type_method_call(e, id, n)); }
    pass 0i32;
};

// --- auto-dereference ------------------------------------------------------------------

// The base of a member access, with AT MOST ONE pointer peeled.
//
// Returning the peeled type and reporting the second level separately keeps the
// two questions apart: "what does this access reach" and "did the writer say how
// far". A single function answering both would have to guess which error to give.
pub func:access_base = int32(ExprTyper->:e, int32:t, Span:at) {
    if ((raw type_kind(e.types, t)) != (raw TY_POINTER())) { pass t; }
    int32:inner = raw type_elem(e.types, t);
    if ((raw type_kind(e.types, inner)) == (raw TY_POINTER())) {
        string:m1 = relay string_concat("`.` dereferences one level, and this is `",
                                        relay type_display(e.types, e.interns, t));
        string:m2 = relay string_concat(m1,
            "`; write `<-` for the outer one so the indirection is visible");
        drop te_error(e, raw TYPE_MISMATCH(), m2, at);
        pass 0i32;
    }
    // An `any->` is type-erased, so there is nothing to reach into.
    if ((raw type_kind(e.types, inner)) == (raw TY_ANY())) {
        drop te_error(e, raw TYPE_MISMATCH(),
            "`any->` is type-erased and has no members; cast it to a concrete pointer first",
            at);
        pass 0i32;
    }
    pass inner;
};

// --- member access ---------------------------------------------------------------------

pub func:type_member_access = int32(ExprTyper->:e, ExprNode:n, bool:safe_nav) {
    // A BASE THAT NAMES A NAMESPACE RATHER THAN A VALUE — `Net.Disconnect` and
    // `math.sqrt`. These are the SAME NODE as `p.x` in the AST, and 0.3.5 left
    // them alone precisely because telling them apart needs the base's meaning,
    // which is what this subcycle supplies.
    //
    // It has to be asked BEFORE the base is typed as a value: `Net` is an enum
    // name, and typing it as an expression reports "`Net` is a type, not a
    // value" — correct in general and wrong here, where a type name is exactly
    // what belongs.
    if (!safe_nav) {
        NsAccess:ns = relay namespace_member(e, n);
        if (ns.handled) { pass (ns.type_id); }
    }

    int32:raw_base = relay type_of_expr(e, raw expr_operand(n));
    if (raw_base == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, raw_base)) { pass 0i32; }

    // `?.` SHORT-CIRCUITS ON ABSENCE, so its base is an `Optional<T>` and its
    // result is an `Optional<U>` — the absence has to survive the access or the
    // operator would be `.` with extra characters.
    int32:base = raw_base;
    bool:optional = false;
    if (safe_nav) {
        if ((raw type_kind(e.types, base)) != (raw TY_OPTIONAL())) {
            string:m1 = relay string_concat("`?.` needs an `Optional`, and this is `",
                                            relay type_display(e.types, e.interns, base));
            string:m2 = relay string_concat(m1, "`; `.` is the plain access");
            pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
        }
        base = raw type_elem(e.types, base);
        optional = true;
    }

    base = relay access_base(e, base, n.span);
    if (base == 0i32) { pass 0i32; }

    int32:name = n.payload =>! int32;
    int32:found = relay member_type(e, base, name, n.span);
    if (found == 0i32) { pass 0i32; }
    if (optional) {
        // A MEMBER THAT IS ITSELF AN `Optional` IS NOT WRAPPED TWICE. `op?.f`
        // where `f` is an `int32?` is an `int32?`, not an `int32??` — the two
        // absences are one absence, and both mean "there is no value here".
        //
        // Flattening is what keeps `Optional<Optional<T>>` unwritable rather than
        // merely unspellable: `resolve_type` refuses the annotation, and this is
        // the one operator that could otherwise manufacture the type behind its
        // back. The prototype hit the other side of this and left a note about it
        // — an `{ i1 true, {i1, T} }` whose outer tag says "present" while the
        // inner one says "absent", so a test reads the wrong flag and passes.
        if ((raw type_kind(e.types, found)) == (raw TY_OPTIONAL())) { pass found; }
        pass (raw tt_optional(e.types, found,
                              raw type_size(e.types, found),
                              raw type_align(e.types, found)));
    }
    pass found;
};

// WHETHER IT WAS HANDLED IS A SEPARATE ANSWER FROM WHAT IT PRODUCED.
//
// The first version returned a type id and treated zero as "not a namespace" —
// so a variant that did not exist reported its own error, returned zero, and
// then fell through to the value path, which reported a second one about `Net`
// being a type. Two diagnostics for one mistake, and the second one misleading.
// The same `whether` versus `which` confusion `expr_shape` and `num_width_kind`
// were built to avoid.
pub struct:NsAccess = { bool:handled; int32:type_id; };

func:ns_no = NsAccess() { NsAccess:r = NsAccess{ handled: false, type_id: 0i32 }; pass r; };
func:ns_yes = NsAccess(int32:t) { NsAccess:r = NsAccess{ handled: true, type_id: t }; pass r; };

// `Net.Disconnect` or `math.sqrt`.
func:namespace_member = NsAccess(ExprTyper->:e, ExprNode:n) {
    ExprId:b = raw expr_operand(n);
    if (raw expr_is_none(b)) { pass (raw ns_no()); }
    ExprNode:bnode = relay ast_expr(e.ast, b);
    if (bnode.kind != ExprKind.ExprIdentifierExpr) { pass (raw ns_no()); }
    if (bnode.a == 0i32) { pass (raw ns_no()); }

    Symbol:s = raw symtab_get(e.tab, bnode.a);
    if (s.origin_kind != (raw SYM_DECL())) { pass (raw ns_no()); }
    DeclId:did = DeclId{ index: s.origin };
    DeclNode:d = relay ast_decl(e.ast, did);
    int32:name = n.payload =>! int32;
    TypeResolver:r = raw etyper_resolver(e);

    if (d.kind == DeclKind.DeclEnumDecl) {
        int32:et = raw tt_enum(e.types, did.index, s.name, 0i64, 1i32);
        FieldInfo:v = relay enum_variant(@r, et, name);
        if (v.found) { pass (raw ns_yes(v.type_id)); }
        // A variant that does not exist names the ENUM, not "unknown name".
        drop te_no_member(e, et, name, n.span);
        pass (raw ns_yes(0i32));
    }

    // A MODULE MEMBER. The symbol carries the scope its name opened, because a
    // `Scope` records only its parent and walking the tree for a child would
    // find every sibling block as well.
    if (d.kind == DeclKind.DeclModuleDecl) {
        if (s.inner == 0i32) { pass (raw ns_no()); }
        int32:m = raw scope_lookup_local(e.tab, s.inner, name);
        if (m == 0i32) {
            string:m1 = relay string_concat("module `",
                                            relay intern_get(e.interns, s.name));
            string:m2 = relay string_concat(m1, "` has no member `");
            string:m3 = relay string_concat(m2, relay intern_get(e.interns, name));
            drop te_error(e, raw TYPE_MISMATCH(),
                          relay string_concat(m3, "`"), n.span);
            pass (raw ns_yes(0i32));
        }
        Symbol:ms = raw symtab_get(e.tab, m);
        DeclId:mdid = DeclId{ index: ms.origin };
        DeclNode:md = relay ast_decl(e.ast, mdid);
        if (md.kind == DeclKind.DeclFunctionDecl) {
            pass (raw ns_yes(relay fn_type(@r, mdid, ms.name, e.scope)));
        }
        if (md.kind == DeclKind.DeclGlobalDecl) {
            TypeId:ty = TypeId{ index: md.a };
            pass (raw ns_yes(relay resolve_type(@r, ty, e.scope)));
        }
        pass (raw ns_yes(0i32));
    }
    pass (raw ns_no());
};

// What `.name` reaches on a base that is already a value type.
func:member_type = int32(ExprTyper->:e, int32:base, int32:name, Span:at) {
    TypeResolver:r = raw etyper_resolver(e);
    int32:k = raw type_kind(e.types, base);

    // A `Result`'s three members (0.4.4). `.is_error` is DERIVED (D-069) — there
    // is no stored field for it to disagree with.
    if (k == (raw TY_RESULT())) {
        string:f = relay intern_get(e.interns, name);
        if (raw string_eq(f, "value"))    { pass (raw type_elem(e.types, base)); }
        if (raw string_eq(f, "error"))    { pass (e.types.t_tbb32); }
        if (raw string_eq(f, "is_error")) { pass (e.types.t_bool); }
        pass (relay te_no_member(e, base, name, at));
    }

    // AN `Optional` HAS NO READABLE MEMBERS, and that is the point (D-099).
    //
    // A draft gave it `.value` and `.has_value`, mirroring the prototype's IR
    // field names. `.has_value` is redundant — `x == NIL` asks it, and two
    // spellings for one question is the thing that gets one of them wrong. And
    // `.value` is worse than redundant: reading it on an empty `Optional` is
    // exactly the unchecked access the wrapper exists to prevent, offered as a
    // one-word shortcut past `??` and `?.`, which are the accessors that cannot
    // be wrong. Neither is in the prototype's source surface either.
    if (k == (raw TY_OPTIONAL())) {
        string:f = relay intern_get(e.interns, name);
        string:g1 = relay string_concat("an `Optional` has no member `", f);
        string:g2 = relay string_concat(g1,
            "`; `?? d` takes the value or a default, `?.` reaches through it, and `== NIL` asks whether it holds anything");
        pass (relay te_error(e, raw TYPE_MISMATCH(), g2, at));
    }

    // A SLICE CARRIES ITS LENGTH; a pointer does not (D-038/D-070), which is the
    // whole reason the two are different types. `.ptr` is the data pointer,
    // typed as a pointer to the ELEMENT.
    if (k == (raw TY_SLICE())) {
        string:f = relay intern_get(e.interns, name);
        if (raw string_eq(f, "len")) { pass (raw tt_int(e.types, 64i32, true)); }
        if (raw string_eq(f, "ptr")) {
            pass (raw tt_pointer(e.types, raw type_elem(e.types, base)));
        }
        pass (relay te_no_member(e, base, name, at));
    }
    if (k == (raw TY_ARRAY())) {
        string:f = relay intern_get(e.interns, name);
        if (raw string_eq(f, "len")) { pass (raw tt_int(e.types, 64i32, true)); }
        pass (relay te_no_member(e, base, name, at));
    }
    // A STRING'S THREE FIELDS (`{ptr, len, cap}`), and a `cstring`'s two — the
    // members the compiler's own sources read on every line that walks bytes
    // (`s.ptr[i]`), and which only `.len` of had a rule until 0.7.8. The bytes
    // are `uint8`: a code unit is 0..255, and a signed byte would make half of
    // every encoding negative.
    if (k == (raw TY_STRING())) {
        string:f = relay intern_get(e.interns, name);
        if (raw string_eq(f, "len")) { pass (raw tt_int(e.types, 64i32, true)); }
        if (raw string_eq(f, "cap")) { pass (raw tt_int(e.types, 64i32, true)); }
        if (raw string_eq(f, "ptr")) {
            pass (raw tt_pointer(e.types, raw tt_int(e.types, 8i32, false)));
        }
        pass (relay te_no_member(e, base, name, at));
    }
    if (k == (raw TY_CSTRING())) {
        string:f = relay intern_get(e.interns, name);
        if (raw string_eq(f, "len")) { pass (raw tt_int(e.types, 64i32, true)); }
        if (raw string_eq(f, "ptr")) {
            pass (raw tt_pointer(e.types, raw tt_int(e.types, 8i32, false)));
        }
        pass (relay te_no_member(e, base, name, at));
    }

    if (k == (raw TY_STRUCT())) {
        FieldInfo:fi = relay struct_field(@r, base, name, e.scope);
        if (fi.found) { pass (fi.type_id); }
        pass (relay te_no_member(e, base, name, at));
    }

    // `Net.Disconnect` — AN ENUM VARIANT, and identical in the AST to
    // `math.sqrt`. They are told apart HERE, by what the base resolved to, which
    // is exactly what 0.3.5 deferred to this subcycle.
    if (k == (raw TY_ENUM())) {
        FieldInfo:v = relay enum_variant(@r, base, name);
        if (v.found) { pass (v.type_id); }
        pass (relay te_no_member(e, base, name, at));
    }

    pass (relay te_no_member(e, base, name, at));
};

// The message NAMES THE TYPE the member was sought on. "no member `x`" leaves the
// reader to work out which of a chain's several types was being asked.
func:te_no_member = int32(ExprTyper->:e, int32:base, int32:name, Span:at) {
    string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, base));
    string:m2 = relay string_concat(m1, "` has no member `");
    string:m3 = relay string_concat(m2, relay intern_get(e.interns, name));
    pass (relay te_error(e, raw TYPE_MISMATCH(),
                         relay string_concat(m3, "`"), at));
};

// --- indexing --------------------------------------------------------------------------

// `a[i]` on an array, a slice, or a pointer. The BOUNDS CHECK is a runtime
// obligation the backend emits; what this decides is the element type and that
// the index is an integer.
//
// A POINTER IS INDEXABLE AND CARRIES NO LENGTH (D-038), so `p[i]` cannot be
// bounds-checked and is the one indexing form that is unchecked. That is why
// slices exist and why a slice is the type a function should take.
pub func:type_index = int32(ExprTyper->:e, ExprNode:n) {
    int32:base = relay type_of_expr(e, raw expr_lhs(n));

    int32:saved = e.expected;
    e.expected = raw tt_int(e.types, 64i32, true);
    int32:idx = relay type_of_expr(e, raw expr_rhs(n));
    e.expected = saved;

    // `arr[lo...hi]` — RANGING an array or a slice yields a SLICE over the same
    // element (D-070), not an element. Until 0.7.8 this fell through the integer
    // check and typed as the ELEMENT, so `int32[]:view = fixed_arr[0i64...4i64];`
    // — a conformance file the seed compiles — was a type error here.
    if (idx != 0i32) {
        if ((raw type_kind(e.types, idx)) == (raw TY_RANGE())) {
            if (base == 0i32) { pass 0i32; }
            int32:bk = raw type_kind(e.types, base);
            if (bk == (raw TY_ARRAY())) {
                pass (raw tt_slice(e.types, raw type_elem(e.types, base)));
            }
            if (bk == (raw TY_SLICE())) { pass base; }
            string:r1 = relay string_concat("`",
                            relay type_display(e.types, e.interns, base));
            pass (relay te_error(e, raw TYPE_MISMATCH(),
                      relay string_concat(r1, "` cannot be ranged"), n.span));
        }
    }

    if (idx != 0i32) {
        if (!(raw type_is_invalid(e.types, idx))) {
            if (!(raw type_is_integer(e.types, idx))) {
                string:m1 = relay string_concat("an index must be an integer, and this is `",
                                                relay type_display(e.types, e.interns, idx));
                drop te_error(e, raw TYPE_MISMATCH(),
                              relay string_concat(m1, "`"), n.span);
            }
        }
    }

    if (base == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, base)) { pass 0i32; }
    int32:k = raw type_kind(e.types, base);
    if (k == (raw TY_ARRAY()))   { pass (raw type_elem(e.types, base)); }
    if (k == (raw TY_SLICE()))   { pass (raw type_elem(e.types, base)); }
    if (k == (raw TY_POINTER())) { pass (raw type_elem(e.types, base)); }

    string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, base));
    string:m2 = relay string_concat(m1, "` cannot be indexed");
    pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
};

// --- calls -----------------------------------------------------------------------------

pub func:type_call = int32(ExprTyper->:e, ExprNode:n) {
    int32:callee = relay type_of_expr(e, raw expr_callee(n));
    int32:gcount = raw expr_generic_count(n);
    int32:start = (raw expr_list_start(n)) + gcount;
    int32:count = (raw expr_list_count(n)) - gcount;

    // A GENERIC CALL IS SUBSTITUTED BEFORE IT IS CHECKED. The generic arguments
    // were parsed, stored, and SKIPPED -- `start` steps over them -- so
    // `extract::<int32>(c)` checked as though the turbofish were not there and
    // `extract(c)` returned `T` rather than the type it was called with.
    DeclNode:d = relay callee_decl(e, n);
    if (d.kind == DeclKind.DeclFunctionDecl) {
        IdSpan:gp = raw decl_generic_window(e.ast, d);
        if (gp.count > 0i32) {
            pass (relay type_generic_call(e, n, d, gp, callee, gcount, start, count));
        }
        // NOT GENERIC AND GIVEN ARGUMENTS ANYWAY. The turbofish names type
        // arguments, so a function with no type parameters has nowhere to put
        // them -- and silently ignoring them is how this behaved until now.
        if (gcount > 0i32) {
            drop te_error(e, raw TYPE_GENERIC_ARITY(),
                "this function is not generic, so it takes no type arguments",
                n.span);
        }
    }

    if (callee == 0i32) {
        // `arena_make(cap)` READS ITS ARENA TYPE FROM CONTEXT (D-152), the way
        // an unsuffixed literal reads its width (D-092): the annotation names
        // `arena<T>`, and the element's layout is what the lowering needs.
        // With no arena context it is an error here, not a silent nothing.
        if (relay callee_is_builtin_named(e, n, "shared_arena_make")) {
            drop type_args_only(e, start, count);
            int32:swant = raw expected_value(e);
            if (swant != 0i32) {
                if ((raw type_kind(e.types, swant)) == (raw TY_SHARED_ARENA())) {
                    pass swant;
                }
            }
            pass (relay te_error(e, raw TYPE_UNKNOWN(),
                "`shared_arena_make` needs a `shared_arena<T>` annotation to read its element type from",
                n.span));
        }
        if (relay callee_is_builtin_named(e, n, "arena_make")) {
            drop type_args_only(e, start, count);
            int32:want = raw expected_value(e);
            if (want != 0i32) {
                if ((raw type_kind(e.types, want)) == (raw TY_ARENA())) {
                    pass want;
                }
            }
            pass (relay te_error(e, raw TYPE_UNKNOWN(),
                "`arena_make` needs an `arena<T>` annotation to read its element type from; write `arena<T>:a = arena_make(cap);`",
                n.span));
        }
        // A bare-name builtin has no signature yet. Its arguments are still
        // typed, so a mistake inside one is not hidden by the callee being
        // unknown.
        drop type_args_only(e, start, count);
        pass 0i32;
    }
    if (raw type_is_invalid(e.types, callee)) { pass 0i32; }

    // `Net.Disconnect(reason)` — A VARIANT CONSTRUCTOR, not a function call.
    // The member access types as the ENUM (a variant's type IS its enum), so
    // this arrived at "`Net` is not a function" — and TYPE_REFERENCE §9.3's own
    // construction syntax had no rule anywhere: `pick` could take a payload
    // apart, and nothing could put one together. Found by the BACKEND's first
    // real programs (0.7.7), not by a frontend test — every enum fixture in the
    // suite either had no payloads or only ever destructured them.
    if ((raw type_kind(e.types, callee)) == (raw TY_ENUM())) {
        pass (relay type_variant_ctor(e, n, callee, start, count));
    }
    if (!(raw type_is_func(e.types, callee))) {
        drop type_args_only(e, start, count);
        string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, callee));
        string:m2 = relay string_concat(m1, "` is not a function");
        pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    pass (relay check_args(e, callee, start, count, 0i32, n.span));
};

// A variant constructor: the callee is `Enum.Variant`, the variant carries a
// payload, and the call's arguments are the payload's values. The whole
// expression is the ENUM — a variant is never a type of its own (D-090's
// companion rule in `type_layout.npk`).
func:type_variant_ctor = int32(ExprTyper->:e, ExprNode:n, int32:enum_ty,
                               int32:start, int32:count) {
    ExprNode:cnode = relay ast_expr(e.ast, raw expr_callee(n));
    if (cnode.kind != ExprKind.ExprMemberAccessExpr) {
        drop type_args_only(e, start, count);
        string:m1 = relay string_concat("`",
                        relay type_display(e.types, e.interns, enum_ty));
        pass (relay te_error(e, raw TYPE_MISMATCH(),
                  relay string_concat(m1, "` is not a function"), n.span));
    }
    pass (relay type_ctor_named(e, n, enum_ty, cnode.payload =>! int32,
                                start, count));
};

func:type_ctor_named = int32(ExprTyper->:e, ExprNode:n, int32:enum_ty,
                             int32:vname, int32:start, int32:count) {
    DeclId:did = DeclId{ index: raw type_decl(e.types, enum_ty) };
    DeclNode:d = relay ast_decl(e.ast, did);
    int32:i = 0i32;
    while (i < (raw item_member_count(e.ast, d))) {
        DeclNode:m = relay ast_decl(e.ast, raw item_member(e.ast, d, i));
        if (m.kind == DeclKind.DeclEnumVariant) {
            if ((raw decl_name(m)) == vname) {
                pass (relay check_ctor_args(e, n, enum_ty, m, start, count));
            }
        }
        i = i + 1i32;
    }
    drop type_args_only(e, start, count);
    string:m1 = relay string_concat("`",
                    relay type_display(e.types, e.interns, enum_ty));
    pass (relay te_error(e, raw TYPE_UNKNOWN(),
              relay string_concat(m1, "` has no variant by this name"), n.span));
};

func:check_ctor_args = int32(ExprTyper->:e, ExprNode:n, int32:enum_ty,
                             DeclNode:v, int32:start, int32:count) {
    int32:want = raw variant_payload_count(v);
    if (count != want) {
        string:m1 = relay string_concat("this variant carries ",
                        raw int_to_string(want => int64));
        string:m2 = relay string_concat(m1, " payload value(s) and this passes ");
        drop te_error(e, raw TYPE_MISMATCH(),
            relay string_concat(m2, raw int_to_string(count => int64)), n.span);
        drop type_args_only(e, start, count);
        pass enum_ty;
    }
    TypeResolver:r = raw etyper_resolver(e);
    // The payload's type resolves in the ENUM's home scope — the declaration
    // means what it meant where it was written (0.8.1).
    int32:home = raw symtab_home_scope(e.tab, raw type_decl(e.types, enum_ty),
                                       e.scope);
    int32:i = 0i32;
    while (i < count) {
        int32:pt = relay resolve_type(@r,
                       TypeId{ index: relay ast_id_at(e.ast,
                                   raw variant_payload_start(v), i) },
                       home);
        int32:saved = e.expected;
        e.expected = pt;
        int32:at = relay type_of_expr(e, ExprId{ index: relay ast_id_at(e.ast,
                                          start, i) });
        e.expected = saved;
        if (at != 0i32) {
            if (!(raw type_is_invalid(e.types, at))) {
                if (!(raw fits(e, pt, at))) {
                    drop te_mismatch(e, n.span, pt, at);
                }
            }
        }
        i = i + 1i32;
    }
    pass enum_ty;
};

// WHICH DECLARATION IS BEING CALLED, when one can be named at all.
//
// ONLY AN IDENTIFIER CAN BE GENERIC. A function VALUE cannot be — monomorphization
// produces one body per instantiation and a code address is one body (D-018,
// D-087) — so a callee that is any other expression has no type parameters by
// construction, and this hands back the NONE declaration rather than guessing.
// The callee's DECLARATION INDEX — what `callee_decl` looks up on the way to the
// node, returned as itself because an instantiation is keyed by the declaration
// (D-108/D-156), not by a node copy. 0 when there is none.
func:callee_decl_index = int32(ExprTyper->:e, ExprNode:n) {
    ExprId:c = raw expr_callee(n);
    if (raw expr_is_none(c)) { pass 0i32; }
    ExprNode:cnode = relay ast_expr(e.ast, c);
    if (cnode.kind != ExprKind.ExprIdentifierExpr) { pass 0i32; }
    if (cnode.a == 0i32) { pass 0i32; }
    Symbol:s = raw symtab_get(e.tab, cnode.a);
    if (s.origin_kind != (raw SYM_DECL())) { pass 0i32; }
    pass (s.origin);
};

func:callee_decl = DeclNode(ExprTyper->:e, ExprNode:n) {
    ExprId:c = raw expr_callee(n);
    if (raw expr_is_none(c)) { pass (relay ast_decl(e.ast, raw decl_none())); }
    ExprNode:cnode = relay ast_expr(e.ast, c);
    if (cnode.kind != ExprKind.ExprIdentifierExpr) {
        pass (relay ast_decl(e.ast, raw decl_none()));
    }
    if (cnode.a == 0i32) { pass (relay ast_decl(e.ast, raw decl_none())); }
    Symbol:s = raw symtab_get(e.tab, cnode.a);
    if (s.origin_kind != (raw SYM_DECL())) {
        pass (relay ast_decl(e.ast, raw decl_none()));
    }
    DeclId:did = DeclId{ index: s.origin };
    pass (relay ast_decl(e.ast, did));
};

// --- a generic call (TRAITS_REFERENCE 3.3, D-064 section 3) -------------------------------
//
// THREE STEPS, AND THE ORDER IS THE DESIGN:
//
//   1. EXPLICIT ARGUMENTS FIRST. The turbofish is the only expression-position
//      form (D-064), and what it supplies is not inferred.
//   2. INFERENCE FILLS THE REST, from the arguments that have a type of their
//      own. Nothing is written at the overwhelming majority of call sites (3.3),
//      so this is the normal path rather than the fallback.
//   3. THE SIGNATURE IS SUBSTITUTED AND THEN CHECKED like any other. The body is
//      NOT re-checked -- it was checked once at its definition -- so what happens
//      here is only that the arguments satisfy the bounds and fill the parameters.
func:type_generic_call = int32(ExprTyper->:e, ExprNode:n, DeclNode:d, IdSpan:gp,
                               int32:generic_ft, int32:gcount, int32:start,
                               int32:count) {
    if (gcount > gp.count) {
        string:m1 = relay string_concat("this call supplies ",
                                        raw int_to_string(gcount => int64));
        string:m2 = relay string_concat(m1, " type argument(s) and the function takes ");
        drop te_error(e, raw TYPE_GENERIC_ARITY(),
            relay string_concat(m2, raw int_to_string(gp.count => int64)), n.span);
    }

    // THE SOLUTION SET IS A WINDOW, one slot per parameter, zero for unsolved.
    // Reserved first and filled in afterwards, which is exactly what
    // `ast_scratch_set` exists for -- a count of things not yet known.
    TypeResolver:r = raw etyper_resolver(e);
    int32:mark = raw ast_scratch_mark(e.ast);
    int32:i = 0i32;
    while (i < gp.count) {
        drop ast_scratch_push(e.ast, 0i32);
        i = i + 1i32;
    }

    int32:gstart = raw expr_list_start(n);
    int32:j = 0i32;
    while (j < gcount) {
        if (j < gp.count) {
            TypeId:a = TypeId{ index: relay ast_id_at(e.ast, gstart, j) };
            DeclId:gpid = DeclId{ index: relay ast_id_at(e.ast, gp.start, j) };
            drop ast_scratch_set(e.ast, mark, j,
                relay resolve_one_arg(@r, a, gpid, e.scope));
        }
        j = j + 1i32;
    }

    drop infer_from_args(e, @r, n, gp, generic_ft, mark, start, count);

    IdSpan:args = raw ast_scratch_commit(e.ast, mark);
    GenericScope:g = GenericScope{ params_start: gp.start, params_count: gp.count,
                                   args_start: args.start, args_count: args.count };

    // EVERY PARAMETER MUST BE SOLVED, and an unsolved one ENDS THE CHECK.
    //
    // Carrying on would check the call against a signature still mentioning `T` —
    // a different signature from the one being called — and every argument and
    // the return would then be reported as not fitting a type the programmer
    // never wrote. One cause, three diagnostics, two of them misleading. Returning
    // the invalid type here is the same discipline `resolve_type` follows and for
    // the same reason.
    //
    // NOTHING IS LEFT UNTYPED BY STOPPING. Inference already typed every argument
    // that has a type of its own; the ones it skipped are the context-dependent
    // ones, which have nothing to be checked against precisely because `T` is
    // unknown.
    if (!(relay all_solved(e, d, gp, args, n.span))) { pass 0i32; }

    // AND EVERY SOLVED ARGUMENT MUST SATISFY ITS BOUNDS -- the same check, from
    // the same function, that an annotation gets. A call and a type annotation
    // refusing the same thing for different reasons would be two rules.
    int32:k = 0i32;
    while (k < args.count) {
        DeclId:gpid = DeclId{ index: relay ast_id_at(e.ast, gp.start, k) };
        drop check_arg_bounds(e.impls, e.bounds, @r,
                              relay ast_id_at(e.ast, args.start, k), gpid, d,
                              n.span);
        k = k + 1i32;
    }

    int32:ft = relay type_subst(@r, generic_ft, g, n.span, 64i32);
    if (ft == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, ft)) { pass 0i32; }
    if (!(raw type_is_func(e.types, ft))) { pass 0i32; }

    // RECORD THE INSTANTIATION (1.0.2b). Every argument is solved and bound-
    // checked by here, and the window is committed into the AST's id pool, so it
    // outlives this call — which is what lets the emitter walk the set. Deduped
    // by (declaration, arguments), D-108's rule applied to functions.
    drop fninst_record(e.fninsts, e.ast, relay callee_decl_index(e, n),
                       args.start, args.count, gp.start, gp.count, 0i32, ft,
                       n.span);

    pass (relay check_args(e, ft, start, count, 0i32, n.span));
};

// SOLVE WHAT THE ARGUMENTS SAY, and nothing else.
//
// AN ARGUMENT THAT TAKES ITS TYPE FROM CONTEXT IS SKIPPED, and that is a rule
// rather than an omission: an unsuffixed literal takes its type FROM the
// parameter it fills, so it cannot also supply it. Typing one here would report
// "this literal has no width suffix" at a call whose only problem is that
// inference has nothing to go on -- and the honest message for that is that `T`
// could not be inferred.
//
// The consequence is stated plainly because it is visible to programmers:
// `identity(5)` needs `identity::<int32>(5)`. `identity(x)` does not.
func:infer_from_args = NIL(ExprTyper->:e, TypeResolver->:r, ExprNode:n,
                           IdSpan:gp, int32:generic_ft, int32:mark,
                           int32:start, int32:count) {
    if (!(raw type_is_func(e.types, generic_ft))) { pass NIL; }
    int32:np = raw type_param_count_of(e.types, generic_ft);
    int32:i = 0i32;
    while (i < count) {
        if (i < np) {
            ExprId:a = ExprId{ index: relay ast_id_at(e.ast, start, i) };
            if (!(raw takes_type_from_context(e, a))) {
                int32:saved = e.expected;
                e.expected = 0i32;
                int32:got = relay type_of_expr(e, a);
                e.expected = saved;
                if (got != 0i32) {
                    drop unify_into(e, raw type_param_at_of(e.ast, e.types, generic_ft, i),
                                    got, gp, mark, 32i32);
                }
            }
        }
        i = i + 1i32;
    }
    pass NIL;
};

// MATCH A DECLARED PARAMETER TYPE AGAINST AN ACTUAL ARGUMENT TYPE, structurally,
// writing whatever it learns into the solution window.
//
// IT LEARNS NOTHING WHERE THE SHAPES DISAGREE, and reports nothing either. A
// genuine mismatch is the argument check's to report, against the SUBSTITUTED
// signature, where the message can name both types; complaining here would name
// `T` and be useless.
//
// FIRST WRITING WINS. `f(a, b)` where both parameters are `T` and the two
// arguments differ leaves `T` as the first one, and the second argument is then
// reported as not fitting -- which is the mismatch, at the argument that caused
// it, rather than an inference failure the reader cannot locate.
func:unify_into = NIL(ExprTyper->:e, int32:declared, int32:actual, IdSpan:gp,
                      int32:mark, int32:fuel) {
    if (fuel <= 0i32) { pass NIL; }
    if (declared == 0i32) { pass NIL; }
    if (actual == 0i32) { pass NIL; }
    int32:k = raw type_kind(e.types, declared);

    if (k == (raw TY_PARAM())) {
        int32:decl = raw type_decl_of(e.types, declared);
        int32:i = 0i32;
        while (i < gp.count) {
            if ((relay ast_id_at(e.ast, gp.start, i)) == decl) {
                if ((relay ast_scratch_at(e.ast, mark, i)) == 0i32) {
                    drop ast_scratch_set(e.ast, mark, i, actual);
                }
                pass NIL;
            }
            i = i + 1i32;
        }
        pass NIL;
    }

    if (k != (raw type_kind(e.types, actual))) { pass NIL; }

    // THE ONE-OPERAND SHAPES. `T->` against `Point->` teaches `T = Point`, and so
    // does `T[]` against `Point[]`, `T?`, `Result<T>` and a fixed array.
    if (k == (raw TY_POINTER()))  { drop unify_elem(e, declared, actual, gp, mark, fuel); pass NIL; }
    if (k == (raw TY_SLICE()))    { drop unify_elem(e, declared, actual, gp, mark, fuel); pass NIL; }
    if (k == (raw TY_ARRAY()))    { drop unify_elem(e, declared, actual, gp, mark, fuel); pass NIL; }
    if (k == (raw TY_OPTIONAL())) { drop unify_elem(e, declared, actual, gp, mark, fuel); pass NIL; }
    if (k == (raw TY_RESULT()))   { drop unify_elem(e, declared, actual, gp, mark, fuel); pass NIL; }

    // AN INSTANCE TEACHES THROUGH ITS ARGUMENTS -- `Container<T>` against
    // `Container<int32>` is where inference earns its keep, since it is the shape
    // §3.3's own example uses. THE DECLARATIONS MUST MATCH: `Container<T>` against
    // `Wrapper<int32>` is a mismatch, not a lesson.
    if (raw same_instance_decl(e, declared, actual)) {
        int32:n = raw type_args_count_of(e.types, declared);
        if (n != (raw type_args_count_of(e.types, actual))) { pass NIL; }
        // NOT `as` — a keyword, and a keyword is not an identifier.
        int32:ds = raw type_args_start_of(e.types, declared);
        int32:actual_start = raw type_args_start_of(e.types, actual);
        int32:i = 0i32;
        while (i < n) {
            drop unify_into(e, relay ast_id_at(e.ast, ds, i),
                            relay ast_id_at(e.ast, actual_start, i),
                            gp, mark, fuel - 1i32);
            i = i + 1i32;
        }
    }
    pass NIL;
};

func:unify_elem = NIL(ExprTyper->:e, int32:declared, int32:actual, IdSpan:gp,
                      int32:mark, int32:fuel) {
    drop unify_into(e, raw type_elem(e.types, declared),
                    raw type_elem(e.types, actual), gp, mark, fuel - 1i32);
    pass NIL;
};

func:same_instance_decl = bool(ExprTyper->:e, int32:a, int32:b) {
    int32:k = raw type_kind(e.types, a);
    if (k != (raw TY_STRUCT())) {
        if (k != (raw TY_ENUM())) {
            if (k != (raw TY_TRAIT())) { pass false; }
        }
    }
    if ((raw type_args_count_of(e.types, a)) == 0i32) { pass false; }
    pass ((raw type_decl_of(e.types, a)) == (raw type_decl_of(e.types, b)));
};

func:all_solved = bool(ExprTyper->:e, DeclNode:d, IdSpan:gp, IdSpan:args,
                       Span:at) {
    bool:ok = true;
    int32:i = 0i32;
    while (i < gp.count) {
        int32:solved = 0i32;
        if (i < args.count) { solved = relay ast_id_at(e.ast, args.start, i); }
        if (solved == 0i32) {
            ok = false;
            DeclId:gpid = DeclId{ index: relay ast_id_at(e.ast, gp.start, i) };
            DeclNode:gpn = relay ast_decl(e.ast, gpid);
            string:m1 = relay string_concat("`",
                            relay intern_get(e.interns, raw decl_name(gpn)));
            string:m2 = relay string_concat(m1, "` cannot be inferred from this call to `");
            string:m3 = relay string_concat(m2,
                            relay intern_get(e.interns, raw decl_name(d)));
            drop te_error(e, raw TYPE_CANNOT_INFER(),
                relay string_concat(m3,
                    "`; write it with the turbofish, which is the only expression-position form for an explicit type argument (D-064)"),
                at);
        }
        i = i + 1i32;
    }
    pass ok;
};

// `p.magnitude()` — UFCS (D-006). The receiver is already apart from the callee
// in the AST (0.2.8), which is what makes this a LOOKUP rather than a rewrite:
// the method name is resolved as an ordinary function and the receiver becomes
// its first argument.
pub func:type_method_call = int32(ExprTyper->:e, ExprId:id, ExprNode:n) {
    // `Ev.Move(5i32)` PARSES AS A METHOD CALL — the parser folds `.name(` into
    // one node deliberately — so a VARIANT CONSTRUCTOR arrives here, not at
    // `type_call`. The receiver is an identifier naming an enum DECLARATION,
    // which no value receiver can be, so the two cannot be confused.
    ExprNode:rn = relay ast_expr(e.ast, raw expr_operand(n));
    if (rn.kind == ExprKind.ExprIdentifierExpr) {
        if (rn.a != 0i32) {
            Symbol:rs = raw symtab_get(e.tab, rn.a);
            if (rs.origin_kind == (raw SYM_DECL())) {
                DeclNode:rd = relay ast_decl(e.ast, DeclId{ index: rs.origin });
                if (rd.kind == DeclKind.DeclEnumDecl) {
                    int32:ety = raw tt_enum(e.types, rs.origin, rs.name, 0i64, 1i32);
                    pass (relay type_ctor_named(e, n, ety, n.payload =>! int32,
                              raw expr_list_start(n), raw expr_list_count(n)));
                }
            }
        }
    }

    int32:recv = relay type_of_expr(e, raw expr_operand(n));
    // NO `expr_generic_count` HERE. That accessor reads the payload, and on a
    // method call the payload is the METHOD NAME — so asking for a generic count
    // returns an intern index and slices the argument window by it. A method
    // call's window holds arguments and nothing else.
    int32:start = raw expr_list_start(n);
    int32:count = raw expr_list_count(n);

    if (recv == 0i32) { pass 0i32; }
    if (raw type_is_invalid(e.types, recv)) { pass 0i32; }

    // THE SAME ONE-LEVEL AUTO-DEREFERENCE plain access gets (D-098). `q.magnitude()`
    // where `q` is `Point->` is the same operation as `q.x`, and a method call
    // that did not peel would make `.` mean two different things one character
    // apart — exactly the context-dependence the blueprint philosophy forbids.
    recv = relay access_base(e, recv, n.span);
    if (recv == 0i32) { pass 0i32; }

    int32:name = n.payload =>! int32;

    // THE ARENA'S OWN OPERATIONS (D-017, D-152) — six methods the TYPE
    // carries, dispatched before any impl lookup the way a slice's `.len` is
    // a fact about slices: no impl block could lawfully claim these names on
    // `arena<T>`, and a user method shadowing `free` on the allocator type is
    // exactly the confusion this ordering forecloses.
    if ((raw type_kind(e.types, recv)) == (raw TY_ARENA())) {
        pass (relay type_arena_method(e, n, recv, name, start, count));
    }
    if ((raw type_kind(e.types, recv)) == (raw TY_SHARED_ARENA())) {
        pass (relay type_sarena_method(e, n, recv, name, start, count));
    }

    // AN `impl` METHOD IS FOUND THROUGH THE TYPE, NOT THROUGH THE SCOPE. This is
    // asked first, and until 0.4.6 it was not asked at all: an `impl` declares
    // nothing at module scope, so the lookup below could only ever reach a
    // module-level free function. UFCS worked, and worked only for the one form
    // the spec does not put methods in.
    int32:did_index = 0i32;
    MethodFind:found = relay find_method(e.impls, e.bounds, e.types, e.ast,
                                         e.interns, recv, name, e.self_trait);
    if (found.ambiguous) {
        string:a1 = relay string_concat("`", relay intern_get(e.interns, name));
        string:a2 = relay string_concat(a1, "` comes from both `");
        string:a3 = relay string_concat(a2,
                        relay type_display(e.types, e.interns, found.owner));
        string:a4 = relay string_concat(a3, "` and `");
        string:a5 = relay string_concat(a4,
                        relay type_display(e.types, e.interns, found.other));
        pass (relay te_error(e, raw TYPE_AMBIGUOUS_METHOD(),
            relay string_concat(a5, "`; call the one you mean by its function form"),
            n.span));
    }
    if (found.found) { did_index = found.decl; }

    // A FREE FUNCTION IS STILL A METHOD. UFCS is what makes `p.magnitude()` and
    // `magnitude(p)` the same call (D-006), so the scope lookup stays — it is the
    // second place to look rather than the only one.
    //
    // A GENERIC PARAMETER DOES NOT GET IT. `T` satisfies its bounds and nothing
    // else, and a free function taking a `T` is not a capability `T` declares —
    // it is a capability the surrounding module happens to have written, which is
    // exactly the duck typing D-064 §1 removes. The receiver's bounds are the
    // whole answer, so a miss there is a miss.
    bool:opaque_recv = ((raw type_kind(e.types, recv)) == (raw TY_PARAM()));
    if (did_index == 0i32) {
        int32:sym = 0i32;
        if (!opaque_recv) { sym = raw scope_lookup(e.tab, e.scope, name); }
        if (sym == 0i32) {
            // THE MESSAGE NAMES THE TYPE IT WAS SOUGHT ON. "unknown function
            // `magnitude`" would send the reader looking for a free function when
            // what they wrote was a method call.
            //
            // AND FOR A PARAMETER IT NAMES THE BOUNDS, because the fix is one of
            // two things and the reader has to be told which: either the call is
            // wrong, or the bound list is missing the trait that declares it.
            string:m1 = relay string_concat("`", relay type_display(e.types, e.interns, recv));
            string:m2 = relay string_concat(m1, "` has no method `");
            string:m3 = relay string_concat(m2, relay intern_get(e.interns, name));
            string:m4 = relay string_concat(m3, "`");
            if (opaque_recv) {
                m4 = relay string_concat(m4, relay bounds_note(e, recv));
            }
            pass (relay te_error(e, raw TYPE_NO_METHOD(), m4, n.span));
        }
        Symbol:s = raw symtab_get(e.tab, sym);
        did_index = s.origin;
    }

    // THE RESOLVED CALLEE, RECORDED (1.0.3). The emitter cannot repeat this
    // lookup — it holds neither the impl table nor the bound table, and a second
    // copy of the resolution is a second answer waiting to drift from this one.
    // Recorded on the expression, the same key its type is recorded under.
    drop exprtypes_set_callee(e.expr_types, id, did_index);

    // AND THE SYMBOL IT IS EMITTED UNDER (1.0.5b). D-156's amendment makes a
    // method's symbol carry its impl, and the two facts that takes — the
    // RECEIVER's type and the owning TRAIT — are both here and in neither table
    // the emitter holds. A trait DEFAULT is one declaration emitted once per
    // implementing impl, so the declaration alone could never have said which
    // body a call meant; the receiver is what separates them.
    //
    // ONLY WHEN AN IMPL SUPPLIED IT. `found.owner_impl` of 0 is the
    // free-function case the scope lookup below answers, and a free function
    // keeps its own name.
    // AND THE TRAIT IT CAME THROUGH (1.0.6b), for the case the name above cannot
    // cover: a receiver that is a generic PARAMETER has no concrete type here, so
    // the emitter substitutes it and combines the two.
    drop exprtypes_set_callee_trait(e.expr_types, id, found.owner);

    if (found.owner_impl != 0i32) {
        drop exprtypes_set_callee_sym(e.expr_types, id,
            raw intern_add(e.interns,
                relay method_symbol_name(e.types, e.interns, recv, found.owner,
                    relay intern_get(e.interns, name))));
    }

    DeclId:did = DeclId{ index: did_index };
    DeclNode:d = relay ast_decl(e.ast, did);
    if (d.kind != DeclKind.DeclFunctionDecl) {
        string:m1 = relay string_concat("`", relay intern_get(e.interns, name));
        string:m2 = relay string_concat(m1, "` is not a function");
        pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    TypeResolver:r = raw etyper_resolver(e);

    // `Self` IN A METHOD'S SIGNATURE IS THE RECEIVER'S TYPE, and this is where the
    // resolver is told so. A trait declares its methods in terms of `Self` and
    // nothing else — `func:cmp = int32(Self:self, Self:other)` — so a signature
    // resolved without it reports "`Self` is valid only inside a `trait` or
    // `impl` body" at a call site that is inside neither and is perfectly correct.
    //
    // It was reachable before 0.4.7 through an impl method written with `Self`,
    // and nothing exercised it; the bound path cannot avoid it, since a bound's
    // method declaration is ALWAYS the trait's.
    //
    // ONLY WHEN THE METHOD CAME THROUGH A TYPE. A free function found by scope
    // lookup is not a member of anything, so `Self` in one is the error it was.
    if (found.found) { r.self_type = recv; }

    // A BLANKET IMPL'S METHOD IS WRITTEN IN TERMS OF ITS PARAMETER, so the
    // parameter is bound to the receiver before the signature is read.
    // `impl:<T: Pr>:Lo = { func:l = int32(T:self) … }` called on a `Point` has
    // `T = Point`, and without saying so `T` resolves to "there is no type named
    // `T`" at a call site nowhere near the declaration.
    //
    // ONLY THE FIRST PARAMETER IS BOUND, because only the first is the target —
    // the window is one entry long and `generic_bind_in` leaves anything past its
    // end opaque, which is the right answer for a parameter the receiver does not
    // determine.
    // A GENERIC TRAIT'S PARAMETERS ARE BOUND FROM THE BOUND THAT NAMED IT
    // (1.0.6b). `func:twice<P: Producer<int32>>` calling `p.make()` reads
    // `Producer`'s declaration, where the method is `func:make = T(Self:self)` —
    // and `T` belongs to the TRAIT, not to this function. Without binding it,
    // `T` was looked up among the caller's own parameters, missed, and reported
    // as "there is no type named `T`" AT THE TRAIT'S DECLARATION, lines away
    // from the call that caused it.
    //
    // `check_signature` has always done this for the impl side (D-111); this is
    // the same binding on the call side, from the same function, because it is
    // the same question — what does this trait's parameter stand for here.
    if (found.found) {
        if ((raw type_args_count_of(e.types, found.owner)) > 0i32) {
            r.enclosing = relay trait_binding(@r, found.owner);
        }
    }

    if (found.blanket_impl != 0i32) {
        r.enclosing = relay bind_blanket(e, found.blanket_impl, recv);
    }
    int32:ft = relay fn_type(@r, did, name, e.scope);

    // A FAMILY IMPL'S METHOD IS A TEMPLATE, SO THE CALL IS AN INSTANTIATION
    // REQUEST (1.0.4b). `impl:<T>:Box<T>:Sized2`'s `width` is one body per `T`,
    // exactly as a generic function is one body per argument set — so it is
    // recorded in the SAME table (`FnInstTable`), deduped the same way, and the
    // emitter walks the one set. The arguments are the receiver's own, which
    // `bind_blanket` just committed into the id pool.
    if (found.blanket_impl != 0i32) {
        if (!(raw type_is_none(raw impl_target(e.ast,
                 relay ast_decl(e.ast, DeclId{ index: found.blanket_impl }))))) {
            drop fninst_record(e.fninsts, e.ast, did_index,
                               r.enclosing.args_start, r.enclosing.args_count,
                               r.enclosing.params_start,
                               r.enclosing.params_count, found.blanket_impl,
                               ft, n.span);
        }
    }

    // THE RECEIVER IS THE FIRST PARAMETER, so it is checked as one — and a method
    // whose first parameter is a different type is a method of that type instead,
    // which the arity/type check below says plainly.
    if ((raw type_param_count_of(e.types, ft)) == 0i32) {
        string:m1 = relay string_concat("`", relay intern_get(e.interns, name));
        string:m2 = relay string_concat(m1,
            "` takes no parameters, so it cannot be called as a method");
        pass (relay te_error(e, raw TYPE_MISMATCH(), m2, n.span));
    }
    int32:p0 = raw type_param_at_of(e.ast, e.types, ft, 0i32);
    if (recv != p0) {
        drop te_mismatch_at(e, p0, recv, n.span);
    }
    pass (relay check_args(e, ft, start, count, 1i32, n.span));
};

// Arity and argument types. `skip` is 1 for a UFCS call, whose first parameter
// the receiver already filled.
//
// TWO ARITY RULES, and which one applies comes from the callee's KIND rather than
// from a flag somebody has to remember to read (D-100). A fixed function takes
// exactly its parameter count; a variadic one takes at least its fixed count and
// checks everything after that against the collected element type.
func:check_args = int32(ExprTyper->:e, int32:ft, int32:start, int32:count,
                        int32:skip, Span:at) {
    bool:variadic = raw type_is_variadic(e.types, ft);
    int32:total = (raw type_param_count_of(e.types, ft)) - skip;

    // The variadic parameter is the LAST entry of the window and is a parameter
    // like any other, so the fixed count is one short of the total. `element` is
    // what each trailing argument is checked against — the slice's element, since
    // the argument is one item and the parameter collects many.
    int32:fixed_count = total;
    int32:element = 0i32;
    int32:collector = 0i32;
    if (variadic) {
        fixed_count = total - 1i32;
        collector = raw type_param_at_of(e.ast, e.types, ft, fixed_count + skip);
        if (!(raw type_is_invalid(e.types, collector))) {
            element = raw type_elem(e.types, collector);
        }
    }

    // BOTH COUNTS ARE NAMED. "wrong number of arguments" makes the reader go and
    // count the parameters themselves, which is the one thing the compiler
    // already did.
    bool:arity_ok = (count == total);
    if (variadic) { arity_ok = (count >= fixed_count); }
    if (!arity_ok) {
        string:m1 = relay string_concat("this call passes ",
                                        raw int_to_string(count => int64));
        string:m2 = relay string_concat(m1, " argument(s) and the function takes ");
        if (variadic) {
            m2 = relay string_concat(m2, "at least ");
            m2 = relay string_concat(m2, raw int_to_string(fixed_count => int64));
        } else {
            m2 = relay string_concat(m2, raw int_to_string(total => int64));
        }
        drop te_error(e, raw TYPE_MISMATCH(), m2, at);
    }

    int32:i = 0i32;
    while (i < count) {
        ExprId:a = ExprId{ index: raw ast_id_at(e.ast, start, i) };

        // `..^coll` EXPANDS A COLLECTION INTO THE VARIADIC TAIL, so it is the one
        // argument checked against the collector rather than the element — it
        // supplies the whole slice, not one item. 0.4.2 typed the spread as its
        // operand and left the position to here, which is the only place an
        // argument list exists to check it against.
        bool:spread = raw is_spread(e, a);
        int32:pt = 0i32;
        if (i < fixed_count) {
            pt = raw type_param_at_of(e.ast, e.types, ft, i + skip);
        } else {
            if (variadic) {
                pt = element;
                if (spread) { pt = collector; }
            }
        }

        int32:saved = e.expected;
        e.expected = pt;
        int32:got = relay type_of_expr(e, a);
        e.expected = saved;

        if (spread) {
            drop check_spread_position(e, ft, variadic, i, fixed_count, count, at);
        }

        if (pt != 0i32) {
            if (got != 0i32) {
                if (!(raw type_is_invalid(e.types, got))) {
                    // `fits`, so an `int32?` parameter accepts a bare `int32`
                    // argument the same way an `int32?` declaration does (D-099).
                    // One rule for every slot; a call that differed from an
                    // initialiser would be one more thing to remember.
                    //
                    // THE ARGUMENT'S SPAN, NOT THE CALL'S. It points at the thing
                    // that is wrong, which is worth doing on its own — and it is
                    // also what keeps two bad arguments two diagnostics. Reported
                    // at the call, `vsum(1i32, 2i32, 3i32)` produced the same
                    // code, span and message twice, so identical-diagnostic
                    // deduplication folded the second away and the reader was told
                    // about one of two mistakes.
                    if (!(raw fits(e, pt, got))) {
                        drop te_mismatch_at(e, pt, got, relay arg_span(e, a, at));
                    }
                }
            }
        }
        i = i + 1i32;
    }
    // THE CALL'S TYPE IS `Result<success>` (D-069), for a named callee and a
    // function value alike — the func TYPE stores the success slot (0.9.6),
    // and the wrap happens here, once, the same place the arguments were held
    // to the same one rule.
    int32:succ = raw type_elem(e.types, ft);
    pass (raw tt_result(e.types, succ, raw type_size(e.types, succ),
                        raw type_align(e.types, succ)));
};

// The blanket impl's parameter window, bound to the receiver.
// Bind a parameterised impl's own parameters for a call on `recv`. TWO SHAPES,
// told apart by whether the impl wrote a target (1.0.4b):
//
//   BLANKET  `impl:<T: Printable>:Loggable` — no target, so the single
//            parameter IS the receiver: `T` = `Point`.
//   FAMILY   `impl:<T>:Box<T>:Sized2` — a target of its own, so the parameters
//            are the receiver's own type ARGUMENTS: `Box<int32>` binds
//            `T` = `int32`, positionally.
//
// The family case takes the arguments positionally rather than unifying the
// target's shape against the receiver's, which is right for the form the
// grammar admits — `Box<T>` with the declaration's parameters in order. A
// target like `Box<Pair<T, U>>` would need real unification, and that is a
// decision to raise rather than to guess at here; the positional read is exact
// for what can be written today and refuses nothing that used to work.
func:bind_blanket = GenericScope(ExprTyper->:e, int32:impl_decl, int32:recv) {
    DeclId:bid = DeclId{ index: impl_decl };
    DeclNode:bd = relay ast_decl(e.ast, bid);
    IdSpan:pw = raw decl_generic_window(e.ast, bd);
    int32:mark = raw ast_scratch_mark(e.ast);

    if (raw type_is_none(raw impl_target(e.ast, bd))) {
        drop ast_scratch_push(e.ast, recv);
    } else {
        int32:rargs = raw type_args_start_of(e.types, recv);
        int32:rn = raw type_args_count_of(e.types, recv);
        int32:i = 0i32;
        while (i < rn) {
            drop ast_scratch_push(e.ast, relay ast_id_at(e.ast, rargs, i));
            i = i + 1i32;
        }
    }

    IdSpan:aw = raw ast_scratch_commit(e.ast, mark);
    GenericScope:g = GenericScope{ params_start: pw.start, params_count: pw.count,
                                   args_start: aw.start, args_count: aw.count };
    pass g;
};

// An argument's own span, falling back to the call's when the argument is the
// NONE node — a missing argument has no place of its own, and the call is where
// the reader would look for it.
func:arg_span = Span(ExprTyper->:e, ExprId:id, Span:at) {
    if (raw expr_is_none(id)) { pass at; }
    pass ((relay ast_expr(e.ast, id)).span);
};

pub func:is_spread = bool(ExprTyper->:e, ExprId:id) {
    if (raw expr_is_none(id)) { pass false; }
    ExprNode:n = relay ast_expr(e.ast, id);
    pass (n.kind == ExprKind.ExprSpreadExpr);
};

// WHERE A SPREAD IS ALLOWED TO SIT (D-026, D-100). It expands a collection into
// the variadic tail, so there has to be a tail to expand into, it has to be in
// it, and it has to be the last thing there — arguments written after an
// expansion have no position anyone can name.
func:check_spread_position = NIL(ExprTyper->:e, int32:ft, bool:variadic,
                                 int32:i, int32:fixed_count, int32:count, Span:at) {
    if (!variadic) {
        string:m1 = relay string_concat("`..^` expands a collection into a variadic parameter, and `",
                                        relay type_display(e.types, e.interns, ft));
        drop te_error(e, raw TYPE_MISMATCH(),
            relay string_concat(m1, "` collects none; pass the elements, or give the function a `..*T[]` parameter"),
            at);
        pass NIL;
    }
    if (i < fixed_count) {
        drop te_error(e, raw TYPE_MISMATCH(),
            "`..^` expands into the variadic parameter, and this argument fills a fixed one",
            at);
        pass NIL;
    }
    if (i != (count - 1i32)) {
        drop te_error(e, raw TYPE_MISMATCH(),
            "`..^` expands to however many elements the collection holds, so nothing can follow it — an argument after an expansion has no position to be in",
            at);
    }
    pass NIL;
};

// Type the arguments and nothing else, for a callee with no signature to check
// against. A mistake inside an argument is still worth reporting.
func:type_args_only = NIL(ExprTyper->:e, int32:start, int32:count) {
    int32:i = 0i32;
    while (i < count) {
        ExprId:a = ExprId{ index: raw ast_id_at(e.ast, start, i) };
        drop type_of_expr(e, a);
        i = i + 1i32;
    }
    pass NIL;
};

// One parameter type out of a function type's window.
pub func:type_param_at_of = int32(Ast->:ast, TypeTable->:t, int32:ft, int32:i) {
    pass (raw ast_id_at(ast, raw type_param_start_of(t, ft), i));
};

// WHAT A PARAMETER IS ACTUALLY ALLOWED TO DO, appended to the diagnostic that
// says it cannot do this. A generic body may use exactly what its bounds declare
// (D-064 §1), so "`T` has no method `render`" leaves the reader one question: what
// DOES it have. Answering it in the same sentence is the difference between a
// diagnostic that ends the search and one that starts it.
func:bounds_note = string(ExprTyper->:e, int32:param) {
    BoundEntry:b = relay bound_entry_of(e.bounds, raw type_decl_of(e.types, param));
    if (b.count == 0i32) {
        pass "; it declares no bounds, and a generic body may use only what its bounds declare — there is no duck typing (D-064)";
    }
    string:m = "; its bounds are `";
    int32:i = 0i32;
    while (i < b.count) {
        if (i > 0i32) { m = relay string_concat(m, " & "); }
        m = relay string_concat(m,
                relay type_display(e.types, e.interns,
                                   relay ast_id_at(e.ast, b.start, i)));
        i = i + 1i32;
    }
    pass (relay string_concat(m,
        "`, and a generic body may use only what its bounds declare (D-064)"));
};

pub func:te_mismatch_at = NIL(ExprTyper->:e, int32:want, int32:got, Span:at) {
    string:m1 = relay string_concat("expected `",
                                    relay type_display(e.types, e.interns, want));
    string:m2 = relay string_concat(m1, "`, found `");
    string:m3 = relay string_concat(m2, relay type_display(e.types, e.interns, got));
    drop te_error(e, raw TYPE_MISMATCH(),
                  relay string_concat(m3, "`"), at);
    pass NIL;
};

// Is this call's callee the bare builtin `name`? (A builtin resolves to no
// symbol, which is what tells it apart from a user function wearing the name.)
func:callee_is_builtin_named = bool(ExprTyper->:e, ExprNode:n, string:name) {
    ExprId:c = raw expr_callee(n);
    if (raw expr_is_none(c)) { pass false; }
    ExprNode:cnode = relay ast_expr(e.ast, c);
    if (cnode.kind != ExprKind.ExprIdentifierExpr) { pass false; }
    if (cnode.a != 0i32) { pass false; }
    pass (raw string_eq(relay intern_get(e.interns, raw expr_name(cnode) =>! int32),
                        name));
};

// `a.alloc()` / `a.get(h)` / `a.put(h, v)` / `a.free(h)` / `a.reset()` /
// `a.destroy()` — the arena operation set (D-017 as amended by D-152: `put`
// joins; `get` COPIES the element out, because a borrow-returning `get`
// would be a returned borrow, which D-004 refuses for everything else and an
// exemption here would be meaning-by-context).
//
// alloc  ()                -> Handle<T>      cannot fail as a value: growth
//                                            that fails is an OOM trap
// get    (Handle<T>)       -> Result<T>      stale handle -> error -4106
// put    (Handle<T>, T)    -> Result<NIL>    stale handle -> error -4106
// free   (Handle<T>)       -> Result<NIL>    stale handle -> error -4106
// reset  ()                -> NIL            invalidates every handle
// destroy()                -> NIL            consumes the arena (a move,
//                                            enforced by the binding analysis)
func:type_arena_method = int32(ExprTyper->:e, ExprNode:n, int32:recv,
                               int32:name, int32:start, int32:count) {
    string:m = relay intern_get(e.interns, name);
    int32:elem = (raw tt_get(e.types, recv)).a;
    // Every operation takes the arena's ADDRESS, so the receiver must be a
    // place — an arena returned by a call has no home to allocate into.
    drop require_place_operand(e, raw expr_operand(n), "an arena operation");

    if (raw string_eq(m, "alloc")) {
        if (count != 0i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`alloc` takes no arguments; the arena knows its element type", n.span));
        }
        pass (raw tt_handle(e.types, elem));
    }
    if (raw string_eq(m, "get")) {
        if (count != 1i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`get` takes exactly one argument, the handle", n.span));
        }
        drop want_handle_of(e, elem, ExprId{ index: raw ast_id_at(e.ast, start, 0i32) });
        pass (raw tt_result(e.types, elem, raw type_size(e.types, elem),
                            raw type_align(e.types, elem)));
    }
    if (raw string_eq(m, "put")) {
        if (count != 2i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`put` takes exactly two arguments, the handle and the value", n.span));
        }
        drop want_handle_of(e, elem, ExprId{ index: raw ast_id_at(e.ast, start, 0i32) });
        int32:saved = e.expected;
        e.expected = elem;
        int32:got = relay type_of_expr(e, ExprId{ index: raw ast_id_at(e.ast, start, 1i32) });
        e.expected = saved;
        if (got != 0i32) {
            if (!(raw type_is_invalid(e.types, got))) {
                if (!(raw fits(e, elem, got))) {
                    drop te_mismatch(e, n.span, elem, got);
                }
            }
        }
        pass (raw tt_result(e.types, e.types.t_nil, 0i64, 1i32));
    }
    if (raw string_eq(m, "free")) {
        if (count != 1i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`free` takes exactly one argument, the handle", n.span));
        }
        drop want_handle_of(e, elem, ExprId{ index: raw ast_id_at(e.ast, start, 0i32) });
        pass (raw tt_result(e.types, e.types.t_nil, 0i64, 1i32));
    }
    if (raw string_eq(m, "reset")) {
        if (count != 0i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`reset` takes no arguments", n.span));
        }
        pass (e.types.t_nil);
    }
    if (raw string_eq(m, "destroy")) {
        if (count != 0i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`destroy` takes no arguments", n.span));
        }
        pass (e.types.t_nil);
    }
    string:m1 = relay string_concat("`", m);
    pass (relay te_error(e, raw TYPE_MISMATCH(),
        relay string_concat(m1,
            "` is not an arena operation; the set is alloc, get, put, free, reset, destroy (D-017, D-152)"),
        n.span));
};

// The argument must be a Handle whose element is THIS arena's element — a
// handle from an `arena<int32>` names nothing in an `arena<int64>`.
func:want_handle_of = NIL(ExprTyper->:e, int32:elem, ExprId:arg) {
    int32:want = raw tt_handle(e.types, elem);
    int32:saved = e.expected;
    e.expected = want;
    int32:got = relay type_of_expr(e, arg);
    e.expected = saved;
    if (got == 0i32) { pass NIL; }
    if (raw type_is_invalid(e.types, got)) { pass NIL; }
    if (!(raw fits(e, want, got))) {
        ExprNode:an = relay ast_expr(e.ast, arg);
        drop te_mismatch(e, an.span, want, got);
    }
    pass NIL;
};

// `s.alloc(v)` / `s.get(h)` / `s.destroy()` — the shared arena's set (D-017,
// D-154). Deliberately SMALLER than `arena<T>`'s, and different in one
// signature: `alloc` CARRIES THE VALUE, because there is no `put` — a slot
// is written once, before its handle escapes, and is immutable after, which
// is what makes concurrent `get` race-free with no per-slot machinery. The
// receiver is a VALUE (one pointer, shareable by reference), so no place is
// required.
func:type_sarena_method = int32(ExprTyper->:e, ExprNode:n, int32:recv,
                                int32:name, int32:start, int32:count) {
    string:m = relay intern_get(e.interns, name);
    int32:elem = (raw tt_get(e.types, recv)).a;

    if (raw string_eq(m, "alloc")) {
        if (count != 1i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "a shared arena's `alloc` takes exactly one argument, the value — there is no `put`, so the slot is written once, here (D-154)",
                n.span));
        }
        int32:saved = e.expected;
        e.expected = elem;
        int32:got = relay type_of_expr(e, ExprId{ index: raw ast_id_at(e.ast, start, 0i32) });
        e.expected = saved;
        if (got != 0i32) {
            if (!(raw type_is_invalid(e.types, got))) {
                if (!(raw fits(e, elem, got))) {
                    drop te_mismatch(e, n.span, elem, got);
                }
            }
        }
        pass (raw tt_handle(e.types, elem));
    }
    if (raw string_eq(m, "get")) {
        if (count != 1i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`get` takes exactly one argument, the handle", n.span));
        }
        drop want_handle_of(e, elem, ExprId{ index: raw ast_id_at(e.ast, start, 0i32) });
        pass (raw tt_result(e.types, elem, raw type_size(e.types, elem),
                            raw type_align(e.types, elem)));
    }
    if (raw string_eq(m, "destroy")) {
        if (count != 0i32) {
            pass (relay te_error(e, raw TYPE_GENERIC_ARITY(),
                "`destroy` takes no arguments", n.span));
        }
        pass (e.types.t_nil);
    }
    string:m1 = relay string_concat("`", m);
    pass (relay te_error(e, raw TYPE_MISMATCH(),
        relay string_concat(m1,
            "` is not a shared-arena operation; the set is alloc, get, destroy — no `free`, no `reset`, no `put`: slots are never reused or rewritten while the arena is live, which is the whole concurrency contract (D-017, D-154)"),
        n.span));
};
