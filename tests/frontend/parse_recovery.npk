// Parser diagnostics and recovery (cycle 0.2.7).
//
// Recovery is the property that cannot be checked by reading the code. A parser
// that stops at the first error reports one problem per run, so fixing a file
// becomes one compile per mistake. A parser that recovers BADLY is worse than one
// that stops: it emits a cascade of phantoms after the real error and the reader
// cannot tell which diagnostic is the cause.
//
// So the assertions here are COUNTS and CODES. "Three errors produced exactly
// three diagnostics" is the whole claim, and it is the one that fails loudly when
// panic mode or resynchronisation breaks.

mod:parse_recovery;
use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_type.npk".*;
use "../../src/frontend/parse_expr.npk".*;
use "../../src/frontend/parse_decorate.npk".*;
use "../../src/frontend/parse_stmt.npk".*;
use "../../src/frontend/parse_pick.npk".*;
use "../../src/frontend/parse_decl.npk".*;

// Parse a whole module and return only how many diagnostics came out. The count
// IS the assertion for most of what follows, so it gets a name.
func:parse_module_text = int64(string:src, InternTable->:it) never fails {
    DiagList:lexed = raw diaglist_init();
    TokenList:toks = raw lex_all(0i32, src, it, @lexed);
    Ast:ast = raw ast_init();
    DiagList:diags = raw diaglist_init();
    Parser:p = raw parser_init(@toks, @ast, @diags, it);
    discard(raw p_parse_module(@p));
    pass (raw diaglist_count(@diags));
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();

    // --- a clean file reports nothing -------------------------------------------
    // Asserted first, because every count below is only meaningful if zero is
    // reachable at all.
    string:clean = "func:main = int32(cstring[]:_~argv) { int32:x = 1i32; exit 0i32; };";
    if ((raw parse_module_text(clean, @it)) != 0i64)          { exit 10i32; }

    // --- three independent errors, three diagnostics ------------------------------
    // Each function is broken in a different way and the good one between them
    // must survive. If recovery stopped early this reports fewer; if it cascaded
    // it reports more.
    string:e1 = string_concat(
        "func:a = int32() { int32:x = ; exit 0i32; };\n",
        "func:b = int32() { exit 0i32; };\n");
    string:three = string_concat(e1,
        "func:c = int32() { int32:y 5i32; exit 0i32; };\nfunc:d = int32() { int32:z = ; };\n");
    int64:n3 = raw parse_module_text(three, @it);
    if (n3 != 3i64)                                           { exit 11i32; }

    // --- one error region, ONE diagnostic ------------------------------------------
    // Panic mode exists for this: a single mistake must not produce a diagnostic
    // per token until the parser happens to resynchronise.
    string:one = "func:a = int32() { int32:x = ; exit 0i32; };";
    if ((raw parse_module_text(one, @it)) != 1i64)            { exit 12i32; }

    // A longer run of garbage after one mistake is still ONE error region.
    string:garbage = "func:a = int32() { int32:x = ) ) ) ) ) ; exit 0i32; };";
    if ((raw parse_module_text(garbage, @it)) > 2i64)         { exit 13i32; }

    // --- the parser always terminates ------------------------------------------------
    // A rule that consumes nothing would loop forever. Recovery guarantees
    // progress, and reaching this line at all is the assertion.
    string:hostile = "{{{{{ ((((( ,,,,, ))))) }}}}}";
    discard(raw parse_module_text(hostile, @it));
    string:hostile2 = "func:a = int32() { pick ( { , ( ) } };";
    discard(raw parse_module_text(hostile2, @it));

    // --- codes, and the spans that go with them ----------------------------------------
    // Every code in parse_codes.npk is reachable. A code nothing can emit is dead
    // weight that a reader has to work out is dead.
    DiagList:d1 = raw diaglist_init();
    TokenList:t1 = raw lex_all(0i32, "a = b = 5i32;", @it, @d1);
    Ast:a1 = raw ast_init();
    DiagList:g1 = raw diaglist_init();
    Parser:p1 = raw parser_init(@t1, @a1, @g1, @it);
    discard(raw p_parse_stmt(@p1));
    if (!(raw string_eq((raw diaglist_at(@g1, 0i64)).code, raw PARSE_ASSIGN_EXPR()))) {
        exit 20i32;
    }

    // PARSE_UNCLOSED points at the OPENING brace, not at end of file -- the one
    // place the mistake certainly is not.
    DiagList:d2 = raw diaglist_init();
    TokenList:t2 = raw lex_all(0i32, "func:a = int32() { exit 0i32;", @it, @d2);
    Ast:a2 = raw ast_init();
    DiagList:g2 = raw diaglist_init();
    Parser:p2 = raw parser_init(@t2, @a2, @g2, @it);
    discard(raw p_parse_module(@p2));
    if (raw diaglist_count(@g2) == 0i64)                      { exit 21i32; }
    Diagnostic:unclosed = raw diaglist_at(@g2, 0i64);
    if (!(raw string_eq(unclosed.code, raw PARSE_UNCLOSED())))  { exit 22i32; }
    if (unclosed.span.col != 18i32)                           { exit 23i32; }

    DiagList:d3 = raw diaglist_init();
    TokenList:t3 = raw lex_all(0i32, "pick (x) { () { f(); } }", @it, @d3);
    Ast:a3 = raw ast_init();
    DiagList:g3 = raw diaglist_init();
    Parser:p3 = raw parser_init(@t3, @a3, @g3, @it);
    discard(raw p_parse_stmt(@p3));
    if (raw diaglist_count(@g3) == 0i64)                      { exit 24i32; }
    if (!(raw string_eq((raw diaglist_at(@g3, 0i64)).code, raw PARSE_BAD_PATTERN()))) {
        exit 25i32;
    }

    // A type where a pattern belongs is its own message, because "expected an
    // expression" would be true and useless.
    DiagList:d4 = raw diaglist_init();
    TokenList:t4 = raw lex_all(0i32, "pick (x) { (int32) { f(); } }", @it, @d4);
    Ast:a4 = raw ast_init();
    DiagList:g4 = raw diaglist_init();
    Parser:p4 = raw parser_init(@t4, @a4, @g4, @it);
    discard(raw p_parse_stmt(@p4));
    if (!(raw string_eq((raw diaglist_at(@g4, 0i64)).code, raw PARSE_BAD_PATTERN()))) {
        exit 26i32;
    }

    DiagList:d5 = raw diaglist_init();
    // A contract-less extern method parses CLEAN since D-190 — the lift
    // D-149 scheduled — so what this pins is that nothing here needs
    // recovering FROM anymore.
    TokenList:t5 = raw lex_all(0i32,
        "extern:\"libc\" = { func:puts = int32(int8->:s); };", @it, @d5);
    Ast:a5 = raw ast_init();
    DiagList:g5 = raw diaglist_init();
    Parser:p5 = raw parser_init(@t5, @a5, @g5, @it);
    discard(raw p_parse_decl(@p5));
    if (raw diaglist_count(@g5) != 0i64) {
        exit 27i32;
    }

    DiagList:d6 = raw diaglist_init();
    TokenList:t6 = raw lex_all(0i32, "pick (x) { (!) { f(); } }", @it, @d6);
    Ast:a6 = raw ast_init();
    DiagList:g6 = raw diaglist_init();
    Parser:p6 = raw parser_init(@t6, @a6, @g6, @it);
    discard(raw p_parse_stmt(@p6));
    if (!(raw string_eq((raw diaglist_at(@g6, 0i64)).code,
                        raw PARSE_UNREACHABLE_MARKER()))) {
        exit 28i32;
    }

    DiagList:d7 = raw diaglist_init();
    TokenList:t7 = raw lex_all(0i32, "int32:x = ;", @it, @d7);
    Ast:a7 = raw ast_init();
    DiagList:g7 = raw diaglist_init();
    Parser:p7 = raw parser_init(@t7, @a7, @g7, @it);
    discard(raw p_parse_stmt(@p7));
    if (!(raw string_eq((raw diaglist_at(@g7, 0i64)).code, raw PARSE_UNEXPECTED()))) {
        exit 29i32;
    }

    DiagList:d8 = raw diaglist_init();
    TokenList:t8 = raw lex_all(0i32, "int32:x 5i32;", @it, @d8);
    Ast:a8 = raw ast_init();
    DiagList:g8 = raw diaglist_init();
    Parser:p8 = raw parser_init(@t8, @a8, @g8, @it);
    discard(raw p_parse_stmt(@p8));
    if (!(raw string_eq((raw diaglist_at(@g8, 0i64)).code, raw PARSE_EXPECTED()))) {
        exit 30i32;
    }

    // --- the diagnostic list is bounded ---------------------------------------------------
    // A file of nothing but errors must not consume memory proportional to its
    // size. The list caps and sets an overflow flag (0.1.6) rather than growing.
    string:many = "func:a = int32() { int32:x = ; };";
    int64:i = 0i64;
    while (i < 8i64) {
        many = string_concat(many, "func:b = int32() { int32:y = ; };");
        i = i + 1i64;
    }
    int64:capped = raw parse_module_text(many, @it);
    if (capped > 256i64)                                      { exit 40i32; }

    wild_release_all();

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (intern.BoundsId) { exit 1i32; },
        (ast.BoundsId) { exit 1i32; },
        (diagnostics.BoundsId) { exit 1i32; },
        (source.FileUnknown) { exit 1i32; },
        (source.BoundsIndex) { exit 1i32; },
        (source.BoundsOffset) { exit 1i32; },
        (types.BoundsId) { exit 1i32; },
        (types.BoundsIndex) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (BoundsId) { exit 1i32; },
        (BoundsScratch) { exit 1i32; },
        (BoundsWindow) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
