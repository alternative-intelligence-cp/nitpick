// Exercises the diagnostics core (cycle 0.0.6): the list, its dedup and its
// bound, the span sort, and since 1.0.8 the ONE formatter every driver prints
// through -- `diag_line`, asserted here and nowhere else.
//
// THE WALK IS NOT HERE. `diag_report` (diag_writer.npk) is what writes these
// lines out, and it is tested where it can be driven for real -- as a program
// with an async `main`, `tests/backend/programs/diag_capture.npk`, which lends
// the walk a `Sink` and reads the bytes back: the capture-and-compare D-075
// designed (D-229). This file stays SYNCHRONOUS and imports no async module,
// so its `failsafe` names only what can reach it.
//
// THE RENDERED LINE IS ASSERTED HERE AND NOWHERE ELSE. The harness's readers
// discard everything but code, line and column — codes are stable identifiers
// and wording must stay free to improve — so this is the one place a rendered
// string exists to check. It pins the SHAPE: `CODE path:line:col: message`,
// the severity word in front for a note or a warning, `<no span>` for a
// spanless diagnostic (D-162), and the overflow note the walk prints.

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/source.npk".*;
use "../../src/frontend/diagnostics.npk".*;

func:main = int32(cstring[]:_~argv) {
    DiagList:list = raw diaglist_init();
    SourceManager:sm = raw srcmgr_init();
    int32:f = raw srcmgr_add(@sm, "a.npk", "func:main = int32(cstring[]:_~argv) { };");
    if (f != 0i32) { exit 10i32; }

    // Pushed OUT OF ORDER on purpose: the sort is what the walk relies on.
    Span:late  = raw span_point(0i32, 90i32, 9i32, 1i32);
    Span:early = raw span_point(0i32, 30i32, 3i32, 5i32);

    drop diaglist_push(@list, raw diag_error("NITPICK-019", "use after move", late));
    drop diaglist_push(@list, raw diag_warning("NITPICK-040", "await outside async", early));
    // A SPANLESS note (D-162): kept, never dropped.
    drop diaglist_push(@list, raw diag_note("NITPICK-001", "no span to point at", raw span_none()));
    // THE SAME MISTAKE REPORTED TWICE IS ONE MISTAKE: same code, span and
    // message is a repeat, and a repeat is dropped.
    drop diaglist_push(@list, raw diag_error("NITPICK-019", "use after move", late));

    if (raw diaglist_count(@list) != 3i64) { exit 11i32; }
    if (!(raw diaglist_has_errors(@list)))  { exit 12i32; }

    // THE SORT: by span, and a spanless diagnostic (file -1) sorts FIRST.
    drop diaglist_sort(@list);
    if ((raw diaglist_at(@list, 0i64)).severity != 0i32)   { exit 13i32; }
    if ((raw diaglist_at(@list, 1i64)).span.line != 3i32)  { exit 14i32; }
    if ((raw diaglist_at(@list, 2i64)).span.line != 9i32)  { exit 15i32; }

    // THE SHAPE, LINE BY LINE. Each part in its place: the severity word only
    // for a warning or a note, the code, the path with its line and column,
    // the separator, the message. An error carries no severity word.
    string:nt = raw diag_line(raw diaglist_at(@list, 0i64), @sm);
    if (!(raw string_eq(nt, "note NITPICK-001 <no span>: no span to point at")))  { exit 16i32; }
    string:wn = raw diag_line(raw diaglist_at(@list, 1i64), @sm);
    if (!(raw string_eq(wn, "warning NITPICK-040 a.npk:3:5: await outside async"))) { exit 17i32; }
    string:er = raw diag_line(raw diaglist_at(@list, 2i64), @sm);
    if (!(raw string_eq(er, "NITPICK-019 a.npk:9:1: use after move")))             { exit 18i32; }

    // A file the manager does not hold renders rather than failing (the same
    // rule as `<no span>`).
    Span:elsewhere = raw span_point(7i32, 0i32, 1i32, 1i32);
    string:lost = raw diag_line(raw diag_error("NITPICK-019", "x", elsewhere), @sm);
    if (!(raw string_eq(lost, "NITPICK-019 <unknown file>:1:1: x")))                 { exit 19i32; }

    // The overflow note is one fixed line, shared with the walk.
    string:ovf = raw diag_overflow_line();
    if (!(raw string_eq(ovf, "note NITPICK-DIAG-001 <no span>: further diagnostics suppressed"))) { exit 20i32; }

    // --- THE SORT DOES NOT FREE WHAT IT KEEPS (D-229's regression) ---------
    //
    // `diaglist_sort`'s early-exit branch moved an entry OUT of its slot and
    // left without putting it back, so the Diagnostic died at the loop's end
    // and dropped its two owned strings while the slot still pointed at them.
    // Every later read of that slot read freed memory.
    //
    // The three-diagnostic case above ALREADY took that branch and passed
    // anyway: nothing reused the freed bodies between the free and the read,
    // which is the same luck four other defects in this cycle ran on. This
    // phase removes the luck -- ASCENDING spans make every insertion take the
    // early exit, and the interleaved allocations give the allocator every
    // chance to hand a freed body to somebody else before it is read back.
    // NEGATIVE-CONTROLLED: exit 31 against the unfixed sort, 0 with it.
    DiagList:asc = raw diaglist_init();
    int32:ai = 0i32;
    while (ai < 12i32) {
        Span:sp = raw span_point(0i32, ai, ai + 1i32, 1i32);
        string:msg = string_concat("keepme-", int_to_string(ai => int64));
        drop diaglist_push(@asc, raw diag_error("NITPICK-019", move(msg), sp));
        // churn the heap between pushes, so a freed body gets reused
        discard(string_concat("churn", int_to_string(ai => int64)));
        ai = ai + 1i32;
    }
    if (raw diaglist_count(@asc) != 12i64) { exit 30i32; }
    drop diaglist_sort(@asc);

    // EVERY message must have survived the sort intact, and in its place.
    int32:aj = 0i32;
    while (aj < 12i32) {
        string:want = string_concat("keepme-", int_to_string(aj => int64));
        Diagnostic:dv = raw diaglist_at(@asc, aj => int64);
        if (!(raw string_eq(dv.message, want))) { exit 31i32; }
        aj = aj + 1i32;
    }

    // --- THE SINK'S SYNCHRONOUS SURFACE -------------------------------------
    //
    // The IR writer's buffer, and the walk's capture buffer through the
    // `Writer` impl diag_writer.npk gives it. The byte-level surface is pinned
    // here; the impl is exercised by the capture program.
    Sink:out = raw sink_to_buffer(4096i64);
    drop sink_write(@out, "ab");
    drop sink_write(@out, "cd");
    if (raw sink_length(@out) != 4i64)                    { exit 40i32; }
    if ((raw sink_byte_at(@out, 2i64)) != 99u8)           { exit 41i32; }   // 'c'
    if (!(raw string_eq(raw sink_view(@out), "abcd")))     { exit 42i32; }
    Sink:other = raw sink_to_buffer(64i64);
    drop sink_write(@other, "ef");
    drop sink_append(@out, @other);
    if (!(raw string_eq(raw sink_view(@out), "abcdef")))   { exit 43i32; }
    drop sink_reset(@out);
    if (raw sink_length(@out) != 0i64)                    { exit 44i32; }

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    // Every defect family this program can die from, NAMED
    // (D-179) — the doctrine applied to ourselves. Exit 3 for
    // each: a defect in the COMPILER, never the input's error.
    pick (e) {
        (IntOverflow) { exit 3i32; },
        (HeapBadRequest) { exit 3i32; },
        (HeapOom) { exit 3i32; },
        (OutOfBounds) { exit 3i32; },
        (Unreachable) { exit 3i32; },
        (WildLeak) { exit 3i32; },
        (diagnostics.BoundsId) { exit 3i32; },
        (intern.BoundsId) { exit 3i32; },
        (intern.ProvenSlice) { exit 3i32; },
        (source.BoundsIndex) { exit 3i32; },
        (source.BoundsOffset) { exit 3i32; },
        (source.FileUnknown) { exit 3i32; },
        (*) { exit 3i32; }
    }
    exit 3i32;
};
