// Exercises the source manager and the intern table (cycle 0.1.0).

mod:source_intern;
use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/source.npk".*;
use "../../src/frontend/intern.npk".*;

func:main = int32(cstring[]:_~argv) {
    // --- #size_of matches what llc lays out --------------------------------
    // A hand-rolled size that disagrees with LLVM's survives testing and
    // corrupts memory later, so this is asserted rather than assumed.
    if (#size_of<int32>() != 4i64)  { exit 10i32; }
    if (#size_of<int64>() != 8i64)  { exit 11i32; }
    if (#size_of<Span>() != 20i64)  { exit 12i32; }   // five int32s

    // --- source manager ----------------------------------------------------
    SourceManager:sm = raw srcmgr_init();

    int32:a = raw srcmgr_add(@sm, "a.npk", "func:main = int32(cstring[]:_~argv) { };");
    int32:b = raw srcmgr_add(@sm, "b.npk", "hi");

    if (a != 0i32)                        { exit 20i32; }
    if (b != 1i32)                        { exit 21i32; }
    if (raw srcmgr_count(@sm) != 2i32)    { exit 22i32; }
    if (raw srcmgr_length(@sm, b) != 2i64) { exit 23i32; }

    // 'h' is 104
    if (raw srcmgr_byte_at(@sm, b, 0i64) != 104u8) { exit 24i32; }

    // Growth past the initial capacity of 8 must not lose or corrupt entries.
    int32:i = 0i32;
    while (i < 40i32) {
        discard(raw srcmgr_add(@sm, "x.npk", "y"));
        i = i + 1i32;
    }
    if (raw srcmgr_count(@sm) != 42i32)            { exit 25i32; }
    if (raw srcmgr_byte_at(@sm, b, 0i64) != 104u8) { exit 26i32; }

    // Out of range is an ERROR, not a sentinel: an fd-style -1 would be a value
    // the caller could mistake for data (D-042's reasoning).
    Result<string>:bad = srcmgr_text(@sm, 999i32);
    if (!(bad.is_error)) { exit 27i32; }

    // --- D-236 (1.4.8): a path SHOWS relative to the manifest root ----------
    // With no root set (this manager) a path shows as given; with one, every
    // real file renders against it -- a relative path through the cwd, an
    // absolute one directly, one outside the root as `../…` -- and a
    // synthesised source keeps its name. The RESOLVED path never changes.
    if (!(raw string_eq(raw srcmgr_path_proven(@sm, b), "b.npk")))          { exit 40i32; }
    SourceManager:rm = raw srcmgr_init();
    drop srcmgr_set_root(@rm, "/r/w", "/r");
    int32:r0 = raw srcmgr_add(@rm, "src/a.npk", "");
    int32:r1 = raw srcmgr_add(@rm, "/r/lib/b.npk", "");
    int32:r2 = raw srcmgr_add(@rm, "/other/c.npk", "");
    int32:r3 = raw srcmgr_add_synthetic(@rm, "<derived-1>", "");
    int32:r4 = raw srcmgr_add(@rm, "../x/../y.npk", "");
    int32:r5 = raw srcmgr_add(@rm, "/r", "");
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r0), "w/src/a.npk")))    { exit 41i32; }
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r1), "lib/b.npk")))      { exit 42i32; }
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r2), "../other/c.npk"))) { exit 43i32; }
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r3), "<derived-1>")))    { exit 44i32; }
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r4), "y.npk")))          { exit 45i32; }
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r5), ".")))              { exit 46i32; }
    if (!(raw string_eq(raw srcmgr_resolved_proven(@rm, r0), "src/a.npk")))  { exit 47i32; }
    // Segment-wise: `/rx` is not under `/r`.
    int32:r6 = raw srcmgr_add(@rm, "/rx/d.npk", "");
    if (!(raw string_eq(raw srcmgr_path_proven(@rm, r6), "../rx/d.npk")))    { exit 48i32; }

    // --- intern table ------------------------------------------------------
    InternTable:it = raw intern_init();

    // Index 0 is the reserved empty string, so a real name never lands on it and
    // "no name" has a value of its own.
    if ((raw intern_count(@it)) != 1i32)                { exit 28i32; }
    if (!(raw string_eq(raw intern_get(@it, 0i32), ""))) { exit 29i32; }

    int32:n1 = raw intern_add(@it, "lexer");
    int32:n2 = raw intern_add(@it, "parser");
    int32:n3 = raw intern_add(@it, "lexer");     // same text -> same index

    if (n1 != 1i32)  { exit 30i32; }
    if (n2 != 2i32)  { exit 31i32; }
    if (n3 != n1)    { exit 32i32; }
    if (raw intern_none() != 0i32) { exit 33i32; }
    if (raw intern_is_none(n1))    { exit 38i32; }
    if (raw intern_count(@it) != 3i32) { exit 39i32; }

    // Round-trip.
    if (!(raw string_eq(raw intern_get(@it, n2), "parser"))) { exit 34i32; }

    // string_eq must compare CONTENT, not length alone.
    if (raw string_eq("abc", "abd"))  { exit 35i32; }
    if (raw string_eq("abc", "ab"))   { exit 36i32; }
    if (!(raw string_eq("abc", "abc"))) { exit 37i32; }

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow) { exit 1i32; },
        (BoundsId) { exit 1i32; },
        (BoundsIndex) { exit 1i32; },
        (BoundsOffset) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (FileUnknown) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
