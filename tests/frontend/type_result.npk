// `Result<T>` — the wrapping, the unary family, and the three members
// (cycle 0.4.4, D-013/D-009/D-069/D-091).

mod:type_result;
error:E99;

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/num_width.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/resolve_codes.npk".*;
use "../../src/frontend/type_codes.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_type.npk".*;
use "../../src/frontend/parse_expr.npk".*;
use "../../src/frontend/parse_decorate.npk".*;
use "../../src/frontend/parse_stmt.npk".*;
use "../../src/frontend/parse_pick.npk".*;
use "../../src/frontend/parse_decl.npk".*;
use "../../src/frontend/symbols.npk".*;
use "../../src/frontend/types.npk".*;
use "../../src/frontend/builtin_types.npk".*;
use "../../src/frontend/type_resolve.npk".*;
use "../../src/frontend/type_names.npk".*;
use "../../src/frontend/type_cast.npk".*;
use "../../src/frontend/type_decls.npk".*;
use "../../src/frontend/type_trait.npk".*;
use "../../src/frontend/expr_types.npk".*;
use "../../src/frontend/type_expr.npk".*;

struct:Rx = {
    TypeTable:types;
    DiagList:diags;
    int32:ty;
    int64:parse_errs;
};

// Type an expression whose operands come from `decls`, inside a function that is
// terminal (`main`/`failsafe`) or not.
func:rx = Rx(string:src, bool:terminal, InternTable->:it) never fails {
    DiagList:ld = raw diaglist_init();
    TokenList:tk = raw lex_all(0i32, src, it, @ld);
    Ast:ast = raw ast_init();
    DiagList:pd = raw diaglist_init();
    Parser:p = raw parser_init(@tk, @ast, @pd, it);
    ExprId:node = raw p_parse_expr(@p);

    TypeTable:types = raw typetable_init();
    SymbolTable:tab = raw symtab_init();
    DiagList:diags = raw diaglist_init();
    // No module here, so no `impl` blocks and no generic parameters -- EMPTY
    // tables rather than skipped arguments, so that a context without them says
    // so.
    // AN EXPRESSION-TYPE TABLE, sized from the AST (0.5.0). The checker records
    // each expression's type as it computes it, so a later analysis reads what
    // the checker decided rather than deciding again.
    ExprTypes:ets = raw exprtypes_for(@ast);
    ImplTable:im = raw impltable_init();
    BoundTable:bd = raw boundtable_init();
    // EVERY INSTANTIATION BUILT, which `etyper_resolver` needs to hand a resolver a
    // place to record one. Missing here until 0.6.7, and D-127 is what the omission
    // cost: nine arguments to a ten-parameter function compiled silently, `@ets`
    // landed in the `instances` slot, and `expr_types` read whatever was in the
    // register — a number that moved whenever anything unrelated changed size.
    InstanceTable:inst = raw insttable_init();
    FnInstTable:fninsts = raw fninst_init();
    ExprTyper:e = raw etyper_init(@ast, @types, @tab, it, @diags, 0i32, @im, @bd,
                                  @inst, @fninsts, @ets);
    e.fn_terminal = terminal;
    // The enclosing function returns `int32`, which is where a `Result{...}`
    // literal gets its `<T>` — nothing writes it.
    e.fn_success = raw tt_int(@types, 32i32, true);
    int32:t = raw type_of_expr(@e, node);

    Rx:out = Rx{ types: move(types), diags: diags, ty: t,
                 parse_errs: raw diaglist_count(@pd) };
    pass out;
};

func:errs = int64(Rx->:x) never fails {
    if (x.parse_errs != 0i64) { pass 0i64 - x.parse_errs; }
    pass (raw diaglist_count(@x.diags));
};
// AN EXPLICIT COPY, not a view of the list (D-004 rule A). `diaglist_at` takes
// a borrow and hands back a `Diagnostic`, which carries a string — so the
// CALL's result is borrow-derived, and returning a field of it directly is
// refused. Reading it into a local first (parameter-rooted, so it taints
// nothing) and copying the code out is the honest spelling: what leaves this
// function is storage it owns, which is what the `string` return already
// claimed. The Python seed ran no such rule.
func:code0 = string(Rx->:x) never fails {
    Diagnostic:d = raw diaglist_at(@x.diags, 0i64);
    pass (string_concat(d.code, ""));
};

// --- resolving a `Result<T>` ANNOTATION -------------------------------------------
struct:Ty = { TypeTable:types; DiagList:diags; int32:ty; };

func:ty = Ty(string:text, InternTable->:it) never fails {
    DiagList:ld = raw diaglist_init();
    Ast:ast = raw ast_init();
    DiagList:pd = raw diaglist_init();
    TokenList:tk = raw lex_all(0i32, text, it, @ld);
    Parser:p = raw parser_init(@tk, @ast, @pd, it);
    TypeId:node = raw p_parse_type(@p);

    TypeTable:types = raw typetable_init();
    SymbolTable:tab = raw symtab_init();
    DiagList:diags = raw diaglist_init();
    // NOTHING GENERIC HERE, so nothing to instantiate -- an EMPTY table rather
    // than a skipped argument, so that a context without instantiations says so.
    InstanceTable:inst = raw insttable_init();
    TypeResolver:r = raw tyres_init(@ast, @types, @tab, it, @diags, @inst);
    int32:t = raw resolve_type(@r, node, 0i32);
    Ty:out = Ty{ types: move(types), diags: diags, ty: t };
    pass out;
};

// --- a function SIGNATURE ---------------------------------------------------------
struct:FnSig2 = { TypeTable:types; DiagList:diags; FnSig:sig; };

func:sig = FnSig2(string:src, move string:want, InternTable->:it) never fails {
    DiagList:ld = raw diaglist_init();
    Ast:ast = raw ast_init();
    DiagList:pd = raw diaglist_init();
    TokenList:tk = raw lex_all(0i32, src, it, @ld);
    Parser:p = raw parser_init(@tk, @ast, @pd, it);
    DeclId:mod_id = raw p_parse_module(@p);

    SymbolTable:tab = raw symtab_init();
    DiagList:diags = raw diaglist_init();
    int32:scope = raw collect_module(@tab, @ast, @diags, mod_id, 0i32);

    TypeTable:types = raw typetable_init();
    // NOTHING GENERIC HERE, so nothing to instantiate -- an EMPTY table rather
    // than a skipped argument, so that a context without instantiations says so.
    InstanceTable:inst = raw insttable_init();
    TypeResolver:r = raw tyres_init(@ast, @types, @tab, it, @diags, @inst);

    int32:name = raw intern_add(it, move(want));
    int32:sym = raw scope_lookup(@tab, scope, name);
    Symbol:sy = raw symtab_get(@tab, sym);
    DeclId:origin = DeclId{ index: sy.origin };
    // NOT `dn` — `an`, `bn`, `cn` and `dn` are balanced-NONARY literals, not
    // identifiers, and the real parser is what caught it.
    DeclNode:fnode = raw ast_decl(@ast, origin);
    FnSig:fs = raw fn_signature(@r, origin, name, scope);

    FnSig2:out = FnSig2{ types: move(types), diags: diags, sig: fs };
    pass out;
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();

    // --- `Result<T>` IS A WRITABLE TYPE (D-091) --------------------------------
    // Everywhere except a return position. `Result<string>:r = read_file(p);` is
    // how this compiler's own sources hold an outcome before unwrapping, so this
    // failing would break the language's most common declaration.
    //
    // It did fail: `Result` is a builtin name that takes arguments, matched
    // nothing in the scalar table, and fell through to the user-name lookup —
    // where a TOKEN KIND was reinterpreted as an intern index and the error read
    // "there is no type named" against whatever string sat there.
    Ty:r1 = raw ty("Result<int32>", @it);
    if ((raw diaglist_count(@r1.diags)) != 0i64)               { exit 10i32; }
    if ((raw type_kind(@r1.types, r1.ty)) != (raw TY_RESULT())) { exit 11i32; }
    // `{T, tbb32}` and NO stored `is_error` (D-069).
    if ((raw type_size(@r1.types, r1.ty)) != 8i64)         { exit 12i32; }

    Ty:r2 = raw ty("Optional<int32>", @it);
    if ((raw type_kind(@r2.types, r2.ty)) != (raw TY_OPTIONAL())) { exit 13i32; }

    // `Result<NIL>` is `{i32}` — NIL contributes nothing (D-084) — and is the
    // most common return type in the language, since void functions do not exist.
    Ty:r3 = raw ty("Result<NIL>", @it);
    if ((raw type_size(@r3.types, r3.ty)) != 4i64)         { exit 14i32; }

    // `Handle<T>` LOWERS since 0.10.2 (D-152): sixteen bytes, an index and a
    // generation — and not a pointer.
    Ty:r4 = raw ty("Handle<int32>", @it);
    if ((raw diaglist_count(@r4.diags)) != 0i64)               { exit 15i32; }
    if ((raw type_kind(@r4.types, r4.ty)) != (raw TY_HANDLE())) { exit 25i32; }
    if ((raw type_size(@r4.types, r4.ty)) != 16i64)        { exit 26i32; }

    // A constructor whose kind arrives at a later rung still NAMES THE RUNG
    // rather than claiming the type does not exist (D-085).
    Ty:r5 = raw ty("Future<int32>", @it);
    if ((raw diaglist_count(@r5.diags)) != 1i64)               { exit 27i32; }

    // --- THE UNARY FAMILY -------------------------------------------------------
    // Each takes a `Result<T>` and yields `T`; they differ in what happens to the
    // error, which is why they are separate nodes rather than one with a mode.
    // `raw` on a NON-CALL is refused since the flip (D-163 rule 3): the
    // checked read of a binding is `.value` after `is_err`, and a literal has
    // no callee to license. The family's typing is asserted through `relay`.
    Rx:u1 = raw rx("raw (Result{value: 1i32 })", false, @it);
    if (raw errs(@u1) != 1i64)                                 { exit 20i32; }

    // APPLYING ONE TO A PLAIN VALUE IS AN ERROR, not a no-op. A permissive `raw`
    // would survive a refactor after the operand stopped being a call, and the
    // next reader would believe there is error handling there.
    // ONE diagnostic (D-240; 1.5.2b step 4): the operand rule (`raw` needs a
    // `Result`, TYPE-007) -- the licence is not asked about an operand that
    // was refused (two from the 1.1.2 flip until this step, the licence's
    // "`raw` takes a CALL" beside it).
    Rx:u2 = raw rx("raw 1i32", false, @it);
    if (raw errs(@u2) != 1i64)                                 { exit 21i32; }
    if (!(raw string_eq(raw code0(@u2), raw TYPE_MISMATCH())))  { exit 22i32; }

    // `_!` desugars to `raw` (OP_REFERENCE level 2), so it is the same one report.
    Rx:u3 = raw rx("_! 1i32", false, @it);
    if (raw errs(@u3) != 1i64)                                 { exit 23i32; }

    // `drop` YIELDS NOTHING. That it is `NIL` rather than `T` is the point:
    // `drop f()` in a value position is then a type error instead of silently
    // being the value with its error thrown away.
    // one since the flip: `drop` takes a CALL (TYPE-042); the yield stays NIL.
    Rx:u4 = raw rx("drop (Result{value: 1i32 })", false, @it);
    if (raw errs(@u4) != 1i64)                                 { exit 24i32; }
    if (u4.ty != u4.types.t_nil)                           { exit 25i32; }

    // …so using one as a number is caught.
    Rx:u5 = raw rx("(drop (Result{value: 1i32 })) + 1i32", false, @it);
    if (raw errs(@u5) != 2i64)                                 { exit 26i32; }

    // --- `relay` IN A TERMINAL FUNCTION IS REFUSED ------------------------------
    // `main` and `failsafe` return no `Result`, so an error propagating out of
    // them has nowhere to go — which is exactly the uncontrolled stop the whole
    // discipline exists to prevent, not an arbitrary restriction.
    Rx:rl1 = raw rx("relay (Result{value: 1i32 })", false, @it);
    if (raw errs(@rl1) != 0i64)                                { exit 30i32; }

    Rx:rl2 = raw rx("relay (Result{value: 1i32 })", true, @it);
    if (raw errs(@rl2) != 1i64)                                { exit 31i32; }
    if (!(raw string_eq(raw code0(@rl2), raw TYPE_RESULT_RETURN()))) { exit 32i32; }

    // `_^` is the same operator, so it is refused in the same place.
    Rx:rl3 = raw rx("_^ (Result{value: 1i32 })", true, @it);
    if (raw errs(@rl3) != 1i64)                                { exit 33i32; }

    // --- `?|` UNWRAPS A `Result`, `??` UNWRAPS AN `Optional` --------------------
    // Two operators one character apart doing different things, so both are
    // pinned rather than assumed.
    Rx:q1 = raw rx("(Result{value: 1i32 }) ?| 0i32", false, @it);
    if (raw errs(@q1) != 0i64)                                 { exit 40i32; }
    if ((raw type_int_bits(@q1.types, q1.ty)) != 32i32)    { exit 41i32; }

    // The fallback must be the SUCCESS type: a default of another type would make
    // the expression's type depend on which way it went at runtime.
    Rx:q2 = raw rx("(Result{value: 1i32 }) ?| true", false, @it);
    if (raw errs(@q2) != 1i64)                                 { exit 42i32; }

    // `??` ON A `Result` SAYS WHICH OPERATOR WAS MEANT, which is the whole value
    // of keeping them apart — mistaking one for the other is a one-character slip
    // and the message has to close it.
    Rx:q3 = raw rx("(Result{value: 1i32 }) ?? 0i32", false, @it);
    if (raw errs(@q3) != 1i64)                                 { exit 43i32; }
    if (!(raw string_eq(raw code0(@q3), raw TYPE_MISMATCH())))  { exit 44i32; }

    // The `??`-on-an-Optional case is asserted in 0.4.5. NOTHING IN THE LANGUAGE
    // CONSTRUCTS AN `Optional` VALUE YET — `ok` builds a `Result` and there is no
    // counterpart — so a test written here would either pass vacuously or be
    // testing a cast that D-095 refuses. It arrives with identifier typing, where
    // an `Optional<int32>:o` declaration gives one a type.

    // --- `?!` TAKES EXACTLY ONE `tbb32` (D-009) ---------------------------------
    // The arity and the type both FOLLOW from `failsafe`'s signature —
    // `func:failsafe = int32(Error:err)` — rather than being chosen.
    Rx:b1 = raw rx("(Result{value: 1i32 }) ?! E99", false, @it);
    if (raw errs(@b1) != 0i64)                                 { exit 50i32; }
    if ((raw type_int_bits(@b1.types, b1.ty)) != 32i32)    { exit 51i32; }

    Rx:b2 = raw rx("(Result{value: 1i32 }) ?! 99i32", false, @it);
    if (raw errs(@b2) != 1i64)                                 { exit 52i32; }
    if (!(raw string_eq(raw code0(@b2), raw TYPE_MISMATCH())))  { exit 53i32; }

    // --- THE THREE MEMBERS, AND `.is_error` IS DERIVED (D-069) ------------------
    // The layout is `{T, tbb32}` with no third field, so there is nothing for
    // `.is_error` to disagree with. A stored flag would be a second source of
    // truth about one fact, and two sources of truth eventually differ.
    Rx:m1 = raw rx("(Result{value: 1i32 }).value", false, @it);
    if (raw errs(@m1) != 0i64)                                 { exit 60i32; }
    if ((raw type_int_bits(@m1.types, m1.ty)) != 32i32)    { exit 61i32; }

    Rx:m2 = raw rx("(Result{value: 1i32 }).err", false, @it);
    if (raw errs(@m2) != 0i64)                                 { exit 62i32; }
    if ((raw type_kind(@m2.types, m2.ty)) != (raw TY_ERROR())) { exit 63i32; }

    Rx:m3 = raw rx("(Result{value: 1i32 }).is_error", false, @it);
    if (raw errs(@m3) != 0i64)                                 { exit 64i32; }
    if (m3.ty != m3.types.t_bool)                          { exit 65i32; }

    // …and it is a `bool`, so it is usable as a condition WITHOUT truthiness.
    Rx:m4 = raw rx("(Result{value: 1i32 }).is_error && true", false, @it);
    if (raw errs(@m4) != 0i64)                                 { exit 66i32; }

    // `is_err` TESTS A `tbb`, NOT A `Result` — a different question, which
    // `.is_error` already answers. The message says which one was meant.
    Rx:ie1 = raw rx("is_err(1tbb32)", false, @it);
    if (raw errs(@ie1) != 0i64)                                { exit 100i32; }
    if (ie1.ty != ie1.types.t_bool)                        { exit 101i32; }

    Rx:ie2 = raw rx("is_err(Result{value: 1i32 })", false, @it);
    if (raw errs(@ie2) != 1i64)                                { exit 102i32; }

    // --- THE LITERAL IS THE CONSTRUCTOR (D-097) --------------------------------
    // `<T>` is never written: it comes from the enclosing function's success
    // type, which is what makes `pass(v)` and `fail(e)` sugar over this form.
    Rx:cl1 = raw rx("Result{value: 1i32 }", false, @it);
    if (raw errs(@cl1) != 0i64)                                { exit 110i32; }
    if ((raw type_kind(@cl1.types, cl1.ty)) != (raw TY_RESULT())) { exit 111i32; }

    // FIELD ORDER DOES NOT MATTER — the names are matched, so the node's slots
    // mean one thing however it was written. The spec's own desugar table writes
    // `error` first and its examples write `value` first.
    Rx:cl2 = raw rx("Result{value: 1i32}", false, @it);
    if (raw errs(@cl2) != 0i64)                                { exit 112i32; }
    if (cl2.ty != cl1.ty)                              { exit 113i32; }

    // ONE FIELD IS ENOUGH, which is exactly what the desugars produce: `pass`
    // writes `value` and leaves `err`, `fail` writes `err` and leaves `value`.
    Rx:cl3 = raw rx("Result{value: 1i32}", false, @it);
    if (raw errs(@cl3) != 0i64)                                { exit 114i32; }
    Rx:cl4 = raw rx("Result{err: E5}", false, @it);
    if (raw errs(@cl4) != 0i64)                                { exit 115i32; }

    // The value must be the enclosing function's SUCCESS type.
    Rx:cl5 = raw rx("Result{value: true }", false, @it);
    if (raw errs(@cl5) != 1i64)                                { exit 116i32; }

    // …and the error is a `tbb32`, never an arbitrary integer.
    Rx:cl6 = raw rx("Result{value: 1i32, err: true}", false, @it);
    if (raw errs(@cl6) != 1i64)                                { exit 117i32; }

    // THERE IS NO `is_error` FIELD (D-069). The prototype stored one as an `i8`
    // third field; it is derived here, so a literal naming it is naming nothing.
    //
    // AND IT IS REFUSED RATHER THAN IGNORED. This asserted zero errors until
    // 0.4.5 — the parser matched the two names it knew and let anything else fall
    // through untouched, so the field was silently dropped and the test recorded
    // that as correct. A discarded field is a value the writer believed they had
    // set, which is the exact failure `Result{…}` has a fixed shape to prevent;
    // `is_error` is also a spelling somebody arrives with from the prototype
    // rather than an idle typo, so the diagnostic names what replaced it.
    Rx:cl7 = raw rx("Result{value: 1i32 , is_error: true}", false, @it);
    if (raw errs(@cl7) != -1i64)                               { exit 118i32; }

    // A NAME NOBODY HAS EVER HAD is the same refusal without the extra sentence.
    Rx:cl8 = raw rx("Result{value: 1i32, valeu: 0tbb32}", false, @it);
    if (raw errs(@cl8) != -1i64)                               { exit 120i32; }

    // A REPEATED FIELD IS NOT AN OVERWRITE. Keeping the last one silently
    // discards the first — the same lost value, differently spelled.
    Rx:cl9 = raw rx("Result{value: 1i32, value: 2i32}", false, @it);
    if (raw errs(@cl9) != -1i64)                               { exit 121i32; }
    Rx:cla = raw rx("Result{err: E5, err: E9}", false, @it);
    if (raw errs(@cla) != -1i64)                               { exit 122i32; }

    // A FIELD NAME THAT IS NOT A NAME. `field.payload` is an intern index only on
    // an `Ident`; on anything else it is that token's own payload, so this either
    // named whatever string sat at index one or ran `intern_get` off the end of
    // the table — which fails the parse through `relay` and produces no
    // diagnostic at all.
    Rx:clb = raw rx("Result{1i32: 2i32}", false, @it);
    if (raw errs(@clb) != -1i64)                               { exit 123i32; }

    // The size assertion that would catch a stored flag being added: `{int32,
    // tbb32}` is 8 bytes, and a third field could not hide in it.
    Rx:clc = raw rx("Result{value: 1i32 }", false, @it);
    if ((raw type_size(@clc.types, clc.ty)) != 8i64)       { exit 119i32; }

    // A member a `Result` does not have is named.
    Rx:m5 = raw rx("(Result{value: 1i32 }).ok", false, @it);
    if (raw errs(@m5) != 1i64)                                 { exit 67i32; }

    // The size assertion is the one that would catch a stored flag being added:
    // `{int32, tbb32}` is 8 bytes, and a third field could not hide in it.
    if ((raw type_size(@m3.types, m3.ty)) != 1i64)         { exit 68i32; }

    // --- THE RETURN TYPE IS THE SUCCESS TYPE (D-013, D-091) --------------------
    // `func:f = int32()` returns `Result<int32>`. The wrapping happens in the
    // checker rather than the parser, because the AST records what was written
    // and this records what it means.
    FnSig2:s1 = raw sig("func:f = int32() { pass 1i32; };", "f", @it);
    if ((raw type_kind(@s1.types, s1.sig.wrapped)) != (raw TY_RESULT())) { exit 70i32; }
    if ((raw type_int_bits(@s1.types, s1.sig.success)) != 32i32)  { exit 71i32; }
    if (s1.sig.terminal)                                          { exit 72i32; }

    // `main` AND `failsafe` ARE NOT WRAPPED. That is not an exception to D-013
    // but to the shape it needs: the program ends there, so there is no caller to
    // return a `Result` to.
    FnSig2:s2 = raw sig("func:main = int32(cstring[]:a) { exit 0i32; };", "main", @it);
    if (!s2.sig.terminal)                                         { exit 73i32; }
    if (s2.sig.wrapped != s2.sig.success)                          { exit 74i32; }
    FnSig2:s3 = raw sig("func:failsafe = int32(Error:e) { exit 1i32; };",
                       "failsafe", @it);
    if (!s3.sig.terminal)                                         { exit 75i32; }

    // WRITING `Result<T>` AS A RETURN TYPE IS AN ERROR THAT SAYS SO (D-091).
    // It would mean either `Result<int32>` — two ways to write one signature — or
    // `Result<Result<int32>>`, a nesting every caller unwraps twice. Both
    // readings are defensible, and a reader cannot tell which from the signature
    // in front of them.
    FnSig2:s4 = raw sig("func:g = Result<int32>() { pass 1i32; };", "g", @it);
    if ((raw diaglist_count(@s4.diags)) != 1i64)                  { exit 76i32; }
    if (!(raw string_eq((raw diaglist_at(@s4.diags, 0i64)).code,
                        raw TYPE_RESULT_RETURN())))               { exit 77i32; }

    // …and it stays writable in a VARIABLE annotation, which is the case that
    // matters: it is how this compiler's own sources hold an outcome.
    Ty:v1 = raw ty("Result<string>", @it);
    if ((raw diaglist_count(@v1.diags)) != 0i64)                  { exit 78i32; }

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (token.BoundsId) { exit 1i32; },
        (intern.BoundsId) { exit 1i32; },
        (intern.ProvenSlice) { exit 1i32; },
        (ast.BoundsId) { exit 1i32; },
        (ast.BoundsScratch) { exit 1i32; },
        (ast.BoundsWindow) { exit 1i32; },
        (diagnostics.BoundsId) { exit 1i32; },
        (symbols.BoundsId) { exit 1i32; },
        (types.BoundsId) { exit 1i32; },
        (types.BoundsIndex) { exit 1i32; },
        (type_trait.BoundsImpl) { exit 1i32; },
        (type_trait.BoundsBound) { exit 1i32; },
        (expr_types.BoundsId) { exit 1i32; },
        (source.FileUnknown) { exit 1i32; },
        (source.BoundsIndex) { exit 1i32; },
        (source.BoundsOffset) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
