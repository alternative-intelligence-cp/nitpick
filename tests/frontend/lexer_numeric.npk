// Numeric literals (cycle 0.1.3).

mod:lexer_numeric;
use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/num_width.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/numeric.npk".*;
use "../../src/frontend/keywords.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/lexer.npk".*;

func:one = Token(string:src, InternTable->:it, DiagList->:dg) never fails {
    TokenList:ts = raw lex_all(0i32, src, it, dg);
    pass (raw tokenlist_at(@ts, 0i64));
};

// `src` IS ONE FLOAT WITH A TAIL THAT IS NO SUFFIX: exactly one diagnostic, its
// code NITPICK-LEX-009, and exactly one token before the end -- a `FloatLit`
// of the whole run, carrying no width. 0 when all of that holds, else which
// part did not.
func:bad_suffix = int32(string:src, int32:run_len, InternTable->:it) never fails {
    DiagList:d = raw diaglist_init();
    TokenList:ts = raw lex_all(0i32, src, it, @d);
    if (raw diaglist_count(@d) != 1i64) { pass 1i32; }
    Diagnostic:f = raw diaglist_at(@d, 0i64);
    if (!(raw string_eq(f.code, raw LEX_BAD_SUFFIX()))) { pass 2i32; }
    Token:t = raw tokenlist_at(@ts, 0i64);
    if (t.kind != TokenKind.FloatLit) { pass 3i32; }
    if (t.width != NumWidth.WNone)    { pass 4i32; }
    if (t.span.len != run_len)        { pass 5i32; }
    if (!(raw token_is_eof(raw tokenlist_at(@ts, 1i64)))) { pass 6i32; }
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();
    DiagList:dg = raw diaglist_init();

    // --- decimal, with a width suffix --------------------------------------
    Token:a = raw one("42i32", @it, @dg);
    if (a.kind != TokenKind.IntLit)   { exit 10i32; }
    if (a.payload != 42i64)           { exit 11i32; }
    if (a.width != NumWidth.WI32)     { exit 12i32; }

    // Underscores are for readability and are ignored.
    Token:u = raw one("1_000_000i64", @it, @dg);
    if (u.payload != 1000000i64)      { exit 13i32; }
    if (u.width != NumWidth.WI64)     { exit 14i32; }

    // --- the base is a SUFFIX, uniform across every base --------------------
    // D-147: a literal BEGINS WITH A DECIMAL DIGIT. Hex's letter digits ride
    // behind a value-neutral leading zero, so 0FFhex is 255 -- and FFhex is a
    // NAME (asserted below), which it could never be before the rule.
    Token:h = raw one("0FFhex", @it, @dg);
    if (h.kind != TokenKind.IntLit)   { exit 20i32; }
    if (h.payload != 255i64)          { exit 21i32; }

    Token:b = raw one("1010bin", @it, @dg);
    if (b.payload != 10i64)           { exit 22i32; }

    Token:o = raw one("777oct", @it, @dg);
    if (o.payload != 511i64)          { exit 23i32; }

    // Balanced ternary: T is -1. 1T0t = 1*9 + (-1)*3 + 0 = 6.
    Token:t3 = raw one("1T0t", @it, @dg);
    if (t3.kind != TokenKind.IntLit)  { exit 24i32; }
    if (t3.payload != 6i64)           { exit 25i32; }

    // Balanced nonary: A is -1. 2An = 2*9 + (-1) = 17.
    Token:n9 = raw one("2An", @it, @dg);
    if (n9.payload != 17i64)          { exit 26i32; }

    // Balanced letter digits behind the leading zero: 0an is the digit -1
    // alone, 0Tt likewise in ternary, 0dn is -4. The zero changes no value in
    // any base; it is what makes the first character a decimal digit.
    Token:n1 = raw one("0an", @it, @dg);
    if (n1.payload != (0i64 - 1i64))  { exit 27i32; }
    Token:t1 = raw one("0Tt", @it, @dg);
    if (t1.payload != (0i64 - 1i64))  { exit 28i32; }
    Token:n4 = raw one("0dn", @it, @dg);
    if (n4.payload != (0i64 - 4i64))  { exit 29i32; }

    // --- a base suffix with no digits is just an identifier -----------------
    // `hex`, `bin` and `non` are perfectly good names.
    Token:kw = raw one("hex", @it, @dg);
    if (kw.kind != TokenKind.Ident)   { exit 30i32; }
    Token:kw2 = raw one("nonsense", @it, @dg);
    if (kw2.kind != TokenKind.Ident)  { exit 31i32; }

    // The names D-147 freed: a letter-leading run is an identifier, full stop.
    // Every one of these was a NUMBER before the rule -- `ban` was nonary
    // -2*9-1 = -19 -- and the variables holding them are named after them.
    Token:fx = raw one("FFhex", @it, @dg);
    if (fx.kind != TokenKind.Ident)   { exit 32i32; }
    Token:dn = raw one("dn", @it, @dg);
    if (dn.kind != TokenKind.Ident)   { exit 33i32; }
    Token:tt = raw one("tt", @it, @dg);
    if (tt.kind != TokenKind.Ident)   { exit 34i32; }
    Token:bw = raw one("ban", @it, @dg);
    if (bw.kind != TokenKind.Ident)   { exit 35i32; }

    // --- floats -------------------------------------------------------------
    Token:f = raw one("1.5f64", @it, @dg);
    if (f.kind != TokenKind.FloatLit) { exit 40i32; }
    if (f.width != NumWidth.WF64)     { exit 41i32; }

    Token:e = raw one("1.0e10f32", @it, @dg);
    if (e.kind != TokenKind.FloatLit) { exit 42i32; }
    if (e.width != NumWidth.WF32)     { exit 43i32; }

    // Everything above must have been clean.
    if (raw diaglist_count(@dg) != 0i64) { exit 44i32; }

    // --- a float is read by its production (DEF-166, 1.6.1e step 3) ---------
    //
    //   FloatLiteral ::= DecimalLiteral "." DecimalLiteral Exponent? TypeSuffix?
    //   Exponent     ::= [eE] [+-]? DecimalLiteral
    //
    // THE TAIL IS ONE `TypeSuffix` OR NOTHING: NITPICK-LEX-009 otherwise, ONE
    // report, at the literal, and the token stays a `FloatLit` -- so the parser
    // has nothing to add about the same mistake. Each of these was accepted
    // until this step -- as the number in front where the tail begins with an
    // `f` (the library listener's `ty0178` and `ty0189b` are the first two),
    // and handed to `llc` as written otherwise.
    if (raw bad_suffix("1.5f512", 7i32, @it) != 0i32)    { exit 70i32; }
    if (raw bad_suffix("3.14flt32", 9i32, @it) != 0i32)  { exit 71i32; }
    if (raw bad_suffix("1.5garbage", 10i32, @it) != 0i32) { exit 72i32; }
    if (raw bad_suffix("2.5e3zz", 7i32, @it) != 0i32)    { exit 73i32; }
    if (raw bad_suffix("1.0f64x", 7i32, @it) != 0i32)    { exit 74i32; }
    if (raw bad_suffix("1.5F64", 6i32, @it) != 0i32)     { exit 75i32; }   // suffixes are lower case
    if (raw bad_suffix("1.5hex", 6i32, @it) != 0i32)     { exit 76i32; }   // no base suffix on a fraction
    // A doubled `e`, and an `e` with no digit behind it, are tails too: the
    // exponent is `e`, an optional sign and a DIGIT, or it is not an exponent.
    if (raw bad_suffix("1.5e3e4", 7i32, @it) != 0i32)    { exit 77i32; }
    if (raw bad_suffix("1.5ee3", 6i32, @it) != 0i32)     { exit 78i32; }
    if (raw bad_suffix("1.5e", 4i32, @it) != 0i32)       { exit 79i32; }
    if (raw bad_suffix("1.5e_3", 6i32, @it) != 0i32)     { exit 80i32; }

    // A SIGN BELONGS TO THE LITERAL ONLY INSIDE AN EXPONENT. The old scan took
    // any sign after any float, and what followed it: `3.5f64-x` was ONE
    // literal whose value was read up to its `f` -- the subtraction vanished
    // and the program computed 3.5, in silence.
    DiagList:dg7 = raw diaglist_init();
    TokenList:sub = raw lex_all(0i32, "3.5f64-x", @it, @dg7);
    Token:s0 = raw tokenlist_at(@sub, 0i64);
    if (s0.kind != TokenKind.FloatLit)                 { exit 81i32; }
    if (s0.width != NumWidth.WF64)                     { exit 82i32; }
    if (s0.span.len != 6i32)                           { exit 83i32; }   // `3.5f64`, not the run
    if ((raw tokenlist_at(@sub, 1i64)).kind != TokenKind.OpMinus) { exit 84i32; }
    if ((raw tokenlist_at(@sub, 2i64)).kind != TokenKind.Ident)   { exit 85i32; }
    TokenList:sub2 = raw lex_all(0i32, "2.5+1.5", @it, @dg7);
    if ((raw tokenlist_at(@sub2, 0i64)).span.len != 3i32)         { exit 86i32; }
    if ((raw tokenlist_at(@sub2, 1i64)).kind != TokenKind.OpPlus) { exit 87i32; }
    if ((raw tokenlist_at(@sub2, 2i64)).kind != TokenKind.FloatLit) { exit 88i32; }
    // ...and inside one it still does, with or without a suffix behind it.
    Token:x1 = raw one("1.5e-3", @it, @dg7);
    if (x1.kind != TokenKind.FloatLit)                 { exit 89i32; }
    if (x1.span.len != 6i32)                           { exit 90i32; }
    Token:x2 = raw one("1.5E+3f64", @it, @dg7);
    if (x2.span.len != 9i32)                           { exit 91i32; }
    if (x2.width != NumWidth.WF64)                     { exit 92i32; }
    if (raw diaglist_count(@dg7) != 0i64)              { exit 93i32; }
    // `3.5e-x` is the literal `3.5e` (a bad tail), a minus and a name: the
    // three bytes of an exponent are looked at before any is taken.
    DiagList:dg8 = raw diaglist_init();
    TokenList:ex = raw lex_all(0i32, "3.5e-x", @it, @dg8);
    if (raw diaglist_count(@dg8) != 1i64)              { exit 94i32; }
    if ((raw tokenlist_at(@ex, 0i64)).span.len != 4i32)           { exit 95i32; }
    if ((raw tokenlist_at(@ex, 1i64)).kind != TokenKind.OpMinus)  { exit 96i32; }

    // A `_` SEPARATOR IS IGNORED (§6.2), in a float as in an integer -- and so
    // it is not in the text the float keeps: `1_000.5f64` reached `llc` as
    // `double 1_000.5`, and `1_000.5tfp64` folded to 1.0.
    DiagList:dg9 = raw diaglist_init();
    Token:u1 = raw one("1_000.5f64", @it, @dg9);
    if (u1.kind != TokenKind.FloatLit)                 { exit 97i32; }
    if (u1.width != NumWidth.WF64)                     { exit 98i32; }
    if (u1.span.len != 10i32)                          { exit 99i32; }   // the span is the source's
    if (!(raw string_eq(raw intern_get(@it, u1.payload =>! int32), "1000.5f64"))) { exit 100i32; }
    Token:u2 = raw one("1.000_5e1_0tfp64", @it, @dg9);
    if (u2.width != NumWidth.WTfp64)                   { exit 101i32; }
    if (!(raw string_eq(raw intern_get(@it, u2.payload =>! int32), "1.0005e10tfp64"))) { exit 102i32; }
    // A text with nothing to drop is kept as it was written.
    Token:u3 = raw one("2.5e-3", @it, @dg9);
    if (!(raw string_eq(raw intern_get(@it, u3.payload =>! int32), "2.5e-3"))) { exit 103i32; }
    if (raw diaglist_count(@dg9) != 0i64)              { exit 104i32; }

    // A FLOAT'S WHOLE PART IS DECIMAL DIGITS. An integer in another base, or
    // one with its own suffix, followed by `.5` is that integer, a dot and an
    // integer -- for the parser to refuse -- and a run that is no integer at
    // all is the integer scan's LEX-003, as it is without the `.0`.
    DiagList:dg10 = raw diaglist_init();
    TokenList:hx = raw lex_all(0i32, "0FFhex.5", @it, @dg10);
    Token:h0 = raw tokenlist_at(@hx, 0i64);
    if (h0.kind != TokenKind.IntLit)                   { exit 105i32; }
    if (h0.payload != 255i64)                          { exit 106i32; }
    if ((raw tokenlist_at(@hx, 1i64)).kind != TokenKind.PDot)     { exit 107i32; }
    if (raw diaglist_count(@dg10) != 0i64)             { exit 108i32; }
    DiagList:dg11 = raw diaglist_init();
    discard(raw lex_all(0i32, "1e5.0", @it, @dg11));
    if (raw diaglist_count(@dg11) != 1i64)             { exit 109i32; }
    Diagnostic:e5 = raw diaglist_at(@dg11, 0i64);
    if (!(raw string_eq(e5.code, raw LEX_BAD_DIGIT())))  { exit 110i32; }

    // A SUFFIX OF ANOTHER FAMILY IS STILL A SUFFIX: `2.5i32` lexes clean, as a
    // float carrying an integer width, and the checker refuses it (TYPE-031).
    DiagList:dg12 = raw diaglist_init();
    Token:fi = raw one("2.5i32", @it, @dg12);
    if (fi.kind != TokenKind.FloatLit)                 { exit 111i32; }
    if (fi.width != NumWidth.WI32)                     { exit 112i32; }
    if (raw diaglist_count(@dg12) != 0i64)             { exit 113i32; }

    // --- `0...4` is a RANGE, not a malformed float --------------------------
    // A float needs a digit after the dot. The seed walked into this exact case
    // in 0.0.2, which is why it has its own test.
    DiagList:dg2 = raw diaglist_init();
    TokenList:r = raw lex_all(0i32, "0...4", @it, @dg2);
    Token:r0 = raw tokenlist_at(@r, 0i64);
    if (r0.kind != TokenKind.IntLit)  { exit 50i32; }
    if (r0.payload != 0i64)           { exit 51i32; }
    if (r0.span.len != 1i32)          { exit 52i32; }   // just the `0`

    // --- errors are reported, not silently wrong ----------------------------
    DiagList:dg3 = raw diaglist_init();
    discard(raw lex_all(0i32, "9999bin", @it, @dg3));           // 9 is not a bit
    if (raw diaglist_count(@dg3) == 0i64) { exit 60i32; }

    // Overflow is DETECTED rather than wrapped: wrapping would put a different
    // number in the program than the one written.
    DiagList:dg4 = raw diaglist_init();
    discard(raw lex_all(0i32, "99999999999999999999999i64", @it, @dg4));
    if (raw diaglist_count(@dg4) == 0i64) { exit 61i32; }

    // The case the OLD guard let through: the FNV-1a basis 0CBF29CE484222325
    // (about 1.47 * 2^63) slipped under a decimal-tuned threshold and WRAPPED
    // silently. D-148's guard is exact per radix, so it is refused loudly --
    // whatever the suffix, because the ENVELOPE is what it does not fit.
    DiagList:dg6 = raw diaglist_init();
    discard(raw lex_all(0i32, "0CBF29CE484222325hexu64", @it, @dg6));
    if (raw diaglist_count(@dg6) == 0i64) { exit 63i32; }

    // D-147 removed the legacy 0x prefix outright: `x` is not a decimal
    // digit, and a run that begins 0-9 was meant as a number, so this is an
    // ERROR (NITPICK-LEX-003), never an identifier rescue.
    DiagList:dg5 = raw diaglist_init();
    discard(raw lex_all(0i32, "0xFF", @it, @dg5));
    if (raw diaglist_count(@dg5) == 0i64) { exit 62i32; }

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (intern.BoundsId) { exit 1i32; },
        (diagnostics.BoundsId) { exit 1i32; },
        (types.BoundsId) { exit 1i32; },
        (types.BoundsIndex) { exit 1i32; },
        (source.FileUnknown) { exit 1i32; },
        (source.BoundsIndex) { exit 1i32; },
        (source.BoundsOffset) { exit 1i32; },
        (ast.BoundsId) { exit 1i32; },
        (ast.BoundsScratch) { exit 1i32; },
        (ast.BoundsWindow) { exit 1i32; },
        (ShiftRange)  { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (BoundsId) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (StackExhausted) { exit 1i32; },
        (MachineFault) { exit 1i32; },
        (LimitViolated) { exit 1i32; },
        (DecreasesViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
