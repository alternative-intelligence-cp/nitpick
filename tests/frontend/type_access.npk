// Member access, indexing, calls and UFCS (cycle 0.4.5, D-006/D-098).

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/num_width.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/resolve_codes.npk".*;
use "../../src/frontend/type_codes.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_type.npk".*;
use "../../src/frontend/parse_expr.npk".*;
use "../../src/frontend/parse_decorate.npk".*;
use "../../src/frontend/parse_stmt.npk".*;
use "../../src/frontend/parse_pick.npk".*;
use "../../src/frontend/parse_decl.npk".*;
use "../../src/frontend/symbols.npk".*;
use "../../src/frontend/resolve.npk".*;
use "../../src/frontend/types.npk".*;
use "../../src/frontend/builtin_types.npk".*;
use "../../src/frontend/resolve_type.npk".*;
use "../../src/frontend/type_names.npk".*;
use "../../src/frontend/type_cast.npk".*;
use "../../src/frontend/type_layout.npk".*;
use "../../src/frontend/type_decl.npk".*;
use "../../src/frontend/type_access.npk".*;
use "../../src/frontend/type_expr.npk".*;
use "../../src/frontend/type_stmt.npk".*;

struct:Ax = { TypeTable:types; DiagList:diags; int64:parse_errs; };

// A fixed preamble of declarations, plus whatever the case adds. Every case is a
// whole module so that names, types and bodies all go through the real pipeline.
func:ax = Ax(string:body, InternTable->:it) {
    pass (relay axd("", body, it));
};

// The same, with EXTRA TOP-LEVEL DECLARATIONS in front. A signature can be wrong
// on its own — `..*int64` without the brackets is — and a case that can only add
// statements inside `f` has no way to write one down.
//
// A declaration is only type-resolved when something reaches it, so a case
// testing a bad signature has to CALL the function; `fn_type` is what runs the
// check, and nothing runs it for a function nobody names.
func:axd = Ax(string:decls, string:body, InternTable->:it) {
    // ONE STRING, not adjacent literals — Nitpick has no implicit string
    // concatenation, which the real parser said plainly.
    // THE VALUES COME IN AS PARAMETERS rather than as locals initialised to
    // `NULL`. `NULL` is valid only where a pointer is expected (TYPE_REFERENCE
    // §27), so a `NULL`-initialised slice is itself an error and every case built
    // on one would have been measuring that instead of what it meant to.
    string:pre = relay string_concat("struct:Point = { int32:x; int32:y; }; struct:Wrap = { Point:p; }; struct:OWrap = { Optional<int32>:oi; }; enum:Net = { Connect; Disconnect; }; func:magnitude = int32(Point:self) { pass 1i32; }; func:add2 = int32(int32:a, int32:b) { pass 1i32; }; func:vsum = int32(int32:first, ..*int64[]:rest) { pass 1i32; }; ", decls);
    string:head = relay string_concat(pre, " func:f = NIL(Point:pt, Wrap:wr, Point->:pp, Point->->:ppp, int32[]:sl, int32[4]:ar, int32->:ip, any->:ap, int32:num, Optional<Point>:op, Optional<int32>:oi, Optional<OWrap>:ow, int64[]:i64s) { ");
    string:with_body = relay string_concat(head, body);
    string:src = relay string_concat(with_body, " pass NIL; };");

    DiagList:ld = raw diaglist_init();
    Ast:ast = raw ast_init();
    DiagList:pd = raw diaglist_init();
    TokenList:tk = raw lex_all(0i32, src, it, @ld);
    Parser:p = raw parser_init(@tk, @ast, @pd, it);
    DeclId:mod_id = relay p_parse_module(@p);

    SymbolTable:tab = raw symtab_init();
    DiagList:diags = raw diaglist_init();
    int32:scope = relay collect_module(@tab, @ast, @diags, mod_id, 0i32);
    Resolver:rs = raw resolver_init(@ast, @tab, it, @diags);
    drop resolve_module(@rs, mod_id, scope);

    TypeTable:types = raw typetable_init();
    TypeResolver:tr = raw tyres_init(@ast, @types, @tab, it, @diags);
    ExprTyper:e = raw etyper_init(@ast, @types, @tab, it, @diags, scope);

    DeclNode:mn = relay ast_decl(@ast, mod_id);
    int32:i = 0i32;
    while (i < (raw item_member_count(@ast, mn))) {
        DeclId:item = raw item_member(@ast, mn, i);
        DeclNode:d = relay ast_decl(@ast, item);
        if (d.kind == DeclKind.DeclFunctionDecl) {
            int32:name = d.payload => int32;
            if (raw string_eq(relay intern_get(it, name), "f")) {
                FnSig:sg = relay fn_signature(@tr, d, name, scope);
                e.fn_success = sg.success;
                e.fn_terminal = sg.terminal;
                drop check_block(@e, raw fn_body(@ast, d));
            }
        }
        i = i + 1i32;
    }
    Ax:out = Ax{ types: types, diags: diags,
                 parse_errs: raw diaglist_count(@pd) };
    pass out;
};

// The body IS a block and `check_stmt` walks one (D-101). This unrolled the top
// level by hand, which stopped being necessary when the checker's walk was
// completed and would now quietly skip anything a case nested.
func:check_block = NIL(ExprTyper->:e, StmtId:body) {
    drop check_stmt(e, body);
    pass NIL;
};

func:errs = int64(Ax->:x) {
    if (x.parse_errs != 0i64) { pass 0i64 - x.parse_errs; }
    pass (raw diaglist_count(@x.diags));
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();

    // --- STRUCT LAYOUT IS REAL ------------------------------------------------
    // 0.4.1 interned a named type from its declaration and left the size at zero.
    // A `Result<Point>` built from that would be four bytes where it should be
    // twelve, and nothing downstream would have said so.
    TypeTable:t0 = raw typetable_init();
    int32:i32t = raw tt_int(@t0, 32i32, true);
    int32:i8t = raw tt_int(@t0, 8i32, true);
    if ((raw align_up(0i64, 4i32)) != 0i64)                    { exit 10i32; }
    if ((raw align_up(1i64, 4i32)) != 4i64)                    { exit 11i32; }
    if ((raw align_up(4i64, 4i32)) != 4i64)                    { exit 12i32; }
    if ((raw align_up(5i64, 8i32)) != 8i64)                    { exit 13i32; }
    // Alignment of 1 never pads, and the guard matters because `% 1` is a
    // division the layout would otherwise perform on every byte-sized field.
    if ((raw align_up(7i64, 1i32)) != 7i64)                    { exit 14i32; }

    // --- `.` REACHES A FIELD --------------------------------------------------
    Ax:m1 = raw ax("int32:v = pt.x;", @it);
    if (raw errs(@m1) != 0i64)                                 { exit 20i32; }

    // The field's TYPE is checked, not just its existence.
    Ax:m2 = raw ax("bool:v = pt.x;", @it);
    if (raw errs(@m2) != 1i64)                                 { exit 21i32; }

    // A MISSING MEMBER NAMES THE TYPE it was sought on. "no member `z`" would
    // leave the reader working out which of a chain's types was being asked.
    Ax:m3 = raw ax("int32:v = pt.z;", @it);
    if (raw errs(@m3) != 1i64)                                 { exit 22i32; }

    // Chained through an embedded field (D-006).
    Ax:m4 = raw ax("int32:v = wr.p.x;", @it);
    if (raw errs(@m4) != 0i64)                                 { exit 23i32; }

    // --- AUTO-DEREFERENCE IS ONE LEVEL (D-098) --------------------------------
    // `.` is the only member operator and it dereferences once. A rule that
    // peeled until it found a struct would make the number of indirections
    // invisible at the use site.
    Ax:d1 = raw ax("int32:v = pp.x;", @it);
    if (raw errs(@d1) != 0i64)                                 { exit 30i32; }

    // TWO LEVELS IS AN ERROR that says to write the dereference.
    Ax:d2 = raw ax("int32:v = ppp.x;", @it);
    if (raw errs(@d2) != 1i64)                                 { exit 31i32; }

    // …and writing it works, because `<-` brings the value back one level.
    Ax:d3 = raw ax("int32:v = (<-ppp).x;", @it);
    if (raw errs(@d3) != 0i64)                                 { exit 32i32; }

    // An `any->` has no members: it is type-erased, so there is nothing to reach.
    Ax:d4 = raw ax("int32:v = ap.x;", @it);
    if (raw errs(@d4) != 1i64)                                 { exit 33i32; }

    // --- AN ENUM VARIANT AND A MODULE MEMBER ARE THE SAME NODE ---------------
    // Told apart HERE, by what the base resolved to — exactly what 0.3.5 left.
    Ax:v1 = raw ax("Net:n = Net.Connect;", @it);
    if (raw errs(@v1) != 0i64)                                 { exit 40i32; }

    // A variant's type is the ENUM, not a type of its own — which is what stops a
    // signature from naming one arm.
    Ax:v2 = raw ax("Point:n = Net.Connect;", @it);
    if (raw errs(@v2) != 1i64)                                 { exit 41i32; }

    Ax:v3 = raw ax("Net:n = Net.Nonexistent;", @it);
    if (raw errs(@v3) != 1i64)                                 { exit 42i32; }

    // --- A SLICE CARRIES ITS LENGTH, A POINTER DOES NOT (D-038/D-070) --------
    // The whole reason the two are different types.
    Ax:s1 = raw ax("int64:n = sl.len;", @it);
    if (raw errs(@s1) != 0i64)                                 { exit 50i32; }
    Ax:s2 = raw ax("int64:n = ip.len;", @it);
    if (raw errs(@s2) != 1i64)                                 { exit 51i32; }

    // --- INDEXING -------------------------------------------------------------
    Ax:x1 = raw ax("int32:v = ar[0i64];", @it);
    if (raw errs(@x1) != 0i64)                                 { exit 60i32; }
    Ax:x2 = raw ax("int32:v = sl[0i64];", @it);
    if (raw errs(@x2) != 0i64)                                 { exit 61i32; }
    // A pointer indexes and carries no length, so it cannot be bounds-checked —
    // which is why slices exist and why a function should take one.
    Ax:x3 = raw ax("int32:v = ip[0i64];", @it);
    if (raw errs(@x3) != 0i64)                                 { exit 62i32; }

    // An index is an INTEGER, and a `bool` is not one.
    Ax:x4 = raw ax("int32:v = sl[true];", @it);
    if (raw errs(@x4) != 1i64)                                 { exit 63i32; }
    // …and a struct cannot be indexed at all.
    Ax:x5 = raw ax("int32:v = pt[0i64];", @it);
    if (raw errs(@x5) != 1i64)                                 { exit 64i32; }

    // --- CALLS: ARITY AND ARGUMENT TYPES -------------------------------------
    // A call yields the function's RESULT, so it needs unwrapping — which is the
    // D-013 discipline showing up at every call site, on purpose.
    Ax:c1 = raw ax("int32:v = raw add2(1i32, 2i32);", @it);
    if (raw errs(@c1) != 0i64)                                 { exit 70i32; }

    // BOTH COUNTS ARE NAMED in the message; making the reader count the
    // parameters is the one thing the compiler already did.
    Ax:c2 = raw ax("int32:v = raw add2(1i32);", @it);
    if (raw errs(@c2) != 1i64)                                 { exit 71i32; }
    Ax:c3 = raw ax("int32:v = raw add2(1i32, 2i32, 3i32);", @it);
    if (raw errs(@c3) != 1i64)                                 { exit 72i32; }

    Ax:c4 = raw ax("int32:v = raw add2(1i32, true);", @it);
    if (raw errs(@c4) != 1i64)                                 { exit 73i32; }

    // Calling something that is not a function.
    Ax:c5 = raw ax("int32:v = raw pt(1i32);", @it);
    if (raw errs(@c5) != 1i64)                                 { exit 74i32; }

    // A call's result is a `Result`, so using it unwrapped is caught.
    Ax:c6 = raw ax("int32:v = add2(1i32, 2i32);", @it);
    if (raw errs(@c6) != 1i64)                                 { exit 75i32; }

    // --- UFCS (D-006) ---------------------------------------------------------
    // `p.magnitude()` resolves to the free function with `p` as its first
    // argument. The receiver is already apart from the callee in the AST, which
    // is what makes this a lookup rather than a rewrite.
    Ax:u1 = raw ax("int32:v = raw pt.magnitude();", @it);
    if (raw errs(@u1) != 0i64)                                 { exit 80i32; }

    // A METHOD THAT DOES NOT EXIST NAMES THE TYPE it was sought on. "unknown
    // function `nope`" would send the reader looking for a free function when
    // what they wrote was a method call.
    Ax:u2 = raw ax("int32:v = raw pt.nope();", @it);
    if (raw errs(@u2) != 1i64)                                 { exit 81i32; }

    // The receiver is checked as the first parameter, so a method of another type
    // is refused rather than silently accepted.
    Ax:u3 = raw ax("int32:v = raw num.magnitude();", @it);
    if (raw errs(@u3) != 1i64)                                 { exit 82i32; }

    // …and it auto-dereferences one level like plain access does.
    Ax:u4 = raw ax("int32:v = raw pp.magnitude();", @it);
    if (raw errs(@u4) != 0i64)                                 { exit 83i32; }

    // --- AN `Optional` IS BUILT BY WRITING THE VALUE (D-099) ------------------
    // There is no constructor. `NIL` is "no value" as `NULL` is "no pointer", and
    // a bare `T` in an `Optional<T>` slot is the one holding a value — which is
    // how the prototype's own `test_nil_optional.npk` is written throughout.
    Ax:o1 = raw ax("Optional<int32>:o = 1i32;", @it);
    if (raw errs(@o1) != 0i64)                                 { exit 90i32; }
    Ax:o2 = raw ax("int32?:o = NIL;", @it);
    if (raw errs(@o2) != 0i64)                                 { exit 91i32; }

    // BOTH SPELLINGS ARE ONE TYPE, so the rules cannot be stepped around by
    // choosing the other annotation.
    Ax:o3 = raw ax("Optional<int32>:o = NIL;", @it);
    if (raw errs(@o3) != 0i64)                                 { exit 92i32; }
    Ax:o4 = raw ax("int32?:o = 1i32;", @it);
    if (raw errs(@o4) != 0i64)                                 { exit 93i32; }

    // The value is still checked against `T` — the wrap is the ONLY thing added.
    Ax:o5 = raw ax("Optional<int32>:o = true;", @it);
    if (raw errs(@o5) != 1i64)                                 { exit 94i32; }

    // AN UNSUFFIXED LITERAL READS ITS WIDTH THROUGH THE WRAPPER. Asking the
    // `Optional` for a width would report "no width suffix" about a slot that
    // plainly names one.
    Ax:o6 = raw ax("int32?:o = 10;", @it);
    if (raw errs(@o6) != 0i64)                                 { exit 95i32; }

    // --- `NIL` IS THE TEST, AND IT READS BOTH WAYS ROUND ---------------------
    Ax:e1 = raw ax("bool:b = (oi == NIL);", @it);
    if (raw errs(@e1) != 0i64)                                 { exit 96i32; }
    // The order used to matter: the left operand was typed with no context, so
    // `NIL == oi` reported the sentinel as homeless while `oi == NIL` worked.
    Ax:e2 = raw ax("bool:b = (NIL == oi);", @it);
    if (raw errs(@e2) != 0i64)                                 { exit 97i32; }
    // `NULL` had the same defect and is fixed by the same list.
    Ax:e3 = raw ax("bool:b = (NULL == ip);", @it);
    if (raw errs(@e3) != 0i64)                                 { exit 98i32; }

    // `NIL` WITH NO `Optional` IN SIGHT IS STILL THE UNIT VALUE — unlike `NULL`,
    // it has a type of its own to fall back to, and `pass NIL;` is the most
    // common statement in the language.
    Ax:e4 = raw ax("NIL:u = NIL;", @it);
    if (raw errs(@e4) != 0i64)                                 { exit 99i32; }

    // --- AN `Optional` HAS NO READABLE MEMBERS -------------------------------
    // `.has_value` duplicates `== NIL`, and `.value` is the unchecked read the
    // wrapper exists to prevent. A draft added both; neither is in the prototype.
    Ax:m6 = raw ax("bool:b = oi.has_value;", @it);
    if (raw errs(@m6) != 1i64)                                 { exit 100i32; }
    Ax:m7 = raw ax("int32:v = oi.value;", @it);
    if (raw errs(@m7) != 1i64)                                 { exit 101i32; }

    // --- `??` UNWRAPS AN `Optional`, AND ONLY AN `Optional` ------------------
    Ax:q1 = raw ax("int32:v = oi ?? 0i32;", @it);
    if (raw errs(@q1) != 0i64)                                 { exit 102i32; }
    // The default must be the inner type.
    Ax:q2 = raw ax("int32:v = oi ?? true;", @it);
    if (raw errs(@q2) != 1i64)                                 { exit 103i32; }
    // A POINTER IS REFUSED. The prototype's checker accepted one and dereferenced
    // it; the behaviour never ran, and a `??` that reads through a pointer hides
    // the read that `<-` exists to show.
    Ax:q3 = raw ax("int32:v = ip ?? 0i32;", @it);
    if (raw errs(@q3) != 1i64)                                 { exit 104i32; }

    // --- `?.` SHORT-CIRCUITS AND THE ABSENCE SURVIVES ------------------------
    // Its result is an `Optional<U>`, not a `U`. If the absence did not survive
    // the access, `?.` would be `.` with two extra characters.
    Ax:n1 = raw ax("Optional<int32>:v = op?.x;", @it);
    if (raw errs(@n1) != 0i64)                                 { exit 110i32; }
    Ax:n2 = raw ax("int32:v = op?.x;", @it);
    if (raw errs(@n2) != 1i64)                                 { exit 111i32; }
    // `?.` on something that is not an `Optional` says which operator was meant.
    Ax:n3 = raw ax("Optional<int32>:v = pt?.x;", @it);
    if (raw errs(@n3) != 1i64)                                 { exit 112i32; }

    // --- THE TWO INNER TYPES THAT ARE REFUSED --------------------------------
    // `NIL?` would be empty in two ways with no way to tell them apart, and
    // `T??` has an inner absence nothing can set.
    Ax:b1 = raw ax("NIL?:o = NIL;", @it);
    if (raw errs(@b1) != 1i64)                                 { exit 113i32; }
    // THE POSTFIX FORM CANNOT EVEN BE LEXED: `??` is one token, so `int32??`
    // reads as `int32` followed by the null-coalesce operator and never reaches
    // the type resolver. Which leaves the generic spelling as the only way in,
    // and it is refused there.
    Ax:b3 = raw ax("Optional<Optional<int32>>:o = NIL;", @it);
    if (raw errs(@b3) != 1i64)                                 { exit 115i32; }
    // …and `?.` FLATTENS rather than manufacturing the type behind the rule's
    // back. `wo` is an `Optional<Wrap>` whose `p` field is a `Point`; `oow` holds
    // an `Optional<int32>` field, so reaching it through `?.` stays one deep.
    Ax:b4 = raw ax("Optional<int32>:v = ow?.oi;", @it);
    if (raw errs(@b4) != 0i64)                                 { exit 116i32; }

    // --- VARIADIC CALLS (D-100) ----------------------------------------------
    // `vsum` is `int32(int32:first, ..*int64[]:rest)`. Until now `fn_type` built
    // a plain `TY_FUNC` from the fixed parameters and dropped the spec, so every
    // one of these checked as a one-parameter function: the zero-extra case
    // passed by accident and every other case was refused for the wrong reason.
    Ax:v1 = raw ax("int32:v = raw vsum(1i32);", @it);
    if (raw errs(@v1) != 0i64)                                 { exit 120i32; }
    Ax:v2 = raw ax("int32:v = raw vsum(1i32, 2i64);", @it);
    if (raw errs(@v2) != 0i64)                                 { exit 121i32; }
    Ax:v3 = raw ax("int32:v = raw vsum(1i32, 2i64, 3i64, 4i64);", @it);
    if (raw errs(@v3) != 0i64)                                 { exit 122i32; }

    // THE FIXED PARAMETERS ARE STILL FIXED — the tail does not swallow them.
    Ax:v4 = raw ax("int32:v = raw vsum();", @it);
    if (raw errs(@v4) != 1i64)                                 { exit 123i32; }
    Ax:v5 = raw ax("int32:v = raw vsum(true);", @it);
    if (raw errs(@v5) != 1i64)                                 { exit 124i32; }

    // …AND EVERY TRAILING ARGUMENT IS CHECKED AGAINST THE ELEMENT, not the slice.
    // `..*int64[]` collects `int64`s, so an `int32` in the tail is refused — one
    // diagnostic per bad argument, and the second one is not masked by the first.
    Ax:v6 = raw ax("int32:v = raw vsum(1i32, 2i32);", @it);
    if (raw errs(@v6) != 1i64)                                 { exit 125i32; }
    Ax:v7 = raw ax("int32:v = raw vsum(1i32, 2i32, 3i32);", @it);
    if (raw errs(@v7) != 2i64)                                 { exit 126i32; }

    // A FIXED FUNCTION IS UNCHANGED. `add2` takes exactly two.
    Ax:v8 = raw ax("int32:v = raw add2(1i32, 2i32, 3i32);", @it);
    if (raw errs(@v8) != 1i64)                                 { exit 127i32; }

    // --- `..^` EXPANDS INTO THE TAIL AND NOWHERE ELSE (D-026) ----------------
    // Its type is the COLLECTOR, not the element: it supplies the whole slice.
    Ax:s1 = raw ax("int32:v = raw vsum(1i32, ..^i64s);", @it);
    if (raw errs(@s1) != 0i64)                                 { exit 130i32; }
    // An element where a collection belongs, and a collection where an element
    // belongs, are both refused.
    Ax:s2 = raw ax("int32:v = raw vsum(1i32, ..^2i64);", @it);
    if (raw errs(@s2) != 1i64)                                 { exit 131i32; }
    Ax:s3 = raw ax("int32:v = raw vsum(1i32, i64s);", @it);
    if (raw errs(@s3) != 1i64)                                 { exit 132i32; }
    // A FUNCTION THAT COLLECTS NOTHING HAS NO TAIL TO EXPAND INTO.
    Ax:s4 = raw ax("int32:v = raw add2(1i32, ..^i64s);", @it);
    if (raw errs(@s4) != 2i64)                                 { exit 133i32; }
    // AN EXPANSION FILLING A FIXED PARAMETER is refused where it sits.
    Ax:s5 = raw ax("int32:v = raw vsum(..^i64s);", @it);
    if (raw errs(@s5) != 2i64)                                 { exit 134i32; }
    // NOTHING MAY FOLLOW ONE — an argument after an expansion has no position.
    Ax:s6 = raw ax("int32:v = raw vsum(1i32, ..^i64s, 9i64);", @it);
    if (raw errs(@s6) != 1i64)                                 { exit 135i32; }

    // --- `..*T[]` AND NOT `..*T` ---------------------------------------------
    // Without the brackets there is no slice to bind and no element to recover.
    Ax:s7 = raw axd("func:bad = int32(..*int64:rest) { pass 1i32; };",
                    "int32:v = raw bad(1i64);", @it);
    if (raw errs(@s7) != 1i64)                                 { exit 136i32; }

    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) {
    exit 1i32;
};
