// Expression parsing and precedence (cycle 0.2.3).

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_type.npk".*;
use "../../src/frontend/parse_expr.npk".*;

struct:Ctx = {
    TokenList:toks;
    Ast:ast;
    DiagList:diags;
    Parser:p;
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();
    DiagList:ld = raw diaglist_init();

    // --- precedence: * binds tighter than + --------------------------------
    TokenList:k1 = raw lex_all(0i32, "1i32 + 2i32 * 3i32", @it, @ld);
    Ast:a1 = raw ast_init();
    DiagList:g1 = raw diaglist_init();
    Parser:p1 = raw parser_init(@k1, @a1, @g1, @it);
    ExprId:e1 = raw p_parse_expr(@p1);
    ExprNode:n1 = raw ast_expr(@a1, e1);
    if (n1.kind != ExprKind.ExprBinaryExpr)              { exit 10i32; }
    if ((raw expr_op(n1)) != TokenKind.OpPlus)           { exit 11i32; }
    // The RIGHT child is the multiplication, not the left.
    ExprNode:r1 = raw ast_expr(@a1, raw expr_rhs(n1));
    if (r1.kind != ExprKind.ExprBinaryExpr)              { exit 12i32; }
    if ((raw expr_op(r1)) != TokenKind.OpStar)           { exit 13i32; }
    if (raw diaglist_count(@g1) != 0i64)                 { exit 14i32; }

    // Left-associativity, asserted rather than assumed: 1-2-3 is (1-2)-3.
    TokenList:k2 = raw lex_all(0i32, "1i32 - 2i32 - 3i32", @it, @ld);
    Ast:a2 = raw ast_init();
    DiagList:g2 = raw diaglist_init();
    Parser:p2 = raw parser_init(@k2, @a2, @g2, @it);
    ExprNode:n2 = raw ast_expr(@a2, raw p_parse_expr(@p2));
    ExprNode:l2 = raw ast_expr(@a2, raw expr_lhs(n2));
    if (l2.kind != ExprKind.ExprBinaryExpr)              { exit 20i32; }
    ExprNode:r2 = raw ast_expr(@a2, raw expr_rhs(n2));
    if (r2.kind != ExprKind.ExprIntLiteral)              { exit 21i32; }

    // --- LEVEL 2: the Result unary operators (D-081) ------------------------
    // Looser than postfix, so `raw f(x)` takes the WHOLE call and not just `f`.
    // Getting this wrong does not fail -- it changes what the program means.
    TokenList:k3 = raw lex_all(0i32, "raw f(x)", @it, @ld);
    Ast:a3 = raw ast_init();
    DiagList:g3 = raw diaglist_init();
    Parser:p3 = raw parser_init(@k3, @a3, @g3, @it);
    ExprNode:n3 = raw ast_expr(@a3, raw p_parse_expr(@p3));
    if (n3.kind != ExprKind.ExprRawUnwrapExpr)           { exit 30i32; }
    ExprNode:inner3 = raw ast_expr(@a3, raw expr_operand(n3));
    if (inner3.kind != ExprKind.ExprCallExpr)            { exit 31i32; }

    // Tighter than cast, so `raw f() => int32` casts the VALUE, not the Result.
    TokenList:k4 = raw lex_all(0i32, "raw f() => int32", @it, @ld);
    Ast:a4 = raw ast_init();
    DiagList:g4 = raw diaglist_init();
    Parser:p4 = raw parser_init(@k4, @a4, @g4, @it);
    ExprNode:n4 = raw ast_expr(@a4, raw p_parse_expr(@p4));
    if (n4.kind != ExprKind.ExprCastExpr)                { exit 32i32; }
    ExprNode:c4 = raw ast_expr(@a4, raw expr_lhs(n4));
    if (c4.kind != ExprKind.ExprRawUnwrapExpr)           { exit 33i32; }

    // Right-associative: `raw relay f()` is raw(relay(f())).
    TokenList:k5 = raw lex_all(0i32, "raw relay f()", @it, @ld);
    Ast:a5 = raw ast_init();
    DiagList:g5 = raw diaglist_init();
    Parser:p5 = raw parser_init(@k5, @a5, @g5, @it);
    ExprNode:n5 = raw ast_expr(@a5, raw p_parse_expr(@p5));
    if (n5.kind != ExprKind.ExprRawUnwrapExpr)           { exit 34i32; }
    ExprNode:i5 = raw ast_expr(@a5, raw expr_operand(n5));
    if (i5.kind != ExprKind.ExprRelayExpr)               { exit 35i32; }

    // The `_^` spelling is the same node as `relay`.
    TokenList:k6 = raw lex_all(0i32, "_^ f()", @it, @ld);
    Ast:a6 = raw ast_init();
    DiagList:g6 = raw diaglist_init();
    Parser:p6 = raw parser_init(@k6, @a6, @g6, @it);
    ExprNode:n6 = raw ast_expr(@a6, raw p_parse_expr(@p6));
    if (n6.kind != ExprKind.ExprRelayExpr)               { exit 36i32; }

    // --- postfix chains ------------------------------------------------------
    TokenList:k7 = raw lex_all(0i32, "a.b[0i64].c", @it, @ld);
    Ast:a7 = raw ast_init();
    DiagList:g7 = raw diaglist_init();
    Parser:p7 = raw parser_init(@k7, @a7, @g7, @it);
    ExprNode:n7 = raw ast_expr(@a7, raw p_parse_expr(@p7));
    if (n7.kind != ExprKind.ExprMemberAccessExpr)        { exit 40i32; }
    ExprNode:i7 = raw ast_expr(@a7, raw expr_operand(n7));
    if (i7.kind != ExprKind.ExprIndexExpr)               { exit 41i32; }

    // --- turbofish is the ONLY expression-position form (D-064) -------------
    TokenList:k8 = raw lex_all(0i32, "f::<int32>(x)", @it, @ld);
    Ast:a8 = raw ast_init();
    DiagList:g8 = raw diaglist_init();
    Parser:p8 = raw parser_init(@k8, @a8, @g8, @it);
    ExprNode:n8 = raw ast_expr(@a8, raw p_parse_expr(@p8));
    if (n8.kind != ExprKind.ExprCallExpr)                { exit 50i32; }
    if (raw expr_generic_count(n8) != 1i32)              { exit 51i32; }
    // one generic + one value argument share the window
    if (raw expr_list_count(n8) != 2i32)                 { exit 52i32; }
    if (raw diaglist_count(@g8) != 0i64)                 { exit 53i32; }

    // Bare `f<T>(x)` is NOT a generic call -- it is two comparisons, which is
    // exactly why the turbofish exists.
    TokenList:k9 = raw lex_all(0i32, "f < int32 > (x)", @it, @ld);
    Ast:a9 = raw ast_init();
    DiagList:g9 = raw diaglist_init();
    Parser:p9 = raw parser_init(@k9, @a9, @g9, @it);
    ExprNode:n9 = raw ast_expr(@a9, raw p_parse_expr(@p9));
    if (n9.kind != ExprKind.ExprBinaryExpr)              { exit 54i32; }

    // --- literals and keyword operators --------------------------------------
    TokenList:ka = raw lex_all(0i32, "true", @it, @ld);
    Ast:aa = raw ast_init();
    DiagList:ga = raw diaglist_init();
    Parser:pa = raw parser_init(@ka, @aa, @ga, @it);
    ExprNode:na = raw ast_expr(@aa, raw p_parse_expr(@pa));
    // `true` is a LITERAL, not an identifier. It lives in section 6.1 rather
    // than the keyword productions, which is how it was missed.
    if (na.kind != ExprKind.ExprBoolLiteral)             { exit 60i32; }

    TokenList:kb = raw lex_all(0i32, "move(x)", @it, @ld);
    Ast:ab = raw ast_init();
    DiagList:gb = raw diaglist_init();
    Parser:pb = raw parser_init(@kb, @ab, @gb, @it);
    ExprNode:nb = raw ast_expr(@ab, raw p_parse_expr(@pb));
    if (nb.kind != ExprKind.ExprMoveExpr)                { exit 61i32; }

    TokenList:kc = raw lex_all(0i32, "#size_of<int32>()", @it, @ld);
    Ast:ac = raw ast_init();
    DiagList:gc = raw diaglist_init();
    Parser:pc = raw parser_init(@kc, @ac, @gc, @it);
    ExprNode:nc = raw ast_expr(@ac, raw p_parse_expr(@pc));
    if (nc.kind != ExprKind.ExprBuiltinExpr)             { exit 62i32; }
    if (raw diaglist_count(@gc) != 0i64)                 { exit 63i32; }

    // --- templates: `&{ }` is the whole formatting mechanism (D-053) --------
    TokenList:kd = raw lex_all(0i32, "`n=&{x}!`", @it, @ld);
    Ast:ad = raw ast_init();
    DiagList:gd = raw diaglist_init();
    Parser:pd = raw parser_init(@kd, @ad, @gd, @it);
    ExprNode:nd = raw ast_expr(@ad, raw p_parse_expr(@pd));
    if (nd.kind != ExprKind.ExprTemplateLiteral)         { exit 70i32; }
    // "n=", x, "!"
    if (raw expr_list_count(nd) != 3i32)                 { exit 71i32; }
    if (raw diaglist_count(@gd) != 0i64)                 { exit 72i32; }

    // --- struct literals -----------------------------------------------------
    TokenList:ke = raw lex_all(0i32, "Point{ x: 1i32, y: 2i32 }", @it, @ld);
    Ast:ae = raw ast_init();
    DiagList:ge = raw diaglist_init();
    Parser:pe = raw parser_init(@ke, @ae, @ge, @it);
    ExprNode:ne = raw ast_expr(@ae, raw p_parse_expr(@pe));
    if (ne.kind != ExprKind.ExprStructLiteralExpr)       { exit 80i32; }
    // two fields, two entries each: name then value
    if (raw expr_list_count(ne) != 4i32)                 { exit 81i32; }

    // --- nested calls keep their own argument windows -----------------------
    // This is the scratch-stack property from 0.2.2, now under an expression:
    // an inner call must not leave its arguments inside the outer one's window.
    TokenList:kf = raw lex_all(0i32, "f(g(1i32, 2i32), 3i32)", @it, @ld);
    Ast:af = raw ast_init();
    DiagList:gf = raw diaglist_init();
    Parser:pf = raw parser_init(@kf, @af, @gf, @it);
    ExprNode:nf = raw ast_expr(@af, raw p_parse_expr(@pf));
    if (nf.kind != ExprKind.ExprCallExpr)                { exit 90i32; }
    if (raw expr_list_count(nf) != 2i32)                 { exit 91i32; }
    int32:inner_ix = raw ast_id_at(@af, raw expr_list_start(nf), 0i32);
    ExprId:innerId = ExprId{ index: inner_ix };
    ExprNode:ninner = raw ast_expr(@af, innerId);
    if (ninner.kind != ExprKind.ExprCallExpr)            { exit 92i32; }
    if (raw expr_list_count(ninner) != 2i32)             { exit 93i32; }
    if (raw diaglist_count(@gf) != 0i64)                 { exit 94i32; }

    // --- 0.2.8: two nodes the parser could not build --------------------------

    // `p.magnitude()` is a METHOD CALL, not a CallExpr over a MemberAccessExpr.
    // UFCS resolves it to `Point_magnitude(p)` (D-006), which needs the receiver
    // kept apart from the callee rather than buried one level down.
    TokenList:kg = raw lex_all(0i32, "p.magnitude(1i32)", @it, @ld);
    Ast:ag = raw ast_init();
    DiagList:gg = raw diaglist_init();
    Parser:pg = raw parser_init(@kg, @ag, @gg, @it);
    ExprNode:ng = raw ast_expr(@ag, raw p_parse_expr(@pg));
    if (ng.kind != ExprKind.ExprMethodCallExpr)          { exit 95i32; }
    if (raw expr_list_count(ng) != 1i32)                 { exit 96i32; }
    ExprNode:recv = raw ast_expr(@ag, raw expr_operand(ng));
    if (recv.kind != ExprKind.ExprIdentifierExpr)        { exit 97i32; }

    // A bare member access is still a MemberAccessExpr -- it is the `(` that
    // makes the difference, and only that.
    TokenList:kh = raw lex_all(0i32, "p.magnitude", @it, @ld);
    Ast:ah = raw ast_init();
    DiagList:gh = raw diaglist_init();
    Parser:ph = raw parser_init(@kh, @ah, @gh, @it);
    if ((raw ast_expr(@ah, raw p_parse_expr(@ph))).kind
            != ExprKind.ExprMemberAccessExpr)            { exit 98i32; }

    // A cast TO a `dyn` type builds a fat pointer, which is not a checked scalar
    // conversion -- so it is its own node (D-029).
    TokenList:ki = raw lex_all(0i32, "obj => dyn Drawable & Printable", @it, @ld);
    Ast:ai = raw ast_init();
    DiagList:gi = raw diaglist_init();
    Parser:pi = raw parser_init(@ki, @ai, @gi, @it);
    ExprNode:ni = raw ast_expr(@ai, raw p_parse_expr(@pi));
    if (ni.kind != ExprKind.ExprDynCastExpr)             { exit 99i32; }
    if (raw expr_list_count(ni) != 2i32)                 { exit 105i32; }

    // …while a cast to an ordinary type is still a CastExpr.
    TokenList:kj = raw lex_all(0i32, "obj => int32", @it, @ld);
    Ast:aj = raw ast_init();
    DiagList:gj = raw diaglist_init();
    Parser:pj = raw parser_init(@kj, @aj, @gj, @it);
    if ((raw ast_expr(@aj, raw p_parse_expr(@pj))).kind
            != ExprKind.ExprCastExpr)                    { exit 106i32; }
    if (raw diaglist_count(@gj) != 0i64)                 { exit 107i32; }

    // --- a `Result{…}` FIELD IS NAMED, AND NAMED ONCE (0.6.6) -----------------
    //
    // Two ways to get `NITPICK-PARSE-008`, and both are about a value going
    // missing rather than about tidiness.
    //
    // A NON-NAME FIELD is checked BEFORE its payload is read as an intern index:
    // `field.payload` is one only for an `Ident`, so on any other token it is that
    // token's own payload — `Result{5: v}` either named whatever string sits at
    // index five or ran `intern_get` off the end of the table.
    TokenList:kw1 = raw lex_all(0i32, "Result{5i32: 1i32}", @it, @ld);
    Ast:aw1 = raw ast_init();
    DiagList:gw1 = raw diaglist_init();
    Parser:pw1 = raw parser_init(@kw1, @aw1, @gw1, @it);
    drop p_parse_expr(@pw1);
    if ((raw diaglist_count(@gw1)) == 0i64)                  { exit 200i32; }
    Diagnostic:dw1 = raw diaglist_at(@gw1, 0i64);
    if (!(raw string_eq(dw1.code, raw PARSE_WRAPPER_FIELD()))) { exit 201i32; }

    // A REPEATED FIELD IS NOT AN OVERWRITE. Taking the last one silently discards
    // the first, which is the same lost-value defect wearing different clothes.
    TokenList:kw2 = raw lex_all(0i32, "Result{value: 1i32, value: 2i32}", @it, @ld);
    Ast:aw2 = raw ast_init();
    DiagList:gw2 = raw diaglist_init();
    Parser:pw2 = raw parser_init(@kw2, @aw2, @gw2, @it);
    drop p_parse_expr(@pw2);
    if ((raw diaglist_count(@gw2)) == 0i64)                  { exit 202i32; }
    Diagnostic:dw2 = raw diaglist_at(@gw2, 0i64);
    if (!(raw string_eq(dw2.code, raw PARSE_WRAPPER_FIELD()))) { exit 203i32; }


    // --- the `Result` fallback is `?|`; a bare `?` and `defaults` are struck (D-175) ---
    // D-175 reverses D-167 (which kept the wrong survivor): `?|` parses clean,
    // while a bare `?` and the word `defaults` are refused by name (PARSE-011).
    TokenList:kd = raw lex_all(0i32, "a ?| b", @it, @ld);
    Ast:ad = raw ast_init();
    DiagList:gd = raw diaglist_init();
    Parser:pd = raw parser_init(@kd, @ad, @gd, @it);
    drop p_parse_expr(@pd);
    if (raw diaglist_count(@gd) != 0i64)                 { exit 90i32; }
    TokenList:ke = raw lex_all(0i32, "a ? b", @it, @ld);
    Ast:ae = raw ast_init();
    DiagList:ge = raw diaglist_init();
    Parser:pe = raw parser_init(@ke, @ae, @ge, @it);
    drop p_parse_expr(@pe);
    if (raw diaglist_count(@ge) != 1i64)                 { exit 91i32; }
    Diagnostic:de = raw diaglist_at(@ge, 0i64);
    if (!(raw string_eq(de.code, raw PARSE_BARE_QUESTION_REMOVED()))) { exit 92i32; }
    TokenList:kx = raw lex_all(0i32, "a defaults b", @it, @ld);
    Ast:ax = raw ast_init();
    DiagList:gx = raw diaglist_init();
    Parser:px = raw parser_init(@kx, @ax, @gx, @it);
    drop p_parse_expr(@px);
    if (raw diaglist_count(@gx) != 1i64)                 { exit 93i32; }

    // --- `++` / `--` are removed (D-174, 1.0.9d) -------------------------------
    // Struck for the reason `?|` was: the prototype carried a C increment, this
    // language does not want a mutation that also YIELDS a value. Parsed (the
    // grammar is never partial, D-085) and refused by name with the replacement.
    TokenList:kg = raw lex_all(0i32, "a ++", @it, @ld);
    Ast:ag = raw ast_init();
    DiagList:gg = raw diaglist_init();
    Parser:pg = raw parser_init(@kg, @ag, @gg, @it);
    drop p_parse_expr(@pg);
    if (raw diaglist_count(@gg) != 1i64)                 { exit 100i32; }
    Diagnostic:dg = raw diaglist_at(@gg, 0i64);
    if (!(raw string_eq(dg.code, raw PARSE_INCDEC_REMOVED()))) { exit 101i32; }
    TokenList:kh = raw lex_all(0i32, "a --", @it, @ld);
    Ast:ah = raw ast_init();
    DiagList:gh = raw diaglist_init();
    Parser:ph = raw parser_init(@kh, @ah, @gh, @it);
    drop p_parse_expr(@ph);
    if (raw diaglist_count(@gh) != 1i64)                 { exit 102i32; }

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:_~err) {
    exit 1i32;
};
