// Type resolution — `TypeNode` → `Type` (cycle 0.4.1).

mod:resolve_types;
use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/resolve_codes.npk".*;
use "../../src/frontend/type_codes.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_type.npk".*;
use "../../src/frontend/parse_expr.npk".*;
use "../../src/frontend/parse_decorate.npk".*;
use "../../src/frontend/parse_stmt.npk".*;
use "../../src/frontend/parse_pick.npk".*;
use "../../src/frontend/parse_decl.npk".*;
use "../../src/frontend/symbols.npk".*;
use "../../src/frontend/types.npk".*;
use "../../src/frontend/builtin_types.npk".*;
use "../../src/frontend/flags_families.npk".*;
use "../../src/frontend/type_resolve.npk".*;

struct:Fix = {
    Ast:ast;
    TypeTable:types;
    SymbolTable:tab;
    DiagList:diags;
    int32:scope;
    int32:ty;
};

// Parse a bare TYPE and resolve it, in a scope holding whatever `decls` declares.
func:ty = Fix(string:decls, string:type_text, InternTable->:it) never fails {
    DiagList:ld = raw diaglist_init();
    Ast:ast = raw ast_init();
    DiagList:pd = raw diaglist_init();

    // The declarations first, so a named type has something to find.
    TokenList:dk = raw lex_all(0i32, decls, it, @ld);
    Parser:dp = raw parser_init(@dk, @ast, @pd, it);
    DeclId:mod_id = raw p_parse_module(@dp);

    SymbolTable:tab = raw symtab_init();
    DiagList:diags = raw diaglist_init();
    int32:scope = raw collect_module(@tab, @ast, @diags, mod_id, 0i32);

    // …then the type itself.
    TokenList:tk = raw lex_all(0i32, type_text, it, @ld);
    Parser:tp = raw parser_init(@tk, @ast, @pd, it);
    TypeId:node = raw p_parse_type(@tp);

    TypeTable:types = raw typetable_init();
    // NOTHING GENERIC HERE, so nothing to instantiate -- an EMPTY table rather
    // than a skipped argument, so that a context without instantiations says so.
    InstanceTable:inst = raw insttable_init();
    TypeResolver:r = raw tyres_init(@ast, @types, @tab, it, @diags, @inst);
    int32:resolved = raw resolve_type(@r, node, scope);

    Fix:f = Fix{ ast: ast, types: types, tab: tab, diags: diags,
                 scope: scope, ty: resolved };
    pass f;
};

func:errs = int64(Fix->:f) never fails { pass (raw diaglist_count(@f.diags)); };
// AN EXPLICIT COPY, not a view of the list (D-004 rule A). `diaglist_at` takes
// a borrow and hands back a `Diag`, which carries a string — so the CALL's
// result is borrow-derived and returning a field of it directly is refused.
// Reading the Diagnostic into a local first (parameter-rooted, so it taints nothing)
// and copying the code out is the honest spelling: what leaves this function is
// storage it owns, which is what the signature already claimed.
func:code0 = string(Fix->:f) never fails {
    Diagnostic:d = raw diaglist_at(@f.diags, 0i64);
    pass (string_concat(d.code, ""));
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();

    // --- the builtin scalars, from the GENERATED table -------------------------
    Fix:a = raw ty("", "int32", @it);
    if (raw errs(@a) != 0i64)                                  { exit 10i32; }
    if ((raw type_kind(@a.types, a.ty)) != (raw TY_INT()))  { exit 11i32; }
    if ((raw type_int_bits(@a.types, a.ty)) != 32i32)      { exit 12i32; }
    if (!(raw type_is_signed(@a.types, a.ty)))             { exit 13i32; }

    Fix:b = raw ty("", "uint64", @it);
    if ((raw type_int_bits(@b.types, b.ty)) != 64i32)      { exit 14i32; }
    if (raw type_is_signed(@b.types, b.ty))                { exit 15i32; }

    // `bool` and `char8` are one byte each and are NOT integers.
    Fix:c = raw ty("", "bool", @it);
    if ((raw type_kind(@c.types, c.ty)) != (raw TY_BOOL())) { exit 16i32; }
    if (raw type_is_numeric(@c.types, c.ty))               { exit 17i32; }
    Fix:d = raw ty("", "char8", @it);
    if ((raw type_kind(@d.types, d.ty)) != (raw TY_CHAR())) { exit 18i32; }
    if (raw type_is_numeric(@d.types, d.ty))               { exit 19i32; }

    // `fd` is its own type, not an integer (D-042).
    Fix:e = raw ty("", "fd", @it);
    if ((raw type_kind(@e.types, e.ty)) != (raw TY_KERNEL())) { exit 20i32; }
    if (raw type_is_numeric(@e.types, e.ty))               { exit 21i32; }

    // `oflags` is a flag family — one kind, the family in the window, not an
    // integer and not ordered (D-044/D-230, 1.4.8); `fmode` is another family.
    Fix:fl = raw ty("", "oflags", @it);
    if ((raw type_kind(@fl.types, fl.ty)) != (raw TY_FLAGS())) { exit 90i32; }
    if (raw type_is_numeric(@fl.types, fl.ty))                { exit 91i32; }
    if (raw type_is_ordered(@fl.types, fl.ty))                { exit 92i32; }
    if ((raw type_elem(@fl.types, fl.ty)) != (raw FLAGS_OFLAGS())) { exit 93i32; }
    // `range<int32>` is D-093's type, spellable since 1.4.8 (S-8).
    Fix:rg = raw ty("", "range<int32>", @it);
    if ((raw type_kind(@rg.types, rg.ty)) != (raw TY_RANGE())) { exit 96i32; }
    if ((raw type_kind(@rg.types, raw type_elem(@rg.types, rg.ty))) != (raw TY_INT())) { exit 97i32; }
    Fix:fm = raw ty("", "fmode", @it);
    if ((raw type_kind(@fm.types, fm.ty)) != (raw TY_FLAGS())) { exit 94i32; }
    if ((raw type_elem(@fm.types, fm.ty)) != (raw FLAGS_FMODE())) { exit 95i32; }

    // --- `cstring` is its own type, reachable since 0.2.8 -----------------------
    Fix:cs = raw ty("", "cstring", @it);
    if (raw errs(@cs) != 0i64)                                 { exit 25i32; }
    if ((raw type_kind(@cs.types, cs.ty)) != (raw TY_CSTRING())) { exit 26i32; }

    // --- `any` IS LEGAL ONLY UNDER `->` (TYPE_REFERENCE §27) ---------------------
    // A bare one is refused rather than silently promoted: a checker that
    // helpfully fixed it would make `any` mean two things depending on where it
    // was written.
    Fix:bare = raw ty("", "any", @it);
    if (raw errs(@bare) != 1i64)                               { exit 30i32; }
    if (!(raw string_eq(raw code0(@bare), raw TYPE_BARE_ANY()))) { exit 31i32; }

    Fix:ptr = raw ty("", "any->", @it);
    if (raw errs(@ptr) != 0i64)                                { exit 32i32; }
    if ((raw type_kind(@ptr.types, ptr.ty)) != (raw TY_POINTER())) { exit 33i32; }
    int32:pointee = raw type_elem(@ptr.types, ptr.ty);
    if ((raw type_kind(@ptr.types, pointee)) != (raw TY_ANY())) { exit 34i32; }

    // …and it is legal at every DEPTH, not only at the top. A struct field's
    // `wild any->` is the same case as one in a signature.
    Fix:deep = raw ty("", "any->->", @it);
    if (raw errs(@deep) != 0i64)                               { exit 35i32; }

    // --- ONE NODE, TWO TYPES: `T[]` and `T[N]` (D-070) ----------------------------
    Fix:sl = raw ty("", "int32[]", @it);
    if ((raw type_kind(@sl.types, sl.ty)) != (raw TY_SLICE())) { exit 40i32; }
    // A slice is {ptr, len} whatever it points at.
    if ((raw type_size(@sl.types, sl.ty)) != 16i64)        { exit 41i32; }

    Fix:ar = raw ty("", "int32[4]", @it);
    if ((raw type_kind(@ar.types, ar.ty)) != (raw TY_ARRAY())) { exit 42i32; }
    // An array CONTAINS its elements, so its size depends on theirs.
    if ((raw type_size(@ar.types, ar.ty)) != 16i64)        { exit 43i32; }

    // An array size that is not constant is refused BY NAME rather than taking
    // whatever number happened to be lying around -- which is what 0.2.8 found
    // this path doing before the size became a real expression.
    Fix:bad = raw ty("", "int32[COUNT]", @it);
    if (raw errs(@bad) != 1i64)                                { exit 44i32; }
    if (!(raw string_eq(raw code0(@bad), raw TYPE_NOT_CONSTANT()))) { exit 45i32; }

    // --- a NAMED type resolves to its declaration (D-090) --------------------------
    Fix:st = raw ty("struct:Point = { int32:x; };", "Point", @it);
    if (raw errs(@st) != 0i64)                                 { exit 50i32; }
    if ((raw type_kind(@st.types, st.ty)) != (raw TY_STRUCT())) { exit 51i32; }

    // Two structs with the same shape are DIFFERENT TYPES.
    Fix:two = raw ty("struct:Meters = { int32:v; }; struct:Seconds = { int32:v; };",
                     "Meters", @it);
    InstanceTable:inst2 = raw insttable_init();
    TypeResolver:r2 = raw tyres_init(@two.ast, @two.types, @two.tab, @it, @two.diags, @inst2);
    // Resolve `Seconds` in the same table and compare.
    DiagList:ld2 = raw diaglist_init();
    TokenList:sk = raw lex_all(0i32, "Seconds", @it, @ld2);
    DiagList:pd2 = raw diaglist_init();
    Parser:sp = raw parser_init(@sk, @two.ast, @pd2, @it);
    TypeId:snode = raw p_parse_type(@sp);
    int32:seconds = raw resolve_type(@r2, snode, two.scope);
    if (two.ty == seconds)                                 { exit 52i32; }

    // --- a name that is NOT a type says what it IS ------------------------------------
    // "unknown type `helper`" would send the reader hunting for a declaration
    // that is right there.
    Fix:fn = raw ty("func:helper = int32() { pass 1i32; };", "helper", @it);
    if (raw errs(@fn) != 1i64)                                 { exit 60i32; }
    if (!(raw string_eq(raw code0(@fn), raw TYPE_NOT_A_TYPE()))) { exit 61i32; }

    // …while a name that is nowhere says THAT.
    Fix:no = raw ty("", "Nowhere", @it);
    if (raw errs(@no) != 1i64)                                 { exit 62i32; }
    if (!(raw string_eq(raw code0(@no), raw TYPE_UNKNOWN())))   { exit 63i32; }

    // --- `func RetType(Params)` (D-087) -------------------------------------------------
    Fix:ft = raw ty("", "func int32(int32, int64)", @it);
    if (raw errs(@ft) != 0i64)                                 { exit 70i32; }
    if ((raw type_kind(@ft.types, ft.ty)) != (raw TY_FUNC())) { exit 71i32; }
    // One word: a code address with no captured environment, because closures
    // are removed (D-018).
    if ((raw type_size(@ft.types, ft.ty)) != 8i64)         { exit 72i32; }

    // --- `Self` is valid only inside a trait or impl (D-030) -----------------------------
    Fix:sf = raw ty("", "Self", @it);
    if (raw errs(@sf) != 1i64)                                 { exit 80i32; }
    if (!(raw string_eq(raw code0(@sf), raw TYPE_SELF_OUTSIDE()))) { exit 81i32; }

    // --- every operand of `dyn` must be a trait -------------------------------------------
    Fix:dy = raw ty("trait:Drawable = { }; trait:Printable = { };",
                    "dyn Drawable & Printable", @it);
    if (raw errs(@dy) != 0i64)                                 { exit 90i32; }
    if ((raw type_kind(@dy.types, dy.ty)) != (raw TY_DYN())) { exit 91i32; }
    // ONE VTABLE WORD PER TRAIT, PLUS THE DATA WORD (D-159, 1.0.5). This
    // asserted a flat 16 bytes, which is right for `dyn A` and wrong for every
    // wider one -- two bounds need three words, and the second vtable pointer
    // had nowhere to live.
    if ((raw type_size(@dy.types, dy.ty)) != 24i64)        { exit 92i32; }

    // A SINGLE BOUND IS STILL THE SPEC'S FAT POINTER.
    Fix:dy1 = raw ty("trait:Drawable = { };", "dyn Drawable", @it);
    if (raw errs(@dy1) != 0i64)                                { exit 95i32; }
    if ((raw type_size(@dy1.types, dy1.ty)) != 16i64)      { exit 96i32; }

    // AND THREE BOUNDS ARE FOUR WORDS.
    Fix:dy3 = raw ty("trait:Aa = { }; trait:Bb = { }; trait:Cc = { };",
                     "dyn Aa & Bb & Cc", @it);
    if (raw errs(@dy3) != 0i64)                                { exit 97i32; }
    if ((raw type_size(@dy3.types, dy3.ty)) != 32i64)      { exit 98i32; }

    // `dyn A & B` AND `dyn B & A` ARE ONE TYPE (D-159). Interning keys on the
    // window, so without a canonical order these were two interned types with
    // two layouts and two different answers to which word holds which vtable.
    // The bounds are sorted by NAME at interning, so the two spellings collapse.
    Fix:dyx = raw ty("trait:Drawable = { }; trait:Printable = { };",
                     "dyn Printable & Drawable", @it);
    if (raw errs(@dyx) != 0i64)                                { exit 99i32; }
    if (dyx.ty != dy.ty)                               { exit 100i32; }

    // `dyn int32` is not a dynamic anything, and catching it here means 0.4.6 can
    // assume a `dyn` has traits.
    Fix:dyn_bad = raw ty("", "dyn int32", @it);
    if (raw errs(@dyn_bad) != 1i64)                            { exit 93i32; }
    if (!(raw string_eq(raw code0(@dyn_bad), raw TYPE_DYN_NOT_TRAIT()))) { exit 94i32; }

    // --- a failure yields the INVALID type, not nothing ------------------------------------
    // One bad annotation produces ONE diagnostic. A pointer to something that did
    // not resolve is still a pointer, so nothing downstream cascades.
    Fix:cascade = raw ty("", "Nowhere->", @it);
    if (raw errs(@cascade) != 1i64)                            { exit 100i32; }
    if ((raw type_kind(@cascade.types, cascade.ty)) != (raw TY_POINTER())) {
        exit 101i32;
    }

    wild_release_all();

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (intern.BoundsId) { exit 1i32; },
        (ast.BoundsId) { exit 1i32; },
        (diagnostics.BoundsId) { exit 1i32; },
        (symbols.BoundsId) { exit 1i32; },
        (types.BoundsId) { exit 1i32; },
        (source.FileUnknown) { exit 1i32; },
        (source.BoundsIndex) { exit 1i32; },
        (source.BoundsOffset) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (BoundsId) { exit 1i32; },
        (BoundsIndex) { exit 1i32; },
        (BoundsScratch) { exit 1i32; },
        (BoundsWindow) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
