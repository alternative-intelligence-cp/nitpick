// WHAT EXPANSION PRODUCED, asserted directly (cycle 0.6.6).
//
// EVERY OTHER SUITE ASSERTS ON DIAGNOSTICS — a code and a span, or silence. That is
// enough when a pass READS the AST and reports. **Expansion rewrites it**, and a
// rewrite that is wrong in a way that still type-checks produces no diagnostic at
// all: the program compiles and means something other than what was written, which
// is the failure mode this whole cycle opens with.
//
// THE CYCLE PLAN PROPOSED `tests/conformance/`, WHICH CANNOT WORK. Those tests are
// compiled and RUN by the seed, and the seed has no macro support at all — no
// `macro:` in its parser, its checker or its emitter. A conformance test containing
// one does not build.
//
// So the assertion is made in-process instead, which is better anyway: this links
// the real expander, runs it, and then WALKS THE RESULTING AST and says what should
// be in it. Not a general AST-comparison rig — the plan is right that one is larger
// than this subcycle should absorb — but targeted assertions about member counts
// and names, which is what the failure mode actually needs.

mod:expansion_output;
use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_decl.npk".*;
use "../../src/frontend/parse_decorate.npk".*;   // contract_cond (1.5.1)
use "../../src/frontend/parse_expr.npk".*;
use "../../src/frontend/parse_type.npk".*;       // type_array_size (1.6.1e step 3)
use "../../src/frontend/macro/expand.npk".*;
use "../../src/frontend/macro/macro_codes.npk".*;

struct:Ex = {
    Ast:ast;
    DiagList:diags;
    DeclId:root;
};

// Parse a module and expand it to a fixed point, exactly as the driver does.
func:expanded = Ex(string:src, InternTable->:it) never fails {
    Ast:ast = raw ast_init();
    DiagList:diags = raw diaglist_init();
    TokenList:toks = raw lex_all(0i32, src, it, @diags);
    Parser:p = raw parser_init(@toks, @ast, @diags, it);
    DeclId:root = raw p_parse_module(@p);

    Expander:x = raw expander_init(@ast, it, @diags);
    drop collect_macros(@x, root);

    // WHAT THE DECLARATIONS DECIDE COMES FIRST, and a program it refuses is not
    // expanded (1.6.1e step 3) -- the driver's order, kept here so that this
    // file asserts on what the driver would have produced.
    drop check_macro_decls(@x);
    if ((raw diaglist_count(@diags)) != 0i64) {
        Ex:refused = Ex{ ast: move(ast), diags: diags, root: root };
        pass refused;
    }

    int32:round = 0i32;
    bool:more = true;
    while (more) decreases (raw EXPAND_ROUNDS()) - round {
        if (round >= (raw EXPAND_ROUNDS())) { break; }
        more = raw expand_module(@x, root);
        if (raw expander_blown(@x)) { break; }
        round = round + 1i32;
    }
    // The bound, and the probe that asks who is standing at it.
    if (more) {
        if (!(raw expander_blown(@x))) {
            drop expand_probe_begin(@x);
            discard(raw expand_module(@x, root));
            drop expand_no_fixpoint(@x);
        }
    }

    Ex:e = Ex{ ast: move(ast), diags: diags, root: root };
    pass e;
};

// Does the list hold exactly one diagnostic, with this code?
func:one_diag = bool(Ex->:e, string:code) never fails {
    if ((raw diaglist_count(@e.diags)) != 1i64) { pass false; }
    Diagnostic:d = raw diaglist_at(@e.diags, 0i64);
    pass (raw string_eq(d.code, code));
};

// A FILE'S OWN `mod:` LINE IS A MEMBER, and every count below includes it. That is
// not an accident of this test: `p_parse_module` parses every declaration in the
// file as a member, and the header is one — which is how the loader finds a
// `mod:name;` with no body and goes looking for `name.npk`.
//
// Worth stating because the first version of this file counted without it and one
// of the four cases passed anyway, on a number that was right for the wrong reason.
func:member_count = int32(Ex->:e) never fails {
    DeclNode:m = raw ast_decl(@e.ast, e.root);
    pass (raw item_member_count(@e.ast, m));
};

// Is there a member of this kind with this name? The question a wrong expansion
// answers differently from a right one.
func:has_member = bool(Ex->:e, InternTable->:it, DeclKind:kind, string:name) never fails {
    DeclNode:m = raw ast_decl(@e.ast, e.root);
    int32:n = raw item_member_count(@e.ast, m);
    int32:i = 0i32;
    while (i < n) decreases n - i {
        DeclNode:d = raw ast_decl(@e.ast, raw item_member(@e.ast, m, i));
        if (d.kind == kind) {
            if (raw string_eq(raw intern_get(it, raw decl_name(d)), name)) {
                pass true;
            }
        }
        i = i + 1i32;
    }
    pass false;
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();

    // --- ONE INVOCATION, TWO DECLARATIONS, BOTH PRESENT ----------------------
    //
    // `bug591`'s shape. A splice that emitted nothing, or one declaration instead
    // of two, type-checks perfectly in a program that does not call them.
    Ex:v1 = raw expanded(
        "mod:m; macro:pair = () { func:a = int32() { pass 1i32; }; func:b = int32() { pass 2i32; }; }; #pair();",
        @it);
    if ((raw diaglist_count(@v1.diags)) != 0i64)                    { exit 10i32; }
    // The macro declaration stays; the splice is replaced by its two functions.
    // `mod:m;` + the macro declaration + the two emitted functions.
    if ((raw member_count(@v1)) != 4i32)                            { exit 11i32; }
    if (!(raw has_member(@v1, @it, DeclKind.DeclFunctionDecl, "a"))) { exit 12i32; }
    if (!(raw has_member(@v1, @it, DeclKind.DeclFunctionDecl, "b"))) { exit 13i32; }
    // AND THE SPLICE IS GONE. A splice left standing would expand again on every
    // round, which the fixed-point loop would not settle out of.
    if (raw has_member(@v1, @it, DeclKind.DeclMacroSplice, ""))      { exit 14i32; }

    // --- TWO INVOCATIONS ARE TWO SUBTREES ------------------------------------
    //
    // Every instantiation is a clone, because two invocations may substitute
    // different arguments — sharing the body's nodes would make the second
    // invocation rewrite the first. Counting members is what shows the second one
    // happened at all.
    Ex:v2 = raw expanded(
        "mod:m; macro:one = () { func:x = int32() { pass 1i32; }; }; #one(); #one();",
        @it);
    // Two functions named `x`: a collision the resolver refuses, and the point here
    // is only that the expander produced BOTH rather than one.
    // `mod:m;` + the macro + BOTH emitted functions.
    if ((raw member_count(@v2)) != 4i32)                            { exit 20i32; }

    // --- NESTED: THE FIXED POINT IS A FIXED POINT ----------------------------
    //
    // `bug594`. `#outer()` emits `#inner()` and a function; the inner splice
    // expands on the round after. One pass produces three members and the wrong
    // answer, and nothing about the resulting program is ill-typed.
    Ex:v3 = raw expanded(
        "mod:m; macro:inner = () { func:i1 = int32() { pass 1i32; }; func:i2 = int32() { pass 2i32; }; }; macro:outer = () { #inner(); func:o1 = int32() { pass 3i32; }; }; #outer();",
        @it);
    if ((raw diaglist_count(@v3.diags)) != 0i64)                    { exit 30i32; }
    // `mod:m;` + two macro declarations + i1 + i2 + o1.
    if ((raw member_count(@v3)) != 6i32)                            { exit 31i32; }
    if (!(raw has_member(@v3, @it, DeclKind.DeclFunctionDecl, "i1"))) { exit 32i32; }
    if (!(raw has_member(@v3, @it, DeclKind.DeclFunctionDecl, "i2"))) { exit 33i32; }
    if (!(raw has_member(@v3, @it, DeclKind.DeclFunctionDecl, "o1"))) { exit 34i32; }

    // --- A PARAMETER REACHES THE BODY ----------------------------------------
    //
    // `bug593`. Substitution that silently did nothing leaves the emitted function
    // returning a name that resolves to nothing — which IS caught downstream, but
    // only because the body happens to reference the parameter. The assertion here
    // is that the expansion happened at all.
    Ex:v4 = raw expanded(
        "mod:m; macro:mk = (V) { func:got = int32() { pass V; }; }; #mk(42i32);",
        @it);
    if ((raw diaglist_count(@v4.diags)) != 0i64)                    { exit 40i32; }
    // `mod:m;` + the macro + the emitted function.
    if ((raw member_count(@v4)) != 3i32)                            { exit 41i32; }
    if (!(raw has_member(@v4, @it, DeclKind.DeclFunctionDecl, "got"))) { exit 42i32; }

    // --- VERIFICATION NODES ARE CLONED PER EXPANSION (1.5.1, V-19) ----------
    //
    // Two invocations of a macro whose function carries an `ensures` must
    // produce two contract nodes with two DISTINCT condition expressions. The
    // clone used to copy the VerifyId index, so both expansions shared one
    // condition with the template — and resolution writes a binding onto the
    // shared node, so the last expansion resolved won. Nothing about the
    // program was ill-typed; only its meaning was wrong, in the second copy.
    Ex:v5 = raw expanded(
        "mod:m; macro:mkg = () { func:g = int32(int32:a) ensures result > 0i32 { pass a; }; }; #mkg(); #mkg();",
        @it);
    if ((raw diaglist_count(@v5.diags)) != 0i64)                    { exit 60i32; }
    // `mod:m;` + the macro + BOTH emitted functions.
    if ((raw member_count(@v5)) != 4i32)                            { exit 61i32; }
    int32:first_cond = 0i32;
    int32:second_cond = 0i32;
    int32:seen = 0i32;
    DeclNode:m5 = raw ast_decl(@v5.ast, v5.root);
    int32:mc5 = raw item_member_count(@v5.ast, m5);
    for (int32:mi in 0i32...mc5) {
        DeclNode:md = raw ast_decl(@v5.ast, raw item_member(@v5.ast, m5, mi));
        if (md.kind == DeclKind.DeclFunctionDecl) {
            if ((raw fn_contract_count(@v5.ast, md)) == 1i32) {
                VerifyNode:cv = raw ast_verify(@v5.ast, raw fn_contract(@v5.ast, md, 0i32));
                if (seen == 0i32) { first_cond = (raw contract_cond(cv)).index; }
                if (seen == 1i32) { second_cond = (raw contract_cond(cv)).index; }
                seen = seen + 1i32;
            }
        }
    }
    if (seen != 2i32)                                                { exit 62i32; }
    if (first_cond == 0i32)                                          { exit 63i32; }
    if (first_cond == second_cond)                                   { exit 64i32; }

    // --- AN ALIAS AT MODULE LEVEL IS WHAT ITS TARGET IS (DEF-171, 1.6.1e step 3) --
    //
    // `macro:al = () { #t(); };` is read as an expression body, and the splice
    // refused it for standing where declarations go. It is passed through now:
    // one round turns `#al();` into `#t();`, the next into `t`'s function.
    Ex:v6 = raw expanded(
        "mod:m; macro:t = () { func:from_t = int32() { pass 1i32; }; }; macro:al = () { #t(); }; #al();",
        @it);
    if ((raw diaglist_count(@v6.diags)) != 0i64)                    { exit 70i32; }
    // `mod:m;` + the two macros + the one emitted function.
    if ((raw member_count(@v6)) != 4i32)                            { exit 71i32; }
    if (!(raw has_member(@v6, @it, DeclKind.DeclFunctionDecl, "from_t"))) { exit 72i32; }
    if (raw has_member(@v6, @it, DeclKind.DeclMacroSplice, ""))      { exit 73i32; }

    // --- AN INVOCATION INSIDE A TYPE IS SUBSTITUTED WHERE IT STANDS (DEF-170) ----
    //
    // The walk never entered a type, so `int32[#three()]` kept its invocation and
    // the audit called it a hole. The size is the literal now -- in place, in the
    // type node the declaration already pointed at.
    Ex:v7 = raw expanded(
        "mod:m; macro:three = () { 3i32; }; fixed int32[#three()]:g = [1i32, 2i32, 3i32];",
        @it);
    if ((raw diaglist_count(@v7.diags)) != 0i64)                    { exit 80i32; }
    bool:sized = false;
    DeclNode:m7 = raw ast_decl(@v7.ast, v7.root);
    int32:mc7 = raw item_member_count(@v7.ast, m7);
    for (int32:gi in 0i32...mc7) {
        DeclNode:gd = raw ast_decl(@v7.ast, raw item_member(@v7.ast, m7, gi));
        if (gd.kind == DeclKind.DeclGlobalDecl) {
            TypeNode:gt = raw ast_type(@v7.ast, raw global_type(gd));
            if (gt.kind != TypeKind.TypeArrayType)                   { exit 81i32; }
            ExprNode:sz = raw ast_expr(@v7.ast, raw type_array_size(gt));
            if (sz.kind != ExprKind.ExprIntLiteral)                  { exit 82i32; }
            if (sz.payload != 3i64)                                  { exit 83i32; }
            sized = true;
        }
    }
    if (!sized)                                                      { exit 84i32; }

    // --- A CYCLE IS REFUSED AT THE DECLARATIONS, AND NOTHING EXPANDS (DEF-172) ---
    //
    // One report for a macro that invokes itself, uninvoked; one for a mutual
    // pair; none for a chain that ends. And the refused program is left as it
    // was parsed: the splice of `#p();` is still a splice.
    Ex:v8 = raw expanded("mod:m; macro:s = () { #s(); };", @it);
    if (!(raw one_diag(@v8, raw MACRO_NO_FIXPOINT())))               { exit 90i32; }
    Ex:v9 = raw expanded(
        "mod:m; macro:p = () { func:fp = int32() { pass 1i32; }; #q(); }; macro:q = () { func:fq = int32() { pass 2i32; }; #p(); }; #p();",
        @it);
    if (!(raw one_diag(@v9, raw MACRO_NO_FIXPOINT())))               { exit 91i32; }
    if (!(raw has_member(@v9, @it, DeclKind.DeclMacroSplice, "")))   { exit 92i32; }
    if (raw has_member(@v9, @it, DeclKind.DeclFunctionDecl, "fp"))   { exit 93i32; }
    Ex:v10 = raw expanded(
        "mod:m; macro:a1 = () { #a2() + 1i32; }; macro:a2 = () { #a3() + 1i32; }; macro:a3 = () { 1i32; };",
        @it);
    if ((raw diaglist_count(@v10.diags)) != 0i64)                   { exit 94i32; }

    // --- A `macro:` INSIDE A MACRO BODY IS REFUSED WHERE IT IS WRITTEN (DEF-173) --
    Ex:v11 = raw expanded(
        "mod:m; macro:outer = () { macro:inner = () { 1i32; }; func:g = int32() { pass 2i32; }; };",
        @it);
    if (!(raw one_diag(@v11, raw MACRO_WRONG_SHAPE())))              { exit 95i32; }

    // --- A PARAMETER IN A TYPE IS SUBSTITUTED, AND THE TYPE IS THE INSTANTIATION'S
    //     OWN (DEF-189, 1.6.1e step 3a) -----------------------------------------------
    //
    // Two splices of one field macro: each struct's `arr` is its own array type
    // whose size is its own argument, where both pointed at the template's
    // `int32[N]` until this step. And a type with no expression inside cannot
    // differ between instantiations, so it stays ONE node: both `tail` fields
    // point at the template's `int32`.
    Ex:v12 = raw expanded(
        "mod:m; macro:af = (N) { int32[N]:arr; int32:tail; }; struct:S3 = { #af(3i32); }; struct:S5 = { #af(5i32); };",
        @it);
    if ((raw diaglist_count(@v12.diags)) != 0i64)                   { exit 96i32; }
    int32:arr_first = 0i32;
    int32:arr_second = 0i32;
    int32:tail_first = 0i32;
    int32:tail_second = 0i32;
    int64:size_sum = 0i64;
    int32:structs = 0i32;
    DeclNode:m12 = raw ast_decl(@v12.ast, v12.root);
    int32:mc12 = raw item_member_count(@v12.ast, m12);
    for (int32:si in 0i32...mc12) {
        DeclNode:sd = raw ast_decl(@v12.ast, raw item_member(@v12.ast, m12, si));
        if (sd.kind == DeclKind.DeclStructDecl) {
            if ((raw item_member_count(@v12.ast, sd)) != 2i32)        { exit 97i32; }
            DeclNode:fa = raw ast_decl(@v12.ast, raw item_member(@v12.ast, sd, 0i32));
            DeclNode:ft = raw ast_decl(@v12.ast, raw item_member(@v12.ast, sd, 1i32));
            if (fa.kind != DeclKind.DeclFieldDecl)                   { exit 98i32; }
            TypeNode:at = raw ast_type(@v12.ast, raw field_type(fa));
            if (at.kind != TypeKind.TypeArrayType)                   { exit 99i32; }
            ExprNode:asz = raw ast_expr(@v12.ast, raw type_array_size(at));
            if (asz.kind != ExprKind.ExprIntLiteral)                 { exit 100i32; }
            size_sum = size_sum + asz.payload;
            if (structs == 0i32) { arr_first = (raw field_type(fa)).index;  tail_first = (raw field_type(ft)).index; }
            if (structs == 1i32) { arr_second = (raw field_type(fa)).index; tail_second = (raw field_type(ft)).index; }
            structs = structs + 1i32;
        }
    }
    if (structs != 2i32)                                             { exit 101i32; }
    if (size_sum != 8i64)                                            { exit 102i32; }   // 3 and 5
    if (arr_first == arr_second)                                     { exit 103i32; }
    if (tail_first == 0i32)                                          { exit 104i32; }
    if (tail_first != tail_second)                                   { exit 105i32; }

    // --- WHAT A PARAMETER CANNOT BE IS REFUSED AT THE DECLARATION (DEF-189) -------
    //
    // A type's name, and a name the body declares AND uses: one report each,
    // uninvoked.
    Ex:v13 = raw expanded("mod:m; macro:bad = (T) { T:x = 1i32; };", @it);
    if (!(raw one_diag(@v13, raw MACRO_PARAM_FORM())))               { exit 106i32; }
    Ex:v14 = raw expanded("mod:m; macro:bump = (N) { int32:N = 1i32; #caller(g) = N + 1i32; };", @it);
    if (!(raw one_diag(@v14, raw MACRO_PARAM_FORM())))               { exit 107i32; }
    // A FIELD of the parameter's spelling is no identifier and is left alone. A
    // name declared and never written as an expression was MACRO_REFERENCE §10's
    // open question (`func:N` was literally called `N`, the argument dropped) and is
    // REFUSED since D-343 (1.6.1e landing 106), one MACRO-011 at the declaration; a
    // program refused at a macro's declaration is not expanded, so no `N` is
    // emitted. The name inside `#caller(…)` is copied by name, no use of the
    // parameter -- but `esc` declares `N` too, and the declaration is what the rule
    // refuses.
    Ex:v15 = raw expanded("mod:m; struct:B = { int32:v; }; macro:ok = (v) { B{ v: v }; };", @it);
    if ((raw diaglist_count(@v15.diags)) != 0i64)                   { exit 108i32; }
    Ex:v16 = raw expanded("mod:m; macro:mk = (N) { func:N = int32() never fails { pass 5i32; }; }; #mk(7i32);", @it);
    if (!(raw one_diag(@v16, raw MACRO_PARAM_FORM())))               { exit 109i32; }
    if (raw has_member(@v16, @it, DeclKind.DeclFunctionDecl, "N"))   { exit 110i32; }
    Ex:v17 = raw expanded("mod:m; macro:esc = (N) { int32:N = 1i32; #caller(g) = #caller(N); };", @it);
    if (!(raw one_diag(@v17, raw MACRO_PARAM_FORM())))               { exit 111i32; }

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (ast.BoundsId) { exit 1i32; },
        (diagnostics.BoundsId) { exit 1i32; },
        (token.BoundsId) { exit 1i32; },
        (source.FileUnknown) { exit 1i32; },
        (source.BoundsIndex) { exit 1i32; },
        (source.BoundsOffset) { exit 1i32; },
        (types.BoundsId) { exit 1i32; },
        (types.BoundsIndex) { exit 1i32; },
        (ShiftRange)  { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (BoundsId) { exit 1i32; },
        (BoundsScratch) { exit 1i32; },
        (BoundsWindow) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (StackExhausted) { exit 1i32; },
        (MachineFault) { exit 1i32; },
        (LimitViolated) { exit 1i32; },
        (DecreasesViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
