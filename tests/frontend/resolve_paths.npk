// Path manipulation and `use` resolution (cycle 0.3.2).
//
// The resolution cases probe REAL FILES, so this test assumes the harness runs
// from the repository root — which it documents, and which every other suite
// already relies on for its relative `use` paths.

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/resolve_codes.npk".*;
use "../../src/frontend/paths.npk".*;
use "../../src/frontend/resolve_path.npk".*;

func:eq = bool(string:a, string:b) {
    pass (raw string_eq(a, b));
};

func:main = int32(cstring[]:_~argv) {
    // --- classification is by FIRST CHARACTER --------------------------------
    if (!(raw path_is_relative("./x.npk")))       { exit 10i32; }
    if (!(raw path_is_relative("../x.npk")))      { exit 11i32; }
    if (raw path_is_relative("nfs/x.npk"))        { exit 12i32; }
    // `.hidden` is not a relative path: the marker is `./`, not a leading dot.
    if (raw path_is_relative(".hidden"))          { exit 13i32; }
    if (!(raw path_is_absolute("/etc/x")))        { exit 14i32; }
    if (raw path_is_absolute("etc/x"))            { exit 15i32; }

    // --- dirname -------------------------------------------------------------
    if (!(raw eq(relay path_dirname("a/b/c.npk"), "a/b")))  { exit 20i32; }
    if (!(raw eq(relay path_dirname("c.npk"), ".")))        { exit 21i32; }
    if (!(raw eq(relay path_dirname("/c.npk"), "/")))       { exit 22i32; }

    // --- normalisation is what makes ONE FILE ONE FILE ID ---------------------
    // `./a/../b.npk` and `b.npk` name the same file. A source manager holding
    // both would load the module twice and declare every symbol in it twice, so
    // 0.3.1's duplicate diagnostic would fire on a file nobody edited.
    if (!(raw eq(relay path_normalise("./a/../b.npk"), "b.npk")))   { exit 30i32; }
    if (!(raw eq(relay path_normalise("a/./b.npk"), "a/b.npk")))    { exit 31i32; }
    if (!(raw eq(relay path_normalise("a//b.npk"), "a/b.npk")))     { exit 32i32; }
    if (!(raw eq(relay path_normalise("a/b/../c.npk"), "a/c.npk"))) { exit 33i32; }
    if (!(raw eq(relay path_normalise("a/b/"), "a/b")))             { exit 34i32; }
    if (!(raw eq(relay path_normalise("a/.."), ".")))               { exit 35i32; }

    // A leading `..` that cannot be cancelled is KEPT -- there is no directory
    // above it to fold into, and dropping it would name a different file.
    if (!(raw eq(relay path_normalise("../a.npk"), "../a.npk")))    { exit 36i32; }
    // And `../../x` must not collapse to `../x`: popping a `..` with a `..` is
    // the mistake that silently climbs one directory too few.
    if (!(raw eq(relay path_normalise("../../x"), "../../x")))      { exit 37i32; }
    // An absolute path cannot escape the root.
    if (!(raw eq(relay path_normalise("/../a"), "/a")))             { exit 38i32; }
    if (!(raw eq(relay path_normalise("/a/b/../c"), "/a/c")))       { exit 39i32; }

    // --- resolving against the importing file's directory ----------------------
    string:from = "src/frontend/parser.npk";
    RootList:none = raw rootlist_init();

    Resolution:r1 = relay resolve_use(from, "./ast.npk", @none, "");
    if (r1.status != (raw RESOLVED_OK()))                        { exit 40i32; }
    if (!(raw eq(r1.path, "src/frontend/ast.npk")))              { exit 41i32; }

    // The same file reached the long way round normalises to the same path, so
    // it will take the same file id.
    Resolution:r2 = relay resolve_use(from, "./../frontend/ast.npk", @none, "");
    if (r2.status != (raw RESOLVED_OK()))                        { exit 42i32; }
    if (!(raw eq(r2.path, r1.path)))                             { exit 43i32; }

    // A `./` path that does not exist is an ERROR, never a retry against the
    // roots. There is no fallback between classes.
    RootList:one = raw rootlist_init();
    drop rootlist_add(@one, "x", ".");           // roots at ./src
    Resolution:r3 = relay resolve_use(from, "./frontend/ast.npk", @one, "");
    if (r3.status != (raw RESOLVED_NOT_FOUND()))                 { exit 44i32; }

    // --- resolving against a dependency root -------------------------------------
    // A dependency declared at `.` roots at `./src`, so `frontend/ast.npk`
    // resolves to `src/frontend/ast.npk`.
    Resolution:r4 = relay resolve_use(from, "frontend/ast.npk", @one, "");
    if (r4.status != (raw RESOLVED_OK()))                        { exit 50i32; }
    if (!(raw eq(r4.path, "src/frontend/ast.npk")))              { exit 51i32; }

    Resolution:r5 = relay resolve_use(from, "frontend/nothere.npk", @one, "");
    if (r5.status != (raw RESOLVED_NOT_FOUND()))                 { exit 52i32; }

    // --- ambiguity is an ERROR, and it names BOTH ---------------------------------
    // Two roots supplying one path. Not first-match, and not manifest order: a
    // first-match rule means adding a dependency can silently change which file
    // an existing `use` resolves to, in a module nobody edited.
    RootList:two = raw rootlist_init();
    drop rootlist_add(@two, "a", ".");
    drop rootlist_add(@two, "b", ".");
    Resolution:r6 = relay resolve_use(from, "frontend/ast.npk", @two, "");
    if (r6.status != (raw RESOLVED_AMBIGUOUS()))                 { exit 60i32; }
    if (r6.first.len == 0i64)                                    { exit 61i32; }
    if (r6.second.len == 0i64)                                   { exit 62i32; }

    // The standard library is a root like any other and gets NO precedence: a
    // name it supplies and a dependency also supplies is still ambiguous,
    // because silently preferring one is what this rule exists to prevent.
    Resolution:r7 = relay resolve_use(from, "frontend/ast.npk", @one, "./src");
    if (r7.status != (raw RESOLVED_AMBIGUOUS()))                 { exit 63i32; }

    // …and on its own it resolves.
    Resolution:r8 = relay resolve_use(from, "frontend/ast.npk", @none, "./src");
    if (r8.status != (raw RESOLVED_OK()))                        { exit 64i32; }

    // --- the diagnostics name what a reader needs -----------------------------------
    DiagList:d = raw diaglist_init();
    Span:sp = raw span_none();
    drop report_resolution(@d, r6, "frontend/ast.npk", sp);
    if (raw diaglist_count(@d) != 1i64)                          { exit 70i32; }
    if (!(raw string_eq((raw diaglist_at(@d, 0i64)).code, raw RESOLVE_AMBIGUOUS()))) {
        exit 71i32;
    }

    drop report_resolution(@d, r5, "frontend/nothere.npk", sp);
    if (raw diaglist_count(@d) != 2i64)                          { exit 72i32; }
    if (!(raw string_eq((raw diaglist_at(@d, 1i64)).code, raw RESOLVE_NO_SUCH_FILE()))) {
        exit 73i32;
    }

    // A successful resolution reports NOTHING.
    drop report_resolution(@d, r4, "frontend/ast.npk", sp);
    if (raw diaglist_count(@d) != 2i64)                          { exit 74i32; }

    wild_release_all();

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) {
    exit 1i32;
};
