// AST storage (cycle 0.2.0).

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/num_width.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;

func:main = int32(cstring[]:_~argv) {
    Ast:ast = raw ast_init();
    Span:sp = raw span_point(0i32, 0i32, 1i32, 1i32);

    // --- index 0 is a reserved NONE node in every array ---------------------
    // A zeroed handle must be a well-defined absence, not a silent reference to
    // whichever node happened to be created first.
    if (!(raw expr_is_none(raw expr_none())))            { exit 10i32; }
    if (!(raw stmt_is_none(raw stmt_none())))            { exit 11i32; }
    ExprNode:n0 = raw ast_expr(@ast, raw expr_none());
    if (n0.kind != ExprKind.ExprNone)                    { exit 12i32; }
    if (raw ast_expr_count(@ast) != 1i32)                { exit 13i32; }

    // --- nodes round-trip ---------------------------------------------------
    ExprId:lit = raw ast_add_expr(@ast, ExprKind.ExprIntLiteral, sp,
                                  0i32, 0i32, 0i32, 42i64);
    if (raw expr_is_none(lit))                           { exit 20i32; }
    ExprNode:got = raw ast_expr(@ast, lit);
    if (got.kind != ExprKind.ExprIntLiteral)             { exit 21i32; }
    if (got.payload != 42i64)                            { exit 22i32; }
    if (got.span.line != 1i32)                           { exit 23i32; }

    // A node referring to another does so by INDEX, which survives growth.
    ExprId:rhs = raw ast_add_expr(@ast, ExprKind.ExprIntLiteral, sp,
                                  0i32, 0i32, 0i32, 7i64);
    ExprId:bin = raw ast_add_expr(@ast, ExprKind.ExprBinaryExpr, sp,
                                  lit.index, rhs.index, 0i32, 0i64);
    ExprNode:b = raw ast_expr(@ast, bin);
    if (b.a != lit.index)                                { exit 24i32; }
    if (b.b != rhs.index)                                { exit 25i32; }

    // --- growth preserves every node ----------------------------------------
    // Past the initial capacity of 256, with each payload equal to its index, so
    // a lost or corrupted node shows up as a mismatch rather than a crash. A
    // pointer-based AST would have needed the handles to survive the realloc;
    // indices do it for free, which is the reason for the design.
    int32:i = 0i32;
    while (i < 1000i32) {
        drop ast_add_expr(@ast, ExprKind.ExprIntLiteral, sp,
                          0i32, 0i32, 0i32, i => int64);
        i = i + 1i32;
    }
    if (raw ast_expr_count(@ast) != 1004i32)             { exit 30i32; }

    // The nodes created BEFORE growth must still read correctly.
    ExprNode:again = raw ast_expr(@ast, lit);
    if (again.payload != 42i64)                          { exit 31i32; }
    ExprNode:b2 = raw ast_expr(@ast, bin);
    if (b2.a != lit.index)                               { exit 32i32; }

    int32:j = 0i32;
    while (j < 1000i32) {
        ExprId:h = ExprId{ index: 4i32 + j };
        ExprNode:e = raw ast_expr(@ast, h);
        if (e.payload != (j => int64))                   { exit 33i32; }
        j = j + 1i32;
    }

    // --- every category works the same way ----------------------------------
    StmtId:st = raw ast_add_stmt(@ast, StmtKind.StmtBlockStmt, sp,
                                 0i32, 0i32, 0i32, 0i64);
    DeclId:dc = raw ast_add_decl(@ast, DeclKind.DeclFunctionDecl, sp,
                                 0i32, 0i32, 0i32, 0i64);
    TypeId:ty = raw ast_add_type(@ast, TypeKind.TypeNamedType, sp,
                                 0i32, 0i32, 0i32, 5i64);
    PatId:pt  = raw ast_add_pat(@ast, PatKind.PatWildcard, sp,
                                0i32, 0i32, 0i32, 0i64);
    if ((raw ast_stmt(@ast, st)).kind != StmtKind.StmtBlockStmt)    { exit 40i32; }
    if ((raw ast_decl(@ast, dc)).kind != DeclKind.DeclFunctionDecl) { exit 41i32; }
    if ((raw ast_type(@ast, ty)).payload != 5i64)                   { exit 42i32; }
    if ((raw ast_pat(@ast, pt)).kind != PatKind.PatWildcard)        { exit 43i32; }

    // --- an out-of-range handle is a DEFECT now (D-163, 1.1.1) --------------
    // `ast_expr` is `never fails` and TRAPS on a corrupt handle — the compiler
    // no longer continues on node 0, and there is no error value to probe.
    // (Returning the NONE node would have let a corrupt handle read as a
    // legitimate absence; failing returned an error `raw` swallowed. The trap
    // is the only answer that cannot be ignored.)

    // --- EVERY EXPRESSION KIND HAS A SHAPE ------------------------------------
    //
    // The mechanical completeness check for `expr_shape`, and the reason it
    // exists is worth stating: two walkers used to decide for themselves which
    // slots of a node held children, both by assuming slot `a` always did. That
    // was true until a literal needed somewhere to keep its width suffix, at
    // which point `42i32` resolved whatever node sat at index `WI32` -- and
    // nothing failed. No crash, no diagnostic; a name in an unrelated file
    // simply stopped binding.
    //
    // `EXPR_KIND_MAX` is generated from AST_REFERENCE.md, so a node kind added to
    // the specification and left out of the table fails HERE, in a test that
    // names the kind, rather than by walking slots whose meaning nobody wrote
    // down. This is the same technique as `check_kinds_reachable` (0.2) and
    // `resolve_audit` (0.3.5), applied to a third list that could drift.
    int32:k = 1i32;
    while (k <= (raw EXPR_KIND_MAX())) {
        if ((raw expr_shape(k => ExprKind)) == (raw EXPR_SHAPE_NONE())) {
            // The kind number is the exit code, so the failure names which one.
            exit (100i32 + k);
        }
        k = k + 1i32;
    }

    // …and the check is one that has been SEEN TO FAIL. Kind 0 is `ExprNone`,
    // which is deliberately absent from the table, so this asserts the loop above
    // would have caught a missing entry rather than passing vacuously.
    if ((raw expr_shape(0i32 => ExprKind)) != (raw EXPR_SHAPE_NONE())) { exit 60i32; }

    // A literal is a LEAF and has no children in any slot. The one assertion
    // that, had it existed, would have caught the bug directly.
    if ((raw expr_shape(ExprKind.ExprIntLiteral)) != (raw EXPR_SHAPE_LEAF())) {
        exit 61i32;
    }
    if ((raw expr_shape(ExprKind.ExprBinaryExpr)) != (raw EXPR_SHAPE_TWO())) {
        exit 62i32;
    }
    if ((raw expr_shape(ExprKind.ExprTernaryExpr)) != (raw EXPR_SHAPE_THREE())) {
        exit 63i32;
    }

    // --- a numeric literal keeps its width, and nothing else does -------------
    // The width has a FIELD rather than a spare slot (D-094), so the invariant
    // that `a`, `b` and `c` are node references holds for every kind.
    Span:lsp = raw span_none();
    ExprId:lit = raw ast_add_expr_w(@ast, ExprKind.ExprIntLiteral, lsp,
                                    0i32, 0i32, 0i32, 42i64, NumWidth.WI32);
    ExprNode:ln = raw ast_expr(@ast, lit);
    if (ln.width != NumWidth.WI32)                       { exit 70i32; }
    if (ln.payload != 42i64)                             { exit 71i32; }
    if (ln.a != 0i32)                                    { exit 72i32; }

    // A node built the ordinary way carries no width at all, so a walker cannot
    // mistake a leftover value for one.
    ExprId:plain = raw ast_add_expr(@ast, ExprKind.ExprBinaryExpr, lsp,
                                    lit.index, lit.index, 0i32, 0i64);
    if ((raw ast_expr(@ast, plain)).width != NumWidth.WNone) { exit 73i32; }

    drop wild_release_all();

    drop wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:_~err) {
    exit 1i32;
};
