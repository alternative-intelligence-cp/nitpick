// ONE MISTAKE, ONE REPORT AT THE LEXER'S AND THE PARSER'S SEAM (DEF-164, landing 101; D-240).
//
// Four shapes reported one mistake twice until this landing: a declaration the parser
// refused mid-way and then RESUMED INSIDE (`error:E(P);` -- "expected `;`" at the `(`,
// then "expected `:`" at the `)`, the recovery having stopped at the identifier the
// broken declaration left behind); an integer run with a bad digit and one outside the
// 64-bit envelope (the lexer's LEX-003 / LEX-004, then the parser's "expected an
// expression" at the Error token that stood where the literal was); and a float's
// dangling exponent sign (LEX-009 for `1.5e`, then "expected an expression" after the
// `+` left behind). A parse refusal is a UNIT case (D-085: the grammar stage feeds every
// tree file through the real parser), so each shape is lexed and parsed here and its
// diagnostics counted: exactly one, with the right code. The controls say what the
// recovery still does: a declaration after a sync keyword parses, two broken
// declarations are two reports, and `3.5e-x` keeps its reading (the literal `3.5e`, a
// minus and a name -- one report, as before).
//
// A DECLARATION WHOSE HEADER FAILS IS NOT PARSED INTO ITS BODY (DEF-245, landing 130): every
// declaration parser bails after its header when the parser is in panic, and a declaration's
// recovery skips a bracketed region as one token and stops at a DECLARATION sync point only --
// `func<T>:f = int32() { pass 1i32; };` was three reports (the header's, then "expected a type"
// at the `pass` the old recovery stopped at and at the body's `}`). The fuzz corpus's seven shapes
// and every declaration kind with a block behind its broken header are one report each here; the
// controls say a sound declaration after a broken one is still parsed, a broken member in an impl
// or a macro body leaves its siblings alone, and two statement-level mistakes stay two reports.
// And a recovery that begins right after a consumed `;` skips nothing (DEF-260, the same landing):
// three keyword-named fields are three reports where the middle one was passed over.

mod:parse_one_report;
use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/parse_decl.npk".*;

struct:Parsed = {
    Ast:ast;
    DiagList:diags;
    DeclId:root;
};

// Lex and parse a module, as the driver does, and keep what came out.
func:parsed = Parsed(string:src, InternTable->:it) never fails {
    Ast:ast = raw ast_init();
    DiagList:diags = raw diaglist_init();
    TokenList:toks = raw lex_all(0i32, src, it, @diags);
    Parser:p = raw parser_init(@toks, @ast, @diags, it);
    DeclId:root = raw p_parse_module(@p);
    Parsed:out = Parsed{ ast: move(ast), diags: diags, root: root };
    pass out;
};

// Exactly one diagnostic, and it carries `code`.
func:one_diag = bool(Parsed->:x, string:code) never fails {
    if ((raw diaglist_count(@x.diags)) != 1i64) { pass false; }
    Diagnostic:d = raw diaglist_at(@x.diags, 0i64);
    pass (raw string_eq(d.code, code));
};

// How many members the parsed module holds, and whether one is a function named `name`.
func:has_func = bool(Parsed->:x, InternTable->:it, string:name) never fails {
    DeclNode:m = raw ast_decl(@x.ast, x.root);
    int32:n = raw item_member_count(@x.ast, m);
    for (int32:i in 0i32...n) {
        DeclNode:d = raw ast_decl(@x.ast, raw item_member(@x.ast, m, i));
        if (d.kind == DeclKind.DeclFunctionDecl) {
            if (raw string_eq(raw intern_get(it, raw decl_name(d)), name)) { pass true; }
        }
    }
    pass false;
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();

    // (a) an error identity with a payload: PARSE-001 at the `(`, and nothing more.
    Parsed:a = raw parsed("mod:m; pub error:ETimeValue(ValueFault);", @it);
    if (!(raw one_diag(@a, raw PARSE_EXPECTED())))                                  { exit 10i32; }

    // (b) an integer run with a bad digit: the lexer's LEX-003, and the parser silent.
    Parsed:b = raw parsed("mod:m; func:f = int32() { int32:a = 12abc; pass a; };", @it);
    if (!(raw one_diag(@b, raw LEX_BAD_DIGIT())))                                   { exit 20i32; }

    // (c) a float's dangling exponent sign before the `;`: LEX-009 for `1.5e+`, once.
    Parsed:c = raw parsed("mod:m; func:f = flt64() { flt64:a = 1.5e+; pass a; };", @it);
    if (!(raw one_diag(@c, raw LEX_BAD_SUFFIX())))                                  { exit 30i32; }

    // (d) a literal outside the 64-bit envelope: LEX-004, once.
    Parsed:d = raw parsed("mod:m; func:f = int64() { int64:a = 99999999999999999999; pass a; };", @it);
    if (!(raw one_diag(@d, raw LEX_INT_TOO_LARGE())))                               { exit 40i32; }

    // CONTROL: the recovery resumes at the next declaration keyword -- the function
    // after the broken declaration is in the module, and the one report stands.
    Parsed:e = raw parsed("mod:m; pub error:ETimeValue(ValueFault); func:g = int32() { pass 1i32; };", @it);
    if (!(raw one_diag(@e, raw PARSE_EXPECTED())))                                  { exit 50i32; }
    if (!(raw has_func(@e, @it, "g")))                                              { exit 51i32; }

    // CONTROL: two broken declarations are two reports -- recovery makes progress,
    // it does not fall silent.
    Parsed:f = raw parsed("mod:m; pub error:E(P); pub error:F(Q);", @it);
    if ((raw diaglist_count(@f.diags)) != 2i64)                                     { exit 60i32; }

    // CONTROL: a sign followed by a name is an operator with its operand, as before:
    // `3.5e` is the refused literal (LEX-009), `- x` parses, one report.
    Parsed:g = raw parsed("mod:m; func:f = flt64(flt64:x) { flt64:a = 3.5e-x; pass a; };", @it);
    if (!(raw one_diag(@g, raw LEX_BAD_SUFFIX())))                                  { exit 70i32; }

    // CONTROL: a sound module parses clean.
    Parsed:h = raw parsed("mod:m; pub error:EPlain; func:f = int32() { pass 1i32; };", @it);
    if ((raw diaglist_count(@h.diags)) != 0i64)                                     { exit 80i32; }

    // --- DEF-245 (landing 130): a header that fails is the one report ------------------------
    // the fuzz corpus's shapes (as0100, tr0425, cc0151c, md0219, tr0448, vf0580)
    Parsed:i1 = raw parsed("mod:m; extern func:f = int32() { pass 1i32; };", @it);
    if (!(raw one_diag(@i1, raw PARSE_EXPECTED())))                                 { exit 110i32; }
    Parsed:i2 = raw parsed("mod:m; func<T>:process = int32(T:_~x) never fails { pass 0i32; };", @it);
    if (!(raw one_diag(@i2, raw PARSE_EXPECTED())))                                 { exit 111i32; }
    Parsed:i3 = raw parsed("mod:m; sync func:f = int32() {\n    pass 1i32;\n};", @it);
    if (!(raw one_diag(@i3, raw PARSE_EXPECTED())))                                 { exit 112i32; }
    Parsed:i4 = raw parsed("mod:m; func add(int32:a, int32:b) -> int32 { pass (a + b); };", @it);
    if (!(raw one_diag(@i4, raw PARSE_EXPECTED())))                                 { exit 113i32; }
    Parsed:i5 = raw parsed("mod:m; func:f = int32(Lock<int64, 2 > 1>:_~l) never fails { pass 0i32; };", @it);
    if (!(raw one_diag(@i5, raw PARSE_EXPECTED())))                                 { exit 114i32; }
    Parsed:i6 = raw parsed("mod:m; func:f = int32(int32:n) unbounded never fails { pass n; };", @it);
    if (!(raw one_diag(@i6, raw PARSE_EXPECTED())))                                 { exit 115i32; }
    // the kinds: a struct, an enum, a trait, an impl, a macro, a rule, an inline module, an extern
    // function inside a sound block, a global, and a nested block behind a broken header
    Parsed:k1 = raw parsed("mod:m; struct<T>:S = { T:v; int32:n; };", @it);
    if (!(raw one_diag(@k1, raw PARSE_EXPECTED())))                                 { exit 120i32; }
    Parsed:k2 = raw parsed("mod:m; enum E = { A; B(int32); };", @it);
    if (!(raw one_diag(@k2, raw PARSE_EXPECTED())))                                 { exit 121i32; }
    Parsed:k3 = raw parsed("mod:m; trait<T>:Tr = { func:f = int32(Self:s); };", @it);
    if (!(raw one_diag(@k3, raw PARSE_EXPECTED())))                                 { exit 122i32; }
    Parsed:k4 = raw parsed("mod:m; impl Pt = { func:f = int32(Pt:s) never fails { pass 1i32; }; };", @it);
    if (!(raw one_diag(@k4, raw PARSE_EXPECTED())))                                 { exit 123i32; }
    Parsed:k5 = raw parsed("mod:m; macro mm = (N) { func:N = int32() { pass 1i32; }; };", @it);
    if (!(raw one_diag(@k5, raw PARSE_EXPECTED())))                                 { exit 124i32; }
    Parsed:k6 = raw parsed("mod:m; Rules<int32> R = { $ > 0i32 };", @it);
    if (!(raw one_diag(@k6, raw PARSE_EXPECTED())))                                 { exit 125i32; }
    Parsed:k7 = raw parsed("mod:m; mod:error = { func:f = int32() { pass 1i32; }; };", @it);
    if (!(raw one_diag(@k7, raw PARSE_EXPECTED())))                                 { exit 126i32; }
    Parsed:k8 = raw parsed("mod:m; extern:\"lib\" = { func f = int32() never fails; func:g = int32() never fails; };", @it);
    if (!(raw one_diag(@k8, raw PARSE_EXPECTED())))                                 { exit 127i32; }
    Parsed:k9 = raw parsed("mod:m; fixed int32 K = 5i32;", @it);
    if (!(raw one_diag(@k9, raw PARSE_EXPECTED())))                                 { exit 128i32; }
    Parsed:k10 = raw parsed("mod:m; func<T>:f = int32() { if (true) { pass 1i32; } pass 2i32; };", @it);
    if (!(raw one_diag(@k10, raw PARSE_EXPECTED())))                                { exit 129i32; }
    // CONTROL: a sound declaration after a broken one is parsed -- the recovery stops at `func`.
    Parsed:c1 = raw parsed("mod:m; func<T>:f = int32() { pass 1i32; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@c1, raw PARSE_EXPECTED())))                                 { exit 130i32; }
    if (!(raw has_func(@c1, @it, "g")))                                             { exit 131i32; }
    // CONTROL: a body whose `{` is the mistake -- the `;` expected at `pass`, the `}` and `;` it
    // leaves at the top level eaten as its tail, the next declaration parsed.
    Parsed:c2 = raw parsed("mod:m; func:f = int32() pass 1i32; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@c2, raw PARSE_EXPECTED())))                                 { exit 132i32; }
    if (!(raw has_func(@c2, @it, "g")))                                             { exit 133i32; }
    // CONTROL: a broken member in an impl and in a macro's declaration body leaves the siblings
    // alone -- one report each.
    Parsed:c3 = raw parsed("mod:m; impl:Pt = { func<T>:f = int32(Pt:s) never fails { pass 1i32; }; func:g = int32(Pt:s) never fails { pass 2i32; }; };", @it);
    if (!(raw one_diag(@c3, raw PARSE_EXPECTED())))                                 { exit 134i32; }
    Parsed:c4 = raw parsed("mod:m; macro:mm = () { func<T>:g = int32() { pass 1i32; }; func:h = int32() { pass 2i32; }; };", @it);
    if (!(raw one_diag(@c4, raw PARSE_EXPECTED())))                                 { exit 135i32; }
    // CONTROL: two statement-level mistakes inside a sound function stay two reports -- the
    // statement recovery (`p_recover`) is untouched.
    Parsed:c5 = raw parsed("mod:m; func:f = int32() { int32:a = ; int32:b = ; pass 1i32; };", @it);
    if ((raw diaglist_count(@c5.diags)) != 2i64)                                    { exit 136i32; }
    // DEF-260 (landing 130): a recovery that begins right after a consumed `;` skips nothing -- three
    // keyword-named fields are three reports (the middle one was passed over), and two keyword-named
    // error constants are two, the function after them parsed.
    Parsed:d1 = raw parsed("mod:m; struct:K = { int64:range; int64:limit; int64:in; };", @it);
    if ((raw diaglist_count(@d1.diags)) != 3i64)                                    { exit 140i32; }
    Parsed:d2 = raw parsed("mod:m; error:any; error:in; func:g = int32() { pass 2i32; };", @it);
    if ((raw diaglist_count(@d2.diags)) != 2i64)                                    { exit 141i32; }
    if (!(raw has_func(@d2, @it, "g")))                                             { exit 142i32; }
    // --- DEF-265 (landing 139): a struct literal's braces after a failed expression are the expression's ------
    // the fuzz corpus's shape (`tr0550`, `as0594`, `ty1282`): `Box<int32>{ … }` after `Box < int32` failed -- the
    // belt skipped the literal's `{` and stopped at its `}`, which ended the body, and the statement after it was
    // a module-level declaration ("expected a type"). One report now.
    Parsed:s1 = raw parsed("mod:m; struct:Box<T> = { T:v; int32:n; }; func:f = int32() { Box<int32>:c = Box<int32>{ v: 5i32, n: 3i32 }; pass 1i32; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@s1, raw PARSE_UNEXPECTED())))                               { exit 150i32; }
    if (!(raw has_func(@s1, @it, "g")))                                             { exit 151i32; }
    // the statement recovery meeting the brace: `Foo<bar>{ … }` refused at the `{` (two comparisons), its fields
    // were a block's statements and reported again -- one report now.
    Parsed:s2 = raw parsed("mod:m; struct:Foo = { int32:v; }; func:f = int32() { int32:bar = 1i32; int32:c = Foo<bar>{ v: 1i32 }; pass 1i32; };", @it);
    if (!(raw one_diag(@s2, raw PARSE_UNEXPECTED())))                               { exit 152i32; }
    // CONTROL: a block statement after a failed statement's `;` is still a block -- its own mistake a second report.
    Parsed:s3 = raw parsed("mod:m; func:f = int32() { int32:a = ; { int32:b = ; } pass 1i32; };", @it);
    if ((raw diaglist_count(@s3.diags)) != 2i64)                                    { exit 153i32; }
    // CONTROL: an `if`'s body after a failed condition is the `if`'s, and the statement after it is parsed.
    Parsed:s4 = raw parsed("mod:m; func:f = int32() { if (1i32 + ) { pass 1i32; } int32:z = ; pass 2i32; };", @it);
    if ((raw diaglist_count(@s4.diags)) != 2i64)                                    { exit 154i32; }
    // --- DEF-271 (landing 139): a block without its `{` reads nothing -------------------------------------------
    // after a statement header that failed, the body's block read the rest of the header and what followed as its
    // statements and took the enclosing body's `}` as its own: the enclosing `{` was never closed and the next
    // declaration was read as statements -- three or four reports of one mistake. One report now, and `g` parsed.
    Parsed:t1 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; if (x = 3i32) { x = 2i32; } pass x; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t1, raw PARSE_EXPECTED())))                                 { exit 155i32; }
    if (!(raw has_func(@t1, @it, "g")))                                             { exit 156i32; }
    Parsed:t2 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; while (x = 3i32) unbounded { x = 2i32; } pass x; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t2, raw PARSE_EXPECTED())))                                 { exit 157i32; }
    if (!(raw has_func(@t2, @it, "g")))                                             { exit 158i32; }
    Parsed:t3 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; loop(0i32, 3i32 1i32) { x += 1i32; } pass x; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t3, raw PARSE_EXPECTED())))                                 { exit 159i32; }
    if (!(raw has_func(@t3, @it, "g")))                                             { exit 160i32; }
    // a body whose `{` is missing: the statement after the header is the enclosing block's -- one report.
    Parsed:t4 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; if (x == 1i32) x = 2i32; pass x; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t4, raw PARSE_EXPECTED())))                                 { exit 161i32; }
    if (!(raw has_func(@t4, @it, "g")))                                             { exit 162i32; }
    // the C three-clause `for` (D-023): the refused header is skipped to its `)` and the body is the `for`'s own --
    // ONE report (the chain's first reading had two: the clauses read as statements); the enclosing body closes and
    // `g` is parsed.
    Parsed:t5 = raw parsed("mod:m; func:f = int32() { int32:s = 0i32; for (int32:i = 0i32; i < 3i32; i += 1i32) { s += i; } pass s; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t5, raw PARSE_EXPECTED())))                                 { exit 163i32; }
    if (!(raw has_func(@t5, @it, "g")))                                             { exit 164i32; }
    // --- the chain's reading of the fuzz corpus (ct0080, mc0374, ty0982; the pick probe) --------------------------
    // a pattern that is no pattern (a removed macro pattern): the arm's recovery is to the next arm, never the
    // enclosing block's statements -- one report, `g` parsed.
    Parsed:t6 = raw parsed("mod:m; func:f = int32() { int32:n = 1i32; pick (n) { MyMacro!(a, b) where (a > b) { n = 2i32; } } pass n; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t6, raw PARSE_EXPECTED())))                                 { exit 165i32; }
    if (!(raw has_func(@t6, @it, "g")))                                             { exit 166i32; }
    // the same arm beside a sound one: still one report, and the sound arm is parsed with the pick.
    Parsed:t7 = raw parsed("mod:m; func:f = int32() { int32:n = 1i32; int32:r = 0i32; pick (n) { my_macro!(a, b) where (a > b) { r = 1i32; }, (*) { r = 2i32; } } pass r; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t7, raw PARSE_EXPECTED())))                                 { exit 167i32; }
    if (!(raw has_func(@t7, @it, "g")))                                             { exit 168i32; }
    // a `for` binding with a qualifier (TYPE_REFERENCE: none is taken): the header is skipped to its `)` -- one report.
    Parsed:t8 = raw parsed("mod:m; func:f = int32() { int64:t = 0i64; for (sealed int64:i in 0i64...3i64) { t = t + i; } pass 0i32; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t8, raw PARSE_EXPECTED())))                                 { exit 169i32; }
    if (!(raw has_func(@t8, @it, "g")))                                             { exit 170i32; }
    // a `pick` whose selector fails: skipped to its `)`, the arms are the pick's own -- one report.
    Parsed:t9 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; pick (x = 3i32) { (1i32) { x = 2i32; }, (*) { x = 4i32; } } pass x; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t9, raw PARSE_EXPECTED())))                                 { exit 171i32; }
    if (!(raw has_func(@t9, @it, "g")))                                             { exit 172i32; }
    // an `if` whose condition fails, with an `else`: one report, both branches the `if`'s.
    Parsed:t10 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; if (x = 3i32) { x = 2i32; } else { x = 5i32; } pass x; }; func:g = int32() { pass 2i32; };", @it);
    if (!(raw one_diag(@t10, raw PARSE_EXPECTED())))                                { exit 173i32; }
    if (!(raw has_func(@t10, @it, "g")))                                            { exit 174i32; }
    // --- DEF-268 (landing 141): a function declared inside a body is one report, at `func` -----------------------
    // the fuzz corpus's `as0594`: PARSE-001 at the `:` and PARSE-002 at the initialiser's type before.
    Parsed:n1 = raw parsed("mod:m; func:f = int32() { int32:x = 1i32; func:inner = int32() never fails { pass x; }; pass x; };", @it);
    if (!(raw one_diag(@n1, raw PARSE_EXPECTED())))                                 { exit 175i32; }
    // the statement after it is parsed: its own mistake is the second report
    Parsed:n2 = raw parsed("mod:m; func:f = int32() { func:inner = int32() { pass 1i32; }; int32:y = ; pass 1i32; };", @it);
    if ((raw diaglist_count(@n2.diags)) != 2i64)                                    { exit 176i32; }
    // CONTROL: a function-typed local is a declaration, its type first.
    Parsed:n3 = raw parsed("mod:m; func:h = int32() never fails { pass 1i32; }; func:f = int32() { func int32() never fails:g = h; pass 1i32; };", @it);
    if ((raw diaglist_count(@n3.diags)) != 0i64)                                    { exit 177i32; }

    wild_release_all();
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (ast.BoundsId) { exit 1i32; },
        (diagnostics.BoundsId) { exit 1i32; },
        (token.BoundsId) { exit 1i32; },
        (source.FileUnknown) { exit 1i32; },
        (source.BoundsIndex) { exit 1i32; },
        (source.BoundsOffset) { exit 1i32; },
        (types.BoundsId) { exit 1i32; },
        (types.BoundsIndex) { exit 1i32; },
        (ShiftRange)  { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (BoundsId) { exit 1i32; },
        (BoundsScratch) { exit 1i32; },
        (BoundsWindow) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (StackExhausted) { exit 1i32; },
        (MachineFault) { exit 1i32; },
        (LimitViolated) { exit 1i32; },
        (DecreasesViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
