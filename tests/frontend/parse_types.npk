// Type parsing, and the `>>` split (cycle 0.2.2).

use "../../src/frontend/source_location.npk".*;
use "../../src/frontend/token_kind.npk".*;
use "../../src/frontend/token.npk".*;
use "../../src/frontend/intern.npk".*;
use "../../src/frontend/ast_kind.npk".*;
use "../../src/frontend/ast.npk".*;
use "../../src/frontend/diag_codes.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/frontend/parse_codes.npk".*;
use "../../src/frontend/lexer.npk".*;
use "../../src/frontend/parser.npk".*;
use "../../src/frontend/parse_expr.npk".*;
use "../../src/frontend/parse_type.npk".*;

struct:Fixture = {
    TokenList:tokens;
    Ast:ast;
    DiagList:diags;
};

func:main = int32(cstring[]:_~argv) {
    InternTable:it = raw intern_init();
    DiagList:ld = raw diaglist_init();

    // --- a plain named type -------------------------------------------------
    TokenList:k1 = raw lex_all(0i32, "int32", @it, @ld);
    Ast:a1 = raw ast_init();
    DiagList:g1 = raw diaglist_init();
    Parser:p1 = raw parser_init(@k1, @a1, @g1, @it);
    TypeId:t1 = raw p_parse_type(@p1);
    TypeNode:n1 = raw ast_type(@a1, t1);
    if (n1.kind != TypeKind.TypeNamedType)            { exit 10i32; }
    if (raw diaglist_count(@g1) != 0i64)              { exit 11i32; }

    // --- suffixes apply left to right ---------------------------------------
    // `int8->[]` is a SLICE OF POINTERS, not a pointer to a slice.
    TokenList:k2 = raw lex_all(0i32, "int8->[]", @it, @ld);
    Ast:a2 = raw ast_init();
    DiagList:g2 = raw diaglist_init();
    Parser:p2 = raw parser_init(@k2, @a2, @g2, @it);
    TypeId:t2 = raw p_parse_type(@p2);
    TypeNode:n2 = raw ast_type(@a2, t2);
    if (n2.kind != TypeKind.TypeArrayType)            { exit 20i32; }
    // There is NO slice node: `T[]` is an ArrayType with no size (AST_REFERENCE 4).
    if (!(raw type_is_slice(n2)))                     { exit 21i32; }
    TypeNode:inner2 = raw ast_type(@a2, raw type_element(n2));
    if (inner2.kind != TypeKind.TypePointerType)      { exit 22i32; }

    // A fixed array has a size, so it is not a slice.
    TokenList:k3 = raw lex_all(0i32, "int32[4]", @it, @ld);
    Ast:a3 = raw ast_init();
    DiagList:g3 = raw diaglist_init();
    Parser:p3 = raw parser_init(@k3, @a3, @g3, @it);
    TypeNode:n3 = raw ast_type(@a3, raw p_parse_type(@p3));
    if (n3.kind != TypeKind.TypeArrayType)            { exit 23i32; }
    if (raw type_is_slice(n3))                        { exit 24i32; }

    // --- generic arguments ---------------------------------------------------
    TokenList:k4 = raw lex_all(0i32, "Result<int32>", @it, @ld);
    Ast:a4 = raw ast_init();
    DiagList:g4 = raw diaglist_init();
    Parser:p4 = raw parser_init(@k4, @a4, @g4, @it);
    TypeNode:n4 = raw ast_type(@a4, raw p_parse_type(@p4));
    if (raw type_args_count(n4) != 1i32)              { exit 30i32; }
    if (raw diaglist_count(@g4) != 0i64)              { exit 31i32; }

    // --- THE `>>` SPLIT -------------------------------------------------------
    // `Handle<Node<int64>>` must parse. The lexer emitted `>>` as one token
    // because a type position is not lexically detectable; the parser asks for
    // the split when it needs a `>`, and the second half closes the outer list.
    //
    // The failure mode here is SILENT: a wrong split produces a valid parse of a
    // different program, which is why this is asserted rather than eyeballed.
    TokenList:k5 = raw lex_all(0i32, "Handle<Node<int64>>", @it, @ld);
    Ast:a5 = raw ast_init();
    DiagList:g5 = raw diaglist_init();
    Parser:p5 = raw parser_init(@k5, @a5, @g5, @it);
    TypeId:t5 = raw p_parse_type(@p5);
    TypeNode:n5 = raw ast_type(@a5, t5);
    if (n5.kind != TypeKind.TypeNamedType)            { exit 40i32; }
    if (raw type_args_count(n5) != 1i32)              { exit 41i32; }
    if (raw diaglist_count(@g5) != 0i64)              { exit 42i32; }
    // Everything was consumed: no `>` left stranded.
    if (!(raw p_at_end(@p5)))                         { exit 43i32; }

    int32:inner_ix = raw ast_id_at(@a5, raw type_args_start(n5), 0i32);
    TypeId:innerId = TypeId{ index: inner_ix };
    TypeNode:node = raw ast_type(@a5, innerId);
    if (node.kind != TypeKind.TypeNamedType)          { exit 44i32; }
    if (raw type_args_count(node) != 1i32)            { exit 45i32; }

    // Three deep, so two splits happen in sequence.
    TokenList:k6 = raw lex_all(0i32, "A<B<C<int64>>>", @it, @ld);
    Ast:a6 = raw ast_init();
    DiagList:g6 = raw diaglist_init();
    Parser:p6 = raw parser_init(@k6, @a6, @g6, @it);
    discard(raw p_parse_type(@p6));
    if (raw diaglist_count(@g6) != 0i64)              { exit 46i32; }
    if (!(raw p_at_end(@p6)))                         { exit 47i32; }

    // --- a SHIFT is left alone -----------------------------------------------
    // Splitting is driven by the parser needing a `>`. Outside a type-argument
    // list nothing asks, so `>>` stays one token.
    TokenList:k7 = raw lex_all(0i32, "x >> 2i32", @it, @ld);
    if (raw tokenlist_count(@k7) != 4i64)             { exit 50i32; }
    Token:shift = raw tokenlist_at(@k7, 1i64);
    if (shift.kind != TokenKind.OpShr)                { exit 51i32; }

    // --- dyn A & B -------------------------------------------------------------
    TokenList:k8 = raw lex_all(0i32, "dyn Read & Write", @it, @ld);
    Ast:a8 = raw ast_init();
    DiagList:g8 = raw diaglist_init();
    Parser:p8 = raw parser_init(@k8, @a8, @g8, @it);
    TypeNode:n8 = raw ast_type(@a8, raw p_parse_type(@p8));
    if (n8.kind != TypeKind.TypeDynType)              { exit 60i32; }
    if (raw type_args_count(n8) != 2i32)              { exit 61i32; }

    // --- qualifiers are NOT part of the type ---------------------------------
    // `stack`, `wild` and friends belong to the VarDeclStmt (AST_REFERENCE 4),
    // so the type parser must leave them for the declaration -- consuming one
    // here would lose it.
    TokenList:k9 = raw lex_all(0i32, "wild int8->", @it, @ld);
    Ast:a9 = raw ast_init();
    DiagList:g9 = raw diaglist_init();
    Parser:p9 = raw parser_init(@k9, @a9, @g9, @it);
    if (!(raw p_at(@p9, TokenKind.KwWild)))           { exit 70i32; }
    discard(raw p_parse_type(@p9));
    // It refused to start on `wild`, leaving the cursor untouched.
    if (!(raw p_at(@p9, TokenKind.KwWild)))           { exit 71i32; }
    if (raw diaglist_count(@g9) != 1i64)              { exit 72i32; }

    // --- 0.2.8: the corners nothing could reach ------------------------------

    // An array SIZE IS AN EXPRESSION. This used to consume one token and call it
    // an integer literal whatever it was, so `int32[COUNT]` produced an array
    // sized by COUNT's intern-table slot -- a plausible wrong number, with no
    // diagnostic.
    TokenList:kc = raw lex_all(0i32, "int32[COUNT]", @it, @ld);
    Ast:ac = raw ast_init();
    DiagList:gc = raw diaglist_init();
    Parser:pc = raw parser_init(@kc, @ac, @gc, @it);
    TypeNode:nc = raw ast_type(@ac, raw p_parse_type(@pc));
    if (nc.kind != TypeKind.TypeArrayType)            { exit 100i32; }
    if (raw type_is_slice(nc))                        { exit 101i32; }
    ExprNode:sizec = raw ast_expr(@ac, raw type_array_size(nc));
    if (sizec.kind != ExprKind.ExprIdentifierExpr)    { exit 102i32; }
    if (raw diaglist_count(@gc) != 0i64)              { exit 103i32; }

    // A compound size expression parses whole. `int32[N + 1]` used to stop after
    // `N` and report a missing `]`.
    TokenList:kd = raw lex_all(0i32, "int32[N + 1i32]", @it, @ld);
    Ast:ad = raw ast_init();
    DiagList:gd = raw diaglist_init();
    Parser:pd = raw parser_init(@kd, @ad, @gd, @it);
    TypeNode:nd = raw ast_type(@ad, raw p_parse_type(@pd));
    ExprNode:sized = raw ast_expr(@ad, raw type_array_size(nd));
    if (sized.kind != ExprKind.ExprBinaryExpr)        { exit 104i32; }
    if (raw diaglist_count(@gd) != 0i64)              { exit 105i32; }

    // `func RetType(ParamTypes)` -- a function type (D-087). It had no spelling
    // in any document until now, so this node could never be built.
    TokenList:ke = raw lex_all(0i32, "func int32(int32, int64)", @it, @ld);
    Ast:ae = raw ast_init();
    DiagList:ge = raw diaglist_init();
    Parser:pe = raw parser_init(@ke, @ae, @ge, @it);
    TypeNode:ne = raw ast_type(@ae, raw p_parse_type(@pe));
    if (ne.kind != TypeKind.TypeFuncType)             { exit 110i32; }
    if (raw type_param_count(ne) != 2i32)             { exit 111i32; }
    TypeNode:rete = raw ast_type(@ae, raw type_return(ne));
    if (rete.kind != TypeKind.TypeNamedType)          { exit 112i32; }
    if (raw diaglist_count(@ge) != 0i64)              { exit 113i32; }

    // It composes with the suffixes like any other type: a POINTER to a
    // function, not a function returning a pointer.
    TokenList:kf = raw lex_all(0i32, "func NIL()->", @it, @ld);
    Ast:af = raw ast_init();
    DiagList:gf = raw diaglist_init();
    Parser:pf = raw parser_init(@kf, @af, @gf, @it);
    TypeNode:nf = raw ast_type(@af, raw p_parse_type(@pf));
    if (nf.kind != TypeKind.TypePointerType)          { exit 114i32; }
    TypeNode:pointee = raw ast_type(@af, raw type_pointee(nf));
    if (pointee.kind != TypeKind.TypeFuncType)        { exit 115i32; }
    if (raw type_param_count(pointee) != 0i32)        { exit 116i32; }

    // `cstring` is its OWN node, not a NamedType that happens to be spelled
    // that way -- so a user type of the same name cannot shadow it (D-049).
    TokenList:kg = raw lex_all(0i32, "cstring", @it, @ld);
    Ast:ag = raw ast_init();
    DiagList:gg = raw diaglist_init();
    Parser:pg = raw parser_init(@kg, @ag, @gg, @it);
    TypeNode:ng = raw ast_type(@ag, raw p_parse_type(@pg));
    if (ng.kind != TypeKind.TypeCStringType)          { exit 120i32; }

    // `any` likewise. Bare `any` PARSES -- the "must be used as `any->`" rule is
    // the type checker's, and enforcing it here would report "expected `->`" and
    // name neither the type nor the rule (D-085).
    TokenList:kh = raw lex_all(0i32, "any->", @it, @ld);
    Ast:ah = raw ast_init();
    DiagList:gh = raw diaglist_init();
    Parser:ph = raw parser_init(@kh, @ah, @gh, @it);
    TypeNode:nh = raw ast_type(@ah, raw p_parse_type(@ph));
    if (nh.kind != TypeKind.TypePointerType)          { exit 121i32; }
    TypeNode:anyp = raw ast_type(@ah, raw type_pointee(nh));
    if (anyp.kind != TypeKind.TypeAnyType)            { exit 122i32; }

    TokenList:ki = raw lex_all(0i32, "any", @it, @ld);
    Ast:ai = raw ast_init();
    DiagList:gi = raw diaglist_init();
    Parser:pi = raw parser_init(@ki, @ai, @gi, @it);
    TypeNode:ni = raw ast_type(@ai, raw p_parse_type(@pi));
    if (ni.kind != TypeKind.TypeAnyType)              { exit 123i32; }
    if (raw diaglist_count(@gi) != 0i64)              { exit 124i32; }

    // --- EVERY node kind in section 4 is reachable ------------------------------
    // The list below is the whole of TypeKind, and each entry was produced above
    // or here. A kind the parser cannot build is a kind a reader has to work out
    // is dead -- and three of these were exactly that until 0.2.8.
    TokenList:kj = raw lex_all(0i32, "Self", @it, @ld);
    Ast:aj = raw ast_init();
    DiagList:gj = raw diaglist_init();
    Parser:pj = raw parser_init(@kj, @aj, @gj, @it);
    if ((raw ast_type(@aj, raw p_parse_type(@pj))).kind != TypeKind.TypeSelfType) {
        exit 130i32;
    }

    TokenList:kk = raw lex_all(0i32, "dyn Drawable & Printable", @it, @ld);
    Ast:ak = raw ast_init();
    DiagList:gk = raw diaglist_init();
    Parser:pk = raw parser_init(@kk, @ak, @gk, @it);
    if ((raw ast_type(@ak, raw p_parse_type(@pk))).kind != TypeKind.TypeDynType) {
        exit 131i32;
    }

    TokenList:kl = raw lex_all(0i32, "int32?", @it, @ld);
    Ast:al = raw ast_init();
    DiagList:gl = raw diaglist_init();
    Parser:pl = raw parser_init(@kl, @al, @gl, @it);
    if ((raw ast_type(@al, raw p_parse_type(@pl))).kind != TypeKind.TypeOptionalType) {
        exit 132i32;
    }

    drop wild_release_all();

    drop wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (BoundsId) { exit 1i32; },
        (BoundsIndex) { exit 1i32; },
        (BoundsOffset) { exit 1i32; },
        (BoundsScratch) { exit 1i32; },
        (BoundsWindow) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (DivByZero) { exit 1i32; },
        (DivOverflow) { exit 1i32; },
        (FileUnknown) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
