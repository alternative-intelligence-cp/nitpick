// A plain `use` does NOT re-export: `shared` is visible here and invisible to
// anyone importing this file (MODULE_REFERENCE 2.3).
mod:middle;
use "./lib.npk".*;

// A `pub use` DOES re-export, and it is the only way to.
pub use "./other.npk".relayed;

pub func:middle_own = int32() never fails { pass 3i32; };
