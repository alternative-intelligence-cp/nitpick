// A FIXTURE for header_mismatch.npk (no expect-error: the resolve stage skips
// it). Its own header is right; its `main` is what the mismatched file would
// have merged -- and what RESOLVE-013 would report had it been loaded.
mod:header_sibling;
func:main = int32(cstring[]:_~argv) { exit 2i32; };
func:failsafe = int32(Error:e) { exit 9i32; };
