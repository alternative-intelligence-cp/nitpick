// expect-error: NITPICK-RESOLVE-006
//
// The second half of D-086's unresolvable-cycle rule. Unlike the struct case
// there is no `->` to break it: a value is a value, and neither of these can be
// computed without the other.
//
// This one could not be checked before names were bound -- it is a question
// about an EXPRESSION, and until phase 2 there is no way to know which global
// `SECOND` refers to.
pub const int32:FIRST = SECOND;
pub const int32:SECOND = FIRST;
