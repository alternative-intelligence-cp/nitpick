// expect-error: NITPICK-RESOLVE-003
//
// A PRIVATE MEMBER IS PRIVATE FROM EITHER SPELLING (D-273 §3, 1.5.4c): `use
// nested.internal;` over an inline module is the named import's own refusal,
// "`internal` is private to `nested`" with the note at the declaration -- the
// code and the sentence `nested.internal()` gets from the checker
// (`tests/types/rejection/mod_private_qualified.npk`).
mod:mod_private_use;
use nested.internal;

mod:nested = {
    func:internal = int32() never fails { pass 1i32; };
    pub func:visible = int32() never fails { pass 2i32; };
};
