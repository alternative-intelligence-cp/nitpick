// A struct whose size depends on itself, which is the case D-086 names as
// genuinely unresolvable. `Cyc` contains `Two` contains `Cyc`, by value.
struct:Cyc = { Two:t; };
struct:Two = { Cyc:c; };

// The same shape with a pointer is FINE: a pointer is one word whatever it
// points at (D-038), so the size is computable.
struct:OkA = { OkB->:b; };
struct:OkB = { OkA:a; };
