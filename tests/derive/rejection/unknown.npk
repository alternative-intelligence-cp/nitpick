// expect-error: NITPICK-DERIVE-001
// expect-error: NITPICK-DERIVE-001
//
// A NAME THAT IS NOT ONE OF THE SEVEN, and an argument that is not a name at all.
// A trait the program declares is implemented by writing an `impl`, because the
// compiler has no way to know what its methods should do.
mod:unknown;

#[derive(Nonsense)]
struct:A = { int32:x; };

#[derive(42i32)]
struct:B = { int32:x; };

func:main = int32(cstring[]:_~argv) { exit 0i32; };
