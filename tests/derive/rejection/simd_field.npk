// The five derives a `simd` field refuses (D-194, 1.3.1): an order over a
// vector has no scalar verdict, a hash and a rendering have no impls to
// call — generating any of them would point a type error at source nobody
// wrote (the enum-ordering rule, applied again). `Eq` and `Clone` still
// derive: lane inequality collapses with `.any()`, and a vector copies as
// a plain value.
mod:simd_field;

// expect-error: NITPICK-DERIVE-005
#[derive(Ord)]
struct:VOrd = { simd<flt64, 2>:a; };

// expect-error: NITPICK-DERIVE-005
#[derive(PartialOrd)]
struct:VPord = { simd<flt64, 2>:a; };

// expect-error: NITPICK-DERIVE-005
#[derive(Hash)]
struct:VHash = { simd<int32, 4>:a; };

// expect-error: NITPICK-DERIVE-005
#[derive(ToString)]
struct:VShow = { simd<int32, 4>:a; };

// expect-error: NITPICK-DERIVE-005
#[derive(Debug)]
struct:VDbg = { simd<int32, 4>:a; };

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};
