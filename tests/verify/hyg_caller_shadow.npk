// expect-exit: 97
// expect-obligation: div-zero open 1
// expect-obligation: overflow open 1
// expect-obligation: div-min discharged 1
// expect-obligation: exhaustive checker 1
// expect-obligation: failsafe-post discharged 33
//
// DEF-223 (1.6.1e): THE ENCODER KEPT A LOCAL BY ITS SPELLING, AND `#caller` NAMES
// ANOTHER LOCAL OF THE SAME SPELLING. The body declares `tmp` (5) and divides by
// `#caller(tmp)` -- the CALLER's `tmp`, which is 0. The innermost binding spelled
// `tmp` was the body's, so the divisor read as 5, the `div-zero` row was
// DISCHARGED, its guard was elided, and the verified build divided by zero:
// `MachineFault` (107) where the plain build answers `DivByZero` (97) -- on every
// compiler since the rows existed. A spelling that a hygienic identifier uses
// and the function declares twice is never named now (`enc_prepare`): the row
// is `open`, the guard stays, and both builds answer 97.
mod:hyg_caller_shadow;
macro:m = () { int32:tmp = 5i32; #caller(out) = (10i32 / #caller(tmp)) + tmp; };

func:main = int32(cstring[]:argv) {
    int32:tmp = 0i32;
    int32:out = 0i32;
    #m();
    exit out;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
