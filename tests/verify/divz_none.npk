// expect-exit: 0
// expect-obligation: failsafe-post discharged 9
// expect-obligation: exhaustive checker 1
//
// NO ROW WHERE NO TRAP ARMS: float division is IEEE and total (D-143) and a
// twisted division yields ERR and continues (D-007, D-144), so neither site
// carries a D-007 guard and neither produces an obligation. The manifest's
// inventory is of GUARDS, and a family with none has none to list. The only
// rows of this module are `failsafe`'s own postconditions (D-267, 1.5.3): a
// program's `failsafe` always has them, so `expect-obligation: none` names
// no program any more -- the runners keep the spelling for their self-checks.
// And no ARM where no trap arms (DEF-37, 1.5.4b step 4b): the reach analysis
// demands `DivByZero`/`DivOverflow` for neither site, so this `failsafe`
// names neither -- it did until step 4b, because the float family had been
// left out of the suppression the twisted families got at 1.3.2.
mod:divz_none;

func:main = int32(cstring[]:_~argv) {
    flt64:f = 1.0f64 / 0.0f64;
    tbb32:t = 5tbb32 / 0tbb32;
    if (!(is_err(t))) { exit 1i32; }
    if (f < 1.0f64) { exit 2i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (IntOverflow) { exit 23i32; },
        (OutOfBounds) { exit 24i32; },
        (TbbErr) { exit 25i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
