// expect-exit: 31
// expect-obligation: bounds discharged 1
// expect-obligation: exhaustive checker 1
// expect-obligation: failsafe-post discharged 15
// expect-obligation: limit discharged 1
// expect-obligation: limit open 3
// expect-obligation: overflow discharged 1
//
// AT A LIMITED FIELD'S ASSIGNMENT THE FIELD'S RULE IS CHECKED BEFORE THE ROOT'S (DEF-582, landing 177d2b3; D-308).
// A read of a limited field is taken to satisfy the field's rule wherever it stands, the root's rule function among
// them: inside `r_shelf` the read `$.n` is in 0..3, so the `bounds` row of `$.arr[$.n]` is discharged and a verified
// build drops that check. That is sound only if no code reads the field between its store and its own check, and
// until this landing the emitter stored, ran the ROOT's check, and then the field's. Here `n` becomes 6: the field's
// rule fails first and both builds trap `LimitViolated`, 31. Before: the plain build trapped `OutOfBounds` inside
// the root's rule (24); the verified build read past `arr` with no check, and at -O2 the assume left in the check's
// place let `opt` remove the field's own check too, so the program ran on with `n` outside its rule (exit 7).
// The prover records the field's row before the root's, the order the emitter now runs them in.
mod:limit_field_first;
error:E9;

Rules<int64>:r_slot = { $ >= 0i64, $ <= 3i64 };
struct:Shelf = { limit<r_slot> int64:n; int64[4]:arr; };
Rules<Shelf>:r_shelf = { $.arr[$.n] >= 0i64 };

func:put = int32(int64:v) never fails {
    limit<r_shelf> Shelf:t = Shelf{ n: 1i64, arr: [0i64, 0i64, 0i64, 0i64] };
    t.n = v;
    discard(t.n);
    pass 7i32;
};

func:main = int32(cstring[]:argv) {
    exit (raw put(argv.len + 5i64));
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 8i32; },
        (LimitViolated) { exit 31i32; },
        (DivByZero) { exit 21i32; },
        (DivOverflow) { exit 22i32; },
        (IntOverflow) { exit 23i32; },
        (OutOfBounds) { exit 24i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (StackExhausted) { exit 9i32; },
        (MachineFault) { exit 9i32; },
        (DecreasesViolated) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
