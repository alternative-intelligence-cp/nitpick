// expect-exit: 36
// expect-obligation: div-zero discharged 1
// expect-obligation: div-zero open 1
// expect-obligation: div-min discharged 2
// expect-obligation: failsafe-post discharged 14
//
// THE MERGE IS AN `ite`, NOT A HAVOC (1.5.4 step 2, L-8): with both arms
// assigning a nonzero divisor, `100 / d` after the `if` discharges through
// `(ite c 3 5)`. The control: only the then-arm assigns and the initialiser
// is zero, so `(ite c 3 0)` CAN be zero -- the row is `open`, the
// counterexample real, and the run without arguments (the condition false)
// traps DivByZero, 36. Nothing is assumed that the program does not do.
mod:path_merge;
error:E9;

func:main = int32(cstring[]:argv) {
    bool:c = argv.len > 5i64;
    int32:d = 1i32;
    if (c) { d = 3i32; } else { d = 5i32; }
    int32:q = 100i32 / d;
    int32:z = 0i32;
    if (c) { z = 3i32; }
    int32:r = 100i32 / z;
    exit (q + r);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
