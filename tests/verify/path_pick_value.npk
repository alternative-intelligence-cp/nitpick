// expect-exit: 20
// expect-obligation: div-zero discharged 1
// expect-obligation: div-min discharged 1
// expect-obligation: failsafe-post discharged 14
//
// A PICK EXPRESSION'S VALUE IS THE CHAIN OF ITS ARMS' `give` TERMS (1.5.4
// step 2, L-9): `k` is `(ite (= s 1) 5 7)`, never zero, so `100 / k`
// discharges. Without arguments `s` is 1 and the answer is 20.
mod:path_pick_value;
error:E9;

func:main = int32(cstring[]:argv) {
    int32:s = argv.len =>! int32;
    int32:k = pick (s) { (1i32) { give 5i32; }, (*) { give 7i32; } };
    int32:q = 100i32 / k;
    exit q;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
