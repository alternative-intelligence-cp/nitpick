// expect-exit: 20
// expect-obligation: div-zero discharged 1
// expect-obligation: div-min discharged 1
// expect-obligation: failsafe-post discharged 10
//
// THE 1.5.0 PROMISE KEPT (1.5.4 step 2, L-7, L-8): both arms assign a
// nonzero divisor. 1.5.0's walk had no path conditions, so after the `if`
// the name was a fresh opaque version and the row was pinned `open` with a
// note saying which subcycle would flip it. The merge is `(ite c |d.2|
// |d.3|)` now, each arm's definition available under its condition, and the
// row discharges -- the visible measure of the improvement.
mod:divz_after_branch;

func:main = int32(cstring[]:argv) {
    int32:d = 1i32;
    if (argv.len > 5i64) { d = 3i32; } else { d = 5i32; }
    int32:q = 100i32 / d;            // 20
    exit q;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero) { exit 21i32; },
        (DivOverflow) { exit 22i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (IntOverflow) { exit 23i32; },
        (OutOfBounds) { exit 24i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
