// expect-exit: 90
// expect-obligation: err-exit discharged 1
// expect-obligation: err-exit open 1
// expect-obligation: failsafe-post discharged 11
// expect-obligation: exhaustive checker 1
// expect-obligation: overflow discharged 1
// expect-obligation: overflow open 1
//
// [1.5.8b step 6c] `argv.len - 1i64`'s `overflow` row discharges on the built-in
// length fact (D-308 SS7); the header moved by exactly that row.
// A TWISTED DIVISION NEVER TRAPS (D-007's fail-operational row, D-278): a
// zero divisor is ERR and the division has NO row -- the manifest lists
// guards, and there is none. The ERR reaches the comparison after it, whose
// row is the guard: `open` where nothing excludes the zero (`loose`, which
// traps at run time -- exit 90), discharged under `is_err` (`guarded`). The
// quotient's term is the emitter's: the dividend scaled up by 2^F, the
// truncating quotient, narrowed by the range test, ERR when tainted or when
// the divisor is zero.
mod:tfp_div_err;

func:guarded = int32(tfp64:a, tfp64:b) never fails {
    tfp64:q = a / b;
    if (!(is_err(q))) { if (q > 0.5tfp64) { pass 1i32; } }
    pass 0i32;
};

func:loose = int32(tfp64:a, tfp64:b) never fails {
    tfp64:q = a / b;
    if (q > 0.5tfp64) { pass 1i32; }
    pass 0i32;
};

func:main = int32(cstring[]:argv) {
    tfp64:z = ((argv.len - 1i64) =>! int32) =>! tfp64;   // 0.0 at run time
    if ((raw guarded(1.0tfp64, z)) != 0i32) { exit 11i32; }
    exit ((raw loose(1.0tfp64, z)) + 10i32);            // traps: ERR at a decision point
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (TbbErr)         { exit 90i32; },
        (IntOverflow)    { exit 93i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault)   { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
