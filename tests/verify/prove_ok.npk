// expect-exit: 0
// expect-obligation: prove discharged 2
// expect-obligation: failsafe-post discharged 17
// expect-obligation: exhaustive checker 1
// expect-obligation: overflow open 1
//
// `prove` LIVE (1.5.4 step 4, L-15; VERIFICATION §1.2): a guard-less row
// over the proposition under its path conditions -- `x != 0` inside `if (x
// > 0)` discharges, and so does `y >= 0` after `if (y < 0) { exit 3; }`. The
// plain build lowers each to nothing, the verified build sees both rows
// discharged and compiles; without arguments `x` is 0 and the answer is 0.
mod:prove_ok;
error:E9;

func:main = int32(cstring[]:argv) {
    int32:x = (argv.len =>! int32) - 1i32;
    if (x > 0i32) {
        prove(x != 0i32);
    }
    int32:y = x;
    if (y < 0i32) { exit 3i32; }
    prove(y >= 0i32);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
