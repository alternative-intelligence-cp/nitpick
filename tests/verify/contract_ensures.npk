// expect-exit: 0
// expect-obligation: requires open 1
// expect-obligation: requires discharged 1
// expect-obligation: ensures discharged 1
// expect-obligation: failsafe-post discharged 10
//
// `ensures` may name `result` -- the grammar binds it, the seam gives it
// meaning (1.5.3 step 1): the passed value in register, checked before the
// store. Refused as a rung from 0.9.0 to 1.5.2; this call keeps its promise,
// and the seam proves it from the precondition (`a >= 0` gives `a + 1 > 0`).

mod:contract_ensures;
error:E9;

func:promised = int32(int32:a) requires a >= 0i32 ensures result > 0i32 {
    pass (a + 1i32);
};

func:main = int32(cstring[]:_~argv) {
    int32:v = promised(1i32) ?! E9;
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (EnsuresViolated) { exit 1i32; },
        (RequiresViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
