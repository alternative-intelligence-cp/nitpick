// expect-exit: 0
// expect-obligation: invariant discharged 2
// expect-obligation: failsafe-post discharged 8
//
// A loop `invariant` the backend never read was an obligation that silently
// vanished. Refused as a rung from 0.9.0 to 1.5.2; checked at every loop head
// since 1.5.3 step 1 -- entry and after each iteration -- and this one holds.

mod:loop_invariant;
func:total = int32(int32:n) never fails {
    int32:i = 0i32;
    int32:acc = 0i32;
    while (i < n) invariant acc >= 0i32 {
        acc = acc + 1i32;
        i = i + 1i32;
    }
    pass acc;
};

func:main = int32(cstring[]:_~argv) {
    int32:t = raw total(3i32);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (InvariantViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
