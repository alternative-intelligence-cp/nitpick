// expect-exit: 0
// expect-obligation: assert-static checker 2
// expect-obligation: failsafe-post discharged 17
// expect-obligation: exhaustive checker 1
//
// `assert_static` FOLDS AT THE FRONTEND (L-17; VERIFICATION §1.1): each
// proposition is a constant the evaluator decides -- a literal comparison, a
// `comptime` function's answer -- and its row is the catalogue's `checker`
// entry: no query, no guard, an inventory line. The statement lowers to
// nothing.
mod:assert_static_ok;
error:E9;

comptime func:sq = int32(int32:n) { pass (n * n); };

func:main = int32(cstring[]:_~argv) {
    assert_static(1i32 + 1i32 == 2i32);
    assert_static(comptime(sq(3i32)) == 9i32);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
