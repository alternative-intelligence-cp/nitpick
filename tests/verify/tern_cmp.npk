// expect-exit: 4
// expect-obligation: err-exit discharged 4
// expect-obligation: err-exit open 3
// expect-obligation: failsafe-post discharged 10
// expect-obligation: exhaustive checker 1
// expect-obligation: overflow open 2
//
// THE TERNARY KINDS (D-197, D-278): the value with its BALANCED bounds --
// a `tryte` is `-29524 ..= 29524` around the carrier's sentinel -- so a sum
// saturates to ERR past that bound, not the carrier's, and the compare after
// an `is_err` discharges (`guarded`); the single-digit `&` is the Kleene
// min, no row (`kleene`); a bare compare is `open` (`loose`); a narrowing
// `tryte => trit` traps a value outside `-1 ..= 1` under `=>`, discharged
// when the branch pins the value (`digit`: its two compares and the
// crossing); an `int32 => tryte` entry that can exceed the bound is `open`
// bare (`enter`), as is `main`'s compare on a value a call returned.
mod:tern_cmp;

func:guarded = int32(tryte:a, tryte:b) never fails {
    tryte:s = a + b;
    if (!(is_err(s))) { if (s < 100) { pass 1i32; } }
    pass 0i32;
};

func:kleene = trit(trit:a, trit:b) never fails { pass (a & b); };

func:loose = int32(tryte:a) never fails { if (a > 5) { pass 1i32; } pass 0i32; };

func:digit = trit(tryte:t) never fails {
    if (!(is_err(t))) { if ((t >= -1) && (t <= 1)) { pass (t => trit); } }
    pass 0;
};

func:enter = tryte(int32:v) never fails { pass (v => tryte); };

func:main = int32(cstring[]:argv) {
    tryte:one = raw enter(argv.len =>! int32);          // 1
    trit:d = raw digit(one);                            // 1
    trit:k = raw kleene(d, 1);                          // min(1, 1) = 1
    if (k != 1) { exit 20i32; }
    exit ((raw guarded(one, 41)) + (raw loose(42)) + 2i32);   // 1 + 1 + 2
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (TbbErr)         { exit 24i32; },
        (IntOverflow)    { exit 93i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault)   { exit 99i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
