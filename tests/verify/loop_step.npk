// expect-exit: 38
// expect-obligation: loop-step open 1
// expect-obligation: failsafe-post discharged 14
//
// THE STEP ROW (S-46, 1.5.4 step 3, L-13): a COMPUTED step is a `loop-step`
// row whose guard is the compare at the loop's entry -- `open` here, since
// `st` comes from `argv`, so the compare stays and the run without
// arguments (`st` 0) traps BadStep, 38. The literal-step loop beside it has
// no row and no compare: the belt counts one `-4101` trap for one retained
// row, and would count two if the literal's compare were still emitted.
mod:loop_step;
error:E9;

func:main = int32(cstring[]:argv) {
    int64:st = argv.len - 1i64;
    int64:acc = 0i64;
    till (3i64, 2i64) { acc = acc + 1i64; }
    till (5i64, st) { acc = acc + 1i64; }
    exit (acc =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
