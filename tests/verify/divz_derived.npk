// expect-exit: 33
// expect-obligation: div-zero discharged 1
// expect-obligation: div-min discharged 1
//
// DISCHARGED BY ARITHMETIC, NOT BY A LITERAL: the divisor is `2x + 1`, odd
// for every integer x, so `(2x + 1) = 0` has no solution and the solver
// says so -- the definition `y.1 = (+ (* 2 x.1) 1)` is the one hypothesis in
// the cone. This is the smallest proof the encoder can carry, and the guard
// it removes is the first one removed by reasoning rather than by inspection.
mod:divz_derived;

func:main = int32(cstring[]:argv) {
    int32:x = argv.len =>! int32;
    int32:y = (2i32 * x) + 1i32;
    int32:q = 100i32 / y;            // 100 / 3 in the runner
    exit q;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero) { exit 21i32; },
        (DivOverflow) { exit 22i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (IntOverflow) { exit 23i32; },
        (OutOfBounds) { exit 24i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
