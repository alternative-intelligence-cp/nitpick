// expect-exit: 34
// expect-obligation: invariant discharged 1
// expect-obligation: invariant open 1
// expect-obligation: failsafe-post discharged 17
// expect-obligation: exhaustive checker 1
// expect-obligation: overflow discharged 3
// expect-obligation: overflow open 1
//
// [1.5.8b step 6c] `argv.len - 1i64` carries the built-in length fact (D-308 SS7: a
// slice's `.len` lies in [0, 2^47]), so `k >= -1` is KNOWN: its own `overflow` row,
// the two rows of `3i64 + k` (the head's check runs at the entry and at the back
// edge, one row per context -- DEF-81) and the ENTRY invariant `0 < 3 + k` all
// discharge where they were open. The preservation row `$ + 1 < 3 + k` under
// `$ < 3 + k` stays open on the merits, and the head keeps its check -- which is
// still what traps the violating iteration at 34. The paragraph below was written
// when nothing bounded `k`; its second sentence is true of the preservation row only.
// `$` IN AN INVARIANT has a term (1.5.4 step 3, L-11 -- opaque from 1.5.2's
// L-19 until then), and both rows are `open` ON THE MERITS: `k` comes from
// `argv` and nothing bounds it, so `0 < 3 + k` at entry and `$ + 1 < 3 + k`
// under `$ < 3 + k` both have counterexamples. The head keeps its check,
// which is what makes the violating iteration (`$` reaching 3 with `k` 0)
// trap InvariantViolated, 34: recorded, never refused, never silently true.
mod:inv_counted;
error:E9;

func:main = int32(cstring[]:argv) {
    int64:k = argv.len - 1i64;
    int64:acc = 0i64;
    loop (0i64, 5i64, 1i64) invariant $ < 3i64 + k {
        acc = acc + 1i64;
    }
    exit (acc =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
