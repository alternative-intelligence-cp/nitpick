// expect-exit: 0
// expect-obligation: div-zero discharged 2
// expect-obligation: div-min discharged 2
// expect-obligation: failsafe-post discharged 14
//
// NESTED COUNTED LOOPS (L-11): `$` is the innermost loop's counter; the
// inner loop's limit reads the outer `$` at its entry and is captured
// there. Inside the inner body `100 / $` discharges from `1 <= $`; back in
// the outer body, after the inner loop, `$` is the outer counter again and
// `100 / $` discharges from `1 <= $ < 4`. Exits 0.
mod:counted_nested;
error:E9;

func:main = int32(cstring[]:_~argv) {
    int64:acc = 0i64;
    loop (1i64, 4i64, 1i64) {
        loop (1i64, $ + 1i64, 1i64) {
            acc = acc + 100i64 / $;
        }
        acc = acc + 100i64 / $;
    }
    exit ((acc - acc) =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
