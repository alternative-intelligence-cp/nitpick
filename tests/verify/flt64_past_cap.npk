// expect-exit: 0
// expect-obligation: prove discharged 2
// expect-obligation: failsafe-post discharged 8
// expect-obligation: exhaustive checker 1
//
// A `flt64` LITERAL IS ONE NUMBER TO THE PROGRAM AND TO THE SOLVER (DEF-209,
// 1.6.1e). The solver's term for a float literal is `to_fp RNE` of the exact
// real its decimal denotes. The program's constant was `double <text>`, read
// by LLVM's decimal parser -- which caps the exponent it reads at 24,000. The
// two literals below are both the number 1.0, written past that cap from
// either side: 24,000 zeros after the point undone by `e24001`, and 24,001
// zeros before it undone by `e-24001` (each is one line of 24 KB). To the
// solver both were 1.0, and both rows below were discharged; to the program
// the first was 0.1 and the second 10.0 -- a verified build proved a sentence
// about a number its own binary did not hold, and `main` below answered 1.
// The constant is the compiler's own exact conversion now (`float_round`),
// written as its bits: the rows are discharged as before, and true.
mod:flt64_past_cap;

func:below = flt64() never fails {
    flt64:x = 0.;
    prove(x == 1.0f64);
    pass x;
};

func:above = flt64() never fails {
    flt64:y = .0e-24001f64;
    prove(y == 1.0f64);
    pass y;
};

func:main = int32(cstring[]:_~argv) {
    if ((raw below()) != 1.0f64) { exit 1i32; }
    if ((raw above()) != 1.0f64) { exit 2i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)    { exit 95i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault)   { exit 99i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
