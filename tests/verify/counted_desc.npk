// expect-exit: 21
// expect-obligation: invariant discharged 2
// expect-obligation: div-zero discharged 1
// expect-obligation: div-min discharged 1
// expect-obligation: failsafe-post discharged 14
//
// A DESCENDING LOOP WITH A STEP OF 3 (L-11): `loop (10, 1, 3)` runs `$` = 10,
// 7, 4 (the body sees `1 < $ <= 10` and `(10 - $) mod 3 = 0`), so the
// preservation row `$ - 3 >= 1` holds only THROUGH the residue class -- 10,
// 7, 4 step to 7, 4, 1 -- and the body's `100 / $` discharges from `$ > 1`.
// Exits 21: 10 + 7 + 4.
mod:counted_desc;
error:E9;

func:main = int32(cstring[]:_~argv) {
    int64:acc = 0i64;
    loop (10i64, 1i64, 3i64) invariant $ >= 1i64 {
        int64:q = 100i64 / $;
        acc = acc + $ + q - q;
    }
    exit (acc =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
