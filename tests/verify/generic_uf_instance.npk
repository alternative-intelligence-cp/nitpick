// expect-exit: 97
// expect-obligation: overflow open 5
// expect-obligation: div-zero open 2
// expect-obligation: div-min discharged 2
// expect-obligation: failsafe-post discharged 33
// expect-obligation: exhaustive checker 1
//
// DEF-195 (1.6.1e step 3a): A GENERIC `pure never fails` CALLEE IS ONE
// UNINTERPRETED FUNCTION PER INSTANCE. The encoder named it per DECLARATION --
// `|uf.width.<decl>|` -- and an argument is an `Int` whatever its width, so
// `width(1i8)` and `width(1i64)` were ONE term, `(|uf.width| 1)`: the solver
// knew two calls equal that return 1 and 8. The `div-zero` row over their
// difference was `discharged` and its guard elided -- the verified build
// divided by zero, unguarded, where the plain build traps `DivByZero`.
//
// Both divisors below are zero at run time and nonzero in that model:
// `by_param` tells its instances apart by a parameter's type (the hole as it
// stood on every compiler since 1.5.3), `by_targ` by nothing but its type
// argument (DEF-191's shape, the same hole once that defect's fix made the two
// instances two bodies). The function symbol carries the instance now
// (`|uf.width.t<arg>.<decl>|`), the two calls are two unknowns, both rows stay
// `open`, both guards are kept, and the verified build traps like the plain one:
// exit 97 from `failsafe`'s `(DivByZero)` arm, at the FIRST division.
mod:generic_uf_instance;

func:width<T> = int64(T:_~x) never fails pure { pass #size_of<T>(); };
func:bytes_of<T> = int64() never fails pure { pass #size_of<T>(); };

func:main = int32(cstring[]:_~argv) {
    int64:a = raw width(1i8);                    // 1
    int64:b = raw width(1i64);                   // 8
    int64:by_param = 100i64 / ((b - a) - 7i64);  // 0 at run time; -7 if the two calls are one term
    int64:c = raw bytes_of::<int32>();           // 4
    int64:d = raw bytes_of::<int64>();           // 8
    int64:by_targ = 100i64 / ((d - c) - 4i64);
    exit ((by_param + by_targ) =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
