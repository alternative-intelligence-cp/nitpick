// expect-exit: 100
// expect-obligation: invariant discharged 2
// expect-obligation: div-zero discharged 1
// expect-obligation: div-min discharged 1
// expect-obligation: failsafe-post discharged 14
//
// `$` AS A TERM (1.5.4 step 3, L-11): the entry row sees `$ = 0`, the
// preservation row sees `$ + 1` beside `acc + 2`, and after the loop the
// invariant holds over the EXIT value, which a step of 1 pins to the limit:
// `$_exit >= 5`, `$_exit < 6`, `($_exit - 0) mod 1 = 0`. So `acc == 10` is
// known after the loop and `100 / (acc - 9)` discharges. Exits 100.
mod:counted_exit;
error:E9;

func:main = int32(cstring[]:_~argv) {
    int64:acc = 0i64;
    loop (0i64, 5i64, 1i64) invariant acc == $ * 2i64 {
        acc = acc + 2i64;
    }
    int64:q = 100i64 / (acc - 9i64);
    exit (q =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
