// expect-exit: 31
// expect-obligation: limit discharged 1
// expect-obligation: limit open 1
// expect-obligation: failsafe-post discharged 15
// expect-obligation: exhaustive checker 1
// expect-obligation: overflow discharged 1
// expect-obligation: overflow open 1
//
// A RULE OVER AN AGGREGATE (D-251): a store to a FIELD of a limited struct is
// a write to the binding, and the root's whole value is re-checked after it.
// The initialiser satisfies `r_q1`; the field store of one minus five does
// not. Until 1.5.8d step 0 both rows were `unencoded` (a struct subject was
// outside the fragment, L-6); since D-317 the struct has an identity and the
// rule reads its fields as functions of it: the initialiser's row is
// DISCHARGED (`x = 1`, `y = 2` from the literal), the field store's is OPEN
// (`x` is the cast's value minus five, unbounded below), its guard stays and
// fires — exit 31. The `overflow` rows: the subtraction open (the cast is
// opaque), and the exit's `p.x + p.y` discharged, because the subtraction
// guard's own fact bounds `x` above and the rule bounds it below while `y`
// is the literal's 2 through the update frame.
mod:limit_field;
error:E9;
struct:Point = { int32:x; int32:y; };
Rules<Point>:r_q1 = { $.x >= 0i32, $.y >= 0i32 };

func:main = int32(cstring[]:argv) {
    limit<r_q1> Point:p = Point{ x: 1i32, y: 2i32 };
    p.x = (argv.len =>! int32) - 5i32;
    exit (p.x + p.y);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 8i32; },
        (LimitViolated) { exit 31i32; },
        (DivByZero) { exit 21i32; },
        (DivOverflow) { exit 22i32; },
        (IntOverflow) { exit 23i32; },
        (OutOfBounds) { exit 24i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (StackExhausted) { exit 9i32; },
        (MachineFault) { exit 9i32; },
        (DecreasesViolated) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
