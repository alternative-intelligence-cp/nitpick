// expect-error: NITPICK-VERIFY-001
// expect-obligation: prove open 1
// expect-obligation: failsafe-post discharged 16
// expect-obligation: exhaustive checker 1
// expect-obligation: overflow open 1
//
// AN UNPROVEN `prove` REFUSES THE VERIFIED BUILD (S-45, 1.5.4 step 4, L-16):
// `d` comes from `argv`, so `d != 0` is `open` -- the solver has a model --
// and the plain `--obligations` build compiles while the `--elide` build
// refuses with NITPICK-VERIFY-001 at the statement, naming the row's word.
// A verified artifact carries no unproven claim; the unit ends at the
// refusal (L-21).
mod:prove_open;
error:E9;

func:main = int32(cstring[]:argv) {
    int32:d = (argv.len =>! int32) - 1i32;
    prove(d != 0i32);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
