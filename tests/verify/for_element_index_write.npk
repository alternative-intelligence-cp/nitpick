// expect-exit: 98
// expect-obligation: bounds open 1
// expect-obligation: overflow discharged 1
// expect-obligation: overflow open 1
// expect-obligation: exhaustive checker 1
// expect-obligation: failsafe-post discharged 12
//
// AN INDEX COMPUTED FROM A WRITTEN ELEMENT BINDING KEEPS ITS BOUND CHECK (Q10, DEF-461, `q10b5`, landing 177d1). The write changes the copy, and the encoder reads the copy: the row stays open, so
// `--elide` leaves the guard and the verified build traps at 98 as the plain one does. `for_element_slice_index.npk` is the view's twin.
mod:for_element_index_write;
func:main = int32(cstring[]:argv) {
    int64[4]:a = [1i64, 2i64, 3i64, 4i64];
    int64[4]:b = [7i64, 7i64, 7i64, 7i64];
    int64:v = 0i64;
    for (int64:x in a) { x = 100i64 + argv.len; v = v + b[x]; }
    exit 67i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)       { exit 74i32; },
        (IntOverflow)       { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (HeapBadRequest)    { exit 93i32; },
        (WildLeak)          { exit 94i32; },
        (StackExhausted)    { exit 96i32; },
        (MachineFault)      { exit 97i32; },
        (OutOfBounds)       { exit 98i32; },
        (LimitViolated)     { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
