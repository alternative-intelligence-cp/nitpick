// expect-exit: 0
// expect-obligation: bounds discharged 2
// expect-obligation: bounds open 1
// expect-obligation: exhaustive checker 1
// expect-obligation: failsafe-post discharged 11
//
// A GUARD INSIDE A `defer` BODY IS ONE ROW AND SEVERAL TRAPS (DEF-82; 1.5.8b
// step 5). The obligation walk sees a `defer` body ONCE -- it is the code that
// runs at an exit the straight line does not see -- while the emitter writes
// it at EVERY exit that runs it. So the row's tenth field, the traps its
// retention keeps, is the traps of one copy times the copies the emitter
// wrote, and the count exists only after the function is lowered: the table
// computes the field when it is written, from what the emitter reported.
//
// Both shapes are here, because the belts read the two directions separately:
// `wander`'s row is open, so its guard is written at both exits and the belt
// counts two `-4099` traps against a row that says two; `fixed_at` 's row is
// discharged, so both copies are elided and the belt counts two `llvm.assume`
// against the two elided guards. Before the fix each row said one, and a
// `defer` with a guarded operation in it was a red run in both runners --
// which is why the tree had none.
mod:defer_guard_copies;

// THE OPEN ROW: `k` is a parameter, nothing bounds it against `xs.len`, so
// the guard stays -- twice, once per `pass`.
func:wander = int32(int32[]:xs, int32:k) never fails {
    int32:acc = 0i32;
    defer {
        acc = acc +% xs[k => int64];
    }
    if (k > 0i32) { pass acc; }
    pass acc;
};

// THE DISCHARGED ROW: a literal index into a fixed array, whose length is its
// type's constant. Both copies of the guard are elided.
func:fixed_at = int32(int32:k) never fails {
    int32[4]:a = [10i32, 20i32, 30i32, 40i32];
    int32:acc = 0i32;
    defer {
        acc = acc +% a[1i64];
    }
    if (k > 0i32) { pass 1i32; }
    pass 2i32;
};

func:main = int32(cstring[]:argv) {
    int32[3]:xs = [1i32, 2i32, 3i32];
    // The defer runs AFTER the returned value is read (D-136), so `wander`
    // answers 0 and the index it guards is in range at run time.
    int32:r = raw wander(xs[0i64...3i64], 1i32);
    int32:q = raw fixed_at(0i32);
    exit (r +% q -% 2i32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 97i32; },
        (MachineFault)   { exit 98i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
