// expect-exit: 0
// expect-obligation: prove discharged 1
// expect-obligation: div-zero discharged 1
// expect-obligation: div-min discharged 1
// expect-obligation: failsafe-post discharged 16
// expect-obligation: exhaustive checker 1
//
// A DISCHARGED `prove` IS KNOWLEDGE AFTER ITS SITE (S-48, 1.5.4 step 4): the
// claim `d * d + 1 > 0` is nonlinear for the encoder's fragment only in the
// sense that z3 must prove it (QF_NIA), and once proven it is a hypothesis
// -- the division `100 / (d * d + 1)` after it discharges THROUGH the
// proof outline rather than by a second nonlinear query of its own.
mod:prove_lemma;
error:E9;

func:main = int32(cstring[]:argv) {
    int32:d = (argv.len =>! int32) - 1i32;
    prove(d * d + 1i32 > 0i32);
    int32:q = 100i32 / (d * d + 1i32);
    exit (q - 100i32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (BadStep)           { exit 38i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (DivByZero)         { exit 36i32; },
        (DivOverflow)       { exit 37i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
