// The forms that clear the `unknown` taint, which the frontend must ACCEPT (D-007).
//
// The counterweight to `rejection/taint.npk`. A taint analysis that refused every
// `.value` read passes every case there, and this one has a specific way to be too
// strict: it recognises the check by SHAPE, so any spelling it does not know
// silently fails to clear anything.
//
// EVERY CASE HERE IS A FORM A PROGRAMMER ACTUALLY WRITES. The plan asked for that
// explicitly — "the forms a programmer writes it in rather than one blessed
// spelling" — because an analysis that recognises only one idiom pushes people
// toward it, and the idiom it would push away from here is the more readable one.

func:might_fail = int32(bool:c) {
    if (c) { fail 5tbb32; }
    pass 7i32;
};

// --- the early exit, which is the common shape --------------------------------------
//
// The `then` arm leaves, so it contributes nothing to the merge and what survives is
// the else path — where the test proved the value is safe. Nothing special is
// written for this form; it falls out of the branch refinement and the exit rule
// 0.5.2 already had.

func:early_exit = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (r.is_error) { pass 0i32; }
    pass (r.value);
};

// --- both arms written out ------------------------------------------------------------

func:else_arm = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (r.is_error) { pass 0i32; } else { pass (r.value); }
};

func:negated_test = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (!r.is_error) { pass (r.value); }
    pass 0i32;
};

// --- the `pick` form ---------------------------------------------------------------------
//
// `.is_error` is a `bool`, so this is a two-armed `pick` that 0.5.4 made
// exhaustive-checkable — and the arm matching `false` is where the value is safe.

func:pick_form = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    int32:v = 0i32;
    pick (r.is_error) {
        (true) { v = 0i32; },
        (false) { v = r.value; }
    }
    pass v;
};

// --- `raw` and the unwrap operators go through -----------------------------------------
//
// They do not read `.value` — they unwrap — so there is nothing here to refuse. That
// is what an escape hatch is for, and both are explicit and greppable, which is the
// only property this language asks of one.

func:raw_unwrap = int32(bool:c) {
    pass (might_fail(c)) ?! 9tbb32;
};

func:relay_propagates = int32(bool:c) {
    int32:v = relay might_fail(c);
    pass v;
};

// --- a checked binding stays checked -------------------------------------------------------
//
// The check dominates everything after it, so a second read needs no second test.

func:two_reads_one_check = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (r.is_error) { pass 0i32; }
    int32:a = r.value;
    int32:b = r.value;
    pass (a + b);
};

// --- `.error` is not tainted ------------------------------------------------------------
//
// The error field is what you read to FIND OUT whether the value is safe. Refusing
// it would leave no way to ask the question.

func:reads_the_error = tbb32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    pass (r.error);
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};
