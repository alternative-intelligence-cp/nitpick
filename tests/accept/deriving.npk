// `#[derive(…)]` — the last "parses and means nothing" shape in the frontend
// (D-123, 0.6.5).
//
// EVERY DERIVED METHOD IS CALLED, and that is the whole point of this file. A
// derive that generated an empty impl, or no impl at all, passes every rejection
// test there is — so each one is exercised through UFCS, and if the implementation
// did not arrive the call does not resolve.
// (The module is `deriving`, because `derive` is a KEYWORD and a module name is an
// identifier — the same trap `comptime` sprang in 0.6.4. The loader's report is
// NITPICK-RESOLVE-005 at the `mod:` line, which reads as a missing file.)
mod:deriving;
error:E9;

// --- a struct: the six that generate ---------------------------------------------
//
// `Eq` compares field by field with `!=` rather than through each field's own `Eq`,
// because the language has the operator and a derived implementation that went
// through a trait would need `int32` to implement one.
//
// `Ord` compares LEXICOGRAPHICALLY IN DECLARATION ORDER (D-123). The cost is stated
// rather than hidden: reordering these two fields is a semantic change.
#[derive(Eq, Ord, PartialOrd, Clone, ToString, Debug)]
struct:Point = {
    int32:x;
    int32:y;
};

func:a_point_has_all_six = NIL(Point:a, Point:b) {
    bool:same = a.eq(b) ?! E9;
    Ordering:o = a.cmp(b) ?! E9;
    Ordering?:p = a.partial_cmp(b) ?! E9;
    Point:c = a.clone() ?! E9;
    string:s = a.to_string() ?! E9;
    string:d = a.debug() ?! E9;
    discard(same);
    discard(o);
    discard(p);
    discard(c.x);
    discard(s);
    discard(d);
    pass NIL;
};

// --- an enum: the four that generate ---------------------------------------------
//
// `ToString` and `Debug` go through a `pick` over the variants rather than through
// `&{self}` — interpolation is what CALLS `to_string`, so a body built out of it
// would call itself. The `pick` is exhaustive by construction, and 0.5.4 checks it.
#[derive(Eq, Clone, ToString, Debug)]
enum:Season = {
    SPRING;
    SUMMER;
    AUTUMN;
    WINTER;
};

func:a_season_has_four = NIL(Season:a, Season:b) {
    bool:same = a.eq(b) ?! E9;
    Season:c = a.clone() ?! E9;
    string:s = a.to_string() ?! E9;
    string:d = a.debug() ?! E9;
    discard(same);
    discard(c);
    discard(s);
    discard(d);
    pass NIL;
};

// --- the prelude is in scope with no import --------------------------------------
//
// `Ordering`, and the seven traits, are declared in `src/prelude/prelude.npk` and
// bound into every module the way `use "prelude.npk".*` would bind them. Nothing
// here imports anything.
func:orders_by_hand = Ordering(int32:a, int32:b) never fails {
    if (a < b) { pass Ordering.Less; }
    if (a > b) { pass Ordering.Greater; }
    pass Ordering.Equal;
};

// A HAND-WRITTEN IMPL OF A PRELUDE TRAIT IS ORDINARY. The traits are declarations
// like any other; what is unusual about them is only where they come from.
struct:Manual = { int32:v; };

impl:Manual:Eq = {
    pub func:eq = bool(Manual:self, Manual:other) never fails { pass (self.v == other.v); };
};

// `Self` IN RETURN POSITION, which did not work until 0.6.5. Every function returns
// `Result<T>`, so `func:clone = Self(Self:self);` has the type `Result<Self>` and
// the impl's has `Result<Manual>` — putting `Self` one level below where the
// one-level substitution could see it, and making every trait method returning
// `Self` unmatchable.
impl:Manual:Clone = {
    pub func:clone = Manual(Manual:self) never fails { pass self; };
};

// DERIVED COMPARISONS OVER A PAYLOAD AND A NAMED TYPE (D-250, 1.5.1b step
// 3b): a payload enum, a struct holding a derived struct, and a generic
// subject whose parameter field still compares by operator (D-161) -- under
// `Eq` alone: `<` on an opaque `T` is refused by the checker (D-107), as it
// was before this step.
#[derive(Eq, Ord, PartialOrd)]
enum:Token = { Num(int64); Sym(uint8); Stop; };
#[derive(Eq, Ord, PartialOrd)]
struct:Nest = { Point:p; Token:t; int32:k; };
#[derive(Eq)]
struct:Cell<T> = { T:v; int32:n; };
func:derived_over_named = NIL(Nest:a, Nest:b, Token:x, Token:y, Cell<int32>:c, Cell<int32>:d) {
    discard(a.eq(b) ?! E9);
    discard(a.cmp(b) ?! E9);
    discard(a.partial_cmp(b) ?! E9);
    discard(x.eq(y) ?! E9);
    discard(x.cmp(y) ?! E9);
    discard(x.partial_cmp(y) ?! E9);
    discard(c.eq(d) ?! E9);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };

// THE HANDLER A ROOT OWES (D-013; REACH-003 at 1.5.1b step 1b): this file
// had a `main` and no `failsafe` from the day it was written, and the reach
// analysis never asked until the workbench's DEF-5 -- every identity the
// trap route can hand the handler is named (D-179), `(*)` beneath them.
func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 80i32; }, (Unreachable) { exit 95i32; },
        (HeapOom) { exit 92i32; }, (HeapBadRequest) { exit 91i32; },
        (WildLeak) { exit 96i32; }, (*) { exit 99i32; }
    }
    exit 9i32;
};
