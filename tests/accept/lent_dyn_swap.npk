    drop list_push::<int64>(@l, v);
    pass l;
};
func:obs_l = int32(List<int64>:v) never fails {
    if (v.count == -6148914691236517206i64) { pass 70i32; }
    if (v.count == 0i64) { pass 23i32; }
    int64:e = v[0i64];
    if (e == 424242i64) { pass 21i32; }
    if (e == 777777i64) { pass 22i32; }
    if (e == 555555i64) { pass 25i32; }
    if (e == -6148914691236517206i64) { pass 70i32; }
    pass 24i32;
};
trait:Tr = { func:peek = int32(Self:self) never fails; func:op = NIL(Self->:self) never fails; };
struct:DHold = { string:v; };
impl:DHold:Tr = {
    func:peek = int32(DHold:self) never fails { pass raw obs_s(self.v); };
    func:op = NIL(DHold->:self) never fails {
        string:other = raw nw();
        string:tmp = move(self.v);
        self.v = move(other);
        other = move(tmp);
        pass NIL;
    };
};
func:callit = NIL(dyn Tr:d) never fails {
    drop d.op();
    pass NIL;
};
func:main = int32(cstring[]:_~argv) {
    DHold:b = DHold{ v: raw mk() };
    dyn Tr:d = move(b);
    drop callit(d);
    int32:o = raw d.peek();
    exit o;
};
