// D-163's PERMITTED forms, all in one place — the counterweight (the 0.5
// lesson: over-refusal is only caught by a program that must stay silent).
// A `never fails` function may handle a may-fail callee with `?|`, `?!`,
// `is_err`, or a `pick` `ERR:` arm; the keyworded statements are legal;
// a marked trait method takes a marked impl; a marked function fills both a
// marked and an unmarked function-type slot; a `defer` handles its own
// cleanup with `?!`.
mod:never_fails;
error:E3;
error:E4;
error:E5;
error:E8;
error:E9;

func:mayfail = int32(int32:v) {
    if (v < 0i32) { fail E3; }
    pass v;
};

func:gives_tbb = tbb32(int32:v) {
    if (v < 0i32) { fail E4; }
    pass (v =>! tbb32);
};

// Every permitted HANDLING form, inside a marked function.
func:handles = int32(int32:v) never fails {
    int32:a = mayfail(v) ?| 0i32;
    int32:b = mayfail(v) ?! E9;
    tbb32:t = gives_tbb(v) ?| ERR;
    int32:c = 0i32;
    if (is_err(t)) { c = 1i32; }
    pick (t) {
        ERR: { c = c + 1i32; },
        (*) { c = c + 2i32; }
    }
    pass a + b + c;
};

// The keyworded statement forms (rule 6's closed list). The statement's own
// type must be `NIL` — the keyword deals with the error, and a VALUE thrown
// away would still need `discard` — so the effect helper returns `NIL`.
func:effect = NIL(int32:v) {
    if (v < 0i32) { fail E5; }
    pass NIL;
};
func:statements = int32(int32:v) {
    relay effect(v);
    effect(v) ?! E9;
    effect(v) ?| NIL;
    effect(v) ?! E9;
    pass v;
};

// A marked trait method with a marked impl.
trait:Steady = {
    func:value = int32(Self:self) never fails;
};
struct:Box = { int32:v; };
impl:Box:Steady = {
    func:value = int32(Self:self) never fails { pass self.v; };
};

// A marked function fills a marked slot — and an unmarked one (widening).
func:nf_id = int32(int32:v) never fails { pass v; };

// D-241 (1.5.1): a `never fails` function may carry a contract and a `limit`
// -- a violation takes the trap route (D-221), the channel a never-fails body
// already admits (`?!`, an overflow, a division) -- and this is the shape a
// contract's helper takes (`never fails pure`, D-242).
Rules<int32>:r_nonneg = { $ >= 0i32 };
func:nf_contract = int32(limit<r_nonneg> int32:v) never fails pure
    requires v < 1000i32
    ensures result >= 0i32
{
    pass v;
};
func:wants_marked = int32(func int32(int32) never fails:f, int32:v) never fails {
    int32:r = f(v) ?! E9;
    pass r;
};
func:wants_plain = int32(func int32(int32):f, int32:v) never fails {
    int32:r = f(v) ?| 0i32;
    pass r;
};

// A `defer` that handles a may-fail cleanup with `?!` — legal under rule 7.
func:cleanup = int32(int32:v) never fails {
    defer {
        effect(v) ?! E8;
    }
    pass v;
};

func:main = int32(cstring[]:_~argv) {
    Box:bx = Box{ v: 4i32 };
    int32:s = bx.value() ?| 0i32;
    int32:h = handles(3i32) ?| 0i32;
    int32:st = statements(2i32) ?| 0i32;
    int32:m = wants_marked(nf_id, 1i32) ?| 0i32;
    int32:p = wants_plain(mayfail, 1i32) ?| 0i32;
    int32:cl = cleanup(1i32) ?| 0i32;
    exit s + h + st + m + p + cl - s - h - st - m - p - cl;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E3) { exit 1i32; },
        (E4) { exit 1i32; },
        (E5) { exit 1i32; },
        (E8) { exit 1i32; },
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (LimitViolated) { exit 1i32; },
        (TbbErr) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (RequiresViolated) { exit 1i32; },
        (EnsuresViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
