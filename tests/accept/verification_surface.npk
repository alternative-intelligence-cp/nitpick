// D-220/D-221 (1.5.1): every legal shape of the verification surface, in full
// silence -- the counterweight to `rules_types.npk` and `contract_types.npk`
// (the 0.5 lesson: over-refusal is only caught by a program that must stay
// silent). A `Rules` block over `$`, a refinement, a `limit` on a parameter
// and on a local, `requires`/`ensures` with `result` and with `raw` calls to a
// `never fails` helper, a never-fails builtin called bare, `is_err` as a
// predicate, invariants on every loop form (`$` inside a counted one),
// `prove` and `assert_static`. Frontend only: the backend still refuses the
// family as a rung until 1.5.2/1.5.3 lower it.
mod:verification_surface;

Rules<int32>:r_pos = { $ > 0i32 };
Rules<int32>:r_small = { limit<r_pos>, $ < 100i32 };
Rules<tbb32>:r_sound = { !is_err($) };

// `never fails pure`: what a contract may call (D-221, S-15). Two words, two
// claims, both checked -- and orthogonal: a pure function may `fail`.
func:helper = int32(int32:v) never fails pure { pass v; };

func:clamp = int32(limit<r_pos> int32:n)
    requires n < 50i32
    ensures result > 0i32
{
    limit<r_small> int32:m = n;
    int32:i = 0i32;
    while (i < m) invariant i >= 0i32, m > 0i32 {
        i = i + 1i32;
    }
    for (int64:k in 0i64...3i64) invariant k >= 0i64 { i = i + 1i32; }
    till (4i64, 1i64) invariant $ >= 0i64 { i = i + 1i32; }
    when (i > 0i32) invariant i >= 0i32 { i = i - 1i32; } then { i = 0i32; } end { i = 1i32; }
    prove(i >= 0i32);
    assert_static(1i32 == 1i32);
    pass m;
};

func:calls = int32(int32:a) requires (raw helper(a)) >= 0i32 ensures result == (raw helper(a)) {
    pass a;
};

func:sound = int32(tbb32:t) requires !is_err(t) { pass 1i32; };

// `old(n)` is `n` at entry -- in `ensures`, and with the same meaning in an
// `invariant` (S-16): the running count against the entry bound.
func:entry = int32(int32:n) ensures result >= old(n) {
    int32:i = 0i32;
    while (i < n) invariant i <= old(n) { i = i + 1i32; }
    pass i;
};

// A `pure` BODY THAT DOES EVERYTHING A PURE BODY MAY (D-221, S-15): locals of
// value types written and rewritten, a field and an element of a local
// aggregate stored, a read through a pointer parameter, arithmetic (its trap
// is Layer 3), a `pick`, a `defer` whose body is pure, and calls to `pure`
// functions and `pure` builtins. It may also `fail`: purity says nothing
// about the error channel.
struct:Pair = { int32:a; int32:b; };
error:ENeg;

func:peek = int32(int32->:p) never fails pure { pass (<-p); };

func:clamp_pure = int32(int32:v, int32:lo, int32:hi, int32->:extra, string:name) pure {
    if (v < 0i32) { fail ENeg; }
    int32:r = v;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    Pair:pr = Pair{ a: r, b: 0i32 };
    pr.b = raw peek(extra);
    int32[2]:arr = [pr.a, pr.b];
    arr[1i64] = arr[1i64] + 1i32;
    int32:acc = pick (r) {
        (0i32) { give 1i32; },
        (*) { give arr[1i64]; }
    };
    defer { acc = acc + 0i32; }
    if (string_is_empty(name)) { acc = acc + 1i32; }
    pass (raw helper(acc));
};

func:view = int32(int8->:p, int64:n) requires (string_from_bytes(p, n)).len == n { pass 1i32; };

// D-251 (1.5.2 step 1): what a limited binding MAY do -- a `stack` local, a
// `move` parameter, passing by value, moving the WHOLE binding out (it dies).
// The rule refuses addresses and borrows of it and moves out of its parts.
Rules<string>:r_ne = { $.len > 0i64 };
func:reads = int32(int32:v) never fails pure { pass v; };
func:owns = int64(move limit<r_ne> string:s) { pass s.len; };
func:shapes = int64(int32:seed) {
    stack limit<r_pos> int32:k = seed;
    int32:r = raw reads(k);
    limit<r_ne> string:s = "abc";
    int64:n = owns(move(s)) ?! ENeg;
    pass (n + (r => int64));
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (ENeg) { exit 1i32; },
        (BadStep) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (LimitViolated) { exit 1i32; },
        (TbbErr) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (RequiresViolated) { exit 1i32; },
        (EnsuresViolated) { exit 1i32; },
        (InvariantViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
