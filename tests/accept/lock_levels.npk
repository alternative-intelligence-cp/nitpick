// Lock levels used correctly, which the frontend must ACCEPT (D-056, 0.5.6).
//
// The counterweight to `rejection/lock_levels.npk`. An ordering analysis that
// refused every second acquisition passes every case there — and this one has a
// specific way to be too strict, because it has to decide when a lock is RELEASED
// without a release to look at. Get that wrong and ordinary code stops compiling.
//
// D-056's model is that the guard's lifetime is the critical section: release is
// automatic at scope exit, so there is no unlock to forget and no early-return path
// that leaks the lock. What that means for the analysis is that a level is held for
// the rest of the block that bound it, and nowhere else.

mod:lock_levels;
error:E9;

struct:Lease = { int32:v; };

func:take_1 = Lease() acquires 1i32 { pass Lease{ v: 1i32 }; };
func:take_2 = Lease() acquires 2i32 { pass Lease{ v: 2i32 }; };
func:take_3 = Lease() acquires 3i32 { pass Lease{ v: 3i32 }; };

// --- upward is the whole point ------------------------------------------------------

func:strictly_increasing = NIL() {
    Lease:a = take_1() ?! E9;
    Lease:b = take_2() ?! E9;
    Lease:c = take_3() ?! E9;
    discard(a.v);
    discard(b.v);
    discard(c.v);
    pass NIL;
};

// --- release at scope exit -------------------------------------------------------------
//
// The guard is bound in an inner block, so the level is held for that block and not
// after it. Taking a LOWER level afterwards is correct code, and an analysis that
// held the level to the end of the function would refuse it.

func:released_at_scope_exit = NIL() {
    {
        Lease:a = take_3() ?! E9;
        discard(a.v);
    }
    Lease:b = take_1() ?! E9;
    discard(b.v);
    pass NIL;
};

// A BARE CALL LEAVES NOTHING HELD. `reaches_3` acquires and releases inside itself
// — its guard is scoped there — so the caller holds nothing afterwards. Treating a
// call and a binding alike would refuse every second call to an ordinary helper.

func:reaches_3 = NIL() {
    Lease:g = take_3() ?! E9;
    discard(g.v);
    pass NIL;
};

func:bare_call_holds_nothing = NIL() {
    reaches_3() ?! E9;
    Lease:b = take_1() ?! E9;
    discard(b.v);
    reaches_3() ?! E9;
    pass NIL;
};

// --- a function that acquires nothing is not in the analysis's way ------------------------

func:ordinary_helper = int32(int32:n) never fails {
    pass (n + 1i32);
};

func:calls_an_ordinary_helper = int32() {
    Lease:a = take_2() ?! E9;
    int32:v = raw ordinary_helper(a.v);
    pass v;
};

// --- a trait bound its implementations keep ------------------------------------------------

trait:Storage = {
    func:commit = NIL(Self:self) acquires <= 3i32;
};

struct:Tight = { int32:v; };

// REACHES 2, DECLARED <= 3. The bound is a ceiling, so anything at or below it is
// fine — and the implementation does not repeat the clause, because the promise is
// the trait's.
impl:Tight:Storage = {
    pub func:commit = NIL(Self:self) {
        Lease:g = take_2() ?! E9;
        discard(g.v);
        pass NIL;
    };
};

struct:Quiet = { int32:v; };

// AN IMPLEMENTATION THAT ACQUIRES NOTHING keeps any bound trivially. "An undeclared
// method may not acquire at all" is about the DECLARATION being absent, not about
// an implementation being empty.
impl:Quiet:Storage = {
    pub func:commit = NIL(Self:self) never fails {
        pass NIL;
    };
};

// --- an inherent impl promises nothing and is bound by nothing --------------------------------

struct:Alone = { int32:v; };

impl:Alone = {
    pub func:whatever = NIL(Self:self) {
        Lease:g = take_3() ?! E9;
        discard(g.v);
        pass NIL;
    };
};

// --- what landing 127 lifted and what it kept (DEF-181, D-339) ---------------------
//
// A HELPER'S `int32` HOLDS NOTHING. `helper` takes and releases level 1 inside
// and returns a number, so binding it twice in one block is two bare calls --
// refused as "holds 1 and can acquire 1" from 1.6.1e step 3 to landing 126. The
// hold a result carries is visible by the callee's own `acquires N`, by a
// bounded trait method, or by a `Guard` in the result's type; a number is none
// of the three.
func:helper = int32() never fails {
    Lease:g = take_1() ?! E9;
    discard(g.v);
    pass 7i32;
};

func:twice = int32() never fails {
    int32:a = raw helper();
    int32:b = raw helper();
    pass (a + b);
};

// A `defer` BODY IS ORDERED AGAINST THE BLOCK'S END, where it runs (D-207):
// written after the guard at 1 it clears, taking 3 there is upward.
func:deferred_upward = NIL() never fails {
    Lease:a = take_1() ?! E9;
    discard(a.v);
    defer { Lease:z = take_3() ?! E9; discard(z.v); }
    pass NIL;
};

// A SPAWN IS JUDGED AT ITS BLOCK'S JOIN: the guard the parent takes after the
// spawn lives in an inner block and is released before the block that joins
// the worker ends, so the worker's wait at 3 is ordered against nothing.
fixed Duration:JOIN_2S = Duration{ ns: 2000000000i64 };

thread async func:worker = NIL(Mutex<int32, 3i32>->:m) joins JOIN_2S {
    Guard<int32>:g = relay await m.acquire(raw duration_ms(200i64));
    g.value = g.value + 1i32;
    pass NIL;
};

async func:spawn_clean = NIL(Mutex<int32, 3i32>->:m) {
    drop worker(m);
    {
        Guard<int32>:g = relay await m.acquire(raw duration_ms(100i64));
        g.value = 5i32;
    }
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

// THE HANDLER A ROOT OWES (D-013; REACH-003 at 1.5.1b step 1b): this file
// had a `main` and no `failsafe` from the day it was written, and the reach
// analysis never asked until the workbench's DEF-5 -- every identity the
// trap route can hand the handler is named (D-179), `(*)` beneath them.
func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 80i32; }, (Unreachable) { exit 95i32; },
        (DeadlineExceeded) { exit 94i32; },
        (HeapOom) { exit 92i32; }, (HeapBadRequest) { exit 91i32; },
        (WildLeak) { exit 96i32; }, (IntOverflow) { exit 93i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault) { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
