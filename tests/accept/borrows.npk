// Borrows used legally, which the frontend must ACCEPT (D-004, cycle 0.5.1).
//
// WHY AN ACCEPTANCE SUITE EXISTS AT ALL. Every `tests/types/` case before this one
// is a rejection, and a rejection suite cannot tell a correct analysis from one
// that refuses everything — an escape checker that answered "yes, a borrow" to
// every expression would pass all nine cases in `rejection/borrows.npk` and be
// completely useless.
//
// That matters more in cycle 0.5 than it did in 0.4. A type rule that is too
// strict is loud: somebody's correct program stops compiling and they say so. An
// ANALYSIS that is too strict is loud in the same way, but the analyses here are
// deliberately conservative — they fail closed on exhaustion, on an unclassified
// node, on anything they cannot decide — and every one of those choices trades
// false refusals for soundness. This suite is what bounds that trade.
//
// A file here must produce NO diagnostics at all.

mod:borrows;
struct:Holder = { int32->:inner; };
struct:Pair = { int32:first; int32:second; };

// --- passing down needs no annotation ------------------------------------------
//
// This is the whole of D-004's ergonomics and the reason it needs no lifetime
// variables: the callee's frame is strictly inner, so a borrow handed downward is
// valid for the whole call by construction. Nothing is written anywhere to say so.

func:sum_through = int32(int32->:a, int32->:b) never fails {
    pass ((<-a) + (<-b));
};

func:passes_down = int32() never fails {
    int32:x = 3i32;
    int32:y = 4i32;
    pass (raw sum_through(@x, @y));
};

// A BORROW HELD IN A BINDING PASSES DOWN TOO. The binding records that `p` holds a
// borrow, and that record must not turn an argument into a violation.
func:passes_binding_down = int32() never fails {
    int32:x = 9i32;
    int32->:p = @x;
    int32->:q = $$i x;
    pass (raw sum_through(p, q));
};

// DERIVED BORROWS PASS DOWN. `@rec.field` and `@arr[i]` are borrows of the same
// frame; being borrows is what makes them second-class, not what makes them
// unusable.
func:passes_derived_down = int32() never fails {
    Pair:pr = Pair{ first: 1i32, second: 2i32 };
    int32[4]:cells = [0i32, 1i32, 2i32, 3i32];
    pass (raw sum_through(@pr.second, @cells[1i64]));
};

// --- the VALUE behind a borrow is not a borrow ---------------------------------
//
// `<-` yields the pointee, copied or moved like anything else. It is the POINTER
// that was second-class, not what it pointed at — so returning the value is
// ordinary code and refusing it would be badly wrong.

func:returns_the_value = int32() never fails {
    int32:x = 5i32;
    int32->:p = @x;
    pass (<-p);
};

func:returns_a_derived_value = int32() never fails {
    Pair:pr = Pair{ first: 7i32, second: 8i32 };
    int32->:p = @pr.first;
    pass (<-p);
};

// --- a borrow may live in a local binding --------------------------------------
//
// Rule 3 forbids storing a borrow into an AGGREGATE. A plain local in the
// borrowing frame is not one, and rebinding is how a borrow is used at all.

func:rebinds = int32() never fails {
    int32:x = 1i32;
    int32:y = 2i32;
    int32->:p = @x;
    p = @y;
    pass (<-p);
};

// --- first-class pointers are untouched ----------------------------------------
//
// A pointer that is not a borrow is not the analysis's business. `NULL` into a
// field, and a field read back out, are ordinary pointer traffic — this is the
// half of the rule that says the checker leaves the type system alone.

func:stores_a_non_borrow = Holder() never fails {
    Holder:h = Holder{ inner: NULL };
    h.inner = NULL;
    pass h;
};

// --- borrows inside control flow -----------------------------------------------
//
// Every path shape the analysis walks, used correctly. An analysis that is right
// on straight-line code and wrong after a branch or a loop is the failure this
// cycle has to keep catching.

func:through_control_flow = int32(bool:flag) never fails {
    int32:x = 0i32;
    int32:acc = 0i32;
    int32->:p = @x;

    if (flag) {
        acc = acc + (raw sum_through(p, @x));
    } else {
        acc = acc + (<-p);
    }

    int32:i = 0i32;
    while (i < 3i32) {
        acc = acc + (raw sum_through(@x, p));
        i = i + 1i32;
    }

    defer { discard(raw sum_through(p, @x)); }
    pass acc;
};

// --- `pick` and `for` on ordinary values ---------------------------------------
//
// A pattern binding and a loop binding are NOT tracked by the escape analysis, so
// a borrow reaching either is refused rather than followed
// (`NITPICK-BORROW-009`). That refusal has to be about the borrow and not about
// the construct: `pick` and `for` on values that have nothing to do with borrows
// are ordinary code and must stay silent.

func:picks_a_plain_value = int32(int32:n) never fails {
    int32:acc = 0i32;
    pick (n) {
        (0i32) { acc = 1i32; },
        (*) { acc = 2i32; }
    }
    pass acc;
};

func:iterates_a_plain_range = int32() never fails {
    int32:acc = 0i32;
    for (int64:i in 0i64..3i64) { acc = acc + 1i32; }
    pass acc;
};

// --- the context-struct idiom, which decided the design ------------------------
//
// Build an aggregate out of pointer parameters and hand it back. `resolver_init`,
// `etyper_init`, `tyres_init`, `graph_init` and `escape_init` are all exactly
// this, and it is safe: the pointers are the CALLER's, and the struct goes
// straight back to that caller.
//
// THIS IS THE CASE THAT RULED OUT MAKING A PARAMETER SECOND-CLASS. With the
// `borrow_imm` / `borrow_mut` route, `a` and `b` below are borrow bindings and
// `pass Ctx{ a: a, b: b };` is a rule 2 violation — and the compiler stops
// compiling itself.

struct:Ctx = { int32->:a; int32->:b; };

func:ctx_init = Ctx(int32->:a, int32->:b) never fails {
    pass Ctx{ a: a, b: b };
};

func:builds_a_context = int32() never fails {
    int32:x = 1i32;
    int32:y = 2i32;
    Ctx:c = raw ctx_init(@x, @y);
    pass ((<-c.a) + (<-c.b));
};

// ONE BORROW ARGUMENT CANNOT BE CONNECTED TO ANYTHING, because there is no second
// borrow to store into it. `typetable_init` is this shape — take the address of a
// local, hand it to a helper, return the local — and the exemption is what keeps
// it compiling.

func:touches = NIL(Ctx->:h) never fails {
    h.a = NULL;
    pass NIL;
};

func:seeds_itself = Ctx() never fails {
    Ctx:c = Ctx{ a: NULL, b: NULL };
    drop touches(@c);
    pass c;
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

// --- F-6's other half (0.9.8): exclusive pick arms are exclusive ---------------
//
// Initialise-`fixed`-per-case is the idiom `pick` exists for, and the arms are
// exclusive — before the repair each arm absorbed its siblings' effects and the
// second init read as "may be the second time".
func:per_case_fixed = int32(int32:n) never fails {
    fixed int32:k;
    pick (n) {
        (0i32) { k = 1i32; },
        (*)    { k = 2i32; }
    }
    pass k;
};
