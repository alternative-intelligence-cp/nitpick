// orphan_ok.npk -- D-359 (landing 124): an impl of a prelude trait for a type declared in another file of the same
// manifest's tree stands, and so does an impl of this tree's trait (declared in that other file) for a builtin: the
// tree is the manifest's, never the file's. Silent, and emitted.
mod:orphan_ok;

use "./orphan_ok_types.npk".*;

impl:OkPt:ToString = { func:to_string = string(OkPt:self) { pass "ok"; }; };
impl:bool:OkTrait = { func:ok = int32(bool:self) never fails { pass 1i32; }; };

func:main = int32(cstring[]:argv) {
    bool:b = true;
    if ((raw b.ok()) != 1i32) { exit 1i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (DecreasesViolated) { exit 109i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
