// D-163's LICENSED forms, all silent — the counterweight to raw_unlicensed
// (the 0.5 lesson: over-refusal is only caught by a program that must stay
// silent). Direct, UFCS/method on a concrete receiver, `dyn` whose TRAIT
// declares the clause, a function pointer of marked type, a never-fails
// builtin, a generic instantiation, and `drop` of a `NIL` never-fails callee.
// The spawn form (`drop work()` on an `async` callee) is accepted by the
// checker here; the BACKEND rungs async until the executor lands (1.1).
mod:raw_licensed;

func:nf = int32(int32:v) never fails { pass v; };
func:nf_effect = NIL(int32:_~v) never fails { pass NIL; };
func:nf_id<T> = T(T:x) never fails { pass x; };

trait:Loud = {
    func:speak = int32(Self:self) never fails;
};
struct:Dog = { int32:x; };
impl:Dog:Loud = {
    func:speak = int32(Self:self) never fails { pass self.x; };
};
impl:Dog = {
    func:bark = int32(Self:self) never fails { pass self.x + 1i32; };
};

async func:work = NIL(int32:_~v) { pass NIL; };

func:all_forms = int32(func int32(int32) never fails:fp, dyn Loud:l, Dog:d) never fails {
    int32:a = raw nf(1i32);                 // direct
    int32:b = raw d.speak();                // trait method, concrete receiver
    int32:b2 = raw d.bark();                // inherent method (UFCS shape)
    int32:c = raw l.speak();                // dyn — the TRAIT declares it
    int32:e = raw fp(2i32);                 // function pointer of marked type
    int64:g = raw string_byte_length("xy"); // never-fails builtin
    int32:h = raw nf_id::<int32>(3i32);     // generic instantiation
    drop nf_effect(4i32);                   // the void call
    pass a + b + b2 + c + e + (g =>! int32) + h;
};

func:spawns = int32(int32:v) {
    drop work(v);                           // THE SPAWN FORM — exempt (D-058)
    pass v;
};

func:main = int32(cstring[]:_~argv) {
    Dog:d = Dog{ x: 5i32 };
    int32:r = all_forms(nf, d, d) ?| 0i32;
    exit r - r;
};
func:failsafe = int32(tbb32:_~e) { exit 1i32; };
