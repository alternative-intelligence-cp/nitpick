// `move` and manual memory used correctly, which the frontend must ACCEPT (D-065).
//
// The counterweight to `rejection/moves.npk`. An ownership analysis that marked
// every binding invalid passes every case there, so what establishes it is right is
// what it lets through — and this analysis has more ways to be too strict than most,
// because a free is a move and both invalidate whole bindings.

mod:moves;
struct:Box = { int32:v; };

func:takes = NIL(int8->:p) never fails { pass NIL; };

// --- ownership moves ONLY where `move` is written -----------------------------------
//
// Nothing moves because it was assigned or passed. D-065 is explicit: an implicit
// move would change ownership with nothing visible at the point it happens, which
// is unreadable at review and ungreppable at audit — the same reasoning that
// governs `raw`, `wild` and `=>!`.

func:passing_does_not_move = NIL() never fails {
    wild int8->:p = alloc(8i64);
    drop takes(p);
    drop takes(p);
    dalloc(p);
    pass NIL;
};

func:assigning_does_not_move = NIL() never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:alias = p;
    discard(alias);
    dalloc(p);
    pass NIL;
};

// --- a moved-from binding comes back when it is assigned ------------------------------
//
// D-065: it "may be reinitialized by assignment, after which it is live again."

func:reinitialised_after_a_move = NIL() never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:taken = move(p);
    p = alloc(8i64);
    dalloc(p);
    dalloc(taken);
    pass NIL;
};

func:reinitialised_after_a_free = NIL() never fails {
    wild int8->:p = alloc(8i64);
    dalloc(p);
    p = alloc(16i64);
    dalloc(p);
    pass NIL;
};

// MOVED ON BOTH BRANCHES AND REASSIGNED ON BOTH is live after the merge — the union
// direction is about what may be INVALID, and an assignment clears it on each path
// before the paths rejoin.
func:moved_and_restored_on_both = NIL(bool:c) never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:q = NULL;
    if (c) {
        q = move(p);
        p = alloc(8i64);
    } else {
        q = move(p);
        p = alloc(16i64);
    }
    dalloc(p);
    dalloc(q);
    pass NIL;
};

// --- `move` means the same thing on every type -----------------------------------------
//
// D-065 rejected making the operator's legality vary by type: under D-064 a generic
// body is checked against its bounds alone, so `move(x)` inside a generic function
// would be un-checkable without inventing an ownership bound. Applying it to a
// primitive is legal and merely pointless.

func:move_a_primitive = int32() never fails {
    int32:a = 5i32;
    int32:b = move(a);
    pass b;
};

func:move_a_struct = int32() never fails {
    Box:one = Box{ v: 3i32 };
    Box:two = move(one);
    pass two.v;
};

// A DERIVED PLACE IS A PLACE. `move(rec.field)` invalidates the whole binding,
// which is conservative, and reading a DIFFERENT binding afterwards is untouched.
func:move_a_field = int32() never fails {
    Box:one = Box{ v: 3i32 };
    Box:other = Box{ v: 4i32 };
    int32:taken = move(one.v);
    discard(taken);
    pass other.v;
};

// --- `nodrop` where there is a drop to suppress -------------------------------------------

func:nodrop_on_wild = NIL() never fails {
    nodrop wild int8->:p = alloc(8i64);
    discard(p);
    pass NIL;
};

// --- the place forms, all of which are places ----------------------------------------------

func:every_place_form = NIL() never fails {
    Box:b = Box{ v: 1i32 };
    int32[2]:cells = [1i32, 2i32];
    int32->:p1 = @b.v;
    int32->:p2 = @cells[0i64];
    int32:read = <-p1;
    <-p2 = 7i32;
    discard(read);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

// The correct wildx lifecycle passes cleanly (D-155): every write before the
// seal, execute only after it, freed exactly once. The state machine that
// refuses the out-of-order forms must accept this one.
func:wildx_correct_lifecycle = NIL() never fails {
    wildx uint8->:page = wildx_alloc(16i64) =>! wildx uint8->;
    page[0i64] = 195u8;
    wildx_seal(page);
    int64:r = wildx_call(page, 0i64);
    discard(r);
    wildx_free(page);
    pass NIL;
};

// --- WHAT THE PARAMETER RULE MUST NOT REFUSE (1.4.3) ------------------------
//
// These analyses fail closed, so OVER-refusal is the likelier defect (0.5's
// lesson, and D-208 says so outright). Tracking parameters made a rule that had
// been dormant apply to every function in the language at once; this is the
// counterweight.

func:mvok_eat = int32(move string:s) never fails { pass (s.len =>! int32); };
struct:MvOkSink = { wild int8->:buf; int64:cap; };

// A `move` parameter moved ONCE is exactly what the qualifier is for.
func:mvok_param_once = int32(move string:s) never fails {
    pass (raw mvok_eat(move(s)));
};

// Reassigned before the back edge, so every iteration moves a fresh body.
func:mvok_reassigned = int32(int32:n) never fails {
    string:s = string_concat("a", "b");
    int32:t = 0i32;
    int32:i = 0i32;
    while (i < n) {
        t = t + (raw mvok_eat(move(s)));
        s = string_concat("c", "d");
        i = i + 1i32;
    }
    pass t;
};

// DECLARED INSIDE the loop: a fresh binding each iteration, nothing carried.
func:mvok_fresh = int32(int32:n) never fails {
    int32:t = 0i32;
    int32:i = 0i32;
    while (i < n) {
        string:s = string_concat("a", "b");
        t = t + (raw mvok_eat(move(s)));
        i = i + 1i32;
    }
    pass t;
};

// THROUGH A POINTER, THIS ANALYSIS SAYS NOTHING, and must not pretend
// otherwise: a binding holding a pointer does not own the pointee ("drops walk
// past a pointer", D-183). Growing a field of a pointed-to aggregate is the
// shape every table in this compiler uses, and the parameter is a `->`.
func:mvok_grow_through_ptr = NIL(MvOkSink->:out, int64:need) never fails {
    int64:n = out.cap;
    while (n < need) { n = n * 2i64; }
    out.buf = ralloc(out.buf, n);
    out.cap = n;
    pass NIL;
};

// ...and the same for an ELEMENT behind a pointer: `wild T->` storage is not
// owned by the binding, so moving elements around inside it — an insertion
// sort, say — invalidates nothing.
func:mvok_permute = NIL(MvOkSink->:a, MvOkSink->:b) never fails {
    wild int8->:t = a.buf;
    a.buf = b.buf;
    b.buf = t;
    pass NIL;
};

// A parameter READ many times is a parameter read many times.
func:mvok_read_often = int64(MvOkSink->:s) never fails {
    pass s.cap + s.cap + s.cap;
};

// --- THE CONSUMING PICK IS THE WAY AN OWNING PAYLOAD COMES OUT (D-216) ------
enum:MvokRes = { Note(string); Blank; };

func:mvok_consume = int64(move MvokRes:r) never fails {
    pick (move(r)) {
        (MvokRes.Note(s)) { pass s.len; },   // `s` OWNS it; drops at arm exit
        (MvokRes.Blank)   { pass 0i64; }
    }
    pass 0i64;
};

// ...and a LENDING pick that binds nothing is unchanged: `_` takes no copy.
func:mvok_lend_tag = int64(MvokRes:r) never fails {
    pick (r) {
        (MvokRes.Note(_)) { pass 1i64; },
        (MvokRes.Blank)   { pass 0i64; }
    }
    pass 0i64;
};

// THE HANDLER A ROOT OWES (D-013; REACH-003 at 1.5.1b step 1b): this file
// had a `main` and no `failsafe` from the day it was written, and the reach
// analysis never asked until the workbench's DEF-5 -- every identity the
// trap route can hand the handler is named (D-179), `(*)` beneath them.
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable) { exit 95i32; }, (HeapOom) { exit 92i32; },
        (HeapBadRequest) { exit 91i32; }, (WildLeak) { exit 96i32; },
        (IntOverflow) { exit 93i32; }, (OutOfBounds) { exit 94i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
