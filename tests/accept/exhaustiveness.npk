// Exhaustive `pick`s, which the frontend must ACCEPT (D-008, cycle 0.5.4).
//
// The counterweight to `rejection/exhaustiveness.npk`. A coverage check that
// refused every `pick` passes every case there, and this analysis has a specific
// way to be too strict: it decides coverage from a pattern's SHAPE, so any form it
// does not recognise silently counts as covering nothing.

enum:Net = { Connected; Disconnect; Retrying; Failed; };

// --- every variant, with no wildcard ------------------------------------------------

func:all_variants = int32(Net:s) {
    int32:r = 0i32;
    pick (s) {
        (Net.Connected) { r = 1i32; },
        (Net.Disconnect) { r = 2i32; },
        (Net.Retrying) { r = 3i32; },
        (Net.Failed) { r = 4i32; }
    }
    pass r;
};

// A VARIANT WITH A PAYLOAD IS STILL THAT VARIANT. The binding list does not change
// which case the arm covers, and a checker reading the whole pattern rather than
// its path would miss it.
func:variant_with_a_binding = int32(Net:s) {
    int32:r = 0i32;
    pick (s) {
        (Net.Connected) { r = 1i32; },
        (Net.Disconnect(reason)) { r = 2i32; },
        (Net.Retrying) { r = 3i32; },
        (Net.Failed) { r = 4i32; }
    }
    pass r;
};

// A GUARDED ARM COVERS NOTHING — and the unguarded arm for the same variant still
// covers it. The rule is that a guard proves nothing, not that it poisons the case.
func:guard_beside_an_unguarded_arm = int32(Net:s, bool:c) {
    int32:r = 0i32;
    pick (s) {
        (Net.Connected) where (c) { r = 9i32; },
        (Net.Connected) { r = 1i32; },
        (Net.Disconnect) { r = 2i32; },
        (Net.Retrying) { r = 3i32; },
        (Net.Failed) { r = 4i32; }
    }
    pass r;
};

// --- `bool`, both values --------------------------------------------------------------

func:both_bools = int32(bool:b) {
    int32:r = 0i32;
    pick (b) {
        (true) { r = 1i32; },
        (false) { r = 2i32; }
    }
    pass r;
};

// --- a wildcard covers what the arms did not ---------------------------------------------

func:integer_with_a_wildcard = int32(int32:n) {
    int32:r = 0i32;
    pick (n) {
        (0i32) { r = 1i32; },
        (1i32) { r = 2i32; },
        (*) { r = 3i32; }
    }
    pass r;
};

func:enum_with_a_wildcard = int32(Net:s) {
    int32:r = 0i32;
    pick (s) {
        (Net.Connected) { r = 1i32; },
        (*) { r = 2i32; }
    }
    pass r;
};

// --- a `tbb` with its `ERR:` arm ------------------------------------------------------------
//
// Both halves present: the explicit ERR arm D-008 requires, and the wildcard for
// the values a `pick` cannot list. Neither substitutes for the other.

func:tbb_with_err_and_wildcard = int32(tbb32:t) {
    int32:r = 0i32;
    pick (t) {
        ERR: { r = 9i32; },
        (0tbb32) { r = 1i32; },
        (*) { r = 2i32; }
    }
    pass r;
};

// --- and what definite assignment now makes of them ------------------------------------------
//
// "A binding assigned on every arm of an EXHAUSTIVE `pick` is assigned after it"
// is 0.5.2's rule, and until 0.5.4 it could only recognise a wildcard — so these
// two were refused for a coverage fact nothing could establish yet. This is the
// debt 0.5.2 recorded, paid.

func:enum_pick_assigns = int32(Net:s) {
    int32:x;
    pick (s) {
        (Net.Connected) { x = 1i32; },
        (Net.Disconnect) { x = 2i32; },
        (Net.Retrying) { x = 3i32; },
        (Net.Failed) { x = 4i32; }
    }
    pass x;
};

func:bool_pick_assigns = int32(bool:b) {
    int32:x;
    pick (b) {
        (true) { x = 1i32; },
        (false) { x = 2i32; }
    }
    pass x;
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};
