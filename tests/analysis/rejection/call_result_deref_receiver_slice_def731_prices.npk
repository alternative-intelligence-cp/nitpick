mod:call_result_deref_receiver_slice_def731_prices;
// 2026-11-26 (landing 177d2f, item 7's row A: DEF-681's own root and its clean fallback). MOVED HERE from
// `tests/backend/programs/call_result_deref_receiver_slice_ok.npk`: its eleven controls that hand a getter's slice result to the writer `wsl`
// (cases 15, 16, 17, 19, 20, 26, 28, 31, 32, 43 and 45), by rulings l.22384 item 3: every refused `_ok` case moves to a prices file, pinned at its
// code and site. Each is a right program that main accepts. Row A refuses each at BORROW-015 at the `wsl` call (eleven sites). They are DEF-731's
// price (LOW, fails closed, made by DEF-681's row; l.22351 item 2): a getter's result passed as a slice is refused where its place spelling (`drop
// wsl(b.sl)`, case 18, which stays in the `_ok` program) is accepted; they are at parity only with the copy (`H2[]:t = b.sl; drop wsl(t)`, which
// main refuses).
error:E1;
fixed Duration:J2 = Duration{ ns: 2000000000i64 };
struct:H2 = { string:o; int64:k; };
impl:H2 = { func:hset = NIL(H2->:self) never fails { self.o = string_concat("x", "y"); pass NIL; }; };
struct:S = { string:s; int64:k; };
impl:S = {
    func:sset = NIL(S->:self) never fails { self.s = string_concat("x", "y"); pass NIL; };
    func:kset = NIL(S->:self) never fails { self.k = 7i64; pass NIL; };
    func:snoop = NIL(S->:self) never fails { if (self.s.len == 999i64) { pass NIL; } pass NIL; };
};
struct:BS = { H2[]:sl; int64:k; };
struct:O = { BS:b; int64:k; };
struct:P = { H2[2]:arr; };
struct:PB = { BS->:bp; int64:k; };
struct:W = { shared_arena<int64>:a; int32:k; };
impl:W = {
    func:rep = NIL(W->:self) never fails { self.a = shared_arena_make(4i64); pass NIL; };
    func:kset = NIL(W->:self) never fails { self.k = 7i32; pass NIL; };
};
struct:HA = { shared_arena<int64>:a; int64:k; };
struct:BA = { HA[]:sl; int64:k; };

func:ids = S->(S->:x) never fails { pass x; };
func:pick_s = S->(bool:c, S->:a, S->:b) never fails { if (c) { pass a; } pass b; };
func:idsl = H2[]->(H2[]->:q) never fails { pass q; };
func:idbs = BS->(BS->:q) never fails { pass q; };
func:getslf = H2[](BS->:q) { pass q.sl; };
func:idbsf = BS->(BS->:q) { pass q; };
func:getslo = H2[]?(BS->:q) never fails { pass q.sl; };
func:idbso = BS->?(BS->:q) never fails { pass q; };
async func:getslaw = H2[](BS->:q) { pass q.sl; };
async func:idbsaw = BS->(BS->:q) { pass q; };
func:idbsw = wild BS->(BS->:q) never fails { pass q =>! wild BS->; };
func:getsl = H2[](BS->:q) never fails { pass q.sl; };
func:getsl2 = H2[](O->:q) never fails { pass q.b.sl; };
struct:C1 = { BS->:bp; int64:k; };
struct:C2 = { C1->:c1p; int64:k; };
struct:C3 = { C2->:c2p; int64:k; };
struct:C4 = { C3->:c3p; int64:k; };
func:getslc2 = H2[](C2->:q) never fails { pass q.c1p.bp.sl; };
func:getslc3 = H2[](C3->:q) never fails { pass q.c2p.c1p.bp.sl; };
func:getslc4 = H2[](C4->:q) never fails { pass q.c3p.c2p.c1p.bp.sl; };
func:wsl = NIL(H2[]:s) never fails { s[0i64].o = string_concat("x", "y"); pass NIL; };
func:wsl1 = NIL(H2[]:s) never fails { s[1i64].o = string_concat("x", "y"); pass NIL; };
func:rsl = NIL(H2[]:s) never fails { if (s[0i64].o.len == 999i64) { pass NIL; } pass NIL; };
func:wr = NIL(H2->:p) never fails { p.o = string_concat("x", "y"); pass NIL; };
func:idw = W->(W->:q) never fails { pass q; };
func:idsla = HA[]->(HA[]->:q) never fails { pass q; };
func:getsla = HA[](BA->:q) never fails { pass q.sl; };
func:wsla = NIL(HA[]:s) never fails { s[0i64].a = shared_arena_make(4i64); pass NIL; };
struct:SL = { List<H2>:l; int64:k; };
func:one = NIL(List<H2>->:q) never fails { drop list_push(q, H2{ o: string_concat("a", "b"), k: 1i64 }); pass NIL; };
func:setk = NIL(H2->:q, int64:v) never fails { q.k = v; pass NIL; };

thread async func:filler = NIL(shared_arena<int64>->:s, Channel<int64, 4i32, 4i64>:done,
                               int64:base) joins J2 {
    int64:i = 0i64;
    int64:last = 0i64;
    while (i < 20i64) decreases 20i64 - i {
        Handle<int64>:h = s.alloc(base + i);
        last = s.get(h) ?! E1;
        i = i + 1i64;
    }
    await done.send(last, raw duration_ms(500i64)) ?! E1;
    pass NIL;
};

// 15. the call-result slice handed to the writer with NO view live (the carrier is the slice's own holder)
func:call_result_slice_to_writer_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl(raw getsl(@b));
    pass p.arr[0i64].o.len;
};

// 16. the view's block ended before the call-result slice is handed to the writer
func:call_result_slice_view_block_ended = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    {
        fixed uint8[]:vw = string_bytes(p.arr[0i64].o);
        if (vw[0i64] != 97u8) { pass 0i64; }
    }
    drop wsl(raw getsl(@b));
    pass p.arr[0i64].o.len;
};

// 17. a carrier over ANOTHER array's slice handed to the writer, under a view of `p.arr`
func:call_result_slice_other_array_carrier = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    P:p2 = P{ arr: [H2{ o: string_concat("e", "f"), k: 5i64 }, H2{ o: string_concat("g", "h"), k: 6i64 }] };
    BS:b2 = BS{ sl: p2.arr[0i64...2i64], k: 2i64 };
    fixed uint8[]:vw = string_bytes(p.arr[0i64].o);
    drop wsl(raw getsl(@b2));
    pass ((vw[0i64] => int64) + p2.arr[0i64].o.len);
};

// 19. the carrier reached through a NAMED pointer local, the call-result slice handed to the writer with no view live (the pointee is the own holder)
func:carrier_through_named_ptr_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    BS->:bp = @b;
    drop wsl(raw getsl(bp));
    pass p.arr[0i64].o.len;
};

// 20. the carrier behind a pointer FIELD, no view live
func:carrier_behind_ptr_field_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    PB:pb = PB{ bp: @b, k: 1i64 };
    drop wsl(raw getsl(pb.bp));
    pass p.arr[0i64].o.len;
};

// 31. (t1n) a MAY-FAIL getter's slice result relayed (`?!`) and handed to the writer with NO view live: the carrier is the own holder (the `?!` node stepped by the own-holder walks since this landing; REFUSED before the fix)
func:relay_slice_road_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl(getslf(@b) ?! E1);
    pass p.arr[0i64].o.len;
};

// 32. (t3n) an ASYNC getter's slice result awaited and relayed, handed to the writer, no view live (an `async` control)
async func:await_slice_road_no_view = int64() {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl(await getslaw(@b) ?! E1);
    pass p.arr[0i64].o.len;
};

// 26. (t5n) the call-result slice cast `=>` to its own type and handed to the writer, no view live
func:cast_slice_road_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl((raw getsl(@b)) => H2[]);
    pass p.arr[0i64].o.len;
};

// 28. (t7n) the call-result slice cast `=>!` to its own type and handed to the writer, no view live
func:ucast_slice_road_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl((raw getsl(@b)) =>! H2[]);
    pass p.arr[0i64].o.len;
};

// 43. (DR5 r1n, landing 167) the `relay` KEYWORD on the slice road with NO view live: the carrier is the own holder (a fallible control, relayed in `main` with `?! E1`)
func:relay_keyword_slice_road_no_view = int64() {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl(relay getslf(@b));
    pass p.arr[0i64].o.len;
};

// 45. (DR5 r3n) `??!` on the slice road, no view live
func:coalesce_slice_road_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl((raw getslo(@b)) ??! E1);
    pass p.arr[0i64].o.len;
};

async func:main = int32(cstring[]:_~argv) {
    if ((raw call_result_slice_to_writer_no_view()) != 2i64) { exit 25i32; }
    if ((raw call_result_slice_view_block_ended()) != 2i64) { exit 26i32; }
    if ((raw call_result_slice_other_array_carrier()) != 99i64) { exit 27i32; }
    if ((raw carrier_through_named_ptr_no_view()) != 2i64) { exit 29i32; }
    if ((raw carrier_behind_ptr_field_no_view()) != 2i64) { exit 30i32; }
    if ((raw relay_slice_road_no_view()) != 2i64) { exit 33i32; }
    if ((await await_slice_road_no_view() ?! E1) != 2i64) { exit 34i32; }
    if ((raw cast_slice_road_no_view()) != 2i64) { exit 35i32; }
    if ((raw ucast_slice_road_no_view()) != 2i64) { exit 37i32; }
    if ((relay_keyword_slice_road_no_view() ?! E1) != 2i64) { exit 43i32; }
    if ((raw coalesce_slice_road_no_view()) != 2i64) { exit 45i32; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (DeadlineExceeded)  { exit 112i32; },
        (StaleHandle)       { exit 113i32; },
        (E1)                { exit 114i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
