// A moved-from binding is invalid until reinitialised (D-065, cycle 0.5.3).
//
// `move(place)` is a KEYWORD OPERATOR ON A PLACE, not a qualifier and not a
// function — it returns no `Result` and could not be one. Ownership moves only
// where `move` is written; nothing moves because it was assigned or passed, which
// is what makes this a question about one operator rather than about every
// expression.
//
// A FREE IS A MOVE INTO THE ALLOCATOR, which is why use-after-free and double-free
// are in this file rather than in one of their own. D-065 says outright that `move`
// is "the mechanism that prevents double-free on `wild` allocations", and the two
// share every piece of machinery.

// --- D-065's own example, which is what the decision asks to be tested ------------
//
// SPELLED WITH `raw_mem` RATHER THAN `buffer`. The decision writes it as `buffer`,
// and `buffer` is a keyword — so the example as printed does not compile. Worth
// knowing before someone tries to paste it.
// expect-error: NITPICK-MOVE-001
func:d065_example = NIL() never fails {
    wild int8->:raw_mem = alloc(100i64);
    wild int8->:taken = move(raw_mem);
    dalloc(raw_mem);
    dalloc(taken);
    pass NIL;
};

// --- moved on one branch is moved after the merge ---------------------------------
//
// THIS MERGE RUNS THE OPPOSITE WAY FROM DEFINITE ASSIGNMENT. Assigned-on-some-path
// is NOT assigned; moved-on-some-path IS moved. Both are the conservative answer
// and they point in different directions.
// expect-error: NITPICK-MOVE-001
func:moved_on_one_branch = NIL(bool:c) never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:q = NULL;
    if (c) { q = move(p); }
    dalloc(p);
    dalloc(q);
    pass NIL;
};

// A LOOP BODY THAT MOVES SOMETHING MOVES IT AGAIN ON THE SECOND ITERATION. What a
// body ASSIGNS does not survive the loop; what it MOVES does.
// expect-error: NITPICK-MOVE-001
func:moved_in_a_loop = NIL(bool:c) never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:q = NULL;
    while (c) { q = move(p); }
    dalloc(q);
    pass NIL;
};

// --- freeing is moving into the allocator -------------------------------------------

// expect-error: NITPICK-MOVE-002
func:double_free = NIL() never fails {
    wild int8->:p = alloc(8i64);
    dalloc(p);
    dalloc(p);
    pass NIL;
};

// expect-error: NITPICK-MOVE-002
func:use_after_free = NIL() never fails {
    wild int8->:p = alloc(8i64);
    dalloc(p);
    p[0i64] = 1i8;
    pass NIL;
};

// `ralloc` TAKES OWNERSHIP TOO. A reallocation invalidates the pointer it was
// given and hands back a different one, so holding on to the old one is the same
// dangling pointer by another route.
// expect-error: NITPICK-MOVE-002
func:use_after_ralloc = NIL() never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:bigger = ralloc(p, 16i64);
    dalloc(p);
    dalloc(bigger);
    pass NIL;
};

// `free` AND `malloc` ARE NOT WRITTEN HERE BECAUSE THEY ARE NOT NITPICK (D-119).
// They are C functions, reachable only by declaring them in an `extern` block —
// and an `extern` callee is opaque, so freeing through one suspends this guarantee
// explicitly, the way every other Nitpick guarantee is suspended. The four native
// allocator builtins are `alloc`, `calloc`, `ralloc` and `dalloc`, and this
// analysis knows the two that take ownership and nothing else about names.

// --- `nodrop` has to have a drop to suppress -----------------------------------------

// expect-error: NITPICK-MOVE-003
func:nodrop_on_managed = NIL() never fails {
    nodrop int32:n = 1i32;
    discard(n);
    pass NIL;
};

// AND WHEREVER ELSE THE QUALIFIER CAN BE WRITTEN (1.2.1c). The rule read only
// STATEMENT qualifiers, so it saw locals and nothing else — while `nodrop`
// also parses on a PARAMETER, a struct FIELD and a GLOBAL, and was accepted in
// silence in all three. A qualifier permitted where it says something untrue
// is worse than one that is merely unread: a reader who believes it is
// reasoning about a lifetime that is not there, which is the exact harm this
// rule exists to prevent — and it was unprevented in three of the four places
// the qualifier can appear. Each names its own position, because "a binding
// that is not `wild`" sends the reader looking at a local when the mistake is
// on a field.

// expect-error: NITPICK-MOVE-003
func:nodrop_on_parameter = NIL(nodrop int32:p) never fails {
    discard(p);
    pass NIL;
};

// expect-error: NITPICK-MOVE-003
struct:NodropField = { nodrop int32:f; };

// expect-error: NITPICK-MOVE-003
nodrop int32:nodrop_global = 1i32;

// --- `move` states a transfer, and only a parameter has a caller -------------
//
// D-183 gives `move T:p` its meaning: the CALLER transferred ownership in, so
// the callee owns the value and drops it at its own scope exit. That is a
// statement about a call, and a local, a field and a global do not have one —
// so `move` on any of them is the same kind of untruth `nodrop` on a managed
// binding is, and is refused for the same reason.
//
// `move` on a PARAMETER is correct and is exercised by the accept suite, not
// here.

// expect-error: NITPICK-MOVE-004
func:move_on_local = NIL() never fails {
    move int32:n = 1i32;
    discard(n);
    pass NIL;
};

// expect-error: NITPICK-MOVE-004
struct:MoveField = { move int32:f; };

// expect-error: NITPICK-MOVE-004
move int32:move_global = 1i32;