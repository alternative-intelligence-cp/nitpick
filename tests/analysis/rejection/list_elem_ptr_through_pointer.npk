    pass NIL;
};
// 17
func:callee_builds_struct = NIL() never fails {
    List<H2>:l = raw list_init::<H2>(1i64);
    drop one(@l);
    PE:pe = raw mkpe(@l);
    drop list_push(@l, H2{ o: string_concat("c", "d"), k: 3i64 });
    discard(pe.p.o.len);
    pass NIL;
};
// 18
func:field_of_elem_ptr_in_struct = NIL() never fails {
    List<H2>:l = raw list_init::<H2>(1i64);
    drop one(@l);
    PS:ps = PS{ s: raw firsto(@l), k: 1i32 };
    drop list_push(@l, H2{ o: string_concat("c", "d"), k: 3i64 });
    discard((<-ps.s).len);
    pass NIL;
};
// 19
func:call_result_elem_assign_named_ptr = NIL() never fails {
    List<H2>:l = raw list_init::<H2>(1i64);
    drop one(@l);
    List<H2>->:lp = @l;
    H2->:e = raw first(@l);
    (<-lp) = raw list_init::<H2>(1i64);
    discard(e.o.len);
    pass NIL;
};
// 20
func:elem_through_ptr_grown_through_other_ptr = NIL() never fails {
    List<H2>:l = raw list_init::<H2>(1i64);
    drop one(@l);
    List<H2>->:lp = @l;
    List<H2>->:lp0 = @l;
    H2->:e = @(<-lp0)[0i64];
    drop list_push(lp, H2{ o: string_concat("c", "d"), k: 3i64 });
    discard(e.o.len);
    pass NIL;
};

// 21 (k22, the accepted false positive of the type reading)
func:mixed_holder_list_ptr_and_other_ptr = NIL() never fails {
    List<H2>:l = raw list_init::<H2>(1i64);
    drop one(@l);
    H2:g = H2{ o: string_concat("g", "h"), k: 9i64 };
    PX:px = PX{ lp: @l, q: @g };
    drop list_push(@l, H2{ o: string_concat("c", "d"), k: 3i64 });
    discard((<-px.lp).count + px.q.k);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    drop assign_call_deref();
    drop move_call_deref();
    drop grow_call_result();
    drop assign_named_ptr();
    drop callee_replaces();
    drop grow_through_ptr();
    drop callee_grows();
    drop clear_through_ptr();
    drop pop_through_ptr();
    drop truncate_through_ptr();
    drop reserve_through_ptr();
    drop call_result_elem();
    drop elem_through_list_ptr();
    drop addr_in_struct_field();
    drop one_callee_grows_and_reads();
    drop call_result_in_struct_field();
    drop callee_builds_struct();
    drop field_of_elem_ptr_in_struct();
    drop call_result_elem_assign_named_ptr();
    drop elem_through_ptr_grown_through_other_ptr();
    drop mixed_holder_list_ptr_and_other_ptr();
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
