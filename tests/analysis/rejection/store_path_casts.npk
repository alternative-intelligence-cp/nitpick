mod:store_path_casts;
// Landing 177d2b6, row 3, the fix row (DEF-644's H1 and H2, DEF-667, DEF-666): the walk of a store reads the destination's whole path. One site per
// face closed here, each a program that reads freed memory on main (8a2b40b), and all but row 1's five on row 2's text (8fe2ceb) too:
//   H1, a cast on the destination's path cut K1's hop list (`cm2`, `cm2k`, `cm3`, `cl3`, `cil`, `cfr`, `cd2`, `cmk3`, `pcm2`, `pcm2b`, `cast_mid`,
//   `cast_midc2`, and the deep casts `cd59`, `cd60`, `cd61`); H1 at one hop, under a pointee-changing cast (`c1_b`, `c1_bi`);
//   H2, a pointee-changing cast between the hops gave the hop no target (`pcb2`);
//   DEF-667, a callee's write of its pointer parameter's pointee two hops down, alone (`wz2`, `wz2r`, `wz2p`, `wz2g`) and with refs (`dw_rw`,
//   `dw_rw3`, `dw_rwn`), and DEF-644's `xk_pbp_R_F` and `xk_pbp_RL_F` with them;
//   DEF-666, a cast copy of a held address (`zl_d`, `z_d`, `zl_v`, `d6_two`) or a cast address stored with no plain ref of its place (`d6_dir`,
//   `d6_lit`, `d6_rep`, `d6_up`), then the `wild` member freed while the pointer is still read;
//   the store walk's end: a path of more than 128 steps is refused there (`cdm124_e60`, `cdm130_e60`, `cdm66_62`, `cdm70_60`, `cdm100_60`),
//   never walked from a cut list;
//   `o_xr2l` and `o_xr2lt` (177d2b5's review probes), and row 1's five beyond its 30 (`rg_a`, `rg_a1`, `rg_l`, `rg_f`, `cyc`).
// Each cell's declarations carry its name as a suffix, and its `main` is `cell_main_<name>`. The controls that run are in
// tests/backend/programs/store_path_casts_ok.npk.
// PRICES: the eighteen cells marked PRICE below are right programs this row's text refuses, each failing closed; each comment names its twin or reason.
error:E5;
struct:K_cm2 = { int64:k; };
struct:H_cm2 = { List<int64>:l; int64:k; K_cm2:kk; };
func:mk_cm2 = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh_cm2 = H_cm2() never fails { pass H_cm2{ l: raw mk_cm2(), k: 2i64, kk: K_cm2{ k: 3i64 } }; };
func:growh_cm2 = int64(H_cm2->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl_cm2 = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp_cm2 = int64->(H_cm2->:q) never fails { pass @((<-q).l[0i64]); };
func:idh_cm2 = H_cm2->(H_cm2->:q) never fails { pass q; };
func:getl_cm2 = List<int64>->(H_cm2->:w) never fails { pass @w.l; };
struct:HPO_cm2 = { H_cm2->:lp; List<int64>:own; };
struct:SQ_cm2 = { HPO_cm2->:q; int64:z; };
struct:SR_cm2 = { SQ_cm2->:sq; int64:z; };
func:g_cm2 = int64(H_cm2->:h0p, H_cm2->:hq, H_cm2->:hz, int64:n) never fails {
    int64->:e = raw fp_cm2(hz);
    HPO_cm2:m = HPO_cm2{ lp: h0p, own: raw mk_cm2() }; SQ_cm2:s = SQ_cm2{ q: @m, z: 1i64 }; SQ_cm2->:sp = @s;
    (<-(((<-sp).q) =>! HPO_cm2->)).lp = hq;
    e = raw fp_cm2(m.lp);
    discard(raw growh_cm2(hq));
    pass (<-e) + 6i64;
};
func:f_cm2 = int64(int64:n) never fails {
    H_cm2:hz = raw mkh_cm2(); H_cm2:h0 = raw mkh_cm2(); H_cm2:h2 = raw mkh_cm2();
    pass raw g_cm2(@h0, @h2, @hz, n);
};
func:cell_main_cm2 = int32() never fails { pass (((raw f_cm2(1i64)) + 60i64) =>! int32); };
