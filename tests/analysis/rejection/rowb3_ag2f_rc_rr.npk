// expect-error: NITPICK-BORROW-015
// expect-error-at: 20:21
// 2026-11-26 (landing 177d2f, item 7, row 5: row B3, form TRY_B3m2fv (SC, over B3v, B3j and B3k); rulings l.24966). ROW B3'S WALK, A FACE OF
// DEF-681: The getter copies its parameter and loads `q = (<-p).nx ??! E5`. It hands back a view of `q.s` (`nB.s`). The caller then rewrites `nB.s`
// through `ws1(@nB)` while the view is live and reads it: a freed read. CLOSED FACE: on main (3a45b7c4) it is accepted, and it exits 140 on every
// road 0-8 at -O0 and -O2, and 97 under the detector; the same on row B2's build; refused from row B3 on. From
// `nitpick/.internal/ag2f-2026-11-21/cells/rc/ag2f_rc_rr.npk`.
mod:rowb3_ag2f_rc_rr;
error:E5;
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 7i64); pass l; };
func:mks = string() never fails { pass string_concat("a", "b"); };
struct:ND = { ND->?:nx; string:s; int64:z; };
func:ws1 = int64(ND->:o) never fails { (<-o).s = string_concat("q", "r"); pass 7i64; };
func:getv = fixed uint8[](ND->:o) never fails { ND->:p = o; ND->:q = (<-p).nx ??! E5; pass string_bytes((<-q).s); };
func:f = int64(int64:n) never fails {
    ND:nB = ND{ nx: NIL, s: raw mks(), z: 1i64 };
    ND:nC = ND{ nx: NIL, s: raw mks(), z: 1i64 };
    ND:nA = ND{ nx: @nB, s: raw mks(), z: 1i64 };
    fixed uint8[]:vw = raw getv(@nA);
    discard(raw ws1(@nB));
    pass (vw[0i64] => int64) - 90i64;
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
