mod:give_leaves_its_arm;
error:E9;
func:mk = string() never fails { pass string_concat("ab", "cde"); };
func:rds = int64(string:x) never fails { string:junk = string_concat("qq", "qq"); pass (string_bytes(x)[0i64] => int64) - 90i64; };
func:eats = int64(move string:v) never fails { pass 0i64; };
struct:SP = { string:s; int64->:p; };
struct:SN = { string:s; int64:n; };
func:eatp = int64(move SP:v) never fails { pass 0i64; };
func:eatn = int64(move SN:v) never fails { pass 0i64; };
func:eatw = int64(move wild int8->:w) never fails { dalloc(w); pass 0i64; };
enum:E = { A(string); Z; };

func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E9; };
struct:Box = { string:s; int64:n; };
enum:Os = { V(string); W(string); Z; };
macro:mv = (S) { (raw eats(move(S))) == 1i64; };
macro:gv = (N) { if (N == 1i64) { give 3i64; } };
macro:gv_bare = () { give 3i64; };
macro:gv_after = (N, X) { if (N == 1i64) { X = 7i64; give 3i64; } };

// A `give` LEAVES ITS ARM WHERE IT STANDS (DEF-526, HIGH by kind, landing 177d2b). The merge read the arm's end only, so what the arm
// assigned, tested or sealed after an early `give` held for the road that gave too: a slot read unassigned, `.value` of a failed
// `Result` a zero with no sign (60/60), a page called unsealed (97/97). `stmt_exits` still doesn't list `give`: an `if`'s merge keeps
// what that road forbids. A cell per place a `give` leaves from: `if`, `else`, a block, each loop kind, a `when`'s three parts, a macro.
// `w_inner_*` nest value picks, both orders. `w_moved_by_*`: what a road forbids, past a dead `pass`'s merge, a body's too.
// Prices, each refusing a program that runs right, all as before this row: `s_arm_end_moved_road_leaves` and `s_read_in_the_arm_after_a_road_moved`
// (DEF-524's and `stmt_exits`' price), `s_fixed_written_on_two_roads`. New here: `defer_effects_after_block.npk`'s `s_widen_give_*`.
// NOT HERE, open: a `fall` road (DEF-437's `t8`).
func:w_x_if = int64() never fails { int64:x; int64:n = 1i64; int64:q = pick (n) { (1i64) { if (n == 1i64) { give 3i64; } x = 7i64; give 1i64; }, (*) { x = 7i64; give 2i64; } }; n = q; pass x; };   // site NITPICK-ASSIGN-001
