mod:struct_pick_guarded_not_exhaustive;
// A GUARDED STRUCT DESTRUCTURE COVERS NOTHING, SO A STRUCT `pick` WHOSE EVERY ARM HAS A GUARD IS NOT EXHAUSTIVE (DEF-545 with
// DEF-472, landing 177d2b; NITPICK-PICK-003 at the pick). `(P { a, b }) where (a > 1)` takes a value only where its guard
// holds. The exhaustiveness check took any destructure as covering the selector, guarded or not. The emitter and definite
// assignment didn't: the chain ends in a trap when no arm takes the value, and what a guarded arm un-permits was dropped with
// the arm. One module per cell, each accepted before this landing and each wrong when run on some road (74: no arm took the
// value, or `.err` of a value; 60: `.value` of an error; 97: an unsealed page called). The road is `n`, 1 to 3, and the
// usual guard `a1 > 1` is false on the first.
//   What the guarded arm takes back: `checked` (most cells), `errchecked` (`e1e`), `sealed_firm` (`e1p`); or nothing, the
//   trap alone (`e1k`, `g1`, and DEF-472's own two shapes on this header, `d1` and `d2`).
//   The selector's forms: a local, a field (`y1`), a call's result (`y2`), a pointee (`y3`), a consumed owner (`x11`), a
//   generic struct (`x12`).
//   The pick's places: a statement, a declaration's value (`e1v`, `y9`), a loop's body (`x5`), a call's argument (`x6`), an
//   `if`'s, a `when`'s and a `while`'s condition (`x7`, `x13`, `y4`), a `defer`'s body (`x8`), an enum pick's arm (`x9`), a
//   value arm (`x10`), a plain struct arm (`y5`), a generic function (`x16`), a macro's expansion (`x17`: the report
//   stands at the macro's pick and a MACRO-009 note names the call), an `async` function (`x18`), a method (`y10`), a
//   trait's default body (`y11`).
//   The arms: one guard, two that cover every value together (`x4r`), three (`y8`), a guarded destructure beside a guarded
//   `(*)` (`x1`, `y9`), a guard that reads a binding (`x14`), the guard `true` (`y7`), an empty binding list (`y6`: the
//   form DEF-554's fix refuses, ruled 2026-11-04, and `y6` changes there).
//   REFUSED BEFORE THIS LANDING TOO, pinned here, the rule's twins: a guard never counted over an enum (`yk2`) or a `bool`
//   (`yk3`), both PICK-001, nor over an integer (`yk4`), nor a guarded `(*)` alone over a struct (`yk5`); and a guard-only
//   pick that assigns (`k5`: ASSIGN-001 before, PICK-003 beside it now).
//   THE PRICES, right on every road and refused: guards that cover every value together, which the check doesn't weigh.
//   Two complementary guards (`x4`, and `pp2` in a value pick), a guard that holds wherever the program runs it (`g1c`),
//   the guard `true` (`pp1`), a guarded destructure beside a guarded `(*)` (`pp3`). The remedy is a last arm with no guard.
mod:e1_spick_guard_rw = {
error:E5_e1_spick_guard_rw;
struct:H = { string:s; int64:k; };
struct:P1 = { int64:a1; int64:b1; };
struct:P2 = { int64:a2; int64:b2; };
func:mkh = H() never fails { pass H{ s: string_concat("ab", "cde"), k: 7i64 }; };
func:eath = int64(move H:v) never fails { pass 0i64; };
func:rdh = int64(move H:v) never fails { pass v.k; };
func:fillh = int64(H->:h) never fails { <-h = H{ s: string_concat("ab", "cde"), k: 7i64 }; pass 1i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_e1_spick_guard_rw; };
func:errv = int64(Error:e) never fails { pick (e) { (E5_e1_spick_guard_rw) { pass 7i64; }, (*) { pass 0i64; } } };
func:f = int64(int64:n) never fails {
    int64:out = 7i64;

    Result<int64>:r = ok(); if (r.is_error) { pass out; }
    P1:p1 = P1{ a1: n, b1: 2i64 };
    pick (p1) { (P1 { a1, b1 }) where (a1 > 1i64) { r = bad(); } }
    out = r.value;
    pass out;
};
};
