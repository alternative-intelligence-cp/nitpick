// Every analysis, across every path shape (cycle 0.5.7).
//
// 0.2 AND 0.3 GOT MECHANICAL COMPLETENESS CHECKS — every node kind reachable,
// every declaration resolved — and 0.4 could not have one, so it used negative
// coverage instead. **This cycle needs a third thing neither had.**
//
// An analysis can visit every node and still be wrong about a PATH. Assigned on one
// arm and not the other; a loop body that may run zero times; an arm of a `pick`;
// an early `pass` that leaves before the code below it; a `defer` that runs after
// everything. Each of those is a place a merge happens, and a merge is where an
// analysis that is right on straight-line code goes wrong.
//
// So this file is the cross-product, worked through: for each analysis, a case that
// exercises it across each shape. No script can tell whether a merge was handled
// CORRECTLY — only whether it was reached — which is why this is a file of cases
// rather than a checker.
//
// The per-analysis files hold the cases about each analysis's RULES. This one holds
// the cases about the shapes those rules have to survive.

mod:path_shapes;
error:E5;
error:E9;

struct:Cell = { int32->:slot; };
struct:Lease = { int32:v; };

func:sink = NIL(int32->:p) never fails { pass NIL; };
func:take_1 = Lease() acquires 1i32 { pass Lease{ v: 1i32 }; };
func:take_2 = Lease() acquires 2i32 { pass Lease{ v: 2i32 }; };
func:might_fail = int32(bool:c) {
    if (c) { fail E5; }
    pass 7i32;
};

// --- D-004, escape: the shapes a borrow can reach an exit through ------------------

// ACROSS A BRANCH. The borrow is taken on one arm and returned after the merge.
// expect-error: NITPICK-BORROW-001
func:escape_across_a_branch = int32->(bool:c) never fails {
    int32:x = 1i32;
    int32->:p = NULL;
    if (c) { p = @x; }
    pass p;
};

// IN A `pick` ARM.
// expect-error: NITPICK-BORROW-001
func:escape_from_a_pick_arm = int32->(int32:n) never fails {
    int32:x = 1i32;
    int32->:p = NULL;
    pick (n) {
        (0i32) { p = @x; },
        (*) { }
    }
    pass p;
};

// IN A `defer`, which runs at scope exit and is walked like any other body.
// (This case drove rule 4 — a borrow into an extern call — until D-190
// retired that rule's subject; the point here was always that DEFER BODIES
// ARE WALKED, so it now drives rule 3's direct store instead.)
// expect-error: NITPICK-BORROW-002
struct:DHold = { int32->:inner; };
func:escape_from_a_defer = NIL() never fails {
    int32:x = 1i32;
    DHold:h = DHold{ inner: NULL };
    defer { h.inner = @x; }
    pass NIL;
};

// --- D-065, moves: the shapes a moved-from binding survives -------------------------

// IN A `pick` ARM: moved on one arm, used after the merge. `moved` UNIONS, so
// moved-on-some-path is moved.
// expect-error: NITPICK-MOVE-001
func:moved_in_a_pick_arm = NIL(int32:n) never fails {
    wild int8->:p = alloc(8i64);
    wild int8->:q = NULL;
    pick (n) {
        (0i32) { q = move(p); },
        (*) { }
    }
    dalloc(p);
    dalloc(q);
    pass NIL;
};

// IN A `defer`: the deferred body runs at scope exit, after the `dalloc` below it,
// so it frees what was already freed.
// expect-error: NITPICK-MOVE-002
func:freed_in_a_defer = NIL() never fails {
    wild int8->:p = alloc(8i64);
    dalloc(p);
    defer { dalloc(p); }
    pass NIL;
};

// --- D-007, taint: the shapes a check has to survive ---------------------------------

// A CHECK INSIDE A LOOP proves nothing after it, because the body may run zero
// times — the same reason an assignment inside one does not survive it.
// expect-error: NITPICK-TAINT-001
func:checked_only_inside_a_loop = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    while (c) {
        if (r.is_error) { pass 0i32; }
    }
    pass (r.value);
};

// --- D-056, locks: the shapes an acquisition can be ordered across ---------------------

// ACROSS A BRANCH: level 2 is taken before the branch and level 1 inside it.
// expect-error: NITPICK-LOCK-001
func:downward_inside_a_branch = NIL(bool:c) never fails {
    Lease:a = take_2() ?! E9;
    discard(a.v);
    if (c) {
        Lease:b = take_1() ?! E9;
        discard(b.v);
    }
    pass NIL;
};

// IN A LOOP BODY.
// expect-error: NITPICK-LOCK-001
func:downward_inside_a_loop = NIL(bool:c) never fails {
    Lease:a = take_2() ?! E9;
    discard(a.v);
    while (c) {
        Lease:b = take_1() ?! E9;
        discard(b.v);
    }
    pass NIL;
};

// IN A `pick` ARM.
// expect-error: NITPICK-LOCK-001
func:downward_inside_a_pick_arm = NIL(int32:n) never fails {
    Lease:a = take_2() ?! E9;
    discard(a.v);
    pick (n) {
        (0i32) {
            Lease:b = take_1() ?! E9;
            discard(b.v);
        },
        (*) { }
    }
    pass NIL;
};

// AFTER AN EARLY `pass`, which leaves before the acquisition below it — so the two
// are never held together and this is NOT a violation. The case is here because an
// analysis that treated an exit as ordinary flow would refuse it.
func:early_exit_is_not_a_violation = NIL(bool:c) never fails {
    if (c) {
        Lease:a = take_2() ?! E9;
        discard(a.v);
        pass NIL;
    }
    Lease:b = take_1() ?! E9;
    discard(b.v);
    pass NIL;
};
