// expect-error: NITPICK-REACH-002
// expect-error-at: 17:5
//
// DEF-129 (1.6.1d step 2): a `uint64` bound of a counted loop can trap
// `IntOverflow` at the head (a value past 2^63 does not fit the counter), so a
// `failsafe` that does not name it is REACH-002 -- as any program's own `+`
// demands the arm.
mod:reach_counted_u64;
error:E9;
func:big = uint64(uint64:v) never fails { pass v; };
func:main = int32(cstring[]:_~argv) {
    int64:c = 0i64;
    till (raw big(10u64), 1u64) { c = c + 1i64; }
    exit (c =>! int32);
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; },
        (OutOfBounds) { exit 94i32; }, (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; }, (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; }, (DecreasesViolated) { exit 109i32; }, (TbbErr) { exit 110i32; },
        (E9) { exit 111i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
