// expect-error: NITPICK-REACH-001
//
// The rule's other face: a `failsafe` with no `pick` at all names nothing,
// and the route every uncaught failure takes cannot be a shrug.
mod:failsafe_nopick;

func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
