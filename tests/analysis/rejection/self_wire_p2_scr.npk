// expect-error: NITPICK-BORROW-001
// expect-error-at: 14:87
// 2026-11-21 (landing 177d2e, row 7: DEF-718, form P2-1d = P2-1c with N718; rulings l.22510, l.23320, l.23532). DEF-290'S SELF-WIRING EXEMPTION
// MARKED THE POINTER, NOT THE STORAGE: a self-wiring store through a pointer (`(<-sp).p = @((<-sp).k)`) now marks each address target of that
// pointer as its store by name would be (`s.p = @s.k`), walked on through its own pointer base and through a slice view on the path, a view taken
// through a pointer too; where the walk can't name the storage (its fuel of 8 spent, a pointer read out of a call's result, no address target), the
// store is refused (BORROW-009). CLOSED FACE (P2-1b's 8, l.22075 item 2): on main (226ebb99) it is accepted and reads a dead frame, exit 74 on
// every road 0-8 at -O0 and 55 on every road 0-8 at -O2, 74 under the detector; refused here. From seat P2's cells,
// `Team/TMP/plan-177d2e-p2-2026-11-20/cells/s718/p2_scr.npk`.
mod:self_wire_p2_scr;
error:E5;
struct:S = { int64:k; int64->:p; };
func:ids = S->(S->:q) never fails { pass q; };
func:f = S(move S:s) never fails { S->:sp = raw ids(@s); (<-sp).p = @((<-sp).k); pass s; };
func:clob = int64(int64:n) never fails { int64[8]:a = [9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64]; pass a[0i64] + (n * 0i64); };
func:g = int64(int64:n) never fails { int64:z = 1i64; S:r = raw f(S{ k: 2i64, p: @z }); int64:junk = raw clob(n); pass (<-(r.p)) + junk - 9i64; };
func:main = int32(cstring[]:argv) { int64:v = raw g(argv.len - 1i64); exit ((v + 65i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
