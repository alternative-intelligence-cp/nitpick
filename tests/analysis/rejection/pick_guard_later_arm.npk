struct:SN = { string:s; int64:n; };
func:eatp = int64(move SP:v) never fails { pass 0i64; };
func:eatn = int64(move SN:v) never fails { pass 0i64; };
func:eatw = int64(move wild int8->:w) never fails { dalloc(w); pass 0i64; };
enum:E = { A(string); Z; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E9; };
struct:Box = { string:s; int64:n; };
enum:Os = { V(string); W(string); Z; };
macro:mv = (S) { (raw eats(move(S))) == 1i64; };

// WHAT A FAILED `where` GUARD DID, THE LATER ARMS INHERIT (DEF-520, HIGH by kind, landing 177d2b). Arms are exclusive, and a guard's evaluation isn't: it runs whether or not its arm is taken, so every later arm of the `pick` sees what it moved, freed, sealed or wrote. `assign_pick` started every arm from the state before the `pick`. Each function here ran on the base: a vacated value read, a double free, a second write to a `fixed`, a write to a sealed page, a call of an unsealed one, or an error's value read as a checked one.
// `n_sibling_field_read` agrees with the plain road: a field's move refuses the whole binding's read, in sequence and in an `if`.
// The price, accepted: `p1` and `s_fall_over` are right at run time, because the guarded arm can't be the road they take, and the analysis doesn't ask. The road is a move in the arm's body (`pick_guard_later_arm_ok.npk`'s `p1r`), or a local before the `pick`.
func:g1_string_later_arm = int64() never fails { string:s = raw mk(); int64:n = 1i64; pick (n) { (1i64) where ((raw eats(move(s))) == 1i64) { pass 5i64; }, (*) { pass raw rds(s); } } pass 2i64; };   // site NITPICK-MOVE-001
