// expect-error: NITPICK-BORROW-015
// expect-error-at: 23:16
// 2026-11-19 (landing 177d2d, row 7: DEF-708, form T3-708d; rulings l.19843, l.19874 item 1, l.20020 item 1 and l.20239). A BY-VALUE holder of a
// pointer to a `List` (`grow(w)`, `Wrap:w = Wrap{ lp: @l }`), handed to a callee while an element address into that `List` is live, is judged as a
// view's holder is: `rejudge_holder` (alias.npk) raises the live element address beside the views when the argument is neither an address-of nor of
// pointer type, an `Optional` or `Result` of a pointer unwrapped first (it is a pointer). FACE (T3-708d, refused here at BORROW-015@23:16): 98 on
// main (aefae6e) on every road 0-8, -O0 and -O2, and under the detector (`failsafe`'s MachineFault: a read of freed storage). From seat A3S's attack
// on T3-708d, T3-709b and T3-711a (l.20020), `Team/TMP/atk-177d2d-t3s-2026-11-19/cells/a708e/e_hfield.npk`.
mod:holder_elem_addr_e_hfield;

struct:HL = { int64:k; List<int64>:items; };
struct:WH = { HL->:hp; };
func:growh = NIL(WH:w) never fails {
    drop list_reserve(@((<-w.hp).items), 1024i64);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    HL:h = HL{ k: 1i64, items: raw list_init::<int64>(512i64) };
    drop list_push(@h.items, 42i64);
    WH:w = WH{ hp: @h };
    int64->:ep = @h.items[0i64];
    drop growh(w);
    if ((<-ep) == 99i64) { exit 1i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (StackExhausted) { exit 97i32; }, (MachineFault)      { exit 98i32; },
        (Unreachable)    { exit 95i32; }, (HeapOom)           { exit 92i32; },
        (HeapBadRequest) { exit 91i32; }, (WildLeak)          { exit 96i32; },
        (OutOfBounds)    { exit 90i32; }, (IntOverflow)       { exit 89i32; },
        (LimitViolated)  { exit 88i32; }, (DecreasesViolated) { exit 87i32; },
        (*)              { exit 99i32; }
    }
    exit 99i32;
};
