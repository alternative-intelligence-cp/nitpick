mod:guard_views_its_lock;

// A GUARD VIEWS ITS LOCK (DEF-438, RULED, a view, landing 177d2). `m.acquire(d)`, `r.read(d)` and `r.write(d)` hand back a pointer to the lock's cell, the one builtin-method result that isn't a scalar or an owned copy. A guard over a mutex
// this function owns can't leave it (BORROW-001), and can't go into a holder that outlives the lock (BORROW-002); while it lives, nothing replaces the lock (BORROW-015). `pass g` over a dead cell read the next mutex's value through it (173,
// `y5a`), and a replaced lock freed the cell under the guard (230). A guard's release reads its lock, so a holder declared before the lock in one block is BORROW-002 too. A guard over a borrowed owner's mutex leaves freely, within that owner's life: `tests/backend/programs/guard_views_its_lock_ok.npk`. A lock's own operation judges no view of
// the lock (`alias.npk`'s `skip_view`): a second guard while the first lives is LOCK-001's. A hold that isn't a declaration raising nothing is DEF-476's.
error:E9;
struct:GH = { Guard<int32>:g; };
struct:RH = { RGuard<int32>:g; };
struct:MH = { Mutex<int32, 1i32>:m; int32:n; };
struct:Box<T> = { T:x; };
enum:EG = { Non; A(Guard<int32>); };
enum:ES = { A(string); Z; };
enum:EP = { A(int32->); Y(int32); };
struct:SS = { string:s; int32:n; };
struct:SE = { ES:e; int32:n; };
struct:GES = { Guard<ES>:g; };
async func:hes = Guard<ES>(Mutex<ES, 1i32>->:m) { pass relay await m.acquire(raw duration_ms(500i64)); };
async func:hold = Guard<int32>(Mutex<int32, 1i32>->:m) { Guard<int32>:g = relay await m.acquire(raw duration_ms(500i64)); pass g; };
async func:fwd = Guard<int32>(move Guard<int32>:g) { pass move(g); };
func:wrap<T> = Box<T>(move T:v) never fails { pass Box{ x: move(v) }; };
func:getp = Mutex<int32, 1i32>->(MH->:h) never fails { pass @h.m; };
func:rew = NIL(Mutex<int32, 1i32>->:m) never fails { <-m = mutex(9i32) ?! Unreachable; pass NIL; };
func:mkm = Mutex<int32, 1i32>() never fails { pass (mutex(7i32) ?! Unreachable); };
impl:MH = { async func:lk = Guard<int32>(MH->:self) { pass relay await self.m.acquire(raw duration_ms(500i64)); }; };
struct:MH2 = { Mutex<int32, 2i32>:m; int32:n; };
struct:XY = { Guard<int32>:g; Mutex<int32, 2i32>:m; };
async func:fill = NIL(Guard<int32>->:gp, Mutex<int32, 2i32>->:m) { Guard<int32>:t = relay await m.acquire(raw duration_ms(500i64)); <-gp = move(t); pass NIL; };
async func:hold2 = Guard<int32>(Mutex<int32, 2i32>->:m) { pass relay await m.acquire(raw duration_ms(500i64)); };
async func:hown = Guard<int32>(move Mutex<int32, 1i32>:m) { Guard<int32>:g = relay await m.acquire(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
// A `move` parameter is this function's own, as a local is: the line above (`hown`).

// Out of the function that owns the lock, by every road a value takes.
async func:guard_passed_up = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
async func:guard_in_struct = GH() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); pass GH{ g: move(g) }; };   // site NITPICK-BORROW-001
async func:rw_read_return = RGuard<int32>() { RwLock<int32, 1i32>:a = rwlock(7i32) ?! Unreachable; RGuard<int32>:g = relay await a.read(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
async func:rw_write_result_return = Guard<int32>(int64:k) { RwLock<int32, 1i32>:a = rwlock(7i32) ?! Unreachable; if (k > 5i64) { fail E9; } Guard<int32>:g = relay await a.write(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
async func:rguard_in_struct = RH() { RwLock<int32, 1i32>:a = rwlock(7i32) ?! Unreachable; RGuard<int32>:g = relay await a.read(raw duration_ms(500i64)); pass RH{ g: move(g) }; };   // site NITPICK-BORROW-001
async func:guard_forwarded_twice = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g0 = relay await a.acquire(raw duration_ms(500i64)); Guard<int32>:g1 = relay await fwd(move(g0)); Guard<int32>:g2 = relay await fwd(move(g1)); pass move(g2); };   // site NITPICK-BORROW-001
async func:long_form = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); return Result{value: move(g)}; };   // site NITPICK-BORROW-001
async func:pass_move = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); pass move(g); };   // site NITPICK-BORROW-001
async func:direct_pass = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; pass relay await a.acquire(raw duration_ms(500i64)); };   // site NITPICK-BORROW-001
async func:emphatic_unwrap = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = await a.acquire(raw duration_ms(500i64)) ?! E9; pass g; };   // site NITPICK-BORROW-001
async func:through_summary = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await hold(@a); pass g; };   // site NITPICK-BORROW-001
async func:method_summary = Guard<int32>() { MH:h = MH{ m: mutex(7i32) ?! Unreachable, n: 1i32 }; Guard<int32>:g = relay await h.lk(); pass g; };   // site NITPICK-BORROW-001
async func:pointer_local = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Mutex<int32, 1i32>->:p = @a; Guard<int32>:g = relay await p.acquire(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
async func:call_result_pointer = Guard<int32>() { MH:h = MH{ m: mutex(7i32) ?! Unreachable, n: 1i32 }; Guard<int32>:g = relay await (raw getp(@h)).acquire(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
async func:field_of_local = Guard<int32>() { MH:h = MH{ m: mutex(7i32) ?! Unreachable, n: 1i32 }; Guard<int32>:g = relay await h.m.acquire(raw duration_ms(500i64)); pass g; };   // site NITPICK-BORROW-001
async func:enum_payload = EG() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); pass EG.A(move(g)); };   // site NITPICK-BORROW-001
async func:generic_wrapper = Box<Guard<int32>>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); pass raw wrap::<Guard<int32>>(move(g)); };   // site NITPICK-BORROW-001
async func:give_arm = Guard<int32>() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; int32:k = 1i32; Guard<int32>:g = pick (k) { (1i32) { give relay await a.acquire(raw duration_ms(500i64)); }, (*) { give relay await a.acquire(raw duration_ms(500i64)); } }; pass g; };   // site NITPICK-BORROW-001
async func:optional = Guard<int32>?() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); Guard<int32>?:o = move(g); pass o; };   // site NITPICK-BORROW-001
async func:in_array = Guard<int32>[1]() { Mutex<int32, 1i32>:a = mutex(7i32) ?! Unreachable; Guard<int32>:g = relay await a.acquire(raw duration_ms(500i64)); Guard<int32>[1]:v = [move(g)]; pass move(v); };   // site NITPICK-BORROW-001

// A holder that outlives the lock, assignment being the road that isn't a declaration (`l7`'s shape; the hold it raises nothing for is DEF-476's).
async func:owner_dies_before_guard_drop = int32() { Mutex<int32, 1i32>:z = mutex(1i32) ?! Unreachable; Guard<int32>:g = relay await z.acquire(raw duration_ms(500i64)); { Mutex<int32, 2i32>:a = mutex(7i32) ?! Unreachable; g = relay await a.acquire(raw duration_ms(500i64)); } pass g.value; };   // site NITPICK-BORROW-002
