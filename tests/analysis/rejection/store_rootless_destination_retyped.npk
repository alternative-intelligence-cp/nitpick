func:g_k4l_hop = int64(H_k4l_hop->:h0p, H_k4l_hop->:hq, H_k4l_hop->:hz, int64:n) never fails {
    HPB_k4l_hop:mb = HPB_k4l_hop{ lp: h0p, own: raw mk_k4l_hop() }; HPB_k4l_hop:mb2 = HPB_k4l_hop{ lp: h0p, own: raw mk_k4l_hop() };
    HPO_k4l_hop:mo2 = HPO_k4l_hop{ lp: h0p, own: raw mk_k4l_hop() }; HPO_k4l_hop:mo3 = HPO_k4l_hop{ lp: h0p, own: raw mk_k4l_hop() };
    func HPO_k4l_hop->(HPB_k4l_hop->) never fails:fv = conv_k4l_hop;
    func SQ_k4l_hop->(SQB_k4l_hop->) never fails:fv2 = cvq_k4l_hop;
    func SQ_k4l_hop->(SQB2_k4l_hop->) never fails:fv3 = cvq2_k4l_hop;
    Z_k4l_hop:z0 = Z_k4l_hop{ z: 1i64 };
    dyn Cv_k4l_hop:d = move(z0) => dyn Cv_k4l_hop;
    SQB_k4l_hop:rb = SQB_k4l_hop{ q: @mo2, z: 1i64 };
    (<-((<-(raw fv2(@rb))).q)).lp = hq;
    int64->:e = raw fp_k4l_hop(mo2.lp);
    discard(raw growh_k4l_hop(hq));
    pass (<-e) + 6i64;
};
