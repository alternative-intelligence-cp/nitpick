mod:first_road_dies_in_a_defer;
// A `give` OR A `fall` WHOSE FIRST ROAD DIES IN A `defer` HIDES NOTHING THAT FOLLOWS (landing 177d2b2; found on the walk before it
// landed, never on main). A `give` runs the `defer`s of the blocks it leaves, and a body that never completes (a loop with no way
// out, a trap on every road) ends that road. The arm's first road was kept whole and each later one folded into it by a writer
// that doesn't read the road's flag, so the dead first road stayed dead whatever live `give` followed: the arm read as one that
// left, and what the live `give` un-permitted never reached the pick's end (`gd1`, `gd5`: `.value` of an error, 60; `gd2`: `.err`
// of a success, 60; `gd4`: a read of an unassigned local). One function takes both jumps' roads and joins them by `state_merge`,
// the writer that knows a dead road. `gf1`, `gf2`: the `fall` twins, refused before and after.
//   The controls, refused at the same place: the `defer` out (`gd1c`, `gd2c`, `gd4c`, `gf1c`, `gf2c`). A right program of each
//   shape is in the program beside this file (`gd3`, `gf3`).
mod:gd1_give_first_road_dies_loop = {
error:E5_gd1_give_first_road_dies_loop;
struct:H = { string:s; int64:k; };
func:mkh = H() never fails { pass H{ s: string_concat("ab", "cde"), k: 7i64 }; };
func:eath = int64(move H:v) never fails { pass 0i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_gd1_give_first_road_dies_loop; };
func:okn = int64(int64:n) { if (n > 90i64) { fail E5_gd1_give_first_road_dies_loop; } pass 7i64; };
func:f = int64(int64:n) never fails {
    int64:out = 7i64;
    Result<int64>:r = ok(); if (r.is_error) { pass out; }
    int64:t = pick (n) {
        (1i64) {
            if (n == 9i64) { { defer { while (true) unbounded { } } give 1i64; } }
            r = bad();
            give 2i64;
        },
        (*) { give 3i64; }
    };
    out = out + (t - t);
    out = r.value;
    pass out;
};
};
