// expect-error: NITPICK-BORROW-001
// expect-error-at: 15:136
// 2026-11-21 (landing 177d2e, row 7: DEF-718, form P2-1d = P2-1c with N718; rulings l.22510, l.23320, l.23532). DEF-290'S SELF-WIRING EXEMPTION
// MARKED THE POINTER, NOT THE STORAGE: a self-wiring store through a pointer (`(<-sp).p = @((<-sp).k)`) now marks each address target of that
// pointer as its store by name would be (`s.p = @s.k`), walked on through its own pointer base and through a slice view on the path, a view taken
// through a pointer too; where the walk can't name the storage (its fuel of 8 spent, a pointer read out of a call's result, no address target), the
// store is refused (BORROW-009). CLOSED FACE (AP2C's face (b), a slice view taken through a pointer, closed by N718, l.23532 item 2): on main
// (226ebb99) it is accepted and reads a dead frame, exit 72 on every road 0-8 at -O0 and 57 on every road 0-8 at -O2, 72 under the detector;
// refused here. From seat AP2C's cells, `.internal/atk-177d2e-ap2c-2026-11-20/cells/c3/ap2c_slh_v7.npk`.
mod:self_wire_ap2c_slh_v7;
error:E5;
struct:S = { int64:k; int64->:p; };
struct:W = { S[2]:a; int64:z; };
struct:WH = { W->:w; int64:z; };
func:f = W(move W:w, int64:n) never fails { WH:h = WH{ w: @w, z: 0i64 }; S[]:sl = h.w.a[0i64...2i64]; sl[0i64].p = @(sl[0i64].k); pass w; };
func:g = int64(int64:n) never fails { int64:z = 2i64; W:r = raw f(W{ a: [S{ k: 2i64, p: @z }, S{ k: 2i64, p: @z }], z: 0i64 }, n); int64:junk = raw clob(n); pass (<-(r.a[0i64].p)) + junk - 7i64; };
func:clob = int64(int64:n) never fails { int64[8]:a = [7i64, 7i64, 7i64, 7i64, 7i64, 7i64, 7i64, 7i64]; pass a[0i64] + (n * 0i64); };
func:main = int32(cstring[]:argv) { int64:v = raw g(argv.len - 1i64); exit ((v + 65i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
