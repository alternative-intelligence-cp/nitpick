// expect-error: NITPICK-BORROW-015
// expect-error-at: 19:261
// 2026-11-26 (landing 177d2f, item 7, row 5: row B3, form TRY_B3m2fv (SC, over B3v, B3j and B3k); rulings l.26933). ROW B3'S WALK, A FACE OF
// DEF-681: With `r.me = @r`, `lk(R3->:r)` stores `adrb((<-r).me ??! E5)`, which is `@r.b`, into `(<-r).a.nx`. The caller takes a view through
// `r.a.nx`, `wse(@r.b)` replaces `r.b.s`, and the view is read. CLOSED FACE: on main (3a45b7c4) it is accepted, and it exits 140 on every road 0-8
// at -O0 and -O2, and 97 under the detector; the same on row B2's build; refused from row B3 on. From
// `Team/TMP/w25-177d2f-2026-11-25/cells/w25f/w25f_gr.npk`.
mod:rowb3_w25f_gr;
error:E5;
func:mks = string() never fails { pass string_concat("a", "b"); };
struct:NE = { NE->?:nx; NE->?:ny; string:s; int64:z; };
struct:R2 = { NE:a; NE:b; int64:z; };
struct:R3 = { NE:a; NE:b; R3->?:me; R2->?:o; int64:z; };
func:wse = int64(NE->:o) never fails { (<-o).s = string_concat("q", "r"); pass 7i64; };
func:getx = fixed uint8[](NE->:o) never fails { NE->:p1 = (<-o).nx ??! E5; pass string_bytes((<-p1).s); };
func:gety = fixed uint8[](NE->:o) never fails { NE->:p1 = (<-o).ny ??! E5; pass string_bytes((<-p1).s); };
func:adrb = NE->(R3->:q) never fails { pass @((<-q).b); };
func:lk = int64(R3->:r) never fails { (<-r).a.nx = raw adrb((<-r).me ??! E5); pass 0i64; };
func:f = int64(int64:n) never fails { R3:r = R3{ a: NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, b: NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, me: NIL, o: NIL, z: 0i64 }; r.me = @r; discard(raw lk(@r)); fixed uint8[]:vw = raw getx(@r.a); discard(raw wse(@r.b)); pass (vw[0i64] => int64) - 90i64; };
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
