// A VIEW RETURNED THROUGH THE BARE POINTER ITSELF (DEF-355, landing 177a). `fixed uint8[]:vw = raw getv(p);` with `p = @s` raises a view party at `p`, its path empty, and `ptr_write_base` looked for a pointer BELOW the place and answered none,
// so `s = ...` by its own name met nothing and the view read freed bytes (`d355_typed`, 113; `r1v_f1_view_summary_named`, 170). The place itself is the pointer now. D-325's rule is flow-free, so a view read BEFORE the owner is written is over-refused when its name lives on
// (`r1vn_f1_view_summary_noview`, 0 on 176b and safe at run time, as `string_bytes(s)` held by name always was): end the view's block first (`cast_place_readers_ok.npk`, case 22).
mod:view_through_bare_pointer;
error:E5;
func:getv = fixed uint8[](string->:q) never fails { pass string_bytes(<-q); };
struct:H2 = { string:o; int64:k; };
func:getm = fixed uint8[](H2->:q) never fails { pass string_bytes((<-q).o); };
struct:S  = { string:x; int64:k; };
impl:S = { func:sset = NIL(S->:self) never fails { self.x = string_concat("x", "y"); pass NIL; }; };
func:getx = fixed uint8[](any->:q) never fails { pass string_bytes((<-(q =>! S->)).x); };
// d355_typed -- DEF-355's non-cast question: `string_bytes(<-q)` returned through a typed pointer held by a named local; then the owner is written; right verdict a refusal; on 176b: exit 113.
func:c_d355_typed = int64() never fails {
    string:s = string_concat("ab", "cd");
    string->:p = @s;
    fixed uint8[]:vw = raw getv(p);
    s = string_concat("zz", "zz");
    string:junk = string_concat("qq", "qq");
    pass (((vw[0i64] => int32)) => int64);
};
// d355_typed_inline -- inline twin of d355_typed; on 176b: BORROW-015.
func:c_d355_typed_inline = int64() never fails {
    string:s = string_concat("ab", "cd");
    fixed uint8[]:vw = raw getv(@s);
    s = string_concat("zz", "zz");
    string:junk = string_concat("qq", "qq");
    pass (((vw[0i64] => int32)) => int64);
};
// d355_typed_member -- the member spelling: `string_bytes((<-q).o)` through a typed pointer held by a named local; on 176b: BORROW-015.
func:c_d355_typed_member = int64() never fails {
    H2:h = H2{ o: string_concat("ab", "cd"), k: 1i64 };
    H2->:p = @h;
    fixed uint8[]:vw = raw getm(p);
    h.o = string_concat("zz", "zz");
    string:junk = string_concat("qq", "qq");
    pass (((vw[0i64] => int32)) => int64);
};
