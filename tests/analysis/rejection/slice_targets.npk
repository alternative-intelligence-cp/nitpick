func:s09 = int32() never fails {
    H2[2]:arr = [H2{ o: string_concat("a", "b") }, H2{ o: string_concat("c", "d") }];
    BW:b = BW{ sl: arr[0i64...2i64], w: string_bytes(arr[0i64].o) };
    b.sl[0i64].o = string_concat("x", "y");
    pass (b.w[0i64] => int32);
};
func:s10 = int32() never fails {
    H2[2]:arr = [H2{ o: string_concat("a", "b") }, H2{ o: string_concat("c", "d") }];
    fixed uint8[]:vw = string_bytes(arr[0i64].o);
    drop g_local(arr[0i64...2i64]);
