    H2[2]:arr = [H2{ o: string_concat("a", "b") }, H2{ o: string_concat("c", "d") }];
    fixed uint8[]:vw = string_bytes(arr[0i64].o);
    B2:b = B2{ sl: arr[0i64...2i64] };
    b.sl[0i64].o = string_concat("x", "y");
    pass (vw[0i64] => int32);
};
func:s08 = int32() never fails {
    H2[2]:arr = [H2{ o: string_concat("a", "b") }, H2{ o: string_concat("c", "d") }];
    fixed uint8[]:vw = string_bytes(arr[0i64].o);
    H2[]:t = arr[0i64...2i64];
