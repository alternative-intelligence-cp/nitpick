// --- controls -------------------------------------------------------------------------------------------------------
func:ctl_local_writer = int32() never fails {
    H2[2]:arr = [H2{ o: string_concat("a", "b") }, H2{ o: string_concat("c", "d") }];
    H2[]:t = arr[0i64...2i64];
    drop w(t);
    if (arr[0i64].o.len != 2i64) { pass 1i32; }
    pass 0i32;
};
