// expect-error: NITPICK-BORROW-009
// expect-error-at: 34:21
// expect-error: NITPICK-BORROW-009
// expect-error-at: 43:11
//
// (2026-10-18, DEF-257, landing 133: the `pick` case picked on an ADDRESS, `pick (@h.t)`,
// and drew `NITPICK-PICK-003` beside the borrow -- its selector a `Tag->` rather than a
// `Tag`. A `pick` does not select on a pointer now: that shape is TYPE-065 in the type
// checker, which runs before the escape analysis, and `tests/types/rejection/pick_pointer.npk`
// keeps it. The case here picks on an enum that HOLDS a local's address -- the borrow
// the analysis still refuses to follow into a pattern binding.)
//
// A BORROW REACHING A BINDING THE ESCAPE ANALYSIS DOES NOT FOLLOW (D-004, 0.5.1).
//
// `for` and `pick` both introduce bindings whose relationship to what they came
// from the analysis has no model of: a `for` binding over a borrowed collection and
// a pattern binding destructured out of a borrowed value. Neither is tracked, so a
// borrow reaching one could not be followed if it escaped.
//
// REFUSED RATHER THAN FOLLOWED WRONGLY. The alternative is an analysis that says
// nothing about the case and lets a borrow through — which is the failure the whole
// of D-004 exists to prevent, arriving in the one place the analysis cannot see.
//
// It is also NARROW: only a borrow reaching one of those two positions is refused.
// Iterating an owned array and picking on an owned enum are the ordinary forms and
// are untouched, which `tests/accept/borrows.npk` shows.
mod:untracked_borrow;

struct:Bag = { int32[4]:items; };

enum:Ref = { At(int32->); Nada; };

func:iterate_a_borrow = NIL(Bag->:b) never fails {
    for (int32:v in @b.items) {
        discard(v);
    }
    pass NIL;
};

func:pick_on_a_borrow = NIL() never fails {
    int32:v = 5i32;
    Ref:r = Ref.At(@v);
    pick (r) {
        (At(q)) { pass NIL; },
        (Ref.Nada) { pass NIL; }
    }
    pass NIL;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };

// THE HANDLER A ROOT OWES (D-013; REACH-003 at 1.5.1b step 1b): this file
// had a `main` and no `failsafe` from the day it was written, and the reach
// analysis never asked until the workbench's DEF-5 -- every identity the
// trap route can hand the handler is named (D-179), `(*)` beneath them.
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable) { exit 95i32; }, (HeapOom) { exit 92i32; },
        (HeapBadRequest) { exit 91i32; }, (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault) { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
