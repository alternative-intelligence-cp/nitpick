// expect-error: NITPICK-BORROW-009
// expect-error-at: 14:139
// 2026-11-26 (landing 177d2f, item 7, row 1: row A, form RA5F, DEF-681's own root and its clean fallback; rulings l.24391 item 4). A SELF-WIRING
// STORE THROUGH A TWO-LEVEL GETTER'S RESULT (`g2` returns `(<-((<-pw).q)).q2`, `@y`, `f`'s `move` parameter; `f` wires `(<-r).p = @((<-r).k)` and
// passes `y` out, so the caller reads `f`'s dead frame). AG2F's release of item 7's earlier row A (RA3, RAB4 and RABC4 accepted it); "The cell
// joins row A's rejection tests" (l.24391 item 4). Main (3a45b7c4) refuses it too, at the same site (BORROW-009), and so does every build of the
// stack. From `nitpick/.internal/ag2f-2026-11-21/cells/a/ag2f_a2l.npk`.
mod:own_root_release_a2l;
error:E5;
struct:S = { int64:k; int64->:p; };
struct:X = { S:iv; S->:q2; };
struct:W = { X->:q; };
func:g2 = S->(W->:pw) never fails { pass (<-((<-pw).q)).q2; };
func:f = S(move S:y) never fails { int64:z = 2i64; X:x = X{ iv: S{ k: 2i64, p: @z }, q2: @y }; W:w = W{ q: @x }; S->:r = raw g2(@w); (<-r).p = @((<-r).k); pass y; };
func:g = int64(int64:n) never fails { int64:z = 2i64; S:r = raw f(S{ k: 2i64, p: @z }); int64:junk = raw clob(n); pass (<-(r.p)) + junk - 9i64; };
func:clob = int64(int64:n) never fails { int64[8]:a = [9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64]; pass a[0i64] + (n * 0i64); };
func:main = int32(cstring[]:argv) { int64:v = raw g(argv.len - 1i64); exit ((v + 65i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
