// D-035 / D-155 — the wildx W^X state machine (0.10.5). The two seal
// transitions the analysis watches directly, plus the two that fall out of
// the move machinery. The regression case D-035 hand-delivered — the
// prototype's jit.npk freed the page on write failure and then sealed the
// freed page — is `seal_after_free` below.

// expect-error: NITPICK-MOVE-002
func:seal_after_free = NIL() never fails {
    // the jit.npk bug: free, then seal the freed page (use-after-free)
    wildx int8->:page = wildx_alloc(64i64);
    wildx_free(page);
    wildx_seal(page);
    pass NIL;
};

// expect-error: NITPICK-WILDX-001
func:write_after_seal = NIL() never fails {
    // a sealed page is executable; writing it would make a region W and X at
    // once — the invariant wildx exists to prevent
    wildx uint8->:page = wildx_alloc(64i64) =>! wildx uint8->;
    page[0i64] = 72u8;
    wildx_seal(page);
    page[0i64] = 99u8;
    wildx_free(page);
    pass NIL;
};

// expect-error: NITPICK-WILDX-002
func:exec_before_seal = NIL() never fails {
    // calling code on a writable page — the state the seal exists to close
    wildx uint8->:page = wildx_alloc(64i64) =>! wildx uint8->;
    page[0i64] = 195u8;
    int64:r = wildx_call(page, 5i64);
    discard(r);
    wildx_free(page);
    pass NIL;
};

// expect-error: NITPICK-MOVE-002
func:double_free = NIL() never fails {
    wildx int8->:page = wildx_alloc(64i64);
    wildx_seal(page);
    wildx_free(page);
    wildx_free(page);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
