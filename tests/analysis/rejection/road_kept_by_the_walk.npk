// wrong read or a wrong free a mutant of the walk accepts: a jump's later `defer` running first in the walk (`ro1`, 60 under it), a
// guard's assignment taken as a later arm's start (`gm2`, 60), a silent trip's `break` not met with the loop's way round (`msb`, 60),
// and the live twins of the dead `continue` and `fall` roads in the `_ok` file (`wr3k`, `wr4k`).
mod:gm2_guard_assigns_later_arm_reads = {
error:E5_gm2_guard_assigns_later_arm_reads;
struct:H = { string:s; int64:k; };
func:mkh = H() never fails { pass H{ s: string_concat("ab", "cde"), k: 7i64 }; };
func:eath = int64(move H:v) never fails { pass 0i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_gm2_guard_assigns_later_arm_reads; };
func:okn = int64(int64:n) { if (n > 90i64) { fail E5_gm2_guard_assigns_later_arm_reads; } pass 7i64; };
func:f = int64(int64:n) never fails {
    int64:out = 7i64;
    int64:y;
    pick (n) {
        (99i64) where (pick (n) { (*) { y = 7i64; give false; } }) { out = 1i64; },
        (*) { out = y; }
    }
    pass out;
};
};
