// expect-error: NITPICK-REACH-002
//
// A FUNCTION'S `decreases` ARMS `DecreasesViolated` (D-304 (5), 1.5.8c step 4):
// every call inside the function's recursive group checks the callee's measure
// at the arguments against the caller's at entry and traps when it is not
// below it, or the caller's is below zero -- so a `failsafe` that does not name
// the identity refuses here, as one missing it for a loop's `decreases` does.
// `(IntOverflow)` IS named, for `n - 1i32` and `n * ...`; the one arm missing is
// the measure's.
mod:reach_fn_decreases;
error:E9;

func:fact = int32(int32:n) decreases n never fails {
    if (n <= 0i32) { pass 1i32; }
    pass (n * (raw fact(n - 1i32)));
};

func:main = int32(cstring[]:_~argv) {
    exit (raw fact(3i32));
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
