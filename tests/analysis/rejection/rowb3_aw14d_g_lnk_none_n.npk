// expect-error: NITPICK-BORROW-015
// expect-error-at: 30:21
// 2026-11-26 (landing 177d2f, item 7, row 5: row B3, form TRY_B3m2fv (SC, over B3v, B3j and B3k); rulings l.25918). ROW B3'S WALK, A FACE OF
// DEF-681: A callee `lnkg` stores `@((<-a)[1])` into `(<-a)[0].nx` of the caller's `NE[3]`, and a one-load getter on `@g[0]` views `g[1].s`. The
// caller rewrites `g[1].s` through `wse(@g[1])` while the view is live and reads it. CLOSED FACE: on main (3a45b7c4) it is accepted, and it exits
// 140 on every road 0-8 at -O0 and -O2, and 97 under the detector; the same on row B2's build; refused from row B3 on. From
// `Team/TMP/aw14-177d2f-2026-11-22/cells/aw14/d/aw14d_g_lnk_none_n.npk`.
mod:rowb3_aw14d_g_lnk_none_n;
error:E5;
func:mks = string() never fails { pass string_concat("a", "b"); };
struct:NE = { NE->?:nx; NE->?:ny; string:s; int64:z; };
struct:R2 = { NE:a; NE:b; int64:z; };
struct:BH = { NE->?:p; int64:z; };
func:wse = int64(NE->:o) never fails { (<-o).s = string_concat("q", "r"); pass 7i64; };
func:getx = fixed uint8[](NE->:o) never fails { NE->:p1 = (<-o).nx ??! E5; pass string_bytes((<-p1).s); };
func:sw = int64(NE->:o) never fails { (<-o).nx = o; pass 0i64; };
func:setnx = int64(NE->:o, NE->:t) never fails { (<-o).nx = t; pass 0i64; };
func:cpyx = int64(NE->:o) never fails { (<-o).ny = (<-o).nx; pass 0i64; };
func:wrapoo = int64(NE->:o) never fails { discard(raw setnx(o, o)); pass 0i64; };
func:cpyr = int64(R2->:r) never fails { (<-r).b.ny = (<-r).a.nx; pass 0i64; };
func:lnkab = int64(R2->:r) never fails { (<-r).a.nx = @((<-r).b); pass 0i64; };
func:adrb = NE->(R2->:r) never fails { pass @((<-r).b); };
func:lnkg = int64(NE[3]->:a) never fails { (<-a)[0i64].nx = @((<-a)[1i64]); pass 0i64; };
func:f = int64(int64:n) never fails {
    NE:c = NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 };
    NE[3]:g = [NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }];
    R2:r = R2{ a: NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, b: NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, z: 0i64 };
    discard(raw lnkg(@g));
    fixed uint8[]:vw = raw getx(@g[0]);
    discard(raw wse(@g[1]));
    pass (vw[0i64] => int64) - 90i64;
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
