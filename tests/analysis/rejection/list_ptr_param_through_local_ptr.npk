mod:list_ptr_param_through_local_ptr;
// A POINTER TO A PARAMETER, READ THROUGH, IS THE PARAMETER (DEF-594, landing 177d2b3). `list_ptr_through_param.npk` freezes a pointer parameter's pointee while a
// pointer a call returned from it is live (DEF-584). Here the parameter reaches the call through a LOCAL POINTER TO IT: `H->->:pp = @hp;` and `raw fp(<-pp)`, or
// `HP->:q = @hv;` over a by-value `hv` and `raw fp((<-q).lp)`. A dereference carries what the binding its pointer names HOLDS, and for a parameter that was only what
// the body had stored into it: the parameter's own value, which is the caller's, was nobody's, so the call's result had no chain and read freed heap after the
// growth (236, detector 97, on main and on this landing's DEF-584). Now the hop that lands on a parameter gives the PASS ref the parameter's name gives, at the
// addressed place, read as the dereference's type (escape.npk's dereference arm). THE YARDSTICK is the direct spelling (`raw fp(hp)`, `raw fp(hv.lp)`; the twin's
// name ends in `d`). Each module is one cell, each site NITPICK-BORROW-015.
//   THE PARAMETER: a pointer parameter (`yp3e`), a by-value struct parameter and its pointer member (`yp1e`), a pointer parameter to a struct and its member
//     (`yp4e`, and `yp4a` with the member read by `.` after the `<-`), the address of a by-value parameter's MEMBER (`yp7e`).
//   HOW THE ADDRESS REACHES ITS READER: kept in a struct (`yp5e`), handed back by a call (`yp6e`), a call's pointer INTO a by-value parameter, where the place is
//     the struct and the value read is its pointer member (`yp15e`: the ref is read as the dereference's type, not the place's).
//   WHERE THE VALUE STANDS: a temporary with the growth a later argument (`yp8e`), an aggregate holder (`yp9e`), a copy made through the pointer and then used
//     for the call and the growth (`yp11e`).
//   ACROSS A CALL: a getter that returns the member through its own local pointer to a by-value parameter, the caller's growth refused (`yp2e`); a callee that
//     stores the parameter read through the pointer into another parameter's pointee, read back by its caller (`yp10e`).
//   THE PRICE, a right program refused as its direct twin `yp14d` has been since DEF-584: a sibling member written while the pointer is live (`yp14e`).
//   REFUSED BEFORE THIS ROW, the direct twins: `yp3d`, `yp1d`, `yp7d`, `yp15d`, `yp14d`.
// STILL OPEN, in neither file: the same reads spelled without `<-` (`q.lp`, `pp[0i64]`; DEF-592, the next row), and a pointer to a variadic tail (DEF-567).
mod:yp3e_ptr_param_local_ptr = {
error:E5_yp3e_ptr_param_local_ptr;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:fpl = int64->(List<int64>->:q) never fails { pass @((<-q)[0i64]); };
func:fa = int64->(S->:q) never fails { pass @((<-q).a); };
func:idp = int64->(int64->:q) never fails { pass q; };
func:idh = H->(H->:q) never fails { pass q; };
func:fp2 = int64->(int64:v, H->:q) never fails { pass @((<-q).l[0i64]); };
func:fp2b = int64->(H->:q, int64:v) never fails { pass @((<-q).l[0i64]); };
func:rd2 = int64(int64->:e, int64:z) never fails { pass <-e; };
impl:H = { func:first = int64->(H->:self) never fails { pass @((<-self).l[0i64]); }; };
impl:K = { func:sel = int64->(K:self, H->:q) never fails { pass @((<-q).l[0i64]); }; };
func:g = int64(H->:hp, int64:n) never fails {
    H->->:pp = @hp;
    int64->:e = raw fp(<-pp);
    discard(raw growh(hp));
    pass (<-e) + 6i64;
};
func:f = int64(int64:n) never fails {
    H:h0 = raw mkh();
    pass raw g(@h0, n);
};
};
