mod:list_ptr_binding_address_read;
// A BINDING'S VALUE READ THROUGH ITS ADDRESS IS ASKED AS THE BINDING READ BY ITS NAME IS (DEF-618, DEF-619, landing 177d2b3). `mkpa(q)` returns
// `[raw fp(q), raw fp(q)]` and `mkpe2(q)` two `PE{ p: raw fp(q), … }`: addresses made inside `q`'s pointee's `List`. A `for` (or `pick`) binding over such a
// source, read by its name (`e = p;`, `e = pe.p;`), is refused since DEF-613's B2c: the source's PASS ref of `hp` is asked as it stands and as the read. Read
// through the binding's ADDRESS (`int64->->:k = @p; e = <-k;`, `PE->:k = @pe; e = raw k.getp();`) the hop through the address (escape.npk's `collect_base_refs`)
// marked the source's refs with the dereference's type and kept no copy, so `hp` was asked only as an `int64->` read out of it, which freezes nothing, and
// `discard(raw growh(hp)); pass <-e;` read freed heap. Now the hop asks both ways under B2c's two conditions (`mark_read_t` against the source's type). Each module
// is one cell: the source is a local built from a call's result in a block that ends before the growth, then `<-e` reads the held pointer.
// DEF-618, a regression of this landing from DEF-592 (`abeb077`), which released it: `n_foraddr_recv`, a by-value receiver called through the binding's address,
// `for (PE:pe in src) { PE->:k = @pe; e = raw k.getp(); }`.
// DEF-619, on main and every build of this landing: `m_foraddr_held` `<-k` over `k = @p`; `m_foraddr_elem` the same with the source an element of a held array;
// `n_foraddr_deref` `<-k` over a `PE`; `n_foraddr_derefmember` `(<-k).p`; `n_foraddr_derefrecv` `raw (<-k).getp()`; `n_formemberaddr_deref` `@pe.p` then `<-k`;
// `n_forinpickaddr` the `for` and its address inside a lending `pick` arm; `t_loc_nestarm` the read inside two nested `if`s; `t_loc_nestfor` inside a nested
// `for`; `t_loc_optsrc` the source held from an Optional call result through `??`; `x_row_derefidx` `(<-k)[0i64]` over a `for` binding of type `int64->[2]`;
// `m_foraddr_call` `<-k` over a binding whose source is a call's result, refused by the emitter alone before this row (EMIT-002), now at the growth as
// its direct twin `m_for_call` is.
// THE READ OF 0, refused before this row and unmoved: `n_foraddr_member` `PE->:k = @pe; e = k.p;` (the member's own mark asks both ways after the hop), and the
// direct twins `m_for_held` (`e = p`) and `n_foraddr_deref`'s by name.
// THE PARAMETER HOP (`ph_…`), refused before this row and unmoved: `g` hands back what it read through its PARAMETER's address (`PE->:k = @pe; pass (<-k).p;`,
// `int64->->:k = @pp; pass <-k;`, `H->->:k = @hp; pass raw fp(<-k);`, …) and `f` grows the `List` and reads it. That hop's PASS ref is the parameter's own value
// read at its own type, so the two asks are one and it pushes no copy; without its push every one of these reads freed heap.
// THE DEPTH CLIFF: `an_fd_d32_cliff` reads each of 32 nested `for` bindings through the previous one's address (`H->->:k = @m; for (H->:m2 in [<-k])`),
// every level through the hop; without the second condition the hop keeps a copy at every level, and the compile stops in npkc's own failsafe.
mod:an_fd_d32_cliff = {
error:E5_an_fd_d32_cliff;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:fpl = int64->(List<int64>->:q) never fails { pass @((<-q)[0i64]); };
func:fa = int64->(S->:q) never fails { pass @((<-q).a); };
func:idp = int64->(int64->:q) never fails { pass q; };
func:idh = H->(H->:q) never fails { pass q; };
func:fp2 = int64->(int64:v, H->:q) never fails { pass @((<-q).l[0i64]); };
func:fp2b = int64->(H->:q, int64:v) never fails { pass @((<-q).l[0i64]); };
func:rd2 = int64(int64->:e, int64:z) never fails { pass <-e; };
impl:H = { func:first = int64->(H->:self) never fails { pass @((<-self).l[0i64]); }; };
impl:K = { func:sel = int64->(K:self, H->:q) never fails { pass @((<-q).l[0i64]); }; };
enum:EH = { A(H->); Z; };
enum:EW = { A(W); Z; };
impl:W = { func:getw = W(W:self) never fails { pass self; }; func:geth = H->(W:self) never fails { pass self.hp; }; };
struct:HO = { H->:h; List<int64>:own; };
enum:EHO = { A(HO); Z; };
impl:HO = { func:geth = H->(HO:self) never fails { pass self.h; }; };
func:mkeho = EHO(H->:q) never fails { pass EHO.A(HO{ h: q, own: raw mk() }); };
func:mkeh = EH(H->:q) never fails { pass EH.A(q); };
func:mkew = EW(W:w) never fails { pass EW.A(w); };
func:g = int64(H->[2]:pa, H->:hz, int64:n) never fails {
    int64->:e = raw fp(hz);
    for (H->:m0 in pa) {
