func:gpl_wap<T> = int64(T->:p, H_wap->:v) never fails { discard(raw put3_wap((((p) =>! any->) =>! HPO_wap->->->), v)); pass 7i64; };
func:gpr_wap<T> = int64(T->:p, T->:p2, H_wap->:v, int64:n) never fails { discard(raw put3_wap((((is (n > 100i64) : p2 : p) =>! any->) =>! HPO_wap->->->), v)); pass 7i64; };
func:gpn_wap<T> = int64(T->:p, H_wap->:v) never fails { HPO_wap->->->:tq = ((p) =>! any->) =>! HPO_wap->->->; discard(raw put3_wap(tq, v)); pass 7i64; };
func:g_wap = int64(H_wap->:h0p, H_wap->:hq, H_wap->:hz, int64:n) never fails {
    int64->:e = raw fp_wap(hz);
    HPO_wap:mo = HPO_wap{ lp: h0p, own: raw mk_wap() }; HN_wap:mn = HN_wap{ a: 1i64, b: 2i64 };
    XW1_wap:s = XW1_wap{ x: @mn, w: @mo, z: 1i64 };
    discard(raw puta_wap(((s.x) =>! any->), hq));
