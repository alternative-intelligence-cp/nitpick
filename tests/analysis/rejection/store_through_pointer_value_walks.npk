func:putgrow_a_pcn = int64(HPO_a_pcn->:p, H_a_pcn->:v) never fails { p.lp = v; loop(0i64, 64i64, 1i64) { drop list_push(@p.own, 1i64); } pass 7i64; };
func:g_a_pcn = int64(H_a_pcn->:h0p, H_a_pcn->:hq, H_a_pcn->:hz, int64:n) never fails {
    int64->:e = raw fp_a_pcn(hz);
    HN_a_pcn:m = HN_a_pcn{ a: 1i64, b: 2i64 }; SN_a_pcn:sn = SN_a_pcn{ q: @m, z: 1i64 };
    discard(raw put_a_pcn(((sn.q) =>! any->) =>! HPO_a_pcn->, hq));
    e = raw fp_a_pcn((<-(((@m) =>! any->) =>! HPO_a_pcn->)).lp);
    discard(raw growh_a_pcn(hq));
    pass (<-e) + 6i64;
};
func:f_a_pcn = int64(int64:n) never fails {
    H_a_pcn:hz = raw mkh_a_pcn(); H_a_pcn:h0 = raw mkh_a_pcn(); H_a_pcn:h2 = raw mkh_a_pcn();
    pass raw g_a_pcn(@h0, @h2, @hz, n);
};
