func:getownv_x_m1a1s2_f2 = List<PV_x_m1a1s2_f2>->(HPV_x_m1a1s2_f2->:w) never fails { pass @w.own; };
func:mkv_x_m1a1s2_f2 = List<PV_x_m1a1s2_f2>(H_x_m1a1s2_f2->:h) never fails { List<PV_x_m1a1s2_f2>:l = raw list_init::<PV_x_m1a1s2_f2>(1i64); drop list_push(@l, PV_x_m1a1s2_f2{ p: h, v: 1i64 }); pass l; };
