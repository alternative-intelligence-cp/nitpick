// --- DEF-383: A `return`'s `Result` LITERAL LEAVES `pass`'s SUMMARY (NITPICK-BORROW-015 at the write) ---
// 28. (e3_func_heapb_l) the long form: `takev_long` hands back a view of the caller's `w` in a `move` parameter's field,
//     and the caller rewrites `w` while the result is live (silent on landing 171, 13 at both legs)
func:result_literal_view = int64() {
    string:w = string_concat("hi", "jkl");
    HB:hh = HB{ v: string_concat("ab", "cd"), n: 0i64 };
    string:t = takev_long(move(hh), @w) ?| string_concat("xy", "zw");
    w = string_concat("zz", "zzz");
    fixed uint8[]:tb = string_bytes(t);
    if (tb[0i64] != 104u8) { pass 3i64; }
    pass 1i64;
};

// 29. (e3_func_heapb_p) the `pass` twin, refused on landing 171 as here
func:pass_view = int64() {
    string:w = string_concat("hi", "jkl");
    HB:hh = HB{ v: string_concat("ab", "cd"), n: 0i64 };
    string:t = takev_pass(move(hh), @w) ?| string_concat("xy", "zw");
    w = string_concat("zz", "zzz");
    fixed uint8[]:tb = string_bytes(t);
    if (tb[0i64] != 104u8) { pass 3i64; }
    pass 1i64;
};

// --- A DEREFERENCE IN A FUNCTION THAT LENDS (R1 of management's review of 99f83e7; NITPICK-BORROW-001 at the read) ---
// A callee or a builtin handed a borrow of this frame stores it into the target where the target's mark does not record
// it (DEF-390: the store matrix does not attribute the store to its target), so `deref_targets_hold` answers YES in any
// function where some call -- a builtin's included -- is handed a borrow of the frame. Each was refused on landing 171
// and silent on the first build of landing 172 (99f83e7), 13 at both legs: the caller read the dead `x`.
// 30. (r1) a callee handed the target's pointer through a FIELD of a holder, `setpp(hh.ptr, @x)`
func:lent_field_callee = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop setpp(hh.ptr, @x);
    PS->:sp = @v;
    pass (<-sp);
};

// 31. (r1m) the same by a method on the field, `hh.ptr.setq(@x)`
func:lent_field_method = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop hh.ptr.setq(@x);
    PS->:sp = @v;
    pass (<-sp);
};

// 32. (r1s) the AUTOMATIC dereference, `sp.p` read after the callee's store
func:lent_auto_deref = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop setpp(hh.ptr, @x);
    PS->:sp = @v;
    int64->:rp = sp.p;
    pass PS{ p: rp, k: 3i64 };
};

// 33. (r1x1) the target's pointer handed to the callee as a CALL'S RESULT, `setpp(raw ptr_of(@hh), @x)`
func:lent_call_result = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop setpp(raw ptr_of(@hh), @x);
    PS->:sp = @v;
    pass (<-sp);
};

// 34. (r1x2) the target's pointer handed to the callee as an ARRAY ELEMENT, `setpp(arr[0i64], @x)`
func:lent_array_elem = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS->[1]:arr = [@v];
    drop setpp(arr[0i64], @x);
    PS->:sp = @v;
    pass (<-sp);
};

// 35. (r1y) the INLINE dereference, `pass (<-(@v))`, after the field road's store
func:lent_inline_deref = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop setpp(hh.ptr, @x);
    pass (<-(@v));
};

// 36. (y1) a BY-VALUE holder, `setps(hh, @x)` with `setps = NIL(HP:h, int64->:q) { h.ptr.p = q; }`
func:lent_byval_holder = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop setps(hh, @x);
    PS->:sp = @v;
    pass (<-sp);
};

// 37. (y2) TWO LEVELS DOWN through a named destination, `setph(@hh, @x)` -- recorded on `hh`, not `v`
func:lent_two_level = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop setph(@hh, @x);
    PS->:sp = @v;
    pass (<-sp);
};

// 38. (y4) an automatic-reference METHOD two levels down, `hh.seth(@x)` with `self.ptr.p = q`
func:lent_method_two_level = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    HP:hh = HP{ ptr: @v, n: 0i64 };
    drop hh.seth(@x);
    PS->:sp = @v;
    pass (<-sp);
};

// 39. (y3) THE COPY ROAD: `@v` written ONCE, into `sp`, and a COPY of the pointer carried to the callee in a holder
func:lent_copy_road = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS->:sp = @v;
    HP:hh = HP{ ptr: sp, n: 0i64 };
    drop setpp(hh.ptr, @x);
    pass (<-sp);
};

// 40. (y3m) the copy road by the method, `hh.seth(@x)`
func:lent_copy_method = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS->:sp = @v;
    HP:hh = HP{ ptr: sp, n: 0i64 };
    drop hh.seth(@x);
    pass (<-sp);
};

// 41. (y3pp) the copy road two levels down, `setph(@hh, @x)`
func:lent_copy_two_level = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS->:sp = @v;
    HP:hh = HP{ ptr: sp, n: 0i64 };
    drop setph(@hh, @x);
    pass (<-sp);
};

// 42. (z9) a BUILTIN METHOD storing its argument into the pointee: an atomic's `store`, `sp.a.store(@x)`, over an
//     `atomic<int64->>` field -- D-249's "a builtin stores nothing through an argument" does not hold for it
func:lent_builtin_method = PA(int64->:ext) never fails {
    int64:x = 41i64;
    PA:v = PA{ a: ext, k: 2i64 };
    PA->:sp = @v;
    sp.a.store(@x);
    pass (<-sp);
};

// 43. (z10) a BARE BUILTIN storing through a pointer argument: `mcpy` of a struct holding `@x` over the target
func:lent_bare_builtin = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS:w = PS{ p: @x, k: 1i64 };
    PS->:sp = @v;
    discard(mcpy(sp =>! wild any->, (@w) =>! wild any->, 16i64));
    pass (<-sp);
};

// --- THE CALLS THE LANGUAGE MAKES WITH NO CALL NODE, in a function that therefore LENDS (NITPICK-BORROW-001 at the read) ---
struct:IT = { int64->:p; int64:k; };
impl:IT:Iterator = {
    assoc:Item = int64;
    func:next = int64?(IT->:self) never fails {
        self.p = @(self.k);
        if (self.k >= 3i64) { pass NIL; }
        self.k = self.k + 1i64;
        pass self.k;
    };
};
struct:PT = { PS->:dst; int64->:src; };
impl:PT:ToString = {
    func:to_string = string(PT:self) never fails {
        self.dst.p = self.src;
        pass "t";
    };
};
// 44. (f1n) a `for` over an `Iterator` BY VALUE calls `next(@it)`, and this `next` stores `@(self.k)` into `self.p`: the
//     iterator's copy handed back through `sp = @it` carries the dead frame's address
func:lent_for_named = IT(int64->:ext) never fails {
    IT:it = IT{ p: ext, k: 0i64 };
    IT->:sp = @it;
    int64:s = 0i64;
    for (int64:v in it) { s = s + v; }
    pass (<-sp);
};
// 45. (f1i) the same, the read inline
func:lent_for_inline = IT(int64->:ext) never fails {
    IT:it = IT{ p: ext, k: 0i64 };
    int64:s = 0i64;
    for (int64:v in it) { s = s + v; }
    pass (<-(@it));
};
// 46. (t1n) a template `&{ h }` calls `to_string(h)`, `h` BY VALUE, and this `to_string` stores `self.src` into
//     `self.dst.p` (DEF-390's by-value holder): the copy of `v` handed back through `sp` carries `@x`
func:lent_tmpl_named = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS->:sp = @v;
    PT:h = PT{ dst: sp, src: @x };
    string:t = `&{ h }`;
    if (t.len == 0i64) { pass PS{ p: ext, k: 0i64 }; }
    pass (<-sp);
};
// 47. (t1i) the same, the read inline
func:lent_tmpl_inline = PS(int64->:ext) never fails {
    int64:x = 41i64;
    PS:v = PS{ p: ext, k: 2i64 };
    PS->:sp = @v;
    PT:h = PT{ dst: sp, src: @x };
    string:t = `&{ h }`;
    if (t.len == 0i64) { pass PS{ p: ext, k: 0i64 }; }
    pass (<-(@v));
};

async func:main = int32(cstring[]:_~argv) {
    int64:e = 5i64;
    discard(raw marked_target(@e));
    discard(raw marked_target_member(@e));
    discard(raw repointed_rootless(@e));
    discard(raw rootless_inline(@e));
    discard(raw repointed_by_call(@e));
    discard(raw repointed_by_callee(@e));
    discard(raw repointed_by_claim(@e));
    discard(raw repointed_back_edge(@e));
    discard(raw repointed_in_defer(@e));
    discard(raw target_back_edge(@e));
    discard(raw target_later(@e));
    discard(raw stored_by_callee(@e));
    discard(raw stored_by_claim(@e));
    discard(raw param_stored_by_name(PS{ p: @e, k: 2i64 }));
    discard(raw param_stored_by_callee(PS{ p: @e, k: 2i64 }));
    discard(raw param_stored_by_claim(PS{ p: @e, k: 2i64 }));
    discard(raw alias_store(@e));
    discard(raw alias_store_whole(@e));
    discard(raw alias_store_field(@e));
    await holds_recv() ?| NIL;
    await holds_arg() ?| NIL;
    await redef_recv() ?| NIL;
    await redef_arg() ?| NIL;
    await addr_taken_recv() ?| NIL;
    await addr_taken_arg() ?| NIL;
    await copy_recv() ?| NIL;
    await copy_arg() ?| NIL;
    discard(result_literal_view() ?| 0i64);
    discard(pass_view() ?| 0i64);
    discard(raw lent_field_callee(@e));
    discard(raw lent_field_method(@e));
    discard(raw lent_auto_deref(@e));
    discard(raw lent_call_result(@e));
    discard(raw lent_array_elem(@e));
    discard(raw lent_inline_deref(@e));
    discard(raw lent_byval_holder(@e));
    discard(raw lent_two_level(@e));
    discard(raw lent_method_two_level(@e));
    discard(raw lent_copy_road(@e));
    discard(raw lent_copy_method(@e));
    discard(raw lent_copy_two_level(@e));
    discard(raw lent_builtin_method(@e));
    discard(raw lent_bare_builtin(@e));
    discard(raw lent_for_named(@e));
    discard(raw lent_for_inline(@e));
    discard(raw lent_tmpl_named(@e));
    discard(raw lent_tmpl_inline(@e));
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (DeadlineExceeded)  { exit 112i32; },
        (StaleHandle)       { exit 113i32; },
        (E1)                { exit 114i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
