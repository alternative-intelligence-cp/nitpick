// expect-error: NITPICK-BORROW-002
// expect-error-at: 7704:9
mod:list_ptr_binding_address;
// A BINDING'S VALUE IS ITS SOURCE'S THROUGH THE BINDING'S ADDRESS TOO (DEF-602 with DEF-603, landing 177d2b3). A `for` binding and a `pick` binding carry what their
// source reaches (DEF-517, DEF-595). A pointer to the binding read through (`HP->:k = @m; … k.lp`, `(<-k).lp`, `<-pp`) gave the binding's own chain, which holds
// nothing, and a write through a pointer rooted at a `pick` binding, or reached through the address of either binding, was a write to no one. So
// `int64->:e = raw fp(k.lp); discard(raw growh(k.lp));` read freed heap, in a `for` body on main and in a consuming `pick`'s arm since DEF-592 (main refused that one
// only where the holder outlives the arm, and by another rule). Now the hop through a binding's address reads the source, as the binding's name does; a `pick`
// binding's refs take the binding's type as their read, as a `for` binding's do; and a pointer rooted at either binding, or reached through one's address, is resolved by
// its value's refs. Each module is one cell.
// `zh1` to `zh3`: the address of a `for` binding: a by-value struct read by `k.lp` (`zh1`), a pointer binding read by `<-pp` (`zh2`), the struct by `(<-k).lp` (`zh3`).
// `zh6`: the address of a consuming `pick`'s binding. `k` takes and grows through the address, `m` takes through it and grows through the binding, `n` the reverse,
// `d` (of `zh6`) does both through the binding. `zq2k`: the selector a local built from a pointer parameter. `zq3k`: the holder declared inside the arm.
// THE ROUTES, `j<form><place>_<take>_<growth>`: the form is `p` a consuming `pick`'s binding (`HO` by value), `v` a `for` value binding (`HP`), `r` a `for` pointer
// binding (`H->`); the place is `i` the holder inside the binding's block (read there after the growth), `o` outside it (read after the block).
// The takes of `p` and `v`: `t0` `fp(m.lp)`; `t1` `k = @m; fp(k.lp)`; `t2` `fp((<-k).lp)`; `t3` `H->->:kp = @m.lp; fp(<-kp)`; `t4` a copy of the pointer;
// `t5` a pointer to the pointer (`(<-kk).lp`); `t6` the address handed through a call (`k = raw idho(@m)`); `t7` the address in a struct (`w.p.lp`); `t8` a local copy
// of the member (`c = k.lp; fp(c)`); `ta` a method on the member (`k.lp.first()`). Of `r`: `t0` `fp(m)`; `t1` `pp = @m; fp(<-pp)`; `t2` `c = <-pp; fp(c)`; `t3` a copy
// of the pointer; `t5` `(<-pp).first()`.
// The growths of `p` and `v`: `g1` `growh(k.lp)`; `g2` `growh(m.lp)`; `g4` `list_push(@k.lp.l, …)`; `g5` `k.lp.l = raw mk();`; `g6` `m.lp.l = raw mk();`;
// `g7` `(<-(k.lp)).l = raw mk();`; `g8` `c2 = k.lp; growh(c2)`. Of `r`: `g1` `growh(<-pp)`; `g2` `growh(m)`; `g4` `(<-pp).l = raw mk();`; `g5` `m.l = raw mk();`;
// `g6` `list_push(@(<-pp).l, …)`; `g7` `c2 = <-pp; growh(c2)`. Left out: the growth by a callee handed the address (`g3`, DEF-610, open) and the take through one
// (`t9`, and `t4` of `r`: DEF-593's, open).
// `zm5` to `zm9`: each `k` cell is accepted by one mutant of this row's text and faults there, or is a route two holders down.
// `zm5ak`, `zm5bk`, `zm5dk`: a pointer payload read WHOLE out of a selector that is a call's result carrying a pointer parameter (`pick (raw mkeph(q))`, `(EPH.A(m))`):
// the growth through `m`, the take through `m`, and both. Without the `pick` binding's read the parameter's ref is no target of an `H->`.
// `zm6ak`, `zm6bk`, `zm6ck`: a value read out of a parameter and pushed BEFORE a `pick` binding in one literal keeps its own read (`TW{ hp: q.lp, gp: m }`): a plain
// `pick`, a consuming one, and the selector a call's result (the one that tells: a by-value selector's own ref is a coarse target either way).
// `zm7dk`, `zm7ek`, `zm7vk`: the same literal, the second member read through a binding's ADDRESS: `<-pp` over a `for` pointer binding (the one that tells: the
// dereference hands the hop its read), over a consuming `pick`'s, and `k.gp` over a `for` struct binding.
// `zm8`, `zm9`: the binding's address two holders down (`KHP:w = KHP{ p: @m }; KHP->:wp = @w; … wp.p.lp`), as the growth (`zm8vk`, `zm8pk`), as the take (`zm9vk`,
// `zm9pk`) and as both (`zm8wk`).
// FIFTEEN RIGHT PROGRAMS ARE REFUSED HERE, THE ROW'S NAMED PRICES: each stores, in a holder declared OUTSIDE the binding's block, a call's result taken through the
// binding's address, and is BORROW-002 at the take. The pointer points into the `List` behind the binding's pointer member, which outlives the block; the report comes
// from the selector's (or the iterable's) by-value parameter, whose carried value the result holds, where the call's argument is judged a borrow of this frame:
// always for a consuming `pick`'s binding, and for a `for` binding where the dereference's reader answers yes without looking (a function that lends, a pointer to the
// pointer, the address in a struct or through a call).
// `zh6c_…_price`, `zh6r_…_price`, `jpo_t1/t4/t5/t6/t7/t8/ta_c_price` (a consuming `pick`), `zq4r` (a `for` binding in a function that lends), `jvo_t5/t6/t7_c_price`
// (a `for` binding): refused on main with this report, released by DEF-592, refused again here.
// `jpo_t2_c_price609`, `jpo_t3_c_price609` (DEF-609, open): the spellings `(<-k).lp` and `@m.lp` then `<-kp`, which main's reader didn't follow: main accepted these
// two and their fault twins (`jpo_t2_g1`, `jpo_t3_g1` here). Their `for` twins (`jvo_t2_c_ok`, `jvo_t3_c_ok`) are accepted.
mod:jpi_t0_g1 = {
error:E5_jpi_t0_g1;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:fpl = int64->(List<int64>->:q) never fails { pass @((<-q)[0i64]); };
func:fa = int64->(S->:q) never fails { pass @((<-q).a); };
func:idp = int64->(int64->:q) never fails { pass q; };
func:idh = H->(H->:q) never fails { pass q; };
func:fp2 = int64->(int64:v, H->:q) never fails { pass @((<-q).l[0i64]); };
func:fp2b = int64->(H->:q, int64:v) never fails { pass @((<-q).l[0i64]); };
func:rd2 = int64(int64->:e, int64:z) never fails { pass <-e; };
impl:H = { func:first = int64->(H->:self) never fails { pass @((<-self).l[0i64]); }; };
impl:K = { func:sel = int64->(K:self, H->:q) never fails { pass @((<-q).l[0i64]); }; };
struct:HO = { H->:lp; List<int64>:own; };
enum:EO = { A(HO); Z; };
struct:KH = { HO->:p; int64:z; };
struct:KP = { HP->:p; int64:z; };
func:idho = HO->(HO->:q) never fails { pass q; };
func:idhp = HP->(HP->:q) never fails { pass q; };
func:fpk = int64->(HO->:q) never fails { pass @((<-(q.lp)).l[0i64]); };
func:fpkp = int64->(HP->:q) never fails { pass @((<-(q.lp)).l[0i64]); };
func:fpp = int64->(H->->:q) never fails { pass @((<-(<-q)).l[0i64]); };
func:growk = int64(HO->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.lp.l, 1i64); } pass 7i64; };
func:growkp = int64(HP->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.lp.l, 1i64); } pass 7i64; };
func:growpp = int64(H->->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@(<-w).l, 1i64); } pass 7i64; };
func:growl = int64(List<int64>->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(w, 1i64); } pass 7i64; };
func:g = int64(move EO:q, H->:hz, H->:hy, int64:n) never fails {
    int64:v = 0i64;
    pick (move(q)) {
        (EO.A(m)) {
        HO->:k = @m; int64->:e2 = raw fp(m.lp);
        discard(raw growh(k.lp));
        v = <-e2;
        },
        (EO.Z) { }
    }
    pass v + 6i64;
};
func:f = int64(int64:n) never fails {
    H:hy = raw mkh();
    H:hz = raw mkh();
    H:h0 = raw mkh();
    H:h1 = raw mkh();
    EO:q0 = EO.A(HO{ lp: @h0, own: raw mk() });
    pass raw g(move(q0), @hz, @hy, n);
};
};
mod:jpi_t0_g2 = {
error:E5_jpi_t0_g2;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
