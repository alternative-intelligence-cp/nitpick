mod:when_clauses_grant_nothing;
// `when`'s `then` AND `end` CONTRIBUTE NOTHING TO `must` (DECISIONS.md:9069). Exactly one of them runs (D-027), so each program here is
// right, and each is refused by that decision, as it was before the pending-exit walk: a binding both assign (`q1`), a `Result` both test
// (`wn1`, `wn2`), a moved string both re-assign (`wn3`). A walk with no cap at the `when`'s end grants all four.
// Each of the cap's other facts has its site: a pointer the body frees and both clauses refill (`wc1`), a page both seal (`wc2`), a page
// the body seals and both re-allocate (`wc3`).
// `then`'s `break` IS AN EXIT, AND `end`'s `pass` DOESN'T TAKE IT AWAY: `wt2`, a `while (true)` left only through its `when`'s `then`, falls off the function's end, FLOW-001. The vacant zero was read here,
// 60, before this landing. `wt2k`, with a `pass` after the loop, is beside this file.
mod:q1_then_end_both_assign = {
error:E5_q1_then_end_both_assign;
struct:H = { string:s; int64:k; };
func:mkh = H() never fails { pass H{ s: string_concat("ab", "cde"), k: 7i64 }; };
func:eath = int64(move H:v) never fails { pass 0i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_q1_then_end_both_assign; };
func:f = int64(int64:n) never fails {
    int64:out = 0i64;
    int64:y;
    int64:j = 0i64;
    when (j < 1i64) decreases 1i64 - j { j = j + 1i64; } then { y = 7i64; } end { y = 7i64; }
    out = y;
    pass out;
};
};
