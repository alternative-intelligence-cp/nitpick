func:wrg2 = NIL(H2->:p, any->:q) never fails { (<-(q =>! H2->)).o = string_concat("z", "w"); p.k = 5i64; pass NIL; };
func:rdg2 = int32(H2->:p, any->:q) never fails { fixed uint8[]:vw = string_bytes(p.o); int64:k = (<-(q =>! H2->)).k; string:junk = string_concat("qq", "qq"); if (k != 1i64) { pass 1i32; } pass (vw[0i64] => int32); };
