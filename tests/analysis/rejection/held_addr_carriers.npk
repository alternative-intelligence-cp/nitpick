func:vwga = int32(H2->:p, any->:q) never fails { fixed uint8[]:vw = string_bytes(p.o); (<-(q =>! H2->)).o = string_concat("z", "w"); string:junk = string_concat("qq", "qq"); pass (vw[0i64] => int32); };
