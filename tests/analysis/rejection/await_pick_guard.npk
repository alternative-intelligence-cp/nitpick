// expect-error: NITPICK-SUSPEND-003
// expect-no-parse-error
//
// The one pick position an `await` cannot take: a `where` guard. The
// compare chain re-reads the selector value after a failed guard to test
// the next arm, and nothing there survives a suspension. Arm BODIES
// suspend freely — their bindings are frame-resident. UNTIL 1.1-close this
// was a backend rung naming its own cycle; the refusal now lives in the
// suspend analysis (SUSPEND-003, D-191), which is why this file moved from
// the backend rejection suite to this one — suites are named by the stage
// that refuses. (`await_shapes.npk` pins the plain-selector shape; this
// one keeps the payload-binding guard chain.)

mod:await_pick_guard;
enum:Ev = { Nudge(int32); Stop; };

async func:one = int32() {
    pass 1i32;
};

async func:g = int32(int32:v) {
    Ev:e = Ev.Nudge(v);
    int32:r = 0i32;
    pick (e) {
        (Ev.Nudge(d)) where (d > (await one() ?| 0i32)) { r = d; },
        (*) { r = 0i32; }
    }
    pass r;
};

async func:main = int32(cstring[]:_~argv) {
    int32:a = await g(5i32) ?| 0i32;
    exit a;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
