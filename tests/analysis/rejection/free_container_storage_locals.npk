mod:free_container_storage_locals;
// 2026-11-15 (landing 177d2b7, row 1: DEF-660's K-a2 as V1 with F6, W3c and W3d). A HAND FREE OF A HEADER'S BUFFER THAT A LOCAL OR A PARAMETER STILL
// DROPS IS REFUSED, BELOW IT TOO. `header_wild_backed` answers no for a place under a statement local of a `wild` array, struct or `List`, or under a
// by-value parameter of the function walked, reached by index or field with no pointer and no slice on the way, its root read through casts and a lending
// `pick`'s view: the local or the parameter drops the header at its end, so a free by hand before it is a double free (`mk_wsa`, `a[0i64]` of a `wild
// string[2]` local, 74 on main). A `List`, a string or a buffer on the way is its owner's storage, as an array is; a slice alone keeps the `wild` answer.
// Each `g` returns, so its locals drop; `//F` marks each cell's free.
// THE FAMILY (each a wrong program main runs 74, refused at the free with BORROW-011): `wa_` an element of a `wild` local array of strings (as),
// cstrings (ac) or buffers (ab), or of a two-deep array (a2), freed by `dalloc` (d), a `ralloc` (r), a `wild` copy (c), a freeing callee (k), a
// ternary's arm (t) or `wildx_free` (x); `wb_` a `wild string` field of a struct local, plain (wf) or `wild` (wv), the same re-stored after the
// free (ra, rf, rc, a cast of the local on the way in rc), under `nodrop` (na, nf) or read off a cast of the local (cm); `wv_` a lending `pick`'s view
// of an enum local's payload (pv plain, pw `wild`; `_k` freed by a callee, BORROW-015 on main too); `hl_lm` a `wild string` local; a `List` on the way:
// `hl_lw` a `List<SS>` local's element's `wild string` field, `hi_lh` the same under a `List` field of a `wild` struct local, `hi_wl` under a `wild List`
// local, `hi_hd` a `hidden wild string` field freed inside its module, `hi_lai` an element of a `List` element's `wild string[2]` field;
// a by-value parameter: a `wild string` (`hl_vp`; `move`, `hp_mv`; `fixed`,
// `hp_fx`; reassigned before the free, `hp_re`; of a generic function, `hp_gf`), a `wild SS` (`hl_vs`), a generic struct (`hp_g`), a struct holding a
// `wild SS[1]` (`hp_sa`), a `wild string[2]` (`hp_ar`), a lending `pick`'s view of an enum parameter (`hp_vv`) and a method's `move` self (`hp_sf`).
// Their twins and the right guards beside them run in `free_container_storage_locals_ok.npk`.
// THE MUTANTS' KILLS (the row's own conditions, each a wrong program main runs 74 or 97 under the detector): `mk_cs_cal` a cstring's `.ptr` handed back
// by a callee; `mk_gn_ral` and `mk_gn_wxf` a generic callee's `ralloc` and `wildx_free` of a `List` element; `mk_l_fld` a field of a `List` element;
// `mk_sref` (its one site is the kill: the mutant reports two); `hl_ps` and `hl_pd`, a `wild` pointer LOCAL's `.ptr` (`p.ptr`, `(<-p).ptr`) over a
// string local, R1W's local answer.
// STILL OPEN, DEF-660's remainder (rulings l.11959 item 5): a `for` binding over a local or by-value array, whose source is not read (`hl_fe2`, `hp_fe`);
// the `=>!` road, a place read through an address crossed to `wild` (`((@h) =>! wild SS->).s`; a by-value parameter's pointer field set so at the
// caller's local, `hp_pt`), which carries no provenance to the free; a `wild` module binding's literal bytes freed by hand (`hp_md2`, `hp_md3`), a module
// binding keeping the `wild` answer.
error:E5;
// mk_cs_cal
func:sp_mk_cs_cal = wild any->(cstring->:s) never fails { pass ((<-s).ptr) =>! wild any->; };
func:g_mk_cs_cal = int64(int64:n) {
    string:t = "wxyzwxyz".clone() ?! E5;
    cstring:s = to_cstring(t) ?! E5;
    dalloc(raw sp_mk_cs_cal(@s)); //F
    pass ((s.ptr[0i64]) => int64) - 112i64;
};
func:cell_main_mk_cs_cal = int32() never fails { pass (((g_mk_cs_cal(1i64) ?! E5) + 60i64) =>! int32); };
// mk_gn_ral
func:mk_mk_gn_ral = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(2i64); drop list_push(@l, 1i64); drop list_push(@l, 2i64); pass l; };
func:frg_mk_gn_ral<T> = int64(wild T->:p) never fails { wild int8->:q = ralloc(p =>! wild any->, 4096i64); dalloc(q); pass 0i64; };
func:g_mk_gn_ral = int64(int64:n) never fails {
    List<int64>:l = raw mk_mk_gn_ral();
    discard(raw frg_mk_gn_ral::<int64>((@l[0i64]) =>! wild int64->)); //F
    pass (l[0i64]) + 6i64;
};
func:cell_main_mk_gn_ral = int32() never fails { pass (((raw g_mk_gn_ral(1i64)) + 60i64) =>! int32); };
// mk_gn_wxf
func:mk_mk_gn_wxf = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(2i64); drop list_push(@l, 1i64); drop list_push(@l, 2i64); pass l; };
func:frg_mk_gn_wxf<T> = int64(wild T->:p) never fails { wildx_free(p =>! wildx any->); pass 0i64; };
func:g_mk_gn_wxf = int64(int64:n) never fails {
    List<int64>:l = raw mk_mk_gn_wxf();
    discard(raw frg_mk_gn_wxf::<int64>((@l[0i64]) =>! wild int64->)); //F
    pass (l[0i64]) + 6i64;
};
func:cell_main_mk_gn_wxf = int32() never fails { pass (((raw g_mk_gn_wxf(1i64)) + 60i64) =>! int32); };
// mk_l_fld
struct:P_mk_l_fld = { int64:a; int64:b; };
func:g_mk_l_fld = int64(int64:n) never fails {
    List<P_mk_l_fld>:l = raw list_init::<P_mk_l_fld>(2i64);
    drop list_push(@l, P_mk_l_fld{ a: 1i64, b: 7i64 });
    wild any->:w = (@(l[0i64].b)) =>! wild any->;
    dalloc(w); //F
    pass l[0i64].b;
};
func:cell_main_mk_l_fld = int32() never fails { pass (((raw g_mk_l_fld(1i64)) + 60i64) =>! int32); };
// mk_sref
func:fr_mk_sref = int64(wild uint8->:p, bool:c) never fails {
    uint8[8]:b = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8]; uint8[]:v = b[0i64...8i64];
    dalloc(is (c) : (p =>! wild any->) : (v.ptr =>! wild any->)); //F
    pass 0i64;
};
func:g_mk_sref = int64(int64:n) never fails {
    List<uint8>:l = raw list_init::<uint8>(2i64);
    drop list_push(@l, 7u8);
    discard(raw fr_mk_sref((@l[0i64]) =>! wild uint8->, n == 1i64)); //F
    pass (l[0i64] => int64);
};
func:cell_main_mk_sref = int32() never fails { pass (((raw g_mk_sref(1i64)) + 60i64) =>! int32); };
