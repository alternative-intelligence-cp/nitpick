mod:store_through_pointer_value;
// Landing 177d2b6, row 4 (V+D with form (h): seat K's text re-cut onto row 3's 7ebd69c): a callee's store through a pointer VALUE. A pointer handed to a
// storing callee carries the callee's store to what it points at, one level below the place the argument names (V), and the argument is walked as written,
// its casts peeled and a leading dereference kept (D). This file holds what V+D refuses alone; what form (h)'s walks beside it refuse is in
// store_through_pointer_value_walks.npk (one file past 256 reports would lose its last cells' sites: NITPICK-DIAG-001). One site per face closed
// here, each a fault on main (8a2b40b) and on row 3's text (7ebd69c):
//   DEF-644's callee faces (`c1c2b`, `c1c2d`, `c2bb`, `c_L_setlp`, `s_2b`, `s_L_cl`, `lb4`, `lb36`, `lb37`) and DEF-643's (`c2t1`, `c2t1p`, `lt_ter`);
//   DEF-335's six destination forms (`d3a` to `d3j`: a slice stored through the pointer a field, a dereference, a call, a ternary, `?!` or `relay` gives);
//   a store through a function value (`fva`, `fvb`, `fvm`, `fvt`); the argument as written (`vd1`, `vd2` by D, `vd3` by V);
//   the `c_arg` family (`c_arg`, `c_arg1`, `c_argb`, `c_argn`) and `c_arg3`, closed by V's walk on row 3's cast step (F1);
//   grid A's callee (`ca`) and method (`ma`) stores, one of each per source V newly refuses (`arr`, `arrv`, `fld`, `nest`, and the local twins of
//   `call`, `lsl` and `sll`);
//   row 4's attack's closures: `a_all3`, `a_dr`, `a_dr2`, `a_dr2c`, `a_dr2co`, `a_drcb`, `a_drci`, `a_drco`, `a_h2`, `a_h2c`, `a_h2cc`, `a_h2l`, `a_h2lc`,
//   `a_mid2`, `a_midb`, `a_pcb`, `a_rootb`, `a_rootc`, `b_enumm`, `a_pch`; `c_coal`, `c_gen`, `c_gen2`, `c_lst`, `c_meth2`, `c_methq`, `c_sarr`, `c_ter2`,
//   `c_unw`; the faults of DEF-669's prices (`c_slp`, `c_slpq`, `c_slst`, `c_sqp`, `c_sqs`, `c_slv2`) and `c_slv`; `c_pa`, `c_sqa`, `c_lpp`, `c_idp`,
//   `c_idpc`, `c_idp2`, `m_dd`, `m_sll`, `gvr`, `c_crf`, `c_pkv`, `a_pcct`; a pointee-changing cast in the holder's initializer (`a_pcnio`, `a_pcnit`);
//   the seat's `b1_pd`;
//   `rrti_held`'s, by a holder's address, root A (`u_geth`, `u_gethr`, `u_wsg`, `u_ga2`, `u_gac`, `u_gm`), and by a parameter's read type, root B
//   (`u_rd`, `u_rda`, `u_rdp`, `u_rd2`, `u_rdl`, `u_rdme`, `u_rdpp`), which a form that skips the top walk (root A) or drops `rrti_held`'s reading
//   (root B) gives back (rulings Addenda 24 and 25); and `u_wsm`, `u_rdd`, `u_rdppd`, `u_gpp`, `u_gsl`, `c_rety`, `h_fori`, `f_al`, `f_b`;
//   the sensitivity faults `pz_1f` and `waf` of row 4's (h) attack;
//   the mutants' killing faces: `sv_addr` (a pointer read out of a holder through a pointer, two hops above the store), `sv_pick` (the same in
//   a consuming `pick`'s arm, refused by DEF-633's pick sentence) and `sv_dkeep` (a kept dereference, `<-d`, as the argument: D).
// Each cell's declarations carry its name as a suffix, and its `main` is `cell_main_<name>`. DEF-335's six are put in this frame: their `main` is `f`,
// passing 7 where it exited 0, and `E1` is `E5`. The controls that run are in tests/backend/programs/store_through_pointer_value_ok.npk.
// PRICES: the cells marked PRICE below are right programs this row's text refuses, each failing closed; each comment names its by-name twin. At parity
// (V's, the twin refused on every build) or not at parity (DEF-669's, the twin running in the _ok file).
error:E5;
struct:K_c1c2b = { int64:k; };
struct:H_c1c2b = { List<int64>:l; int64:k; K_c1c2b:kk; };
func:mk_c1c2b = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh_c1c2b = H_c1c2b() never fails { pass H_c1c2b{ l: raw mk_c1c2b(), k: 2i64, kk: K_c1c2b{ k: 3i64 } }; };
func:growh_c1c2b = int64(H_c1c2b->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl_c1c2b = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp_c1c2b = int64->(H_c1c2b->:q) never fails { pass @((<-q).l[0i64]); };
func:idh_c1c2b = H_c1c2b->(H_c1c2b->:q) never fails { pass q; };
func:getl_c1c2b = List<int64>->(H_c1c2b->:w) never fails { pass @w.l; };
struct:HPO_c1c2b = { H_c1c2b->:lp; List<int64>:own; };
struct:GP_c1c2b<T> = { T:lp; List<int64>:own; };
func:setlp_c1c2b = NIL(HPO_c1c2b->:d, H_c1c2b->:q) never fails { (<-d).lp = q; pass NIL; };
func:set2_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q) never fails { (<-(<-d)).lp = q; pass NIL; };
func:set2b_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q) never fails { drop setlp_c1c2b(<-d, q); pass NIL; };
func:set2c_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q) never fails { HPO_c1c2b->:t = <-d; (<-t).lp = q; pass NIL; };
func:set2d_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q) never fails { drop (<-d).setme(q); pass NIL; };
func:set2e_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q) never fails { { defer { (<-(<-d)).lp = q; } } pass NIL; };
func:set2f_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q, int64:n) never fails { if (n > 0i64) { (<-(<-d)).lp = q; } pass NIL; };
func:set2l_c1c2b = NIL(HPO_c1c2b->->:d, H_c1c2b->:q) never fails { loop(0i64, 1i64, 1i64) { (<-(<-d)).lp = q; } pass NIL; };
func:setvia2_c1c2b = NIL(HPO_c1c2b->:d, H_c1c2b->:q) never fails { HPO_c1c2b->->:pp = @d; (<-(<-pp)).lp = q; pass NIL; };
func:setg_c1c2b<T> = NIL(T->->:d, move T:v) never fails { <-(<-d) = move(v); pass NIL; };
func:sets2_c1c2b = NIL(HPO_c1c2b->->[]:s, H_c1c2b->:q) never fails { (<-(<-(s[0i64]))).lp = q; pass NIL; };
impl:HPO_c1c2b = { func:setme = NIL(HPO_c1c2b->:self, H_c1c2b->:q) never fails { (<-self).lp = q; pass NIL; }; func:setvia = NIL(HPO_c1c2b->:self, H_c1c2b->:q) never fails { HPO_c1c2b->->:pp = @self; (<-(<-pp)).lp = q; pass NIL; }; };
trait:S2_c1c2b = { func:s2 = NIL(Self->:self, H_c1c2b->:q) never fails; };
impl:HPO_c1c2b:S2_c1c2b = { func:s2 = NIL(HPO_c1c2b->:self, H_c1c2b->:q) never fails { HPO_c1c2b->->:pp = @self; (<-(<-pp)).lp = q; pass NIL; }; };
func:g_c1c2b = int64(H_c1c2b->:h0p, H_c1c2b->:hq, H_c1c2b->:hz, int64:n) never fails {
    int64->:e = raw fp_c1c2b(hz);
    HPO_c1c2b:m = HPO_c1c2b{ lp: h0p, own: raw mk_c1c2b() }; HPO_c1c2b->:mp = @m; HPO_c1c2b->->:mpp = @mp;
    drop set2b_c1c2b(@mp, hq);
    e = raw fp_c1c2b(m.lp);
    discard(raw growh_c1c2b(hq));
    pass (<-e) + 6i64;
};
func:f_c1c2b = int64(int64:n) never fails {
    H_c1c2b:hz = raw mkh_c1c2b(); H_c1c2b:h0 = raw mkh_c1c2b(); H_c1c2b:h2 = raw mkh_c1c2b();
    pass raw g_c1c2b(@h0, @h2, @hz, n);
};
func:cell_main_c1c2b = int32() never fails { pass (((raw f_c1c2b(1i64)) + 60i64) =>! int32); };
struct:K_c1c2d = { int64:k; };
struct:H_c1c2d = { List<int64>:l; int64:k; K_c1c2d:kk; };
func:mk_c1c2d = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh_c1c2d = H_c1c2d() never fails { pass H_c1c2d{ l: raw mk_c1c2d(), k: 2i64, kk: K_c1c2d{ k: 3i64 } }; };
func:growh_c1c2d = int64(H_c1c2d->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl_c1c2d = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
