func:inner_of = H->(H2->:p) never fails { pass @((<-p).inner); };
struct:OP = { H->?:o; int64:z; };
func:g = int64(Result<Result<H->?>?>:r, int64:n) never fails {
    int64->:e = raw fp(((((r ?! E5_zd4a_nest) ??! E5_zd4a_nest) ?! E5_zd4a_nest) ??! E5_zd4a_nest));
    discard(raw growh(((((r ?! E5_zd4a_nest) ??! E5_zd4a_nest) ?! E5_zd4a_nest) ??! E5_zd4a_nest)));
    pass (<-e) + 6i64;
};
func:f = int64(int64:n) never fails {
    H:h0 = raw mkh();
    H->?:v1 = @h0;
    Result<H->?>:v2 = Result{ value: v1 };
    Result<H->?>?:v3 = v2;
    Result<Result<H->?>?>:v4 = Result{ value: v3 };
    pass raw g(v4, n);
};
};
