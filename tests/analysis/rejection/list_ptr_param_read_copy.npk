// expect-error-at: 4459:23
mod:list_ptr_param_read_copy;
// A VALUE READ OUT OF A PARAMETER IS ASKED BY WHAT IT WAS READ AS, BESIDE THE PARAMETER'S OWN TYPE (DEF-590, landing 177d2b3). `H->:k = hp.lp;`, `= pa[1i64];`,
// `= <-pp;`, `= w.hp;` put the parameter's value on `k`'s chain, and the write side asked it by the parameter's own type (`HP->`, `H->[2]`, a by-value `W`): no target
// of an `H->`. So `growh(k)` wrote to no one under `int64->:e = raw fp(…);` and `e` read freed heap, where the same growth through the parameter was refused. Each
// module is one cell.
// `zk`: the local copy, taken and grown through (`cc`), through the copy and the parameter (`cp`, `pc`) and through the parameter both times (`pp`, the yardstick).
// `zr`: the growth through a call's result over the value (`raw idh(hp.lp)`, the rootless reader in escape.npk). `zt`: a pointer member reached through a local copy
// of a pointer that came out of a parameter (`HP->:k = q; growh(k.lp)`): the pointee is the parameter's and has no chain in this frame. `xq1`, `xq13`, `zf11ti`,
// `zl3ii`, `zy6`: the same reader met in other rows' cells.
// THE `any->` LINK IS ASKED BY THE PLACE'S TYPE OR BY THE READ TYPE: `za1k`, `za3k` (read as `any->` and cast back), `za5k`, `za6k` (the same through a call's
// result), `za9k`, `za10k` (the place an `any->` parameter, the read an `H->` carried on as an `H2->`).
// THE PLACE'S OWN ASK STAYS BESIDE THE READ'S: `zb4k`, `zb5k` (a value read out and carried on as another pointer type through `any->`: a target by the parameter's
// type and by nothing the read says).
// A BY-VALUE AGGREGATE READ OUT OF A PARAMETER AND HANDED TO A GETTER: `zc1r`, `zc4r` (`growh(raw pick1(q.arr))`, `growh(raw pick1(<-pp))`), their local twins
// `zc1k`, `zc4k`, and `yw7a`, `yw7e` (`growh(raw q.get())`, a by-value receiver reached through a pointer parameter).
// FOUR RIGHT PROGRAMS ARE REFUSED HERE, THE ROW'S NAMED PRICES: `zk9n` (two by-value parameters carried in one local: a local's chain is whole, so the growth through
// one member's pointer meets the view through the other's), `zk10n` (the same with the second nested two deep, where the type walk's fuel ends and answers YES),
// `zc6n` and `zc7n` (a view of one element of an array of pointers, the growth through a getter handed the whole array, which hands back the other element: the
// getter's result is asked as the array is, and the direct spellings `zc6d`, `zc7d` are refused the same way). `zk9d` and `zk10d` run right in
// `list_ptr_param_read_copy_ok.npk`.
mod:xq13_member_grow_through_copy = {
error:E5_xq13_member_grow_through_copy;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:fpl = int64->(List<int64>->:q) never fails { pass @((<-q)[0i64]); };
func:fa = int64->(S->:q) never fails { pass @((<-q).a); };
func:idp = int64->(int64->:q) never fails { pass q; };
func:idh = H->(H->:q) never fails { pass q; };
func:fp2 = int64->(int64:v, H->:q) never fails { pass @((<-q).l[0i64]); };
func:fp2b = int64->(H->:q, int64:v) never fails { pass @((<-q).l[0i64]); };
func:rd2 = int64(int64->:e, int64:z) never fails { pass <-e; };
impl:H = { func:first = int64->(H->:self) never fails { pass @((<-self).l[0i64]); }; };
impl:K = { func:sel = int64->(K:self, H->:q) never fails { pass @((<-q).l[0i64]); }; };
func:g = int64(HP->:hp, int64:n) never fails {
    H->:q = hp.lp;
    int64->:e = raw fp(hp.lp);
    discard(raw growh(q));
    pass (<-e) + 6i64;
};
func:f = int64(int64:n) never fails {
    H:h0 = raw mkh();
    HP:h = HP{ lp: @h0, z: 0i64 };
    pass raw g(@h, n);
};
};
