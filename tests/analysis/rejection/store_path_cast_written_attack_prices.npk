mod:store_path_cast_written_attack_prices;
// 2026-11-16 (landing 177d2b8, row 1: DEF-674's rest, P2). THE ROW'S PRICES FROM ITS ATTACKS, cut by class (rulings l.13126 item 4): each a right program
// main runs to 67 that the row refuses, marked PRICE and pinned by its site, followed by its TWIN or naming where its twin is. A result that doesn't fit its
// argument is read as a retype of it, the reading main gives the named call. The faces are in store_path_cast_written_faces.npk, the right controls in
// tests/backend/programs/store_path_cast_written_ok.npk.
// EACH FACE'S `X_c`, the face with its growth dropped, refused at its store through the result (one site). AT PARITY, 46, each followed by its `X_c_nm`, the
// call made to the named callee, which main refuses at the same site: `a_arr_c`, `a_fld_c`, `a_lst_c`, `a_par_c`, `a_ret_c`, `f_gen_c`, `n_2lv_c`, `n_ret_c`,
// `n_st_c`, `r_copy_c`, `r_fldcp_c`, `r_lpush_c`, `r_wret_c`, `p2_blk_c`, `p2_gsi_c`, `l_shad1_c`, `l_shadq_c`, `r_arrl_c`, `r_opt_c`, `r_pp_c`, `r_sw_c`,
// `x_meth_c`, `f_sfld_c`, `g_bx_c`, `g_open_c`, `g_openw_c`, `g_open2_c`, `g_openk_c`, `g_openp_c`, `g_openr_c`, `g_opent_c`, `w_oo_c`, `w_ro_c`, `p2_bes_c`,
// `p2_bnd_c`, `p2_conc_c`, `p2_d1_c`, `p2_d2_c`, `p2_d4_c`, `p2_gwc_c`, `p2_lst_c`, `p2_nest_c`, `p2_self_c`, `g_rl_c`, `g_ro_c`, `g_rv_c`.
// OFF PARITY, 9, one LOW number each class (l.13072), each `X_c_nm` running 67 on main and here (in the `_ok` file): DEF-682, the fit's other direction, a
// result whose pointee holds the argument's pointee inline (`u_arr_c`, `u_dir_c`, `f_pw_c`); DEF-683, the -2 mark refusing a store where DEF-585's named hold
// doesn't, on a pointer no name holds, a relay through a call, a branch arm, a loop or a wrapper (`w_plain_c`, `r_ifarm_c`, `r_loop_c`, `x_idp_c`, `x_put_c`,
// `x_relay_c`).
// LEFT OUT by the cut, each face's `X_ok` (55), the face with its pointer read before the growth: its row-1 site is its `X_c`'s, and its other site is main's
// own price at the growth, as its `X_nm_ok` shows on main (the nine whose `X_c` is off parity carry its off store site too): `a_arr_ok`, `a_fld_ok`,
// `a_lst_ok`, `a_par_ok`, `a_ret_ok`, `f_gen_ok`, `n_2lv_ok`, `n_ret_ok`, `n_st_ok`, `r_copy_ok`, `r_fldcp_ok`, `r_lpush_ok`, `r_wret_ok`, `p2_blk_ok`,
// `p2_gsi_ok`, `u_arr_ok`, `u_dir_ok`, `l_shad1_ok`, `w_plain_ok`, `l_shadq_ok`, `r_arrl_ok`, `r_ifarm_ok`, `r_loop_ok`, `r_opt_ok`, `r_pp_ok`, `r_sw_ok`,
// `x_idp_ok`, `x_meth_ok`, `x_put_ok`, `x_relay_ok`, `f_pw_ok`, `f_sfld_ok`, `g_bx_ok`, `g_open_ok`, `g_openw_ok`, `g_open2_ok`, `g_openk_ok`, `g_openp_ok`,
// `g_openr_ok`, `g_opent_ok`, `w_oo_ok`, `w_ro_ok`, `p2_bes_ok`, `p2_bnd_ok`, `p2_conc_ok`, `p2_d1_ok`, `p2_d2_ok`, `p2_d4_ok`, `p2_gwc_ok`, `p2_lst_ok`,
// `p2_nest_ok`, `p2_self_ok`, `g_rl_ok`, `g_ro_ok`, `g_rv_ok`.
// 177d2b7'S CELLS this row prices, at parity, each with its twin (W2's `t674` and `t674b` cells, or made by the cells' rule where none was): `c_ptl_s_ok`,
// `r_fvl_s_ok`, `t2_plain_s_ok`, `t2_ptr_s_ok`, `v_fvo_s_ok`, `b_t2cpy_ok`, `b_t2loop_ok`, `b_t2nmx_ok`, `b_t2par_ok`, `b_t2pick_ok`, `b_vopt_ok`,
// `b_vstr_ok`, `b_vter_ok`, `t2_plain_ok`, `t2_ptr_ok`, `v_fvo_ok`, `u_ffld_ok`, `u_ffldc_ok`, `v_fv_ok`, `v_fvn_ok`. Left out: the 16 that are
// store_path_cast_written_prices.npk's own cells, equal by text once suffixed, and three duplicates by text (r5/s5's `t2_plain_ok`, `t2_ptr_ok`, `v_fvo_ok`);
// `u_ffld_ok` and `u_ffldc_ok` stay, their units naming the field `fx`.
// OFF PARITY, DEF-684 (LOW, fails closed, rulings l.13198): the fit answers no for a field of a kind it doesn't walk (a `string`, an enum) beside a pointer
// that is the argument itself, so the result is marked and a sibling's store refused (`fit_str_c`, `fit_enum_c`); each twin `X_nm` runs 67 on main and here,
// in the `_ok` file.
// PINNED, main's own price at the same site on main and here, for the row's mutants: `q_ctor_ok`, a sibling store beside an enum constructor's payload. An
// enum constructor's arguments aren't judged by the fit; judged, they would add a refusal at the growth.
error:E5;
// PRICE: `a_arr_c`, the face `a_arr` with its growth dropped (main runs it 67), refused at its store through the result; at parity. Its twin `a_arr_c_nm` follows.
struct:K_a_arr_c = { int64:k; };
struct:H_a_arr_c = { List<int64>:l; int64:k; K_a_arr_c:kk; };
func:mk_a_arr_c = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh_a_arr_c = H_a_arr_c() never fails { pass H_a_arr_c{ l: raw mk_a_arr_c(), k: 2i64, kk: K_a_arr_c{ k: 3i64 } }; };
func:growh_a_arr_c = int64(H_a_arr_c->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl_a_arr_c = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp_a_arr_c = int64->(H_a_arr_c->:q) never fails { pass @((<-q).l[0i64]); };
func:idh_a_arr_c = H_a_arr_c->(H_a_arr_c->:q) never fails { pass q; };
func:getl_a_arr_c = List<int64>->(H_a_arr_c->:w) never fails { pass @w.l; };
struct:HPO_a_arr_c = { H_a_arr_c->:lp; List<int64>:own; };
struct:SQ_a_arr_c = { HPO_a_arr_c->:q; int64:z; };
struct:SR_a_arr_c = { SQ_a_arr_c->:sq; int64:z; };
struct:SL_a_arr_c = { List<int64>->:l; int64:z; };
struct:SL2_a_arr_c = { SL_a_arr_c:s; int64:z; };
struct:SLP_a_arr_c = { SL_a_arr_c->:sp; int64:z; };
struct:SQB_a_arr_c = { HPO_a_arr_c->:q; int64:z; };
struct:HPB_a_arr_c = { H_a_arr_c->:lp; List<int64>:own; };
struct:PV_a_arr_c = { H_a_arr_c->:p; int64:v; };
struct:HPV_a_arr_c = { H_a_arr_c->:lp; List<PV_a_arr_c>:own; };
struct:SLV_a_arr_c = { List<PV_a_arr_c>->:l; int64:z; };
struct:SQV_a_arr_c = { HPV_a_arr_c->:q; int64:z; };
func:getown_a_arr_c = List<int64>->(HPO_a_arr_c->:w) never fails { pass @w.own; };
func:getownv_a_arr_c = List<PV_a_arr_c>->(HPV_a_arr_c->:w) never fails { pass @w.own; };
func:mkv_a_arr_c = List<PV_a_arr_c>(H_a_arr_c->:h) never fails { List<PV_a_arr_c>:l = raw list_init::<PV_a_arr_c>(1i64); drop list_push(@l, PV_a_arr_c{ p: h, v: 1i64 }); pass l; };
func:idp_a_arr_c = HPO_a_arr_c->(HPO_a_arr_c->:w) never fails { pass w; };
func:cvq_a_arr_c = SQ_a_arr_c->(SQB_a_arr_c->:b) never fails { pass ((b =>! any->) =>! SQ_a_arr_c->); };
func:put_a_arr_c = int64(HPO_a_arr_c->:p, H_a_arr_c->:v) never fails { p.lp = v; pass 7i64; };
struct:SR2_a_arr_c = { SQ_a_arr_c->:sq; int64:z; };
struct:SPP_a_arr_c = { HPO_a_arr_c->->:qq; int64:z; };
struct:SPPP_a_arr_c = { HPO_a_arr_c->->->:qqq; int64:z; };
struct:SPPPP_a_arr_c = { HPO_a_arr_c->->->->:qqqq; int64:z; };
struct:HN_a_arr_c = { int64:a; int64:b; };
struct:SN_a_arr_c = { HN_a_arr_c->:q; int64:z; };
struct:SNPP_a_arr_c = { HN_a_arr_c->->:qq; int64:z; };
struct:SN4_a_arr_c = { HN_a_arr_c->->->->:qqqq; int64:z; };
struct:W_a_arr_c = { HPO_a_arr_c:h; int64:z; };
struct:W2_a_arr_c = { HPO_a_arr_c->:a; HPO_a_arr_c->:b; int64:z; };
struct:SO2_a_arr_c = { HPO_a_arr_c->->?:oqq; int64:z; };
func:geth_a_arr_c = HPO_a_arr_c->(W_a_arr_c->:w) never fails { pass @w.h; };
func:geta_a_arr_c = HPO_a_arr_c->->(W2_a_arr_c->:w) never fails { pass @w.a; };
func:mksqw_a_arr_c = SQ_a_arr_c(W_a_arr_c->:w) never fails { pass SQ_a_arr_c{ q: @w.h, z: 1i64 }; };
func:idpp_a_arr_c = HPO_a_arr_c->->(HPO_a_arr_c->->:p) never fails { pass p; };
func:rety_a_arr_c = HPO_a_arr_c->(HN_a_arr_c->:p) never fails { pass ((p =>! any->) =>! HPO_a_arr_c->); };
func:put2pp_a_arr_c = int64(HPO_a_arr_c->->:pp, H_a_arr_c->:v) never fails { (<-(<-pp)).lp = v; pass 7i64; };
