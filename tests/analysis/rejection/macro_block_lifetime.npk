async func:lock_in_a_macro_block = int32() { Mutex<int32, 2i32>:z = mutex(1i32) ?! E9; Mutex<int32, 2i32>->:p = @z; #klk(); Guard<int32>:g = await p.acquire(raw duration_ms(500i64)) ?! E9; int32:x = g.value; if (x == 7i32) { pass 7i32; } pass 23i32; };
