mod:macro_block_lifetime;
error:E9;
struct:PH = { string->:p; };
struct:GH = { Guard<int32>:g; };
func:setp = NIL(PH->:h, string->:v) never fails { h.p = v; pass NIL; };
func:setq = NIL(string->->:h, string->:v) never fails { <-h = v; pass NIL; };
func:mkl = List<int32>() never fails { List<int32>:l = raw list_init::<int32>(4i64); drop list_push(@l, 42i32); pass l; };

// A MACRO'S BLOCK DIES INSIDE ITS INVOCATION'S BLOCK (DEF-509, HIGH by kind, landing 177d2b). Its scope's `parent` is the macro's home, for hygiene (`resolve.npk`), so the lifetime walk reached the module and answered "not inside", and `#caller` stored what the block was about to free: 83 at both legs, a release over a freed cell 124. Rule 3 (D-004) says this already.
macro:k1 = () { string:s = string_concat("ab", "cd"); #caller(p) = @s; };   // site NITPICK-BORROW-002
func:caller_view = int32() never fails { string:o = string_concat("ab", "cd"); string->:p = @o; #k1(); fixed uint8[]:b = string_bytes(<-p); pass b[0i64] => int32; };
macro:k2 = () { string:s = string_concat("ab", "cd"); #caller(h).p = @s; };   // site NITPICK-BORROW-002
func:caller_field = int32() never fails { string:o = string_concat("ab", "cd"); PH:h = PH{ p: @o }; #k2(); fixed uint8[]:b = string_bytes(<-h.p); pass b[0i64] => int32; };
