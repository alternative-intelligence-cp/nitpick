// THE SAME SHAPES IN A PLAIN BLOCK, the reports this rule always made: the macro's block now reads as this block does.
func:plain_view = int32() never fails { string:o = string_concat("ab", "cd"); string->:p = @o; { string:s = string_concat("ab", "cd"); p = @s; } fixed uint8[]:b = string_bytes(<-p); pass b[0i64] => int32; };   // site NITPICK-BORROW-002
func:plain_value_param_holder = int32(PH:h) never fails { { string:s = string_concat("ab", "cd"); h.p = @s; } fixed uint8[]:b = string_bytes(<-h.p); pass b[0i64] => int32; };   // site NITPICK-BORROW-002
async func:plain_move_param_guard = int32(move GH:h) { { Mutex<int32, 2i32>:a = mutex(7i32) ?! E9; Guard<int32>:t = await a.acquire(raw duration_ms(500i64)) ?! E9; h.g = move(t); } pass 7i32; };   // site NITPICK-BORROW-002
func:plain_callee_store = int32() never fails { string:o = string_concat("ab", "cd"); PH:h = PH{ p: @o }; { string:s = string_concat("ab", "cd"); drop setp(@h, @s); } fixed uint8[]:b = string_bytes(<-h.p); pass b[0i64] => int32; };   // site NITPICK-BORROW-002
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E9)               { exit 75i32; },
        (DeadlineExceeded) { exit 76i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
