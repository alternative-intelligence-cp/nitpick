func:nested_block_in_macro = int32() never fails { string:o = string_concat("ab", "cd"); string->:p = @o; #k3(); fixed uint8[]:b = string_bytes(<-p); pass b[0i64] => int32; };
macro:k4 = () { List<int32>:l = raw mkl(); #caller(v) = l[0i64...1i64]; };   // site NITPICK-BORROW-002
func:caller_slice = int32() never fails { int32[1]:a = [1i32]; int32[]:v = a[0i64...1i64]; #k4(); pass v[0i64]; };
macro:k5 = () { Mutex<int32, 2i32>:a = mutex(7i32) ?! E9; Guard<int32>:t = await a.acquire(raw duration_ms(500i64)) ?! E9; #caller(h) = GH{ g: move(t) }; };   // site NITPICK-BORROW-002
async func:caller_guard = int32() { Mutex<int32, 1i32>:z = mutex(1i32) ?! E9; Guard<int32>:g0 = await z.acquire(raw duration_ms(500i64)) ?! E9; GH:h = GH{ g: move(g0) }; #k5(); pass 7i32; };
macro:k6 = () { Mutex<int32, 2i32>:a = mutex(7i32) ?! E9; Guard<int32>:t = await a.acquire(raw duration_ms(500i64)) ?! E9; #caller(h) = move(t); };   // site NITPICK-BORROW-002
async func:caller_guard_local = int32() { Mutex<int32, 1i32>:z = mutex(1i32) ?! E9; Guard<int32>:h = await z.acquire(raw duration_ms(500i64)) ?! E9; #k6(); pass 7i32; };
macro:k7 = () { string:s = string_concat("ab", "cd"); #caller(h).p = @s; };   // site NITPICK-BORROW-002
func:value_param_holder = int32(PH:h) never fails { #k7(); fixed uint8[]:b = string_bytes(<-h.p); pass b[0i64] => int32; };
macro:k8 = () { Mutex<int32, 2i32>:a = mutex(7i32) ?! E9; Guard<int32>:t = await a.acquire(raw duration_ms(500i64)) ?! E9; #caller(h).g = move(t); };   // site NITPICK-BORROW-002
async func:move_param_guard = int32(move GH:h) { #k8(); pass 7i32; };
macro:k9 = () { string:s = string_concat("ab", "cd"); drop setp(@#caller(h), @s); };   // site NITPICK-BORROW-002
