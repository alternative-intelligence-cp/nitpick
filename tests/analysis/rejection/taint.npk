// `Result.value` is tainted until the `Result` is checked (D-007, cycle 0.5.5).
//
// `unknown` IS COMPILER-ASSIGNED AND NOT USER-WRITABLE (`TYPE_REFERENCE` §27). The
// prototype let it be written directly and used it as a general degradation
// mechanism; D-007 struck that, because `tbb`'s sticky ERR already covers degraded
// computation and two mechanisms for one job is one too many. What survives is one
// thing: the `value` field of a `Result` carrying an error.
//
// WHY IT IS WORTH A RULE. D-007's argument for trapping rather than tainting is
// that "a tainted value that reaches an actuator command produces a WRONG ACTION,
// which is worse than no action". The taint exists so that reaching an actuator
// with one is a compile error rather than a discipline — and disciplines fail
// under pressure.

mod:taint;
error:E5;

func:might_fail = int32(bool:c) {
    if (c) { fail E5; }
    pass 7i32;
};

// --- nothing checked it ----------------------------------------------------------

// expect-error: NITPICK-TAINT-001
func:reads_it_unchecked = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    pass (r.value);
};

// --- checked, and read on the wrong side ------------------------------------------
//
// `r.is_error` BEING TRUE IS THE TAINTED BRANCH. This is the case that makes the
// analysis worth having over a syntactic "was `is_error` mentioned" check: the test
// is right there, and the read is on the arm where it proved the opposite.
// expect-error: NITPICK-TAINT-001
func:reads_it_on_the_error_arm = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (r.is_error) { pass (r.value); }
    pass 0i32;
};

// AND THE NEGATED FORM, on the arm the negation says is unsafe.
// expect-error: NITPICK-TAINT-001
func:reads_it_on_the_negated_arm = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (!r.is_error) { pass 0i32; } else { pass (r.value); }
};

// --- a check does not license every later read --------------------------------------
//
// The binding holds a DIFFERENT `Result` after the assignment, and nothing has
// checked that one. Without clearing the state on assignment, one check at the top
// of a function would license every read below it.
// expect-error: NITPICK-TAINT-001
func:checked_then_reassigned = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    if (r.is_error) { pass 0i32; }
    r = might_fail(c);
    pass (r.value);
};

// --- checked on one path only ---------------------------------------------------------
//
// `checked` INTERSECTS at a merge, like `must` and unlike `moved` — the read after
// the merge happens on both paths, so a check on one of them proves nothing.
// expect-error: NITPICK-TAINT-001
func:checked_on_one_branch = int32(bool:c, bool:other) never fails {
    Result<int32>:r = might_fail(c);
    if (other) {
        if (r.is_error) { pass 0i32; }
    }
    pass (r.value);
};

// --- the wrong arm of a `pick` ------------------------------------------------------------

// expect-error: NITPICK-TAINT-001
func:pick_on_the_error_arm = int32(bool:c) never fails {
    Result<int32>:r = might_fail(c);
    int32:v = 0i32;
    pick (r.is_error) {
        (true) { v = r.value; },
        (false) { v = 1i32; }
    }
    pass v;
};
