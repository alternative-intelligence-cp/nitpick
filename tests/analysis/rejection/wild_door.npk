// THE `wild` DOOR (DEF-423, landing 177c; D-223 amended): a pointer, slice or view not of `wild` provenance enters a `wild` slot only
// through `v =>! wild T->`, or `#wild_ptr` from an integer. The slots are every store, `pass` and `return` in a `wild`-returning
// function, every call's `wild` parameter, and a sigil builtin's pointer operand. `wildx` counts as `wild`. `NITPICK-BORROW-011` at the
// value. Each module below is one cell. On this landing's parent 106 of the 147 compiled, reading the vacant owner (60), a value that happened to be right (65), or a block overrun or fault (62, 74, 83, 97, a segfault), and 41 were
// refused, some by the old store rule and some by another report; the other codes here are the analyses' own reports on the same cells: the door silences nothing.
// `wild_door_slots.npk` is the matrix's sample, `wild_index_plain.npk` and `wild_door_types.npk` the type stage's, and the cells that stay legal are
// `tests/backend/programs/wild_door_reads.npk`.
mod:wild_door;

// THE RULED LIST (the rulings section 4, MANAGEMENT/probes/def423-read, def423-ptr, 177b-review, wild-slot-attack).
mod:w0_ctl_at_call = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); drop take(@s); pass s.len; };
};
mod:w5a_memset_overrun = {
func:f = int64() never fails { int64:j = 5i64; int64:i = 7i64; int64:k = 5i64; discard(memset(@i, 0i64, 64i64)); pass j + k - 5i64; };
};
mod:w5b_mcpy_overrun = {
func:f = int64() never fails { int64:j = 5i64; int64:i = 7i64; int64[16]:b = [9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64]; discard(mcpy(@i, @b, 128i64)); pass j; };
};
mod:w6_write_read_addr_file = {
error:E9_w6_write_read_addr_file;
struct:H = { string:s; };
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:mk = H() never fails { pass H{ s: raw mks() }; };
func:at = wild H->(int64:a) never fails { pass #wild_ptr<H>(a); };
func:cell_main = int32() {
    H:h = raw mk(); H->:p = @h; int64:a = 0i64;
    cstring:c = to_cstring("/tmp/claude-1000/-home-randy-Workspace-MANAGEMENT/19298f8e-2986-4607-96e1-c0b46aecb813/scratchpad/w6.bin") ?! E9_w6_write_read_addr_file;
    fd:o = open(c, 577i64, 384i64) ?! E9_w6_write_read_addr_file;
    int64:n = write(o, @p, 8i64) ?! E9_w6_write_read_addr_file;
    fd:i = open(c, 0i64, 0i64) ?! E9_w6_write_read_addr_file;
    int64:m = read(i, @a, 8i64) ?! E9_w6_write_read_addr_file;
    string:t = move((<-(raw at(a))).s);
    pass ((h.s.len + 60i64) =>! int32);
};
};
