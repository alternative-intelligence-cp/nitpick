// expect-error: NITPICK-BORROW-015
// expect-error-at: 59:18
// expect-error: NITPICK-BORROW-015
// expect-error-at: 68:19
// expect-error: NITPICK-BORROW-009
// expect-error-at: 80:13
// expect-error: NITPICK-BORROW-015
// expect-error-at: 80:13
// expect-error: NITPICK-BORROW-015
// expect-error-at: 90:20
// expect-error: NITPICK-BORROW-015
// expect-error-at: 100:20
// expect-error: NITPICK-BORROW-009
// expect-error-at: 143:194
// expect-error: NITPICK-BORROW-009
// expect-error-at: 144:189
// A POINTER VALUE HANDED TO A CALLEE IS CHECKED AGAINST THE VIEWS THROUGH IT
// (DEF-275, landing 140; found by landing 138's probes). `drop clobber(@hd)` under
// `fixed uint8[]:v = string_bytes(hd.items[0i64])` has been BORROW-015 since D-325
// (landing 116): the callee's mutation summary says it writes the whole pointee, and
// a view's root is frozen while the view lives. Hand the callee the same storage as
// a pointer LOCAL's VALUE -- `Holder->:b = @hd; … drop clobber(b)` -- and the
// aliasing walk read the argument as a READ of `b`, judged against no view party
// rooted at the pointer: the callee freed the viewed bytes and `v[0i64]` read the
// allocator's free poison (exit 170 at both legs). A pointer-typed place-chain
// argument is checked now as `@place` is -- the callee's written paths against the
// view parties of the argument's root (`acc_call`, alias.npk): a whole-pointee
// write, an element write, a move out of an element and an unknown callee (a
// function value: the whole pointee; the store rule's BORROW-009 stands beside it,
// as under every compiler since D-325) each refuse. A callee that writes ANOTHER
// field (`bump`: `n` beside `items`) or reads only stands -- the mutation summary's
// own precision -- and so does the call after the view's block. AND THE LIMIT the
// landing measured and KEPT: a view of a List element's STRING body
// (`string_bytes(rows[0i64].path)`) across `list_push(@rows, …)` is refused as it
// was, though a push never frees an element's body -- a callee's mutation path
// `items/[…]` cannot tell a push from an overwrite or a removal, which frees it, so
// the walk keeps the conservative answer and the author copies the bytes or ends
// the view's block first (the compiler's own import loader holds a copy for this
// reason); a view of a `fixed uint8[]` field's bytes across the same push likewise.
// EVERY CASE HERE TYPE-CHECKS; the controls at the end carry no code.
mod:view_through_pointer_value;

struct:Holder = { string[2]:items; int64:n; };
struct:Rec = { string:path; int64:k; };
struct:Row = { fixed uint8[]:view; int64:k; };

func:fresh = string() never fails { pass string_concat("ghij", "klmn"); };
func:made = Holder() never fails { pass Holder{ items: [string_concat("abc", "def"), string_concat("abc", "def")], n: 0i64 }; };
func:clobber = NIL(Holder->:h) never fails { <-h = Holder{ items: [raw fresh(), raw fresh()], n: 1i64 }; pass NIL; };
func:set_elem = NIL(Holder->:h) never fails { h.items[0i64] = raw fresh(); pass NIL; };
func:bump = NIL(Holder->:h) never fails { h.n = h.n + 1i64; pass NIL; };
func:count_only = int64(Holder->:h) never fails { pass h.n; };

// (1) the hole: the whole pointee rewritten through the pointer VALUE under a view through it
func:whole_value = int32() never fails {
    Holder:hd = raw made();
    Holder->:b = @hd;
    fixed uint8[]:v = string_bytes(b.items[0i64]);
    drop clobber(b);
    pass (v[0i64] => int32);
};

// (2) an element written through the value
func:elem_value = int32() never fails {
    Holder:hd = raw made();
    Holder->:b = @hd;
    fixed uint8[]:v = string_bytes(b.items[0i64]);
    drop set_elem(b);
    pass (v[0i64] => int32);
};

// (3) a move out of the element through the value: TYPE-104 since landing 177b (DEF-416: a `move` takes an owning place), a cell of tests/types/rejection/move_through_pointer.npk; no cell here.

// (4) an unknown callee: a function value is read as writing the whole pointee
func:value_fn = int32() never fails {
    Holder:hd = raw made();
    Holder->:b = @hd;
    func NIL(Holder->) never fails:fv = clobber;
    fixed uint8[]:v = string_bytes(b.items[0i64]);
    drop fv(b);
    pass (v[0i64] => int32);
};

// (5) the limit kept: a view of a `fixed uint8[]` field's bytes across the push
func:slice_field_push = int32() never fails {
    string:s = string_concat("abc", "def");
    List<Row>:rows = raw list_init::<Row>(1i64);
    drop list_push(@rows, Row{ view: string_bytes(s), k: 1i64 });
    fixed uint8[]:w = rows[0i64].view[0i64...2i64];
    drop list_push(@rows, Row{ view: string_bytes(s), k: 2i64 });
    pass (w[0i64] => int32);
};

// (6) the limit kept: a view of an element's STRING body across the push -- a push
// frees no body, but the summary's `items/[…]` could be an overwrite or a removal
func:string_field_push = int32() never fails {
    List<Rec>:rows = raw list_init::<Rec>(1i64);
    drop list_push(@rows, Rec{ path: string_concat("abc", "def"), k: 1i64 });
    fixed uint8[]:v = string_bytes(rows[0i64].path);
    drop list_push(@rows, Rec{ path: string_concat("ghi", "jkl"), k: 2i64 });
    pass (v[0i64] => int32);
};

// --- the controls: no code ------------------------------------------------------

// the callee writes `n`, not `items`: the mutation summary tells them apart
func:ctl_other_field = int32() never fails {
    Holder:hd = raw made();
    Holder->:b = @hd;
    fixed uint8[]:v = string_bytes(b.items[0i64]);
    drop bump(b);
    pass (v[0i64] => int32);
};

// a reader through the value
func:ctl_reader = int32() never fails {
    Holder:hd = raw made();
    Holder->:b = @hd;
    fixed uint8[]:v = string_bytes(b.items[0i64]);
    int64:c = raw count_only(b);
    if (c != 0i64) { pass 1i32; }
    pass (v[0i64] => int32);
};

// the write after the view's block
func:ctl_after_block = int32() never fails {
    Holder:hd = raw made();
    Holder->:b = @hd;
    int32:first = 0i32;
    { fixed uint8[]:v = string_bytes(b.items[0i64]); first = v[0i64] => int32; }
    drop clobber(b);
    pass first;
};

// A CALLEE RE-POINTING A HOLDER HANDED BY VALUE, ASKED AND CLOSED HERE (landing 177b, DEF-416's review A, finding 4). DEF-416's
// store tracking sees this frame's own stores, `@` and `$$m`; a `wild` holder from `alloc` handed to a callee by VALUE, with the
// frame's own `@arr[0i64]` beside it, is re-pointed where the walk cannot see, and `move(<-lp.items)` then reads as a move through
// storage from outside. The store rule refuses the call first: a view of this frame's storage stored by the callee into what the
// pointer binding points at, the target unnameable (D-325) -- the plain address (ra4a_callee_holder_value) and `#ptr_add` over it
// (rc7a_holder_ptr_add). `NITPICK-BORROW-009`, one report each, on 177a and on this landing's compiler.
struct:L__holder_value = { wild string->:items; int64:n; };
func:setl__holder_value = NIL(wild L__holder_value->:l, wild string->:x) never fails { l.items = x; pass NIL; };
func:c_ra4a_callee_holder_value = int64() never fails { string[2]:arr = [raw fresh(), raw fresh()]; wild L__holder_value->:lp = alloc(16i64) =>! wild L__holder_value->; drop setl__holder_value(lp, @arr[0i64]); string:t = move(<-lp.items); pass arr[0i64].len; };
func:c_rc7a_holder_ptr_add = int64() never fails { string[2]:arr = [raw fresh(), raw fresh()]; wild L__holder_value->:lp = alloc(16i64) =>! wild L__holder_value->; drop setl__holder_value(lp, #ptr_add<string>(@arr[0i64], 0i64)); string:t = move(<-lp.items); pass arr[0i64].len; };

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
