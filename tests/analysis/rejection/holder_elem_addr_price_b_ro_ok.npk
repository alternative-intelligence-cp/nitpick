struct:Wrap = { List<int64>->:lp; };
func:peek = int64(Wrap:w) never fails { pass 7i64; };
func:f = int64(int64:n) never fails {
    List<int64>:l = raw list_init::<int64>(512i64);
    drop list_push(@l, 42i64);
    Wrap:w = Wrap{ lp: @l };
