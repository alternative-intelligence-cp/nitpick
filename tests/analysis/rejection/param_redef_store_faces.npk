struct:SL2_t_pun = { SL_t_pun:s; int64:z; };
struct:SLP_t_pun = { SL_t_pun->:sp; int64:z; };
struct:SQB_t_pun = { HPO_t_pun->:q; int64:z; };
struct:HPB_t_pun = { H_t_pun->:lp; List<int64>:own; };
struct:PV_t_pun = { H_t_pun->:p; int64:v; };
struct:HPV_t_pun = { H_t_pun->:lp; List<PV_t_pun>:own; };
struct:SLV_t_pun = { List<PV_t_pun>->:l; int64:z; };
struct:SQV_t_pun = { HPV_t_pun->:q; int64:z; };
func:getown_t_pun = List<int64>->(HPO_t_pun->:w) never fails { pass @w.own; };
func:getownv_t_pun = List<PV_t_pun>->(HPV_t_pun->:w) never fails { pass @w.own; };
func:mkv_t_pun = List<PV_t_pun>(H_t_pun->:h) never fails { List<PV_t_pun>:l = raw list_init::<PV_t_pun>(1i64); drop list_push(@l, PV_t_pun{ p: h, v: 1i64 }); pass l; };
func:idp_t_pun = HPO_t_pun->(HPO_t_pun->:w) never fails { pass w; };
func:cvq_t_pun = SQ_t_pun->(SQB_t_pun->:b) never fails { pass ((b =>! any->) =>! SQ_t_pun->); };
func:put_t_pun = int64(HPO_t_pun->:p, H_t_pun->:v) never fails { p.lp = v; pass 7i64; };
struct:SR2_t_pun = { SQ_t_pun->:sq; int64:z; };
struct:ST_t_pun = { SR_t_pun->:sr; int64:z; };
struct:SPP_t_pun = { HPO_t_pun->->:qq; int64:z; };
struct:SPPP_t_pun = { HPO_t_pun->->->:qqq; int64:z; };
struct:SQX_t_pun = { HPB_t_pun->:q; int64:z; };
struct:HN_t_pun = { int64:a; int64:b; };
struct:SN_t_pun = { HN_t_pun->:q; int64:z; };
struct:SA_t_pun = { any->:q; int64:z; };
func:put2_t_pun = int64(SQ_t_pun->:p, H_t_pun->:v) never fails { (<-((<-p).q)).lp = v; pass 7i64; };
func:getq_t_pun = HPO_t_pun->(SQ_t_pun->:w) never fails { pass (<-w).q; };
func:putgrow_t_pun = int64(HPO_t_pun->:p, H_t_pun->:v) never fails { p.lp = v; loop(0i64, 64i64, 1i64) { drop list_push(@p.own, 1i64); } pass 7i64; };
func:mksq_t_pun = SQ_t_pun(HPO_t_pun->:p) never fails { pass SQ_t_pun{ q: p, z: 1i64 }; };
func:cpsq_t_pun = SQ_t_pun(SQ_t_pun->:w) never fails { pass SQ_t_pun{ q: (<-w).q, z: 2i64 }; };
struct:SO_t_pun = { HPO_t_pun->?:oq; int64:z; };
struct:SRO_t_pun = { SO_t_pun->:so; int64:z; };
func:g3p_t_pun = int64(HPO_t_pun->:a, HPO_t_pun->:b, H_t_pun->:v, int64:n) never fails { a = b; (<-a).lp = v; pass 7i64; };
func:g_t_pun = int64(H_t_pun->:h0p, H_t_pun->:hq, H_t_pun->:hz, int64:n) never fails {
    int64->:e = raw fp_t_pun(hz);
    HPO_t_pun:m = HPO_t_pun{ lp: h0p, own: raw mk_t_pun() }; SO_t_pun:so = SO_t_pun{ oq: @m, z: 1i64 };
    HPO_t_pun:m0 = HPO_t_pun{ lp: h0p, own: raw mk_t_pun() };
    discard(raw g3p_t_pun(@m0, @m, hq, n));
    e = raw fp_t_pun(m.lp);
    discard(raw growh_t_pun(hq));
    pass (<-e) + 6i64;
};
func:f_t_pun = int64(int64:n) never fails {
    H_t_pun:hz = raw mkh_t_pun(); H_t_pun:h0 = raw mkh_t_pun(); H_t_pun:h2 = raw mkh_t_pun();
    pass raw g_t_pun(@h0, @h2, @hz, n);
};
func:cell_main_t_pun = int32() never fails { pass (((raw f_t_pun(1i64)) + 60i64) =>! int32); };
