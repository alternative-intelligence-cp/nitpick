struct:K = { int64:k; };
enum:EK = { A(int64->); Z; };
enum:EP = { A(PE); Z; };
enum:EA = { A(int64->[2]); Z; };
impl:PE = { func:getp = int64->(PE:self) never fails { pass self.p; }; func:getpp = int64->(PE->:self) never fails { pass (<-self).p; }; };
func:getppf = int64->(PE->:q) never fails { pass (<-q).p; };
