// PRICE OFF PARITY, DEF-771 (row 5; class m85k, kind K1): `keep(O->:o)` stores `string_from_bytes(o.s.ptr, o.s.len)` into `o.t` of the same
// pointee. `f` runs `drop keep(@o)` on a local, then reads `o.t` by name. It's right (67), but T5 refuses it at the call (BORROW-015@7:110): the
// party of the whole `o` meets the same call's write of `o.t`. Right: on main (3a45b7c4) it exits 67 on every road 0-8 at -O0 and -O2 and under the
// detector. Way out: `holder_view_def771_wayout_m85k_bn_ok.npk`. From `MANAGEMENT/probes/item7-bar/m85k/m85k_dir_ok.npk`.
struct:O_m85k_dir_ok = { string:s; string:t; };
func:keep_m85k_dir_ok = NIL(O_m85k_dir_ok->:o) never fails { o.t = string_from_bytes(o.s.ptr, o.s.len); pass NIL; };
func:rd_m85k_dir_ok = int64(O_m85k_dir_ok->:o) never fails { pass (string_bytes(o.t)[0i64] => int64) - 90i64; };
func:wr_m85k_dir_ok = int64(O_m85k_dir_ok->:o) never fails { o.s = string_concat("wx", "yz"); string:junk = string_concat("qq", "qq"); pass (string_bytes(o.t)[0i64] => int64) - 90i64; };
func:f_m85k_dir_ok = int64() never fails { O_m85k_dir_ok:o = O_m85k_dir_ok{ s: string_concat("ab", "cde"), t: string_concat("", "") }; drop keep_m85k_dir_ok(@o); pass (string_bytes(o.t)[0i64] => int64) - 90i64; };
func:cell_main_m85k_dir_ok = int32() never fails { pass (((raw f_m85k_dir_ok()) + 60i64) =>! int32); };
