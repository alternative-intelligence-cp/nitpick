mod:list_ptr_read_off_result;
// A MEMBER OR AN ELEMENT READ OFF A VALUE THAT CARRIES A POINTER PARAMETER HOLDS WHAT THE VALUE CARRIES (DEF-613, landing 177d2b3). `mkpe(q)` returns
// `PE{ p: raw fp(q), z: 0i64 }`, an address made inside `q`'s pointee's `List`, so `(raw mkpe(hp)).p` is that address. escape.npk's member and index arms gave every
// PASS ref of the operand's walk the READ's type (`mark_read_as`, DEF-584's mark), the call's argument `hp` among them: the take side asked an `int64->`'s pointee,
// which holds no heap, and nothing froze `hp`. `int64->:e = (raw mkpe(hp)).p; discard(raw growh(hp)); pass <-e;` read freed heap on main and on every build before
// this row. Now a PASS ref whose own type, Optional and `Result` peeled (`type_unwrapped`), isn't the base's is what the base CARRIES, not its value: it's asked as it
// stands and as the read, both. Each module is one cell; each fault cell takes `e` off the value, grows the same `List` through the same parameter and reads `e`.
// `…l` is a cell's local twin (the `H` a local, the pointer `@h0`).
// CLOSED HERE, 17: `zs1` `(raw mkpe(hp)).p`; `zs2` `(raw mkpa(hp))[0i64]`; `zs3` `(raw m.pem(hp)).p`, a method's result with the pointer an argument; `zs3r`
// `(raw (hp).hpem()).p`, the pointer the receiver; `zs4` `(raw mkpe(raw idh(hp))).p`; `zs5` `(raw mkpe2(hp)).inner.p`; `zs6` `(raw mkpas(hp)).a[0i64]`; `zs6m`
// `(raw mkpaa(hp))[0i64].p`; `zs7` `(mkper(hp) ?! E5).p`; `zs7o` `((raw mkpeo(hp)) ??! E5).p`; `zs8` `(raw mkpe2p(s0, hp)).p`, a `PE` parameter beside `hp`;
// `zs10` a member read off a HELD result whose block ended, `{ PE:pe = raw mkpe(hp); e = pe.p; }`; `zs10q` off a held literal, `PE:pe = PE{ p: raw fp(hp), z: 0i64 };`;
// `zs11` the held result read through a pointer to it, `PE->:pq = @pv; e = pq.p;`; `zs12` a `pick` binding of a call's result,
// `pick (raw mkek(hp)) { (EK.A(p)) { e = p; }, (EK.Z) { e = @one; } }`; `zs12h` a `pick` binding of a held enum; `zs13h` a `for` binding over a held array.
// REFUSED BEFORE THIS ROW, the yardsticks: the local twins of `zs1` to `zs8` (from DEF-575). KEPT REFUSED (`…_keep`): the value read IS the parameter's own, or a
// struct built from its member, and the marked read refuses as before: `zt1` `raw fp((raw idhp(q)).lp)`; `zt2` `(raw mkw(q)).hp`; `zt3`
// `(raw idhpo(q))?.lp ??! E5`; `zt4` `<-(raw idhh(hpp))`; `zt5` the plain `q.lp` (DEF-584's own).
// THREE RIGHT PROGRAMS ARE REFUSED HERE, B2's PRICES (`…_price613`; of DEF-575's kind): a holder that carries TWO parameters, the member read being the one not grown.
// `zp1` `HS2:hv = HS2{ a: hp, b: sp }; HS2->:pq = @hv; int64->:e = raw fa(pq.b); discard(raw growh(hp));`; `zp2` `raw fa((raw mkhs2(hp, sp)).b)`; `zp3`
// `raw fa(hv.b)`. The analysis reads what the holder carries, not which member holds which. Each is in line with its local twin (`…l_twin`, refused before this row)
// and out of line with the plain twin `zp4` (`raw fa(sp)`, right on every build: `list_ptr_read_off_result_ok.npk`).
// NOT PUSHED WHERE THE TYPES ARE EQUAL AS THEY STAND: a ref whose own type is already the read's (`t`) is only marked. A `for` over an array literal hands its refs on
// read as the element's type, and a copy at every level made 2^d refs: `x72e_nested_for_k1_d32_cliff` (DEF-595's nested `for` over one-element literals, 32 levels)
// ran out after a minute and 10 GB with no report while the copy was unconditional. It's refused here at its site at once, as before this row.
// THE COMPARE'S OWN ROUTE (`x72…`, a PASS ref whose own type equals the read's): `x72a1` to `x72a5` an `H->` member of a call's result, read, held in a block
// (`zs10`'s shape) or a literal (`zs10q`'s), or grown through; `x72b1` to `x72b4` a `for` over a named `H->[2]` array, taken or grown through, nested to three;
// `x72b5`, `x72b6` a `pick` binding of `EH.A(H->)`; `x72c1` to `x72c7` the wrapper roads, a ref read `H->?` and read again as `H->`. `x72c1` (`H->:u = op.o ??! E5;`,
// a `for` over `[u, u]` grown by `growl(raw lpof(m))`) and `x72c4` (`growl(raw lpof((raw mkhq(op.o ??! E5)).p))`) read freed heap on main, HEAD and W: the copy
// still read `H->?` refuses them (DEF-590's write-side readers take `read` unpeeled), so the types are compared as they stand, not peeled. `x72c4l` is refused from
// HEAD on. Local twins whose own controls are refused (BORROW-009 over a local array or `pick`, BORROW-002 held) compare nothing and are left out.
mod:x72a1_hq_member_of_call_result_same_type = {
error:E5_x72a1_hq_member_of_call_result_same_type;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:fpl = int64->(List<int64>->:q) never fails { pass @((<-q)[0i64]); };
func:fa = int64->(S->:q) never fails { pass @((<-q).a); };
func:idp = int64->(int64->:q) never fails { pass q; };
func:idh = H->(H->:q) never fails { pass q; };
func:fp2 = int64->(int64:v, H->:q) never fails { pass @((<-q).l[0i64]); };
func:fp2b = int64->(H->:q, int64:v) never fails { pass @((<-q).l[0i64]); };
func:rd2 = int64(int64->:e, int64:z) never fails { pass <-e; };
impl:H = { func:first = int64->(H->:self) never fails { pass @((<-self).l[0i64]); }; };
impl:K = { func:sel = int64->(K:self, H->:q) never fails { pass @((<-q).l[0i64]); }; };
struct:HA = { H->[2]:arr; int64:z; };
struct:HH = { H2->:hq; int64:z; };
func:pick1 = H->(H->[2]:a) never fails { pass a[1i64]; };
func:inner_of = H->(H2->:p) never fails { pass @((<-p).inner); };
struct:OP = { H->?:o; int64:z; };
func:mkpe = PE(H->:q) never fails { pass PE{ p: raw fp(q), z: 0i64 }; };
struct:HQ = { H->:p; int64:z; };
struct:OQ = { H->?:o; int64:z; };
enum:EH = { A(H->); Z; };
func:mkhq = HQ(H->:q) never fails { pass HQ{ p: q, z: 0i64 }; };
func:mkoq = OQ(H->:q) never fails { H->?:r = q; pass OQ{ o: r, z: 0i64 }; };
func:mkeh = EH(H->:q) never fails { pass EH.A(q); };
func:lpof = List<int64>->(H->:q) never fails { pass @((<-q).l); };
func:growl = int64(List<int64>->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(w, 1i64); } pass 7i64; };
func:g = int64(H->:hp, H->:hz, int64:n) never fails {
    int64->:e = raw fp((raw mkhq(hp)).p);
    discard(raw growh(hp));   // GROW
    pass (<-(e)) + 6i64;
};
func:f = int64(int64:n) never fails {
    H:h0 = raw mkh();
    H:hz = raw mkh();
    pass raw g(@h0, @hz, n);
};
};
