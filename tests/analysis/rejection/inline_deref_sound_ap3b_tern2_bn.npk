// expect-error: NITPICK-BORROW-015
// expect-error-at: 20:128
// 2026-11-21 (landing 177d2e, row 11: DEF-720's row B, form RR6a = RR6s with ARM1; rulings l.22431, l.23411, l.23500, l.23643). A PLACE UNDER THE
// DEREFERENCE OF AN INLINE POINTER EXPRESSION -- a call's result, a ternary, a `??`/`?|` (whose default it may yield), or an unwrap over one -- IS
// ROOTED WHERE THAT EXPRESSION MAY POINT, for a view or an element's address (P3-6's narrowing); before its kind test, an unwrap (`??!`, `?!`) is
// peeled down to a `??`/`?|` and both of that node's sides are collected (ARM1). A SOUND REFUSAL, NOT A PRICE: it runs 67 on main (226ebb99) and on
// row 10 at every road 0-8 at -O0 and -O2 and under the detector, but the same function with the ternary's written arm taken, `p2c_tern2w_bn` (a
// closed face here, in inline_deref_faces.npk), reads freed storage there, so the refusal is the sound verdict, as row 9's
// `pass_read_member_sound_ap3b_tern2` is for its by-member spelling. From the cell
// `Team/TMP/atk-177d2e-ap3b-2026-11-20/cells/b2/ap3b_tern2_bn.npk`.
mod:inline_deref_sound_ap3b_tern2_bn;
error:E5;
struct:HO = { List<int64>:own; List<int64>:oth; int64:z; };
struct:SOP = { HO->:oq; int64:z; };
struct:SOQ = { HO->:oq; HO->:oq2; int64:z; };
struct:SO = { HO->?:oq; int64:z; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkho = HO() never fails { pass HO{ own: raw mk(), oth: raw mk(), z: 1i64 }; };
func:repo = int64(HO->:r) never fails { (<-r).own = raw mk(); pass 7i64; };
func:g2 = int64(SOQ->:s, int64:n) never fails { int64->:e = @((<-(is (n > 0i64) : s.oq : s.oq2)).own[0i64]); discard(raw repo(s.oq2)); pass (<-e) + 6i64; };
func:g = int64(int64:n) never fails {
    HO:m = raw mkho(); HO:m2 = raw mkho(); SOQ:so = SOQ{ oq: @m, oq2: @m2, z: 1i64 };
    pass raw g2(@so, n);
};
func:f = int64(int64:n) never fails { pass raw g(n); };
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
