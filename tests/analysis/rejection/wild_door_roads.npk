// THE `wild` DOOR'S SECOND ROUND (DEF-423, DEF-426, landing 177c's rebuild, the second rulings R1, R5, R7, R8, R11, R15's holds, and DEF-480): each module is one cell, spelled as it read on the rulings'
// binaries. `wild_door.npk` holds the first round, and `tests/types/rejection/wild_into_plain_roads.npk` and `header_ptr_uses.npk` this round's type stage.
mod:wild_door_roads;

// R1: W3'S ROLE STOPS AT EVERY TRANSPARENT FORM: A `.ptr` IN AN ARM OF A TERNARY OR `??` ISN'T W3'S ARGUMENT. `d5` READS NOTHING AND IS REFUSED ALL THE SAME: THE RULE IS CLOSED.
mod:d1_dalloc_memset_ternary = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; dalloc(memset(is (true) : v.ptr : v.ptr, 0i64, v.len)); pass 7i64; };
};
mod:d2_wild_local_memset_ternary = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; wild int8->:w = memset(is (true) : v.ptr : v.ptr, 0i64, v.len); dalloc(w); pass 7i64; };
};
mod:d3_dalloc_mcpy_ternary = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; dalloc(mcpy(is (true) : v.ptr : v.ptr, alloc(8i64), v.len)); pass 7i64; };
};
mod:d4_ctl_dalloc_memset_direct = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; dalloc(memset(v.ptr, 0i64, v.len)); pass 7i64; };
};
mod:d5_ctl_memset_ternary_legal = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; discard(memset(is (true) : v.ptr : v.ptr, 0i64, v.len)); pass 7i64; };
};
mod:d6_dalloc_memset_coalesce = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; wild uint8->?:o = NIL; dalloc(memset(o ?? v.ptr, 0i64, v.len)); pass 7i64; };
};
mod:d8_write_past_via_ternary = {
func:f = int64() never fails { uint8[16]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; wild int8->:w = memset(is (true) : v.ptr : v.ptr, 2i64, v.len); w[8i64] = 9i8; pass (b[8i64] => int64) - 2i64; };
};
mod:d9_ctl_write_past_direct = {
func:f = int64() never fails { uint8[16]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; wild int8->:w = memset(v.ptr, 2i64, v.len); w[8i64] = 9i8; pass (b[8i64] => int64) - 2i64; };
};
mod:d10_mcpy_ident_middle = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; wild int8->:s = alloc(8i64); wild int8->:w = mcpy(is (true) : v.ptr : v.ptr, s, v.len); dalloc(w); pass 7i64; };
};
mod:d11_wild_arm_and_ptr = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; wild uint8->:a = alloc(8i64) =>! wild uint8->; dalloc(memset(is (false) : a : v.ptr, 0i64, v.len)); pass 7i64; };
};

// THE CONTROLS AND THE SLOTS THAT STAY REFUSED.
mod:a1c_ctl_direct = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->[1]:a = [NULL]; a[0i64] = @s; drop take(a[0i64]); pass s.len + 2i64; };
};
mod:a1s_wild_view_judged = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:a1s = NIL(string->:q) never fails { wild string->[1]:a = [NULL]; wild string->[]:v = a[0i64...1i64]; v[0i64] = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); drop a1s(@s); pass 7i64; };
};
mod:a1t_wild_view_legal = {
func:f = int64() never fails { wild int64->[2]:a = [NULL, NULL]; wild int64->[]:v = a[0i64...2i64]; wild int64->:n = alloc(8i64) =>! wild int64->; v[1i64] = n; dalloc(a[1i64]); pass 7i64; };
};
mod:a2r_ctl_direct_param = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:a2r = NIL(string->:q) never fails { wild string->[1]:a = [NULL]; a[0i64] = q; drop take(a[0i64]); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); drop a2r(@s); pass s.len + 2i64; };
};
mod:p20_ptr_add_header_ptr = {
func:f = int64() never fails { uint8[16]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8]; uint8[]:e = b[8i64...8i64]; wild uint8->:w = #ptr_add<uint8>(e.ptr, 1i64); pass 7i64; };
};
mod:p35_wild_slot_ternary_ptr = {
func:f = int64() never fails { uint8[16]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8]; uint8[]:e = b[8i64...8i64]; wild uint8->:w = is (true) : e.ptr : e.ptr; pass ((<-w) => int64) - 2i64; };
};
mod:p36_any_wild_builtin_ternary_ptr = {
func:f = int64() never fails { uint8[16]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8, 9u8]; uint8[]:e = b[8i64...8i64]; dalloc(is (true) : e.ptr : e.ptr); pass 7i64; };
};

// R5: `wl[i]` IS A PLAIN POINTER, SO `dalloc(wl[i])` IS THE DOOR'S. A `wild` ARRAY AND A `wild` STRUCT STAY REFUSED.
mod:w5_wild_array_of_plain_index = {
struct:HA = { wild int64->[1]:ps; };
func:f = int64() never fails { int64[1]:a = [5i64]; HA:h = HA{ ps: [@a[0i64]] }; pass h.ps[0i64][3i64] - h.ps[0i64][3i64] + 7i64; };
};
mod:w6_wild_list_elem_dalloc = {
func:f = int64() never fails { int64:x = 5i64; List<int64->>:l = raw list_init::<int64->>(1i64); drop list_push(@l, @x); wild List<int64->>:wl = move(l); dalloc(wl[0i64]); pass 7i64; };
};
mod:w7_struct_wild_list_elem_dalloc = {
struct:HL = { wild List<int64->>:ps; };
func:f = int64() never fails { int64:x = 5i64; List<int64->>:l = raw list_init::<int64->>(1i64); drop list_push(@l, @x); HL:h = HL{ ps: move(l) }; dalloc(h.ps[0i64]); pass 7i64; };
};
mod:w10_wild_struct_member_dalloc = {
struct:Bp = { int64->:v; };
func:f = int64() never fails { int64:x = 5i64; wild Bp:w = Bp{ v: @x }; dalloc(w.v); pass 7i64; };
};
mod:w12_wild_array_of_struct_member = {
struct:Bp = { int64->:v; };
func:f = int64() never fails { int64:x = 5i64; wild Bp[1]:w = [Bp{ v: @x }]; dalloc(w[0i64].v); pass 7i64; };
};

// R7'S CONTROLS: `@w` HANDED TO A PLAIN SLOT IN EVERY SPELLING BUT A CHECKED CAST.
mod:a3c_ctl_plain_out = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:gp = NIL(string->->:c, string->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->:w = NULL; drop gp(@w, @s); drop take(w); pass s.len + 2i64; };
};
mod:a3d_checked_cast_plain_target = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:gp = NIL(string->->:c, string->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->:w = NULL; drop gp((@w) => string->->, @s); drop take(w); pass s.len + 2i64; };
};
mod:a3e_ternary_of_addr = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
