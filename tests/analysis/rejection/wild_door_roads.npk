// R8: A RECEIVER IS AN ARGUMENT: `a.seta(@s)` AUTO-REFERENCES THE ARRAY INTO A PLAIN `T->`, AND W4 JUDGES IT WHATEVER THE PARAMETER.
mod:a4_autoref_receiver = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:seta = NIL(string->[1]->:c, string->:q) never fails { (<-c)[0i64] = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->[1]:a = [NULL]; drop a.seta(@s); drop take(a[0i64]); pass s.len + 2i64; };
};
mod:a4c_ctl_named_call = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:seta = NIL(string->[1]->:c, string->:q) never fails { (<-c)[0i64] = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->[1]:a = [NULL]; drop seta(@a, @s); drop take(a[0i64]); pass s.len + 2i64; };
};
mod:a4e_wild_struct_receiver = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
struct:HW = { string->:p; };
impl:HW = { func:seth = NIL(HW->:self, string->:q) never fails { self.p = q; pass NIL; }; };
func:f = int64() never fails { string:s = raw mks(); wild HW:h = HW{ p: @s }; drop h.seth(@s); drop take(h.p); pass s.len + 2i64; };
};

