struct:SQ_p4 = { HPO_p4->:q; int64:z; };
struct:SR_p4 = { SQ_p4->:sq; int64:z; };
struct:SP2_p4 = { HPO_p4->->:pp; int64:z; };
func:g2_p4 = int64(SQ_p4:s, H_p4->:hq, H_p4->:hz, H_p4->:h0p) never fails {
    int64->:e = raw fp_p4(hz);
    HPO_p4:mloc = HPO_p4{ lp: h0p, own: raw mk_p4() };
    s.q = @mloc;
    (<-(s.q)).lp = hq;
    e = raw fp_p4(mloc.lp);
    discard(raw growh_p4(hq));
    pass (<-e) + 6i64;
};
func:g_p4 = int64(H_p4->:h0p, H_p4->:hq, H_p4->:hz, int64:n) never fails {
    HPO_p4:m0 = HPO_p4{ lp: h0p, own: raw mk_p4() };
