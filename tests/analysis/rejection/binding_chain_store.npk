    H_p4:hz = raw mkh_p4(); H_p4:h0 = raw mkh_p4(); H_p4:h2 = raw mkh_p4();
    pass raw g_p4(@h0, @h2, @hz, n);
};
func:cell_main_p4 = int32() never fails { pass (((raw f_p4(1i64)) + 60i64) =>! int32); };
