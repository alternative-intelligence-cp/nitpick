mod:loop_body_clears_permission;
error:E9;
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E9; };
func:rewrite = int64(Result<int64>->:p) never fails { <-p = bad(); pass 0i64; };
macro:rw = (R) { R = bad(); };

// A LOOP BODY'S REWRITE CLEARS WHAT A PERMISSION SAID (DEF-522, HIGH by kind, landing 177d2b). A `Result` tested above a loop whose
// body re-assigned it stayed tested after the loop and on the body's later trips, so `.value` read a zero with no sign (60/60), and
// a page a body re-assigned stayed sealed, so the call went to writable bytes (97/97). `x10` and `x23` are `.err`'s road, `x14` a
// rewrite in `end`. `x17` needs a nested loop's quiet walk, `x12` the walk that starts from what a trip left. `x24` was refused before.
// NOT HERE: a rewrite on a road that leaves by `break` or `continue` is DEF-429's: `state_merge` drops that arm.
func:x4_while_body_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; int64:k = 0i64; while (k < 1i64) decreases 1i64 - k { r = bad(); k = k + 1i64; } pass r.value; };   // site NITPICK-TAINT-001
func:x5_for_body_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; for (int64:i in 0i64...1i64) { r = bad(); } pass r.value; };   // site NITPICK-TAINT-001
func:x6_loop_body_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; loop (0i64, 1i64, 1i64) { r = bad(); } pass r.value; };   // site NITPICK-TAINT-001
func:x15_till_body_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; till (1i64, 1i64) { r = bad(); } pass r.value; };   // site NITPICK-TAINT-001
func:x16_for_over_array_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; int64[2]:a = [1i64, 2i64]; for (int64:e in a) { r = bad(); n = n + e; } pass r.value; };   // site NITPICK-TAINT-001
func:x7_when_body_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; int64:k = 0i64; when (k < 1i64) decreases 1i64 - k { r = bad(); k = k + 1i64; } then { k = 2i64; } end { k = 3i64; } pass r.value; };   // site NITPICK-TAINT-001
