func:x14_when_end_rewrites_result = int64() never fails { Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } int64:n = 1i64; int64:k = 0i64; when (k < 1i64) decreases 1i64 - k { k = k + 1i64; } then { k = 2i64; } end { r = bad(); } pass r.value; };   // site NITPICK-TAINT-001
func:x10_while_rewrites_result_err = int64() never fails { Result<int64>:r = bad(); if (!r.is_error) { pass 1i64; } int64:k = 0i64; while (k < 1i64) decreases 1i64 - k { r = ok(); k = k + 1i64; } discard(r.err); pass 7i64; };   // site NITPICK-TAINT-001
