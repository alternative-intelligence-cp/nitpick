// 1. the carrier behind THREE pointer links (`getslc3(@c3)`: c3 -> c2 -> c1 -> b, each link a pointer FIELD read by an auto-dereferencing getter), under a view of `p.arr` -- the last depth the carrier reader's fuel (4) resolves
func:carrier_three_hops = NIL() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    fixed uint8[]:vw = string_bytes(p.arr[0i64].o);
    C1:c1 = C1{ bp: @b, k: 1i64 };
    C2:c2 = C2{ c1p: @c1, k: 2i64 };
    C3:c3 = C3{ c2p: @c2, k: 3i64 };
    drop wsl(raw getslc3(@c3));
    discard(vw[0i64] => int32);
