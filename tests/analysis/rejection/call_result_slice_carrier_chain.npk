    C1:c1 = C1{ bp: @b, k: 1i64 };
    C2:c2 = C2{ c1p: @c1, k: 2i64 };
    drop wsl(c2.c1p.bp.sl);
    discard(p.arr[0i64].o.len);
    pass NIL;
};
