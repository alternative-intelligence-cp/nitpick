mod:labelled_break_completes;
// A LABELLED `break` FROM AN INNER LOOP, OR A BARE ONE IN A `when`'s `then` OR `end`, LEAVES THE LOOP IT NAMES (DEF-436, landing 177d2b2): the
// `while (true)` read as endless, FLOW-001 was silent, and the function fell off its end and returned a zero (97: a null plain
// pointer; `y3d`, `y3e` 67 as zero + 7). `y3c` was refused before.
mod:y3a_labelled_break = {
error:E5_y3a_labelled_break;
func:mk = string() never fails { pass string_concat("ab", "cde"); };
func:setq = int64(string->:q) never fails { <-q = string_concat("wx", "yz"); pass 0i64; };
func:fs = int64(string:v, int64:k) never fails { string:junk = string_concat("qq", "qq"); pass (string_bytes(v)[0i64] => int64) - 90i64 + k; };
func:gvv = int64(fixed uint8[]:v, int64:k) never fails { string:junk = string_concat("qq", "qq"); pass (v[0i64] => int64) - 90i64 + k; };
func:midv = int64(string:v, string->:q) never fails { <-q = string_concat("wx", "yz"); string:junk = string_concat("qq", "qq"); pass (string_bytes(v)[0i64] => int64) - 90i64; };
func:g = int64->(int64->:q) never fails { outer: while (true) unbounded { while (true) unbounded { break outer; } } };
func:f = int64() never fails { int64:x = 7i64; int64->:p = raw g(@x); pass <-p; };
};
