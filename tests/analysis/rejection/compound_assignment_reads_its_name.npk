func:okn = int64(int64:n) { if (n > 90i64) { fail E5_oi9b_compound_name_value_assigns; } pass 7i64; };
func:f = int64(int64:n) never fails {
    int64:y;
    y += pick (n) { (*) { y = 7i64; give 0i64; } };
    pass y;
};
};
