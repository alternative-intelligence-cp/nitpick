mod:compound_assignment_reads_its_name;
// A COMPOUND LOADS ITS NAME BEFORE ITS VALUE (`emit_assign`'s `cur`; DEF-572, landing 177d2b2), so `y += 1i64;` reads `y`: an unassigned name is ASSIGN-001, whether nothing
// assigned it (`oi9a`), the value assigns it after the load (`oi9b`) or a loop's first trip reads it (`oi9f`), and a moved name stays moved (`oi9c`). In a `defer` body that
// read is pending until the block ends: a move of the name before then is MOVE-001 (`oi9g`), and the body itself is judged (`oi9i`). A field's root was read already (`oi9j`).
// And what it loaded stands still while the value runs: `oi9b` and `oi9e` assign the name there, ASSIGN-005. `oi9e` is a right program, a price of DEF-571's rule, and the remedy is to bind the value first.
mod:oi9a_compound_name_unassigned = {
error:E5_oi9a_compound_name_unassigned;
struct:H = { string:s; int64:k; };
func:mkh = H() never fails { pass H{ s: string_concat("ab", "cde"), k: 7i64 }; };
func:eath = int64(move H:v) never fails { pass 0i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_oi9a_compound_name_unassigned; };
func:okn = int64(int64:n) { if (n > 90i64) { fail E5_oi9a_compound_name_unassigned; } pass 7i64; };
func:f = int64(int64:n) never fails {
    int64:y;
    y += 7i64;
    pass y;
};
};
