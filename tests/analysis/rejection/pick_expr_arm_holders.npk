// DEF-327 + DEF-337 (landing 168): A HOLDER DECLARED IN A PICK EXPRESSION'S ARM HAS A PARTY WHEREVER THE
// PICK STANDS, AND A `give` INSIDE A NESTED STATEMENT OF THE ARM CARRIES ITS VIEW OUT OF THE PICK.
//
// Until this landing the aliasing pass's prescan walked STATEMENTS and never entered an expression, so a
// holder declared in a pick EXPRESSION's arm (`fixed uint8[]:v = string_bytes(d);`) had no party and a
// write of the viewed root inside the arm was unjudged (DEF-327); and the escape pass's reader of a pick
// expression's `give`s entered a block, an `if`'s branches and a `pick` but no loop body, so a view given
// from inside a `for`, a `while`, a `loop`, a `till` or a `when` left the pick with no ref, and the root
// written after the pick was unjudged (DEF-337). Sites 1-12 are DEF-327's, one per expression slot the
// pick can stand in: an initialiser, an assigned value, `discard(...)`, a `pass` operand, an `if` and a
// `while` condition, a call argument, a binary operand, a nested pick's arm, a struct literal's field,
// a `$$m` claim in the arm (site 12, NITPICK-BORROW-013: the bare-block twin's code), and the `exit`
// operand in `main` (site 9, the one slot only `main` has). Sites 13-21 are DEF-337's, one per statement
// kind the give may be nested in: `for`, `while`, `if`-then, `if`-then with an else, `loop`, `till`, a
// `when`'s body, its `then` and its `end`. Every other site is NITPICK-BORROW-015 at the write of the
// viewed root. Landing 167's checker reports NONE of them: each ran and read the freed, re-used bytes
// (113 at both legs; `wt/51a/.internal/probes/t168/`). The legal half is
// tests/backend/programs/pick_expr_arm_holders_ok.npk.
mod:pick_expr_arm_holders;
error:E1;
struct:H2 = { string:o; int64:k; };
func:idi = int32(int32:x) never fails { pass x; };

// --- DEF-327: THE ARM'S HOLDER, THE ROOT WRITTEN IN THE ARM -------------------------------------------
// 1. an initialiser's pick (f3a)
func:init_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    };
    pass r;
};

// 2. an assigned value's pick (p1)
func:assign_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = 0i32;
    r = pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    };
    pass r;
};

// 3. `discard(pick ...)` (h7a)
func:discard_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    discard(pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            if (v[0i64] != 104u8) { pass (v[0i64] => int32); }
            give 0i32;
        }
    });
    pass 0i32;
};

// 4. `pass pick ...` (h7b)
func:pass_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    pass pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            if (v[0i64] != 104u8) { give (v[0i64] => int32); }
            give 0i32;
        }
    };
};

// 5. an `if` condition's pick (p2)
func:if_cond_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    if ((pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    }) != 104i32) { pass 113i32; }
    pass 0i32;
};

// 6. a `while` condition's pick (p3)
func:while_cond_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    while ((pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    }) != 104i32) unbounded { pass 113i32; }
    pass 0i32;
};

// 7. a call argument's pick (p4; the custom shapes, the second build)
func:call_arg_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = raw idi(pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    });
    pass r;
};

// 8. a binary operand's pick (p5)
func:binary_operand_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = 0i32 + pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    };
    pass r;
};

// 10. a pick INSIDE a pick expression's arm, the inner arm declaring the view and writing the root (p7)
func:nested_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = pick (1i32) {
        (*) {
            int32:q = pick (2i32) {
                (*) {
                    fixed uint8[]:v = string_bytes(d);
                    d = string_concat("xyzzy", "!");
                    string:junk = string_concat("qqqqqqqq", "qqq");
                    give (v[0i64] => int32);
                }
            };
            give q;
        }
    };
    pass r;
};

// 11. a struct literal field's pick (p8; the custom shapes, the second build)
func:struct_field_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    H2:h = H2{ o: string_concat("a", "b"), k: (pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int64);
        }
    }) };
    if (h.k != 104i64) { pass 5i32; }
    pass 0i32;
};

// 12. a `$$m` claim declared in the arm, the root written in the arm (f3b): NITPICK-BORROW-013, as in a bare block (f3f)
func:claim_in_arm = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = pick (1i32) {
        (*) {
            string->:pm = $$m d;
            d = string_concat("xyzzy", "!");
            if (pm.len == 999i64) { give 7i32; }
            give 1i32;
        }
    };
    pass r;
};

// --- DEF-337: THE GIVE INSIDE A NESTED STATEMENT OF THE ARM, THE ROOT WRITTEN AFTER THE PICK ---------
// 13. the give inside a `for` in the arm (g1)
func:give_in_for = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            for (int32:i in 0i32...1i32) { give string_bytes(d); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 14. the give inside a `while` in the arm (g2)
func:give_in_while = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            int32:i = 0i32;
            while (i < 1i32) decreases 1i32 - i { give string_bytes(d); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 15. the give in an `if`'s then-branch, no else (g2b)
func:give_in_if_then = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            if (d.len > 0i64) { give string_bytes(d); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 16. the give in an `if`'s then-branch, the else giving another string (g2d)
func:give_in_if_then_else = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            if (d.len > 0i64) { give string_bytes(d); } else { give string_bytes(e); }
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 17. the give inside a counted `loop` in the arm (g10)
func:give_in_loop = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            loop (0i64, 1i64, 1i64) { give string_bytes(d); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 18. the give inside a `till` in the arm (g11)
func:give_in_till = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
