// 19. the give inside a `when`'s BODY in the arm (g12)
func:give_in_when_body = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            int64:n = 1i64;
            when (n > 0i64) decreases n { n = n - 1i64; give string_bytes(d); } then { give string_bytes(e); } end { give string_bytes(e); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 20. the give in a `when`'s THEN clause -- the body ran (g13)
func:give_in_when_then = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            int64:n = 1i64;
            when (n > 0i64) decreases n { n = n - 1i64; } then { give string_bytes(d); } end { give string_bytes(e); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 21. the give in a `when`'s END clause -- the body never ran (g14)
func:give_in_when_end = int32() never fails {
    string:d = string_concat("hello", " world");
    fixed uint8[]:v = pick (1i32) {
        (*) {
            string:e = string_concat("ee", "ee");
            int64:n = 0i64;
            when (n > 0i64) decreases n { n = n - 1i64; } then { give string_bytes(e); } end { give string_bytes(d); }
            give string_bytes(e);
        }
    };
    d = string_concat("xyzzy", "!");
    string:junk = string_concat("qqqqqqqq", "qqq");
    pass (v[0i64] => int32);
};

// 22. the pick in a `for` ITERABLE's range bound (q1; the third build: `prescan_stmt` walked the loop's BODY alone,
//     and the escape pass walked the iterable only when the binding could carry a borrow)
func:for_iter_bound_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:acc = 0i32;
    for (int32:i in 0i32...(pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    })) { acc = acc + 1i32; }
    pass acc;
};

// 23. the pick AS the `for` iterable, giving an array (q1c)
func:for_iter_array_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32[2]:arr = [1i32, 2i32];
    int32[2]:brr = [5i32, 6i32];
    int32:acc = 0i32;
    for (int32:e in (pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            if (v[0i64] == 104u8) { give arr; }
            give brr;
        }
    })) { acc = acc + e; }
    pass acc;
};

// 24. the pick in a counted `loop`'s END argument (q2)
func:loop_arg_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:acc = 0i32;
    loop (0i64, (pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int64);
        }
    }), 1i64) { acc = acc + 1i32; }
    pass acc;
};

// 25. the pick in a `till`'s argument (the counted loop's twin spelling)
func:till_arg_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:acc = 0i32;
    till ((pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int64);
        }
    }), 1i64) { acc = acc + 1i32; }
    pass acc;
};

// 26. the pick in a `when`'s CONDITION (q3)
func:when_cond_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int64:n = 1i64;
    int32:r = 0i32;
    when (((pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int32);
        }
    }) == 104i32) && (n > 0i64)) decreases n { n = n - 1i64; r = r + 1i32; } then { pass r; } end { pass 113i32; }
    pass 5i32;
};

// 27. the pick as a statement pick's SELECTOR, the arm giving a plain value (q7; a given VIEW is NITPICK-BORROW-009 already, q4)
func:pick_stmt_selector_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    pick (pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            if (v[0i64] == 104u8) { give 1i32; }
            give 2i32;
        }
    }) {
        (1i32) { pass 0i32; },
        (*) { pass 113i32; }
    }
    pass 5i32;
};

// 28. the pick as a pick EXPRESSION's selector, the arm giving a plain value (q8)
func:pick_expr_selector_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = pick (pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            if (v[0i64] == 104u8) { give 1i32; }
            give 2i32;
        }
    }) {
        (1i32) { give 0i32; },
        (*) { give 113i32; }
    };
    pass r;
};

// 29. the pick inside a pick arm's `where` GUARD (q6)
func:arm_guard_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32:r = pick (1i32) {
        (1i32) where ((pick (2i32) {
            (*) {
                fixed uint8[]:v = string_bytes(d);
                d = string_concat("xyzzy", "!");
                string:junk = string_concat("qqqqqqqq", "qqq");
                give (v[0i64] => int32);
            }
        }) == 104i32) { give 0i32; },
        (*) { give 113i32; }
    };
    pass r;
};

// 30. the pick in an assignment TARGET's index (q5: the freed byte indexes out of bounds, the intact one lands on arr[0])
func:assign_target_index_pick = int32() never fails {
    string:d = string_concat("hello", " world");
    int32[2]:arr = [0i32, 0i32];
    arr[((pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give (v[0i64] => int64);
        }
    }) - 104i64)] = 7i32;
    pass arr[0i64];
};

// 9. the `exit` operand's pick (p6): the one slot only `main` has
func:main = int32(cstring[]:_~argv) {
    string:d = string_concat("hello", " world");
    exit (pick (1i32) {
        (*) {
            fixed uint8[]:v = string_bytes(d);
            d = string_concat("xyzzy", "!");
            string:junk = string_concat("qqqqqqqq", "qqq");
            give ((v[0i64] => int32) - 104i32);
        }
    });
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (DeadlineExceeded)  { exit 112i32; },
        (StaleHandle)       { exit 113i32; },
        (E1)                { exit 114i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
