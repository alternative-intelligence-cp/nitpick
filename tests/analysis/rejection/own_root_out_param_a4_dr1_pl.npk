// expect-error: NITPICK-BORROW-015
// expect-error-at: 30:23
// 2026-11-26 (landing 177d2f, item 7, row 1: row A, form RA5F, DEF-681's own root and its clean fallback; rulings l.24359 item 2). A STORE THROUGH
// ANOTHER POINTER PARAMETER (A3b, ROW A'S OUT-PARAMETER FIX), DEF-681: `st(@m1, @m2)` stores `(<-b).lp` (`@h2`) into `m1.lp` through another
// pointer parameter; `e = fp(m1.lp)` then points into `h2.l`, `growh(@h2)` reallocates it, and `<-e` reads freed memory. CLOSED FACE: on main
// (3a45b7c4) it is accepted, and it exits 236 on every road 0-8 at -O0 and -O2, and 97 under the detector; the same on row 0's build; refused from
// row A on. From `nitpick/.internal/g2f-2026-11-21/cells/ag2e/ctl/a4_dr1_pl.npk`.
mod:own_root_out_param_a4_dr1_pl;
error:E5;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
struct:HPO = { H->:lp; List<int64>:own; };
func:growp = int64(HPO->:p) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@p.own, 1i64); } pass 7i64; };
func:growo = int64(HPO->?:o) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@((<-(o ??! E5)).own), 1i64); } pass 7i64; };
func:growr = int64(Result<HPO->>:r) never fails { if (r.is_error) { pass 7i64; } loop(0i64, 64i64, 1i64) { drop list_push(@((<-(r.value)).own), 1i64); } pass 7i64; };
func:mknone = HPO->?() never fails { pass NIL; };
func:st = int64(HPO->:a, HPO->:b) never fails { (<-a).lp = (<-b).lp; pass 7i64; };
func:f = int64(int64:n) never fails {
    H:h1 = raw mkh();
    H:h2 = raw mkh();
    HPO:m1 = HPO{ lp: @h1, own: raw mk() };
    HPO:m2 = HPO{ lp: @h2, own: raw mk() };
    discard(raw st(@m1, @m2));   // one hop: m1.lp = m2.lp
    int64->:e = raw fp(m1.lp);
    discard(raw growh(@h2));   // GROW what m1.lp now views
    pass (<-e) + 6i64;
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
