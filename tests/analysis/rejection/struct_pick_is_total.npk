mod:struct_pick_is_total;
// A `pick` WITH AN UNGUARDED STRUCT DESTRUCTURE IS TOTAL, AND WHAT ITS ARMS DID COUNTS AFTER IT (DEF-537, HIGH, pre-existing,
// landing 177d2b). `(P { a, b })` binds the struct's fields and always matches. The exhaustiveness check took it as covering
// the selector, and the question definite assignment asks of the same pick (`pick_covers_all`) had no struct case, so the
// pick was partial there: the state before it was kept, and what an arm UN-PERMITS was lost. A `Result` the arm rewrote stayed
// checked and a page it re-made stayed sealed. One module per cell, each accepted before this landing and each wrong when
// run (60: `.value` of an error; 74: `.err` of a value; 97: an unsealed page called).
//   The three facts an arm can take back: `checked` (most cells), `errchecked` (`c4`, `h14`), `sealed_firm` (`c2`, `h15`,
//   `e1pc`).
//   The selector's forms: a local, a field (`h1`), a call's result (`h2`), a pointee (`h3`), a consumed owner (`c6`, `x11c`),
//   a generic struct (`x12c`).
//   The pick's places: a statement, a declaration's value (`c3`, `e1vc`), a call's argument (`h6`), an `if`'s and a
//   `while`'s condition (`h10`, `h18`), a loop's body (`c5`), an `if`'s block (`c7`), a `defer`'s body (`h4`), a value arm
//   (`h5`), another struct pick's arm (`h19`), a generic function (`h11`), a macro's expansion (`h12`), an `async`
//   function (`h13`).
//   The arms: one, two (`h7`: the second can't run), a guarded one before the plain one (`x2`: the rewrite is the plain
//   arm's), one binding of two (`h20`), and an empty binding list (`h8`). `(P1 { })` is taken by the parser today, binds
//   nothing and always matches, and no reference shows it; it's judged here as the emitter runs it. RULED 2026-11-04
//   (management_21, 21:53 EST): DEF-554's fix refuses the form, and `h8` changes there.
//   REFUSED BEFORE THIS LANDING TOO, pinned here: a `(*)` arm that rewrites (`c1k`, `x3`); a guard-only pick that assigns
//   (`g2`: no arm may run, and the pick itself is PICK-003 since DEF-545); one arm of two that doesn't assign (`k6`); a
//   `(*)` after a plain destructure that rewrites (`k7`: the `(*)` made the pick total already); an arm after a plain
//   destructure that doesn't assign (`k8`).
//   THE PRICES, right on every road and refused: an arm AFTER an unguarded destructure can't run, and its end is merged
//   as any arm's is, so what it rewrites is counted (`x2w`, `pw1`, `pw2`). After `(*)` such an arm is PICK-004; after a
//   destructure nothing says it's dead. The remedy is to delete the arm.
mod:c1_struct_pick_rewrites_result = {
error:E5_c1_struct_pick_rewrites_result;
func:mk = string() never fails { pass string_concat("ab", "cde"); };
func:rds = int64(string:x) never fails { string:junk = string_concat("qq", "qq"); pass (string_bytes(x)[0i64] => int64) - 90i64; };
func:eats = int64(move string:v) never fails { pass 0i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_c1_struct_pick_rewrites_result; };
struct:P = { int64:a; int64:b; };
enum:Os = { V(string); W(string); Z; };

func:f = int64() never fails {
Result<int64>:r = ok(); if (r.is_error) { pass 1i64; } P:p = P{ a: 1i64, b: 2i64 }; pick (p) { (P { a, b }) { r = bad(); } } pass r.value;
};
};
