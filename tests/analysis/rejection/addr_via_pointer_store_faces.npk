mod:addr_via_pointer_store_faces;
// 2026-11-16 (landing 177d2b9, row 3: DEF-644 root B, seat S's S4, ported onto rows 1 and 2). AN ADDRESS TAKEN THROUGH ANOTHER POINTER (`r =
// @((<-q0).inner)` over `q0 = @mx`; `@((<-pb).q)`, `@(<-mp2)`) NAMES STORAGE THAT POINTER POINTS AT, but the address ref's root is `q0`, whose
// chain names the pointee, so a store through `r` landed on a place main doesn't record (`mx` held no view, and a growth of what was stored freed
// what `mx.inner.lp` read). The escape analysis now REROOTS such an address: its targets are the pointee's (`escape_pointer_targets` of the first
// pointer inward from the place's base), and a store records on each target and then on the address ref itself, as main does
// (`record_refs_at_target` wraps the old body, `record_refs_at_target_one`). `rrti_path`'s and `rrti_chain`'s descents also go down the rerooted
// targets' chains (by row 2's marked key), beside their own walk. A fix only adds records beside main's.
// THE FACES (74), each a fault on main (acb78ea) and on row 2's candidate, refused here (each once by text; `dt_loc` and `r26_2lv_d` are `dt2`'s
// and `b_base`'s texts): `dt_low`, `a3_hqv`, `a3_hqv_tw`, `a3_v1`, `a3_v2`, `a3_v3`, `a3_v5`, `a3_v6`, `dt1`, `dt2`, `u_dref_nm`, `u_pp_nm`,
// `v_castfr`, `v_dir1`, `v_dstore`, `v_nocall`, `v_nocast`, `v_whole`, `xk_pbp_L_F`, `xk_pbp_P_F`, `cal_st2`, `cal_st2m`, `cal_stpp`,
// `cyc_self1`, `r16_lq_f`, `r16_wq_f`, `b_base`, `r10_loop`, `r10_loop2`, `r10_strct`, `r3_d1`, `r3_dd`, `r3_pp`, `r3_ppp`, `r5_fld`, `r5_fldp`,
// `r7_br`, `r7_late`, `r8_fld`, `r9_arr`, `r12_pf`, `r13_hop`, `r14_pp`, `r4_idv`, `r5_copy`, `r6_cq`, `r15_ap`, `r16_lq`, `r16_wq`, `r17_lst`,
// `r20_optb`, `r22_auto`, `r22_autopp`, `r24_mid`, `r24_mid2`, `r24_mid3`, `r25_ternb`, `r26_2lv_n`, `r26_dd_d`, `r26_dd_n`, `r26_fld_n`,
// `r26_pp_d`, `r26_sbf_d`, `a5_cal3`, `a5_cal4`, `x_r1_resv`, `kp_chm`, `kp_chd`, `kp_chi`, `km6_g2`, `km8_cl`, `km8_clm`, `km8_pf`, `km8_sp`.
// AND ONE GUARD, refused on main and here: `km6_rr`, a store through an address taken through `q0`, read back through that address (main's record
// on the address ref itself, which the reroot keeps).
error:E5;
struct:K_dt_low = { int64:k; };
struct:H_dt_low = { List<int64>:l; int64:k; K_dt_low:kk; };
func:mk_dt_low = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh_dt_low = H_dt_low() never fails { pass H_dt_low{ l: raw mk_dt_low(), k: 2i64, kk: K_dt_low{ k: 3i64 } }; };
func:growh_dt_low = int64(H_dt_low->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl_dt_low = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp_dt_low = int64->(H_dt_low->:q) never fails { pass @((<-q).l[0i64]); };
func:idh_dt_low = H_dt_low->(H_dt_low->:q) never fails { pass q; };
func:getl_dt_low = List<int64>->(H_dt_low->:w) never fails { pass @w.l; };
struct:HPO_dt_low = { H_dt_low->:lp; List<int64>:own; };
struct:SQ_dt_low = { HPO_dt_low->:q; int64:z; };
struct:SR_dt_low = { SQ_dt_low->:sq; int64:z; };
func:g_dt_low = int64(H_dt_low->:h0p, H_dt_low->:hq, H_dt_low->:hz, int64:n) never fails {
    int64->:e = raw fp_dt_low(hz);
    HPO_dt_low:m = HPO_dt_low{ lp: h0p, own: raw mk_dt_low() }; HPO_dt_low->:mp = @m; SQ_dt_low:s = SQ_dt_low{ q: @(<-mp), z: 1i64 }; SQ_dt_low->:sp = @s;
    (<-((<-sp).q)).lp = hq;
    e = raw fp_dt_low(m.lp);
    discard(raw growh_dt_low(hq));
    pass (<-e) + 6i64;
};
func:f_dt_low = int64(int64:n) never fails {
    H_dt_low:hz = raw mkh_dt_low(); H_dt_low:h0 = raw mkh_dt_low(); H_dt_low:h2 = raw mkh_dt_low();
    pass raw g_dt_low(@h0, @h2, @hz, n);
};
func:cell_main_dt_low = int32() never fails { pass (((raw f_dt_low(1i64)) + 60i64) =>! int32); };
