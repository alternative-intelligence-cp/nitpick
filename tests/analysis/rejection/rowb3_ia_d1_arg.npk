// expect-error: NITPICK-BORROW-015
// expect-error-at: 21:21
// 2026-11-26 (landing 177d2f, item 7, row 5: row B3, form TRY_B3m2fv (SC, over B3v, B3j and B3k); rulings l.25468). ROW B3'S WALK, A FACE OF
// DEF-681: `g[0].nx = @g[1]` links two elements of one array, and a one-load getter on `@g[0]` views `g[1].s`. The caller then rewrites `g[1].s`
// through `wse(@g[1])` while the view is live and reads it: the own-root skip at a sibling element. CLOSED FACE: on main (3a45b7c4) it is accepted,
// and it exits 140 on every road 0-8 at -O0 and -O2, and 97 under the detector; the same on row B2's build; refused from row B3 on. From
// `Team/TMP/aw10-177d2f-2026-11-22/cells/aw10/ia/ia_d1_arg.npk`.
mod:rowb3_ia_d1_arg;
error:E5;
func:mks = string() never fails { pass string_concat("a", "b"); };
struct:NE = { NE->?:nx; NE->?:ny; string:s; int64:z; };
func:wse = int64(NE->:o) never fails { (<-o).s = string_concat("q", "r"); pass 7i64; };
func:setnx = int64(NE->:o, NE->:t) never fails { (<-o).nx = t; pass 7i64; };
func:getd0 = fixed uint8[](NE->:o) never fails { NE->:p1 = (<-o).nx ??! E5; pass string_bytes((<-p1).s); };
func:f = int64(int64:n) never fails {
    NE:t = NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 };
    NE:c = NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 };
    NE[2]:g = [NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }, NE{ nx: NIL, ny: NIL, s: raw mks(), z: 1i64 }];
    g[0].nx = @g[1];
    fixed uint8[]:vw0 = raw getd0(@g[0]);
    discard(raw wse(@g[1]));
    pass (vw0[0i64] => int64) - 90i64;
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
