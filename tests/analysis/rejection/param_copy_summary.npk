// 12. (DEF-342) the copy made through the checked cast `=>` (f9j9)
func:copy_through_cast_write = NIL() never fails {
    H2:h = H2{ o: string_concat("ab", "cd"), k: 1i64 };
    H2->:hp = @h;
    fixed uint8[]:vw = string_bytes(h.o);
