// 6. (DEF-342) the copy handed to a writing callee (f9j11)
func:copy_forwarded_to_writer = NIL() never fails {
    H2:h = H2{ o: string_concat("ab", "cd"), k: 1i64 };
    H2->:hp = @h;
    fixed uint8[]:vw = string_bytes(h.o);
    drop wrfwd(hp);
    discard(vw[0i64] => int32);
    pass NIL;
};

// 7. (DEF-342) the copy written through an explicit dereference (f9j12)
func:copy_explicit_deref_write = NIL() never fails {
