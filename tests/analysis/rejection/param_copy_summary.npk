// 11. (DEF-342) an `any->` parameter copied through `=>!` to the pointee's type and written (f9j6)
func:any_copy_through_ucast_write = NIL() never fails {
    H2:h = H2{ o: string_concat("ab", "cd"), k: 1i64 };
    any->:ap = (@h) =>! any->;
    fixed uint8[]:vw = string_bytes(h.o);
    drop wrany2(ap);
    discard(vw[0i64] => int32);
    pass NIL;
