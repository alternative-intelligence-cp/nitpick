// 10. (DEF-342) the copy made through a same-type `=>!` (f9j5)
func:copy_through_ucast_write = NIL() never fails {
    H2:h = H2{ o: string_concat("ab", "cd"), k: 1i64 };
    H2->:hp = @h;
