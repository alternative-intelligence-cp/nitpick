// 8. (DEF-342) the whole pointee assigned through the copy (f9j13)
func:copy_whole_pointee_assign = NIL() never fails {
    H2:h = H2{ o: string_concat("ab", "cd"), k: 1i64 };
    H2->:hp = @h;
    fixed uint8[]:vw = string_bytes(h.o);
    drop wrcwh(hp);
    discard(vw[0i64] => int32);
    pass NIL;
