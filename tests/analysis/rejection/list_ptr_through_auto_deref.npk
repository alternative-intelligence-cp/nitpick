mod:list_ptr_through_auto_deref;
// A VALUE READ THROUGH A POINTER IS THE POINTEE'S, WHATEVER THE SPELLING (DEF-592, landing 177d2b3). `<-q` always read the pointee. The spellings that dereference without
// the sigil (D-098) gave the pointer's own refs, the address of what it points at: a member `q.lp`, a safe member `o?.lp`, an index `pp[0i64]`, and a by-value receiver
// reached through a pointer, `q.get()`. So `raw fp(q.lp)` through a local `HP->:q = @h;` froze `h` and not the `H` behind `h.lp`, and `growh(h.lp)` freed what the
// result pointed into. Each module is one cell: an `a` cell is the auto spelling, an `e` cell the explicit `<-`, a `d` cell the place itself, refused alike.
// A receiver is read through for what the callee hands BACK. A callee that returns a VIEW of a by-value receiver views the bytes it's lent, which the pointer's own
// refs name, so `yz3a`, `(raw idv(@v)).vw()`, stays refused (its `<-` twin isn't yet: DEF-597, not in this file). `yd1`, `yd3`: a pointer with two targets, the growth
// behind the second. `yv2a`, `yv2e`: a `wild` slot's value read through a pointer to the slot and crossed by `=>!` is held against `dalloc` in both spellings.
mod:xq19l_member_through_local_ptr_auto = {
error:E5_xq19l_member_through_local_ptr_auto;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
struct:H2 = { H:inner; int64:z; };
struct:HP = { H->:lp; int64:z; };
struct:W = { H->:hp; int64:z; };
struct:S = { int64:a; int64:b; };
struct:PE = { int64->:p; int64:z; };
enum:EK = { A(int64->); Z; };
func:rdk = int64(EK:e) never fails { int64:v = 0i64; pick (e) { (EK.A(q)) { v = <-q; }, (EK.Z) { v = 0i64; } } pass v; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:fpl = int64->(List<int64>->:q) never fails { pass @((<-q)[0i64]); };
func:fa = int64->(S->:q) never fails { pass @((<-q).a); };
func:idp = int64->(int64->:q) never fails { pass q; };
func:idh = H->(H->:q) never fails { pass q; };
func:fp2 = int64->(int64:v, H->:q) never fails { pass @((<-q).l[0i64]); };
func:fp2b = int64->(H->:q, int64:v) never fails { pass @((<-q).l[0i64]); };
func:rd2 = int64(int64->:e, int64:z) never fails { pass <-e; };
impl:H = { func:first = int64->(H->:self) never fails { pass @((<-self).l[0i64]); }; };
impl:K = { func:sel = int64->(K:self, H->:q) never fails { pass @((<-q).l[0i64]); }; };
func:f = int64(int64:n) never fails {
    H:h0 = raw mkh();
    HP:h = HP{ lp: @h0, z: 0i64 };
    HP->:q = @h;
    int64->:e = raw fp(q.lp);
    discard(raw growh(h.lp));
    pass (<-e) + 6i64;
};
};
