func:errv = int64(Error:e) never fails { pick (e) { (E5_a3_give_loop_silent) { pass 7i64; }, (*) { pass 0i64; } } };
func:f = int64(int64:n) never fails {
    int64:out = 7i64;

    Result<int64>:r = ok(); if (r.is_error) { pass out; }
    int64:i1 = 0i64;
    while (i1 < 2i64) decreases 2i64 - i1 {
        out = r.value;
        i1 = i1 + 1i64;
        int64:t1 = pick (n) {
            (1i64) {
                int64:j1 = 0i64;
                while (true) unbounded {
                    if (j1 == 1i64) { give 5i64; }
                    r = bad();
                    j1 = j1 + 1i64;
                }
