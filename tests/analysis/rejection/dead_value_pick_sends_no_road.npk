func:okn = int64(int64:n) { if (n > 90i64) { fail E5_pa2k_loop_inside_the_live_arm; } pass 7i64; };
func:f = int64(int64:n) never fails {
    int64:out = 0i64;
    Result<int64>:r = ok(); if (r.is_error) { pass 1i64; }
    int64:i = 0i64;
    lo: while (i < 3i64) decreases 3i64 - i {
        i = i + 1i64;
        out = r.value;
        if (n > 5i64) { out = 7i64;
            int64:v = pick (n) {
                (1i64) { int64:j = 0i64; li: while (j < 2i64) decreases 2i64 - j { j = j + 1i64; if (j == 1i64) { continue li; } r = bad(); continue lo; } give j; },
                (*) { give 2i64; }
            };
            out = out + v;
        }
    }
    pass out;
};
};
