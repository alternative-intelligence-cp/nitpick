mod:break_in_a_value_pick_leaves;
// A `break L` OR `continue L` HELD IN A VALUE `pick` LEAVES ITS STATEMENT (DEF-548, landing 177d2b2): a `while (true)` it
// leaves completes, so a function that ends after it falls off its end (FLOW-001), and a value arm that leaves gives nothing (FLOW-001
// at the arm). Before: the leave was walked as staying, the function returned a zero (67 as zero + 7, 97 a null pointer). `c1c`,
// `c1rc`, `c2c` were refused before and after.
mod:c1_expr_break_falls_off = {
error:E5_c1_expr_break_falls_off;
struct:H = { string:s; int64:k; };
struct:P1 = { int64:a1; int64:b1; };
struct:P2 = { int64:a2; int64:b2; };
func:mkh = H() never fails { pass H{ s: string_concat("ab", "cde"), k: 7i64 }; };
func:eath = int64(move H:v) never fails { pass 0i64; };
func:rdh = int64(move H:v) never fails { pass v.k; };
func:fillh = int64(H->:h) never fails { <-h = H{ s: string_concat("ab", "cde"), k: 7i64 }; pass 1i64; };
func:ok = int64() { pass 7i64; };
func:bad = int64() { fail E5_c1_expr_break_falls_off; };
func:errv = int64(Error:e) never fails { pick (e) { (E5_c1_expr_break_falls_off) { pass 7i64; }, (*) { pass 0i64; } } };
func:g = int64(int64:n) never fails {
    l1: while (true) unbounded {
        int64:v = pick (n) { (1i64) { break l1; }, (*) { give 5i64; } };
        pass v;
    }
};
func:f = int64(int64:n) never fails {
    int64:out = 7i64;

    int64:w = raw g(n);
    if (w != 5i64) { out = w; }
    pass out;
};
};
