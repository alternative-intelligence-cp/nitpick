func:g_a4_shat = int64(H_a4_shat->:h0p, H_a4_shat->:hq, H_a4_shat->:hz, int64:n) never fails {
    HPO_a4_shat:m = HPO_a4_shat{ lp: h0p, own: raw mk_a4_shat() }; HPO_a4_shat:m2 = HPO_a4_shat{ lp: h0p, own: raw mk_a4_shat() };
    SQ_a4_shat:s = SQ_a4_shat{ q: @m, z: 1i64 }; SQ_a4_shat:s2 = SQ_a4_shat{ q: @m2, z: 2i64 };
    discard(raw w_a4_shat(@s, @s2, hq, n));
    int64->:e2 = raw fp_a4_shat((<-(s.q)).lp);
    discard(raw growh_a4_shat(hq));
    pass (<-e2) + 6i64;
};
