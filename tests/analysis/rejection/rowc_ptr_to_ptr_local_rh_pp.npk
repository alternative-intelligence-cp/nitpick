// expect-error: NITPICK-BORROW-015
// expect-error-at: 22:21
// 2026-11-26 (landing 177d2f, item 7, row 3: row C, form RABC5F, DEF-728; rulings l.24618 items 1 and 2). A GETTER RETURNING A VIEW THROUGH A LOCAL
// THAT HOLDS ITS PARAMETER'S ADDRESS, DEF-728: `getv(LF->:o)` takes `LF->->:pp = @o` and returns `string_bytes((<-(<-pp)).s)`, a view through a
// local holding its parameter's address; the caller then replaces `fB.s` and reads the freed view. CLOSED FACE: on main (3a45b7c4) it is accepted,
// and it exits 140 on every road 0-8 at -O0 and -O2, and 97 under the detector; the same on row B's build; refused from row C on. From
// `MANAGEMENT/probes/177d2f-plan/ag2f/m78-rel/ag2f_rh_pp.npk`.
mod:rowc_ptr_to_ptr_local_rh_pp;
error:E5;
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 7i64); pass l; };
func:mks = string() never fails { pass string_concat("a", "b"); };
struct:LF = { List<int64>:own; string:s; int64:z; };
func:nlf = LF() never fails { pass LF{ own: raw mk(), s: raw mks(), z: 1i64 }; };
func:ws1 = int64(LF->:o) never fails { (<-o).s = string_concat("q", "r"); pass 7i64; };
struct:HL = { LF->:lp; int64:z; };
func:getd = fixed uint8[](LF->:o) never fails { pass string_bytes((<-o).s); };
func:getv = fixed uint8[](LF->:o) never fails { LF->->:pp = @o; pass string_bytes((<-(<-pp)).s); };
func:f = int64(int64:n) never fails {
    LF:fB = raw nlf();
    LF:fC = raw nlf();
    fixed uint8[]:vw = raw getv(@fB);
    discard(raw ws1(@fB));
    pass (vw[0i64] => int64) - 90i64;
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (DivByZero)        { exit 88i32; },
        (DivOverflow)      { exit 89i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
