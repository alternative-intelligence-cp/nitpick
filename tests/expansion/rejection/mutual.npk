// Two macros expanding into each other (D-057, 0.6.1).
//
// The same non-termination as direct self-recursion, reached by a route no single
// macro's body reveals — which is why the diagnostic is reported at the module
// rather than at an invocation: a cycle needs at least two participants and blaming
// either one would be arbitrary.
mod:mutual;

// expect-error: NITPICK-MACRO-004
macro:ping = () {
    func:from_ping = int32() never fails { pass 1i32; };
    #pong();
};

macro:pong = () {
    func:from_pong = int32() never fails { pass 2i32; };
    #ping();
};

#ping();

func:main = int32(cstring[]:_~argv) { exit 0i32; };
