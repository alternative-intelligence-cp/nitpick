// Subset 1 — control flow.
// `while` is the only loop. Every extra loop form is seed work, and while
// expresses all of them; the compiler's source is slightly more verbose for it.

func:count_to = int32(int32:bound) never fails {
    int32:i = 0i32;
    int32:acc = 0i32;

    while (i < bound) {
        if (i == 3i32) {
            acc = acc + 10i32;
        } else if (i == 5i32) {
            acc = acc + 100i32;
        } else {
            acc = acc + 1i32;
        }
        i = i + 1i32;
    }

    pass acc;
};

func:scoped = int32() never fails {
    int32:outer = 1i32;

    // A bare block introduces a lexical scope. This is how a critical section
    // is written -- there is no `with` construct (D-082).
    {
        fixed int32:pinned = 7i32;      // immutable binding, enforced by the seed
        outer = outer + pinned;
    }

    pass outer;
};

func:main = int32(cstring[]:_~argv) {
    int32:a = raw count_to(6i32);
    int32:b = raw scoped();
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
