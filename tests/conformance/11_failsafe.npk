// expect-exit: 7
//
// Subset 1 -- the trap path.
//
// `!!! code;` transfers control directly to failsafe WITHOUT unwinding, and
// `defer` does NOT run (D-014). At trap time the state of the system is unknown,
// so no cleanup executes before the handler that understands the situation gets
// control.
//
// failsafe's return value becomes the process exit code, and it must be
// POSITIVE: reaching failsafe means something failed, so returning 0 would be a
// contradiction (D-014).

error:E19;

func:risky = int32(int32:x) never fails {
    wild int8->:buf = alloc(16i64);
    defer { dalloc(buf); }        // must NOT run on the trap path below

    if (x < 0i32) {
        !!! E19;
    }

    pass x;
};

func:main = int32(cstring[]:_~argv) {
    int32:v = raw risky(0i32 - 1i32);
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 7i32; },
        (E19) { exit 7i32; },
        (HeapBadRequest) { exit 7i32; },
        (HeapOom) { exit 7i32; },
        (IntOverflow) { exit 7i32; },
        (Unreachable) { exit 7i32; },
        (WildLeak) { exit 7i32; },
        (*) { exit 7i32; }
    }
    exit 7i32;
};
