// Subset 1 — tagged enums with single-word payloads, and pick.
//
// The payload restriction is what makes enum lowering trivial in the seed:
// every enum is {i32 tag, i64 payload}. The frontend satisfies it naturally --
// identifiers are interned to an int32 index, and AST nodes are indices into
// concrete node arrays rather than pointers.

mod:c03_enums_pick;
pub enum:Severity = {
    Note    = 0i32;
    Warning = 1i32;
    Error   = 2i32;
};

pub enum:Expr = {
    IntLit(int64);
    Ident(int32);        // interned name index
    Binary(int32);       // index into the BinaryExpr node array
};

func:describe = int32(Severity:s) never fails {
    pick (s) {
        (Severity.Note)    { pass 0i32; },
        (Severity.Warning) { pass 1i32; },
        (Severity.Error)   { pass 2i32; }
    }
};

func:payload_of = int64(Expr:e) never fails {
    pick (e) {
        (Expr.IntLit(v))  { pass v; },
        (Expr.Ident(n))   { pass (n => int64); },
        (Expr.Binary(ix)) { pass (ix => int64); }
    }
};

func:main = int32(cstring[]:_~argv) {
    Expr:lit = Expr.IntLit(42i64);
    int64:v  = raw payload_of(lit);
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
