// Subset 1 — strings.
// No interpolation: &{ } needs to know a formatting function per type, which is
// more than the seed should carry. Diagnostics build messages by explicit
// concatenation instead, which is mechanical.

mod:c07_strings;
func:render = string(int32:code) never fails {
    string:head = "error[";
    string:num  = int_to_string(code => int64);
    string:tail = "]: unexpected token";

    string:a = string_concat(head, num);
    string:b = string_concat(a, tail);
    pass b;
};

func:main = int32(cstring[]:_~argv) {
    string:msg = raw render(19i32);
    // `wild_release_all()` used to sit here, appeasing the leak check before
    // the managed lowering existed. Under D-183 the drops ARE the cleanup, and
    // a wholesale release before scope exit frees the very bodies the drops
    // are about to free again — the interim's tool colliding with the thing
    // that replaced it. It remains what it always was: failsafe's instrument
    // (leak_cleanup exercises that), not ordinary main's.
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
