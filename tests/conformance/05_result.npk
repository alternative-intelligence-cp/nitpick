// Subset 1 — Result<T>, the only parameterized type, and the operators that
// consume it. Result<T> is builtin with shape {T, tbb32} (D-069); the seed
// hard-codes it rather than implementing generics.

error:E9;
error:E19;

func:might_fail = int32(int32:x) {
    if (x < 0i32) {
        fail E19;
    }
    pass (x * 2i32);
};

// relay forwards the error code verbatim and returns early (D-080). This is
// the ordinary way to propagate, and it is why subset 1 includes it despite
// being otherwise minimal: hand-written propagation gets written wrong.
func:doubled_plus_one = int32(int32:x) {
    int32:d = relay might_fail(x);
    pass (d + 1i32);
};

func:with_explicit_check = int32(int32:x) {
    Result<int32>:r = might_fail(x);

    // .is_error is a derived accessor for .err != 0i32 (D-069).
    if (r.is_error) {
        fail r.err;                  // forward the code, never a constant
    }

    // The CHECKED read (D-007): `is_error` was tested above, so `.value`
    // reads clean — `raw` on a binding is a second spelling of exactly this,
    // which is why the D-163 licence refuses it (rule 3).
    pass r.value;
};

func:nothing_useful = NIL() never fails {
    pass NIL;                          // Result<NIL> is {i32} -- NIL is zero-sized
};

func:main = int32(cstring[]:_~argv) {
    int32:a = doubled_plus_one(5i32) ?! E9;
    int32:b = with_explicit_check(5i32) ?! E9;
    drop nothing_useful();             // discard the Result entirely
    drop wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (E19) { exit 1i32; },
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
