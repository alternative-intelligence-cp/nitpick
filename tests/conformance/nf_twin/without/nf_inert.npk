// expect-exit: 42
//
// D-163's contract changes NO emitted byte: this file and its twin
// (../with/nf_inert.npk) differ only in the `never fails` clauses, and the
// harness byte-compares their IR. The clause is a CHECKED CLAIM, not a codegen
// hint — `raw` lowers to the same extractvalue either way.
mod:nf_inert;

func:dbl = int32(int32:v) never fails { pass v * 2i32; };
func:effect = NIL(int32:_~v) never fails { pass NIL; };

func:main = int32(cstring[]:_~argv) {
    drop effect(3i32);
    int32:a = raw dbl(21i32);
    exit a;
};

func:failsafe = int32(tbb32:_~e) { exit 1i32; };
