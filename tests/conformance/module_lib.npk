// Subset 1 — the exporting half of the module test.
// pub marks exports; everything else is private to the file.

mod:module_lib;

pub struct:Token = {
    int32:kind;
    int32:start;
};

pub func:token_kind = int32(Token:t) {
    pass t.kind;
};

// Not exported -- must not be visible to the importer.
func:internal_helper = int32() {
    pass 0i32;
};
