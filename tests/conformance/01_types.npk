// Subset 1 — scalar types and casts.
// No floats: the compiler needs none, so the seed does no float arithmetic.
// tbb32 appears as an error-code type only: assignment and comparison, never
// arithmetic, so the seed needs no ERR or saturation logic.

func:widths = NIL() never fails {
    int8:a   = 1i8;
    int16:b  = 2i16;
    int32:c  = 3i32;
    int64:d  = 4i64;
    uint8:e  = 5u8;
    uint16:f = 6u16;
    uint32:g = 7u32;
    uint64:h = 8u64;

    bool:flag  = true;
    char8:ch   = 'x';

    // Widening is explicit (D-021): the only two cast forms are => and =>!.
    int64:wide = c => int64;

    // Wrapping on overflow is defined behaviour for plain integers (D-037).
    int32:wrapped = c + 1i32;

    pass NIL;
};

func:error_codes = NIL() never fails {
    tbb32:code = 0tbb32;
    bool:clean = (code == 0tbb32);      // comparison only — no arithmetic
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    drop widths();
    drop error_codes();
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (TbbErr) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
