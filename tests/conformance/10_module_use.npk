// Subset 1 — the importing half.
// One form only: wildcard, relative path. No selective imports, no aliases, no
// logical paths. Sufficient to write a multi-file compiler, and a fraction of
// the resolution logic in MODULE_REFERENCE 2.3.

use "09_module_lib.npk".*;

func:main = int32(cstring[]:_~argv) {
    Token:t = Token{ kind: 7i32, start: 0i32 };
    int32:k = raw token_kind(t);
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) { exit 1i32; };
