// Subset 1 — `pass (raw f(...))` where `f` returns Result<NIL>.
//
// THE SHAPE THE SEED MISCOMPILED (0.8.5): a NIL-returning function whose whole
// body is "call this and pass its verdict along". The seed's `pass` lowering
// saw a NIL return type and emitted ok WITHOUT EVALUATING the expression — the
// call never ran, and a callee's failure came back as success. Every diagnostic
// line the compiler printed lost its newline to the first half, and the
// compiler's whole error report went silent to the second.
//
// The two halves are asserted separately, because they fail separately: the
// EFFECT must run, and the ERROR must propagate carrying the same code.

error:E5;

struct:Box = { int32:v; };

func:bump = NIL(Box->:b) never fails {
    b.v = b.v + 1i32;
    pass NIL;
};

func:erring = NIL(Box->:b) {
    b.v = b.v + 10i32;
    fail E5;
};

func:via = NIL(Box->:b) never fails {
    pass (raw bump(b));
};

func:via_err = NIL(Box->:b) {
    pass (relay erring(b));
};

func:main = int32(cstring[]:_~argv) {
    Box:x = Box{ v: 1i32 };

    drop via(@x);
    if (x.v != 2i32)        { exit 10i32; }   // the call ran

    Result<NIL>:r = via_err(@x);
    if (x.v != 12i32)       { exit 11i32; }   // the effect preceded the fail
    if (!r.is_error)        { exit 12i32; }   // the error propagated
    if (r.err != E5)  { exit 13i32; }   // ... carrying the same code

    wild_release_all();

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (E5) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
