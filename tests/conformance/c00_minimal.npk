// Subset 1 — the smallest legal program.
// Every executable must define failsafe (D-013): it must exist, must not be
// empty, and must return a positive value (D-014).

mod:c00_minimal;
func:main = int32(cstring[]:_~argv) {
    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
