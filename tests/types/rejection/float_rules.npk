// expect-error: NITPICK-TYPE-030
// expect-error-at: 38:10
// expect-error: NITPICK-TYPE-030
// expect-error-at: 47:16
// expect-error: NITPICK-TYPE-030
// expect-error-at: 57:16
// expect-error: NITPICK-TYPE-030
// expect-error-at: 72:13
// expect-error: NITPICK-TYPE-030
// expect-error-at: 76:13
//
// D-143's float rules, refused by the CHECKER (language rules, not rungs): the
// storage-only flt128 -- no literals, no arithmetic, no comparison.
//
// THE RULES FOLLOW THE LITERAL'S WIDTH, WHATEVER GAVE IT ONE (DEF-206, 1.6.1e):
// an unsuffixed fraction takes the width of the float slot it sits in, and
// `flt128:x = 1.0;` passed the checker and died in the emitter
// (NITPICK-EMIT-002) on every compiler before landing 88. `comptime(...)` of an
// unsuffixed fraction is a third road to a width, with the same hole
// (`wide_comptime`). One helper is asked of the text on all three
// (`float_text_ok`).
//
// THE OTHER RULE THIS FILE HELD IS GONE (D-346, the user, 2026-10-01): a
// `flt32` literal carried "at most 15 significant digits". Its stated reason --
// a `flt32` literal lowered through a double, the two roundings held equal to
// one below sixteen digits -- was false (DEF-203), and since the constant is
// the nearest float whatever is written the rule protected nothing. The three
// `long_` functions were its sites; they are controls now, with the two that
// always were. What a float literal must still do is FIT its type:
// `float_fit.npk`.

mod:float_rules;
func:long_literal = flt32() never fails {
    pass 1.0000000000000001f32;
};

func:wide_literal = flt128() never fails {
    pass 1.0f128;
};

func:long_unsuffixed = flt32() never fails {
    flt32:x = 1.0000000000000001;
    pass x;
};

func:wide_unsuffixed = flt128() never fails {
    flt128:x = 1.0;
    pass x;
};

func:long_comptime = flt32() never fails {
    flt32:x = comptime(1.0000000000000001);
    pass x;
};

func:wide_comptime = flt128() never fails {
    flt128:x = comptime(1.0);
    pass x;
};

func:fifteen_digits = flt32() never fails {
    flt32:x = 0.123456789012345;
    pass x;
};

func:double_slot = flt64() never fails {
    flt64:x = 1.00000000000000000001;
    pass x;
};

func:wide_arith = flt128(flt128:a, flt128:b) never fails {
    pass (a + b);
};

func:wide_compare = bool(flt128:a, flt128:b) never fails {
    pass (a == b);
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:_~err) { exit 1i32; };
