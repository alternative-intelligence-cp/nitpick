// A CALLBACK IN A TRAIT METHOD'S SIGNATURE IS COMPARED STRUCTURALLY (DEF-56,
// 1.5.6b step 4c) -- and structurally means it still REFUSES what differs.
// Until the fix every function-typed parameter made the impl unmatchable
// (`backend/programs/trait_fn_param.npk` is the accepted half); these are the
// controls: a callback whose parameter type differs, one whose arity differs,
// one whose RETURN differs, and one whose `never fails` contract differs in
// either direction -- the caller hands the callback the TRAIT spells, so an
// impl that spells it otherwise is promising, or demanding, something else.
mod:trait_callback_sig;

struct:A = { int64:n; };
struct:B = { int64:n; };
struct:C = { int64:n; };
struct:D = { int64:n; };
struct:E = { int64:n; };

trait:Apply = { func:run = int64(Self:self, func int64(int64) never fails:cb); };

// the callback's parameter type differs
// expect-error: NITPICK-TYPE-014
impl:A:Apply = {
    func:run = int64(Self:self, func int64(int32) never fails:cb) { pass self.n; };
};

// its arity differs
// expect-error: NITPICK-TYPE-014
impl:B:Apply = {
    func:run = int64(Self:self, func int64(int64, int64) never fails:cb) { pass self.n; };
};

// its return differs
// expect-error: NITPICK-TYPE-014
impl:C:Apply = {
    func:run = int64(Self:self, func int32(int64) never fails:cb) { pass self.n; };
};

// the impl DROPS the callback's `never fails`
// expect-error: NITPICK-TYPE-014
impl:D:Apply = {
    func:run = int64(Self:self, func int64(int64):cb) { pass self.n; };
};

trait:Loose = { func:go = int64(Self:self, func int64(int64):cb); };
// ...and the impl ADDS one the trait did not promise its callers would supply
// expect-error: NITPICK-TYPE-014
impl:E:Loose = {
    func:go = int64(Self:self, func int64(int64) never fails:cb) { pass self.n; };
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
