// `complex<T>`: what refuses, by name (D-199, 1.3.6).
//
// TYPE-053 is the family's OWN rules — no `%`, `is_err` on float elements,
// `.abs()` on tfp elements, the element gate, the ctor's arity, pick
// selectors. The ordering refusal and mixing ride TYPE-008, and the casts
// that do not exist ride TYPE-032.
mod:complex_rules;

// The complex numbers have no total order — the ordering refusal rides the
// shared not-ordered code, with the mathematics in the message.
// expect-error: NITPICK-TYPE-008
func:no_order = bool(complex<flt64>:a, complex<flt64>:b) never fails {
    pass (a < b);
};

// No remainder either.
// expect-error: NITPICK-TYPE-053
func:no_mod = complex<flt64>(complex<flt64>:a, complex<flt64>:b) never fails {
    pass (a % b);
};

// A float carries NaN, not ERR.
// expect-error: NITPICK-TYPE-053
func:no_float_is_err = bool(complex<flt64>:a) never fails {
    pass (is_err(a));
};

// A fixed-point square root has no consumer; `.abs2()` is total everywhere.
// expect-error: NITPICK-TYPE-053
func:no_tfp_abs = tfp32(complex<tfp32>:a) never fails {
    pass (a.abs());
};

// The element gate: the ratified four only.
// expect-error: NITPICK-TYPE-053
func:bad_elem = int32(complex<int32>:_~a) never fails {
    pass 0i32;
};

// The ctor takes exactly two components.
// expect-error: NITPICK-TYPE-053
func:bad_arity = complex<flt64>() never fails {
    complex<flt64>:c = complex(1.0f64);
    pass c;
};

// A pick does not select on a complex.
// expect-error: NITPICK-TYPE-053
func:no_pick = int32(complex<flt64>:a) never fails {
    int32:r = 0i32;
    pick (a) {
        (*) { r = 1i32; }
    }
    pass r;
};

// The family computes only with itself.
// expect-error: NITPICK-TYPE-008
func:mixed = complex<flt64>(complex<flt64>:a) never fails {
    pass (a + 1.0f64);
};

// No casts, either direction: built with `complex(re, im)`, read with
// `.re()`/`.im()`.
// expect-error: NITPICK-TYPE-032
func:no_cast_out = flt64(complex<flt64>:a) never fails {
    pass (a =>! flt64);
};
// expect-error: NITPICK-TYPE-032
func:no_cast_in = complex<flt64>(flt64:v) never fails {
    pass (v =>! complex<flt64>);
};

func:main = int32(cstring[]:_~argv) { pass 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
