// expect-error-at: 43:14
// expect-error: NITPICK-TYPE-007
// expect-error-at: 44:5
// expect-error: NITPICK-TYPE-031
// expect-error-at: 45:15
// expect-error: NITPICK-TYPE-031
// expect-error-at: 46:15
// expect-error: NITPICK-TYPE-004
// expect-error-at: 47:15
// expect-error: NITPICK-TYPE-004
// expect-error-at: 48:15
// expect-error: NITPICK-TYPE-007
// expect-error-at: 49:15
