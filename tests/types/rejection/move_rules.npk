// D-183's ownership rules at the type level.
//
// `move T:p` marks a CONSUMING parameter: the caller transferred ownership in,
// so the callee owns the value. The DEFAULT is the other one, and it is D-065
// unchanged — passing transfers nothing, so an ordinary parameter is a value
// the callee may read and may not keep.

mod:move_rules;

struct:Box = { string:held; };

// YOU CANNOT TRANSFER WHAT YOU WERE ONLY LENT. `text` was lent, so there is no
// ownership here to move on — moving it would hand a second owner to the box
// while the caller still holds the first, which is the double free the whole
// rule exists to prevent, written one frame further down.
//
// This is what forces a function that STORES its argument to say so: storing
// needs `move`, `move` on a lent parameter is refused here, and the only way
// to write the function is to declare the parameter `move` — at which point
// its callers must transfer at the call site too. The chain closes without the
// escape analysis needing to learn about ownership.
// expect-error: NITPICK-TYPE-047
func:keeps_what_it_borrowed = NIL(Box->:b, string:text) never fails {
    b.held = move(text);
    pass NIL;
};

// The same body is correct once the parameter says it received ownership.
// (In `tests/accept/accept.npk`, with its callers transferring.)

// A TYPE WITH A DROP IS MOVE-ONLY (D-183 §4). `built` owns a heap body that
// scope exit will release, so copying it into a second binding would leave two
// owners and one double free. The transfer must be written (`move`), or the
// second name takes an explicit fresh copy (`.clone()`, allocating) — what it
// cannot be is silent.
// expect-error: NITPICK-TYPE-046
func:copies_an_owner = int32() {
    string:built = string_concat("ab", "cd");
    string:second = built;
    pass ((built.len + second.len) =>! int32);
};
// A `dyn` IS AN OWNER (D-183, 1.2.4): the coercion moved the concrete value
// into a heap cell only the fat pointer knows how to release — through the
// vtable's slot 0 — so copying a `dyn` place duplicates the cell's owner the
// same way copying a built string duplicates its body's.
trait:Says = { func:val = int32(Self:self); };
struct:Plain = { int32:v; };
impl:Plain:Says = { func:val = int32(Plain:self) { pass self.v; }; };

// expect-error: NITPICK-TYPE-046
func:copies_a_dyn = int32() never fails {
    Plain:p = Plain{ v: 4i32 };
    dyn Says:a = p;
    dyn Says:b = a;
    pass ((a.val() ?! Unreachable) + (b.val() ?! Unreachable));
};

// A CHANNEL TAKES OWNERSHIP OF ITS ELEMENT (D-072/D-183, 1.2.5b): the far
// side's recv hands the value to a new owner whose drop frees it, so a send
// of an owning PLACE must say `move` — a copy would leave the sender's
// binding and the ring both believing they own one body.
// expect-error: NITPICK-TYPE-046
async func:sends_a_copy = NIL() {
    Channel<string, 1i32, 8i64>:ch = channel() ?! Unreachable;
    string:s = string_concat("a", "b");
    await ch.send(s, raw duration_ms(1i64)) ?! Unreachable;
    pass NIL;
};

// AN ARENA IS AN OWNER (D-003/D-183, 1.2.5c): its scope exit destroys the
// slabs, so a copy would be two destroyers of one storage.
// expect-error: NITPICK-TYPE-046
func:copies_an_arena = int32() never fails {
    arena<int32>:a = arena_make(4i64);
    arena<int32>:b = a;
    pass 0i32;
};

// AN OWNING ELEMENT DOES NOT ENTER AN ARENA YET (D-183, 1.2.5c): `get` and
// `put` copy bytes, and a byte copy of an owner is two owners — one arena
// body freed twice. The generated deep-view accessors are the recorded
// answer; until then the arena refuses at its make.
// expect-error: NITPICK-TYPE-007
func:owns_in_an_arena = int32() never fails {
    arena<string>:a = arena_make(4i64);
    pass 0i32;
};

// A SHARED HOLD IS READ-ONLY (D-056, 1.1.11b): a write through an
// `RGuard.value` is the unsynchronized mutation the write lock exists to
// serialize.
// expect-error: NITPICK-TYPE-007
async func:writes_through_a_read = NIL(RwLock<int32, 3i32>->:r) {
    RGuard<int32>:g = relay await r.read(raw duration_ms(5i64));
    g.value = 4i32;
    pass NIL;
};

// --- THE CONSUMING PICK, AND WHAT IT REPLACES (D-216, 1.4.3b) ---------------
//
// A lending pick's arm binding is a COPY of the payload — the emitter stores
// the whole `{ptr, len, cap}` — so it is a second owner of one body that
// outlives the enum whenever it escapes. An executed probe read the
// allocator's 0xAA poison through one. D-216 recorded this as already refused
// by TYPE-046; it was not, because the move-only rule fires on reading a
// PLACE and a pattern binding is not one.

enum:MrRes = { Note(string); Blank; };

// A LENDING BIND IS A VIEW NOW (D-266, 1.5.2h): the payload in place, read
// through the binding, no copy -- ACCEPTED (a control; it refused TYPE-046
// from 1.4.3b until D-266). `pick_view_rules.npk` holds what a view refuses.
func:mr_lending_bind = int64(MrRes:r) never fails {
    pick (r) {
        (MrRes.Note(s)) { pass s.len; },
        (MrRes.Blank)   { pass 0i64; }
    }
    pass 0i64;
};

// `move` on a selector that owns nothing is the same meaningless move it is
// anywhere else.
// expect-error: NITPICK-TYPE-046
func:mr_consume_nonowner = int32(int32:v) never fails {
    pick (move(v)) {
        (0i32) { pass 1i32; },
        (*)    { pass 2i32; }
    }
    pass 0i32;
};
