// THE ROADS D-361'S CHECK MISSED (DEF-423, DEF-477, landing 177c's rebuild, the second rulings R5 to R9, R15, R16, R17): a value of `wild` provenance enters a plain slot only through `v =>! T->`.
// Each module is one cell. `tests/analysis/rejection/wild_door_roads.npk` holds these rulings' BORROW family: a TYPE report here stops the analyses, which is why the two are two files.
mod:wild_into_plain_roads;

// R5: AN ELEMENT OF A `List` OR ANY OTHER INDEXABLE STRUCT ANSWERS NO, SO `wl[0i64]` IS A PLAIN POINTER AND `[3i64]` OVER IT IS TYPE-106. `dalloc(wl[0i64])` IS `wild_door_roads.npk`'s.
mod:w1_wild_list_elem_index = {
func:f = int64() never fails { int64[1]:a = [5i64]; List<int64->>:l = raw list_init::<int64->>(1i64); drop list_push(@l, @a[0i64]); wild List<int64->>:wl = move(l); pass wl[0i64][3i64] - wl[0i64][3i64] + 7i64; };
};
mod:w2_struct_wild_list_elem_index = {
struct:HL = { wild List<int64->>:ps; };
func:f = int64() never fails { int64[1]:a = [5i64]; List<int64->>:l = raw list_init::<int64->>(1i64); drop list_push(@l, @a[0i64]); HL:h = HL{ ps: move(l) }; pass h.ps[0i64][3i64] - h.ps[0i64][3i64] + 7i64; };
};
mod:w3c_ctl_plain_list_elem_index = {
func:f = int64() never fails { int64[1]:a = [5i64]; List<int64->>:l = raw list_init::<int64->>(1i64); drop list_push(@l, @a[0i64]); pass l[0i64][3i64] - l[0i64][3i64] + 7i64; };
};
mod:w11_wild_struct_member_index = {
struct:Bp = { int64->:v; };
func:f = int64() never fails { int64:x = 5i64; wild Bp:w = Bp{ v: @x }; pass w.v[3i64] - w.v[3i64] + 7i64; };
};

// R6: A SLICE WHOSE ELEMENT HOLDS A POINTER, OVER A `wild` PLACE OR FROM `#wild_slice<T>`, ENTERS ONLY A `wild` SLOT, AND ITS SPELLING INTO A PLAIN ONE IS THE CROSSING.
mod:a1_view_of_wild_array = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->[1]:a = [NULL]; string->[]:v = a[0i64...1i64]; v[0i64] = @s; drop take(a[0i64]); pass s.len + 2i64; };
};
mod:a1b_view_dalloc = {
func:f = int64() never fails { int64:x = 5i64; wild int64->[1]:a = [NULL]; int64->[]:v = a[0i64...1i64]; v[0i64] = @x; dalloc(a[0i64]); pass 7i64; };
};
mod:a1p_view_param = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:a1p = NIL(string->:q) never fails { wild string->[1]:a = [NULL]; string->[]:v = a[0i64...1i64]; v[0i64] = q; drop take(a[0i64]); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); drop a1p(@s); pass s.len + 2i64; };
};
mod:a1q_slice_call = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:putv = NIL(string->[]:v, string->:q) never fails { v[0i64] = q; pass NIL; };
func:a1q = NIL(string->:q) never fails { wild string->[1]:a = [NULL]; drop putv(a[0i64...1i64], q); drop take(a[0i64]); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); drop a1q(@s); pass s.len + 2i64; };
};
mod:a1r_view_param_dalloc = {
func:a1r = NIL(int64->:q) never fails { wild int64->[1]:a = [NULL]; int64->[]:v = a[0i64...1i64]; v[0i64] = q; dalloc(a[0i64]); pass NIL; };
func:f = int64() never fails { int64:x = 5i64; drop a1r(@x); pass 7i64; };
};
mod:xd1_wild_slice_ptrs_plain = {
func:f = int64() never fails { int64:x = 5i64; wild int8->:blk8 = alloc(32i64); discard(memset(blk8, 0i64, 32i64)); wild int64->->:blk = blk8 =>! wild int64->->; int64->[]:v = #wild_slice<int64->>(blk, 4i64); v[0i64] = @x; dalloc(blk[0i64]); dalloc(blk8); pass 7i64; };
};
mod:xd2_wild_slice_ptrs_call = {
func:putv = NIL(int64->[]:v, int64->:q) never fails { v[0i64] = q; pass NIL; };
func:f = int64() never fails { int64:x = 5i64; wild int8->:blk8 = alloc(32i64); discard(memset(blk8, 0i64, 32i64)); wild int64->->:blk = blk8 =>! wild int64->->; drop putv(#wild_slice<int64->>(blk, 4i64), @x); dalloc(blk[0i64]); dalloc(blk8); pass 7i64; };
};
mod:xd5_struct_elem_holder = {
struct:H = { int64->:p; };
func:f = int64() never fails { int64:x = 5i64; wild H[1]:a = [H{ p: NULL =>! int64-> }]; H[]:v = a[0i64...1i64]; v[0i64] = H{ p: @x }; pass 7i64; };
};
mod:xd5_struct_elem_holder2 = {
struct:H = { int64->:p; };
func:hq = NIL(int64->:q) never fails { wild H[1]:a = [H{ p: q =>! wild int64-> }]; H[]:v = a[0i64...1i64]; v[0i64] = H{ p: q }; pass NIL; };
func:f = int64() never fails { int64:x = 5i64; drop hq(@x); pass 7i64; };
};
mod:xd6_wild_slice_ptrs_param = {
func:a1w = NIL(int64->:q) never fails { wild int8->:blk8 = alloc(32i64); discard(memset(blk8, 0i64, 32i64)); wild int64->->:blk = blk8 =>! wild int64->->; int64->[]:v = #wild_slice<int64->>(blk, 4i64); v[0i64] = q; dalloc(blk[0i64]); dalloc(blk8); pass NIL; };
};
mod:xd7_wild_slice_ptrs_call_param = {
func:putv = NIL(int64->[]:v, int64->:q) never fails { v[0i64] = q; pass NIL; };
func:a1w = NIL(int64->:q) never fails { wild int8->:blk8 = alloc(32i64); discard(memset(blk8, 0i64, 32i64)); wild int64->->:blk = blk8 =>! wild int64->->; drop putv(#wild_slice<int64->>(blk, 4i64), q); dalloc(blk[0i64]); dalloc(blk8); pass NIL; };
};

// R7: AT D-361'S CHECK A CHECKED CAST COUNTS WHEN ITS TARGET IS `wild` OR ITS OPERAND IS OF `wild` PROVENANCE.
mod:a3_checked_cast = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:gp = NIL(string->->:c, string->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->:w = NULL; drop gp((@w) => wild string->->, @s); drop take(w); pass s.len + 2i64; };
};
mod:a3b_checked_cast_dalloc = {
func:gi = NIL(int64->->:c, int64->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { int64:x = 5i64; wild int64->:w = NULL; drop gi((@w) => wild int64->->, @x); dalloc(w); pass 7i64; };
};
mod:a3h_bind_checked_cast = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:gp = NIL(string->->:c, string->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->:w = NULL; string->->:c = (@w) => wild string->->; drop gp(c, @s); drop take(w); pass s.len + 2i64; };
};
mod:a3i_double_checked = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:gp = NIL(string->->:c, string->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->:w = NULL; drop gp(((@w) => wild string->->) => string->->, @s); drop take(w); pass s.len + 2i64; };
};

// R7: THE OTHER READERS STAY: A `move` THROUGH SUCH A CAST IS TYPE-104, A RETYPE TYPE-032.
mod:xg2_move_via_checked_wild = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:mv = string(string->:p) { string:t = move(<-(p => wild string->)); pass move(t); };
func:f = int64() never fails { string:s = raw mks(); Result<string>:r = mv(@s); pass 7i64; };
};
mod:xg2c_ctl_move_plain = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:mv = string(string->:p) { string:t = move(<-p); pass move(t); };
func:f = int64() never fails { string:s = raw mks(); Result<string>:r = mv(@s); pass 7i64; };
};
mod:xg3_move_via_checked_wild_local = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:f = int64() never fails { string:s = raw mks(); string->:p = @s; string:t = move(<-(p => wild string->)); pass t.len + 2i64; };
};
mod:xg1_retype_via_checked_wild = {
func:f = int64() never fails { int64:x = 7i64; uint8->:p = (@x => wild int64->) =>! uint8->; pass (<-p) => int64; };
};
mod:xg1b_retype_via_checked_wild = {
func:f = int64() never fails { int64:x = 7i64; uint8->:p = ((@x) => wild int64->) =>! uint8->; pass ((<-p) => int64); };
};
mod:xg1c_ctl_retype_plain = {
func:f = int64() never fails { int64:x = 7i64; uint8->:p = (@x) =>! uint8->; pass (<-p) => int64; };
};

// R8's D-361 HALF: A `wild` RECEIVER OF A PLAIN PARAMETER IS AN ARGUMENT.
mod:a4f_wild_receiver_plain_param = {
func:rd1 = int64(int64->:q) never fails { pass <-q; };
func:f = int64() never fails { wild int64->:w = alloc(8i64) =>! wild int64->; <-w = 7i64; int64:k = raw w.rd1(); dalloc(w); pass k; };
};
mod:a4g_ctl_wild_arg_plain_param = {
func:rd1 = int64(int64->:q) never fails { pass <-q; };
func:f = int64() never fails { wild int64->:w = alloc(8i64) =>! wild int64->; <-w = 7i64; int64:k = raw rd1(w); dalloc(w); pass k; };
};
mod:a4d_wild_local_receiver = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:gp = NIL(string->->:c, string->:q) never fails { <-c = q; pass NIL; };
func:f = int64() never fails { string:s = raw mks(); wild string->:w = NULL; drop w.gp(@s); drop take(w); pass s.len + 2i64; };
};

// R9, DEF-477: A `give`'S VALUE IS JUDGED IN THE SLOT THE `pick` STANDS IN, AS A TERNARY'S ARM IS; A `pick` WHOSE PARENT WROTE `ptr_ok` ISN'T.
mod:p37_give_wild_to_plain = {
func:f = int64() never fails { int64:j = 1i64; wild int64->:w = alloc(8i64) =>! wild int64->; <-w = 7i64; int64->:p = pick (j) { (*) { give w; } }; int64:k = <-p; dalloc(w); pass k; };
