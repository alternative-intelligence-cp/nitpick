// A PROGRAM'S OWN IMPL OF A PAIR THE PRELUDE COVERS WAS THE COHERENCE VIOLATION
// IT ALWAYS WAS (TYPE-013; D-257, 1.5.2b step 2) UNTIL THE ORPHAN RULE (D-359,
// 1.6.1e landing 124): `impl:int32:Ord` names no type or trait declared in this
// manifest's tree -- `int32` is the compiler's, `Ord` the prelude's -- so it is
// NITPICK-TYPE-099 at the impl, once, and the coherence question is never asked
// of it (an orphan stays in the table marked so; `check_coherence` skips it). The
// pair the prelude does NOT cover (`impl:bool:Ord`), admitted until 124 and S-37's
// question, is the same orphan. TYPE-013's cases: coherence.npk, impl_overlap.npk.

mod:scalar_impl_taken;
// expect-error: NITPICK-TYPE-099
// expect-error: NITPICK-TYPE-099
impl:int32:Ord = { func:cmp = Ordering(int32:self, int32:other) never fails { if (self < other) { pass Ordering.Less; } if (self > other) { pass Ordering.Greater; } pass Ordering.Equal; }; };
impl:bool:Ord = { func:cmp = Ordering(bool:self, bool:other) never fails { pass Ordering.Equal; }; };
func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
