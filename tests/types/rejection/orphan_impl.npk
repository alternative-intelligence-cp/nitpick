struct:Pt = { int32:x; };
struct:Box<T> = { T:v; };

impl:bool:Ord = { func:cmp = Ordering(bool:self, bool:other) { pass Ordering.Equal; }; };          // a builtin, the prelude's trait
impl:int32:Ord = { func:cmp = Ordering(int32:self, int32:other) { pass Ordering.Equal; }; };       // a pair the prelude covers: TYPE-099 alone
impl:List<int32>:ToString = { func:to_string = string(List<int32>:self) { pass "l"; }; };          // a prelude type over a builtin argument
impl:<T>:List<T>:ToString = { func:to_string = string(List<T>:self) { pass "f"; }; };              // a family impl over a prelude type
impl:<T: Own>:T:ToString = { func:to_string = string(T:self) { pass "b"; }; };                     // a blanket impl of a prelude trait
impl:string = { func:twice = string(string:self) never fails { pass "s"; }; };                     // an inherent impl on a builtin
impl:string:Copy = { };                                                                            // TYPE-099 alone, not TYPE-087
impl:Ordering:ToString = { func:to_string = string(Ordering:self) { pass "o"; }; };                // the prelude's type and trait

// CONTROLS: each names a type or a trait of this tree, and carries no code.
impl:bool:Own = { func:own = int32(bool:self) never fails { pass 1i32; }; };                       // this tree's trait on a builtin
impl:Pt:ToString = { func:to_string = string(Pt:self) { pass "p"; }; };                            // the prelude's trait on this tree's type
impl:List<Pt>:ToString = { func:to_string = string(List<Pt>:self) { pass "lp"; }; };               // a type argument counts
impl:<T>:Box<T>:ToString = { func:to_string = string(Box<T>:self) { pass "bx"; }; };               // this tree's family
impl:<T: Own>:T:Own2 = { func:own2 = int32(T:self) never fails { pass 2i32; }; };                   // a blanket impl of this tree's trait
impl:Ordering:Own = { func:own = int32(Ordering:self) never fails { pass 3i32; }; };               // the prelude's type, this tree's trait
