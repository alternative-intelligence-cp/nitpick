// R10'S CLOSED CHOICE, A LEGAL SHAPE REFUSED: A MACRO'S `#m(...)` IN A GENERIC COUNTS AS THE WORD, BECAUSE ITS BODY ISN'T IN THE DECLARATION'S TOKENS. HERE THE MACRO NEVER TOUCHES `T` AND THE PROGRAM READ 65 BEFORE THE RULING. PINNED SO THAT RELAXING IT LATER SHOWS UP.
mod:t18_macro_stmt_no_T = {
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:takex = NIL(wildx string->:x) never fails { string:t = move(<-x); pass NIL; };
func:idp = string->(string->:q) never fails { pass q; };
func:rdb = int64(uint8->:p) never fails { pass (<-p) => int64; };
struct:H = { string->:q; };
struct:W = { wild string->:p; };
struct:WX = { wildx string->:p; };
struct:M = { int64:k; };
struct:Ma = { int64[2]:a; int64:k; };
enum:En = { Aa(int64); Bb; };
impl:M = {
    func:setk = NIL(M->:self, int64:v) never fails { self.k = v; pass NIL; };
    func:getk = int64(M->:self) never fails { pass self.k; };
    func:byv = int64(M:self, wild string->:x) never fails { string:t = move(<-x); pass self.k; };
    func:wself = int64(wild M->:self) never fails { pass self.k; };
    func:wxself = int64(wildx M->:self) never fails { pass self.k; };
};
trait:Tw = { func:tm = int64(wild Self->:self) never fails; func:tb = int64(Self:self, wild string->:x) never fails; };
impl:M:Tw = { func:tm = int64(wild M->:self) never fails { pass self.k; }; func:tb = int64(M:self, wild string->:x) never fails { string:t = move(<-x); pass self.k; }; };
func:putg<T> = NIL(wild T->:c, move T:v) never fails { <-c = move(v); pass NIL; };
struct:G<T> = { T:p; };
func:hg<T> = G<T>(move T:v) never fails { G<T>:g = G{ p: move(v) }; pass move(g); };
func:wret<T> = wild T->(wild T->:c) never fails { pass c; };
macro:wm = () { wild int8->:c = alloc(8i64) =>! wild int8->; dalloc(c); };
func:noword<T> = T(move T:v) never fails { #wm(); pass move(v); };
func:f = int64() never fails { string:s = raw mks(); string->:q = raw noword::<string->>(@s); pass q.len; pass s.len; };
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)       { exit 74i32; },
        (IntOverflow)       { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (HeapBadRequest)    { exit 93i32; },
        (WildLeak)          { exit 94i32; },
        (LimitViolated)     { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (StackExhausted)    { exit 96i32; },
        (MachineFault)      { exit 97i32; },
        (OutOfBounds)       { exit 98i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
