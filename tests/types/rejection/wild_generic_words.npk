// A GENERIC'S `wild` WORD (R10, landing 177c's rebuild): a `#` sigil that reads storage, `=>!` and the `wild` token each count as the word, so a generic spelling none of them keeps its D-225
// reading and one spelling any is refused at an instance whose type argument holds an address (`NITPICK-TYPE-107`). `g6` is an impl's method; its TYPE-046 is the cell's own spelling. The concrete twin is
// the crossing as written, with the pointer type on the page, and stays legal: DEF-425's row. `header_ptr_uses_ok.npk`'s `g3`, `xe2` are the int instances.
mod:wild_generic_words;
mod:g1_no_word_ptr_add = {
struct:Cell = { wild int8->:blk; };
func:clob = int64() never fails { int64[16]:z = [9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64, 9i64]; pass z[3i64]; };
func:put<T> = NIL(Cell->:c, move T:v) never fails { <-(#ptr_add<T>(c.blk, 0i64)) = move(v); pass NIL; };
func:get<T> = T(Cell->:c) never fails { pass (<-(#ptr_add<T>(c.blk, 0i64))); };
func:stash = NIL(Cell->:c) never fails { int32:x = 7i32; drop put::<int32->>(c, @x); pass NIL; };
func:rd = int64(Cell->:c) never fails { int32->:q = raw get::<int32->>(c); int64:d = raw clob(); pass ((<-q) => int64) + d - d; };
func:f = int64() never fails { Cell:c = Cell{ blk: alloc(16i64) }; drop stash(@c); int64:seen = raw rd(@c); dalloc(c.blk); pass seen; };
func:cell_main = int32() { pass (((raw f()) + 60i64) =>! int32); };
};
