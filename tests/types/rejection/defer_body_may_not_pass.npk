error:E5_dl_pass;
func:g2 = int64(int64:n) { if (n > 5i64) { fail E5_dl_pass; } pass 7i64; };
func:f = int64(int64:n) never fails { defer { if (n > 5i64) { pass 1i64; } } pass 7i64; };
};
