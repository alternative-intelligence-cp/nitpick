// expect-error: NITPICK-TYPE-029
//
// A CONSTRUCT THE FRONTEND ACCEPTS AND NO TIER SUPPLIES A TYPE FOR.
//
// D-085's rule one layer up: the parser never restricts, so `simd(…)` parses — and
// `TYPE_REFERENCE` section 14 puts `simd<T, N>` in Tier 0 with nothing implementing
// it. Saying so is the point. Typing it as INVALID would accept it silently, which
// is what happened until 0.6.7; inventing a type would make the program mean
// something the language has not decided yet.
//
// THE COMPONENTS ARE STILL TYPED, so a mistake inside one would be reported rather
// than hidden behind the tier.
mod:tier;

func:main = int32(cstring[]:_~argv) {
    int32:v = simd(1.0f64, 2.0f64) => int32;
    exit 0i32;
};
