// `List<T>` IS MOVE-ONLY (D-247, 1.5.1b step 5): it owns its block and its
// elements, so a copy would be two owners and one double free (TYPE-046), and
// a moved-from list is invalid until assigned again (TYPE-047) -- the rules
// every owner already lives under, reaching the compiler's own collection.
mod:list_moved;
use "../../../src/frontend/list.npk".*;

// expect-error: NITPICK-TYPE-046
// expect-error-at: 12:5
func:copies = int64() never fails {
    List<int32>:a = raw list_init::<int32>(4i64);
    List<int32>:b = a;
    pass (a.count + b.count);
};

struct:Holder = { List<int32>:kept; };

// A LENT list cannot be moved (TYPE-047): the caller still owns it. Storing
// it needs a `move` parameter, at which point the callers transfer too.
// expect-error: NITPICK-TYPE-047
// expect-error-at: 23:14
func:keeps_what_it_borrowed = NIL(Holder->:h, List<int32>:l) never fails {
    h.kept = move(l);
    pass NIL;
};
