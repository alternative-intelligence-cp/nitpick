// expect-error: NITPICK-TYPE-069
// expect-error-at: 15
//
// A `decreases` IN A `comptime` BODY IS EVALUATED (1.5.8c step 3, D-304): the
// compile-time evaluator checks the measure where it runs the loop, as the
// emitter's check does at run time (DEF-29: the evaluator agrees with the
// emitter) and as a `prove` in a `comptime` body is evaluated (1.5.4, L-18). A
// measure that does not shrink is a counterexample, reported once at the loop.
mod:comptime_decreases;

comptime func:climb = int32(int32:n) {
    int32:i = 0i32;
    // the measure `n - i` GROWS: the counter walks the wrong way, and the loop
    // ends only by its own exit test -- the check sees the growth on the second trip
    while (i > (0i32 - 4i32)) decreases n - i {
        i = i - 1i32;
    }
    pass i;
};

func:main = int32(cstring[]:_~argv) {
    int32:a = comptime(climb(3i32));
    exit 0i32;
};
