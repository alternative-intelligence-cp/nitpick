// expect-error-at: 73:41
// expect-error: NITPICK-TYPE-031
// expect-error-at: 74:41
// expect-error: NITPICK-TYPE-031
// expect-error-at: 75:42
// expect-error: NITPICK-TYPE-031
// expect-error-at: 76:42
// expect-error: NITPICK-TYPE-031
// expect-error-at: 77:44
// expect-error: NITPICK-TYPE-031
// expect-error-at: 80:15
