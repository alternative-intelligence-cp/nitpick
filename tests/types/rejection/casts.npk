// Casts: `=>` refuses possible loss, `=>!` is the sole opt-out (D-021).
//
// The opt-out is EXPLICIT AND GREPPABLE, which is the whole design: a safety
// property is absolute by default and suspended only through a construct an
// auditor can search for.

// A narrowing cast can lose the value, so `=>` refuses it and names the operator
// that says "I know".
// expect-error: NITPICK-TYPE-009
func:narrowing = int32(int64:wide) never fails {
    int32:small = wide => int32;
    pass small;
};

// A cast between types that are not numbers at all is not a width question. A
// character is not its code point (D-005) — and there is NO conversion to
// `bool`, so this is not the lossy code but its own (1.0.8): `=>!` opts out of
// a check, and there is no check here to opt out of.
// expect-error: NITPICK-TYPE-032
func:char_to_bool = bool(char8:c) never fails {
    bool:b = c => bool;
    pass b;
};

// A STRUCT IS NOT A DESCRIPTOR (1.0.8). Until then the kernel-identifier arm
// tested only the target, so `Point =>! fd` — and a string, a pointer, a float
// — was accepted as an "opt-out": a value with no meaning as a handle, asserted
// into one. Only an integer may be (D-042, D-095), and only with `=>!`.
// expect-error: NITPICK-TYPE-032
struct:Point = { int32:x; int32:y; };
func:forged = fd(Point:p) never fails {
    fd:h = p =>! fd;
    pass h;
};

// LEAVING A `tbb` IS RANGE-CLASSIFIED LIKE ANY NUMERIC PAIR (D-144 as amended
// at 1.3.2): a narrower target can lose a genuine value, so the checked
// spelling refuses it exactly as it refuses `int64 => int8`. Until 1.3.2 every
// int/float target rode `=>` and the emitter resized the carrier raw — a
// silent loss under the checked spelling.
// expect-error: NITPICK-TYPE-009
func:tbb_narrow_out = int8(tbb64:v) never fails {
    int8:small = v => int8;
    pass small;
};

// The sign crossing is the same question: a negative tbb value has no unsigned
// image, so `=>` refuses and `=>!` is the acknowledgment (the prelude's own
// Hash impls spell it with the bang).
// expect-error: NITPICK-TYPE-009
func:tbb_sign_out = uint32(tbb32:v) never fails {
    uint32:u = v => uint32;
    pass u;
};

func:main = int32(cstring[]:_~argv) { pass 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
