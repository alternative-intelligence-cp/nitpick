// expect-error: NITPICK-TYPE-043
// expect-error-at: 32:24
// expect-error: NITPICK-TYPE-043
// expect-error-at: 38:24
// expect-error: NITPICK-TYPE-039
// expect-error-at: 39:5
// expect-error: NITPICK-TYPE-043
// expect-error-at: 39:6
//
// DEF-149 (1.6.1e step 2; the library listener's F-023): AN UN-AWAITED ASYNC
// METHOD CALL IS REFUSED as the free-function call always was -- `r.read(buf,
// d)` bound to a `Result`, a bare `obj.run()` on an impl's async method, a bare
// call through a `dyn` -- `NITPICK-TYPE-043` at the call, where each compiled to
// a call of the coroutine's undefined symbol that `llc` refused (a rule written
// for one spelling owed to the other). The controls: the call awaited, and a
// `NIL` method spawned with `drop` (a spawned task's value has nowhere to go,
// D-177, so the spawn control is a `NIL` method). A bare `j.run();` statement is
// also TYPE-039, as a bare free call `run();` has always been.
mod:async_method_bare;

trait:Runner = {
    async func:run = int32(Self->:self);
    async func:tick = NIL(Self->:self);
};
struct:Job = { int32:n; };
impl:Job:Runner = {
    async func:run = int32(Job->:self) { pass (self.n + 1i32); };
    async func:tick = NIL(Job->:self) { pass NIL; };
};

async func:through_dyn = int32(dyn Runner:d) {
    Result<int32>:r = d.run();
    pass 0i32;
};

async func:bare = int32() {
    Job:j = Job{ n: 1i32 };
    Result<int32>:a = j.run();
    j.run();
    pass 0i32;
};

async func:fine = int32() {
    Job:j = Job{ n: 1i32 };
    int32:v = await j.run() ?| 0i32;
    drop j.tick();
    pass v;
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};