// expect-error: NITPICK-TYPE-026
// expect-error: NITPICK-TYPE-027
// expect-error: NITPICK-TYPE-028
// expect-error: NITPICK-TYPE-007
//
// A STRUCT LITERAL WAS NOT CHECKED AT ALL until 0.6.7 (D-129).
// `ExprStructLiteralExpr` had no case in `type_of_expr_inner`, so it fell through
// to type `0` — the INVALID type, which exists so one bad annotation produces one
// diagnostic instead of a cascade, and which is therefore SILENT. Every case in
// this file compiled clean.
//
// FOUR RULES, THREE NEW CODES, and they are separate for the reason D-120 gives for
// exhaustiveness having three: a field that does not exist is fixed by changing the
// name or the struct, a mismatched value by changing the value, and a missing field
// by adding one. One code would make three rules look like one coincidence.
mod:struct_literals;

struct:Point = {
    int32:x;
    int32:y;
};

// `zzz` is not a field. (`y` is missing too, and both are reported: fixing the name
// does not make the literal complete, so telling the reader one at a time would
// take two rounds.)
func:names_a_field_that_is_not_there = NIL() {
    Point:p = Point{ x: 1i32, zzz: 3i32 };
    discard(p.x);
    pass NIL;
};

// THE ONE THAT IS A SAFETY PROPERTY. There is no field-default syntax, so `y` would
// hold nothing — and an unassigned binding is what D-010's definite assignment
// refuses everywhere else in the language. A struct literal was the one place a
// value could come into existence without anybody choosing it.
func:leaves_a_field_with_no_value = NIL() {
    Point:p = Point{ x: 1i32 };
    discard(p.x);
    pass NIL;
};

// The same field twice. Taking the last silently discards the first, which is the
// lost-value defect `Result{value: a, value: b}` already has its own code for.
func:gives_one_field_twice = NIL() {
    Point:p = Point{ x: 1i32, x: 2i32, y: 3i32 };
    discard(p.x);
    pass NIL;
};

// And the value is checked against the FIELD's type, which is the ordinary mismatch
// and keeps the ordinary code.
func:gives_a_field_the_wrong_type = NIL() {
    Point:p = Point{ x: 1i32, y: true };
    discard(p.x);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
