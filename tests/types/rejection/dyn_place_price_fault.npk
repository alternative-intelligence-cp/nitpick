// expect-error: NITPICK-TYPE-116
// expect-error-at: 30:17
mod:dyn_place_price_fault;
error:E9;

// D-370'S PRICE, CLASS 1, A FAULT ON MAIN (management_67's `def710dyn/dyn_mut_uaf`): `callit(h)` copied `h` into the lent `dyn`'s cell,
// `op` freed the buffer the copy shares and stored a new one in the copy, and `h.b` read the freed buffer (97 under the detector on
// main). Refused now (`NITPICK-TYPE-116`); `move(h)`, a `dyn` held from the start or `DHold->` with `@h` are the roads.

trait:Tr = { func:peek = int32(Self:self) never fails; func:op = NIL(Self->:self) never fails; };
struct:DHold = { buffer:b; };
impl:DHold:Tr = {
    func:peek = int32(DHold:self) never fails { pass (self.b[0i64] => int32); };
    func:op = NIL(DHold->:self) never fails {
        buffer:nb = buffer_new(16i64);
        nb[0i64] = 7u8;
        self.b = move(nb);
        pass NIL;
    };
};
func:callit = NIL(dyn Tr:d) never fails {
    drop d.op();
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    buffer:bb = buffer_new(4096i64);
    bb[0i64] = 42u8;
    DHold:h = DHold{ b: move(bb) };
    drop callit(h);   // site NITPICK-TYPE-116
    int32:v = h.b[0i64] => int32;
    exit v;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (StackExhausted) { exit 96i32; },
        (MachineFault)   { exit 97i32; },
        (Unreachable)    { exit 95i32; },
        (HeapOom)        { exit 92i32; },
        (HeapBadRequest) { exit 91i32; },
        (WildLeak)       { exit 94i32; },
        (OutOfBounds)    { exit 93i32; },
        (E9)             { exit 9i32; },
        (*)              { exit 99i32; }
    }
    exit 99i32;
};
