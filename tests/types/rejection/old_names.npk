// expect-error: NITPICK-TYPE-060
// expect-error: NITPICK-TYPE-060
//
// `old(…)` NAMES PARAMETERS ONLY (1.5.3 step 0; D-243 read literally): the
// value at the function's ENTRY exists for a parameter and for nothing else.
// A local declared before the loop and a `for` binding have no entry value,
// and the checker admitted both until this step (the emitter would have
// snapshotted a slot that did not exist yet). The control, `old(n)` of a
// parameter in an `ensures` and in an invariant, is accepted.
mod:old_names;

func:sum_local = int32(int32:n) {
    int32:total = 0i32;
    int32:i = 0i32;
    while (i < n) invariant total >= old(total) { total = total + i; i = i + 1i32; }
    pass total;
};

func:sum_binding = int32(int32:n) {
    int32:acc = 0i32;
    for (int32:k in 0i32...n) invariant acc >= old(k) { acc = acc + k; }
    pass acc;
};

func:control = int32(int32:n) ensures result >= old(n) {
    int32:i = 0i32;
    while (i < n) invariant i <= old(n) { i = i + 1i32; }
    pass i;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
