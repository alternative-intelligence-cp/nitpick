// expect-error: NITPICK-TYPE-007
// expect-error-at: 44:39
// 2026-11-21 (landing 177d2e, row 5: DEF-528, form D528-4; rulings l.22208, l.22666). D-183'S QUESTION AT THE INSTANCE: a generic `arena<T>` or
// `shared_arena<T>` whose substituted element owns heap storage (a `string`, a `dyn Tr`, a guard holder) is refused NITPICK-TYPE-007 at the
// instance (`type_subst`'s arena arms ask `type_drops`), as the same arena spelled at the concrete type is on main. PRICE AT PARITY (D528's table,
// accepted at l.22208 item 2): a generic body's `arena<dyn Tr>` or `shared_arena<dyn Tr>`, used with a `move` or a fresh value and never read back:
// exit 42 on main (226ebb99) on every road 0-8, -O0 and -O2, and under the detector; refused here at the instance. Its spelled twin,
// `generic_arena_twin_g4_tw_concrete.npk`, is TYPE-007 on main. Way out: a concrete non-owning element (an index, a `Handle<Concrete>` into a
// spelled arena of plain data), or a `List<dyn Tr>`. From seat D528's cells,
// `Team/TMP/plan-177d2e-d528-2026-11-20/cells/a4g/g4_salloc_tmp_part2.npk`.
mod:generic_arena_price_g4_salloc_tmp_part2;
error:E9;

trait:Tr = { func:peek = int32(Self:self) never fails; func:op = NIL(Self->:self) never fails; };
struct:DHold = { buffer:b; };
impl:DHold:Tr = {
    func:peek = int32(DHold:self) never fails { pass (self.b[0i64] => int32); };
    func:op = NIL(DHold->:self) never fails {
        buffer:nb = buffer_new(16i64);
        nb[0i64] = 7u8;
        self.b = move(nb);
        pass NIL;
    };
};
func:callit = NIL(dyn Tr:d) never fails {
    drop d.op();
    pass NIL;
};
func:peekit = int32(dyn Tr:d) never fails {
    pass (raw d.peek());
};
func:yes = bool() never fails { pass true; };
func:mkh = DHold() never fails {
    buffer:bb = buffer_new(4096i64);
    bb[0i64] = 42u8;
    pass DHold{ b: move(bb) };
};
struct:W = { DHold:h; int32:k; };
func:mkw = W() never fails {
    pass W{ h: raw mkh(), k: 1i32 };
};
func:mksar<T> = shared_arena<T>() never fails { pass shared_arena_make(4i64); };
func:work = int32() {
    shared_arena<dyn Tr>:a = raw mksar::<dyn Tr>();
    Handle<dyn Tr>:hd = a.alloc((raw mkw()).h);
    pass 42i32;
};
func:main = int32(cstring[]:_~argv) {
    int32:r = work() ?! E9;
    exit r;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (StackExhausted) { exit 96i32; },
        (MachineFault)   { exit 97i32; },
        (Unreachable)    { exit 95i32; },
        (HeapOom)        { exit 92i32; },
        (HeapBadRequest) { exit 91i32; },
        (WildLeak)       { exit 94i32; },
        (OutOfBounds)    { exit 93i32; },
        (E9)             { exit 9i32; },
        (StaleHandle)    { exit 83i32; },
        (LimitViolated)  { exit 87i32; },
        (DecreasesViolated) { exit 86i32; },
        (IntOverflow)    { exit 89i32; },
        (DeadlineExceeded) { exit 88i32; },
        (*)              { exit 99i32; }
    }
    exit 99i32;
};
