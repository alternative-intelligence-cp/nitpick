// expect-error: NITPICK-TYPE-046
// expect-error: NITPICK-TYPE-046
// expect-error: NITPICK-TYPE-092
//
// D-328 (1.6.1d step 3b): A `cstring` OWNS ITS BODY AND IS MOVE-ONLY as every owner is
// (TYPE-046): a binding-to-binding copy is `.clone()` or a move, an `argv` element is
// read in place. And a string literal in `cstring` position is the compile-time way to
// one (D-049) -- an interior NUL is refused at the literal, TYPE-092, where `to_cstring`
// refuses it at run time.
mod:cstring_copy;
error:E9;

func:copies = NIL(cstring[]:argv) {
    cstring:a = relay to_cstring("/tmp");
    cstring:b = a;
    cstring:p = argv[0i64];
    cstring:z = "a\0b";
    discard(b.len);
    discard(p.len);
    discard(z.len);
    pass NIL;
};

// --- the controls: silent --------------------------------------------------------
func:uses = NIL(cstring[]:argv) {
    cstring:a = relay to_cstring("/tmp");
    cstring:c = relay a.clone();
    cstring:m = move(a);
    if (!path_exists(c)) { fail E9; }
    if (m.len != argv[0i64].len) { discard(m.cap); }
    cstring:lit = "/tmp";
    discard(lit.cap);
    pass NIL;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 89i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom) { exit 95i32; },
        (OutOfBounds) { exit 95i32; },
        (Unreachable) { exit 96i32; },
        (WildLeak) { exit 97i32; },
        (StackExhausted) { exit 98i32; },
        (MachineFault) { exit 98i32; },
        (DecreasesViolated) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 99i32;
};
