// expect-error: NITPICK-TYPE-035
// expect-error-at: 40:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 41:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 42:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 43:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 44:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 46:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 48:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 49:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 50:1
// expect-error: NITPICK-TYPE-035
// expect-error-at: 51:1
//
// DEF-197 (1.6.1e): A MODULE-LEVEL CONSTANT OF A CARRIED FAMILY IS WRITTEN, NOT
// COMPUTED. The folder computes in the plain integers, `bool`, `char` and
// `string`; it read every `tbb`, `tfp` and ternary literal as an untyped plain
// integer and folded plain arithmetic over them, and the global's renderer wrote
// the result whatever the type. Each of the first three COMPILED on every
// compiler before this one, to a wrong constant, in silence:
//
//   fixed tbb8:A = 100tbb8 + 100tbb8;   `constant i8 200` (-56; the run time: ERR)
//   fixed tfp64:B = 2tfp64 + 1tfp64;    `constant i64 3`  (the Q value of 3.0 is 12884901888)
//   fixed tryte:C = 29524 + 1;          `constant i16 29525` (no tryte at all; the run time: ERR)
//
// A float's arithmetic is the run time's too (its rounding), a `flt32` constant
// waits for the compiler's own decimal conversion, and a reference does not
// launder the arithmetic. The controls are every written form.
mod:module_const_carried;

struct:W = { tfp64:q; int32:k; };

fixed tbb8:A = 100tbb8 + 100tbb8;
fixed tfp64:B = 2tfp64 + 1tfp64;
fixed tryte:C = 29524 + 1;
fixed flt64:D = 2.0f64 * 3.0f64;
fixed flt32:E = 1.5f32;
fixed tryte:F0 = 5;
fixed tryte:F = F0 + 1;
fixed tbb8:G0 = 100tbb8;
fixed tbb8:G = G0 - 1tbb8;
fixed W:H = W{ q: 1tfp64 * 2tfp64, k: 1i32 + 1i32 };
fixed flt64[2]:I = [1.0f64, 1.0f64 + 1.0f64];
fixed tfp64:J = Q0 / Q0;
fixed tfp64:Q0 = 2tfp64;

// controls: a literal, a negated literal, a sentinel, a reference, plain integers
fixed tbb8:OK1 = -100tbb8;
fixed tfp64:OK2 = -2.5tfp64;
fixed tryte:OK3 = -29524;
fixed flt64:OK4 = 6.0f64;
fixed tbb8:OK5 = ERR;
fixed tfp64:OK6 = Q0;
fixed int32:OK7 = 2i32 + 3i32;
fixed W:OK8 = W{ q: 2tfp64, k: 1i32 + 1i32 };

func:main = int32(cstring[]:argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (*) { exit 70i32; }
    }
};
