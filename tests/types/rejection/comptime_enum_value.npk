// expect-error: NITPICK-TYPE-035
// expect-error-at: 62:1
// expect-error: NITPICK-TYPE-004
// expect-error-at: 63:21
// expect-error: NITPICK-TYPE-025
// expect-error-at: 88:27
// expect-error: NITPICK-TYPE-004
// expect-error-at: 105:20
// expect-error: NITPICK-TYPE-004
// expect-error-at: 106:25
// expect-error: NITPICK-TYPE-004
// expect-error-at: 107:23
// expect-error: NITPICK-TYPE-004
// expect-error-at: 108:16
// expect-error: NITPICK-TYPE-004
// expect-error-at: 109:16
// expect-error: NITPICK-TYPE-004
// expect-error-at: 110:15
// expect-error: NITPICK-TYPE-004
// expect-error-at: 111:15
//
// WHERE THE COMPILE-TIME EVALUATOR'S NEW VALUE STOPS (D-338, 1.6.1e step 3b). It
// holds a payload-less enum variant, compares two with `==`/`!=`, and runs a
// `pick` over a constant selector -- inside a `comptime func:` call. Each case
// below is one step past that, and each is refused where it is written, never
// handed to an emitter that has nothing to write:
//
//   AN ENUM VALUE DOES NOT LEAVE THE EVALUATOR. `comptime(…)` whose value is a
//   variant is NITPICK-TYPE-004 with its own sentence (`at_site`, `through_call`),
//   and a module binding initialised with one is NITPICK-TYPE-035, as it was
//   before the evaluator could hold the value (`AT_MODULE`); a module binding
//   forced through `comptime(…)` is ONE report, the TYPE-004 (`FORCED`). Whether
//   either should be a constant is S-127, the user's.
//
//   A `pick` IS EVALUATED ONLY INSIDE A `comptime func:` CALL (`bare_pick`): an
//   arm is a block of statements, and the evaluator runs statements in a frame.
//
//   THE ARM OF AN EXPRESSION `pick` ENDS IN `give` (`pass_out`): a `pass` there
//   leaves the function through an expression.
//
//   A SELECTOR THE FOLDER CARRIES AND DOES NOT COMPUTE IN is not selected on
//   (`tbb_sel`): a `tbb`'s arms may include `ERR:`.
//
//   ONE METHOD CALL FOLDS, `cmp` on two strings (`int_cmp`), and a GENERIC
//   enum's variant is not a value here -- its instance is not in the
//   expression (`generic_variant`).
//
//   TWO ARMS THAT FALL TO EACH OTHER END AS EVERY LOOP THAT DOES NOT
//   (`fall_cycle`): NITPICK-TYPE-025, the budget, never a hung build.
//
// The controls at the end fold: the same shapes one step back.
mod:comptime_enum_value;

enum:Mode = { Off; Slow; Fast; };
enum:Opt<T> = { Nothing; Some(T); };

comptime func:mode_of = Mode(int32:k) never fails {
    if (k == 0i32) { pass Mode.Off; }
    pass Mode.Fast;
};

fixed Mode:AT_MODULE = Mode.Slow;
fixed Mode:FORCED = comptime(mode_of(0i32));

comptime func:pass_out = int32(int32:k) never fails {
    int32:r = pick (k) { (1i32) { pass 7i32; }, (*) { give 0i32; } };
    pass r;
};

comptime func:tbb_sel = int32() never fails {
    tbb8:t = 5tbb8;
    pick (t) { (5tbb8) { pass 1i32; }, ERR: { pass 2i32; }, (*) { pass 3i32; } }
};

comptime func:int_cmp = bool(int32:a, int32:b) never fails {
    pass ((raw a.cmp(b)) == Ordering.Less);
};

comptime func:generic_variant = bool() never fails {
    Opt<int32>:o = Opt.Nothing;
    pick (o) { (Opt.Nothing) { pass true; }, (*) { pass false; } }
};

comptime func:fall_cycle = int32(int32:k) never fails {
    int32:n = 0i32;
    pick (k) {
        one: (1i32) { n = n + 1i32; fall two; },
        two: (2i32) { n = n + 1i32; fall one; },
        (*)         { n = 9i32; }
    }
    pass n;
};

// --- controls: each folds ---
comptime func:give_out = int32(int32:k) never fails {
    int32:r = pick (k) { (1i32) { give 7i32; }, (*) { give 0i32; } };
    pass r;
};
comptime func:mode_is_off = bool(int32:k) never fails { pass ((raw mode_of(k)) == Mode.Off); };
comptime func:str_cmp = bool(string:a, string:b) never fails {
    pass ((raw a.cmp(b)) == Ordering.Less);
};

func:main = int32(cstring[]:argv) {
    Mode:at_site = comptime(Mode.Off);
    Mode:through_call = comptime(mode_of(1i32));
    int32:bare_pick = comptime(pick (3i32) { (3i32) { give 10i32; }, (*) { give 20i32; } });
    int32:po = comptime(pass_out(1i32));
    int32:ts = comptime(tbb_sel());
    bool:ic = comptime(int_cmp(1i32, 2i32));
    bool:gv = comptime(generic_variant());
    int32:fc = comptime(fall_cycle(1i32));

    int32:c1 = comptime(give_out(1i32));
    bool:c2 = comptime(mode_is_off(0i32));
    bool:c3 = comptime(str_cmp("ab", "b"));
    int32:c4 = comptime(fall_cycle(5i32));
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
