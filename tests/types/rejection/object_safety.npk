// Object safety (4.2). FOUR rules, and the diagnostic says WHICH ONE — "trait is
// not object safe" sends the reader to re-derive the list.
//
// A NON-OBJECT-SAFE TRAIT IS STILL A GOOD TRAIT. Only `dyn` is refused, which is
// why each case below has to write one.

// Rule 1 — every method takes `self`. A vtable dispatches on a receiver, and a
// method with none has nothing to dispatch on.
mod:object_safety;
trait:Makeable = { func:make = int32(); };
// expect-error: NITPICK-TYPE-015
func:no_receiver = NIL(dyn Makeable:d) never fails { pass NIL; };

// Rule 2 — no method returns `Self`. Behind `dyn` the concrete type is erased, so
// its size is unknown and there is nowhere to put the result.
trait:Cloneable = { func:copy = Self(Self:self); };
// expect-error: NITPICK-TYPE-015
func:returns_self = NIL(dyn Cloneable:d) never fails { pass NIL; };

// Rule 3 — nothing that monomorphizes. Those become one body per argument, and a
// vtable slot is one address.
trait:Mapper = { func:map<T> = int32(Self:self, T:x); };
// expect-error: NITPICK-TYPE-015
func:generic_method = NIL(dyn Mapper:d) never fails { pass NIL; };

// EVERY OPERAND OF `dyn` MUST BE A TRAIT. `dyn int32` is not a dynamic anything.
struct:Plain = { int32:v; };
// expect-error: NITPICK-TYPE-006
func:not_a_trait = NIL(dyn Plain:d) never fails { pass NIL; };

// D-157, 1.0.5 — `Self` NOWHERE BUT THE RECEIVER. Every case below PASSED
// object safety until 1.0.5, because rule 2 read the return's top node and
// nothing else. Behind a vtable the concrete type is erased, so each of these
// would have had a value read at the wrong layout.

// A LATER PARAMETER. This is the case D-157 names: the erased `other` is read
// as whatever the vtable's caller believed it was.
trait:Eq2 = { func:same = bool(Self:self, Self:other); };
// expect-error: NITPICK-TYPE-015
func:self_in_param = NIL(dyn Eq2:d) never fails { pass NIL; };

// NESTED IN THE RETURN — an optional `Self` erases exactly as badly as a bare
// one, and the old top-node test could not see it.
trait:Maybe2 = { func:maybe = Self?(Self:self); };
// expect-error: NITPICK-TYPE-015
func:self_in_optional = NIL(dyn Maybe2:d) never fails { pass NIL; };

// UNDER A SLICE.
trait:Lister = { func:all = Self[](Self:self); };
// expect-error: NITPICK-TYPE-015
func:self_in_slice = NIL(dyn Lister:d) never fails { pass NIL; };

// UNDER A POINTER.
trait:Selfptr = { func:me = Self->(Self:self); };
// expect-error: NITPICK-TYPE-015
func:self_in_pointer = NIL(dyn Selfptr:d) never fails { pass NIL; };

// INSIDE A GENERIC ARGUMENT — the `Handle<Self>` shape D-157 refuses BY NAME
// even though such a type's size does survive erasure. One uniform rule beats a
// size-based carve-out.
struct:Boxed<T> = { T:v; };
trait:Boxer = { func:boxed = Boxed<Self>(Self:self); };
// expect-error: NITPICK-TYPE-015
func:self_in_generic_arg = NIL(dyn Boxer:d) never fails { pass NIL; };

// THE RECEIVER MAY *BE* `Self`; IT MAY NOT *CONTAIN* ONE.
trait:Oddrecv = { func:f = int32(Self?:self); };
// expect-error: NITPICK-TYPE-015
func:self_nested_in_receiver = NIL(dyn Oddrecv:d) never fails { pass NIL; };

// AND THE POSITIVE CASE, so the rule is not merely "refuse everything": a
// receiver-only `Self` with ordinary parameters and return is object-safe, and
// this file must report no error for it.
trait:Drawable = { func:draw = int32(Self:self, int32:scale); };
func:ok_object_safe = NIL(dyn Drawable:d) never fails { pass NIL; };

func:main = int32(cstring[]:_~argv) { pass 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };

// Rule 4, NARROWED at 1.1.12d (D-185) — an `async` method is object-safe
// WITH a `Self->` receiver: the vtable's size tail tells the caller how big
// the concrete coroutine's frame is, and a pointer receiver is the one form
// whose slot is the same size whoever implements. A BY-VALUE `Self`
// receiver is the part of the signature whose layout stays concrete, so it
// alone still disqualifies — which is exactly what this trait spells.
trait:Work = { async func:run = int32(Self:self); };
// expect-error: NITPICK-TYPE-015
func:async_dyn = NIL(dyn Work:w) never fails { pass NIL; };
