// expect-error: NITPICK-TYPE-094
// expect-error-at: 35:5
// expect-error: NITPICK-TYPE-094
// expect-error-at: 40:5
// expect-error: NITPICK-TYPE-094
// expect-error-at: 47:18
// expect-error: NITPICK-TYPE-094
// expect-error-at: 55:38
// expect-error: NITPICK-TYPE-094
// expect-error-at: 55:58
// expect-error: NITPICK-TYPE-040
// expect-error-at: 63:26
// expect-error: NITPICK-TYPE-040
// expect-error-at: 72:26
//
// A `give` OR A `fall` OUTSIDE A `pick` ARM IS REFUSED BY NAME (DEF-233, 1.6.1e
// landing 111; the library listener's F-038). Each means something only inside an
// arm -- `give` hands a `pick` EXPRESSION its value, `fall` moves to another arm of
// the enclosing `pick` -- and the checker let both stand anywhere, so the emitter's
// lookup for the enclosing pick trapped the compiler: exit 3 and no message. Seven
// sites: a `give` in a plain body, a `fall` in a plain body, a `give` inside a
// STATEMENT pick's arm (that arm gives nothing), a `give` in EACH arm of a statement
// pick NESTED in a pick expression's arm (the innermost pick governs, as it does
// for `fall`; the emitter met the statement pick's empty slot there, EMIT-002), and
// a `give` and a `fall` inside a `defer` body written in an arm -- TYPE-040, the
// cleanup rule's (D-163 rule 7): the body runs at the scope's exit, after the arm
// has finished, and the compiler exited 3 in silence on either. The controls below
// them compile: a `give` in a pick expression's arm, a `fall` in a statement pick's
// arm, a `fall` in a pick expression's arm, a `give` from inside an `if` and a loop
// in an arm, and a pick expression nested inside a statement pick's arm inside a
// pick expression's arm, each `give` reaching its own pick.
mod:give_fall_outside;

func:give_outside = int32(int32:x) never fails {
    give x;
    pass x;
};

func:fall_outside = int32(int32:x) never fails {
    fall two;
    pass x;
};

func:give_in_statement_pick = int32(int32:x) never fails {
    int32:v = 0i32;
    pick (x) {
        (1i32) { give 7i32; },
        (*) { v = 1i32; }
    }
    pass v;
};

func:give_in_nested_statement_pick = int32(int32:x, int32:y) never fails {
    int32:v = pick (x) {
        (1i32) { pick (y) { (2i32) { give 7i32; }, (*) { give 0i32; } } },
        (*) { give 0i32; }
    };
    pass v;
};

func:give_in_defer = int32(int32:x) never fails {
    int32:v = pick (x) {
        (1i32) { defer { give 3i32; } give 7i32; },
        (*) { give 0i32; }
    };
    pass v;
};

func:fall_in_defer = int32(int32:x) never fails {
    int32:v = 0i32;
    pick (x) {
        (1i32) { defer { fall two; } v = 1i32; },
        two: (2i32) { v = v + 1i32; },
        (*) { v = 9i32; }
    }
    pass v;
};

func:give_in_expression_pick = int32(int32:x) never fails {
    int32:v = pick (x) {
        (1i32) { give 7i32; },
        (*) { give 0i32; }
    };
    pass v;
};

func:fall_in_statement_pick = int32(int32:x) never fails {
    int32:v = 0i32;
    pick (x) {
        (1i32) { v = 1i32; fall two; },
        two: (2i32) { v = v + 1i32; },
        (*) { v = 9i32; }
    }
    pass v;
};

func:fall_in_expression_pick = int32(int32:x) never fails {
    int32:v = pick (x) {
        (1i32) { fall two; },
        two: (2i32) { give 2i32; },
        (*) { give 0i32; }
    };
    pass v;
};

func:give_through_if_and_loop = int32(int32:x) never fails {
    int32:v = pick (x) {
        (1i32) { if (x > 0i32) { give 4i32; } give 0i32; },
        (2i32) { int32:i = 0i32; while (i < 5i32) decreases 5i32 - i { i = i + 1i32; if (i == 3i32) { give i; } } give 0i32; },
        (*) { give 9i32; }
    };
    pass v;
};

func:nested_expression_pick = int32(int32:x, int32:y) never fails {
    int32:v = pick (x) {
        (1i32) { int32:w = 0i32; pick (y) { (2i32) { w = pick (y) { (2i32) { give 5i32; }, (*) { give 1i32; } }; }, (*) { w = 8i32; } } give w; },
        (*) { give 0i32; }
    };
    pass v;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:_~e) { exit 1i32; };
