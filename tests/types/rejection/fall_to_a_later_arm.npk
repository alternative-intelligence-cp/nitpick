mod:fall_to_a_later_arm;
error:E9;
func:mk = string() never fails { pass string_concat("ab", "cde"); };
func:fs = int64(string:v, int64:k) never fails { pass (string_bytes(v)[0i64] => int64) - 90i64 + k; };
func:eat = int64(move string:v) never fails { pass 0i64; };
macro:bk = () { fall a; };   // site NITPICK-TYPE-111

// A `fall` GOES TO A LATER ARM OF ITS `pick`, BY SOURCE ORDER (DEF-487, HIGH, pre-existing, landing 177d2b). A `fall` to the same or an
// earlier arm is a loop with no `decreases` or `unbounded`, and `pick` has no grammar for one: accepted, in a `never fails` function with
// no clause, `cycle_no_leave` hung (124/124). `backward_after_move` read a moved string (98/98). `chain_back_no_cycle` is acyclic and refused
// all the same: one rule, not a cycle test. The road is a loop around the `pick`.
func:self = int64() never fails { int64:k = 1i64; int64:t = 0i64; pick (k) { a: (1i64) { t = t + 1i64; if (t > 6i64) { pass t; } fall a; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:chain_back_no_cycle = int64() never fails { int64:k = 1i64; int64:t = 0i64; pick (k) { (1i64) { t = 3i64; fall c; }, b: (2i64) { t = t + 4i64; }, c: (3i64) { fall b; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:back_from_for = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = t + 7i64; }, (2i64) { for (int64:i in 0i64...1i64) { fall a; } }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:backward = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { one: (1i64) { t = t + 7i64; }, (2i64) { t = 0i64; fall one; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:cycle = int64() never fails { int64:k = 1i64; int64:t = 0i64; pick (k) { a: (1i64) { t = t + 1i64; if (t > 6i64) { pass t; } fall b; }, b: (2i64) { fall a; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:backward_after_move = int64() never fails { string:s = raw mk(); int64:k = 2i64; int64:t = 0i64; pick (k) { one: (1i64) { t = raw fs(s, 0i64); }, (2i64) { t = raw eat(move(s)); fall one; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:cycle_no_leave = int64() never fails { int64:k = 1i64; pick (k) { a: (1i64) { fall b; }, b: (2i64) { fall a; }, (*) { fall a; } } };   // sites NITPICK-TYPE-111 NITPICK-TYPE-111
func:back_from_if = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { if (k == 2i64) { fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_else = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { if (k == 3i64) { t = 1i64; } else { fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_a_block = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { { fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_while = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { while (t < 1i64) decreases 1i64 - t { t = t + 1i64; fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_loop = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { loop (0i64, 1i64, 1i64) { fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_till = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { till (1i64, 1i64) { fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_when_body = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { when (t < 1i64) decreases 1i64 - t { t = t + 1i64; fall a; } then { t = 2i64; } end { t = 3i64; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_when_then = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { when (t < 1i64) decreases 1i64 - t { t = t + 1i64; } then { fall a; } end { t = 3i64; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_when_end = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { when (t < 1i64) decreases 1i64 - t { t = t + 1i64; } then { t = 2i64; } end { fall a; } } } pass t; };   // site NITPICK-TYPE-111
func:back_from_a_macro = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { #bk(); } } pass t; };
func:back_in_a_value_pick = int64() never fails { int64:k = 2i64; int64:t = 0i64; int64:q = pick (k) { a: (1i64) { give 7i64; }, (*) { fall a; } }; pass q; };   // site NITPICK-TYPE-111
func:back_in_a_guarded_arm = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (2i64) where (t == 0i64) { fall a; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:back_over_an_arm = int64() never fails { int64:k = 3i64; int64:t = 0i64; pick (k) { a: (1i64) { t = 7i64; }, (2i64) { t = 1i64; }, (3i64) { fall a; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:back_in_an_inner_pick = int64() never fails { int64:k = 2i64; int64:t = 0i64; pick (k) { (2i64) { pick (k) { a: (1i64) { t = 7i64; }, (*) { fall a; } } }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:back_in_a_loop_around = int64() never fails { int64:k = 2i64; int64:t = 0i64; while (t < 1i64) decreases 1i64 - t { t = t + 1i64; pick (k) { a: (1i64) { t = 7i64; }, (*) { fall a; } } } pass t; };   // site NITPICK-TYPE-111
async func:back_after_a_park = int64() { int64:x = 7i64; int64:k = 2i64; int64:t = 0i64; pick (k) { one: (1i64) { t = x; }, (2i64) { await sleep(raw duration_ms(1i64)) ?| NIL; k = 1i64; fall one; }, (*) { t = 5i64; } } pass t; };   // site NITPICK-TYPE-111
func:main = int32(cstring[]:_~argv) { exit 0i32; };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E9)               { exit 75i32; },
        (DeadlineExceeded) { exit 76i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (LimitViolated)    { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
