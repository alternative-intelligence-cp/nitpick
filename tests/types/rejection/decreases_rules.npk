// expect-error-at: 95
// expect-error: NITPICK-TYPE-073
// expect-error-at: 124
// THE TERMINATION CLAUSES' SHAPES (D-304, 1.5.8c step 1). A `while` or `when`
// states exactly one of `decreases E` and `unbounded`, before its `invariant`;
// `for`, `loop` and `till` are bounded by construction (D-234, D-022) and take
// neither; the measure is a plain integer (TYPE-073); a function's measure on a
// function whose recursive group has no cycle checks nothing (TYPE-075, since
// step 4 computes the groups). The `neither` shape of TYPE-072 -- a `while` or
// a `when` with no clause -- is refused since the tree was swept (D-304 (6),
// 1.5.8c steps 3 and 4): the two loops at the end.
mod:decreases_rules;
error:E9;

func:both = int32(int32:n) never fails {
    int32:i = 0i32;
    while (i < n) decreases n - i unbounded { i = i + 1i32; }   // ERR:072
    pass i;
};

func:twice = int32(int32:n) never fails {
    int32:i = 0i32;
    while (i < n) decreases n - i decreases n { i = i + 1i32; }   // ERR:072
    pass i;
};

func:on_for = int32(int32:n) never fails {
    int32:i = 0i32;
    for (int32:k in 0i32...n) decreases n { i = i + k; }   // ERR:072
    pass i;
};

func:on_loop = int32() never fails {
    int32:i = 0i32;
    loop (0i64, 5i64, 1i64) unbounded { i = i + 1i32; }   // ERR:072
    pass i;
};

func:on_till = int32() never fails {
    int32:i = 0i32;
    till (5i64, 1i64) decreases 5i64 { i = i + 1i32; }   // ERR:072
    pass i;
};

func:after_invariant = int32(int32:n) never fails {
    int32:i = 0i32;
    while (i < n) invariant i >= 0i32 decreases n - i { i = i + 1i32; }   // ERR:072
    pass i;
};

func:when_both = int32(int32:n) never fails {
    int32:i = 0i32;
    when (i < n) unbounded decreases n - i { i = i + 1i32; }   // ERR:072
    pass i;
};

func:float_measure = flt64(flt64:f0) never fails {
    flt64:f = f0;
    while (f > 0.0) decreases f { f = f - 1.0; }   // ERR:073
    pass f;
};

func:bool_measure = int32() never fails {
    bool:go = true;
    int32:i = 0i32;
    while (go) decreases go { go = false; i = i + 1i32; }   // ERR:073
    pass i;
};

func:twisted_measure = tbb32(tbb32:t0) never fails {
    tbb32:t = t0;
    while (!(is_err(t))) decreases t { t = t - 1tbb32; }   // ERR:073
    pass t;
};

// ACCEPTED since step 4 (the groups): `count_down` calls itself, so its measure has
// a call to be compared at. A measure on a function whose group has no cycle is
// TYPE-075, in `decreases_no_recursion.npk` -- the group pass runs only over a
// program the checker admitted, so that shape cannot share a file with these.
func:count_down = int32(int32:n) decreases n never fails {
    if (n <= 0i32) { pass 0i32; }
    pass (raw count_down(n - 1i32));
};

// ACCEPTED: one clause each, before the invariant, on the two loop forms that
// take one. REFUSED since step 4 (the tree swept at step 3): a `while` or a
// `when` with NEITHER clause -- the last shape of TYPE-072.
func:clean = int32(int32:n) never fails {
    int32:i = 0i32;
    while (i < n) decreases n - i invariant i >= 0i32 { i = i + 1i32; }
    when (i > 0i32) unbounded { i = i - 1i32; }
    while (i < 3i32) { i = i + 1i32; }                    // ERR:072 (neither)
    when (i > 0i32) { i = i - 1i32; }                     // ERR:072 (neither)
    pass i;
};

// TYPE-073 (1.5.8c step 4): a FUNCTION's measure is at most 64 bits wide --
// every member of a recursive group compares its measure against the others'
// in one signed 128-bit domain at each call, and `int128` does not fit it. A
// loop's measure keeps its own width: it compares only with itself.
func:wide = int32(int128:n) decreases n never fails {   // ERR:073
    if (n <= 0i128) { pass 0i32; }
    pass (raw wide(n - 1i128));
};
