// expect-error: NITPICK-TYPE-025
//
// The other half of the same bound: a loop rather than recursion. `MACRO_REFERENCE`
// section 8 recovered loops and mutable locals from the corpus, so the evaluator
// runs them — which means a loop with no exit is a build that never finishes.
mod:comptime_loop;

comptime func:spin = int32(int32:n) {
    int32:i = 0i32;
    while (i >= 0i32) { i = i + 1i32; }
    pass i;
};

func:main = int32(cstring[]:_~argv) {
    int32:a = comptime(spin(1i32));
    exit 0i32;
};
