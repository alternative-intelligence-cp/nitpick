// expect-error: NITPICK-TYPE-007
// expect-error-at: 27:22
// expect-error: NITPICK-TYPE-007
// expect-error-at: 32:19
// expect-error: NITPICK-TYPE-007
// expect-error-at: 37:17
// expect-error: NITPICK-TYPE-007
// expect-error-at: 42:17
// expect-error: NITPICK-TYPE-007
// expect-error-at: 47:17
// expect-error: NITPICK-TYPE-060
// expect-error-at: 51:48
//
// `??!` TAKES AN `Optional` AND ONE `Error` IDENTITY (D-360, 1.6.1e landing 120; D-099's one
// wrapper per unwrap operator): the lhs a `Result` (TYPE-007 naming `?!` and `?|`), a plain
// pointer (TYPE-007 naming `T->?`: a plain `T->` always points at something, D-355) or a plain
// value (TYPE-007); the rhs an integer or a `bool` where an identity stands (TYPE-007, as `?!`'s
// rhs is held, D-179). Inside a contract it is an outcome, not a proposition (TYPE-060, as `?!`
// is, D-221). The two controls at the end compile.
mod:optional_trap_rules;

error:Absent;

func:may = int32(bool:b) { if (b) { fail Absent; } pass 1i32; };

func:lhs_result = int32(bool:b) never fails {
    int32:v = may(b) ??! Absent;
    pass v;
};

func:lhs_pointer = int64(int64->:p) never fails {
    int64->:q = p ??! Absent;
    pass (<-q);
};

func:lhs_plain = int32(int32:n) never fails {
    int32:v = n ??! Absent;
    pass v;
};

func:rhs_int = int32(int32?:o) never fails {
    int32:v = o ??! 7i32;
    pass v;
};

func:rhs_bool = int32(int32?:o) never fails {
    int32:v = o ??! true;
    pass v;
};

func:in_contract = int32(int32?:o) requires (o ??! Absent) > 0i32 never fails {
    pass 1i32;
};

// The controls: a value Optional and a pointer Optional, unwrapped.
func:control_value = int32(int32?:o) never fails { pass (o ??! Absent); };
func:control_pointer = int64(int64->?:p) never fails { int64->:q = p ??! Absent; pass (<-q); };

func:main = int32(cstring[]:_~argv) { exit 0i32; };

func:failsafe = int32(Error:e) {
    pick (e) {
        (Absent)            { exit 7i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
