// expect-error: NITPICK-TYPE-091
// expect-error-at: 37:9
// expect-error: NITPICK-TYPE-091
// expect-error-at: 46:12
// expect-error: NITPICK-TYPE-091
// expect-error-at: 54:13
// expect-error: NITPICK-TYPE-091
// expect-error-at: 63:15
// expect-error: NITPICK-TYPE-091
// expect-error-at: 71:9
mod:destroy_pointer_place;
// DEF-310 (1.6.1e, landing 164): `destroy` THROUGH A POINTER REACHED BY A FIELD OR AN
// ELEMENT IS NITPICK-TYPE-091, AS `destroy` THROUGH A POINTER LOCAL IS. `destroy`
// CONSUMES its arena (D-152), so its receiver is storage this function owns -- a
// binding, or a field or element of one reached through no pointer (DEF-157,
// `destroy_receiver_owned`). The walk tested the IDENTIFIER's type and each BASE's
// type for pointer-ness, never the receiver place's OWN: `pa.p` -> its base `pa` a
// struct -> `pa` a local -> owned, and the pointee was destroyed with no flag to
// clear, then freed again by its owner's scope exit. Each shape here compiled on
// landing 163's compiler and ran MachineFault (107) at both legs
// (`.internal/probes/def309/sib/d310*`; the matrix cell m_lend_forward_destroy_local_field);
// the plain-arena twin compiled and freed its slab twice silently (DEF-157's text: a
// plain arena's destroy is idempotent). Now every place on the walk is tested for its
// own type: a pointer, a slice or a handle anywhere on it is not owned storage.
//
// Controls carrying no code (clean -- `destroy_owned.npk`'s controls and the program
// tests `destroy_field_once.npk`, `arena_basic.npk`): an owned binding, an owned
// field, a `move` parameter. `pap.p.destroy()` (a pointer field reached THROUGH a
// pointer) was TYPE-091 already, by the base's type.
struct:PA = { shared_arena<int64>->:p; };
struct:PB = { arena<int64>->:q; };

// 1. a pointer FIELD of a local struct
func:field_ptr = NIL() never fails {
    shared_arena<int64>:s = shared_arena_make(8i64);
    PA:pa = PA{ p: @s };
    pa.p.destroy();
    pass NIL;
};

// 2. a `List` element that is a pointer
func:list_elem_ptr = NIL() never fails {
    shared_arena<int64>:s = shared_arena_make(8i64);
    List<shared_arena<int64>->>:l = raw list_init::<shared_arena<int64>->>(1i64);
    drop list_push(@l, @s);
    l[0i64].destroy();
    pass NIL;
};

// 3. an array element that is a pointer
func:array_elem_ptr = NIL() never fails {
    shared_arena<int64>:s = shared_arena_make(8i64);
    shared_arena<int64>->[1]:ar = [@s];
    ar[0i64].destroy();
    pass NIL;
};

// 4. a pointer field of a `List` element
func:list_elem_field_ptr = NIL() never fails {
    shared_arena<int64>:s = shared_arena_make(8i64);
    List<PA>:lp = raw list_init::<PA>(1i64);
    drop list_push(@lp, PA{ p: @s });
    lp[0i64].p.destroy();
    pass NIL;
};

// 5. the plain-arena twin: a pointer FIELD to an `arena<T>`
func:arena_field_ptr = NIL() never fails {
    arena<int64>:a = arena_make(2i64);
    PB:pb = PB{ q: @a };
    pb.q.destroy();
    pass NIL;
};
