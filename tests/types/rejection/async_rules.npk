// expect-error: NITPICK-TYPE-043
// expect-error: NITPICK-TYPE-048
// expect-error: NITPICK-TYPE-043
// expect-error: NITPICK-TYPE-043
// expect-error: NITPICK-TYPE-043
// expect-error: NITPICK-TYPE-043
// expect-error: NITPICK-TYPE-043
// expect-error: NITPICK-TYPE-043
//
// D-177's checker rules, one refusal per shape. `await` and the spawn form
// live only inside `async` functions (a synchronous scope has no frame to
// suspend or to join from); a defer body is synchronous cleanup, so neither
// suspends there; `failsafe` is the controlled-stop path and must run
// without an executor; and an `async` callee has no direct symbol — a bare
// call would be an implicit await, a suspension nothing in the source says.
mod:async_rules;

async func:leaf = int32(int32:v) {
    pass v + 1i32;
};

func:sync_await = int32(int32:v) {
    int32:a = relay await leaf(v);              // TYPE-043: await in a sync fn
    pass a;
};

func:sync_spawn = int32(int32:v) {
    drop leaf(v);                               // TYPE-043: spawn in a sync fn
    pass v;
};

async func:defer_await = int32(int32:v) {
    defer { discard(await leaf(v) ?| 0i32); }   // TYPE-043: await inside defer
    pass v;
};

async func:defer_spawn = int32(int32:v) {
    defer { drop leaf(v); }                     // TYPE-043: spawn inside defer
    pass v;
};

async func:valued_spawn = int32(int32:v) {
    drop leaf(v);                               // TYPE-043: a spawned VALUE
    pass v;
};

async func:bare_call = int32(int32:v) {
    int32:a = relay leaf(v);                    // TYPE-043: bare async call
    pass a;
};

func:main = int32(cstring[]:_~argv) { exit 0i32; };
async func:failsafe = int32(Error:_~e) { exit 1i32; };  // TYPE-043: async failsafe

// A CHANNEL `send`/`recv` OBEYS THE SAME RULE (D-072/D-177, 1.1.10-D). Both are
// `async`, so both run only under `await` — and a bare one is not a suspension
// in the wrong place, it is an operation that does not happen: the value is
// never sent, the value is never received, and the `Result` says nothing about
// it.
//
// It escaped the rule above for a while because it is a METHOD on a builtin
// type rather than a call to a declared `async` function, and the backend
// caught it instead — as a RUNG, "not supported at this backend rung, enabled
// by cycle 1.1", which promised a capability that was never going to arrive.
async func:bare_chan = NIL() {
    Channel<int32, 3i32, 2i64>:ch = channel() ?! Unreachable;
    // expect-error: NITPICK-TYPE-043
    ch.send(1i32, raw duration_ms(10i64)) ?! Unreachable;
    pass NIL;
};

// An impl may not drop (or add) the `async` its trait method declares
// (TYPE-048, 1.1.12b): an await through a bound drives the impl by the
// TRAIT's word, and a sync body run as a coroutine is memory corruption,
// not a slow call.
trait:Work48 = {
    async func:run48 = int64(Self->:self);
};
struct:Job48 = { int32:n; };
impl:Job48:Work48 = {
    func:run48 = int64(Job48->:self) {
        pass 1i64;
    };
};
