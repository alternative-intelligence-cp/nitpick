// The IR text writer (cycle 0.7.1).
//
// THE FIRST BACKEND TEST. What it asserts is not "IR came out" but the two
// properties the whole cycle rests on:
//
//   DETERMINISM — the same calls produce the same bytes, because D-085's
//   stage-1/stage-2 fixpoint compares two compilers' output for EQUALITY. Not
//   equivalent IR: identical bytes.
//
//   SYMBOL NAMING MATCHES THE SEED — stage 1 is built by the seed and calls into
//   the same runtime, so a different prefix is two compilers emitting calls to two
//   different symbols, and nothing would catch it until the link failed.

use "../../src/frontend/intern.npk".*;
use "../../src/frontend/diagnostics.npk".*;
use "../../src/backend/ir/ir_writer.npk".*;

// The bytes a writer produced, as a comparable string.
func:same_text = bool(IrWriter->:a, IrWriter->:b) never fails {
    if ((raw irw_length(a)) != (raw irw_length(b))) { pass false; }
    int64:i = 0i64;
    while (i < (raw irw_length(a))) {
        if ((raw irw_byte_at(a, i)) != (raw irw_byte_at(b, i))) { pass false; }
        i = i + 1i64;
    }
    pass true;
};

// Everything one writer does, so the two runs below are the same program twice.
func:build = NIL(IrWriter->:w) never fails {
    drop irw_raw(w, "define i32 @main() {");
    drop irw_begin_function(w);
    string:a = raw irw_temp(w);
    string:b = raw irw_temp(w);
    drop irw_line(w, raw string_concat(a, " = alloca i32"));
    drop irw_line(w, raw string_concat(b, " = load i32, ptr %0"));
    drop irw_label(w, raw irw_new_label(w, "bb"));
    drop irw_line(w, "ret i32 0");
    drop irw_raw(w, "}");
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    // --- SYMBOL NAMING, WHICH THE SEED DECIDED --------------------------------
    //
    // `main` keeps its name so the linker finds it; everything else is prefixed so
    // a Nitpick name cannot collide with a runtime symbol.
    if (!(raw string_eq(raw ir_symbol("main"), "@main")))        { exit 10i32; }
    if (!(raw string_eq(raw ir_symbol("alloc"), "@npk_alloc")))  { exit 11i32; }
    if (!(raw string_eq(raw ir_symbol("f"), "@npk_f")))          { exit 12i32; }

    // --- TEMPORARIES ARE SEQUENTIAL, AND PER FUNCTION -------------------------
    //
    // Sequential because the numbering must not depend on visit order; per function
    // because a one-function change should produce a one-function diff.
    IrWriter:w1 = raw irw_to_buffer();
    drop irw_begin_function(@w1);
    if (!(raw string_eq(raw irw_temp(@w1), "%t0")))               { exit 20i32; }
    if (!(raw string_eq(raw irw_temp(@w1), "%t1")))               { exit 21i32; }
    drop irw_begin_function(@w1);
    if (!(raw string_eq(raw irw_temp(@w1), "%t0")))               { exit 22i32; }

    // --- THE SAME PROGRAM TWICE IS THE SAME BYTES -----------------------------
    IrWriter:a = raw irw_to_buffer();
    IrWriter:b = raw irw_to_buffer();
    drop build(@a);
    drop build(@b);
    if (!(raw same_text(@a, @b)))                                  { exit 30i32; }
    if ((raw irw_length(@a)) == 0i64)                              { exit 31i32; }

    // --- AND A SINK THAT GROWS RATHER THAN TRUNCATING -------------------------
    //
    // The buffer used to be fixed and dropped whatever did not fit. IR that is
    // silently truncated is a program that compiles to something other than what
    // was written, with nothing anywhere reporting it — so this writes far past the
    // initial capacity and asserts every byte arrived.
    IrWriter:big = raw irw_to_buffer();
    string:body = "call void @npk_nothing()";
    int32:i = 0i32;
    while (i < 2000i32) {
        drop irw_line(@big, body);
        i = i + 1i32;
    }
    // THE EXPECTED LENGTH IS COMPUTED, NOT COUNTED. Two spaces of indent and one
    // newline around a body whose length the program can ask for — a hand-counted
    // constant here is a number that is wrong once and then asserted forever.
    int64:per = 2i64 + body.len + 1i64;
    if ((raw irw_length(@big)) != (2000i64 * per))                 { exit 40i32; }
    // And it definitely grew: the buffer starts at 4096.
    if ((raw irw_length(@big)) <= 4096i64)                         { exit 41i32; }

    drop wild_release_all();

    drop wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (BoundsId) { exit 1i32; },
        (BoundsOffset) { exit 1i32; },
        (DeadlineExceeded) { exit 1i32; },
        (FileUnknown) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (ProvenSlice) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
