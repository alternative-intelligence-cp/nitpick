// expect-exit: 0
//
// THE REACTOR'S "NONE" IS -1, AND DESCRIPTOR 0 IS A DESCRIPTOR (DEF-69, 1.5.8
// step 3c). The executor's epoll and eventfd words said "no reactor" with 0,
// on the reasoning that fd 0 is stdin and the kernel never hands it out while
// it is open -- and nothing kept it open. A program that closes its own stdin
// makes 0 the lowest free number, so its next reactor's epoll set IS
// descriptor 0, and every reader took that for "none": a thread's join did
// not close it (an epoll set leaked per thread), a second wait made a second
// set (one leaked per wait), and the idle wait was the futex's, which no
// readiness wakes (a ready descriptor answered at its deadline instead).
//
// Each count below is of descriptors 0..63 that are open, so an environment
// that hands the program more than 0, 1 and 2 moves every count alike.
mod:reactor_fd_zero;
error:EPipe;
error:EWait;
error:ERead;
error:EThreadReady;
error:EThreadWait;
error:EThreadSet;
fixed Duration:JOIN_2S = Duration{ ns: 2000000000i64 };

// how many of descriptors 0..63 are open: fcntl(F_GETFD) answers EBADF for a
// closed one
func:count_open = int64() never fails {
    int64:n = 0i64;
    for (int64:d in 0i64...64i64) {
        Result<int64>:g = sys(72i64, d, 1i64);
        if (!g.is_error) { n = n + 1i64; }
    }
    pass n;
};

thread async func:waiter = NIL(int64:rfd) joins JOIN_2S {
    // this thread's first wait makes its reactor, and the lowest free number
    // -- 0 -- is its epoll set; nothing is written, so the deadline answers
    Result<NIL>:r = await io_ready(rfd =>! int32, 1i32, raw duration_ms(2i64));
    if (!r.is_error)                 { !!! EThreadReady; }
    if (r.err != DeadlineExceeded)   { !!! EThreadWait; }
    // the premise: descriptor 0 is open, and it is this thread's epoll set
    Result<int64>:g = sys(72i64, 0i64, 1i64);
    if (g.is_error)                  { !!! EThreadSet; }
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    // pipe2(&fds, O_NONBLOCK), before descriptor 0 is closed
    wild int8->:fds = alloc(8i64);
    discard(sys(293i64, fds, 2048i64) ?! EPipe);
    wild int32->:fdi = fds =>! wild int32->;
    int64:rfd = fdi[0i64] => int64;
    int64:wfd = fdi[1i64] => int64;
    dalloc(fds);
    // the program closes its own stdin: 0 is the lowest free number now
    discard(sys(3i64, 0i64) ?! EPipe);
    int64:c0 = raw count_open();

    // 1. A THREAD'S EPOLL SET ON DESCRIPTOR 0 IS CLOSED BY ITS JOIN. The
    // thread's eventfd stays open with its pooled executor (DEF-66); the set
    // does not. The floor before this step left it open: 10.
    {
        drop waiter(rfd);
    }
    int64:c1 = raw count_open();
    if (c1 != c0 + 1i64)             { exit 10i32; }
    Result<int64>:g1 = sys(72i64, 0i64, 1i64);
    if (!g1.is_error)                { exit 11i32; }

    // 2. THIS THREAD'S EPOLL SET ON DESCRIPTOR 0 IS THE ONE EVERY WAIT USES:
    // one set and one eventfd, however many waits. The floor before this step
    // made a second set at the second wait: 14.
    Result<NIL>:a = await io_ready(rfd =>! int32, 1i32, raw duration_ms(2i64));
    if (!a.is_error)                 { exit 12i32; }
    Result<NIL>:b = await io_ready(rfd =>! int32, 1i32, raw duration_ms(2i64));
    if (!b.is_error)                 { exit 13i32; }
    int64:c2 = raw count_open();
    if (c2 != c1 + 2i64)             { exit 14i32; }
    Result<int64>:g2 = sys(72i64, 0i64, 1i64);
    if (g2.is_error)                 { exit 15i32; }

    // 3. AND IT DELIVERS: a byte in the pipe, and the wait on a set that is
    // descriptor 0 answers readiness long before its deadline. With the
    // futex as its idle wait, it answered DeadlineExceeded after a second.
    wild int8->:wb = alloc(8i64);
    <-wb = 55i8;
    discard(sys(1i64, wfd, wb, 1i64) ?! EPipe);
    await io_ready(rfd =>! int32, 1i32, raw duration_ms(1000i64)) ?! EWait;
    wild int8->:rb = alloc(8i64);
    int64:n = sys(0i64, rfd, rb, 8i64) ?! ERead;
    if (n != 1i64)                   { exit 16i32; }
    if ((<-rb) != 55i8)              { exit 17i32; }
    dalloc(rb);
    dalloc(wb);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (EPipe)            { exit 81i32; },
        (EWait)            { exit 82i32; },
        (ERead)            { exit 83i32; },
        (EThreadReady)     { exit 30i32; },
        (EThreadWait)      { exit 31i32; },
        (EThreadSet)       { exit 32i32; },
        (DeadlineExceeded) { exit 94i32; },
        (HeapBadRequest)   { exit 95i32; },
        (HeapOom)          { exit 95i32; },
        (IntOverflow)      { exit 96i32; },
        (OutOfBounds)      { exit 96i32; },
        (Unreachable)      { exit 97i32; },
        (WildLeak)         { exit 98i32; },
        (StackExhausted)   { exit 99i32; },
        (MachineFault)     { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
