// expect-exit: 24
//
// The accepted-loss spelling's half of the leaving matrix, as amended at
// 1.3.2 (D-144, aligned with tfp's D-195 rule): `tbb =>! int` acknowledges
// the VALUE's loss, and ERR is not a value — so the taint traps (-4100)
// under the bang exactly as under `=>`. Until the alignment this read the
// carrier raw and ERR crossed as INT_MIN, the recognizable-but-unchecked
// laundering the one-rule discipline closes. The checked spelling's trap is
// its own program (tbb_cast_trap); the valid-value bang read is tbb.npk's.

func:main = int32(cstring[]:argv) {
    tbb32:z = (argv.len =>! int32 - 1i32) =>! tbb32;   // 0, at run time
    tbb32:e = 5tbb32 / z;                              // ERR
    int64:laundered = e =>! int64;                     // must trap
    exit (laundered =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (TbbErr) { exit 24i32; },
        (DivByZero) { exit 9i32; },
        (DivOverflow) { exit 9i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
