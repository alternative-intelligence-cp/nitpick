// expect-exit: 21
//
// LIVE-2's lock for `%`: remainder shares the division guard — a zero divisor
// traps with the same DIV_BY_ZERO code, because `srem` faults on the same
// hardware path `sdiv` does.

mod:rem_guard;
func:main = int32(cstring[]:argv) {
    int64:zero = argv.len - 1i64;
    int64:r = 7i64 % zero;
    exit (r =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero) { exit 21i32; },
        (DivOverflow) { exit 9i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (IntOverflow) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
