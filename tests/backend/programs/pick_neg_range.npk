// expect-exit: 4
//
// DEF-132 (1.6.1d step 4; the library listener's F-016): A `pick` RANGE
// PATTERN WITH A NEGATIVE BOUND LOWERS. `(-5i32..-2i32)` was EMIT-002 where
// the value pattern `(-3i32)` lowered since DEF-35: the chain read a bound's
// payload as a literal and answered `iv_broken` for the negated form. Each
// bound is read through the constant folder now (a literal, a negated
// literal, a `fixed` constant). The three shapes of the finding -- both bounds
// negative, a negative low bound, the exclusive form -- in one program.
mod:pick_neg_range;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:y = raw v32(-3i32);
    int32:r = 0i32;
    pick (y) { (-5i32..-2i32) { r = 4i32; }, (*) { r = 5i32; } }
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
