// expect-exit: 0
//
// THE ELEMENT DROPS ARE REAL (D-247, 1.5.1b step 5): a `List<OwnedFd>` of 500
// descriptors dropped at scope exit, three rounds -- 1 500 opens against a
// table of 1 024, so a list that freed its block and not its elements answers
// EMFILE on the third round (the overwrite_owned technique).
mod:list_fds;
error:E9;

func:round = int64(cstring:path) {
    List<OwnedFd>:fds = raw list_init::<OwnedFd>(8i64);
    for (int32:i in 0i32...500i32) {
        fd:f = open(path, (O_RDONLY => int32) => int64, (S_NONE => int32) => int64) ?! E9;
        drop list_push(@fds, own_fd(f));
    }
    pass fds.count;
};

func:main = int32(cstring[]:_~argv) {
    cstring:devnull = to_cstring("/dev/null") ?! E9;
    int64:acc = 0i64;
    for (int32:r in 0i32...3i32) { acc = acc + (round(devnull) ?! E9); }
    if (acc != 1500i64) { exit 1i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 90i32; },
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; }, (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
