// expect-exit: 0
// stress: 40
//
// AN OWNING TEMPORARY AS AN `await`'S ARGUMENT (D-246, D-178): the string
// lives in the caller's FRAME across the suspension the callee makes, lent to
// it for its whole run, and is dropped when the statement ends after the
// resume. The temporary's flag is zeroed by the first resume, so a path the
// statement did not take reads "not produced".
mod:temp_await;
error:E9;

async func:take_len = int64(string:s) {
    Result<NIL>:z = await sleep(raw duration_ns(1000i64));
    if (z.is_error) { fail E9; }
    pass s.len;
};

async func:main = int32(cstring[]:_~argv) {
    int64:acc = 0i64;
    for (int32:i in 0i32...200i32) {
        Result<int64>:r = await take_len(string_concat("ab", int_to_string(i => int64)));
        if (r.is_error) { exit 1i32; }
        acc = acc + r.value;
    }
    if (acc < 600i64) { exit 2i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 90i32; },
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; }, (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (DeadlineExceeded) { exit 97i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
