// expect-exit: 92
//
// INT_MIN / -1 AT VECTOR WIDTH (D-194): the structural detection — the one
// nonzero value equal to its own negation — runs elementwise, and any lane
// hitting it traps DivOverflow. INT_MIN arrives at run time so nothing
// folds; the run-time zero from argv builds it.
mod:simd_divmin;

func:main = int32(cstring[]:argv) {
    int32:z = (argv.len - 1i64) =>! int32;              // 0 at run time
    int32:minv = (0i32 - 2147483647i32) - 1i32 + z;    // INT_MIN
    simd<int32, 4>:a = simd(1i32, minv, 3i32, 4i32);
    simd<int32, 4>:b = simd(0i32 - 1i32);
    simd<int32, 4>:q = a / b;
    if (q[0i64] == (0i32 - 1i32)) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero)      { exit 91i32; },
        (OutOfBounds)    { exit 96i32; },
        (DivOverflow)    { exit 92i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom)        { exit 95i32; },
        (Unreachable)    { exit 97i32; },
        (WildLeak)       { exit 98i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
