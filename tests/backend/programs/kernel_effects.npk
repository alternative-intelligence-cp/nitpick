// expect-exit: 0
//
// THE KERNEL-EFFECT TABLE, HELD TO THE RUNNING KERNEL (1.5.6b step 1; D-288 as
// amended). The floor's translator models a syscall's effect on memory from
// one table -- VERIFICATION_REFERENCE SS9.2's `kernel-effects` region -- and
// until this program existed a reader ACCEPTED that table. On the day it
// became an authority two of its rows were measured wrong: `sched_getaffinity`
// claimed the REQUESTED length where the raw call writes `result` bytes (and
// behind that row the floor popcounted 120 bytes of stack nobody had written,
// DEF-52), and `rt_sigaction` claimed the 8-byte sigset size where the kernel
// writes the whole 32-byte action -- an UNDER-approximation, the unsound
// direction.
//
// For every row that WRITES memory: the raw syscall over a sentinel-filled
// buffer, twice with two sentinels (a written byte that equals one sentinel
// cannot equal the other), and the bytes the kernel changed must be EXACTLY
// the row's on a success and NONE on a failure. Equality, not containment: an
// over-approximating row is sound, and is what hid the defect. The row's
// BUFFER column is held too (the probe passes the buffer where the ABI wants it
// and the row must name that argument), and its BOUND (the answer never
// exceeds the argument the row names). The claims below are GENERATED from the
// region by gen_tables.py, so this file cannot carry a stale copy of the table.
//
// Exit codes name the row: 1x read, 2x getrandom, 3x clock_gettime,
// 4x sched_getaffinity, 5x rt_sigaction, 6x epoll_pwait, 7x mmap, 8x sigaltstack.
mod:kernel_effects;

// --- kernel-effects:begin (GENERATED by bootstrap/generator/gen_tables.py -- do not edit)
// the 1-based argument a `writes` row names as its buffer
func:ke_buf_arg = int64(int64:nr) never fails {
    if (nr == 0i64) { pass 2i64; }   // read
    if (nr == 13i64) { pass 3i64; }   // rt_sigaction
    if (nr == 131i64) { pass 2i64; }   // sigaltstack
    if (nr == 204i64) { pass 3i64; }   // sched_getaffinity
    if (nr == 228i64) { pass 2i64; }   // clock_gettime
    if (nr == 281i64) { pass 2i64; }   // epoll_pwait
    if (nr == 318i64) { pass 1i64; }   // getrandom
    pass 0i64;
};
// the length the row claims: 1 `result`, 2 `result*12`, 3 a numeral (ke_len_num)
func:ke_len_kind = int64(int64:nr) never fails {
    if (nr == 0i64) { pass 1i64; }   // read
    if (nr == 13i64) { pass 3i64; }   // rt_sigaction
    if (nr == 131i64) { pass 3i64; }   // sigaltstack
    if (nr == 204i64) { pass 1i64; }   // sched_getaffinity
    if (nr == 228i64) { pass 3i64; }   // clock_gettime
    if (nr == 281i64) { pass 2i64; }   // epoll_pwait
    if (nr == 318i64) { pass 1i64; }   // getrandom
    pass 0i64;
};
// the numeral, where the length is one
func:ke_len_num = int64(int64:nr) never fails {
    if (nr == 0i64) { pass 0i64; }   // read
    if (nr == 13i64) { pass 32i64; }   // rt_sigaction
    if (nr == 131i64) { pass 24i64; }   // sigaltstack
    if (nr == 204i64) { pass 0i64; }   // sched_getaffinity
    if (nr == 228i64) { pass 16i64; }   // clock_gettime
    if (nr == 281i64) { pass 0i64; }   // epoll_pwait
    if (nr == 318i64) { pass 0i64; }   // getrandom
    pass 0i64;
};
// the 1-based argument a non-negative answer never exceeds; 0 for none
func:ke_bound_arg = int64(int64:nr) never fails {
    if (nr == 0i64) { pass 3i64; }   // read
    if (nr == 13i64) { pass 0i64; }   // rt_sigaction
    if (nr == 131i64) { pass 0i64; }   // sigaltstack
    if (nr == 204i64) { pass 2i64; }   // sched_getaffinity
    if (nr == 228i64) { pass 0i64; }   // clock_gettime
    if (nr == 281i64) { pass 3i64; }   // epoll_pwait
    if (nr == 318i64) { pass 2i64; }   // getrandom
    pass 0i64;
};
// --- kernel-effects:end

struct:Span = {
    int64:lo;
    int64:hi;      // one past the last changed byte; 0 when nothing changed
};

func:fill = NIL(wild int8->:b, int64:n, uint8:v) never fails {
    for (int64:i in 0i64...n) { <-(#ptr_add<uint8>(b, i)) = v; }
    pass NIL;
};

// The span of bytes in [0, n) that are no longer `v`.
func:changed = Span(wild int8->:b, int64:n, uint8:v) never fails {
    int64:lo = n;
    int64:hi = 0i64;
    for (int64:i in 0i64...n) {
        uint8:c = <-(#ptr_add<uint8>(b, i));
        if (c != v) {
            if (i < lo) { lo = i; }
            hi = i + 1i64;
        }
    }
    if (hi == 0i64) { lo = 0i64; }
    pass Span{ lo: lo, hi: hi };
};

// The union of two spans (an empty one has hi == 0).
func:span_union = Span(Span:a, Span:b) never fails {
    if (a.hi == 0i64) { pass b; }
    if (b.hi == 0i64) { pass a; }
    int64:lo = a.lo;
    if (b.lo < lo) { lo = b.lo; }
    int64:hi = a.hi;
    if (b.hi > hi) { hi = b.hi; }
    pass Span{ lo: lo, hi: hi };
};

// The length the row claims the kernel wrote, given the answer.
func:claimed = int64(int64:nr, int64:answer) never fails {
    int64:k = raw ke_len_kind(nr);
    if (k == 1i64) { pass answer; }
    if (k == 2i64) { pass (answer * 12i64); }
    if (k == 3i64) { pass (raw ke_len_num(nr)); }
    pass 0i64;
};

// Is the span exactly [0, want)?  (want == 0: nothing changed)
func:exactly = bool(Span:s, int64:want) never fails {
    if (want == 0i64) { pass (s.hi == 0i64); }
    pass ((s.lo == 0i64) && (s.hi == want));
};

func:main = int32(cstring[]:_~argv) {
    int64:cap = 256i64;
    wild int8->:buf = alloc(cap);
    wild int8->:aux = alloc(64i64);

    // ---- read (0): a pipe holding five bytes, read with room for sixty-four
    if (((raw ke_buf_arg(0i64)) != 2i64) || ((raw ke_bound_arg(0i64)) != 3i64)) { exit 10i32; }   // the row's buffer and bound columns
    Span:rd = Span{ lo: 0i64, hi: 0i64 };
    int64:rd_n = 0i64;
    for (int64:pass_i in 0i64...2i64) {
        uint8:sv = 165u8;
        if (pass_i == 1i64) { sv = 90u8; }
        int64:pr = sys(293i64, aux, 0i64) ?| (0i64 - 1i64);              // pipe2(fds, 0)
        if (pr != 0i64) { exit 11i32; }
        int64:rfd = (<-(#ptr_add<int32>(aux, 0i64))) => int64;
        int64:wfd = (<-(#ptr_add<int32>(aux, 1i64))) => int64;
        drop fill(buf, cap, 104u8);                                        // 'h' x5 is the payload's source
        int64:wr = sys(1i64, wfd, buf, 5i64) ?| (0i64 - 1i64);
        if (wr != 5i64) { exit 11i32; }
        discard(sys(3i64, wfd) ?| 0i64);
        drop fill(buf, cap, sv);
        rd_n = sys(0i64, rfd, buf, 64i64) ?| (0i64 - 1i64);
        rd = raw span_union(rd, raw changed(buf, cap, sv));
        // at EOF the answer is 0 and nothing is written
        drop fill(buf, cap, sv);
        int64:eof = sys(0i64, rfd, buf, 64i64) ?| (0i64 - 1i64);
        if (eof != 0i64) { exit 13i32; }
        if ((raw changed(buf, cap, sv)).hi != 0i64) { exit 13i32; }
        discard(sys(3i64, rfd) ?| 0i64);
    }
    if (rd_n != 5i64) { exit 11i32; }
    if (!(raw exactly(rd, raw claimed(0i64, rd_n)))) { exit 12i32; }
    if (rd_n > 64i64) { exit 14i32; }                                      // the row's bound: arg3
    // a failing read writes nothing
    drop fill(buf, cap, 165u8);
    Result<int64>:rbad = sys(0i64, 0i64 - 1i64, buf, 64i64);
    if (!rbad.is_error) { exit 14i32; }
    if ((raw changed(buf, cap, 165u8)).hi != 0i64) { exit 14i32; }

    // ---- getrandom (318): eight bytes, the floor's own shape. RANDOM bytes: an edge byte
    // may equal the first sentinel in one pass and the second in the other (1 in 65,536), so
    // the exact span must show in ONE of eight attempts while EVERY attempt stays inside it.
    if (((raw ke_buf_arg(318i64)) != 1i64) || ((raw ke_bound_arg(318i64)) != 2i64)) { exit 20i32; }   // the row's buffer and bound columns
    bool:gr_exact = false;
    for (int64:attempt in 0i64...8i64) {
        Span:gs = Span{ lo: 0i64, hi: 0i64 };
        int64:gn = 0i64;
        for (int64:gp in 0i64...2i64) {
            uint8:gv = 165u8;
            if (gp == 1i64) { gv = 90u8; }
            drop fill(buf, cap, gv);
            gn = sys(318i64, buf, 8i64, 0i64) ?| (0i64 - 1i64);
            if (gn != 8i64) { exit 21i32; }
            gs = raw span_union(gs, raw changed(buf, cap, gv));
        }
        if (gs.hi > (raw claimed(318i64, gn))) { exit 22i32; }             // never past the row
        if (raw exactly(gs, raw claimed(318i64, gn))) { gr_exact = true; }
    }
    if (!gr_exact) { exit 22i32; }

    // ---- clock_gettime (228): the monotonic clock writes sixteen bytes; a bad clock id writes none
    if (((raw ke_buf_arg(228i64)) != 2i64) || ((raw ke_bound_arg(228i64)) != 0i64)) { exit 30i32; }   // the row's buffer and bound columns
    Span:cs = Span{ lo: 0i64, hi: 0i64 };
    for (int64:cp in 0i64...2i64) {
        uint8:cv = 165u8;
        if (cp == 1i64) { cv = 90u8; }
        drop fill(buf, cap, cv);
        int64:cr = sys(228i64, 1i64, buf) ?| (0i64 - 1i64);
        if (cr != 0i64) { exit 31i32; }
        cs = raw span_union(cs, raw changed(buf, cap, cv));
    }
    if (!(raw exactly(cs, raw claimed(228i64, 0i64)))) { exit 32i32; }
    drop fill(buf, cap, 165u8);
    Result<int64>:cbad = sys(228i64, 12345i64, buf);
    if (!cbad.is_error) { exit 33i32; }
    if ((raw changed(buf, cap, 165u8)).hi != 0i64) { exit 33i32; }

    // ---- sched_getaffinity (204): the RAW call writes `result` bytes of the 128 asked, and no more
    if (((raw ke_buf_arg(204i64)) != 3i64) || ((raw ke_bound_arg(204i64)) != 2i64)) { exit 40i32; }   // the row's buffer and bound columns
    Span:afs = Span{ lo: 0i64, hi: 0i64 };
    int64:an = 0i64;
    for (int64:ap in 0i64...2i64) {
        uint8:av = 165u8;
        if (ap == 1i64) { av = 90u8; }
        drop fill(buf, cap, av);
        an = sys(204i64, 0i64, 128i64, buf) ?| (0i64 - 1i64);
        if (an <= 0i64) { exit 41i32; }
        afs = raw span_union(afs, raw changed(buf, cap, av));
    }
    if (an > 128i64) { exit 42i32; }                                       // the row's bound: arg2
    if (!(raw exactly(afs, raw claimed(204i64, an)))) { exit 42i32; }

    // ---- rt_sigaction (13): the old action of SIGUSR2, thirty-two bytes whatever the sigset size
    if (((raw ke_buf_arg(13i64)) != 3i64) || ((raw ke_bound_arg(13i64)) != 0i64)) { exit 50i32; }   // the row's buffer and bound columns
    Span:ss = Span{ lo: 0i64, hi: 0i64 };
    for (int64:sp in 0i64...2i64) {
        uint8:sv2 = 165u8;
        if (sp == 1i64) { sv2 = 90u8; }
        drop fill(buf, cap, sv2);
        int64:sr = sys(13i64, 12i64, 0i64, buf, 8i64) ?| (0i64 - 1i64);
        if (sr != 0i64) { exit 51i32; }
        ss = raw span_union(ss, raw changed(buf, cap, sv2));
    }
    if (!(raw exactly(ss, raw claimed(13i64, 0i64)))) { exit 52i32; }

    // ---- sigaltstack (131, 1.5.8 step 2): the old signal stack -- the floor registered one for this
    // thread at startup (D-305) -- read into the buffer: twenty-four bytes, the padding after
    // ss_flags included (the kernel zeroes its stack_t before it copies it out)
    if (((raw ke_buf_arg(131i64)) != 2i64) || ((raw ke_bound_arg(131i64)) != 0i64)) { exit 80i32; }   // the row's buffer and bound columns
    Span:ks = Span{ lo: 0i64, hi: 0i64 };
    for (int64:kp in 0i64...2i64) {
        uint8:sv3 = 165u8;
        if (kp == 1i64) { sv3 = 90u8; }
        drop fill(buf, cap, sv3);
        int64:kr = sys(131i64, 0i64, buf) ?| (0i64 - 1i64);
        if (kr != 0i64) { exit 81i32; }
        ks = raw span_union(ks, raw changed(buf, cap, sv3));
    }
    if (!(raw exactly(ks, raw claimed(131i64, 0i64)))) { exit 82i32; }

    // ---- epoll_pwait (281): one ready eventfd of sixteen -> twelve bytes, events at +0, data at +4
    if (((raw ke_buf_arg(281i64)) != 2i64) || ((raw ke_bound_arg(281i64)) != 3i64)) { exit 60i32; }   // the row's buffer and bound columns
    Span:es = Span{ lo: 0i64, hi: 0i64 };
    for (int64:ep in 0i64...2i64) {
        uint8:ev_s = 165u8;
        if (ep == 1i64) { ev_s = 90u8; }
        int64:epfd = sys(291i64, 524288i64) ?| (0i64 - 1i64);              // epoll_create1(EPOLL_CLOEXEC)
        int64:evfd = sys(290i64, 0i64, 526336i64) ?| (0i64 - 1i64);        // eventfd2(0, CLOEXEC|NONBLOCK)
        if ((epfd < 0i64) || (evfd < 0i64)) { exit 61i32; }
        // the packed 12-byte event: events = EPOLLIN (1), data = 0x1122334455667788, little-endian
        drop fill(aux, 12i64, 0u8);
        <-(#ptr_add<uint8>(aux, 0i64)) = 1u8;
        <-(#ptr_add<uint8>(aux, 4i64)) = 136u8;
        <-(#ptr_add<uint8>(aux, 5i64)) = 119u8;
        <-(#ptr_add<uint8>(aux, 6i64)) = 102u8;
        <-(#ptr_add<uint8>(aux, 7i64)) = 85u8;
        <-(#ptr_add<uint8>(aux, 8i64)) = 68u8;
        <-(#ptr_add<uint8>(aux, 9i64)) = 51u8;
        <-(#ptr_add<uint8>(aux, 10i64)) = 34u8;
        <-(#ptr_add<uint8>(aux, 11i64)) = 17u8;
        int64:ctl = sys(233i64, epfd, 1i64, evfd, aux) ?| (0i64 - 1i64);
        if (ctl != 0i64) { exit 61i32; }
        // nothing ready yet: the answer is 0 and nothing is written
        drop fill(buf, cap, ev_s);
        int64:none = sys(281i64, epfd, buf, 16i64, 0i64, 0i64, 8i64) ?| (0i64 - 1i64);
        if (none != 0i64) { exit 62i32; }
        if ((raw changed(buf, cap, ev_s)).hi != 0i64) { exit 62i32; }
        // make it ready: write the counter's eight bytes
        drop fill(aux, 8i64, 0u8);
        <-(#ptr_add<uint8>(aux, 0i64)) = 1u8;
        int64:ew = sys(1i64, evfd, aux, 8i64) ?| (0i64 - 1i64);
        if (ew != 8i64) { exit 61i32; }
        drop fill(buf, cap, ev_s);
        int64:got = sys(281i64, epfd, buf, 16i64, 0i64, 0i64, 8i64) ?| (0i64 - 1i64);
        if (got != 1i64) { exit 63i32; }
        if (got > 16i64) { exit 63i32; }                                   // the row's bound: arg3
        es = raw span_union(es, raw changed(buf, cap, ev_s));
        // the layout the floor reads: stride 12, the payload at +4
        if ((<-(#ptr_add<uint8>(buf, 0i64))) != 1u8) { exit 65i32; }
        if ((<-(#ptr_add<uint8>(buf, 4i64))) != 136u8) { exit 65i32; }
        if ((<-(#ptr_add<uint8>(buf, 11i64))) != 17u8) { exit 65i32; }
        discard(sys(3i64, evfd) ?| 0i64);
        discard(sys(3i64, epfd) ?| 0i64);
    }
    if (!(raw exactly(es, raw claimed(281i64, 1i64)))) { exit 64i32; }

    // ---- mmap (9): the floor's one shape -- private, anonymous -- is fresh and ZERO
    int64:map = sys(9i64, 0i64, 4096i64, 3i64, 34i64, 0i64 - 1i64, 0i64) ?| 0i64;
    if (map <= 0i64) { exit 70i32; }
    wild int8->:mp = #wild_ptr<int8>(map);
    for (int64:mi in 0i64...4096i64) {
        if ((<-(#ptr_add<uint8>(mp, mi))) != 0u8) { exit 71i32; }
    }
    discard(sys(11i64, map, 4096i64) ?| 0i64);

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault)   { exit 99i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
