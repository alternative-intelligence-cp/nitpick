// expect-exit: 24
//
// A tainted ternary value at a bare comparison TRAPS (-4100) — D-008 §5
// through D-197, the one taint discipline every twisted family shares.
// `is_err` looks without trapping and the `pick` ERR arm is the sanctioned
// branch; a bare `<` is neither.
mod:tern_cmp_err;

func:main = int32(cstring[]:argv) {
    tryte:z = (argv.len =>! int32 - 1i32) =>! tryte;   // 0 at run time
    tryte:e = 100 / z;                                  // ERR
    tryte:limit_v = 5;
    if (e < limit_v) { exit 10i32; }                    // must trap
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow) { exit 97i32; },
        (TbbErr)         { exit 24i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom)        { exit 95i32; },
        (Unreachable)    { exit 97i32; },
        (WildLeak)       { exit 98i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
