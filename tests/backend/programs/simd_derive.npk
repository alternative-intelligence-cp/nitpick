// expect-exit: 42
//
// DERIVE OVER A `simd` FIELD (D-194, 1.3.1): `Eq` derives — the field's
// `!=` is a verdict vector, and the generated body collapses it with
// `.any()` — and `Clone` copies the vector as the plain value it is. The
// five derives with no lane meaning refuse by name (DERIVE-005,
// `tests/derive/rejection/simd_field.npk`).
mod:simd_derive;
error:EDv;
#[derive(Eq, Clone)]
struct:V = { simd<flt64, 2>:a; int32:b; };
func:main = int32(cstring[]:_~argv) {
    V:x = V{ a: simd(1.0f64, 2.0f64), b: 3i32 };
    V:y = x.clone() ?! EDv;
    if (!(x.eq(y) ?! EDv)) { exit 11i32; }
    V:z = V{ a: simd(1.0f64, 9.0f64), b: 3i32 };
    if (x.eq(z) ?! EDv) { exit 12i32; }
    exit 42i32;
};
func:failsafe = int32(Error:e) {
    pick (e) { (EDv) { exit 81i32; }, (HeapOom) { exit 95i32; }, (HeapBadRequest) { exit 95i32; }, (OutOfBounds) { exit 96i32; }, (Unreachable) { exit 97i32; }, (WildLeak) { exit 98i32; }, (*) { exit 99i32; } }
    exit 9i32;
};
