// expect-exit: 7
//
// The control: good divisions still divide. 10/2 + 7%2 + (-9)/-3 - 8u/4u =
// 5 + 1 + 3 - 2 = 7 (signed division truncates toward zero) — the guard must
// not fire on any of them, and the unsigned path gets its own case.

func:main = int32(cstring[]:argv) {
    int32:one = argv.len =>! int32;
    int32:a = 10i32 / (one + 1i32);
    int32:b = 7i32 % (one + 1i32);
    int32:c = (0i32 - 9i32) / (0i32 - 3i32);
    uint32:d = 8u32 / 4u32;
    int32:sum = (a + b + c) - (d =>! int32);
    exit sum;
};

func:failsafe = int32(Error:_~err) { exit 1i32; };
