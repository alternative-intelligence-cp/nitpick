// THE ROADS a constant's text takes to the emitter's one writer besides a literal in a body, each with a
// text past the cap: a module binding, one under a sign, an aggregate's element, a literal with no suffix
// in a `flt64` slot, `comptime(...)` and `comptime(-...)`.
fixed flt64:M_ONE = 0.;
fixed flt64:M_NEG = -.0e-24001f64;
fixed flt64[2]:M_ARR = [0.1f64, 0.];

func:roads = int32() never fails {
    if ((raw b64(M_ONE)) != 4607182418800017408u64) { pass 1i32; }
    if ((raw b64(M_NEG)) != (4607182418800017408u64 | (1u64 << 63u64))) { pass 2i32; }
    if ((raw b64(M_ARR[1])) != 4607182418800017408u64) { pass 3i32; }
    flt64:u = .0e-24001;
    if ((raw b64(u)) != 4607182418800017408u64) { pass 4i32; }
    flt64:c = comptime(0.);
    if ((raw b64(c)) != 4607182418800017408u64) { pass 5i32; }
    flt64:cn = comptime(-.0e-24001f64);
    if ((raw b64(cn)) != (4607182418800017408u64 | (1u64 << 63u64))) { pass 6i32; }
    pass 0i32;
};

