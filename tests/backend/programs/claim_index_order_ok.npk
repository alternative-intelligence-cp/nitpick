// expect-exit: 7
// THE INDEXES OF A CLAIMED PLACE RUN INNERMOST FIRST, AND THE BINDINGS ANALYSIS WALKS THEM IN THAT
// ORDER (DEF-407; landing 175's second delta review, R1). In `g[s.len - 4].c[consume(move(s)) - 2]`
// the inner index reads `s` BEFORE the outer one moves it, so the claim is legal and names `g[1].c[3]`
// (8); the arithmetic is in bounds only in that order (the other order reads a vacated `s`: len 0,
// index -4, an `OutOfBounds` trap), so exit 7 measures the EMITTER's order as well as the analysis's.
// The same for an unassigned `k` assigned (`$$m k`, the out-parameter) in the inner index and read
// in the outer: `g[seti($$m k) - 1].c[k - 1]` names `g[0].c[0]` (1). Three roads each: a `$$m`
// claim, a `$$i` claim, an `@` address (the last two go through `assign_expr`'s two-operand road,
// which always walked a left operand first). Landing 174 accepts all six, as this build does; the
// first commit of 175 refused the two `$$m` roads (MOVE-001 at `s.len`, ASSIGN-001 at `k`) and
// accepted their mirrors -- the reversed orders are tests/analysis/rejection/claim_index.npk's.
mod:claim_index_order_ok;
error:E5;
struct:Row = { int32[4]:c; };
func:consume = int64(move string:x) never fails { pass x.len; };
func:fill = NIL(int32->:q) never fails { pass NIL; };
func:seti = int64(int64->:p) never fails { (<-p) = 1i64; pass 1i64; };
func:move_m = int64() never fails {
    string:s = string_concat("ab", "cde");
    Row[2]:g = [Row{ c: [1i32, 2i32, 3i32, 4i32] }, Row{ c: [5i32, 6i32, 7i32, 8i32] }];
    drop fill($$m g[s.len - 4i64].c[(raw consume(move(s))) - 2i64]);
    pass (g[1i64].c[3i64] => int64);
};
func:move_i = int64() never fails {
    string:s = string_concat("ab", "cde");
    Row[2]:g = [Row{ c: [1i32, 2i32, 3i32, 4i32] }, Row{ c: [5i32, 6i32, 7i32, 8i32] }];
    drop fill($$i g[s.len - 4i64].c[(raw consume(move(s))) - 2i64]);
    pass (g[1i64].c[3i64] => int64);
};
func:move_a = int64() never fails {
    string:s = string_concat("ab", "cde");
    Row[2]:g = [Row{ c: [1i32, 2i32, 3i32, 4i32] }, Row{ c: [5i32, 6i32, 7i32, 8i32] }];
    drop fill(@g[s.len - 4i64].c[(raw consume(move(s))) - 2i64]);
    pass (g[1i64].c[3i64] => int64);
};
func:assign_m = int64() never fails {
    int64:k;
    Row[2]:g = [Row{ c: [1i32, 2i32, 3i32, 4i32] }, Row{ c: [5i32, 6i32, 7i32, 8i32] }];
    drop fill($$m g[(raw seti($$m k)) - 1i64].c[k - 1i64]);
    pass (g[0i64].c[0i64] => int64);
};
func:assign_i = int64() never fails {
    int64:k;
    Row[2]:g = [Row{ c: [1i32, 2i32, 3i32, 4i32] }, Row{ c: [5i32, 6i32, 7i32, 8i32] }];
    drop fill($$i g[(raw seti($$m k)) - 1i64].c[k - 1i64]);
    pass (g[0i64].c[0i64] => int64);
};
func:assign_a = int64() never fails {
    int64:k;
    Row[2]:g = [Row{ c: [1i32, 2i32, 3i32, 4i32] }, Row{ c: [5i32, 6i32, 7i32, 8i32] }];
    drop fill(@g[(raw seti($$m k)) - 1i64].c[k - 1i64]);
    pass (g[0i64].c[0i64] => int64);
};
func:main = int32(cstring[]:_~argv) {
    if ((raw move_m()) != 8i64)   { exit 51i32; }
    if ((raw move_i()) != 8i64)   { exit 52i32; }
    if ((raw move_a()) != 8i64)   { exit 53i32; }
    if ((raw assign_m()) != 1i64) { exit 54i32; }
    if ((raw assign_i()) != 1i64) { exit 55i32; }
    if ((raw assign_a()) != 1i64) { exit 56i32; }
    exit 7i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (IntOverflow)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StackExhausted)   { exit 96i32; },
        (MachineFault)     { exit 97i32; },
        (OutOfBounds)      { exit 98i32; },
        (E5)               { exit 55i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
