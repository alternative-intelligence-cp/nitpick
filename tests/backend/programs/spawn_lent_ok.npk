// expect-exit: 0
// stress: 40
// explore: 1000
//
// A SPAWN LENDS ITS CROSSING UNTIL THE BLOCK'S JOIN (DEF-148, 1.6.1e step 1;
// the library listener's F-022): the owner and two tasks allocate in one
// shared arena while it is lent -- `alloc` and `get` are the contract's own
// operations (D-154) -- a helper that only allocates takes `@s` while it is
// lent, and the arena is destroyed after the block whose exit joined the tasks.
// The refusals of the same shape are `tests/analysis/rejection/spawn_lent.npk`.
mod:spawn_lent_ok;
error:E1;
error:E2;
error:E3;
error:E9;
fixed Duration:J2 = Duration{ ns: 2000000000i64 };

thread async func:filler = NIL(shared_arena<int64>->:s, Channel<int64, 4i32, 4i64>:done,
                               int64:base) joins J2 {
    int64:i = 0i64;
    int64:last = 0i64;
    while (i < 50i64) decreases 50i64 - i {
        Handle<int64>:h = s.alloc(base + i);
        last = s.get(h) ?! E9;
        i = i + 1i64;
    }
    await done.send(last, raw duration_ms(500i64)) ?! E9;
    pass NIL;
};
func:fill_one = NIL(shared_arena<int64>->:p, int64:v) never fails {
    Handle<int64>:h = p.alloc(v);
    discard(h);
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    Channel<int64, 4i32, 4i64>:done = channel() ?! Unreachable;
    shared_arena<int64>:s = shared_arena_make(8i64);
    {
        drop filler(@s, done, 2000i64);
        drop filler(@s, done, 5000i64);
        // the owner's own operations while the arena is lent
        Handle<int64>:h0 = s.alloc(1000i64);
        if ((s.get(h0) ?! E9) != 1000i64) { exit 10i32; }
        drop fill_one(@s, 1001i64);
    }
    int64:a = await done.recv(raw duration_ms(5i64)) ?! E9;
    int64:b = await done.recv(raw duration_ms(5i64)) ?! E9;
    if ((a + b) != 7098i64) { exit 11i32; }
    s.destroy();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E1) { exit 81i32; },
        (E2) { exit 82i32; },
        (E3) { exit 83i32; },
        (E9) { exit 89i32; },
        (IntOverflow) { exit 90i32; },
        (StaleHandle) { exit 92i32; },
        (ChannelClosed) { exit 93i32; },
        (DeadlineExceeded) { exit 94i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom) { exit 95i32; },
        (OutOfBounds) { exit 95i32; },
        (Unreachable) { exit 96i32; },
        (WildLeak) { exit 97i32; },
        (StackExhausted) { exit 98i32; },
        (MachineFault) { exit 98i32; },
        (DecreasesViolated) { exit 98i32; },
        (LimitViolated) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 99i32;
};
