// expect-exit: 0
// stress: 40
// explore: 1000
//
// THE LEGAL HALF OF DEF-393(a) (landing 173): what the spawn's `lends` mark
// keeps legal. The mark refuses a dereference OUT of a lending frame; it does
// not refuse the dereference-out itself, nor a spawn that lends.
//   - `mk_nospawn` (control 1) builds a `Mutex` and returns it with
//     `pass move(<-sp)`, with NO spawn -- the frame does not lend, so the
//     dereference-out is legal, as it was on 172. This is the discriminating
//     control: the refusal in tests/analysis/rejection/spawn_lends.npk is
//     conditional on the spawn, not on the `move(<-sp)`.
//   - `spawn_noderef` (control 2) hands a sanctioned `Mutex` pointer to a
//     spawn -- so the frame lends, and the task stores a frame borrow through
//     it -- but returns a plain `int32`, not a dereference out of the frame, so
//     there is nothing for the mark to refuse. `v` is dropped at the frame's
//     end with its dangling interior never read.
// Exit 0 at both legs under this compiler and under 172's. The refused shapes
// are tests/analysis/rejection/spawn_lends.npk.
mod:spawn_lends_ok;
error:E1;

fixed Duration:J2 = Duration{ ns: 2000000000i64 };

// A task that stores the caller's frame-local barrier into the lock's interior
// (the lend). Harmless in control 2 because that frame never dereferences out.
thread async func:worker = NIL(Mutex<Barrier<1i32, 5i32>->, 3i32>->:dst, Barrier<1i32, 5i32>->:q) joins J2 {
    Guard<Barrier<1i32, 5i32>->>:g = await dst.acquire(raw duration_ms(500i64)) ?! E1;
    g.value = q;
    pass NIL;
};

// Control 1: a factory with NO spawn -- the frame does not lend, so
// `pass move(<-sp)` is legal.
async func:mk_nospawn = Mutex<Barrier<1i32, 5i32>->, 3i32>(Barrier<1i32, 5i32>->:ext) {
    Mutex<Barrier<1i32, 5i32>->, 3i32>:v = mutex(ext) ?! E1;
    Mutex<Barrier<1i32, 5i32>->, 3i32>->:sp = @v;
    pass move(<-sp);
};

// Control 2: a spawn that lends, but the frame returns a plain `int32` -- no
// dereference out of the frame, so the `lends` mark refuses nothing.
async func:spawn_noderef = int32(Barrier<1i32, 5i32>->:ext) {
    Barrier<1i32, 5i32>:b = barrier() ?! E1;
    Mutex<Barrier<1i32, 5i32>->, 3i32>:v = mutex(ext) ?! E1;
    { drop worker(@v, @b); }
    pass 7i32;
};

async func:main = int32(cstring[]:_~argv) {
    // Control 1: build the lock, return it, use it in place.
    Barrier<1i32, 5i32>:o1 = barrier() ?! E1;
    Mutex<Barrier<1i32, 5i32>->, 3i32>:ra = await mk_nospawn(@o1) ?! E1;
    {
        Guard<Barrier<1i32, 5i32>->>:g = await ra.acquire(raw duration_ms(500i64)) ?! E1;
        await g.value.arrive(raw duration_ms(500i64)) ?! E1;
    }
    // Control 2: a spawn that lends, frame returns a plain int.
    Barrier<1i32, 5i32>:o2 = barrier() ?! E1;
    int32:n = await spawn_noderef(@o2) ?! E1;
    if (n != 7i32) { exit 21i32; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (DeadlineExceeded)  { exit 112i32; },
        (StaleHandle)       { exit 113i32; },
        (E1)                { exit 114i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
