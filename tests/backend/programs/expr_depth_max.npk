// expect-exit: 0
//
// DEF-150's c2 (1.6.1e step 2): THE DEEPEST TREE THE COMPILER ADMITS. No node sits
// more than 256 levels below its root, a function's body block counting as the
// first (AST_DEPTH_MAX, ast.npk): `main`'s body (1), a statement (2) and an
// expression of height 254 are the bound exactly, and a function's `pass` of one
// the same. Two shapes of the 254: 254 parentheses nested to the RIGHT (the
// parser's own descent), and a chain of 254 terms nested to the LEFT, which the
// parser builds in a loop and which ran the constant folder off its stack at 600
// before the bound measured the tree. Both parse, fold and run; one level more is
// `NITPICK-PARSE-012` (`tests/frontend/parse_decls.npk`'s depth cases).
mod:expr_depth_max;

func:chain = int32() never fails {
    pass 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32 + 1i32;
