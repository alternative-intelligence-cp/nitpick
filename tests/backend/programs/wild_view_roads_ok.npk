func:c_frame_list_range = int64() never fails { List<SS>:l = raw list_init::<SS>(4i64); drop list_push(@l, SS{ s: raw mks() }); SS[]:v = l[0i64...1i64]; v[0i64].s = raw mks(); pass v[0i64].s.len + 2i64; };
