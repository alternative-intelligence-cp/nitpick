// expect-exit: 0
// THE ROADS BESIDE `tests/types/rejection/wild_view_plain_slot.npk` AND `wild_view_generic.npk` (DEF-486, z36, RULED, landing 177d2). Over room not yet written the view is `wild T[]`, whose element store drops nothing;
// over a live block it's the crossing, `v =>! T[]`, which a `fixed T[]` slot takes too; a view over something that isn't manual storage, or of an element with nothing to drop and no pointer to hold, stays plain. A generic's
// plain `T[]` over a block stands at an argument that doesn't drop, a bare `T: Copy` always, and a generic that crosses or says `wild T[]` at any argument. Every cell's value comes through the view (`mks` makes five bytes), each returns 7, and `main` compares. Before this landing the first four were the only sound spellings too; nothing changes for them.
mod:wild_view_roads_ok;
error:E5;
func:mks = string() never fails { pass string_concat("ab", "cde"); };
struct:SS = { string:s; };
struct:ASS = { SS[2]:q; };
struct:API = { int64->[2]:a; };
struct:HL = { List<SS>:l; };
struct:HSV = { SS[]:sv; };
struct:PI = { int64:n; };
struct:Box<T> = { T:x; };
struct:WH<T> = { wild T->:w; };
func:set = NIL(string->:p) never fails { <-p = raw mks(); pass NIL; };
func:rd = int64(string[]:v) never fails { pass v[0i64].len; };
func:setw = NIL(wild SS[]:v) never fails { v[0i64].s = raw mks(); pass NIL; };
func:setr = int64(SS[]:p) never fails { SS[]:v = p[0i64...1i64]; v[0i64].s = raw mks(); pass v[0i64].s.len; };
func:setp = int64(ASS->:p) never fails { SS[]:v = (<-p).q[0i64...2i64]; v[0i64].s = raw mks(); pass v[0i64].s.len; };
func:gv<T> = T[](wild T->:w) never fails { pass #wild_slice<T>(w, 1i64); };
func:fw<T> = T[](wild T->:w) never fails { pass raw gv::<T>(w); };
func:gb<T> = Box<T>[](wild Box<T>->:w) never fails { pass #wild_slice<Box<T>>(w, 1i64); };
func:gc<T: Copy> = T[](wild T->:w) never fails { pass #wild_slice<T>(w, 1i64); };
func:gxc<T> = T[](wild T->:w) never fails { pass #wild_slice<T>(w, 1i64) =>! T[]; };
func:gwv<T> = int64(wild T->:w) never fails { wild T[]:v = #wild_slice<T>(w, 1i64); pass v.len; };
impl:<T>:WH<T> = { func:view = T[](WH<T>->:self) never fails { pass #wild_slice<T>(self.w, 1i64); }; };
func:c_wild_view_writes_room = int64() never fails { wild SS->:w = alloc(256i64) =>! wild SS->; discard(memset(w, 65i64, 256i64)); int64:n = 0i64; { wild SS[]:v = #wild_slice<SS>(w, 1i64); v[0i64].s = raw mks(); n = v[0i64].s.len + 2i64; } SS:o = move(<-w); dalloc(w); pass n; };
func:c_wild_view_takes_whole = int64() never fails { wild string->:w = alloc(64i64) =>! wild string->; discard(memset(w, 65i64, 64i64)); int64:n = 0i64; { wild string[]:v = #wild_slice<string>(w, 1i64); v[0i64] = raw mks(); n = v[0i64].len + 2i64; } string:o = move(<-w); dalloc(w); pass n; };
func:c_wild_param_takes_it = int64() never fails { wild SS->:w = alloc(256i64) =>! wild SS->; discard(memset(w, 65i64, 256i64)); drop setw(#wild_slice<SS>(w, 1i64)); int64:n = w.s.len + 2i64; SS:o = move(<-w); dalloc(w); pass n; };
func:c_range_into_wild_local = int64() never fails { wild ASS->:w = alloc(256i64) =>! wild ASS->; discard(memset(w, 65i64, 256i64)); int64:n = 0i64; { wild SS[]:v = w.q[0i64...2i64]; v[0i64].s = raw mks(); v[1i64].s = raw mks(); n = v[1i64].s.len + 2i64; } ASS:o = move(<-w); dalloc(w); pass n; };
