func:c_crossed_fixed = int64() never fails { wild SS->:w = alloc(256i64) =>! wild SS->; discard(memset(w, 0i64, 256i64)); <-w = SS{ s: raw mks() }; int64:n = 0i64; { fixed SS[]:v = (#wild_slice<SS>(w, 1i64) =>! SS[]); n = v[0i64].s.len + 2i64; } SS:o = move(<-w); dalloc(w); pass n; };
