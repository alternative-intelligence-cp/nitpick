func:c_crossed_range = int64() never fails { wild ASS->:w = alloc(256i64) =>! wild ASS->; discard(memset(w, 0i64, 256i64)); w.q = [SS{ s: raw mks() }, SS{ s: raw mks() }]; int64:n = 0i64; { SS[]:v = w.q[0i64...2i64] =>! SS[]; v[0i64].s = raw mks(); n = v[0i64].s.len + 2i64; } ASS:o = move(<-w); dalloc(w); pass n; };
func:c_range_of_crossed = int64() never fails { wild SS->:w = alloc(256i64) =>! wild SS->; discard(memset(w, 0i64, 256i64)); <-w = SS{ s: raw mks() }; int64:n = 0i64; { SS[]:v = #wild_slice<SS>(w, 1i64) =>! SS[]; SS[]:u = v[0i64...1i64]; u[0i64].s = raw mks(); n = u[0i64].s.len + 2i64; } SS:o = move(<-w); dalloc(w); pass n; };
func:c_crossed_element_address = int64() never fails { wild string->:w = alloc(256i64) =>! wild string->; discard(memset(w, 0i64, 256i64)); <-w = raw mks(); int64:n = 0i64; { string[]:v = #wild_slice<string>(w, 1i64) =>! string[]; drop set(@v[0i64]); n = v[0i64].len + 2i64; } string:o = move(<-w); dalloc(w); pass n; };
func:c_crossed_param = int64() never fails { wild string->:w = alloc(256i64) =>! wild string->; discard(memset(w, 0i64, 256i64)); <-w = raw mks(); int64:n = (raw rd(#wild_slice<string>(w, 1i64) =>! string[])) + 2i64; string:o = move(<-w); dalloc(w); pass n; };
func:c_int_view = int64() never fails { wild int64->:w = alloc(64i64) =>! wild int64->; discard(memset(w, 0i64, 64i64)); int64[]:v = #wild_slice<int64>(w, 1i64); v[0i64] = 7i64; int64:n = v[0i64]; dalloc(w); pass n; };
func:c_int_view_element_address = int64() never fails { wild int64->:w = alloc(64i64) =>! wild int64->; discard(memset(w, 0i64, 64i64)); int64[]:v = #wild_slice<int64>(w, 1i64); int64->:p = @v[0i64]; <-p = 7i64; int64:n = <-p; dalloc(w); pass n; };
