func:main = int32(cstring[]:_~argv) {
    if ((raw c_wild_view_writes_room()) != 7i64) { exit 1i32; }
    if ((raw c_wild_view_takes_whole()) != 7i64) { exit 2i32; }
    if ((raw c_wild_param_takes_it()) != 7i64) { exit 3i32; }
    if ((raw c_range_into_wild_local()) != 7i64) { exit 4i32; }
    if ((raw c_crossed_over_written()) != 7i64) { exit 5i32; }
    if ((raw c_crossed_fixed()) != 7i64) { exit 6i32; }
    if ((raw c_crossed_then_fixed_local()) != 7i64) { exit 7i32; }
    if ((raw c_crossed_range()) != 7i64) { exit 8i32; }
    if ((raw c_range_of_crossed()) != 7i64) { exit 9i32; }
    if ((raw c_crossed_element_address()) != 7i64) { exit 10i32; }
    if ((raw c_crossed_param()) != 7i64) { exit 11i32; }
    if ((raw c_int_view()) != 7i64) { exit 12i32; }
    if ((raw c_int_view_element_address()) != 7i64) { exit 13i32; }
    if ((raw c_no_drop_struct_view()) != 7i64) { exit 14i32; }
    if ((raw c_frame_list_range()) != 7i64) { exit 15i32; }
    if ((raw c_list_in_block_range()) != 7i64) { exit 16i32; }
    if ((raw c_frame_array_range()) != 7i64) { exit 17i32; }
    if ((raw c_plain_param_range()) != 7i64) { exit 18i32; }
    if ((raw c_plain_pointer_range()) != 7i64) { exit 19i32; }
    if ((raw c_plain_slice_field_in_block()) != 7i64) { exit 20i32; }
    if ((raw c_range_of_plain_slice_field()) != 7i64) { exit 21i32; }
    if ((raw c_gen_at_int64()) != 7i64) { exit 22i32; }
    if ((raw c_gen_at_no_drop_struct()) != 7i64) { exit 23i32; }
    if ((raw c_gen_forwarded_at_int64()) != 7i64) { exit 24i32; }
    if ((raw c_gen_box_at_int64()) != 7i64) { exit 25i32; }
    if ((raw c_gen_method_at_int64()) != 7i64) { exit 26i32; }
    if ((raw c_gen_copy_bound_at_int64()) != 7i64) { exit 27i32; }
    if ((raw c_gen_crossed_over_written()) != 7i64) { exit 28i32; }
    if ((raw c_gen_wild_view_at_struct()) != 7i64) { exit 29i32; }
    if ((raw c_elem_read_direct()) != 7i64) { exit 30i32; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)       { exit 74i32; },
        (IntOverflow)       { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (HeapBadRequest)    { exit 93i32; },
        (WildLeak)          { exit 94i32; },
        (StackExhausted)    { exit 96i32; },
        (MachineFault)      { exit 97i32; },
        (OutOfBounds)       { exit 98i32; },
        (LimitViolated)     { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (DeadlineExceeded)  { exit 76i32; },
        (E5)                { exit 75i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
