// expect-exit: 0
mod:generic_async_local_across_await_ok;
// A LOCAL WHOSE TYPE HOLDS A TYPE PARAMETER LIVES IN THE FRAME ACROSS A SUSPENSION (DEF-533, landing 177d2b). An owning local is
// used at its scope's exit, where its drop reads it, so the suspend walk keeps it in the coroutine's frame; the checker marks which
// declarations own, and it asked `type_drops`, which reads a bare `T` as owning nothing. So in a generic `async` function a `T`,
// `T?`, `T[1]`, `Result<T>` or `Bx<T>` local declared before an `await` and not named after it stayed in the resume function's own
// allocas, and at an instance that owns (a `string`, a `List`, a `buffer`, a struct or an array of them) the drop after the `await`
// read a slot nothing had written: 74 or 97 at `opt -O2`, right at -O0 only because old stack bytes survive. THE PROGRAM STAGE RUNS
// `opt -O2`, AND THAT IS THE LEG THIS TEST CAN FAIL ON. `t_*` are the forms of the declared type, `i_*` the instance types, `p_*`
// the places the declaration stands in and the ways the function is reached, `c_*` the controls, whose emission the fix leaves alone.
error:Bad;
mod:t_T = {
error:E5_t_T;
async func:hp<T> = int32(move T:v) { T:x = move(v); await sleep(raw duration_ms(20i64)) ?| NIL; pass 7i32; };
pub async func:f = int32() { string:o = string_concat("ab","cd"); int32:k = await hp(move(o)) ?! E5_t_T; pass k; };
pub async func:cell_main = int32() { int32:v = await f() ?! E5_t_T; pass v; };
};
