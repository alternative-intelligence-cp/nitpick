// expect-exit: 32
//
// A `requires` FALSE AT THE ENTRY traps `RequiresViolated` (-4112; 1.5.3
// step 1) in the callee's `.req` predicate, called from its checked entry;
// the argument is computed from `argv` so no build folds the call away.

mod:contract_trap_req;
error:E9;

func:half = int32(int32:n) requires n > 0i32 { pass (n + 1i32); };

func:main = int32(cstring[]:argv) {
    int32:k = (argv.len =>! int32) - 1i32;   // 0 when run without arguments
    int32:v = half(k) ?! E9;
    exit (v + 1i32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (RequiresViolated)  { exit 32i32; },
        (EnsuresViolated)   { exit 33i32; },
        (InvariantViolated) { exit 34i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
