// expect-exit: 21
//
// The div guard is total over width (0.9.3): a zero divisor at i128 traps to
// failsafe with DIV_BY_ZERO exactly as i32 does — and the INT_MIN check is
// STRUCTURAL (the one nonzero value equal to its own negation), so no width
// ships unguarded by a missing table row.

func:main = int32(cstring[]:argv) {
    int128:zero = (argv.len - 1i64) => int128;   // 0, at run time
    int128:q = 5i128 / zero;
    exit (q =>! int32);
};

func:failsafe = int32(tbb32:err) {
    if ((err => int64) == (0i64 - 4097i64)) { exit 21i32; }
    exit 9i32;
};
