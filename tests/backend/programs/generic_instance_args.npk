// expect-exit: 0
//
// DEF-191 (1.6.1e step 3a): A GENERIC CALL REACHES THE INSTANCE ITS OWN TYPE
// ARGUMENTS NAME. The emitter re-derived a call's instance from the callee's
// SUBSTITUTED SIGNATURE -- "two instantiations of one declaration differ in their
// substituted signature, so the arguments that reached this call say which one it
// is" -- and that is false for a type parameter that appears in no parameter type
// and not in the return type: every instance of `bytes_of<T>` below is an
// `int64()`. Both instances were emitted, and EVERY CALL REACHED THE FIRST ONE
// RECORDED: `bytes_of::<int64>()` answered 4 after `bytes_of::<int32>()` had been
// seen, in silence, at both legs, on every compiler since 1.0.2b. The checker
// records each call's type arguments now (`ExprTypes.callee_targs`) and the
// emitter matches the instance by them -- the key the instance table dedups by.
//
// Each case below answered wrongly before: two scalar instances; two array
// instances (the shape it was found on, writing DEF-189's test); a value
// parameter beside the type parameter, the larger instance asked first; two
// template-shaped instances inside one generic body, at two specializations of
// the caller; and a generic coroutine awaited at three.
mod:generic_instance_args;
error:E1;

func:bytes_of<T> = int64() never fails { pass #size_of<T>(); };
func:scaled<T> = int64(int64:n) never fails { pass n * #size_of<T>(); };
func:pair_bytes<A, B> = int64(A:_~a, B:_~b) never fails {
    pass ((raw bytes_of::<A>()) * 10i64) + (raw bytes_of::<B>());
};
async func:abytes<T> = int64() { pass #size_of<T>(); };

async func:main = int32(cstring[]:_~argv) {
    if ((raw bytes_of::<int32>()) != 4i64)    { exit 10i32; }
    if ((raw bytes_of::<int64>()) != 8i64)    { exit 11i32; }
    if ((raw bytes_of::<int32[3]>()) != 12i64) { exit 12i32; }
    if ((raw bytes_of::<int32[5]>()) != 20i64) { exit 13i32; }
    if ((raw bytes_of::<int8>()) != 1i64)     { exit 14i32; }

    if ((raw scaled::<int64>(3i64)) != 24i64) { exit 15i32; }
    if ((raw scaled::<int8>(3i64)) != 3i64)   { exit 16i32; }

    if ((raw pair_bytes(1i8, 2i64)) != 18i64)  { exit 17i32; }   // 1 * 10 + 8
    if ((raw pair_bytes(1i32, 2i16)) != 42i64) { exit 18i32; }   // 4 * 10 + 2

    int64:a = await abytes::<int8>() ?! E1;
    int64:b = await abytes::<int64>() ?! E1;
    int64:c = await abytes::<int16>() ?! E1;
    if (a != 1i64) { exit 19i32; }
    if (b != 8i64) { exit 20i32; }
    if (c != 2i64) { exit 21i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E1) { exit 90i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
