struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
func:idh = H->(H->:q) never fails { pass q; };
func:getl = List<int64>->(H->:w) never fails { pass @w.l; };
struct:HPO = { H->:lp; List<int64>:own; };
struct:SQ = { HPO->:q; int64:z; };
struct:SP2 = { HPO->->:pp; int64:z; };
func:setlp = NIL(HPO->:d, H->:q) never fails { (<-d).lp = q; pass NIL; };
func:set2 = NIL(HPO->->:d, H->:q) never fails { (<-(<-d)).lp = q; pass NIL; };
func:setq = NIL(SQ->:d, H->:q) never fails { (<-((<-d).q)).lp = q; pass NIL; };
func:g = int64(H->:h0p, H->:hq, H->:hz, int64:n) never fails {
    int64->:e = raw fp(h0p);
    H:hl = raw mkh();
    HPO:m = HPO{ lp: h0p, own: raw mk() }; HPO->:mp = @m; HPO->->:mpp = @mp; SQ:s = SQ{ q: @m, z: 1i64 }; SQ->:sp = @s; SP2:s2s = SP2{ pp: @mp, z: 1i64 };
    HPO->[1]:a1 = [@m]; HPO->->[1]:a2 = [@mp]; HPO->[]:ps = a1[0i64...1i64]; HPO->->[]:s2 = a2[0i64...1i64];
    drop setq(sp, raw idh(hq));
    e = raw fp(m.lp);
    int64:r = <-e;
    discard(raw growh(hq));
    pass r + 6i64;
};
func:f = int64(int64:n) never fails {
    H:hz = raw mkh(); H:h0 = raw mkh(); H:h2 = raw mkh();
    pass raw g(@h0, @h2, @hz, n);
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
