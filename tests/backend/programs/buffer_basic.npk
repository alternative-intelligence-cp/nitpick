// `buffer` — the managed owning byte cell (D-200/TYPE §23, 1.3.7).
//
// The string's twin: `{ptr, len, cap}`, born zeroed from `buffer_new(n)`
// with `len == cap == n`, reached through `.ptr` (reads index it; writes go
// through `#ptr_add` and `<-`), and DROPPED AT SCOPE EXIT by the 1.2
// managed regime — the exit-time leak registry proves the reclaim in the
// same breath as the `exit 0`. `n <= 0` is the EMPTY buffer — null, no
// cell, nothing to drop — an answer, not an error: `buffer_new` never
// fails (allocation failure traps, D-150), which is why the call needs no
// `raw` and no `?!`.
mod:buffer_basic;

func:main = int32(cstring[]:_~argv) {
    // Born zeroed, len == cap == n.
    buffer:b = buffer_new(16i64);
    if (b.len != 16i64)                          { exit 10i32; }
    if (b.cap != 16i64)                          { exit 11i32; }
    if (b.ptr[0i64] != 0u8)                      { exit 12i32; }
    if (b.ptr[15i64] != 0u8)                     { exit 13i32; }

    // Writes through the general mechanism, reads through the trio.
    <-(#ptr_add<uint8>(b.ptr, 0i64)) = 7u8;
    <-(#ptr_add<uint8>(b.ptr, 15i64)) = 9u8;
    if (b.ptr[0i64] != 7u8)                      { exit 14i32; }
    if (b.ptr[3i64] != 0u8)                      { exit 15i32; }
    if (b.ptr[15i64] != 9u8)                     { exit 16i32; }

    // Wider elements over the same bytes: an int64 lattice.
    buffer:w = buffer_new(64i64);
    int64:i = 0i64;
    while (i < 8i64) {
        <-(#ptr_add<int64>(w.ptr, i)) = i * 100i64;
        i = i + 1i64;
    }
    if ((<-(#ptr_add<int64>(w.ptr, 5i64))) != 500i64) { exit 17i32; }

    // `n <= 0` is the empty non-owning buffer, not an error.
    buffer:e0 = buffer_new(0i64);
    if (e0.len != 0i64)                          { exit 18i32; }
    if (e0.cap != 0i64)                          { exit 19i32; }
    buffer:en = buffer_new(0i64 - 3i64);
    if (en.cap != 0i64)                          { exit 20i32; }

    // An inner scope's buffer drops at its exit; the registry stays clean.
    {
        buffer:inner = buffer_new(4096i64);
        <-(#ptr_add<uint8>(inner.ptr, 4095i64)) = 1u8;
        if (inner.ptr[4095i64] != 1u8)           { exit 21i32; }
    }

    // A buffer MOVES like the owner it is; the source dies at the move.
    buffer:m0 = buffer_new(8i64);
    <-(#ptr_add<uint8>(m0.ptr, 2i64)) = 42u8;
    buffer:m1 = move(m0);
    if (m1.ptr[2i64] != 42u8)                    { exit 22i32; }

    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapOom) { exit 95i32; },
        (HeapBadRequest) { exit 95i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 97i32; },
        (WildLeak) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
