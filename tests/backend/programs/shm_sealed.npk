// expect-exit: 42
//
// THE SEALED SHARED MEMORY (D-149, 1.1.13; poc test 1's shape). A memfd
// created, sized, SEALED against shrink/grow, and mapped shared. The seal
// is the load-bearing line of the whole driver architecture: without it a
// hostile `ftruncate(fd, 0)` from the driver makes the next runtime access
// take SIGBUS — the driver crashing the runtime through the data plane. So
// this proves BOTH: the mapping is writable and readable, AND the seals are
// set: `shm_seal_holds` reads the seal word back (F_GET_SEALS) and asks for
// shrink, grow and seal together. The kernel enforces a seal that's set; the
// hostile-driver fixture (bridge_hd_f1, bridge_hd_f4) covers the driver's
// side. Wild-and-sys code, the nlibc tier.
mod:shm_sealed;
use "../../../lib/nbridge.npk".*;
error:E9;

func:main = int32(cstring[]:_~argv) {
    Shm:s = shm_create_sealed(4096i64) ?! E9;

    // the mapping is live: write a byte near the end, read it back
    <-(#ptr_add<int8>(s.base, 4000i64)) = 55i8;
    if ((<-(#ptr_add<int8>(s.base, 4000i64))) != 55i8) { exit 11i32; }

    // THE SEAL HOLDS: the descriptor is hidden (DEF-719's row), so the test
    // asks the library, which reads the seal word (fcntl F_GET_SEALS): shrink,
    // grow and seal must all be set. A missing seal would let a hostile
    // driver's `ftruncate(fd, 0)` make the next access take SIGBUS, the bomb
    // the seal exists to prevent, and fails the test.
    if (!(raw shm_seal_holds(@s))) { exit 12i32; }   // all three seals MUST be set

    // the mapping still answers after the seal read
    if ((<-(#ptr_add<int8>(s.base, 4000i64))) != 55i8) { exit 14i32; }

    shm_unmap(move(s)) ?! E9;   // unmaps, and closes the region's descriptor (its one owner)
    exit 42i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)             { exit 91i32; },
        (EShmCreate)     { exit 92i32; },
        (EShmSeal)       { exit 93i32; },
        (EShmMap)        { exit 94i32; },
        (EDriverSpawn)   { exit 90i32; },
        (EDriverFault)   { exit 90i32; },
        (EDriverProtocol){ exit 90i32; },
        (EDriverDeadline){ exit 90i32; },
        (ERingFull)      { exit 90i32; },
        (EBridgePoisoned){ exit 90i32; },
        (DeadlineExceeded){ exit 90i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom)        { exit 95i32; },
        (IntOverflow) { exit 97i32; },
        (OutOfBounds)    { exit 96i32; },
        (Unreachable)    { exit 97i32; },
        (WildLeak)       { exit 98i32; },
        (StackExhausted) { exit 99i32; },
        (MachineFault)   { exit 99i32; },
        (DecreasesViolated) { exit 99i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
