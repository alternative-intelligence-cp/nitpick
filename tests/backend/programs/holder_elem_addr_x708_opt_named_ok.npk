// pointer to a `List` (`grow(w)`, `Wrap:w = Wrap{ lp: @l }`), handed to a callee while an element address into that `List` is live, is judged as a
// view's holder is: `rejudge_holder` (alias.npk) raises the live element address beside the views when the argument is neither an address-of nor of
// pointer type, an `Optional` or `Result` of a pointer unwrapped first (it is a pointer). RIGHT PROGRAM (T3-708d): exit 67 on main (aefae6e) and here
// on every road 0-8, -O0 and -O2, and under the detector; named at l.19843 (`growo2(om)`, an `Optional` of the pointer handed by name): 67 on main,
// refused by T3-708a, b and c, accepted by T3-708d, which unwraps the argument's type first (l.19874 item 1). From seat T3's cells (l.19843,
// l.19874), `Team/TMP/plan-177d2d-t3-2026-11-19/cells/def708m/x708_opt_named.npk`.
mod:holder_elem_addr_x708_opt_named_ok;
error:E5;
struct:K = { int64:k; };
struct:H = { List<int64>:l; int64:k; K:kk; };
func:mk = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh = H() never fails { pass H{ l: raw mk(), k: 2i64, kk: K{ k: 3i64 } }; };
func:growh = int64(H->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:growl = int64(List<int64>->:l) never fails { loop(0i64, 64i64, 1i64) { drop list_push(l, 1i64); } pass 7i64; };
func:fp = int64->(H->:q) never fails { pass @((<-q).l[0i64]); };
struct:HPO = { H->:lp; List<int64>:own; };
func:growp = int64(HPO->:p) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@p.own, 1i64); } pass 7i64; };
func:growo = int64(HPO->?:o) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@((<-(o ??! E5)).own), 1i64); } pass 7i64; };
func:growr = int64(Result<HPO->>:r) never fails { if (r.is_error) { pass 7i64; } loop(0i64, 64i64, 1i64) { drop list_push(@((<-(r.value)).own), 1i64); } pass 7i64; };
func:mknone = HPO->?() never fails { pass NIL; };
struct:HP2 = { List<int64>:a; List<int64>:own; };
func:growo2 = int64(HP2->?:o) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@((<-(o ??! E5)).own), 1i64); } pass 7i64; };
func:idw2 = HP2->?(HP2->?:w) never fails { pass w; };

func:f = int64(int64:n) never fails {
    HP2:m = HP2{ a: raw mk(), own: raw mk() };
    HP2->?:om = @m;
    int64->:e = @(m.a[0i64]);
    discard(raw growo2(om));   // the Optional by name (as m_r4c_rooted)
    pass (<-e) + 6i64;
};
func:main = int32(cstring[]:argv) { exit (((raw f(argv.len)) + 60i64) =>! int32); };
func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 74i32; },
        (E5)               { exit 75i32; },
        (IntOverflow)      { exit 91i32; },
