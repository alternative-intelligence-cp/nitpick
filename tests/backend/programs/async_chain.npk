// expect-exit: 42
//
// THE FIRST ASYNC PROGRAMS (D-177, 1.1.4 stage C). Every `async` function
// below is a switched-resume state machine over a heap frame; `await`
// composes machines — allocate the callee's frame, store the arguments,
// drive its resume, copy the result slot out at DONE, free the frame — and
// `async main` runs under the entry shim that `@main` now is.
//
// The shapes exercised: a two-level awaited chain (`mid` awaits `leaf`);
// `relay await` propagating a child's `fail` verbatim through two machines
// into `?|`; a `while` loop whose condition and step live entirely in
// frame-resident PARAMETERS (the only cross-suspension storage stage C
// allows); pipelining a value through the NEXT await's argument, which is
// how results chain without a crossing local; and zero-argument machines.
mod:async_chain;
error:E7;

async func:one = int32() {
    pass 1i32;
};

async func:leaf = int32(int32:v) {
    if (v > 100i32) { fail E7; }
    pass v * 2i32;
};

async func:mid = int32(int32:v) {
    int32:a = relay await leaf(v);
    pass a + 1i32;
};

async func:spin = int32(int32:n) {
    while (n > 3i32) {
        n = n - 1i32;
        discard(await one() ?| 1i32);
    }
    pass n;
};

async func:failing = int32(int32:v) {
    int32:a = relay await leaf(v + 200i32);
    pass a;
};

async func:with_spin = int32(int32:c) {
    int32:d = await spin(9i32) ?| 0i32;      // 3
    pass c + d + 38i32;
};

async func:main = int32(cstring[]:_~argv) {
    int32:a = await mid(20i32) ?| 0i32;      // 41
    int32:b = await leaf(a) ?| 0i32;         // 82
    int32:c = await failing(b) ?| 1i32;      // fail E7 -> 1
    int32:r = await with_spin(c) ?| 0i32;    // 1 + 3 + 38
    exit r;                                  // 42
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 111i32; },
        (E7) { exit 111i32; },
        (HeapBadRequest) { exit 111i32; },
        (HeapOom) { exit 111i32; },
        (Unreachable) { exit 111i32; },
        (WildLeak) { exit 111i32; },
        (*) { exit 111i32; }
    }
    exit 111i32;
};
