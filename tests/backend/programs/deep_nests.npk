// expect-exit: 0
// DEF-281 AND DEF-278 (landing 152): FOUR NESTS THE FRONT HALF COULD NOT FINISH.
// A nest of loops walked its innermost body 2^n times in the bindings analysis
// (`assign_loop_body`'s silent pre-pass repeated at every level: twenty levels
// two seconds and 476 MB, twenty-four past 6 GB), and a nest of pick EXPRESSIONS
// was typed and escape-walked twice per level (twenty levels 25 s, twenty-four
// past five minutes). Each nest here is well past where landing 151's compiler
// stopped, and well within the AST's bound (a `while` is two levels, a `for`
// and a `loop` two, a pick expression nested through `give` four). The runners
// bound a compile's time, so a walk that doubles again is a red, not a hang.
mod:deep_nests;

// 100 nested `while (b) unbounded` loops whose `b` is false: the body never runs.
func:whiles = int32() never fails {
    int32:x = 1i32;
    bool:b = false;
    while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { while (b) unbounded { x = x + 1i32; } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } 
    pass x;
};

