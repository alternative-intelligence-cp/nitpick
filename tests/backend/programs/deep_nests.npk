    int32:y = pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give pick (x) { (1i32) { give x; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } }; }, (*) { give 0i32; } };
    pass y;
};

func:main = int32(cstring[]:_~argv) {
    if ((raw whiles()) != 1i32) { exit 1i32; }
    if ((raw fors()) != 2i32) { exit 2i32; }
    if ((raw loops()) != 2i32) { exit 3i32; }
    if ((raw picks()) != 1i32) { exit 4i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (IntOverflow) { exit 23i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (StackExhausted) { exit 9i32; },
        (MachineFault) { exit 9i32; },
        (DecreasesViolated) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
