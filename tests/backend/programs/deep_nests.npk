    for (int32:i0 in 0i32...1i32) { for (int32:i1 in 0i32...1i32) { for (int32:i2 in 0i32...1i32) { for (int32:i3 in 0i32...1i32) { for (int32:i4 in 0i32...1i32) { for (int32:i5 in 0i32...1i32) { for (int32:i6 in 0i32...1i32) { for (int32:i7 in 0i32...1i32) { for (int32:i8 in 0i32...1i32) { for (int32:i9 in 0i32...1i32) { for (int32:i10 in 0i32...1i32) { for (int32:i11 in 0i32...1i32) { for (int32:i12 in 0i32...1i32) { for (int32:i13 in 0i32...1i32) { for (int32:i14 in 0i32...1i32) { for (int32:i15 in 0i32...1i32) { for (int32:i16 in 0i32...1i32) { for (int32:i17 in 0i32...1i32) { for (int32:i18 in 0i32...1i32) { for (int32:i19 in 0i32...1i32) { for (int32:i20 in 0i32...1i32) { for (int32:i21 in 0i32...1i32) { for (int32:i22 in 0i32...1i32) { for (int32:i23 in 0i32...1i32) { for (int32:i24 in 0i32...1i32) { for (int32:i25 in 0i32...1i32) { for (int32:i26 in 0i32...1i32) { for (int32:i27 in 0i32...1i32) { for (int32:i28 in 0i32...1i32) { for (int32:i29 in 0i32...1i32) { for (int32:i30 in 0i32...1i32) { for (int32:i31 in 0i32...1i32) { for (int32:i32 in 0i32...1i32) { for (int32:i33 in 0i32...1i32) { for (int32:i34 in 0i32...1i32) { for (int32:i35 in 0i32...1i32) { for (int32:i36 in 0i32...1i32) { for (int32:i37 in 0i32...1i32) { for (int32:i38 in 0i32...1i32) { for (int32:i39 in 0i32...1i32) { for (int32:i40 in 0i32...1i32) { for (int32:i41 in 0i32...1i32) { for (int32:i42 in 0i32...1i32) { for (int32:i43 in 0i32...1i32) { for (int32:i44 in 0i32...1i32) { for (int32:i45 in 0i32...1i32) { for (int32:i46 in 0i32...1i32) { for (int32:i47 in 0i32...1i32) { for (int32:i48 in 0i32...1i32) { for (int32:i49 in 0i32...1i32) { for (int32:i50 in 0i32...1i32) { for (int32:i51 in 0i32...1i32) { for (int32:i52 in 0i32...1i32) { for (int32:i53 in 0i32...1i32) { for (int32:i54 in 0i32...1i32) { for (int32:i55 in 0i32...1i32) { for (int32:i56 in 0i32...1i32) { for (int32:i57 in 0i32...1i32) { for (int32:i58 in 0i32...1i32) { for (int32:i59 in 0i32...1i32) { x = x + 1i32; } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } 
    pass x;
};

// 60 nested counted loops of one trip each: the innermost body runs once.
func:loops = int32() never fails {
    int32:x = 1i32;
    loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { loop(0i32, 1i32, 1i32) { x = x + 1i32; } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } 
    pass x;
};

