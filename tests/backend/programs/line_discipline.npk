// expect-exit: 0
//
// D-050 at run time: line endings are a property of the STREAM. Reading text
// normalizes `\r\n`, `\n`, and a lone `\r` to `\n`; writing emits `\n` unless
// the writer was CREATED asking for `\r\n`; and the byte path underneath
// (write_file / read_file) translates nothing, ever — which is what lets this
// test plant exact bytes and then check exact bytes.

error:E9;

use "../../../lib/nio.npk".*;

func:bytes_equal = bool(string:a, string:b) never fails {
    if (a.len != b.len) { pass false; }
    int64:i = 0i64;
    while (i < a.len) {
        if (a.ptr[i] != b.ptr[i]) { pass false; }
        i = i + 1i64;
    }
    pass true;
};

func:main = int32(cstring[]:_~argv) {
    // --- reading normalizes, the byte path does not -------------------------
    cstring:p1 = to_cstring(".internal/line_discipline_in.tmp") ?! E9;
    // All three ending shapes in one buffer, planted byte-exactly.
    Result<NIL>:w = write_file(p1, "alpha\r\nbeta\rgamma\ndelta");
    if (w.is_error)                                          { exit 10i32; }

    Result<string>:back = read_file(p1);
    if (back.is_error)                                       { exit 11i32; }
    if (!(raw bytes_equal(back.value, "alpha\r\nbeta\rgamma\ndelta")))
                                                             { exit 12i32; }

    string:text = nio_read_text(p1) ?! E9;
    if (!(string_equals(text, "alpha\nbeta\ngamma\ndelta"))) { exit 13i32; }

    // The pure normalizer, on the shapes a buffer can end with.
    if (!(string_equals(nio_normalize("a\r\nb\r") ?! E9, "a\nb\n")))
                                                             { exit 14i32; }
    if (!(string_equals(nio_normalize("plain") ?! E9, "plain")))
                                                             { exit 15i32; }

    // --- writing emits \n; \r\n is a creation choice ------------------------
    cstring:p2 = to_cstring(".internal/line_discipline_lf.tmp") ?! E9;
    NioW:lf = nio_create(p2, NioEnding.Lf) ?! E9;
    nio_line(@lf, "one") ?! E9;
    nio_line(@lf, "two") ?! E9;
    Result<NIL>:e1 = nio_end(@lf);
    if (e1.is_error)                                         { exit 16i32; }
    Result<string>:lfb = read_file(p2);
    if (lfb.is_error)                                        { exit 17i32; }
    if (!(raw bytes_equal(lfb.value, "one\ntwo\n")))         { exit 18i32; }

    cstring:p3 = to_cstring(".internal/line_discipline_crlf.tmp") ?! E9;
    NioW:cw = nio_create(p3, NioEnding.CrLf) ?! E9;
    nio_line(@cw, "one") ?! E9;
    // An interior `\n` in the TEXT is a logical newline like any other, so the
    // CrLf writer translates it too — the program never writes `\r` itself.
    nio_put(@cw, "mid\ntail") ?! E9;
    Result<NIL>:e2 = nio_end(@cw);
    if (e2.is_error)                                         { exit 19i32; }
    Result<string>:crb = read_file(p3);
    if (crb.is_error)                                        { exit 20i32; }
    if (!(raw bytes_equal(crb.value, "one\r\nmid\r\ntail"))) { exit 21i32; }

    // `wild_release_all()` used to sit here, appeasing the leak check before
    // the managed lowering existed. Under D-183 the drops ARE the cleanup, and
    // a wholesale release before scope exit frees the very bodies the drops
    // are about to free again — the interim's tool colliding with the thing
    // that replaced it. It remains what it always was: failsafe's instrument
    // (leak_cleanup exercises that), not ordinary main's.

    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (OutOfBounds) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
