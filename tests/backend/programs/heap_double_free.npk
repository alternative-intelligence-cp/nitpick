// expect-exit: 24
//
// DOUBLE-FREE IS A TRAP, NOT UB (0.10.0, D-150). The static analysis already
// refuses a double-free of a TRACKED binding (D-119); this program launders
// the pointer through an alias — assignment does not move (D-065), so the
// second binding is one the analysis deliberately does not follow — and the
// slab's out-of-band bitmap catches the second free deterministically:
// the slot's free bit is already set, so npk_trap(-4102) routes to failsafe.

func:main = int32(cstring[]:_~argv) {
    wild int8->:a = alloc(24i64);
    wild int8->:b = a;
    dalloc(a);
    dalloc(b);
    exit 0i32;
};

func:failsafe = int32(tbb32:err) {
    if ((err =>! int64) == (0i64 - 4102i64)) { exit 24i32; }
    exit 9i32;
};
