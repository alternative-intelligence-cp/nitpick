// expect-exit: 70
//
// D-210 THROUGH THE OTHER SPELLING. `x += y` and `x = x + y` are one
// arithmetic core since 1.3.3 — the extraction made for exactly this reason,
// after compound assignment was found to be a SECOND implementation of the
// operators that wrapped where the expression form guarded. The guard is
// inherited, not re-written, and this is the test that says so.
mod:overflow_compound;

func:one = int32() never fails { pass 1i32; };

func:main = int32(cstring[]:_~argv) {
    int32:c = 2147483646i32;
    c += raw one();                     // lands exactly on INT_MAX: no trap
    if (c != 2147483647i32) { exit 11i32; }
    c += raw one();                     // ...and the next step has nowhere to go
    exit c;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 70i32; },
        (Unreachable)    { exit 93i32; },
        (WildLeak)       { exit 94i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
