// expect-exit: 42
//
// FLOAT ToString KNOWN-ANSWER VECTORS (S6b) -- generated by the workbench
// python against the platform's shortest-round-trip repr; values built
// FROM BITS so literal parsing is out of the loop. Curated torture cases
// (subnormal floor, max finite, 2^53 neighbours, the 2.225e-308 pair,
// signed zeros, infinities, nan) plus 200 random flt64 and 100 random
// flt32 bit patterns, seed 20260827.
mod:flt_tostring;

func:f64bits = flt64(uint64:w) never fails {
    wild int8->:b = alloc(8i64);
    wild uint64->:ip = b =>! wild uint64->;
    <-ip = w;
    wild flt64->:fp = b =>! wild flt64->;
    flt64:v = <-fp;
    drop dalloc(b);
    pass v;
};
func:f32bits = flt32(uint32:w) never fails {
    wild int8->:b = alloc(4i64);
    wild uint32->:ip = b =>! wild uint32->;
    <-ip = w;
    wild flt32->:fp = b =>! wild flt32->;
    flt32:v = <-fp;
    drop dalloc(b);
    pass v;
};
func:ck64 = bool(uint64:w, string:want) never fails {
    flt64:v = raw f64bits(w);
    pass (raw string_equals(`&{ v }`, want));
};
func:ck32 = bool(uint32:w, string:want) never fails {
    flt32:v = raw f32bits(w);
    pass (raw string_equals(`&{ v }`, want));
};
