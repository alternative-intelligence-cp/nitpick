// expect-exit: 41
//
// A MEASURE THAT DOES NOT SHRINK (D-304, 1.5.8c step 1): `decreases i` on a
// loop whose `i` grows -- the second visit's measure is not below the first's,
// and the head's check traps `DecreasesViolated` through `failsafe`, 41. The
// first visit compares against nothing (there is no previous trip yet), so the
// body runs exactly once before the stop: `acc` is 1, never 2.
mod:decreases_grow;
error:E9;

func:main = int32(cstring[]:argv) {
    int32:n = 10i32 + ((argv.len - 1i64) =>! int32);
    int32:i = 0i32;
    int32:acc = 0i32;
    while (i < n) decreases i { acc = acc + 1i32; i = i + 1i32; }
    exit (acc =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (DecreasesViolated) { exit 41i32; },
        (InvariantViolated) { exit 34i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
