// expect-exit: 42
//
// `&{ }` TEMPLATE INTERPOLATION (D-168, 1.0.9d). Inside a backtick template a
// `string` renders as itself; any other type renders through the prelude trait
// `ToString`, and the whole template lowers to a `string_concat` chain. The
// prelude supplies `ToString` for the integer widths and `bool` over the floor's
// `int_to_string`. A literal part keeps its whitespace — the lexer treats a
// template part as verbatim content, not code to skip trivia in.
mod:template;

func:main = int32(cstring[]:_~argv) {
    int32:n = 7i32;
    bool:ok = true;
    string:who = "world";
    uint64:big = 1000000000000000000u64;         // 10^18, 19 digits
    tbb32:t = 5tbb32;
    string:msg = `n=&{n} ok=&{ok} hi &{who}`;     // "n=7 ok=true hi world" = 20 bytes
    if ((raw string_byte_length(msg)) != 20i64) { exit 90i32; }
    string:m2 = `big=&{big} t=&{t}`;              // "big=1000000000000000000 t=5" = 27
    if ((raw string_byte_length(m2)) != 27i64) { exit (raw string_byte_length(m2)) =>! int32; }
    exit 42i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (TbbErr) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
