// expect-exit: 60
//
// A STACK OVERFLOW IS A CONTROLLED TRAP (D-305, 1.5.8 step 2; DEF-59). Every
// function the compiler emits compares its frame against the thread's limit
// word before allocating it; the floor's `__morestack` is the trap route's
// `StackExhausted`. This recursion has no bottom: on the main thread's 8 MiB
// it reaches the limit and `failsafe` answers 60 -- where until this step the
// process died of SIGSEGV with no `failsafe` at all (`npkc` itself, under
// `ulimit -s 2048`, exited 139).
mod:stack_exhausted;

// A recursion the optimiser cannot turn into a loop: each level passes the
// address of its own local down, and the bottom reads through it.
func:deep = int64(int64:n, int64->:prev) never fails {
    if (n == 0i64) { pass (<-prev); }
    int64:mine = n;
    pass ((raw deep(n - 1i64, @mine)) + 1i64);
};

func:main = int32(cstring[]:argv) {
    int64:seed = argv.len;
    int64:r = raw deep(1000000000000i64, @seed);
    if (r == 0i64) { exit 3i32; }
    exit 4i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (StackExhausted) { exit 60i32; },
        (IntOverflow)    { exit 93i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (MachineFault)   { exit 61i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
