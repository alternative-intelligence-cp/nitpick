thread async func:takecfd = NIL(move SC:x, Channel<int64, 3i32, 64i64>:done) joins J2 {
    await sleep(raw duration_ms(1i64)) ?| NIL;
    fixed uint8[]:xb = string_bytes(x.s);
    await done.send((xb[0i64] => int64), raw duration_ms(2000i64)) ?! E1;
    pass NIL;
};
// R1's commit (landing 172; management's review of the first build, 99f83e7): a dereference of a pointer answers YES
// in a function that LENDS -- some call, a builtin's included, handed a borrow of the frame -- because a callee or a
// builtin may store a borrow into the target where no mark records it (DEF-390). `main` lends (its other controls hand
// borrows to calls), so controls 28 and 37 stand here, in functions that lend nothing; each answers 1 if the vacant
// pointee was not assigned, and `main` compares at the control's own exit.
async func:pointee_moved_recv = int64(Channel<int64, 3i32, 64i64>:done) {
    SC:w = SC{ s: string_concat("ab", "c"), k: 1i64 };
    SC->:sp = @w;
    {
        drop (move(<-sp)).takecd(done);
    }
    w = SC{ s: string_concat("de", "f"), k: 2i64 };
    if (w.s.len != 3i64) { pass 1i64; }
    pass 0i64;
};
async func:pointee_moved_arg = int64(Channel<int64, 3i32, 64i64>:done) {
    SC:w = SC{ s: string_concat("ab", "c"), k: 1i64 };
    SC->:sp = @w;
    {
        drop takecfd(move(<-sp), done);
    }
    w = SC{ s: string_concat("de", "f"), k: 2i64 };
    if (w.s.len != 3i64) { pass 1i64; }
    pass 0i64;
};
