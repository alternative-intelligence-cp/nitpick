    {
        await gen_arr_moved::<string>(string_concat("ab", "c"), string_concat("de", "f"), done) ?! E1;
        int64:got34 = await done.recv(raw duration_ms(2000i64)) ?! E1;
        if (got34 != 100i64) { exit 34i32; }
    }
    // 35. (c7a) control 7's ARGUMENT spelling: the pick expression handed to a by-value `W` parameter, its arm viewing
    //     `d` and writing ANOTHER string -- refused NITPICK-BORROW-004 by landing 171 (the walk answered YES for the
    //     byte read through the live view `v`, whatever its type, DEF-378), legal here; the task reports 104
    {
        string:d = string_concat("hello", " world");
        string:o = string_concat("ab", "c");
        {
            drop lookwd(pick (1i32) { (*) {
                fixed uint8[]:v = string_bytes(d);
                o = string_concat("xyzzy", "!");
                give W{ k: (v[0i64] => int64) }; } }, done);
        }
        int64:got35 = await done.recv(raw duration_ms(2000i64)) ?! E1;
        if (got35 != 104i64) { exit 35i32; }
        if (o.len != 6i64) { exit 35i32; }
    }
    // 36. (c8a) control 8's argument spelling: the root written AFTER the block's join
    {
        string:d = string_concat("hello", " world");
        {
            drop lookwd(pick (1i32) { (*) {
                fixed uint8[]:v = string_bytes(d);
                give W{ k: (v[0i64] => int64) }; } }, done);
        }
        d = string_concat("xyzzy", "!");
        int64:got36 = await done.recv(raw duration_ms(2000i64)) ?! E1;
        if (got36 != 104i64) { exit 36i32; }
        if (d.len != 6i64) { exit 36i32; }
    }
    // 37. (c28a; t171/p364/ u1) control 28's argument spelling: the owning pointee TRANSFERRED into a `move SC`
    //     parameter through the pointer, `takecfd(move(<-sp), done)` -- refused NITPICK-BORROW-004 by landing 171 (the
    //     walk answered YES for the pointee whatever its type, DEF-378), legal here in a function that hands no borrow
    //     to a call; the pointee is left VACANT and assigned before a read; the task reports 97. In a function of its
    //     own, `pointee_moved_arg`, since R1's commit
    {
        int64:bad37 = await pointee_moved_arg(done) ?! E1;
        int64:got37 = await done.recv(raw duration_ms(2000i64)) ?! E1;
        if (got37 != 97i64) { exit 37i32; }
        if (bad37 != 0i64) { exit 37i32; }
    }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (DeadlineExceeded)  { exit 112i32; },
        (StaleHandle)       { exit 113i32; },
        (E1)                { exit 114i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
#[derive(Clone)]
struct:SC = { string:s; int64:k; };
impl:SC = {
    // Landing 171 (test item C): control 29 spawns this, and the task REPORTS the byte it read; landing 172 (F4):
    // control 28 too.
    thread async func:takecd = NIL(move SC:self, Channel<int64, 3i32, 64i64>:done) joins J2 {
        await sleep(raw duration_ms(1i64)) ?| NIL;
        fixed uint8[]:xb = string_bytes(self.s);
        await done.send((xb[0i64] => int64), raw duration_ms(2000i64)) ?! E1;
        pass NIL;
    };
};
// Landing 172: controls 30-34's receivers and tasks.
struct:HV = { int64:b; };
impl:HV = {
    thread async func:rdvd = NIL(HV:self, Channel<int64, 3i32, 64i64>:done) joins J2 {
        await sleep(raw duration_ms(1i64)) ?| NIL;
        await done.send(self.b, raw duration_ms(2000i64)) ?! E1;
        pass NIL;
    };
};
struct:Bx<T> = { T:v; };
thread async func:peekbd = NIL(Bx<int64>:x, Channel<int64, 3i32, 64i64>:done) joins J2 {
    await sleep(raw duration_ms(1i64)) ?| NIL;
    await done.send(x.v, raw duration_ms(2000i64)) ?! E1;
    pass NIL;
};
trait:Fb = { func:fb = int64(Self:self) never fails; };
impl:string:Fb = {
    func:fb = int64(string:self) never fails {
        fixed uint8[]:b = string_bytes(self);
        if (b.len == 0i64) { pass 0i64; }
        pass (b[0i64] => int64);
    };
};
thread async func:takeod<T: Fb> = NIL(move T?:x, Channel<int64, 3i32, 64i64>:done) joins J2 {
    await sleep(raw duration_ms(1i64)) ?| NIL;
    T:v = move(x) ??! E1;
    await done.send(raw v.fb(), raw duration_ms(2000i64)) ?! E1;
    pass NIL;
};
async func:gen_opt_moved<T: Fb> = NIL(move T:a, Channel<int64, 3i32, 64i64>:done) {
    T?:o = move(a);
    {
        drop takeod::<T>(move(o), done);
    }
    pass NIL;
};
thread async func:takead<T: Fb> = NIL(move T[2]:x, Channel<int64, 3i32, 64i64>:done) joins J2 {
    await sleep(raw duration_ms(1i64)) ?| NIL;
    await done.send(raw x[1i64].fb(), raw duration_ms(2000i64)) ?! E1;
    pass NIL;
};
async func:gen_arr_moved<T: Fb> = NIL(move T:a, move T:b, Channel<int64, 3i32, 64i64>:done) {
    T[2]:o = [move(a), move(b)];
    {
        drop takead::<T>(move(o), done);
    }
    pass NIL;
};
// Landing 172: controls 35-37's tasks, each REPORTING what it read.
thread async func:lookwd = NIL(W:w, Channel<int64, 3i32, 64i64>:done) joins J2 {
    await sleep(raw duration_ms(1i64)) ?| NIL;
    await done.send(w.k, raw duration_ms(2000i64)) ?! E1;
    pass NIL;
