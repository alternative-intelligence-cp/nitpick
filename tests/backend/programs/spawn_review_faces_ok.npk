    {
        string:d = string_concat("hello", " world");
        int64:b0 = 0i64;
        {
            fixed uint8[]:db = string_bytes(d);
            b0 = (db[0i64] => int64);
        }
        HV:hv = HV{ b: b0 };
        {
            drop hv.rdvd(done);
            d = string_concat("xyzzy", "!");
        }
        int64:got30 = await done.recv(raw duration_ms(2000i64)) ?! E1;
        if (got30 != 104i64) { exit 30i32; }
    }
    // 31. a by-value receiver HOLDING A BORROW, `H{ p: @d }`, AWAITED by name, `await h.rdb()`: the caller is suspended
