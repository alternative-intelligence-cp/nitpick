// The imported half of `import_scope_table.npk` and `import_scope_loud.npk` -- a
// fixture, not a program (no `main`): a struct and two `fixed` bindings typed by it.
mod:import_scope_lib;

pub struct:Row = { int64:x; int64:y; };
pub fixed Row[2]:ROWS = [ Row{ x: 1i64, y: -2i64 }, Row{ x: 3i64, y: -4i64 } ];
pub fixed Row:ONE = Row{ x: 5i64, y: -6i64 };
