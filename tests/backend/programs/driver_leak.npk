// expect-exit: 45
// stress: 40
// argv: MOCK_DRIVER
//
// A CLEAN EXIT NEVER ABANDONS A SUPERVISED PROCESS (D-188). This program
// spawns a real driver and then exits 0 WITHOUT closing it — the program
// that never decided its driver's fate. The controlled exit's registry
// check refuses to report success: it traps DriverLeak (-4109), the trap
// path SIGKILLs every registered driver before user code runs (safing is
// mechanism, not policy — D-013), and failsafe reports what happened.
//
// The Bridge binding is deliberately leaked THROUGH main's exit — `exit`
// ends the program at that statement, so no scope-exit drop intervenes;
// the registry entry is still standing, which is the point. The mock
// itself dies by the trap path's kill_all (and would die by PDEATHSIG at
// exit_group regardless — the layers below the report).
mod:driver_leak;
use "../../../lib/nbridge.npk".*;
error:E9;

async func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) { exit 7i32; }
    string:mp = string_from_bytes(argv[1i64].ptr, argv[1i64].len);
    Path:p = path_parse(mp) ?! E9;
    Result<Bridge>:br = await spawn_driver(p, 65536i64, 64i64, 0i64, raw duration_secs(5i64));
    Bridge:b = br ?! E9;
    if (b.closed) { exit 11i32; }
    exit 0i32;   // abandoning a live driver: the exit check must refuse this
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DriverLeak)       { exit 45i32; },
        (E9)               { exit 91i32; },
        (BadPath)          { exit 92i32; },
        (EDriverSpawn)     { exit 93i32; },
        (EDriverFault)     { exit 94i32; },
        (EDriverProtocol)  { exit 95i32; },
        (EDriverDeadline)  { exit 96i32; },
        (EShmCreate)       { exit 97i32; },
        (EShmSeal)         { exit 97i32; },
        (EShmMap)          { exit 97i32; },
        (DeadlineExceeded) { exit 98i32; },
        (ERingFull)        { exit 85i32; },
        (EBridgePoisoned)  { exit 85i32; },
        (WildLeak)         { exit 88i32; },
        (Unreachable)      { exit 87i32; },
        (HeapOom)          { exit 87i32; },
        (HeapBadRequest)   { exit 87i32; },
        (OutOfBounds)      { exit 86i32; },
        (*)                { exit 99i32; }
    }
    exit 90i32;
};
