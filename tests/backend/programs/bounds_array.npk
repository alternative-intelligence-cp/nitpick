// expect-exit: 23
//
// The array half of D-070's runtime guard: the bound is the TYPE'S constant,
// and a NEGATIVE index of any width is caught by the same single unsigned
// compare (it sign-extends to a huge unsigned value).

mod:bounds_array;
func:main = int32(cstring[]:argv) {
    int32[3]:arr = [5i32, 6i32, 7i32];
    if (arr[2i32] != 7i32) { exit 10i32; }

    int32:neg = 0i32 - (argv.len =>! int32);   // -1, at run time
    int32:v = arr[neg];
    exit v;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow) { exit 9i32; },
        (OutOfBounds) { exit 23i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
