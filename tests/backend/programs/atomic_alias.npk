// expect-exit: 42
//
// atomic_from_ptr::<T>(p) aliases foreign memory AS an atomic (D-033/D-187,
// option A) — the fused form over the existing turbofish grammar. The
// element comes from the turbofish; the cell is the POINTER, so no local
// holds it and it is used in place, never stored. This is the Bridge's ring
// access shape (SPSC head/tail in a shared mapping): load, store, and the
// compare_exchange the producer/consumer indices ride. The pointee proves
// the ops reached the real memory.
mod:atomic_alias;
error:E9;
func:main = int32(cstring[]:_~argv) {
    wild int8->:buf = alloc(16i64);
    wild int64->:cell = buf =>! wild int64->;
    <-cell = 41i64;

    // fused load / store through the alias
    int64:v = atomic_from_ptr::<int64>(cell).load();
    if (v != 41i64) { exit 11i32; }
    atomic_from_ptr::<int64>(cell).store(100i64);
    if ((<-cell) != 100i64) { exit 12i32; }

    // swap and compare_exchange, the ring's index moves
    int64:was = atomic_from_ptr::<int64>(cell).swap(7i64);
    if (was != 100i64)  { exit 13i32; }
    if ((<-cell) != 7i64) { exit 14i32; }
    // CAS returns the OBSERVED value (D-182): equal to `expected` means it
    // swapped. Success: cell holds 7, expect 7 -> writes 9, returns 7.
    int64:seen1 = atomic_from_ptr::<int64>(cell).compare_exchange(7i64, 9i64);
    if (seen1 != 7i64)  { exit 15i32; }
    if ((<-cell) != 9i64) { exit 16i32; }
    // Failure: cell holds 9, expect 7 -> no write, returns the actual 9.
    int64:seen2 = atomic_from_ptr::<int64>(cell).compare_exchange(7i64, 11i64);
    if (seen2 != 9i64)  { exit 17i32; }
    if ((<-cell) != 9i64) { exit 18i32; }

    dalloc(buf);
    wild_release_all();
    exit 42i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 91i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom) { exit 95i32; },
        (OutOfBounds) { exit 96i32; },
        (Unreachable) { exit 97i32; },
        (WildLeak) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
