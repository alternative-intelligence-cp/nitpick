// expect-exit: 26
//
// ?| and ?! (D-175): the fallback is LAZY and the emphatic unwrap routes the
// CALLER'S code to failsafe through the D-142 trap — exit 26 proves the
// error path carried 77.

mod:unwrap_ops;
error:E5;
error:E77;
func:half = int32(int32:v) {
    if (v < 0i32) { fail E5; }
    pass (v / 2i32);
};
func:main = int32(cstring[]:argv) {
    int32:a = half(10i32) ?| 99i32;
    if (a != 5i32)  { exit 10i32; }
    int32:b = half(0i32 - 4i32) ?| 99i32;
    if (b != 99i32) { exit 11i32; }
    int32:c = half(8i32) ?! E77;
    if (c != 4i32)  { exit 12i32; }
    int32:d = half(0i32 - 1i32) ?! E77;
    exit (d - d);
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (E77) { exit 26i32; },
        (DivByZero) { exit 9i32; },
        (DivOverflow) { exit 9i32; },
        (E5) { exit 9i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
