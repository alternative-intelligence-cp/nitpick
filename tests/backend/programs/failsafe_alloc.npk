// expect-exit: 45
// stress: 40
// explore: 1000
//
// `failsafe` ALLOCATES WHILE ANOTHER THREAD HOLDS THE HEAP MUTEX (D-292,
// 1.5.6 step 2). The churner allocates and frees in a tight loop -- inside
// the allocator, under its mutex, most of the time -- and never suspends;
// the trapper divides by the zero main computed from `argv` twenty
// milliseconds in. The trap route stops the churner where it stands
// (D-291), possibly holding the heap mutex forever. `failsafe` then builds a
// 64 KiB string by concatenation: on a floor whose `failsafe` allocated from
// the heap this waited on the mutex with no deadline -- a hang, the
// uncontrolled stop (this program timed out on step 1's floor); with the
// failsafe region it bumps from preallocated `.bss` and answers 45.
//
// THE JOIN DEADLINE IS A HANG NET, NEVER A VERDICT (DEF-85, settled by the user
// 2026-09-24 as option 1 of three; 1.5.8b step 7). It bounds the trap route's
// stop walk (D-291): how long the route waits for the churner -- inside the
// allocator, under its mutex, in a tight loop -- to park. At five seconds, three
// full harnesses running at once made it miss once in forty runs, and the
// deadline raised INSIDE the trap route: a second trap, the re-entry exit 70,
// where a quiet machine answers 45 a hundred and twenty times out of a hundred
// and twenty. The compiler and the floor did what D-291 and D-307 say; the test
// had put a wall clock in a verdict position, which is what NPK_HEAP_STATS
// (1.5.1b step 0) exists to forbid. Sixty seconds is a bound only a real hang
// reaches -- the solver's hang net (D-297) and the explorer's control net
// (DEF-83, 60 -> 300 s) settled the same way -- so the verdict is the region's
// answer and nothing the scheduler decides.
mod:failsafe_alloc;
fixed Duration:JOIN_60S = Duration{ ns: 60000000000i64 };

thread async func:churner = NIL(int32:_~v) joins JOIN_60S {
    int64:n = 0i64;
    while (n < 2000000000i64) decreases 2000000000i64 - n {                        // the stop is what ends this
        wild int8->:p = alloc(64i64);
        p[0i64] = 1i8;
        dalloc(p);
        n = n + 1i64;
    }
    pass NIL;
};

thread async func:trapper = NIL(int32:zero) joins JOIN_60S {
    int64:t0 = mono_now();
    // a spin on the monotonic clock (D-316)
    while ((mono_now() - t0) < 20000000i64) unbounded { }       // the churner is churning
    discard(10i32 / zero);
    pass NIL;
};

async func:main = int32(cstring[]:argv) {
    int32:zero = (argv.len =>! int32) - 1i32;
    drop churner(1i32);
    drop trapper(zero);
    int64:t0 = mono_now();
    // a spin on the monotonic clock until the trap ends it (D-316)
    while ((mono_now() - t0) < 2000000000i64) unbounded { }     // never suspends; the trap ends this
    exit 0i32;                                         // no trap happened
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero) {
            // 64 KiB in sixteen 4 KiB chunks: growing a string by concatenation
            // is QUADRATIC in a bump region (every step allocates the whole new
            // string and frees nothing), so a `failsafe` builds in few, large
            // steps -- 544 KiB here against the region's mebibyte, where 1,024
            // 64-byte steps would need 33 MB and exit 70 at the bound
            string:chunk = "";
            int32:k = 0i32;
            while (k < 64i32) decreases 64i32 - k {
                chunk = string_concat(chunk, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
                k = k + 1i32;
            }
            string:s = "";
            int32:i = 0i32;
            while (i < 16i32) decreases 16i32 - i {
                s = string_concat(s, chunk);
                i = i + 1i32;
            }
            if (s.len != 65536i64) { exit 46i32; }
            exit 45i32;
        },
        (DeadlineExceeded) { exit 47i32; },
        (DivOverflow)      { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (HeapOom)          { exit 94i32; },
        (IntOverflow)      { exit 96i32; },
        (OutOfBounds)      { exit 95i32; },
        (Unreachable)      { exit 96i32; },
        (WildLeak)         { exit 97i32; },
        (StackExhausted)   { exit 98i32; },
        (MachineFault)     { exit 98i32; },
        (DecreasesViolated) { exit 98i32; },
        (*)                { exit 98i32; }
    }
    exit 99i32;
};
