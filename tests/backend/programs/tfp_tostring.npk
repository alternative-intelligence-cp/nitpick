func:t32 = tfp32(uint32:w) never fails {
    wild int8->:b = alloc(4i64);
    wild uint32->:ip = b =>! wild uint32->;
    <-ip = w;
    wild tfp32->:tp = b =>! wild tfp32->;
    tfp32:v = <-tp;
    drop dalloc(b);
    pass v;
};
