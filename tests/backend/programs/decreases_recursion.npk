// expect-exit: 0
//
// A RECURSIVE GROUP'S MEASURES HOLD (D-304 (5), 1.5.8c step 4): at every call
// inside a group the callee's measure at the arguments is compared against the
// caller's at entry -- `m1 < m0` and `m0 >= 0`, `DecreasesViolated` otherwise --
// and none of these trips it: a self-recursion (`fact`), a mutual pair
// (`is_even`/`is_odd`), a method calling itself through `Self->` (the measure
// read through the receiver), a coroutine awaiting itself (the entry measure
// lives in the frame, the await site checks), and a recursion through a
// function a `requires` splits (the snapshot is the BODY's, past the checked
// entry, so the bypassed call and the checked one compare alike). Silent: 0.
mod:decreases_recursion;
error:E9;

func:fact = int64(int64:n) decreases n never fails {
    if (n <= 0i64) { pass 1i64; }
    pass (n * (raw fact(n - 1i64)));
};

func:is_even = bool(int32:n) decreases n never fails {
    if (n <= 0i32) { pass true; }
    pass (raw is_odd(n - 1i32));
};

func:is_odd = bool(int32:n) decreases n never fails {
    if (n <= 0i32) { pass false; }
    pass (raw is_even(n - 1i32));
};

struct:Counter = { int32:left; int32:acc; };

impl:Counter = {
    func:run = int32(Counter->:self) decreases self.left never fails {
        if (self.left <= 0i32) { pass self.acc; }
        self.acc = self.acc + self.left;
        self.left = self.left - 1i32;
        pass (raw self.run());
    };
};

async func:sum_to = int32(int32:n) decreases n {
    if (n <= 0i32) { pass 0i32; }
    int32:r = await sum_to(n - 1i32) ?! E9;
    pass (n + r);
};

func:guarded = int32(int32:n) requires n >= 0i32 decreases n never fails {
    if (n == 0i32) { pass 0i32; }
    pass (1i32 + (raw guarded(n - 1i32)));
};

async func:main = int32(cstring[]:_~argv) {
    if ((raw fact(5i64)) != 120i64) { exit 1i32; }
    if (!(raw is_even(6i32))) { exit 2i32; }
    if (raw is_even(7i32)) { exit 3i32; }
    Counter:c = Counter{ left: 4i32, acc: 0i32 };
    if ((raw c.run()) != 10i32) { exit 4i32; }
    int32:s = await sum_to(4i32) ?! E9;
    if (s != 10i32) { exit 5i32; }
    if ((raw guarded(3i32)) != 3i32) { exit 6i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)                { exit 20i32; },
        (DecreasesViolated) { exit 41i32; },
        (RequiresViolated)  { exit 31i32; },
        (DeadlineExceeded)  { exit 98i32; },
        (IntOverflow)       { exit 93i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 99i32; },
        (MachineFault)      { exit 99i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
