// expect-exit: 42
//
// THE PIPE OPERATOR (1.0.9c) IS STRUCK (D-362, S-139; 1.6.1e landing 133): `x |> g` was `g(x)` written the other way
// round, a second spelling of a call, and the parser refuses it by name now (`parse_pipe_struck.npk` holds the
// refusal). This file kept its two calls, spelled as the calls they always were, and the answer they always gave.
mod:pipe;

func:dbl = int32(int32:x) never fails { pass x * 2i32; };
func:inc = int32(int32:x) never fails { pass x + 1i32; };

func:main = int32(cstring[]:_~argv) {
    int32:a = dbl(20i32) ?| 0i32;          // dbl(20) = 40
    int32:b = inc(1i32) ?| 0i32;           // inc(1)  = 2
    exit a + b;                           // 42
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (StackExhausted) { exit 1i32; },
        (MachineFault) { exit 1i32; },
        (DecreasesViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
