// `lib/nvec.npk` — the small-vector tier over `simd<flt64, N>` (D-200, 1.3.7).
//
// Exact values throughout: 3-4-5 and 1-2-2 triangles, integer-valued
// cross products, and the vec9 identity — every comparison is `==` on
// numbers IEEE represents exactly, so a drifted lane is a failed exit,
// not a tolerance. The methods are `never fails` (they allocate nothing),
// so every call sits under `raw` — the D-163 licence, checked against the
// callee's own contract.
mod:nvec_basic;

use "../../../lib/nvec.npk".*;

func:main = int32(cstring[]:_~argv) {
    // Lane reads and the 1-2-2 triangle.
    vec3:va = raw vec3_of(1.0f64, 2.0f64, 2.0f64);
    if ((raw va.x()) != 1.0f64)                  { exit 10i32; }
    if ((raw va.y()) != 2.0f64)                  { exit 11i32; }
    if ((raw va.z()) != 2.0f64)                  { exit 12i32; }
    if ((raw va.length2()) != 9.0f64)            { exit 13i32; }
    if ((raw va.length()) != 3.0f64)             { exit 14i32; }

    // Dot: (1,2,2)·(3,0,4) = 3 + 0 + 8.
    vec3:vb = raw vec3_of(3.0f64, 0.0f64, 4.0f64);
    if ((raw va.dot(vb)) != 11.0f64)             { exit 15i32; }

    // Cross: (1,2,2)×(3,0,4) = (8, 2, −6) — and a×a is the zero vector.
    vec3:vc = raw va.cross(vb);
    if ((raw vc.x()) != 8.0f64)                  { exit 16i32; }
    if ((raw vc.y()) != 2.0f64)                  { exit 17i32; }
    if ((raw vc.z()) != (0.0f64 - 6.0f64))       { exit 18i32; }
    vec3:vz = raw va.cross(va);
    if ((raw vz.length2()) != 0.0f64)            { exit 19i32; }

    // A cross product is perpendicular to both factors.
    if ((raw vc.dot(va)) != 0.0f64)              { exit 20i32; }
    if ((raw vc.dot(vb)) != 0.0f64)              { exit 21i32; }

    // vec2: the 3-4-5 triangle.
    vec2:v2 = raw vec2_of(3.0f64, 4.0f64);
    if ((raw v2.x()) != 3.0f64)                  { exit 22i32; }
    if ((raw v2.y()) != 4.0f64)                  { exit 23i32; }
    if ((raw v2.length()) != 5.0f64)             { exit 24i32; }
    if ((raw v2.dot(v2)) != 25.0f64)             { exit 25i32; }

    // vec4: lanes and the unit diagonal.
    vec4:v4 = raw vec4_of(1.0f64, 2.0f64, 3.0f64, 4.0f64);
    if ((raw v4.w()) != 4.0f64)                  { exit 26i32; }
    if ((raw v4.length2()) != 30.0f64)           { exit 27i32; }
    vec4:u4 = raw vec4_of(1.0f64, 1.0f64, 1.0f64, 1.0f64);
    if ((raw u4.length()) != 2.0f64)             { exit 28i32; }

    // vec9: I×M = M, and a permutation actually permutes.
    vec9:idm = raw vec9_id();
    vec9:m = vec9{ m00: 1.0f64, m01: 2.0f64, m02: 3.0f64,
                   m10: 4.0f64, m11: 5.0f64, m12: 6.0f64,
                   m20: 7.0f64, m21: 8.0f64, m22: 9.0f64 };
    vec9:mm = raw idm.mul(m);
    if (mm.m00 != 1.0f64)                        { exit 29i32; }
    if (mm.m12 != 6.0f64)                        { exit 30i32; }
    if (mm.m21 != 8.0f64)                        { exit 31i32; }
    vec9:swap = vec9{ m00: 0.0f64, m01: 1.0f64, m02: 0.0f64,
                      m10: 1.0f64, m11: 0.0f64, m12: 0.0f64,
                      m20: 0.0f64, m21: 0.0f64, m22: 1.0f64 };
    vec9:sm = raw swap.mul(m);
    if (sm.m00 != 4.0f64)                        { exit 32i32; }
    if (sm.m01 != 5.0f64)                        { exit 33i32; }
    if (sm.m10 != 1.0f64)                        { exit 34i32; }

    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (OutOfBounds) { exit 94i32; },
        (HeapOom) { exit 95i32; },
        (HeapBadRequest) { exit 95i32; },
        (Unreachable) { exit 97i32; },
        (WildLeak) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
