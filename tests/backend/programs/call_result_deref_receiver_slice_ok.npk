func:list_level_above_zero = int64() never fails {
    SL:s = SL{ l: raw list_init::<H2>(1i64), k: 0i64 };
    drop one(@s.l);
    drop list_push(@s.l, H2{ o: string_concat("x", "y"), k: 2i64 });
    SL->:ps = @s;
    H2->:e = @s.l[0i64];
    (<-ps).l[1i64].k = 7i64;
    pass (e.o.len + s.l[1i64].k);
};

// 43. (DR5 r1n, landing 167) the `relay` KEYWORD on the slice road with NO view live: the carrier is the own holder (a fallible control, relayed in `main` with `?! E1`)
func:relay_keyword_slice_road_no_view = int64() {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl(relay getslf(@b));
    pass p.arr[0i64].o.len;
};

// 44. (DR5 r2n) the `relay` keyword on the pointer road, no view live
func:relay_keyword_ptr_road_no_view = int64() {
    H2[2]:arr = [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }];
    BS:bs = BS{ sl: arr[0i64...2i64], k: 1i64 };
    (<-(relay idbsf(@bs))).sl[0i64].o = string_concat("x", "y");
    pass arr[0i64].o.len;
};

// 45. (DR5 r3n) `??!` on the slice road, no view live
func:coalesce_slice_road_no_view = int64() never fails {
    P:p = P{ arr: [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }] };
    BS:b = BS{ sl: p.arr[0i64...1i64], k: 1i64 };
    b.sl = p.arr[0i64...2i64];
    drop wsl((raw getslo(@b)) ??! E1);
    pass p.arr[0i64].o.len;
};

// 46. (DR5 r4n) `??!` on the pointer road, no view live
func:coalesce_ptr_road_no_view = int64() never fails {
    H2[2]:arr = [H2{ o: string_concat("a", "b"), k: 1i64 }, H2{ o: string_concat("c", "d"), k: 2i64 }];
    BS:bs = BS{ sl: arr[0i64...2i64], k: 1i64 };
    (<-((raw idbso(@bs)) ??! E1)).sl[0i64].o = string_concat("x", "y");
    pass arr[0i64].o.len;
};

