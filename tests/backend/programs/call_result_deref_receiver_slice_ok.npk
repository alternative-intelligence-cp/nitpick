func:idsla = HA[]->(HA[]->:q) never fails { pass q; };
func:getsla = HA[](BA->:q) never fails { pass q.sl; };
func:wsla = NIL(HA[]:s) never fails { s[0i64].a = shared_arena_make(4i64); pass NIL; };
struct:SL = { List<H2>:l; int64:k; };
func:one = NIL(List<H2>->:q) never fails { drop list_push(q, H2{ o: string_concat("a", "b"), k: 1i64 }); pass NIL; };
func:setk = NIL(H2->:q, int64:v) never fails { q.k = v; pass NIL; };

thread async func:filler = NIL(shared_arena<int64>->:s, Channel<int64, 4i32, 4i64>:done,
                               int64:base) joins J2 {
    int64:i = 0i64;
    int64:last = 0i64;
    while (i < 20i64) decreases 20i64 - i {
        Handle<int64>:h = s.alloc(base + i);
        last = s.get(h) ?! E1;
        i = i + 1i64;
    }
    await done.send(last, raw duration_ms(500i64)) ?! E1;
    pass NIL;
};

// 1. a method writing a DISJOINT field (`self.k`) on the dereference of a call-result pointer, under a view of `h.s`: the resolution is field-precise
func:disjoint_field_method_deref_call = int64() never fails {
    S:h = S{ s: string_concat("a", "b"), k: 1i64 };
    fixed uint8[]:vw = string_bytes(h.s);
    drop (<-(raw ids(@h))).kset();
    pass ((vw[0i64] => int64) + h.k);
};

// 2. the disjoint-field method BY NAME under the view (parity)
func:disjoint_field_method_by_name = int64() never fails {
    S:h = S{ s: string_concat("a", "b"), k: 1i64 };
    fixed uint8[]:vw = string_bytes(h.s);
    drop h.kset();
    pass ((vw[0i64] => int64) + h.k);
};

