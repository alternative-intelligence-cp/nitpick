// expect-exit: 0
// stress: 40
// explore: 1000
//
// THE LEGAL HALF OF DEF-315 + DEF-316 + DEF-317 (landing 166: a `Self->` method on the bare
// dereference of a call-result pointer, a slice reached below such a dereference, and a
// call-result slice handed out of a struct carrier, each resolved to the storage it reaches):
// the shapes the precise reading must keep clean. A method writing a DISJOINT field (the
// resolution is field-precise), a method writing nothing, the view's block ended, another
// pointee, the write before the view; the write through the dereference with no view live
// (the slice's own view is its own: the pointee is the holder), a slice of ANOTHER array, a
// READ through the dereference, the struct behind a call-result pointer writing its own slice
// field with nothing else live; a READING callee, the call-result slice handed to the writer
// with no view live (the carrier is the own holder, through a named pointer or a pointer
// field too), the view's block ended, a carrier over another array; the by-name twins of the
// no-view shapes; the three `List` controls landing 165's review asked for (a callee writing
// another element through a `List` pointer under a live element address, the level
// arithmetic by name, a level above zero); the no-view twins of the TRANSPARENT KINDS the readers
// step -- a may-fail getter's pointer result relayed (`?!`), an async getter's awaited, a call result
// cast `=>` or `=>!` to its own type on either road, a wild call-result pointer cast to a plain one
// (cells4 t1n-t9n; t1n and t3n, the slice road under `?!`, REFUSED before this landing's fix of the own-holder
// walks) --; and the lend twins -- the method on the dereference
// of a call result over ANOTHER `W` while `w.a` is lent, the lend's block ended (joined)
// before the method, a method writing the DISJOINT field `k` under the lend, by name too.
// Each control is a function returning a known value, checked in `main` at its own exit
// (11-46; the two `async` controls are awaited, the two `relay`-keyword ones relayed with `?! E1`; 43-46 are landing 167's DR5 controls: the `relay`
// KEYWORD and `??!` on both roads with no view live); the lend controls L1-L4 stand in `main` (exits 51-54). Exit 0 at both legs under this
// compiler AND landing 165's. The refusals of the same shapes are
// `tests/analysis/rejection/call_result_deref_receiver_slice.npk`.
mod:call_result_deref_receiver_slice_ok;
error:E1;
fixed Duration:J2 = Duration{ ns: 2000000000i64 };
struct:H2 = { string:o; int64:k; };
impl:H2 = { func:hset = NIL(H2->:self) never fails { self.o = string_concat("x", "y"); pass NIL; }; };
struct:S = { string:s; int64:k; };
impl:S = {
    func:sset = NIL(S->:self) never fails { self.s = string_concat("x", "y"); pass NIL; };
    func:kset = NIL(S->:self) never fails { self.k = 7i64; pass NIL; };
    func:snoop = NIL(S->:self) never fails { if (self.s.len == 999i64) { pass NIL; } pass NIL; };
};
struct:BS = { H2[]:sl; int64:k; };
struct:O = { BS:b; int64:k; };
struct:P = { H2[2]:arr; };
struct:PB = { BS->:bp; int64:k; };
struct:W = { shared_arena<int64>:a; int32:k; };
impl:W = {
    func:rep = NIL(W->:self) never fails { self.a = shared_arena_make(4i64); pass NIL; };
    func:kset = NIL(W->:self) never fails { self.k = 7i32; pass NIL; };
};
struct:HA = { shared_arena<int64>:a; int64:k; };
struct:BA = { HA[]:sl; int64:k; };

func:ids = S->(S->:x) never fails { pass x; };
func:pick_s = S->(bool:c, S->:a, S->:b) never fails { if (c) { pass a; } pass b; };
