    W:w = W{ a: shared_arena_make(8i64), k: 1i32 };
    W:w2 = W{ a: shared_arena_make(8i64), k: 2i32 };
    {
        drop filler(@w.a, done, 1000i64);
        drop (<-(raw idw(@w2))).rep();
