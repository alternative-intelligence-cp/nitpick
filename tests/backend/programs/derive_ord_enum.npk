// expect-exit: 42
//
// `#[derive(Ord)]` ON AN ENUM (D-123, 1.0.9d). The order is the variants'
// declaration order, read through `enum =>! int32` — a later variant is greater.
// The same body serves `PartialOrd`, whose `Ordering?` wraps the total order as
// an always-present one.
mod:derive_ord_enum;
error:E9;

#[derive(Ord)]
enum:Level = { Low; Mid; High; };

func:main = int32(cstring[]:_~argv) {
    Level:lo = Level.Low;
    Level:hi = Level.High;
    Level:m1 = Level.Mid;
    Level:m2 = Level.Mid;
    int32:acc = 0i32;
    pick (lo.cmp(hi) ?! E9)  { (Ordering.Less)    { acc = acc + 20i32; }, (*) { } }
    pick (hi.cmp(lo) ?! E9)  { (Ordering.Greater) { acc = acc + 20i32; }, (*) { } }
    pick (m1.cmp(m2) ?! E9)  { (Ordering.Equal)   { acc = acc + 2i32; },  (*) { } }
    exit acc;                                    // 20 + 20 + 2 = 42
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
