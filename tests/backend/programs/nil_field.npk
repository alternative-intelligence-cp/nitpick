// expect-exit: 0
// DEF-232 (1.6.1e, landing 112): A `NIL` FIELD OCCUPIES NOTHING (D-084), AND THE
// EMITTER SAYS SO. A struct with a `NIL` field was emitted as `{ i32, void, i32 }`
// and an enum with a `NIL` payload got no type header at all -- `llc` refused
// both ("void type only allowed for function results"; "cannot allocate unsized
// type") on a program the checker accepted. A `NIL` member is the zero-sized `{}`
// now: the literal inserts nothing into it, a read of it is the `NIL` value, a
// store into it lands nowhere, a module constant renders `{} zeroinitializer`, an
// enum's `NIL` payload is stored nowhere (its slot is `[0 x iK]`), and the
// struct's size is the size of its other fields. Each shape is checked where it
// is read; `#size_of` is D-084's promise measured.
mod:nil_field;

struct:S = { int32:a; NIL:b; int32:c; };
struct:Named = { string:name; NIL:gap; int32:n; };
struct:Box<T> = { int32:tag; T:item; };
enum:E = { A(NIL); B; C(int32); };

fixed S:K = S{ a: 4i32, b: NIL, c: 5i32 };

func:main = int32(cstring[]:argv) {
    S:s = S{ a: 1i32, b: NIL, c: 2i32 };
    if (s.a + s.c != 3i32)                 { exit 1i32; }
    s.b = NIL;
    s.c = 7i32;
    if (s.c != 7i32)                       { exit 2i32; }
    if (#size_of<S>() != 8i64)             { exit 3i32; }
    if (K.a + K.c != 9i32)                 { exit 4i32; }
    Box<NIL>:bx = Box{ tag: 5i32, item: NIL };
    if (bx.tag != 5i32)                    { exit 5i32; }
    S[2]:arr = [S{ a: 1i32, b: NIL, c: 1i32 }, S{ a: 2i32, b: NIL, c: 2i32 }];
    if (arr[1i64].c != 2i32)               { exit 6i32; }
    Named:nm = Named{ name: "abc", gap: NIL, n: 3i32 };
    if (nm.name.len != 3i64)               { exit 7i32; }
    if (nm.n != 3i32)                      { exit 8i32; }
    E:e = E.A(NIL);
    int32:v = 9i32;
    pick (e) {
        (E.A(_)) { v = 0i32; },
        (E.B) { v = 1i32; },
        (E.C(k)) { v = k; }
    }
    if (v != 0i32)                         { exit 10i32; }
    E:e2 = E.C(11i32);
    pick (e2) {
        (E.A(_)) { v = 0i32; },
        (E.B) { v = 1i32; },
        (E.C(k)) { v = k; }
    }
    if (v != 11i32)                        { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable) { exit 95i32; },
        (HeapOom) { exit 92i32; },
        (HeapBadRequest) { exit 91i32; },
        (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
