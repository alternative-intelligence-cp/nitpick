// expect-exit: 28
//
// FAILSAFE MAY CLEAN UP AND EXIT POSITIVE (CONTROL_REFERENCE 4.6's second
// half): wild_release_all() drops the whole heap -- every chunk, every large
// mapping -- and failsafe's own exit passes the check because it IS the
// handler (the in-failsafe flag; the check runs once, at the program's exit).

mod:leak_cleanup;
func:main = int32(cstring[]:_~argv) {
    wild int8->:p = alloc(24i64);
    discard(p);
    exit 0i32;
};

// THE COUNT AFTER THE RELEASE, INSIDE `exit`'S OPERAND (TYPE-062, 1.5.1b step 5):
// 28 when the release left nothing live, 8 otherwise.
func:after_release = int32() never fails {
    if (wild_live_count() != 0i64) { pass 8i32; }
    pass 28i32;
};
func:failsafe = int32(Error:err) {
    pick (err) {
        (WildLeak) {
            wild_release_all();
            exit (raw after_release());
        },
        (Unreachable)    { exit 9i32; },
        (HeapOom)        { exit 9i32; },
        (HeapBadRequest) { exit 9i32; },
        (*)              { exit 9i32; }
    }
    exit 9i32;
};
