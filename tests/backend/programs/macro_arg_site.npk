// expect-exit: 0
//
// D-340 (DEF-183 part B, 1.6.1e): A CALLER'S LOCAL IS PASSED TO A MACRO. Every
// function below was refused on the compiler before this one -- RESOLVE-002,
// "cannot find `n` in the scope this macro was written in", about the caller's
// own text. (The shapes that compiled and answered wrongly are
// `macro_arg_shadow.npk`.) What each one holds the mechanism to:
//
//   plain            the argument resolves at the invocation, used twice;
//   two_levels       an argument handed on as an inner macro's argument steps
//                    back out of TWO expansions;
//   wrapper          ... also where the outer body is exactly the inner invocation
//                    (two expansions rooted at one node), and where the inner body
//                    is exactly its parameter (the root and the step cancel);
//   identity         `macro:id = (X) { X; };` leaves the argument standing as
//                    though it had been written there, nested or not;
//   body_text_arg    an argument a macro BODY writes for an inner invocation is
//                    the body's text: `k` in `#inc(X + k)` is the module's, and
//                    the `X` inside it is still the caller's;
//   pick_argument    an argument may bind names of its own (an arm's), and an
//                    invocation inside the arm takes the arm's binding;
//   as_place         an argument stands as an assignment's target;
//   in_guard         in a `where` guard and as a value pattern;
//   stmt_argument    an invocation of a STATEMENT macro passed as an argument and
//                    used twice: each block steps back to the caller's scope;
//   in_defer         inside a `defer` body;
//   through_alias    an alias (D-125) hands its argument on and stays transparent
//                    to its target's `#caller`: both name the alias's caller;
//   swapped          two arguments, each naming a local the other's parameter
//                    spells;
//   in_module        a declaration macro invoked in an inline module: its argument
//                    is that module's `a`, not the emitted function's parameter,
//                    through an inner expression macro too;
//   at_impl          ... and in an `impl` block;
//   coroutine        the same through a coroutine's frame, across suspensions.
mod:macro_arg_site;
error:E9;

fixed int32:k = 100i32;
fixed int32:p = 50i32;

func:v32 = int32(int32:x) never fails { pass x; };
enum:Opt = { Non; Som(int32); };
struct:Box = { int32:v; };

macro:twice = (X) { X + X; };
macro:inc = (Y) { Y + 1i32; };
macro:outer = (X) { #inc(X) + 10i32; };
macro:wrap = (X) { #inc(X); };
macro:id = (X) { X; };
macro:wrap_id = (X) { #id(X); };
macro:with_k = (X) { #inc(X + k); };
macro:set = (T, V) { T = V; };
macro:big = (S, LIM) { pick (S) { (1i32..9i32) where (S > LIM) { #caller(r) = 1i32; }, (*) { #caller(r) = 0i32; } } };
macro:pk = (S, V) { pick (S) { (V) { #caller(r) = 1i32; }, (*) { #caller(r) = 2i32; } } };
macro:both = (X) { X; X; };
macro:addr = (V) { #caller(r) = #caller(r) + V; };
macro:later = (X) { defer { #caller(out) = #caller(out) + X; } };
macro:stmt_k = (OUT) { OUT = #caller(k); };
macro:via = (O2) { #stmt_k(O2); };
macro:sum2 = (A, B) { A + B; };
macro:cross = (P, Q) { #sum2(Q, P) * 2i32; };
macro:stmt_tmp = (X) { int32:tmp = X; #caller(out) = tmp + tmp; };

mod:inner = {
    fixed int32:a = 7i32;
    macro:dbl = (Y) { Y + Y; };
    macro:mkfn = (V) { pub func:f = int32(int32:a) never fails { pass #dbl(V) + a; }; };
    #mkfn(a);
};

macro:meth = (V) { func:get = int32(Box:self) never fails { pass self.v + V; }; };
impl:Box = { #meth(k); };

func:plain = int32() never fails {
    int32:n = raw v32(5i32);
    if ((#twice(n)) != 10i32) { pass 1i32; }
    pass 0i32;
};

func:two_levels = int32() never fails {
    int32:n = raw v32(5i32);
    if ((#outer(n)) != 16i32) { pass 2i32; }
    pass 0i32;
};

func:wrapper = int32() never fails {
    int32:n = raw v32(5i32);
    if ((#wrap(n)) != 6i32) { pass 3i32; }
    if ((#wrap_id(n) + #wrap_id(#wrap_id(n))) != 10i32) { pass 4i32; }
    pass 0i32;
};

func:identity = int32() never fails {
    int32:n = raw v32(5i32);
    if ((#id(#id(n)) + #id(n)) != 10i32) { pass 5i32; }
    pass 0i32;
};

func:body_text_arg = int32() never fails {
    int32:k = raw v32(5i32);
    int32:n = raw v32(2i32);
    if ((#with_k(n)) != 103i32) { pass 6i32; }
    if (k != 5i32) { pass 7i32; }
    pass 0i32;
};

func:pick_argument = int32() never fails {
    Opt:o = Opt.Som(raw v32(4i32));
    int32:r = #inc(pick (o) { (Som(v)) { give #inc(v); }, (Opt.Non) { give 0i32; } });
    if (r != 6i32) { pass 8i32; }
    pass 0i32;
};

func:as_place = int32() never fails {
    int32:x = raw v32(1i32);
    int32:y = raw v32(9i32);
    #set(x, y + 1i32);
    if (x != 10i32) { pass 9i32; }
    pass 0i32;
};

func:in_guard = int32() never fails {
    int32:lim = raw v32(3i32);
    int32:s = raw v32(5i32);
    int32:r = 7i32;
    #big(s, lim);
    if (r != 1i32) { pass 10i32; }
    #pk(s, 5i32);
    if (r != 1i32) { pass 11i32; }
    pass 0i32;
};

func:stmt_argument = int32() never fails {
    int32:r = 0i32;
    int32:n = raw v32(6i32);
    #both(#addr(n));
    if (r != 12i32) { pass 12i32; }
    pass 0i32;
};

func:in_defer = int32() never fails {
    int32:out = 1i32;
    int32:n = raw v32(4i32);
    {
        #later(n);
    }
    if (out != 5i32) { pass 13i32; }
    pass 0i32;
};

func:through_alias = int32() never fails {
    int32:k = raw v32(5i32);
    int32:r = 0i32;
    #via(r);
    if (r != 5i32) { pass 14i32; }
    if (k != 5i32) { pass 15i32; }
    pass 0i32;
};

func:swapped = int32() never fails {
    int32:p = raw v32(1i32);
    int32:q = raw v32(2i32);
    if ((#cross(p, #sum2(q, p))) != 8i32) { pass 16i32; }
    pass 0i32;
};

async func:coroutine = int32() {
    int32:tmp = raw v32(7i32);
    int32:out = 0i32;
    await sleep(raw duration_ms(1i64)) ?| NIL;
    #stmt_tmp(tmp);
    if (out != 14i32) { pass 20i32; }
    await sleep(raw duration_ms(1i64)) ?| NIL;
    int32:got = #twice(tmp);
    if (got != 14i32) { pass 21i32; }
    await sleep(raw duration_ms(1i64)) ?| NIL;
    if (tmp != 7i32) { pass 22i32; }
    pass 0i32;
};

async func:main = int32(cstring[]:_~argv) {
    int32:c1 = raw plain();
    if (c1 != 0i32) { exit c1; }
    int32:c2 = raw two_levels();
    if (c2 != 0i32) { exit c2; }
    int32:c3 = raw wrapper();
    if (c3 != 0i32) { exit c3; }
    int32:c4 = raw identity();
    if (c4 != 0i32) { exit c4; }
    int32:c5 = raw body_text_arg();
    if (c5 != 0i32) { exit c5; }
    int32:c6 = raw pick_argument();
    if (c6 != 0i32) { exit c6; }
    int32:c7 = raw as_place();
    if (c7 != 0i32) { exit c7; }
    int32:c8 = raw in_guard();
    if (c8 != 0i32) { exit c8; }
    int32:c9 = raw stmt_argument();
    if (c9 != 0i32) { exit c9; }
    int32:c10 = raw in_defer();
    if (c10 != 0i32) { exit c10; }
    int32:c11 = raw through_alias();
    if (c11 != 0i32) { exit c11; }
    int32:c12 = raw swapped();
    if (c12 != 0i32) { exit c12; }
    if ((raw inner.f(1i32)) != 15i32) { exit 17i32; }
    Box:b = Box{ v: 5i32 };
    if ((raw b.get()) != 105i32) { exit 18i32; }
    int32:c = await coroutine() ?! E9;
    if (c != 0i32) { exit c; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (E9) { exit 89i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
