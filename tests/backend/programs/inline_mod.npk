// expect-exit: 7
//
// The audit's fourth Theme-A hole, inverted into its own test: emit_all used
// to neither descend into an inline `mod` nor refuse it, so declared code was
// SILENTLY SHED -- this file compiled clean while its function vanished. From
// 0.7.7 to 1.5.4 it lived in tests/rejection/ carrying whatever construct
// still rung (an `async` function, then a `requires`, then a `prove`): the
// walk reached the construct and refused it by name, which proved the descent.
// The last rung fell at 1.5.4 step 4 (S-47), and until 1.5.4c no spelling
// reached the function from its parent (DEF-31): `use nested.*;` was
// RESOLVE-002 and `nested.fetch(...)` TYPE-007, "a module, not a value".
// D-273 made the qualified call a DIRECT call of the member, so the descent
// is observed by an ANSWER: `nested.fetch(3i32)` is 7, and the program exits
// through it.
mod:inline_mod;
error:Boom;
mod:nested = {
    pub func:fetch = int32(int32:v) {
        prove(v == v);
        pass (v + 4i32);
    };
};

func:main = int32(cstring[]:_~argv) {
    int32:r = nested.fetch(3i32) ?! Boom;
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Boom)           { exit 2i32; },
        (IntOverflow)    { exit 93i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom)        { exit 1i32; },
        (Unreachable)    { exit 1i32; },
        (WildLeak)       { exit 1i32; },
        (StackExhausted) { exit 1i32; },
        (MachineFault)   { exit 1i32; },
        (DecreasesViolated) { exit 1i32; },
        (*)              { exit 1i32; }
    }
    exit 1i32;
};
