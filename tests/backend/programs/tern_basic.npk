// expect-exit: 0
//
// The ternary/nonary bases end to end (D-197, 1.3.4): balanced values with
// the D-144 sticky-ERR discipline, checked as ternary, emulated by the
// binary rung in the VALUE representation. Both literal spellings, overflow
// past the BALANCED bound -> ERR (the prototype's trit clamp is OVERRULED:
// D-197's text is uniform), the Kleene pair on the single digits, digit
// extraction at both bases (negative values included -- the offset trick's
// edge), the family casts, and compound assigns through the shared core.
mod:tern_basic;

func:main = int32(cstring[]:argv) {
    // Contextual literals, decimal and balanced.
    tryte:a = 42;
    tryte:b = 1T1T0t;          // 81 - 27 + 9 - 3 + 0 = 60
    trit:t1 = 1;
    trit:tm = 0Tt;             // -1
    nit:n4 = 4;
    nyte:ny = 100;

    if ((b => int32) != 60i32)                 { exit 10i32; }
    if ((tm => int32) != (0i32 - 1i32))        { exit 11i32; }

    // Arithmetic and overflow → ERR (the trit clamp is OVERRULED: 1+1 errs).
    tryte:sum = a + b;
    if ((sum => int32) != 102i32)              { exit 12i32; }
    if (!(is_err(t1 + t1)))                    { exit 13i32; }
    tryte:big = 29524;
    if (!(is_err(big + a)))                    { exit 14i32; }
    if (!(is_err(big * big)))                  { exit 15i32; }

    // Stickiness.
    tryte:e = ERR;
    if (!(is_err(e * a)))                      { exit 17i32; }

    // Division at the multi-digit pair; zero divisor degrades.
    tryte:z = ((argv.len =>! int32 - 1i32) =>! tryte);
    tryte:q = a / 5;
    if ((q => int32) != 8i32)                  { exit 18i32; }
    tryte:r = a % 5;
    if ((r => int32) != 2i32)                  { exit 19i32; }
    if (!(is_err(a / z)))                      { exit 20i32; }
    nyte:nq = ny / 9;
    if ((nq => int32) != 11i32)                { exit 21i32; }

    // Kleene on the single digits: & is min, | is max, NOT is 0 - x.
    trit:tt = 1;
    trit:tu = 0;
    trit:tf = 0Tt;
    trit:kand = tt & tu;
    if ((kand => int32) != 0i32)               { exit 22i32; }
    trit:kor = tt | tf;
    if ((kor => int32) != 1i32)                { exit 23i32; }
    trit:kuf = tu | tf;
    if ((kuf => int32) != 0i32)                { exit 24i32; }
    trit:knot = 0 - tf;
    if ((knot => int32) != 1i32)               { exit 25i32; }
    trit:terr = e =>! trit;
    if (!(is_err(tt & terr)))                  { exit 26i32; }

    // Digits: 60 = ...1T1T0 balanced — trit(0)=0, trit(1)=-1, trit(2)=1.
    trit:d0 = b.trit(0i64);
    if ((d0 => int32) != 0i32)                 { exit 27i32; }
    trit:d1 = b.trit(1i64);
    if ((d1 => int32) != (0i32 - 1i32))        { exit 28i32; }
    trit:d2 = b.trit(2i64);
    if ((d2 => int32) != 1i32)                 { exit 29i32; }
    if (b.len != 10i64)                        { exit 30i32; }
    if (n4.len != 1i64)                        { exit 31i32; }
    // 100 = 1*81 + 2*9 + 1 nonary — nit(0)=1, nit(1)=2, nit(2)=1.
    nit:e0 = ny.nit(0i64);
    if ((e0 => int32) != 1i32)                 { exit 32i32; }
    nit:e1 = ny.nit(1i64);
    if ((e1 => int32) != 2i32)                 { exit 33i32; }
    nit:e2 = ny.nit(2i64);
    if ((e2 => int32) != 1i32)                 { exit 34i32; }

    // Family casts: widen, relabel, narrow-saturate; ERR maps.
    tryte:wt = t1 => tryte;
    if ((wt => int32) != 1i32)                 { exit 35i32; }
    nyte:rel = b => nyte;
    if ((rel => int32) != 60i32)               { exit 36i32; }
    trit:nar = b =>! trit;
    if (!(is_err(nar)))                        { exit 37i32; }
    trit:fits = wt =>! trit;
    if ((fits => int32) != 1i32)               { exit 38i32; }
    tryte:eerr = e => tryte;
    if (!(is_err(eerr)))                       { exit 39i32; }

    // Entering: out-of-range saturates under the bang; in-range converts.
    tryte:sat = 30000i32 =>! tryte;
    if (!(is_err(sat)))                        { exit 40i32; }
    nit:okn = 3i32 =>! nit;
    if ((okn => int32) != 3i32)                { exit 41i32; }

    // ERR rides pick.
    int32:seen = 0i32;
    pick (e) {
        ERR: { seen = 1i32; },
        (*) { seen = 2i32; }
    }
    if (seen != 1i32)                          { exit 42i32; }

    // Compound assigns through the shared core.
    tryte:acc = 100;
    acc += 20;
    if ((acc => int32) != 120i32)              { exit 43i32; }
    acc /= z;
    if (!(is_err(acc)))                        { exit 44i32; }
    trit:ka = 1;
    trit:kb = 0Tt;
    ka &= kb;
    if ((ka => int32) != (0i32 - 1i32))        { exit 45i32; }

    // Digits of a NEGATIVE value -- balanced negation negates every digit,
    // and the offset trick must agree: -60 has trit(1) = 1, trit(2) = -1.
    tryte:nb = 0 - b;
    trit:m1 = nb.trit(1i64);
    if ((m1 => int32) != 1i32)                 { exit 46i32; }
    trit:m2 = nb.trit(2i64);
    if ((m2 => int32) != (0i32 - 1i32))        { exit 47i32; }

    // An ERR receiver yields an ERR digit -- extraction is sticky.
    trit:derr = e.trit(0i64);
    if (!(is_err(derr)))                       { exit 48i32; }

    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow) { exit 97i32; },
        (TbbErr) { exit 90i32; },
        (OutOfBounds) { exit 94i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom) { exit 95i32; },
        (Unreachable) { exit 97i32; },
        (WildLeak) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
