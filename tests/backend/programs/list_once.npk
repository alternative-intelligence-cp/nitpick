// expect-exit: 0
//
// The bound half of the `lists` probe (D-247, 1.5.1b step 5): ONE
// `List<string>` of 10 000 owned strings, built once -- its peak is what
// `list_drop.npk`'s hundred rounds must stay within twice of.
mod:list_once;

// In a function, not in `main`: `exit` runs no drops (D-183, D-224), so a
// list held at the exit would be D-151's WildLeak -- a leak, correctly.
func:once = int64() never fails {
    List<string>:l = raw list_init::<string>(16i64);
    for (int32:i in 0i32...10000i32) {
        drop list_push(@l, string_concat("item-", int_to_string(i => int64)));
    }
    int64:total = 0i64;
    for (int64:j in 0i64...l.count) { total = total + l.items[j].len; }
    pass total;
};

func:main = int32(cstring[]:_~argv) {
    if ((raw once()) != 88890i64) { exit 1i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; }, (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
