// expect-exit: 26
//
// ralloc(p, 0) is REFUSED (0.10.0, D-150): C's realloc(p, 0) is the
// implementation-defined footgun this is not. Freeing is spelled `dalloc`,
// so a zero-size reallocation is a program error: npk_trap(-4104).

func:main = int32(cstring[]:_~argv) {
    wild int8->:p = alloc(8i64);
    wild int8->:q = ralloc(p, 0i64);
    discard(q);
    exit 0i32;
};

func:failsafe = int32(Error:err) {
    if (err == HeapBadRequest) { exit 26i32; }
    exit 9i32;
};
