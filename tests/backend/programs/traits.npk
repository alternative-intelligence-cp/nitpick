// expect-exit: 21
//
// TRAIT DISPATCH ON A CONCRETE RECEIVER, AND INHERITED DEFAULTS (1.0.4).
//
// `p.size()` reaches the impl's method. `p.doubled_size()` reaches the trait's
// DEFAULT — a method with a body, inherited by every impl that does not write
// its own — and that default calls `self.size()` back into the impl. Two
// things had to be built for the second line to work at all:
//
//   * the LOOKUP: `find_method` asked only the impl's own members, so an
//     inherited default reported "no method"; it now falls back to the trait,
//     and a `Self` receiver inside a default body resolves against the
//     enclosing TRAIT (what `Self` is guaranteed to have) rather than against
//     an impl that does not exist yet.
//   * the EMISSION: a default is a template over `Self`, so it is emitted once
//     per implementing impl with `Self` bound — the same rule a generic
//     function follows (1.0.2b), for the same reason.

error:E9;

struct:Point = { int32:x; int32:y; };

trait:Measured = {
    func:size = int32(Self:self);
    func:doubled_size = int32(Self:self) { pass (self.size() ?! E9) * 2i32; };
};

impl:Point:Measured = {
    func:size = int32(Point:self) never fails { pass self.x + self.y; };
};

func:main = int32(cstring[]:_~argv) {
    Point:p = Point{ x: 3i32, y: 4i32 };
    int32:a = raw p.size();          // the impl's method:        7
    int32:b = p.doubled_size() ?! E9;  // the inherited default:   14
    exit a + b;                      // 21
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
