// expect-exit: 0
//
// DEF-1's REGRESSION CASE (1.5.1b, OPEN_DECISIONS §2f): the library
// workbench's `nitpick-time/tests/probe/defect/big_fixed_array_cost.npk` at
// commit 8066e6229c77aed28be7ab471209962a03534b0f, verbatim below the header
// -- a module-level `fixed` array of 4 000 `{ int64; int32 }` rows, the shape
// TM-007's compiled tzdb takes at 26 838 rows. Against the 1.5.0-close
// compiler it cost about six seconds and 580 MiB to COMPILE, quadratic in the
// row count (8 000 rows: 17 s and 1.9 GiB; 30 000 rows: 281 s and 30.9 GiB),
// because three builders in src/backend/ accumulated their text by
// re-concatenation and every intermediate was a temporary nothing dropped.
//
// This file is the reporter's own reproduction kept as the case that proves
// the fix; the CURVE lives in the `cost` stage (tests/cost/axis1.toml
// regenerates the recipe at N and 4N and holds the ratio). Here it is an
// ordinary real-backend program: compiled, linked, run, exit 0 -- and its
// compile is what the stage's bound keeps linear. The data is the probe's
// synthetic sequence:
//     at_utc[i]     = -2208988800 + i * 604800 + (i % 97) * 3600
//     type_index[i] = i % 13
mod:big_fixed_array;

struct:ZoneTransition = { int64:at_utc; int32:type_index; };

// `main` never reads this. The cost is in analysing the DECLARATION: making
// the table untouched changes nothing (measured, README.md's table).
