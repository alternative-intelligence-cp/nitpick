// expect-exit: 0
//
// THE STACK BUDGET IS THE PROGRAM'S, NOT THE SHELL'S (D-305 (3), 1.5.8 step
// 2; DEF-59). The main thread runs on a stack the floor mapped at startup, so
// the kernel's own stack -- and `RLIMIT_STACK`, the shell's `ulimit -s` --
// no longer decide how deep a program may go. This program lowers its own
// `RLIMIT_STACK` to 64 KiB and then recurses 100,000 levels (some 4.8 MB at
// `-O0`): on the kernel's stack that was a SIGSEGV; on the floor's it is 0.
mod:stack_budget_own;
error:ELim;

// A recursion the optimiser cannot turn into a loop: each level passes the
// address of its own local down, and the bottom reads through it.
func:deep = int64(int64:n, int64->:prev) never fails {
    if (n == 0i64) { pass (<-prev); }
    int64:mine = n;
    pass ((raw deep(n - 1i64, @mine)) + 1i64);
};

func:main = int32(cstring[]:argv) {
    // struct rlimit { rlim_cur, rlim_max }: 64 KiB both ways, RLIMIT_STACK = 3
    wild int8->:buf = alloc(16i64);
    wild int64->:rl = buf =>! wild int64->;
    <-rl = 65536i64;
    <-(#ptr_add<int64>(rl, 1i64)) = 65536i64;
    discard(sys(160i64, 3i64, rl) ?! ELim);
    dalloc(buf);
    int64:seed = argv.len;
    int64:r = raw deep(100000i64, @seed);
    if (r != 100001i64) { exit 3i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (ELim)           { exit 81i32; },
        (StackExhausted) { exit 60i32; },
        (IntOverflow)    { exit 93i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (MachineFault)   { exit 61i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
