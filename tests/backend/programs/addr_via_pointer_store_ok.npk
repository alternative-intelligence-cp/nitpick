// expect-exit: 0
mod:addr_via_pointer_store_ok;
// 2026-11-16 (landing 177d2b9, row 3: DEF-644 root B, seat S's S4, ported onto rows 1 and 2). AN ADDRESS TAKEN THROUGH ANOTHER POINTER (`r =
// @((<-q0).inner)` over `q0 = @mx`; `@((<-pb).q)`, `@(<-mp2)`) NAMES STORAGE THAT POINTER POINTS AT, but the address ref's root is `q0`, whose
// chain names the pointee, so a store through `r` landed on a place main doesn't record (`mx` held no view, and a growth of what was stored freed
// what `mx.inner.lp` read). The escape analysis now REROOTS such an address: its targets are the pointee's (`escape_pointer_targets` of the first
// pointer inward from the place's base), and a store records on each target and then on the address ref itself, as main does
// (`record_refs_at_target` wraps the old body, `record_refs_at_target_one`). `rrti_path`'s and `rrti_chain`'s descents also go down the rerooted
// targets' chains (by row 2's marked key), beside their own walk. A fix only adds records beside main's.
// THE CONTROLS AND RIGHT PROGRAMS (118; 116 since 177d2c row 3), each running 67 on main (acb78ea), row 2's candidate and here, by text: seat S's and seat A3's controls
// and right programs, seat S2's and seat A5's right programs, A5's fuel shapes one per form at K = 130 (7 of 56), and the controls of row 3's own
// probe faces and guard (`kp_chm_ok`, `kp_chd_ok`, `kp_chi_ok`, `km6_g2_ok`, `km8_cl_ok`, `km8_clm_ok`, `km8_pf_ok`, `km8_sp_ok`, `km6_rr_ok`).
// Not here: the other 49 `fu_*` and A5's 8 compile-time probes `tm_*`.
// 2026-11-18 (landing 177d2c, row 3, rulings l.17362): `pk2_lc_ok` and `r21_pkt_ok` moved to redef_reroot_store_prices.npk, prices at parity (a
// store into a `pick` binding's storage through an address rerooted to it is refused there at BORROW-009, as its direct twin is on main); 118 ->
// 116.
// 2026-11-19 (landing 177d2d, row 2: row 1 of 177d2c held out, now rebased onto aefae6e as R1-4 with the cost fix, its price DEF-694; rulings l.19112 and l.19370):
// its six growths (`a5_hpc_ok`, `a5_if_ok`, `a5_loop_ok`, `a5_rsg_ok`, `a5_view_ok`, `fu_self130_ok`) are refused on R1-4 at BORROW-015 and are in
// tests/analysis/rejection/addr_via_pointer_deep_prices_1.npk (rulings l.16674 item 3 (a)); `pk2_ok`, `pk2c_ok` and `pk3_ok` are refused on R1-4 at
// BORROW-009, row 3's `pick` gate met at depth, prices at parity with `pk2_lc_ok`, which main refuses at BORROW-009 in
// redef_reroot_store_prices.npk, and moved to tests/analysis/rejection/addr_via_pointer_deep_prices_2.npk (l.19112 item 4); 116 -> 107.
error:E5;
// Ailp-team_156, a3_hqv RIGHT TWIN, no growth (a3_hq with a parameter's value, as BORROW-002 refuses a borrow stored there): a one-hop rootless store whose targets are a
// field through a LOCAL POINTER (`@q.h`, q = @m); `q` dies at the block's end; `m.h.lp` read after `hq` grows.
struct:H_a3_hqv_ok = { List<int64>:l; int64:k; };
func:mk_a3_hqv_ok = List<int64>() never fails { List<int64>:l = raw list_init::<int64>(1i64); drop list_push(@l, 1i64); pass l; };
func:mkh_a3_hqv_ok = H_a3_hqv_ok() never fails { pass H_a3_hqv_ok{ l: raw mk_a3_hqv_ok(), k: 2i64 }; };
func:growh_a3_hqv_ok = int64(H_a3_hqv_ok->:w) never fails { loop(0i64, 64i64, 1i64) { drop list_push(@w.l, 1i64); } pass 7i64; };
func:fp_a3_hqv_ok = int64->(H_a3_hqv_ok->:q) never fails { pass @((<-q).l[0i64]); };
struct:HPO_a3_hqv_ok = { H_a3_hqv_ok->:lp; int64:z; };
struct:W_a3_hqv_ok = { HPO_a3_hqv_ok:h; int64:z; };
func:g_a3_hqv_ok = int64(H_a3_hqv_ok->:h0p, H_a3_hqv_ok->:hq, int64:n) never fails {
    W_a3_hqv_ok:m = W_a3_hqv_ok{ h: HPO_a3_hqv_ok{ lp: h0p, z: 0i64 }, z: 0i64 };
    {
        W_a3_hqv_ok->:q = @m;
        (<-(is (n > 0i64) : @q.h : @q.h)).lp = hq;
    }
    int64->:e = raw fp_a3_hqv_ok(m.h.lp);

    pass (<-e) + 6i64;
};
func:f_a3_hqv_ok = int64(int64:n) never fails {
    H_a3_hqv_ok:h0 = raw mkh_a3_hqv_ok(); H_a3_hqv_ok:h2 = raw mkh_a3_hqv_ok();
    pass raw g_a3_hqv_ok(@h0, @h2, n);
};
