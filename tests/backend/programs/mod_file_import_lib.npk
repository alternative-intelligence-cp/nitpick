// A FIXTURE for mod_file_import.npk: `use "./mod_file_import_lib.npk".*;`
// binds this file's `pub mod:fmi_other;` -- a file-module import's symbol --
// WITH the scope the loader linked to it (D-274 with D-273 §4), so
// `fmi_other.h()` works across files. The link is made at the end of
// collection, before any import round runs, or this copy would carry the
// empty scope collection opened. Not a test of its own.
mod:mod_file_import_lib;
pub mod:fmi_other;
