// expect-exit: 42
// stress: 40
//
// THE TEXT READER OVER A LIVE PIPE (D-185, 1.1.12c), aimed at the one
// stateful corner: a `\r` split from its `\n` by a refill boundary. The
// writer thread sends "ab\r", sleeps, then "\ncd\n" — the reader's first
// line ends at the lone-so-far `\r` (a break by itself, §3), and the
// pending flag swallows the late `\n` instead of minting an empty line.
// Then the writer's scope closes its end and the reader sees IoEof.
mod:text_pipe;
error:EStep;
const Duration:JOIN_2S = Duration{ ns: 2000000000i64 };

thread async func:feed = NIL(int64:wfd) joins JOIN_2S {
    ByteWriter:w = ByteWriter{ sink: own_fd((wfd =>! int32) =>! fd) };
    uint8[3]:a = [97u8, 98u8, 13u8];       // "ab\r"
    int64:n1 = await w.write(a[0i64...3i64], raw duration_ms(500i64)) ?! EStep;
    if (n1 != 3i64) { fail EStep; }
    await sleep(raw duration_ms(30i64)) ?| NIL;
    uint8[4]:b = [10u8, 99u8, 100u8, 10u8]; // "\ncd\n"
    int64:n2 = await w.write(b[0i64...4i64], raw duration_ms(500i64)) ?! EStep;
    if (n2 != 4i64) { fail EStep; }
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    wild int8->:fds = alloc(8i64);
    discard(sys(293i64, fds, 2048i64) ?! EStep);   // pipe2(O_NONBLOCK)
    wild int32->:fdi = fds =>! wild int32->;
    int32:rfd = fdi[0i64];
    int32:wfd = fdi[1i64];
    drop dalloc(fds);

    TextReader<ByteReader>:tr = raw text_reader(
        ByteReader{ src: own_fd(rfd =>! fd) });
    drop feed(wfd => int64);

    string:l1 = await text_read_line(@tr, raw duration_ms(1000i64)) ?! EStep;
    if (!(string_equals(l1, "ab"))) { exit 10i32; }
    string:l2 = await text_read_line(@tr, raw duration_ms(1000i64)) ?! EStep;
    if (!(string_equals(l2, "cd"))) { exit 11i32; }
    Result<string>:done = await text_read_line(@tr, raw duration_ms(1000i64));
    if (!done.is_error)             { exit 12i32; }
    if (done.err != IoEof)          { exit 13i32; }
    exit 42i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (EStep)            { exit 91i32; },
        (WouldBlock)       { exit 92i32; },
        (Interrupted)      { exit 92i32; },
        (IoEof)            { exit 93i32; },
        (BadPath)          { exit 93i32; },
        (DeadlineExceeded) { exit 94i32; },
        (HeapBadRequest)   { exit 95i32; },
        (HeapOom)          { exit 95i32; },
        (OutOfBounds)      { exit 96i32; },
        (Unreachable)      { exit 97i32; },
        (WildLeak)         { exit 98i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
