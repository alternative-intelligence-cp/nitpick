// expect-exit: 0
//
// The exact rationals end to end (D-198, 1.3.5): invariant-normalized mixed
// numbers whose arithmetic is the PRELUDE CORE's — the emitter unpacks,
// widens to int256, calls the deterministic prelude symbol, and narrows
// back or lands on the canonical ERR triple. Every answer below is
// hand-computed and EXACT; "exact or ERR" is the family's whole promise.
mod:frac_basic;

func:main = int32(cstring[]:argv) {
    // Construction: the lossless entry.
    frac32:a = 5i32 => frac32;
    frac32:third = (1i32 => frac32) / (3i32 => frac32);
    if (third.whole != 0i32)                     { exit 10i32; }
    if (third.num != 1i32)                       { exit 11i32; }
    if (third.denom != 3u32)                     { exit 12i32; }

    // 5 + 1/3 = 5 1/3 — normalization through the members.
    frac32:b = a + third;
    if (b.whole != 5i32)                         { exit 13i32; }
    if (b.num != 1i32)                           { exit 14i32; }
    if (b.denom != 3u32)                         { exit 15i32; }

    // 1/3 * 3 = 1, reduced: denom collapses to 1.
    frac32:one = third * (3i32 => frac32);
    if (one.whole != 1i32)                       { exit 16i32; }
    if (one.num != 0i32)                         { exit 17i32; }
    if (one.denom != 1u32)                       { exit 18i32; }

    // 1/2 - 5/6 = -1/3: the sign rides num when whole is 0.
    frac32:half = (1i32 => frac32) / (2i32 => frac32);
    frac32:fivesixth = (5i32 => frac32) / (6i32 => frac32);
    frac32:negthird = half - fivesixth;
    if (negthird.whole != 0i32)                  { exit 19i32; }
    if (negthird.num != (0i32 - 1i32))           { exit 20i32; }
    if (negthird.denom != 3u32)                  { exit 21i32; }

    // -2 5/8 through negation: -(2 5/8) — sign on whole, num positive.
    frac32:two58 = (2i32 => frac32) + ((5i32 => frac32) / (8i32 => frac32));
    frac32:neg258 = -two58;
    if (neg258.whole != (0i32 - 3i32))           { exit 22i32; }
    if (neg258.num != 3i32)                      { exit 23i32; }
    if (neg258.denom != 8u32)                    { exit 24i32; }

    // Division by an exact zero degrades to ERR; stickiness holds.
    frac32:z = (argv.len =>! int32 - 1i32) => frac32;
    frac32:derr = a / z;
    if (!(is_err(derr)))                         { exit 25i32; }
    if (!(is_err(derr + a)))                     { exit 26i32; }
    frac32:e = ERR;
    if (!(is_err(e * a)))                        { exit 27i32; }

    // Comparisons are exact: 1/3 < 1/2, 2/4 == 1/2, ordering both ways.
    if (!(third < half))                         { exit 28i32; }
    frac32:twofourth = (2i32 => frac32) / (4i32 => frac32);
    if (twofourth != half)                       { exit 29i32; }
    if (half <= third)                           { exit 30i32; }

    // Widths widen losslessly; narrowing that fits converts, one that
    // cannot absorbs as ERR.
    frac64:wide = third => frac64;
    if (wide.num != 1i64)                        { exit 31i32; }
    frac8:small = third =>! frac8;
    if (small.num != 1i8)                        { exit 32i32; }
    frac32:big = (200i32 => frac32) + third;
    frac8:nofit = big =>! frac8;
    if (!(is_err(nofit)))                        { exit 33i32; }

    // The exits: flt64 rounds under the bang; int truncates toward zero.
    flt64:f = third =>! flt64;
    if (f < 0.33f64)                             { exit 34i32; }
    if (f > 0.34f64)                             { exit 35i32; }
    int32:t = neg258 =>! int32;
    if (t != (0i32 - 2i32))                      { exit 36i32; }
    int32:p = two58 =>! int32;
    if (p != 2i32)                               { exit 37i32; }

    // Compound assignment through the shared core.
    frac32:acc = one;
    acc += third;
    if (acc.num != 1i32)                         { exit 38i32; }
    acc *= (3i32 => frac32);
    if (acc.whole != 4i32)                       { exit 39i32; }
    if (acc.num != 0i32)                         { exit 40i32; }

    // ToString renders the mixed number: "5 1/3".
    string:s = `&{b}`;
    if (s.len != 5i64)                           { exit 41i32; }

    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (IntOverflow) { exit 97i32; },
        (TbbErr) { exit 90i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom) { exit 95i32; },
        (Unreachable) { exit 97i32; },
        (WildLeak) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
