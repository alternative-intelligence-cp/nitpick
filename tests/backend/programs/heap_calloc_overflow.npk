// expect-exit: 25
//
// calloc's multiply is CHECKED (0.10.0, D-150): 2^62 * 8 wraps a plain
// `mul i64` into a small plausible size, and the floor allocator would have
// handed back an undersized block wearing a huge one's name. The real
// allocator refuses the request: npk_trap(-4104) -> failsafe.

func:main = int32(cstring[]:_~argv) {
    wild int8->:p = calloc(4611686018427387904i64, 8i64);
    discard(p);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 25i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
