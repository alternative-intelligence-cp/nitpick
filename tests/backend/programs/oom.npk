// expect-exit: 29
//
// OOM IS A TRAP, NOT AN EXIT CODE (0.10.1, the C-3 obligation): mmap refuses
// four exbibytes, and the allocator routes -4103 through a path that
// allocates nothing -- failsafe runs with preallocated state, because
// allocation just failed.

func:main = int32(cstring[]:_~argv) {
    wild int8->:p = alloc(4611686018427387904i64);
    discard(p);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapOom) { exit 29i32; },
        (HeapBadRequest) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
