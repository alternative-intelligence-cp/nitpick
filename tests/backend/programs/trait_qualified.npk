// expect-exit: 42
//
// D-172 — `Trait.method(recv, …)`. Two traits declare a method of the SAME
// name, one type implements both, and each method is reached by naming the
// trait it belongs to. The receiver is fitted as parameter 0 and the call
// lowers as a direct call to that impl's method (T-8) — the "a call through a
// member" rung retires for this shape. The UNQUALIFIED `p.name()` is refused as
// ambiguous by name; that rejection is `tests/types/rejection/`.
mod:trait_qualified;
error:E9;

// `twice` is a DEFAULT (1.4.7): the qualified spelling reached only an impl's
// OWN methods until then -- an inherited default's signature is `Self:self`,
// and the call resolved it with `Self` unbound (TYPE-005 at the trait).
// Inside Ta's own body `self.name()` is Ta's, never Tb's (1.0.4).
trait:Ta = {
    func:name = int32(Self:self);
    func:twice = int32(Self:self) { pass ((relay self.name()) * 2i32); };
    func:take = int32(Self:self, move string:s) never fails;
};
trait:Tb = { func:name = int32(Self:self); };

struct:P = { int32:v; };
impl:P:Ta = {
    func:name = int32(P:self) { pass 1i32; };
    func:take = int32(P:self, move string:s) never fails { pass ((s.len =>! int32) + self.v); };
};
impl:P:Tb = { func:name = int32(P:self) { pass 2i32; }; };

// A `move` PARAMETER THROUGH THE QUALIFIED SPELLING (1.5.4c step 0): the
// call demands `move(t)` as `p.take(t)` would, the callee drops the string at
// its exit, and `t` -- moved from -- is not dropped again when this function
// returns. Before the fix the checker demanded nothing and the same program
// spelled `Ta.take(p, t)` freed the body twice.
func:take_once = int32(P:p) never fails {
    string:t = string_concat("ab", "cd");
    pass (raw Ta.take(p, move(t)));      // 4
};

func:main = int32(cstring[]:_~argv) {
    P:p = P{ v: 0i32 };
    int32:a = Ta.name(p) ?! E9;          // 1, through Ta's impl
    int32:b = Tb.name(p) ?! E9;          // 2, through Tb's impl
    int32:c = Ta.twice(p) ?! E9;         // 2, the inherited default
    int32:d = raw take_once(p);          // 4, the moved string freed once
    exit a + b + c + d + 33i32;        // 42
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (StackExhausted) { exit 1i32; },
        (MachineFault) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
