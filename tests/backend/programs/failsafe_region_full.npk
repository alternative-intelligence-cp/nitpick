// expect-exit: 70
//
// THE FAILSAFE REGION IS A STATED BOUND (D-292, 1.5.6 step 2): a `failsafe`
// that allocates more than the region holds -- one mebibyte, stated once in
// the floor and in TCB.md SS5 -- traps `HeapOom` inside `failsafe`, which is
// the re-entry rule's one uncatchable stop, exit 70: today's answer to
// `HeapOom` there, at a bound a reader can name. On a floor whose `failsafe`
// allocated from the heap this request simply succeeded (46).
mod:failsafe_region_full;

func:main = int32(cstring[]:argv) {
    int32:zero = (argv.len =>! int32) - 1i32;
    exit 10i32 / zero;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DivByZero) {
            wild int8->:big = alloc(2097152i64);       // two mebibytes: past the region
            big[0i64] = 1i8;
            dalloc(big);
            exit 46i32;                                // the heap answered -- the old floor
        },
        (DivOverflow)      { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (HeapOom)          { exit 94i32; },
        (IntOverflow)      { exit 96i32; },
        (OutOfBounds)      { exit 95i32; },
        (Unreachable)      { exit 96i32; },
        (WildLeak)         { exit 97i32; },
        (*)                { exit 98i32; }
    }
    exit 99i32;
};
