// expect-exit: 42
//
// CALLING A METHOD THROUGH A GENERIC PARAMETER'S BOUND (1.0.6b). Three defects
// met here, and none of them had a test — which is why all three were live.
//
//   1. A GENERIC TRAIT NAMED AS A BOUND broke the trait's own parameter.
//      `func:twice<P: Producer<int32>>` calling `p.make()` made `T` in
//      `func:make = T(Self:self)` report "there is no type named `T`" AT THE
//      TRAIT'S DECLARATION, lines from the call that caused it. The trait's
//      parameters are bound from the instance now, on the CALL side, by the same
//      function the impl side has used since D-111.
//
//   2. THE VTABLE EMITTER read the same trait signature unbound, so a generic
//      trait WITH AN IMPL was refused by `npkc` for a program the frontend had
//      already accepted. Introduced at 1.0.5c, which added that read; no test had
//      a generic trait with an impl.
//
//   3. EVERY CALL THROUGH A BOUND named a symbol that no longer existed —
//      `@npk.m.make` where the definition had become `IntBox:Producer.make`.
//      Broken at 1.0.5b when symbols began carrying their impl, and invisible
//      because both ends had said the same wrong thing before. At check time the
//      receiver is the PARAMETER, so there is no impl to name; at emit time the
//      parameter has been substituted, so there is. The trait travels on the
//      call and the two are combined.
//
// Each of 1, 2 and 3 alone produces a program that does not compile, so the
// exit code below is only reached if all three hold.

error:E9;

trait:Plain = { func:one = int32(Self:self); };
trait:Producer<T> = { func:make = T(Self:self); };

struct:IntBox = { int32:v; };

impl:IntBox:Plain = { func:one = int32(IntBox:self) { pass 1i32; }; };
impl:IntBox:Producer<int32> = { func:make = int32(IntBox:self) { pass self.v; }; };

// A NON-GENERIC trait as a bound.
func:once<P: Plain> = int32(P:p) { pass (p.one()) ?! E9; };

// A GENERIC trait as a bound — the trait's `T` must resolve here.
func:twice<P: Producer<int32>> = int32(P:p) {
    int32:a = p.make() ?! E9;
    pass (a + a);
};

func:main = int32(cstring[]:_~argv) {
    IntBox:b = IntBox{ v: 20i32 };

    if ((once(b) ?! E9) != 1i32)   { exit 10i32; }
    if ((twice(b) ?! E9) != 40i32) { exit 11i32; }

    exit 42i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
