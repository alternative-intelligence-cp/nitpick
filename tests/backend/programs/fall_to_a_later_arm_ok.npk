func:forward_over_an_arm = int64() never fails { int64:k = 1i64; int64:t = 0i64; pick (k) { (1i64) { t = 7i64; fall c; }, (2i64) { t = 1i64; }, c: (3i64) { t = t + 0i64; }, (*) { t = 5i64; } } pass t; };
func:forward_from_if = int64() never fails { int64:k = 1i64; int64:t = 0i64; pick (k) { (1i64) { t = 7i64; if (k == 1i64) { fall b; } t = 1i64; }, b: (2i64) { t = t + 0i64; }, (*) { t = 5i64; } } pass t; };
func:forward_in_a_value_pick = int64() never fails { int64:k = 1i64; int64:t = 0i64; int64:q = pick (k) { (1i64) { fall b; }, b: (2i64) { give 7i64; }, (*) { give 5i64; } }; pass q + t; };
func:the_road_a_loop_around = int64() never fails { int64:k = 1i64; int64:t = 0i64; int64:g = 8i64; while (g > 0i64) decreases g { g = g - 1i64; pick (k) { a: (1i64) { t = t + 1i64; if (t == 7i64) { pass t; } fall b; }, b: (2i64) { k = 1i64; }, (*) { pass 5i64; } } } pass t; };
