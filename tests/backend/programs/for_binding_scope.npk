// expect-exit: 0
//
// DEF-127 (1.6.1d step 1; the library listener's F-011): A `for` BINDING ENDS
// WITH ITS LOOP IN THE EMITTER. Until this step the loop variable stayed in
// the emitter's name table after the loop, so a later use of an OUTER binding
// of the same name read the loop's slot: 3 for 100 (the same type), an outer
// array indexed the loop's 4-byte slot and read past it (-O0 and -O2
// disagreeing), an outer `string` reached `llc` as an `i64`. Each shape here,
// in a sync body and in a coroutine whose loop suspends (the frame-slot path),
// with a nested loop that shadows the outer loop's binding; every exit is the
// shape that broke.
mod:for_binding_scope;
error:E9;

func:v64 = int64(int64:n) never fails { pass n; };
func:v32 = int32(int32:n) never fails { pass n; };

func:sync_shapes = int32() never fails {
    // (1) the same type: the outer `i` after the loop is 100
    int64:i = raw v64(100i64);
    int64:s = 0i64;
    for (int64:i in 0i64...3i64) { s = s + i; }
    if (s != 3i64) { pass 1i32; }
    if (i != 100i64) { pass 2i32; }
    // (2) an outer array, a loop binding of its element type: `v[3]` is 44
    int32[4]:v = [11i32, 22i32, 33i32, 44i32];
    int32[3]:src = [5i32, 6i32, 7i32];
    int32:t = 0i32;
    for (int32:v in src) { t = t + v; }
    if (t != 18i32) { pass 3i32; }
    if (v[3i64] != 44i32) { pass 4i32; }
    if (v[0i64] != 11i32) { pass 5i32; }
    // (3) an outer `string`, a loop `int64`: the string is whole after the loop
    string:k = string_concat("hel", "lo");
    int64:c = 0i64;
    for (int64:k in 0i64...4i64) { c = c + k; }
    if (c != 6i64) { pass 6i32; }
    if (string_byte_length(k) != 5i64) { pass 7i32; }
    // (4) a nested loop whose binding shadows the outer loop's
    int64:seen = 0i64;
    for (int64:m in 0i64...2i64) {
        for (int64:m in 0i64...3i64) { seen = seen + m; }
        if (m > 1i64) { pass 8i32; }
    }
    if (seen != 6i64) { pass 9i32; }
    pass 0i32;
};

async func:coroutine_shapes = int32() {
    int64:i = raw v64(100i64);
    int64:s = 0i64;
    for (int64:i in 0i64...3i64) {
        await sleep(raw duration_ms(1i64)) ?| NIL;
        s = s + i;
    }
    if (s != 3i64) { pass 11i32; }
    if (i != 100i64) { pass 12i32; }
    int32[4]:v = [11i32, 22i32, 33i32, 44i32];
    int32[3]:src = [5i32, 6i32, 7i32];
    int32:t = 0i32;
    for (int32:v in src) {
        await sleep(raw duration_ms(1i64)) ?| NIL;
        t = t + v;
    }
    if (t != 18i32) { pass 13i32; }
    if (v[3i64] != 44i32) { pass 14i32; }
    string:k = string_concat("hel", "lo");
    int64:c = 0i64;
    for (int64:k in 0i64...4i64) {
        await sleep(raw duration_ms(1i64)) ?| NIL;
        c = c + k;
    }
    if (c != 6i64) { pass 15i32; }
    if (string_byte_length(k) != 5i64) { pass 16i32; }
    pass 0i32;
};

async func:main = int32(cstring[]:_~argv) {
    int32:a = raw sync_shapes();
    if (a != 0i32) { exit a; }
    int32:b = await coroutine_shapes() ?! E9;
    if (b != 0i32) { exit b; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; }, (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; }, (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; }, (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; }, (DecreasesViolated) { exit 109i32; }, (TbbErr) { exit 110i32; },
        (E9) { exit 111i32; }, (DeadlineExceeded) { exit 112i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
