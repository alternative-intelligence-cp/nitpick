// expect-exit: 42
//
// MULTI-PAYLOAD VARIANTS (1.0.9c). A variant's payloads are laid out as a
// struct — each at its aligned offset within the payload area, sized to the
// largest variant — so construction stores each argument at its offset and
// destructuring reads each back from the same place. Mixed widths and a
// three-payload variant exercise the offsets and the layout together.
mod:multi_payload;

enum:Ev = { Move(int32, int64); Tri(int8, int32, int8); Stop; };

func:score = int64(Ev:e) {
    pick (e) {
        (Ev.Move(a, b))    { pass (a =>! int64) + b; },
        (Ev.Tri(p, q, r))  { pass (p =>! int64) + (q =>! int64) + (r =>! int64); },
        (Ev.Stop)          { pass 0i64; }
    }
    pass 0i64;
};

func:main = int32(cstring[]:_~argv) {
    int64:s1 = score(Ev.Move(10i32, 22i64)) ?| 0i64;    // 32
    int64:s2 = score(Ev.Tri(3i8, 5i32, 2i8)) ?| 0i64;   // 10
    exit ((s1 + s2) =>! int32);                         // 42
};

func:failsafe = int32(tbb32:_~e) { exit 1i32; };
