// expect-exit: 11
//
// THE ARM FORMS OVER AN `Error` THAT ARE RIGHT (D-275, 1.5.4d), run: a `pick`
// over a `Result`'s `.err` in an ordinary function matches an inline
// module's constant by its FILE-qualified identity `(error_arm_forms.Boom)`
// -- the emitter hashes the pair through the one `error_identity` the
// resolver assigned it with, and the checker has admitted the pair because a
// declared constant hashes to it -- and `failsafe` names the same constant
// BARE after `use hidden.{Boom};`, the spelling D-275 recommends for a
// constant declared inside an inline module (a bare arm matches by the
// symbol's declaration, and the reach analysis accepts it for the constant
// `?! Boom` arms). `classify(5i32)` fails inside `hidden.b` and takes the
// qualified arm (10); `classify(1i32)` does not fail (0); `hidden.b(1i32) ?!
// Boom` succeeds (1).
mod:error_arm_forms;
use hidden.{Boom};

mod:hidden = {
    error:Boom;
    pub func:b = int32(int32:v) { if (v > 1i32) { fail Boom; } pass v; };
};

func:classify = int32(int32:v) never fails {
    Result<int32>:r = hidden.b(v);
    if (r.is_error) {
        pick (r.err) {
            (error_arm_forms.Boom) { pass 10i32; },
            (*)                    { pass 30i32; }
        }
    }
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    int32:a = raw classify(5i32);      // 10, the qualified identity matched outside `failsafe`
    int32:b = raw classify(1i32);      // 0
    int32:c = hidden.b(1i32) ?! Boom;  // 1, the constant imported bare
    exit (a + b + c);                  // 11
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Boom)           { exit 2i32; },
        (IntOverflow)    { exit 93i32; },
        (Unreachable)    { exit 95i32; },
        (HeapOom)        { exit 92i32; },
        (HeapBadRequest) { exit 91i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
