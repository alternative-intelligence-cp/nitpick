// expect-exit: 42
//
// #ptr_add<T>(ptr, offset) — pointer arithmetic, ELEMENT-scaled (D-033/D-187):
// it lowers to `getelementptr T`, so the offset counts elements of T and the
// type carries the stride; byte math is T = int8. The element-scaled and
// byte-scaled spellings must land on the same cell, which is what this checks.
mod:ptr_add;
error:E9;
func:main = int32(cstring[]:_~argv) {
    wild int8->:buf = alloc(64i64);
    int32:i = 0i32;
    while (i < 8i32) {
        wild int64->:slot = #ptr_add<int64>(buf =>! wild int64->, i => int64);
        <-slot = (i => int64) * 100i64;
        i = i + 1i32;
    }
    wild int64->:third = #ptr_add<int64>(buf =>! wild int64->, 3i64);
    if ((<-third) != 300i64) { exit 11i32; }
    wild int8->:b24 = #ptr_add<int8>(buf, 24i64);
    wild int64->:fourth = b24 =>! wild int64->;
    if ((<-fourth) != 300i64) { exit 12i32; }
    drop dalloc(buf);
    drop wild_release_all();
    exit 42i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 91i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom) { exit 95i32; },
        (OutOfBounds) { exit 96i32; },
        (Unreachable) { exit 97i32; },
        (WildLeak) { exit 98i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
