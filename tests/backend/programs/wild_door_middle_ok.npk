    discard(memset(src, 7i64, 128i64));
    uint8[]:b = small;
    Holder:hd = Holder{ p: src }; discard(mcpy(b.ptr, hd.p, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
