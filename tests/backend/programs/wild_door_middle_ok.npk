    uint8[]:b = small;
    uint8[]:t = #wild_slice<uint8>(src, 4i64); discard(mcpy(b.ptr, t.ptr =>! wild uint8->, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
