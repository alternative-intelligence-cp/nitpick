func:c10_mmov_wildsrc = int64() never fails {
    wild uint8->:w = alloc(128i64) =>! wild uint8->;
    discard(memset(w, 1i64, 128i64));
    uint8[]:small = #wild_slice<uint8>(w, 4i64);
    uint8[]:big = #wild_slice<uint8>(#ptr_add<uint8>(w, 64i64), 64i64);
    wild uint8->:src = alloc(128i64) =>! wild uint8->;
    discard(memset(src, 7i64, 128i64));
    uint8[]:b = small;
    discard(mmov(b.ptr, src, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
    dalloc(src);
    dalloc(w);
    pass (g * 10i64) + h;
};

// No `wild`, no `=>!`, no `#`: two views of one array, handed in by the caller. 10 * a[8] + a[0]: 11 the old pair, 17 the new pair; the refused cell `n1` read 71.
func:nowild = NIL(uint8[]:s, bool:hoist) never fails {
    uint8[]:b = s[2i64...4i64];
    if (hoist) { int64:v = raw repoint(@b, s); discard(memset(b.ptr, v, b.len)); pass NIL; }
    discard(memset(b.ptr, 7i64, b.len));
    pass NIL;
};
func:nc1_memset_lit = int64() never fails {
    uint8[16]:a = [1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8];
    drop nowild(a[0i64...8i64], false);
    pass ((a[8i64] => int64) * 10i64) + (a[0i64] => int64);
};
func:nc2_memset_before = int64() never fails {
    uint8[16]:a = [1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8,1u8];
    drop nowild(a[0i64...8i64], true);
    pass ((a[8i64] => int64) * 10i64) + (a[0i64] => int64);
};
// A `buffer` replaced BEFORE the call: the write lands in the live buffer, 7. The refused cell `n2` read 0.
func:nd_memset_buffer_ctl = int64() never fails {
    buffer:b = buffer_new(4i64);
    int64:v = raw regrow(@b);
    discard(memset(b.ptr, v, b.len));
    pass (b[0i64] => int64);
};

func:main = int32(cstring[]:_~argv) {
    if ((raw c1_memset_lit()) != 11i64) { exit 1i32; }
    if ((raw c2_memset_before()) != 17i64) { exit 2i32; }
    if ((raw c3_mcpy_before()) != 17i64) { exit 3i32; }
    if ((raw c4_mcpy_wildsrc()) != 11i64) { exit 4i32; }
    if ((raw c5_memset_binary()) != 11i64) { exit 5i32; }
    if ((raw c6_memset_index()) != 11i64) { exit 6i32; }
    if ((raw c7_memset_deref()) != 11i64) { exit 7i32; }
    if ((raw c8_mcpy_path()) != 11i64) { exit 8i32; }
    if ((raw c9_mcpy_cast_path()) != 11i64) { exit 9i32; }
    if ((raw c10_mmov_wildsrc()) != 11i64) { exit 10i32; }
    if ((raw nc1_memset_lit()) != 11i64) { exit 11i32; }
    if ((raw nc2_memset_before()) != 17i64) { exit 12i32; }
    if ((raw nd_memset_buffer_ctl()) != 7i64) { exit 13i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)       { exit 74i32; },
        (IntOverflow)       { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (HeapBadRequest)    { exit 93i32; },
        (WildLeak)          { exit 94i32; },
        (StackExhausted)    { exit 96i32; },
        (MachineFault)      { exit 97i32; },
        (OutOfBounds)       { exit 98i32; },
        (LimitViolated)     { exit 95i32; },
        (DecreasesViolated) { exit 95i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
