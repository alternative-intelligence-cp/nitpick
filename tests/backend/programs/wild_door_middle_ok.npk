// expect-exit: 0
//
// WHAT STAYS LEGAL IN THE ARGUMENT BETWEEN A WRITING SLOT'S `.ptr` AND ITS `.len`, AND WHAT EACH READS (DEF-469, landing 177c; `tests/analysis/rejection/wild_door_middle.npk` is its other half).
// One block of 1s: `small` views its first 4 bytes, `big` the last 64, from offset 64. Each cell returns 10 * byte[10] + byte[64]: 11 the old pair wrote (4 bytes at 0), 17 the new pair wrote (64 bytes at 64).
// 71, the mixed pair, is what the refused cells read before the rule, so a cell reading 71 here is the hole back. A failure exits with the cell's position in `main`'s list.
mod:wild_door_middle_ok;

func:repoint = int64(uint8[]->:b, uint8[]:big) never fails { <-b = big; pass 7i64; };
func:rep_src = wild uint8->(uint8[]->:b, uint8[]:big, wild uint8->:src) never fails { <-b = big; pass src; };
func:regrow = int64(buffer->:b) never fails { <-b = buffer_new(64i64); pass 7i64; };
struct:Holder = { wild uint8->:p; };

func:c1_memset_lit = int64() never fails {
    wild uint8->:w = alloc(128i64) =>! wild uint8->;
    discard(memset(w, 1i64, 128i64));
    uint8[]:small = #wild_slice<uint8>(w, 4i64);
    uint8[]:big = #wild_slice<uint8>(#ptr_add<uint8>(w, 64i64), 64i64);
    wild uint8->:src = alloc(128i64) =>! wild uint8->;
    discard(memset(src, 7i64, 128i64));
    uint8[]:b = small;
    discard(memset(b.ptr, 7i64, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
    dalloc(src);
    dalloc(w);
    pass (g * 10i64) + h;
};

func:c2_memset_before = int64() never fails {
    wild uint8->:w = alloc(128i64) =>! wild uint8->;
    discard(memset(w, 1i64, 128i64));
    uint8[]:small = #wild_slice<uint8>(w, 4i64);
    uint8[]:big = #wild_slice<uint8>(#ptr_add<uint8>(w, 64i64), 64i64);
    wild uint8->:src = alloc(128i64) =>! wild uint8->;
    discard(memset(src, 7i64, 128i64));
    uint8[]:b = small;
    int64:v = raw repoint(@b, big); discard(memset(b.ptr, v, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
    dalloc(src);
    dalloc(w);
    pass (g * 10i64) + h;
};

func:c3_mcpy_before = int64() never fails {
    wild uint8->:w = alloc(128i64) =>! wild uint8->;
    discard(memset(w, 1i64, 128i64));
    uint8[]:small = #wild_slice<uint8>(w, 4i64);
    uint8[]:big = #wild_slice<uint8>(#ptr_add<uint8>(w, 64i64), 64i64);
    wild uint8->:src = alloc(128i64) =>! wild uint8->;
    discard(memset(src, 7i64, 128i64));
    uint8[]:b = small;
    wild uint8->:s2 = raw rep_src(@b, big, src); discard(mcpy(b.ptr, s2, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
    dalloc(src);
    dalloc(w);
    pass (g * 10i64) + h;
};

