    uint8[]:b = small;
    int64:k = 3i64; discard(memset(b.ptr, k + 4i64, b.len));
    int64:g = (<-(#ptr_add<uint8>(w, 10i64))) => int64;
    int64:h = (<-(#ptr_add<uint8>(w, 64i64))) => int64;
