// expect-exit: 0
mod:place_too_deep_ok;
// WHAT PART A LEAVES LEGAL (DEF-430, landing 177d2b4, row 2), each module one cell that reads its own right value at -O0, -O2 and under the freed-heap
// detector. Places 63 storage steps deep, one under the limit, by each road: `fin_63` and `fpn_63` a `for`, `fkn_63` a lending `pick`, `pri_63` and
// `pr_63` a read, and a stateful kind's operation beside the place it would refuse (`sk_cv_fc_63` a plain local, `sk_mx_zc_63` after a `pick`,
// `sk_sa_lc_63` a `move` parameter, `sk_gd_vc_63` a consuming `pick`). `prs_64`: the road the sentence names, a 64-step read split at a pointer taken
// half way. `gmn_123`: a right `where` guard 123 calls deep; `hn_123`: a loop whose deep write is 123 calls down: just under the guard walk's and the
// assigned walk's start (the tree's bound, 256), the parser refusing a few levels on (PARSE-012).
error:E5;
func:mk = string() never fails { pass string_concat("ab", "cde"); };
func:fs = int64(string:v, int64:k) never fails { string:junk = string_concat("qq", "qq"); pass (string_bytes(v)[0i64] => int64) - 90i64 + k; };
func:code = int32(int64:v) never fails { int32:c = 0i32; int64:w = v & 255i64; for (int64:i in 0i64...w) { c = c + 1i32; } pass c; };
enum:E2 = { A(string); Z; };
