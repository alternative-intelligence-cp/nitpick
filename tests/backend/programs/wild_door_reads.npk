// expect-exit: 0
//
// WHAT THE `wild` DOOR LEAVES LEGAL, AND WHAT IT READS (DEF-423, DEF-425, landing 177c): each module is one cell of the review, its own `main` now `cell_main`,
// each with the value it read alone. A failure exits with the cell's position in `main`'s list. A header's `.ptr[i]` read past its length, the other half of I2, is `header_ptr_past.npk`.
mod:wild_door_reads;

// THE RULED LIST (rulings section 4): `p0c`, `r7`, `r10`, the written cast `ra6b`. `i2a`: the index `setq(@s)` re-assigns `s` to "wxyz", `ptr` and `len` load after the index, so the read is `w` of the new block: 119 - 30 + 60 = 149. Before the fix this cell read the freed block's poison, 200.
mod:p0c_slice_ptr_memset_ok = {
func:f = int64() never fails { uint8[8]:b = [1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]; uint8[]:v = b[0i64...8i64]; discard(memset(v.ptr, 0i64, v.len)); pass 5i64 + (v[0i64] => int64); };
pub func:cell_main = int32() never fails { pass (((raw f()) + 60i64) =>! int32); };
};
mod:r7_plain_ptr_index_ctl = {
func:f = int64() never fails { int64:i = 5i64; int64->:p = @i; pass p[0i64]; };
pub func:cell_main = int32() never fails { pass (((raw f()) + 60i64) =>! int32); };
};
mod:r10_wild_alloc_index_ctl = {
func:f = int64() never fails { wild uint8->:w = alloc(8i64) =>! wild uint8->; w[0i64] = 1u8; pass 5i64 + ((w[0i64] => int64) - 1i64); };
pub func:cell_main = int32() never fails { pass (((raw f()) + 60i64) =>! int32); };
};
mod:ra6b_wild_param_cast_ctl = {
struct:H = { string:s; };
struct:L = { wild string->:items; int64:n; };
func:mk = H() never fails { pass H{ s: string_concat("ab", "cde") }; };
func:mks = string() never fails { pass string_concat("ab", "cde"); };
func:setw = NIL(wild H->->:pp, wild H->:v) never fails { <-pp = v; pass NIL; };
func:bump = NIL(int64->:p) never fails { (<-p) = (<-p) + 1i64; pass NIL; };
func:take = NIL(wild string->:x) never fails { string:t = move(<-x); pass NIL; };
func:f = int64() never fails { string:s = raw mks(); drop take((@s) =>! wild string->); pass s.len; };
pub func:cell_main = int32() never fails { pass (((raw f()) + 60i64) =>! int32); };
};
mod:i2a_load_before_index = {
func:mk = string() never fails { pass string_concat("ab", "cde"); };
func:setq = int64(string->:q) never fails { <-q = string_concat("wx", "yz"); pass 0i64; };
func:fs = int64(string:v, int64:k) never fails { string:junk = string_concat("qq", "qq"); pass (string_bytes(v)[0i64] => int64) - 90i64 + k; };
func:gvv = int64(fixed uint8[]:v, int64:k) never fails { string:junk = string_concat("qq", "qq"); pass (v[0i64] => int64) - 90i64 + k; };
func:midv = int64(string:v, string->:q) never fails { <-q = string_concat("wx", "yz"); string:junk = string_concat("qq", "qq"); pass (string_bytes(v)[0i64] => int64) - 90i64; };
func:f = int64() never fails { string:s = raw mk(); int64:r = (s.ptr[raw setq(@s)] => int64) - 30i64; pass r; };
pub func:cell_main = int32() never fails { pass (((raw f()) + 60i64) =>! int32); };
};

