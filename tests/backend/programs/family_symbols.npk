// expect-exit: 42
//
// TWO INSTANTIATIONS OF ONE FAMILY IMPL ARE TWO SYMBOLS (D-156 amended,
// 1.0.5b). `emit_family_instances` passed the plain method name for every
// instantiation, so `impl:<T>:Box<T>:S` emitted `w` twice and `llc` refused the
// module — the same collision two per-instance impls had, one level up.
//
// The symbol carries the INSTANTIATED target, which is what separates them:
// `Box<int32>:S.w` and `Box<int64>:S.w`.

error:E9;

trait:S = { func:w = int64(Self:self); };

struct:Box<T> = { T:v; };

impl:<T>:Box<T>:S = { func:w = int64(Box<T>:self) { pass 8i64; }; };

func:main = int32(cstring[]:_~argv) {
    Box<int32>:a = Box{ v: 1i32 };
    Box<int64>:b = Box{ v: 2i64 };

    if ((a.w() ?! E9) != 8i64) { exit 10i32; }
    if ((b.w() ?! E9) != 8i64) { exit 11i32; }

    exit 42i32;
};

func:failsafe = int32(Error:_~e) { exit 1i32; };
