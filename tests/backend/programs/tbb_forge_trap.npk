// expect-exit: 24
//
// The SAME-WIDTH forge trap (1.3.4): `int32 => tbb32` with INT_MIN — a
// number arriving from outside wearing the sentinel's bit pattern — must
// TRAP under the checked spelling (D-144: a forged taint is a value with no
// image). Until the tern work the same-text early-out passed it through
// raw, and the result LOOKED like the saturation `=>!` performs — the
// coincidence that hid the hole: the forge manufactured exactly the state
// the test expected.
mod:tbb_forge_trap;

func:main = int32(cstring[]:argv) {
    int32:one = argv.len =>! int32;                    // 1, at run time
    int32:minv = ((0i32 - 2147483647i32) - one);       // INT_MIN, at run time
    tbb32:forged = minv => tbb32;                      // must trap
    exit (forged =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (TbbErr) { exit 24i32; },
        (DivByZero) { exit 9i32; },
        (DivOverflow) { exit 9i32; },
        (HeapBadRequest) { exit 9i32; },
        (HeapOom) { exit 9i32; },
        (Unreachable) { exit 9i32; },
        (WildLeak) { exit 9i32; },
        (*) { exit 9i32; }
    }
    exit 9i32;
};
