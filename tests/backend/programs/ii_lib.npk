// A FIXTURE for inline_imports.npk, imported INSIDE its inline module `m`
// in three spellings -- `use "./ii_lib.npk".*;`, `use "./ii_lib.npk" as
// lib;`, `use "./ii_lib.npk".{g};` -- and re-exported from it with `pub use
// "./ii_lib.npk".{twice};` (D-276, 1.5.4d). Not a test of its own.
mod:ii_lib;
pub func:f = int32() never fails { pass 5i32; };
pub func:g = int32() never fails { pass 7i32; };
pub func:twice = int32(int32:v) never fails { pass (v * 2i32); };
