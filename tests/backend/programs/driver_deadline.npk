// expect-exit: 0
// stress: 10
// argv: MOCK_DRIVER
//
// THE DISPATCH DEADLINE CONTAINS A HANG (D-055 rule 1: a hang is worse
// than a crash). Kernel 888 never replies; the 100ms deadline expires, the
// dispatch SIGKILLs the driver via its pidfd and fails EDriverDeadline —
// and the Bridge is POISONED: the ring state is unknown, so the next
// dispatch answers EBridgePoisoned without touching the wire (§4.4, no
// partial results). Teardown then reaps the corpse; exit 0 asserts the
// full reclaim.
mod:driver_deadline;
use "../../../lib/nbridge.npk".*;
error:E9;

async func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) { exit 7i32; }
    string:mp = string_from_bytes(argv[1i64].ptr, argv[1i64].len);
    Path:p = path_parse(mp) ?! E9;
    Result<Bridge>:br = await spawn_driver(p, 65536i64, 64i64, 0i64, raw duration_secs(5i64));
    Bridge:b = br ?! E9;

    Result<int32>:r = await dispatch(@b, 888i64, 0i64, raw duration_ms(100i64));
    if (!r.is_error)                 { exit 21i32; }
    if (r.err != EDriverDeadline)    { exit 22i32; }

    Result<int32>:r2 = await dispatch(@b, 35i64, 0i64, raw duration_secs(1i64));
    if (!r2.is_error)                { exit 23i32; }
    if (r2.err != EBridgePoisoned)   { exit 24i32; }

    drop bridge_reap(@b);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)               { exit 91i32; },
        (BadPath)          { exit 92i32; },
        (EDriverSpawn)     { exit 93i32; },
        (EDriverFault)     { exit 94i32; },
        (EDriverProtocol)  { exit 95i32; },
        (EDriverDeadline)  { exit 96i32; },
        (ERingFull)        { exit 85i32; },
        (EBridgePoisoned)  { exit 85i32; },
        (EShmCreate)       { exit 97i32; },
        (EShmSeal)         { exit 97i32; },
        (EShmMap)          { exit 97i32; },
        (DeadlineExceeded) { exit 98i32; },
        (DriverLeak)       { exit 89i32; },
        (WildLeak)         { exit 88i32; },
        (Unreachable)      { exit 87i32; },
        (HeapOom)          { exit 87i32; },
        (HeapBadRequest)   { exit 87i32; },
        (OutOfBounds)      { exit 86i32; },
        (*)                { exit 99i32; }
    }
    exit 90i32;
};
