// expect-exit: 0
//
// `Result<T>`'s three members (D-069): `value`, `error`, and `is_error` DERIVED
// as `error != 0` — plus the one explicit spelling of `return`.

mod:result_members;
error:E3;

func:direct = int32() {
    return Result{ value: 41i32 };
};

func:refused = int32(int32:code) {
    if (code > 0i32) { fail E3; }
    pass 5i32;
};

func:main = int32(cstring[]:_~argv) {
    Result<int32>:a = direct();
    if (a.is_error)                          { exit 10i32; }
    if (a.is_error)                          { exit 11i32; }
    if (a.value != 41i32)                    { exit 12i32; }

    Result<int32>:b = refused(3i32);
    if (!b.is_error)                         { exit 13i32; }
    if (b.err != E3)                     { exit 14i32; }
    // `b.value` here would be NITPICK-TAINT-001: after a failure the value slot
    // is TAINTED, and reading it is refused — the analysis caught this very
    // file trying, which is the rule working. The zeroed slot is asserted from
    // the emitting side instead (tests/backend/ir_func.npk pins the bytes).

    Result<int32>:c = refused(0i32);
    if (c.is_error)                          { exit 16i32; }
    if (c.value != 5i32)                     { exit 17i32; }

    wild_release_all();

    wild_release_all();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (E3) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
