// expect-exit: 0
//
// THE LEGAL HALF OF DEF-371 + DEF-373 (landing 171): a `return` statement's `Result{value: v}` takes `pass v;`'s
// road, so what `pass` moves the long form moves -- a named owner, a field of one (the aggregate left with its
// vacant field, S-26), a pointer parameter's whole pointee (left VACANT, D-225) -- where landings 169 and 170 COPIED
// each (95/95 at both legs: wt/51a/.internal/probes/t171/twin371/, ra3 and ra6 of t170/rev170/); every refusal of
// tests/types/rejection/result_literal_road.npk has its transfer here [not so of sites 25 and 28-33, nor of site 29's
// two remedies, until landing 172 -- management's review of 224d907, its F3: see below] -- `move(...)` at the place inside each
// operator (a ternary's arms, nested, `??`, `??!`, `?!`, `?|`, `relay`, a cast, a `dyn` cast, a pick's `give`), a
// temporary's part BOUND FIRST and moved out of the binding, or cloned; plain data copied, which no rule refuses (a
// pointer parameter's pointee's PLAIN part among it); and the literal writing ONE field, `value` or `err` (DEF-373).
// Each control is a function that RETURNS, so its scope's drops run -- a second owner would trap in the allocator's
// double-free check (95) --, and each fails at its own exit. Exit 0 at both legs.
// LANDING 172 (2026-10-30; management's review of 224d907, its F2 and F3): controls 27-30 move a named owner into a
// literal OUTSIDE a `return` -- an initialiser, an assignment's value, a call's argument, a struct literal's field
// (the rejection file's sites 38-41 copy it) --, and controls 31-37 hold the transfer each remaining refusal NAMES: a
// part read through a call's pointer, cloned (site 25); the parameter declared `move` (site 28); a pointer parameter's
// pointee's owning part cloned, or handed back as a VIEW of the caller's bytes (site 29; the plain part and the whole
// pointee were controls 25 and 13); a limited binding's part copied, or the whole binding moved (site 30); a `fixed`
// binding cloned (site 31); the sealing module's own function handing the field on (site 32); a `never fails`
// function filling the `never fails` slot (site 33). Controls 27-30's literals stand in functions returning PS, the
// literal's `T` (DEF-388, OPEN HIGH: a literal outside a `return` is typed by the enclosing function's success type
// and wild context, never by its slot). Exit 0 at both legs under this compiler and landing 171's.
mod:result_literal_road_ok;
error:E1;
struct:PS = { string:s; int64:k; };
trait:Tl = { func:ln = int64(Self:self) never fails; };
impl:PS:Tl = { func:ln = int64(PS:self) never fails { pass self.s.len; }; };
struct:HU = { PS:u; int64:j; };
struct:WR = { Result<PS>:ra; };
#[derive(Clone)]
struct:PC = { string:s; int64:k; };
struct:Named = { string:name; int32:v; };
Rules<Named>:r_named = { $.v > 0i32 };
mod:bank = {
    pub struct:Vault = { sealed string:name; };
    pub func:vault_of = Vault(move string:s) never fails {
        Vault:n = Vault{ name: move(s) };
        pass n;
    };
    // site 32's remedy: the module that seals the field hands it on, the long form moving it out inside the module
    pub func:name_of = string(move Vault:v) {
        return Result{value: v.name};
    };
};
use bank.*;
func:mk = PS() never fails {
    pass PS{ s: string_concat("ab", "cd"), k: 1i64 };
};
func:mk6 = PS() never fails {
    pass PS{ s: string_concat("abc", "def"), k: 2i64 };
};
func:mkh = HU() never fails {
    pass HU{ u: raw mk(), j: 2i64 };
};
func:mka = PS[2]() never fails {
    pass [raw mk(), raw mk6()];
};
func:mkr = PS(bool:c) {
    if (!c) { fail E1; }
    pass raw mk();
};

// --- `pass`'s implicit move (D-183), now the long form's ----------------------------------------------------------
func:lr_named = PS() {
    PS:a = raw mk();
    PS:b = raw mk6();
    return Result{value: a};
};
func:c_named = int64() {
    PS:x = lr_named() ?| raw mk6();
    pass x.s.len;
};
func:lr_field = PS() {
    HU:h = HU{ u: raw mk(), j: 1i64 };
    return Result{value: h.u};
};
func:c_field = int64() {
    PS:x = lr_field() ?| raw mk6();
    pass x.s.len;
};
func:lr_deref = PS(PS->:pa) {
    return Result{value: <-pa};
};
func:c_deref = int64() {
    PS:a = raw mk();
    PS:x = lr_deref(@a) ?| raw mk6();
    pass x.s.len + a.s.len;
};

// --- `move(...)` at the place inside the operator ---------------------------------------------------------------
func:lr_tern = PS(bool:c) {
    PS:a = raw mk();
    PS:b = raw mk6();
    return Result{value: is (c) : move(a) : move(b)};
};
func:c_tern = int64() {
    PS:x = lr_tern(false) ?| raw mk();
    pass x.s.len;
};
func:lr_nest = PS(bool:c, bool:d) {
    PS:a = raw mk();
    PS:b = raw mk6();
    PS:a2 = raw mk();
    return Result{value: is (c) : (is (d) : move(a) : move(b)) : move(a2)};
};
func:c_nest = int64() {
    PS:x = lr_nest(true, false) ?| raw mk();
    pass x.s.len;
};
func:lr_coal = PS() {
    PS?:oa = raw mk6();
    return Result{value: move(oa) ?? raw mk()};
};
func:c_coal = int64() {
    PS:x = lr_coal() ?| raw mk();
    pass x.s.len;
};
func:lr_ecoal = PS() {
    PS?:oa = raw mk6();
    return Result{value: move(oa) ??! E1};
};
func:c_ecoal = int64() {
    PS:x = lr_ecoal() ?| raw mk();
    pass x.s.len;
};
func:lr_unwrap = PS(bool:c) {
    Result<PS>:ra = mkr(c);
    return Result{value: move(ra) ?! E1};
};
func:c_unwrap = int64() {
    PS:x = lr_unwrap(true) ?| raw mk6();
    pass x.s.len;
};
func:lr_dflt = PS(bool:c) {
    Result<PS>:ra = mkr(c);
    return Result{value: move(ra) ?| raw mk6()};
};
func:c_dflt = int64() {
    PS:x = lr_dflt(false) ?| raw mk();
    pass x.s.len;
};
func:lr_relay = PS(bool:c) {
    Result<PS>:ra = mkr(c);
    return Result{value: relay move(ra)};
};
func:c_relay = int64() {
    PS:x = lr_relay(true) ?| raw mk6();
    PS:y = lr_relay(false) ?| raw mk6();
    pass x.s.len + y.s.len;
};
func:lr_cast = PS() {
    PS:a = raw mk6();
    return Result{value: move(a) => PS};
};
func:c_cast = int64() {
    PS:x = lr_cast() ?| raw mk();
    pass x.s.len;
};
func:lr_dyn = dyn Tl() {
    PS:a = raw mk6();
    return Result{value: move(a) => dyn Tl};
};
func:c_dyn = int64() {
    dyn Tl:x = lr_dyn() ?| (raw mk() => dyn Tl);
    pass raw x.ln();
};
func:lr_pgive = PS(bool:c) {
    PS:a = raw mk();
    PS:b = raw mk6();
    return Result{value: pick (c) { (true) { give move(a); }, (false) { give move(b); } }};
};
func:c_pgive = int64() {
    PS:x = lr_pgive(false) ?| raw mk();
    pass x.s.len;
};

// --- a temporary's part bound first and moved out of the binding, or cloned ---------------------------------------
func:lr_part_bound = string() {
    PS:t = raw mk6();
    return Result{value: move(t.s)};
};
func:lr_part_clone = string() {
    return Result{value: (raw mk6()).s.clone() ?! E1};
};
func:lr_part_nested = string() {
    HU:t = raw mkh();
    return Result{value: move(t.u.s)};
};
func:lr_part_elem = string() {
    PS[2]:t = raw mka();
    return Result{value: move(t[1i64].s)};
};
func:lr_part_snav = string() {
    PS?:o = raw mk6();
    PS:t = move(o) ?? raw mk();
    return Result{value: move(t.s)};
};
func:c_parts = int64() {
    string:a = lr_part_bound() ?| string_concat("", "");
    string:b = lr_part_clone() ?| string_concat("", "");
    string:c = lr_part_nested() ?| string_concat("", "");
    string:d = lr_part_elem() ?| string_concat("", "");
    string:e = lr_part_snav() ?| string_concat("", "");
    pass a.len + b.len + c.len + d.len + e.len;
};

// --- a fresh value, a transfer, plain data (a pointer parameter's pointee's plain part among it) -------------------
func:lr_fresh = PS() {
    return Result{value: raw mk6()};
};
func:lr_moved = PS() {
    PS:a = raw mk6();
    return Result{value: move(a)};
};
func:lr_plain = int64() {
    int64:k = 3i64;
    return Result{value: k};
};
func:lr_plain_pointee = int64(PS->:q) {
    return Result{value: q.k};
};
func:c_clean = int64() {
    PS:x = lr_fresh() ?| raw mk();
    PS:y = lr_moved() ?| raw mk();
    PS:z = raw mk6();
    int64:p = lr_plain_pointee(@z) ?| 0i64;
    pass x.s.len + y.s.len + (lr_plain() ?| 0i64) + p + z.s.len;
};

// --- DEF-373: ONE field -----------------------------------------------------------------------------------------
func:lr_err = PS() {
    PS:a = raw mk();
    return Result{err: E1};
};
func:c_err = int64() {
    Result<PS>:r = lr_err();
    if (!r.is_error) { pass 0i64; }
    PS:x = lr_err() ?| raw mk6();
    pass x.s.len;
};

// --- landing 172 (F2): a `Result` literal's value OUTSIDE a `return`, MOVED ------------------------------------------
// Each literal stands in a function returning PS, the literal's `T` (DEF-388: a literal outside a `return` is typed
// by the enclosing function's success type, never by its slot).
func:takes_r = int64(move Result<PS>:r) never fails {
    PS:x = move(r) ?| raw mk();
    pass x.s.len;
};
func:lr_lit_init = PS() {
    PS:a = raw mk6();
    Result<PS>:r = Result{value: move(a)};
    PS:x = move(r) ?| raw mk();
    pass x;
};
func:c_lit_init = int64() {
    PS:x = lr_lit_init() ?| raw mk();
    pass x.s.len;
};
func:lr_lit_assign = PS() {
    PS:a = raw mk6();
    Result<PS>:r = Result{value: raw mk()};
    r = Result{value: move(a)};
    PS:x = move(r) ?| raw mk();
    pass x;
};
func:c_lit_assign = int64() {
    PS:x = lr_lit_assign() ?| raw mk();
    pass x.s.len;
};
func:lr_lit_arg = PS() {
    PS:a = raw mk6();
    int64:n = raw takes_r(Result{value: move(a)});
    pass PS{ s: string_concat("", ""), k: n };
};
func:c_lit_arg = int64() {
    PS:x = lr_lit_arg() ?| raw mk();
    pass x.k;
};
func:lr_lit_field = PS() {
    PS:a = raw mk6();
    WR:w = WR{ ra: Result{value: move(a)} };
    PS:x = move(w.ra) ?| raw mk();
    pass x;
};
func:c_lit_field = int64() {
    PS:x = lr_lit_field() ?| raw mk();
    pass x.s.len;
};

// --- landing 172 (F3): the transfer each remaining refusal names --------------------------------------------------
func:getp = PS->(PS->:q) never fails {
    pass q;
};
// site 25's: the part read through a call's pointer, cloned
func:lr_cptr_clone = string() {
    PS:ps = raw mk6();
    return Result{value: (raw getp(@ps)).s.clone() ?! E1};
};
func:c_cptr_clone = int64() {
    string:a = lr_cptr_clone() ?| string_concat("", "");
    pass a.len;
};
// site 28's: the parameter declared `move`
func:lr_move_param = PS(move PS:p) {
    return Result{value: p};
};
func:c_move_param = int64() {
    PS:b = lr_move_param(raw mk6()) ?| raw mk();
    pass b.s.len;
};
// site 29's: the pointee's owning part cloned, or handed back as a VIEW of the caller's bytes
func:lr_pointee_clone = string(PS->:q) {
    return Result{value: q.s.clone() ?! E1};
};
func:lr_pointee_view = string(PS->:q) {
    fixed uint8[]:b = string_bytes(q.s);
    return Result{value: string_from_bytes(b.ptr, b.len)};
};
func:c_pointee = int64() {
    PS:z = raw mk6();
    string:c = lr_pointee_clone(@z) ?| string_concat("", "");
    string:d = lr_pointee_view(@z) ?| string_concat("", "");
    fixed uint8[]:db = string_bytes(d);
    if (db[5i64] != 102u8) { pass 0i64; }
    pass c.len + d.len + z.s.len;
};
// site 30's: the limited binding's part copied, or the whole binding moved
func:lr_limited_clone = string() {
    limit<r_named> Named:n = Named{ name: string_concat("abc", "def"), v: 1i32 };
    return Result{value: n.name.clone() ?! E1};
};
func:lr_limited_whole = Named() {
    limit<r_named> Named:n = Named{ name: string_concat("abc", "def"), v: 1i32 };
    return Result{value: n};
};
func:c_limited = int64() {
    string:e = lr_limited_clone() ?| string_concat("", "");
    Named:f = lr_limited_whole() ?| Named{ name: string_concat("", ""), v: 1i32 };
    pass e.len + f.name.len;
};
// site 31's: the `fixed` binding cloned
func:lr_fixed_clone = PC() {
    fixed PC:f = PC{ s: string_concat("abc", "def"), k: 2i64 };
    return Result{value: f.clone() ?! E1};
};
func:c_fixed_clone = int64() {
    PC:g = lr_fixed_clone() ?| PC{ s: string_concat("", ""), k: 0i64 };
    pass g.s.len;
};
// site 32's: the sealing module's own function hands the field on
func:lr_sealed_module = string() {
    Vault:n = raw vault_of(string_concat("abc", "def"));
    return Result{value: name_of(move(n)) ?! E1};
};
func:c_sealed_module = int64() {
    string:h = lr_sealed_module() ?| string_concat("", "");
    pass h.len;
};
// site 33's: a `never fails` function fills the `never fails` slot
func:nf = int32(int32:v) never fails {
    pass v + 1i32;
};
func:lr_nf_slot = func int32(int32) never fails () {
    return Result{value: nf};
};
func:c_nf_slot = int64() {
    func int32(int32) never fails:g33 = lr_nf_slot() ?! E1;
    int32:y = raw g33(5i32);
    pass (y => int64);
};

func:main = int32(cstring[]:_~argv) {
    if ((c_named() ?| 0i64) != 4i64) { exit 11i32; }
    if ((c_field() ?| 0i64) != 4i64) { exit 12i32; }
    if ((c_deref() ?| 0i64) != 4i64) { exit 13i32; }
    if ((c_tern() ?| 0i64) != 6i64) { exit 14i32; }
    if ((c_nest() ?| 0i64) != 6i64) { exit 15i32; }
    if ((c_coal() ?| 0i64) != 6i64) { exit 16i32; }
    if ((c_ecoal() ?| 0i64) != 6i64) { exit 17i32; }
    if ((c_unwrap() ?| 0i64) != 4i64) { exit 18i32; }
    if ((c_dflt() ?| 0i64) != 6i64) { exit 19i32; }
    if ((c_relay() ?| 0i64) != 10i64) { exit 20i32; }
    if ((c_cast() ?| 0i64) != 6i64) { exit 21i32; }
    if ((c_dyn() ?| 0i64) != 6i64) { exit 22i32; }
    if ((c_pgive() ?| 0i64) != 6i64) { exit 23i32; }
    if ((c_parts() ?| 0i64) != 28i64) { exit 24i32; }
    if ((c_clean() ?| 0i64) != 23i64) { exit 25i32; }
    if ((c_err() ?| 0i64) != 6i64) { exit 26i32; }
    if ((c_lit_init() ?| 0i64) != 6i64) { exit 27i32; }
    if ((c_lit_assign() ?| 0i64) != 6i64) { exit 28i32; }
    if ((c_lit_arg() ?| 0i64) != 6i64) { exit 29i32; }
    if ((c_lit_field() ?| 0i64) != 6i64) { exit 30i32; }
    if ((c_cptr_clone() ?| 0i64) != 6i64) { exit 31i32; }
    if ((c_move_param() ?| 0i64) != 6i64) { exit 32i32; }
    if ((c_pointee() ?| 0i64) != 18i64) { exit 33i32; }
    if ((c_limited() ?| 0i64) != 12i64) { exit 34i32; }
    if ((c_fixed_clone() ?| 0i64) != 6i64) { exit 35i32; }
    if ((c_sealed_module() ?| 0i64) != 6i64) { exit 36i32; }
    if ((c_nf_slot() ?| 0i64) != 6i64) { exit 37i32; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (IntOverflow)       { exit 108i32; },
        (OutOfBounds)       { exit 109i32; },
        (LimitViolated)     { exit 110i32; },
        (DecreasesViolated) { exit 111i32; },
        (DeadlineExceeded)  { exit 112i32; },
        (StaleHandle)       { exit 113i32; },
        (E1)                { exit 114i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
