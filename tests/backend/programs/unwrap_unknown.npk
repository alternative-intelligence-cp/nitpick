// expect-exit: 42
//
// THE `?|` UNKNOWN-OPERAND FALLBACK (S-3b's other half, 1.1-interlude close).
// `sys` is typed now (D-048/S-3a), but the REST of the bare-name builtin
// surface still records UNKNOWN — so `?|` over one derives its slot shape
// from the operand's own LL, exactly the rule `?!` has carried since 1.1.2:
//   - the typer visits the DEFAULT even when the lhs is unknown (it used to
//     bail first, and the emitter then met a literal with no recorded type);
//   - the emitter takes the value half of the operand's `Result` text for
//     the slot, `{ i32 }` meaning `Result<NIL>` with no value at all.
// An aggregate value half is exercised deliberately: `read_file`'s value is
// a `string`, three words wide — the fallback is not a scalars-only trick.
mod:unwrap_unknown;
error:EPath;

func:main = int32(cstring[]:_~argv) {
    // (`to_cstring` is another unknown-typed operand — `?!` over it drives
    // the aggregate value half through the OTHER unwrap form.)
    cstring:missing = to_cstring("/nonexistent/npk_unwrap_unknown_probe") ?! EPath;
    // The error path takes the default...
    string:s = read_file(missing) ?| "fallback";
    if (!(string_equals(s, "fallback"))) { exit 11i32; }
    // ...and the value path keeps the value: write a file, read it back.
    cstring:path = to_cstring(".internal/unwrap_unknown.tmp") ?! EPath;
    write_file(path, "payload") ?| NIL;
    string:back = read_file(path) ?| "";
    if (!(string_equals(back, "payload"))) { exit 12i32; }
    exit 42i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (EPath)          { exit 94i32; },
        (HeapBadRequest) { exit 95i32; },
        (HeapOom)        { exit 95i32; },
        (Unreachable)    { exit 97i32; },
        (WildLeak)       { exit 98i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
