// expect-exit: 0
// stress: 40
// argv: ECHO_TOOL
//
// THE TOOL RUNNER, END TO END (1.4.8, D-206): a real child through the one
// clone primitive with the BUILD'S descriptor map — stdin from /dev/null,
// stdout and stderr captured through pipes, no control channel — its
// environment passed through with one entry added, both pipes drained, the
// exit status read back through the pidfd, the registry slot retired. Then
// the two failure shapes the build will meet: a tool that is not there (the
// clone succeeds, the exec fails, and 127 comes back as the CHILD'S answer,
// not as a spawn error), and a tool that hangs (killed at the deadline,
// reaped, retired — `EProcDeadline`, and nothing left registered).
//
// The exit is 0 ON PURPOSE: the controlled exit's checks refuse success while
// a wild allocation lives (D-151) or a registered child stands (D-188), so a
// leak on any path — the block, the argv copies, a pipe end, a slot — turns
// this exit into a trap. The path to the tool arrives through argv (the
// harness builds fixtures and substitutes ECHO_TOOL), because `Path` refuses
// relative paths by design.
mod:proc_tool;
use "../../../lib/nproc.npk".*;
error:E9;

func:args_of = ProcArgs(string:exe, string:arg) {
    ProcArgs:a = raw args_init();
    Result<NIL>:r1 = args_push(@a, exe);
    if (r1.is_error) { fail r1.err; }
    Result<NIL>:r2 = args_push(@a, arg);
    if (r2.is_error) { fail r2.err; }
    pass a;
};

async func:main = int32(cstring[]:argv) {
    if (argv.len < 2i64) { exit 7i32; }
    string:tp = string_from_bytes(argv[1i64].ptr, argv[1i64].len);
    Path:tool = path_parse(tp) ?! E9;

    // The environment: ours, plus the one entry the tool looks for.
    ProcArgs:env = raw args_init();
    cstring[]:mine = environ();
    for (int64:i in 0i64...mine.len) { args_push_cstring(@env, mine[i]) ?! E9; }
    args_push(@env, "NPK_PROBE=1") ?! E9;

    // 1. capture, environment, exit status.
    ProcArgs:a1 = args_of(tool.text, "seven") ?! E9;
    Proc:p1 = proc_spawn(tool, @a1, @env) ?! E9;
    ProcExit:x1 = (await proc_wait(@p1, raw duration_secs(5i64))) ?! E9;
    if (!x1.exited)                                       { exit 11i32; }
    if (x1.status != 7i64)                                { exit 12i32; }
    if (!(string_equals(x1.out, "hello seven\nprobe\n"))) { exit 13i32; }
    if (!(string_equals(x1.err, "n=2\n")))                { exit 14i32; }
    drop args_free(@a1);

    // 2. a tool that is not there: 127 is the child's answer, not a spawn error.
    Path:none = path_parse("/nonexistent/npk_no_such_tool") ?! E9;
    ProcArgs:a2 = args_of(none.text, "x") ?! E9;
    Proc:p2 = proc_spawn(none, @a2, @env) ?! E9;
    ProcExit:x2 = (await proc_wait(@p2, raw duration_secs(5i64))) ?! E9;
    if (!x2.exited)          { exit 15i32; }
    if (x2.status != 127i64) { exit 16i32; }
    drop args_free(@a2);

    // 3. a tool that hangs: killed at the deadline, reaped, retired.
    ProcArgs:a3 = args_of(tool.text, "sleep") ?! E9;
    Proc:p3 = proc_spawn(tool, @a3, @env) ?! E9;
    Result<ProcExit>:x3 = await proc_wait(@p3, raw duration_ms(200i64));
    if (!x3.is_error)             { exit 17i32; }
    if (x3.err != EProcDeadline)  { exit 18i32; }
    drop args_free(@a3);
    drop args_free(@env);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)               { exit 91i32; },
        (BadPath)          { exit 92i32; },
        (EProcArgs)        { exit 93i32; },
        (EProcSpawn)       { exit 94i32; },
        (EProcDeadline)    { exit 95i32; },
        (EProcWait)        { exit 96i32; },
        (DeadlineExceeded) { exit 98i32; },
        (DriverLeak)       { exit 89i32; },
        (IntOverflow)      { exit 87i32; },
        (OutOfBounds)      { exit 86i32; },
        (WildLeak)         { exit 88i32; },
        (Unreachable)      { exit 87i32; },
        (HeapOom)          { exit 87i32; },
        (HeapBadRequest)   { exit 87i32; },
        (*)                { exit 99i32; }
    }
    exit 90i32;
};
