// expect-exit: 0
//
// LIVE-1's lock (0.9.0) is OPEN (1.5.3 step 1): a `requires` the backend never
// read compiled to a function that claims a contract nothing enforces -- the
// observed defect was this exact shape emitting a bare `sdiv`. It refused as
// a rung from 0.9.0 to 1.5.2; the clause is checked at the entry now, and
// this call satisfies it.

mod:contract_requires;
error:E9;

func:contracted = int32(int32:a, int32:b) requires b != 0i32 {
    pass (a + b);
};

func:main = int32(cstring[]:_~argv) {
    int32:v = contracted(6i32, 2i32) ?! E9;
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (IntOverflow) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (RequiresViolated) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
