// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// Traits, impl, and dyn are excluded from subset 1. The diagnostic sink is a
// concrete type until D-075's `dyn Writer` is lowerable. Lifted by cycle 1.0.

trait:Renderable = {
    func:render = string(Self:self);
};

struct:Point = { int32:x; };

// `impl:Type:Trait` -- type first, no connector (D-031). This test was written
// with `impl:Renderable:for:Point`, FORMAL_DRAFT 13's superseded form, which the
// seed still accepted.
impl:Point:Renderable = {
    func:render = string(Point:self) { pass "point"; };
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) { exit 1i32; };
