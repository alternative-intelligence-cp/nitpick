// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// The audit's fourth Theme-A hole, inverted into its own test: emit_all used
// to neither descend into an inline `mod` nor refuse it, so declared code was
// SILENTLY SHED — this file compiled clean while its async function vanished.
// Now the walk descends, reaches the construct, and refuses it by name.
// (This file's hidden construct was an `async` function until 1.1.4 lowered
// those; a `requires` contract carries the rung now, refusing until 1.3.)

mod:hidden = {
    func:fetch = int32(int32:v) requires v != 0i32 {
        pass 1i32;
    };
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
