// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// Stage C of 1.1.4 (D-177) lowers the awaited chain — an `async` function is
// a switched-resume machine and `await` composes them — so awaiting is no
// longer this file's rung. What still refuses by name is the SPAWN form:
// `drop work()` links a child onto the join list, and the join is stage E.

async func:fetch = int32() {
    pass 1i32;
};

async func:main = int32(cstring[]:_~argv) {
    drop fetch();
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) { exit 1i32; };
