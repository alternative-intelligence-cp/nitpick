// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// Stage C lowered the awaited chain, stage E the spawn and its join — so
// this file's rung has moved twice. What still refuses by name is an
// `await` of a GENERIC call: the await site derives the callee's frame
// type and resume symbol, and the specialization lookup for that pairing
// is not yet wired.

async func:fetch<T> = T(T:v) {
    pass v;
};

async func:main = int32(cstring[]:_~argv) {
    int32:r = await fetch(1i32) ?| 0i32;
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (DeadlineExceeded) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};
