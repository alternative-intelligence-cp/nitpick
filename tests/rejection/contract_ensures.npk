// expect-error: NITPICK-RUNG-001
// expect-error-at: 10
// expect-no-parse-error
//
// `ensures` may name `result` — the grammar binds it, the verifier gives it
// meaning (1.3). Until then the whole contract refuses rather than vanishing.

error:E9;

func:promised = int32(int32:a) ensures result > 0i32 {
    pass (a + 1i32);
};

func:main = int32(cstring[]:_~argv) {
    int32:v = promised(1i32) ?! E9;
    exit 0i32;
};

func:failsafe = int32(Error:_~err) { exit 1i32; };
