// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// The suspend walk (D-177) marked `a` as live across a suspension: declared
// before the second await, still needed after it. Stage C keeps locals as
// allocas, and an alloca dies between `resume` calls — so the declaration
// refuses by name until stage D lays crossing locals into the frame.

async func:step = int32(int32:v) {
    pass v + 1i32;
};

async func:main = int32(cstring[]:_~argv) {
    int32:a = await step(1i32) ?| 0i32;
    int32:b = await step(2i32) ?| 0i32;
    exit a + b;
};

func:failsafe = int32(tbb32:_~err) { exit 1i32; };
