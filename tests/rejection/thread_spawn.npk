// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// A GENERIC thread body (D-181): the spawn site derives the callee's frame
// type and resume symbol by name, and the specialization lookup for that
// pairing is not wired — the same rung a generic `await` carries. Ordinary
// thread spawns lower and run (tests/backend/programs/thread_spawn_join).

const Duration:JOIN_2S = Duration{ ns: 2000000000i64 };

thread async func:worker<T> = NIL(T:_~v) joins JOIN_2S {
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    drop worker(1i32);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (Unreachable)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (DeadlineExceeded) { exit 95i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
