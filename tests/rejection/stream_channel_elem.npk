// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// A STREAM DOES NOT RIDE A CHANNEL (D-185, IO_REFERENCE §6). An OwnedFd is
// SCOPE-BOUND: the scope that owns it closes it, and a channel's receiver
// may outlive that scope — the unbounded conduit is exactly where the
// closing discipline would be outrun. A spawn is different: moves into a
// thread call are legal because the join (D-062) bounds the thread by the
// creating scope, the owning-string precedent. The wall is the same one a
// Guard hits, for the same reason.
mod:stream_channel_elem;
error:Sent;
async func:main = int32(cstring[]:_~argv) {
    Channel<OwnedFd, 3i32, 2i64>:ch = channel() ?! Unreachable;
    fd:f = 0i32 =>! fd;
    OwnedFd:o = own_fd(f);
    await ch.send(move(o), raw duration_ms(50i64)) ?! Sent;
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (Sent)             { exit 61i32; },
        (Unreachable)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StaleHandle)      { exit 95i32; },
        (ChannelClosed)    { exit 96i32; },
        (DeadlineExceeded) { exit 97i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
