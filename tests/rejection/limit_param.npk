// expect-error: NITPICK-RUNG-001
// expect-error-at: 12
// expect-no-parse-error
//
// A parameter's `limit<Rules>` is enforced in EVERY build (D-068) — so until
// 1.3 emits the check, carrying one refuses. A limit that lowered to nothing
// told the caller its argument was checked when nothing checked it.

mod:limit_param;
error:E9;

func:limited = int32(limit<r_pos> int32:x) {
    pass x;
};

func:main = int32(cstring[]:_~argv) {
    int32:v = limited(3i32) ?! E9;
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};

// D-220 (1.5.1): the rule name RESOLVES now, so the rule this file leans on
// is declared -- after the construct, so the line the rung is expected at holds.
Rules<int32>:r_pos = { $ > 0i32 };
