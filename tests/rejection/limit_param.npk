// expect-error: NITPICK-RUNG-001
// expect-error-at: 9
// expect-no-parse-error
//
// A parameter's `limit<Rules>` is enforced in EVERY build (D-068) — so until
// 1.3 emits the check, carrying one refuses. A limit that lowered to nothing
// told the caller its argument was checked when nothing checked it.

func:limited = int32(limit<r_pos> int32:x) {
    pass x;
};

func:main = int32(cstring[]:_~argv) {
    int32:v = raw limited(3i32);
    exit 0i32;
};

func:failsafe = int32(tbb32:_~err) { exit 1i32; };
