// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// `while` is the only loop in subset 1. for / loop / till are excluded because
// every extra loop form is seed work and `while` expresses all of them.
// The counter variable `$` comes with them.

func:total = int32(int32:n) {
    int32:acc = 0i32;

    for (int64:i in 0...10) {
        acc = acc + 1i32;
    }

    till (5i32, 1i32) {
        acc = acc + ($ => int32);
    }

    pass acc;
};

func:main = int32() {
    int32:t = raw total(3i32);
    exit 0i32;
};

func:failsafe = int32(tbb32:err) { exit 1i32; };
