// expect-error: NITPICK-RUNG-001
// expect-error-at: 12
// expect-no-parse-error
//
// A declaration's `limit<Rules>` — the probe that opened 0.9.0: it lowered to
// a bare alloca+store with the rule absent from the IR. Now it refuses.

mod:limit_local;
error:E9;

func:build = int32(int32:seed) {
    limit<r_pos> int32:x = seed;
    pass x;
};

func:main = int32(cstring[]:_~argv) {
    int32:v = build(5i32) ?! E9;
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9) { exit 1i32; },
        (HeapBadRequest) { exit 1i32; },
        (HeapOom) { exit 1i32; },
        (LimitViolated) { exit 1i32; },
        (Unreachable) { exit 1i32; },
        (WildLeak) { exit 1i32; },
        (*) { exit 1i32; }
    }
    exit 1i32;
};

// D-220 (1.5.1): the rule name RESOLVES now, so the rule this file leans on
// is declared -- after the construct, so the line the rung is expected at holds.
Rules<int32>:r_pos = { $ > 0i32 };
