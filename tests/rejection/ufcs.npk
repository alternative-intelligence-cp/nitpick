// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// UFCS method-call syntax is excluded from subset 1 -- the compiler's source
// writes Type_method(x) instead. `.` remains field access, which IS in the
// subset; only the method-call form is out. Lifted by cycle 1.0.

struct:Point = { int32:x; int32:y; };

func:Point_magnitude = int32(Point:self) {
    pass (self.x + self.y);
};

func:main = int32() {
    Point:p = Point{ x: 3i32, y: 4i32 };

    int32:ok  = p.x;                      // field access -- in subset 1
    int32:bad = raw p.magnitude();        // UFCS method call -- outside it

    exit 0i32;
};

func:failsafe = int32(tbb32:err) { exit 1i32; };
