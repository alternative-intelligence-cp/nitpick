// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// `v + relay await step(v)` loads `v` into an SSA value BEFORE the
// suspension and adds it after — a value that would not dominate its use
// once the resume switch re-enters. (A CONSTANT left operand is fine —
// constants dominate everywhere — which is why the guard counts minted
// temps, not syntax.) The spill that fixes this is stage D's frame work;
// until then an `await` must be the first evaluation its statement makes.

async func:step = int32(int32:v) {
    pass v + 1i32;
};

async func:helper = int32(int32:v) {
    pass v + (relay await step(v));
};

async func:main = int32(cstring[]:_~argv) {
    int32:a = await helper(1i32) ?| 0i32;
    exit a;
};

func:failsafe = int32(tbb32:_~err) { exit 1i32; };
