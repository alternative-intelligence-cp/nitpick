// expect-error: NITPICK-RUNG-001
// expect-no-parse-error
//
// A BORROW DOES NOT RIDE A CHANNEL (D-183, 1.2.5b). Owning elements ride
// now — the send's `move` transfers a `string`'s body with its ownership,
// and the receiver's drop frees it — which is exactly why what remains
// refused is sharper than it was: a `T->`, a slice, or anything holding one
// names storage that stays behind on the sender's frame, and no move can
// carry a borrowed target across a task boundary. The refusal names the
// element, not the channel: everything whose bytes ARE the value — scalars,
// `Handle<T>`, endpoints, owning aggregates — transfers whole.
mod:channel_owning_elem;
error:Sent;
async func:main = int32(cstring[]:_~argv) {
    Channel<int64->, 3i32, 2i64>:ch = channel() ?! Unreachable;
    int64:v = 9i64;
    await ch.send(@v, raw duration_ms(50i64)) ?! Sent;
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (Sent)             { exit 61i32; },
        (Unreachable)      { exit 91i32; },
        (HeapOom)          { exit 92i32; },
        (HeapBadRequest)   { exit 93i32; },
        (WildLeak)         { exit 94i32; },
        (StaleHandle)      { exit 95i32; },
        (ChannelClosed)    { exit 96i32; },
        (DeadlineExceeded) { exit 97i32; },
        (*)                { exit 99i32; }
    }
    exit 9i32;
};
